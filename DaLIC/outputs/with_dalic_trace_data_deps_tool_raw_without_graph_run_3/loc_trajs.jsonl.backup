        formatted = np.array(\n1333 |                 [\n1334 |                     formatter(val) if not m else na_rep\n1335 |                     for val, m in zip(values.ravel(), mask.ravel())\n1336 |                 ]\n1337 |             ).reshape(values.shape)\n1338 |             return formatted\n1339 | \n1340 |         def format_complex_with_na_rep(\n1341 |             values: ArrayLike, formatter: Callable, na_rep: str\n1342 |         ) -> np.ndarray:\n1343 |             real_values = np.real(values).ravel()  # type: ignore[arg-type]\n1344 |             imag_values = np.imag(values).ravel()  # type: ignore[arg-type]\n1345 |             real_mask, imag_mask = isna(real_values), isna(imag_values)\n1346 |             formatted_lst = []\n1347 |             for val, real_val, imag_val, re_isna, im_isna in zip(\n1348 |                 values.ravel(),\n1349 |                 real_values,\n1350 |                 imag_values,\n1351 |                 real_mask,\n1352 |                 imag_mask,\n1353 |             ):\n1354 |                 if not re_isna and not im_isna:\n1355 |                     formatted_lst.append(formatter(val))\n1356 |                 elif not re_isna:  # xxx+nanj\n1357 |                     formatted_lst.append(f\"{formatter(real_val)}+{na_rep}j\")\n1358 |                 elif not im_isna:  # nan[+/-]xxxj\n1359 |                     # The imaginary part may either start with a \"-\" or a space\n1360 |                     imag_formatted = formatter(imag_val).strip()\n1361 |                     if imag_formatted.startswith(\"-\"):\n1362 |                         formatted_lst.append(f\"{na_rep}{imag_formatted}j\")\n1363 |                     else:\n1364 |                         formatted_lst.append(f\"{na_rep}+{imag_formatted}j\")\n1365 |                 else:  # nan+nanj\n1366 |                     formatted_lst.append(f\"{na_rep}+{na_rep}j\")\n1367 |             return np.array(formatted_lst).reshape(values.shape)\n1368 | \n1369 |         if self.formatter is not None:\n1370 |             return format_with_na_rep(self.values, self.formatter, self.na_rep)\n1371 | \n1372 |         if self.fixed_width:\n1373 |             threshold = get_option(\"display.chop_threshold\")\n1374 |         else:\n1375 |             threshold = None\n1376 | \n1377 |         # if we have a fixed_width, we'll need to try different float_format\n1378 |         def format_values_with(float_format):\n1379 |             formatter = self._value_formatter(float_format, threshold)\n1380 | \n1381 |             # default formatter leaves a space to the left when formatting\n1382 |             # floats, must be consistent for left-justifying NaNs (GH #25061)\n1383 |             na_rep = \" \" + self.na_rep if self.justify == \"left\" else self.na_rep\n1384 | \n1385 |             # different formatting strategies for complex and non-complex data\n1386 |             # need to distinguish complex and float NaNs (GH #53762)\n1387 |             values = self.values\n1388 |             is_complex = is_complex_dtype(values)\n1389 | \n1390 |             # separate the wheat from the chaff\n1391 |             if is_complex:\n1392 |                 values = format_complex_with_na_rep(values, formatter, na_rep)\n1393 |             else:\n1394 |                 values = format_with_na_rep(values, formatter, na_rep)\n1395 | \n1396 |             if self.fixed_width:\n1397 |                 if is_complex:\n1398 |                     result = _trim_zeros_complex(values, self.decimal)\n1399 |                 else:\n1400 |                     result = _trim_zeros_float(values, self.decimal)\n1401 |                 return np.asarray(result, dtype=\"object\")\n1402 | \n1403 |             return values\n1404 | \n1405 |         # There is a special default string when we are fixed-width\n1406 |         # The default is otherwise to use str instead of a formatting string\n1407 |         float_format: FloatFormatType | None\n1408 |         if self.float_for