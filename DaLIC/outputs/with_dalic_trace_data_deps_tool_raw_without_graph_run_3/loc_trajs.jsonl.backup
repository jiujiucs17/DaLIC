le_axes(xs, ys, verts_zs, zdir)\n3044 |         self.auto_scale_xyz(xs, ys, verts_zs, had_data)\n3045 | \n3046 |         return patches\n```\n\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be horizontal.\n65 | \n66 |     \"\"\"\n67 | \n68 |     def __init__(self, patches, errorbar=None, *, datavalues=None,\n69 |                  orientation=None, **kwargs):\n70 |         self.patches = patches\n71 |         self.errorbar = errorbar\n72 |         self.datavalues = datavalues\n73 |         self.orientation = orientation\n74 |         super().__init__(patches, **kwargs)\n```\n\n\n\n##Searching for term \"color\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/individual_colors_from_cmap.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ===========================================\n 3 | Selecting individual colors from a colormap\n 4 | ===========================================\n 5 | \n 6 | Sometimes we want to use more colors or a different set of colors than the default color\n 7 | cycle provides. Selecting individual colors from one of the provided colormaps can be a\n 8 | convenient way to do this.\n 9 | \n10 | We can retrieve colors from any `.Colormap` by calling it with a float or a list of\n11 | floats in the range [0, 1]; e.g. ``cmap(0.5)`` will give the middle color. See also\n12 | `.Colormap.__call__`.\n13 | \n14 | Extracting colors from a continuous colormap\n15 | --------------------------------------------\n16 | \"\"\"\n17 | \n18 | import matplotlib.pyplot as plt\n19 | import numpy as np\n20 | \n21 | import matplotlib as mpl\n22 | \n23 | n_lines = 21\n24 | cmap = mpl.colormaps['plasma']\n25 | \n26 | # Take colors at regular intervals spanning the colormap.\n27 | colors = cmap(np.linspace(0, 1, n_lines))\n28 | \n29 | fig, ax = plt.subplots(layout='constrained')\n30 | \n31 | for i, color in enumerate(colors):\n32 |     ax.plot([0, i], color=color)\n33 | \n34 | plt.show()\n35 | \n36 | # %%\n37 | #\n38 | # Extracting colors from a discrete colormap\n39 | # ------------------------------------------\n40 | # The list of all colors in a `.ListedColormap` is available as the ``colors``\n41 | # attribute.\n42 | \n43 | colors = mpl.colormaps['Dark2'].colors\n44 | \n45 | fig, ax = plt.subplots(layout='constrained')\n46 | \n47 | for i, color in enumerate(colors):\n48 |     ax.plot([0, i], color=color)\n49 | \n50 | plt.show()\n51 | \n52 | # %%\n53 | # See Also\n54 | # --------\n55 | #\n56 | # For more details about manipulating colormaps, see :ref:`colormap-manipulation`.  To\n57 | # change the default color cycle, see :ref:`color_cycle`.\n58 | #\n59 | # .. admonition:: References\n60 | #\n61 | #    The use of the following functions, methods, classes and modules is shown\n62 | #    in this example:\n63 | #\n64 | #    - `matplotlib.colors.Colormap`\n65 | #    - `matplotlib.colors.Colormap.resampled`\n66 | #\n67 | # .. tags::\n68 | #\n69 | #    component: colormap\n70 | #    styling: color\n71 | #    plot-type: line\n72 | #    level: intermediate\n73 | \n```\n\nFound class `lib/matplotlib/colorizer.py:Colorizer`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Colorizer:\n    def __init__(self, cmap=None, norm=None):\n...\n    def _scale_norm(self, norm, vmin, vmax, A):\n...\n    @property\n    def norm(self):\n...\n    @norm.setter\n    def norm(self, norm):\n...\n    def to_rgba(self, x, alpha=None, bytes=False, norm=True):\n...\n    @staticmethod\n    def _pass_image_data(x, alpha=None, bytes=False, norm=True):\n...\n    def autoscale(self, A):\n...\n    def autoscale_None(self, A):\n...\n    def _set_cmap(self, cmap):\n...\n    @property\n    def cmap(self):\n...\n    @cmap.setter\n    def cmap(self, cmap):\n...\n    def set_clim(self, vmin=None, vmax=None):\n...\n    def get_clim(self):\n...\n    def changed(self):\n...\n    @property\n    def vmin(self):\n...\n    @vmin.setter\n    def vmin(self, vmin):\n...\n    @property\n    def vmax(self):\n...\n    @vmax.setter\n    def vmax(self, vmax):\n...\n    @property\n    def clip(self):\n...\n    @clip.setter\n    def clip(self, clip):\n\n```\nHint: Search `lib/matplotlib/colorizer.py:Colorizer` to get the full content if needed.\n\nFound function `lib/matplotlib/colorizer.py:Colorizer.autoscale_None`.\nSource: Retrieved entity using keyword search (bm25).\n```\n215 | def autoscale_None(self, A):\n216 |         \"\"\"\n217 |         Autoscale the scalar limits on the norm instance using the\n218 |         current array, changing only limits that are None\n219 |         \"\"\"\n220 |         if A is None:\n221 |             raise TypeError('You must first set_array for mappable')\n222 |         # If the norm's limits are updated self.changed() will be called\n223 |         # through the callbacks attached to the norm\n224 |         self.norm.aut