|         return format_array(\n756 |             frame.iloc[:, i]._values,\n757 |             formatter,\n758 |             float_format=self.float_format,\n759 |             na_rep=self.na_rep,\n760 |             space=self.col_space.get(frame.columns[i]),\n761 |             decimal=self.decimal,\n762 |             leading_space=self.index,\n763 |         )\n764 | \n765 |     def _get_formatter(self, i: str | int) -> Callable | None:\n766 |         if isinstance(self.formatters, (list, tuple)):\n767 |             if is_integer(i):\n768 |                 i = cast(int, i)\n769 |                 return self.formatters[i]\n770 |             else:\n771 |                 return None\n772 |         else:\n773 |             if is_integer(i) and i not in self.columns:\n774 |                 i = self.columns[i]\n775 |             return self.formatters.get(i, None)\n776 | \n777 |     def _get_formatted_column_labels(self, frame: DataFrame) -> list[list[str]]:\n778 |         from pandas.core.indexes.multi import sparsify_labels\n779 | \n780 |         columns = frame.columns\n781 | \n782 |         if isinstance(columns, MultiIndex):\n783 |             fmt_columns = columns._format_multi(sparsify=False, include_names=False)\n784 |             if self.sparsify and len(fmt_columns):\n785 |                 fmt_columns = sparsify_labels(fmt_columns)\n786 | \n787 |             str_columns = [list(x) for x in zip(*fmt_columns)]\n788 |         else:\n789 |             fmt_columns = columns._format_flat(include_name=False)\n790 |             str_columns = [\n791 |                 [\n792 |                     \" \" + x\n793 |                     if not self._get_formatter(i) and is_numeric_dtype(dtype)\n794 |                     else x\n795 |                 ]\n796 |                 for i, (x, dtype) in enumerate(zip(fmt_columns, self.frame.dtypes))\n797 |             ]\n798 |         return str_columns\n799 | \n800 |     def _get_formatted_index(self, frame: DataFrame) -> list[str]:\n