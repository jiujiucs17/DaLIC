1:\n1124 |             print(\"Learning code...\", end=\" \")\n1125 |         elif verbose == 1:\n1126 |             print(\"|\", end=\" \")\n1127 |         code = sparse_encode(\n1128 |             X,\n1129 |             dictionary,\n1130 |             algorithm=method,\n1131 |             alpha=alpha,\n1132 |             n_jobs=n_jobs,\n1133 |             check_input=False,\n1134 |             positive=positive_code,\n1135 |             max_iter=method_max_iter,\n1136 |             verbose=verbose,\n1137 |         )\n1138 |         if verbose > 1:\n1139 |             dt = time.time() - t0\n1140 |             print(\"done (total time: % 3is, % 4.1fmn)\" % (dt, dt / 60))\n1141 |         if return_n_iter:\n1142 |             return code, dictionary, ii - iter_offset + 1\n1143 |         else:\n1144 |             return code, dictionary\n1145 | \n1146 |     if return_n_iter:\n1147 |         return dictionary, ii - iter_offset + 1\n1148 |     else:\n1149 |         return dictionary\n```\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation._em_step`.\nSource: Retrieved code content using keyword search (bm25).\n```\n475 | def _em_step(self, X, total_samples, batch_update, parallel=None):\n476 |         \"\"\"EM update for 1 iteration.\n477 | \n478 |         update `_component` by batch VB or online VB.\n479 | \n480 |         Parameters\n481 |         ----------\n482 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n483 |             Document word matrix.\n484 | \n485 |         total_samples : int\n486 |             Total number of documents. It is only used when\n487 |             batch_update is `False`.\n488 | \n489 |         batch_update : bool\n490 |             Parameter that controls updating method.\n491 |             `True` for batch learning, `False` for online learning.\n492 | \n493 |         parallel : joblib.Parallel, default=None\n494 |             Pre-initialized instance of joblib.Parallel\n495 | \n496 |     