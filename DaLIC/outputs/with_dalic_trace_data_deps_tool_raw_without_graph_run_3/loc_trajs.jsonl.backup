`estimator=self` is automatically added to these params to generate\n2900 |         more informative error message in case of invalid input data.\n2901 | \n2902 |     Returns\n2903 |     -------\n2904 |     out : {ndarray, sparse matrix} or tuple of these\n2905 |         The validated input. A tuple is returned if both `X` and `y` are\n2906 |         validated.\n2907 |     \"\"\"\n2908 |     _check_feature_names(_estimator, X, reset=reset)\n2909 |     tags = get_tags(_estimator)\n2910 |     if y is None and tags.target_tags.required:\n2911 |         raise ValueError(\n2912 |             f\"This {_estimator.__class__.__name__} estimator \"\n2913 |             \"requires y to be passed, but the target y is None.\"\n2914 |         )\n2915 | \n2916 |     no_val_X = isinstance(X, str) and X == \"no_validation\"\n2917 |     no_val_y = y is None or isinstance(y, str) and y == \"no_validation\"\n2918 | \n2919 |     if no_val_X and no_val_y:\n2920 |         raise ValueError(\"Validation should be done on X, y or both.\")\n2921 | \n2922 |     default_check_params = {\"estimator\": _estimator}\n2923 |     check_params = {**default_check_params, **check_params}\n2924 | \n2925 |     if skip_check_array:\n2926 |         if not no_val_X and no_val_y:\n2927 |             out = X\n2928 |         elif no_val_X and not no_val_y:\n2929 |             out = y\n2930 |         else:\n2931 |             out = X, y\n2932 |     elif not no_val_X and no_val_y:\n2933 |         out = check_array(X, input_name=\"X\", **check_params)\n2934 |     elif no_val_X and not no_val_y:\n2935 |         out = _check_y(y, **check_params)\n2936 |     else:\n2937 |         if validate_separately:\n2938 |             # We need this because some estimators validate X and y\n2939 |             # separately, and in general, separately calling check_array()\n2940 |             # on X and y isn't equivalent to just calling check_X_y()\n2941 |             # :(\n2942 |             check_X_params, check_y_params = validate_separately\n2943 |             if \"estimator\" not in check_X_params:\n2944 |                 check_X_params = {**default_check_params, **check_X_params}\n2945 |             X = check_array(X, input_name=\"X\", **check_X_params)\n2946 |             if \"estimator\" not in check_y_params:\n2947 |                 check_y_params = {**default_check_params, **check_y_params}\n2948 |             y = check_array(y, input_name=\"y\", **check_y_params)\n2949 |         else:\n2950 |             X, y = check_X_y(X, y, **check_params)\n2951 |         out = X, y\n2952 | \n2953 |     if not no_val_X and check_params.get(\"ensure_2d\", True):\n2954 |         _check_n_features(_estimator, X, reset=reset)\n2955 | \n2956 |     return out\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_estimator_tags_renamed`.\nSource: Retrieved code content using keyword search (bm25).\n```\n4447 | def check_estimator_tags_renamed(name, estimator_orig):\n4448 |     help = \"\"\"{tags_func}() was removed in 1.6. Please use __sklearn_tags__ instead.\n4449 | You can implement both __sklearn_tags__() and {tags_func}() to support multiple\n4450 | scikit-learn versions.\n4451 | \"\"\"\n4452 | \n4453 |     for klass in type(estimator_orig).mro():\n4454 |         if (\n4455 |             # Here we check vars(...) because we want to check if the method is\n4456 |             # explicitly defined in the class instead of inherited from a parent class.\n4457 |             (\"_more_tags\" in vars(klass) or \"_get_tags\" in vars(klass))\n4458 |             and \"__sklearn_tags__\" not in vars(klass)\n4459 |         ):\n4460 |             raise TypeError(\n4461 |                 f\"Estimator {name} has defined either `_more_tags` or `_get_tags`,\"\n4462 |                 \" but not `__sklearn_tags__`. If you're customizing tags, and need to\"\n4463 |                 \" support multiple scikit-learn versions, you can implement both\"\n4464 |                 \" `__sklearn_tags__` and `_more_tags`