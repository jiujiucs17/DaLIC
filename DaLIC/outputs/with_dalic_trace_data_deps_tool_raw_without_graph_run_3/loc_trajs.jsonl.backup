 \"as_strided\",\n      \"path\": \"numpy/lib/stride_tricks.py\",\n      \"line\": 97\n    }\n  ],\n  \"edges\": [\n    {\n      \"src\": {\n        \"kind\": \"ref\",\n        \"symbol\": \"np\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 0\n      },\n      \"dst\": {\n        \"kind\": \"var\",\n        \"symbol\": \"x\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 7\n      },\n      \"edge_type\": \"data\"\n    },\n    {\n      \"src\": {\n        \"kind\": \"attr\",\n        \"symbol\": \"np.arange\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 0\n      },\n      \"dst\": {\n        \"kind\": \"var\",\n        \"symbol\": \"x\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 7\n      },\n      \"edge_type\": \"data\"\n    },\n    {\n      \"src\": {\n        \"kind\": \"var\",\n        \"symbol\": \"x\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 7\n      },\n      \"dst\": {\n        \"kind\": \"param\",\n        \"symbol\": \"max_line_width\",\n        \"scope\": \"_array_str_implementation\",\n        \"path\": \"numpy/core/arrayprint.py\",\n        \"line\": 1500\n      },\n      \"edge_type\": \"arg\"\n    },\n    {\n      \"src\": {\n        \"kind\": \"ref\",\n        \"symbol\": \"sliding_window_view\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 0\n      },\n      \"dst\": {\n        \"kind\": \"var\",\n        \"symbol\": \"view\",\n        \"scope\": \"run_task\",\n        \"path\": \"data point 131/DaLIC/A.py\",\n        \"line\": 9\n      },\n      \"edge_type\": \"data\"\n    },\n    {\n      \"src\": {\n        \"kind\": \"var\",\n        \"symbol\": \"view\",\n        \"scope\": \"run_task\",\n      