             return str(x)\n1214 |             elif isinstance(x, StringDtype):\n1215 |                 return repr(x)\n1216 |             else:\n1217 |                 # object dtype\n1218 |                 return str(formatter(x))\n1219 | \n1220 |         vals = self.values\n1221 |         if not isinstance(vals, np.ndarray):\n1222 |             raise TypeError(\n1223 |                 \"ExtensionArray formatting should use _ExtensionArrayFormatter\"\n1224 |             )\n1225 |         inferred = lib.map_infer(vals, is_float)\n1226 |         is_float_type = (\n1227 |             inferred\n1228 |             # vals may have 2 or more dimensions\n1229 |             & np.all(notna(vals), axis=tuple(range(1, len(vals.shape))))\n1230 |         )\n1231 |         leading_space = self.leading_space\n1232 |         if leading_space is None:\n1233 |             leading_space = is_float_type.any()\n1234 | \n1235 |         fmt_values = []\n1236 |         for i, v in enumerate(vals):\n1237 |             if (not is_float_type[i] or self.formatter is not None) and leading_space:\n1238 |                 fmt_values.append(f\" {_format(v)}\")\n1239 |             elif is_float_type[i]:\n1240 |                 fmt_values.append(float_format(v))\n1241 |             else:\n1242 |                 if leading_space is False:\n1243 |                     # False specifically, so that the default is\n1244 |                     # to include a space if we get here.\n1245 |                     tpl = \"{v}\"\n1246 |                 else:\n1247 |                     tpl = \" {v}\"\n1248 |                 fmt_values.append(tpl.format(v=_format(v)))\n1249 | \n1250 |         return fmt_values\n```\n\nFound function `pandas/io/formats/format.py:FloatArrayFormatter._value_formatter`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1266 | def _value_formatter(\n1267 |         self,\n1268 |         float_format: FloatFormatType | None = None,\n1269 |         threshold: float | None 