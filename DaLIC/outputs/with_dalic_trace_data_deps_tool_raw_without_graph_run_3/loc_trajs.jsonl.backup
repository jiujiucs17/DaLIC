erations run. Returned only if `return_n_iter` is\n 921 |         set to `True`.\n 922 | \n 923 |     See Also\n 924 |     --------\n 925 |     dict_learning\n 926 |     DictionaryLearning\n 927 |     MiniBatchDictionaryLearning\n 928 |     SparsePCA\n 929 |     MiniBatchSparsePCA\n 930 |     \"\"\"\n 931 |     deps = (return_n_iter, return_inner_stats, iter_offset, inner_stats)\n 932 |     if max_iter is not None and not all(arg == \"deprecated\" for arg in deps):\n 933 |         raise ValueError(\n 934 |             \"The following arguments are incompatible with 'max_iter': \"\n 935 |             \"return_n_iter, return_inner_stats, iter_offset, inner_stats\"\n 936 |         )\n 937 | \n 938 |     iter_offset = _check_warn_deprecated(iter_offset, \"iter_offset\", default=0)\n 939 |     return_inner_stats = _check_warn_deprecated(\n 940 |         return_inner_stats,\n 941 |         \"return_inner_stats\",\n 942 |         default=False,\n 943 |         additional_message=\"From 1.3 inner_stats will never be returned.\",\n 944 |     )\n 945 |     inner_stats = _check_warn_deprecated(inner_stats, \"inner_stats\", default=None)\n 946 |     return_n_iter = _check_warn_deprecated(\n 947 |         return_n_iter,\n 948 |         \"return_n_iter\",\n 949 |         default=False,\n 950 |         additional_message=(\n 951 |             \"From 1.3 'n_iter' will never be returned. Refer to the 'n_iter_' and \"\n 952 |             \"'n_steps_' attributes of the MiniBatchDictionaryLearning object instead.\"\n 953 |         ),\n 954 |     )\n 955 | \n 956 |     if max_iter is not None:\n 957 |         transform_algorithm = \"lasso_\" + method\n 958 | \n 959 |         est = MiniBatchDictionaryLearning(\n 960 |             n_components=n_components,\n 961 |             alpha=alpha,\n 962 |             n_iter=n_iter,\n 963 |             n_jobs=n_jobs,\n 964 |             fit_algorithm=method,\n 965 |             batch_size=batch_size,\n 966 |             shuffle=shuffle,\n 967 |             dict_init=dict_init,\n 968 |             random_state=random_state,\n 969 |             transform_algorithm=transform_algorithm,\n 970 |             transform_alpha=alpha,\n 971 |             positive_code=positive_code,\n 972 |             positive_dict=positive_dict,\n 973 |             transform_max_iter=method_max_iter,\n 974 |             verbose=verbose,\n 975 |             callback=callback,\n 976 |             tol=tol,\n 977 |             max_no_improvement=max_no_improvement,\n 978 |         ).fit(X)\n 979 | \n 980 |         if not return_code:\n 981 |             return est.components_\n 982 |         else:\n 983 |             code = est.transform(X)\n 984 |             return code, est.components_\n 985 | \n 986 |     # TODO remove the whole old behavior in 1.3\n 987 |     # Fallback to old behavior\n 988 | \n 989 |     n_iter = _check_warn_deprecated(\n 990 |         n_iter, \"n_iter\", default=100, additional_message=\"Use 'max_iter' instead.\"\n 991 |     )\n 992 | \n 993 |     if batch_size == \"warn\":\n 994 |         warnings.warn(\n 995 |             \"The default value of batch_size will change from 3 to 256 in 1.3.\",\n 996 |             FutureWarning,\n 997 |         )\n 998 |         batch_size = 3\n 999 | \n1000 |     if n_components is None:\n1001 |         n_components = X.shape[1]\n1002 | \n1003 |     if method not in (\"lars\", \"cd\"):\n1004 |         raise ValueError(\"Coding method not supported as a fit algorithm.\")\n1005 | \n1006 |     _check_positive_coding(method, positive_code)\n1007 | \n1008 |     method = \"lasso_\" + method\n1009 | \n1010 |     t0 = time.time()\n1011 |     n_samples, n_features = X.shape\n1012 |     # Avoid integer division problems\n1013 |     alpha = float(alpha)\n1014 |     random_state = check_random_state(random_state)\n1015 | \n1016 |     # Init V with SVD of X\n1017 |     if dict_init is not None:\n1018 |         dictionary = dict_init\n1019 |     else:\n1020 |         _, S, dictionary = random