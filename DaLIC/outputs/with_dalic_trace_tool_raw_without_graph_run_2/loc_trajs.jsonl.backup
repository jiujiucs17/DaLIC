5 |     .. versionadded:: 1.2\n2456 | \n2457 |     Parameters\n2458 |     ----------\n2459 |     estimator : estimator instance\n2460 | \n2461 |     monotonic_cst : array-like of int, dict of str or None, default=None\n2462 |         Monotonic constraints for the features.\n2463 | \n2464 |         - If array-like, then it should contain only -1, 0 or 1. Each value\n2465 |             will be checked to be in [-1, 0, 1]. If a value is -1, then the\n2466 |             corresponding feature is required to be monotonically decreasing.\n2467 |         - If dict, then it the keys should be the feature names occurring in\n2468 |             `estimator.feature_names_in_` and the values should be -1, 0 or 1.\n2469 |         - If None, then an array of 0s will be allocated.\n2470 | \n2471 |     Returns\n2472 |     -------\n2473 |     monotonic_cst : ndarray of int\n2474 |         Monotonic constraints for each feature.\n2475 |     \"\"\"\n2476 |     original_monotonic_cst = monotonic_cst\n2477 |     if monotonic_cst is None or isinstance(monotonic_cst, dict):\n2478 |         monotonic_cst = np.full(\n2479 |             shape=estimator.n_features_in_,\n2480 |             fill_value=0,\n2481 |             dtype=np.int8,\n2482 |         )\n2483 |         if isinstance(original_monotonic_cst, dict):\n2484 |             if not hasattr(estimator, \"feature_names_in_\"):\n2485 |                 raise ValueError(\n2486 |                     f\"{estimator.__class__.__name__} was not fitted on data \"\n2487 |                     \"with feature names. Pass monotonic_cst as an integer \"\n2488 |                     \"array instead.\"\n2489 |                 )\n2490 |             unexpected_feature_names = list(\n2491 |                 set(original_monotonic_cst) - set(estimator.feature_names_in_)\n2492 |             )\n2493 |             unexpected_feature_names.sort()  # deterministic error message\n2494 |             n_unexpeced = len(unexpected_feature_names)\n2495 |             if un