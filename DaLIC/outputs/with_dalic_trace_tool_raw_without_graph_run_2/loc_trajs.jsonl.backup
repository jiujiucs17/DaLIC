 this error, either use a version\"\n477 |                         \" of scipy `>=1.9.2` or alter the `PolynomialFeatures`\"\n478 |                         \" transformer to produce fewer than 2^31 output features\"\n479 |                     )\n480 |                 XP = sparse.hstack(to_stack, dtype=X.dtype, format=\"csr\")\n481 |         elif sparse.isspmatrix_csc(X) and self._max_degree < 4:\n482 |             return self.transform(X.tocsr()).tocsc()\n483 |         elif sparse.isspmatrix(X):\n484 |             combinations = self._combinations(\n485 |                 n_features=n_features,\n486 |                 min_degree=self._min_degree,\n487 |                 max_degree=self._max_degree,\n488 |                 interaction_only=self.interaction_only,\n489 |                 include_bias=self.include_bias,\n490 |             )\n491 |             columns = []\n492 |             for combi in combinations:\n493 |                 if combi:\n494 |                     out_col = 1\n495 |                     for col_idx in combi:\n496 |                         out_col = X[:, col_idx].multiply(out_col)\n497 |                     columns.append(out_col)\n498 |                 else:\n499 |                     bias = sparse.csc_matrix(np.ones((X.shape[0], 1)))\n500 |                     columns.append(bias)\n501 |             XP = sparse.hstack(columns, dtype=X.dtype).tocsc()\n502 |         else:\n503 |             # Do as if _min_degree = 0 and cut down array after the\n504 |             # computation, i.e. use _n_out_full instead of n_output_features_.\n505 |             XP = np.empty(\n506 |                 shape=(n_samples, self._n_out_full), dtype=X.dtype, order=self.order\n507 |             )\n508 | \n509 |             # What follows is a faster implementation of:\n510 |             # for i, comb in enumerate(combinations):\n511 |             #     XP[:, i] = X[:, comb].prod(1)\n512 |             # This implementation uses two optimisations.\n513 |             # First one is broadcasting,\n514 |             # multiply ([X1, ..., Xn], X1) -> [X1 X1, ..., Xn X1]\n515 |             # multiply ([X2, ..., Xn], X2) -> [X2 X2, ..., Xn X2]\n516 |             # ...\n517 |             # multiply ([X[:, start:end], X[:, start]) -> ...\n518 |             # Second optimisation happens for degrees >= 3.\n519 |             # Xi^3 is computed reusing previous computation:\n520 |             # Xi^3 = Xi^2 * Xi.\n521 | \n522 |             # degree 0 term\n523 |             if self.include_bias:\n524 |                 XP[:, 0] = 1\n525 |                 current_col = 1\n526 |             else:\n527 |                 current_col = 0\n528 | \n529 |             if self._max_degree == 0:\n530 |                 return XP\n531 | \n532 |             # degree 1 term\n533 |             XP[:, current_col : current_col + n_features] = X\n534 |             index = list(range(current_col, current_col + n_features))\n535 |             current_col += n_features\n536 |             index.append(current_col)\n537 | \n538 |             # loop over degree >= 2 terms\n539 |             for _ in range(2, self._max_degree + 1):\n540 |                 new_index = []\n541 |                 end = index[-1]\n542 |                 for feature_idx in range(n_features):\n543 |                     start = index[feature_idx]\n544 |                     new_index.append(current_col)\n545 |                     if self.interaction_only:\n546 |                         start += index[feature_idx + 1] - index[feature_idx]\n547 |                     next_col = current_col + end - start\n548 |                     if next_col <= current_col:\n549 |                         break\n550 |                     # XP[:, start:end] are terms of degree d - 1\n551 |                     # that exclude feature #feature_idx.\n552 |                     np.multiply(\n553 |                         XP[:, start:end],\n554 |                         X[:, feature_idx : feature_idx + 1],\n555 |                         out=XP[:, current_col:next_col],\n556 |                         casting=\"no\",\n557 |                     )\n558 |                     current_col = next_col\n559 | \n560 |                 new_index.append(current_col)\n561 |                 index = new_index\n562 | \n563 |             if self._min_degree > 1:\n564 |                 n_XP, n_Xout = self._n_out_full, self.n_output_features_\n565 |                 if self.include_bias:\n566 |                     Xout = np.empty(\n567 |                         shape=(n_samples, n_Xout), dtype=XP.dtype, order=self.order\n568 |                     )\n569 |                     Xout[:, 0] = 1\n570 |                     Xout[:, 1:] = XP[:, n_XP - n_Xout + 1 :]\n571 |                 else:\n572 |                     Xout = XP[:, n_XP - n_Xout :].copy()\n573 |                 XP = Xout\n574 |         return XP\n```\n\nFound function `sklearn/neighbors/_base.py:sort_graph_by_row_values`.\nSource: Retrieved code content using keyword search (bm25).\n```\n207 | def sort_graph_by_row_values(graph, copy=False, warn_when_not_sorted=True):\n208 |     \"\"\"Sort a sparse graph such that each row is stored with increasing values.\n209 | \n210 |     .. versionadded:: 1.2\n211 | \n212 |     Parameters\n213 |     ----------\n214 |     graph : sparse matrix of shape (n_samples, n_samples)\n215 |         Distance matrix to other samples, where only non-zero elements are\n216 |         considered neighbors. Matrix is converted to CSR format if not already.\n217 | \n218 |     copy : bool, default=False\n219 |         If True, the graph is copied before sorting. If False, the sorting is\n220 |         performed inplace. If the graph is not of CSR format, `copy` must be\n221 |         True to allow the conversion to CSR format, otherwise an error is\n222 |         raised.\n223 | \n224 |     warn_when_not_sorted : bool, default=True\n225 |         If True, a :class:`~sklearn.exceptions.EfficiencyWarning` is raised\n226 |         when the input graph is not sorted by row values.\n227 | \n228 |     Returns\n229 |     -------\n230 |     graph : sparse matrix of shape (n_samples, n_samples)\n231 |         Distance matrix to other samples, where only non-zero elements are\n232 |         considered neighbors. Matrix is in CSR format.\n233 |     \"\"\"\n234 |     if graph.format == \"csr\" and _is_sorted_by_data(graph):\n235 |         return graph\n236 | \n237 |     if warn_when_not_sorted:\n238 |         warnings.warn(\n239 |             (\n240 |                 \"Precomputed sparse input was not sorted by row values. Use the\"\n241 |                 \" function sklearn.neighbors.sort_graph_by_row_values to sort the input\"\n242 |                 \" by row values, with warn_when_not_sorted=False to remove this\"\n243 |                 \" warning.\"\n244 |             ),\n245 |             EfficiencyWarning,\n246 |         )\n247 | \n248 |     if graph.format not in (\"csr\", \"csc\", \"coo\", \"lil\"):\n249 |         raise TypeError(\n250 |             f\"Sparse matrix in {graph.format!r} format is not supported due to \"\n251 |             \"its handling of explicit zeros\"\n252 |         )\n253 |     elif graph.format != \"csr\":\n254 |         if not copy:\n255 |             raise ValueError(\n256 |                 \"The input graph is not in CSR format. Use copy=True to allow \"\n257 |                 \"the conversion to CSR format.\"\n258 |             )\n259 |         graph = graph.asformat(\"csr\")\n260 |     elif copy:  # csr format with copy=True\n261 |         graph = graph.copy()\n262 | \n263 |     row_nnz = np.diff(graph.indptr)\n264 |     if row_nnz.max() == row_nnz.min():\n265 |         # if each sample has the same number of provided neighbors\n266 |         n_samples = graph.shape[0]\n267 |         distances = graph.data.reshape(n_samples, -1)\n268 | \n269 |         order = np.argsort(distances, kind=\"mergesort\")\n270 |         order += np.arange(n_samples)[:, None] * row_nnz[0]\n271 |         order = order.ravel()\n272 |         graph.data = graph.data[order]\n273 |         graph.indices = graph.indices[order]\n274 | \n275 |     else:\n276 |         for start, stop in zip(graph.indptr, graph.indptr[1:]):\n277 |             order = np.argsort(graph.data[start:stop], kind=\"mergesort\")\n278 |             graph.data[start:stop] = graph.data[start:stop][order]\n279 |             graph.indices[start:stop] = graph.indices[start:stop][order]\n280 | \n281 |     return graph\n```\n\nFound function `sklearn/metrics/_pairwise_distances_reduction/_dispatcher.py:BaseDistancesReductionDispatcher.compute`.\nSource: Retrieved code content using keyword search (bm25).\n```\n132 | def compute(\n133 |         cls,\n134 |         X,\n135 |         Y,\n136 |         **kwargs,\n137 |     ):\n138 |         \"\"\"Compute the reduction.\n139 | \n140 |         Parameters\n141 |         ----------\n142 |         X : ndarray or CSR matrix of shape (n_samples_X, n_features)\n143 |             Input data.\n144 | \n145 |         Y : ndarray or CSR matrix of shape (n_samples_Y, n_features)\n146 |             Input data.\n147 | \n148 |         **kwargs : additional parameters for the reduction\n149 | \n150 |         Notes\n151 |         -----\n152 |         This method is an abstract class method: it has to be implemented\n153 |         for all subclasses.\n154 |         \"\"\"\n```\n\nFound function `sklearn/utils/sparsefuncs.py:inplace_swap_row`.\nSource: Retrieved code content using keyword search (bm25).\n```\n359 | def inplace_swap_row(X, m, n):\n360 |     \"\"\"\n361 |     Swap two rows of a CSC/CSR matrix in-place.\n362 | \n363 |     Parameters\n364 |     ----------\n365 |     X : sparse matrix of shape (n_samples, n_features)\n366 |         Matrix whose two rows are to be swapped. It should be of CSR or\n367 |         CSC format.\n368 | \n369 |     m : int\n370 |         Index of the row of X to be swapped.\n371 | \n372 |     n : int\n373 |         Index of the row of