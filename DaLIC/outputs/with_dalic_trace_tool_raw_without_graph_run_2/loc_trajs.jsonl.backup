ataFrame or None\n5680 |         \"\"\"\n5681 |         # Operate column-wise\n5682 |         res = self if inplace else self.copy(deep=False)\n5683 |         ax = self.columns\n5684 | \n5685 |         for i, ax_value in enumerate(ax):\n5686 |             if ax_value in mapping:\n5687 |                 ser = self.iloc[:, i]\n5688 | \n5689 |                 target, value = mapping[ax_value]\n5690 |                 newobj = ser.replace(target, value, regex=regex)\n5691 | \n5692 |                 res._iset_item(i, newobj, inplace=inplace)\n5693 | \n5694 |         if inplace:\n5695 |             return None\n5696 |         return res.__finalize__(self)\n```\n\nFound class `asv_bench/benchmarks/frame_methods.py:Interpolate`.\nSource: Retrieved code content using keyword search (bm25).\n```\n585 | class Interpolate:\n586 |     def setup(self):\n587 |         N = 10000\n588 |         # this is the worst case, where every column has NaNs.\n589 |         arr = np.random.randn(N, 100)\n590 |         arr[::2] = np.nan\n591 | \n592 |         self.df = DataFrame(arr)\n593 | \n594 |         self.df2 = DataFrame(\n595 |             {\n596 |                 \"A\": np.arange(0, N),\n597 |                 \"B\": np.random.randint(0, 100, N),\n598 |                 \"C\": np.random.randn(N),\n599 |                 \"D\": np.random.randn(N),\n600 |             }\n601 |         )\n602 |         self.df2.loc[1::5, \"A\"] = np.nan\n603 |         self.df2.loc[1::5, \"C\"] = np.nan\n604 | \n605 |     def time_interpolate(self):\n606 |         self.df.interpolate()\n607 | \n608 |     def time_interpolate_some_good(self):\n609 |         self.df2.interpolate()\n```\n\nFound function `pandas/core/generic.py:NDFrame.interpolate`.\nFound function `pandas/core/internals/blocks.py:Block.interpolate`.\nFound function `pandas/core/internals/managers.py:BaseBlockManager.interpolate`.\nFound function `pandas/core/arrays/numpy_.py:NumpyExtensionArray.interpolate`.\nFound function `pandas/core/arrays/mas