er_path\n2062 |         # cost of XObject is len_path + 5 for the definition,\n2063 |         #    uses_per_path for the uses\n2064 |         len_path = len(paths[0].vertices) if len(paths) > 0 else 0\n2065 |         uses_per_path = self._iter_collection_uses_per_path(\n2066 |             paths, all_transforms, offsets, facecolors, edgecolors)\n2067 |         should_do_optimization = \\\n2068 |             len_path + uses_per_path + 5 < len_path * uses_per_path\n2069 | \n2070 |         if (not can_do_optimization) or (not should_do_optimization):\n2071 |             return RendererBase.draw_path_collection(\n2072 |                 self, gc, master_transform, paths, all_transforms,\n2073 |                 offsets, offset_trans, facecolors, edgecolors,\n2074 |                 linewidths, linestyles, antialiaseds, urls,\n2075 |                 offset_position)\n2076 | \n2077 |         padding = np.max(linewidths)\n2078 |         path_codes = []\n2079 |         for i, (path, transform) in enumerate(self._iter_collection_raw_paths(\n2080 |                 master_transform, paths, all_transforms)):\n2081 |             name = self.file.pathCollectionObject(\n2082 |                 gc, path, transform, padding, filled, stroked)\n2083 |             path_codes.append(name)\n2084 | \n2085 |         output = self.file.output\n2086 |         output(*self.gc.push())\n2087 |         lastx, lasty = 0, 0\n2088 |         for xo, yo, path_id, gc0, rgbFace in self._iter_collection(\n2089 |                 gc, path_codes, offsets, offset_trans,\n2090 |                 facecolors, edgecolors, linewidths, linestyles,\n2091 |                 antialiaseds, urls, offset_position):\n2092 | \n2093 |             self.check_gc(gc0, rgbFace)\n2094 |             dx, dy = xo - lastx, yo - lasty\n2095 |             output(1, 0, 0, 1, dx, dy, Op.concat_matrix, path_id,\n2096 |                    Op.use_xobject)\n2097 |             lastx, lasty = xo, yo\n2098 |         output(*self.gc.pop())\n```\n\n\n\n##Searching for term \"color\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/individual_colors_from_cmap.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ===========================================\n 3 | Selecting individual colors from a colormap\n 4 | ===========================================\n 5 | \n 6 | Sometimes we want to use more colors or a different set of colors than the default color\n 7 | cycle provides. Selecting individual colors from one of the provided colormaps can be a\n 8 | convenient way to do this.\n 9 | \n10 | We can retrieve colors from any `.Colormap` by calling it with a float or a list of\n11 | floats in the range [0, 1]; e.g. ``cmap(0.5)`` will give the middle color. See also\n12 | `.Colormap.__call__`.\n13 | \n14 | Extracting colors from a continuous colormap\n15 | --------------------------------------------\n16 | \"\"\"\n17 | \n18 | import matplotlib.pyplot as plt\n19 | import numpy as np\n20 | \n21 | import matplotlib as mpl\n22 | \n23 | n_lines = 21\n24 | cmap = mpl.colormaps['plasma']\n25 | \n26 | # Take colors at regular intervals spanning the colormap.\n27 | colors = cmap(np.linspace(0, 1, n_lines))\n28 | \n29 | fig, ax = plt.subplots(layout='constrained')\n30 | \n31 | for i, color in enumerate(colors):\n32 |     ax.plot([0, i], color=color)\n33 | \n34 | plt.show()\n35 | \n36 | # %%\n37 | #\n38 | # Extracting colors from a discrete colormap\n39 | # ------------------------------------------\n40 | # The list of all colors in a `.ListedColormap` is available as the ``colors``\n41 | # attribute.\n42 | \n43 | colors = mpl.colormaps['Dark2'].colors\n44 | \n45 | fig, ax = plt.subplots(layout='constrained')\n46 | \n47 | for i, color in enumerate(colors):\n48 |     ax.plot([0, i], color=color)\n49 | \n50 | plt.show()\n51 | \n52 | # %%\n53 | # See Also\n54 | # --------\n55 | #\n56 | # For more details about manipulating colormaps, see :ref:`colormap-manipulation`.  To\n57 | # change the default color cycle, see :ref:`color_cycle`.\n58 | #\n59 | # .. admonition:: References\n60 | #\n61 | #    The use of the following functions, methods, classes and modules is shown\n62 | #    in this example:\n63 | #\n64 | #    - `matplotlib.colors.Colormap`\n65 | #    - `matplotlib.colors.Colormap.resampled`\n66 | #\n67 | # .. tags::\n68 | #\n69 | #    component: colormap\n70 | #    styling: color\n71 | #    plot-type: line\n72 | #    level: intermediate\n73 | \n```\n\nFound class `lib/matplotlib/colorizer.py:Colorizer`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Colorizer:\n    def __init__(self, cmap=None, norm=None):\n...\n    def _scale_norm(self, norm, vmin, vmax, A):\n...\n    @property\n    def norm(self):\n...\n    @norm.setter\n    def norm(self, norm):\n...\n    def to_rgba(self, x, alpha=None, bytes=False, norm=True):\n...\n    @staticmethod\n    def _pass_image_data(x, alpha=None, bytes=False, norm=True):\n...\n    def autoscale(self, A):\n...\n    def autoscale_None(self, A):\n...\n    def _set_cmap(self, cmap):\n...\n    @property\n    def cmap(self):\n...\n    @cmap.setter\n    def cmap(self, cmap):\n...\n    def set_clim(self, vmin=None, vmax=None):\n...\n    def get_clim(self):\n...\n    def changed(self):\n...\n    @property\n    def vmin(self):\n...\n    @vmin.setter\n    def vmin(self, vmin):\n...\n    @property\n    def vmax(self):\n...\n    @vmax.setter\n    def vmax(self, vmax):\n...\n    @property\n    def clip(self):\n...\n    @clip.setter\n    def clip(self, clip):\n\n```\nHint: Search `lib/matplotlib/colorizer.py:Colorizer` to get the full content if needed.\n\nFound function `lib/matplotlib/colorizer.py:Colorizer.autoscale_None`.\nSource: Retrieved entity using keyword search (bm25).\n```\n215 | def autoscale_None(self, A):\n216 |         \"\"\"\n217 |         Autoscale the scalar limits on the norm instance using the