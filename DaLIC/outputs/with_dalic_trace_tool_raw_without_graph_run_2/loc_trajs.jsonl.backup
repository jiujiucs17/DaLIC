"Expected ax to have {} axes, got {}\".format(n_features, ax.size)\n1017 |                 )\n1018 | \n1019 |             if ax.ndim == 2:\n1020 |                 n_cols = ax.shape[1]\n1021 |             else:\n1022 |                 n_cols = None\n1023 | \n1024 |             self.bounding_ax_ = None\n1025 |             self.figure_ = ax.ravel()[0].figure\n1026 |             self.axes_ = ax\n1027 |             if self.kind == \"average\":\n1028 |                 self.lines_ = np.empty_like(ax, dtype=object)\n1029 |             else:\n1030 |                 self.lines_ = np.empty(ax.shape + (n_lines,), dtype=object)\n1031 |             self.contours_ = np.empty_like(ax, dtype=object)\n1032 | \n1033 |         # create contour levels for two-way plots\n1034 |         if 2 in self.pdp_lim:\n1035 |             Z_level = np.linspace(*self.pdp_lim[2], num=8)\n1036 | \n1037 |         self.deciles_vlines_ = np.empty_like(self.axes_, dtype=object)\n1038 |         self.deciles_hlines_ = np.empty_like(self.axes_, dtype=object)\n1039 | \n1040 |         for pd_plot_idx, (axi, feature_idx, pd_result) in enumerate(\n1041 |             zip(self.axes_.ravel(), self.features, self.pd_results)\n1042 |         ):\n1043 |             avg_preds = None\n1044 |             preds = None\n1045 |             feature_values = pd_result[\"values\"]\n1046 |             if self.kind == \"individual\":\n1047 |                 preds = pd_result.individual\n1048 |             elif self.kind == \"average\":\n1049 |                 avg_preds = pd_result.average\n1050 |             else:  # kind='both'\n1051 |                 avg_preds = pd_result.average\n1052 |                 preds = pd_result.individual\n1053 | \n1054 |             if len(feature_values) == 1:\n1055 |                 self._plot_one_way_partial_dependence(\n1056 |                     preds,\n1057 |                     avg_preds,\n1058 |                     feature_values[0],\n1059 |                     feature_idx,\n1060 |           