r if no additional arguments are\n277 |         needed.\n278 | \n279 |     Examples\n280 |     --------\n281 |     {examples}\n282 |     \"\"\"\n283 | \n284 |     def decorator(accessor: TypeT) -> TypeT:\n285 |         if hasattr(cls, name):\n286 |             warnings.warn(\n287 |                 f\"registration of accessor {accessor!r} under name \"\n288 |                 f\"{name!r} for type {cls!r} is overriding a preexisting \"\n289 |                 f\"attribute with the same name.\",\n290 |                 UserWarning,\n291 |                 stacklevel=find_stack_level(),\n292 |             )\n293 |         setattr(cls, name, Accessor(name, accessor))\n294 |         cls._accessors.add(name)\n295 |         return accessor\n296 | \n297 |     return decorator\n```\n\n\n\n##Searching for term \"AttributeError\"...\n### Search Result:\nFound class `pandas/errors/__init__.py:AttributeConflictWarning`.\nSource: Retrieved entity using keyword search (bm25).\n```\n648 | class AttributeConflictWarning(Warning):\n649 |     \"\"\"\n650 |     Warning raised when index attributes conflict when using HDFStore.\n651 | \n652 |     Occurs when attempting to append an index with a different\n653 |     name than the existing index on an HDFStore or attempting to append an index with a\n654 |     different frequency than the existing index on an HDFStore.\n655 | \n656 |     Examples\n657 |     --------\n658 |     >>> idx1 = pd.Index([\"a\", \"b\"], name=\"name1\")\n659 |     >>> df1 = pd.DataFrame([[1, 2], [3, 4]], index=idx1)\n660 |     >>> df1.to_hdf(\"file\", \"data\", \"w\", append=True)  # doctest: +SKIP\n661 |     >>> idx2 = pd.Index([\"c\", \"d\"], name=\"name2\")\n662 |     >>> df2 = pd.DataFrame([[5, 6], [7, 8]], index=idx2)\n663 |     >>> df2.to_hdf(\"file\", \"data\", \"a\", append=True)  # doctest: +SKIP\n664 |     AttributeConflictWarning: the [index_name] attribute of the existing index is\n665 |     [name1] which conflicts with the new [name2]...\n666 |     \"\"\"\