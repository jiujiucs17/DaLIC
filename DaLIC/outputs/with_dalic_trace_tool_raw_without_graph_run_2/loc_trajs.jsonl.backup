rue, random_init=True, parallel=parallel\n505 |         )\n506 | \n507 |         # M-step\n508 |         if batch_update:\n509 |             self.components_ = self.topic_word_prior_ + suff_stats\n510 |         else:\n511 |             # online update\n512 |             # In the literature, the weight is `rho`\n513 |             weight = np.power(\n514 |                 self.learning_offset + self.n_batch_iter_, -self.learning_decay\n515 |             )\n516 |             doc_ratio = float(total_samples) / X.shape[0]\n517 |             self.components_ *= 1 - weight\n518 |             self.components_ += weight * (\n519 |                 self.topic_word_prior_ + doc_ratio * suff_stats\n520 |             )\n521 | \n522 |         # update `component_` related variables\n523 |         self.exp_dirichlet_component_ = np.exp(\n524 |             _dirichlet_expectation_2d(self.components_)\n525 |         )\n526 |         self.n_batch_iter_ += 1\n527 |         return\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:_update_dict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n415 | def _update_dict(\n416 |     dictionary,\n417 |     Y,\n418 |     code,\n419 |     A=None,\n420 |     B=None,\n421 |     verbose=False,\n422 |     random_state=None,\n423 |     positive=False,\n424 | ):\n425 |     \"\"\"Update the dense dictionary factor in place.\n426 | \n427 |     Parameters\n428 |     ----------\n429 |     dictionary : ndarray of shape (n_components, n_features)\n430 |         Value of the dictionary at the previous iteration.\n431 | \n432 |     Y : ndarray of shape (n_samples, n_features)\n433 |         Data matrix.\n434 | \n435 |     code : ndarray of shape (n_samples, n_components)\n436 |         Sparse coding of the data against which to optimize the dictionary.\n437 | \n438 |     A : ndarray of shape (n_components, n_components), default=None\n439 |         Together with `B`, sufficient stats of the online model to update the\n440 |         dictionary.\n441 | \n442 |     B : ndarray of shape (n_features, n_components), default=None\n443 |         Together with `A`, sufficient stats of the online model to update the\n444 |         dictionary.\n445 | \n446 |     verbose: bool, default=False\n447 |         Degree of output the procedure will print.\n448 | \n449 |     random_state : int, RandomState instance or None, default=None\n450 |         Used for randomly initializing the dictionary. Pass an int for\n451 |         reproducible results across multiple function calls.\n452 |         See :term:`Glossary <random_state>`.\n453 | \n454 |     positive : bool, default=False\n455 |         Whether to enforce positivity when finding the dictionary.\n456 | \n457 |         .. versionadded:: 0.20\n458 |     \"\"\"\n459 |     n_samples, n_components = code.shape\n460 |     random_state = check_random_state(random_state)\n461 | \n462 |     if A is None:\n463 |         A = code.T @ code\n464 |     if B is None:\n465 |         B = Y.T @ code\n466 | \n467 |     n_unused = 0\n468 | \n469 |     for k in range(n_components):\n470 |         if A[k, k] > 1e-6:\n471 |             # 1e-6 is arbitrary but consistent with the spams implementation\n472 |             dictionary[k] += (B[:, k] - A[k] @ dictionary) / A[k, k]\n473 |         else:\n474 |             # kth atom is almost never used -> sample a new one from the data\n475 |             newd = Y[random_state.choice(n_samples)]\n476 | \n477 |             # add small noise to avoid making the sparse coding ill conditioned\n478 |             noise_level = 0.01 * (newd.std() or 1)  # avoid 0 std\n479 |             noise = random_state.normal(0, noise_level, size=len(newd))\n480 | \n481 |             dictionary[k] = newd + noise\n482 |             code[:, k] = 0\n483 |             n_unused += 1\n484 | \n485 |         if positive:\n486 |             np.clip(dictionary[k], 0, None, out=dictionary[k])\n487 | \n488 |         # Projection on the constraint set ||V_k|| <= 1\n