sion(n_samples=200, n_features=5000, random_state=0)\n32 | # create a copy of X in sparse format\n33 | X_sp = sparse.coo_matrix(X)\n34 | \n35 | alpha = 1\n36 | sparse_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n37 | dense_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n38 | \n39 | t0 = time()\n40 | sparse_lasso.fit(X_sp, y)\n41 | print(f\"Sparse Lasso done in {(time() - t0):.3f}s\")\n42 | \n43 | t0 = time()\n44 | dense_lasso.fit(X, y)\n45 | print(f\"Dense Lasso done in {(time() - t0):.3f}s\")\n46 | \n47 | # compare the regression coefficients\n48 | coeff_diff = linalg.norm(sparse_lasso.coef_ - dense_lasso.coef_)\n49 | print(f\"Distance between coefficients : {coeff_diff:.2e}\")\n50 | \n51 | #\n52 | # %%\n53 | # Comparing the two Lasso implementations on Sparse data\n54 | # ------------------------------------------------------\n55 | #\n56 | # We make the previous problem sparse by replacing all small values with 0\n57 | # and run the same comparisons as above. Because the data is now sparse, we\n58 | # expect the implementation that uses the sparse data format to be faster.\n59 | \n60 | # make a copy of the previous data\n61 | Xs = X.copy()\n62 | # make Xs sparse by replacing the values lower than 2.5 with 0s\n63 | Xs[Xs < 2.5] = 0.0\n64 | # create a copy of Xs in sparse format\n```\n\nFound function `sklearn/utils/extmath.py:safe_sparse_dot`.\nSource: Retrieved code content using keyword search (bm25).\n```\n160 | def safe_sparse_dot(a, b, *, dense_output=False):\n161 |     \"\"\"Dot product that handle the sparse matrix case correctly.\n162 | \n163 |     Parameters\n164 |     ----------\n165 |     a : {ndarray, sparse matrix}\n166 |     b : {ndarray, sparse matrix}\n167 |     dense_output : bool, default=False\n168 |         When False, ``a`` and ``b`` both being sparse will yield sparse output.\n169 |         When True, output will always be a dense array.\n170 | \n171 |     Returns\n172 |     -------\n173 |     dot_product : {ndarray, sparse matrix}\n174 |         Sparse if ``a`` and ``b`` are sparse and ``dense_output=False``.\n175 |     \"\"\"\n176 |     if a.ndim > 2 or b.ndim > 2:\n177 |         if sparse.issparse(a):\n178 |             # sparse is always 2D. Implies b is 3D+\n179 |             # [i, j] @ [k, ..., l, m, n] -> [i, k, ..., l, n]\n180 |             b_ = np.rollaxis(b, -2)\n181 |             b_2d = b_.reshape((b.shape[-2], -1))\n182 |             ret = a @ b_2d\n183 |             ret = ret.reshape(a.shape[0], *b_.shape[1:])\n184 |         elif sparse.issparse(b):\n185 |             # sparse is always 2D. Implies a is 3D+\n186 |             # [k, ..., l, m] @ [i, j] -> [k, ..., l, j]\n187 |             a_2d = a.reshape(-1, a.shape[-1])\n188 |             ret = a_2d @ b\n189 |             ret = ret.reshape(*a.shape[:-1], b.shape[1])\n190 |         else:\n191 |             ret = np.dot(a, b)\n192 |     else:\n193 |         ret = a @ b\n194 | \n195 |     if (\n196 |         sparse.issparse(a)\n197 |         and sparse.issparse(b)\n198 |         and dense_output\n199 |         and hasattr(ret, \"toarray\")\n200 |     ):\n201 |         return ret.toarray()\n202 |     return ret\n```\n\nFound function `sklearn/metrics/pairwise.py:paired_distances`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1165 | def paired_distances(X, Y, *, metric=\"euclidean\", **kwds):\n1166 |     \"\"\"\n1167 |     Compute the paired distances between X and Y.\n1168 | \n1169 |     Compute the distances between (X[0], Y[0]), (X[1], Y[1]), etc...\n1170 | \n1171 |     Read more in the :ref:`User Guide <metrics>`.\n1172 | \n1173 |     Parameters\n1174 |     ----------\n1175 |     X : ndarray of shape (n_samples, n_features)\n1176 |         Array 1 for distance computation.\n1177 | \n1178 |     Y : ndarray of shape (n_samples, n_features)\n1179 |         Array 2 for distance computation.\n1180 | \n1181 |     metric : str or callable, default=\"euclidean\"\n1182 |         The metric to use when calculating distance between instances in a\n1183 |         feature array. If metric is a string, it must be one of the options\n1184 |         specified in PAIRED_DISTANCES, including \"euclidean\",\n1185 |         \"manhattan\", or \"cosine\".\n1186 |         Alternatively, if metric is a callable function, it is called on each\n1187 |         pair of instances (rows) and the resulting value recorded. The callable\n1188 |         should take two arrays from `X` as input and return a value indicating\n1189 |         the distance between them.\n1190 | \n1191 |     **kwds : dict\n1192 |         Unused parameters.\n1193 | \n1194 |     Returns\n1195 |     -------\n1196 |     distances : ndarray of shape (n_samples,)\n1197 |         Returns the distances between the row vectors of `X`\n1198 |         and the row vectors of `Y`.\n1199 | \n1200 |     See Also\n1201 |     --------\n1202 |     pairwise_distances : Computes the distance between every pair of samples.\n1203 | \n1204 |     Examples\n1205 |     --------\n1206 |     >>> from sklearn.metrics.pairwise import paired_distances\n1207 |     >>> X = [[0, 1], [1, 1]]\n1208 |     >>> Y = [[0, 1], [2, 1]]\n1209 |     >>> paired_distances(X, Y)\n1210 |     array([0., 1.])\n1211 |     \"\"\"\n1212 | \n1213 |     if metric in PAIRED_DISTANCES:\n1214 |         func = PAIRED_DISTANCES[metric]\n1215 |         return func(X, Y)\n1216 |     elif callable(metric):\n1217 |         # Check the matrix first (it is usually done by the metric)\n1218 |         X, Y = check_paired_arrays(X, Y)\n1219 |         distances = np.zeros(len(X))\n1220 |         for i in range(len(X)):\n1221 |             distances[i] = metric(X[i], Y[i])\n1222 |         return distances\n1223 |     else:\n1224 |         raise ValueError(\"Unknown distance %s\" % metric)\n```\n\nFound function `sklearn/metrics/pairwise.py:linear_kernel`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1235 | def linear_kernel(X, Y=None, dense_output=Tru