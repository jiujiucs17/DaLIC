\n830 |         indices = X.indices.copy()\n831 |         indptr = X.indptr.copy()\n832 | \n833 |         data_step = np.sqrt(X.data * sample_interval)\n834 |         X_step = sp.csr_matrix(\n835 |             (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n836 |         )\n837 |         X_new = [X_step]\n838 | \n839 |         log_step_nz = sample_interval * np.log(X.data)\n840 |         step_nz = 2 * X.data * sample_interval\n841 | \n842 |         for j in range(1, sample_steps):\n843 |             factor_nz = np.sqrt(step_nz / np.cosh(np.pi * j * sample_interval))\n844 | \n845 |             data_step = factor_nz * np.cos(j * log_step_nz)\n846 |             X_step = sp.csr_matrix(\n847 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n848 |             )\n849 |             X_new.append(X_step)\n850 | \n851 |             data_step = factor_nz * np.sin(j * log_step_nz)\n852 |             X_step = sp.csr_matrix(\n853 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n854 |             )\n855 |             X_new.append(X_step)\n856 | \n857 |         return sp.hstack(X_new)\n```\n\nFound function `sklearn/random_projection.py:_sparse_random_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n202 | def _sparse_random_matrix(n_components, n_features, density=\"auto\", random_state=None):\n203 |     \"\"\"Generalized Achlioptas random sparse matrix for random projection.\n204 | \n205 |     Setting density to 1 / 3 will yield the original matrix by Dimitris\n206 |     Achlioptas while setting a lower value will yield the generalization\n207 |     by Ping Li et al.\n208 | \n209 |     If we note :math:`s = 1 / density`, the components of the random matrix are\n210 |     drawn from:\n211 | \n212 |       - -sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n213 |       -  0                              with probability 1 - 1 / s\n214 |       - +sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n215 | \n216 |     Read more in the :ref:`User Guide <sparse_random_matrix>`.\n217 | \n218 |     Parameters\n219 |     ----------\n220 |     n_components : int,\n221 |         Dimensionality of the target projection space.\n222 | \n223 |     n_features : int,\n224 |         Dimensionality of the original source space.\n225 | \n226 |     density : float or 'auto', default='auto'\n227 |         Ratio of non-zero component in the random projection matrix in the\n228 |         range `(0, 1]`\n229 | \n230 |         If density = 'auto', the value is set to the minimum density\n231 |         as recommended by Ping Li et al.: 1 / sqrt(n_features).\n232 | \n233 |         Use density = 1 / 3.0 if you want to reproduce the results from\n234 |         Achlioptas, 2001.\n235 | \n236 |     random_state : int, RandomState instance or None, default=None\n237 |         Controls the pseudo random number generator used to generate the matrix\n238 |         at fit time.\n239 |         Pass an int for reproducible output across multiple function calls.\n240 |         See :term:`Glossary <random_state>`.\n241 | \n242 |     Returns\n243 |     -------\n244 |     components : {ndarray, sparse matrix} of shape (n_components, n_features)\n245 |         The generated Gaussian random matrix. Sparse matrix will be of CSR\n246 |         format.\n247 | \n248 |     See Also\n249 |     --------\n250 |     SparseRandomProjection\n251 | \n252 |     References\n253 |     ----------\n254 | \n255 |     .. [1] Ping Li, T. Hastie and K. W. Church, 2006,\n256 |            \"Very Sparse Random Projections\".\n257 |            https://web.stanford.edu/~hastie/Papers/Ping/KDD06_rp.pdf\n258 | \n259 |     .. [2] D. Achlioptas, 2001, \"Database-friendly random projections\",\n260 |            https://cgi.di.uoa.gr/~optas/papers/jl.pdf\n261 | \n262 |     \"\"\"\n263 |     _check_input_size(n_components, n_features)\n264 |     density = _check_density(density, n_features)\n265 |     rng = check_random_state(random_state)\n266 | \n267 |     if density == 1:\n268 |         # skip index generation if totally dense\n269 |         components = rng.binomial(1, 0.5, (n_components, n_features)) * 2 - 1\n270 |         return 1 / np.sqrt(n_components) * components\n271 | \n272 |     else:\n273 |         # Generate location of non zero elements\n274 |         indices = []\n275 |         offset = 0\n276 |         indptr = [offset]\n277 |         for _ in range(n_components):\n278 |             # find the indices of the non-zero components for row i\n279 |             n_nonzero_i = rng.binomial(n_features, density)\n280 |             indices_i = sample_without_replacement(\n281 |                 n_features, n_nonzero_i, random_state=rng\n282 |             )\n283 |             indices.append(indices_i)\n284 |             offset += n_nonzero_i\n285 |             indptr.append(offset)\n286 | \n287 |         indices = np.concatenate(indices)\n288 | \n289 |         # Among non zero components the probability of the sign is 50%/50%\n290 |         data = rng.binomial(1, 0.5, size=np.size(indices)) * 2 - 1\n291 | \n292 |         # build the CSR structure by concatenating the rows\n293 |         components = sp.csr_matrix(\n294 |             (data, indices, indptr), shape=(n_components, n_features)\n295 |         )\n296 | \n297 |         return np.sqrt(1 / density) / np.sqrt(n_components) * components\n```\n\n\n\n##Searching for term \"CSR\"...\n### Search Result:\nFound class `sklearn/svm/_classes.py:SVR`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass SVR(RegressorMixin, BaseLibSVM):\n\n    _impl = \"epsilon_svr\"\n\n    _parameter_constraints: dict = {**BaseLibSVM._parameter_constraints}\n    for unused_param in [\"class_weight\", \"nu\", \"probability\", \"random_state\"]:\n        _parameter_constraints.pop(unused_param)\n\n    def __init__(\n        sel