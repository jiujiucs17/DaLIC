)\n35 |         self.empty_left = [DataFrame(), df]\n36 |         self.empty_right = [df, DataFrame()]\n37 |         self.mixed_ndims = [df, df.head(N // 2)]\n38 | \n39 |     def time_concat_series(self, axis):\n40 |         concat(self.series, axis=axis, sort=False)\n41 | \n42 |     def time_concat_small_frames(self, axis):\n43 |         concat(self.small_frames, axis=axis)\n44 | \n45 |     def time_concat_empty_right(self, axis):\n46 |         concat(self.empty_right, axis=axis)\n47 | \n48 |     def time_concat_empty_left(self, axis):\n49 |         concat(self.empty_left, axis=axis)\n50 | \n51 |     def time_concat_mixed_ndims(self, axis):\n52 |         concat(self.mixed_ndims, axis=axis)\n```\n\nFound function `pandas/io/formats/excel.py:ExcelFormatter._format_header_mi`.\nSource: Retrieved code content using keyword search (bm25).\n```\n611 | def _format_header_mi(self) -> Iterable[ExcelCell]:\n612 |         if self.columns.nlevels > 1:\n613 |             if not self.index:\n614 |                 raise NotImplementedError(\n615 |                     \"Writing to Excel with MultiIndex columns and no \"\n616 |                     \"index ('index'=False) is not yet implemented.\"\n617 |                 )\n618 | \n619 |         if not (self._has_aliases or self.header):\n620 |             return\n621 | \n622 |         columns = self.columns\n623 |         level_strs = columns._format_multi(\n624 |             sparsify=self.merge_cells in {True, \"columns\"}, include_names=False\n625 |         )\n626 |         level_lengths = get_level_lengths(level_strs)\n627 |         coloffset = 0\n628 |         lnum = 0\n629 | \n630 |         if self.index and isinstance(self.df.index, MultiIndex):\n631 |             coloffset = self.df.index.nlevels - 1\n632 | \n633 |         if self.merge_cells in {True, \"columns\"}:\n634 |             # Format multi-index as a merged cells.\n635 |             for lnum, name in enumerate(columns.names):\n636 |                 yield ExcelCell(\