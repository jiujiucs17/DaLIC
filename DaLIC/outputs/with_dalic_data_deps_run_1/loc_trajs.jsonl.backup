\n  29 | \n  30 | def norm(x):\n  31 |     \"\"\"Dot product-based Euclidean norm implementation.\n  32 | \n  33 |     See: http://fseoane.net/blog/2011/computing-the-vector-norm/\n  34 | \n  35 |     Parameters\n  36 |     ----------\n  37 |     x : array-like\n  38 |         Vector for which to compute the norm.\n  39 |     \"\"\"\n  40 |     return sqrt(squared_norm(x))\n  41 | \n  42 | \n  43 | def trace_dot(X, Y):\n  44 |     \"\"\"Trace of np.dot(X, Y.T).\n  45 | \n  46 |     Parameters\n  47 |     ----------\n  48 |     X : array-like\n  49 |         First matrix.\n  50 |     Y : array-like\n  51 |         Second matrix.\n  52 |     \"\"\"\n  53 |     return np.dot(X.ravel(), Y.ravel())\n  54 | \n  55 | \n  56 | def _check_init(A, shape, whom):\n  57 |     A = check_array(A)\n  58 |     if np.shape(A) != shape:\n  59 |         raise ValueError(\n  60 |             \"Array with wrong shape passed to %s. Expected %s, but got %s \"\n  61 |             % (whom, shape, np.shape(A))\n  62 |         )\n  63 |     check_non_negative(A, whom)\n  64 |     if np.max(A) == 0:\n  65 |         raise ValueError(\"Array passed to %s is full of zeros.\" % whom)\n  66 | \n  67 | \n  68 | def _beta_divergence(X, W, H, beta, square_root=False):\n  69 |     \"\"\"Compute the beta-divergence of X and dot(W, H).\n  70 | \n  71 |     Parameters\n  72 |     ----------\n  73 |     X : float or array-like of shape (n_samples, n_features)\n  74 | \n  75 |     W : float or array-like of shape (n_samples, n_components)\n  76 | \n  77 |     H : float or array-like of shape (n_components, n_features)\n  78 | \n  79 |     beta : float or {'frobenius', 'kullback-leibler', 'itakura-saito'}\n  80 |         Parameter of the beta-divergence.\n  81 |         If beta == 2, this is half the Frobenius *squared* norm.\n  82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n  83 |         If beta == 0, this is the Itakura-Saito divergence.\n  84 |         Else, this is the general beta-divergence.\n  85 | \n  86 |     square_root : bool, default=False\n  87 |         If True, return np.sqrt(2 * res)\n  88 |         For beta == 2, it corresponds to the Frobenius norm.\n  89 | \n  90 |     Returns\n  91 |     -------\n  92 |         res : float\n  93 |             Beta divergence of X and np.dot(X, H).\n  94 |     \"\"\"\n  95 |     beta = _beta_loss_to_float(beta)\n  96 | \n  97 |     # The method can be called with scalars\n  98 |     if not sp.issparse(X):\n  99 |         X = np.atleast_2d(X)\n 100 |     W = np.atleast_2d(W)\n 101 |     H = np.atleast_2d(H)\n 102 | \n 103 |     # Frobenius norm\n 104 |     if beta == 2:\n 105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n 106 |         if sp.issparse(X):\n 107 |             norm_X = np.dot(X.data, X.data)\n 108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n 109 |             cross_prod = trace_dot((X * H.T), W)\n 110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n 111 |         else:\n 112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n 113 | \n 114 |         if square_root:\n 115 |             return np.sqrt(res * 2)\n 116 |         else:\n 117 |             return res\n 118 | \n 119 |     if sp.issparse(X):\n 120 |         # compute np.dot(W, H) only where X is nonzero\n 121 |         WH_data = _special_sparse_dot(W, H, X).data\n 122 |         X_data = X.data\n 123 |     else:\n 124 |         WH = np.dot(W, H)\n 125 |         WH_data = WH.ravel()\n 126 |         X_data = X.ravel()\n 127 | \n 128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n 129 |     indices = X_data > EPSILON\n 130 |     WH_data = WH_data[indices]\n 131 |     X_data = X_data[indices]\n 132 | \n 133 |     # used to avoid division by zero\n 134 |     WH_data[WH_data == 0] = EPSILON\n 135 | \n 136 |     # generalized Kullback-Leibler divergence\n 137 |     if beta == 1:\n 138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n 139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n 140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n 141 |         div = X_data / WH_data\n 142 |         res = np.dot(X_data, np.log(div))\n 143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n 144 |         res += sum_WH - X_data.sum()\n 145 | \n 146 |     # Itakura-Saito divergence\n 147 |     elif beta == 0:\n 148 |         div = X_data / WH_data\n 149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n 150 | \n 151 |     # beta-divergence, beta not in (0, 1, 2)\n 152 |     else:\n 153 |         if sp.issparse(X):\n 154 |             # slow loop, but memory efficient computation of :\n 155 |             # np.sum(np.dot(W, H) ** beta)\n 156 |             sum_WH_beta = 0\n 157 |             for i in range(X.shape[1]):\n 158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n 159 | \n 160 |         else:\n 161 |             sum_WH_beta = np.sum(WH**beta)\n 162 | \n 163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n 164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n 165 |         res += sum_WH_beta * (beta - 1)\n 166 |         res /= beta * (beta - 1)\n 167 | \n 168 |     if square_root:\n 169 |         return np.sqrt(2 * res)\n 170 |     else:\n 171 |         return res\n 172 | \n 173 | \n 174 | def _special_sparse_dot(W, H, X):\n 175 |     \"\"\"Computes np.dot(W, H), only where X is non zero.\"\"\"\n 176 |     if sp.issparse(X):\n 177 |         ii, jj = X.nonzero()\n 178 |         n_vals = ii.shape[0]\n 179 |         dot_vals = np.empty(n_vals)\n 180 |         n_components = W.shape[1]\n 181 | \n 182 |         batch_size = max(n_components, n_vals // n_components)\n 183 |         for start in range(0, n_vals, batch_size):\n 184 |             batch = slice(start, start + batch_size)\n 185 |             dot_vals[batch] = np.multiply(W[ii[batch], :], H.T[jj[batch], :]).sum(\n 186 |                 axis=1\n 187 |             )\n 188 | \n 189 |         WH = sp.coo_matrix((dot_vals, (ii, jj)), shape=X.shape)\n 190 |         return WH.tocsr()\n 191 |     else:\n 192 |         return np.dot(W, H)\n 193 | \n 194 | \n 195 | def _compute_regularization(alpha, alpha_W, alpha_H, l1_ratio, regularization):\n 196 |     \"\"\"Compute L1 and L2 regularization coefficients for W and H.\"\"\"\n 197 |     if alpha_W != 0 or alpha_H != \"same\":\n 198 |         # if alpha_W or alpha_H is not left to its default value we ignore alpha and\n 199 |         # regularization.\n 200 |         alpha_H = alpha_W if alpha_H == \"same\" else alpha_H\n 201 |         l1_reg_W = alpha_W * l1_ratio\n 202 |         l1_reg_H = alpha_H * l1_ratio\n 203 |         l2_reg_W = alpha_W * (1.0 - l1_ratio)\n 204 |         l2_reg_H = alpha_H * (1.0 - l1_ratio)\n 205 |     else:\n 206 |         # TODO remove in 1.2\n 207 |         l1_reg_W, l2_reg_W, l1_reg_H, l2_reg_H = 0.0, 0.0, 0.0, 0.0\n 208 |         if regularization in (\"both\", \"transformation\"):\n 209 |             l1_reg_W = alpha * l1_ratio\n 210 |             l2_reg_W = alpha * (1.0 - l1_ratio)\n 211 |         if regularization in (\"both\", \"components\"):\n 212 |             l1_reg_H = alpha * l1_ratio\n 213 |             l2_reg_H = alpha * (1.0 - l1_ratio)\n 214 | \n 215 |     return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n 216 | \n 217 | \n 218 | def _beta_loss_to_float(beta_loss):\n 219 |     \"\"\"Convert string beta_loss to float.\"\"\"\n 220 |     allowed_beta_loss = {\"frobenius\": 2, \"kullback-leibler\": 1, \"itakura-saito\": 0}\n 221 |     if isinstance(beta_loss, str) and beta_loss in allowed_beta_loss:\n 222 |         beta_loss = allowed_beta_loss[beta_loss]\n 223 | \n 224 |     if not isinstance(beta_loss, numbers.Number):\n 225 |         raise ValueError(\n 226 |             \"Invalid beta_loss parameter: got %r instead of one of %r, or a float.\"\n 227 |             % (beta_loss, allowed_beta_loss.keys())\n 228 |         )\n 229 |     return beta_loss\n 230 | \n 231 | \n 232 | def _initialize_nmf(X, n_components, init=None, eps=1e-6, random_state=None):\n 233 |     \"\"\"Algorithms for NMF initialization.\n 234 | \n 235 |     Computes an initial guess for the non-negative\n 236 |     rank k matrix approximation for X: X = WH.\n 237 | \n 238 |     Parameters\n 239 |     ----------\n 240 |     X : array-like of shape (n_samples, n_features)\n 241 |         The data matrix to be decomposed.\n 242 | \n 243 |     n_components : int\n 244 |         The number of components desired in the approximation.\n 245 | \n 246 |     init :  {'random', 'nndsvd', 'nndsvda', 'nndsvdar'}, default=None\n 247 |         Method used to initialize the procedure.\n 248 |         Valid options:\n 249 | \n 250 |         - None: 'nndsvda' if n_components <= min(n_samples, n_features),\n 251 |             otherwise 'random'.\n 252 | \n 253 |         - 'random': non-negative random matrices, scaled with:\n 254 |             sqrt(X.mean() / n_components)\n 255 | \n 256 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 257 |             initialization (better for sparseness)\n 258 | \n 259 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 260 |             (better when sparsity is not desired)\n 261 | \n 262 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 263 |             (generally faster, less accurate alternative to NNDSVDa\n 264 |             for when sparsity is not desired)\n 265 | \n 266 |         - 'custom': use custom matrices W and H\n 267 | \n 268 |         .. versionchanged:: 1.1\n 269 |             When `init=None` and n_components is less than n_samples and n_features\n 270 |             defaults to `nndsvda` instead of `nndsvd`.\n 271 | \n 272 |     eps : float, default=1e-6\n 273 |         Truncate all values less then this in output to zero.\n 274 | \n 275 |     random_state : int, RandomState instance or None, default=None\n 276 |         Used when ``init`` == 'nndsvdar' or 'random'. Pass an int for\n 277 |         reproducible results across multiple function calls.\n 278 |         See :term:`Glossary <random_state>`.\n 279 | \n 280 |     Returns\n 281 |     -------\n 282 |     W : array-like of shape (n_samples, n_components)\n 283 |         Initial guesses for solving X ~= WH.\n 284 | \n 285 |     H : array-like of shape (n_components, n_features)\n 286 |         Initial guesses for solving X ~= WH.\n 287 | \n 288 |     References\n 289 |     ----------\n 290 |     C. Boutsidis, E. Gallopoulos: SVD based initialization: A head start for\n 291 |     nonnegative matrix factorization - Pattern Recognition, 2008\n 292 |     http://tinyurl.com/nndsvd\n 293 |     \"\"\"\n 294 |     check_non_negative(X, \"NMF initialization\")\n 295 |     n_samples, n_features = X.shape\n 296 | \n 297 |     if (\n 298 |         init is not None\n 299 |         and init != \"random\"\n 300 |         and n_components > min(n_samples, n_features)\n 301 |     ):\n 302 |         raise ValueError(\n 303 |             \"init = '{}' can only be used when \"\n 304 |             \"n_components <= min(n_samples, n_features)\".format(init)\n 305 |         )\n 306 | \n 307 |     if init is None:\n 308 |         if n_components <= min(n_samples, n_features):\n 309 |             init = \"nndsvda\"\n 310 |         else:\n 311 |             init = \"random\"\n 312 | \n 313 |     # Random initialization\n 314 |     if init == \"random\":\n 315 |         avg = np.sqrt(X.mean() / n_components)\n 316 |         rng = check_random_state(random_state)\n 317 |         H = avg * rng.standard_normal(size=(n_components, n_features)).astype(\n 318 |             X.dtype, copy=False\n 319 |         )\n 320 |         W = avg * rng.standard_normal(size=(n_samples, n_components)).astype(\n 321 |             X.dtype, copy=False\n 322 |         )\n 323 |         np.abs(H, out=H)\n 324 |         np.abs(W, out=W)\n 325 |         return W, H\n 326 | \n 327 |     # NNDSVD initialization\n 328 |     U, S, V = randomized_svd(X, n_components, random_state=random_state)\n 329 |     W = np.zeros_like(U)\n 330 |     H = np.zeros_like(V)\n 331 | \n 332 |     # The leading singular triplet is non-negative\n 333 |     # so it can be used as is for initialization.\n 334 |     W[:, 0] = np.sqrt(S[0]) * np.abs(U[:, 0])\n 335 |     H[0, :] = np.sqrt(S[0]) * np.abs(V[0, :])\n 336 | \n 337 |     for j in range(1, n_components):\n 338 |         x, y = U[:, j], V[j, :]\n 339 | \n 340 |         # extract positive and negative parts of column vectors\n 341 |         x_p, y_p = np.maximum(x, 0), np.maximum(y, 0)\n 342 |         x_n, y_n = np.abs(np.minimum(x, 0)), np.abs(np.minimum(y, 0))\n 343 | \n 344 |         # and their norms\n 345 |         x_p_nrm, y_p_nrm = norm(x_p), norm(y_p)\n 346 |         x_n_nrm, y_n_nrm = norm(x_n), norm(y_n)\n 347 | \n 348 |         m_p, m_n = x_p_nrm * y_p_nrm, x_n_nrm * y_n_nrm\n 349 | \n 350 |         # choose update\n 351 |         if m_p > m_n:\n 352 |             u = x_p / x_p_nrm\n 353 |             v = y_p / y_p_nrm\n 354 |             sigma = m_p\n 355 |         else:\n 356 |             u = x_n / x_n_nrm\n 357 |             v = y_n / y_n_nrm\n 358 |             sigma = m_n\n 359 | \n 360 |         lbd = np.sqrt(S[j] * sigma)\n 361 |         W[:, j] = lbd * u\n 362 |         H[j, :] = lbd * v\n 363 | \n 364 |     W[W < eps] = 0\n 365 |     H[H < eps] = 0\n 366 | \n 367 |     if init == \"nndsvd\":\n 368 |         pass\n 369 |     elif init == \"nndsvda\":\n 370 |         avg = X.mean()\n 371 |         W[W == 0] = avg\n 372 |         H[H == 0] = avg\n 373 |     elif init == \"nndsvdar\":\n 374 |         rng = check_random_state(random_state)\n 375 |         avg = X.mean()\n 376 |         W[W == 0] = abs(avg * rng.standard_normal(size=len(W[W == 0])) / 100)\n 377 |         H[H == 0] = abs(avg * rng.standard_normal(size=len(H[H == 0])) / 100)\n 378 |     else:\n 379 |         raise ValueError(\n 380 |             \"Invalid init parameter: got %r instead of one of %r\"\n 381 |             % (init, (None, \"random\", \"nndsvd\", \"nndsvda\", \"nndsvdar\"))\n 382 |         )\n 383 | \n 384 |     return W, H\n 385 | \n 386 | \n 387 | def _update_coordinate_descent(X, W, Ht, l1_reg, l2_reg, shuffle, random_state):\n 388 |     \"\"\"Helper function for _fit_coordinate_descent.\n 389 | \n 390 |     Update W to minimize the objective function, iterating once over all\n 391 |     coordinates. By symmetry, to update H, one can call\n 392 |     _update_coordinate_descent(X.T, Ht, W, ...).\n 393 | \n 394 |     \"\"\"\n 395 |     n_components = Ht.shape[1]\n 396 | \n 397 |     HHt = np.dot(Ht.T, Ht)\n 398 |     XHt = safe_sparse_dot(X, Ht)\n 399 | \n 400 |     # L2 regularization corresponds to increase of the diagonal of HHt\n 401 |     if l2_reg != 0.0:\n 402 |         # adds l2_reg only on the diagonal\n 403 |         HHt.flat[:: n_components + 1] += l2_reg\n 404 |     # L1 regularization corresponds to decrease of each element of XHt\n 405 |     if l1_reg != 0.0:\n 406 |         XHt -= l1_reg\n 407 | \n 408 |     if shuffle:\n 409 |         permutation = random_state.permutation(n_components)\n 410 |     else:\n 411 |         permutation = np.arange(n_components)\n 412 |     # The following seems to be required on 64-bit Windows w/ Python 3.5.\n 413 |     permutation = np.asarray(permutation, dtype=np.intp)\n 414 |     return _update_cdnmf_fast(W, HHt, XHt, permutation)\n 415 | \n 416 | \n 417 | def _fit_coordinate_descent(\n 418 |     X,\n 419 |     W,\n 420 |     H,\n 421 |     tol=1e-4,\n 422 |     max_iter=200,\n 423 |     l1_reg_W=0,\n 424 |     l1_reg_H=0,\n 425 |     l2_reg_W=0,\n 426 |     l2_reg_H=0,\n 427 |     update_H=True,\n 428 |     verbose=0,\n 429 |     shuffle=False,\n 430 |     random_state=None,\n 431 | ):\n 432 |     \"\"\"Compute Non-negative Matrix Factorization (NMF) with Coordinate Descent\n 433 | \n 434 |     The objective function is minimized with an alternating minimization of W\n 435 |     and H. Each minimization is done with a cyclic (up to a permutation of the\n 436 |     features) Coordinate Descent.\n 437 | \n 438 |     Parameters\n 439 |     ----------\n 440 |     X : array-like of shape (n_samples, n_features)\n 441 |         Constant matrix.\n 442 | \n 443 |     W : array-like of shape (n_samples, n_components)\n 444 |         Initial guess for the solution.\n 445 | \n 446 |     H : array-like of shape (n_components, n_features)\n 447 |         Initial guess for the solution.\n 448 | \n 449 |     tol : float, default=1e-4\n 450 |         Tolerance of the stopping condition.\n 451 | \n 452 |     max_iter : int, default=200\n 453 |         Maximum number of iterations before timing out.\n 454 | \n 455 |     l1_reg_W : float, default=0.\n 456 |         L1 regularization parameter for W.\n 457 | \n 458 |     l1_reg_H : float, default=0.\n 459 |         L1 regularization parameter for H.\n 460 | \n 461 |     l2_reg_W : float, default=0.\n 462 |         L2 regularization parameter for W.\n 463 | \n 464 |     l2_reg_H : float, default=0.\n 465 |         L2 regularization parameter for H.\n 466 | \n 467 |     update_H : bool, default=True\n 468 |         Set to True, both W and H will be estimated from initial guesses.\n 469 |         Set to False, only W will be estimated.\n 470 | \n 471 |     verbose : int, default=0\n 472 |         The verbosity level.\n 473 | \n 474 |     shuffle : bool, default=False\n 475 |         If true, randomize the order of coordinates in the CD solver.\n 476 | \n 477 |     random_state : int, RandomState instance or None, default=None\n 478 |         Used to randomize the coordinates in the CD solver, when\n 479 |         ``shuffle`` is set to ``True``. Pass an int for reproducible\n 480 |         results across multiple function calls.\n 481 |         See :term:`Glossary <random_state>`.\n 482 | \n 483 |     Returns\n 484 |     -------\n 485 |     W : ndarray of shape (n_samples, n_components)\n 486 |         Solution to the non-negative least squares problem.\n 487 | \n 488 |     H : ndarray of shape (n_components, n_features)\n 489 |         Solution to the non-negative least squares problem.\n 490 | \n 491 |     n_iter : int\n 492 |         The number of iterations done by the algorithm.\n 493 | \n 494 |     References\n 495 |     ----------\n 496 |     Cichocki, Andrzej, and Phan, Anh-Huy. \"Fast local algorithms for\n 497 |     large scale nonnegative matrix and tensor factorizations.\"\n 498 |     IEICE transactions on fundamentals of electronics, communications and\n 499 |     computer sciences 92.3: 708-721, 2009.\n 500 |     \"\"\"\n 501 |     # so W and Ht are both in C order in memory\n 502 |     Ht = check_array(H.T, order=\"C\")\n 503 |     X = check_array(X, accept_sparse=\"csr\")\n 504 | \n 505 |     rng = check_random_state(random_state)\n 506 | \n 507 |     for n_iter in range(1, max_iter + 1):\n 508 |         violation = 0.0\n 509 | \n 510 |         # Update W\n 511 |         violation += _update_coordinate_descent(\n 512 |             X, W, Ht, l1_reg_W, l2_reg_W, shuffle, rng\n 513 |         )\n 514 |         # Update H\n 515 |         if update_H:\n 516 |             violation += _update_coordinate_descent(\n 517 |                 X.T, Ht, W, l1_reg_H, l2_reg_H, shuffle, rng\n 518 |             )\n 519 | \n 520 |         if n_iter == 1:\n 521 |             violation_init = violation\n 522 | \n 523 |         if violation_init == 0:\n 524 |             break\n 525 | \n 526 |         if verbose:\n 527 |             print(\"violation:\", violation / violation_init)\n 528 | \n 529 |         if violation / violation_init <= tol:\n 530 |             if verbose:\n 531 |                 print(\"Converged at iteration\", n_iter + 1)\n 532 |             break\n 533 | \n 534 |     return W, Ht.T, n_iter\n 535 | \n 536 | \n 537 | def _multiplicative_update_w(\n 538 |     X,\n 539 |     W,\n 540 |     H,\n 541 |     beta_loss,\n 542 |     l1_reg_W,\n 543 |     l2_reg_W,\n 544 |     gamma,\n 545 |     H_sum=None,\n 546 |     HHt=None,\n 547 |     XHt=None,\n 548 |     update_H=True,\n 549 | ):\n 550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n 551 |     if beta_loss == 2:\n 552 |         # Numerator\n 553 |         if XHt is None:\n 554 |             XHt = safe_sparse_dot(X, H.T)\n 555 |         if update_H:\n 556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n 557 |             numerator = XHt\n 558 |         else:\n 559 |             # preserve the XHt, which is not re-computed (update_H=False)\n 560 |             numerator = XHt.copy()\n 561 | \n 562 |         # Denominator\n 563 |         if HHt is None:\n 564 |             HHt = np.dot(H, H.T)\n 565 |         denominator = np.dot(W, HHt)\n 566 | \n 567 |     else:\n 568 |         # Numerator\n 569 |         # if X is sparse, compute WH only where X is non zero\n 570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n 571 |         if sp.issparse(X):\n 572 |             WH_safe_X_data = WH_safe_X.data\n 573 |             X_data = X.data\n 574 |         else:\n 575 |             WH_safe_X_data = WH_safe_X\n 576 |             X_data = X\n 577 |             # copy used in the Denominator\n 578 |             WH = WH_safe_X.copy()\n 579 |             if beta_loss - 1.0 < 0:\n 580 |                 WH[WH == 0] = EPSILON\n 581 | \n 582 |         # to avoid taking a negative power of zero\n 583 |         if beta_loss - 2.0 < 0:\n 584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n 585 | \n 586 |         if beta_loss == 1:\n 587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n 588 |         elif beta_loss == 0:\n 589 |             # speeds up computation time\n 590 |             # refer to /numpy/numpy/issues/9363\n 591 |             WH_safe_X_data **= -1\n 592 |             WH_safe_X_data **= 2\n 593 |             # element-wise multiplication\n 594 |             WH_safe_X_data *= X_data\n 595 |         else:\n 596 |             WH_safe_X_data **= beta_loss - 2\n 597 |             # element-wise multiplication\n 598 |             WH_safe_X_data *= X_data\n 599 | \n 600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n 601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n 602 | \n 603 |         # Denominator\n 604 |         if beta_loss == 1:\n 605 |             if H_sum is None:\n 606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n 607 |             denominator = H_sum[np.newaxis, :]\n 608 | \n 609 |         else:\n 610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n 611 |             if sp.issparse(X):\n 612 |                 # memory efficient computation\n 613 |                 # (compute row by row, avoiding the dense matrix WH)\n 614 |                 WHHt = np.empty(W.shape)\n 615 |                 for i in range(X.shape[0]):\n 616 |                     WHi = np.dot(W[i, :], H)\n 617 |                     if beta_loss - 1 < 0:\n 618 |                         WHi[WHi == 0] = EPSILON\n 619 |                     WHi **= beta_loss - 1\n 620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n 621 |             else:\n 622 |                 WH **= beta_loss - 1\n 623 |                 WHHt = np.dot(WH, H.T)\n 624 |             denominator = WHHt\n 625 | \n 626 |     # Add L1 and L2 regularization\n 627 |     if l1_reg_W > 0:\n 628 |         denominator += l1_reg_W\n 629 |     if l2_reg_W > 0:\n 630 |         denominator = denominator + l2_reg_W * W\n 631 |     denominator[denominator == 0] = EPSILON\n 632 | \n 633 |     numerator /= denominator\n 634 |     delta_W = numerator\n 635 | \n 636 |     # gamma is in ]0, 1]\n 637 |     if gamma != 1:\n 638 |         delta_W **= gamma\n 639 | \n 640 |     return delta_W, H_sum, HHt, XHt\n 641 | \n 642 | \n 643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n 644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n 645 |     if beta_loss == 2:\n 646 |         numerator = safe_sparse_dot(W.T, X)\n 647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n 648 | \n 649 |     else:\n 650 |         # Numerator\n 651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n 652 |         if sp.issparse(X):\n 653 |             WH_safe_X_data = WH_safe_X.data\n 654 |             X_data = X.data\n 655 |         else:\n 656 |             WH_safe_X_data = WH_safe_X\n 657 |             X_data = X\n 658 |             # copy used in the Denominator\n 659 |             WH = WH_safe_X.copy()\n 660 |             if beta_loss - 1.0 < 0:\n 661 |                 WH[WH == 0] = EPSILON\n 662 | \n 663 |         # to avoid division by zero\n 664 |         if beta_loss - 2.0 < 0:\n 665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n 666 | \n 667 |         if beta_loss == 1:\n 668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n 669 |         elif beta_loss == 0:\n 670 |             # speeds up computation time\n 671 |             # refer to /numpy/numpy/issues/9363\n 672 |             WH_safe_X_data **= -1\n 673 |             WH_safe_X_data **= 2\n 674 |             # element-wise multiplication\n 675 |             WH_safe_X_data *= X_data\n 676 |         else:\n 677 |             WH_safe_X_data **= beta_loss - 2\n 678 |             # element-wise multiplication\n 679 |             WH_safe_X_data *= X_data\n 680 | \n 681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n 682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n 683 | \n 684 |         # Denominator\n 685 |         if beta_loss == 1:\n 686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n 687 |             W_sum[W_sum == 0] = 1.0\n 688 |             denominator = W_sum[:, np.newaxis]\n 689 | \n 690 |         # beta_loss not in (1, 2)\n 691 |         else:\n 692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n 693 |             if sp.issparse(X):\n 694 |                 # memory efficient computation\n 695 |                 # (compute column by column, avoiding the dense matrix WH)\n 696 |                 WtWH = np.empty(H.shape)\n 697 |                 for i in range(X.shape[1]):\n 698 |                     WHi = np.dot(W, H[:, i])\n 699 |                     if beta_loss - 1 < 0:\n 700 |                         WHi[WHi == 0] = EPSILON\n 701 |                     WHi **= beta_loss - 1\n 702 |                     WtWH[:, i] = np.dot(W.T, WHi)\n 703 |             else:\n 704 |                 WH **= beta_loss - 1\n 705 |                 WtWH = np.dot(W.T, WH)\n 706 |             denominator = WtWH\n 707 | \n 708 |     # Add L1 and L2 regularization\n 709 |     if l1_reg_H > 0:\n 710 |         denominator += l1_reg_H\n 711 |     if l2_reg_H > 0:\n 712 |         denominator = denominator + l2_reg_H * H\n 713 |     denominator[denominator == 0] = EPSILON\n 714 | \n 715 |     numerator /= denominator\n 716 |     delta_H = numerator\n 717 | \n 718 |     # gamma is in ]0, 1]\n 719 |     if gamma != 1:\n 720 |         delta_H **= gamma\n 721 | \n 722 |     return delta_H\n 723 | \n 724 | \n 725 | def _fit_multiplicative_update(\n 726 |     X,\n 727 |     W,\n 728 |     H,\n 729 |     beta_loss=\"frobenius\",\n 730 |     max_iter=200,\n 731 |     tol=1e-4,\n 732 |     l1_reg_W=0,\n 733 |     l1_reg_H=0,\n 734 |     l2_reg_W=0,\n 735 |     l2_reg_H=0,\n 736 |     update_H=True,\n 737 |     verbose=0,\n 738 | ):\n 739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n 740 | \n 741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n 742 |     alternating minimization of W and H. Each minimization is done with a\n 743 |     Multiplicative Update.\n 744 | \n 745 |     Parameters\n 746 |     ----------\n 747 |     X : array-like of shape (n_samples, n_features)\n 748 |         Constant input matrix.\n 749 | \n 750 |     W : array-like of shape (n_samples, n_components)\n 751 |         Initial guess for the solution.\n 752 | \n 753 |     H : array-like of shape (n_components, n_features)\n 754 |         Initial guess for the solution.\n 755 | \n 756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n 757 |             'itakura-saito'}, default='frobenius'\n 758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n 759 |         Beta divergence to be minimized, measuring the distance between X\n 760 |         and the dot product WH. Note that values different from 'frobenius'\n 761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n 762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n 763 |         matrix X cannot contain zeros.\n 764 | \n 765 |     max_iter : int, default=200\n 766 |         Number of iterations.\n 767 | \n 768 |     tol : float, default=1e-4\n 769 |         Tolerance of the stopping condition.\n 770 | \n 771 |     l1_reg_W : float, default=0.\n 772 |         L1 regularization parameter for W.\n 773 | \n 774 |     l1_reg_H : float, default=0.\n 775 |         L1 regularization parameter for H.\n 776 | \n 777 |     l2_reg_W : float, default=0.\n 778 |         L2 regularization parameter for W.\n 779 | \n 780 |     l2_reg_H : float, default=0.\n 781 |         L2 regularization parameter for H.\n 782 | \n 783 |     update_H : bool, default=True\n 784 |         Set to True, both W and H will be estimated from initial guesses.\n 785 |         Set to False, only W will be estimated.\n 786 | \n 787 |     verbose : int, default=0\n 788 |         The verbosity level.\n 789 | \n 790 |     Returns\n 791 |     -------\n 792 |     W : ndarray of shape (n_samples, n_components)\n 793 |         Solution to the non-negative least squares problem.\n 794 | \n 795 |     H : ndarray of shape (n_components, n_features)\n 796 |         Solution to the non-negative least squares problem.\n 797 | \n 798 |     n_iter : int\n 799 |         The number of iterations done by the algorithm.\n 800 | \n 801 |     References\n 802 |     ----------\n 803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n 804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n 805 |     \"\"\"\n 806 |     start_time = time.time()\n 807 | \n 808 |     beta_loss = _beta_loss_to_float(beta_loss)\n 809 | \n 810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n 811 |     if beta_loss < 1:\n 812 |         gamma = 1.0 / (2.0 - beta_loss)\n 813 |     elif beta_loss > 2:\n 814 |         gamma = 1.0 / (beta_loss - 1.0)\n 815 |     else:\n 816 |         gamma = 1.0\n 817 | \n 818 |     # used for the convergence criterion\n 819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n 820 |     previous_error = error_at_init\n 821 | \n 822 |     H_sum, HHt, XHt = None, None, None\n 823 |     for n_iter in range(1, max_iter + 1):\n 824 |         # update W\n 825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n 826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n 827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n 828 |         )\n 829 |         W *= delta_W\n 830 | \n 831 |         # necessary for stability with beta_loss < 1\n 832 |         if beta_loss < 1:\n 833 |             W[W < np.finfo(np.float64).eps] = 0.0\n 834 | \n 835 |         # update H\n 836 |         if update_H:\n 837 |             delta_H = _multiplicative_update_h(\n 838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n 839 |             )\n 840 |             H *= delta_H\n 841 | \n 842 |             # These values will be recomputed since H changed\n 843 |             H_sum, HHt, XHt = None, None, None\n 844 | \n 845 |             # necessary for stability with beta_loss < 1\n 846 |             if beta_loss <= 1:\n 847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n 848 | \n 849 |         # test convergence criterion every 10 iterations\n 850 |         if tol > 0 and n_iter % 10 == 0:\n 851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n 852 | \n 853 |             if verbose:\n 854 |                 iter_time = time.time()\n 855 |                 print(\n 856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n 857 |                     % (n_iter, iter_time - start_time, error)\n 858 |                 )\n 859 | \n 860 |             if (previous_error - error) / error_at_init < tol:\n 861 |                 break\n 862 |             previous_error = error\n 863 | \n 864 |     # do not print if we have already printed in the convergence test\n 865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n 866 |         end_time = time.time()\n 867 |         print(\n 868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n 869 |         )\n 870 | \n 871 |     return W, H, n_iter\n 872 | \n 873 | \n 874 | def non_negative_factorization(\n 875 |     X,\n 876 |     W=None,\n 877 |     H=None,\n 878 |     n_components=None,\n 879 |     *,\n 880 |     init=None,\n 881 |     update_H=True,\n 882 |     solver=\"cd\",\n 883 |     beta_loss=\"frobenius\",\n 884 |     tol=1e-4,\n 885 |     max_iter=200,\n 886 |     alpha=\"deprecated\",\n 887 |     alpha_W=0.0,\n 888 |     alpha_H=\"same\",\n 889 |     l1_ratio=0.0,\n 890 |     regularization=\"deprecated\",\n 891 |     random_state=None,\n 892 |     verbose=0,\n 893 |     shuffle=False,\n 894 | ):\n 895 |     \"\"\"Compute Non-negative Matrix Factorization (NMF).\n 896 | \n 897 |     Find two non-negative matrices (W, H) whose product approximates the non-\n 898 |     negative matrix X. This factorization can be used for example for\n 899 |     dimensionality reduction, source separation or topic extraction.\n 900 | \n 901 |     The objective function is:\n 902 | \n 903 |         .. math::\n 904 | \n 905 |             0.5 * ||X - WH||_{loss}^2\n 906 | \n 907 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n 908 | \n 909 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n 910 | \n 911 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n 912 | \n 913 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n 914 | \n 915 |     Where:\n 916 | \n 917 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n 918 | \n 919 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n 920 | \n 921 |     The generic norm :math:`||X - WH||_{loss}^2` may represent\n 922 |     the Frobenius norm or another supported beta-divergence loss.\n 923 |     The choice between options is controlled by the `beta_loss` parameter.\n 924 | \n 925 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n 926 |     `H` to keep their impact balanced with respect to one another and to the data fit\n 927 |     term as independent as possible of the size `n_samples` of the training set.\n 928 | \n 929 |     The objective function is minimized with an alternating minimization of W\n 930 |     and H. If H is given and update_H=False, it solves for W only.\n 931 | \n 932 |     Note that the transformed data is named W and the components matrix is named H. In\n 933 |     the NMF literature, the naming convention is usually the opposite since the data\n 934 |     matrix X is transposed.\n 935 | \n 936 |     Parameters\n 937 |     ----------\n 938 |     X : array-like of shape (n_samples, n_features)\n 939 |         Constant matrix.\n 940 | \n 941 |     W : array-like of shape (n_samples, n_components), default=None\n 942 |         If init='custom', it is used as initial guess for the solution.\n 943 | \n 944 |     H : array-like of shape (n_components, n_features), default=None\n 945 |         If init='custom', it is used as initial guess for the solution.\n 946 |         If update_H=False, it is used as a constant, to solve for W only.\n 947 | \n 948 |     n_components : int, default=None\n 949 |         Number of components, if n_components is not set all features\n 950 |         are kept.\n 951 | \n 952 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n 953 |         Method used to initialize the procedure.\n 954 | \n 955 |         Valid options:\n 956 | \n 957 |         - None: 'nndsvda' if n_components < n_features, otherwise 'random'.\n 958 | \n 959 |         - 'random': non-negative random matrices, scaled with:\n 960 |             sqrt(X.mean() / n_components)\n 961 | \n 962 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 963 |             initialization (better for sparseness)\n 964 | \n 965 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 966 |             (better when sparsity is not desired)\n 967 | \n 968 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 969 |             (generally faster, less accurate alternative to NNDSVDa\n 970 |             for when sparsity is not desired)\n 971 | \n 972 |         - 'custom': use custom matrices W and H if `update_H=True`. If\n 973 |           `update_H=False`, then only custom matrix H is used.\n 974 | \n 975 |         .. versionchanged:: 0.23\n 976 |             The default value of `init` changed from 'random' to None in 0.23.\n 977 | \n 978 |         .. versionchanged:: 1.1\n 979 |             When `init=None` and n_components is less than n_samples and n_features\n 980 |             defaults to `nndsvda` instead of `nndsvd`.\n 981 | \n 982 |     update_H : bool, default=True\n 983 |         Set to True, both W and H will be estimated from initial guesses.\n 984 |         Set to False, only W will be estimated.\n 985 | \n 986 |     solver : {'cd', 'mu'}, default='cd'\n 987 |         Numerical solver to use:\n 988 | \n 989 |         - 'cd' is a Coordinate Descent solver that uses Fast Hierarchical\n 990 |             Alternating Least Squares (Fast HALS).\n 991 | \n 992 |         - 'mu' is a Multiplicative Update solver.\n 993 | \n 994 |         .. versionadded:: 0.17\n 995 |            Coordinate Descent solver.\n 996 | \n 997 |         .. versionadded:: 0.19\n 998 |            Multiplicative Update solver.\n 999 | \n1000 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1001 |             'itakura-saito'}, default='frobenius'\n1002 |         Beta divergence to be minimized, measuring the distance between X\n1003 |         and the dot product WH. Note that values different from 'frobenius'\n1004 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1005 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1006 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1007 | \n1008 |         .. versionadded:: 0.19\n1009 | \n1010 |     tol : float, default=1e-4\n1011 |         Tolerance of the stopping condition.\n1012 | \n1013 |     max_iter : int, default=200\n1014 |         Maximum number of iterations before timing out.\n1015 | \n1016 |     alpha : float, default=0.0\n1017 |         Constant that multiplies the regularization terms. Set it to zero to have no\n1018 |         regularization. When using `alpha` instead of `alpha_W` and `alpha_H`, the\n1019 |         regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1020 |         factors for `W` (resp. `H`).\n1021 | \n1022 |         .. deprecated:: 1.0\n1023 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1024 |             Use `alpha_W` and `alpha_H` instead.\n1025 | \n1026 |     alpha_W : float, default=0.0\n1027 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1028 |         (default) to have no regularization on `W`.\n1029 | \n1030 |         .. versionadded:: 1.0\n1031 | \n1032 |     alpha_H : float or \"same\", default=\"same\"\n1033 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1034 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1035 |         `alpha_W`.\n1036 | \n1037 |         .. versionadded:: 1.0\n1038 | \n1039 |     l1_ratio : float, default=0.0\n1040 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1041 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1042 |         (aka Frobenius Norm).\n1043 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1044 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1045 | \n1046 |     regularization : {'both', 'components', 'transformation'}, default=None\n1047 |         Select whether the regularization affects the components (H), the\n1048 |         transformation (W), both or none of them.\n1049 | \n1050 |         .. deprecated:: 1.0\n1051 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1052 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1053 | \n1054 |     random_state : int, RandomState instance or None, default=None\n1055 |         Used for NMF initialisation (when ``init`` == 'nndsvdar' or\n1056 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1057 |         results across multiple function calls.\n1058 |         See :term:`Glossary <random_state>`.\n1059 | \n1060 |     verbose : int, default=0\n1061 |         The verbosity level.\n1062 | \n1063 |     shuffle : bool, default=False\n1064 |         If true, randomize the order of coordinates in the CD solver.\n1065 | \n1066 |     Returns\n1067 |     -------\n1068 |     W : ndarray of shape (n_samples, n_components)\n1069 |         Solution to the non-negative least squares problem.\n1070 | \n1071 |     H : ndarray of shape (n_components, n_features)\n1072 |         Solution to the non-negative least squares problem.\n1073 | \n1074 |     n_iter : int\n1075 |         Actual number of iterations.\n1076 | \n1077 |     Examples\n1078 |     --------\n1079 |     >>> import numpy as np\n1080 |     >>> X = np.array([[1,1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1081 |     >>> from sklearn.decomposition import non_negative_factorization\n1082 |     >>> W, H, n_iter = non_negative_factorization(X, n_components=2,\n1083 |     ... init='random', random_state=0)\n1084 | \n1085 |     References\n1086 |     ----------\n1087 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1088 |     large scale nonnegative matrix and tensor factorizations.\"\n1089 |     IEICE transactions on fundamentals of electronics, communications and\n1090 |     computer sciences 92.3: 708-721, 2009.\n1091 | \n1092 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1093 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1094 |     \"\"\"\n1095 |     X = check_array(X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32])\n1096 | \n1097 |     est = NMF(\n1098 |         n_components=n_components,\n1099 |         init=init,\n1100 |         solver=solver,\n1101 |         beta_loss=beta_loss,\n1102 |         tol=tol,\n1103 |         max_iter=max_iter,\n1104 |         random_state=random_state,\n1105 |         alpha=alpha,\n1106 |         alpha_W=alpha_W,\n1107 |         alpha_H=alpha_H,\n1108 |         l1_ratio=l1_ratio,\n1109 |         verbose=verbose,\n1110 |         shuffle=shuffle,\n1111 |         regularization=regularization,\n1112 |     )\n1113 | \n1114 |     with config_context(assume_finite=True):\n1115 |         W, H, n_iter = est._fit_transform(X, W=W, H=H, update_H=update_H)\n1116 | \n1117 |     return W, H, n_iter\n1118 | \n1119 | \n1120 | class NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n1121 |     \"\"\"Non-Negative Matrix Factorization (NMF).\n1122 | \n1123 |     Find two non-negative matrices (W, H) whose product approximates the non-\n1124 |     negative matrix X. This factorization can be used for example for\n1125 |     dimensionality reduction, source separation or topic extraction.\n1126 | \n1127 |     The objective function is:\n1128 | \n1129 |         .. math::\n1130 | \n1131 |             0.5 * ||X - WH||_{loss}^2\n1132 | \n1133 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n1134 | \n1135 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n1136 | \n1137 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n1138 | \n1139 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n1140 | \n1141 |     Where:\n1142 | \n1143 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n1144 | \n1145 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n1146 | \n1147 |     The generic norm :math:`||X - WH||_{loss}` may represent\n1148 |     the Frobenius norm or another supported beta-divergence loss.\n1149 |     The choice between options is controlled by the `beta_loss` parameter.\n1150 | \n1151 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n1152 |     `H` to keep their impact balanced with respect to one another and to the data fit\n1153 |     term as independent as possible of the size `n_samples` of the training set.\n1154 | \n1155 |     The objective function is minimized with an alternating minimization of W\n1156 |     and H.\n1157 | \n1158 |     Note that the transformed data is named W and the components matrix is named H. In\n1159 |     the NMF literature, the naming convention is usually the opposite since the data\n1160 |     matrix X is transposed.\n1161 | \n1162 |     Read more in the :ref:`User Guide <NMF>`.\n1163 | \n1164 |     Parameters\n1165 |     ----------\n1166 |     n_components : int, default=None\n1167 |         Number of components, if n_components is not set all features\n1168 |         are kept.\n1169 | \n1170 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n1171 |         Method used to initialize the procedure.\n1172 |         Default: None.\n1173 |         Valid options:\n1174 | \n1175 |         - `None`: 'nndsvda' if n_components <= min(n_samples, n_features),\n1176 |           otherwise random.\n1177 | \n1178 |         - `'random'`: non-negative random matrices, scaled with:\n1179 |           sqrt(X.mean() / n_components)\n1180 | \n1181 |         - `'nndsvd'`: Nonnegative Double Singular Value Decomposition (NNDSVD)\n1182 |           initialization (better for sparseness)\n1183 | \n1184 |         - `'nndsvda'`: NNDSVD with zeros filled with the average of X\n1185 |           (better when sparsity is not desired)\n1186 | \n1187 |         - `'nndsvdar'` NNDSVD with zeros filled with small random values\n1188 |           (generally faster, less accurate alternative to NNDSVDa\n1189 |           for when sparsity is not desired)\n1190 | \n1191 |         - `'custom'`: use custom matrices W and H\n1192 | \n1193 |         .. versionchanged:: 1.1\n1194 |             When `init=None` and n_components is less than n_samples and n_features\n1195 |             defaults to `nndsvda` instead of `nndsvd`.\n1196 | \n1197 |     solver : {'cd', 'mu'}, default='cd'\n1198 |         Numerical solver to use:\n1199 |         'cd' is a Coordinate Descent solver.\n1200 |         'mu' is a Multiplicative Update solver.\n1201 | \n1202 |         .. versionadded:: 0.17\n1203 |            Coordinate Descent solver.\n1204 | \n1205 |         .. versionadded:: 0.19\n1206 |            Multiplicative Update solver.\n1207 | \n1208 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1209 |             'itakura-saito'}, default='frobenius'\n1210 |         Beta divergence to be minimized, measuring the distance between X\n1211 |         and the dot product WH. Note that values different from 'frobenius'\n1212 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1213 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1214 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1215 | \n1216 |         .. versionadded:: 0.19\n1217 | \n1218 |     tol : float, default=1e-4\n1219 |         Tolerance of the stopping condition.\n1220 | \n1221 |     max_iter : int, default=200\n1222 |         Maximum number of iterations before timing out.\n1223 | \n1224 |     random_state : int, RandomState instance or None, default=None\n1225 |         Used for initialisation (when ``init`` == 'nndsvdar' or\n1226 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1227 |         results across multiple function calls.\n1228 |         See :term:`Glossary <random_state>`.\n1229 | \n1230 |     alpha : float, default=0.0\n1231 |         Constant that multiplies the regularization terms. Set it to zero to\n1232 |         have no regularization. When using `alpha` instead of `alpha_W` and `alpha_H`,\n1233 |         the regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1234 |         factors for `W` (resp. `H`).\n1235 | \n1236 |         .. versionadded:: 0.17\n1237 |            *alpha* used in the Coordinate Descent solver.\n1238 | \n1239 |         .. deprecated:: 1.0\n1240 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1241 |             Use `alpha_W` and `alpha_H` instead.\n1242 | \n1243 |     alpha_W : float, default=0.0\n1244 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1245 |         (default) to have no regularization on `W`.\n1246 | \n1247 |         .. versionadded:: 1.0\n1248 | \n1249 |     alpha_H : float or \"same\", default=\"same\"\n1250 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1251 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1252 |         `alpha_W`.\n1253 | \n1254 |         .. versionadded:: 1.0\n1255 | \n1256 |     l1_ratio : float, default=0.0\n1257 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1258 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1259 |         (aka Frobenius Norm).\n1260 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1261 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1262 | \n1263 |         .. versionadded:: 0.17\n1264 |            Regularization parameter *l1_ratio* used in the Coordinate Descent\n1265 |            solver.\n1266 | \n1267 |     verbose : int, default=0\n1268 |         Whether to be verbose.\n1269 | \n1270 |     shuffle : bool, default=False\n1271 |         If true, randomize the order of coordinates in the CD solver.\n1272 | \n1273 |         .. versionadded:: 0.17\n1274 |            *shuffle* parameter used in the Coordinate Descent solver.\n1275 | \n1276 |     regularization : {'both', 'components', 'transformation', None}, \\\n1277 |                      default='both'\n1278 |         Select whether the regularization affects the components (H), the\n1279 |         transformation (W), both or none of them.\n1280 | \n1281 |         .. versionadded:: 0.24\n1282 | \n1283 |         .. deprecated:: 1.0\n1284 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1285 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1286 | \n1287 |     Attributes\n1288 |     ----------\n1289 |     components_ : ndarray of shape (n_components, n_features)\n1290 |         Factorization matrix, sometimes called 'dictionary'.\n1291 | \n1292 |     n_components_ : int\n1293 |         The number of components. It is same as the `n_components` parameter\n1294 |         if it was given. Otherwise, it will be same as the number of\n1295 |         features.\n1296 | \n1297 |     reconstruction_err_ : float\n1298 |         Frobenius norm of the matrix difference, or beta-divergence, between\n1299 |         the training data ``X`` and the reconstructed data ``WH`` from\n1300 |         the fitted model.\n1301 | \n1302 |     n_iter_ : int\n1303 |         Actual number of iterations.\n1304 | \n1305 |     n_features_in_ : int\n1306 |         Number of features seen during :term:`fit`.\n1307 | \n1308 |         .. versionadded:: 0.24\n1309 | \n1310 |     feature_names_in_ : ndarray of shape (`n_features_in_`,)\n1311 |         Names of features seen during :term:`fit`. Defined only when `X`\n1312 |         has feature names that are all strings.\n1313 | \n1314 |         .. versionadded:: 1.0\n1315 | \n1316 |     See Also\n1317 |     --------\n1318 |     DictionaryLearning : Find a dictionary that sparsely encodes data.\n1319 |     MiniBatchSparsePCA : Mini-batch Sparse Principal Components Analysis.\n1320 |     PCA : Principal component analysis.\n1321 |     SparseCoder : Find a sparse representation of data from a fixed,\n1322 |         precomputed dictionary.\n1323 |     SparsePCA : Sparse Principal Components Analysis.\n1324 |     TruncatedSVD : Dimensionality reduction using truncated SVD.\n1325 | \n1326 |     References\n1327 |     ----------\n1328 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1329 |     large scale nonnegative matrix and tensor factorizations.\"\n1330 |     IEICE transactions on fundamentals of electronics, communications and\n1331 |     computer sciences 92.3: 708-721, 2009.\n1332 | \n1333 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1334 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1335 | \n1336 |     Examples\n1337 |     --------\n1338 |     >>> import numpy as np\n1339 |     >>> X = np.array([[1, 1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1340 |     >>> from sklearn.decomposition import NMF\n1341 |     >>> model = NMF(n_components=2, init='random', random_state=0)\n1342 |     >>> W = model.fit_transform(X)\n1343 |     >>> H = model.components_\n1344 |     \"\"\"\n1345 | \n1346 |     def __init__(\n1347 |         self,\n1348 |         n_components=None,\n1349 |         *,\n1350 |         init=None,\n1351 |         solver=\"cd\",\n1352 |         beta_loss=\"frobenius\",\n1353 |         tol=1e-4,\n1354 |         max_iter=200,\n1355 |         random_state=None,\n1356 |         alpha=\"deprecated\",\n1357 |         alpha_W=0.0,\n1358 |         alpha_H=\"same\",\n1359 |         l1_ratio=0.0,\n1360 |         verbose=0,\n1361 |         shuffle=False,\n1362 |         regularization=\"deprecated\",\n1363 |     ):\n1364 |         self.n_components = n_components\n1365 |         self.init = init\n1366 |         self.solver = solver\n1367 |         self.beta_loss = beta_loss\n1368 |         self.tol = tol\n1369 |         self.max_iter = max_iter\n1370 |         self.random_state = random_state\n1371 |         self.alpha = alpha\n1372 |         self.alpha_W = alpha_W\n1373 |         self.alpha_H = alpha_H\n1374 |         self.l1_ratio = l1_ratio\n1375 |         self.verbose = verbose\n1376 |         self.shuffle = shuffle\n1377 |         self.regularization = regularization\n1378 | \n1379 |     def _more_tags(self):\n1380 |         return {\"requires_positive_X\": True}\n1381 | \n1382 |     def _check_params(self, X):\n1383 |         # n_components\n1384 |         self._n_components = self.n_components\n1385 |         if self._n_components is None:\n1386 |             self._n_components = X.shape[1]\n1387 |         if (\n1388 |             not isinstance(self._n_components, numbers.Integral)\n1389 |             or self._n_components <= 0\n1390 |         ):\n1391 |             raise ValueError(\n1392 |                 \"Number of components must be a positive integer; got \"\n1393 |                 f\"(n_components={self._n_components!r})\"\n1394 |             )\n1395 | \n1396 |         # max_iter\n1397 |         if not isinstance(self.max_iter, numbers.Integral) or self.max_iter < 0:\n1398 |             raise ValueError(\n1399 |                 \"Maximum number of iterations must be a positive \"\n1400 |                 f\"integer; got (max_iter={self.max_iter!r})\"\n1401 |             )\n1402 | \n1403 |         # tol\n1404 |         if not isinstance(self.tol, numbers.Number) or self.tol < 0:\n1405 |             raise ValueError(\n1406 |                 \"Tolerance for stopping criteria must be positive; got \"\n1407 |                 f\"(tol={self.tol!r})\"\n1408 |             )\n1409 | \n1410 |         # beta_loss\n1411 |         self._beta_loss = _beta_loss_to_float(self.beta_loss)\n1412 | \n1413 |         # solver\n1414 |         allowed_solver = (\"cd\", \"mu\")\n1415 |         if self.solver not in allowed_solver:\n1416 |             raise ValueError(\n1417 |                 f\"Invalid solver parameter: got {self.solver!r} instead of one of \"\n1418 |                 f\"{allowed_solver}\"\n1419 |             )\n1420 |         if self.solver != \"mu\" and self.beta_loss not in (2, \"frobenius\"):\n1421 |             # 'mu' is the only solver that handles other beta losses than 'frobenius'\n1422 |             raise ValueError(\n1423 |                 f\"Invalid beta_loss parameter: solver {self.solver!r} does not handle \"\n1424 |                 f\"beta_loss = {self.beta_loss!r}\"\n1425 |             )\n1426 |         if self.solver == \"mu\" and self.init == \"nndsvd\":\n1427 |             warnings.warn(\n1428 |                 \"The multiplicative update ('mu') solver cannot update \"\n1429 |                 \"zeros present in the initialization, and so leads to \"\n1430 |                 \"poorer results when used jointly with init='nndsvd'. \"\n1431 |                 \"You may try init='nndsvda' or init='nndsvdar' instead.\",\n1432 |                 UserWarning,\n1433 |             )\n1434 | \n1435 |         # alpha and regularization are deprecated in favor of alpha_W and alpha_H\n1436 |         # TODO clean up in 1.2\n1437 |         if self.alpha != \"deprecated\":\n1438 |             warnings.warn(\n1439 |                 \"`alpha` was deprecated in version 1.0 and will be removed \"\n1440 |                 \"in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1441 |                 FutureWarning,\n1442 |             )\n1443 |             alpha = self.alpha\n1444 |         else:\n1445 |             alpha = 0.0\n1446 | \n1447 |         if self.regularization != \"deprecated\":\n1448 |             warnings.warn(\n1449 |                 \"`regularization` was deprecated in version 1.0 and will be \"\n1450 |                 \"removed in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1451 |                 FutureWarning,\n1452 |             )\n1453 |             allowed_regularization = (\"both\", \"components\", \"transformation\", None)\n1454 |             if self.regularization not in allowed_regularization:\n1455 |                 raise ValueError(\n1456 |                     f\"Invalid regularization parameter: got {self.regularization!r} \"\n1457 |                     f\"instead of one of {allowed_regularization}\"\n1458 |                 )\n1459 |             regularization = self.regularization\n1460 |         else:\n1461 |             regularization = \"both\"\n1462 | \n1463 |         (\n1464 |             self._l1_reg_W,\n1465 |             self._l1_reg_H,\n1466 |             self._l2_reg_W,\n1467 |             self._l2_reg_H,\n1468 |         ) = _compute_regularization(\n1469 |             alpha, self.alpha_W, self.alpha_H, self.l1_ratio, regularization\n1470 |         )\n1471 | \n1472 |         return self\n1473 | \n1474 |     def _check_w_h(self, X, W, H, update_H):\n1475 |         # check W and H, or initialize them\n1476 |         n_samples, n_features = X.shape\n1477 |         if self.init == \"custom\" and update_H:\n1478 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1479 |             _check_init(W, (n_samples, self._n_components), \"NMF (input W)\")\n1480 |             if H.dtype != X.dtype or W.dtype != X.dtype:\n1481 |                 raise TypeError(\n1482 |                     \"H and W should have the same dtype as X. Got \"\n1483 |                     \"H.dtype = {} and W.dtype = {}.\".format(H.dtype, W.dtype)\n1484 |                 )\n1485 |         elif not update_H:\n1486 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1487 |             if H.dtype != X.dtype:\n1488 |                 raise TypeError(\n1489 |                     \"H should have the same dtype as X. Got H.dtype = {}.\".format(\n1490 |                         H.dtype\n1491 |                     )\n1492 |                 )\n1493 |             # 'mu' solver should not be initialized by zeros\n1494 |             if self.solver == \"mu\":\n1495 |                 avg = np.sqrt(X.mean() / self._n_components)\n1496 |                 W = np.full((n_samples, self._n_components), avg, dtype=X.dtype)\n1497 |             else:\n1498 |                 W = np.zeros((n_samples, self._n_components), dtype=X.dtype)\n1499 |         else:\n1500 |             W, H = _initialize_nmf(\n1501 |                 X, self._n_components, init=self.init, random_state=self.random_state\n1502 |             )\n1503 |         return W, H\n1504 | \n1505 |     def _scale_regularization(self, X):\n1506 |         n_samples, n_features = X.shape\n1507 |         if self.alpha_W != 0 or self.alpha_H != \"same\":\n1508 |             # if alpha_W or alpha_H is not left to its default value we ignore alpha\n1509 |             # and regularization, and we scale the regularization terms.\n1510 |             l1_reg_W = n_features * self._l1_reg_W\n1511 |             l1_reg_H = n_samples * self._l1_reg_H\n1512 |             l2_reg_W = n_features * self._l2_reg_W\n1513 |             l2_reg_H = n_samples * self._l2_reg_H\n1514 |         else:\n1515 |             # Otherwise we keep the old behavior with no scaling\n1516 |             # TODO remove in 1.2\n1517 |             l1_reg_W = self._l1_reg_W\n1518 |             l1_reg_H = self._l1_reg_H\n1519 |             l2_reg_W = self._l2_reg_W\n1520 |             l2_reg_H = self._l2_reg_H\n1521 | \n1522 |         return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n1523 | \n1524 |     def fit_transform(self, X, y=None, W=None, H=None):\n1525 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1526 | \n1527 |         This is more efficient than calling fit followed by transform.\n1528 | \n1529 |         Parameters\n1530 |         ----------\n1531 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1532 |             Training vector, where `n_samples` is the number of samples\n1533 |             and `n_features` is the number of features.\n1534 | \n1535 |         y : Ignored\n1536 |             Not used, present for API consistency by convention.\n1537 | \n1538 |         W : array-like of shape (n_samples, n_components)\n1539 |             If init='custom', it is used as initial guess for the solution.\n1540 | \n1541 |         H : array-like of shape (n_components, n_features)\n1542 |             If init='custom', it is used as initial guess for the solution.\n1543 | \n1544 |         Returns\n1545 |         -------\n1546 |         W : ndarray of shape (n_samples, n_components)\n1547 |             Transformed data.\n1548 |         \"\"\"\n1549 |         X = self._validate_data(\n1550 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n1551 |         )\n1552 | \n1553 |         with config_context(assume_finite=True):\n1554 |             W, H, n_iter = self._fit_transform(X, W=W, H=H)\n1555 | \n1556 |         self.reconstruction_err_ = _beta_divergence(\n1557 |             X, W, H, self._beta_loss, square_root=True\n1558 |         )\n1559 | \n1560 |         self.n_components_ = H.shape[0]\n1561 |         self.components_ = H\n1562 |         self.n_iter_ = n_iter\n1563 | \n1564 |         return W\n1565 | \n1566 |     def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n1567 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1568 | \n1569 |         Parameters\n1570 |         ----------\n1571 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1572 |             Data matrix to be decomposed\n1573 | \n1574 |         y : Ignored\n1575 | \n1576 |         W : array-like of shape (n_samples, n_components)\n1577 |             If init='custom', it is used as initial guess for the solution.\n1578 | \n1579 |         H : array-like of shape (n_components, n_features)\n1580 |             If init='custom', it is used as initial guess for the solution.\n1581 |             If update_H=False, it is used as a constant, to solve for W only.\n1582 | \n1583 |         update_H : bool, default=True\n1584 |             If True, both W and H will be estimated from initial guesses,\n1585 |             this corresponds to a call to the 'fit_transform' method.\n1586 |             If False, only W will be estimated, this corresponds to a call\n1587 |             to the 'transform' method.\n1588 | \n1589 |         Returns\n1590 |         -------\n1591 |         W : ndarray of shape (n_samples, n_components)\n1592 |             Transformed data.\n1593 | \n1594 |         H : ndarray of shape (n_components, n_features)\n1595 |             Factorization matrix, sometimes called 'dictionary'.\n1596 | \n1597 |         n_iter_ : int\n1598 |             Actual number of iterations.\n1599 |         \"\"\"\n1600 |         check_non_negative(X, \"NMF (input X)\")\n1601 | \n1602 |         # check parameters\n1603 |         self._check_params(X)\n1604 | \n1605 |         if X.min() == 0 and self._beta_loss <= 0:\n1606 |             raise ValueError(\n1607 |                 \"When beta_loss <= 0 and X contains zeros, \"\n1608 |                 \"the solver may diverge. Please add small values \"\n1609 |                 \"to X, or use a positive beta_loss.\"\n1610 |             )\n1611 | \n1612 |         # initialize or check W and H\n1613 |         W, H = self._check_w_h(X, W, H, update_H)\n1614 | \n1615 |         # scale the regularization terms\n1616 |         l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H = self._scale_regularization(X)\n1617 | \n1618 |         if self.solver == \"cd\":\n1619 |             W, H, n_iter = _fit_coordinate_descent(\n1620 |                 X,\n1621 |                 W,\n1622 |                 H,\n1623 |                 self.tol,\n1624 |                 self.max_iter,\n1625 |                 l1_reg_W,\n1626 |                 l1_reg_H,\n1627 |                 l2_reg_W,\n1628 |                 l2_reg_H,\n1629 |                 update_H=update_H,\n1630 |                 verbose=self.verbose,\n1631 |                 shuffle=self.shuffle,\n1632 |                 random_state=self.random_state,\n1633 |             )\n1634 |         elif self.solver == \"mu\":\n1635 |             W, H, n_iter = _fit_multiplicative_update(\n1636 |                 X,\n1637 |                 W,\n1638 |                 H,\n1639 |                 self._beta_loss,\n1640 |                 self.max_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params)\n1684 |         return self\n1685 | \n1686 |     def transform(self, X):\n1687 |         \"\"\"Transform the data X according to the fitted NMF model.\n1688 | \n1689 |         Parameters\n1690 |         ----------\n1691 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1692 |             Training vector, where `n_samples` is the number of samples\n1693 |             and `n_features` is the number of features.\n1694 | \n1695 |         Returns\n1696 |         -------\n1697 |         W : ndarray of shape (n_samples, n_components)\n1698 |             Transformed data.\n1699 |         \"\"\"\n1700 |         check_is_fitted(self)\n1701 |         X = self._validate_data(\n1702 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n1703 |         )\n1704 | \n1705 |         with config_context(assume_finite=True):\n1706 |             W, *_ = self._fit_transform(X, H=self.components_, update_H=False)\n1707 | \n1708 |         return W\n1709 | \n1710 |     def inverse_transform(self, W):\n1711 |         \"\"\"Transform data back to its original space.\n1712 | \n1713 |         .. versionadded:: 0.18\n1714 | \n1715 |         Parameters\n1716 |         ----------\n1717 |         W : {ndarray, sparse matrix} of shape (n_samples, n_components)\n1718 |             Transformed data matrix.\n1719 | \n1720 |         Returns\n1721 |         -------\n1722 |         X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n1723 |             Returns a data matrix of the original shape.\n1724 |         \"\"\"\n1725 |         check_is_fitted(self)\n1726 |         return np.dot(W, self.components_)\n1727 | \n1728 |     @property\n1729 |     def _n_features_out(self):\n1730 |         \"\"\"Number of transformed output features.\"\"\"\n1731 |         return self.components_.shape[0]\n1732 | \n```\n"}, {"content": "Let me analyze the issue requirements and compare them with the found code.\n\nThe issue requests an online implementation of Non-negative Matrix Factorization (NMF) that would be useful in big data settings. Currently, NMF supports two solvers:\n1. Coordinate Descent (CD) via `solver=\"cd\"`\n2. Multiplicative Update (MU) via `solver=\"mu\"`\n\nHowever, the issue specifically mentions that the current online implementation only supports the kullback-leibler divergence and can be generalized to support any beta divergence.\n\nLooking at the code, we can see that the implementation of multiplicative update solver is in `_fit_multiplicative_update()` function, which currently only handles beta_loss=1 (KL divergence) and beta_loss=2 (Frobenius norm). The core functionality would need to be extended to support other beta values.\n\nLet me find the specific locations that need modification:\n\n```\nsklearn/decomposition/_nmf.py\nline: 643-682\nline: 708-722\nfunction: _multiplicative_update_h_X\n\nsklearn/decomposition/_nmf.py\nline: 824-829\nline: 836-840\nfunction: _fit_multiplicative_update\n\nsklearn/decomposition/_nmf.py\nline: 218-171\nfunction: _beta_divergence\n\nsklearn/decomposition/_nmf.py\nline: 1411-1412\nfunction: _check_params\n\nsklearn/decomposition/_nmf.py\nline: 1447-1461\nfunction: _check_params\n```\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 216121, "completion_tokens": 681}, "time": 144.00625801086426}]}}
{"instance_id": "scikit-learn__scikit-learn-14800", "found_files": [["sklearn/datasets/_openml.py", "sklearn/externals/_arff.py", "sklearn/utils/validation.py"]], "found_modules": [["sklearn/metrics/pairwise.py:_argmin_min_reduce", "sklearn/base.py:RegressorMixin", "sklearn/calibration.py:_SigmoidCalibration", "sklearn/base.py:ClassifierMixin", "sklearn/gaussian_process/_gpr.py:GaussianProcessRegressor", "sklearn/utils/sparsefuncs.py:_get_elem_at_rank", "sklearn/linear_model/_base.py:LinearRegression.fit", "sklearn/neighbors/_nca.py:NeighborhoodComponentsAnalysis", "sklearn/discriminant_analysis.py:LinearDiscriminantAnalysis", "sklearn/pipeline.py:Pipeline", "sklearn/linear_model/_glm/glm.py:GammaRegressor", "sklearn/gaussian_process/kernels.py:CompoundKernel", "sklearn/ensemble/_gb_losses.py:BinomialDeviance", "sklearn/ensemble/_gb.py:BaseGradientBoosting", "sklearn/datasets/_openml.py:fetch_openml", "sklearn/datasets/_openml.py:_download_data_to_bunch", "sklearn/ensemble/_hist_gradient_boosting/grower.py:TreeGrower", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset", "doc/conf.py:SubSectionTitleOrder", "sklearn/model_selection/_search.py:ParameterSampler", "sklearn/linear_model/_stochastic_gradient.py:BaseSGD", "sklearn/utils/_mocking.py:NoSampleWeightWrapper", "sklearn/neural_network/_multilayer_perceptron.py:BaseMultilayerPerceptron", "sklearn/externals/_arff.py:_parse_values", "sklearn/metrics/_plot/base.py:_check_classifier_response_method"]], "found_entities": [["sklearn/metrics/pairwise.py:_argmin_min_reduce", "sklearn/base.py:RegressorMixin._more_tags", "sklearn/calibration.py:_SigmoidCalibration.predict", "sklearn/base.py:ClassifierMixin._more_tags", "sklearn/gaussian_process/_gpr.py:GaussianProcessRegressor._more_tags", "sklearn/utils/sparsefuncs.py:_get_elem_at_rank", "sklearn/linear_model/_base.py:LinearRegression.fit.matvec", "sklearn/neighbors/_nca.py:NeighborhoodComponentsAnalysis._more_tags", "sklearn/linear_model/_base.py:LinearRegression.fit.rmatvec", "sklearn/discriminant_analysis.py:LinearDiscriminantAnalysis.predict_log_proba", "sklearn/pipeline.py:Pipeline.transform", "sklearn/linear_model/_glm/glm.py:GammaRegressor.family", "sklearn/gaussian_process/kernels.py:CompoundKernel.is_stationary", "sklearn/pipeline.py:Pipeline._inverse_transform", "sklearn/ensemble/_gb_losses.py:BinomialDeviance.init_estimator", "sklearn/ensemble/_gb.py:BaseGradientBoosting._make_estimator", "sklearn/ensemble/_gb.py:BaseGradientBoosting._raw_predict", "sklearn/datasets/_openml.py:fetch_openml", "sklearn/datasets/_openml.py:_download_data_to_bunch", "sklearn/ensemble/_hist_gradient_boosting/grower.py:TreeGrower.grow", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.__getitem__", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.__repr__", "doc/conf.py:SubSectionTitleOrder.__repr__", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.setOffset", "sklearn/model_selection/_search.py:ParameterSampler.__len__", "sklearn/linear_model/_stochastic_gradient.py:BaseSGD.standard_intercept_", "sklearn/utils/_mocking.py:NoSampleWeightWrapper.fit", "sklearn/neural_network/_multilayer_perceptron.py:BaseMultilayerPerceptron._init_coef", "sklearn/utils/_mocking.py:NoSampleWeightWrapper.predict", "sklearn/externals/_arff.py:_parse_values", "sklearn/metrics/_plot/base.py:_check_classifier_response_method"]], "raw_output_loc": ["Based on the analysis of the issue and the code, I can now provide the locations that need modification to implement the MD5 checksum validation feature:\n\n```\nsklearn/datasets/_openml.py\nline: 488-606\nfunction: fetch_openml\ndescription: Main function where MD5 checksum should be validated\n\nsklearn/datasets/_openml.py\nline: 508-510\nfunction: _stream_checksum_generator\ndescription: Existing checksum generation logic that needs enhancement\n\nsklearn/datasets/_openml.py\nline: 547-561\nfunction: _download_data_to_bunch\ndescription: Where actual data download and processing happens\n\nsklearn/externals/_arff.py\nline: 286-313\nfunction: _parse_values\ndescription: Helper function for ARFF parsing that processes data values\n\nsklearn/utils/validation.py\nline: 1\nfunction: check_md5_checksum\ndescription: Should contain validation logic implementation\n```\n\nThe locations are ordered by importance. The `fetch_openml` function is the main entry point where the MD5 checksum validation should be implemented. The `_stream_checksum_generator` function currently exists but needs to be enhanced to support checksum validation. The `_download_data_to_bunch` function handles the actual data download and processing. The `_parse_values` function in `_arff.py` handles the ARFF file parsing and may need modifications to support checksum verification. Finally, a new validation function might be added to `validation.py` to handle the checksum comparison."], "meta_data": {"repo": "scikit-learn/scikit-learn", "base_commit": "acb8ac5145cfd88fdbd2d381b34883b2c212c8c5", "problem_statement": "Validate MD5 checksum of downloaded ARFF in fetch_openml\n`fetch_openml` downloads the `data_set_description` from openml.org which includes an `md5_checksum` field. This should correspond to the MD5 checksum of the downloaded ARFF data. We should (optionally?) use `hashlib` to verify that the MD5 matches.\n", "patch": "diff --git a/doc/whats_new/v0.24.rst b/doc/whats_new/v0.24.rst\nindex a647de6dac628..ba137fb76698f 100644\n--- a/doc/whats_new/v0.24.rst\n+++ b/doc/whats_new/v0.24.rst\n@@ -224,6 +224,11 @@ Changelog\n   :meth:`tree.DecisionTreeRegressor.fit`, and has not effect.\n   :pr:`17614` by :user:`Juan Carlos Alfaro Jim\u00e9nez <alfaro96>`.\n \n+:mod:`sklearn.datasets`\n+.......................\n+- |Feature| :func:`datasets.fetch_openml` now validates md5checksum of arff\n+  files downloaded or cached to ensure data integrity.\n+  :pr:`14800` by :user:`Shashank Singh <shashanksingh28>` and `Joel Nothman`_.\n \n Code and Documentation Contributors\n -----------------------------------\ndiff --git a/sklearn/datasets/_openml.py b/sklearn/datasets/_openml.py\nindex 6b537c09c59ad..d2ce5d471f8f7 100644\n--- a/sklearn/datasets/_openml.py\n+++ b/sklearn/datasets/_openml.py\n@@ -2,6 +2,7 @@\n import json\n import os\n import shutil\n+import hashlib\n from os.path import join\n from warnings import warn\n from contextlib import closing\n@@ -492,7 +493,8 @@ def _load_arff_response(\n     url: str,\n     data_home: Optional[str],\n     return_type, encode_nominal: bool,\n-    parse_arff: Callable[[ArffContainerType], Tuple]\n+    parse_arff: Callable[[ArffContainerType], Tuple],\n+    md5_checksum: str\n ) -> Tuple:\n     \"\"\"Load arff data with url and parses arff response with parse_arff\"\"\"\n     response = _open_openml_url(url, data_home)\n@@ -500,10 +502,32 @@ def _load_arff_response(\n     with closing(response):\n         # Note that if the data is dense, no reading is done until the data\n         # generator is iterated.\n-        arff = _arff.load((line.decode('utf-8') for line in response),\n+        actual_md5_checksum = hashlib.md5()\n+\n+        def _stream_checksum_generator(response):\n+            for line in response:\n+                actual_md5_checksum.update(line)\n+                yield line.decode('utf-8')\n+\n+        stream = _stream_checksum_generator(response)\n+\n+        arff = _arff.load(stream,\n                           return_type=return_type,\n                           encode_nominal=encode_nominal)\n-        return parse_arff(arff)\n+\n+        parsed_arff = parse_arff(arff)\n+\n+        # consume remaining stream, if early exited\n+        for _ in stream:\n+            pass\n+\n+        if actual_md5_checksum.hexdigest() != md5_checksum:\n+            raise ValueError(\"md5 checksum of local file for \" + url +\n+                             \" does not match description. \"\n+                             \"Downloaded file could have been modified / \"\n+                             \"corrupted, clean cache and retry...\")\n+\n+        return parsed_arff\n \n \n def _download_data_to_bunch(\n@@ -515,7 +539,8 @@ def _download_data_to_bunch(\n     features_list: List,\n     data_columns: List[int],\n     target_columns: List,\n-    shape: Optional[Tuple[int, int]]\n+    shape: Optional[Tuple[int, int]],\n+    md5_checksum: str\n ):\n     \"\"\"Download OpenML ARFF and convert to Bunch of data\n     \"\"\"\n@@ -609,7 +634,8 @@ def postprocess(X, y, nominal_attributes):\n         _load_arff_response)(url, data_home,\n                              return_type=return_type,\n                              encode_nominal=not as_frame,\n-                             parse_arff=parse_arff)\n+                             parse_arff=parse_arff,\n+                             md5_checksum=md5_checksum)\n     X, y, frame, nominal_attributes = postprocess(*out)\n \n     return Bunch(data=X, target=y, frame=frame,\n@@ -883,7 +909,9 @@ def fetch_openml(\n                                     as_frame=as_frame,\n                                     features_list=features_list, shape=shape,\n                                     target_columns=target_columns,\n-                                    data_columns=data_columns)\n+                                    data_columns=data_columns,\n+                                    md5_checksum=data_description[\n+                                        \"md5_checksum\"])\n \n     if return_X_y:\n         return bunch.data, bunch.target\n"}, "usage": {"cost($)": "0", "prompt_tokens": 202187, "completion_tokens": 589}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'scikit-learn' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described execution flow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described execution flow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Clarify the Purpose of the Issue\n    - If expanding capabilities: Identify where and how are the new behavior, fields, or modules incorporated.\n- Reconstruct the execution flow\n    - Identify main entry points triggering the feature described in the issue.\n    - Trace function calls, class interactions, and sequences of events.\n    - Identify potential relevant points in the code workflow of the codebase.\n    - Use the unique artifacts provided to you to complement your understanding of the execution flow, or use as a hint.\n    Important: Keep the reconstructed flow focused on the problem, avoiding irrelevant details.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Validate MD5 checksum of downloaded ARFF in fetch_openml\n\n`fetch_openml` downloads the `data_set_description` from openml.org which includes an `md5_checksum` field. This should correspond to the MD5 checksum of the downloaded ARFF data. We should (optionally?) use `hashlib` to verify that the MD5 matches.\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n\n\nSupplemental context information:\n\nYou will receive supplemental context for the current task. Use it to better understand the issue and to localize the relevant code more accurately.\n\nTreat this context as additional evidence, not as the final answer.\n- It may contain noise.\n- It may be incomplete.\n- You should carefully analyze it and decide how to use it when searching for relevant code locations.\n\nDepending on the settings, the supplemental context may include:\n1. Unique artifacts\n2. Unique dependency tree\n\n## How to use this supplemental context\n- Use it to identify candidate files, classes, functions, and execution paths that may be relevant to the issue.\n- Cross-check it against the issue description and the repository evidence you collect.\n- Do not assume every artifact is important.\n- Do not assume the provided context is sufficient by itself.\n\n## What the provided information means\nAssume the issue sent to you is a feature request requesting feature F.\n\n1. Unique artifacts\n- The unique artifacts are obtained through a Software Reconnaissance-style analysis.\n- For the requested feature described in the issue text, two Python scripts, A.py and B.py, describing the same process are executed and traced.\n- The only difference is that A.py is executed with feature F enabled, while B.py is executed with the feature disabled.\n- By comparing the two tracing results, the overlapping part between the trace for A.py and B.py is subtracted.\n- The remaining artifacts are the unique artifacts that appear only in A.py.\n- These unique artifacts are likely to be related to the feature and thus to the issue.\n\n2. Unique dependency tree\n- The unique dependency tree is obtained by further analyzing the data dependencies of the unique artifacts.\n- It contains the dataflows associated with the unique artifacts.\n- It can help you understand how the unique artifacts are related to each other and how they are related to other parts of the codebase.\n\n\nHere is the information about the current task:\n1. Unique artifacts (obtained through Software Reconnaissance-style analysis):\n# Unique Artifacts\n\nUse these unique artifacts as supplemental hints, not as final answers.\n\n## Summary\n- Trace A role: `feature_positive`\n- Trace B role: `feature_negative`\n- Comparison: `trace_a_minus_trace_b`\n- Unique functions in JSON: `58`\n- Unique functions shown here: `42`\n- Target package filter: `sklearn`\n\n## Related Files\n- `sklearn/datasets/_openml.py`: `23` unique function(s)\n- `sklearn/externals/_arff.py`: `16` unique function(s)\n- `sklearn/datasets/_base.py`: `1` unique function(s)\n- `sklearn/utils/__init__.py`: `1` unique function(s)\n- `sklearn/utils/validation.py`: `1` unique function(s)\n\n## Artifact Candidates\n- artifact: `sklearn/externals/_arff.py:<listcomp>`\n  - module: `sklearn.externals._arff`\n  - first observed in trace A: `line 291`\n  - observed lines: `291, 292, 496, 497`\n  - trace activity: 5412 events, 301 calls, 4810 line events, 301 returns, 0 exceptions, max depth 12\n  - sample executed lines:\n    - `line 291`: `return [None if s in ('?', '') else s`\n    - `line 292`: `for s in next(csv.reader([s]))]`\n    - `line 496`: `values = [None if value is None else conversor(value)`\n- artifact: `sklearn/datasets/_openml.py:_stream_checksum_generator`\n  - module: `sklearn.datasets._openml`\n  - first observed in trace A: `line 508`\n  - observed lines: `508, 509, 510`\n  - trace activity: 1113 events, 223 calls, 667 line events, 223 returns, 0 exceptions, max depth 11\n  - sample executed lines:\n    - `line 508`: `for line in response:`\n    - `line 509`: `actual_md5_checksum.update(line)`\n    - `line 510`: `yield line.decode('utf-8')`\n- artifact: `sklearn/externals/_arff.py:ArffDecoder._decode.stream`\n  - module: `sklearn.externals._arff`\n  - definition: `lines 880-886`\n  - first observed in trace A: `line 881`\n  - observed lines: `881, 882, 883, 885, 886`\n  - trace activity: 1050 eve