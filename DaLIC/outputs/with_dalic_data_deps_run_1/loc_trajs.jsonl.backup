854 |         ...     [[\"Raphael\", \"red\", \"sai\"], [\"Donatello\", \"purple\", \"bo staff\"]],\n3855 |         ...     columns=[\"name\", \"mask\", \"weapon\"],\n3856 |         ... )\n3857 |         >>> df.to_csv(\"out.csv\", index=False)  # doctest: +SKIP\n3858 | \n3859 |         Create 'out.zip' containing 'out.csv'\n3860 | \n3861 |         >>> df.to_csv(index=False)\n3862 |         'name,mask,weapon\\nRaphael,red,sai\\nDonatello,purple,bo staff\\n'\n3863 |         >>> compression_opts = dict(\n3864 |         ...     method=\"zip\", archive_name=\"out.csv\"\n3865 |         ... )  # doctest: +SKIP\n3866 |         >>> df.to_csv(\n3867 |         ...     \"out.zip\", index=False, compression=compression_opts\n3868 |         ... )  # doctest: +SKIP\n3869 | \n3870 |         To write a csv file to a new folder or nested folder you will first\n3871 |         need to create it using either Pathlib or os:\n3872 | \n3873 |         >>> from pathlib import Path  # doctest: +SKIP\n3874 |         >>> filepath = Path(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3875 |         >>> filepath.parent.mkdir(parents=True, exist_ok=True)  # doctest: +SKIP\n3876 |         >>> df.to_csv(filepath)  # doctest: +SKIP\n3877 | \n3878 |         >>> import os  # doctest: +SKIP\n3879 |         >>> os.makedirs(\"folder/subfolder\", exist_ok=True)  # doctest: +SKIP\n3880 |         >>> df.to_csv(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3881 |         \"\"\"\n3882 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n3883 | \n3884 |         formatter = DataFrameFormatter(\n3885 |             frame=df,\n3886 |             header=header,\n3887 |             index=index,\n3888 |             na_rep=na_rep,\n3889 |             float_format=float_format,\n3890 |             decimal=decimal,\n3891 |         )\n3892 | \n3893 |         return DataFrameRenderer(formatter).to_csv(\n3894 |             path_or_buf,\n3895 |             lineterminator=lineterminator,\n3896 |   