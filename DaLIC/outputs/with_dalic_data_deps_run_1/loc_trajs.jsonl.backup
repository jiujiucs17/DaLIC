6hash.update(buffer)\n1154 |     return sha256hash.hexdigest()\n```\n\n\n\n##Searching for term \"_stream_checksum_generator md5_checksum hashlib\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/_base.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n   1 | \"\"\"\n   2 | Base IO code for all datasets\n   3 | \"\"\"\n   4 | \n   5 | # Copyright (c) 2007 David Cournapeau <cournape@gmail.com>\n   6 | #               2010 Fabian Pedregosa <fabian.pedregosa@inria.fr>\n   7 | #               2010 Olivier Grisel <olivier.grisel@ensta.org>\n   8 | # License: BSD 3 clause\n   9 | import os\n  10 | import csv\n  11 | import shutil\n  12 | from collections import namedtuple\n  13 | from os import environ, listdir, makedirs\n  14 | from os.path import dirname, exists, expanduser, isdir, join, splitext\n  15 | import hashlib\n  16 | \n  17 | from ..utils import Bunch\n  18 | from ..utils import check_random_state\n  19 | from ..utils import check_pandas_support\n  20 | from ..utils.validation import _deprecate_positional_args\n  21 | \n  22 | import numpy as np\n  23 | \n  24 | from urllib.request import urlretrieve\n  25 | \n  26 | RemoteFileMetadata = namedtuple('RemoteFileMetadata',\n  27 |                                 ['filename', 'url', 'checksum'])\n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 40 | XY_METADATA = (\n 41 |     RemoteFileMetadata(\n 42 |         url='https://ndownloader.figshare.com/files/5976069',\n 43 |         checksum=('ed40f7e418d10484091b059703eeb95a'\n 44 |                   'e3199fe042891dcec4be6696b9968374'),\n 45 |         filename='lyrl2004_vectors_test_pt0.dat.gz'),\n 46 |     RemoteFileMetadata(\n 47 |         url='https://ndownloader.figshare.com/files/5976066',\n 48 |         checksum=('87700668ae45d45d5ca1ef6ae9bd81ab'\n 49 |                   '0f5ec88cc95dcef9ae7838f727a13aa6'),\n 50 |         filename='lyrl2004_vectors_test_pt1.dat.gz'),\n 51 |     RemoteFi