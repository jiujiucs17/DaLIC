ccessor import StringMethods\n 152 | from pandas.core.tools.datetimes import to_datetime\n 153 | \n 154 | import pandas.io.formats.format as fmt\n 155 | from pandas.io.formats.info import (\n 156 |     INFO_DOCSTRING,\n 157 |     SeriesInfo,\n 158 |     series_sub_kwargs,\n 159 | )\n 160 | import pandas.plotting\n 161 | \n 162 | if TYPE_CHECKING:\n 163 |     from pandas._libs.internals import BlockValuesRefs\n 164 |     from pandas._typing import (\n 165 |         AggFuncType,\n 166 |         AnyAll,\n 167 |         AnyArrayLike,\n 168 |         ArrayLike,\n 169 |         Axis,\n 170 |         AxisInt,\n 171 |         CorrelationMethod,\n 172 |         DropKeep,\n 173 |         Dtype,\n 174 |         DtypeObj,\n 175 |         FilePath,\n 176 |         Frequency,\n 177 |         IgnoreRaise,\n 178 |         IndexKeyFunc,\n 179 |         IndexLabel,\n 180 |         Level,\n 181 |         ListLike,\n 182 |         MutableMappingT,\n 183 |         NaPosition,\n 184 |         NumpySorter,\n 185 |         NumpyValueArrayLike,\n 186 |         QuantileInterpolation,\n 187 |         ReindexMethod,\n 188 |         Renamer,\n 189 |         Scalar,\n 190 |         Self,\n 191 |         SortKind,\n 192 |         StorageOptions,\n 193 |         Suffixes,\n 194 |         ValueKeyFunc,\n 195 |         WriteBuffer,\n 196 |         npt,\n 197 |     )\n 198 | \n 199 |     from pandas.core.frame import DataFrame\n 200 |     from pandas.core.groupby.generic import SeriesGroupBy\n 201 | \n 202 | __all__ = [\"Series\"]\n 203 | \n 204 | _shared_doc_kwargs = {\n 205 |     \"axes\": \"index\",\n 206 |     \"klass\": \"Series\",\n 207 |     \"axes_single_arg\": \"{0 or 'index'}\",\n 208 |     \"axis\": \"\"\"axis : {0 or 'index'}\n 209 |         Unused. Parameter needed for compatibility with DataFrame.\"\"\",\n 210 |     \"inplace\": \"\"\"inplace : bool, default False\n 211 |         If True, performs operation inplace and returns None.\"\"\",\n 212 |     \"unique\": \"np.ndarray\",\n 213 |     \"duplicated\": \"Series\",\n 214 |     \"optional_by\": \"\",\n 215 |     \"optional_reindex\": \"\"\"\n 216 | index : array-like, optional\n 217 |     New labels for the index. Preferably an Index object to avoid\n 218 |     duplicating data.\n 219 | axis : int or str, optional\n 220 |     Unused.\"\"\",\n 221 | }\n 222 | \n 223 | # ----------------------------------------------------------------------\n 224 | # Series class\n 225 | \n 226 | \n 227 | # error: Cannot override final attribute \"ndim\" (previously declared in base\n 228 | # class \"NDFrame\")\n 229 | # error: Cannot override final attribute \"size\" (previously declared in base\n 230 | # class \"NDFrame\")\n 231 | # definition in base class \"NDFrame\"\n 232 | class Series(base.IndexOpsMixin, NDFrame):  # type: ignore[misc]\n 233 |     \"\"\"\n 234 |     One-dimensional ndarray with axis labels (including time series).\n 235 | \n 236 |     Labels need not be unique but must be a hashable type. The object\n 237 |     supports both integer- and label-based indexing and provides a host of\n 238 |     methods for performing operations involving the index. Statistical\n 239 |     methods from ndarray have been overridden to automatically exclude\n 240 |     missing data (currently represented as NaN).\n 241 | \n 242 |     Operations between Series (+, -, /, \\\\*, \\\\*\\\\*) align values based on their\n 243 |     associated index values-- they need not be the same length. The result\n 244 |     index will be the sorted union of the two indexes.\n 245 | \n 246 |     Parameters\n 247 |     ----------\n 248 |     data : array-like, Iterable, dict, or scalar value\n 249 |         Contains data stored in Series. If data is a dict, argument order is\n 250 |         maintained. Unordered sets are not supported.\n 251 |     index : array-like or Index (1d)\n 252 |         Values must be hashable and have the same length as `data`.\n 253 |         Non-unique index values are allowed. Will default to\n 254 |         RangeIndex (0, 1, 2, ..., n) if not provided. If data is dict-like\n 255 |         and index is None, then the keys in the data are used as the index. If the\n 256 |         index is not None, the resulting Series is reindexed with the index values.\n 257 |     dtype : str, numpy.dtype, or ExtensionDtype, optional\n 258 |         Data type for the output Series. If not specified, this will be\n 259 |         inferred from `data`.\n 260 |         See the :ref:`user guide <basics.dtypes>` for more usages.\n 261 |         If ``data`` is Series then is ignored.\n 262 |     name : Hashable, default None\n 263 |         The name to give to the Series.\n 264 |     copy : bool, default False\n 265 |         Copy input data. Only affects Series or 1d ndarray input. See examples.\n 266 | \n 267 |     See Also\n 268 |     --------\n 269 |     DataFrame : Two-dimensional, size-mutable, potentially heterogeneous tabular data.\n 270 |     Index : Immutable sequence used for indexing and alignment.\n 271 | \n 272 |     Notes\n 273 |     -----\n 274 |     Please reference the :ref:`User Guide <basics.series>` for more information.\n 275 | \n 276 |     Examples\n 277 |     --------\n 278 |     Constructing Series from a dictionary with an Index specified\n 279 | \n 280 |     >>> d = {\"a\": 1, \"b\": 2, \"c\": 3}\n 281 |     >>> ser = pd.Series(data=d, index=[\"a\", \"b\", \"c\"])\n 282 |     >>> ser\n 283 |     a   1\n 284 |     b   2\n 285 |     c   3\n 286 |     dtype: int64\n 287 | \n 288 |     The keys of the dictionary match with the Index values, hence the Index\n 289 |     values have no effect.\n 290 | \n 291 |     >>> d = {\"a\": 1, \"b\": 2, \"c\": 3}\n 292 |     >>> ser = pd.Series(data=d, index=[\"x\", \"y\", \"z\"])\n 293 |     >>> ser\n 294 |     x   NaN\n 295 |     y   NaN\n 296 |     z   NaN\n 297 |     dtype: float64\n 298 | \n 299 |     Note that the Index is first built with the keys from the dictionary.\n 300 |     After this the Series is reindexed with the given Index values, hence we\n 301 |     get all NaN as a result.\n 302 | \n 303 |     Constructing Series from a list with `copy=False`.\n 304 | \n 305 |     >>> r = [1, 2]\n 306 |     >>> ser = pd.Series(r, copy=False)\n 307 |     >>> ser.iloc[0] = 999\n 308 |     >>> r\n 309 |     [1, 2]\n 310 |     >>> ser\n 311 |     0    999\n 312 |     1      2\n 313 |     dtype: int64\n 314 | \n 315 |     Due to input data type the Series has a `copy` of\n 316 |     the original data even though `copy=False`, so\n 317 |     the data is unchanged.\n 318 | \n 319 |     Constructing Series from a 1d ndarray with `copy=False`.\n 320 | \n 321 |     >>> r = np.array([1, 2])\n 322 |     >>> ser = pd.Series(r, copy=False)\n 323 |     >>> ser.iloc[0] = 999\n 324 |     >>> r\n 325 |     array([999,   2])\n 326 |     >>> ser\n 327 |     0    999\n 328 |     1      2\n 329 |     dtype: int64\n 330 | \n 331 |     Due to input data type the Series has a `view` on\n 332 |     the original data, so\n 333 |     the data is changed as well.\n 334 |     \"\"\"\n 335 | \n 336 |     _typ = \"series\"\n 337 |     _HANDLED_TYPES = (Index, ExtensionArray, np.ndarray)\n 338 | \n 339 |     _name: Hashable\n 340 |     _metadata: list[str] = [\"_name\"]\n 341 |     _internal_names_set = {\"index\", \"name\"} | NDFrame._internal_names_set\n 342 |     _accessors = {\"dt\", \"cat\", \"str\", \"sparse\"}\n 343 |     _hidden_attrs = (\n 344 |         base.IndexOpsMixin._hidden_attrs | NDFrame._hidden_attrs | frozenset([])\n 345 |     )\n 346 | \n 347 |     # similar to __array_priority__, positions Series after DataFrame\n 348 |     #  but before Index and ExtensionArray.  Should NOT be overridden by subclasses.\n 349 |     __pandas_priority__ = 3000\n 350 | \n 351 |     # Override cache_readonly bc Series is mutable\n 352 |     # error: Incompatible types in assignment (expression has type \"property\",\n 353 |     # base class \"IndexOpsMixin\" defined the type as \"Callable[[IndexOpsMixin], bool]\")\n 354 |     hasnans = property(  # type: ignore[assignment]\n 355 |         # error: \"Callable[[IndexOpsMixin], bool]\" has no attribute \"fget\"\n 356 |         base.IndexOpsMixin.hasnans.fget,  # type: ignore[attr-defined]\n 357 |         doc=base.IndexOpsMixin.hasnans.__doc__,\n 358 |     )\n 359 |     _mgr: SingleBlockManager\n 360 | \n 361 |     # ----------------------------------------------------------------------\n 362 |     # Constructors\n 363 | \n 364 |     def __init__(\n 365 |         self,\n 366 |         data=None,\n 367 |         index=None,\n 368 |         dtype: Dtype | None = None,\n 369 |         name=None,\n 370 |         copy: bool | None = None,\n 371 |     ) -> None:\n 372 |         allow_mgr = False\n 373 |         if (\n 374 |             isinstance(data, SingleBlockManager)\n 375 |             and index is None\n 376 |             and dtype is None\n 377 |             and (copy is False or copy is None)\n 378 |         ):\n 379 |             if not allow_mgr:\n 380 |                 # GH#52419\n 381 |                 warnings.warn(\n 382 |                     f\"Passing a {type(data).__name__} to {type(self).__name__} \"\n 383 |                     \"is deprecated and will raise in a future version. \"\n 384 |                     \"Use public APIs instead.\",\n 385 |                     DeprecationWarning,\n 386 |                     stacklevel=2,\n 387 |                 )\n 388 |             data = data.copy(deep=False)\n 389 |             # GH#33357 called with just the SingleBlockManager\n 390 |             NDFrame.__init__(self, data)\n 391 |             self.name = name\n 392 |             return\n 393 | \n 394 |         if isinstance(data, (ExtensionArray, np.ndarray)):\n 395 |             if copy is not False:\n 396 |                 if dtype is None or astype_is_view(data.dtype, pandas_dtype(dtype)):\n 397 |                     data = data.copy()\n 398 |         if copy is None:\n 399 |             copy = False\n 400 | \n 401 |         if isinstance(data, SingleBlockManager) and not copy:\n 402 |             data = data.copy(deep=False)\n 403 | \n 404 |             if not allow_mgr:\n 405 |                 warnings.warn(\n 406 |                     f\"Passing a {type(data).__name__} to {type(self).__name__} \"\n 407 |                     \"is deprecated and will raise in a future version. \"\n 408 |                     \"Use public APIs instead.\",\n 409 |                     DeprecationWarning,\n 410 |                     stacklevel=2,\n 411 |                 )\n 412 | \n 413 |         name = ibase.maybe_extract_name(name, data, type(self))\n 414 | \n 415 |         if index is not None:\n 416 |             index = ensure_index(index)\n 417 | \n 418 |         if dtype is not None:\n 419 |             dtype = self._validate_dtype(dtype)\n 420 | \n 421 |         if data is None:\n 422 |             index = index if index is not None else default_index(0)\n 423 |             if len(index) or dtype is not None:\n 424 |                 data = na_value_for_dtype(pandas_dtype(dtype), compat=False)\n 425 |             else:\n 426 |                 data = []\n 427 | \n 428 |         if isinstance(data, MultiIndex):\n 429 |             raise NotImplementedError(\n 430 |                 \"initializing a Series from a MultiIndex is not supported\"\n 431 |             )\n 432 | \n 433 |         refs = None\n 434 |         if isinstance(data, Index):\n 435 |             if dtype is not None:\n 436 |                 data = data.astype(dtype)\n 437 | \n 438 |             refs = data._references\n 439 |             copy = False\n 440 | \n 441 |         elif isinstance(data, np.ndarray):\n 442 |             if len(data.dtype):\n 443 |                 # GH#13296 we are dealing with a compound dtype, which\n 444 |                 #  should be treated as 2D\n 445 |                 raise ValueError(\n 446 |                     \"Cannot construct a Series from an ndarray with \"\n 447 |                     \"compound dtype.  Use DataFrame instead.\"\n 448 |                 )\n 449 |         elif isinstance(data, Series):\n 450 |             if index is None:\n 451 |                 index = data.index\n 452 |                 data = data._mgr.copy(deep=False)\n 453 |             else:\n 454 |                 data = data.reindex(index)\n 455 |                 copy = False\n 456 |                 data = data._mgr\n 457 |         elif isinstance(data, Mapping):\n 458 |             data, index = self._init_dict(data, index, dtype)\n 459 |             dtype = None\n 460 |             copy = False\n 461 |         elif isinstance(data, SingleBlockManager):\n 462 |             if index is None:\n 463 |                 index = data.index\n 464 |             elif not data.index.equals(index) or copy:\n 465 |                 # GH#19275 SingleBlockManager input should only be called\n 466 |                 # internally\n 467 |                 raise AssertionError(\n 468 |                     \"Cannot pass both SingleBlockManager \"\n 469 |                     \"`data` argument and a different \"\n 470 |                     \"`index` argument. `copy` must be False.\"\n 471 |                 )\n 472 | \n 473 |             if not allow_mgr:\n 474 |                 warnings.warn(\n 475 |                     f\"Passing a {type(data).__name__} to {type(self).__name__} \"\n 476 |                     \"is deprecated and will raise in a future version. \"\n 477 |                     \"Use public APIs instead.\",\n 478 |                     DeprecationWarning,\n 479 |                     stacklevel=2,\n 480 |                 )\n 481 |                 allow_mgr = True\n 482 | \n 483 |         elif isinstance(data, ExtensionArray):\n 484 |             pass\n 485 |         else:\n 486 |             data = com.maybe_iterable_to_list(data)\n 487 |             if is_list_like(data) and not len(data) and dtype is None:\n 488 |                 # GH 29405: Pre-2.0, this defaulted to float.\n 489 |                 dtype = np.dtype(object)\n 490 | \n 491 |         if index is None:\n 492 |             if not is_list_like(data):\n 493 |                 data = [data]\n 494 |             index = default_index(len(data))\n 495 |         elif is_list_like(data):\n 496 |             com.require_length_match(data, index)\n 497 | \n 498 |         # create/copy the manager\n 499 |         if isinstance(data, SingleBlockManager):\n 500 |             if dtype is not None:\n 501 |                 data = data.astype(dtype=dtype, errors=\"ignore\")\n 502 |             elif copy:\n 503 |                 data = data.copy()\n 504 |         else:\n 505 |             data = sanitize_array(data, index, dtype, copy)\n 506 |             data = SingleBlockManager.from_array(data, index, refs=refs)\n 507 | \n 508 |         NDFrame.__init__(self, data)\n 509 |         self.name = name\n 510 |         self._set_axis(0, index)\n 511 | \n 512 |     def _init_dict(\n 513 |         self, data: Mapping, index: Index | None = None, dtype: DtypeObj | None = None\n 514 |     ):\n 515 |         \"\"\"\n 516 |         Derive the \"_mgr\" and \"index\" attributes of a new Series from a\n 517 |         dictionary input.\n 518 | \n 519 |         Parameters\n 520 |         ----------\n 521 |         data : dict or dict-like\n 522 |             Data used to populate the new Series.\n 523 |         index : Index or None, default None\n 524 |             Index for the new Series: if None, use dict keys.\n 525 |         dtype : np.dtype, ExtensionDtype, or None, default None\n 526 |             The dtype for the new Series: if None, infer from data.\n 527 | \n 528 |         Returns\n 529 |         -------\n 530 |         _data : BlockManager for the new Series\n 531 |         index : index for the new Series\n 532 |         \"\"\"\n 533 |         # Looking for NaN in dict doesn't work ({np.nan : 1}[float('nan')]\n 534 |         # raises KeyError), so we iterate the entire dict, and align\n 535 |         if data:\n 536 |             # GH:34717, issue was using zip to extract key and values from data.\n 537 |             # using generators in effects the performance.\n 538 |             # Below is the new way of extracting the keys and values\n 539 | \n 540 |             keys = maybe_sequence_to_range(tuple(data.keys()))\n 541 |             values = list(data.values())  # Generating list of values- faster way\n 542 |         elif index is not None:\n 543 |             # fastpath for Series(data=None). Just use broadcasting a scalar\n 544 |             # instead of reindexing.\n 545 |             if len(index) or dtype is not None:\n 546 |                 values = na_value_for_dtype(pandas_dtype(dtype), compat=False)\n 547 |             else:\n 548 |                 values = []\n 549 |             keys = index\n 550 |         else:\n 551 |             keys, values = default_index(0), []\n 552 | \n 553 |         # Input is now list-like, so rely on \"standard\" construction:\n 554 |         s = Series(values, index=keys, dtype=dtype)\n 555 | \n 556 |         # Now we just make sure the order is respected, if any\n 557 |         if data and index is not None:\n 558 |             s = s.reindex(index)\n 559 |         return s._mgr, s.index\n 560 | \n 561 |     # ----------------------------------------------------------------------\n 562 | \n 563 |     def __arrow_c_stream__(self, requested_schema=None):\n 564 |         \"\"\"\n 565 |         Export the pandas Series as an Arrow C stream PyCapsule.\n 566 | \n 567 |         This relies on pyarrow to convert the pandas Series to the Arrow\n 568 |         format (and follows the default behaviour of ``pyarrow.Array.from_pandas``\n 569 |         in its handling of the index, i.e. to ignore it).\n 570 |         This conversion is not necessarily zero-copy.\n 571 | \n 572 |         Parameters\n 573 |         ----------\n 574 |         requested_schema : PyCapsule, default None\n 575 |             The schema to which the dataframe should be casted, passed as a\n 576 |             PyCapsule containing a C ArrowSchema representation of the\n 577 |             requested schema.\n 578 | \n 579 |         Returns\n 580 |         -------\n 581 |         PyCapsule\n 582 |         \"\"\"\n 583 |         pa = import_optional_dependency(\"pyarrow\", min_version=\"16.0.0\")\n 584 |         type = (\n 585 |             pa.DataType._import_from_c_capsule(requested_schema)\n 586 |             if requested_schema is not None\n 587 |             else None\n 588 |         )\n 589 |         ca = pa.array(self, type=type)\n 590 |         if not isinstance(ca, pa.ChunkedArray):\n 591 |             ca = pa.chunked_array([ca])\n 592 |         return ca.__arrow_c_stream__()\n 593 | \n 594 |     # ----------------------------------------------------------------------\n 595 | \n 596 |     @property\n 597 |     def _constructor(self) -> type[Series]:\n 598 |         return Series\n 599 | \n 600 |     def _constructor_from_mgr(self, mgr, axes):\n 601 |         ser = Series._from_mgr(mgr, axes=axes)\n 602 |         ser._name = None  # caller is responsible for setting real name\n 603 | \n 604 |         if type(self) is Series:\n 605 |             # This would also work `if self._constructor is Series`, but\n 606 |             #  this check is slightly faster, benefiting the most-common case.\n 607 |             return ser\n 608 | \n 609 |         # We assume that the subclass __init__ knows how to handle a\n 610 |         #  pd.Series object.\n 611 |         return self._constructor(ser)\n 612 | \n 613 |     @property\n 614 |     def _constructor_expanddim(self) -> Callable[..., DataFrame]:\n 615 |         \"\"\"\n 616 |         Used when a manipulation result has one higher dimension as the\n 617 |         original, such as Series.to_frame()\n 618 |         \"\"\"\n 619 |         from pandas.core.frame import DataFrame\n 620 | \n 621 |         return DataFrame\n 622 | \n 623 |     def _constructor_expanddim_from_mgr(self, mgr, axes):\n 624 |         from pandas.core.frame import DataFrame\n 625 | \n 626 |         df = DataFrame._from_mgr(mgr, axes=mgr.axes)\n 627 | \n 628 |         if type(self) is Series:\n 629 |             # This would also work `if self._constructor_expanddim is DataFrame`,\n 630 |             #  but this check is slightly faster, benefiting the most-common case.\n 631 |             return df\n 632 | \n 633 |         # We assume that the subclass __init__ knows how to handle a\n 634 |         #  pd.DataFrame object.\n 635 |         return self._constructor_expanddim(df)\n 636 | \n 637 |     # types\n 638 |     @property\n 639 |     def _can_hold_na(self) -> bool:\n 640 |         return self._mgr._can_hold_na\n 641 | \n 642 |     # ndarray compatibility\n 643 |     @property\n 644 |     def dtype(self) -> DtypeObj:\n 645 |         \"\"\"\n 646 |         Return the dtype object of the underlying data.\n 647 | \n 648 |         See Also\n 649 |         --------\n 650 |         Series.dtypes : Return the dtype object of the underlying data.\n 651 |         Series.astype : Cast a pandas object to a specified dtype dtype.\n 652 |         Series.convert_dtypes : Convert columns to the best possible dtypes using dtypes\n 653 |             supporting pd.NA.\n 654 | \n 655 |         Examples\n 656 |         --------\n 657 |         >>> s = pd.Series([1, 2, 3])\n 658 |         >>> s.dtype\n 659 |         dtype('int64')\n 660 |         \"\"\"\n 661 |         return self._mgr.dtype\n 662 | \n 663 |     @property\n 664 |     def dtypes(self) -> DtypeObj:\n 665 |         \"\"\"\n 666 |         Return the dtype object of the underlying data.\n 667 | \n 668 |         See Also\n 669 |         --------\n 670 |         DataFrame.dtypes :  Return the dtypes in the DataFrame.\n 671 | \n 672 |         Examples\n 673 |         --------\n 674 |         >>> s = pd.Series([1, 2, 3])\n 675 |         >>> s.dtypes\n 676 |         dtype('int64')\n 677 |         \"\"\"\n 678 |         # DataFrame compatibility\n 679 |         return self.dtype\n 680 | \n 681 |     @property\n 682 |     def name(self) -> Hashable:\n 683 |         \"\"\"\n 684 |         Return the name of the Series.\n 685 | \n 686 |         The name of a Series becomes its index or column name if it is used\n 687 |         to form a DataFrame. It is also used whenever displaying the Series\n 688 |         using the interpreter.\n 689 | \n 690 |         Returns\n 691 |         -------\n 692 |         label (hashable object)\n 693 |             The name of the Series, also the column name if part of a DataFrame.\n 694 | \n 695 |         See Also\n 696 |         --------\n 697 |         Series.rename : Sets the Series name when given a scalar input.\n 698 |         Index.name : Corresponding Index property.\n 699 | \n 700 |         Examples\n 701 |         --------\n 702 |         The Series name can be set initially when calling the constructor.\n 703 | \n 704 |         >>> s = pd.Series([1, 2, 3], dtype=np.int64, name=\"Numbers\")\n 705 |         >>> s\n 706 |         0    1\n 707 |         1    2\n 708 |         2    3\n 709 |         Name: Numbers, dtype: int64\n 710 |         >>> s.name = \"Integers\"\n 711 |         >>> s\n 712 |         0    1\n 713 |         1    2\n 714 |         2    3\n 715 |         Name: Integers, dtype: int64\n 716 | \n 717 |         The name of a Series within a DataFrame is its column name.\n 718 | \n 719 |         >>> df = pd.DataFrame(\n 720 |         ...     [[1, 2], [3, 4], [5, 6]], columns=[\"Odd Numbers\", \"Even Numbers\"]\n 721 |         ... )\n 722 |         >>> df\n 723 |            Odd Numbers  Even Numbers\n 724 |         0            1             2\n 725 |         1            3             4\n 726 |         2            5             6\n 727 |         >>> df[\"Even Numbers\"].name\n 728 |         'Even Numbers'\n 729 |         \"\"\"\n 730 |         return self._name\n 731 | \n 732 |     @name.setter\n 733 |     def name(self, value: Hashable) -> None:\n 734 |         validate_all_hashable(value, error_name=f\"{type(self).__name__}.name\")\n 735 |         object.__setattr__(self, \"_name\", value)\n 736 | \n 737 |     @property\n 738 |     def values(self):\n 739 |         \"\"\"\n 740 |         Return Series as ndarray or ndarray-like depending on the dtype.\n 741 | \n 742 |         .. warning::\n 743 | \n 744 |            We recommend using :attr:`Series.array` or\n 745 |            :meth:`Series.to_numpy`, depending on whether you need\n 746 |            a reference to the underlying data or a NumPy array.\n 747 | \n 748 |         Returns\n 749 |         -------\n 750 |         numpy.ndarray or ndarray-like\n 751 | \n 752 |         See Also\n 753 |         --------\n 754 |         Series.array : Reference to the underlying data.\n 755 |         Series.to_numpy : A NumPy array representing the underlying data.\n 756 | \n 757 |         Examples\n 758 |         --------\n 759 |         >>> pd.Series([1, 2, 3]).values\n 760 |         array([1, 2, 3])\n 761 | \n 762 |         >>> pd.Series(list(\"aabc\")).values\n 763 |         array(['a', 'a', 'b', 'c'], dtype=object)\n 764 | \n 765 |         >>> pd.Series(list(\"aabc\")).astype(\"category\").values\n 766 |         ['a', 'a', 'b', 'c']\n 767 |         Categories (3, object): ['a', 'b', 'c']\n 768 | \n 769 |         Timezone aware datetime data is converted to UTC:\n 770 | \n 771 |         >>> pd.Series(pd.date_range(\"20130101\", periods=3, tz=\"US/Eastern\")).values\n 772 |         array(['2013-01-01T05:00:00.000000000',\n 773 |                '2013-01-02T05:00:00.000000000',\n 774 |                '2013-01-03T05:00:00.000000000'], dtype='datetime64[ns]')\n 775 |         \"\"\"\n 776 |         return self._mgr.external_values()\n 777 | \n 778 |     @property\n 779 |     def _values(self):\n 780 |         \"\"\"\n 781 |         Return the internal repr of this data (defined by Block.interval_values).\n 782 |         This are the values as stored in the Block (ndarray or ExtensionArray\n 783 |         depending on the Block class), with datetime64[ns] and timedelta64[ns]\n 784 |         wrapped in ExtensionArrays to match Index._values behavior.\n 785 | \n 786 |         Differs from the public ``.values`` for certain data types, because of\n 787 |         historical backwards compatibility of the public attribute (e.g. period\n 788 |         returns object ndarray and datetimetz a datetime64[ns] ndarray for\n 789 |         ``.values`` while it returns an ExtensionArray for ``._values`` in those\n 790 |         cases).\n 791 | \n 792 |         Differs from ``.array`` in that this still returns the numpy array if\n 793 |         the Block is backed by a numpy array (except for datetime64 and\n 794 |         timedelta64 dtypes), while ``.array`` ensures to always return an\n 795 |         ExtensionArray.\n 796 | \n 797 |         Overview:\n 798 | \n 799 |         dtype       | values        | _values       | array                 |\n 800 |         ----------- | ------------- | ------------- | --------------------- |\n 801 |         Numeric     | ndarray       | ndarray       | NumpyExtensionArray   |\n 802 |         Category    | Categorical   | Categorical   | Categorical           |\n 803 |         dt64[ns]    | ndarray[M8ns] | DatetimeArray | DatetimeArray         |\n 804 |         dt64[ns tz] | ndarray[M8ns] | DatetimeArray | DatetimeArray         |\n 805 |         td64[ns]    | ndarray[m8ns] | TimedeltaArray| TimedeltaArray        |\n 806 |         Period      | ndarray[obj]  | PeriodArray   | PeriodArray           |\n 807 |         Nullable    | EA            | EA            | EA                    |\n 808 | \n 809 |         \"\"\"\n 810 |         return self._mgr.internal_values()\n 811 | \n 812 |     @property\n 813 |     def _references(self) -> BlockValuesRefs:\n 814 |         return self._mgr._block.refs\n 815 | \n 816 |     @Appender(base.IndexOpsMixin.array.__doc__)  # type: ignore[prop-decorator]\n 817 |     @property\n 818 |     def array(self) -> ExtensionArray:\n 819 |         return self._mgr.array_values()\n 820 | \n 821 |     def __len__(self) -> int:\n 822 |         \"\"\"\n 823 |         Return the length of the Series.\n 824 |         \"\"\"\n 825 |         return len(self._mgr)\n 826 | \n 827 |     # ----------------------------------------------------------------------\n 828 |     # NDArray Compat\n 829 |     def __array__(\n 830 |         self, dtype: npt.DTypeLike | None = None, copy: bool | None = None\n 831 |     ) -> np.ndarray:\n 832 |         \"\"\"\n 833 |         Return the values as a NumPy array.\n 834 | \n 835 |         Users should not call this directly. Rather, it is invoked by\n 836 |         :func:`numpy.array` and :func:`numpy.asarray`.\n 837 | \n 838 |         Parameters\n 839 |         ----------\n 840 |         dtype : str or numpy.dtype, optional\n 841 |             The dtype to use for the resulting NumPy array. By default,\n 842 |             the dtype is inferred from the data.\n 843 | \n 844 |         copy : bool or None, optional\n 845 |             Unused.\n 846 | \n 847 |         Returns\n 848 |         -------\n 849 |         numpy.ndarray\n 850 |             The values in the series converted to a :class:`numpy.ndarray`\n 851 |             with the specified `dtype`.\n 852 | \n 853 |         See Also\n 854 |         --------\n 855 |         array : Create a new array from data.\n 856 |         Series.array : Zero-copy view to the array backing the Series.\n 857 |         Series.to_numpy : Series method for similar behavior.\n 858 | \n 859 |         Examples\n 860 |         --------\n 861 |         >>> ser = pd.Series([1, 2, 3])\n 862 |         >>> np.asarray(ser)\n 863 |         array([1, 2, 3])\n 864 | \n 865 |         For timezone-aware data, the timezones may be retained with\n 866 |         ``dtype='object'``\n 867 | \n 868 |         >>> tzser = pd.Series(pd.date_range(\"2000\", periods=2, tz=\"CET\"))\n 869 |         >>> np.asarray(tzser, dtype=\"object\")\n 870 |         array([Timestamp('2000-01-01 00:00:00+0100', tz='CET'),\n 871 |                Timestamp('2000-01-02 00:00:00+0100', tz='CET')],\n 872 |               dtype=object)\n 873 | \n 874 |         Or the values may be localized to UTC and the tzinfo discarded with\n 875 |         ``dtype='datetime64[ns]'``\n 876 | \n 877 |         >>> np.asarray(tzser, dtype=\"datetime64[ns]\")  # doctest: +ELLIPSIS\n 878 |         array(['1999-12-31T23:00:00.000000000', ...],\n 879 |               dtype='datetime64[ns]')\n 880 |         \"\"\"\n 881 |         values = self._values\n 882 |         arr = np.asarray(values, dtype=dtype)\n 883 |         if astype_is_view(values.dtype, arr.dtype):\n 884 |             arr = arr.view()\n 885 |             arr.flags.writeable = False\n 886 |         return arr\n 887 | \n 888 |     # ----------------------------------------------------------------------\n 889 | \n 890 |     # indexers\n 891 |     @property\n 892 |     def axes(self) -> list[Index]:\n 893 |         \"\"\"\n 894 |         Return a list of the row axis labels.\n 895 |         \"\"\"\n 896 |         return [self.index]\n 897 | \n 898 |     # ----------------------------------------------------------------------\n 899 |     # Indexing Methods\n 900 | \n 901 |     def _ixs(self, i: int, axis: AxisInt = 0) -> Any:\n 902 |         \"\"\"\n 903 |         Return the i-th value or values in the Series by location.\n 904 | \n 905 |         Parameters\n 906 |         ----------\n 907 |         i : int\n 908 | \n 909 |         Returns\n 910 |         -------\n 911 |         scalar\n 912 |         \"\"\"\n 913 |         return self._values[i]\n 914 | \n 915 |     def _slice(self, slobj: slice, axis: AxisInt = 0) -> Series:\n 916 |         # axis kwarg is retained for compat with NDFrame method\n 917 |         #  _slice is *always* positional\n 918 |         mgr = self._mgr.get_slice(slobj, axis=axis)\n 919 |         out = self._constructor_from_mgr(mgr, axes=mgr.axes)\n 920 |         out._name = self._name\n 921 |         return out.__finalize__(self)\n 922 | \n 923 |     def __getitem__(self, key):\n 924 |         check_dict_or_set_indexers(key)\n 925 |         key = com.apply_if_callable(key, self)\n 926 | \n 927 |         if key is Ellipsis:\n 928 |             return self.copy(deep=False)\n 929 | \n 930 |         key_is_scalar = is_scalar(key)\n 931 |         if isinstance(key, (list, tuple)):\n 932 |             key = unpack_1tuple(key)\n 933 | \n 934 |         elif key_is_scalar:\n 935 |             # Note: GH#50617 in 3.0 we changed int key to always be treated as\n 936 |             #  a label, matching DataFrame behavior.\n 937 |             return self._get_value(key)\n 938 | \n 939 |         # Convert generator to list before going through hashable part\n 940 |         # (We will iterate through the generator there to check for slices)\n 941 |         if is_iterator(key):\n 942 |             key = list(key)\n 943 | \n 944 |         if is_hashable(key) and not isinstance(key, slice):\n 945 |             # Otherwise index.get_value will raise InvalidIndexError\n 946 |             try:\n 947 |                 # For labels that don't resolve as scalars like tuples and frozensets\n 948 |                 result = self._get_value(key)\n 949 | \n 950 |                 return result\n 951 | \n 952 |             except (KeyError, TypeError, InvalidIndexError):\n 953 |                 # InvalidIndexError for e.g. generator\n 954 |                 #  see test_series_getitem_corner_generator\n 955 |                 if isinstance(key, tuple) and isinstance(self.index, MultiIndex):\n 956 |                     # We still have the corner case where a tuple is a key\n 957 |                     # in the first level of our MultiIndex\n 958 |                     return self._get_values_tuple(key)\n 959 | \n 960 |         if isinstance(key, slice):\n 961 |             # Do slice check before somewhat-costly is_bool_indexer\n 962 |             return self._getitem_slice(key)\n 963 | \n 964 |         if com.is_bool_indexer(key):\n 965 |             key = check_bool_indexer(self.index, key)\n 966 |             key = np.asarray(key, dtype=bool)\n 967 |             return self._get_rows_with_mask(key)\n 968 | \n 969 |         return self._get_with(key)\n 970 | \n 971 |     def _get_with(self, key):\n 972 |         # other: fancy integer or otherwise\n 973 |         if isinstance(key, ABCDataFrame):\n 974 |             raise TypeError(\n 975 |                 \"Indexing a Series with DataFrame is not \"\n 976 |                 \"supported, use the appropriate DataFrame column\"\n 977 |             )\n 978 |         elif isinstance(key, tuple):\n 979 |             return self._get_values_tuple(key)\n 980 | \n 981 |         return self.loc[key]\n 982 | \n 983 |     def _get_values_tuple(self, key: tuple):\n 984 |         # mpl hackaround\n 985 |         if com.any_none(*key):\n 986 |             # mpl compat if we look up e.g. ser[:, np.newaxis];\n 987 |             #  see tests.series.timeseries.test_mpl_compat_hack\n 988 |             # the asarray is needed to avoid returning a 2D DatetimeArray\n 989 |             result = np.asarray(self._values[key])\n 990 |             disallow_ndim_indexing(result)\n 991 |             return result\n 992 | \n 993 |         if not isinstance(self.index, MultiIndex):\n 994 |             raise KeyError(\"key of type tuple not found and not a MultiIndex\")\n 995 | \n 996 |         # If key is contained, would have returned by now\n 997 |         indexer, new_index = self.index.get_loc_level(key)\n 998 |         new_ser = self._constructor(self._values[indexer], index=new_index, copy=False)\n 999 |         if isinstance(indexer, slice):\n1000 |             new_ser._mgr.add_references(self._mgr)\n1001 |         return new_ser.__finalize__(self)\n1002 | \n1003 |     def _get_rows_with_mask(self, indexer: npt.NDArray[np.bool_]) -> Series:\n1004 |         new_mgr = self._mgr.get_rows_with_mask(indexer)\n1005 |         return self._constructor_from_mgr(new_mgr, axes=new_mgr.axes).__finalize__(self)\n1006 | \n1007 |     def _get_value(self, label, takeable: bool = False):\n1008 |         \"\"\"\n1009 |         Quickly retrieve single value at passed index label.\n1010 | \n1011 |         Parameters\n1012 |         ----------\n1013 |         label : object\n1014 |         takeable : interpret the index as indexers, default False\n1015 | \n1016 |         Returns\n1017 |         -------\n1018 |         scalar value\n1019 |         \"\"\"\n1020 |         if takeable:\n1021 |             return self._values[label]\n1022 | \n1023 |         # Similar to Index.get_value, but we do not fall back to positional\n1024 |         loc = self.index.get_loc(label)\n1025 | \n1026 |         if is_integer(loc):\n1027 |             return self._values[loc]\n1028 | \n1029 |         if isinstance(self.index, MultiIndex):\n1030 |             mi = self.index\n1031 |             new_values = self._values[loc]\n1032 |             if len(new_values) == 1 and mi.nlevels == 1:\n1033 |                 # If more than one level left, we can not return a scalar\n1034 |                 return new_values[0]\n1035 | \n1036 |             new_index = mi[loc]\n1037 |             new_index = maybe_droplevels(new_index, label)\n1038 |             new_ser = self._constructor(\n1039 |                 new_values, index=new_index, name=self.name, copy=False\n1040 |             )\n1041 |             if isinstance(loc, slice):\n1042 |                 new_ser._mgr.add_references(self._mgr)\n1043 |             return new_ser.__finalize__(self)\n1044 | \n1045 |         else:\n1046 |             return self.iloc[loc]\n1047 | \n1048 |     def __setitem__(self, key, value) -> None:\n1049 |         if not PYPY:\n1050 |             if sys.getrefcount(self) <= 3:\n1051 |                 warnings.warn(\n1052 |                     _chained_assignment_msg, ChainedAssignmentError, stacklevel=2\n1053 |                 )\n1054 | \n1055 |         check_dict_or_set_indexers(key)\n1056 |         key = com.apply_if_callable(key, self)\n1057 | \n1058 |         if key is Ellipsis:\n1059 |             key = slice(None)\n1060 | \n1061 |         if isinstance(key, slice):\n1062 |             indexer = self.index._convert_slice_indexer(key, kind=\"getitem\")\n1063 |             return self._set_values(indexer, value)\n1064 | \n1065 |         try:\n1066 |             self._set_with_engine(key, value)\n1067 |         except KeyError:\n1068 |             # We have a scalar (or for MultiIndex or object-dtype, scalar-like)\n1069 |             #  key that is not present in self.index.\n1070 |             # GH#12862 adding a new key to the Series\n1071 |             self.loc[key] = value\n1072 | \n1073 |         except (TypeError, ValueError, LossySetitemError):\n1074 |             # The key was OK, but we cannot set the value losslessly\n1075 |             indexer = self.index.get_loc(key)\n1076 |             self._set_values(indexer, value)\n1077 | \n1078 |         except InvalidIndexError as err:\n1079 |             if isinstance(key, tuple) and not isinstance(self.index, MultiIndex):\n1080 |                 # cases with MultiIndex don't get here bc they raise KeyError\n1081 |                 # e.g. test_basic_getitem_setitem_corner\n1082 |                 raise KeyError(\n1083 |                     \"key of type tuple not found and not a MultiIndex\"\n1084 |                 ) from err\n1085 | \n1086 |             if com.is_bool_indexer(key):\n1087 |                 key = check_bool_indexer(self.index, key)\n1088 |                 key = np.asarray(key, dtype=bool)\n1089 | \n1090 |                 if (\n1091 |                     is_list_like(value)\n1092 |                     and len(value) != len(self)\n1093 |                     and not isinstance(value, Series)\n1094 |                     and not is_object_dtype(self.dtype)\n1095 |                 ):\n1096 |                     # Series will be reindexed to have matching length inside\n1097 |                     #  _where call below\n1098 |                     # GH#44265\n1099 |                     indexer = key.nonzero()[0]\n1100 |                     self._set_values(indexer, value)\n1101 |                     return\n1102 | \n1103 |                 # otherwise with listlike other we interpret series[mask] = other\n1104 |                 #  as series[mask] = other[mask]\n1105 |                 try:\n1106 |                     self._where(~key, value, inplace=True)\n1107 |                 except InvalidIndexError:\n1108 |                     # test_where_dups\n1109 |                     self.iloc[key] = value\n1110 |                 return\n1111 | \n1112 |             else:\n1113 |                 self._set_with(key, value)\n1114 | \n1115 |     def _set_with_engine(self, key, value) -> None:\n1116 |         loc = self.index.get_loc(key)\n1117 | \n1118 |         # this is equivalent to self._values[key] = value\n1119 |         self._mgr.setitem_inplace(loc, value)\n1120 | \n1121 |     def _set_with(self, key, value) -> None:\n1122 |         # We got here via exception-handling off of InvalidIndexError, so\n1123 |         #  key should always be listlike at this point.\n1124 |         assert not isinstance(key, tuple)\n1125 | \n1126 |         if is_iterator(key):\n1127 |             # Without this, the call to infer_dtype will consume the generator\n1128 |             key = list(key)\n1129 | \n1130 |         self._set_labels(key, value)\n1131 | \n1132 |     def _set_labels(self, key, value) -> None:\n1133 |         key = com.asarray_tuplesafe(key)\n1134 |         indexer: np.ndarray = self.index.get_indexer(key)\n1135 |         mask = indexer == -1\n1136 |         if mask.any():\n1137 |             raise KeyError(f\"{key[mask]} not in index\")\n1138 |         self._set_values(indexer, value)\n1139 | \n1140 |     def _set_values(self, key, value) -> None:\n1141 |         if isinstance(key, (Index, Series)):\n1142 |             key = key._values\n1143 | \n1144 |         self._mgr = self._mgr.setitem(indexer=key, value=value)\n1145 | \n1146 |     def _set_value(self, label, value, takeable: bool = False) -> None:\n1147 |         \"\"\"\n1148 |         Quickly set single value at passed label.\n1149 | \n1150 |         If label is not contained, a new object is created with the label\n1151 |         placed at the end of the result index.\n1152 | \n1153 |         Parameters\n1154 |         ----------\n1155 |         label : object\n1156 |             Partial indexing with MultiIndex not allowed.\n1157 |         value : object\n1158 |             Scalar value.\n1159 |         takeable : interpret the index as indexers, default False\n1160 |         \"\"\"\n1161 |         if not takeable:\n1162 |             try:\n1163 |                 loc = self.index.get_loc(label)\n1164 |             except KeyError:\n1165 |                 # set using a non-recursive method\n1166 |                 self.loc[label] = value\n1167 |                 return\n1168 |         else:\n1169 |             loc = label\n1170 | \n1171 |         self._set_values(loc, value)\n1172 | \n1173 |     # ----------------------------------------------------------------------\n1174 |     # Unsorted\n1175 | \n1176 |     def repeat(self, repeats: int | Sequence[int], axis: None = None) -> Series:\n1177 |         \"\"\"\n1178 |         Repeat elements of a Series.\n1179 | \n1180 |         Returns a new Series where each element of the current Series\n1181 |         is repeated consecutively a given number of times.\n1182 | \n1183 |         Parameters\n1184 |         ----------\n1185 |         repeats : int or array of ints\n1186 |             The number of repetitions for each element. This should be a\n1187 |             non-negative integer. Repeating 0 times will return an empty\n1188 |             Series.\n1189 |         axis : None\n1190 |             Unused. Parameter needed for compatibility with DataFrame.\n1191 | \n1192 |         Returns\n1193 |         -------\n1194 |         Series\n1195 |             Newly created Series with repeated elements.\n1196 | \n1197 |         See Also\n1198 |         --------\n1199 |         Index.repeat : Equivalent function for Index.\n1200 |         numpy.repeat : Similar method for :class:`numpy.ndarray`.\n1201 | \n1202 |         Examples\n1203 |         --------\n1204 |         >>> s = pd.Series([\"a\", \"b\", \"c\"])\n1205 |         >>> s\n1206 |         0    a\n1207 |         1    b\n1208 |         2    c\n1209 |         dtype: object\n1210 |         >>> s.repeat(2)\n1211 |         0    a\n1212 |         0    a\n1213 |         1    b\n1214 |         1    b\n1215 |         2    c\n1216 |         2    c\n1217 |         dtype: object\n1218 |         >>> s.repeat([1, 2, 3])\n1219 |         0    a\n1220 |         1    b\n1221 |         1    b\n1222 |         2    c\n1223 |         2    c\n1224 |         2    c\n1225 |         dtype: object\n1226 |         \"\"\"\n1227 |         nv.validate_repeat((), {\"axis\": axis})\n1228 |         new_index = self.index.repeat(repeats)\n1229 |         new_values = self._values.repeat(repeats)\n1230 |         return self._constructor(new_values, index=new_index, copy=False).__finalize__(\n1231 |             self, method=\"repeat\"\n1232 |         )\n1233 | \n1234 |     @overload\n1235 |     def reset_index(\n1236 |         self,\n1237 |         level: IndexLabel = ...,\n1238 |         *,\n1239 |         drop: Literal[False] = ...,\n1240 |         name: Level = ...,\n1241 |         inplace: Literal[False] = ...,\n1242 |         allow_duplicates: bool = ...,\n1243 |     ) -> DataFrame: ...\n1244 | \n1245 |     @overload\n1246 |     def reset_index(\n1247 |         self,\n1248 |         level: IndexLabel = ...,\n1249 |         *,\n1250 |         drop: Literal[True],\n1251 |         name: Level = ...,\n1252 |         inplace: Literal[False] = ...,\n1253 |         allow_duplicates: bool = ...,\n1254 |     ) -> Series: ...\n1255 | \n1256 |     @overload\n1257 |     def reset_index(\n1258 |         self,\n1259 |         level: IndexLabel = ...,\n1260 |         *,\n1261 |         drop: bool = ...,\n1262 |         name: Level = ...,\n1263 |         inplace: Literal[True],\n1264 |         allow_duplicates: bool = ...,\n1265 |     ) -> None: ...\n1266 | \n1267 |     def reset_index(\n1268 |         self,\n1269 |         level: IndexLabel | None = None,\n1270 |         *,\n1271 |         drop: bool = False,\n1272 |         name: Level = lib.no_default,\n1273 |         inplace: bool = False,\n1274 |         allow_duplicates: bool = False,\n1275 |     ) -> DataFrame | Series | None:\n1276 |         \"\"\"\n1277 |         Generate a new DataFrame or Series with the index reset.\n1278 | \n1279 |         This is useful when the index needs to be treated as a column, or\n1280 |         when the index is meaningless and needs to be reset to the default\n1281 |         before another operation.\n1282 | \n1283 |         Parameters\n1284 |         ----------\n1285 |         level : int, str, tuple, or list, default optional\n1286 |             For a Series with a MultiIndex, only remove the specified levels\n1287 |             from the index. Removes all levels by default.\n1288 |         drop : bool, default False\n1289 |             Just reset the index, without inserting it as a column in\n1290 |             the new DataFrame.\n1291 |         name : object, optional\n1292 |             The name to use for the column containing the original Series\n1293 |             values. Uses ``self.name`` by default. This argument is ignored\n1294 |             when `drop` is True.\n1295 |         inplace : bool, default False\n1296 |             Modify the Series in place (do not create a new object).\n1297 |         allow_duplicates : bool, default False\n1298 |             Allow duplicate column labels to be created.\n1299 | \n1300 |             .. versionadded:: 1.5.0\n1301 | \n1302 |         Returns\n1303 |         -------\n1304 |         Series or DataFrame or None\n1305 |             When `drop` is False (the default), a DataFrame is returned.\n1306 |             The newly created columns will come first in the DataFrame,\n1307 |             followed by the original Series values.\n1308 |             When `drop` is True, a `Series` is returned.\n1309 |             In either case, if ``inplace=True``, no value is returned.\n1310 | \n1311 |         See Also\n1312 |         --------\n1313 |         DataFrame.reset_index: Analogous function for DataFrame.\n1314 | \n1315 |         Examples\n1316 |         --------\n1317 |         >>> s = pd.Series(\n1318 |         ...     [1, 2, 3, 4],\n1319 |         ...     name=\"foo\",\n1320 |         ...     index=pd.Index([\"a\", \"b\", \"c\", \"d\"], name=\"idx\"),\n1321 |         ... )\n1322 | \n1323 |         Generate a DataFrame with default index.\n1324 | \n1325 |         >>> s.reset_index()\n1326 |           idx  foo\n1327 |         0   a    1\n1328 |         1   b    2\n1329 |         2   c    3\n1330 |         3   d    4\n1331 | \n1332 |         To specify the name of the new column use `name`.\n1333 | \n1334 |         >>> s.reset_index(name=\"values\")\n1335 |           idx  values\n1336 |         0   a       1\n1337 |         1   b       2\n1338 |         2   c       3\n1339 |         3   d       4\n1340 | \n1341 |         To generate a new Series with the default set `drop` to True.\n1342 | \n1343 |         >>> s.reset_index(drop=True)\n1344 |         0    1\n1345 |         1    2\n1346 |         2    3\n1347 |         3    4\n1348 |         Name: foo, dtype: int64\n1349 | \n1350 |         The `level` parameter is interesting for Series with a multi-level\n1351 |         index.\n1352 | \n1353 |         >>> arrays = [\n1354 |         ...     np.array([\"bar\", \"bar\", \"baz\", \"baz\"]),\n1355 |         ...     np.array([\"one\", \"two\", \"one\", \"two\"]),\n1356 |         ... ]\n1357 |         >>> s2 = pd.Series(\n1358 |         ...     range(4),\n1359 |         ...     name=\"foo\",\n1360 |         ...     index=pd.MultiIndex.from_arrays(arrays, names=[\"a\", \"b\"]),\n1361 |         ... )\n1362 | \n1363 |         To remove a specific level from the Index, use `level`.\n1364 | \n1365 |         >>> s2.reset_index(level=\"a\")\n1366 |                a  foo\n1367 |         b\n1368 |         one  bar    0\n1369 |         two  bar    1\n1370 |         one  baz    2\n1371 |         two  baz    3\n1372 | \n1373 |         If `level` is not set, all levels are removed from the Index.\n1374 | \n1375 |         >>> s2.reset_index()\n1376 |              a    b  foo\n1377 |         0  bar  one    0\n1378 |         1  bar  two    1\n1379 |         2  baz  one    2\n1380 |         3  baz  two    3\n1381 |         \"\"\"\n1382 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n1383 |         if drop:\n1384 |             new_index = default_index(len(self))\n1385 |             if level is not None:\n1386 |                 level_list: Sequence[Hashable]\n1387 |                 if not isinstance(level, (tuple, list)):\n1388 |                     level_list = [level]\n1389 |                 else:\n1390 |                     level_list = level\n1391 |                 level_list = [self.index._get_level_number(lev) for lev in level_list]\n1392 |                 if len(level_list) < self.index.nlevels:\n1393 |                     new_index = self.index.droplevel(level_list)\n1394 | \n1395 |             if inplace:\n1396 |                 self.index = new_index\n1397 |             else:\n1398 |                 new_ser = self.copy(deep=False)\n1399 |                 new_ser.index = new_index\n1400 |                 return new_ser.__finalize__(self, method=\"reset_index\")\n1401 |         elif inplace:\n1402 |             raise TypeError(\n1403 |                 \"Cannot reset_index inplace on a Series to create a DataFrame\"\n1404 |             )\n1405 |         else:\n1406 |             if name is lib.no_default:\n1407 |                 # For backwards compatibility, keep columns as [0] instead of\n1408 |                 #  [None] when self.name is None\n1409 |                 if self.name is None:\n1410 |                     name = 0\n1411 |                 else:\n1412 |                     name = self.name\n1413 | \n1414 |             df = self.to_frame(name)\n1415 |             return df.reset_index(\n1416 |                 level=level, drop=drop, allow_duplicates=allow_duplicates\n1417 |             )\n1418 |         return None\n1419 | \n1420 |     # ----------------------------------------------------------------------\n1421 |     # Rendering Methods\n1422 | \n1423 |     def __repr__(self) -> str:\n1424 |         \"\"\"\n1425 |         Return a string representation for a particular Series.\n1426 |         \"\"\"\n1427 |         repr_params = fmt.get_series_repr_params()\n1428 |         return self.to_string(**repr_params)\n1429 | \n1430 |     @overload\n1431 |     def to_string(\n1432 |         self,\n1433 |         buf: None = ...,\n1434 |         *,\n1435 |         na_rep: str = ...,\n1436 |         float_format: str | None = ...,\n1437 |         header: bool = ...,\n1438 |         index: bool = ...,\n1439 |         length: bool = ...,\n1440 |         dtype=...,\n1441 |         name=...,\n1442 |         max_rows: int | None = ...,\n1443 |         min_rows: int | None = ...,\n1444 |     ) -> str: ...\n1445 | \n1446 |     @overload\n1447 |     def to_string(\n1448 |         self,\n1449 |         buf: FilePath | WriteBuffer[str],\n1450 |         *,\n1451 |         na_rep: str = ...,\n1452 |         float_format: str | None = ...,\n1453 |         header: bool = ...,\n1454 |         index: bool = ...,\n1455 |         length: bool = ...,\n1456 |         dtype=...,\n1457 |         name=...,\n1458 |         max_rows: int | None = ...,\n1459 |         min_rows: int | None = ...,\n1460 |     ) -> None: ...\n1461 | \n1462 |     @deprecate_nonkeyword_arguments(\n1463 |         version=\"4.0\", allowed_args=[\"self\", \"buf\"], name=\"to_string\"\n1464 |     )\n1465 |     def to_string(\n1466 |         self,\n1467 |         buf: FilePath | WriteBuffer[str] | None = None,\n1468 |         na_rep: str = \"NaN\",\n1469 |         float_format: str | None = None,\n1470 |         header: bool = True,\n1471 |         index: bool = True,\n1472 |         length: bool = False,\n1473 |         dtype: bool = False,\n1474 |         name: bool = False,\n1475 |         max_rows: int | None = None,\n1476 |         min_rows: int | None = None,\n1477 |     ) -> str | None:\n1478 |         \"\"\"\n1479 |         Render a string representation of the Series.\n1480 | \n1481 |         Parameters\n1482 |         ----------\n1483 |         buf : StringIO-like, optional\n1484 |             Buffer to write to.\n1485 |         na_rep : str, optional\n1486 |             String representation of NaN to use, default 'NaN'.\n1487 |         float_format : one-parameter function, optional\n1488 |             Formatter function to apply to columns' elements if they are\n1489 |             floats, default None.\n1490 |         header : bool, default True\n1491 |             Add the Series header (index name).\n1492 |         index : bool, optional\n1493 |             Add index (row) labels, default True.\n1494 |         length : bool, default False\n1495 |             Add the Series length.\n1496 |         dtype : bool, default False\n1497 |             Add the Series dtype.\n1498 |         name : bool, default False\n1499 |             Add the Series name if not None.\n1500 |         max_rows : int, optional\n1501 |             Maximum number of rows to show before truncating. If None, show\n1502 |             all.\n1503 |         min_rows : int, optional\n1504 |             The number of rows to display in a truncated repr (when number\n1505 |             of rows is above `max_rows`).\n1506 | \n1507 |         Returns\n1508 |         -------\n1509 |         str or None\n1510 |             String representation of Series if ``buf=None``, otherwise None.\n1511 | \n1512 |         See Also\n1513 |         --------\n1514 |         Series.to_dict : Convert Series to dict object.\n1515 |         Series.to_frame : Convert Series to DataFrame object.\n1516 |         Series.to_markdown : Print Series in Markdown-friendly format.\n1517 |         Series.to_timestamp : Cast to DatetimeIndex of Timestamps.\n1518 | \n1519 |         Examples\n1520 |         --------\n1521 |         >>> ser = pd.Series([1, 2, 3]).to_string()\n1522 |         >>> ser\n1523 |         '0    1\\\\n1    2\\\\n2    3'\n1524 |         \"\"\"\n1525 |         formatter = fmt.SeriesFormatter(\n1526 |             self,\n1527 |             name=name,\n1528 |             length=length,\n1529 |             header=header,\n1530 |             index=index,\n1531 |             dtype=dtype,\n1532 |             na_rep=na_rep,\n1533 |             float_format=float_format,\n1534 |             min_rows=min_rows,\n1535 |             max_rows=max_rows,\n1536 |         )\n1537 |         result = formatter.to_string()\n1538 | \n1539 |         # catch contract violations\n1540 |         if not isinstance(result, str):\n1541 |             raise AssertionError(\n1542 |                 \"result must be of type str, type \"\n1543 |                 f\"of result is {type(result).__name__!r}\"\n1544 |             )\n1545 | \n1546 |         if buf is None:\n1547 |             return result\n1548 |         else:\n1549 |             if hasattr(buf, \"write\"):\n1550 |                 buf.write(result)\n1551 |             else:\n1552 |                 with open(buf, \"w\", encoding=\"utf-8\") as f:\n1553 |                     f.write(result)\n1554 |         return None\n1555 | \n1556 |     @overload\n1557 |     def to_markdown(\n1558 |         self,\n1559 |         buf: None = ...,\n1560 |         *,\n1561 |         mode: str = ...,\n1562 |         index: bool = ...,\n1563 |         storage_options: StorageOptions | None = ...,\n1564 |         **kwargs,\n1565 |     ) -> str: ...\n1566 | \n1567 |     @overload\n1568 |     def to_markdown(\n1569 |         self,\n1570 |         buf: IO[str],\n1571 |         *,\n1572 |         mode: str = ...,\n1573 |         index: bool = ...,\n1574 |         storage_options: StorageOptions | None = ...,\n1575 |         **kwargs,\n1576 |     ) -> None: ...\n1577 | \n1578 |     @overload\n1579 |     def to_markdown(\n1580 |         self,\n1581 |         buf: IO[str] | None,\n1582 |         *,\n1583 |         mode: str = ...,\n1584 |         index: bool = ...,\n1585 |         storage_options: StorageOptions | None = ...,\n1586 |         **kwargs,\n1587 |     ) -> str | None: ...\n1588 | \n1589 |     @doc(\n1590 |         klass=_shared_doc_kwargs[\"klass\"],\n1591 |         storage_options=_shared_docs[\"storage_options\"],\n1592 |         examples=dedent(\n1593 |             \"\"\"Examples\n1594 |             --------\n1595 |             >>> s = pd.Series([\"elk\", \"pig\", \"dog\", \"quetzal\"], name=\"animal\")\n1596 |             >>> print(s.to_markdown())\n1597 |             |    | animal   |\n1598 |             |---:|:---------|\n1599 |             |  0 | elk      |\n1600 |             |  1 | pig      |\n1601 |             |  2 | dog      |\n1602 |             |  3 | quetzal  |\n1603 | \n1604 |             Output markdown with a tabulate option.\n1605 | \n1606 |             >>> print(s.to_markdown(tablefmt=\"grid\"))\n1607 |             +----+----------+\n1608 |             |    | animal   |\n1609 |             +====+==========+\n1610 |             |  0 | elk      |\n1611 |             +----+----------+\n1612 |             |  1 | pig      |\n1613 |             +----+----------+\n1614 |             |  2 | dog      |\n1615 |             +----+----------+\n1616 |             |  3 | quetzal  |\n1617 |             +----+----------+\"\"\"\n1618 |         ),\n1619 |     )\n1620 |     @deprecate_nonkeyword_arguments(\n1621 |         version=\"4.0\", allowed_args=[\"self\", \"buf\"], name=\"to_markdown\"\n1622 |     )\n1623 |     def to_markdown(\n1624 |         self,\n1625 |         buf: IO[str] | None = None,\n1626 |         mode: str = \"wt\",\n1627 |         index: bool = True,\n1628 |         storage_options: StorageOptions | None = None,\n1629 |         **kwargs,\n1630 |     ) -> str | None:\n1631 |         \"\"\"\n1632 |         Print {klass} in Markdown-friendly format.\n1633 | \n1634 |         Parameters\n1635 |         ----------\n1636 |         buf : str, Path or StringIO-like, optional, default None\n1637 |             Buffer to write to. If None, the output is returned as a string.\n1638 |         mode : str, optional\n1639 |             Mode in which file is opened, \"wt\" by default.\n1640 |         index : bool, optional, default True\n1641 |             Add index (row) labels.\n1642 | \n1643 |         {storage_options}\n1644 | \n1645 |         **kwargs\n1646 |             These parameters will be passed to `tabulate \\\n1647 |                 <https://pypi.org/project/tabulate>`_.\n1648 | \n1649 |         Returns\n1650 |         -------\n1651 |         str\n1652 |             {klass} in Markdown-friendly format.\n1653 | \n1654 |         See Also\n1655 |         --------\n1656 |         Series.to_frame : Rrite a text representation of object to the system clipboard.\n1657 |         Series.to_latex : Render Series to LaTeX-formatted table.\n1658 | \n1659 |         Notes\n1660 |         -----\n1661 |         Requires the `tabulate <https://pypi.org/project/tabulate>`_ package.\n1662 | \n1663 |         {examples}\n1664 |         \"\"\"\n1665 |         return self.to_frame().to_markdown(\n1666 |             buf, mode=mode, index=index, storage_options=storage_options, **kwargs\n1667 |         )\n1668 | \n1669 |     # ----------------------------------------------------------------------\n1670 | \n1671 |     def items(self) -> Iterable[tuple[Hashable, Any]]:\n1672 |         \"\"\"\n1673 |         Lazily iterate over (index, value) tuples.\n1674 | \n1675 |         This method returns an iterable tuple (index, value). This is\n1676 |         convenient if you want to create a lazy iterator.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         iterable\n1681 |             Iterable of tuples containing the (index, value) pairs from a\n1682 |             Series.\n1683 | \n1684 |         See Also\n1685 |         --------\n1686 |         DataFrame.items : Iterate over (column name, Series) pairs.\n1687 |         DataFrame.iterrows : Iterate over DataFrame rows as (index, Series) pairs.\n1688 | \n1689 |         Examples\n1690 |         --------\n1691 |         >>> s = pd.Series([\"A\", \"B\", \"C\"])\n1692 |         >>> for index, value in s.items():\n1693 |         ...     print(f\"Index : {index}, Value : {value}\")\n1694 |         Index : 0, Value : A\n1695 |         Index : 1, Value : B\n1696 |         Index : 2, Value : C\n1697 |         \"\"\"\n1698 |         return zip(iter(self.index), iter(self))\n1699 | \n1700 |     # ----------------------------------------------------------------------\n1701 |     # Misc public methods\n1702 | \n1703 |     def keys(self) -> Index:\n1704 |         \"\"\"\n1705 |         Return alias for index.\n1706 | \n1707 |         Returns\n1708 |         -------\n1709 |         Index\n1710 |             Index of the Series.\n1711 | \n1712 |         See Also\n1713 |         --------\n1714 |         Series.index : The index (axis labels) of the Series.\n1715 | \n1716 |         Examples\n1717 |         --------\n1718 |         >>> s = pd.Series([1, 2, 3], index=[0, 1, 2])\n1719 |         >>> s.keys()\n1720 |         Index([0, 1, 2], dtype='int64')\n1721 |         \"\"\"\n1722 |         return self.index\n1723 | \n1724 |     @overload\n1725 |     def to_dict(\n1726 |         self, *, into: type[MutableMappingT] | MutableMappingT\n1727 |     ) -> MutableMappingT: ...\n1728 | \n1729 |     @overload\n1730 |     def to_dict(self, *, into: type[dict] = ...) -> dict: ...\n1731 | \n1732 |     # error: Incompatible default for argument \"into\" (default has type \"type[\n1733 |     # dict[Any, Any]]\", argument has type \"type[MutableMappingT] | MutableMappingT\")\n1734 |     def to_dict(\n1735 |         self,\n1736 |         *,\n1737 |         into: type[MutableMappingT] | MutableMappingT = dict,  # type: ignore[assignment]\n1738 |     ) -> MutableMappingT:\n1739 |         \"\"\"\n1740 |         Convert Series to {label -> value} dict or dict-like object.\n1741 | \n1742 |         Parameters\n1743 |         ----------\n1744 |         into : class, default dict\n1745 |             The collections.abc.MutableMapping subclass to use as the return\n1746 |             object. Can be the actual class or an empty instance of the mapping\n1747 |             type you want.  If you want a collections.defaultdict, you must\n1748 |             pass it initialized.\n1749 | \n1750 |         Returns\n1751 |         -------\n1752 |         collections.abc.MutableMapping\n1753 |             Key-value representation of Series.\n1754 | \n1755 |         See Also\n1756 |         --------\n1757 |         Series.to_list: Converts Series to a list of the values.\n1758 |         Series.to_numpy: Converts Series to NumPy ndarray.\n1759 |         Series.array: ExtensionArray of the data backing this Series.\n1760 | \n1761 |         Examples\n1762 |         --------\n1763 |         >>> s = pd.Series([1, 2, 3, 4])\n1764 |         >>> s.to_dict()\n1765 |         {0: 1, 1: 2, 2: 3, 3: 4}\n1766 |         >>> from collections import OrderedDict, defaultdict\n1767 |         >>> s.to_dict(into=OrderedDict)\n1768 |         OrderedDict([(0, 1), (1, 2), (2, 3), (3, 4)])\n1769 |         >>> dd = defaultdict(list)\n1770 |         >>> s.to_dict(into=dd)\n1771 |         defaultdict(<class 'list'>, {0: 1, 1: 2, 2: 3, 3: 4})\n1772 |         \"\"\"\n1773 |         # GH16122\n1774 |         into_c = com.standardize_mapping(into)\n1775 | \n1776 |         if is_object_dtype(self.dtype) or isinstance(self.dtype, ExtensionDtype):\n1777 |             return into_c((k, maybe_box_native(v)) for k, v in self.items())\n1778 |         else:\n1779 |             # Not an object dtype => all types will be the same so let the default\n1780 |             # indexer return native python type\n1781 |             return into_c(self.items())\n1782 | \n1783 |     def to_frame(self, name: Hashable = lib.no_default) -> DataFrame:\n1784 |         \"\"\"\n1785 |         Convert Series to DataFrame.\n1786 | \n1787 |         Parameters\n1788 |         ----------\n1789 |         name : object, optional\n1790 |             The passed name should substitute for the series name (if it has\n1791 |             one).\n1792 | \n1793 |         Returns\n1794 |         -------\n1795 |         DataFrame\n1796 |             DataFrame representation of Series.\n1797 | \n1798 |         See Also\n1799 |         --------\n1800 |         Series.to_dict : Convert Series to dict object.\n1801 | \n1802 |         Examples\n1803 |         --------\n1804 |         >>> s = pd.Series([\"a\", \"b\", \"c\"], name=\"vals\")\n1805 |         >>> s.to_frame()\n1806 |           vals\n1807 |         0    a\n1808 |         1    b\n1809 |         2    c\n1810 |         \"\"\"\n1811 |         columns: Index\n1812 |         if name is lib.no_default:\n1813 |             name = self.name\n1814 |             if name is None:\n1815 |                 # default to [0], same as we would get with DataFrame(self)\n1816 |                 columns = default_index(1)\n1817 |             else:\n1818 |                 columns = Index([name])\n1819 |         else:\n1820 |             columns = Index([name])\n1821 | \n1822 |         mgr = self._mgr.to_2d_mgr(columns)\n1823 |         df = self._constructor_expanddim_from_mgr(mgr, axes=mgr.axes)\n1824 |         return df.__finalize__(self, method=\"to_frame\")\n1825 | \n1826 |     def _set_name(\n1827 |         self, name, inplace: bool = False, deep: bool | None = None\n1828 |     ) -> Series:\n1829 |         \"\"\"\n1830 |         Set the Series name.\n1831 | \n1832 |         Parameters\n1833 |         ----------\n1834 |         name : str\n1835 |         inplace : bool\n1836 |             Whether to modify `self` directly or return a copy.\n1837 |         \"\"\"\n1838 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n1839 |         ser = self if inplace else self.copy(deep=False)\n1840 |         ser.name = name\n1841 |         return ser\n1842 | \n1843 |     @Appender(\n1844 |         dedent(\n1845 |             \"\"\"\n1846 |         Examples\n1847 |         --------\n1848 |         >>> ser = pd.Series([390., 350., 30., 20.],\n1849 |         ...                 index=['Falcon', 'Falcon', 'Parrot', 'Parrot'],\n1850 |         ...                 name=\"Max Speed\")\n1851 |         >>> ser\n1852 |         Falcon    390.0\n1853 |         Falcon    350.0\n1854 |         Parrot     30.0\n1855 |         Parrot     20.0\n1856 |         Name: Max Speed, dtype: float64\n1857 | \n1858 |         We can pass a list of values to group the Series data by custom labels:\n1859 | \n1860 |         >>> ser.groupby([\"a\", \"b\", \"a\", \"b\"]).mean()\n1861 |         a    210.0\n1862 |         b    185.0\n1863 |         Name: Max Speed, dtype: float64\n1864 | \n1865 |         Grouping by numeric labels yields similar results:\n1866 | \n1867 |         >>> ser.groupby([0, 1, 0, 1]).mean()\n1868 |         0    210.0\n1869 |         1    185.0\n1870 |         Name: Max Speed, dtype: float64\n1871 | \n1872 |         We can group by a level of the index:\n1873 | \n1874 |         >>> ser.groupby(level=0).mean()\n1875 |         Falcon    370.0\n1876 |         Parrot     25.0\n1877 |         Name: Max Speed, dtype: float64\n1878 | \n1879 |         We can group by a condition applied to the Series values:\n1880 | \n1881 |         >>> ser.groupby(ser > 100).mean()\n1882 |         Max Speed\n1883 |         False     25.0\n1884 |         True     370.0\n1885 |         Name: Max Speed, dtype: float64\n1886 | \n1887 |         **Grouping by Indexes**\n1888 | \n1889 |         We can groupby different levels of a hierarchical index\n1890 |         using the `level` parameter:\n1891 | \n1892 |         >>> arrays = [['Falcon', 'Falcon', 'Parrot', 'Parrot'],\n1893 |         ...           ['Captive', 'Wild', 'Captive', 'Wild']]\n1894 |         >>> index = pd.MultiIndex.from_arrays(arrays, names=('Animal', 'Type'))\n1895 |         >>> ser = pd.Series([390., 350., 30., 20.], index=index, name=\"Max Speed\")\n1896 |         >>> ser\n1897 |         Animal  Type\n1898 |         Falcon  Captive    390.0\n1899 |                 Wild       350.0\n1900 |         Parrot  Captive     30.0\n1901 |                 Wild        20.0\n1902 |         Name: Max Speed, dtype: float64\n1903 | \n1904 |         >>> ser.groupby(level=0).mean()\n1905 |         Animal\n1906 |         Falcon    370.0\n1907 |         Parrot     25.0\n1908 |         Name: Max Speed, dtype: float64\n1909 | \n1910 |         We can also group by the 'Type' level of the hierarchical index\n1911 |         to get the mean speed for each type:\n1912 | \n1913 |         >>> ser.groupby(level=\"Type\").mean()\n1914 |         Type\n1915 |         Captive    210.0\n1916 |         Wild       185.0\n1917 |         Name: Max Speed, dtype: float64\n1918 | \n1919 |         We can also choose to include `NA` in group keys or not by defining\n1920 |         `dropna` parameter, the default setting is `True`.\n1921 | \n1922 |         >>> ser = pd.Series([1, 2, 3, 3], index=[\"a\", 'a', 'b', np.nan])\n1923 |         >>> ser.groupby(level=0).sum()\n1924 |         a    3\n1925 |         b    3\n1926 |         dtype: int64\n1927 | \n1928 |         To include `NA` values in the group keys, set `dropna=False`:\n1929 | \n1930 |         >>> ser.groupby(level=0, dropna=False).sum()\n1931 |         a    3\n1932 |         b    3\n1933 |         NaN  3\n1934 |         dtype: int64\n1935 | \n1936 |         We can also group by a custom list with NaN values to handle\n1937 |         missing group labels:\n1938 | \n1939 |         >>> arrays = ['Falcon', 'Falcon', 'Parrot', 'Parrot']\n1940 |         >>> ser = pd.Series([390., 350., 30., 20.], index=arrays, name=\"Max Speed\")\n1941 |         >>> ser.groupby([\"a\", \"b\", \"a\", np.nan]).mean()\n1942 |         a    210.0\n1943 |         b    350.0\n1944 |         Name: Max Speed, dtype: float64\n1945 | \n1946 |         >>> ser.groupby([\"a\", \"b\", \"a\", np.nan], dropna=False).mean()\n1947 |         a    210.0\n1948 |         b    350.0\n1949 |         NaN   20.0\n1950 |         Name: Max Speed, dtype: float64\n1951 |         \"\"\"\n1952 |         )\n1953 |     )\n1954 |     @Appender(_shared_docs[\"groupby\"] % _shared_doc_kwargs)\n1955 |     def groupby(\n1956 |         self,\n1957 |         by=None,\n1958 |         level: IndexLabel | None = None,\n1959 |         as_index: bool = True,\n1960 |         sort: bool = True,\n1961 |         group_keys: bool = True,\n1962 |         observed: bool = False,\n1963 |         dropna: bool = True,\n1964 |     ) -> SeriesGroupBy:\n1965 |         from pandas.core.groupby.generic import SeriesGroupBy\n1966 | \n1967 |         if level is None and by is None:\n1968 |             raise TypeError(\"You have to supply one of 'by' and 'level'\")\n1969 |         if not as_index:\n1970 |             raise TypeError(\"as_index=False only valid with DataFrame\")\n1971 | \n1972 |         return SeriesGroupBy(\n1973 |             obj=self,\n1974 |             keys=by,\n1975 |             level=level,\n1976 |             as_index=as_index,\n1977 |             sort=sort,\n1978 |             group_keys=group_keys,\n1979 |             observed=observed,\n1980 |             dropna=dropna,\n1981 |         )\n1982 | \n1983 |     # ----------------------------------------------------------------------\n1984 |     # Statistics, overridden ndarray methods\n1985 | \n1986 |     # TODO: integrate bottleneck\n1987 |     def count(self) -> int:\n1988 |         \"\"\"\n1989 |         Return number of non-NA/null observations in the Series.\n1990 | \n1991 |         Returns\n1992 |         -------\n1993 |         int\n1994 |             Number of non-null values in the Series.\n1995 | \n1996 |         See Also\n1997 |         --------\n1998 |         DataFrame.count : Count non-NA cells for each column or row.\n1999 | \n2000 |         Examples\n2001 |         --------\n2002 |         >>> s = pd.Series([0.0, 1.0, np.nan])\n2003 |         >>> s.count()\n2004 |         2\n2005 |         \"\"\"\n2006 |         return notna(self._values).sum().astype(\"int64\")\n2007 | \n2008 |     def mode(self, dropna: bool = True) -> Series:\n2009 |         \"\"\"\n2010 |         Return the mode(s) of the Series.\n2011 | \n2012 |         The mode is the value that appears most often. There can be multiple modes.\n2013 | \n2014 |         Always returns Series even if only one value is returned.\n2015 | \n2016 |         Parameters\n2017 |         ----------\n2018 |         dropna : bool, default True\n2019 |             Don't consider counts of NaN/NaT.\n2020 | \n2021 |         Returns\n2022 |         -------\n2023 |         Series\n2024 |             Modes of the Series in sorted order.\n2025 | \n2026 |         See Also\n2027 |         --------\n2028 |         numpy.mode : Equivalent numpy function for computing median.\n2029 |         Series.sum : Sum of the values.\n2030 |         Series.median : Median of the values.\n2031 |         Series.std : Standard deviation of the values.\n2032 |         Series.var : Variance of the values.\n2033 |         Series.min : Minimum value.\n2034 |         Series.max : Maximum value.\n2035 | \n2036 |         Examples\n2037 |         --------\n2038 |         >>> s = pd.Series([2, 4, 2, 2, 4, None])\n2039 |         >>> s.mode()\n2040 |         0    2.0\n2041 |         dtype: float64\n2042 | \n2043 |         More than one mode:\n2044 | \n2045 |         >>> s = pd.Series([2, 4, 8, 2, 4, None])\n2046 |         >>> s.mode()\n2047 |         0    2.0\n2048 |         1    4.0\n2049 |         dtype: float64\n2050 | \n2051 |         With and without considering null value:\n2052 | \n2053 |         >>> s = pd.Series([2, 4, None, None, 4, None])\n2054 |         >>> s.mode(dropna=False)\n2055 |         0   NaN\n2056 |         dtype: float64\n2057 |         >>> s = pd.Series([2, 4, None, None, 4, None])\n2058 |         >>> s.mode()\n2059 |         0    4.0\n2060 |         dtype: float64\n2061 |         \"\"\"\n2062 |         # TODO: Add option for bins like value_counts()\n2063 |         values = self._values\n2064 |         if isinstance(values, np.ndarray):\n2065 |             res_values = algorithms.mode(values, dropna=dropna)\n2066 |         else:\n2067 |             res_values = values._mode(dropna=dropna)\n2068 | \n2069 |         # Ensure index is type stable (should always use int index)\n2070 |         return self._constructor(\n2071 |             res_values,\n2072 |             index=range(len(res_values)),\n2073 |             name=self.name,\n2074 |             copy=False,\n2075 |             dtype=self.dtype,\n2076 |         ).__finalize__(self, method=\"mode\")\n2077 | \n2078 |     def unique(self) -> ArrayLike:\n2079 |         \"\"\"\n2080 |         Return unique values of Series object.\n2081 | \n2082 |         Uniques are returned in order of appearance. Hash table-based unique,\n2083 |         therefore does NOT sort.\n2084 | \n2085 |         Returns\n2086 |         -------\n2087 |         ndarray or ExtensionArray\n2088 |             The unique values returned as a NumPy array. See Notes.\n2089 | \n2090 |         See Also\n2091 |         --------\n2092 |         Series.drop_duplicates : Return Series with duplicate values removed.\n2093 |         unique : Top-level unique method for any 1-d array-like object.\n2094 |         Index.unique : Return Index with unique values from an Index object.\n2095 | \n2096 |         Notes\n2097 |         -----\n2098 |         Returns the unique values as a NumPy array. In case of an\n2099 |         extension-array backed Series, a new\n2100 |         :class:`~api.extensions.ExtensionArray` of that type with just\n2101 |         the unique values is returned. This includes\n2102 | \n2103 |             * Categorical\n2104 |             * Period\n2105 |             * Datetime with Timezone\n2106 |             * Datetime without Timezone\n2107 |             * Timedelta\n2108 |             * Interval\n2109 |             * Sparse\n2110 |             * IntegerNA\n2111 | \n2112 |         See Examples section.\n2113 | \n2114 |         Examples\n2115 |         --------\n2116 |         >>> pd.Series([2, 1, 3, 3], name=\"A\").unique()\n2117 |         array([2, 1, 3])\n2118 | \n2119 |         >>> pd.Series([pd.Timestamp(\"2016-01-01\") for _ in range(3)]).unique()\n2120 |         <DatetimeArray>\n2121 |         ['2016-01-01 00:00:00']\n2122 |         Length: 1, dtype: datetime64[s]\n2123 | \n2124 |         >>> pd.Series(\n2125 |         ...     [pd.Timestamp(\"2016-01-01\", tz=\"US/Eastern\") for _ in range(3)]\n2126 |         ... ).unique()\n2127 |         <DatetimeArray>\n2128 |         ['2016-01-01 00:00:00-05:00']\n2129 |         Length: 1, dtype: datetime64[s, US/Eastern]\n2130 | \n2131 |         An Categorical will return categories in the order of\n2132 |         appearance and with the same dtype.\n2133 | \n2134 |         >>> pd.Series(pd.Categorical(list(\"baabc\"))).unique()\n2135 |         ['b', 'a', 'c']\n2136 |         Categories (3, object): ['a', 'b', 'c']\n2137 |         >>> pd.Series(\n2138 |         ...     pd.Categorical(list(\"baabc\"), categories=list(\"abc\"), ordered=True)\n2139 |         ... ).unique()\n2140 |         ['b', 'a', 'c']\n2141 |         Categories (3, object): ['a' < 'b' < 'c']\n2142 |         \"\"\"\n2143 |         return super().unique()\n2144 | \n2145 |     @overload\n2146 |     def drop_duplicates(\n2147 |         self,\n2148 |         *,\n2149 |         keep: DropKeep = ...,\n2150 |         inplace: Literal[False] = ...,\n2151 |         ignore_index: bool = ...,\n2152 |     ) -> Series: ...\n2153 | \n2154 |     @overload\n2155 |     def drop_duplicates(\n2156 |         self, *, keep: DropKeep = ..., inplace: Literal[True], ignore_index: bool = ...\n2157 |     ) -> None: ...\n2158 | \n2159 |     @overload\n2160 |     def drop_duplicates(\n2161 |         self, *, keep: DropKeep = ..., inplace: bool = ..., ignore_index: bool = ...\n2162 |     ) -> Series | None: ...\n2163 | \n2164 |     def drop_duplicates(\n2165 |         self,\n2166 |         *,\n2167 |         keep: DropKeep = \"first\",\n2168 |         inplace: bool = False,\n2169 |         ignore_index: bool = False,\n2170 |     ) -> Series | None:\n2171 |         \"\"\"\n2172 |         Return Series with duplicate values removed.\n2173 | \n2174 |         Parameters\n2175 |         ----------\n2176 |         keep : {'first', 'last', ``False``}, default 'first'\n2177 |             Method to handle dropping duplicates:\n2178 | \n2179 |             - 'first' : Drop duplicates except for the first occurrence.\n2180 |             - 'last' : Drop duplicates except for the last occurrence.\n2181 |             - ``False`` : Drop all duplicates.\n2182 | \n2183 |         inplace : bool, default ``False``\n2184 |             If ``True``, performs operation inplace and returns None.\n2185 | \n2186 |         ignore_index : bool, default ``False``\n2187 |             If ``True``, the resulting axis will be labeled 0, 1, \u2026, n - 1.\n2188 | \n2189 |             .. versionadded:: 2.0.0\n2190 | \n2191 |         Returns\n2192 |         -------\n2193 |         Series or None\n2194 |             Series with duplicates dropped or None if ``inplace=True``.\n2195 | \n2196 |         See Also\n2197 |         --------\n2198 |         Index.drop_duplicates : Equivalent method on Index.\n2199 |         DataFrame.drop_duplicates : Equivalent method on DataFrame.\n2200 |         Series.duplicated : Related method on Series, indicating duplicate\n2201 |             Series values.\n2202 |         Series.unique : Return unique values as an array.\n2203 | \n2204 |         Examples\n2205 |         --------\n2206 |         Generate a Series with duplicated entries.\n2207 | \n2208 |         >>> s = pd.Series(\n2209 |         ...     [\"llama\", \"cow\", \"llama\", \"beetle\", \"llama\", \"hippo\"], name=\"animal\"\n2210 |         ... )\n2211 |         >>> s\n2212 |         0     llama\n2213 |         1       cow\n2214 |         2     llama\n2215 |         3    beetle\n2216 |         4     llama\n2217 |         5     hippo\n2218 |         Name: animal, dtype: object\n2219 | \n2220 |         With the 'keep' parameter, the selection behaviour of duplicated values\n2221 |         can be changed. The value 'first' keeps the first occurrence for each\n2222 |         set of duplicated entries. The default value of keep is 'first'.\n2223 | \n2224 |         >>> s.drop_duplicates()\n2225 |         0     llama\n2226 |         1       cow\n2227 |         3    beetle\n2228 |         5     hippo\n2229 |         Name: animal, dtype: object\n2230 | \n2231 |         The value 'last' for parameter 'keep' keeps the last occurrence for\n2232 |         each set of duplicated entries.\n2233 | \n2234 |         >>> s.drop_duplicates(keep=\"last\")\n2235 |         1       cow\n2236 |         3    beetle\n2237 |         4     llama\n2238 |         5     hippo\n2239 |         Name: animal, dtype: object\n2240 | \n2241 |         The value ``False`` for parameter 'keep' discards all sets of\n2242 |         duplicated entries.\n2243 | \n2244 |         >>> s.drop_duplicates(keep=False)\n2245 |         1       cow\n2246 |         3    beetle\n2247 |         5     hippo\n2248 |         Name: animal, dtype: object\n2249 |         \"\"\"\n2250 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n2251 |         result = super().drop_duplicates(keep=keep)\n2252 | \n2253 |         if ignore_index:\n2254 |             result.index = default_index(len(result))\n2255 | \n2256 |         if inplace:\n2257 |             self._update_inplace(result)\n2258 |             return None\n2259 |         else:\n2260 |             return result\n2261 | \n2262 |     def duplicated(self, keep: DropKeep = \"first\") -> Series:\n2263 |         \"\"\"\n2264 |         Indicate duplicate Series values.\n2265 | \n2266 |         Duplicated values are indicated as ``True`` values in the resulting\n2267 |         Series. Either all duplicates, all except the first or all except the\n2268 |         last occurrence of duplicates can be indicated.\n2269 | \n2270 |         Parameters\n2271 |         ----------\n2272 |         keep : {'first', 'last', False}, default 'first'\n2273 |             Method to handle dropping duplicates:\n2274 | \n2275 |             - 'first' : Mark duplicates as ``True`` except for the first\n2276 |               occurrence.\n2277 |             - 'last' : Mark duplicates as ``True`` except for the last\n2278 |               occurrence.\n2279 |             - ``False`` : Mark all duplicates as ``True``.\n2280 | \n2281 |         Returns\n2282 |         -------\n2283 |         Series[bool]\n2284 |             Series indicating whether each value has occurred in the\n2285 |             preceding values.\n2286 | \n2287 |         See Also\n2288 |         --------\n2289 |         Index.duplicated : Equivalent method on pandas.Index.\n2290 |         DataFrame.duplicated : Equivalent method on pandas.DataFrame.\n2291 |         Series.drop_duplicates : Remove duplicate values from Series.\n2292 | \n2293 |         Examples\n2294 |         --------\n2295 |         By default, for each set of duplicated values, the first occurrence is\n2296 |         set on False and all others on True:\n2297 | \n2298 |         >>> animals = pd.Series([\"llama\", \"cow\", \"llama\", \"beetle\", \"llama\"])\n2299 |         >>> animals.duplicated()\n2300 |         0    False\n2301 |         1    False\n2302 |         2     True\n2303 |         3    False\n2304 |         4     True\n2305 |         dtype: bool\n2306 | \n2307 |         which is equivalent to\n2308 | \n2309 |         >>> animals.duplicated(keep=\"first\")\n2310 |         0    False\n2311 |         1    False\n2312 |         2     True\n2313 |         3    False\n2314 |         4     True\n2315 |         dtype: bool\n2316 | \n2317 |         By using 'last', the last occurrence of each set of duplicated values\n2318 |         is set on False and all others on True:\n2319 | \n2320 |         >>> animals.duplicated(keep=\"last\")\n2321 |         0     True\n2322 |         1    False\n2323 |         2     True\n2324 |         3    False\n2325 |         4    False\n2326 |         dtype: bool\n2327 | \n2328 |         By setting keep on ``False``, all duplicates are True:\n2329 | \n2330 |         >>> animals.duplicated(keep=False)\n2331 |         0     True\n2332 |         1    False\n2333 |         2     True\n2334 |         3    False\n2335 |         4     True\n2336 |         dtype: bool\n2337 |         \"\"\"\n2338 |         res = self._duplicated(keep=keep)\n2339 |         result = self._constructor(res, index=self.index, copy=False)\n2340 |         return result.__finalize__(self, method=\"duplicated\")\n2341 | \n2342 |     def idxmin(self, axis: Axis = 0, skipna: bool = True, *args, **kwargs) -> Hashable:\n2343 |         \"\"\"\n2344 |         Return the row label of the minimum value.\n2345 | \n2346 |         If multiple values equal the minimum, the first row label with that\n2347 |         value is returned.\n2348 | \n2349 |         Parameters\n2350 |         ----------\n2351 |         axis : {0 or 'index'}\n2352 |             Unused. Parameter needed for compatibility with DataFrame.\n2353 |         skipna : bool, default True\n2354 |             Exclude NA/null values. If the entire Series is NA, or if ``skipna=False``\n2355 |             and there is an NA value, this method will raise a ``ValueError``.\n2356 |         *args, **kwargs\n2357 |             Additional arguments and keywords have no effect but might be\n2358 |             accepted for compatibility with NumPy.\n2359 | \n2360 |         Returns\n2361 |         -------\n2362 |         Index\n2363 |             Label of the minimum value.\n2364 | \n2365 |         Raises\n2366 |         ------\n2367 |         ValueError\n2368 |             If the Series is empty.\n2369 | \n2370 |         See Also\n2371 |         --------\n2372 |         numpy.argmin : Return indices of the minimum values\n2373 |             along the given axis.\n2374 |         DataFrame.idxmin : Return index of first occurrence of minimum\n2375 |             over requested axis.\n2376 |         Series.idxmax : Return index *label* of the first occurrence\n2377 |             of maximum of values.\n2378 | \n2379 |         Notes\n2380 |         -----\n2381 |         This method is the Series version of ``ndarray.argmin``. This method\n2382 |         returns the label of the minimum, while ``ndarray.argmin`` returns\n2383 |         the position. To get the position, use ``series.values.argmin()``.\n2384 | \n2385 |         Examples\n2386 |         --------\n2387 |         >>> s = pd.Series(data=[1, None, 4, 1], index=[\"A\", \"B\", \"C\", \"D\"])\n2388 |         >>> s\n2389 |         A    1.0\n2390 |         B    NaN\n2391 |         C    4.0\n2392 |         D    1.0\n2393 |         dtype: float64\n2394 | \n2395 |         >>> s.idxmin()\n2396 |         'A'\n2397 |         \"\"\"\n2398 |         axis = self._get_axis_number(axis)\n2399 |         iloc = self.argmin(axis, skipna, *args, **kwargs)\n2400 |         return self.index[iloc]\n2401 | \n2402 |     def idxmax(self, axis: Axis = 0, skipna: bool = True, *args, **kwargs) -> Hashable:\n2403 |         \"\"\"\n2404 |         Return the row label of the maximum value.\n2405 | \n2406 |         If multiple values equal the maximum, the first row label with that\n2407 |         value is returned.\n2408 | \n2409 |         Parameters\n2410 |         ----------\n2411 |         axis : {0 or 'index'}\n2412 |             Unused. Parameter needed for compatibility with DataFrame.\n2413 |         skipna : bool, default True\n2414 |             Exclude NA/null values. If the entire Series is NA, or if ``skipna=False``\n2415 |             and there is an NA value, this method will raise a ``ValueError``.\n2416 |         *args, **kwargs\n2417 |             Additional arguments and keywords have no effect but might be\n2418 |             accepted for compatibility with NumPy.\n2419 | \n2420 |         Returns\n2421 |         -------\n2422 |         Index\n2423 |             Label of the maximum value.\n2424 | \n2425 |         Raises\n2426 |         ------\n2427 |         ValueError\n2428 |             If the Series is empty.\n2429 | \n2430 |         See Also\n2431 |         --------\n2432 |         numpy.argmax : Return indices of the maximum values\n2433 |             along the given axis.\n2434 |         DataFrame.idxmax : Return index of first occurrence of maximum\n2435 |             over requested axis.\n2436 |         Series.idxmin : Return index *label* of the first occurrence\n2437 |             of minimum of values.\n2438 | \n2439 |         Notes\n2440 |         -----\n2441 |         This method is the Series version of ``ndarray.argmax``. This method\n2442 |         returns the label of the maximum, while ``ndarray.argmax`` returns\n2443 |         the position. To get the position, use ``series.values.argmax()``.\n2444 | \n2445 |         Examples\n2446 |         --------\n2447 |         >>> s = pd.Series(data=[1, None, 4, 3, 4], index=[\"A\", \"B\", \"C\", \"D\", \"E\"])\n2448 |         >>> s\n2449 |         A    1.0\n2450 |         B    NaN\n2451 |         C    4.0\n2452 |         D    3.0\n2453 |         E    4.0\n2454 |         dtype: float64\n2455 | \n2456 |         >>> s.idxmax()\n2457 |         'C'\n2458 |         \"\"\"\n2459 |         axis = self._get_axis_number(axis)\n2460 |         iloc = self.argmax(axis, skipna, *args, **kwargs)\n2461 |         return self.index[iloc]\n2462 | \n2463 |     def round(self, decimals: int = 0, *args, **kwargs) -> Series:\n2464 |         \"\"\"\n2465 |         Round each value in a Series to the given number of decimals.\n2466 | \n2467 |         Parameters\n2468 |         ----------\n2469 |         decimals : int, default 0\n2470 |             Number of decimal places to round to. If decimals is negative,\n2471 |             it specifies the number of positions to the left of the decimal point.\n2472 |         *args, **kwargs\n2473 |             Additional arguments and keywords have no effect but might be\n2474 |             accepted for compatibility with NumPy.\n2475 | \n2476 |         Returns\n2477 |         -------\n2478 |         Series\n2479 |             Rounded values of the Series.\n2480 | \n2481 |         See Also\n2482 |         --------\n2483 |         numpy.around : Round values of an np.array.\n2484 |         DataFrame.round : Round values of a DataFrame.\n2485 | \n2486 |         Notes\n2487 |         -----\n2488 |         For values exactly halfway between rounded decimal values, pandas rounds\n2489 |         to the nearest even value (e.g. -0.5 and 0.5 round to 0.0, 1.5 and 2.5\n2490 |         round to 2.0, etc.).\n2491 | \n2492 |         Examples\n2493 |         --------\n2494 |         >>> s = pd.Series([-0.5, 0.1, 2.5, 1.3, 2.7])\n2495 |         >>> s.round()\n2496 |         0   -0.0\n2497 |         1    0.0\n2498 |         2    2.0\n2499 |         3    1.0\n2500 |         4    3.0\n2501 |         dtype: float64\n2502 |         \"\"\"\n2503 |         nv.validate_round(args, kwargs)\n2504 |         new_mgr = self._mgr.round(decimals=decimals)\n2505 |         return self._constructor_from_mgr(new_mgr, axes=new_mgr.axes).__finalize__(\n2506 |             self, method=\"round\"\n2507 |         )\n2508 | \n2509 |     @overload\n2510 |     def quantile(\n2511 |         self, q: float = ..., interpolation: QuantileInterpolation = ...\n2512 |     ) -> float: ...\n2513 | \n2514 |     @overload\n2515 |     def quantile(\n2516 |         self,\n2517 |         q: Sequence[float] | AnyArrayLike,\n2518 |         interpolation: QuantileInterpolation = ...,\n2519 |     ) -> Series: ...\n2520 | \n2521 |     @overload\n2522 |     def quantile(\n2523 |         self,\n2524 |         q: float | Sequence[float] | AnyArrayLike = ...,\n2525 |         interpolation: QuantileInterpolation = ...,\n2526 |     ) -> float | Series: ...\n2527 | \n2528 |     def quantile(\n2529 |         self,\n2530 |         q: float | Sequence[float] | AnyArrayLike = 0.5,\n2531 |         interpolation: QuantileInterpolation = \"linear\",\n2532 |     ) -> float | Series:\n2533 |         \"\"\"\n2534 |         Return value at the given quantile.\n2535 | \n2536 |         Parameters\n2537 |         ----------\n2538 |         q : float or array-like, default 0.5 (50% quantile)\n2539 |             The quantile(s) to compute, which can lie in range: 0 <= q <= 1.\n2540 |         interpolation : {'linear', 'lower', 'higher', 'midpoint', 'nearest'}\n2541 |             This optional parameter specifies the interpolation method to use,\n2542 |             when the desired quantile lies between two data points `i` and `j`:\n2543 | \n2544 |                 * linear: `i + (j - i) * (x-i)/(j-i)`, where `(x-i)/(j-i)` is\n2545 |                   the fractional part of the index surrounded by `i > j`.\n2546 |                 * lower: `i`.\n2547 |                 * higher: `j`.\n2548 |                 * nearest: `i` or `j` whichever is nearest.\n2549 |                 * midpoint: (`i` + `j`) / 2.\n2550 | \n2551 |         Returns\n2552 |         -------\n2553 |         float or Series\n2554 |             If ``q`` is an array, a Series will be returned where the\n2555 |             index is ``q`` and the values are the quantiles, otherwise\n2556 |             a float will be returned.\n2557 | \n2558 |         See Also\n2559 |         --------\n2560 |         core.window.Rolling.quantile : Calculate the rolling quantile.\n2561 |         numpy.percentile : Returns the q-th percentile(s) of the array elements.\n2562 | \n2563 |         Examples\n2564 |         --------\n2565 |         >>> s = pd.Series([1, 2, 3, 4])\n2566 |         >>> s.quantile(0.5)\n2567 |         2.5\n2568 |         >>> s.quantile([0.25, 0.5, 0.75])\n2569 |         0.25    1.75\n2570 |         0.50    2.50\n2571 |         0.75    3.25\n2572 |         dtype: float64\n2573 |         \"\"\"\n2574 |         validate_percentile(q)\n2575 | \n2576 |         # We dispatch to DataFrame so that core.internals only has to worry\n2577 |         #  about 2D cases.\n2578 |         df = self.to_frame()\n2579 | \n2580 |         result = df.quantile(q=q, interpolation=interpolation, numeric_only=False)\n2581 |         if result.ndim == 2:\n2582 |             result = result.iloc[:, 0]\n2583 | \n2584 |         if is_list_like(q):\n2585 |             result.name = self.name\n2586 |             idx = Index(q, dtype=np.float64)\n2587 |             return self._constructor(result, index=idx, name=self.name)\n2588 |         else:\n2589 |             # scalar\n2590 |             return result.iloc[0]\n2591 | \n2592 |     def corr(\n2593 |         self,\n2594 |         other: Series,\n2595 |         method: CorrelationMethod = \"pearson\",\n2596 |         min_periods: int | None = None,\n2597 |     ) -> float:\n2598 |         \"\"\"\n2599 |         Compute correlation with `other` Series, excluding missing values.\n2600 | \n2601 |         The two `Series` objects are not required to be the same length and will be\n2602 |         aligned internally before the correlation function is applied.\n2603 | \n2604 |         Parameters\n2605 |         ----------\n2606 |         other : Series\n2607 |             Series with which to compute the correlation.\n2608 |         method : {'pearson', 'kendall', 'spearman'} or callable\n2609 |             Method used to compute correlation:\n2610 | \n2611 |             - pearson : Standard correlation coefficient\n2612 |             - kendall : Kendall Tau correlation coefficient\n2613 |             - spearman : Spearman rank correlation\n2614 |             - callable: Callable with input two 1d ndarrays and returning a float.\n2615 | \n2616 |             .. warning::\n2617 |                 Note that the returned matrix from corr will have 1 along the\n2618 |                 diagonals and will be symmetric regardless of the callable's\n2619 |                 behavior.\n2620 |         min_periods : int, optional\n2621 |             Minimum number of observations needed to have a valid result.\n2622 | \n2623 |         Returns\n2624 |         -------\n2625 |         float\n2626 |             Correlation with other.\n2627 | \n2628 |         See Also\n2629 |         --------\n2630 |         DataFrame.corr : Compute pairwise correlation between columns.\n2631 |         DataFrame.corrwith : Compute pairwise correlation with another\n2632 |             DataFrame or Series.\n2633 | \n2634 |         Notes\n2635 |         -----\n2636 |         Pearson, Kendall and Spearman correlation are currently computed using pairwise complete observations.\n2637 | \n2638 |         * `Pearson correlation coefficient <https://en.wikipedia.org/wiki/Pearson_correlation_coefficient>`_\n2639 |         * `Kendall rank correlation coefficient <https://en.wikipedia.org/wiki/Kendall_rank_correlation_coefficient>`_\n2640 |         * `Spearman's rank correlation coefficient <https://en.wikipedia.org/wiki/Spearman%27s_rank_correlation_coefficient>`_\n2641 | \n2642 |         Automatic data alignment: as with all pandas operations, automatic data alignment is performed for this method.\n2643 |         ``corr()`` automatically considers values with matching indices.\n2644 | \n2645 |         Examples\n2646 |         --------\n2647 |         >>> def histogram_intersection(a, b):\n2648 |         ...     v = np.minimum(a, b).sum().round(decimals=1)\n2649 |         ...     return v\n2650 |         >>> s1 = pd.Series([0.2, 0.0, 0.6, 0.2])\n2651 |         >>> s2 = pd.Series([0.3, 0.6, 0.0, 0.1])\n2652 |         >>> s1.corr(s2, method=histogram_intersection)\n2653 |         0.3\n2654 | \n2655 |         Pandas auto-aligns the values with matching indices\n2656 | \n2657 |         >>> s1 = pd.Series([1, 2, 3], index=[0, 1, 2])\n2658 |         >>> s2 = pd.Series([1, 2, 3], index=[2, 1, 0])\n2659 |         >>> s1.corr(s2)\n2660 |         -1.0\n2661 | \n2662 |         If the input is a constant array, the correlation is not defined in this case,\n2663 |         and ``np.nan`` is returned.\n2664 | \n2665 |         >>> s1 = pd.Series([0.45, 0.45])\n2666 |         >>> s1.corr(s1)\n2667 |         nan\n2668 |         \"\"\"  # noqa: E501\n2669 |         this, other = self.align(other, join=\"inner\")\n2670 |         if len(this) == 0:\n2671 |             return np.nan\n2672 | \n2673 |         this_values = this.to_numpy(dtype=float, na_value=np.nan, copy=False)\n2674 |         other_values = other.to_numpy(dtype=float, na_value=np.nan, copy=False)\n2675 | \n2676 |         if method in [\"pearson\", \"spearman\", \"kendall\"] or callable(method):\n2677 |             return nanops.nancorr(\n2678 |                 this_values, other_values, method=method, min_periods=min_periods\n2679 |             )\n2680 | \n2681 |         raise ValueError(\n2682 |             \"method must be either 'pearson', \"\n2683 |             \"'spearman', 'kendall', or a callable, \"\n2684 |             f\"'{method}' was supplied\"\n2685 |         )\n2686 | \n2687 |     def cov(\n2688 |         self,\n2689 |         other: Series,\n2690 |         min_periods: int | None = None,\n2691 |         ddof: int | None = 1,\n2692 |     ) -> float:\n2693 |         \"\"\"\n2694 |         Compute covariance with Series, excluding missing values.\n2695 | \n2696 |         The two `Series` objects are not required to be the same length and\n2697 |         will be aligned internally before the covariance is calculated.\n2698 | \n2699 |         Parameters\n2700 |         ----------\n2701 |         other : Series\n2702 |             Series with which to compute the covariance.\n2703 |         min_periods : int, optional\n2704 |             Minimum number of observations needed to have a valid result.\n2705 |         ddof : int, default 1\n2706 |             Delta degrees of freedom.  The divisor used in calculations\n2707 |             is ``N - ddof``, where ``N`` represents the number of elements.\n2708 | \n2709 |         Returns\n2710 |         -------\n2711 |         float\n2712 |             Covariance between Series and other normalized by N-1\n2713 |             (unbiased estimator).\n2714 | \n2715 |         See Also\n2716 |         --------\n2717 |         DataFrame.cov : Compute pairwise covariance of columns.\n2718 | \n2719 |         Examples\n2720 |         --------\n2721 |         >>> s1 = pd.Series([0.90010907, 0.13484424, 0.62036035])\n2722 |         >>> s2 = pd.Series([0.12528585, 0.26962463, 0.51111198])\n2723 |         >>> s1.cov(s2)\n2724 |         -0.01685762652715874\n2725 |         \"\"\"\n2726 |         this, other = self.align(other, join=\"inner\")\n2727 |         if len(this) == 0:\n2728 |             return np.nan\n2729 |         this_values = this.to_numpy(dtype=float, na_value=np.nan, copy=False)\n2730 |         other_values = other.to_numpy(dtype=float, na_value=np.nan, copy=False)\n2731 |         return nanops.nancov(\n2732 |             this_values, other_values, min_periods=min_periods, ddof=ddof\n2733 |         )\n2734 | \n2735 |     @doc(\n2736 |         klass=\"Series\",\n2737 |         extra_params=\"\",\n2738 |         other_klass=\"DataFrame\",\n2739 |         examples=dedent(\n2740 |             \"\"\"\n2741 |         Difference with previous row\n2742 | \n2743 |         >>> s = pd.Series([1, 1, 2, 3, 5, 8])\n2744 |         >>> s.diff()\n2745 |         0    NaN\n2746 |         1    0.0\n2747 |         2    1.0\n2748 |         3    1.0\n2749 |         4    2.0\n2750 |         5    3.0\n2751 |         dtype: float64\n2752 | \n2753 |         Difference with 3rd previous row\n2754 | \n2755 |         >>> s.diff(periods=3)\n2756 |         0    NaN\n2757 |         1    NaN\n2758 |         2    NaN\n2759 |         3    2.0\n2760 |         4    4.0\n2761 |         5    6.0\n2762 |         dtype: float64\n2763 | \n2764 |         Difference with following row\n2765 | \n2766 |         >>> s.diff(periods=-1)\n2767 |         0    0.0\n2768 |         1   -1.0\n2769 |         2   -1.0\n2770 |         3   -2.0\n2771 |         4   -3.0\n2772 |         5    NaN\n2773 |         dtype: float64\n2774 | \n2775 |         Overflow in input dtype\n2776 | \n2777 |         >>> s = pd.Series([1, 0], dtype=np.uint8)\n2778 |         >>> s.diff()\n2779 |         0      NaN\n2780 |         1    255.0\n2781 |         dtype: float64\"\"\"\n2782 |         ),\n2783 |     )\n2784 |     def diff(self, periods: int = 1) -> Series:\n2785 |         \"\"\"\n2786 |         First discrete difference of element.\n2787 | \n2788 |         Calculates the difference of a {klass} element compared with another\n2789 |         element in the {klass} (default is element in previous row).\n2790 | \n2791 |         Parameters\n2792 |         ----------\n2793 |         periods : int, default 1\n2794 |             Periods to shift for calculating difference, accepts negative\n2795 |             values.\n2796 |         {extra_params}\n2797 |         Returns\n2798 |         -------\n2799 |         {klass}\n2800 |             First differences of the Series.\n2801 | \n2802 |         See Also\n2803 |         --------\n2804 |         {klass}.pct_change: Percent change over given number of periods.\n2805 |         {klass}.shift: Shift index by desired number of periods with an\n2806 |             optional time freq.\n2807 |         {other_klass}.diff: First discrete difference of object.\n2808 | \n2809 |         Notes\n2810 |         -----\n2811 |         For boolean dtypes, this uses :meth:`operator.xor` rather than\n2812 |         :meth:`operator.sub`.\n2813 |         The result is calculated according to current dtype in {klass},\n2814 |         however dtype of the result is always float64.\n2815 | \n2816 |         Examples\n2817 |         --------\n2818 |         {examples}\n2819 |         \"\"\"\n2820 |         if not lib.is_integer(periods):\n2821 |             if not (is_float(periods) and periods.is_integer()):\n2822 |                 raise ValueError(\"periods must be an integer\")\n2823 |         result = algorithms.diff(self._values, periods)\n2824 |         return self._constructor(result, index=self.index, copy=False).__finalize__(\n2825 |             self, method=\"diff\"\n2826 |         )\n2827 | \n2828 |     def autocorr(self, lag: int = 1) -> float:\n2829 |         \"\"\"\n2830 |         Compute the lag-N autocorrelation.\n2831 | \n2832 |         This method computes the Pearson correlation between\n2833 |         the Series and its shifted self.\n2834 | \n2835 |         Parameters\n2836 |         ----------\n2837 |         lag : int, default 1\n2838 |             Number of lags to apply before performing autocorrelation.\n2839 | \n2840 |         Returns\n2841 |         -------\n2842 |         float\n2843 |             The Pearson correlation between self and self.shift(lag).\n2844 | \n2845 |         See Also\n2846 |         --------\n2847 |         Series.corr : Compute the correlation between two Series.\n2848 |         Series.shift : Shift index by desired number of periods.\n2849 |         DataFrame.corr : Compute pairwise correlation of columns.\n2850 |         DataFrame.corrwith : Compute pairwise correlation between rows or\n2851 |             columns of two DataFrame objects.\n2852 | \n2853 |         Notes\n2854 |         -----\n2855 |         If the Pearson correlation is not well defined return 'NaN'.\n2856 | \n2857 |         Examples\n2858 |         --------\n2859 |         >>> s = pd.Series([0.25, 0.5, 0.2, -0.05])\n2860 |         >>> s.autocorr()  # doctest: +ELLIPSIS\n2861 |         0.10355...\n2862 |         >>> s.autocorr(lag=2)  # doctest: +ELLIPSIS\n2863 |         -0.99999...\n2864 | \n2865 |         If the Pearson correlation is not well defined, then 'NaN' is returned.\n2866 | \n2867 |         >>> s = pd.Series([1, 0, 0, 0])\n2868 |         >>> s.autocorr()\n2869 |         nan\n2870 |         \"\"\"\n2871 |         return self.corr(cast(Series, self.shift(lag)))\n2872 | \n2873 |     def dot(self, other: AnyArrayLike | DataFrame) -> Series | np.ndarray:\n2874 |         \"\"\"\n2875 |         Compute the dot product between the Series and the columns of other.\n2876 | \n2877 |         This method computes the dot product between the Series and another\n2878 |         one, or the Series and each columns of a DataFrame, or the Series and\n2879 |         each columns of an array.\n2880 | \n2881 |         It can also be called using `self @ other`.\n2882 | \n2883 |         Parameters\n2884 |         ----------\n2885 |         other : Series, DataFrame or array-like\n2886 |             The other object to compute the dot product with its columns.\n2887 | \n2888 |         Returns\n2889 |         -------\n2890 |         scalar, Series or numpy.ndarray\n2891 |             Return the dot product of the Series and other if other is a\n2892 |             Series, the Series of the dot product of Series and each rows of\n2893 |             other if other is a DataFrame or a numpy.ndarray between the Series\n2894 |             and each columns of the numpy array.\n2895 | \n2896 |         See Also\n2897 |         --------\n2898 |         DataFrame.dot: Compute the matrix product with the DataFrame.\n2899 |         Series.mul: Multiplication of series and other, element-wise.\n2900 | \n2901 |         Notes\n2902 |         -----\n2903 |         The Series and other has to share the same index if other is a Series\n2904 |         or a DataFrame.\n2905 | \n2906 |         Examples\n2907 |         --------\n2908 |         >>> s = pd.Series([0, 1, 2, 3])\n2909 |         >>> other = pd.Series([-1, 2, -3, 4])\n2910 |         >>> s.dot(other)\n2911 |         8\n2912 |         >>> s @ other\n2913 |         8\n2914 |         >>> df = pd.DataFrame([[0, 1], [-2, 3], [4, -5], [6, 7]])\n2915 |         >>> s.dot(df)\n2916 |         0    24\n2917 |         1    14\n2918 |         dtype: int64\n2919 |         >>> arr = np.array([[0, 1], [-2, 3], [4, -5], [6, 7]])\n2920 |         >>> s.dot(arr)\n2921 |         array([24, 14])\n2922 |         \"\"\"\n2923 |         if isinstance(other, (Series, ABCDataFrame)):\n2924 |             common = self.index.union(other.index)\n2925 |             if len(common) > len(self.index) or len(common) > len(other.index):\n2926 |                 raise ValueError(\"matrices are not aligned\")\n2927 | \n2928 |             left = self.reindex(index=common)\n2929 |             right = other.reindex(index=common)\n2930 |             lvals = left.values\n2931 |             rvals = right.values\n2932 |         else:\n2933 |             lvals = self.values\n2934 |             rvals = np.asarray(other)\n2935 |             if lvals.shape[0] != rvals.shape[0]:\n2936 |                 raise Exception(\n2937 |                     f\"Dot product shape mismatch, {lvals.shape} vs {rvals.shape}\"\n2938 |                 )\n2939 | \n2940 |         if isinstance(other, ABCDataFrame):\n2941 |             return self._constructor(\n2942 |                 np.dot(lvals, rvals), index=other.columns, copy=False\n2943 |             ).__finalize__(self, method=\"dot\")\n2944 |         elif isinstance(other, Series):\n2945 |             return np.dot(lvals, rvals)\n2946 |         elif isinstance(rvals, np.ndarray):\n2947 |             return np.dot(lvals, rvals)\n2948 |         else:  # pragma: no cover\n2949 |             raise TypeError(f\"unsupported type: {type(other)}\")\n2950 | \n2951 |     def __matmul__(self, other):\n2952 |         \"\"\"\n2953 |         Matrix multiplication using binary `@` operator.\n2954 |         \"\"\"\n2955 |         return self.dot(other)\n2956 | \n2957 |     def __rmatmul__(self, other):\n2958 |         \"\"\"\n2959 |         Matrix multiplication using binary `@` operator.\n2960 |         \"\"\"\n2961 |         return self.dot(np.transpose(other))\n2962 | \n2963 |     @doc(base.IndexOpsMixin.searchsorted, klass=\"Series\")\n2964 |     # Signature of \"searchsorted\" incompatible with supertype \"IndexOpsMixin\"\n2965 |     def searchsorted(  # type: ignore[override]\n2966 |         self,\n2967 |         value: NumpyValueArrayLike | ExtensionArray,\n2968 |         side: Literal[\"left\", \"right\"] = \"left\",\n2969 |         sorter: NumpySorter | None = None,\n2970 |     ) -> npt.NDArray[np.intp] | np.intp:\n2971 |         return base.IndexOpsMixin.searchsorted(self, value, side=side, sorter=sorter)\n2972 | \n2973 |     # -------------------------------------------------------------------\n2974 |     # Combination\n2975 | \n2976 |     def _append(\n2977 |         self, to_append, ignore_index: bool = False, verify_integrity: bool = False\n2978 |     ):\n2979 |         from pandas.core.reshape.concat import concat\n2980 | \n2981 |         if isinstance(to_append, (list, tuple)):\n2982 |             to_concat = [self]\n2983 |             to_concat.extend(to_append)\n2984 |         else:\n2985 |             to_concat = [self, to_append]\n2986 |         if any(isinstance(x, (ABCDataFrame,)) for x in to_concat[1:]):\n2987 |             msg = \"to_append should be a Series or list/tuple of Series, got DataFrame\"\n2988 |             raise TypeError(msg)\n2989 |         return concat(\n2990 |             to_concat, ignore_index=ignore_index, verify_integrity=verify_integrity\n2991 |         )\n2992 | \n2993 |     @doc(\n2994 |         _shared_docs[\"compare\"],\n2995 |         dedent(\n2996 |             \"\"\"\n2997 |         Returns\n2998 |         -------\n2999 |         Series or DataFrame\n3000 |             If axis is 0 or 'index' the result will be a Series.\n3001 |             The resulting index will be a MultiIndex with 'self' and 'other'\n3002 |             stacked alternately at the inner level.\n3003 | \n3004 |             If axis is 1 or 'columns' the result will be a DataFrame.\n3005 |             It will have two columns namely 'self' and 'other'.\n3006 | \n3007 |         See Also\n3008 |         --------\n3009 |         DataFrame.compare : Compare with another DataFrame and show differences.\n3010 | \n3011 |         Notes\n3012 |         -----\n3013 |         Matching NaNs will not appear as a difference.\n3014 | \n3015 |         Examples\n3016 |         --------\n3017 |         >>> s1 = pd.Series([\"a\", \"b\", \"c\", \"d\", \"e\"])\n3018 |         >>> s2 = pd.Series([\"a\", \"a\", \"c\", \"b\", \"e\"])\n3019 | \n3020 |         Align the differences on columns\n3021 | \n3022 |         >>> s1.compare(s2)\n3023 |           self other\n3024 |         1    b     a\n3025 |         3    d     b\n3026 | \n3027 |         Stack the differences on indices\n3028 | \n3029 |         >>> s1.compare(s2, align_axis=0)\n3030 |         1  self     b\n3031 |            other    a\n3032 |         3  self     d\n3033 |            other    b\n3034 |         dtype: object\n3035 | \n3036 |         Keep all original rows\n3037 | \n3038 |         >>> s1.compare(s2, keep_shape=True)\n3039 |           self other\n3040 |         0  NaN   NaN\n3041 |         1    b     a\n3042 |         2  NaN   NaN\n3043 |         3    d     b\n3044 |         4  NaN   NaN\n3045 | \n3046 |         Keep all original rows and also all original values\n3047 | \n3048 |         >>> s1.compare(s2, keep_shape=True, keep_equal=True)\n3049 |           self other\n3050 |         0    a     a\n3051 |         1    b     a\n3052 |         2    c     c\n3053 |         3    d     b\n3054 |         4    e     e\n3055 |         \"\"\"\n3056 |         ),\n3057 |         klass=_shared_doc_kwargs[\"klass\"],\n3058 |     )\n3059 |     def compare(\n3060 |         self,\n3061 |         other: Series,\n3062 |         align_axis: Axis = 1,\n3063 |         keep_shape: bool = False,\n3064 |         keep_equal: bool = False,\n3065 |         result_names: Suffixes = (\"self\", \"other\"),\n3066 |     ) -> DataFrame | Series:\n3067 |         return super().compare(\n3068 |             other=other,\n3069 |             align_axis=align_axis,\n3070 |             keep_shape=keep_shape,\n3071 |             keep_equal=keep_equal,\n3072 |             result_names=result_names,\n3073 |         )\n3074 | \n3075 |     def combine(\n3076 |         self,\n3077 |         other: Series | Hashable,\n3078 |         func: Callable[[Hashable, Hashable], Hashable],\n3079 |         fill_value: Hashable | None = None,\n3080 |     ) -> Series:\n3081 |         \"\"\"\n3082 |         Combine the Series with a Series or scalar according to `func`.\n3083 | \n3084 |         Combine the Series and `other` using `func` to perform elementwise\n3085 |         selection for combined Series.\n3086 |         `fill_value` is assumed when value is missing at some index\n3087 |         from one of the two objects being combined.\n3088 | \n3089 |         Parameters\n3090 |         ----------\n3091 |         other : Series or scalar\n3092 |             The value(s) to be combined with the `Series`.\n3093 |         func : function\n3094 |             Function that takes two scalars as inputs and returns an element.\n3095 |         fill_value : scalar, optional\n3096 |             The value to assume when an index is missing from\n3097 |             one Series or the other. The default specifies to use the\n3098 |             appropriate NaN value for the underlying dtype of the Series.\n3099 | \n3100 |         Returns\n3101 |         -------\n3102 |         Series\n3103 |             The result of combining the Series with the other object.\n3104 | \n3105 |         See Also\n3106 |         --------\n3107 |         Series.combine_first : Combine Series values, choosing the calling\n3108 |             Series' values first.\n3109 | \n3110 |         Examples\n3111 |         --------\n3112 |         Consider 2 Datasets ``s1`` and ``s2`` containing\n3113 |         highest clocked speeds of different birds.\n3114 | \n3115 |         >>> s1 = pd.Series({\"falcon\": 330.0, \"eagle\": 160.0})\n3116 |         >>> s1\n3117 |         falcon    330.0\n3118 |         eagle     160.0\n3119 |         dtype: float64\n3120 |         >>> s2 = pd.Series({\"falcon\": 345.0, \"eagle\": 200.0, \"duck\": 30.0})\n3121 |         >>> s2\n3122 |         falcon    345.0\n3123 |         eagle     200.0\n3124 |         duck       30.0\n3125 |         dtype: float64\n3126 | \n3127 |         Now, to combine the two datasets and view the highest speeds\n3128 |         of the birds across the two datasets\n3129 | \n3130 |         >>> s1.combine(s2, max)\n3131 |         duck        NaN\n3132 |         eagle     200.0\n3133 |         falcon    345.0\n3134 |         dtype: float64\n3135 | \n3136 |         In the previous example, the resulting value for duck is missing,\n3137 |         because the maximum of a NaN and a float is a NaN.\n3138 |         So, in the example, we set ``fill_value=0``,\n3139 |         so the maximum value returned will be the value from some dataset.\n3140 | \n3141 |         >>> s1.combine(s2, max, fill_value=0)\n3142 |         duck       30.0\n3143 |         eagle     200.0\n3144 |         falcon    345.0\n3145 |         dtype: float64\n3146 |         \"\"\"\n3147 |         if fill_value is None:\n3148 |             fill_value = na_value_for_dtype(self.dtype, compat=False)\n3149 | \n3150 |         if isinstance(other, Series):\n3151 |             # If other is a Series, result is based on union of Series,\n3152 |             # so do this element by element\n3153 |             new_index = self.index.union(other.index)\n3154 |             new_name = ops.get_op_result_name(self, other)\n3155 |             new_values = np.empty(len(new_index), dtype=object)\n3156 |             with np.errstate(all=\"ignore\"):\n3157 |                 for i, idx in enumerate(new_index):\n3158 |                     lv = self.get(idx, fill_value)\n3159 |                     rv = other.get(idx, fill_value)\n3160 |                     new_values[i] = func(lv, rv)\n3161 |         else:\n3162 |             # Assume that other is a scalar, so apply the function for\n3163 |             # each element in the Series\n3164 |             new_index = self.index\n3165 |             new_values = np.empty(len(new_index), dtype=object)\n3166 |             with np.errstate(all=\"ignore\"):\n3167 |                 new_values[:] = [func(lv, other) for lv in self._values]\n3168 |             new_name = self.name\n3169 | \n3170 |         # try_float=False is to match agg_series\n3171 |         npvalues = lib.maybe_convert_objects(new_values, try_float=False)\n3172 |         # same_dtype here is a kludge to avoid casting e.g. [True, False] to\n3173 |         #  [\"True\", \"False\"]\n3174 |         same_dtype = isinstance(self.dtype, (StringDtype, CategoricalDtype))\n3175 |         res_values = maybe_cast_pointwise_result(\n3176 |             npvalues, self.dtype, same_dtype=same_dtype\n3177 |         )\n3178 |         return self._constructor(res_values, index=new_index, name=new_name, copy=False)\n3179 | \n3180 |     def combine_first(self, other) -> Series:\n3181 |         \"\"\"\n3182 |         Update null elements with value in the same location in 'other'.\n3183 | \n3184 |         Combine two Series objects by filling null values in one Series with\n3185 |         non-null values from the other Series. Result index will be the union\n3186 |         of the two indexes.\n3187 | \n3188 |         Parameters\n3189 |         ----------\n3190 |         other : Series\n3191 |             The value(s) to be used for filling null values.\n3192 | \n3193 |         Returns\n3194 |         -------\n3195 |         Series\n3196 |             The result of combining the provided Series with the other object.\n3197 | \n3198 |         See Also\n3199 |         --------\n3200 |         Series.combine : Perform element-wise operation on two Series\n3201 |             using a given function.\n3202 | \n3203 |         Examples\n3204 |         --------\n3205 |         >>> s1 = pd.Series([1, np.nan])\n3206 |         >>> s2 = pd.Series([3, 4, 5])\n3207 |         >>> s1.combine_first(s2)\n3208 |         0    1.0\n3209 |         1    4.0\n3210 |         2    5.0\n3211 |         dtype: float64\n3212 | \n3213 |         Null values still persist if the location of that null value\n3214 |         does not exist in `other`\n3215 | \n3216 |         >>> s1 = pd.Series({\"falcon\": np.nan, \"eagle\": 160.0})\n3217 |         >>> s2 = pd.Series({\"eagle\": 200.0, \"duck\": 30.0})\n3218 |         >>> s1.combine_first(s2)\n3219 |         duck       30.0\n3220 |         eagle     160.0\n3221 |         falcon      NaN\n3222 |         dtype: float64\n3223 |         \"\"\"\n3224 |         from pandas.core.reshape.concat import concat\n3225 | \n3226 |         if self.dtype == other.dtype:\n3227 |             if self.index.equals(other.index):\n3228 |                 return self.mask(self.isna(), other)\n3229 |             elif self._can_hold_na and not isinstance(self.dtype, SparseDtype):\n3230 |                 this, other = self.align(other, join=\"outer\")\n3231 |                 return this.mask(this.isna(), other)\n3232 | \n3233 |         new_index = self.index.union(other.index)\n3234 | \n3235 |         this = self\n3236 |         # identify the index subset to keep for each series\n3237 |         keep_other = other.index.difference(this.index[notna(this)])\n3238 |         keep_this = this.index.difference(keep_other)\n3239 | \n3240 |         this = this.reindex(keep_this)\n3241 |         other = other.reindex(keep_other)\n3242 | \n3243 |         if this.dtype.kind == \"M\" and other.dtype.kind != \"M\":\n3244 |             # TODO: try to match resos?\n3245 |             other = to_datetime(other)\n3246 |         combined = concat([this, other])\n3247 |         combined = combined.reindex(new_index)\n3248 |         return combined.__finalize__(self, method=\"combine_first\")\n3249 | \n3250 |     def update(self, other: Series | Sequence | Mapping) -> None:\n3251 |         \"\"\"\n3252 |         Modify Series in place using values from passed Series.\n3253 | \n3254 |         Uses non-NA values from passed Series to make updates. Aligns\n3255 |         on index.\n3256 | \n3257 |         Parameters\n3258 |         ----------\n3259 |         other : Series, or object coercible into Series\n3260 |             Other Series that provides values to update the current Series.\n3261 | \n3262 |         See Also\n3263 |         --------\n3264 |         Series.combine : Perform element-wise operation on two Series\n3265 |             using a given function.\n3266 |         Series.transform: Modify a Series using a function.\n3267 | \n3268 |         Examples\n3269 |         --------\n3270 |         >>> s = pd.Series([1, 2, 3])\n3271 |         >>> s.update(pd.Series([4, 5, 6]))\n3272 |         >>> s\n3273 |         0    4\n3274 |         1    5\n3275 |         2    6\n3276 |         dtype: int64\n3277 | \n3278 |         >>> s = pd.Series([\"a\", \"b\", \"c\"])\n3279 |         >>> s.update(pd.Series([\"d\", \"e\"], index=[0, 2]))\n3280 |         >>> s\n3281 |         0    d\n3282 |         1    b\n3283 |         2    e\n3284 |         dtype: object\n3285 | \n3286 |         >>> s = pd.Series([1, 2, 3])\n3287 |         >>> s.update(pd.Series([4, 5, 6, 7, 8]))\n3288 |         >>> s\n3289 |         0    4\n3290 |         1    5\n3291 |         2    6\n3292 |         dtype: int64\n3293 | \n3294 |         If ``other`` contains NaNs the corresponding values are not updated\n3295 |         in the original Series.\n3296 | \n3297 |         >>> s = pd.Series([1, 2, 3])\n3298 |         >>> s.update(pd.Series([4, np.nan, 6]))\n3299 |         >>> s\n3300 |         0    4\n3301 |         1    2\n3302 |         2    6\n3303 |         dtype: int64\n3304 | \n3305 |         ``other`` can also be a non-Series object type\n3306 |         that is coercible into a Series\n3307 | \n3308 |         >>> s = pd.Series([1, 2, 3])\n3309 |         >>> s.update([4, np.nan, 6])\n3310 |         >>> s\n3311 |         0    4\n3312 |         1    2\n3313 |         2    6\n3314 |         dtype: int64\n3315 | \n3316 |         >>> s = pd.Series([1, 2, 3])\n3317 |         >>> s.update({1: 9})\n3318 |         >>> s\n3319 |         0    1\n3320 |         1    9\n3321 |         2    3\n3322 |         dtype: int64\n3323 |         \"\"\"\n3324 |         if not PYPY:\n3325 |             if sys.getrefcount(self) <= REF_COUNT:\n3326 |                 warnings.warn(\n3327 |                     _chained_assignment_method_msg,\n3328 |                     ChainedAssignmentError,\n3329 |                     stacklevel=2,\n3330 |                 )\n3331 | \n3332 |         if not isinstance(other, Series):\n3333 |             other = Series(other)\n3334 | \n3335 |         other = other.reindex_like(self)\n3336 |         mask = notna(other)\n3337 | \n3338 |         self._mgr = self._mgr.putmask(mask=mask, new=other)\n3339 | \n3340 |     # ----------------------------------------------------------------------\n3341 |     # Reindexing, sorting\n3342 | \n3343 |     @overload\n3344 |     def sort_values(\n3345 |         self,\n3346 |         *,\n3347 |         axis: Axis = ...,\n3348 |         ascending: bool | Sequence[bool] = ...,\n3349 |         inplace: Literal[False] = ...,\n3350 |         kind: SortKind = ...,\n3351 |         na_position: NaPosition = ...,\n3352 |         ignore_index: bool = ...,\n3353 |         key: ValueKeyFunc = ...,\n3354 |     ) -> Series: ...\n3355 | \n3356 |     @overload\n3357 |     def sort_values(\n3358 |         self,\n3359 |         *,\n3360 |         axis: Axis = ...,\n3361 |         ascending: bool | Sequence[bool] = ...,\n3362 |         inplace: Literal[True],\n3363 |         kind: SortKind = ...,\n3364 |         na_position: NaPosition = ...,\n3365 |         ignore_index: bool = ...,\n3366 |         key: ValueKeyFunc = ...,\n3367 |     ) -> None: ...\n3368 | \n3369 |     @overload\n3370 |     def sort_values(\n3371 |         self,\n3372 |         *,\n3373 |         axis: Axis = ...,\n3374 |         ascending: bool | Sequence[bool] = ...,\n3375 |         inplace: bool = ...,\n3376 |         kind: SortKind = ...,\n3377 |         na_position: NaPosition = ...,\n3378 |         ignore_index: bool = ...,\n3379 |         key: ValueKeyFunc = ...,\n3380 |     ) -> Series | None: ...\n3381 | \n3382 |     def sort_values(\n3383 |         self,\n3384 |         *,\n3385 |         axis: Axis = 0,\n3386 |         ascending: bool | Sequence[bool] = True,\n3387 |         inplace: bool = False,\n3388 |         kind: SortKind = \"quicksort\",\n3389 |         na_position: NaPosition = \"last\",\n3390 |         ignore_index: bool = False,\n3391 |         key: ValueKeyFunc | None = None,\n3392 |     ) -> Series | None:\n3393 |         \"\"\"\n3394 |         Sort by the values.\n3395 | \n3396 |         Sort a Series in ascending or descending order by some\n3397 |         criterion.\n3398 | \n3399 |         Parameters\n3400 |         ----------\n3401 |         axis : {0 or 'index'}\n3402 |             Unused. Parameter needed for compatibility with DataFrame.\n3403 |         ascending : bool or list of bools, default True\n3404 |             If True, sort values in ascending order, otherwise descending.\n3405 |         inplace : bool, default False\n3406 |             If True, perform operation in-place.\n3407 |         kind : {'quicksort', 'mergesort', 'heapsort', 'stable'}, default 'quicksort'\n3408 |             Choice of sorting algorithm. See also :func:`numpy.sort` for more\n3409 |             information. 'mergesort' and 'stable' are the only stable  algorithms.\n3410 |         na_position : {'first' or 'last'}, default 'last'\n3411 |             Argument 'first' puts NaNs at the beginning, 'last' puts NaNs at\n3412 |             the end.\n3413 |         ignore_index : bool, default False\n3414 |             If True, the resulting axis will be labeled 0, 1, \u2026, n - 1.\n3415 |         key : callable, optional\n3416 |             If not None, apply the key function to the series values\n3417 |             before sorting. This is similar to the `key` argument in the\n3418 |             builtin :meth:`sorted` function, with the notable difference that\n3419 |             this `key` function should be *vectorized*. It should expect a\n3420 |             ``Series`` and return an array-like.\n3421 | \n3422 |         Returns\n3423 |         -------\n3424 |         Series or None\n3425 |             Series ordered by values or None if ``inplace=True``.\n3426 | \n3427 |         See Also\n3428 |         --------\n3429 |         Series.sort_index : Sort by the Series indices.\n3430 |         DataFrame.sort_values : Sort DataFrame by the values along either axis.\n3431 |         DataFrame.sort_index : Sort DataFrame by indices.\n3432 | \n3433 |         Examples\n3434 |         --------\n3435 |         >>> s = pd.Series([np.nan, 1, 3, 10, 5])\n3436 |         >>> s\n3437 |         0     NaN\n3438 |         1     1.0\n3439 |         2     3.0\n3440 |         3     10.0\n3441 |         4     5.0\n3442 |         dtype: float64\n3443 | \n3444 |         Sort values ascending order (default behaviour)\n3445 | \n3446 |         >>> s.sort_values(ascending=True)\n3447 |         1     1.0\n3448 |         2     3.0\n3449 |         4     5.0\n3450 |         3    10.0\n3451 |         0     NaN\n3452 |         dtype: float64\n3453 | \n3454 |         Sort values descending order\n3455 | \n3456 |         >>> s.sort_values(ascending=False)\n3457 |         3    10.0\n3458 |         4     5.0\n3459 |         2     3.0\n3460 |         1     1.0\n3461 |         0     NaN\n3462 |         dtype: float64\n3463 | \n3464 |         Sort values putting NAs first\n3465 | \n3466 |         >>> s.sort_values(na_position=\"first\")\n3467 |         0     NaN\n3468 |         1     1.0\n3469 |         2     3.0\n3470 |         4     5.0\n3471 |         3    10.0\n3472 |         dtype: float64\n3473 | \n3474 |         Sort a series of strings\n3475 | \n3476 |         >>> s = pd.Series([\"z\", \"b\", \"d\", \"a\", \"c\"])\n3477 |         >>> s\n3478 |         0    z\n3479 |         1    b\n3480 |         2    d\n3481 |         3    a\n3482 |         4    c\n3483 |         dtype: object\n3484 | \n3485 |         >>> s.sort_values()\n3486 |         3    a\n3487 |         1    b\n3488 |         4    c\n3489 |         2    d\n3490 |         0    z\n3491 |         dtype: object\n3492 | \n3493 |         Sort using a key function. Your `key` function will be\n3494 |         given the ``Series`` of values and should return an array-like.\n3495 | \n3496 |         >>> s = pd.Series([\"a\", \"B\", \"c\", \"D\", \"e\"])\n3497 |         >>> s.sort_values()\n3498 |         1    B\n3499 |         3    D\n3500 |         0    a\n3501 |         2    c\n3502 |         4    e\n3503 |         dtype: object\n3504 |         >>> s.sort_values(key=lambda x: x.str.lower())\n3505 |         0    a\n3506 |         1    B\n3507 |         2    c\n3508 |         3    D\n3509 |         4    e\n3510 |         dtype: object\n3511 | \n3512 |         NumPy ufuncs work well here. For example, we can\n3513 |         sort by the ``sin`` of the value\n3514 | \n3515 |         >>> s = pd.Series([-4, -2, 0, 2, 4])\n3516 |         >>> s.sort_values(key=np.sin)\n3517 |         1   -2\n3518 |         4    4\n3519 |         2    0\n3520 |         0   -4\n3521 |         3    2\n3522 |         dtype: int64\n3523 | \n3524 |         More complicated user-defined functions can be used,\n3525 |         as long as they expect a Series and return an array-like\n3526 | \n3527 |         >>> s.sort_values(key=lambda x: (np.tan(x.cumsum())))\n3528 |         0   -4\n3529 |         3    2\n3530 |         4    4\n3531 |         1   -2\n3532 |         2    0\n3533 |         dtype: int64\n3534 |         \"\"\"\n3535 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n3536 |         # Validate the axis parameter\n3537 |         self._get_axis_number(axis)\n3538 | \n3539 |         if is_list_like(ascending):\n3540 |             ascending = cast(Sequence[bool], ascending)\n3541 |             if len(ascending) != 1:\n3542 |                 raise ValueError(\n3543 |                     f\"Length of ascending ({len(ascending)}) must be 1 for Series\"\n3544 |                 )\n3545 |             ascending = ascending[0]\n3546 | \n3547 |         ascending = validate_ascending(ascending)\n3548 | \n3549 |         if na_position not in [\"first\", \"last\"]:\n3550 |             raise ValueError(f\"invalid na_position: {na_position}\")\n3551 | \n3552 |         # GH 35922. Make sorting stable by leveraging nargsort\n3553 |         if key:\n3554 |             values_to_sort = cast(Series, ensure_key_mapped(self, key))._values\n3555 |         else:\n3556 |             values_to_sort = self._values\n3557 |         sorted_index = nargsort(values_to_sort, kind, bool(ascending), na_position)\n3558 | \n3559 |         if is_range_indexer(sorted_index, len(sorted_index)):\n3560 |             if inplace:\n3561 |                 return self._update_inplace(self)\n3562 |             return self.copy(deep=False)\n3563 | \n3564 |         result = self._constructor(\n3565 |             self._values[sorted_index], index=self.index[sorted_index], copy=False\n3566 |         )\n3567 | \n3568 |         if ignore_index:\n3569 |             result.index = default_index(len(sorted_index))\n3570 | \n3571 |         if not inplace:\n3572 |             return result.__finalize__(self, method=\"sort_values\")\n3573 |         self._update_inplace(result)\n3574 |         return None\n3575 | \n3576 |     @overload\n3577 |     def sort_index(\n3578 |         self,\n3579 |         *,\n3580 |         axis: Axis = ...,\n3581 |         level: IndexLabel = ...,\n3582 |         ascending: bool | Sequence[bool] = ...,\n3583 |         inplace: Literal[True],\n3584 |         kind: SortKind = ...,\n3585 |         na_position: NaPosition = ...,\n3586 |         sort_remaining: bool = ...,\n3587 |         ignore_index: bool = ...,\n3588 |         key: IndexKeyFunc = ...,\n3589 |     ) -> None: ...\n3590 | \n3591 |     @overload\n3592 |     def sort_index(\n3593 |         self,\n3594 |         *,\n3595 |         axis: Axis = ...,\n3596 |         level: IndexLabel = ...,\n3597 |         ascending: bool | Sequence[bool] = ...,\n3598 |         inplace: Literal[False] = ...,\n3599 |         kind: SortKind = ...,\n3600 |         na_position: NaPosition = ...,\n3601 |         sort_remaining: bool = ...,\n3602 |         ignore_index: bool = ...,\n3603 |         key: IndexKeyFunc = ...,\n3604 |     ) -> Series: ...\n3605 | \n3606 |     @overload\n3607 |     def sort_index(\n3608 |         self,\n3609 |         *,\n3610 |         axis: Axis = ...,\n3611 |         level: IndexLabel = ...,\n3612 |         ascending: bool | Sequence[bool] = ...,\n3613 |         inplace: bool = ...,\n3614 |         kind: SortKind = ...,\n3615 |         na_position: NaPosition = ...,\n3616 |         sort_remaining: bool = ...,\n3617 |         ignore_index: bool = ...,\n3618 |         key: IndexKeyFunc = ...,\n3619 |     ) -> Series | None: ...\n3620 | \n3621 |     def sort_index(\n3622 |         self,\n3623 |         *,\n3624 |         axis: Axis = 0,\n3625 |         level: IndexLabel | None = None,\n3626 |         ascending: bool | Sequence[bool] = True,\n3627 |         inplace: bool = False,\n3628 |         kind: SortKind = \"quicksort\",\n3629 |         na_position: NaPosition = \"last\",\n3630 |         sort_remaining: bool = True,\n3631 |         ignore_index: bool = False,\n3632 |         key: IndexKeyFunc | None = None,\n3633 |     ) -> Series | None:\n3634 |         \"\"\"\n3635 |         Sort Series by index labels.\n3636 | \n3637 |         Returns a new Series sorted by label if `inplace` argument is\n3638 |         ``False``, otherwise updates the original series and returns None.\n3639 | \n3640 |         Parameters\n3641 |         ----------\n3642 |         axis : {0 or 'index'}\n3643 |             Unused. Parameter needed for compatibility with DataFrame.\n3644 |         level : int, optional\n3645 |             If not None, sort on values in specified index level(s).\n3646 |         ascending : bool or list-like of bools, default True\n3647 |             Sort ascending vs. descending. When the index is a MultiIndex the\n3648 |             sort direction can be controlled for each level individually.\n3649 |         inplace : bool, default False\n3650 |             If True, perform operation in-place.\n3651 |         kind : {'quicksort', 'mergesort', 'heapsort', 'stable'}, default 'quicksort'\n3652 |             Choice of sorting algorithm. See also :func:`numpy.sort` for more\n3653 |             information. 'mergesort' and 'stable' are the only stable algorithms. For\n3654 |             DataFrames, this option is only applied when sorting on a single\n3655 |             column or label.\n3656 |         na_position : {'first', 'last'}, default 'last'\n3657 |             If 'first' puts NaNs at the beginning, 'last' puts NaNs at the end.\n3658 |             Not implemented for MultiIndex.\n3659 |         sort_remaining : bool, default True\n3660 |             If True and sorting by level and index is multilevel, sort by other\n3661 |             levels too (in order) after sorting by specified level.\n3662 |         ignore_index : bool, default False\n3663 |             If True, the resulting axis will be labeled 0, 1, \u2026, n - 1.\n3664 |         key : callable, optional\n3665 |             If not None, apply the key function to the index values\n3666 |             before sorting. This is similar to the `key` argument in the\n3667 |             builtin :meth:`sorted` function, with the notable difference that\n3668 |             this `key` function should be *vectorized*. It should expect an\n3669 |             ``Index`` and return an ``Index`` of the same shape.\n3670 | \n3671 |         Returns\n3672 |         -------\n3673 |         Series or None\n3674 |             The original Series sorted by the labels or None if ``inplace=True``.\n3675 | \n3676 |         See Also\n3677 |         --------\n3678 |         DataFrame.sort_index: Sort DataFrame by the index.\n3679 |         DataFrame.sort_values: Sort DataFrame by the value.\n3680 |         Series.sort_values : Sort Series by the value.\n3681 | \n3682 |         Examples\n3683 |         --------\n3684 |         >>> s = pd.Series([\"a\", \"b\", \"c\", \"d\"], index=[3, 2, 1, 4])\n3685 |         >>> s.sort_index()\n3686 |         1    c\n3687 |         2    b\n3688 |         3    a\n3689 |         4    d\n3690 |         dtype: object\n3691 | \n3692 |         Sort Descending\n3693 | \n3694 |         >>> s.sort_index(ascending=False)\n3695 |         4    d\n3696 |         3    a\n3697 |         2    b\n3698 |         1    c\n3699 |         dtype: object\n3700 | \n3701 |         By default NaNs are put at the end, but use `na_position` to place\n3702 |         them at the beginning\n3703 | \n3704 |         >>> s = pd.Series([\"a\", \"b\", \"c\", \"d\"], index=[3, 2, 1, np.nan])\n3705 |         >>> s.sort_index(na_position=\"first\")\n3706 |         NaN     d\n3707 |          1.0    c\n3708 |          2.0    b\n3709 |          3.0    a\n3710 |         dtype: object\n3711 | \n3712 |         Specify index level to sort\n3713 | \n3714 |         >>> arrays = [\n3715 |         ...     np.array([\"qux\", \"qux\", \"foo\", \"foo\", \"baz\", \"baz\", \"bar\", \"bar\"]),\n3716 |         ...     np.array([\"two\", \"one\", \"two\", \"one\", \"two\", \"one\", \"two\", \"one\"]),\n3717 |         ... ]\n3718 |         >>> s = pd.Series([1, 2, 3, 4, 5, 6, 7, 8], index=arrays)\n3719 |         >>> s.sort_index(level=1)\n3720 |         bar  one    8\n3721 |         baz  one    6\n3722 |         foo  one    4\n3723 |         qux  one    2\n3724 |         bar  two    7\n3725 |         baz  two    5\n3726 |         foo  two    3\n3727 |         qux  two    1\n3728 |         dtype: int64\n3729 | \n3730 |         Does not sort by remaining levels when sorting by levels\n3731 | \n3732 |         >>> s.sort_index(level=1, sort_remaining=False)\n3733 |         qux  one    2\n3734 |         foo  one    4\n3735 |         baz  one    6\n3736 |         bar  one    8\n3737 |         qux  two    1\n3738 |         foo  two    3\n3739 |         baz  two    5\n3740 |         bar  two    7\n3741 |         dtype: int64\n3742 | \n3743 |         Apply a key function before sorting\n3744 | \n3745 |         >>> s = pd.Series([1, 2, 3, 4], index=[\"A\", \"b\", \"C\", \"d\"])\n3746 |         >>> s.sort_index(key=lambda x: x.str.lower())\n3747 |         A    1\n3748 |         b    2\n3749 |         C    3\n3750 |         d    4\n3751 |         dtype: int64\n3752 |         \"\"\"\n3753 | \n3754 |         return super().sort_index(\n3755 |             axis=axis,\n3756 |             level=level,\n3757 |             ascending=ascending,\n3758 |             inplace=inplace,\n3759 |             kind=kind,\n3760 |             na_position=na_position,\n3761 |             sort_remaining=sort_remaining,\n3762 |             ignore_index=ignore_index,\n3763 |             key=key,\n3764 |         )\n3765 | \n3766 |     def argsort(\n3767 |         self,\n3768 |         axis: Axis = 0,\n3769 |         kind: SortKind = \"quicksort\",\n3770 |         order: None = None,\n3771 |         stable: None = None,\n3772 |     ) -> Series:\n3773 |         \"\"\"\n3774 |         Return the integer indices that would sort the Series values.\n3775 | \n3776 |         Override ndarray.argsort. Argsorts the value, omitting NA/null values,\n3777 |         and places the result in the same locations as the non-NA values.\n3778 | \n3779 |         Parameters\n3780 |         ----------\n3781 |         axis : {0 or 'index'}\n3782 |             Unused. Parameter needed for compatibility with DataFrame.\n3783 |         kind : {'mergesort', 'quicksort', 'heapsort', 'stable'}, default 'quicksort'\n3784 |             Choice of sorting algorithm. See :func:`numpy.sort` for more\n3785 |             information. 'mergesort' and 'stable' are the only stable algorithms.\n3786 |         order : None\n3787 |             Has no effect but is accepted for compatibility with numpy.\n3788 |         stable : None\n3789 |             Has no effect but is accepted for compatibility with numpy.\n3790 | \n3791 |         Returns\n3792 |         -------\n3793 |         Series[np.intp]\n3794 |             Positions of values within the sort order with -1 indicating\n3795 |             nan values.\n3796 | \n3797 |         See Also\n3798 |         --------\n3799 |         numpy.ndarray.argsort : Returns the indices that would sort this array.\n3800 | \n3801 |         Examples\n3802 |         --------\n3803 |         >>> s = pd.Series([3, 2, 1])\n3804 |         >>> s.argsort()\n3805 |         0    2\n3806 |         1    1\n3807 |         2    0\n3808 |         dtype: int64\n3809 |         \"\"\"\n3810 |         if axis != -1:\n3811 |             # GH#54257 We allow -1 here so that np.argsort(series) works\n3812 |             self._get_axis_number(axis)\n3813 | \n3814 |         result = self.array.argsort(kind=kind)\n3815 | \n3816 |         res = self._constructor(\n3817 |             result, index=self.index, name=self.name, dtype=np.intp, copy=False\n3818 |         )\n3819 |         return res.__finalize__(self, method=\"argsort\")\n3820 | \n3821 |     def nlargest(\n3822 |         self, n: int = 5, keep: Literal[\"first\", \"last\", \"all\"] = \"first\"\n3823 |     ) -> Series:\n3824 |         \"\"\"\n3825 |         Return the largest `n` elements.\n3826 | \n3827 |         Parameters\n3828 |         ----------\n3829 |         n : int, default 5\n3830 |             Return this many descending sorted values.\n3831 |         keep : {'first', 'last', 'all'}, default 'first'\n3832 |             When there are duplicate values that cannot all fit in a\n3833 |             Series of `n` elements:\n3834 | \n3835 |             - ``first`` : return the first `n` occurrences in order\n3836 |               of appearance.\n3837 |             - ``last`` : return the last `n` occurrences in reverse\n3838 |               order of appearance.\n3839 |             - ``all`` : keep all occurrences. This can result in a Series of\n3840 |               size larger than `n`.\n3841 | \n3842 |         Returns\n3843 |         -------\n3844 |         Series\n3845 |             The `n` largest values in the Series, sorted in decreasing order.\n3846 | \n3847 |         See Also\n3848 |         --------\n3849 |         Series.nsmallest: Get the `n` smallest elements.\n3850 |         Series.sort_values: Sort Series by values.\n3851 |         Series.head: Return the first `n` rows.\n3852 | \n3853 |         Notes\n3854 |         -----\n3855 |         Faster than ``.sort_values(ascending=False).head(n)`` for small `n`\n3856 |         relative to the size of the ``Series`` object.\n3857 | \n3858 |         Examples\n3859 |         --------\n3860 |         >>> countries_population = {\n3861 |         ...     \"Italy\": 59000000,\n3862 |         ...     \"France\": 65000000,\n3863 |         ...     \"Malta\": 434000,\n3864 |         ...     \"Maldives\": 434000,\n3865 |         ...     \"Brunei\": 434000,\n3866 |         ...     \"Iceland\": 337000,\n3867 |         ...     \"Nauru\": 11300,\n3868 |         ...     \"Tuvalu\": 11300,\n3869 |         ...     \"Anguilla\": 11300,\n3870 |         ...     \"Montserrat\": 5200,\n3871 |         ... }\n3872 |         >>> s = pd.Series(countries_population)\n3873 |         >>> s\n3874 |         Italy       59000000\n3875 |         France      65000000\n3876 |         Malta         434000\n3877 |         Maldives      434000\n3878 |         Brunei        434000\n3879 |         Iceland       337000\n3880 |         Nauru          11300\n3881 |         Tuvalu         11300\n3882 |         Anguilla       11300\n3883 |         Montserrat      5200\n3884 |         dtype: int64\n3885 | \n3886 |         The `n` largest elements where ``n=5`` by default.\n3887 | \n3888 |         >>> s.nlargest()\n3889 |         France      65000000\n3890 |         Italy       59000000\n3891 |         Malta         434000\n3892 |         Maldives      434000\n3893 |         Brunei        434000\n3894 |         dtype: int64\n3895 | \n3896 |         The `n` largest elements where ``n=3``. Default `keep` value is 'first'\n3897 |         so Malta will be kept.\n3898 | \n3899 |         >>> s.nlargest(3)\n3900 |         France    65000000\n3901 |         Italy     59000000\n3902 |         Malta       434000\n3903 |         dtype: int64\n3904 | \n3905 |         The `n` largest elements where ``n=3`` and keeping the last duplicates.\n3906 |         Brunei will be kept since it is the last with value 434000 based on\n3907 |         the index order.\n3908 | \n3909 |         >>> s.nlargest(3, keep=\"last\")\n3910 |         France      65000000\n3911 |         Italy       59000000\n3912 |         Brunei        434000\n3913 |         dtype: int64\n3914 | \n3915 |         The `n` largest elements where ``n=3`` with all duplicates kept. Note\n3916 |         that the returned Series has five elements due to the three duplicates.\n3917 | \n3918 |         >>> s.nlargest(3, keep=\"all\")\n3919 |         France      65000000\n3920 |         Italy       59000000\n3921 |         Malta         434000\n3922 |         Maldives      434000\n3923 |         Brunei        434000\n3924 |         dtype: int64\n3925 |         \"\"\"\n3926 |         return selectn.SelectNSeries(self, n=n, keep=keep).nlargest()\n3927 | \n3928 |     def nsmallest(\n3929 |         self, n: int = 5, keep: Literal[\"first\", \"last\", \"all\"] = \"first\"\n3930 |     ) -> Series:\n3931 |         \"\"\"\n3932 |         Return the smallest `n` elements.\n3933 | \n3934 |         Parameters\n3935 |         ----------\n3936 |         n : int, default 5\n3937 |             Return this many ascending sorted values.\n3938 |         keep : {'first', 'last', 'all'}, default 'first'\n3939 |             When there are duplicate values that cannot all fit in a\n3940 |             Series of `n` elements:\n3941 | \n3942 |             - ``first`` : return the first `n` occurrences in order\n3943 |               of appearance.\n3944 |             - ``last`` : return the last `n` occurrences in reverse\n3945 |               order of appearance.\n3946 |             - ``all`` : keep all occurrences. This can result in a Series of\n3947 |               size larger than `n`.\n3948 | \n3949 |         Returns\n3950 |         -------\n3951 |         Series\n3952 |             The `n` smallest values in the Series, sorted in increasing order.\n3953 | \n3954 |         See Also\n3955 |         --------\n3956 |         Series.nlargest: Get the `n` largest elements.\n3957 |         Series.sort_values: Sort Series by values.\n3958 |         Series.head: Return the first `n` rows.\n3959 | \n3960 |         Notes\n3961 |         -----\n3962 |         Faster than ``.sort_values().head(n)`` for small `n` relative to\n3963 |         the size of the ``Series`` object.\n3964 | \n3965 |         Examples\n3966 |         --------\n3967 |         >>> countries_population = {\n3968 |         ...     \"Italy\": 59000000,\n3969 |         ...     \"France\": 65000000,\n3970 |         ...     \"Brunei\": 434000,\n3971 |         ...     \"Malta\": 434000,\n3972 |         ...     \"Maldives\": 434000,\n3973 |         ...     \"Iceland\": 337000,\n3974 |         ...     \"Nauru\": 11300,\n3975 |         ...     \"Tuvalu\": 11300,\n3976 |         ...     \"Anguilla\": 11300,\n3977 |         ...     \"Montserrat\": 5200,\n3978 |         ... }\n3979 |         >>> s = pd.Series(countries_population)\n3980 |         >>> s\n3981 |         Italy       59000000\n3982 |         France      65000000\n3983 |         Brunei        434000\n3984 |         Malta         434000\n3985 |         Maldives      434000\n3986 |         Iceland       337000\n3987 |         Nauru          11300\n3988 |         Tuvalu         11300\n3989 |         Anguilla       11300\n3990 |         Montserrat      5200\n3991 |         dtype: int64\n3992 | \n3993 |         The `n` smallest elements where ``n=5`` by default.\n3994 | \n3995 |         >>> s.nsmallest()\n3996 |         Montserrat    5200\n3997 |         Nauru        11300\n3998 |         Tuvalu       11300\n3999 |         Anguilla     11300\n4000 |         Iceland     337000\n4001 |         dtype: int64\n4002 | \n4003 |         The `n` smallest elements where ``n=3``. Default `keep` value is\n4004 |         'first' so Nauru and Tuvalu will be kept.\n4005 | \n4006 |         >>> s.nsmallest(3)\n4007 |         Montserrat   5200\n4008 |         Nauru       11300\n4009 |         Tuvalu      11300\n4010 |         dtype: int64\n4011 | \n4012 |         The `n` smallest elements where ``n=3`` and keeping the last\n4013 |         duplicates. Anguilla and Tuvalu will be kept since they are the last\n4014 |         with value 11300 based on the index order.\n4015 | \n4016 |         >>> s.nsmallest(3, keep=\"last\")\n4017 |         Montserrat   5200\n4018 |         Anguilla    11300\n4019 |         Tuvalu      11300\n4020 |         dtype: int64\n4021 | \n4022 |         The `n` smallest elements where ``n=3`` with all duplicates kept. Note\n4023 |         that the returned Series has four elements due to the three duplicates.\n4024 | \n4025 |         >>> s.nsmallest(3, keep=\"all\")\n4026 |         Montserrat   5200\n4027 |         Nauru       11300\n4028 |         Tuvalu      11300\n4029 |         Anguilla    11300\n4030 |         dtype: int64\n4031 |         \"\"\"\n4032 |         return selectn.SelectNSeries(self, n=n, keep=keep).nsmallest()\n4033 | \n4034 |     def swaplevel(\n4035 |         self, i: Level = -2, j: Level = -1, copy: bool | lib.NoDefault = lib.no_default\n4036 |     ) -> Series:\n4037 |         \"\"\"\n4038 |         Swap levels i and j in a :class:`MultiIndex`.\n4039 | \n4040 |         Default is to swap the two innermost levels of the index.\n4041 | \n4042 |         Parameters\n4043 |         ----------\n4044 |         i, j : int or str\n4045 |             Levels of the indices to be swapped. Can pass level name as string.\n4046 |         copy : bool, default True\n4047 |                     Whether to copy underlying data.\n4048 | \n4049 |                     .. note::\n4050 |                         The `copy` keyword will change behavior in pandas 3.0.\n4051 |                         `Copy-on-Write\n4052 |                         <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n4053 |                         will be enabled by default, which means that all methods with a\n4054 |                         `copy` keyword will use a lazy copy mechanism to defer the copy\n4055 |                         and ignore the `copy` keyword. The `copy` keyword will be\n4056 |                         removed in a future version of pandas.\n4057 | \n4058 |                         You can already get the future behavior and improvements through\n4059 |                         enabling copy on write ``pd.options.mode.copy_on_write = True``\n4060 | \n4061 |         Returns\n4062 |         -------\n4063 |         Series\n4064 |             Series with levels swapped in MultiIndex.\n4065 | \n4066 |         See Also\n4067 |         --------\n4068 |         DataFrame.swaplevel : Swap levels i and j in a :class:`DataFrame`.\n4069 |         Series.reorder_levels : Rearrange index levels using input order.\n4070 |         MultiIndex.swaplevel : Swap levels i and j in a :class:`MultiIndex`.\n4071 | \n4072 |         Examples\n4073 |         --------\n4074 |         >>> s = pd.Series(\n4075 |         ...     [\"A\", \"B\", \"A\", \"C\"],\n4076 |         ...     index=[\n4077 |         ...         [\"Final exam\", \"Final exam\", \"Coursework\", \"Coursework\"],\n4078 |         ...         [\"History\", \"Geography\", \"History\", \"Geography\"],\n4079 |         ...         [\"January\", \"February\", \"March\", \"April\"],\n4080 |         ...     ],\n4081 |         ... )\n4082 |         >>> s\n4083 |         Final exam  History     January      A\n4084 |                     Geography   February     B\n4085 |         Coursework  History     March        A\n4086 |                     Geography   April        C\n4087 |         dtype: object\n4088 | \n4089 |         In the following example, we will swap the levels of the indices.\n4090 |         Here, we will swap the levels column-wise, but levels can be swapped row-wise\n4091 |         in a similar manner. Note that column-wise is the default behaviour.\n4092 |         By not supplying any arguments for i and j, we swap the last and second to\n4093 |         last indices.\n4094 | \n4095 |         >>> s.swaplevel()\n4096 |         Final exam  January     History         A\n4097 |                     February    Geography       B\n4098 |         Coursework  March       History         A\n4099 |                     April       Geography       C\n4100 |         dtype: object\n4101 | \n4102 |         By supplying one argument, we can choose which index to swap the last\n4103 |         index with. We can for example swap the first index with the last one as\n4104 |         follows.\n4105 | \n4106 |         >>> s.swaplevel(0)\n4107 |         January     History     Final exam      A\n4108 |         February    Geography   Final exam      B\n4109 |         March       History     Coursework      A\n4110 |         April       Geography   Coursework      C\n4111 |         dtype: object\n4112 | \n4113 |         We can also define explicitly which indices we want to swap by supplying values\n4114 |         for both i and j. Here, we for example swap the first and second indices.\n4115 | \n4116 |         >>> s.swaplevel(0, 1)\n4117 |         History     Final exam  January         A\n4118 |         Geography   Final exam  February        B\n4119 |         History     Coursework  March           A\n4120 |         Geography   Coursework  April           C\n4121 |         dtype: object\n4122 |         \"\"\"\n4123 |         self._check_copy_deprecation(copy)\n4124 |         assert isinstance(self.index, MultiIndex)\n4125 |         result = self.copy(deep=False)\n4126 |         result.index = self.index.swaplevel(i, j)\n4127 |         return result\n4128 | \n4129 |     def reorder_levels(self, order: Sequence[Level]) -> Series:\n4130 |         \"\"\"\n4131 |         Rearrange index levels using input order.\n4132 | \n4133 |         May not drop or duplicate levels.\n4134 | \n4135 |         Parameters\n4136 |         ----------\n4137 |         order : list of int representing new level order\n4138 |             Reference level by number or key.\n4139 | \n4140 |         Returns\n4141 |         -------\n4142 |         Series\n4143 |             Type of caller with index as MultiIndex (new object).\n4144 | \n4145 |         See Also\n4146 |         --------\n4147 |         DataFrame.reorder_levels : Rearrange index or column levels using\n4148 |             input ``order``.\n4149 | \n4150 |         Examples\n4151 |         --------\n4152 |         >>> arrays = [\n4153 |         ...     np.array([\"dog\", \"dog\", \"cat\", \"cat\", \"bird\", \"bird\"]),\n4154 |         ...     np.array([\"white\", \"black\", \"white\", \"black\", \"white\", \"black\"]),\n4155 |         ... ]\n4156 |         >>> s = pd.Series([1, 2, 3, 3, 5, 2], index=arrays)\n4157 |         >>> s\n4158 |         dog   white    1\n4159 |               black    2\n4160 |         cat   white    3\n4161 |               black    3\n4162 |         bird  white    5\n4163 |               black    2\n4164 |         dtype: int64\n4165 |         >>> s.reorder_levels([1, 0])\n4166 |         white  dog     1\n4167 |         black  dog     2\n4168 |         white  cat     3\n4169 |         black  cat     3\n4170 |         white  bird    5\n4171 |         black  bird    2\n4172 |         dtype: int64\n4173 |         \"\"\"\n4174 |         if not isinstance(self.index, MultiIndex):  # pragma: no cover\n4175 |             raise Exception(\"Can only reorder levels on a hierarchical axis.\")\n4176 | \n4177 |         result = self.copy(deep=False)\n4178 |         assert isinstance(result.index, MultiIndex)\n4179 |         result.index = result.index.reorder_levels(order)\n4180 |         return result\n4181 | \n4182 |     def explode(self, ignore_index: bool = False) -> Series:\n4183 |         \"\"\"\n4184 |         Transform each element of a list-like to a row.\n4185 | \n4186 |         Parameters\n4187 |         ----------\n4188 |         ignore_index : bool, default False\n4189 |             If True, the resulting index will be labeled 0, 1, \u2026, n - 1.\n4190 | \n4191 |         Returns\n4192 |         -------\n4193 |         Series\n4194 |             Exploded lists to rows; index will be duplicated for these rows.\n4195 | \n4196 |         See Also\n4197 |         --------\n4198 |         Series.str.split : Split string values on specified separator.\n4199 |         Series.unstack : Unstack, a.k.a. pivot, Series with MultiIndex\n4200 |             to produce DataFrame.\n4201 |         DataFrame.melt : Unpivot a DataFrame from wide format to long format.\n4202 |         DataFrame.explode : Explode a DataFrame from list-like\n4203 |             columns to long format.\n4204 | \n4205 |         Notes\n4206 |         -----\n4207 |         This routine will explode list-likes including lists, tuples, sets,\n4208 |         Series, and np.ndarray. The result dtype of the subset rows will\n4209 |         be object. Scalars will be returned unchanged, and empty list-likes will\n4210 |         result in a np.nan for that row. In addition, the ordering of elements in\n4211 |         the output will be non-deterministic when exploding sets.\n4212 | \n4213 |         Reference :ref:`the user guide <reshaping.explode>` for more examples.\n4214 | \n4215 |         Examples\n4216 |         --------\n4217 |         >>> s = pd.Series([[1, 2, 3], \"foo\", [], [3, 4]])\n4218 |         >>> s\n4219 |         0    [1, 2, 3]\n4220 |         1          foo\n4221 |         2           []\n4222 |         3       [3, 4]\n4223 |         dtype: object\n4224 | \n4225 |         >>> s.explode()\n4226 |         0      1\n4227 |         0      2\n4228 |         0      3\n4229 |         1    foo\n4230 |         2    NaN\n4231 |         3      3\n4232 |         3      4\n4233 |         dtype: object\n4234 |         \"\"\"\n4235 |         if isinstance(self.dtype, ExtensionDtype):\n4236 |             values, counts = self._values._explode()\n4237 |         elif len(self) and is_object_dtype(self.dtype):\n4238 |             values, counts = reshape.explode(np.asarray(self._values))\n4239 |         else:\n4240 |             result = self.copy()\n4241 |             return result.reset_index(drop=True) if ignore_index else result\n4242 | \n4243 |         if ignore_index:\n4244 |             index: Index = default_index(len(values))\n4245 |         else:\n4246 |             index = self.index.repeat(counts)\n4247 | \n4248 |         return self._constructor(values, index=index, name=self.name, copy=False)\n4249 | \n4250 |     def unstack(\n4251 |         self,\n4252 |         level: IndexLabel = -1,\n4253 |         fill_value: Hashable | None = None,\n4254 |         sort: bool = True,\n4255 |     ) -> DataFrame:\n4256 |         \"\"\"\n4257 |         Unstack, also known as pivot, Series with MultiIndex to produce DataFrame.\n4258 | \n4259 |         Parameters\n4260 |         ----------\n4261 |         level : int, str, or list of these, default last level\n4262 |             Level(s) to unstack, can pass level name.\n4263 |         fill_value : scalar value, default None\n4264 |             Value to use when replacing NaN values.\n4265 |         sort : bool, default True\n4266 |             Sort the level(s) in the resulting MultiIndex columns.\n4267 | \n4268 |         Returns\n4269 |         -------\n4270 |         DataFrame\n4271 |             Unstacked Series.\n4272 | \n4273 |         See Also\n4274 |         --------\n4275 |         DataFrame.unstack : Pivot the MultiIndex of a DataFrame.\n4276 | \n4277 |         Notes\n4278 |         -----\n4279 |         Reference :ref:`the user guide <reshaping.stacking>` for more examples.\n4280 | \n4281 |         Examples\n4282 |         --------\n4283 |         >>> s = pd.Series(\n4284 |         ...     [1, 2, 3, 4],\n4285 |         ...     index=pd.MultiIndex.from_product([[\"one\", \"two\"], [\"a\", \"b\"]]),\n4286 |         ... )\n4287 |         >>> s\n4288 |         one  a    1\n4289 |              b    2\n4290 |         two  a    3\n4291 |              b    4\n4292 |         dtype: int64\n4293 | \n4294 |         >>> s.unstack(level=-1)\n4295 |              a  b\n4296 |         one  1  2\n4297 |         two  3  4\n4298 | \n4299 |         >>> s.unstack(level=0)\n4300 |            one  two\n4301 |         a    1    3\n4302 |         b    2    4\n4303 |         \"\"\"\n4304 |         from pandas.core.reshape.reshape import unstack\n4305 | \n4306 |         return unstack(self, level, fill_value, sort)\n4307 | \n4308 |     # ----------------------------------------------------------------------\n4309 |     # function application\n4310 | \n4311 |     def map(\n4312 |         self,\n4313 |         arg: Callable | Mapping | Series,\n4314 |         na_action: Literal[\"ignore\"] | None = None,\n4315 |         **kwargs,\n4316 |     ) -> Series:\n4317 |         \"\"\"\n4318 |         Map values of Series according to an input mapping or function.\n4319 | \n4320 |         Used for substituting each value in a Series with another value,\n4321 |         that may be derived from a function, a ``dict`` or\n4322 |         a :class:`Series`.\n4323 | \n4324 |         Parameters\n4325 |         ----------\n4326 |         arg : function, collections.abc.Mapping subclass or Series\n4327 |             Mapping correspondence.\n4328 |         na_action : {None, 'ignore'}, default None\n4329 |             If 'ignore', propagate NaN values, without passing them to the\n4330 |             mapping correspondence.\n4331 |         **kwargs\n4332 |             Additional keyword arguments to pass as keywords arguments to\n4333 |             `arg`.\n4334 | \n4335 |             .. versionadded:: 3.0.0\n4336 | \n4337 |         Returns\n4338 |         -------\n4339 |         Series\n4340 |             Same index as caller.\n4341 | \n4342 |         See Also\n4343 |         --------\n4344 |         Series.apply : For applying more complex functions on a Series.\n4345 |         Series.replace: Replace values given in `to_replace` with `value`.\n4346 |         DataFrame.apply : Apply a function row-/column-wise.\n4347 |         DataFrame.map : Apply a function elementwise on a whole DataFrame.\n4348 | \n4349 |         Notes\n4350 |         -----\n4351 |         When ``arg`` is a dictionary, values in Series that are not in the\n4352 |         dictionary (as keys) are converted to ``NaN``. However, if the\n4353 |         dictionary is a ``dict`` subclass that defines ``__missing__`` (i.e.\n4354 |         provides a method for default values), then this default is used\n4355 |         rather than ``NaN``.\n4356 | \n4357 |         Examples\n4358 |         --------\n4359 |         >>> s = pd.Series([\"cat\", \"dog\", np.nan, \"rabbit\"])\n4360 |         >>> s\n4361 |         0      cat\n4362 |         1      dog\n4363 |         2      NaN\n4364 |         3   rabbit\n4365 |         dtype: object\n4366 | \n4367 |         ``map`` accepts a ``dict`` or a ``Series``. Values that are not found\n4368 |         in the ``dict`` are converted to ``NaN``, unless the dict has a default\n4369 |         value (e.g. ``defaultdict``):\n4370 | \n4371 |         >>> s.map({\"cat\": \"kitten\", \"dog\": \"puppy\"})\n4372 |         0   kitten\n4373 |         1    puppy\n4374 |         2      NaN\n4375 |         3      NaN\n4376 |         dtype: object\n4377 | \n4378 |         It also accepts a function:\n4379 | \n4380 |         >>> s.map(\"I am a {}\".format)\n4381 |         0       I am a cat\n4382 |         1       I am a dog\n4383 |         2       I am a nan\n4384 |         3    I am a rabbit\n4385 |         dtype: object\n4386 | \n4387 |         To avoid applying the function to missing values (and keep them as\n4388 |         ``NaN``) ``na_action='ignore'`` can be used:\n4389 | \n4390 |         >>> s.map(\"I am a {}\".format, na_action=\"ignore\")\n4391 |         0     I am a cat\n4392 |         1     I am a dog\n4393 |         2            NaN\n4394 |         3  I am a rabbit\n4395 |         dtype: object\n4396 |         \"\"\"\n4397 |         if callable(arg):\n4398 |             arg = functools.partial(arg, **kwargs)\n4399 |         new_values = self._map_values(arg, na_action=na_action)\n4400 |         return self._constructor(new_values, index=self.index, copy=False).__finalize__(\n4401 |             self, method=\"map\"\n4402 |         )\n4403 | \n4404 |     def _gotitem(self, key, ndim, subset=None) -> Self:\n4405 |         \"\"\"\n4406 |         Sub-classes to define. Return a sliced object.\n4407 | \n4408 |         Parameters\n4409 |         ----------\n4410 |         key : string / list of selections\n4411 |         ndim : {1, 2}\n4412 |             Requested ndim of result.\n4413 |         subset : object, default None\n4414 |             Subset to act on.\n4415 |         \"\"\"\n4416 |         return self\n4417 | \n4418 |     _agg_see_also_doc = dedent(\n4419 |         \"\"\"\n4420 |     See Also\n4421 |     --------\n4422 |     Series.apply : Invoke function on a Series.\n4423 |     Series.transform : Transform function producing a Series with like indexes.\n4424 |     \"\"\"\n4425 |     )\n4426 | \n4427 |     _agg_examples_doc = dedent(\n4428 |         \"\"\"\n4429 |     Examples\n4430 |     --------\n4431 |     >>> s = pd.Series([1, 2, 3, 4])\n4432 |     >>> s\n4433 |     0    1\n4434 |     1    2\n4435 |     2    3\n4436 |     3    4\n4437 |     dtype: int64\n4438 | \n4439 |     >>> s.agg('min')\n4440 |     1\n4441 | \n4442 |     >>> s.agg(['min', 'max'])\n4443 |     min   1\n4444 |     max   4\n4445 |     dtype: int64\n4446 |     \"\"\"\n4447 |     )\n4448 | \n4449 |     @doc(\n4450 |         _shared_docs[\"aggregate\"],\n4451 |         klass=_shared_doc_kwargs[\"klass\"],\n4452 |         axis=_shared_doc_kwargs[\"axis\"],\n4453 |         see_also=_agg_see_also_doc,\n4454 |         examples=_agg_examples_doc,\n4455 |     )\n4456 |     def aggregate(self, func=None, axis: Axis = 0, *args, **kwargs):\n4457 |         # Validate the axis parameter\n4458 |         self._get_axis_number(axis)\n4459 | \n4460 |         # if func is None, will switch to user-provided \"named aggregation\" kwargs\n4461 |         if func is None:\n4462 |             func = dict(kwargs.items())\n4463 | \n4464 |         op = SeriesApply(self, func, args=args, kwargs=kwargs)\n4465 |         result = op.agg()\n4466 |         return result\n4467 | \n4468 |     agg = aggregate\n4469 | \n4470 |     @doc(\n4471 |         _shared_docs[\"transform\"],\n4472 |         klass=_shared_doc_kwargs[\"klass\"],\n4473 |         axis=_shared_doc_kwargs[\"axis\"],\n4474 |     )\n4475 |     def transform(\n4476 |         self, func: AggFuncType, axis: Axis = 0, *args, **kwargs\n4477 |     ) -> DataFrame | Series:\n4478 |         # Validate axis argument\n4479 |         self._get_axis_number(axis)\n4480 |         ser = self.copy(deep=False)\n4481 |         result = SeriesApply(ser, func=func, args=args, kwargs=kwargs).transform()\n4482 |         return result\n4483 | \n4484 |     def apply(\n4485 |         self,\n4486 |         func: AggFuncType,\n4487 |         args: tuple[Any, ...] = (),\n4488 |         *,\n4489 |         by_row: Literal[False, \"compat\"] = \"compat\",\n4490 |         **kwargs,\n4491 |     ) -> DataFrame | Series:\n4492 |         \"\"\"\n4493 |         Invoke function on values of Series.\n4494 | \n4495 |         Can be ufunc (a NumPy function that applies to the entire Series)\n4496 |         or a Python function that only works on single values.\n4497 | \n4498 |         Parameters\n4499 |         ----------\n4500 |         func : function\n4501 |             Python function or NumPy ufunc to apply.\n4502 |         args : tuple\n4503 |             Positional arguments passed to func after the series value.\n4504 |         by_row : False or \"compat\", default \"compat\"\n4505 |             If ``\"compat\"`` and func is a callable, func will be passed each element of\n4506 |             the Series, like ``Series.map``. If func is a list or dict of\n4507 |             callables, will first try to translate each func into pandas methods. If\n4508 |             that doesn't work, will try call to apply again with ``by_row=\"compat\"``\n4509 |             and if that fails, will call apply again with ``by_row=False``\n4510 |             (backward compatible).\n4511 |             If False, the func will be passed the whole Series at once.\n4512 | \n4513 |             ``by_row`` has no effect when ``func`` is a string.\n4514 | \n4515 |             .. versionadded:: 2.1.0\n4516 |         **kwargs\n4517 |             Additional keyword arguments passed to func.\n4518 | \n4519 |         Returns\n4520 |         -------\n4521 |         Series or DataFrame\n4522 |             If func returns a Series object the result will be a DataFrame.\n4523 | \n4524 |         See Also\n4525 |         --------\n4526 |         Series.map: For element-wise operations.\n4527 |         Series.agg: Only perform aggregating type operations.\n4528 |         Series.transform: Only perform transforming type operations.\n4529 | \n4530 |         Notes\n4531 |         -----\n4532 |         Functions that mutate the passed object can produce unexpected\n4533 |         behavior or errors and are not supported. See :ref:`gotchas.udf-mutation`\n4534 |         for more details.\n4535 | \n4536 |         Examples\n4537 |         --------\n4538 |         Create a series with typical summer temperatures for each city.\n4539 | \n4540 |         >>> s = pd.Series([20, 21, 12], index=[\"London\", \"New York\", \"Helsinki\"])\n4541 |         >>> s\n4542 |         London      20\n4543 |         New York    21\n4544 |         Helsinki    12\n4545 |         dtype: int64\n4546 | \n4547 |         Square the values by defining a function and passing it as an\n4548 |         argument to ``apply()``.\n4549 | \n4550 |         >>> def square(x):\n4551 |         ...     return x**2\n4552 |         >>> s.apply(square)\n4553 |         London      400\n4554 |         New York    441\n4555 |         Helsinki    144\n4556 |         dtype: int64\n4557 | \n4558 |         Square the values by passing an anonymous function as an\n4559 |         argument to ``apply()``.\n4560 | \n4561 |         >>> s.apply(lambda x: x**2)\n4562 |         London      400\n4563 |         New York    441\n4564 |         Helsinki    144\n4565 |         dtype: int64\n4566 | \n4567 |         Define a custom function that needs additional positional\n4568 |         arguments and pass these additional arguments using the\n4569 |         ``args`` keyword.\n4570 | \n4571 |         >>> def subtract_custom_value(x, custom_value):\n4572 |         ...     return x - custom_value\n4573 | \n4574 |         >>> s.apply(subtract_custom_value, args=(5,))\n4575 |         London      15\n4576 |         New York    16\n4577 |         Helsinki     7\n4578 |         dtype: int64\n4579 | \n4580 |         Define a custom function that takes keyword arguments\n4581 |         and pass these arguments to ``apply``.\n4582 | \n4583 |         >>> def add_custom_values(x, **kwargs):\n4584 |         ...     for month in kwargs:\n4585 |         ...         x += kwargs[month]\n4586 |         ...     return x\n4587 | \n4588 |         >>> s.apply(add_custom_values, june=30, july=20, august=25)\n4589 |         London      95\n4590 |         New York    96\n4591 |         Helsinki    87\n4592 |         dtype: int64\n4593 | \n4594 |         Use a function from the Numpy library.\n4595 | \n4596 |         >>> s.apply(np.log)\n4597 |         London      2.995732\n4598 |         New York    3.044522\n4599 |         Helsinki    2.484907\n4600 |         dtype: float64\n4601 |         \"\"\"\n4602 |         return SeriesApply(\n4603 |             self,\n4604 |             func,\n4605 |             by_row=by_row,\n4606 |             args=args,\n4607 |             kwargs=kwargs,\n4608 |         ).apply()\n4609 | \n4610 |     def _reindex_indexer(\n4611 |         self,\n4612 |         new_index: Index | None,\n4613 |         indexer: npt.NDArray[np.intp] | None,\n4614 |     ) -> Series:\n4615 |         # Note: new_index is None iff indexer is None\n4616 |         # if not None, indexer is np.intp\n4617 |         if indexer is None and (\n4618 |             new_index is None or new_index.names == self.index.names\n4619 |         ):\n4620 |             return self.copy(deep=False)\n4621 | \n4622 |         new_values = algorithms.take_nd(\n4623 |             self._values, indexer, allow_fill=True, fill_value=None\n4624 |         )\n4625 |         return self._constructor(new_values, index=new_index, copy=False)\n4626 | \n4627 |     def _needs_reindex_multi(self, axes, method, level) -> bool:\n4628 |         \"\"\"\n4629 |         Check if we do need a multi reindex; this is for compat with\n4630 |         higher dims.\n4631 |         \"\"\"\n4632 |         return False\n4633 | \n4634 |     @overload\n4635 |     def rename(\n4636 |         self,\n4637 |         index: Renamer | Hashable | None = ...,\n4638 |         *,\n4639 |         axis: Axis | None = ...,\n4640 |         copy: bool | lib.NoDefault = ...,\n4641 |         inplace: Literal[True],\n4642 |         level: Level | None = ...,\n4643 |         errors: IgnoreRaise = ...,\n4644 |     ) -> None: ...\n4645 | \n4646 |     @overload\n4647 |     def rename(\n4648 |         self,\n4649 |         index: Renamer | Hashable | None = ...,\n4650 |         *,\n4651 |         axis: Axis | None = ...,\n4652 |         copy: bool | lib.NoDefault = ...,\n4653 |         inplace: Literal[False] = ...,\n4654 |         level: Level | None = ...,\n4655 |         errors: IgnoreRaise = ...,\n4656 |     ) -> Series: ...\n4657 | \n4658 |     @overload\n4659 |     def rename(\n4660 |         self,\n4661 |         index: Renamer | Hashable | None = ...,\n4662 |         *,\n4663 |         axis: Axis | None = ...,\n4664 |         copy: bool | lib.NoDefault = ...,\n4665 |         inplace: bool = ...,\n4666 |         level: Level | None = ...,\n4667 |         errors: IgnoreRaise = ...,\n4668 |     ) -> Series | None: ...\n4669 | \n4670 |     def rename(\n4671 |         self,\n4672 |         index: Renamer | Hashable | None = None,\n4673 |         *,\n4674 |         axis: Axis | None = None,\n4675 |         copy: bool | lib.NoDefault = lib.no_default,\n4676 |         inplace: bool = False,\n4677 |         level: Level | None = None,\n4678 |         errors: IgnoreRaise = \"ignore\",\n4679 |     ) -> Series | None:\n4680 |         \"\"\"\n4681 |         Alter Series index labels or name.\n4682 | \n4683 |         Function / dict values must be unique (1-to-1). Labels not contained in\n4684 |         a dict / Series will be left as-is. Extra labels listed don't throw an\n4685 |         error.\n4686 | \n4687 |         Alternatively, change ``Series.name`` with a scalar value.\n4688 | \n4689 |         See the :ref:`user guide <basics.rename>` for more.\n4690 | \n4691 |         Parameters\n4692 |         ----------\n4693 |         index : scalar, hashable sequence, dict-like or function optional\n4694 |             Functions or dict-like are transformations to apply to\n4695 |             the index.\n4696 |             Scalar or hashable sequence-like will alter the ``Series.name``\n4697 |             attribute.\n4698 |         axis : {0 or 'index'}\n4699 |             Unused. Parameter needed for compatibility with DataFrame.\n4700 |         copy : bool, default False\n4701 |             Also copy underlying data.\n4702 | \n4703 |             .. note::\n4704 |                 The `copy` keyword will change behavior in pandas 3.0.\n4705 |                 `Copy-on-Write\n4706 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n4707 |                 will be enabled by default, which means that all methods with a\n4708 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n4709 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n4710 |                 future version of pandas.\n4711 | \n4712 |                 You can already get the future behavior and improvements through\n4713 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n4714 | \n4715 |             .. deprecated:: 3.0.0\n4716 |         inplace : bool, default False\n4717 |             Whether to return a new Series. If True the value of copy is ignored.\n4718 |         level : int or level name, default None\n4719 |             In case of MultiIndex, only rename labels in the specified level.\n4720 |         errors : {'ignore', 'raise'}, default 'ignore'\n4721 |             If 'raise', raise `KeyError` when a `dict-like mapper` or\n4722 |             `index` contains labels that are not present in the index being transformed.\n4723 |             If 'ignore', existing keys will be renamed and extra keys will be ignored.\n4724 | \n4725 |         Returns\n4726 |         -------\n4727 |         Series or None\n4728 |             Series with index labels or name altered or None if ``inplace=True``.\n4729 | \n4730 |         See Also\n4731 |         --------\n4732 |         DataFrame.rename : Corresponding DataFrame method.\n4733 |         Series.rename_axis : Set the name of the axis.\n4734 | \n4735 |         Examples\n4736 |         --------\n4737 |         >>> s = pd.Series([1, 2, 3])\n4738 |         >>> s\n4739 |         0    1\n4740 |         1    2\n4741 |         2    3\n4742 |         dtype: int64\n4743 |         >>> s.rename(\"my_name\")  # scalar, changes Series.name\n4744 |         0    1\n4745 |         1    2\n4746 |         2    3\n4747 |         Name: my_name, dtype: int64\n4748 |         >>> s.rename(lambda x: x**2)  # function, changes labels\n4749 |         0    1\n4750 |         1    2\n4751 |         4    3\n4752 |         dtype: int64\n4753 |         >>> s.rename({1: 3, 2: 5})  # mapping, changes labels\n4754 |         0    1\n4755 |         3    2\n4756 |         5    3\n4757 |         dtype: int64\n4758 |         \"\"\"\n4759 |         self._check_copy_deprecation(copy)\n4760 |         if axis is not None:\n4761 |             # Make sure we raise if an invalid 'axis' is passed.\n4762 |             axis = self._get_axis_number(axis)\n4763 | \n4764 |         if callable(index) or is_dict_like(index):\n4765 |             # error: Argument 1 to \"_rename\" of \"NDFrame\" has incompatible\n4766 |             # type \"Union[Union[Mapping[Any, Hashable], Callable[[Any],\n4767 |             # Hashable]], Hashable, None]\"; expected \"Union[Mapping[Any,\n4768 |             # Hashable], Callable[[Any], Hashable], None]\"\n4769 |             return super()._rename(\n4770 |                 index,  # type: ignore[arg-type]\n4771 |                 inplace=inplace,\n4772 |                 level=level,\n4773 |                 errors=errors,\n4774 |             )\n4775 |         else:\n4776 |             return self._set_name(index, inplace=inplace)\n4777 | \n4778 |     @Appender(\n4779 |         \"\"\"\n4780 |         Examples\n4781 |         --------\n4782 |         >>> s = pd.Series([1, 2, 3])\n4783 |         >>> s\n4784 |         0    1\n4785 |         1    2\n4786 |         2    3\n4787 |         dtype: int64\n4788 | \n4789 |         >>> s.set_axis(['a', 'b', 'c'], axis=0)\n4790 |         a    1\n4791 |         b    2\n4792 |         c    3\n4793 |         dtype: int64\n4794 |     \"\"\"\n4795 |     )\n4796 |     @Substitution(\n4797 |         klass=_shared_doc_kwargs[\"klass\"],\n4798 |         axes_single_arg=_shared_doc_kwargs[\"axes_single_arg\"],\n4799 |         extended_summary_sub=\"\",\n4800 |         axis_description_sub=\"\",\n4801 |         see_also_sub=\"\",\n4802 |     )\n4803 |     @Appender(NDFrame.set_axis.__doc__)\n4804 |     def set_axis(\n4805 |         self,\n4806 |         labels,\n4807 |         *,\n4808 |         axis: Axis = 0,\n4809 |         copy: bool | lib.NoDefault = lib.no_default,\n4810 |     ) -> Series:\n4811 |         return super().set_axis(labels, axis=axis, copy=copy)\n4812 | \n4813 |     # error: Cannot determine type of 'reindex'\n4814 |     @doc(\n4815 |         NDFrame.reindex,  # type: ignore[has-type]\n4816 |         klass=_shared_doc_kwargs[\"klass\"],\n4817 |         optional_reindex=_shared_doc_kwargs[\"optional_reindex\"],\n4818 |     )\n4819 |     def reindex(  # type: ignore[override]\n4820 |         self,\n4821 |         index=None,\n4822 |         *,\n4823 |         axis: Axis | None = None,\n4824 |         method: ReindexMethod | None = None,\n4825 |         copy: bool | lib.NoDefault = lib.no_default,\n4826 |         level: Level | None = None,\n4827 |         fill_value: Scalar | None = None,\n4828 |         limit: int | None = None,\n4829 |         tolerance=None,\n4830 |     ) -> Series:\n4831 |         return super().reindex(\n4832 |             index=index,\n4833 |             method=method,\n4834 |             level=level,\n4835 |             fill_value=fill_value,\n4836 |             limit=limit,\n4837 |             tolerance=tolerance,\n4838 |             copy=copy,\n4839 |         )\n4840 | \n4841 |     @overload  # type: ignore[override]\n4842 |     def rename_axis(\n4843 |         self,\n4844 |         mapper: IndexLabel | lib.NoDefault = ...,\n4845 |         *,\n4846 |         index=...,\n4847 |         axis: Axis = ...,\n4848 |         copy: bool | lib.NoDefault = ...,\n4849 |         inplace: Literal[True],\n4850 |     ) -> None: ...\n4851 | \n4852 |     @overload\n4853 |     def rename_axis(\n4854 |         self,\n4855 |         mapper: IndexLabel | lib.NoDefault = ...,\n4856 |         *,\n4857 |         index=...,\n4858 |         axis: Axis = ...,\n4859 |         copy: bool | lib.NoDefault = ...,\n4860 |         inplace: Literal[False] = ...,\n4861 |     ) -> Self: ...\n4862 | \n4863 |     @overload\n4864 |     def rename_axis(\n4865 |         self,\n4866 |         mapper: IndexLabel | lib.NoDefault = ...,\n4867 |         *,\n4868 |         index=...,\n4869 |         axis: Axis = ...,\n4870 |         copy: bool | lib.NoDefault = ...,\n4871 |         inplace: bool = ...,\n4872 |     ) -> Self | None: ...\n4873 | \n4874 |     def rename_axis(\n4875 |         self,\n4876 |         mapper: IndexLabel | lib.NoDefault = lib.no_default,\n4877 |         *,\n4878 |         index=lib.no_default,\n4879 |         axis: Axis = 0,\n4880 |         copy: bool | lib.NoDefault = lib.no_default,\n4881 |         inplace: bool = False,\n4882 |     ) -> Self | None:\n4883 |         \"\"\"\n4884 |         Set the name of the axis for the index.\n4885 | \n4886 |         Parameters\n4887 |         ----------\n4888 |         mapper : scalar, list-like, optional\n4889 |             Value to set the axis name attribute.\n4890 | \n4891 |             Use either ``mapper`` and ``axis`` to\n4892 |             specify the axis to target with ``mapper``, or ``index``.\n4893 | \n4894 |         index : scalar, list-like, dict-like or function, optional\n4895 |             A scalar, list-like, dict-like or functions transformations to\n4896 |             apply to that axis' values.\n4897 |         axis : {0 or 'index'}, default 0\n4898 |             The axis to rename. For `Series` this parameter is unused and defaults to 0.\n4899 |         copy : bool, default False\n4900 |             Also copy underlying data.\n4901 | \n4902 |             .. note::\n4903 |                 The `copy` keyword will change behavior in pandas 3.0.\n4904 |                 `Copy-on-Write\n4905 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n4906 |                 will be enabled by default, which means that all methods with a\n4907 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n4908 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n4909 |                 future version of pandas.\n4910 | \n4911 |                 You can already get the future behavior and improvements through\n4912 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n4913 |         inplace : bool, default False\n4914 |             Modifies the object directly, instead of creating a new Series\n4915 |             or DataFrame.\n4916 | \n4917 |         Returns\n4918 |         -------\n4919 |         Series, or None\n4920 |             The same type as the caller or None if ``inplace=True``.\n4921 | \n4922 |         See Also\n4923 |         --------\n4924 |         Series.rename : Alter Series index labels or name.\n4925 |         DataFrame.rename : Alter DataFrame index labels or name.\n4926 |         Index.rename : Set new names on index.\n4927 | \n4928 |         Examples\n4929 |         --------\n4930 | \n4931 |         >>> s = pd.Series([\"dog\", \"cat\", \"monkey\"])\n4932 |         >>> s\n4933 |         0       dog\n4934 |         1       cat\n4935 |         2    monkey\n4936 |         dtype: object\n4937 |         >>> s.rename_axis(\"animal\")\n4938 |         animal\n4939 |         0    dog\n4940 |         1    cat\n4941 |         2    monkey\n4942 |         dtype: object\n4943 |         \"\"\"\n4944 |         return super().rename_axis(\n4945 |             mapper=mapper,\n4946 |             index=index,\n4947 |             axis=axis,\n4948 |             inplace=inplace,\n4949 |             copy=copy,\n4950 |         )\n4951 | \n4952 |     @overload\n4953 |     def drop(\n4954 |         self,\n4955 |         labels: IndexLabel | ListLike = ...,\n4956 |         *,\n4957 |         axis: Axis = ...,\n4958 |         index: IndexLabel | ListLike = ...,\n4959 |         columns: IndexLabel | ListLike = ...,\n4960 |         level: Level | None = ...,\n4961 |         inplace: Literal[True],\n4962 |         errors: IgnoreRaise = ...,\n4963 |     ) -> None: ...\n4964 | \n4965 |     @overload\n4966 |     def drop(\n4967 |         self,\n4968 |         labels: IndexLabel | ListLike = ...,\n4969 |         *,\n4970 |         axis: Axis = ...,\n4971 |         index: IndexLabel | ListLike = ...,\n4972 |         columns: IndexLabel | ListLike = ...,\n4973 |         level: Level | None = ...,\n4974 |         inplace: Literal[False] = ...,\n4975 |         errors: IgnoreRaise = ...,\n4976 |     ) -> Series: ...\n4977 | \n4978 |     @overload\n4979 |     def drop(\n4980 |         self,\n4981 |         labels: IndexLabel | ListLike = ...,\n4982 |         *,\n4983 |         axis: Axis = ...,\n4984 |         index: IndexLabel | ListLike = ...,\n4985 |         columns: IndexLabel | ListLike = ...,\n4986 |         level: Level | None = ...,\n4987 |         inplace: bool = ...,\n4988 |         errors: IgnoreRaise = ...,\n4989 |     ) -> Series | None: ...\n4990 | \n4991 |     def drop(\n4992 |         self,\n4993 |         labels: IndexLabel | ListLike = None,\n4994 |         *,\n4995 |         axis: Axis = 0,\n4996 |         index: IndexLabel | ListLike = None,\n4997 |         columns: IndexLabel | ListLike = None,\n4998 |         level: Level | None = None,\n4999 |         inplace: bool = False,\n5000 |         errors: IgnoreRaise = \"raise\",\n5001 |     ) -> Series | None:\n5002 |         \"\"\"\n5003 |         Return Series with specified index labels removed.\n5004 | \n5005 |         Remove elements of a Series based on specifying the index labels.\n5006 |         When using a multi-index, labels on different levels can be removed\n5007 |         by specifying the level.\n5008 | \n5009 |         Parameters\n5010 |         ----------\n5011 |         labels : single label or list-like\n5012 |             Index labels to drop.\n5013 |         axis : {0 or 'index'}\n5014 |             Unused. Parameter needed for compatibility with DataFrame.\n5015 |         index : single label or list-like\n5016 |             Redundant for application on Series, but 'index' can be used instead\n5017 |             of 'labels'.\n5018 |         columns : single label or list-like\n5019 |             No change is made to the Series; use 'index' or 'labels' instead.\n5020 |         level : int or level name, optional\n5021 |             For MultiIndex, level for which the labels will be removed.\n5022 |         inplace : bool, default False\n5023 |             If True, do operation inplace and return None.\n5024 |         errors : {'ignore', 'raise'}, default 'raise'\n5025 |             If 'ignore', suppress error and only existing labels are dropped.\n5026 | \n5027 |         Returns\n5028 |         -------\n5029 |         Series or None\n5030 |             Series with specified index labels removed or None if ``inplace=True``.\n5031 | \n5032 |         Raises\n5033 |         ------\n5034 |         KeyError\n5035 |             If none of the labels are found in the index.\n5036 | \n5037 |         See Also\n5038 |         --------\n5039 |         Series.reindex : Return only specified index labels of Series.\n5040 |         Series.dropna : Return series without null values.\n5041 |         Series.drop_duplicates : Return Series with duplicate values removed.\n5042 |         DataFrame.drop : Drop specified labels from rows or columns.\n5043 | \n5044 |         Examples\n5045 |         --------\n5046 |         >>> s = pd.Series(data=np.arange(3), index=[\"A\", \"B\", \"C\"])\n5047 |         >>> s\n5048 |         A  0\n5049 |         B  1\n5050 |         C  2\n5051 |         dtype: int64\n5052 | \n5053 |         Drop labels B and C\n5054 | \n5055 |         >>> s.drop(labels=[\"B\", \"C\"])\n5056 |         A  0\n5057 |         dtype: int64\n5058 | \n5059 |         Drop 2nd level label in MultiIndex Series\n5060 | \n5061 |         >>> midx = pd.MultiIndex(\n5062 |         ...     levels=[[\"llama\", \"cow\", \"falcon\"], [\"speed\", \"weight\", \"length\"]],\n5063 |         ...     codes=[[0, 0, 0, 1, 1, 1, 2, 2, 2], [0, 1, 2, 0, 1, 2, 0, 1, 2]],\n5064 |         ... )\n5065 |         >>> s = pd.Series([45, 200, 1.2, 30, 250, 1.5, 320, 1, 0.3], index=midx)\n5066 |         >>> s\n5067 |         llama   speed      45.0\n5068 |                 weight    200.0\n5069 |                 length      1.2\n5070 |         cow     speed      30.0\n5071 |                 weight    250.0\n5072 |                 length      1.5\n5073 |         falcon  speed     320.0\n5074 |                 weight      1.0\n5075 |                 length      0.3\n5076 |         dtype: float64\n5077 | \n5078 |         >>> s.drop(labels=\"weight\", level=1)\n5079 |         llama   speed      45.0\n5080 |                 length      1.2\n5081 |         cow     speed      30.0\n5082 |                 length      1.5\n5083 |         falcon  speed     320.0\n5084 |                 length      0.3\n5085 |         dtype: float64\n5086 |         \"\"\"\n5087 |         return super().drop(\n5088 |             labels=labels,\n5089 |             axis=axis,\n5090 |             index=index,\n5091 |             columns=columns,\n5092 |             level=level,\n5093 |             inplace=inplace,\n5094 |             errors=errors,\n5095 |         )\n5096 | \n5097 |     def pop(self, item: Hashable) -> Any:\n5098 |         \"\"\"\n5099 |         Return item and drops from series. Raise KeyError if not found.\n5100 | \n5101 |         Parameters\n5102 |         ----------\n5103 |         item : label\n5104 |             Index of the element that needs to be removed.\n5105 | \n5106 |         Returns\n5107 |         -------\n5108 |         scalar\n5109 |             Value that is popped from series.\n5110 | \n5111 |         See Also\n5112 |         --------\n5113 |         Series.drop: Drop specified values from Series.\n5114 |         Series.drop_duplicates: Return Series with duplicate values removed.\n5115 | \n5116 |         Examples\n5117 |         --------\n5118 |         >>> ser = pd.Series([1, 2, 3])\n5119 | \n5120 |         >>> ser.pop(0)\n5121 |         1\n5122 | \n5123 |         >>> ser\n5124 |         1    2\n5125 |         2    3\n5126 |         dtype: int64\n5127 |         \"\"\"\n5128 |         return super().pop(item=item)\n5129 | \n5130 |     @doc(INFO_DOCSTRING, **series_sub_kwargs)\n5131 |     def info(\n5132 |         self,\n5133 |         verbose: bool | None = None,\n5134 |         buf: IO[str] | None = None,\n5135 |         max_cols: int | None = None,\n5136 |         memory_usage: bool | str | None = None,\n5137 |         show_counts: bool = True,\n5138 |     ) -> None:\n5139 |         return SeriesInfo(self, memory_usage).render(\n5140 |             buf=buf,\n5141 |             max_cols=max_cols,\n5142 |             verbose=verbose,\n5143 |             show_counts=show_counts,\n5144 |         )\n5145 | \n5146 |     def memory_usage(self, index: bool = True, deep: bool = False) -> int:\n5147 |         \"\"\"\n5148 |         Return the memory usage of the Series.\n5149 | \n5150 |         The memory usage can optionally include the contribution of\n5151 |         the index and of elements of `object` dtype.\n5152 | \n5153 |         Parameters\n5154 |         ----------\n5155 |         index : bool, default True\n5156 |             Specifies whether to include the memory usage of the Series index.\n5157 |         deep : bool, default False\n5158 |             If True, introspect the data deeply by interrogating\n5159 |             `object` dtypes for system-level memory consumption, and include\n5160 |             it in the returned value.\n5161 | \n5162 |         Returns\n5163 |         -------\n5164 |         int\n5165 |             Bytes of memory consumed.\n5166 | \n5167 |         See Also\n5168 |         --------\n5169 |         numpy.ndarray.nbytes : Total bytes consumed by the elements of the\n5170 |             array.\n5171 |         DataFrame.memory_usage : Bytes consumed by a DataFrame.\n5172 | \n5173 |         Examples\n5174 |         --------\n5175 |         >>> s = pd.Series(range(3))\n5176 |         >>> s.memory_usage()\n5177 |         152\n5178 | \n5179 |         Not including the index gives the size of the rest of the data, which\n5180 |         is necessarily smaller:\n5181 | \n5182 |         >>> s.memory_usage(index=False)\n5183 |         24\n5184 | \n5185 |         The memory footprint of `object` values is ignored by default:\n5186 | \n5187 |         >>> s = pd.Series([\"a\", \"b\"])\n5188 |         >>> s.values\n5189 |         array(['a', 'b'], dtype=object)\n5190 |         >>> s.memory_usage()\n5191 |         144\n5192 |         >>> s.memory_usage(deep=True)\n5193 |         244\n5194 |         \"\"\"\n5195 |         v = self._memory_usage(deep=deep)\n5196 |         if index:\n5197 |             v += self.index.memory_usage(deep=deep)\n5198 |         return v\n5199 | \n5200 |     def isin(self, values) -> Series:\n5201 |         \"\"\"\n5202 |         Whether elements in Series are contained in `values`.\n5203 | \n5204 |         Return a boolean Series showing whether each element in the Series\n5205 |         matches an element in the passed sequence of `values` exactly.\n5206 | \n5207 |         Parameters\n5208 |         ----------\n5209 |         values : set or list-like\n5210 |             The sequence of values to test. Passing in a single string will\n5211 |             raise a ``TypeError``. Instead, turn a single string into a\n5212 |             list of one element.\n5213 | \n5214 |         Returns\n5215 |         -------\n5216 |         Series\n5217 |             Series of booleans indicating if each element is in values.\n5218 | \n5219 |         Raises\n5220 |         ------\n5221 |         TypeError\n5222 |           * If `values` is a string\n5223 | \n5224 |         See Also\n5225 |         --------\n5226 |         DataFrame.isin : Equivalent method on DataFrame.\n5227 | \n5228 |         Examples\n5229 |         --------\n5230 |         >>> s = pd.Series(\n5231 |         ...     [\"llama\", \"cow\", \"llama\", \"beetle\", \"llama\", \"hippo\"], name=\"animal\"\n5232 |         ... )\n5233 |         >>> s.isin([\"cow\", \"llama\"])\n5234 |         0     True\n5235 |         1     True\n5236 |         2     True\n5237 |         3    False\n5238 |         4     True\n5239 |         5    False\n5240 |         Name: animal, dtype: bool\n5241 | \n5242 |         To invert the boolean values, use the ``~`` operator:\n5243 | \n5244 |         >>> ~s.isin([\"cow\", \"llama\"])\n5245 |         0    False\n5246 |         1    False\n5247 |         2    False\n5248 |         3     True\n5249 |         4    False\n5250 |         5     True\n5251 |         Name: animal, dtype: bool\n5252 | \n5253 |         Passing a single string as ``s.isin('llama')`` will raise an error. Use\n5254 |         a list of one element instead:\n5255 | \n5256 |         >>> s.isin([\"llama\"])\n5257 |         0     True\n5258 |         1    False\n5259 |         2     True\n5260 |         3    False\n5261 |         4     True\n5262 |         5    False\n5263 |         Name: animal, dtype: bool\n5264 | \n5265 |         Strings and integers are distinct and are therefore not comparable:\n5266 | \n5267 |         >>> pd.Series([1]).isin([\"1\"])\n5268 |         0    False\n5269 |         dtype: bool\n5270 |         >>> pd.Series([1.1]).isin([\"1.1\"])\n5271 |         0    False\n5272 |         dtype: bool\n5273 |         \"\"\"\n5274 |         result = algorithms.isin(self._values, values)\n5275 |         return self._constructor(result, index=self.index, copy=False).__finalize__(\n5276 |             self, method=\"isin\"\n5277 |         )\n5278 | \n5279 |     def between(\n5280 |         self,\n5281 |         left,\n5282 |         right,\n5283 |         inclusive: Literal[\"both\", \"neither\", \"left\", \"right\"] = \"both\",\n5284 |     ) -> Series:\n5285 |         \"\"\"\n5286 |         Return boolean Series equivalent to left <= series <= right.\n5287 | \n5288 |         This function returns a boolean vector containing `True` wherever the\n5289 |         corresponding Series element is between the boundary values `left` and\n5290 |         `right`. NA values are treated as `False`.\n5291 | \n5292 |         Parameters\n5293 |         ----------\n5294 |         left : scalar or list-like\n5295 |             Left boundary.\n5296 |         right : scalar or list-like\n5297 |             Right boundary.\n5298 |         inclusive : {\"both\", \"neither\", \"left\", \"right\"}\n5299 |             Include boundaries. Whether to set each bound as closed or open.\n5300 | \n5301 |             .. versionchanged:: 1.3.0\n5302 | \n5303 |         Returns\n5304 |         -------\n5305 |         Series\n5306 |             Series representing whether each element is between left and\n5307 |             right (inclusive).\n5308 | \n5309 |         See Also\n5310 |         --------\n5311 |         Series.gt : Greater than of series and other.\n5312 |         Series.lt : Less than of series and other.\n5313 | \n5314 |         Notes\n5315 |         -----\n5316 |         This function is equivalent to ``(left <= ser) & (ser <= right)``\n5317 | \n5318 |         Examples\n5319 |         --------\n5320 |         >>> s = pd.Series([2, 0, 4, 8, np.nan])\n5321 | \n5322 |         Boundary values are included by default:\n5323 | \n5324 |         >>> s.between(1, 4)\n5325 |         0     True\n5326 |         1    False\n5327 |         2     True\n5328 |         3    False\n5329 |         4    False\n5330 |         dtype: bool\n5331 | \n5332 |         With `inclusive` set to ``\"neither\"`` boundary values are excluded:\n5333 | \n5334 |         >>> s.between(1, 4, inclusive=\"neither\")\n5335 |         0     True\n5336 |         1    False\n5337 |         2    False\n5338 |         3    False\n5339 |         4    False\n5340 |         dtype: bool\n5341 | \n5342 |         `left` and `right` can be any scalar value:\n5343 | \n5344 |         >>> s = pd.Series([\"Alice\", \"Bob\", \"Carol\", \"Eve\"])\n5345 |         >>> s.between(\"Anna\", \"Daniel\")\n5346 |         0    False\n5347 |         1     True\n5348 |         2     True\n5349 |         3    False\n5350 |         dtype: bool\n5351 |         \"\"\"\n5352 |         if inclusive == \"both\":\n5353 |             lmask = self >= left\n5354 |             rmask = self <= right\n5355 |         elif inclusive == \"left\":\n5356 |             lmask = self >= left\n5357 |             rmask = self < right\n5358 |         elif inclusive == \"right\":\n5359 |             lmask = self > left\n5360 |             rmask = self <= right\n5361 |         elif inclusive == \"neither\":\n5362 |             lmask = self > left\n5363 |             rmask = self < right\n5364 |         else:\n5365 |             raise ValueError(\n5366 |                 \"Inclusive has to be either string of 'both',\"\n5367 |                 \"'left', 'right', or 'neither'.\"\n5368 |             )\n5369 | \n5370 |         return lmask & rmask\n5371 | \n5372 |     def case_when(\n5373 |         self,\n5374 |         caselist: list[\n5375 |             tuple[\n5376 |                 ArrayLike | Callable[[Series], Series | np.ndarray | Sequence[bool]],\n5377 |                 ArrayLike | Scalar | Callable[[Series], Series | np.ndarray],\n5378 |             ],\n5379 |         ],\n5380 |     ) -> Series:\n5381 |         \"\"\"\n5382 |         Replace values where the conditions are True.\n5383 | \n5384 |         .. versionadded:: 2.2.0\n5385 | \n5386 |         Parameters\n5387 |         ----------\n5388 |         caselist : A list of tuples of conditions and expected replacements\n5389 |             Takes the form:  ``(condition0, replacement0)``,\n5390 |             ``(condition1, replacement1)``, ... .\n5391 |             ``condition`` should be a 1-D boolean array-like object\n5392 |             or a callable. If ``condition`` is a callable,\n5393 |             it is computed on the Series\n5394 |             and should return a boolean Series or array.\n5395 |             The callable must not change the input Series\n5396 |             (though pandas doesn`t check it). ``replacement`` should be a\n5397 |             1-D array-like object, a scalar or a callable.\n5398 |             If ``replacement`` is a callable, it is computed on the Series\n5399 |             and should return a scalar or Series. The callable\n5400 |             must not change the input Series\n5401 |             (though pandas doesn`t check it).\n5402 | \n5403 |         Returns\n5404 |         -------\n5405 |         Series\n5406 |             A new Series with values replaced based on the provided conditions.\n5407 | \n5408 |         See Also\n5409 |         --------\n5410 |         Series.mask : Replace values where the condition is True.\n5411 | \n5412 |         Examples\n5413 |         --------\n5414 |         >>> c = pd.Series([6, 7, 8, 9], name=\"c\")\n5415 |         >>> a = pd.Series([0, 0, 1, 2])\n5416 |         >>> b = pd.Series([0, 3, 4, 5])\n5417 | \n5418 |         >>> c.case_when(\n5419 |         ...     caselist=[\n5420 |         ...         (a.gt(0), a),  # condition, replacement\n5421 |         ...         (b.gt(0), b),\n5422 |         ...     ]\n5423 |         ... )\n5424 |         0    6\n5425 |         1    3\n5426 |         2    1\n5427 |         3    2\n5428 |         Name: c, dtype: int64\n5429 |         \"\"\"\n5430 |         if not isinstance(caselist, list):\n5431 |             raise TypeError(\n5432 |                 f\"The caselist argument should be a list; instead got {type(caselist)}\"\n5433 |             )\n5434 | \n5435 |         if not caselist:\n5436 |             raise ValueError(\n5437 |                 \"provide at least one boolean condition, \"\n5438 |                 \"with a corresponding replacement.\"\n5439 |             )\n5440 | \n5441 |         for num, entry in enumerate(caselist):\n5442 |             if not isinstance(entry, tuple):\n5443 |                 raise TypeError(\n5444 |                     f\"Argument {num} must be a tuple; instead got {type(entry)}.\"\n5445 |                 )\n5446 |             if len(entry) != 2:\n5447 |                 raise ValueError(\n5448 |                     f\"Argument {num} must have length 2; \"\n5449 |                     \"a condition and replacement; \"\n5450 |                     f\"instead got length {len(entry)}.\"\n5451 |                 )\n5452 |         caselist = [\n5453 |             (\n5454 |                 com.apply_if_callable(condition, self),\n5455 |                 com.apply_if_callable(replacement, self),\n5456 |             )\n5457 |             for condition, replacement in caselist\n5458 |         ]\n5459 |         default = self.copy(deep=False)\n5460 |         conditions, replacements = zip(*caselist)\n5461 |         common_dtypes = [infer_dtype_from(arg)[0] for arg in [*replacements, default]]\n5462 |         if len(set(common_dtypes)) > 1:\n5463 |             common_dtype = find_common_type(common_dtypes)\n5464 |             updated_replacements = []\n5465 |             for condition, replacement in zip(conditions, replacements):\n5466 |                 if is_scalar(replacement):\n5467 |                     replacement = construct_1d_arraylike_from_scalar(\n5468 |                         value=replacement, length=len(condition), dtype=common_dtype\n5469 |                     )\n5470 |                 elif isinstance(replacement, ABCSeries):\n5471 |                     replacement = replacement.astype(common_dtype)\n5472 |                 else:\n5473 |                     replacement = pd_array(replacement, dtype=common_dtype)\n5474 |                 updated_replacements.append(replacement)\n5475 |             replacements = updated_replacements\n5476 |             default = default.astype(common_dtype)\n5477 | \n5478 |         counter = range(len(conditions) - 1, -1, -1)\n5479 |         for position, condition, replacement in zip(\n5480 |             counter, reversed(conditions), reversed(replacements)\n5481 |         ):\n5482 |             try:\n5483 |                 default = default.mask(\n5484 |                     condition, other=replacement, axis=0, inplace=False, level=None\n5485 |                 )\n5486 |             except Exception as error:\n5487 |                 raise ValueError(\n5488 |                     f\"Failed to apply condition{position} and replacement{position}.\"\n5489 |                 ) from error\n5490 |         return default\n5491 | \n5492 |     # error: Cannot determine type of 'isna'\n5493 |     @doc(NDFrame.isna, klass=_shared_doc_kwargs[\"klass\"])  # type: ignore[has-type]\n5494 |     def isna(self) -> Series:\n5495 |         return NDFrame.isna(self)\n5496 | \n5497 |     # error: Cannot determine type of 'isna'\n5498 |     @doc(NDFrame.isna, klass=_shared_doc_kwargs[\"klass\"])  # type: ignore[has-type]\n5499 |     def isnull(self) -> Series:\n5500 |         \"\"\"\n5501 |         Series.isnull is an alias for Series.isna.\n5502 |         \"\"\"\n5503 |         return super().isnull()\n5504 | \n5505 |     # error: Cannot determine type of 'notna'\n5506 |     @doc(NDFrame.notna, klass=_shared_doc_kwargs[\"klass\"])  # type: ignore[has-type]\n5507 |     def notna(self) -> Series:\n5508 |         return super().notna()\n5509 | \n5510 |     # error: Cannot determine type of 'notna'\n5511 |     @doc(NDFrame.notna, klass=_shared_doc_kwargs[\"klass\"])  # type: ignore[has-type]\n5512 |     def notnull(self) -> Series:\n5513 |         \"\"\"\n5514 |         Series.notnull is an alias for Series.notna.\n5515 |         \"\"\"\n5516 |         return super().notnull()\n5517 | \n5518 |     @overload\n5519 |     def dropna(\n5520 |         self,\n5521 |         *,\n5522 |         axis: Axis = ...,\n5523 |         inplace: Literal[False] = ...,\n5524 |         how: AnyAll | None = ...,\n5525 |         ignore_index: bool = ...,\n5526 |     ) -> Series: ...\n5527 | \n5528 |     @overload\n5529 |     def dropna(\n5530 |         self,\n5531 |         *,\n5532 |         axis: Axis = ...,\n5533 |         inplace: Literal[True],\n5534 |         how: AnyAll | None = ...,\n5535 |         ignore_index: bool = ...,\n5536 |     ) -> None: ...\n5537 | \n5538 |     def dropna(\n5539 |         self,\n5540 |         *,\n5541 |         axis: Axis = 0,\n5542 |         inplace: bool = False,\n5543 |         how: AnyAll | None = None,\n5544 |         ignore_index: bool = False,\n5545 |     ) -> Series | None:\n5546 |         \"\"\"\n5547 |         Return a new Series with missing values removed.\n5548 | \n5549 |         See the :ref:`User Guide <missing_data>` for more on which values are\n5550 |         considered missing, and how to work with missing data.\n5551 | \n5552 |         Parameters\n5553 |         ----------\n5554 |         axis : {0 or 'index'}\n5555 |             Unused. Parameter needed for compatibility with DataFrame.\n5556 |         inplace : bool, default False\n5557 |             If True, do operation inplace and return None.\n5558 |         how : str, optional\n5559 |             Not in use. Kept for compatibility.\n5560 |         ignore_index : bool, default ``False``\n5561 |             If ``True``, the resulting axis will be labeled 0, 1, \u2026, n - 1.\n5562 | \n5563 |             .. versionadded:: 2.0.0\n5564 | \n5565 |         Returns\n5566 |         -------\n5567 |         Series or None\n5568 |             Series with NA entries dropped from it or None if ``inplace=True``.\n5569 | \n5570 |         See Also\n5571 |         --------\n5572 |         Series.isna: Indicate missing values.\n5573 |         Series.notna : Indicate existing (non-missing) values.\n5574 |         Series.fillna : Replace missing values.\n5575 |         DataFrame.dropna : Drop rows or columns which contain NA values.\n5576 |         Index.dropna : Drop missing indices.\n5577 | \n5578 |         Examples\n5579 |         --------\n5580 |         >>> ser = pd.Series([1.0, 2.0, np.nan])\n5581 |         >>> ser\n5582 |         0    1.0\n5583 |         1    2.0\n5584 |         2    NaN\n5585 |         dtype: float64\n5586 | \n5587 |         Drop NA values from a Series.\n5588 | \n5589 |         >>> ser.dropna()\n5590 |         0    1.0\n5591 |         1    2.0\n5592 |         dtype: float64\n5593 | \n5594 |         Empty strings are not considered NA values. ``None`` is considered an\n5595 |         NA value.\n5596 | \n5597 |         >>> ser = pd.Series([np.nan, 2, pd.NaT, \"\", None, \"I stay\"])\n5598 |         >>> ser\n5599 |         0       NaN\n5600 |         1         2\n5601 |         2       NaT\n5602 |         3\n5603 |         4      None\n5604 |         5    I stay\n5605 |         dtype: object\n5606 |         >>> ser.dropna()\n5607 |         1         2\n5608 |         3\n5609 |         5    I stay\n5610 |         dtype: object\n5611 |         \"\"\"\n5612 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n5613 |         ignore_index = validate_bool_kwarg(ignore_index, \"ignore_index\")\n5614 |         # Validate the axis parameter\n5615 |         self._get_axis_number(axis or 0)\n5616 | \n5617 |         if self._can_hold_na:\n5618 |             result = remove_na_arraylike(self)\n5619 |         else:\n5620 |             if not inplace:\n5621 |                 result = self.copy(deep=False)\n5622 |             else:\n5623 |                 result = self\n5624 | \n5625 |         if ignore_index:\n5626 |             result.index = default_index(len(result))\n5627 | \n5628 |         if inplace:\n5629 |             return self._update_inplace(result)\n5630 |         else:\n5631 |             return result\n5632 | \n5633 |     # ----------------------------------------------------------------------\n5634 |     # Time series-oriented methods\n5635 | \n5636 |     def to_timestamp(\n5637 |         self,\n5638 |         freq: Frequency | None = None,\n5639 |         how: Literal[\"s\", \"e\", \"start\", \"end\"] = \"start\",\n5640 |         copy: bool | lib.NoDefault = lib.no_default,\n5641 |     ) -> Series:\n5642 |         \"\"\"\n5643 |         Cast to DatetimeIndex of Timestamps, at *beginning* of period.\n5644 | \n5645 |         This can be changed to the *end* of the period, by specifying `how=\"e\"`.\n5646 | \n5647 |         Parameters\n5648 |         ----------\n5649 |         freq : str, default frequency of PeriodIndex\n5650 |             Desired frequency.\n5651 |         how : {'s', 'e', 'start', 'end'}\n5652 |             Convention for converting period to timestamp; start of period\n5653 |             vs. end.\n5654 |         copy : bool, default False\n5655 |             Whether or not to return a copy.\n5656 | \n5657 |             .. note::\n5658 |                 The `copy` keyword will change behavior in pandas 3.0.\n5659 |                 `Copy-on-Write\n5660 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n5661 |                 will be enabled by default, which means that all methods with a\n5662 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n5663 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n5664 |                 future version of pandas.\n5665 | \n5666 |                 You can already get the future behavior and improvements through\n5667 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n5668 | \n5669 |             .. deprecated:: 3.0.0\n5670 | \n5671 |         Returns\n5672 |         -------\n5673 |         Series with DatetimeIndex\n5674 |             Series with the PeriodIndex cast to DatetimeIndex.\n5675 | \n5676 |         See Also\n5677 |         --------\n5678 |         Series.to_period: Inverse method to cast DatetimeIndex to PeriodIndex.\n5679 |         DataFrame.to_timestamp: Equivalent method for DataFrame.\n5680 | \n5681 |         Examples\n5682 |         --------\n5683 |         >>> idx = pd.PeriodIndex([\"2023\", \"2024\", \"2025\"], freq=\"Y\")\n5684 |         >>> s1 = pd.Series([1, 2, 3], index=idx)\n5685 |         >>> s1\n5686 |         2023    1\n5687 |         2024    2\n5688 |         2025    3\n5689 |         Freq: Y-DEC, dtype: int64\n5690 | \n5691 |         The resulting frequency of the Timestamps is `YearBegin`\n5692 | \n5693 |         >>> s1 = s1.to_timestamp()\n5694 |         >>> s1\n5695 |         2023-01-01    1\n5696 |         2024-01-01    2\n5697 |         2025-01-01    3\n5698 |         Freq: YS-JAN, dtype: int64\n5699 | \n5700 |         Using `freq` which is the offset that the Timestamps will have\n5701 | \n5702 |         >>> s2 = pd.Series([1, 2, 3], index=idx)\n5703 |         >>> s2 = s2.to_timestamp(freq=\"M\")\n5704 |         >>> s2\n5705 |         2023-01-31    1\n5706 |         2024-01-31    2\n5707 |         2025-01-31    3\n5708 |         Freq: YE-JAN, dtype: int64\n5709 |         \"\"\"\n5710 |         self._check_copy_deprecation(copy)\n5711 |         if not isinstance(self.index, PeriodIndex):\n5712 |             raise TypeError(f\"unsupported Type {type(self.index).__name__}\")\n5713 | \n5714 |         new_obj = self.copy(deep=False)\n5715 |         new_index = self.index.to_timestamp(freq=freq, how=how)\n5716 |         setattr(new_obj, \"index\", new_index)\n5717 |         return new_obj\n5718 | \n5719 |     def to_period(\n5720 |         self,\n5721 |         freq: str | None = None,\n5722 |         copy: bool | lib.NoDefault = lib.no_default,\n5723 |     ) -> Series:\n5724 |         \"\"\"\n5725 |         Convert Series from DatetimeIndex to PeriodIndex.\n5726 | \n5727 |         Parameters\n5728 |         ----------\n5729 |         freq : str, default None\n5730 |             Frequency associated with the PeriodIndex.\n5731 |         copy : bool, default False\n5732 |             Whether or not to return a copy.\n5733 | \n5734 |             .. note::\n5735 |                 The `copy` keyword will change behavior in pandas 3.0.\n5736 |                 `Copy-on-Write\n5737 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n5738 |                 will be enabled by default, which means that all methods with a\n5739 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n5740 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n5741 |                 future version of pandas.\n5742 | \n5743 |                 You can already get the future behavior and improvements through\n5744 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n5745 | \n5746 |             .. deprecated:: 3.0.0\n5747 | \n5748 |         Returns\n5749 |         -------\n5750 |         Series\n5751 |             Series with index converted to PeriodIndex.\n5752 | \n5753 |         See Also\n5754 |         --------\n5755 |         DataFrame.to_period: Equivalent method for DataFrame.\n5756 |         Series.dt.to_period: Convert DateTime column values.\n5757 | \n5758 |         Examples\n5759 |         --------\n5760 |         >>> idx = pd.DatetimeIndex([\"2023\", \"2024\", \"2025\"])\n5761 |         >>> s = pd.Series([1, 2, 3], index=idx)\n5762 |         >>> s = s.to_period()\n5763 |         >>> s\n5764 |         2023    1\n5765 |         2024    2\n5766 |         2025    3\n5767 |         Freq: Y-DEC, dtype: int64\n5768 | \n5769 |         Viewing the index\n5770 | \n5771 |         >>> s.index\n5772 |         PeriodIndex(['2023', '2024', '2025'], dtype='period[Y-DEC]')\n5773 |         \"\"\"\n5774 |         self._check_copy_deprecation(copy)\n5775 |         if not isinstance(self.index, DatetimeIndex):\n5776 |             raise TypeError(f\"unsupported Type {type(self.index).__name__}\")\n5777 | \n5778 |         new_obj = self.copy(deep=False)\n5779 |         new_index = self.index.to_period(freq=freq)\n5780 |         setattr(new_obj, \"index\", new_index)\n5781 |         return new_obj\n5782 | \n5783 |     # ----------------------------------------------------------------------\n5784 |     # Add index\n5785 |     _AXIS_ORDERS: list[Literal[\"index\", \"columns\"]] = [\"index\"]\n5786 |     _AXIS_LEN = len(_AXIS_ORDERS)\n5787 |     _info_axis_number: Literal[0] = 0\n5788 |     _info_axis_name: Literal[\"index\"] = \"index\"\n5789 | \n5790 |     index = properties.AxisProperty(\n5791 |         axis=0,\n5792 |         doc=\"\"\"\n5793 |         The index (axis labels) of the Series.\n5794 | \n5795 |         The index of a Series is used to label and identify each element of the\n5796 |         underlying data. The index can be thought of as an immutable ordered set\n5797 |         (technically a multi-set, as it may contain duplicate labels), and is\n5798 |         used to index and align data in pandas.\n5799 | \n5800 |         Returns\n5801 |         -------\n5802 |         Index\n5803 |             The index labels of the Series.\n5804 | \n5805 |         See Also\n5806 |         --------\n5807 |         Series.reindex : Conform Series to new index.\n5808 |         Index : The base pandas index type.\n5809 | \n5810 |         Notes\n5811 |         -----\n5812 |         For more information on pandas indexing, see the `indexing user guide\n5813 |         <https://pandas.pydata.org/docs/user_guide/indexing.html>`__.\n5814 | \n5815 |         Examples\n5816 |         --------\n5817 |         To create a Series with a custom index and view the index labels:\n5818 | \n5819 |         >>> cities = ['Kolkata', 'Chicago', 'Toronto', 'Lisbon']\n5820 |         >>> populations = [14.85, 2.71, 2.93, 0.51]\n5821 |         >>> city_series = pd.Series(populations, index=cities)\n5822 |         >>> city_series.index\n5823 |         Index(['Kolkata', 'Chicago', 'Toronto', 'Lisbon'], dtype='object')\n5824 | \n5825 |         To change the index labels of an existing Series:\n5826 | \n5827 |         >>> city_series.index = ['KOL', 'CHI', 'TOR', 'LIS']\n5828 |         >>> city_series.index\n5829 |         Index(['KOL', 'CHI', 'TOR', 'LIS'], dtype='object')\n5830 |         \"\"\",\n5831 |     )\n5832 | \n5833 |     # ----------------------------------------------------------------------\n5834 |     # Accessor Methods\n5835 |     # ----------------------------------------------------------------------\n5836 |     str = Accessor(\"str\", StringMethods)\n5837 |     dt = Accessor(\"dt\", CombinedDatetimelikeProperties)\n5838 |     cat = Accessor(\"cat\", CategoricalAccessor)\n5839 |     plot = Accessor(\"plot\", pandas.plotting.PlotAccessor)\n5840 |     sparse = Accessor(\"sparse\", SparseAccessor)\n5841 |     struct = Accessor(\"struct\", StructAccessor)\n5842 |     list = Accessor(\"list\", ListAccessor)\n5843 | \n5844 |     # ----------------------------------------------------------------------\n5845 |     # Add plotting methods to Series\n5846 |     hist = pandas.plotting.hist_series\n5847 | \n5848 |     # ----------------------------------------------------------------------\n5849 |     # Template-Based Arithmetic/Comparison Methods\n5850 | \n5851 |     def _cmp_method(self, other, op):\n5852 |         res_name = ops.get_op_result_name(self, other)\n5853 | \n5854 |         if isinstance(other, Series) and not self._indexed_same(other):\n5855 |             raise ValueError(\"Can only compare identically-labeled Series objects\")\n5856 | \n5857 |         lvalues = self._values\n5858 |         rvalues = extract_array(other, extract_numpy=True, extract_range=True)\n5859 | \n5860 |         res_values = ops.comparison_op(lvalues, rvalues, op)\n5861 | \n5862 |         return self._construct_result(res_values, name=res_name)\n5863 | \n5864 |     def _logical_method(self, other, op):\n5865 |         res_name = ops.get_op_result_name(self, other)\n5866 |         self, other = self._align_for_op(other, align_asobject=True)\n5867 | \n5868 |         lvalues = self._values\n5869 |         rvalues = extract_array(other, extract_numpy=True, extract_range=True)\n5870 | \n5871 |         res_values = ops.logical_op(lvalues, rvalues, op)\n5872 |         return self._construct_result(res_values, name=res_name)\n5873 | \n5874 |     def _arith_method(self, other, op):\n5875 |         self, other = self._align_for_op(other)\n5876 |         return base.IndexOpsMixin._arith_method(self, other, op)\n5877 | \n5878 |     def _align_for_op(self, right, align_asobject: bool = False):\n5879 |         \"\"\"align lhs and rhs Series\"\"\"\n5880 |         # TODO: Different from DataFrame._align_for_op, list, tuple and ndarray\n5881 |         # are not coerced here\n5882 |         # because Series has inconsistencies described in GH#13637\n5883 |         left = self\n5884 | \n5885 |         if isinstance(right, Series):\n5886 |             # avoid repeated alignment\n5887 |             if not left.index.equals(right.index):\n5888 |                 if align_asobject:\n5889 |                     if left.dtype not in (object, np.bool_) or right.dtype not in (\n5890 |                         object,\n5891 |                         np.bool_,\n5892 |                     ):\n5893 |                         pass\n5894 |                         # GH#52538 no longer cast in these cases\n5895 |                     else:\n5896 |                         # to keep original value's dtype for bool ops\n5897 |                         left = left.astype(object)\n5898 |                         right = right.astype(object)\n5899 | \n5900 |                 left, right = left.align(right)\n5901 | \n5902 |         return left, right\n5903 | \n5904 |     def _binop(self, other: Series, func, level=None, fill_value=None) -> Series:\n5905 |         \"\"\"\n5906 |         Perform generic binary operation with optional fill value.\n5907 | \n5908 |         Parameters\n5909 |         ----------\n5910 |         other : Series\n5911 |         func : binary operator\n5912 |         fill_value : float or object\n5913 |             Value to substitute for NA/null values. If both Series are NA in a\n5914 |             location, the result will be NA regardless of the passed fill value.\n5915 |         level : int or level name, default None\n5916 |             Broadcast across a level, matching Index values on the\n5917 |             passed MultiIndex level.\n5918 | \n5919 |         Returns\n5920 |         -------\n5921 |         Series\n5922 |         \"\"\"\n5923 |         this = self\n5924 | \n5925 |         if not self.index.equals(other.index):\n5926 |             this, other = self.align(other, level=level, join=\"outer\")\n5927 | \n5928 |         this_vals, other_vals = ops.fill_binop(this._values, other._values, fill_value)\n5929 | \n5930 |         with np.errstate(all=\"ignore\"):\n5931 |             result = func(this_vals, other_vals)\n5932 | \n5933 |         name = ops.get_op_result_name(self, other)\n5934 |         out = this._construct_result(result, name)\n5935 |         return cast(Series, out)\n5936 | \n5937 |     def _construct_result(\n5938 |         self, result: ArrayLike | tuple[ArrayLike, ArrayLike], name: Hashable\n5939 |     ) -> Series | tuple[Series, Series]:\n5940 |         \"\"\"\n5941 |         Construct an appropriately-labelled Series from the result of an op.\n5942 | \n5943 |         Parameters\n5944 |         ----------\n5945 |         result : ndarray or ExtensionArray\n5946 |         name : Label\n5947 | \n5948 |         Returns\n5949 |         -------\n5950 |         Series\n5951 |             In the case of __divmod__ or __rdivmod__, a 2-tuple of Series.\n5952 |         \"\"\"\n5953 |         if isinstance(result, tuple):\n5954 |             # produced by divmod or rdivmod\n5955 | \n5956 |             res1 = self._construct_result(result[0], name=name)\n5957 |             res2 = self._construct_result(result[1], name=name)\n5958 | \n5959 |             # GH#33427 assertions to keep mypy happy\n5960 |             assert isinstance(res1, Series)\n5961 |             assert isinstance(res2, Series)\n5962 |             return (res1, res2)\n5963 | \n5964 |         # TODO: result should always be ArrayLike, but this fails for some\n5965 |         #  JSONArray tests\n5966 |         dtype = getattr(result, \"dtype\", None)\n5967 |         out = self._constructor(result, index=self.index, dtype=dtype, copy=False)\n5968 |         out = out.__finalize__(self)\n5969 | \n5970 |         # Set the result's name after __finalize__ is called because __finalize__\n5971 |         #  would set it back to self.name\n5972 |         out.name = name\n5973 |         return out\n5974 | \n5975 |     def _flex_method(self, other, op, *, level=None, fill_value=None, axis: Axis = 0):\n5976 |         if axis is not None:\n5977 |             self._get_axis_number(axis)\n5978 | \n5979 |         res_name = ops.get_op_result_name(self, other)\n5980 | \n5981 |         if isinstance(other, Series):\n5982 |             return self._binop(other, op, level=level, fill_value=fill_value)\n5983 |         elif isinstance(other, (np.ndarray, list, tuple)):\n5984 |             if len(other) != len(self):\n5985 |                 raise ValueError(\"Lengths must be equal\")\n5986 |             other = self._constructor(other, self.index, copy=False)\n5987 |             result = self._binop(other, op, level=level, fill_value=fill_value)\n5988 |             result._name = res_name\n5989 |             return result\n5990 |         else:\n5991 |             if fill_value is not None:\n5992 |                 if isna(other):\n5993 |                     return op(self, fill_value)\n5994 |                 self = self.fillna(fill_value)\n5995 | \n5996 |             return op(self, other)\n5997 | \n5998 |     def eq(\n5999 |         self,\n6000 |         other,\n6001 |         level: Level | None = None,\n6002 |         fill_value: float | None = None,\n6003 |         axis: Axis = 0,\n6004 |     ) -> Series:\n6005 |         \"\"\"\n6006 |         Return Equal to of series and other, element-wise (binary operator `eq`).\n6007 | \n6008 |         Equivalent to ``series == other``, but with support to substitute a fill_value\n6009 |         for missing data in either one of the inputs.\n6010 | \n6011 |         Parameters\n6012 |         ----------\n6013 |         other : Series or scalar value\n6014 |             The second operand in this operation.\n6015 |         level : int or name\n6016 |             Broadcast across a level, matching Index values on the\n6017 |             passed MultiIndex level.\n6018 |         fill_value : None or float value, default None (NaN)\n6019 |             Fill existing missing (NaN) values, and any new element needed for\n6020 |             successful Series alignment, with this value before computation.\n6021 |             If data in both corresponding Series locations is missing\n6022 |             the result of filling (at that location) will be missing.\n6023 |         axis : {0 or 'index'}\n6024 |             Unused. Parameter needed for compatibility with DataFrame.\n6025 | \n6026 |         Returns\n6027 |         -------\n6028 |         Series\n6029 |             The result of the operation.\n6030 | \n6031 |         See Also\n6032 |         --------\n6033 |         Series.ge : Return elementwise Greater than or equal to of series and other.\n6034 |         Series.le : Return elementwise Less than or equal to of series and other.\n6035 |         Series.gt : Return elementwise Greater than of series and other.\n6036 |         Series.lt : Return elementwise Less than of series and other.\n6037 | \n6038 |         Examples\n6039 |         --------\n6040 |         >>> a = pd.Series([1, 1, 1, np.nan], index=[\"a\", \"b\", \"c\", \"d\"])\n6041 |         >>> a\n6042 |         a    1.0\n6043 |         b    1.0\n6044 |         c    1.0\n6045 |         d    NaN\n6046 |         dtype: float64\n6047 |         >>> b = pd.Series([1, np.nan, 1, np.nan], index=[\"a\", \"b\", \"d\", \"e\"])\n6048 |         >>> b\n6049 |         a    1.0\n6050 |         b    NaN\n6051 |         d    1.0\n6052 |         e    NaN\n6053 |         dtype: float64\n6054 |         >>> a.eq(b, fill_value=0)\n6055 |         a     True\n6056 |         b    False\n6057 |         c    False\n6058 |         d    False\n6059 |         e    False\n6060 |         dtype: bool\n6061 |         \"\"\"\n6062 |         return self._flex_method(\n6063 |             other, operator.eq, level=level, fill_value=fill_value, axis=axis\n6064 |         )\n6065 | \n6066 |     @Appender(ops.make_flex_doc(\"ne\", \"series\"))\n6067 |     def ne(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6068 |         return self._flex_method(\n6069 |             other, operator.ne, level=level, fill_value=fill_value, axis=axis\n6070 |         )\n6071 | \n6072 |     def le(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6073 |         \"\"\"\n6074 |         Return Less than or equal to of series and other, \\\n6075 |         element-wise (binary operator `le`).\n6076 | \n6077 |         Equivalent to ``series <= other``, but with support to substitute a\n6078 |         fill_value for missing data in either one of the inputs.\n6079 | \n6080 |         Parameters\n6081 |         ----------\n6082 |         other : Series or scalar value\n6083 |             The second operand in this operation.\n6084 |         level : int or name\n6085 |             Broadcast across a level, matching Index values on the\n6086 |             passed MultiIndex level.\n6087 |         fill_value : None or float value, default None (NaN)\n6088 |             Fill existing missing (NaN) values, and any new element needed for\n6089 |             successful Series alignment, with this value before computation.\n6090 |             If data in both corresponding Series locations is missing\n6091 |             the result of filling (at that location) will be missing.\n6092 |         axis : {0 or 'index'}\n6093 |             Unused. Parameter needed for compatibility with DataFrame.\n6094 | \n6095 |         Returns\n6096 |         -------\n6097 |         Series\n6098 |             The result of the operation.\n6099 | \n6100 |         See Also\n6101 |         --------\n6102 |         Series.ge : Return elementwise Greater than or equal to of series and other.\n6103 |         Series.lt : Return elementwise Less than of series and other.\n6104 |         Series.gt : Return elementwise Greater than of series and other.\n6105 |         Series.eq : Return elementwise equal to of series and other.\n6106 | \n6107 |         Examples\n6108 |         --------\n6109 |         >>> a = pd.Series([1, 1, 1, np.nan, 1], index=['a', 'b', 'c', 'd', 'e'])\n6110 |         >>> a\n6111 |         a    1.0\n6112 |         b    1.0\n6113 |         c    1.0\n6114 |         d    NaN\n6115 |         e    1.0\n6116 |         dtype: float64\n6117 |         >>> b = pd.Series([0, 1, 2, np.nan, 1], index=['a', 'b', 'c', 'd', 'f'])\n6118 |         >>> b\n6119 |         a    0.0\n6120 |         b    1.0\n6121 |         c    2.0\n6122 |         d    NaN\n6123 |         f    1.0\n6124 |         dtype: float64\n6125 |         >>> a.le(b, fill_value=0)\n6126 |         a    False\n6127 |         b     True\n6128 |         c     True\n6129 |         d    False\n6130 |         e    False\n6131 |         f     True\n6132 |         dtype: bool\n6133 |         \"\"\"\n6134 |         return self._flex_method(\n6135 |             other, operator.le, level=level, fill_value=fill_value, axis=axis\n6136 |         )\n6137 | \n6138 |     @Appender(ops.make_flex_doc(\"lt\", \"series\"))\n6139 |     def lt(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6140 |         return self._flex_method(\n6141 |             other, operator.lt, level=level, fill_value=fill_value, axis=axis\n6142 |         )\n6143 | \n6144 |     def ge(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6145 |         \"\"\"\n6146 |         Return Greater than or equal to of series and other, \\\n6147 |         element-wise (binary operator `ge`).\n6148 | \n6149 |         Equivalent to ``series >= other``, but with support to substitute a\n6150 |         fill_value for missing data in either one of the inputs.\n6151 | \n6152 |         Parameters\n6153 |         ----------\n6154 |         other : Series or scalar value\n6155 |             The second operand in this operation.\n6156 |         level : int or name\n6157 |             Broadcast across a level, matching Index values on the\n6158 |             passed MultiIndex level.\n6159 |         fill_value : None or float value, default None (NaN)\n6160 |             Fill existing missing (NaN) values, and any new element needed for\n6161 |             successful Series alignment, with this value before computation.\n6162 |             If data in both corresponding Series locations is missing\n6163 |             the result of filling (at that location) will be missing.\n6164 |         axis : {0 or 'index'}\n6165 |             Unused. Parameter needed for compatibility with DataFrame.\n6166 | \n6167 |         Returns\n6168 |         -------\n6169 |         Series\n6170 |             The result of the operation.\n6171 | \n6172 |         See Also\n6173 |         --------\n6174 |         Series.gt : Greater than comparison, element-wise.\n6175 |         Series.le : Less than or equal to comparison, element-wise.\n6176 |         Series.lt : Less than comparison, element-wise.\n6177 |         Series.eq : Equal to comparison, element-wise.\n6178 |         Series.ne : Not equal to comparison, element-wise.\n6179 | \n6180 |         Examples\n6181 |         --------\n6182 |         >>> a = pd.Series([1, 1, 1, np.nan, 1], index=[\"a\", \"b\", \"c\", \"d\", \"e\"])\n6183 |         >>> a\n6184 |         a    1.0\n6185 |         b    1.0\n6186 |         c    1.0\n6187 |         d    NaN\n6188 |         e    1.0\n6189 |         dtype: float64\n6190 |         >>> b = pd.Series([0, 1, 2, np.nan, 1], index=[\"a\", \"b\", \"c\", \"d\", \"f\"])\n6191 |         >>> b\n6192 |         a    0.0\n6193 |         b    1.0\n6194 |         c    2.0\n6195 |         d    NaN\n6196 |         f    1.0\n6197 |         dtype: float64\n6198 |         >>> a.ge(b, fill_value=0)\n6199 |         a     True\n6200 |         b     True\n6201 |         c    False\n6202 |         d    False\n6203 |         e     True\n6204 |         f    False\n6205 |         dtype: bool\n6206 |         \"\"\"\n6207 |         return self._flex_method(\n6208 |             other, operator.ge, level=level, fill_value=fill_value, axis=axis\n6209 |         )\n6210 | \n6211 |     @Appender(ops.make_flex_doc(\"gt\", \"series\"))\n6212 |     def gt(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6213 |         return self._flex_method(\n6214 |             other, operator.gt, level=level, fill_value=fill_value, axis=axis\n6215 |         )\n6216 | \n6217 |     def add(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6218 |         \"\"\"\n6219 |         Return Addition of series and other, element-wise (binary operator `add`).\n6220 | \n6221 |         Equivalent to ``series + other``, but with support to substitute a fill_value\n6222 |         for missing data in either one of the inputs.\n6223 | \n6224 |         Parameters\n6225 |         ----------\n6226 |         other : Series or scalar value\n6227 |             With which to compute the addition.\n6228 |         level : int or name\n6229 |             Broadcast across a level, matching Index values on the\n6230 |             passed MultiIndex level.\n6231 |         fill_value : None or float value, default None (NaN)\n6232 |             Fill existing missing (NaN) values, and any new element needed for\n6233 |             successful Series alignment, with this value before computation.\n6234 |             If data in both corresponding Series locations is missing\n6235 |             the result of filling (at that location) will be missing.\n6236 |         axis : {0 or 'index'}\n6237 |             Unused. Parameter needed for compatibility with DataFrame.\n6238 | \n6239 |         Returns\n6240 |         -------\n6241 |         Series\n6242 |             The result of the operation.\n6243 | \n6244 |         See Also\n6245 |         --------\n6246 |         Series.radd : Reverse of the Addition operator, see\n6247 |             `Python documentation\n6248 |             <https://docs.python.org/3/reference/datamodel.html#emulating-numeric-types>`_\n6249 |             for more details.\n6250 | \n6251 |         Examples\n6252 |         --------\n6253 |         >>> a = pd.Series([1, 1, 1, np.nan], index=[\"a\", \"b\", \"c\", \"d\"])\n6254 |         >>> a\n6255 |         a    1.0\n6256 |         b    1.0\n6257 |         c    1.0\n6258 |         d    NaN\n6259 |         dtype: float64\n6260 |         >>> b = pd.Series([1, np.nan, 1, np.nan], index=[\"a\", \"b\", \"d\", \"e\"])\n6261 |         >>> b\n6262 |         a    1.0\n6263 |         b    NaN\n6264 |         d    1.0\n6265 |         e    NaN\n6266 |         dtype: float64\n6267 |         >>> a.add(b, fill_value=0)\n6268 |         a    2.0\n6269 |         b    1.0\n6270 |         c    1.0\n6271 |         d    1.0\n6272 |         e    NaN\n6273 |         dtype: float64\n6274 |         \"\"\"\n6275 |         return self._flex_method(\n6276 |             other, operator.add, level=level, fill_value=fill_value, axis=axis\n6277 |         )\n6278 | \n6279 |     @Appender(ops.make_flex_doc(\"radd\", \"series\"))\n6280 |     def radd(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6281 |         return self._flex_method(\n6282 |             other, roperator.radd, level=level, fill_value=fill_value, axis=axis\n6283 |         )\n6284 | \n6285 |     @Appender(ops.make_flex_doc(\"sub\", \"series\"))\n6286 |     def sub(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6287 |         return self._flex_method(\n6288 |             other, operator.sub, level=level, fill_value=fill_value, axis=axis\n6289 |         )\n6290 | \n6291 |     subtract = sub\n6292 | \n6293 |     @Appender(ops.make_flex_doc(\"rsub\", \"series\"))\n6294 |     def rsub(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6295 |         return self._flex_method(\n6296 |             other, roperator.rsub, level=level, fill_value=fill_value, axis=axis\n6297 |         )\n6298 | \n6299 |     def mul(\n6300 |         self,\n6301 |         other,\n6302 |         level: Level | None = None,\n