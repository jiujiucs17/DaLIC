.cos(yy - 0.4) * 0.5\nsegs = []\n\ncol = collections.LineCollection(segs, offsets=offs)\n\n# %%\n#\n# .. admonition:: References\n#\n#    The use of the following functions, methods, classes and modules is shown\n#    in this example:\n#\n#    - `matplotlib.figure.Figure`\n#    - `matplotlib.collections`\n#    - `matplotlib.collections.LineCollection`\n#    - `matplotlib.collections.RegularPolyCollection`\n#    - `matplotlib.axes.Axes.add_collection`\n#    - `matplotlib.axes.Axes.autoscale_view`\n#    - `matplotlib.transforms.Affine2D`\n#    - `matplotlib.transforms.Affine2D.scale`\n\n```\nHint: Search `galleries/examples/shapes_and_collections/collections.py` to get the full content if needed.\n\nFound function `lib/matplotlib/axes/_base.py:_AxesBase.collections`.\nSource: Match found for entity name `collections`.\n```\n1504 | def collections(self):\n1505 |         return self.ArtistList(self, 'collections',\n1506 |                                valid_types=mcoll.Collection)\n```\n"}, {"content": "Now let me get the specific LineCollection class implementation to analyze the docstring:\n\n<function=get_entity_contents>\n<parameter=entity_names>['lib/matplotlib/collections.py:LineCollection']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `lib/matplotlib/collections.py:LineCollection`...\n### Search Result:\nFound class `lib/matplotlib/collections.py:LineCollection`.\nSource: Exact match found for entity name `lib/matplotlib/collections.py:LineCollection`.\n```\n1587 | class LineCollection(Collection):\n1588 |     r\"\"\"\n1589 |     Represents a sequence of `.Line2D`\\s that should be drawn together.\n1590 | \n1591 |     This class extends `.Collection` to represent a sequence of\n1592 |     `.Line2D`\\s instead of just a sequence of `.Patch`\\s.\n1593 |     Just as in `.Collection`, each property of a *LineCollection* may be either\n1594 |     a single value or a list of values. This list is then used cyclically for\n1595 |     each element of the LineCollection, so the property of the ``i``\\th element\n1596 |     of the collection is::\n1597 | \n1598 |       prop[i % len(prop)]\n1599 | \n1600 |     The properties of each member of a *LineCollection* default to their values\n1601 |     in :rc:`lines.*` instead of :rc:`patch.*`, and the property *colors* is\n1602 |     added in place of *edgecolors*.\n1603 |     \"\"\"\n1604 | \n1605 |     _edge_default = True\n1606 | \n1607 |     def __init__(self, segments,  # Can be None.\n1608 |                  *,\n1609 |                  zorder=2,        # Collection.zorder is 1\n1610 |                  **kwargs\n1611 |                  ):\n1612 |         \"\"\"\n1613 |         Parameters\n1614 |         ----------\n1615 |         segments : list of array-like\n1616 |             A sequence (*line0*, *line1*, *line2*) of lines, where each line is a list\n1617 |             of points::\n1618 | \n1619 |                 lineN = [(x0, y0), (x1, y1), ... (xm, ym)]\n1620 | \n1621 |             or the equivalent Mx2 numpy array with two columns. Each line\n1622 |             can have a different number of segments.\n1623 |         linewidths : float or list of float, default: :rc:`lines.linewidth`\n1624 |             The width of each line in points.\n1625 |         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n1626 |             A sequence of RGBA tuples (e.g., arbitrary color strings, etc, not\n1627 |             allowed).\n1628 |         antialiaseds : bool or list of bool, default: :rc:`lines.antialiased`\n1629 |             Whether to use antialiasing for each line.\n1630 |         zorder : float, default: 2\n1631 |             zorder of the lines once drawn.\n1632 | \n1633 |         facecolors : :mpltype:`color` or list of :mpltype:`color`, default: 'none'\n1634 |             When setting *facecolors*, each line is interpreted as a boundary\n1635 |             for an area, implicitly closing the path from the last point to the\n1636 |             first point. The enclosed area is filled with *facecolor*.\n1637 |             In order to manually specify what should count as the \"interior\" of\n1638 |             each line, please use `.PathCollection` instead, where the\n1639 |             \"interior\" can be specified by appropriate usage of\n1640 |             `~.path.Path.CLOSEPOLY`.\n1641 | \n1642 |         **kwargs\n1643 |             Forwarded to `.Collection`.\n1644 |         \"\"\"\n1645 |         # Unfortunately, mplot3d needs this explicit setting of 'facecolors'.\n1646 |         kwargs.setdefault('facecolors', 'none')\n1647 |         super().__init__(\n1648 |             zorder=zorder,\n1649 |             **kwargs)\n1650 |         self.set_segments(segments)\n1651 | \n1652 |     def set_segments(self, segments):\n1653 |         if segments is None:\n1654 |             return\n1655 | \n1656 |         self._paths = [mpath.Path(seg) if isinstance(seg, np.ma.MaskedArray)\n1657 |                        else mpath.Path(np.asarray(seg, float))\n1658 |                        for seg in segments]\n1659 |         self.stale = True\n1660 | \n1661 |     set_verts = set_segments  # for compatibility with PolyCollection\n1662 |     set_paths = set_segments\n1663 | \n1664 |     def get_segments(self):\n1665 |         \"\"\"\n1666 |         Returns\n1667 |         -------\n1668 |         list\n1669 |             List of segments in the LineCollection. Each list item contains an\n1670 |             array of vertices.\n1671 |         \"\"\"\n1672 |         segments = []\n1673 | \n1674 |         for path in self._paths:\n1675 |             vertices = [\n1676 |                 vertex\n1677 |                 for vertex, _\n1678 |                 # Never simplify here, we want to get the data-space values\n1679 |                 # back and there in no way to know the \"right