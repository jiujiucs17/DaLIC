 |             The edgecolor.\n4591 | \n4592 |         \"\"\"\n4593 |         facecolors = kwargs.pop('facecolors', None)\n4594 |         facecolors = kwargs.pop('facecolor', facecolors)\n4595 |         edgecolors = kwargs.pop('edgecolor', edgecolors)\n4596 | \n4597 |         kwcolor = kwargs.pop('color', None)\n4598 | \n4599 |         if kwcolor is not None and c is not None:\n4600 |             raise ValueError(\"Supply a 'c' argument or a 'color'\"\n4601 |                              \" kwarg but not both; they differ but\"\n4602 |                              \" their functionalities overlap.\")\n4603 | \n4604 |         if kwcolor is not None:\n4605 |             try:\n4606 |                 mcolors.to_rgba_array(kwcolor)\n4607 |             except ValueError as err:\n4608 |                 raise ValueError(\n4609 |                     \"'color' kwarg must be a color or sequence of color \"\n4610 |                     \"specs.  For a sequence of values to be color-mapped, use \"\n4611 |                     \"the 'c' argument instead.\") from err\n4612 |             if edgecolors is None:\n4613 |                 edgecolors = kwcolor\n4614 |             if facecolors is None:\n4615 |                 facecolors = kwcolor\n4616 | \n4617 |         if edgecolors is None and not mpl.rcParams['_internal.classic_mode']:\n4618 |             edgecolors = mpl.rcParams['scatter.edgecolors']\n4619 | \n4620 |         c_was_none = c is None\n4621 |         if c is None:\n4622 |             c = (facecolors if facecolors is not None\n4623 |                  else \"b\" if mpl.rcParams['_internal.classic_mode']\n4624 |                  else get_next_color_func())\n4625 |         c_is_string_or_strings = (\n4626 |             isinstance(c, str)\n4627 |             or (np.iterable(c) and len(c) > 0\n4628 |                 and isinstance(cbook._safe_first_finite(c), str)))\n4629 | \n4630 |         def invalid_shape_exception(csize, xsize):\n4631 |             return ValueError(\n4632