ized\"],)\n15 | \n16 |     def setup_cache(self):\n17 |         super().setup_cache()\n18 | \n19 |     def make_data(self, params):\n20 |         return _mnist_dataset()\n21 | \n22 |     def make_estimator(self, params):\n23 |         (svd_solver,) = params\n24 | \n25 |         estimator = PCA(n_components=32, svd_solver=svd_solver, random_state=0)\n26 | \n27 |         return estimator\n28 | \n29 |     def make_scorers(self):\n30 |         make_pca_scorers(self)\n31 | \n32 | \n33 | class DictionaryLearningBenchmark(Transformer, Estimator, Benchmark):\n34 |     \"\"\"\n35 |     Benchmarks for DictionaryLearning.\n36 |     \"\"\"\n37 | \n38 |     param_names = [\"fit_algorithm\", \"n_jobs\"]\n39 |     params = ([\"lars\", \"cd\"], Benchmark.n_jobs_vals)\n40 | \n41 |     def setup_cache(self):\n42 |         super().setup_cache()\n43 | \n44 |     def make_data(self, params):\n45 |         return _olivetti_faces_dataset()\n46 | \n47 |     def make_estimator(self, params):\n48 |         fit_algorithm, n_jobs = params\n49 | \n50 |         estimator = DictionaryLearning(\n51 |             n_components=15,\n52 |             fit_algorithm=fit_algorithm,\n53 |             alpha=0.1,\n54 |             max_iter=20,\n55 |             tol=1e-16,\n56 |             random_state=0,\n57 |             n_jobs=n_jobs,\n58 |         )\n59 | \n60 |         return estimator\n61 | \n62 |     def make_scorers(self):\n63 |         make_dict_learning_scorers(self)\n64 | \n65 | \n66 | class MiniBatchDictionaryLearningBenchmark(Transformer, Estimator, Benchmark):\n67 |     \"\"\"\n68 |     Benchmarks for MiniBatchDictionaryLearning\n69 |     \"\"\"\n70 | \n71 |     param_names = [\"fit_algorithm\", \"n_jobs\"]\n72 |     params = ([\"lars\", \"cd\"], Benchmark.n_jobs_vals)\n73 | \n74 |     def setup_cache(self):\n75 |         super().setup_cache()\n76 | \n77 |     def make_data(self, params):\n78 |         return _olivetti_faces_dataset()\n79 | \n80 |     def make_estimator(self, params):\n81 |         fit_algorithm, n_jobs = params\n82 | \n83 |         estimator = MiniBatchDictionaryLearning(\n84 |             n_components=15,\n85 |             fit_algorithm=fit_algorithm,\n86 |             alpha=0.1,\n87 |             batch_size=3,\n88 |             random_state=0,\n89 |             n_jobs=n_jobs,\n90 |         )\n91 | \n92 |         return estimator\n93 | \n94 |     def make_scorers(self):\n95 |         make_dict_learning_scorers(self)\n96 | \n```\n"}, {"content": "Let me explore the dependency structure around NMF to understand the implementation better.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/decomposition/_nmf.py:NMF']</parameter>\n<parameter=direction>both</parameter>\n<parameter=traversal_depth>2</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\nsklearn/decomposition/_nmf.py:NMF\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/decomposition/_nmf.py:NMF._more_tags\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/decomposition/_nmf.py:NMF._check_params\n\u2502               \u251c\u2500\u2500 invokes \u2500\u2500 sklearn/decomposition/_nmf.py:_beta_loss_to_float\n\u2502               \u2514\u2500\u2500 invokes \u2500\u2500 sklearn/decomposition/_nmf.py:_compute_regularization\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/decomposition/_nmf.py:NMF._check_w_h\n\u2502               \u251c\u2500\u2500 invokes \u2500\u2500 sklearn/utils/_pprint.py:_EstimatorPrettyPrinter.format\n\u2502               \u251c\u2500\u2500 invokes \u2500\u2500 sklearn/decomposition/_nmf.py:_initialize_nmf\n\u2502               \u2514\u2500\u2500 invokes \u2500\u2500 sklearn/decomposition/_nmf.py:_check_init\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/decomposition/_nmf.py:NMF._scale_regularization\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/decomposition/_nmf.py:NMF.fit_transform\n\u2502       