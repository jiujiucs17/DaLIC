\": [\"T\", \"Z\"]}, index=[\"tiger\", \"zebra\"])\n7033 |         >>> df.median(numeric_only=True)\n7034 |         a   1.5\n7035 |         dtype: float64\n7036 |         \"\"\"\n7037 |         return NDFrame.median(\n7038 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n7039 |         )\n7040 | \n7041 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"sem\")\n7042 |     @doc(make_doc(\"sem\", ndim=1))\n7043 |     def sem(\n7044 |         self,\n7045 |         axis: Axis | None = None,\n7046 |         skipna: bool = True,\n7047 |         ddof: int = 1,\n7048 |         numeric_only: bool = False,\n7049 |         **kwargs,\n7050 |     ):\n7051 |         return NDFrame.sem(\n7052 |             self,\n7053 |             axis=axis,\n7054 |             skipna=skipna,\n7055 |             ddof=ddof,\n7056 |             numeric_only=numeric_only,\n7057 |             **kwargs,\n7058 |         )\n7059 | \n7060 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"var\")\n7061 |     def var(\n7062 |         self,\n7063 |         axis: Axis | None = None,\n7064 |         skipna: bool = True,\n7065 |         ddof: int = 1,\n7066 |         numeric_only: bool = False,\n7067 |         **kwargs,\n7068 |     ):\n7069 |         \"\"\"\n7070 |         Return unbiased variance over requested axis.\n7071 | \n7072 |         Normalized by N-1 by default. This can be changed using the ddof argument.\n7073 | \n7074 |         Parameters\n7075 |         ----------\n7076 |         axis : {index (0)}\n7077 |             For `Series` this parameter is unused and defaults to 0.\n7078 | \n7079 |             .. warning::\n7080 | \n7081 |                 The behavior of DataFrame.var with ``axis=None`` is deprecated,\n7082 |                 in a future version this will reduce over both axes and return a scalar\n7083 |                 To retain the old behavior, pass axis=0 (or do not pass axis).\n7084 | \n7085 |         skipna : bool, default True\n7086 |             Exclude NA/null values. If an entire row/column is NA, the result\n7087 |             will be NA.\n7088 |         ddof : int, default 1\n7089 |             Delta Degrees of Freedom. The divisor used in calculations is N - ddof,\n7090 |             where N represents the number of elements.\n7091 |         numeric_only : bool, default False\n7092 |             Include only float, int, boolean columns. Not implemented for Series.\n7093 |         **kwargs :\n7094 |             Additional keywords passed.\n7095 | \n7096 |         Returns\n7097 |         -------\n7098 |         scalar or Series (if level specified)\n7099 |             Unbiased variance over requested axis.\n7100 | \n7101 |         See Also\n7102 |         --------\n7103 |         numpy.var : Equivalent function in NumPy.\n7104 |         Series.std : Returns the standard deviation of the Series.\n7105 |         DataFrame.var : Returns the variance of the DataFrame.\n7106 |         DataFrame.std : Return standard deviation of the values over\n7107 |             the requested axis.\n7108 | \n7109 |         Examples\n7110 |         --------\n7111 |         >>> df = pd.DataFrame(\n7112 |         ...     {\n7113 |         ...         \"person_id\": [0, 1, 2, 3],\n7114 |         ...         \"age\": [21, 25, 62, 43],\n7115 |         ...         \"height\": [1.61, 1.87, 1.49, 2.01],\n7116 |         ...     }\n7117 |         ... ).set_index(\"person_id\")\n7118 |         >>> df\n7119 |                    age  height\n7120 |         person_id\n7121 |         0           21    1.61\n7122 |         1           25    1.87\n7123 |         2           62    1.49\n7124 |         3           43    2.01\n7125 | \n7126 |         >>> df.var()\n7127 |         age       352.916667\n7128 |         height      0.056367\n7129 |         dtype: float64\n7130 | \n7131 |         Alternatively, ``ddof=0`` can be set to normalize by N instead of N-1:\n7132 | \n7133 