bove listed Patch properties.\n6911 | \n6912 |         See Also\n6913 |         --------\n6914 |         hist2d : 2D histogram with rectangular bins\n6915 |         hexbin : 2D histogram with hexagonal bins\n6916 |         stairs : Plot a pre-computed histogram\n6917 |         bar : Plot a pre-computed histogram\n6918 | \n6919 |         Notes\n6920 |         -----\n6921 |         For large numbers of bins (>1000), plotting can be significantly\n6922 |         accelerated by using `~.Axes.stairs` to plot a pre-computed histogram\n6923 |         (``plt.stairs(*np.histogram(data))``), or by setting *histtype* to\n6924 |         'step' or 'stepfilled' rather than 'bar' or 'barstacked'.\n6925 |         \"\"\"\n6926 |         # Avoid shadowing the builtin.\n6927 |         bin_range = range\n6928 |         from builtins import range\n6929 | \n6930 |         if np.isscalar(x):\n6931 |             x = [x]\n6932 | \n6933 |         if bins is None:\n6934 |             bins = mpl.rcParams['hist.bins']\n6935 | \n6936 |         # Validate string inputs here to avoid cluttering subsequent code.\n6937 |         _api.check_in_list(['bar', 'barstacked', 'step', 'stepfilled'],\n6938 |                            histtype=histtype)\n6939 |         _api.check_in_list(['left', 'mid', 'right'], align=align)\n6940 |         _api.check_in_list(['horizontal', 'vertical'], orientation=orientation)\n6941 | \n6942 |         if histtype == 'barstacked' and not stacked:\n6943 |             stacked = True\n6944 | \n6945 |         # Massage 'x' for processing.\n6946 |         x = cbook._reshape_2D(x, 'x')\n6947 |         nx = len(x)  # number of datasets\n6948 | \n6949 |         # Process unit information.  _process_unit_info sets the unit and\n6950 |         # converts the first dataset; then we convert each following dataset\n6951 |         # one at a time.\n6952 |         if orientation == \"vertical\":\n6953 |             convert_units = self.convert_xunits\n6954 |             x = [*self._proces