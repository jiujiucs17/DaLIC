string] but \"\n5132 |                     f\"[{inferred_type}] object dtype\"\n5133 |                 )\n5134 | \n5135 |     # itemsize is the maximum length of a string (along any dimension)\n5136 | \n5137 |     data_converted = _convert_string_array(data, encoding, errors).reshape(data.shape)\n5138 |     itemsize = data_converted.itemsize\n5139 | \n5140 |     # specified min_itemsize?\n5141 |     if isinstance(min_itemsize, dict):\n5142 |         min_itemsize = int(min_itemsize.get(name) or min_itemsize.get(\"values\") or 0)\n5143 |     itemsize = max(min_itemsize or 0, itemsize)\n5144 | \n5145 |     # check for column in the values conflicts\n5146 |     if existing_col is not None:\n5147 |         eci = existing_col.validate_col(itemsize)\n5148 |         if eci is not None and eci > itemsize:\n5149 |             itemsize = eci\n5150 | \n5151 |     data_converted = data_converted.astype(f\"|S{itemsize}\", copy=False)\n5152 |     return data_converted\n```\n\nFound file `asv_bench/benchmarks/libs.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `asv_bench/benchmarks/libs.py` for the full content if needed.\n\n\n\n##Searching for term \"infer_dtype lib.infer_dtype\"...\n### Search Result:\nFound code snippet in file `pandas/api/types/__init__.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | Public toolkit API.\n 3 | \"\"\"\n 4 | \n 5 | from pandas._libs.lib import infer_dtype\n 6 | \n 7 | from pandas.core.dtypes.api import *  # noqa: F403\n 8 | from pandas.core.dtypes.concat import union_categoricals\n 9 | from pandas.core.dtypes.dtypes import (\n10 |     CategoricalDtype,\n11 |     DatetimeTZDtype,\n12 |     IntervalDtype,\n13 |     PeriodDtype,\n14 | )\n15 | \n16 | __all__ = [\n17 |     \"infer_dtype\",\n18 |     \"union_categoricals\",\n19 |     \"CategoricalDtype\",\n20 |     \"DatetimeTZDtype\",\n21 |     \"IntervalDtype\",\n22 |     \"PeriodDtype\",\n23 | ]\n24 | \n```\n"}, {"content": "After a