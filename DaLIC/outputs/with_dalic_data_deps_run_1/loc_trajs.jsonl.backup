    max_iter=max_iter,\n 88 |             batch_size=1000,\n 89 |             max_no_improvement=None,\n 90 |             compute_labels=False,\n 91 |             random_state=0,\n 92 |         )\n 93 | \n 94 |         return estimator\n 95 | \n 96 |     def make_scorers(self):\n 97 |         self.train_scorer = lambda _, __: neg_mean_inertia(\n 98 |             self.X, self.estimator.predict(self.X), self.estimator.cluster_centers_\n 99 |         )\n100 |         self.test_scorer = lambda _, __: neg_mean_inertia(\n101 |             self.X_val,\n102 |             self.estimator.predict(self.X_val),\n103 |             self.estimator.cluster_centers_,\n104 |         )\n```\n\n\n\n##Searching for term \"MiniBatchNMF\", \"minibatch_step\", \"MiniBatchNMF minibatch_step\"...\n### Search Result:\nFound class `sklearn/cross_decomposition/_pls.py:PLSRegression`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSRegression(_PLS):\n\n    # This implementation provides the same results that 3 PLS packages\n    # provided in the R language (R-project):\n    #     - \"mixOmics\" with function pls(X, Y, mode = \"regression\")\n    #     - \"plspm \" with function plsreg2(X, Y)\n    #     - \"pls\" with function oscorespls.fit(X, Y)\n\n    def __init__(\n        self, n_components=2, *, scale=True, max_iter=500, tol=1e-06, copy=True\n    ):\n...\n    def fit(self, X, Y):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSRegression` to get the full content if needed.\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSCanonical`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSCanonical(_PLS):\n\n    # This implementation provides the same results that the \"plspm\" package\n    # provided in the R language (R-project), using the function plsca(X, Y).\n    # Results are equal or collinear with the function\n    # ``pls(..., mode = \"canonical\")`` of the \"mixOmics\" package. The\n    # difference relies in the fact that mixOmics implementation does not\n    # exactly implement the Wold algorithm since it does not normalize\n    # y_weights to one.\n\n    def __init__(\n        self,\n        n_components=2,\n        *,\n        scale=True,\n        algorithm=\"nipals\",\n        max_iter=500,\n        tol=1e-06,\n        copy=True,\n    ):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSCanonical` to get the full content if needed.\n\nFound function `sklearn/utils/validation.py:_generate_get_feature_names_out`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1918 | def _generate_get_feature_names_out(estimator, n_features_out, input_features=None):\n1919 |     \"\"\"Generate feature names out for estimator using the estimator name as the prefix.\n1920 | \n1921 |     The input_feature names are validated but not used. This function is useful\n1922 |     for estimators that generate their own names based on `n_features_out`, i.e. PCA.\n1923 | \n1924 |     Parameters\n1925 |     ----------\n1926 |     estimator : estimator instance\n1927 |         Estimator producing output feature names.\n1928 | \n1929 |     n_feature_out : int\n1930 |         Number of feature names out.\n1931 | \n1932 |     input_features : array-like of str or None, default=None\n1933 |         Only used to validate feature names with `estimator.feature_names_in_`.\n1934 | \n1935 |     Returns\n1936 |     -------\n1937 |     feature_names_in : ndarray of str or `None`\n1938 |         Feature names in.\n1939 |     \"\"\"\n1940 |     _check_feature_names_in(estimator, input_features, generate_names=False)\n1941 |     estimator_name = estimator.__class__.__name__.lower()\n1942 |     return np.asarray(\n1943 |         [f\"{estimator_name}{i}\" for i in range(n_features_out)], dtype=object\n1944 |     )\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSRegression.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n634 | def fit(self, X, Y):\n635 |         \"\"\"Fit model to data.\n636 | \n637 |         Parameters\n638 |         ----------\n639 |         X : array-like of shape (n_samples, n_features)\n640 |             Training vectors, where `n_samples` is the number of samples and\n641 |             `n_features` is the number of predictors.\n642 | \n643 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets)\n644 |             Target vectors, where `n_samples` is the number of samples and\n645 |             `n_targets` is the number of response variables.\n646 | \n647 |         Returns\n648 |         -------\n649 |         self : object\n650 |             Fitted model.\n651 |         \"\"\"\n652 |         super().fit(X, Y)\n653 |         # expose the fitted attributes `x_scores_` and `y_scores_`\n654 |         self.x_scores_ = self._x_scores\n655 |         self.y_scores_ = self._y_scores\n656 |         return self\n```\n\n\n\n##Searching for term \"minibatch_step\", \"MiniBatchNMF minibatch_step\"...\n### Search Result:\nFound function `sklearn/decomposition/_dict_learning.py:MiniBatchDictionaryLearning._minibatch_step`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2114 | def _minibatch_step(self, X, dictionary, random_state, step):\n2115 |         \"\"\"Perform the update on the dictionary for one minibatch.\"\"\"\n2116 |         batch_size = X.shape[0]\n2117 | \n2118 |         # Compute code for this batch\n2119 |         code = sparse_encode(\n2120 |             X,\n2121 |             dictionary,\n2122 |             algorithm=self._fit_algorithm,\n2123 |             alpha=self.alpha,\n2124 |             n_jobs=self.n_jobs,\n2125 |             check_input=False,\n2126 |             positive=self.positive_code,\n2127 |             max_iter=self.transform_max_iter,\n2128 |             verbose=self.verbose,\n2129 |         )\n2130 | \n2131 |         batch_cost = (\n2132 |             0.5 * ((X - code @ dictionary) ** 2).sum()\n2133 |             + self.alpha * np.sum(np.abs(code))\n2134 |         ) / batch_size\n2135 | \n2136 |         # Update inner stats\n2137 |         self._update_inner_stats(X, code, batch_size, step)\n2138 | \n2139 |         # Update dictionary\n2140 |         A, B = self._inner_stats\n2141 |         _update_dict(\n2142 |             dictionary,\n2143 |             X,\n2144 |             code,\n2145 |             A,\n2146 |             B,\n2147 |             verbose=self.verbose,\n2148 |             random_state=random_state,\n2149 |             positive=self.positive_dict,\n2150 |         )\n2151 | \n2152 |         return batch_cost\n```\n\nFound function `examples/applications/plot_out_of_core_classification.py:get_minibatch`.\nSource: Retrieved entity using keyword search (bm25).\n```\n212 | def get_minibatch(doc_iter, size, pos_class=positive_class):\n213 |     \"\"\"Extract a minibatch of examples, return a tuple X_text, y.\n214 | \n215 |     Note: size is before excluding invalid docs with no topics assigned.\n216 | \n217 |     \"\"\"\n218 |     data = [\n219 |         (\"{title}\\n\\n{body}\".format(**doc), pos_class in doc[\"topics\"])\n220 |         for doc in itertools.islice(doc_iter, size)\n221 |         if doc[\"topics\"]\n222 |     ]\n223 |     if not len(data):\n224 |         return np.asarray([], dtype=int), np.asarray([], dtype=int)\n225 |     X_text, y = zip(*data)\n226 |     return X_text, np.asarray(y, dtype=int)\n```\n\n\n\n##Searching for term \"minibatch_step\"...\n### Search Result:\nFound file `sklearn/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/__init__.py` for the full content if needed.\n"}, {"content": "Let me check the NMF implementation in more detail.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/decomposition/_nmf.py:NMF._minibatch_step']</parameter>\n", "role": "