 |                 )\n1117 | \n1118 |         # override for transductive outlier detectors like LocalOulierFactor\n1119 |         return self.fit(X, **kwargs).predict(X)\n1120 | \n1121 | \n1122 | class MetaEstimatorMixin:\n1123 |     \"\"\"Mixin class for all meta estimators in scikit-learn.\n1124 | \n1125 |     This mixin is empty, and only exists to indicate that the estimator is a\n1126 |     meta-estimator.\n1127 | \n1128 |     .. versionchanged:: 1.6\n1129 |         The `_required_parameters` is now removed and is unnecessary since tests are\n1130 |         refactored and don't use this anymore.\n1131 | \n1132 |     Examples\n1133 |     --------\n1134 |     >>> from sklearn.base import MetaEstimatorMixin\n1135 |     >>> from sklearn.datasets import load_iris\n1136 |     >>> from sklearn.linear_model import LogisticRegression\n1137 |     >>> class MyEstimator(MetaEstimatorMixin):\n1138 |     ...     def __init__(self, *, estimator=None):\n1139 |     ...         self.estimator = estimator\n1140 |     ...     def fit(self, X, y=None):\n1141 |     ...         if self.estimator is None:\n1142 |     ...             self.estimator_ = LogisticRegression()\n1143 |     ...         else:\n1144 |     ...             self.estimator_ = self.estimator\n1145 |     ...         return self\n1146 |     >>> X, y = load_iris(return_X_y=True)\n1147 |     >>> estimator = MyEstimator().fit(X, y)\n1148 |     >>> estimator.estimator_\n1149 |     LogisticRegression()\n1150 |     \"\"\"\n1151 | \n1152 | \n1153 | class MultiOutputMixin:\n1154 |     \"\"\"Mixin to mark estimators that support multioutput.\"\"\"\n1155 | \n1156 |     def __sklearn_tags__(self):\n1157 |         tags = super().__sklearn_tags__()\n1158 |         tags.target_tags.multi_output = True\n1159 |         return tags\n1160 | \n1161 | \n1162 | class _UnstableArchMixin:\n1163 |     \"\"\"Mark estimators that are non-determinstic on 32bit or PowerPC\"\"\"\n1164 | \n1165 |     def __sklearn_tags__(self):\n1166 |         tags = super().__sklearn_tags__()\n1167 |         tags.non_deterministic = _IS_32BIT or platform.machine().startswith(\n1168 |             (\"ppc\", \"powerpc\")\n1169 |         )\n1170 |         return tags\n1171 | \n1172 | \n1173 | def is_classifier(estimator):\n1174 |     \"\"\"Return True if the given estimator is (probably) a classifier.\n1175 | \n1176 |     Parameters\n1177 |     ----------\n1178 |     estimator : object\n1179 |         Estimator object to test.\n1180 | \n1181 |     Returns\n1182 |     -------\n1183 |     out : bool\n1184 |         True if estimator is a classifier and False otherwise.\n1185 | \n1186 |     Examples\n1187 |     --------\n1188 |     >>> from sklearn.base import is_classifier\n1189 |     >>> from sklearn.cluster import KMeans\n1190 |     >>> from sklearn.svm import SVC, SVR\n1191 |     >>> classifier = SVC()\n1192 |     >>> regressor = SVR()\n1193 |     >>> kmeans = KMeans()\n1194 |     >>> is_classifier(classifier)\n1195 |     True\n1196 |     >>> is_classifier(regressor)\n1197 |     False\n1198 |     >>> is_classifier(kmeans)\n1199 |     False\n1200 |     \"\"\"\n1201 |     # TODO(1.8): Remove this check\n1202 |     if isinstance(estimator, type):\n1203 |         warnings.warn(\n1204 |             f\"passing a class to {print(inspect.stack()[0][3])} is deprecated and \"\n1205 |             \"will be removed in 1.8. Use an instance of the class instead.\",\n1206 |             FutureWarning,\n1207 |         )\n1208 |         return getattr(estimator, \"_estimator_type\", None) == \"classifier\"\n1209 | \n1210 |     return get_tags(estimator).estimator_type == \"classifier\"\n1211 | \n1212 | \n1213 | def is_regressor(estimator):\n1214 |     \"\"\"Return True if the given estimator is (probably) a regressor.\n1215 | \n1216 |     Parameters\n1217 |     ----------\n1218 |     estimator : estimator instance\n1219 |         Estimator object to test.\n1220 | \n1221 |     Returns\n1222 |     -------\n1223 |     out : bool\n1224 |         T