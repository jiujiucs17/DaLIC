_iter_collection_raw_paths(\n2080 |                 master_transform, paths, all_transforms)):\n2081 |             name = self.file.pathCollectionObject(\n2082 |                 gc, path, transform, padding, filled, stroked)\n2083 |             path_codes.append(name)\n2084 | \n2085 |         output = self.file.output\n2086 |         output(*self.gc.push())\n2087 |         lastx, lasty = 0, 0\n2088 |         for xo, yo, path_id, gc0, rgbFace in self._iter_collection(\n2089 |                 gc, path_codes, offsets, offset_trans,\n2090 |                 facecolors, edgecolors, linewidths, linestyles,\n2091 |                 antialiaseds, urls, offset_position):\n2092 | \n2093 |             self.check_gc(gc0, rgbFace)\n2094 |             dx, dy = xo - lastx, yo - lasty\n2095 |             output(1, 0, 0, 1, dx, dy, Op.concat_matrix, path_id,\n2096 |                    Op.use_xobject)\n2097 |             lastx, lasty = xo, yo\n2098 |         output(*self.gc.pop())\n```\n\n\n\n##Searching for term \"facecolor\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.voxels`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3353 | def voxels(self, *args, facecolors=None, edgecolors=None, shade=True,\n3354 |                lightsource=None, axlim_clip=False, **kwargs):\n3355 |         \"\"\"\n3356 |         ax.voxels([x, y, z,] /, filled, facecolors=None, edgecolors=None, \\\n3357 | **kwargs)\n3358 | \n3359 |         Plot a set of filled voxels\n3360 | \n3361 |         All voxels are plotted as 1x1x1 cubes on the axis, with\n3362 |         ``filled[0, 0, 0]`` placed with its lower corner at the origin.\n3363 |         Occluded faces are not plotted.\n3364 | \n3365 |         Parameters\n3366 |         ----------\n3367 |         filled : 3D np.array of bool\n3368 |             A 3D array of values, with truthy values indicating which voxels\n3369 |             to fill\n3370 | \n3371 |         x, y, z : 3D np.array, optional\n3372 