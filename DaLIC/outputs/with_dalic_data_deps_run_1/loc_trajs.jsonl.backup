l2004_vectors_train.dat.gz')\n 66 | )\n 67 | \n 68 | # The original data can be found at:\n 69 | # http://jmlr.csail.mit.edu/papers/volume5/lewis04a/a08-topic-qrels/rcv1-v2.topics.qrels.gz\n 70 | TOPICS_METADATA = RemoteFileMetadata(\n 71 |     url='https://ndownloader.figshare.com/files/5976048',\n 72 |     checksum=('2a98e5e5d8b770bded93afc8930d882'\n 73 |               '99474317fe14181aee1466cc754d0d1c1'),\n 74 |     filename='rcv1v2.topics.qrels.gz')\n 75 | \n 76 | logger = logging.getLogger(__name__)\n```\n\nFound function `sklearn/datasets/_rcv1.py:fetch_rcv1`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 80 | def fetch_rcv1(*, data_home=None, subset='all', download_if_missing=True,\n 81 |                random_state=None, shuffle=False, return_X_y=False):\n 82 |     \"\"\"Load the RCV1 multilabel dataset (classification).\n 83 | \n 84 |     Download it if necessary.\n 85 | \n 86 |     Version: RCV1-v2, vectors, full sets, topics multilabels.\n 87 | \n 88 |     =================   =====================\n 89 |     Classes                               103\n 90 |     Samples total                      804414\n 91 |     Dimensionality                      47236\n 92 |     Features            real, between 0 and 1\n 93 |     =================   =====================\n 94 | \n 95 |     Read more in the :ref:`User Guide <rcv1_dataset>`.\n 96 | \n 97 |     .. versionadded:: 0.17\n 98 | \n 99 |     Parameters\n100 |     ----------\n101 |     data_home : str, default=None\n102 |         Specify another download and cache folder for the datasets. By default\n103 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n104 | \n105 |     subset : {'train', 'test', 'all'}, default='all'\n106 |         Select the dataset to load: 'train' for the training set\n107 |         (23149 samples), 'test' for the test set (781265 samples),\n108 |         'all' for both, with the training samples first if shuffle is False.\n109 |         This follows the official LYRL2004 chronological split.\n110 | \n111 |     download_if_missing : bool, default=True\n112 |         If False, raise a IOError if the data is not locally available\n113 |         instead of trying to download the data from the source site.\n114 | \n115 |     random_state : int or RandomState instance, default=None\n116 |         Determines random number generation for dataset shuffling. Pass an int\n117 |         for reproducible output across multiple function calls.\n118 |         See :term:`Glossary <random_state>`.\n119 | \n120 |     shuffle : bool, default=False\n121 |         Whether to shuffle dataset.\n122 | \n123 |     return_X_y : bool, default=False\n124 |         If True, returns ``(dataset.data, dataset.target)`` instead of a Bunch\n125 |         object. See below for more information about the `dataset.data` and\n126 |         `dataset.target` object.\n127 | \n128 |         .. versionadded:: 0.20\n129 | \n130 |     Returns\n131 |     -------\n132 |     dataset : :class:`~sklearn.utils.Bunch`\n133 |         Dictionary-like object, with the following attributes.\n134 | \n135 |         data : scipy csr array, dtype np.float64, shape (804414, 47236)\n136 |             The array has 0.16% of non zero values.\n137 |         target : scipy csr array, dtype np.uint8, shape (804414, 103)\n138 |             Each sample has a value of 1 in its categories, and 0 in others.\n139 |             The array has 3.15% of non zero values.\n140 |         sample_id : numpy array, dtype np.uint32, shape (804414,)\n141 |             Identification number of each sample, as ordered in dataset.data.\n142 |         target_names : numpy array, dtype object, length (103)\n143 |             Names of each target (RCV1 topics), as ordered in dataset.target.\n144 |         DESCR : string\n145 |             Description of the RCV1 dataset.\n146 | \n147 |     (data, target) : tuple if ``return_X_y`` is True\n148 | \n149 |         .. versionadded:: 0.20\n150 |     \"\"\"\n151 |     N_SAMPLES = 804414\n152 |     N_FEATURES = 47236\n153 |     N_CATEGORIES = 103\n154 |     N_TRAIN = 23149\n155 | \n156 |     data_home = get_data_home(data_home=data_home)\n157 |     rcv1_dir = join(data_home, \"RCV1\")\n158 |     if download_if_missing:\n159 |         if not exists(rcv1_dir):\n160 |             makedirs(rcv1_dir)\n161 | \n162 |     samples_path = _pkl_filepath(rcv1_dir, \"samples.pkl\")\n163 |     sample_id_path = _pkl_filepath(rcv1_dir, \"sample_id.pkl\")\n164 |     sample_topics_path = _pkl_filepath(rcv1_dir, \"sample_topics.pkl\")\n165 |     topics_path = _pkl_filepath(rcv1_dir, \"topics_names.pkl\")\n166 | \n167 |     # load data (X) and sample_id\n168 |     if download_if_missing and (not exists(samples_path) or\n169 |                                 not exists(sample_id_path)):\n170 |         files = []\n171 |         for each in XY_METADATA:\n172 |             logger.info(\"Downloading %s\" % each.url)\n173 |             file_path = _fetch_remote(each, dirname=rcv1_dir)\n174 |             files.append(GzipFile(filename=file_path))\n175 | \n176 |         Xy = load_svmlight_files(files, n_features=N_FEATURES)\n177 | \n178 |         # Training data is before testing data\n179 |         X = sp.vstack([Xy[8], Xy[0], Xy[2], Xy[4], Xy[6]]).tocsr()\n180 |         sample_id = np.hstack((Xy[9], Xy[1], Xy[3], Xy[5], Xy[7]))\n181 |         sample_id = sample_id.astype(np.uint32, copy=False)\n182 | \n183 |         joblib.dump(X, samples_path, compress=9)\n184 |         joblib.dump(sample_id, sample_id_path, compress=9)\n185 | \n186 |         # delete archives\n187 |         for f in files:\n188 |             f.close()\n189 |             remove(f.name)\n190 |     else:\n191 |         X = joblib.load(samples_path)\n192 |         sample_id = joblib.load(sample_id_path)\n193 | \n194 |     # load target (y), categories, and sample_id_bis\n195 |     if download_if_missing and (not exists(sample_topics_path) or\n196 |                                 not exists(topics_path)):\n197 |         logger.info(\"Downloading %s\" % TOPICS_METADATA.url)\n198 |         topics_archive_path = _fetch_remote(TOPICS_METADATA,\n199 |                                             dirname=rcv1_dir)\n200 | \n201 |         # parse the target file\n202 |         n_cat = -1\n203 |         n_doc = -1\n204 |         doc_previous = -1\n205 |         y = np.zeros((N_SAMPLES, N_CATEGORIES), dtype=np.uint8)\n206 |         sample_id_bis = np.zeros(N_SAMPLES, dtype=np.int32)\n207 |         category_names = {}\n208 |         with GzipFile(filename=topics_archive_path, mode='rb') as f:\n209 |             for line in f:\n210 |                 line_components = line.decode(\"ascii\").split(\" \")\n211 |                 if len(line_components) == 3:\n212 |                     cat, doc, _ = line_components\n213 |                     if cat not in category_names:\n214 |                         n_cat += 1\n215 |                         category_names[cat] = n_cat\n216 | \n217 |                     doc = int(doc)\n218 |                     if doc != doc_previous:\n219 |                         doc_previous = doc\n220 |                         n_doc += 1\n221 |                         sample_id_bis[n_doc] = doc\n222 |                     y[n_doc, category_names[cat]] = 1\n223 | \n224 |         # delete archive\n225 |         remove(topics_archive_path)\n226 | \n227 |         # Samples in X are ordered with sample_id,\n228 |         # whereas in y, they are ordered with sample_id_bis.\n229 |         permutation = _find_permutation(sample_id_bis, sample_id)\n230 |         y = y[permutation, :]\n231 | \n232 |         # save category names in a list, with same order than y\n233 |         categories = np.empty(N_CATEGORIES, dtype=object)\n234 |         for k in category_names.keys():\n235 |             categories[category_names[k]] = k\n236 | \n237 |         # reorder categories in lexicographic order\n238 |         order = np.argsort(categories)\n239 |         categories = categories[order]\n240 |         y = sp.csr_matrix(y[:, order])\n241 | \n242 |         joblib.dump(y, sample_topics_path, compress=9)\n243 |         joblib.dump(categories, topics_path, compress=9)\n244 |     else:\n245 |         y = joblib.load(sample_topics_path)\n246 |         categories = joblib.load(topics_path)\n247 | \n248 |     if subset == 'all':\n249 |         pass\n250 |     elif subset == 'train':\n251 |         X = X[:N_TRAIN, :]\n252 |         y = y[:N_TRAIN, :]\n253 |         sample_id = sample_id[:N_TRAIN]\n254 |     elif subset == 'test':\n255 |         X = X[N_TRAIN:, :]\n256 |         y = y[N_TRAIN:, :]\n257 |         sample_id = sample_id[N_TRAIN:]\n258 |     else:\n259 |         raise ValueError(\"Unknown subset parameter. Got '%s' instead of one\"\n260 |                          \" of ('all', 'train', test')\" % subset)\n261 | \n262 |     if shuffle:\n263 |         X, y, sample_id = shuffle_(X, y, sample_id, random_state=random_state)\n264 | \n265 |     module_path = dirname(__file__)\n266 |     with open(join(module_path, 'descr', 'rcv1.rst')) as rst_file:\n267 |         fdescr = rst_file.read()\n268 | \n269 |     if return_X_y:\n270 |         return X, y\n271 | \n272 |     return Bunch(data=X, target=y, sample_id=sample_id,\n273 |                  target_names=categories, DESCR=fdescr)\n```\n\nFound function `sklearn/utils/validation.py:_check_fit_params`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1344 | def _check_fit_params(X, fit_params, indices=None):\n1345 |     \"\"\"Check and validate the parameters passed during `fit`.\n1346 | \n1347 |     Parameters\n1348 |     ----------\n1349 |     X : array-like of shape (n_samples, n_features)\n1350 |         Data array.\n1351 | \n1352 |     fit_params : dict\n1353 |         Dictionary containing the parameters passed at fit.\n1354 | \n1355 |     indices : array-like of shape (n_samples,), default=None\n1356 |         Indices to be selected if the parameter has the same size as `X`.\n1357 | \n1358 |     Returns\n1359 |     -------\n1360 |     fit_params_validated : dict\n1361 |         Validated parameters. We ensure that the values support indexing.\n1362 |     \"\"\"\n1363 |     from . import _safe_indexing\n1364 |     fit_params_validated = {}\n1365 |     for param_key, param_value in fit_params.items():\n1366 |         if (not _is_arraylike(param_value) or\n1367 |                 _num_samples(param_value) != _num_samples(X)):\n1368 |             # Non-indexable pass-through (for now for backward-compatibility).\n1369 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n1370 |             fit_params_validated[param_key] = param_value\n1371 |         else:\n1372 |             # Any other fit_params should support indexing\n1373 |             # (e.g. for cross-validation).\n1374 |             fit_params_validated[param_key] = _make_indexable(param_value)\n1375 |             fit_params_validated[param_key] = _safe_indexing(\n1376 |                 fit_params_validated[param_key], indices\n1377 |             )\n1378 | \n1379 |     return fit_params_validated\n```\n\nFound file `benchmarks/bench_glm.py`.\nFound file `benchmarks/bench_mnist.py`.\nFound file `benchmarks/bench_glmnet.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"fetch_openml\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:fetch_openml`.\nSource: Match found for entity name `fetch_openml`.\n```\n664 | def fetch_openml(\n665 |     name: Optional[str] = None,\n666 |     *,\n667 |     version: Union[str, int] = 'active',\n668 |     data_id: Optional[int] = None,\n669 |     data_home: Optional[str] = None,\n670 |     target_column: Optional[Union[str, List]] = 'default-target',\n671 |     cache: bool = True,\n672 |     return_X_y: bool = False,\n673 |     as_frame: bool = False\n674 | ):\n675 |     \"\"\"Fetch dataset from openml by name or dataset id.\n676 | \n677 |     Datasets are uniquely identified by either an integer ID or by a\n678 |     combination of name and version (i.e. there might be multiple\n679 |     versions of the 'iris' dataset). Please give either name or data_id\n680 |     (not both). In case a name is given, a version can also be\n681 |     provided.\n682 | \n683 |     Read more in the :ref:`User Guide <openml>`.\n684 | \n685 |     .. versionadded:: 0.20\n686 | \n687 |     .. note:: EXPERIMENTAL\n688 | \n689 |         The API is experimental (particularly the return value structure),\n690 |         and might have small backward-incompatible changes in future releases.\n691 | \n692 |     Parameters\n693 |     ----------\n694 |     name : str, default=None\n695 |         String identifier of the dataset. Note that OpenML can have multiple\n696 |         datasets with the same name.\n697 | \n698 |     version : int or 'active', default='active'\n699 |         Version of the dataset. Can only be provided if also ``name`` is given.\n700 |         If 'active' the oldest version that's still active is used. Since\n701 |         there may be more than one active version of a dataset, and those\n702 |         versions may fundamentally be different from one another, setting an\n703 |         exact version is highly recommended.\n704 | \n705 |     data_id : int, default=None\n706 |         OpenML ID of the dataset. The most specific way of retrieving a\n707 |         dataset. If data_id is not given, name (and potential version) are\n708 |         used to obtain a dataset.\n709 | \n710 |     data_home : str, default=None\n711 |         Specify another download and cache folder for the data sets. By default\n712 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n713 | \n714 |     target_column : str, list or None, default='default-target'\n715 |         Specify the column name in the data to use as target. If\n716 |         'default-target', the standard target column a stored on the server\n717 |         is used. If ``None``, all columns are returned as data and the\n718 |         target is ``None``. If list (of strings), all columns with these names\n719 |         are returned as multi-target (Note: not all scikit-learn classifiers\n720 |         can handle all types of multi-output combinations)\n721 | \n722 |     cache : bool, default=True\n723 |         Whether to cache downloaded datasets using joblib.\n724 | \n725 |     return_X_y : bool, default=False\n726 |         If True, returns ``(data, target)`` instead of a Bunch object. See\n727 |         below for more information about the `data` and `target` objects.\n728 | \n729 |     as_frame : bool or 'auto', default=False\n730 |         If True, the data is a pandas DataFrame including columns with\n731 |         appropriate dtypes (numeric, string or categorical). The target is\n732 |         a pandas DataFrame or Series depending on the number of target_columns.\n733 |         The Bunch will contain a ``frame`` attribute with the target and the\n734 |         data. If ``return_X_y`` is True, then ``(data, target)`` will be pandas\n735 |         DataFrames or Series as describe above.\n736 |         If as_frame is 'auto', the data and target will be converted to\n737 |         DataFrame or Series as if as_frame is set to True, unless the dataset\n738 |         is stored in sparse format.\n739 | \n740 |     Returns\n741 |     -------\n742 | \n743 |     data : :class:`~sklearn.utils.Bunch`\n744 |         Dictionary-like object, with the following attributes.\n745 | \n746 |         data : np.array, scipy.sparse.csr_matrix of floats, or pandas DataFrame\n747 |             The feature matrix. Categorical features are encoded as ordinals.\n748 |         target : np.array, pandas Series or DataFrame\n749 |             The regression target or classification labels, if applicable.\n750 |             Dtype is float if numeric, and object if categorical. If\n751 |             ``as_frame`` is True, ``target`` is a pandas object.\n752 |         DESCR : str\n753 |             The full description of the dataset\n754 |         feature_names : list\n755 |             The names of the dataset columns\n756 |         target_names: list\n757 |             The names of the target columns\n758 | \n759 |         .. versionadded:: 0.22\n760 | \n761 |         categories : dict or None\n762 |             Maps each categorical feature name to a list of values, such\n763 |             that the value encoded as i is ith in the list. If ``as_frame``\n764 |             is True, this is None.\n765 |         details : dict\n766 |             More metadata from OpenML\n767 |         frame : pandas DataFrame\n768 |             Only present when `as_frame=True`. DataFrame with ``data`` and\n769 |             ``target``.\n770 | \n771 |     (data, target) : tuple if ``return_X_y`` is True\n772 | \n773 |         .. note:: EXPERIMENTAL\n774 | \n775 |             This interface is **experimental** and subsequent releases may\n776 |             change attributes without notice (although there should only be\n777 |             minor changes to ``data`` and ``target``).\n778 | \n779 |         Missing values in the 'data' are represented as NaN's. Missing values\n780 |         in 'target' are represented as NaN's (numerical target) or None\n781 |         (categorical target)\n782 |     \"\"\"\n783 |     data_home = get_data_home(data_home=data_home)\n784 |     data_home = join(data_home, 'openml')\n785 |     if cache is False:\n786 |         # no caching will be applied\n787 |         data_home = None\n788 | \n789 |     # check valid function arguments. data_id XOR (name, version) should be\n790 |     # provided\n791 |     if name is not None:\n792 |         # OpenML is case-insensitive, but the caching mechanism is not\n793 |         # convert all data names (str) to lower case\n794 |         name = name.lower()\n795 |         if data_id is not None:\n796 |             raise ValueError(\n797 |                 \"Dataset data_id={} and name={} passed, but you can only \"\n798 |                 \"specify a numeric data_id or a name, not \"\n799 |                 \"both.\".format(data_id, name))\n800 |         data_info = _get_data_info_by_name(name, version, data_home)\n801 |         data_id = data_info['did']\n802 |     elif data_id is not None:\n803 |         # from the previous if statement, it is given that name is None\n804 |         if version != \"active\":\n805 |             raise ValueError(\n806 |                 \"Dataset data_id={} and version={} passed, but you can only \"\n807 |                 \"specify a numeric data_id or a version, not \"\n808 |                 \"both.\".format(data_id, name))\n809 |     else:\n810 |         raise ValueError(\n811 |             \"Neither name nor data_id are provided. Please provide name or \"\n812 |             \"data_id.\")\n813 | \n814 |     data_description = _get_data_description_by_id(data_id, data_home)\n815 |     if data_description['status'] != \"active\":\n816 |         warn(\"Version {} of dataset {} is inactive, meaning that issues have \"\n817 |              \"been found in the dataset. Try using a newer version from \"\n818 |              \"this URL: {}\".format(\n819 |                 data_description['version'],\n820 |                 data_description['name'],\n821 |                 data_description['url']))\n822 |     if 'error' in data_description:\n823 |         warn(\"OpenML registered a problem with the dataset. It might be \"\n824 |              \"unusable. Error: {}\".format(data_description['error']))\n825 |     if 'warning' in data_description:\n826 |         warn(\"OpenML raised a warning on the dataset. It might be \"\n827 |              \"unusable. Warning: {}\".format(data_description['warning']))\n828 | \n829 |     return_sparse = False\n830 |     if data_description['format'].lower() == 'sparse_arff':\n831 |         return_sparse = True\n832 | \n833 |     if as_frame == 'auto':\n834 |         as_frame = not return_sparse\n835 | \n836 |     if as_frame and return_sparse:\n837 |         raise ValueError('Cannot return dataframe with sparse data')\n838 | \n839 |     # download data features, meta-info about column types\n840 |     features_list = _get_data_features(data_id, data_home)\n841 | \n842 |     if not as_frame:\n843 |         for feature in features_list:\n844 |             if 'true' in (feature['is_ignore'], feature['is_row_identifier']):\n845 |                 continue\n846 |             if feature['data_type'] == 'string':\n847 |                 raise ValueError('STRING attributes are not supported for '\n848 |                                  'array representation. Try as_frame=True')\n849 | \n850 |     if target_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |                         \"Should be str, list or None. Got: \"\n866 |                         \"{}\".format(type(target_column)))\n867 |     data_columns = _valid_data_column_names(features_list,\n868 |                                             target_columns)\n869 | \n870 |     shape: Optional[Tuple[int, i