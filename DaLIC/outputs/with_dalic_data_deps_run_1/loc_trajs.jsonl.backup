nents.extend(\n373 |                     docstring._docstring_components  # pyright: ignore[reportAttributeAccessIssue]\n374 |                 )\n375 |             elif isinstance(docstring, str) or docstring.__doc__:\n376 |                 docstring_components.append(docstring)\n377 | \n378 |         params_applied = [\n379 |             component.format(**params)\n380 |             if isinstance(component, str) and len(params) > 0\n381 |             else component\n382 |             for component in docstring_components\n383 |         ]\n384 | \n385 |         decorated.__doc__ = \"\".join(\n386 |             [\n387 |                 component\n388 |                 if isinstance(component, str)\n389 |                 else dedent(component.__doc__ or \"\")\n390 |                 for component in params_applied\n391 |             ]\n392 |         )\n393 | \n394 |         # error: \"F\" has no attribute \"_docstring_components\"\n395 |         decorated._docstring_components = (  # type: ignore[attr-defined]\n396 |             docstring_components\n397 |         )\n398 |         return decorated\n399 | \n400 |     return decorator\n```\n\nFound function `doc/make.py:main`.\nSource: Retrieved entity using keyword search (bm25).\n```\n302 | def main():\n303 |     cmds = [method for method in dir(DocBuilder) if not method.startswith(\"_\")]\n304 | \n305 |     joined = \",\".join(cmds)\n306 |     argparser = argparse.ArgumentParser(\n307 |         description=\"pandas documentation builder\", epilog=f\"Commands: {joined}\"\n308 |     )\n309 | \n310 |     joined = \", \".join(cmds)\n311 |     argparser.add_argument(\n312 |         \"command\", nargs=\"?\", default=\"html\", help=f\"command to run: {joined}\"\n313 |     )\n314 |     argparser.add_argument(\n315 |         \"--num-jobs\", default=\"auto\", help=\"number of jobs used by sphinx-build\"\n316 |     )\n317 |     argparser.add_argument(\n318 |         \"--no-api\", default=False, help=\"omit api and autosummary\",