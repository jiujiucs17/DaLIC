|             self.colormap = colormap\n248 | \n249 |         self.table = table\n250 |         self.include_bool = include_bool\n251 | \n252 |         self.kwds = kwds\n253 | \n254 |         self._validate_color_args()\n255 | \n256 |     def _validate_color_args(self):\n257 |         if (\n258 |             \"color\" in self.kwds\n259 |             and self.nseries == 1\n260 |             and not is_list_like(self.kwds[\"color\"])\n261 |         ):\n262 |             # support series.plot(color='green')\n263 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n264 | \n265 |         if (\n266 |             \"color\" in self.kwds\n267 |             and isinstance(self.kwds[\"color\"], tuple)\n268 |             and self.nseries == 1\n269 |             and len(self.kwds[\"color\"]) in (3, 4)\n270 |         ):\n271 |             # support RGB and RGBA tuples in series plot\n272 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n273 | \n274 |         if (\n275 |             \"color\" in self.kwds or \"colors\" in self.kwds\n276 |         ) and self.colormap is not None:\n277 |             warnings.warn(\n278 |                 \"'color' and 'colormap' cannot be used simultaneously. Using 'color'\"\n279 |             )\n280 | \n281 |         if \"color\" in self.kwds and self.style is not None:\n282 |             if is_list_like(self.style):\n283 |                 styles = self.style\n284 |             else:\n285 |                 styles = [self.style]\n286 |             # need only a single match\n287 |             for s in styles:\n288 |                 if _color_in_style(s):\n289 |                     raise ValueError(\n290 |                         \"Cannot pass 'style' string with a color symbol and \"\n291 |                         \"'color' keyword argument. Please use one or the \"\n292 |                         \"other or pass 'style' without a color symbol\"\n293 |                     )\n294 | \n295 |     def _iter_data(self, data=None, keep_ind