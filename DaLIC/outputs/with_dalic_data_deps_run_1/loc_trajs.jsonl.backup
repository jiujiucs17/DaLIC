py`.\nSource: Exact match found for entity name `sklearn/utils/_tags.py`.\n```\n  1 | from __future__ import annotations\n  2 | \n  3 | import warnings\n  4 | from dataclasses import dataclass, field\n  5 | \n  6 | from .fixes import _dataclass_args\n  7 | \n  8 | # Authors: The scikit-learn developers\n  9 | # SPDX-License-Identifier: BSD-3-Clause\n 10 | \n 11 | \n 12 | @dataclass(**_dataclass_args())\n 13 | class InputTags:\n 14 |     \"\"\"Tags for the input data.\n 15 | \n 16 |     Parameters\n 17 |     ----------\n 18 |     one_d_array : bool, default=False\n 19 |         Whether the input can be a 1D array.\n 20 | \n 21 |     two_d_array : bool, default=True\n 22 |         Whether the input can be a 2D array. Note that most common\n 23 |         tests currently run only if this flag is set to ``True``.\n 24 | \n 25 |     three_d_array : bool, default=False\n 26 |         Whether the input can be a 3D array.\n 27 | \n 28 |     sparse : bool, default=False\n 29 |         Whether the input can be a sparse matrix.\n 30 | \n 31 |     categorical : bool, default=False\n 32 |         Whether the input can be categorical.\n 33 | \n 34 |     string : bool, default=False\n 35 |         Whether the input can be an array-like of strings.\n 36 | \n 37 |     dict : bool, default=False\n 38 |         Whether the input can be a dictionary.\n 39 | \n 40 |     positive_only : bool, default=False\n 41 |         Whether the estimator requires positive X.\n 42 | \n 43 |     allow_nan : bool, default=False\n 44 |         Whether the estimator supports data with missing values encoded as `np.nan`.\n 45 | \n 46 |     pairwise : bool, default=False\n 47 |         This boolean attribute indicates whether the data (`X`),\n 48 |         :term:`fit` and similar methods consists of pairwise measures\n 49 |         over samples rather than a feature representation for each\n 50 |         sample.  It is usually `True` where an estimator has a\n 51 |         `metric` or `affinity` or `kernel` parameter with value\n 52 |         'precomputed'. Its primary purpose is to support a\n 53 |         :term:`meta-estimator` or a cross validation procedure that\n 54 |         extracts a sub-sample of data intended for a pairwise\n 55 |         estimator, where the data needs to be indexed on both axes.\n 56 |         Specifically, this tag is used by\n 57 |         `sklearn.utils.metaestimators._safe_split` to slice rows and\n 58 |         columns.\n 59 |     \"\"\"\n 60 | \n 61 |     one_d_array: bool = False\n 62 |     two_d_array: bool = True\n 63 |     three_d_array: bool = False\n 64 |     sparse: bool = False\n 65 |     categorical: bool = False\n 66 |     string: bool = False\n 67 |     dict: bool = False\n 68 |     positive_only: bool = False\n 69 |     allow_nan: bool = False\n 70 |     pairwise: bool = False\n 71 | \n 72 | \n 73 | @dataclass(**_dataclass_args())\n 74 | class TargetTags:\n 75 |     \"\"\"Tags for the target data.\n 76 | \n 77 |     Parameters\n 78 |     ----------\n 79 |     required : bool\n 80 |         Whether the estimator requires y to be passed to `fit`,\n 81 |         `fit_predict` or `fit_transform` methods. The tag is ``True``\n 82 |         for estimators inheriting from `~sklearn.base.RegressorMixin`\n 83 |         and `~sklearn.base.ClassifierMixin`.\n 84 | \n 85 |     one_d_labels : bool, default=False\n 86 |         Whether the input is a 1D labels (y).\n 87 | \n 88 |     two_d_labels : bool, default=False\n 89 |         Whether the input is a 2D labels (y).\n 90 | \n 91 |     positive_only : bool, default=False\n 92 |         Whether the estimator requires a positive y (only applicable\n 93 |         for regression).\n 94 | \n 95 |     multi_output : bool, default=False\n 96 |         Whether a regressor supports multi-target outputs or a classifier supports\n 97 |         multi-class multi-output.\n 98 | \n 99 |     single_output : bool, default=True\n100 |         Whether the target can be single-output. This can be ``False`` if the\n101 |         estimator supports only multi-output cases.\n102 |     \"\"\"\n103 | \n104 |     required: bool\n105 |     one_d_labels: bool = False\n106 |     two_d_labels: bool = False\n107 |     positive_only: bool = False\n108 |     multi_output: bool = False\n109 |     single_output: bool = True\n110 | \n111 | \n112 | @dataclass(**_dataclass_args())\n113 | class TransformerTags:\n114 |     \"\"\"Tags for the transformer.\n115 | \n116 |     Parameters\n117 |     ----------\n118 |     preserves_dtype : list[str], default=[\"float64\"]\n119 |         Applies only on transformers. It corresponds to the data types\n120 |         which will be preserved such that `X_trans.dtype` is the same\n121 |         as `X.dtype` after calling `transformer.transform(X)`. If this\n122 |         list is empty, then the transformer is not expected to\n123 |         preserve the data type. The first value in the list is\n124 |         considered as the default data type, corresponding to the data\n125 |         type of the output when the input data type is not going to be\n126 |         preserved.\n127 |     \"\"\"\n128 | \n129 |     preserves_dtype: list[str] = field(default_factory=lambda: [\"float64\"])\n130 | \n131 | \n132 | @dataclass(**_dataclass_args())\n133 | class ClassifierTags:\n134 |     \"\"\"Tags for the classifier.\n135 | \n136 |     Parameters\n137 |     ----------\n138 |     poor_score : bool, default=False\n139 |         Whether the estimator fails to provide a \"reasonable\" test-set\n140 |         score, which currently for classification is an accuracy of\n141 |         0.83 on ``make_blobs(n_samples=300, random_state=0)``. The\n142 |         datasets and values are based on current estimators in scikit-learn\n143 |         and might be replaced by something more systematic.\n144 | \n145 |     multi_class : bool, default=True\n146 |         Whether the classifier can handle multi-class\n147 |         classification. Note that all classifiers support binary\n148 |         classification. Therefore this flag indicates whether the\n149 |         classifier is a binary-classifier-only or not.\n150 | \n151 |     multi_label : bool, default=False\n152 |         Whether the classifier supports multi-label output.\n153 |     \"\"\"\n154 | \n155 |     poor_score: bool = False\n156 |     multi_class: bool = True\n157 |     multi_label: bool = False\n158 | \n159 | \n160 | @dataclass(**_dataclass_args())\n161 | class RegressorTags:\n162 |     \"\"\"Tags for the regressor.\n163 | \n164 |     Parameters\n165 |     ----------\n166 |     poor_score : bool, default=False\n167 |         Whether the estimator fails to provide a \"reasonable\" test-set\n168 |         score, which currently for regression is an R2 of 0.5 on\n169 |         ``make_regression(n_samples=200, n_features=10,\n170 |         n_informative=1, bias=5.0, noise=20, random_state=42)``. The\n171 |         dataset and values are based on current estimators in scikit-learn\n172 |         and might be replaced by something more systematic.\n173 | \n174 |     multi_label : bool, default=False\n175 |         Whether the regressor supports multilabel output.\n176 |     \"\"\"\n177 | \n178 |     poor_score: bool = False\n179 |     multi_label: bool = False\n180 | \n181 | \n182 | @dataclass(**_dataclass_args())\n183 | class Tags:\n184 |     \"\"\"Tags for the estimator.\n185 | \n186 |     See :ref:`estimator_tags` for more information.\n187 | \n188 |     Parameters\n189 |     ----------\n190 |     estimator_type : str or None\n191 |         The type of the estimator. Can be one of:\n192 |         - \"classifier\"\n193 |         - \"regressor\"\n194 |         - \"transformer\"\n195 |         - \"clusterer\"\n196 |         - \"outlier_detector\"\n197 |         - \"density_estimator\"\n198 | \n199 |     target_tags : :class:`TargetTags`\n200 |         The target(y) tags.\n201 | \n202 |     transformer_tags : :class:`TransformerTags` or None\n203 |         The transformer tags.\n204 | \n205 |     classifier_tags : :class:`ClassifierTags` or None\n206 |         The classifier tags.\n207 | \n208 |     regressor_tags : :class:`RegressorTags` or None\n209 |         The regressor tags.\n210 | \n211 |     array_api_support : bool, default=False\n212 |         Whether the estimator supports Array API compatible inputs.\n213 | \n214 |     no_validation : bool, default=False\n215 |         Whether the estimator skips input-validation. This is only meant for\n216 |         stateless and dummy transformers!\n217 | \n218 |     non_deterministic : bool, default=False\n219 |         Whether the estimator is not deterministic given a fixed ``random_state``.\n220 | \n221 |     requires_fit : bool, default=True\n222 |         Whether the estimator requires to be fitted before calling one of\n223 |         `transform`, `predict`, `predict_proba`, or `decision_function`.\n224 | \n225 |     _skip_test : bool, default=False\n226 |         Whether to skip common tests entirely. Don't use this unless\n227 |         you have a *very good* reason.\n228 | \n229 |     input_tags : :class:`InputTags`\n230 |         The input data(X) tags.\n231 |     \"\"\"\n232 | \n233 |     estimator_type: str | None\n234 |     target_tags: TargetTags\n235 |     transformer_tags: TransformerTags | None = None\n236 |     classifier_tags: ClassifierTags | None = None\n237 |     regressor_tags: RegressorTags | None = None\n238 |     array_api_support: bool = False\n239 |     no_validation: bool = False\n240 |     non_deterministic: bool = False\n241 |     requires_fit: bool = True\n242 |     _skip_test: bool = False\n243 |     input_tags: InputTags = field(default_factory=InputTags)\n244 | \n245 | \n246 | # TODO(1.8): Remove this function\n247 | def default_tags(estimator) -> Tags:\n248 |     \"\"\"Get the default tags for an estimator.\n249 | \n250 |     This ignores any ``__sklearn_tags__`` method that the estimator may have.\n251 | \n252 |     If the estimator is a classifier or a regressor, ``target_tags.required``\n253 |     will be set to ``True``, otherwise it will be set to ``False``.\n254 | \n255 |     ``transformer_tags`` will be set to :class:`~.sklearn.utils. TransformerTags` if the\n256 |     estimator has a ``transform`` or ``fit_transform`` method, otherwise it will be set\n257 |     to ``None``.\n258 | \n259 |     ``classifier_tags`` will be set to :class:`~.sklearn.utils.ClassifierTags` if the\n260 |     estimator is a classifier, otherwise it will be set to ``None``.\n261 |     a classifier, otherwise it will be set to ``None``.\n262 | \n263 |     ``regressor_tags`` will be set to :class:`~.sklearn.utils.RegressorTags` if the\n264 |     estimator is a regressor, otherwise it will be set to ``None``.\n265 | \n266 |     Parameters\n267 |     ----------\n268 |     estimator : estimator object\n269 |         The estimator for which to get the default tags.\n270 | \n271 |     Returns\n272 |     -------\n273 |     tags : Tags\n274 |         The default tags for the estimator.\n275 |     \"\"\"\n276 |     est_is_classifier = getattr(estimator, \"_estimator_type\", None) == \"classifier\"\n277 |     est_is_regressor = getattr(estimator, \"_estimator_type\", None) == \"regressor\"\n278 |     target_required = est_is_classifier or est_is_regressor\n279 | \n280 |     return Tags(\n281 |         estimator_type=getattr(estimator, \"_estimator_type\", None),\n282 |         target_tags=TargetTags(required=target_required),\n283 |         transformer_tags=(\n284 |             TransformerTags()\n285 |             if hasattr(estimator, \"transform\") or hasattr(estimator, \"fit_transform\")\n286 |             else None\n287 |         ),\n288 |         classifier_tags=ClassifierTags() if est_is_classifier else None,\n289 |         regressor_tags=RegressorTags() if est_is_regressor else None,\n290 |     )\n291 | \n292 | \n293 | def get_tags(estimator) -> Tags:\n294 |     \"\"\"Get estimator tags.\n295 | \n296 |     :class:`~sklearn.BaseEstimator` provides the estimator tags machinery.\n297 |     However, if an estimator does not inherit from this base class, we should\n298 |     fall-back to the default tags.\n299 | \n300 |     For scikit-learn built-in estimators, we should still rely on\n301 |     `self.__sklearn_tags__()`. `get_tags(est)` should be used when we\n302 |     are not sure where `est` comes from: typically\n303 |     `get_tags(self.estimator)` where `self` is a meta-estimator, or in\n304 |     the common checks.\n305 | \n306 |     .. versionadded:: 1.6\n307 | \n308 |     Parameters\n309 |     ----------\n310 |     estimator : estimator object\n311 |         The estimator from which to get the tag.\n312 | \n313 |     Returns\n314 |     -------\n315 |     tags : :class:`~.sklearn.utils.Tags`\n316 |         The estimator tags.\n317 |     \"\"\"\n318 | \n319 |     if hasattr(estimator, \"__sklearn_tags__\"):\n320 |         tags = estimator.__sklearn_tags__()\n321 |     else:\n322 |         warnings.warn(\n323 |             f\"Estimator {estimator} has no __sklearn_tags__ attribute, which is \"\n324 |             \"defined in `sklearn.base.BaseEstimator`. This will raise an error in \"\n325 |             \"scikit-learn 1.8. Please define the __sklearn_tags__ method, or inherit \"\n326 |             \"from `sklearn.base.BaseEstimator` and other appropriate mixins such as \"\n327 |             \"`sklearn.base.TransformerMixin`, `sklearn.base.ClassifierMixin`, \"\n328 |             \"`sklearn.base.RegressorMixin`, and `sklearn.base.ClusterMixin`, and \"\n329 |             \"`sklearn.base.OutlierMixin`.\",\n330 |             category=FutureWarning,\n331 |         )\n332 |         tags = default_tags(estimator)\n333 | \n334 |     return tags\n335 | \n```\n"}, {"content": "Let me analyze the dependencies of the tagging system:\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/utils/_tags.py']</parameter>\n<parameter=direction>both</parameter>\n<parameter=traversal_depth>2</p