|     \"\"\"\n185 | \n186 |     def add_delegate_accessors(cls):\n187 |         cls._add_delegate_accessors(\n188 |             delegate,\n189 |             accessors,\n190 |             typ,\n191 |             overwrite=overwrite,\n192 |             accessor_mapping=accessor_mapping,\n193 |             raise_on_missing=raise_on_missing,\n194 |         )\n195 |         return cls\n196 | \n197 |     return add_delegate_accessors\n198 | \n199 | \n200 | class Accessor:\n201 |     \"\"\"\n202 |     Custom property-like object.\n203 | \n204 |     A descriptor for accessors.\n205 | \n206 |     Parameters\n207 |     ----------\n208 |     name : str\n209 |         Namespace that will be accessed under, e.g. ``df.foo``.\n210 |     accessor : cls\n211 |         Class with the extension methods.\n212 | \n213 |     Notes\n214 |     -----\n215 |     For accessor, The class's __init__ method assumes that one of\n216 |     ``Series``, ``DataFrame`` or ``Index`` as the\n217 |     single argument ``data``.\n218 |     \"\"\"\n219 | \n220 |     def __init__(self, name: str, accessor) -> None:\n221 |         self._name = name\n222 |         self._accessor = accessor\n223 | \n224 |     def __get__(self, obj, cls):\n225 |         if obj is None:\n226 |             # we're accessing the attribute of the class, i.e., Dataset.geo\n227 |             return self._accessor\n228 |         return self._accessor(obj)\n229 | \n230 | \n231 | # Alias kept for downstream libraries\n232 | # TODO: Deprecate as name is now misleading\n233 | CachedAccessor = Accessor\n234 | \n235 | \n236 | @doc(klass=\"\", examples=\"\", others=\"\")\n237 | def _register_accessor(\n238 |     name: str, cls: type[NDFrame | Index]\n239 | ) -> Callable[[TypeT], TypeT]:\n240 |     \"\"\"\n241 |     Register a custom accessor on {klass} objects.\n242 | \n243 |     Parameters\n244 |     ----------\n245 |     name : str\n246 |         Name under which the accessor should be registered. A warning is issued\n247 |         if this