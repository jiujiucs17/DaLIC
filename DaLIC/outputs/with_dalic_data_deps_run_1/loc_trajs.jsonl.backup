d using Fisher's definition of\n7191 |         kurtosis (kurtosis of normal == 0.0). Normalized by N-1.\n7192 | \n7193 |         Parameters\n7194 |         ----------\n7195 |         axis : {index (0)}\n7196 |             Axis for the function to be applied on.\n7197 |             For `Series` this parameter is unused and defaults to 0.\n7198 | \n7199 |             For DataFrames, specifying ``axis=None`` will apply the aggregation\n7200 |             across both axes.\n7201 | \n7202 |             .. versionadded:: 2.0.0\n7203 | \n7204 |         skipna : bool, default True\n7205 |             Exclude NA/null values when computing the result.\n7206 |         numeric_only : bool, default False\n7207 |             Include only float, int, boolean columns.\n7208 | \n7209 |         **kwargs\n7210 |             Additional keyword arguments to be passed to the function.\n7211 | \n7212 |         Returns\n7213 |         -------\n7214 |         scalar\n7215 |             Unbiased kurtosis.\n7216 | \n7217 |         See Also\n7218 |         --------\n7219 |         Series.skew : Return unbiased skew over requested axis.\n7220 |         Series.var : Return unbiased variance over requested axis.\n7221 |         Series.std : Return unbiased standard deviation over requested axis.\n7222 | \n7223 |         Examples\n7224 |         --------\n7225 |         >>> s = pd.Series([1, 2, 2, 3], index=[\"cat\", \"dog\", \"dog\", \"mouse\"])\n7226 |         >>> s\n7227 |         cat    1\n7228 |         dog    2\n7229 |         dog    2\n7230 |         mouse  3\n7231 |         dtype: int64\n7232 |         >>> s.kurt()\n7233 |         1.5\n7234 |         \"\"\"\n7235 |         return NDFrame.kurt(\n7236 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n7237 |         )\n7238 | \n7239 |     kurtosis = kurt\n7240 |     product = prod\n7241 | \n7242 |     @doc(make_doc(\"cummin\", ndim=1))\n7243 |     def cummin(self, axis: Axis = 0, skipna: bool = True, *args, **