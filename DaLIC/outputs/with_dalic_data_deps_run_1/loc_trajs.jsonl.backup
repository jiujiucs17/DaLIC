10 |         # If bins are not specified either explicitly or via range,\n7011 |         # we need to figure out the range required for all datasets,\n7012 |         # and supply that to np.histogram.\n7013 |         if not input_empty and len(x) > 1:\n7014 |             if weights is not None:\n7015 |                 _w = np.concatenate(w)\n7016 |             else:\n7017 |                 _w = None\n7018 |             bins = np.histogram_bin_edges(\n7019 |                 np.concatenate(x), bins, bin_range, _w)\n7020 |         else:\n7021 |             hist_kwargs['range'] = bin_range\n7022 | \n7023 |         density = bool(density)\n7024 |         if density and not stacked:\n7025 |             hist_kwargs['density'] = density\n7026 | \n7027 |         # List to store all the top coordinates of the histograms\n7028 |         tops = []  # Will have shape (n_datasets, n_bins).\n7029 |         # Loop through datasets\n7030 |         for i in range(nx):\n7031 |             # this will automatically overwrite bins,\n7032 |             # so that each histogram uses the same bins\n7033 |             m, bins = np.histogram(x[i], bins, weights=w[i], **hist_kwargs)\n7034 |             tops.append(m)\n7035 |         tops = np.array(tops, float)  # causes problems later if it's an int\n7036 |         bins = np.array(bins, float)  # causes problems if float16\n7037 |         if stacked:\n7038 |             tops = tops.cumsum(axis=0)\n7039 |             # If a stacked density plot, normalize so the area of all the\n7040 |             # stacked histograms together is 1\n7041 |             if density:\n7042 |                 tops = (tops / np.diff(bins)) / tops[-1].sum()\n7043 |         if cumulative:\n7044 |             slc = slice(None)\n7045 |             if isinstance(cumulative, Number) and cumulative < 0:\n7046 |                 slc = slice(None, None, -1)\n7047 |             if density:\n7048 |                 tops = (tops * np.diff(bins))[:, slc].cumsum(axis=1)[:, slc]\n7049 |             else:\n7050 |                 tops = tops[:, slc].cumsum(axis=1)[:, slc]\n7051 | \n7052 |         patches = []\n7053 | \n7054 |         if histtype.startswith('bar'):\n7055 | \n7056 |             totwidth = np.diff(bins)\n7057 | \n7058 |             if rwidth is not None:\n7059 |                 dr = np.clip(rwidth, 0, 1)\n7060 |             elif (len(tops) > 1 and\n7061 |                   ((not stacked) or mpl.rcParams['_internal.classic_mode'])):\n7062 |                 dr = 0.8\n7063 |             else:\n7064 |                 dr = 1.0\n7065 | \n7066 |             if histtype == 'bar' and not stacked:\n7067 |                 width = dr * totwidth / nx\n7068 |                 dw = width\n7069 |                 boffset = -0.5 * dr * totwidth * (1 - 1 / nx)\n7070 |             elif histtype == 'barstacked' or stacked:\n7071 |                 width = dr * totwidth\n7072 |                 boffset, dw = 0.0, 0.0\n7073 | \n7074 |             if align == 'mid':\n7075 |                 boffset += 0.5 * totwidth\n7076 |             elif align == 'right':\n7077 |                 boffset += totwidth\n7078 | \n7079 |             if orientation == 'horizontal':\n7080 |                 _barfunc = self.barh\n7081 |                 bottom_kwarg = 'left'\n7082 |             else:  # orientation == 'vertical'\n7083 |                 _barfunc = self.bar\n7084 |                 bottom_kwarg = 'bottom'\n7085 | \n7086 |             for top, color in zip(tops, colors):\n7087 |                 if bottom is None:\n7088 |                     bottom = np.zeros(len(top))\n7089 |                 if stacked:\n7090 |                     height = top - bottom\n7091 |                 else:\n7092 |                     height = top\n7093 |                 bars = _barfunc(bins[:-1]+boffset, height, width,\n7094 |                                 align='center', log=log,\n7095 |                                 color=color, **{bottom_kwarg: bottom})\n7096 |                 patches.append(bars)\n7097 |                 if stacked:\n7098 |                     bottom = top\n7099 |                 boffset += dw\n7100 |             # Remove stickies from all bars but the lowest ones, as otherwise\n7101 |             # margin expansion would be unable to cross the stickies in the\n7102 |             # middle of the bars.\n7103 |             for bars in patches[1:]:\n7104 |                 for patch in bars:\n7105 |                     patch.sticky_edges.x[:] = patch.sticky_edges.y[:] = []\n7106 | \n7107 |         elif histtype.startswith('step'):\n7108 |             # these define the perimeter of the polygon\n7109 |             x = np.zeros(4 * len(bins) - 3)\n7110 |             y = np.zeros(4 * len(bins) - 3)\n7111 | \n7112 |             x[0:2*len(bins)-1:2], x[1:2*len(bins)-1:2] = bins, bins[:-1]\n7113 |             x[2*len(bins)-1:] = x[1:2*len(bins)-1][::-1]\n7114 | \n7115 |             if bottom is None:\n7116 |                 bottom = 0\n7117 | \n7118 |             y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = bottom\n7119 |             y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7120 | \n7121 |             if log:\n7122 |                 if orientation == 'horizontal':\n7123 |                     self.set_xscale('log', nonpositive='clip')\n7124 |                 else:  # orientation == 'vertical'\n7125 |                     self.set_yscale('log', nonpositive='clip')\n7126 | \n7127 |             if align == 'left':\n7128 |                 x -= 0.5*(bins[1]-bins[0])\n7129 |             elif align == 'right':\n7130 |                 x += 0.5*(bins[1]-bins[0])\n7131 | \n7132 |             # If fill kwarg is set, it will be passed to the patch collection,\n7133 |             # overriding this\n7134 |             fill = (histtype == 'stepfilled')\n7135 | \n7136 |             xvals, yvals = [], []\n7137 |             for top in tops:\n7138 |                 if stacked:\n7139 |                     # top of the previous polygon becomes the bottom\n7140 |                     y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7141 |                 # set the top of this polygon\n7142 |                 y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = top + bottom\n7143 | \n7144 |                 # The starting point of the polygon has not yet been\n7145 |                 # updated. So far only the endpoint was adjusted. This\n7146 |                 # assignment closes the polygon. The redundant endpoint is\n7147 |                 # later discarded (for step and stepfilled).\n7148 |                 y[0] = y[-1]\n7149 | \n7150 |                 if orientation == 'horizontal':\n7151 |                     xvals.append(y.copy())\n7152 |                     yvals.append(x.copy())\n7153 |                 else:\n7154 |                     xvals.append(x.copy())\n7155 |                     yvals.append(y.copy())\n7156 | \n7157 |             # stepfill is closed, step is not\n7158 |             split = -1 if fill else 2 * len(bins)\n7159 |             # add patches in reverse order so that when stacking,\n7160 |             # items lower in the stack are plotted on top of\n7161 |             # items higher in the stack\n7162 |             for x, y, color in reversed(list(zip(xvals, yvals, colors))):\n7163 |                 patches.append(self.fill(\n7164 |                     x[:split], y[:split],\n7165 |                     closed=True if fill else None,\n7166 |                     facecolor=color,\n7167 |                     edgecolor=None if fill else color,\n7168 |                     fill=fill if fill else None,\n7169 |                     zorder=None if fill else mlines.Line2D.zorder))\n7170 |             for patch_list in patches:\n7171 |                 for patch in patch_list:\n7172 |                     if orientation == 'vertical':\n7173 |                         patch.sticky_edges.y.append(0)\n7174 |                     elif orientation == 'horizontal':\n7175 |                         patch.sticky_edges.x.append(0)\n7176 | \n7177 |             # we return patches, so put it back in the expected order\n7178 |             patches.reverse()\n7179 | \n7180 |         # If None, make all labels None (via zip_longest below); otherwise,\n7181 |         # cast each element to str, but keep a single str as it.\n7182 |         labels = [] if label is None else np.atleast_1d(np.asarray(label, str))\n7183 | \n7184 |         if histtype == \"step\":\n7185 |             edgecolors = itertools.cycle(np.atleast_1d(kwargs.get('edgecolor',\n7186 |                                                                   colors)))\n7187 |         else:\n7188 |             edgecolors = itertools.cycle(np.atleast_1d(kwargs.get(\"edgecolor\", None)))\n7189 | \n7190 |         facecolors = itertools.cycle(np.atleast_1d(kwargs.get('facecolor', colors)))\n7191 |         hatches = itertools.cycle(np.atleast_1d(kwargs.get('hatch', None)))\n7192 |         linewidths = itertools.cycle(np.atleast_1d(kwargs.get('linewidth', None)))\n7193 |         linestyles = itertools.cycle(np.atleast_1d(kwargs.get('linestyle', None)))\n7194 | \n7195 |         for patch, lbl in itertools.zip_longest(patches, labels):\n7196 |             if not patch:\n7197 |                 continue\n7198 |             p = patch[0]\n7199 |             kwargs.update({\n7200 |                 'hatch': next(hatches),\n7201 |                 'linewidth': next(linewidths),\n7202 |                 'linestyle': next(linestyles),\n7203 |                 'edgecolor': next(edgecolors),\n7204 |                 'facecolor': next(facecolors),\n7205 |             })\n7206 |             p._internal_update(kwargs)\n7207 |             if lbl is not None:\n7208 |                 p.set_label(lbl)\n7209 |             for p in patch[1:]:\n7210 |                 p._internal_update(kwargs)\n7211 |                 p.set_label('_nolegend_')\n7212 | \n7213 |         if nx == 1:\n7214 |             return tops[0], bins, patches[0]\n7215 |         else:\n7216 |             patch_type