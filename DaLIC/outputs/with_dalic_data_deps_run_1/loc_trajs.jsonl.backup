nml.py:_get_data_qualities\nsklearn/datasets/_openml.py:_valid_data_column_names\nsklearn/datasets/_openml.py:_load_arff_response\nsklearn/datasets/_openml.py:_feature_to_dtype\nsklearn/datasets/_openml.py:_sparse_data_to_array\nsklearn/datasets/_openml.py:_retry_with_clean_cache\n##Searching for term \"fetch_openml\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:fetch_openml`.\nSource: Match found for entity name `fetch_openml`.\n```\n664 | def fetch_openml(\n665 |     name: Optional[str] = None,\n666 |     *,\n667 |     version: Union[str, int] = 'active',\n668 |     data_id: Optional[int] = None,\n669 |     data_home: Optional[str] = None,\n670 |     target_column: Optional[Union[str, List]] = 'default-target',\n671 |     cache: bool = True,\n672 |     return_X_y: bool = False,\n673 |     as_frame: bool = False\n674 | ):\n675 |     \"\"\"Fetch dataset from openml by name or dataset id.\n676 | \n677 |     Datasets are uniquely identified by either an integer ID or by a\n678 |     combination of name and version (i.e. there might be multiple\n679 |     versions of the 'iris' dataset). Please give either name or data_id\n680 |     (not both). In case a name is given, a version can also be\n681 |     provided.\n682 | \n683 |     Read more in the :ref:`User Guide <openml>`.\n684 | \n685 |     .. versionadded:: 0.20\n686 | \n687 |     .. note:: EXPERIMENTAL\n688 | \n689 |         The API is experimental (particularly the return value structure),\n690 |         and might have small backward-incompatible changes in future releases.\n691 | \n692 |     Parameters\n693 |     ----------\n694 |     name : str, default=None\n695 |         String identifier of the dataset. Note that OpenML can have multiple\n696 |         datasets with the same name.\n697 | \n698 |     version : int or 'active', default='active'\n699 |         Version of the dataset. Can only be provided if also ``name`` is given.\n700 |         If 'active' the oldest version that's still active is used. Since\n701 |         there may be more than one active version of a dataset, and those\n702 |         versions may fundamentally be different from one another, setting an\n703 |         exact version is highly recommended.\n704 | \n705 |     data_id : int, default=None\n706 |         OpenML ID of the dataset. The most specific way of retrieving a\n707 |         dataset. If data_id is not given, name (and potential version) are\n708 |         used to obtain a dataset.\n709 | \n710 |     data_home : str, default=None\n711 |         Specify another download and cache folder for the data sets. By default\n712 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n713 | \n714 |     target_column : str, list or None, default='default-target'\n715 |         Specify the column name in the data to use as target. If\n716 |         'default-target', the standard target column a stored on the server\n717 |         is used. If ``None``, all columns are returned as data and the\n718 |         target is ``None``. If list (of strings), all columns with these names\n719 |         are returned as multi-target (Note: not all scikit-learn classifiers\n720 |         can handle all types of multi-output combinations)\n721 | \n722 |     cache : bool, default=True\n723 |         Whether to cache downloaded datasets using joblib.\n724 | \n725 |     return_X_y : bool, default=False\n726 |         If True, returns ``(data, target)`` instead of a Bunch object. See\n727 |         below for more information about the `data` and `target` objects.\n728 | \n729 |     as_frame : bool or 'auto', default=False\n730 |         If True, the data is a pandas DataFrame including columns with\n731 |         appropriate dtypes (numeric, string or categorical). The target is\n732 |         a pandas DataFrame or Series depending on the number of target_columns.\n733 |         The Bunch will contain a ``frame`` attribute with the target and the\n734 |         data. If ``return_X_y`` is True, then ``(data, target)`` will be pandas\n735 |         DataFrames or Series as describe above.\n736 |         If as_frame is 'auto', the data and target will be converted to\n737 |         DataFrame or Series as if as_frame is set to True, unless the dataset\n738 |         is stored in sparse format.\n739 | \n740 |     Returns\n741 |     -------\n742 | \n743 |     data : :class:`~sklearn.utils.Bunch`\n744 |         Dictionary-like object, with the following attributes.\n745 | \n746 |         data : np.array, scipy.sparse.csr_matrix of floats, or pandas DataFrame\n747 |             The feature matrix. Categorical features are encoded as ordinals.\n748 |         target : np.array, pandas Series or DataFrame\n749 |             The regression target or classification labels, if applicable.\n750 |             Dtype is float if numeric, and object if categorical. If\n751 |             ``as_frame`` is True, ``target`` is a pandas object.\n752 |         DESCR : str\n753 |             The full description of the dataset\n754 |         feature_names : list\n755 |             The names of the dataset columns\n756 |         target_names: list\n757 |             The names of the target columns\n758 | \n759 |         .. versionadded:: 0.22\n760 | \n761 |         categories : dict or None\n762 |             Maps each categorical feature name to a list of values, such\n763 |             that the value encoded as i is ith in the list. If ``as_frame``\n764 |             is True, this is None.\n765 |         details : dict\n766 |             More metadata from OpenML\n767 |         frame : pandas DataFrame\n768 |             Only present when `as_frame=True`. DataFrame with ``data`` and\n769 |             ``target``.\n770 | \n771 |     (data, target) : tuple if ``return_X_y`` is True\n772 | \n773 |         .. note:: EXPERIMENTAL\n774 | \n775 |             This interface is **experimental** and subsequent releases may\n776 |             change attributes without notice (although there should only be\n777 |             minor changes to ``data`` and ``target``).\n778 | \n779 |         Missing values in the 'data' are represented as NaN's. Missing values\n780 |         in 'target' are represented as NaN's (numerical target) or None\n781 |         (categorical target)\n782 |     \"\"\"\n783 |     data_home = get_data_home(data_home=data_home)\n784 |     data_home = join(data_home, 'openml')\n785 |     if cache is False:\n786 |         # no caching will be applied\n787 |         data_home = None\n788 | \n789 |     # check valid function arguments. data_id XOR (name, version) should be\n790 |     # provided\n791 |     if name is not None:\n792 |         # OpenML is case-insensitive, but the caching mechanism is not\n793 |         # convert all data names (str) to lower case\n794 |         name = name.lower()\n795 |         if data_id is not None:\n796 |             raise ValueError(\n797 |                 \"Dataset data_id={} and name={} passed, but you can only \"\n798 |                 \"specify a numeric data_id or a name, not \"\n799 |                 \"both.\".format(data_id, name))\n800 |         data_info = _get_data_info_by_name(name, version, data_home)\n801 |         data_id = data_info['did']\n802 |     elif data_id is not None:\n803 |         # from the previous if statement, it is given that name is None\n804 |         if version != \"active\":\n805 |             raise ValueError(\n806 |                 \"Dataset data_id={} and version={} passed, but you can only \"\n807 |                 \"specify a numeric data_id or a version, not \"\n808 |                 \"both.\".format(data_id, name))\n809 |     else:\n810 |         raise ValueError(\n811 |             \"Neither name nor data_id are provided. Please provide name or \"\n812 |             \"data_id.\")\n813 | \n814 |     data_description = _get_data_description_by_id(data_id, data_home)\n815 |     if data_description['status'] != \"active\":\n816 |         warn(\"Version {} of dataset {} is inactive, meaning that issues have \"\n817 |              \"been found in the dataset. Try using a newer version from \"\n818 |              \"this URL: {}\".format(\n819 |                 data_description['version'],\n820 |                 data_description['name'],\n821 |                 data_description['url']))\n822 |     if 'error' in data_description:\n823 |         warn(\"OpenML registered a problem with the dataset. It might be \"\n824 |              \"unusable. Error: {}\".format(data_description['error']))\n825 |     if 'warning' in data_description:\n826 |         warn(\"OpenML raised a warning on the dataset. It might be \"\n827 |              \"unusable. Warning: {}\".format(data_description['warning']))\n828 | \n829 |     return_sparse = False\n830 |     if data_description['format'].lower() == 'sparse_arff':\n831 |         return_sparse = True\n832 | \n833 |     if as_frame == 'auto':\n834 |         as_frame = not return_sparse\n835 | \n836 |     if as_frame and return_sparse:\n837 |         raise ValueError('Cannot return dataframe with sparse data')\n838 | \n839 |     # download data features, meta-info about column types\n840 |     features_list = _get_data_features(data_id, data_home)\n841 | \n842 |     if not as_frame:\n843 |         for feature in features_list:\n844 |             if 'true' in (feature['is_ignore'], feature['is_row_identifier']):\n845 |                 continue\n846 |             if feature['data_type'] == 'string':\n847 |                 raise ValueError('STRING attributes are not supported for '\n848 |                                  'array representation. Try as_frame=True')\n849 | \n850 |     if target_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |                         \"Should be str, list or None. Got: \"\n866 |                         \"{}\".format(type(target_column)))\n867 |     data_columns = _valid_data_column_names(features_list,\n868 |                                             target_columns)\n869 | \n870 |     shape: Optional[Tuple[int, int]]\n871 |     # determine arff encoding to return\n872 |     if not return_sparse:\n873 |         # The shape must include the ignored features to keep the right indexes\n874 |         # during the arff data conversion.\n875 |         data_qualities = _get_data_qualities(data_id, data_home)\n876 |         shape = _get_num_samples(data_qualities), len(features_list)\n877 |     else:\n878 |         shape = None\n879 | \n880 |     # obtain the data\n881 |     url = _DATA_FILE.format(data_description['file_id'])\n882 |     bunch = _download_data_to_bunch(url, return_sparse, data_home,\n883 |                                     as_frame=as_frame,\n884 |                                     features_list=features_list, shape=shape,\n885 |                                     target_columns=target_columns,\n886 |                                     data_columns=data_columns)\n887 | \n888 |     if return_X_y:\n889 |         return bunch.data, bunch.target\n890 | \n891 |     description = \"{}\\n\\nDownloaded from openml.org.\".format(\n892 |         data_description.pop('description'))\n893 | \n894 |     bunch.update(\n895 |         DESCR=description, details=data_description,\n896 |         url=\"https://www.openml.org/d/{}\".format(data_id))\n897 | \n898 |     return bunch\n```\n\n\n\n##Searching for term \"datasets/_openml.py\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_sparse_data_to_array`.\nSource: Retrieved entity using keyword search (bm25).\n```\n216 | def _sparse_data_to_array(\n217 |     arff_data: ArffSparseDataType, include_columns: List\n218 | ) -> np.ndarray:\n219 |     # turns the sparse data back into an array (can't use toarray() function,\n220 |     # as this does only work on numeric data)\n221 |     num_obs = max(arff_data[1]) + 1\n222 |     y_shape = (num_obs, len(include_columns))\n223 |     reindexed_columns = {column_idx: array_idx for array_idx, column_idx\n224 |                          in enumerate(include_columns)}\n225 |     # TODO: improve for efficiency\n226 |     y = np.empty(y_shape, dtype=np.float64)\n227 |     for val, row_idx, col_idx in zip(arff_data[0], arff_data[1], arff_data[2]):\n228 |         if col_idx in include_columns:\n229 |             y[row_idx, reindexed_columns[col_idx]] = val\n230 |     return y\n```\n\nFound function `sklearn/datasets/_openml.py:_get_data_info_by_name`.\nSource: Retrieved code content using keyword search (bm25).\n```\n364 | def _get_data_info_by_name(\n365 |     name: str, version: Union[int, str], data_home: Optional[str]\n366 | ):\n367 |     \"\"\"\n368 |     Utilizes the openml dataset listing api to find a dataset by\n369 |     name/version\n370 |     OpenML api function:\n371 |     https://www.openml.org/api_docs#!/data/get_data_list_data_name_data_name\n372 | \n373 |     Parameters\n374 |     ----------\n375 |     name : str\n376 |         name of the dataset\n377 | \n378 |     version : int or str\n379 |         If version is an integer, the exact name/version will be obtained from\n380 |         OpenML. If version is a string (value: \"active\") it will take the first\n381 |         version from OpenML that is annotated as active. Any other string\n382 |         values except \"active\" are treated as integer.\n383 | \n384 |     data_home : str or None\n385 |         Location to cache the response. None if no cache is required.\n386 | \n387 |     Returns\n388 |     -------\n389 |     first_dataset : json\n390 |         json representation of the first dataset object that adhired to the\n391 |         search criteria\n392 | \n393 |     \"\"\"\n394 |     if version == \"active\":\n395 |         # situation in which we return the oldest active version\n396 |         url = _SEARCH_NAME.format(name) + \"/status/active/\"\n397 |         error_msg = \"No active dataset {} found.\".format(name)\n398 |         json_data = _get_json_content_from_openml_api(\n399 |             url, error_msg, data_home=data_home\n400 |         )\n401 |         res = json_data['data']['dataset']\n402 |         if len(res) > 1:\n403 |             warn(\"Multiple active versions of the dataset matching the name\"\n404 |                  \" {name} exist. Versions may be fundamentally different, \"\n405 |                  \"returning version\"\n406 |                  \" {version}.\".format(name=name, version=res[0]['version']))\n407 |         return res[0]\n408 | \n409 |     # an integer version has been provided\n410 |     url = (_SEARCH_NAME + \"/data_version/{}\").format(name, version)\n411 |     try:\n412 |         json_data = _get_json_content_from_openml_api(\n413 |             url, error_message=None, data_home=data_home\n414 |         )\n415 |     except OpenMLError:\n416 |         # we can do this in 1 function call if OpenML does not require the\n417 |         # specification of the dataset status (i.e., return datasets with a\n418 |         # given name / version regardless of active, deactivated, etc. )\n419 |         # TODO: feature request OpenML.\n420 |         url += \"/status/deactivated\"\n421 |         error_msg = \"Dataset {} with version {} not found.\".format(name,\n422 |                                                                    version)\n423 |         json_data = _get_json_content_from_openml_api(\n424 |             url, error_msg, data_home=data_home\n425 |         )\n426 | \n427 |     return json_data['data']['dataset'][0]\n```\n\nFound function `sklearn/datasets/_openml.py:_get_data_description_by_id`.\nSource: Retrieved code content using keyword search (bm25).\n```\n430 | def _get_data_description_by_id(\n431 |     data_id: int, data_home: Optional[str]\n432 | ) -> Dict[str, Any]:\n433 |     # OpenML API function: https://www.openml.org/api_docs#!/data/get_data_id\n434 |     url = _DATA_INFO.format(data_id)\n435 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n436 |     json_data = _get_json_content_from_openml_api(\n437 |         url, error_message, data_home=data_home\n438 |     )\n439 |     return json_data['data_set_description']\n```\n\nFound function `sklearn/datasets/_openml.py:_get_data_features`.\nSource: Retrieved code content using keyword search (bm25).\n```\n442 | def _get_data_features(\n443 |     data_id: int, data_home: Optional[str]\n444 | ) -> OpenmlFeaturesType:\n445 |     # OpenML function:\n446 |     # https://www.openml.org/api_docs#!/data/get_data_features_id\n447 |     url = _DATA_FEATURES.format(data_id)\n448 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n449 |     json_data = _get_json_content_from_openml_api(\n450 |         url, error_message, data_home=data_home\n451 |     )\n452 |     return json_data['data_features']['feature']\n```\n\nFound function `sklearn/datasets/_openml.py:_get_data_qualities`.\nSource: Retrieved entity using keyword search (bm25).\n```\n455 | def _get_data_qualities(\n456 |     data_id: int, data_home: Optional[str]\n457 | ) -> OpenmlQualitiesType:\n458 |     # OpenML API function:\n459 |     # https://www.openml.org/api_docs#!/data/get_data_qualities_id\n460 |     url = _DATA_QUALITIES.format(data_id)\n461 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n462 |     json_data = _get_json_content_from_openml_api(\n463 |         url, error_message, data_home=data_home\n464 |     )\n465 |     # the qualities might not be available, but we still try to process\n466 |     # the data\n467 |     return json_data.get('data_qualities', {}).get('quality', [])\n```\n\nFound function `sklearn/datasets/_openml.py:_get_num_samples`.\nSource: Retrieved entity using keyword search (bm25).\n```\n470 | def _get_num_samples(data_qualities: OpenmlQualitiesType) -> int:\n471 |     \"\"\"Get the number of samples from data qualities.\n472 | \n473 |     Parameters\n474 |     ----------\n475 |     data_qualities : list of dict\n476 |         Used to retrieve the number of instances (samples) in the dataset.\n477 | \n478 |     Returns\n479 |     -------\n480 |     n_samples : int\n481 |         The number of samples in the dataset or -1 if data qualities are\n482 |         unavailable.\n483 |     \"\"\"\n484 |     # If the data qualities are unavailable, we return -1\n485 |     default_n_samples = -1\n486 | \n487 |     qualities = {d['name']: d['value'] for d in data_qualities}\n488 |     return int(float(qualities.get('NumberOfInstances', default_n_samples)))\n```\n\nFound file `sklearn/datasets/_openml.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/datasets/_openml.py` for the full content if needed.\n"}, {"content": "Let me also check the external ARFF handling:\n\n<function=search_code_snippets>\n<parameter=search_terms>['sklearn/externals/_arff.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"sklearn/externals/_arff.py\"...\n### Search Result:\nFound file `sklearn/externals/_arff.py`.\nSource: Exact match found for entity name `sklearn/externals/_arff.py`.\n```\n   1 | # -*- coding: utf-8 -*-\n   2 | # =============================================================================\n   3 | # Federal University of Rio Grande do Sul (UFRGS)\n   4 | # Connectionist Artificial Intelligence Laboratory (LIAC)\n   5 | # Renato de Pontes Pereira - rppereira@inf.ufrgs.br\n   6 | # =============================================================================\n   7 | # Copyright (c) 2011 Renato de Pontes Pereira, renato.ppontes at gmail dot com\n   8 | #\n   9 | # Permission is hereby granted, free of charge, to any person obtaining a copy\n  10 | # of this software and associated documentation files (the \"Software\"), to deal\n  11 | # in the Software without restriction, including without limitation the rights\n  12 | # to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  13 | # copies of the Software, and to permit persons to whom the Software is\n  14 | # furnished to do so, subject to the following conditions:\n  15 | #\n  16 | # The above copyright notice and this permission notice shall be included in\n  17 | # all copies or substantial portions of the Software.\n  18 | #\n  19 | # THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  20 | # IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  21 | # FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  22 | # AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  23 | # LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  24 | # OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  25 | # SOFTWARE.\n  26 | # =============================================================================\n  27 | \n  28 | '''\n  29 | The liac-arff module implements functions to read and write ARFF files in\n  30 | Python. It was created in the Connectionist Artificial Intelligence Laboratory\n  31 | (LIAC), which takes place at the Federal University of Rio Grande do Sul\n  32 | (UFRGS), in Brazil.\n  33 | \n  34 | ARFF (Attribute-Relation File Format) is an file format specially created for\n  35 | describe datasets which are commonly used for machine learning experiments and\n  36 | softwares. This file format was created to be used in Weka, the best\n  37 | representative software for machine learning automated experiments.\n  38 | \n  39 | An ARFF file can be divided into two sections: header and data. The Header\n  40 | describes the metadata of the dataset, including a general description of the\n  41 | dataset, its name and its attributes. The source below is an example of a\n  42 | header section in a XOR dataset::\n  43 | \n  44 |     %\n  45 |     % XOR Dataset\n  46 |     %\n  47 |     % Created by Renato Pereira\n  48 |     %            rppereira@inf.ufrgs.br\n  49 |     %            http://inf.ufrgs.br/~rppereira\n  50 |     %\n  51 |     %\n  52 |     @RELATION XOR\n  53 | \n  54 |     @ATTRIBUTE input1 REAL\n  55 |     @ATTRIBUTE input2 REAL\n  56 |     @ATTRIBUTE y REAL\n  57 | \n  58 | The Data section of an ARFF file describes the observations of the dataset, in\n  59 | the case of XOR dataset::\n  60 | \n  61 |     @DATA\n  62 |     0.0,0.0,0.0\n  63 |     0.0,1.0,1.0\n  64 |     1.0,0.0,1.0\n  65 |     1.0,1.0,0.0\n  66 |     %\n  67 |     %\n  68 |     %\n  69 | \n  70 | Notice that several lines are starting with an ``%`` symbol, denoting a\n  71 | comment, thus, lines with ``%`` at the beginning will be ignored, except by the\n  72 | description part at the beginning of the file. The declarations ``@RELATION``,\n  73 | ``@ATTRIBUTE``, and ``@DATA`` are all case insensitive and obligatory.\n  74 | \n  75 | For more information and details about the ARFF file description, consult\n  76 | http://www.cs.waikato.ac.nz/~ml/weka/arff.html\n  77 | \n  78 | \n  79 | ARFF Files in Python\n  80 | ~~~~~~~~~~~~~~~~~~~~\n  81 | \n  82 | This module uses built-ins python objects to represent a deserialized ARFF\n  83 | file. A dictionary is used as the container of the data and metadata of ARFF,\n  84 | and have the following keys:\n  85 | \n  86 | - **description**: (OPTIONAL) a string with the description of the dataset.\n  87 | - **relation**: (OBLIGATORY) a string with the name of the dataset.\n  88 | - **attributes**: (OBLIGATORY) a list of attributes with the following\n  89 |   template::\n  90 | \n  91 |     (attribute_name, attribute_type)\n  92 | \n  93 |   the attribute_name is a string, and attribute_type must be an string\n  94 |   or a list of strings.\n  95 | - **data**: (OBLIGATORY) a list of data instances. Each data instance must be\n  96 |   a list with values, depending on the attributes.\n  97 | \n  98 | The above keys must follow the case which were described, i.e., the keys are\n  99 | case sensitive. The attribute type ``attribute_type`` must be one of these\n 100 | strings (they are not case sensitive): ``NUMERIC``, ``INTEGER``, ``REAL`` or\n 101 | ``STRING``. For nominal attributes, the ``attribute_type`` must be a list of\n 102 | strings.\n 103 | \n 104 | In this format, the XOR dataset presented above can be represented as a python\n 105 | object as::\n 106 | \n 107 |     xor_dataset = {\n 108 |         'description': 'XOR Dataset',\n 109 |         'relation': 'XOR',\n 110 |         'attributes': [\n 111 |             ('input1', 'REAL'),\n 112 |             ('input2', 'REAL'),\n 113 |             ('y', 'REAL'),\n 114 |         ],\n 115 |         'data': [\n 116 |             [0.0, 0.0, 0.0],\n 117 |             [0.0, 1.0, 1.0],\n 118 |             [1.0, 0.0, 1.0],\n 119 |             [1.0, 1.0, 0.0]\n 120 |         ]\n 121 |     }\n 122 | \n 123 | \n 124 | Features\n 125 | ~~~~~~~~\n 126 | \n 127 | This module provides several features, including:\n 128 | \n 129 | - Read and write ARFF files using python built-in structures, such dictionaries\n 130 |   and lists;\n 131 | - Supports `scipy.sparse.coo <http://docs.scipy\n 132 |   .org/doc/scipy/reference/generated/scipy.sparse.coo_matrix.html#scipy.sparse.coo_matrix>`_\n 133 |   and lists of dictionaries as used by SVMLight\n 134 | - Supports the following attribute types: NUMERIC, REAL, INTEGER, STRING, and\n 135 |   NOMINAL;\n 136 | - Has an interface similar to other built-in modules such as ``json``, or\n 137 |   ``zipfile``;\n 138 | - Supports read and write the descriptions of files;\n 139 | - Supports missing values and names with spaces;\n 140 | - Supports unicode values and names;\n 141 | - Fully compatible with Python 2.7+, Python 3.3+, pypy and pypy3;\n 142 | - Under `MIT License <http://opensource.org/licenses/MIT>`_\n 143 | \n 144 | '''\n 145 | __author__ = 'Renato de Pontes Pereira, Matthias Feurer, Joel Nothman'\n 146 | __author_email__ = ('renato.ppontes@gmail.com, '\n 147 |                     'feurerm@informatik.uni-freiburg.de, '\n 148 |                     'joel.nothman@gmail.com')\n 149 | __version__ = '2.4.0'\n 150 | \n 151 | import typing\n 152 | from typing import Optional, List, Dict, Any, Iterator, Union, Tuple\n 153 | \n 154 | import re\n 155 | import sys\n 156 | import csv\n 157 | \n 158 | # CONSTANTS ===================================================================\n 159 | _SIMPLE_TYPES = ['NUMERIC', 'REAL', 'INTEGER', 'STRING']\n 160 | \n 161 | _TK_DESCRIPTION = '%'\n 162 | _TK_COMMENT     = '%'\n 163 | _TK_RELATION    = '@RELATION'\n 164 | _TK_ATTRIBUTE   = '@ATTRIBUTE'\n 165 | _TK_DATA        = '@DATA'\n 166 | \n 167 | _RE_RELATION     = re.compile(r'^([^\\{\\}%,\\s]*|\\\".*\\\"|\\'.*\\')$', re.UNICODE)\n 168 | _RE_ATTRIBUTE    = re.compile(r'^(\\\".*\\\"|\\'.*\\'|[^\\{\\}%,\\s]*)\\s+(.+)$', re.UNICODE)\n 169 | _RE_TYPE_NOMINAL = re.compile(r'^\\{\\s*((\\\".*\\\"|\\'.*\\'|\\S*)\\s*,\\s*)*(\\\".*\\\"|\\'.*\\'|\\S*)\\s*\\}$', re.UNICODE)\n 170 | _RE_QUOTE_CHARS = re.compile(r'[\"\\'\\\\\\s%,\\000-\\031]', re.UNICODE)\n 171 | _RE_ESCAPE_CHARS = re.compile(r'(?=[\"\\'\\\\%])|[\\n\\r\\t\\000-\\031]')\n 172 | _RE_SPARSE_LINE = re.compile(r'^\\s*\\{.*\\}\\s*$', re.UNICODE)\n 173 | _RE_NONTRIVIAL_DATA = re.compile('[\"\\'{}\\\\s]', re.UNICODE)\n 174 | \n 175 | ArffDenseDataType = Iterator[List]\n 176 | ArffSparseDataType = Tuple[List, ...]\n 177 | \n 178 | \n 179 | if typing.TYPE_CHECKING:\n 180 |     # typing_extensions is available when mypy is installed\n 181 |     from typing_extensions import TypedDict\n 182 | \n 183 |     class ArffContainerType(TypedDict):\n 184 |         description: str\n 185 |         relation: str\n 186 |         attributes: List\n 187 |         data: Union[ArffDenseDataType, ArffSparseDataType]\n 188 | \n 189 | else:\n 190 |     ArffContainerType = Dict[str, Any]\n 191 | \n 192 | \n 193 | def _build_re_values():\n 194 |     quoted_re = r'''\n 195 |                     \"      # open quote followed by zero or more of:\n 196 |                     (?:\n 197 |                         (?<!\\\\)    # no additional backslash\n 198 |                         (?:\\\\\\\\)*  # maybe escaped backslashes\n 199 |                         \\\\\"        # escaped quote\n 200 |                     |\n 201 |                         \\\\[^\"]     # escaping a non-quote\n 202 |                     |\n 203 |                         [^\"\\\\]     # non-quote char\n 204 |                     )*\n 205 |                     \"      # close quote\n 206 |                     '''\n 207 |     # a value is surrounded by \" or by ' or contains no quotables\n 208 |     value_re = r'''(?:\n 209 |         %s|          # a value may be surrounded by \"\n 210 |         %s|          # or by '\n 211 |         [^,\\s\"'{}]+  # or may contain no characters requiring quoting\n 212 |         )''' % (quoted_re,\n 213 |                 quoted_re.replace('\"', \"'\"))\n 214 | \n 215 |     # This captures (value, error) groups. Because empty values are allowed,\n 216 |     # we cannot just look for empty values to handle syntax errors.\n 217 |     # We presume the line has had ',' prepended...\n 218 |     dense = re.compile(r'''(?x)\n 219 |         ,                # may follow ','\n 220 |         \\s*\n 221 |         ((?=,)|$|%(value_re)s)  # empty or value\n 222 |         |\n 223 |         (\\S.*)           # error\n 224 |         ''' % {'value_re': value_re})\n 225 | \n 226 |     # This captures (key, value) groups and will have an empty key/value\n 227 |     # in case of syntax errors.\n 228 |     # It does not ensure that the line starts with '{' or ends with '}'.\n 229 |     sparse = re.compile(r'''(?x)\n 230 |         (?:^\\s*\\{|,)   # may follow ',', or '{' at line start\n 231 |         \\s*\n 232 |         (\\d+)          # attribute key\n 233 |         \\s+\n 234 |         (%(value_re)s) # value\n 235 |         |\n 236 |         (?!}\\s*$)      # not an error if it's }$\n 237 |         (?!^\\s*{\\s*}\\s*$)  # not an error if it's ^{}$\n 238 |         \\S.*           # error\n 239 |         ''' % {'value_re': value_re})\n 240 |     return dense, sparse\n 241 | \n 242 | \n 243 | _RE_DENSE_VALUES, _RE_SPARSE_KEY_VALUES = _build_re_values()\n 244 | \n 245 | \n 246 | _ESCAPE_SUB_MAP = {\n 247 |     '\\\\\\\\': '\\\\',\n 248 |     '\\\\\"': '\"',\n 249 |     \"\\\\'\": \"'\",\n 250 |     '\\\\t': '\\t',\n 251 |     '\\\\n': '\\n',\n 252 |     '\\\\r': '\\r',\n 253 |     '\\\\b': '\\b',\n 254 |     '\\\\f': '\\f',\n 255 |     '\\\\%': '%',\n 256 | }\n 257 | _UNESCAPE_SUB_MAP = {chr(i): '\\\\%03o' % i for i in range(32)}\n 258 | _UNESCAPE_SUB_MAP.update({v: k for k, v in _ESCAPE_SUB_MAP.items()})\n 259 | _UNESCAPE_SUB_MAP[''] = '\\\\'\n 260 | _ESCAPE_SUB_MAP.update({'\\\\%d' % i: chr(i) for i in range(10)})\n 261 | \n 262 | \n 263 | def _escape_sub_callback(match):\n 264 |     s = match.group()\n 265 |     if len(s) == 2:\n 266 |         try:\n 267 |             return _ESCAPE_SUB_MAP[s]\n 268 |         except KeyError:\n 269 |             raise ValueError('Unsupported escape sequence: %s' % s)\n 270 |     if s[1] == 'u':\n 271 |         return unichr(int(s[2:], 16))\n 272 |     else:\n 273 |         return chr(int(s[1:], 8))\n 274 | \n 275 | \n 276 | def _unquote(v):\n 277 |     if v[:1] in ('\"', \"'\"):\n 278 |         return re.sub(r'\\\\([0-9]{1,3}|u[0-9a-f]{4}|.)', _escape_sub_callback,\n 279 |                       v[1:-1])\n 280 |     elif v in ('?', ''):\n 281 |         return None\n 282 |     else:\n 283 |         return v\n 284 | \n 285 | \n 286 | def _parse_values(s):\n 287 |     '''(INTERNAL) Split a line into a list of values'''\n 288 |     if not _RE_NONTRIVIAL_DATA.search(s):\n 289 |         # Fast path for trivial cases (unfortunately we have to handle missing\n 290 |         # values because of the empty string case :(.)\n 291 |         return [None if s in ('?', '') else s\n 292 |                 for s in next(csv.reader([s]))]\n 293 | \n 294 |     # _RE_DENSE_VALUES tokenizes despite quoting, whitespace, etc.\n 295 |     values, errors = zip(*_RE_DENSE_VALUES.findall(',' + s))\n 296 |     if not any(errors):\n 297 |         return [_unquote(v) for v in values]\n 298 |     if _RE_SPARSE_LINE.match(s):\n 299 |         try:\n 300 |             return {int(k): _unquote(v)\n 301 |                     for k, v in _RE_SPARSE_KEY_VALUES.findall(s)}\n 302 |         except ValueError as exc:\n 303 |             # an ARFF syntax error in sparse data\n 304 |             for match in _RE_SPARSE_KEY_VALUES.finditer(s):\n 305 |                 if not match.group(1):\n 306 |                     raise BadLayout('Error parsing %r' % match.group())\n 307 |             raise BadLayout('Unknown parsing error')\n 308 |     else:\n 309 |         # an ARFF syntax error\n 310 |         for match in _RE_DENSE_VALUES.finditer(s):\n 311 |             if match.group(2):\n 312 |                 raise BadLayout('Error parsing %r' % match.group())\n 313 |         raise BadLayout('Unknown parsing error')\n 314 | \n 315 | \n 316 | DENSE = 0     # Constant value representing a dense matrix\n 317 | COO = 1       # Constant value representing a sparse matrix in coordinate format\n 318 | LOD = 2       # Constant value representing a sparse matrix in list of\n 319 |               # dictionaries format\n 320 | DENSE_GEN = 3 # Generator of dictionaries\n 321 | LOD_GEN = 4   # Generator of dictionaries\n 322 | _SUPPORTED_DATA_STRUCTURES = [DENSE, COO, LOD, DENSE_GEN, LOD_GEN]\n 323 | \n 324 | # =============================================================================\n 325 | \n 326 | # COMPATIBILITY WITH PYTHON 3 =================================================\n 327 | PY3 = sys.version_info[0] == 3\n 328 | if PY3:\n 329 |     unicode = str\n 330 |     basestring = str\n 331 |     xrange = range\n 332 |     unichr = chr\n 333 | # COMPABILITY WITH PYTHON 2 ===================================================\n 334 | # =============================================================================\n 335 | PY2 = sys.version_info[0] == 2\n 336 | if PY2:\n 337 |     from itertools import izip as zip\n 338 | \n 339 | # EXCEPTIONS ==================================================================\n 340 | class ArffException(Exception):\n 341 |     message : Optional[str] = None\n 342 | \n 343 |     def __init__(self):\n 344 |         self.line = -1\n 345 | \n 346 |     def __str__(self):\n 347 |         return self.message%self.line\n 348 | \n 349 | class BadRelationFormat(ArffException):\n 350 |     '''Error raised when the relation declaration is in an invalid format.'''\n 351 |     message = 'Bad @RELATION format, at line %d.'\n 352 | \n 353 | class BadAttributeFormat(ArffException):\n 354 |     '''Error raised when some attribute declaration is in an invalid format.'''\n 355 |     message = 'Bad @ATTRIBUTE format, at line %d.'\n 356 | \n 357 | class BadDataFormat(ArffException):\n 358 |     '''Error raised when some data instance is in an invalid format.'''\n 359 |     def __init__(self, value):\n 360 |         super(BadDataFormat, self).__init__()\n 361 |         self.message = (\n 362 |             'Bad @DATA instance format in line %d: ' +\n 363 |             ('%s' % value)\n 364 |         )\n 365 | \n 366 | class BadAttributeType(ArffException):\n 367 |     '''Error raised when some invalid type is provided into the attribute\n 368 |     declaration.'''\n 369 |     message = 'Bad @ATTRIBUTE type, at line %d.'\n 370 | \n 371 | class BadAttributeName(ArffException):\n 372 |     '''Error raised when an attribute name is provided twice the attribute\n 373 |     declaration.'''\n 374 | \n 375 |     def __init__(self, value, value2):\n 376 |         super(BadAttributeName, self).__init__()\n 377 |         self.message = (\n 378 |             ('Bad @ATTRIBUTE name %s at line' % value) +\n 379 |             ' %d, this name is already in use in line' +\n 380 |             (' %d.' % value2)\n 381 |         )\n 382 | \n 383 | class BadNominalValue(ArffException):\n 384 |     '''Error raised when a value in used in some data instance but is not\n 385 |     declared into it respective attribute declaration.'''\n 386 | \n 387 |     def __init__(self, value):\n 388 |         super(BadNominalValue, self).__init__()\n 389 |         self.message = (\n 390 |             ('Data value %s not found in nominal declaration, ' % value)\n 391 |             + 'at line %d.'\n 392 |         )\n 393 | \n 394 | class BadNominalFormatting(ArffException):\n 395 |     '''Error raised when a nominal value with space is not properly quoted.'''\n 396 |     def __init__(self, value):\n 397 |         super(BadNominalFormatting, self).__init__()\n 398 |         self.message = (\n 399 |             ('Nominal data value \"%s\" not properly quoted in line ' % value) +\n 400 |             '%d.'\n 401 |         )\n 402 | \n 403 | class BadNumericalValue(ArffException):\n 404 |     '''Error raised when and invalid numerical value is used in some data\n 405 |     instance.'''\n 406 |     message = 'Invalid numerical value, at line %d.'\n 407 | \n 408 | class BadStringValue(ArffException):\n 409 |     '''Error raise when a string contains space but is not quoted.'''\n 410 |     message = 'Invalid string value at line %d.'\n 411 | \n 412 | class BadLayout(ArffException):\n 413 |     '''Error raised when the layout of the ARFF file has something wrong.'''\n 414 |     message = 'Invalid layout of the ARFF file, at line %d.'\n 415 | \n 416 |     def __init__(self, msg=''):\n 417 |         super(BadLayout, self).__init__()\n 418 |         if msg:\n 419 |             self.message = BadLayout.message + ' ' + msg.replace('%', '%%')\n 420 | \n 421 | \n 422 | class BadObject(ArffException):\n 423 |     '''Error raised when the object representing the ARFF file has something\n 424 |     wrong.'''\n 425 |     def __init__(self, msg='Invalid object.'):\n 426 |         self.msg = msg\n 427 | \n 428 |     def __str__(self):\n 429 |         return '%s' % self.msg\n 430 | \n 431 | # =============================================================================\n 432 | \n 433 | # INTERNAL ====================================================================\n 434 | def _unescape_sub_callback(match):\n 435 |     return _UNESCAPE_SUB_MAP[match.group()]\n 436 | \n 437 | \n 438 | def encode_string(s):\n 439 |     if _RE_QUOTE_CHARS.search(s):\n 440 |         return u\"'%s'\" % _RE_ESCAPE_CHARS.sub(_unescape_sub_callback, s)\n 441 |     return s\n 442 | \n 443 | \n 444 | class EncodedNominalConversor(object):\n 445 |     def __init__(self, values):\n 446 |         self.values = {v: i for i, v in enumerate(values)}\n 447 |         self.values[0] = 0\n 448 | \n 449 |     def __call__(self, value):\n 450 |         try:\n 451 |             return self.values[value]\n 452 |         except KeyError:\n 453 |             raise BadNominalValue(value)\n 454 | \n 455 | \n 456 | class NominalConversor(object):\n 457 |     def __init__(self, values):\n 458 |         self.values = set(values)\n 459 |         self.zero_value = values[0]\n 460 | \n 461 |     def __call__(self, value):\n 462 |         if value not in self.values:\n 463 |             if value == 0:\n 464 |                 # Sparse decode\n 465 |                 # See issue #52: nominals should take their first value when\n 466 |                 # unspecified in a sparse matrix. Naturally, this is consistent\n 467 |                 # with EncodedNominalConversor.\n 468 |                 return self.zero_value\n 469 |             raise BadNominalValue(value)\n 470 |         return unicode(value)\n 471 | \n 472 | \n 473 | class DenseGeneratorData(object):\n 474 |     '''Internal helper class to allow for different matrix types without\n 475 |     making the code a huge collection of if statements.'''\n 476 | \n 477 |     def decode_rows(self, stream, conversors):\n 478 |         for row in stream:\n 479 |             values = _parse_values(row)\n 480 | \n 481 |             if isinstance(values, dict):\n 482 |                 if values and max(values) >= len(conversors):\n 483 |                     raise BadDataFormat(row)\n 484 |                 # XXX: int 0 is used for implicit values, not '0'\n 485 |                 values = [values[i] if i in values else 0 for i in\n 486 |                           xrange(len(conversors))]\n 487 |             else:\n 488 |                 if len(values) != len(conversors):\n 489 |                     raise BadDataFormat(row)\n 490 | \n 491 |             yield self._decode_values(values, conversors)\n 492 | \n 493 |     @staticmethod\n 494 |     def _decode_values(values, conversors):\n 495 |         try:\n 496 |             values = [None if value is None else conversor(value)\n 497 |                       for conversor, value\n 498 |                       in zip(conversors, values)]\n 499 |         except ValueError as exc:\n 500 |             if 'float: ' in str(exc):\n 501 |                 raise BadNumericalValue()\n 502 |         return values\n 503 | \n 504 |     def encode_data(self, data, attributes):\n 505 |         '''(INTERNAL) Encodes a line of data.\n 506 | \n 507 |         Data instances follow the csv format, i.e, attribute values are\n 508 |         delimited by commas. After converted from csv.\n 509 | \n 510 |         :param data: a list of values.\n 511 |         :param attributes: a list of attributes. Used to check if data is valid.\n 512 |         :return: a string with the encoded data line.\n 513 |         '''\n 514 |         current_row = 0\n 515 | \n 516 |         for inst in data:\n 517 |             if len(inst) != len(attributes):\n 518 |                 raise BadObject(\n 519 |                     'Instance %d has %d attributes, expected %d' %\n 520 |                      (current_row, len(inst), len(attributes))\n 521 |                 )\n 522 | \n 523 |             new_data = []\n 524 |             for value in inst:\n 525 |                 if value is None or value == u'' or value != value:\n 526 |                     s = '?'\n 527 |                 else:\n 528 |                     s = encode_string(unicode(value))\n 529 |                 new_data.append(s)\n 530 | \n 531 |             current_row += 1\n 532 |             yield u','.join(new_data)\n 533 | \n 534 | \n 535 | class _DataListMixin(object):\n 536 |     \"\"\"Mixin to return a list from decode_rows instead of a generator\"\"\"\n 537 |     def decode_rows(self, stream, conversors):\n 538 |         return list(super(_DataListMixin, self).decode_rows(stream, conversors))\n 539 | \n 540 | \n 541 | class Data(_DataListMixin, DenseGeneratorData):\n 542 |     pass\n 543 | \n 544 | \n 545 | class COOData(object):\n 546 |     def decode_rows(self, stream, conversors):\n 547 |         data, rows, cols = [], [], []\n 548 |         for i, row in enumerate(stream):\n 549 |             values = _parse_values(row)\n 550 |             if not isinstance(values, dict):\n 551 |                 raise BadLayout()\n 552 |             if not values:\n 553 |                 continue\n 554 |             row_cols, values = zip(*sorted(values.items()))\n 555 |             try:\n 556 |                 values = [value if value is None else conversors[key](value)\n 557 |                           for key, value in zip(row_cols, values)]\n 558 |             except ValueError as exc:\n 559 |                 if 'float: ' in str(exc):\n 560 |                     raise BadNumericalValue()\n 561 |                 raise\n 562 |             except IndexError:\n 563 |                 # conversor out of range\n 564 |                 raise BadDataFormat(row)\n 565 | \n 566 |             data.extend(values)\n 567 |             rows.extend([i] * len(values))\n 568 |             cols.extend(row_cols)\n 569 | \n 570 |         return data, rows, cols\n 571 | \n 572 |     def encode_data(self, data, attributes):\n 573 |         num_attributes = len(attributes)\n 574 |         new_data = []\n 575 |         current_row = 0\n 576 | \n 577 |         row = data.row\n 578 |         col = data.col\n 579 |         data = data.data\n 580 | \n 581 |         # Check if the rows are sorted\n 582 |         if not all(row[i] <= row[i + 1] for i in xrange(len(row) - 1)):\n 583 |             raise ValueError(\"liac-arff can only output COO matrices with \"\n 584 |                              \"sorted rows.\")\n 585 | \n 586 |         for v, col, row in zip(data, col, row):\n 587 |             if row > current_row:\n 588 |                 # Add empty rows if necessary\n 589 |                 while current_row < row:\n 590 |                     yield \" \".join([u\"{\", u','.join(new_data), u\"}\"])\n 591 |                     new_data = []\n 592 |                     current_row += 1\n 593 | \n 594 |             if col >= num_attributes:\n 595 |                 raise BadObject(\n 596 |                     'Instance %d has at least %d attributes, expected %d' %\n 597 |                     (current_row, col + 1, num_attributes)\n 598 |                 )\n 599 | \n 600 |             if v is None or v == u'' or v != v:\n 601 |                 s = '?'\n 602 |             else:\n 603 |                 s = encode_string(unicode(v))\n 604 |             new_data.append(\"%d %s\" % (col, s))\n 605 | \n 606 |         yield \" \".join([u\"{\", u','.join(new_data), u\"}\"])\n 607 | \n 608 | class LODGeneratorData(object):\n 609 |     def decode_rows(self, stream, conversors):\n 610 |         for row in stream:\n 611 |             values = _parse_values(row)\n 612 | \n 613 |             if not isinstance(values, dict):\n 614 |                 raise BadLayout()\n 615 |             try:\n 616 |                 yield {key: None if value is None else conversors[key](value)\n 617 |                        for key, value in values.items()}\n 618 |             except ValueError as exc:\n 619 |                 if 'float: ' in str(exc):\n 620 |                     raise BadNumericalValue()\n 621 |                 raise\n 622 |             except IndexError:\n 623 |                 # conversor out of range\n 624 |                 raise BadDataFormat(row)\n 625 | \n 626 |     def encode_data(self, data, attributes):\n 627 |         current_row = 0\n 628 | \n 629 |         num_attributes = len(attributes)\n 630 |         for row in data:\n 631 |             new_data = []\n 632 | \n 633 |             if len(row) > 0 and max(row) >= num_attributes:\n 634 |                 raise BadObject(\n 635 |                     'Instance %d has %d attributes, expected %d' %\n 636 |                     (current_row, max(row) + 1, num_attributes)\n 637 |                 )\n 638 | \n 639 |             for col in sorted(row):\n 640 |                 v = row[col]\n 641 |                 if v is None or v == u'' or v != v:\n 642 |                     s = '?'\n 643 |                 else:\n 644 |                     s = encode_string(unicode(v))\n 645 |                 new_data.append(\"%d %s\" % (col, s))\n 646 | \n 647 |             current_row += 1\n 648 |             yield \" \".join([u\"{\", u','.join(new_data), u\"}\"])\n 649 | \n 650 | class LODData(_DataListMixin, LODGeneratorData):\n 651 |     pass\n 652 | \n 653 | \n 654 | def _get_data_object_for_decoding(matrix_type):\n 655 |     if matrix_type == DENSE:\n 656 |         return Data()\n 657 |     elif matrix_type == COO:\n 658 |         return COOData()\n 659 |     elif matrix_type == LOD:\n 660 |         return LODData()\n 661 |     elif matrix_type == DENSE_GEN:\n 662 |         return DenseGeneratorData()\n 663 |     elif matrix_type == LOD_GEN:\n 664 |         return LODGeneratorData()\n 665 |     else:\n 666 |         raise ValueError(\"Matrix type %s not supported.\" % str(matrix_type))\n 667 | \n 668 | def _get_data_object_for_encoding(matrix):\n 669 |     # Probably a scipy.sparse\n 670 |     if hasattr(matrix, 'format'):\n 671 |         if matrix.format == 'coo':\n 672 |             return COOData()\n 673 |         else:\n 674 |             raise ValueError('Cannot guess matrix format!')\n 675 |     elif isinstance(matrix[0], dict):\n 676 |         return LODData()\n 677 |     else:\n 678 |         return Data()\n 679 | \n 680 | # =============================================================================\n 681 | \n 682 | # ADVANCED INTERFACE ==========================================================\n 683 | class ArffDecoder(object):\n 684 |     '''An ARFF decoder.'''\n 685 | \n 686 |     def __init__(self):\n 687 |         '''Constructor.'''\n 688 |         self._conversors = []\n 689 |         self._current_line = 0\n 690 | \n 691 |     def _decode_comment(self, s):\n 692 |         '''(INTERNAL) Decodes a comment line.\n 693 | \n 694 |         Comments are single line strings starting, obligatorily, with the ``%``\n 695 |         character, and can have any symbol, including whitespaces or special\n 696 |         characters.\n 697 | \n 698 |         This method must receive a normalized string, i.e., a string without\n 699 |         padding, including the \"\\r\\n\" characters.\n 700 | \n 701 |         :param s: a normalized string.\n 702 |         :return: a string with the decoded comment.\n 703 |         '''\n 704 |         res = re.sub(r'^\\%( )?', '', s)\n 705 |         return res\n 706 | \n 707 |     def _decode_relation(self, s):\n 708 |         '''(INTERNAL) Decodes a relation line.\n 709 | \n 710 |         The relation declaration is a line with the format ``@RELATION\n 711 |         <relation-name>``, where ``relation-name`` is a string. The string must\n 712 |         start with alphabetic character and must be quoted if the name includes\n 713 |         spaces, otherwise this method will raise a `BadRelationFormat` exception.\n 714 | \n 715 |         This method must receive a normalized string, i.e., a string without\n 716 |         padding, including the \"\\r\\n\" characters.\n 717 | \n 718 |         :param s: a normalized string.\n 719 |         :return: a string with the decoded relation name.\n 720 |         '''\n 721 |         _, v = s.split(' ', 1)\n 722 |         v = v.strip()\n 723 | \n 724 |         if not _RE_RELATION.match(v):\n 725 |             raise BadRelationFormat()\n 726 | \n 727 |         res = unicode(v.strip('\"\\''))\n 728 |         return res\n 729 | \n 730 |     def _decode_attribute(self, s):\n 731 |         '''(INTERNAL) Decodes an attribute line.\n 732 | \n 733 |         The attribute is the most complex declaration in an arff file. All\n 734 |         attributes must follow the template::\n 735 | \n 736 |              @attribute <attribute-name> <datatype>\n 737 | \n 738 |         where ``attribute-name`` is a string, quoted if the name contains any\n 739 |         whitespace, and ``datatype`` can be:\n 740 | \n 741 |         - Numerical attributes as ``NUMERIC``, ``INTEGER`` or ``REAL``.\n 742 |         - Strings as ``STRING``.\n 743 |         - Dates (NOT IMPLEMENTED).\n 744 |         - Nominal attributes with format:\n 745 | \n 746 |             {<nominal-name1>, <nominal-name2>, <nominal-name3>, ...}\n 747 | \n 748 |         The nominal names follow the rules for the attribute names, i.e., they\n 749 |         must be quoted if the name contains whitespaces.\n 750 | \n 751 |         This method must receive a normalized string, i.e., a string without\n 752 |         padding, including the \"\\r\\n\" characters.\n 753 | \n 754 |         :param s: a normalized string.\n 755 |         :return: a tuple (ATTRIBUTE_NAME, TYPE_OR_VALUES).\n 756 |         '''\n 757 |         _, v = s.split(' ', 1)\n 758 |         v = v.strip()\n 759 | \n 760 |         # Verify the general structure of declaration\n 761 |         m = _RE_ATTRIBUTE.match(v)\n 762 |         if not m:\n 763 |             raise BadAttributeFormat()\n 764 | \n 765 |         # Extracts the raw name and type\n 766 |         name, type_ = m.groups()\n 767 | \n 768 |         # Extracts the final name\n 769 |         name = unicode(name.strip('\"\\''))\n 770 | \n 771 |         # Extracts the final type\n 772 |         if _RE_TYPE_NOMINAL.match(type_):\n 773 |             try:\n 774 |                 type_ = _parse_values(type_.strip('{} '))\n 775 |             except Exception:\n 776 |                 raise BadAttributeType()\n 777 |             if isinstance(type_, dict):\n 778 |                 raise BadAttributeType()\n 779 | \n 780 |         else:\n 781 |             # If not nominal, verify the type name\n 782 |             type_ = unicode(type_).upper()\n 783 |             if type_ not in ['NUMERIC', 'REAL', 'INTEGER', 'STRING']:\n 784 |                 raise BadAttributeType()\n 785 | \n 786 |         return (name, type_)\n 787 | \n 788 |     def _decode(self, s, encode_nominal=False, matrix_type=DENSE):\n 789 |         '''Do the job the ``encode``.'''\n 790 | \n 791 |         # Make sure this method is idempotent\n 792 |         self._current_line = 0\n 793 | \n 794 |         # If string, convert to a list of lines\n 795 |         if isinstance(s, basestring):\n 796 |             s = s.strip('\\r\\n ').replace('\\r\\n', '\\n').split('\\n')\n 797 | \n 798 |         # Create the return object\n 799 |         obj: ArffContainerType = {\n 800 |             u'description': u'',\n 801 |             u'relation': u'',\n 802 |             u'attributes': [],\n 803 |             u'data': []\n 804 |         }\n 805 |         attribute_names = {}\n 806 | \n 807 |         # Create the data helper object\n 808 |         data = _get_data_object_for_decoding(matrix_type)\n 809 | \n 810 |         # Read all lines\n 811 |         STATE = _TK_DESCRIPTION\n 812 |         s = iter(s)\n 813 |         for row in s:\n 814 |             self._current_line += 1\n 815 |             # Ignore empty lines\n 816 |             row = row.strip(' \\r\\n')\n 817 |             if not row: continue\n 818 | \n 819 |             u_row = row.upper()\n 820 | \n 821 |             # DESCRIPTION -----------------------------------------------------\n 822 |             if u_row.startswith(_TK_DESCRIPTION) and STATE == _TK_DESCRIPTION:\n 823 |                 obj['description'] += self._decode_comment(row) + '\\n'\n 824 |             # -----------------------------------------------------------------\n 825 | \n 826 |             # RELATION --------------------------------------------------------\n 827 |             elif u_row.startswith(_TK_RELATION):\n 828 |                 if STATE != _TK_DESCRIPTION:\n 829 |                     raise BadLayout()\n 830 | \n 831 |                 STATE = _TK_RELATION\n 832 |                 obj['relation'] = self._decode_relation(row)\n 833 |             # -----------------------------------------------------------------\n 834 | \n 835 |             # ATTRIBUTE -------------------------------------------------------\n 836 |             elif u_row.startswith(_TK_ATTRIBUTE):\n 837 |                 if STATE != _TK_RELATION and STATE != _TK_ATTRIBUTE:\n 838 |                     raise BadLayout()\n 839 | \n 840 |                 STATE = _TK_ATTRIBUTE\n 841 | \n 842 |                 attr = self._decode_attribute(row)\n 843 |                 if attr[0] in attribute_names:\n 844 |                     raise BadAttributeName(attr[0], attribute_names[attr[0]])\n 845 |                 else:\n 846 |                     attribute_names[attr[0]] = self._current_line\n 847 |                 obj['attributes'].append(attr)\n 848 | \n 849 |                 if isinstance(attr[1], (list, tuple)):\n 850 |                     if encode_nominal:\n 851 |                         conversor = EncodedNominalConversor(attr[1])\n 852 |                     else:\n 853 |                         conversor = NominalConversor(attr[1])\n 854 |                 else:\n 855 |                     CONVERSOR_MAP = {'STRING': unicode,\n 856 |                                      'INTEGER': lambda x: int(float(x)),\n 857 |                                      'NUMERIC': float,\n 858 |                                      'REAL': float}\n 859 |                     conversor = CONVERSOR_MAP[attr[1]]\n 860 | \n 861 |                 self._conversors.append(conversor)\n 862 |             # -----------------------------------------------------------------\n 863 | \n 864 |             # DATA ------------------------------------------------------------\n 865 |             elif u_row.startswith(_TK_DATA):\n 866 |                 if STATE != _TK_ATTRIBUTE:\n 867 |                     raise BadLayout()\n 868 | \n 869 |                 break\n 870 |             # -----------------------------------------------------------------\n 871 | \n 872 |             # COMMENT ---------------------------------------------------------\n 873 |             elif u_row.startswith(_TK_COMMENT):\n 874 |                 pass\n 875 |             # -----------------------------------------------------------------\n 876 |         else:\n 877 |             # Never found @DATA\n 878 |             raise BadLayout()\n 879 | \n 880 |         def stream():\n 881 |             for row in s:\n 882 |                 self._current_line += 1\n 883 |                 row = row.strip()\n 884 |                 # Ignore empty lines and comment lines.\n 885 |                 if row and not row.startswith(_TK_COMMENT):\n 886 |                     yield row\n 887 | \n 888 |         # Alter the data object\n 889 |         obj['data'] = data.decode_rows(stream(), self._conversors)\n 890 |         if obj['description'].endswith('\\n'):\n 891 |             obj['description'] = obj['description'][:-1]\n 892 | \n 893 |         return obj\n 894 | \n 895 |     def decode(self, s, encode_nominal=False, return_type=DENSE):\n 896 |         '''Returns the Python representation of a given ARFF file.\n 897 | \n 898 |         When a file object is passed as an argument, this method reads lines\n 899 |         iteratively, avoiding to load unnecessary information to the memory.\n 900 | \n 901 |         :param s: a string or file object with the ARFF file.\n 902 |         :param encode_nominal: boolean, if True perform a label encoding\n 903 |             while reading the .arff file.\n 904 |         :param return_type: determines the data structure used to store the\n 905 |             dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n 906 |             `arff.DENSE_GEN` or `arff.LOD_GEN`.\n 907 |             Consult the sections on `working with sparse data`_ and `loading\n 908 |             progressively`_.\n 909 |         '''\n 910 |         try:\n 911 |             return self._decode(s, encode_nominal=encode_nominal,\n 912 |                                 matrix_type=return_type)\n 913 |         except ArffException as e:\n 914 |             e.line = self._current_line\n 915 |             raise e\n 916 | \n 917 | \n 918 | class ArffEncoder(object):\n 919 |     '''An ARFF encoder.'''\n 920 | \n 921 |     def _encode_comment(self, s=''):\n 922 |         '''(INTERNAL) Encodes a comment line.\n 923 | \n 924 |         Comments are single line strings starting, obligatorily, with the ``%``\n 925 |         character, and can have any symbol, including whitespaces or special\n 926 |         characters.\n 927 | \n 928 |         If ``s`` is None, this method will simply return an empty comment.\n 929 | \n 930 |         :param s: (OPTIONAL) string.\n 931 |         :return: a string with the encoded comment line.\n 932 |         '''\n 933 |         if s:\n 934 |             return u'%s %s'%(_TK_COMMENT, s)\n 935 |         else:\n 936 |             return u'%s' % _TK_COMMENT\n 937 | \n 938 |     def _encode_relation(self, name):\n 939 |         '''(INTERNAL) Decodes a relation line.\n 940 | \n 941 |         The relation declaration is a line with the format ``@RELATION\n 942 |         <relation-name>``, where ``relation-name`` is a string.\n 943 | \n 944 |         :param name: a string.\n 945 |         :return: a string with the encoded relation declaration.\n 946 |         '''\n 947 |         for char in ' %{},':\n 948 |             if char in name:\n 949 |                 name = '\"%s\"'%name\n 950 |                 break\n 951 | \n 952 |         return u'%s %s'%(_TK_RELATION, name)\n 953 | \n 954 |     def _encode_attribute(self, name, type_):\n 955 |         '''(INTERNAL) Encodes an attribute line.\n 956 | \n 957 |         The attribute follow the template::\n 958 | \n 959 |              @attribute <attribute-name> <datatype>\n 960 | \n 961 |         where ``attribute-name`` is a string, and ``datatype`` can be:\n 962 | \n 963 |         - Numerical attributes as ``NUMERIC``, ``INTEGER`` or ``REAL``.\n 964 |         - Strings as ``STRING``.\n 965 |         - Dates (NOT IMPLEMENTED).\n 966 |         - Nominal attributes with format:\n 967 | \n 968 |             {<nominal-name1>, <nominal-name2>, <nominal-name3>, ...}\n 969 | \n 970 |         This method must receive a the name of the attribute and its type, if\n 971 |         the attribute type is nominal, ``type`` must be a list of values.\n 972 | \n 973 |         :param name: a string.\n 974 |         :param type_: a string or a list of string.\n 975 |         :return: a string with the encoded attribute declaration.\n 976 |         '''\n 977 |         for char in ' %{},':\n 978 |             if char in name:\n 979 |                 name = '\"%s\"'%name\n 980 |                 break\n 981 | \n 982 |         if isinstance(type_, (tuple, list)):\n 983 |             type_tmp = [u'%s' % encode_string(type_k) for type_k in type_]\n 984 |             type_ = u'{%s}'%(u', '.join(type_tmp))\n 985 | \n 986 |         return u'%s %s %s'%(_TK_ATTRIBUTE, name, type_)\n 987 | \n 988 |     def encode(self, obj):\n 989 |         '''Encodes a given object to an ARFF file.\n 990 | \n 991 |         :param obj: the object containing the ARFF information.\n 992 |         :return: the ARFF file as an unicode string.\n 993 |         '''\n 994 |         data = [row for row in self.iter_encode(obj)]\n 995 | \n 996 |         return u'\\n'.join(data)\n 997 | \n 998 |     def iter_encode(self, obj):\n 999 |         '''The iterative version of `arff.ArffEncoder.encode`.\n1000 | \n1001 |         This encodes iteratively a given object and return, one-by-one, the\n1002 |         lines of the ARFF file.\n1003 | \n1004 |         :param obj: the object containing the ARFF information.\n1005 |         :return: (yields) the ARFF file as unicode strings.\n1006 |         '''\n1007 |         # DESCRIPTION\n1008 |         if obj.get('description', None):\n1009 |             for row in obj['description'].split('\\n'):\n1010 |                 yield self._encode_comment(row)\n1011 | \n1012 |         # RELATION\n1013 |         if not obj.get('relation'):\n1014 |             raise BadObject('Relation name not found or with invalid value.')\n1015 | \n1016 |         yield self._encode_relation(obj['relation'])\n1017 |         yield u''\n1018 | \n1019 |         # ATTRIBUTES\n1020 |         if not obj.get('attributes'):\n1021 |             raise BadObject('Attributes not found.')\n1022 | \n1023 |         attribute_names = set()\n1024 |         for attr in obj['attributes']:\n1025 |             # Verify for bad object format\n1026 |             if not isinstance(attr, (tuple, list)) or \\\n1027 |                len(attr) != 2 or \\\n1028 |                not isinstance(attr[0], basestring):\n1029 |                 raise BadObject('Invalid attribute declaration \"%s\"'%str(attr))\n1030 | \n1031 |             if isinstance(attr[1], basestring):\n1032 |                 # Verify for invalid types\n1033 |                 if attr[1] not in _SIMPLE_TYPES:\n1034 |                     raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1035 | \n1036 |             # Verify for bad object format\n1037 |             elif not isinstance(attr[1], (tuple, list)):\n1038 |                 raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1039 | \n1040 |             # Verify attribute name is not used twice\n1041 |             if attr[0] in attribute_names:\n1042 |                 raise BadObject('Trying to use attribute name \"%s\" for the '\n1043 |                                 'second time.' % str(attr[0]))\n1044 |             else:\n1045 |                 attribute_names.add(attr[0])\n1046 | \n1047 |             yield self._encode_attribute(attr[0], attr[1])\n1048 |         yield u''\n1049 |         attributes = obj['attributes']\n1050 | \n1051 |         # DATA\n1052 |         yield _TK_DATA\n1053 |         if 'data' in obj:\n1054 |             data = _get_data_object_for_encoding(obj.get('data'))\n1055 |             for line in data.encode_data(obj.get('data'), attributes):\n1056 |                 yield line\n1057 | \n1058 |         yield u''\n1059 | \n1060 | # =============================================================================\n1061 | \n1062 | # BASIC INTERFACE =============================================================\n1063 | def load(fp, encode_nominal=False, return_type=DENSE):\n1064 |     '''Load a file-like object containing the ARFF document and convert it into\n1065 |     a Python object.\n1066 | \n1067 |     :param fp: a file-like object.\n1068 |     :param encode_nominal: boolean, if True perform a label encoding\n1069 |         while reading the .arff file.\n1070 |     :param return_type: determines the data structure used to store the\n1071 |         dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n1072 |         `arff.DENSE_GEN` or `arff.LOD_GEN`.\n1073 |         Consult the sections on `working with sparse data`_ and `loading\n1074 |         progressively`_.\n1075 |     :return: a dictionary.\n1076 |      '''\n1077 |     decoder = ArffDecoder()\n1078 |     return decoder.decode(fp, encode_nominal=encode_nominal,\n1079 |                           return_type=return_type)\n1080 | \n1081 | def loads(s, encode_nominal=False, return_type=DENSE):\n1082 |     '''Convert a string instance containing the ARFF document into a Python\n1083 |     object.\n1084 | \n1085 |     :param s: a string object.\n1086 |     :param encode_nominal: boolean, if True perform a label encoding\n1087 |         while reading the .arff file.\n1088 |     :param return_type: determines the data structure used to store the\n1089 |         dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n1090 |         `arff.DENSE_GEN` or `arff.LOD_GEN`.\n1091 |         Consult the sections on `working with sparse data`_ and `loading\n1092 |         progressively`_.\n1093 |     :return: a dictionary.\n1094 |     '''\n1095 |     decoder = ArffDecoder()\n1096 |     return decoder.decode(s, encode_nominal=encode_nominal,\n1097 |                           return_type=return_type)\n1098 | \n1099 | def dump(obj, fp):\n1100 |     '''Serialize an object representing the ARFF document to a given file-like\n1101 |     object.\n1102 | \n1103 |     :param obj: a dictionary.\n1104 |     :param fp: a file-like object.\n1105 |     '''\n1106 |     encoder = ArffEncoder()\n1107 |     generator = encoder.iter_encode(obj)\n1108 | \n1109 |     last_row = next(generator)\n1110 |     for row in gene