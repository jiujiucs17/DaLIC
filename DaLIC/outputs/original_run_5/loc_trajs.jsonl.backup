e, copy=False)\n374 |         intercept_init = intercept_init.astype(dtype, copy=False)\n375 |         return coef_init, intercept_init\n```\n\nFound function `sklearn/ensemble/_hist_gradient_boosting/gradient_boosting.py:BaseHistGradientBoosting._print_iteration_stats`.\nSource: Retrieved code content using keyword search (bm25).\n```\n878 | def _print_iteration_stats(self, iteration_start_time):\n879 |         \"\"\"Print info about the current fitting iteration.\"\"\"\n880 |         log_msg = \"\"\n881 | \n882 |         predictors_of_ith_iteration = [\n883 |             predictors_list\n884 |             for predictors_list in self._predictors[-1]\n885 |             if predictors_list\n886 |         ]\n887 |         n_trees = len(predictors_of_ith_iteration)\n888 |         max_depth = max(\n889 |             predictor.get_max_depth() for predictor in predictors_of_ith_iteration\n890 |         )\n891 |         n_leaves = sum(\n892 |             predictor.get_n_leaf_nodes() for predictor in predictors_of_ith_iteration\n893 |         )\n894 | \n895 |         if n_trees == 1:\n896 |             log_msg += \"{} tree, {} leaves, \".format(n_trees, n_leaves)\n897 |         else:\n898 |             log_msg += \"{} trees, {} leaves \".format(n_trees, n_leaves)\n899 |             log_msg += \"({} on avg), \".format(int(n_leaves / n_trees))\n900 | \n901 |         log_msg += \"max depth = {}, \".format(max_depth)\n902 | \n903 |         if self.do_early_stopping_:\n904 |             if self.scoring == \"loss\":\n905 |                 factor = -1  # score_ arrays contain the negative loss\n906 |                 name = \"loss\"\n907 |             else:\n908 |                 factor = 1\n909 |                 name = \"score\"\n910 |             log_msg += \"train {}: {:.5f}, \".format(name, factor * self.train_score_[-1])\n911 |             if self._use_validation_data:\n912 |                 log_msg += \"val {}: {:.5f}, \".format(\n913 |                     name, factor * self.validation_score_[-1]\n914 |                 )\n915 | \n916 |         iteration_time = time() - iteration_start_time\n917 |         log_msg += \"in {:0.3f}s\".format(iteration_time)\n918 | \n919 |         print(log_msg)\n```\n\nFound function `sklearn/datasets/_samples_generator.py:make_circles`.\nSource: Retrieved code content using keyword search (bm25).\n```\n641 | def make_circles(\n642 |     n_samples=100, *, shuffle=True, noise=None, random_state=None, factor=0.8\n643 | ):\n644 |     \"\"\"Make a large circle containing a smaller circle in 2d.\n645 | \n646 |     A simple toy dataset to visualize clustering and classification\n647 |     algorithms.\n648 | \n649 |     Read more in the :ref:`User Guide <sample_generators>`.\n650 | \n651 |     Parameters\n652 |     ----------\n653 |     n_samples : int or tuple of shape (2,), dtype=int, default=100\n654 |         If int, it is the total number of points generated.\n655 |         For odd numbers, the inner circle will have one point more than the\n656 |         outer circle.\n657 |         If two-element tuple, number of points in outer circle and inner\n658 |         circle.\n659 | \n660 |         .. versionchanged:: 0.23\n661 |            Added two-element tuple.\n662 | \n663 |     shuffle : bool, default=True\n664 |         Whether to shuffle the samples.\n665 | \n666 |     noise : float, default=None\n667 |         Standard deviation of Gaussian noise added to the data.\n668 | \n669 |     random_state : int, RandomState instance or None, default=None\n670 |         Determines random number generation for dataset shuffling and noise.\n671 |         Pass an int for reproducible output across multiple function calls.\n672 |         See :term:`Glossary <random_state>`.\n673 | \n674 |     factor : float, default=.8\n675 |         Scale factor between inner and outer circle in the range `(0, 1)`.\n676 | \n677 |     Returns\n678 |     -------\n679 |     X : ndarray of shape (n_samples, 2)\n680 |         The generated samples.\n681 | \n682 |     y : ndarray of shape (n_samples,)\n683 |         The integer labels (0 or 1) for class membership of each sample.\n684 |     \"\"\"\n685 | \n686 |     if factor >= 1 or factor < 0:\n687 |         raise ValueError(\"'factor' has to be between 0 and 1.\")\n688 | \n689 |     if isinstance(n_samples, numbers.Integral):\n690 |         n_samples_out = n_samples // 2\n691 |         n_samples_in = n_samples - n_samples_out\n692 |     else:\n693 |         try:\n694 |             n_samples_out, n_samples_in = n_samples\n695 |         except ValueError as e:\n696 |             raise ValueError(\n697 |                 \"`n_samples` can be either an int or a two-element tuple.\"\n698 |             ) from e\n699 | \n700 |     generator = check_random_state(random_state)\n701 |     # so as not to have the first point = last point, we set endpoint=False\n702 |     linspace_out = np.linspace(0, 2 * np.pi, n_samples_out, endpoint=False)\n703 |     linspace_in = np.linspace(0, 2 * np.pi, n_samples_in, endpoint=False)\n704 |     outer_circ_x = np.cos(linspace_out)\n705 |     outer_circ_y = np.sin(linspace_out)\n706 |     inner_circ_x = np.cos(linspace_in) * factor\n707 |     inner_circ_y = np.sin(linspace_in) * factor\n708 | \n709 |     X = np.vstack(\n710 |         [np.append(outer_circ_x, inner_circ_x), np.append(outer_circ_y, inner_circ_y)]\n711 |     ).T\n712 |     y = np.hstack(\n713 |         [np.zeros(n_samples_out, dtype=np.intp), np.ones(n_samples_in, dtype=np.intp)]\n714 |     )\n715 |     if shuffle:\n716 |         X, y = util_shuffle(X, y, random_state=generator)\n717 | \n718 |     if noise is not None:\n719 |         X += generator.normal(scale=noise, size=X.shape)\n720 | \n721 |     return X, y\n```\n\nFound file `benchmarks/bench_text_vectorizers.py`.\nFound file `sklearn/metrics/_classification.py`.\nFound file `sklearn/feature_extraction/_dict_vectorizer.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n"}, {"content": "Let me explore the NMF implementation structure more deeply.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/decomposition/_nmf.py:NMF']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `sklearn/decomposition/_nmf.py:NMF`...\n### Search Result:\nFound class `sklearn/decomposition/_nmf.py:NMF`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:NMF`.\n```\n1120 | class NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n1121 |     \"\"\"Non-Negative Matrix Factorization (NMF).\n1122 | \n1123 |     Find two non-negative matrices (W, H) whose product approximates the non-\n1124 |     negative matrix X. This factorization can be used for example for\n1125 |     dimensionality reduction, source separation or topic extraction.\n1126 | \n1127 |     The objective function is:\n1128 | \n1129 |         .. math::\n1130 | \n1131 |             0.5 * ||X - WH||_{loss}^2\n1132 | \n1133 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n1134 | \n1135 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n1136 | \n1137 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n1138 | \n1139 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n1140 | \n1141 |     Where:\n1142 | \n1143 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n1144 | \n1145 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n1146 | \n1147 |     The generic norm :math:`||X - WH||_{loss}` may represent\n1148 |     the Frobenius norm or another supported beta-divergence loss.\n1149 |     The choice between options is controlled by the `beta_loss` parameter.\n1150 | \n1151 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n1152 |     `H` to keep their impact balanced with respect to one another and to the data fit\n1153 |     term as independent as possible of the size `n_samples` of the training set.\n1154 | \n1155 |     The objective function is minimized with an alternating minimization of W\n1156 |     and H.\n1157 | \n1158 |     Note that the transformed data is named W and the components matrix is named H. In\n1159 |     the NMF literature, the naming convention is usually the opposite since the data\n1160 |     matrix X is transposed.\n1161 | \n1162 |     Read more in the :ref:`User Guide <NMF>`.\n1163 | \n1164 |     Parameters\n1165 |     ----------\n1166 |     n_components : int, default=None\n1167 |         Number of components, if n_components is not set all features\n1168 |         are kept.\n1169 | \n1170 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n1171 |         Method used to initialize the procedure.\n1172 |         Default: None.\n1173 |         Valid options:\n1174 | \n1175 |         - `None`: 'nndsvda' if n_components <= min(n_samples, n_features),\n1176 |           otherwise random.\n1177 | \n1178 |         - `'random'`: non-negative random matrices, scaled with:\n1179 |           sqrt(X.mean() / n_components)\n1180 | \n1181 |         - `'nndsvd'`: Nonnegative Double Singular Value Decomposition (NNDSVD)\n1182 |           initialization (better for sparseness)\n1183 | \n1184 |         - `'nndsvda'`: NNDSVD with zeros filled with the average of X\n1185 |           (better when sparsity is not desired)\n1186 | \n1187 |         - `'nndsvdar'` NNDSVD with zeros filled with small random values\n1188 |           (generally faster, less accurate alternative to NNDSVDa\n1189 |           for when sparsity is not desired)\n1190 | \n1191 |         - `'custom'`: use custom matrices W and H\n1192 | \n1193 |         .. versionchanged:: 1.1\n1194 |             When `init=None` and n_components is less than n_samples and n_features\n1195 |             defaults to `nndsvda` instead of `nndsvd`.\n1196 | \n1197 |     solver : {'cd', 'mu'}, default='cd'\n1198 |         Numerical solver to use:\n1199 |         'cd' is a Coordinate Descent solver.\n1200 |         'mu' is a Multiplicative Update solver.\n1201 | \n1202 |         .. versionadded:: 0.17\n1203 |            Coordinate Descent solver.\n1204 | \n1205 |         .. versionadded:: 0.19\n1206 |            Multiplicative Update solver.\n1207 | \n1208 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1209 |             'itakura-saito'}, default='frobenius'\n1210 |         Beta divergence to be minimized, measuring the distance between X\n1211 |         and the dot product WH. Note that values different from 'frobenius'\n1212 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1213 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1214 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1215 | \n1216 |         .. versionadded:: 0.19\n1217 | \n1218 |     tol : float, default=1e-4\n1219 |         Tolerance of the stopping condition.\n1220 | \n1221 |     max_iter : int, default=200\n1222 |         Maximum number of iterations before timing out.\n1223 | \n1224 |     random_state : int, RandomState instance or None, default=None\n1225 |         Used for initialisation (when ``init`` == 'nndsvdar' or\n1226 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1227 |         results across multiple function calls.\n1228 |         See :term:`Glossary <random_state>`.\n1229 | \n1230 |     alpha : float, default=0.0\n1231 |         Constant that multiplies the regularization terms. Set it to zero to\n1232 |         have no regularization. When using `alpha` instead of `alpha_W` and `alpha_H`,\n1233 |         the regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1234 |         factors for `W` (resp. `H`).\n1235 | \n1236 |         .. versionadded:: 0.17\n1237 |            *alpha* used in the Coordinate Descent solver.\n1238 | \n1239 |         .. deprecated:: 1.0\n1240 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1241 |             Use `alpha_W` and `alpha_H` instead.\n1242 | \n1243 |     alpha_W : float, default=0.0\n1244 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1245 |         (default) to have no regularization on `W`.\n1246 | \n1247 |         .. versionadded:: 1.0\n1248 | \n1249 |     alpha_H : float or \"same\", default=\"same\"\n1250 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1251 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1252 |         `alpha_W`.\n1253 | \n1254 |         .. versionadded:: 1.0\n1255 | \n1256 |     l1_ratio : float, default=0.0\n1257 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1258 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1259 |         (aka Frobenius Norm).\n1260 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1261 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1262 | \n1263 |         .. versionadded:: 0.17\n1264 |            Regularization parameter *l1_ratio* used in the Coordinate Descent\n1265 |            solver.\n1266 | \n1267 |     verbose : int, default=0\n1268 |         Whether to be verbose.\n1269 | \n1270 |     shuffle : bool, default=False\n1271 |         If true, randomize the order of coordinates in the CD solver.\n1272 | \n1273 |         .. versionadded:: 0.17\n1274 |            *shuffle* parameter used in the Coordinate Descent solver.\n1275 | \n1276 |     regularization : {'both', 'components', 'transformation', None}, \\\n1277 |                      default='both'\n1278 |         Select whether the regularization affects the components (H), the\n1279 |         transformation (W), both or none of them.\n1280 | \n1281 |         .. versionadded:: 0.24\n1282 | \n1283 |         .. deprecated:: 1.0\n1284 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1285 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1286 | \n1287 |     Attributes\n1288 |     ----------\n1289 |     components_ : ndarray of shape (n_components, n_features)\n1290 |         Factorization matrix, sometimes called 'dictionary'.\n1291 | \n1292 |     n_components_ : int\n1293 |         The number of components. It is same as the `n_components` parameter\n1294 |         if it was given. Otherwise, it will be same as the number of\n1295 |         features.\n1296 | \n1297 |     reconstruction_err_ : float\n1298 |         Frobenius norm of the matrix difference, or beta-divergence, between\n1299 |         the training data ``X`` and the reconstructed data ``WH`` from\n1300 |         the fitted model.\n1301 | \n1302 |     n_iter_ : int\n1303 |         Actual number of iterations.\n1304 | \n1305 |     n_features_in_ : int\n1306 |         Number of features seen during :term:`fit`.\n1307 | \n1308 |         .. versionadded:: 0.24\n1309 | \n1310 |     feature_names_in_ : ndarray of shape (`n_features_in_`,)\n1311 |         Names of features seen during :term:`fit`. Defined only when `X`\n1312 |         has feature names that are all strings.\n1313 | \n1314 |         .. versionadded:: 1.0\n1315 | \n1316 |     See Also\n1317 |     --------\n1318 |     DictionaryLearning : Find a dictionary that sparsely encodes data.\n1319 |     MiniBatchSparsePCA : Mini-batch Sparse Principal Components Analysis.\n1320 |     PCA : Principal component analysis.\n1321 |     SparseCoder : Find a sparse representation of data from a fixed,\n1322 |         precomputed dictionary.\n1323 |     SparsePCA : Sparse Principal Components Analysis.\n1324 |     TruncatedSVD : Dimensionality reduction using truncated SVD.\n1325 | \n1326 |     References\n1327 |     ----------\n1328 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1329 |     large scale nonnegative matrix and tensor factorizations.\"\n1330 |     IEICE transactions on fundamentals of electronics, communications and\n1331 |     computer sciences 92.3: 708-721, 2009.\n1332 | \n1333 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1334 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1335 | \n1336 |     Examples\n1337 |     --------\n1338 |     >>> import numpy as np\n1339 |     >>> X = np.array([[1, 1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1340 |     >>> from sklearn.decomposition import NMF\n1341 |     >>> model = NMF(n_components=2, init='random', random_state=0)\n1342 |     >>> W = model.fit_transform(X)\n1343 |     >>> H = model.components_\n1344 |     \"\"\"\n1345 | \n1346 |     def __init__(\n1347 |         self,\n1348 |         n_components=None,\n1349 |         *,\n1350 |         init=None,\n1351 |         solver=\"cd\",\n1352 |         beta_loss=\"frobenius\",\n1353 |         tol=1e-4,\n1354 |         max_iter=200,\n1355 |         random_state=None,\n1356 |         alpha=\"deprecated\",\n1357 |         alpha_W=0.0,\n1358 |         alpha_H=\"same\",\n1359 |         l1_ratio=0.0,\n1360 |         verbose=0,\n1361 |         shuffle=False,\n1362 |         regularization=\"deprecated\",\n1363 |     ):\n1364 |         self.n_components = n_components\n1365 |         self.init = init\n1366 |         self.solver = solver\n1367 |         self.beta_loss = beta_loss\n1368 |         self.tol = tol\n1369 |         self.max_iter = max_iter\n1370 |         self.random_state = random_state\n1371 |         self.alpha = alpha\n1372 |         self.alpha_W = alpha_W\n1373 |         self.alpha_H = alpha_H\n1374 |         self.l1_ratio = l1_ratio\n1375 |         self.verbose = verbose\n1376 |         self.shuffle = shuffle\n1377 |         self.regularization = regularization\n1378 | \n1379 |     def _more_tags(self):\n1380 |         return {\"requires_positive_X\": True}\n1381 | \n1382 |     def _check_params(self, X):\n1383 |         # n_components\n1384 |         self._n_components = self.n_components\n1385 |         if self._n_components is None:\n1386 |             self._n_components = X.shape[1]\n1387 |         if (\n1388 |             not isinstance(self._n_components, numbers.Integral)\n1389 |             or self._n_components <= 0\n1390 |         ):\n1391 |             raise ValueError(\n1392 |                 \"Number of components must be a positive integer; got \"\n1393 |                 f\"(n_components={self._n_components!r})\"\n1394 |             )\n1395 | \n1396 |         # max_iter\n1397 |         if not isinstance(self.max_iter, numbers.Integral) or self.max_iter < 0:\n1398 |             raise ValueError(\n1399 |                 \"Maximum number of iterations must be a positive \"\n1400 |                 f\"integer; got (max_iter={self.max_iter!r})\"\n1401 |             )\n1402 | \n1403 |         # tol\n1404 |         if not isinstance(self.tol, numbers.Number) or self.tol < 0:\n1405 |             raise ValueError(\n1406 |                 \"Tolerance for stopping criteria must be positive; got \"\n1407 |                 f\"(tol={self.tol!r})\"\n1408 |             )\n1409 | \n1410 |         # beta_loss\n1411 |         self._beta_loss = _beta_loss_to_float(self.beta_loss)\n1412 | \n1413 |         # solver\n1414 |         allowed_solver = (\"cd\", \"mu\")\n1415 |         if self.solver not in allowed_solver:\n1416 |             raise ValueError(\n1417 |                 f\"Invalid solver parameter: got {self.solver!r} instead of one of \"\n1418 |                 f\"{allowed_solver}\"\n1419 |             )\n1420 |         if self.solver != \"mu\" and self.beta_loss not in (2, \"frobenius\"):\n1421 |             # 'mu' is the only solver that handles other beta losses than 'frobenius'\n1422 |             raise ValueError(\n1423 |                 f\"Invalid beta_loss parameter: solver {self.solver!r} does not handle \"\n1424 |                 f\"beta_loss = {self.beta_loss!r}\"\n1425 |             )\n1426 |         if self.solver == \"mu\" and self.init == \"nndsvd\":\n1427 |             warnings.warn(\n1428 |                 \"The multiplicative update ('mu') solver cannot update \"\n1429 |                 \"zeros present in the initialization, and so leads to \"\n1430 |                 \"poorer results when used jointly with init='nndsvd'. \"\n1431 |                 \"You may try init='nndsvda' or init='nndsvdar' instead.\",\n1432 |                 UserWarning,\n1433 |             )\n1434 | \n1435 |         # alpha and regularization are deprecated in favor of alpha_W and alpha_H\n1436 |         # TODO clean up in 1.2\n1437 |         if self.alpha != \"deprecated\":\n1438 |             warnings.warn(\n1439 |                 \"`alpha` was deprecated in version 1.0 and will be removed \"\n1440 |                 \"in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1441 |                 FutureWarning,\n1442 |             )\n1443 |             alpha = self.alpha\n1444 |         else:\n1445 |             alpha = 0.0\n1446 | \n1447 |         if self.regularization != \"deprecated\":\n1448 |             warnings.warn(\n1449 |                 \"`regularization` was deprecated in version 1.0 and will be \"\n1450 |                 \"removed in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1451 |                 FutureWarning,\n1452 |             )\n1453 |             allowed_regularization = (\"both\", \"components\", \"transformation\", None)\n1454 |             if self.regularization not in allowed_regularization:\n1455 |                 raise ValueError(\n1456 |                     f\"Invalid regularization parameter: got {self.regularization!r} \"\n1457 |                     f\"instead of one of {allowed_regularization}\"\n1458 |                 )\n1459 |             regularization = self.regularization\n1460 |         else:\n1461 |             regularization = \"both\"\n1462 | \n1463 |         (\n1464 |             self._l1_reg_W,\n1465 |             self._l1_reg_H,\n1466 |             self._l2_reg_W,\n1467 |             self._l2_reg_H,\n1468 |         ) = _compute_regularization(\n1469 |             alpha, self.alpha_W, self.alpha_H, self.l1_ratio, regularization\n1470 |         )\n1471 | \n1472 |         return self\n1473 | \n1474 |     def _check_w_h(self, X, W, H, update_H):\n1475 |         # check W and H, or initialize them\n1476 |         n_samples, n_features = X.shape\n1477 |         if self.init == \"custom\" and update_H:\n1478 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1479 |             _check_init(W, (n_samples, self._n_components), \"NMF (input W)\")\n1480 |             if H.dtype != X.dtype or W.dtype != X.dtype:\n1481 |                 raise TypeError(\n1482 |                     \"H and W should have the same dtype as X. Got \"\n1483 |                     \"H.dtype = {} and W.dtype = {}.\".format(H.dtype, W.dtype)\n1484 |                 )\n1485 |         elif not update_H:\n1486 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1487 |             if H.dtype != X.dtype:\n1488 |                 raise TypeError(\n1489 |                     \"H should have the same dtype as X. Got H.dtype = {}.\".format(\n1490 |                         H.dtype\n1491 |                     )\n1492 |                 )\n1493 |             # 'mu' solver should not be initialized by zeros\n1494 |             if self.solver == \"mu\":\n1495 |                 avg = np.sqrt(X.mean() / self._n_components)\n1496 |                 W = np.full((n_samples, self._n_components), avg, dtype=X.dtype)\n1497 |             else:\n1498 |                 W = np.zeros((n_samples, self._n_components), dtype=X.dtype)\n1499 |         else:\n1500 |             W, H = _initialize_nmf(\n1501 |                 X, self._n_components, init=self.init, random_state=self.random_state\n1502 |             )\n1503 |         return W, H\n1504 | \n1505 |     def _scale_regularization(self, X):\n1506 |         n_samples, n_features = X.shape\n1507 |         if self.alpha_W != 0 or self.alpha_H != \"same\":\n1508 |             # if alpha_W or alpha_H is not left to its default value we ignore alpha\n1509 |             # and regularization, and we scale the regularization terms.\n1510 |             l1_reg_W = n_features * self._l1_reg_W\n1511 |             l1_reg_H = n_samples * self._l1_reg_H\n1512 |             l2_reg_W = n_features * self._l2_reg_W\n1513 |             l2_reg_H = n_samples * self._l2_reg_H\n1514 |         else:\n1515 |             # Otherwise we keep the old behavior with no scaling\n1516 |             # TODO remove in 1.2\n1517 |             l1_reg_W = self._l1_reg_W\n1518 |             l1_reg_H = self._l1_reg_H\n1519 |             l2_reg_W = self._l2_reg_W\n1520 |             l2_reg_H = self._l2_reg_H\n1521 | \n1522 |         return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n1523 | \n1524 |     def fit_transform(self, X, y=None, W=None, H=None):\n1525 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1526 | \n1527 |         This is more efficient than calling fit followed by transform.\n1528 | \n1529 |         Parameters\n1530 |         ----------\n1531 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1532 |             Training vector, where `n_samples` is the number of samples\n1533 |             and `n_features` is the number of features.\n1534 | \n1535 |         y : Ignored\n1536 |             Not used, present for API consistency by convention.\n1537 | \n1538 |         W : array-like of shape (n_samples, n_components)\n1539 |             If init='custom', it is used as initial guess for the solution.\n1540 | \n1541 |         H : array-like of shape (n_components, n_features)\n1542 |             If init='custom', it is used as initial guess for the solution.\n1543 | \n1544 |         Returns\n1545 |         -------\n1546 |         W : ndarray of shape (n_samples, n_components)\n1547 |             Transformed data.\n1548 |         \"\"\"\n1549 |         X = self._validate_data(\n1550 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n1551 |         )\n1552 | \n1553 |         with config_context(assume_finite=True):\n1554 |             W, H, n_iter = self._fit_transform(X, W=W, H=H)\n1555 | \n1556 |         self.reconstruction_err_ = _beta_divergence(\n1557 |             X, W, H, self._beta_loss, square_root=True\n1558 |         )\n1559 | \n1560 |         self.n_components_ = H.shape[0]\n1561 |         self.components_ = H\n1562 |         self.n_iter_ = n_iter\n1563 | \n1564 |         return W\n1565 | \n1566 |     def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n1567 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1568 | \n1569 |         Parameters\n1570 |         ----------\n1571 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1572 |             Data matrix to be decomposed\n1573 | \n1574 |         y : Ignored\n1575 | \n1576 |         W : array-like of shape (n_samples, n_components)\n1577 |             If init='custom', it is used as initial guess for the solution.\n1578 | \n1579 |         H : array-like of shape (n_components, n_features)\n1580 |             If init='custom', it is used as initial guess for the solution.\n1581 |             If update_H=False, it is used as a constant, to solve for W only.\n1582 | \n1583 |         update_H : bool, default=True\n1584 |             If True, both W and H will be estimated from initial guesses,\n1585 |             this corresponds to a call to the 'fit_transform' method.\n1586 |             If False, only W will be estimated, this corresponds to a call\n1587 |             to the 'transform' method.\n1588 | \n1589 |         Returns\n1590 |         -------\n1591 |         W : ndarray of shape (n_samples, n_components)\n1592 |             Transformed data.\n1593 | \n1594 |         H : ndarray of shape (n_components, n_features)\n1595 |             Factorization matrix, sometimes called 'dictionary'.\n1596 | \n1597 |         n_iter_ : int\n1598 |             Actual number of iterations.\n1599 |         \"\"\"\n1600 |         check_non_negative(X, \"NMF (input X)\")\n1601 | \n1602 |         # check parameters\n1603 |         self._check_params(X)\n1604 | \n1605 |         if X.min() == 0 and self._beta_loss <= 0:\n1606 |             raise ValueError(\n1607 |                 \"When beta_loss <= 0 and X contains zeros, \"\n1608 |                 \"the solver may diverge. Please add small values \"\n1609 |                 \"to X, or use a positive beta_loss.\"\n1610 |             )\n1611 | \n1612 |         # initialize or check W and H\n1613 |         W, H = self._check_w_h(X, W, H, update_H)\n1614 | \n1615 |         # scale the regularization terms\n1616 |         l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H = self._scale_regularization(X)\n1617 | \n1618 |         if self.solver == \"cd\":\n1619 |             W, H, n_iter = _fit_coordinate_descent(\n1620 |                 X,\n1621 |                 W,\n1622 |                 H,\n1623 |                 self.tol,\n1624 |                 self.max_iter,\n1625 |                 l1_reg_W,\n1626 |                 l1_reg_H,\n1627 |                 l2_reg_W,\n1628 |                 l2_reg_H,\n1629 |                 update_H=update_H,\n1630 |                 verbose=self.verbose,\n1631 |                 shuffle=self.shuffle,\n1632 |                 random_state=self.random_state,\n1633 |             )\n1634 |         elif self.solver == \"mu\":\n1635 |             W, H, n_iter = _fit_multiplicative_update(\n1636 |                 X,\n1637 |                 W,\n1638 |                 H,\n1639 |                 self._beta_loss,\n1640 |                 self.max_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params)\n1684 |         return self\n1685 | \n1686 |     def transform(self, X):\n1687 |         \"\"\"Transform the data X according to the fitted NMF model.\n1688 | \n1689 |         Parameters\n1690 |         ----------\n1691 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1692 |             Training vector, where `n_samples` is the number of samples\n1693 |             and `n_features` is the number of features.\n1694 | \n1695 |         Returns\n1696 |         -------\n1697 |         W : ndarray of shape (n_samples, n_components)\n1698 |             Transformed data.\n1699 |         \"\"\"\n1700 |         check_is_fitted(self)\n1701 |         X = self._validate_data(\n1702 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n1703 |         )\n1704 | \n1705 |         with config_context(assume_finite=True):\n1706 |             W, *_ = self._fit_transform(X, H=self.components_, update_H=False)\n1707 | \n1708 |         return W\n1709 | \n1710 |     def inverse_transform(self, W):\n1711 |         \"\"\"Transform data back to its original space.\n1712 | \n1713 |         .. versionadded:: 0.18\n1714 | \n1715 |         Parameters\n1716 |         ----------\n1717 |         W : {ndarray, sparse matrix} of shape (n_samples, n_components)\n1718 |             Transformed data matrix.\n1719 | \n1720 |         Returns\n1721 |         -------\n1722 |         X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n1723 |             Returns a data matrix of the original shape.\n1724 |         \"\"\"\n1725 |         check_is_fitted(self)\n1726 |         return np.dot(W, self.components_)\n1727 | \n1728 |     @property\n1729 |     def _n_features_out(self):\n1730 |         \"\"\"Number of transformed output features.\"\"\"\n1731 |         return self.components_.shape[0]\n```\n"}, {"content": "Let me also check for any related implementation files:\n\n<function=search_code_snippets>\n<parameter=search_terms>['_fit_coordinate_descent', '_fit_multiplicative_update']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"_fit_coordinate_descent\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_fit_coordinate_descent`.\nSource: Match found for entity name `_fit_coordinate_descent`.\n```\n417 | def _fit_coordinate_descent(\n418 |     X,\n419 |     W,\n420 |     H,\n421 |     tol=1e-4,\n422 |     max_iter=200,\n423 |     l1_reg_W=0,\n424 |     l1_reg_H=0,\n425 |     l2_reg_W=0,\n426 |     l2_reg_H=0,\n427 |     update_H=True,\n428 |     verbose=0,\n429 |     shuffle=False,\n430 |     random_state=None,\n431 | ):\n432 |     \"\"\"Compute Non-negative Matrix Factorization (NMF) with Coordinate Descent\n433 | \n434 |     The objective function is minimized with an alternating minimization of W\n435 |     and H. Each minimization is done with a cyclic (up to a permutation of the\n436 |     features) Coordinate Descent.\n437 | \n438 |     Parameters\n439 |     ----------\n440 |     X : array-like of shape (n_samples, n_features)\n441 |         Constant matrix.\n442 | \n443 |     W : array-like of shape (n_samples, n_components)\n444 |         Initial guess for the solution.\n445 | \n446 |     H : array-like of shape (n_components, n_features)\n447 |         Initial guess for the solution.\n448 | \n449 |     tol : float, default=1e-4\n450 |         Tolerance of the stopping condition.\n451 | \n452 |     max_iter : int, default=200\n453 |         Maximum number of iterations before timing out.\n454 | \n455 |     l1_reg_W : float, default=0.\n456 |         L1 regularization parameter for W.\n457 | \n458 |     l1_reg_H : float, default=0.\n459 |         L1 regularization parameter for H.\n460 | \n461 |     l2_reg_W : float, default=0.\n462 |         L2 regularization parameter for W.\n463 | \n464 |     l2_reg_H : float, default=0.\n465 |         L2 regularization parameter for H.\n466 | \n467 |     update_H : bool, default=True\n468 |         Set to True, both W and H will be estimated from initial guesses.\n469 |         Set to False, only W will be estimated.\n470 | \n471 |     verbose : int, default=0\n472 |         The verbosity level.\n473 | \n474 |     shuffle : bool, default=False\n475 |         If true, randomize the order of coordinates in the CD solver.\n476 | \n477 |     random_state : int, RandomState instance or None, default=None\n478 |         Used to randomize the coordinates in the CD solver, when\n479 |         ``shuffle`` is set to ``True``. Pass an int for reproducible\n480 |         results across multiple function calls.\n481 |         See :term:`Glossary <random_state>`.\n482 | \n483 |     Returns\n484 |     -------\n485 |     W : ndarray of shape (n_samples, n_components)\n486 |         Solution to the non-negative least squares problem.\n487 | \n488 |     H : ndarray of shape (n_components, n_features)\n489 |         Solution to the non-negative least squares problem.\n490 | \n491 |     n_iter : int\n492 |         The number of iterations done by the algorithm.\n493 | \n494 |     References\n495 |     ----------\n496 |     Cichocki, Andrzej, and Phan, Anh-Huy. \"Fast local algorithms for\n497 |     large scale nonnegative matrix and tensor factorizations.\"\n498 |     IEICE transactions on fundamentals of electronics, communications and\n499 |     computer sciences 92.3: 708-721, 2009.\n500 |     \"\"\"\n501 |     # so W and Ht are both in C order in memory\n502 |     Ht = check_array(H.T, order=\"C\")\n503 |     X = check_array(X, accept_sparse=\"csr\")\n504 | \n505 |     rng = check_random_state(random_state)\n506 | \n507 |     for n_iter in range(1, max_iter + 1):\n508 |         violation = 0.0\n509 | \n510 |         # Update W\n511 |         violation += _update_coordinate_descent(\n512 |             X, W, Ht, l1_reg_W, l2_reg_W, shuffle, rng\n513 |         )\n514 |         # Update H\n515 |         if update_H:\n516 |             violation += _update_coordinate_descent(\n517 |                 X.T, Ht, W, l1_reg_H, l2_reg_H, shuffle, rng\n518 |             )\n519 | \n520 |         if n_iter == 1:\n521 |             violation_init = violation\n522 | \n523 |         if violation_init == 0:\n524 |             break\n525 | \n526 |         if verbose:\n527 |             print(\"violation:\", violation / violation_init)\n528 | \n529 |         if violation / violation_init <= tol:\n530 |             if verbose:\n531 |                 print(\"Converged at iteration\", n_iter + 1)\n532 |             break\n533 | \n534 |     return W, Ht.T, n_iter\n```\n\n\n\n##Searching for term \"_fit_multiplicative_update\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\nSource: Match found for entity name `_fit_multiplicative_update`.\n```\n725 | def _fit_multiplicative_update(\n726 |     X,\n727 |     W,\n728 |     H,\n729 |     beta_loss=\"frobenius\",\n730 |     max_iter=200,\n731 |     tol=1e-4,\n732 |     l1_reg_W=0,\n733 |     l1_reg_H=0,\n734 |     l2_reg_W=0,\n735 |     l2_reg_H=0,\n736 |     update_H=True,\n737 |     verbose=0,\n738 | ):\n739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n740 | \n741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n742 |     alternating minimization of W and H. Each minimization is done with a\n743 |     Multiplicative Update.\n744 | \n745 |     Parameters\n746 |     ----------\n747 |     X : array-like of shape (n_samples, n_features)\n748 |         Constant input matrix.\n749 | \n750 |     W : array-like of shape (n_samples, n_components)\n751 |         Initial guess for the solution.\n752 | \n753 |     H : array-like of shape (n_components, n_features)\n754 |         Initial guess for the solution.\n755 | \n756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n757 |             'itakura-saito'}, default='frobenius'\n758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n759 |         Beta divergence to be minimized, measuring the distance between X\n760 |         and the dot product WH. Note that values different from 'frobenius'\n761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n763 |         matrix X cannot contain zeros.\n764 | \n765 |     max_iter : int, default=200\n766 |         Number of iterations.\n767 | \n768 |     tol : float, default=1e-4\n769 |         Tolerance of the stopping condition.\n770 | \n771 |     l1_reg_W : float, default=0.\n772 |         L1 regularization parameter for W.\n773 | \n774 |     l1_reg_H : float, default=0.\n775 |         L1 regularization parameter for H.\n776 | \n777 |     l2_reg_W : float, default=0.\n778 |         L2 regularization parameter for W.\n779 | \n780 |     l2_reg_H : float, default=0.\n781 |         L2 regularization parameter for H.\n782 | \n783 |     update_H : bool, default=True\n784 |         Set to True, both W and H will be estimated from initial guesses.\n785 |         Set to False, only W will be estimated.\n786 | \n787 |     verbose : int, default=0\n788 |         The verbosity level.\n789 | \n790 |     Returns\n791 |     -------\n792 |     W : ndarray of shape (n_samples, n_components)\n793 |         Solution to the non-negative least squares problem.\n794 | \n795 |     H : ndarray of shape (n_components, n_features)\n796 |         Solution to the non-negative least squares problem.\n797 | \n798 |     n_iter : int\n799 |         The number of iterations done by the algorithm.\n800 | \n801 |     References\n802 |     ----------\n803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n805 |     \"\"\"\n806 |     start_time = time.time()\n807 | \n808 |     beta_loss = _beta_loss_to_float(beta_loss)\n809 | \n810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n811 |     if beta_loss < 1:\n812 |         gamma = 1.0 / (2.0 - beta_loss)\n813 |     elif beta_loss > 2:\n814 |         gamma = 1.0 / (beta_loss - 1.0)\n815 |     else:\n816 |         gamma = 1.0\n817 | \n818 |     # used for the convergence criterion\n819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n820 |     previous_error = error_at_init\n821 | \n822 |     H_sum, HHt, XHt = None, None, None\n823 |     for n_iter in range(1, max_iter + 1):\n824 |         # update W\n825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n"}, {"content": "Let me also check for related utility functions:\n\n<function=search_code_snippets>\n<parameter=search_terms>['_multiplicative_update_w', '_multiplicative_update_h', '_beta_divergence']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"_multiplicative_update_w\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_w`.\nSource: Match found for entity name `_multiplicative_update_w`.\n```\n537 | def _multiplicative_update_w(\n538 |     X,\n539 |     W,\n540 |     H,\n541 |     beta_loss,\n542 |     l1_reg_W,\n543 |     l2_reg_W,\n544 |     gamma,\n545 |     H_sum=None,\n546 |     HHt=None,\n547 |     XHt=None,\n548 |     update_H=True,\n549 | ):\n550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n551 |     if beta_loss == 2:\n552 |         # Numerator\n553 |         if XHt is None:\n554 |             XHt = safe_sparse_dot(X, H.T)\n555 |         if update_H:\n556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n557 |             numerator = XHt\n558 |         else:\n559 |             # preserve the XHt, which is not re-computed (update_H=False)\n560 |             numerator = XHt.copy()\n561 | \n562 |         # Denominator\n563 |         if HHt is None:\n564 |             HHt = np.dot(H, H.T)\n565 |         denominator = np.dot(W, HHt)\n566 | \n567 |     else:\n568 |         # Numerator\n569 |         # if X is sparse, compute WH only where X is non zero\n570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n571 |         if sp.issparse(X):\n572 |             WH_safe_X_data = WH_safe_X.data\n573 |             X_data = X.data\n574 |         else:\n575 |             WH_safe_X_data = WH_safe_X\n576 |             X_data = X\n577 |             # copy used in the Denominator\n578 |             WH = WH_safe_X.copy()\n579 |             if beta_loss - 1.0 < 0:\n580 |                 WH[WH == 0] = EPSILON\n581 | \n582 |         # to avoid taking a negative power of zero\n583 |         if beta_loss - 2.0 < 0:\n584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n585 | \n586 |         if beta_loss == 1:\n587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n588 |         elif beta_loss == 0:\n589 |             # speeds up computation time\n590 |             # refer to /numpy/numpy/issues/9363\n591 |             WH_safe_X_data **= -1\n592 |             WH_safe_X_data **= 2\n593 |             # element-wise multiplication\n594 |             WH_safe_X_data *= X_data\n595 |         else:\n596 |             WH_safe_X_data **= beta_loss - 2\n597 |             # element-wise multiplication\n598 |             WH_safe_X_data *= X_data\n599 | \n600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n602 | \n603 |         # Denominator\n604 |         if beta_loss == 1:\n605 |             if H_sum is None:\n606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n607 |             denominator = H_sum[np.newaxis, :]\n608 | \n609 |         else:\n610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n611 |             if sp.issparse(X):\n612 |                 # memory efficient computation\n613 |                 # (compute row by row, avoiding the dense matrix WH)\n614 |                 WHHt = np.empty(W.shape)\n615 |                 for i in range(X.shape[0]):\n616 |                     WHi = np.dot(W[i, :], H)\n617 |                     if beta_loss - 1 < 0:\n618 |                         WHi[WHi == 0] = EPSILON\n619 |                     WHi **= beta_loss - 1\n620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n621 |             else:\n622 |                 WH **= beta_loss - 1\n623 |                 WHHt = np.dot(WH, H.T)\n624 |             denominator = WHHt\n625 | \n626 |     # Add L1 and L2 regularization\n627 |     if l1_reg_W > 0:\n628 |         denominator += l1_reg_W\n629 |     if l2_reg_W > 0:\n630 |         denominator = denominator + l2_reg_W * W\n631 |     denominator[denominator == 0] = EPSILON\n632 | \n633 |     numerator /= denominator\n634 |     delta_W = numerator\n635 | \n636 |     # gamma is in ]0, 1]\n637 |     if gamma != 1:\n638 |         delta_W **= gamma\n639 | \n640 |     return delta_W, H_sum, HHt, XHt\n```\n\n\n\n##Searching for term \"_multiplicative_update_h\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_h`.\nSource: Match found for entity name `_multiplicative_update_h`.\n```\n643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n645 |     if beta_loss == 2:\n646 |         numerator = safe_sparse_dot(W.T, X)\n647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n648 | \n649 |     else:\n650 |         # Numerator\n651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n652 |         if sp.issparse(X):\n653 |             WH_safe_X_data = WH_safe_X.data\n654 |             X_data = X.data\n655 |         else:\n656 |             WH_safe_X_data = WH_safe_X\n657 |             X_data = X\n658 |             # copy used in the Denominator\n659 |             WH = WH_safe_X.copy()\n660 |             if beta_loss - 1.0 < 0:\n661 |                 WH[WH == 0] = EPSILON\n662 | \n663 |         # to avoid division by zero\n664 |         if beta_loss - 2.0 < 0:\n665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n666 | \n667 |         if beta_loss == 1:\n668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n669 |         elif beta_loss == 0:\n670 |             # speeds up computation time\n671 |             # refer to /numpy/numpy/issues/9363\n672 |             WH_safe_X_data **= -1\n673 |             WH_safe_X_data **= 2\n674 |             # element-wise multiplication\n675 |             WH_safe_X_data *= X_data\n676 |         else:\n677 |             WH_safe_X_data **= beta_loss - 2\n678 |             # element-wise multiplication\n679 |             WH_safe_X_data *= X_data\n680 | \n681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n683 | \n684 |         # Denominator\n685 |         if beta_loss == 1:\n686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n687 |             W_sum[W_sum == 0] = 1.0\n688 |             denominator = W_sum[:, np.newaxis]\n689 | \n690 |         # beta_loss not in (1, 2)\n691 |         else:\n692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n693 |             if sp.issparse(X):\n694 |                 # memory efficient computation\n695 |                 # (compute column by column, avoiding the dense matrix WH)\n696 |                 WtWH = np.empty(H.shape)\n697 |                 for i in range(X.shape[1]):\n698 |                     WHi = np.dot(W, H[:, i])\n699 |                     if beta_loss - 1 < 0:\n700 |                         WHi[WHi == 0] = EPSILON\n701 |                     WHi **= beta_loss - 1\n702 |                     WtWH[:, i] = np.dot(W.T, WHi)\n703 |             else:\n704 |                 WH **= beta_loss - 1\n705 |                 WtWH = np.dot(W.T, WH)\n706 |             denominator = WtWH\n707 | \n708 |     # Add L1 and L2 regularization\n709 |     if l1_reg_H > 0:\n710 |         denominator += l1_reg_H\n711 |     if l2_reg_H > 0:\n712 |         denominator = denominator + l2_reg_H * H\n713 |     denominator[denominator == 0] = EPSILON\n714 | \n715 |     numerator /= denominator\n716 |     delta_H = numerator\n717 | \n718 |     # gamma is in ]0, 1]\n719 |     if gamma != 1:\n720 |         delta_H **= gamma\n721 | \n722 |     return delta_H\n```\n\n\n\n##Searching for term \"_beta_divergence\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_beta_divergence`.\nSource: Match found for entity name `_beta_divergence`.\n```\n 68 | def _beta_divergence(X, W, H, beta, square_root=False):\n 69 |     \"\"\"Compute the beta-divergence of X and dot(W, H).\n 70 | \n 71 |     Parameters\n 72 |     ----------\n 73 |     X : float or array-like of shape (n_samples, n_features)\n 74 | \n 75 |     W : float or array-like of shape (n_samples, n_components)\n 76 | \n 77 |     H : float or array-like of shape (n_components, n_features)\n 78 | \n 79 |     beta : float or {'frobenius', 'kullback-leibler', 'itakura-saito'}\n 80 |         Parameter of the beta-divergence.\n 81 |         If beta == 2, this is half the Frobenius *squared* norm.\n 82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n 83 |         If beta == 0, this is the Itakura-Saito divergence.\n 84 |         Else, this is the general beta-divergence.\n 85 | \n 86 |     square_root : bool, default=False\n 87 |         If True, return np.sqrt(2 * res)\n 88 |         For beta == 2, it corresponds to the Frobenius norm.\n 89 | \n 90 |     Returns\n 91 |     -------\n 92 |         res : float\n 93 |             Beta divergence of X and np.dot(X, H).\n 94 |     \"\"\"\n 95 |     beta = _beta_loss_to_float(beta)\n 96 | \n 97 |     # The method can be called with scalars\n 98 |     if not sp.issparse(X):\n 99 |         X = np.atleast_2d(X)\n100 |     W = np.atleast_2d(W)\n101 |     H = np.atleast_2d(H)\n102 | \n103 |     # Frobenius norm\n104 |     if beta == 2:\n105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n106 |         if sp.issparse(X):\n107 |             norm_X = np.dot(X.data, X.data)\n108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n109 |             cross_prod = trace_dot((X * H.T), W)\n110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n111 |         else:\n112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n"}, {"content": "Based on my analysis, here are the key files and functions that need to be modified to implement online NMF:\n\n```\nsklearn/decomposition/_nmf.py\nline: 1120-1346\nclass: NMF\nfunction: __init__, _check_params, _fit_transform, _fit_coordinate_descent, _multiplicative_update_w, _multiplicative_update_h, _beta_divergence\n\nsklearn/decomposition/_nmf.py\nline: 874-1112\nfunction: non_negative_factorization\n\nsklearn/decomposition/_nmf.py\nline: 417-534\nfunction: _fit_coordinate_descent\n\nsklearn/decomposition/_nmf.py\nline: 725-871\nfunction: _fit_multiplicative_update\n\nsklearn/decomposition/_nmf.py\nline: 643-722\nfunction: _multiplicative_update_h\n```\n\nThe main modifications needed are focused on the NMF class in `sklearn/decomposition/_nmf.py`. Specifically:\n\n1. The `NMF` class needs to be enhanced to support online learning:\n   - Track running sums of sufficient statistics\n   - Modify `_fit_transform` to operate on batches instead of full datasets\n   - Update initialization logic for online setting\n\n2. The core algorithms `_fit_coordinate_descent` and `_fit_multiplicative_update` need modifications to:\n   - Handle streaming data instead of batch processing\n   - Manage internal state for online learning\n   - Update regularization terms dynamically\n\n3. The `_multiplicative_update_w` and `_multiplicative_update_h` functions need to:\n   - Adjust to work with online data streams\n   - Manage buffer states for sufficient statistics\n   - Update regularization calculations over windows\n\n4. The `non_negative_factorization` function would need modifications to support online mode:\n   - Add online-specific parameters\n   - Implement online learning logic\n   - Update return values for online case\n\nThese modifications would enable the implementation of online NMF with beta-divergence support, meeting the feature request's requirements.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 197555, "completion_tokens": 717}, "time": 132.36574482917786}]}}
{"instance_id": "scikit-learn__scikit-learn-30128", "found_files": [["sklearn/metrics/_regression.py", "sklearn/utils/_array_api.py"]], "found_modules": [["examples/gaussian_process/plot_gpr_on_structured_data.py:SequenceKernel", "benchmarks/bench_sparsify.py:score", "doc/sphinxext/dropdown_anchors.py:setup", "sklearn/externals/_packaging/_structures.py:NegativeInfinityType", "sklearn/utils/_mocking.py:MockDataFrame", "benchmarks/bench_tsne_mnist.py:sanitize", "doc/conftest.py:setup_grid_search", "examples/linear_model/plot_sgd_iris.py:plot_hyperplane", "examples/cluster/plot_adjusted_for_chance_measures.py:random_labels", "sklearn/utils/fixes.py:_object_dtype_isnan", "benchmarks/bench_sparsify.py:benchmark_dense_predict", "doc/sphinxext/sphinx_issues.py:IssueRole", "asv_benchmarks/benchmarks/decomposition.py:MiniBatchDictionaryLearningBenchmark", "examples/ensemble/plot_adaboost_multiclass.py:misclassification_error", "sklearn/utils/parallel.py:delayed", "examples/applications/plot_out_of_core_classification.py:ReutersParser", "doc/conftest.py:skip_if_cupy_not_installed", "examples/ensemble/plot_feature_transformation.py:gbdt_apply", "asv_benchmarks/benchmarks/common.py:Estimator", "sklearn/metrics/_regression.py:_check_reg_targets", "sklearn/metrics/pairwise.py:_argmin_reduce", "sklearn/utils/_metadata_requests.py:MetadataRequest", "sklearn/ensemble/_hist_gradient_boosting/grower.py:TreeGrower", "examples/miscellaneous/plot_metadata_routing.py:ExampleRegressor", "doc/conf.py:reset_sklearn_config", "sklearn/utils/validation.py:_check_estimator_name", "sklearn/utils/_array_api.py:_find_matching_floating_dtype", "doc/api_reference.py:_get_guide", "benchmarks/bench_plot_incremental_pca.py:plot_results", "examples/linear_model/plot_sgd_loss_functions.py:modified_huber_loss", "benchmarks/bench_isotonic.py:generate_perturbed_logarithm_dataset", "sklearn/utils/_estimator_html_repr.py:_get_css_style", "asv_benchmarks/benchmarks/svm.py:SVCBenchmark", "benchmarks/bench_glmne