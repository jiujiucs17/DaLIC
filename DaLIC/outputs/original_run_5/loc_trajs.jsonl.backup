100, 40, 50]\n8925 |         >>> df[\"week_starting\"] = pd.date_range(\"01/01/2018\", periods=8, freq=\"W\")\n8926 |         >>> df\n8927 |            price  volume week_starting\n8928 |         0     10      50    2018-01-07\n8929 |         1     11      60    2018-01-14\n8930 |         2      9      40    2018-01-21\n8931 |         3     13     100    2018-01-28\n8932 |         4     14      50    2018-02-04\n8933 |         5     18     100    2018-02-11\n8934 |         6     17      40    2018-02-18\n8935 |         7     19      50    2018-02-25\n8936 |         >>> df.resample(\"ME\", on=\"week_starting\").mean()\n8937 |                        price  volume\n8938 |         week_starting\n8939 |         2018-01-31     10.75    62.5\n8940 |         2018-02-28     17.00    60.0\n8941 | \n8942 |         For a DataFrame with MultiIndex, the keyword `level` can be used to\n8943 |         specify on which level the resampling needs to take place.\n8944 | \n8945 |         >>> days = pd.date_range(\"1/1/2000\", periods=4, freq=\"D\")\n8946 |         >>> df2 = pd.DataFrame(\n8947 |         ...     [\n8948 |         ...         [10, 50],\n8949 |         ...         [11, 60],\n8950 |         ...         [9, 40],\n8951 |         ...         [13, 100],\n8952 |         ...         [14, 50],\n8953 |         ...         [18, 100],\n8954 |         ...         [17, 40],\n8955 |         ...         [19, 50],\n8956 |         ...     ],\n8957 |         ...     columns=[\"price\", \"volume\"],\n8958 |         ...     index=pd.MultiIndex.from_product([days, [\"morning\", \"afternoon\"]]),\n8959 |         ... )\n8960 |         >>> df2\n8961 |                               price  volume\n8962 |         2000-01-01 morning       10      50\n8963 |                    afternoon     11      60\n8964 |         2000-01-02 morning        9      40\n8965 |                    afternoon     13     100\n8966 |         2000-01-03 morning       14      50\n8967 |                    afternoon     18     100\n8968 |         2000-01-04 morning       17      40\n8969 |                    afternoon     19      50\n8970 |         >>> df2.resample(\"D\", level=0).sum()\n8971 |                     price  volume\n8972 |         2000-01-01     21     110\n8973 |         2000-01-02     22     140\n8974 |         2000-01-03     32     150\n8975 |         2000-01-04     36      90\n8976 | \n8977 |         If you want to adjust the start of the bins based on a fixed timestamp:\n8978 | \n8979 |         >>> start, end = \"2000-10-01 23:30:00\", \"2000-10-02 00:30:00\"\n8980 |         >>> rng = pd.date_range(start, end, freq=\"7min\")\n8981 |         >>> ts = pd.Series(np.arange(len(rng)) * 3, index=rng)\n8982 |         >>> ts\n8983 |         2000-10-01 23:30:00     0\n8984 |         2000-10-01 23:37:00     3\n8985 |         2000-10-01 23:44:00     6\n8986 |         2000-10-01 23:51:00     9\n8987 |         2000-10-01 23:58:00    12\n8988 |         2000-10-02 00:05:00    15\n8989 |         2000-10-02 00:12:00    18\n8990 |         2000-10-02 00:19:00    21\n8991 |         2000-10-02 00:26:00    24\n8992 |         Freq: 7min, dtype: int64\n8993 | \n8994 |         >>> ts.resample(\"17min\").sum()\n8995 |         2000-10-01 23:14:00     0\n8996 |         2000-10-01 23:31:00     9\n8997 |         2000-10-01 23:48:00    21\n8998 |         2000-10-02 00:05:00    54\n8999 |         2000-10-02 00:22:00    24\n9000 |         Freq: 17min, dtype: int64\n9001 | \n9002 |         >>> ts.resample(\"17min\", origin=\"epoch\").sum()\n9003 |         2000-10-01 23:18:00     0\n9004 |         2000-10-01 23:35:00    18\n9005 |         2000-10-01 23:52:00    27\n9006 |         2000-10-02 00:09:00    39\n9007 |         2000-10-02 00:26:00    24\n9008 |         Freq: 17min, dtype: int64\n9009 | \n9010 |         >>> ts.resample(\"17min\", origin=\"2000-01-01\").sum()\n9011 |         2000-10-01 23:24:00     3\n9012 |         2000-10-01 23:41:00    15\n9013 |         2000-10-01 23:58:00    45\n9014 |     