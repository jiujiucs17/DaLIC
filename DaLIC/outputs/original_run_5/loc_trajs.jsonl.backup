# Search Result:\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch`.\nSource: Match found for entity name `_download_data_to_bunch`.\n```\n509 | def _download_data_to_bunch(\n510 |     url: str,\n511 |     sparse: bool,\n512 |     data_home: Optional[str],\n513 |     *,\n514 |     as_frame: bool,\n515 |     features_list: List,\n516 |     data_columns: List[int],\n517 |     target_columns: List,\n518 |     shape: Optional[Tuple[int, int]]\n519 | ):\n520 |     \"\"\"Download OpenML ARFF and convert to Bunch of data\n521 |     \"\"\"\n522 |     # NB: this function is long in order to handle retry for any failure\n523 |     #     during the streaming parse of the ARFF.\n524 | \n525 |     # Prepare which columns and data types should be returned for the X and y\n526 |     features_dict = {feature['name']: feature for feature in features_list}\n527 | \n528 |     # XXX: col_slice_y should be all nominal or all numeric\n529 |     _verify_target_data_type(features_dict, target_columns)\n530 | \n531 |     col_slice_y = [int(features_dict[col_name]['index'])\n532 |                    for col_name in target_columns]\n533 | \n534 |     col_slice_x = [int(features_dict[col_name]['index'])\n535 |                    for col_name in data_columns]\n536 |     for col_idx in col_slice_y:\n537 |         feat = features_list[col_idx]\n538 |         nr_missing = int(feat['number_of_missing_values'])\n539 |         if nr_missing > 0:\n540 |             raise ValueError('Target column {} has {} missing values. '\n541 |                              'Missing values are not supported for target '\n542 |                              'columns. '.format(feat['name'], nr_missing))\n543 | \n544 |     # Access an ARFF file on the OpenML server. Documentation:\n545 |     # https://www.openml.org/api_data_docs#!/data/get_download_id\n546 | \n547 |     if sparse is True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n```\n"}, {"content": "Let me also search for MD5 checksum handling:\n\n<function=search_code_snippets>\n<parameter=search_terms>['md5_checksum', 'checksum']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/validation.py:_check_fit_params\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/datasets/_openml.py:fetch_openml\nsklearn/datasets/_samples_generator.py:make_classification\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/datasets/_samples_generator.py:make_classification\nsklearn/datasets/_base.py:_fetch_remote\nsklearn/utils/estimator_checks.py:check_estimators_overwrite_params\nsklearn/datasets/_base.py:_fetch_remote\nsklearn/utils/estimator_checks.py:check_estimators_overwrite_params\n##Searching for term \"md5_checksum\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/_rcv1.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"RCV1 dataset.\n  2 | \n  3 | The dataset page is available at\n  4 | \n  5 |     http://jmlr.csail.mit.edu/papers/volume5/lewis04a/\n  6 | \"\"\"\n  7 | \n  8 | # Author: Tom Dupre la Tour\n  9 | # License: BSD 3 clause\n 10 | \n 11 | import logging\n 12 | \n 13 | from os import remove, makedirs\n 14 | from os.path import dirname, exists, join\n 15 | from gzip import GzipFile\n 16 | \n 17 | import numpy as np\n 18 | import scipy.sparse as sp\n 19 | import joblib\n 20 | \n 21 | from . import get_data_home\n 22 | from ._base import _pkl_filepath\n 23 | from ._base import _fetch_remote\n 24 | from ._base import RemoteFileMetadata\n 25 | from ._svmlight_format_io import load_svmlight_files\n 26 | from ..utils import shuffle as shuffle_\n 27 | from ..utils import Bunch\n 28 | from ..utils.validation import _deprecate_positional_args\n 29 | \n 30 | \n 31 | # The original vectorized data can be found at:\n 32 | #    http://www.ai.mit.edu/projects/jmlr/papers/volume5/lewis04a/a13-vector-files/lyrl2004_vectors_test_pt0.dat.gz\n 33 | #    http://www.ai.mit.edu/projects/jmlr/papers/volume5/lewis04a/a13-vector-files/lyrl2004_vectors_test_pt1.dat.gz\n 34 | #    http://www.ai.mit.edu/projects/jmlr/papers/volume5/lewis04a/a13-vector-files/lyrl2004_vectors_test_pt2.dat.gz\n 35 | #    http://www.ai.mit.edu/projects/jmlr/papers/volume5/lewis04a/a13-vector-files/lyrl2004_vectors_test_pt3.dat.gz\n 36 | #    http://www.ai.mit.edu/projects/jmlr/papers/volume5/lewis04a/a13-vector-files/lyrl2004_vectors_train.dat.gz\n 37 | # while the original stemmed token files can be found\n 38