ordering, which will cause a memory copy\n2076 |             if the given data is not C-contiguous.\n2077 |             If a sparse matrix is passed, a copy will be made if it's not in\n2078 |             CSR format.\n2079 | \n2080 |         y : Ignored\n2081 |             Not used, present here for API consistency by convention.\n2082 | \n2083 |         sample_weight : array-like of shape (n_samples,), default=None\n2084 |             The weights for each observation in X. If None, all observations\n2085 |             are assigned equal weight.\n2086 | \n2087 |         Returns\n2088 |         -------\n2089 |         self : object\n2090 |             Return updated estimator.\n2091 |         \"\"\"\n2092 |         has_centers = hasattr(self, \"cluster_centers_\")\n2093 | \n2094 |         X = self._validate_data(\n2095 |             X,\n2096 |             accept_sparse=\"csr\",\n2097 |             dtype=[np.float64, np.float32],\n2098 |             order=\"C\",\n2099 |             accept_large_sparse=False,\n2100 |             reset=not has_centers,\n2101 |         )\n2102 | \n2103 |         self._random_state = getattr(\n2104 |             self, \"_random_state\", check_random_state(self.random_state)\n2105 |         )\n2106 |         sample_weight = _check_sample_weight(sample_weight, X, dtype=X.dtype)\n2107 |         self.n_steps_ = getattr(self, \"n_steps_\", 0)\n2108 | \n2109 |         # precompute squared norms of data points\n2110 |         x_squared_norms = row_norms(X, squared=True)\n2111 | \n2112 |         if not has_centers:\n2113 |             # this instance has not been fitted yet (fit or partial_fit)\n2114 |             self._check_params(X)\n2115 |             self._n_threads = _openmp_effective_n_threads()\n2116 | \n2117 |             # Validate init array\n2118 |             init = self.init\n2119 |             if _is_arraylike_not_scalar(init):\n2120 |                 init = check_array(init, dtype=X.dtype, copy=True, order=\"C\")\n2121 |          