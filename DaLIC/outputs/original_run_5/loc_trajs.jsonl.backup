       barlinecol = barlinecols[0]  # the \"LineCollection\" of error bars\n2842 |             errs = barlinecol.get_segments()\n2843 |         else:\n2844 |             errs = []\n2845 | \n2846 |         if labels is None:\n2847 |             labels = []\n2848 | \n2849 |         annotations = []\n2850 | \n2851 |         for bar, err, dat, lbl in itertools.zip_longest(\n2852 |                 bars, errs, datavalues, labels\n2853 |         ):\n2854 |             (x0, y0), (x1, y1) = bar.get_bbox().get_points()\n2855 |             xc, yc = (x0 + x1) / 2, (y0 + y1) / 2\n2856 | \n2857 |             if orientation == \"vertical\":\n2858 |                 extrema = max(y0, y1) if dat >= 0 else min(y0, y1)\n2859 |                 length = abs(y0 - y1)\n2860 |             else:  # horizontal\n2861 |                 extrema = max(x0, x1) if dat >= 0 else min(x0, x1)\n2862 |                 length = abs(x0 - x1)\n2863 | \n2864 |             if err is None or np.size(err) == 0:\n2865 |                 endpt = extrema\n2866 |             elif orientation == \"vertical\":\n2867 |                 endpt = err[:, 1].max() if dat >= 0 else err[:, 1].min()\n2868 |             else:  # horizontal\n2869 |                 endpt = err[:, 0].max() if dat >= 0 else err[:, 0].min()\n2870 | \n2871 |             if label_type == \"center\":\n2872 |                 value = sign(dat) * length\n2873 |             else:  # edge\n2874 |                 value = extrema\n2875 | \n2876 |             if label_type == \"center\":\n2877 |                 xy = (0.5, 0.5)\n2878 |                 kwargs[\"xycoords\"] = (\n2879 |                     lambda r, b=bar:\n2880 |                         mtransforms.Bbox.intersection(\n2881 |                             b.get_window_extent(r), b.get_clip_box()\n2882 |                         ) or mtransforms.Bbox.null()\n2883 |                 )\n2884 |             else:  # edge\n2885 |                 if orientation == \"vertical\":\n2886 |                     xy