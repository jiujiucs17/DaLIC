ations}\")\n312 |             print(f\"min_resources_: {self.min_resources_}\")\n313 |             print(f\"max_resources_: {self.max_resources_}\")\n314 |             print(f\"aggressive_elimination: {self.aggressive_elimination}\")\n315 |             print(f\"factor: {self.factor}\")\n316 | \n317 |         self.n_resources_ = []\n318 |         self.n_candidates_ = []\n319 | \n320 |         for itr in range(n_iterations):\n321 | \n322 |             power = itr  # default\n323 |             if self.aggressive_elimination:\n324 |                 # this will set n_resources to the initial value (i.e. the\n325 |                 # value of n_resources at the first iteration) for as many\n326 |                 # iterations as needed (while candidates are being\n327 |                 # eliminated), and then go on as usual.\n328 |                 power = max(0, itr - n_required_iterations + n_possible_iterations)\n329 | \n330 |             n_resources = int(self.factor**power * self.min_resources_)\n331 |             # guard, probably not needed\n332 |             n_resources = min(n_resources, self.max_resources_)\n333 |             self.n_resources_.append(n_resources)\n334 | \n335 |             n_candidates = len(candidate_params)\n336 |             self.n_candidates_.append(n_candidates)\n337 | \n338 |             if self.verbose:\n339 |                 print(\"-\" * 10)\n340 |                 print(f\"iter: {itr}\")\n341 |                 print(f\"n_candidates: {n_candidates}\")\n342 |                 print(f\"n_resources: {n_resources}\")\n343 | \n344 |             if self.resource == \"n_samples\":\n345 |                 # subsampling will be done in cv.split()\n346 |                 cv = _SubsampleMetaSplitter(\n347 |                     base_cv=self._checked_cv_orig,\n348 |                     fraction=n_resources / self._n_samples_orig,\n349 |                     subsample_test=True,\n350 |                     random_state=self.random_state,\n351 |               