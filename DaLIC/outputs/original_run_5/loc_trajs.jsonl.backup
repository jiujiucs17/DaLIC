  if True. Merge MultiIndex column headers only if 'columns'.\n530 |         .. versionchanged:: 3.0.0\n531 |             Added the 'columns' option.\n532 |     inf_rep : str, default `'inf'`\n533 |         representation for np.inf values (which aren't representable in Excel)\n534 |         A `'-'` sign will be added in front of -inf.\n535 |     style_converter : callable, optional\n536 |         This translates Styler styles (CSS) into ExcelWriter styles.\n537 |         Defaults to ``CSSToExcelConverter()``.\n538 |         It should have signature css_declarations string -> excel style.\n539 |         This is only called for body cells.\n540 |     \"\"\"\n541 | \n542 |     max_rows = 2**20\n543 |     max_cols = 2**14\n544 | \n545 |     def __init__(\n546 |         self,\n547 |         df,\n548 |         na_rep: str = \"\",\n549 |         float_format: str | None = None,\n550 |         cols: Sequence[Hashable] | None = None,\n551 |         header: Sequence[Hashable] | bool = True,\n552 |         index: bool = True,\n553 |         index_label: IndexLabel | None = None,\n554 |         merge_cells: ExcelWriterMergeCells = False,\n555 |         inf_rep: str = \"inf\",\n556 |         style_converter: Callable | None = None,\n557 |     ) -> None:\n558 |         self.rowcounter = 0\n559 |         self.na_rep = na_rep\n560 |         if not isinstance(df, DataFrame):\n561 |             self.styler = df\n562 |             self.styler._compute()  # calculate applied styles\n563 |             df = df.data\n564 |             if style_converter is None:\n565 |                 style_converter = CSSToExcelConverter()\n566 |             self.style_converter: Callable | None = style_converter\n567 |         else:\n568 |             self.styler = None\n569 |             self.style_converter = None\n570 |         self.df = df\n571 |         if cols is not None:\n572 |             # all missing, raise\n573 |             if not len(Index(cols).intersection(df.columns)):\n574 |                 raise KeyError(\"passes columns are not ALL present dataframe\")\n575 | \n576 |             if len(Index(cols).intersection(df.columns)) != len(set(cols)):\n577 |                 # Deprecated in GH#17295, enforced in 1.0.0\n578 |                 raise KeyError(\"Not all names specified in 'columns' are found\")\n579 | \n580 |             self.df = df.reindex(columns=cols)\n581 | \n582 |         self.columns = self.df.columns\n583 |         self.float_format = float_format\n584 |         self.index = index\n585 |         self.index_label = index_label\n586 |         self.header = header\n587 | \n588 |         if not isinstance(merge_cells, bool) and merge_cells != \"columns\":\n589 |             raise ValueError(f\"Unexpected value for {merge_cells=}.\")\n590 |         self.merge_cells = merge_cells\n591 |         self.inf_rep = inf_rep\n592 | \n593 |     def _format_value(self, val):\n594 |         if is_scalar(val) and missing.isna(val):\n595 |             val = self.na_rep\n596 |         elif is_float(val):\n597 |             if missing.isposinf_scalar(val):\n598 |                 val = self.inf_rep\n599 |             elif missing.isneginf_scalar(val):\n600 |                 val = f\"-{self.inf_rep}\"\n601 |             elif self.float_format is not None:\n602 |                 val = float(self.float_format % val)\n603 |         if getattr(val, \"tzinfo\", None) is not None:\n604 |             raise ValueError(\n605 |                 \"Excel does not support datetimes with \"\n606 |                 \"timezones. Please ensure that datetimes \"\n607 |                 \"are timezone unaware before writing to Excel.\"\n608 |             )\n609 |         return val\n610 | \n611 |     def _format_header_mi(self) -> Iterable[ExcelCell]:\n612 |         if self.columns.nlevels > 1:\n613 |             if not self.index:\n614 |                 raise NotImplementedError(\n615 |                     \"Writing to Excel with MultiIndex columns and no \"\n616 |                     \"index ('index'=False) is not yet implemented.\"\n617 |                 )\n618 | \n619 |         if not (self._has_aliases or self.header):\n620 |             return\n621 | \n622 |         columns = self.columns\n623 |         level_strs = columns._format_multi(\n624 |             sparsify=self.merge_cells in {True, \"columns\"}, include_names=False\n625 |         )\n626 |         level_lengths = get_level_lengths(level_strs)\n627 |         coloffset = 0\n628 |         lnum = 0\n629 | \n630 |         if self.index and isinstance(self.df.index, MultiIndex):\n631 |             coloffset = self.df.index.nlevels - 1\n632 | \n633 |         if self.merge_cells in {True, \"columns\"}:\n634 |             # Format multi-index as a merged cells.\n635 |             for lnum, name in enumerate(columns.names):\n636 |                 yield ExcelCell(\n637 |                     row=lnum,\n638 |                     col=coloffset,\n639 |                     val=name,\n640 |                     style=None,\n641 |                 )\n642 | \n643 |             for lnum, (spans, levels, level_codes) in enumerate(\n644 |                 zip(level_lengths, columns.levels, columns.codes)\n645 |             ):\n646 |                 values = levels.take(level_codes)\n647 |                 for i, span_val in spans.items():\n648 |                     mergestart, mergeend = None, None\n649 |                     if span_val > 1:\n650 |                         mergestart, mergeend = lnum, coloffset + i + span_val\n651 |                     yield CssExcelCell(\n652 |                         row=lnum,\n653 |                         col=coloffset + i + 1,\n654 |                         val=values[i],\n655 |                         style=None,\n656 |                         css_styles=getattr(self.styler, \"ctx_columns\", None),\n657 |                         css_row=lnum,\n658 |                         css_col=i,\n659 |                         css_converter=self.style_converter,\n660 |     