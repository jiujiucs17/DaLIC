re_tags", "sklearn/externals/_arff.py:loads", "sklearn/ensemble/_forest.py:ForestRegressor._more_tags", "sklearn/ensemble/_hist_gradient_boosting/gradient_boosting.py:BaseHistGradientBoosting._encode_y", "sklearn/gaussian_process/kernels.py:Exponentiation.__eq__", "sklearn/ensemble/_weight_boosting.py:AdaBoostRegressor._validate_estimator", "sklearn/ensemble/_hist_gradient_boosting/gradient_boosting.py:BaseHistGradientBoosting.n_iter_", "sklearn/linear_model/_coordinate_descent.py:ElasticNet.sparse_coef_", "sklearn/decomposition/_nmf.py:non_negative_factorization", "sklearn/random_projection.py:BaseRandomProjection._n_features_out", "sklearn/isotonic.py:IsotonicRegression.get_feature_names_out", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults.__iter__", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults.__reversed__", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults._iterkeys", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults._itervalues", "sklearn/manifold/_mds.py:MDS._more_tags", "sklearn/cluster/_dbscan.py:DBSCAN._more_tags", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults.keys", "sklearn/gaussian_process/kernels.py:StationaryKernelMixin.is_stationary", "sklearn/utils/sparsefuncs.py:_sparse_nan_min_max", "sklearn/ensemble/_bagging.py:BaseBagging.n_features_", "sklearn/feature_selection/_univariate_selection.py:_BaseFilter._check_params", "sklearn/ensemble/_gb.py:BaseGradientBoosting._is_initialized", "sklearn/feature_selection/_univariate_selection.py:_BaseFilter._more_tags", "sklearn/ensemble/_gb.py:BaseGradientBoosting._check_initialized", "sklearn/cluster/_birch.py:Birch.fit_", "sklearn/preprocessing/_polynomial.py:PolynomialFeatures.n_input_features_", "sklearn/cluster/_mean_shift.py:MeanShift.predict", "sklearn/multiclass.py:OneVsRestClassifier.multilabel_", "sklearn/multioutput.py:_available_if_base_estimator_has", "sklearn/multiclass.py:OneVsRestClassifier.n_classes_", "sklearn/multiclass.py:OneVs