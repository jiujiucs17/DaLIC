        When true, this shades the dark sides of the bars (relative\n3093 |             to the plot's source of light).\n3094 | \n3095 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3096 |             The lightsource to use when *shade* is True.\n3097 | \n3098 |         axlim_clip : bool, default: False\n3099 |             Whether to hide the bars with points outside the axes view limits.\n3100 | \n3101 |             .. versionadded:: 3.10\n3102 | \n3103 |         data : indexable object, optional\n3104 |             DATA_PARAMETER_PLACEHOLDER\n3105 | \n3106 |         **kwargs\n3107 |             Any additional keyword arguments are passed onto\n3108 |             `~.art3d.Poly3DCollection`.\n3109 | \n3110 |         Returns\n3111 |         -------\n3112 |         collection : `~.art3d.Poly3DCollection`\n3113 |             A collection of three-dimensional polygons representing the bars.\n3114 |         \"\"\"\n3115 | \n3116 |         had_data = self.has_data()\n3117 | \n3118 |         x, y, z, dx, dy, dz = np.broadcast_arrays(\n3119 |             np.atleast_1d(x), y, z, dx, dy, dz)\n3120 |         minx = np.min(x)\n3121 |         maxx = np.max(x + dx)\n3122 |         miny = np.min(y)\n3123 |         maxy = np.max(y + dy)\n3124 |         minz = np.min(z)\n3125 |         maxz = np.max(z + dz)\n3126 | \n3127 |         # shape (6, 4, 3)\n3128 |         # All faces are oriented facing outwards - when viewed from the\n3129 |         # outside, their vertices are in a counterclockwise ordering.\n3130 |         cuboid = np.array([\n3131 |             # -z\n3132 |             (\n3133 |                 (0, 0, 0),\n3134 |                 (0, 1, 0),\n3135 |                 (1, 1, 0),\n3136 |                 (1, 0, 0),\n3137 |             ),\n3138 |             # +z\n3139 |             (\n3140 |                 (0, 0, 1),\n3141 |                 (1, 0, 1),\n3142 |                 (1, 1, 1),\n3143 |                 (0, 1, 1),\n3144 |             ),\n3145 |             # -y\n3146 |             (\n3147 |                 (0, 0, 0),\n3148 |                 (1, 0, 0),\n3149 |                 (1, 0, 1),\n3150 |                 (0, 0, 1),\n3151 |             ),\n3152 |             # +y\n3153 |             (\n3154 |                 (0, 1, 0),\n3155 |                 (0, 1, 1),\n3156 |                 (1, 1, 1),\n3157 |                 (1, 1, 0),\n3158 |             ),\n3159 |             # -x\n3160 |             (\n3161 |                 (0, 0, 0),\n3162 |                 (0, 0, 1),\n3163 |                 (0, 1, 1),\n3164 |                 (0, 1, 0),\n3165 |             ),\n3166 |             # +x\n3167 |             (\n3168 |                 (1, 0, 0),\n3169 |                 (1, 1, 0),\n3170 |                 (1, 1, 1),\n3171 |                 (1, 0, 1),\n3172 |             ),\n3173 |         ])\n3174 | \n3175 |         # indexed by [bar, face, vertex, coord]\n3176 |         polys = np.empty(x.shape + cuboid.shape)\n3177 | \n3178 |         # handle each coordinate separately\n3179 |         for i, p, dp in [(0, x, dx), (1, y, dy), (2, z, dz)]:\n3180 |             p = p[..., np.newaxis, np.newaxis]\n3181 |             dp = dp[..., np.newaxis, np.newaxis]\n3182 |             polys[..., i] = p + dp * cuboid[..., i]\n3183 | \n3184 |         # collapse the first two axes\n3185 |         polys = polys.reshape((-1,) + polys.shape[2:])\n3186 | \n3187 |         facecolors = []\n3188 |         if color is None:\n3189 |             color = [self._get_patches_for_fill.get_next_color()]\n3190 | \n3191 |         color = list(mcolors.to_rgba_array(color))\n3192 | \n3193 |         if len(color) == len(x):\n3194 |             # bar colors specified, need to expand to number of faces\n3195 |             for c in color:\n3196 |                 facecolors.extend([c] * 6)\n3197 |         else:\n3198 |             # a single color specified, or face colors specified explicitly\n3199 |             facecolors = color\n3200 |             if len(facecolors) < len(x):\n3201 |                 facecolors *= (6 * len(x))\n3202 | \n3203 |         col = art3d.Poly3DCollection(polys,\n3204 |                                      zsort=zsort,\n3205 |                                      facecolors=facecolors,\n3206 |                                      shade=shade,\n3207 |                                      lightsource=lightsource,\n3208 |                                      axlim_clip=axlim_clip,\n3209 |                                      *args, **kwargs)\n3210 |         self.add_collection(col)\n3211 | \n3212 |         self.auto_scale_xyz((minx, maxx), (miny, maxy), (minz, maxz), had_data)\n3213 | \n3214 |         return col\n```\n\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2989 | def bar(self, left, height, zs=0, zdir='z', *args,\n2990 |             axlim_clip=False, **kwargs):\n2991 |         \"\"\"\n2992 |         Add 2D bar(s).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         left : 1D array-like\n2997 |             The x coordinates of the left sides of the bars.\n2998 |         height : 1D array-like\n2999 |             The height of the bars.\n3000 |         zs : float or 1D array-like, default: 0\n3001 |             Z coordinate of bars; if a single value is specified, it will be\n3002 |             used for all bars.\n3003 |         zdir : {'x', 'y', 'z'}, default: 'z'\n3004 |             When plotting 2D data, the direction to use as z ('x', 'y' or 'z').\n3005 |         axlim_clip : bool, default: False\n3006 |             Whether to hide bars with points outside the axes view limits.\n3007 | \n3008 |             .. versionadded:: 3.10\n3009 |         data : indexable object, optional\n3010 |             DATA_PARAMETER_PLACEHOLDER\n3011 |         **kwargs\n3012 |             Other keyword arguments are forwarded to\n3013 |             `matplotlib.axes.Axes.bar`.\n3014 | \n3015 |         Returns\n3016 |         -------\n3017 |         mpl_toolkits.mplot3d.art3d.Patch3DCollection\n3018 |         \"\"\"\n3019 |         had_data = self.has_data()\n3020 | \n3021 |         patches = super().bar(left, height, *args, **kwargs)\n3022 | \n3023 |         zs = np.broadcast_to(zs, len(left), subok=True)\n3024 | \n3025 |         verts = []\n3026 |         verts_zs = []\n3027 |         for p, z in zip(patches, zs):\n3028 |             vs = art3d._get_patch_verts(p)\n3029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |             # NOTE: Bugs could still occur if len(verts) > 0,\n3038 |             #       but the \"2nd dimension\" is empty.\n3039 |             xs, ys = zip(*verts)\n3040 |         else:\n3041 |             xs, ys = [], []\n3042 | \n3043 |         xs, ys, verts_zs = art3d.juggle_axes(xs, ys, verts_zs, zdir)\n3044 |         self.auto_scale_xyz(xs, ys, verts_zs, had_data)\n3045 | \n3046 |         return patches\n```\n\n\n\n##Searching for term \"def bar(\", \"def bar( bar plot\"...\n### Search Result:\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be horizontal.\n65 | \n66 |     \"\"\"\n67 | \n68 |     def __init__(self, patches, errorbar=None, *, datavalues=None,\n69 |                  orientation=None, **kwargs):\n70 |         self.patches = patches\n71 |         self.errorbar = errorbar\n72 |         self.datavalues = datavalues\n73 |         self.orientation = orientation\n74 |         super().__init__(patches, **kwargs)\n```\n\n\n\n##Searching for term \"bar plot\"...\n### Search Result:\nFound code snippet in file `galleries/examples/pie_and_polar_charts/polar_bar.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =======================\n 3 | Bar chart on polar axis\n 4 | =======================\n 5 | \n 6 | Demo of bar plot on a polar axis.\n 7 | \"\"\"\n 8 | import matplotlib.pyplot as plt\n 9 | import numpy as np\n10 | \n11 | # Fixing random state for reproducibility\n12 | np.random.seed(19680801)\n13 | \n14 | # Compute pie slices\n15 | N = 20\n16 | theta = np.linspace(0.0, 2 * np.pi, N, endpoint=False)\n17 | radii = 10 * np.random.rand(N)\n18 | width = np.pi / 4 * np.random.rand(N)\n19 | colors = plt.cm.viridis(radii / 10.)\n20 | \n21 | ax = plt.subplot(projection='polar')\n22 | ax.bar(theta, radii, width=width, bottom=0.0, color=colors, alpha=0.5)\n23 | \n24 | plt.show()\n25 | \n26 | # %%\n27 | #\n28 | # .. admonition:: References\n29 | #\n30 | #    The use of the following functions, methods, classes and modules is shown\n31 | #    in this example:\n32 | #\n33 | #    - `matplotlib.axes.Axes.bar` / `matplotlib.pyplot.bar`\n34 | #    - `matplotlib.projections.polar`\n35 | #\n36 | # .. tags::\n37 | #\n38 | #    plot-type: pie\n39 | #    plot-type: bar\n40 | #    level: beginner\n41 | #    purpose: showcase\n42 | \n```\n\nFound code snippet in file `galleries/examples/mplot3d/bars3d.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ========================================\n 3 | Create 2D bar graphs in different planes\n 4 | ========================================\n 5 | \n 6 | Demonstrates making a 3D plot which has 2D bar graphs projected onto\n 7 | planes y=0, y=1, etc.\n 8 | \"\"\"\n 9 | \n10 | import matplotlib.pyplot as plt\n11 | import numpy as np\n12 | \n13 | # Fixing random state for reproducibility\n14 | np.random.seed(19680801)\n15 | \n16 | \n17 | fig = plt.figure()\n18 | ax = fig.add_subplot(projection='3d')\n19 | \n20 | colors = ['r', 'g', 'b', 'y']\n21 | yticks = [3, 2, 1, 0]\n22 | for c, k in zip(colors, yticks):\n23 |     # Generate the random data for the y=k 'layer'.\n24 |     xs = np.arange(20)\n25 |     ys = np.random.rand(20)\n26 | \n27 |     # You can provide either a single color or an array with the same length as\n28 |     # xs and ys. To demonstrate this, we color the first bar of each set cyan.\n29 |     cs = [c] * len(xs)\n30 |     cs[0] = 'c'\n31 | \n32 |     # Plot the bar graph given by xs and ys on the plane y=k with 80% opacity.\n33 |     ax.bar(xs, ys, zs=k, zdir='y', color=cs, alpha=0.8)\n34 | \n35 | ax.set_xlabel('X')\n36 | ax.set_ylabel('Y')\n37 | ax.set_zlabel('Z')\n38 | \n39 | # On the y-axis let's only label the discrete values that we have data for.\n40 | ax.set_yticks(yticks)\n41 | \n42 | plt.show()\n43 | \n44 | # %%\n45 | # .. tags::\n46 | #    plot-type: 3D, plot-type: bar,\n47 | #    styling: color,\n48 | #    level: beginner\n49 | \n```\n\nFound code snippet in file `galleries/examples/pie_and_polar_charts/polar_error_caps.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =================================\n 3 | Error bar rendering on polar axis\n 4 | =================================\n 5 | \n 6 | Demo of error bar plot in polar coordinates.\n 7 | Theta error bars are curved lines ended with caps oriented towards the\n 8 | center.\n 9 | Radius error bars are straight lines oriented towards center with\n10 | perpendicular caps.\n11 | \"\"\"\n12 | import matplotlib.pyplot as plt\n13 | import numpy as np\n14 | \n15 | theta = np.arange(0, 2 * np.pi, np.pi / 4)\n16 | r = theta / np.pi / 2 + 0.5\n17 | \n18 | fig = plt.figure(figsize=(10, 10))\n19 | ax = fig.add_subplot(projection='polar')\n20 | ax.errorbar(theta, r, xerr=0.25, yerr=0.1, capsize=7, fmt=\"o\", c=\"seagreen\")\n21 | ax.set_title(\"Pretty polar error bars\")\n22 | plt.show()\n23 | \n24 | # %%\n25 | # Please acknowledge that large theta error bars will be overlapping.\n26 | # This may reduce readability of the output plot. See example figure below:\n27 | \n28 | fig = plt.figure(figsize=(10, 10))\n29 | ax = fig.add_subplot(projection='polar')\n30 | ax.errorbar(theta, r, xerr=5.25, yerr=0.1, capsize=7, fmt=\"o\", c=\"darkred\")\n31 | ax.set_title(\"Overlapping theta error bars\")\n32 | plt.show()\n33 | \n34 | # %%\n35 | # On the other hand, large radius error bars will never overlap, they just\n36 | # lead to unwanted scale in the data, reducing the displayed range.\n37 | \n38 | fig = plt.figure(figsize=(10, 10))\n39 | ax = fig.add_subplot(projection='polar')\n40 | ax.errorbar(theta, r, xerr=0.25, yerr=10.1, capsize=7, fmt=\"o\", c=\"orangered\")\n41 | ax.set_title(\"Large radius error bars\")\n42 | plt.show()\n43 | \n44 | \n45 | # %%\n46 | #\n47 | # .. admonition:: References\n48 | #\n49 | #    The use of the following functions, methods, classes and modules is shown\n50 | #    in this example:\n51 | #\n52 | #    - `matplotlib.axes.Axes.errorbar` / `matplotlib.pyplot.errorbar`\n53 | #    - `matplotlib.projections.polar`\n54 | #\n55 | # .. tags::\n56 | #\n57 | #    co