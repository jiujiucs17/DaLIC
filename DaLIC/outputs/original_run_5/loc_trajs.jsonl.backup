tr,\n150 |     overwrite: bool = False,\n151 |     accessor_mapping: Callable[[str], str] = lambda x: x,\n152 |     raise_on_missing: bool = True,\n153 | ):\n154 |     \"\"\"\n155 |     Add delegated names to a class using a class decorator.  This provides\n156 |     an alternative usage to directly calling `_add_delegate_accessors`\n157 |     below a class definition.\n158 | \n159 |     Parameters\n160 |     ----------\n161 |     delegate : object\n162 |         The class to get methods/properties & doc-strings.\n163 |     accessors : Sequence[str]\n164 |         List of accessor to add.\n165 |     typ : {'property', 'method'}\n166 |     overwrite : bool, default False\n167 |        Overwrite the method/property in the target class if it exists.\n168 |     accessor_mapping: Callable, default lambda x: x\n169 |         Callable to map the delegate's function to the cls' function.\n170 |     raise_on_missing: bool, default True\n171 |         Raise if an accessor does not exist on delegate.\n172 |         False skips the missing accessor.\n173 | \n174 |     Returns\n175 |     -------\n176 |     callable\n177 |         A class decorator.\n178 | \n179 |     Examples\n180 |     --------\n181 |     @delegate_names(Categorical, [\"categories\", \"ordered\"], \"property\")\n182 |     class CategoricalAccessor(PandasDelegate):\n183 |         [...]\n184 |     \"\"\"\n185 | \n186 |     def add_delegate_accessors(cls):\n187 |         cls._add_delegate_accessors(\n188 |             delegate,\n189 |             accessors,\n190 |             typ,\n191 |             overwrite=overwrite,\n192 |             accessor_mapping=accessor_mapping,\n193 |             raise_on_missing=raise_on_missing,\n194 |         )\n195 |         return cls\n196 | \n197 |     return add_delegate_accessors\n```\n\nFound function `pandas/core/accessor.py:_register_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n237 | def _register_accessor(\n238 |     name: str, cls: type[NDF