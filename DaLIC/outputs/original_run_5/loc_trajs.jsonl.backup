/period.py:PeriodArray.__arrow_array__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n400 | def __arrow_array__(self, type=None):\n401 |         \"\"\"\n402 |         Convert myself into a pyarrow Array.\n403 |         \"\"\"\n404 |         import pyarrow\n405 | \n406 |         from pandas.core.arrays.arrow.extension_types import ArrowPeriodType\n407 | \n408 |         if type is not None:\n409 |             if pyarrow.types.is_integer(type):\n410 |                 return pyarrow.array(self._ndarray, mask=self.isna(), type=type)\n411 |             elif isinstance(type, ArrowPeriodType):\n412 |                 # ensure we have the same freq\n413 |                 if self.freqstr != type.freq:\n414 |                     raise TypeError(\n415 |                         \"Not supported to convert PeriodArray to array with different \"\n416 |                         f\"'freq' ({self.freqstr} vs {type.freq})\"\n417 |                     )\n418 |             else:\n419 |                 raise TypeError(\n420 |                     f\"Not supported to convert PeriodArray to '{type}' type\"\n421 |                 )\n422 | \n423 |         period_type = ArrowPeriodType(self.freqstr)\n424 |         storage_array = pyarrow.array(self._ndarray, mask=self.isna(), type=\"int64\")\n425 |         return pyarrow.ExtensionArray.from_storage(period_type, storage_array)\n```\n\nFound function `pandas/core/dtypes/dtypes.py:CategoricalDtype.categories`.\nSource: Retrieved code content using keyword search (bm25).\n```\n629 | def categories(self) -> Index:\n630 |         \"\"\"\n631 |         An ``Index`` containing the unique categories allowed.\n632 | \n633 |         See Also\n634 |         --------\n635 |         ordered : Whether the categories have an ordered relationship.\n636 | \n637 |         Examples\n638 |         --------\n639 |         >>> cat_type = pd.CategoricalDtype(categories=[\"a\", \"b\"], ordered=True)\n640 |         >>> cat_type.categories\n641 |     