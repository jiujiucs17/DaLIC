n690 |                     array, flags=['external_loop', 'buffered', 'zerosize_ok'],\n691 |                     buffersize=buffersize, order='C'):\n692 |                 fp.write(chunk.tobytes('C'))\n```\n\nFound function `numpy/lib/format.py:read_array`.\nSource: Retrieved entity using keyword search (bm25).\n```\n695 | def read_array(fp, allow_pickle=False, pickle_kwargs=None):\n696 |     \"\"\"\n697 |     Read an array from an NPY file.\n698 | \n699 |     Parameters\n700 |     ----------\n701 |     fp : file_like object\n702 |         If this is not a real file object, then this may take extra memory\n703 |         and time.\n704 |     allow_pickle : bool, optional\n705 |         Whether to allow writing pickled data. Default: False\n706 | \n707 |         .. versionchanged:: 1.16.3\n708 |             Made default False in response to CVE-2019-6446.\n709 | \n710 |     pickle_kwargs : dict\n711 |         Additional keyword arguments to pass to pickle.load. These are only\n712 |         useful when loading object arrays saved on Python 2 when using\n713 |         Python 3.\n714 | \n715 |     Returns\n716 |     -------\n717 |     array : ndarray\n718 |         The array from the data on disk.\n719 | \n720 |     Raises\n721 |     ------\n722 |     ValueError\n723 |         If the data is invalid, or allow_pickle=False and the file contains\n724 |         an object array.\n725 | \n726 |     \"\"\"\n727 |     version = read_magic(fp)\n728 |     _check_version(version)\n729 |     shape, fortran_order, dtype = _read_array_header(fp, version)\n730 |     if len(shape) == 0:\n731 |         count = 1\n732 |     else:\n733 |         count = numpy.multiply.reduce(shape, dtype=numpy.int64)\n734 | \n735 |     # Now read the actual data.\n736 |     if dtype.hasobject:\n737 |         # The array contained Python objects. We need to unpickle the data.\n738 |         if not allow_pickle:\n739 |             raise ValueError(\"Object arrays cannot be loaded when \"\n740 |                              \"allow_pickle=False\")\n741 |         if pickle_kwargs is None:\n742 |             pickle_kwargs = {}\n743 |         try:\n744 |             array = pickle.load(fp, **pickle_kwargs)\n745 |         except UnicodeError as err:\n746 |             # Friendlier error message\n747 |             raise UnicodeError(\"Unpickling a python object failed: %r\\n\"\n748 |                                \"You may need to pass the encoding= option \"\n749 |                                \"to numpy.load\" % (err,)) from err\n750 |     else:\n751 |         if isfileobj(fp):\n752 |             # We can use the fast fromfile() function.\n753 |             array = numpy.fromfile(fp, dtype=dtype, count=count)\n754 |         else:\n755 |             # This is not a real file. We have to read it the\n756 |             # memory-intensive way.\n757 |             # crc32 module fails on reads greater than 2 ** 32 bytes,\n758 |             # breaking large reads from gzip streams. Chunk reads to\n759 |             # BUFFER_SIZE bytes to avoid issue and reduce memory overhead\n760 |             # of the read. In non-chunked case count < max_read_count, so\n761 |             # only one read is performed.\n762 | \n763 |             # Use np.ndarray instead of np.empty since the latter does\n764 |             # not correctly instantiate zero-width string dtypes; see\n765 |             # https://github.com/numpy/numpy/pull/6430\n766 |             array = numpy.ndarray(count, dtype=dtype)\n767 | \n768 |             if dtype.itemsize > 0:\n769 |                 # If dtype.itemsize == 0 then there's nothing more to read\n770 |                 max_read_count = BUFFER_SIZE // min(BUFFER_SIZE, dtype.itemsize)\n771 | \n772 |                 for i in range(0, count, max_read_count):\n773 |                     read_count = min(max_read_count, count - i)\n774 |                     read_size = int(read_count * dtype.itemsize)\n775 |                     data = _read_bytes(fp, read_size, \"array data\")\n776 |                     array[i:i+read_count] = numpy.frombuffer(data, dtype=dtype,\n777 |                                                              count=read_count)\n778 | \n779 |         if fortran_order:\n780 |             array.shape = shape[::-1]\n781 |             array = array.transpose()\n782 |         else:\n783 |             array.shape = shape\n784 | \n785 |     return array\n```\n\nFound function `numpy/core/arrayprint.py:_leading_trailing`.\nSource: Retrieved entity using keyword search (bm25).\n```\n324 | def _leading_trailing(a, edgeitems, index=()):\n325 |     \"\"\"\n326 |     Keep only the N-D corners (leading and trailing edges) of an array.\n327 | \n328 |     Should be passed a base-class ndarray, since it makes no guarantees about\n329 |     preserving subclasses.\n330 |     \"\"\"\n331 |     axis = len(index)\n332 |     if axis == a.ndim:\n333 |         return a[index]\n334 | \n335 |     if a.shape[axis] > 2*edgeitems:\n336 |         return concatenate((\n337 |             _leading_trailing(a, edgeitems, index + np.index_exp[ :edgeitems]),\n338 |             _leading_trailing(a, edgeitems, index + np.index_exp[-edgeitems:])\n339 |         ), axis=axis)\n340 |     else:\n341 |         return _leading_trailing(a, edgeitems, index + np.index_exp[:])\n```\n\nFound function `numpy/distutils/command/autodist.py:check_restrict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n31 | def check_restrict(cmd):\n32 |     \"\"\"Return the restrict identifier (may be empty).\"\"\"\n33 |     cmd._check_compiler()\n34 |     body = textwrap.dedent(\"\"\"\n35 |         static int static_func (char * %(restrict)s a)\n36 |         {\n37 |             return 0;\n38 |         }\n39 |         \"\"\")\n40 | \n41 |     for kw in ['restrict', '__restrict__', '__restrict']:\n42 |         st = cmd.try_compile(body % {'restrict': kw}, None, None)\n43 |         if st:\n44 |             return kw\n45 | \n46 |     return ''\n```\n\nFound function `numpy/distutils/command/autodist.py:check_compiler_gcc`.\nSource: Retrieved code content using keyword search (bm25).\n```\n49 | def check_compiler_gcc(cmd):\n50 |     \"\"\"Check if the compiler is GCC.\"\"\"\n51 | \n52 |     cmd._check_compiler()\n53 |     body = textwrap.dedent(\"\"\"\n54 |         int\n55 |         main()\n56 |         {\n57 |         #if (! defined __GNUC__)\n58 |         #error gcc required\n59 |         #endif\n60 |             return 0;\n61 |         }\n62 |         \"\"\")\n63 |     return cmd.try_compile(body, None, None)\n```\n\nFound function `numpy/distutils/command/autodist.py:check_gcc_version_at_least`.\nSource: Retrieved code content using keyword search (bm25).\n```\n66 | def check_gcc_version_at_least(cmd, major, minor=0, patchlevel=0):\n67 |     \"\"\"\n68 |     Check that the gcc version is at least the specified version.\"\"\"\n69 | \n70 |     cmd._check_compiler()\n71 |     version = '.'.join([str(major), str(minor), str(patchlevel)])\n72 |     body = textwrap.dedent(\"\"\"\n73 |         int\n74 |         main()\n75 |         {\n76 |         #if (! defined __GNUC__) || (__GNUC__ < %(major)d) || \\\\\n77 |                 (__GNUC_MINOR__ < %(minor)d) || \\\\\n78 |                 (__GNUC_PATCHLEVEL__ < %(patchlevel)d)\n79 |         #error gcc >= %(version)s required\n80 |         #endif\n81 |             return 0;\n82 |         }\n83 |         \"\"\")\n84 |     kw = {'version': version, 'major': major, 'minor': minor,\n85 |           'patchlevel': patchlevel}\n86 | \n87 |     return cmd.try_compile(body % kw, None, None)\n```\n\nFound function `numpy/distutils/command/autodist.py:check_gcc_function_attribute`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 90 | def check_gcc_function_attribute(cmd, attribute, name):\n 91 |     \"\"\"Return True if the given function attribute is supported.\"\"\"\n 92 |     cmd._check_compiler()\n 93 |     body = textwrap.dedent(\"\"\"\n 94 |         #pragma GCC dia