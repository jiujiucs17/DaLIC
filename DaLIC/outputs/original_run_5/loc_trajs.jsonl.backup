e, new_values)\n110 | \n111 |             _getter.__name__ = name\n112 |             _setter.__name__ = name\n113 | \n114 |             return property(\n115 |                 fget=_getter,\n116 |                 fset=_setter,\n117 |                 doc=getattr(delegate, accessor_mapping(name)).__doc__,\n118 |             )\n119 | \n120 |         def _create_delegator_method(name: str):\n121 |             method = getattr(delegate, accessor_mapping(name))\n122 | \n123 |             @functools.wraps(method)\n124 |             def f(self, *args, **kwargs):\n125 |                 return self._delegate_method(name, *args, **kwargs)\n126 | \n127 |             return f\n128 | \n129 |         for name in accessors:\n130 |             if (\n131 |                 not raise_on_missing\n132 |                 and getattr(delegate, accessor_mapping(name), None) is None\n133 |             ):\n134 |                 continue\n135 | \n136 |             if typ == \"property\":\n137 |                 f = _create_delegator_property(name)\n138 |             else:\n139 |                 f = _create_delegator_method(name)\n140 | \n141 |             # don't overwrite existing methods/properties\n142 |             if overwrite or not hasattr(cls, name):\n143 |                 setattr(cls, name, f)\n```\n\nFound function `pandas/core/accessor.py:delegate_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n146 | def delegate_names(\n147 |     delegate,\n148 |     accessors: list[str],\n149 |     typ: str,\n150 |     overwrite: bool = False,\n151 |     accessor_mapping: Callable[[str], str] = lambda x: x,\n152 |     raise_on_missing: bool = True,\n153 | ):\n154 |     \"\"\"\n155 |     Add delegated names to a class using a class decorator.  This provides\n156 |     an alternative usage to directly calling `_add_delegate_accessors`\n157 |     below a class definition.\n158 | \n159 |     Parameters\n160 |     ----------\n161 |     delegate : object\n162 |         The class