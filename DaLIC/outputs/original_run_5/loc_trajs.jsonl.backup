\n5310 |         collection._internal_update(kwargs)\n5311 |         collection._scale_norm(norm, vmin, vmax)\n5312 | \n5313 |         # autoscale the norm with current accum values if it hasn't been set\n5314 |         if norm is not None:\n5315 |             if collection.norm.vmin is None and collection.norm.vmax is None:\n5316 |                 collection.norm.autoscale()\n5317 | \n5318 |         corners = ((xmin, ymin), (xmax, ymax))\n5319 |         self.update_datalim(corners)\n5320 |         self._request_autoscale_view(tight=True)\n5321 | \n5322 |         # add the collection last\n5323 |         self.add_collection(collection, autolim=False)\n5324 |         if not marginals:\n5325 |             return collection\n5326 | \n5327 |         # Process marginals\n5328 |         bars = []\n5329 |         for zname, z, zmin, zmax, zscale, nbins in [\n5330 |                 (\"x\", x, xmin, xmax, xscale, nx),\n5331 |                 (\"y\", y, ymin, ymax, yscale, 2 * ny),\n5332 |         ]:\n5333 | \n5334 |             if zscale == \"log\":\n5335 |                 bin_edges = np.geomspace(zmin, zmax, nbins + 1)\n5336 |             else:\n5337 |                 bin_edges = np.linspace(zmin, zmax, nbins + 1)\n5338 | \n5339 |             verts = np.empty((nbins, 4, 2))\n5340 |             verts[:, 0, 0] = verts[:, 1, 0] = bin_edges[:-1]\n5341 |             verts[:, 2, 0] = verts[:, 3, 0] = bin_edges[1:]\n5342 |             verts[:, 0, 1] = verts[:, 3, 1] = .00\n5343 |             verts[:, 1, 1] = verts[:, 2, 1] = .05\n5344 |             if zname == \"y\":\n5345 |                 verts = verts[:, :, ::-1]  # Swap x and y.\n5346 | \n5347 |             # Sort z-values into bins defined by bin_edges.\n5348 |             bin_idxs = np.searchsorted(bin_edges, z) - 1\n5349 |             values = np.empty(nbins)\n5350 |             for i in range(nbins):\n5351 |                 # Get C-values for each bin, and compute bin value with\n5352 |                 # reduce_C_function.