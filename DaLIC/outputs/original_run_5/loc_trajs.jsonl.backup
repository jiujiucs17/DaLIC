                   ['filename', 'url', 'checksum'])\n  28 | \n  29 | \n  30 | def get_data_home(data_home=None) -> str:\n  31 |     \"\"\"Return the path of the scikit-learn data dir.\n  32 | \n  33 |     This folder is used by some large dataset loaders to avoid downloading the\n  34 |     data several times.\n  35 | \n  36 |     By default the data dir is set to a folder named 'scikit_learn_data' in the\n  37 |     user home folder.\n  38 | \n  39 |     Alternatively, it can be set by the 'SCIKIT_LEARN_DATA' environment\n  40 |     variable or programmatically by giving an explicit folder path. The '~'\n  41 |     symbol is expanded to the user home folder.\n  42 | \n  43 |     If the folder does not already exist, it is automatically created.\n  44 | \n  45 |     Parameters\n  46 |     ----------\n  47 |     data_home : str | None\n  48 |         The path to scikit-learn data dir.\n  49 |     \"\"\"\n  50 |     if data_home is None:\n  51 |         data_home = environ.get('SCIKIT_LEARN_DATA',\n  52 |                                 join('~', 'scikit_learn_data'))\n  53 |     data_home = expanduser(data_home)\n  54 |     if not exists(data_home):\n  55 |         makedirs(data_home)\n  56 |     return data_home\n  57 | \n  58 | \n  59 | def clear_data_home(data_home=None):\n  60 |     \"\"\"Delete all the content of the data home cache.\n  61 | \n  62 |     Parameters\n  63 |     ----------\n  64 |     data_home : str | None\n  65 |         The path to scikit-learn data dir.\n  66 |     \"\"\"\n  67 |     data_home = get_data_home(data_home)\n  68 |     shutil.rmtree(data_home)\n  69 | \n  70 | \n  71 | def _convert_data_dataframe(caller_name, data, target,\n  72 |                             feature_names, target_names):\n  73 |     pd = check_pandas_support('{} with as_frame=True'.format(caller_name))\n  74 |     data_df = pd.DataFrame(data, columns=feature_names)\n  75 |     target_df = pd.DataFrame(target, columns=target_names)\n  76 |     combined_df = pd.concat([data_df, target_df], axis=1)\n  77 |     X = combined_df[feature_names]\n  78 |     y = combined_df[target_names]\n  79 |     if y.shape[1] == 1:\n  80 |         y = y.iloc[:, 0]\n  81 |     return combined_df, X, y\n  82 | \n  83 | \n  84 | @_deprecate_positional_args\n  85 | def load_files(container_path, *, description=None, categories=None,\n  86 |                load_content=True, shuffle=True, encoding=None,\n  87 |                decode_error='strict', random_state=0):\n  88 |     \"\"\"Load text files with categories as subfolder names.\n  89 | \n  90 |     Individual samples are assumed to be files stored a two levels folder\n  91 |     structure such as the following:\n  92 | \n  93 |         container_folder/\n  94 |             category_1_folder/\n  95 |                 file_1.txt\n  96 |                 file_2.txt\n  97 |                 ...\n  98 |                 file_42.txt\n  99 |             category_2_folder/\n 100 |                 file_43.txt\n 101 |                 file_44.txt\n 102 |                 ...\n 103 | \n 104 |     The folder names are used as supervised signal label names. The individual\n 105 |     file names are not important.\n 106 | \n 107 |     This function does not try to extract features into a numpy array or scipy\n 108 |     sparse matrix. In addition, if load_content is false it does not try to\n 109 |     load the files in memory.\n 110 | \n 111 |     To use text files in a scikit-learn classification or clustering algorithm,\n 112 |     you will need to use the :mod`~sklearn.feature_extraction.text` module to\n 113 |     build a feature extraction transformer that suits your problem.\n 114 | \n 115 |     If you set load_content=True, you should also specify the encoding of the\n 116 |     text using the 'encoding' parameter. For many modern text files, 'utf-8'\n 117 |     will be the correct encoding. If you leave encoding equal to None, then the\n 118 |     content will be made of bytes instead of Unicode, and you will not be able\n 119 |     to use most functions in :mod:`~sklearn.feature_extraction.text`.\n 120 | \n 121 |     Similar feature extractors should be built for other kind of unstructured\n 122 |     data input such as images, audio, video, ...\n 123 | \n 124 |     Read more in the :ref:`User Guide <datasets>`.\n 125 | \n 126 |     Parameters\n 127 |     ----------\n 128 |     container_path : str or unicode\n 129 |         Path to the main folder holding one subfolder per category\n 130 | \n 131 |     description : str or unicode, default=None\n 132 |         A paragraph describing the characteristic of the dataset: its source,\n 133 |         reference, etc.\n 134 | \n 135 |     categories : list of str, default=None\n 136 |         If None (default), load all the categories. If not None, list of\n 137 |         category names to load (other categories ignored).\n 138 | \n 139 |     load_content : bool, default=True\n 140 |         Whether to load or not the content of the different files. If true a\n 141 |         'data' attribute containing the text information is present in the data\n 142 |         structure returned. If not, a filenames attribute gives the path to the\n 143 |         files.\n 144 | \n 145 |     shuffle : bool, default=True\n 146 |         Whether or not to shuffle the data: might be important for models that\n 147 |         make the assumption that the samples are independent and identically\n 148 |         distributed (i.i.d.), such as stochastic gradient descent.\n 149 | \n 150 |     encoding : str, default=None\n 151 |         If None, do not try to decode the content of the files (e.g. for images\n 152 |         or other non-text content). If not None, encoding to use to decode text\n 153 |         files to Unicode if load_content is True.\n 154 | \n 155 |     decode_error : {'strict', 'ignore', 'replace'}, default='strict'\n 156 |         Instruction on what to do if a byte sequence is given to analyze that\n 157 |         contains characters not of the given `encoding`. Passed as keyword\n 158 |         argument 'errors' to bytes.decode.\n 159 | \n 160 |     random_state : int, RandomState instance or None, default=0\n 161 |         Determines random number generation for dataset shuffling. Pass an int\n 162 |         for reproducible output across multiple function calls.\n 163 |         See :term:`Glossary <random_state>`.\n 164 | \n 165 |     Returns\n 166 |     -------\n 167 |     data : :class:`~sklearn.utils.Bunch`\n 168 |         Dictionary-like object, with the following attributes.\n 169 | \n 170 |         data : list of str\n 171 |             Only present when `load_content=True`.\n 172 |             The raw text data to learn.\n 173 |         target : ndarray\n 174 |             The target labels (integer index).\n 175 |         target_names : list\n 176 |             The names of target classes.\n 177 |         DESCR : str\n 178 |             The full description of the dataset.\n 179 |         filenames: ndarray\n 180 |             The filenames holding the dataset.\n 181 |     \"\"\"\n 182 |     target = []\n 183 |     target_names = []\n 184 |     filenames = []\n 185 | \n 186 |     folders = [f for f in sorted(listdir(container_path))\n 187 |                if isdir(join(container_path, f))]\n 188 | \n 189 |     if categories is not None:\n 190 |         folders = [f for f in folders if f in categories]\n 191 | \n 192 |     for label, folder in enumerate(folders):\n 193 |         target_names.append(folder)\n 194 |         folder_path = join(container_path, folder)\n 195 |         documents = [join(folder_path, d)\n 196 |                      for d in sorted(listdir(folder_path))]\n 197 |         target.extend(len(documents) * [label])\n 198 |         filenames.extend(documents)\n 199 | \n 200 |     # convert to array for fancy indexing\n 201 |     filenames = np.array(filenames)\n 202 |     target = np.array(target)\n 203 | \n 204 |     if shuffle:\n 205 |         random_state = check_random_state(random_state)\n 206 |         indices = np.arange(filenames.shape[0])\n 207 |         random_state.shuffle(indices)\n 208 |         filenames = filenames[indices]\n 209 |         target = target[indices]\n 210 | \n 211 |     if load_content:\n 212 |         data = []\n 213 |         for filename in filenames:\n 214 |             with open(filename, 'rb') as f:\n 215 |                 data.append(f.read())\n 216 |         if encoding is not None:\n 217 |             data = [d.decode(encoding, decode_error) for d in data]\n 218 |         return Bunch(data=data,\n 219 |                      filenames=filenames,\n 220 |                      target_names=target_names,\n 221 |                      target=target,\n 222 |                      DESCR=description)\n 223 | \n 224 |     return Bunch(filenames=filenames,\n 225 |                  target_names=target_names,\n 226 |                  target=target,\n 227 |                  DESCR=description)\n 228 | \n 229 | \n 230 | def load_data(module_path, data_file_name):\n 231 |     \"\"\"Loads data from module_path/data/data_file_name.\n 232 | \n 233 |     Parameters\n 234 |     ----------\n 235 |     module_path : string\n 236 |         The module path.\n 237 | \n 238 |     data_file_name : string\n 239 |         Name of csv file to be loaded from\n 240 |         module_path/data/data_file_name. For example 'wine_data.csv'.\n 241 | \n 242 |     Returns\n 243 |     -------\n 244 |     data : Numpy array\n 245 |         A 2D array with each row representing one sample and each column\n 246 |         representing the features of a given sample.\n 247 | \n 248 |     target : Numpy array\n 249 |         A 1D array holding target variables for all the samples in `data.\n 250 |         For example target[0] is the target varible for data[0].\n 251 | \n 252 |     target_names : Numpy array\n 253 |         A 1D array containing the names of the classifications. For example\n 254 |         target_names[0] is the name of the target[0] class.\n 255 |     \"\"\"\n 256 |     with open(join(module_path, 'data', data_file_name)) as csv_file:\n 257 |         data_file = csv.reader(csv_file)\n 258 |         temp = next(data_file)\n 259 |         n_samples = int(temp[0])\n 260 |         n_features = int(temp[1])\n 261 |         target_names = np.array(temp[2:])\n 262 |         data = np.empty((n_samples, n_features))\n 263 |         target = np.empty((n_samples,), dtype=int)\n 264 | \n 265 |         for i, ir in enumerate(data_file):\n 266 |             data[i] = np.asarray(ir[:-1], dtype=np.float64)\n 267 |             target[i] = np.asarray(ir[-1], dtype=int)\n 268 | \n 269 |     return data, target, target_names\n 270 | \n 271 | \n 272 | @_deprecate_positional_args\n 273 | def load_wine(*, return_X_y=False, as_frame=False):\n 274 |     \"\"\"Load and return the wine dataset (classification).\n 275 | \n 276 |     .. versionadded:: 0.18\n 277 | \n 278 |     The wine dataset is a classic and very easy multi-class classification\n 279 |     dataset.\n 280 | \n 281 |     =================   ==============\n 282 |     Classes                          3\n 283 |     Samples per class        [59,71,48]\n 284 |     Samples total                  178\n 285 |     Dimensionality                  13\n 286 |     Features            real, positive\n 287 |     =================   ==============\n 288 | \n 289 |     Read more in the :ref:`User Guide <wine_dataset>`.\n 290 | \n 291 |     Parameters\n 292 |     ----------\n 293 |     return_X_y : bool, default=False\n 294 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 295 |         See below for more information about the `data` and `target` object.\n 296 | \n 297 |     as_frame : bool, default=False\n 298 |         If True, the data is a pandas DataFrame including columns with\n 299 |         appropriate dtypes (numeric). The target is\n 300 |         a pandas DataFrame or Series depending on the number of target columns.\n 301 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 302 |         DataFrames or Series as described below.\n 303 | \n 304 |         .. versionadded:: 0.23\n 305 | \n 306 |     Returns\n 307 |     -------\n 308 |     data : :class:`~sklearn.utils.Bunch`\n 309 |         Dictionary-like object, with the following attributes.\n 310 | \n 311 |         data : {ndarray, dataframe} of shape (178, 13)\n 312 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 313 |             DataFrame.\n 314 |         target: {ndarray, Series} of shape (178,)\n 315 |             The classification target. If `as_frame=True`, `target` will be\n 316 |             a pandas Series.\n 317 |         feature_names: list\n 318 |             The names of the dataset columns.\n 319 |         target_names: list\n 320 |             The names of target classes.\n 321 |         frame: DataFrame of shape (178, 14)\n 322 |             Only present when `as_frame=True`. DataFrame with `data` and\n 323 |             `target`.\n 324 | \n 325 |             .. versionadded:: 0.23\n 326 |         DESCR: str\n 327 |             The full description of the dataset.\n 328 | \n 329 |     (data, target) : tuple if ``return_X_y`` is True\n 330 | \n 331 |     The copy of UCI ML Wine Data Set dataset is downloaded and modified to fit\n 332 |     standard format from:\n 333 |     https://archive.ics.uci.edu/ml/machine-learning-databases/wine/wine.data\n 334 | \n 335 |     Examples\n 336 |     --------\n 337 |     Let's say you are interested in the samples 10, 80, and 140, and want to\n 338 |     know their class name.\n 339 | \n 340 |     >>> from sklearn.datasets import load_wine\n 341 |     >>> data = load_wine()\n 342 |     >>> data.target[[10, 80, 140]]\n 343 |     array([0, 1, 2])\n 344 |     >>> list(data.target_names)\n 345 |     ['class_0', 'class_1', 'class_2']\n 346 |     \"\"\"\n 347 |     module_path = dirname(__file__)\n 348 |     data, target, target_names = load_data(module_path, 'wine_data.csv')\n 349 | \n 350 |     with open(join(module_path, 'descr', 'wine_data.rst')) as rst_file:\n 351 |         fdescr = rst_file.read()\n 352 | \n 353 |     feature_names = ['alcohol',\n 354 |                      'malic_acid',\n 355 |                      'ash',\n 356 |                      'alcalinity_of_ash',\n 357 |                      'magnesium',\n 358 |                      'total_phenols',\n 359 |                      'flavanoids',\n 360 |                      'nonflavanoid_phenols',\n 361 |                      'proanthocyanins',\n 362 |                      'color_intensity',\n 363 |                      'hue',\n 364 |                      'od280/od315_of_diluted_wines',\n 365 |                      'proline']\n 366 | \n 367 |     frame = None\n 368 |     target_columns = ['target', ]\n 369 |     if as_frame:\n 370 |         frame, data, target = _convert_data_dataframe(\"load_wine\",\n 371 |                                                       data,\n 372 |                                                       target,\n 373 |                                                       feature_names,\n 374 |                                                       target_columns)\n 375 | \n 376 |     if return_X_y:\n 377 |         return data, target\n 378 | \n 379 |     return Bunch(data=data,\n 380 |                  target=target,\n 381 |                  frame=frame,\n 382 |                  target_names=target_names,\n 383 |                  DESCR=fdescr,\n 384 |                  feature_names=feature_names)\n 385 | \n 386 | \n 387 | @_deprecate_positional_args\n 388 | def load_iris(*, return_X_y=False, as_frame=False):\n 389 |     \"\"\"Load and return the iris dataset (classification).\n 390 | \n 391 |     The iris dataset is a classic and very easy multi-class classification\n 392 |     dataset.\n 393 | \n 394 |     =================   ==============\n 395 |     Classes                          3\n 396 |     Samples per class               50\n 397 |     Samples total                  150\n 398 |     Dimensionality                   4\n 399 |     Features            real, positive\n 400 |     =================   ==============\n 401 | \n 402 |     Read more in the :ref:`User Guide <iris_dataset>`.\n 403 | \n 404 |     Parameters\n 405 |     ----------\n 406 |     return_X_y : bool, default=False\n 407 |         If True, returns ``(data, target)`` instead of a Bunch object. See\n 408 |         below for more information about the `data` and `target` object.\n 409 | \n 410 |         .. versionadded:: 0.18\n 411 | \n 412 |     as_frame : bool, default=False\n 413 |         If True, the data is a pandas DataFrame including columns with\n 414 |         appropriate dtypes (numeric). The target is\n 415 |         a pandas DataFrame or Series depending on the number of target columns.\n 416 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 417 |         DataFrames or Series as described below.\n 418 | \n 419 |         .. versionadded:: 0.23\n 420 | \n 421 |     Returns\n 422 |     -------\n 423 |     data : :class:`~sklearn.utils.Bunch`\n 424 |         Dictionary-like object, with the following attributes.\n 425 | \n 426 |         data : {ndarray, dataframe} of shape (150, 4)\n 427 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 428 |             DataFrame.\n 429 |         target: {ndarray, Series} of shape (150,)\n 430 |             The classification target. If `as_frame=True`, `target` will be\n 431 |             a pandas Series.\n 432 |         feature_names: list\n 433 |             The names of the dataset columns.\n 434 |         target_names: list\n 435 |             The names of target classes.\n 436 |         frame: DataFrame of shape (150, 5)\n 437 |             Only present when `as_frame=True`. DataFrame with `data` and\n 438 |             `target`.\n 439 | \n 440 |             .. versionadded:: 0.23\n 441 |         DESCR: str\n 442 |             The full description of the dataset.\n 443 |         filename: str\n 444 |             The path to the location of the data.\n 445 | \n 446 |             .. versionadded:: 0.20\n 447 | \n 448 |     (data, target) : tuple if ``return_X_y`` is True\n 449 | \n 450 |         .. versionadded:: 0.18\n 451 | \n 452 |     Notes\n 453 |     -----\n 454 |         .. versionchanged:: 0.20\n 455 |             Fixed two wrong data points according to Fisher's paper.\n 456 |             The new version is the same as in R, but not as in the UCI\n 457 |             Machine Learning Repository.\n 458 | \n 459 |     Examples\n 460 |     --------\n 461 |     Let's say you are interested in the samples 10, 25, and 50, and want to\n 462 |     know their class name.\n 463 | \n 464 |     >>> from sklearn.datasets import load_iris\n 465 |     >>> data = load_iris()\n 466 |     >>> data.target[[10, 25, 50]]\n 467 |     array([0, 0, 1])\n 468 |     >>> list(data.target_names)\n 469 |     ['setosa', 'versicolor', 'virginica']\n 470 |     \"\"\"\n 471 |     module_path = dirname(__file__)\n 472 |     data, target, target_names = load_data(module_path, 'iris.csv')\n 473 |     iris_csv_filename = join(module_path, 'data', 'iris.csv')\n 474 | \n 475 |     with open(join(module_path, 'descr', 'iris.rst')) as rst_file:\n 476 |         fdescr = rst_file.read()\n 477 | \n 478 |     feature_names = ['sepal length (cm)', 'sepal width (cm)',\n 479 |                      'petal length (cm)', 'petal width (cm)']\n 480 | \n 481 |     frame = None\n 482 |     target_columns = ['target', ]\n 483 |     if as_frame:\n 484 |         frame, data, target = _convert_data_dataframe(\"load_iris\",\n 485 |                                                       data,\n 486 |                                                       target,\n 487 |                                                       feature_names,\n 488 |                                                       target_columns)\n 489 | \n 490 |     if return_X_y:\n 491 |         return data, target\n 492 | \n 493 |     return Bunch(data=data,\n 494 |                  target=target,\n 495 |                  frame=frame,\n 496 |                  target_names=target_names,\n 497 |                  DESCR=fdescr,\n 498 |                  feature_names=feature_names,\n 499 |                  filename=iris_csv_filename)\n 500 | \n 501 | \n 502 | @_deprecate_positional_args\n 503 | def load_breast_cancer(*, return_X_y=False, as_frame=False):\n 504 |     \"\"\"Load and return the breast cancer wisconsin dataset (classification).\n 505 | \n 506 |     The breast cancer dataset is a classic and very easy binary classification\n 507 |     dataset.\n 508 | \n 509 |     =================   ==============\n 510 |     Classes                          2\n 511 |     Samples per class    212(M),357(B)\n 512 |     Samples total                  569\n 513 |     Dimensionality                  30\n 514 |     Features            real, positive\n 515 |     =================   ==============\n 516 | \n 517 |     Read more in the :ref:`User Guide <breast_cancer_dataset>`.\n 518 | \n 519 |     Parameters\n 520 |     ----------\n 521 |     return_X_y : bool, default=False\n 522 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 523 |         See below for more information about the `data` and `target` object.\n 524 | \n 525 |         .. versionadded:: 0.18\n 526 | \n 527 |     as_frame : bool, default=False\n 528 |         If True, the data is a pandas DataFrame including columns with\n 529 |         appropriate dtypes (numeric). The target is\n 530 |         a pandas DataFrame or Series depending on the number of target columns.\n 531 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 532 |         DataFrames or Series as described below.\n 533 | \n 534 |         .. versionadded:: 0.23\n 535 | \n 536 |     Returns\n 537 |     -------\n 538 |     data : :class:`~sklearn.utils.Bunch`\n 539 |         Dictionary-like object, with the following attributes.\n 540 | \n 541 |         data : {ndarray, dataframe} of shape (569, 30)\n 542 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 543 |             DataFrame.\n 544 |         target: {ndarray, Series} of shape (569,)\n 545 |             The classification target. If `as_frame=True`, `target` will be\n 546 |             a pandas Series.\n 547 |         feature_names: list\n 548 |             The names of the dataset columns.\n 549 |         target_names: list\n 550 |             The names of target classes.\n 551 |         frame: DataFrame of shape (569, 31)\n 552 |             Only present when `as_frame=True`. DataFrame with `data` and\n 553 |             `target`.\n 554 | \n 555 |             .. versionadded:: 0.23\n 556 |         DESCR: str\n 557 |             The full description of the dataset.\n 558 |         filename: str\n 559 |             The path to the location of the data.\n 560 | \n 561 |             .. versionadded:: 0.20\n 562 | \n 563 |     (data, target) : tuple if ``return_X_y`` is True\n 564 | \n 565 |         .. versionadded:: 0.18\n 566 | \n 567 |     The copy of UCI ML Breast Cancer Wisconsin (Diagnostic) dataset is\n 568 |     downloaded from:\n 569 |     https://goo.gl/U2Uwz2\n 570 | \n 571 |     Examples\n 572 |     --------\n 573 |     Let's say you are interested in the samples 10, 50, and 85, and want to\n 574 |     know their class name.\n 575 | \n 576 |     >>> from sklearn.datasets import load_breast_cancer\n 577 |     >>> data = load_breast_cancer()\n 578 |     >>> data.target[[10, 50, 85]]\n 579 |     array([0, 1, 0])\n 580 |     >>> list(data.target_names)\n 581 |     ['malignant', 'benign']\n 582 |     \"\"\"\n 583 |     module_path = dirname(__file__)\n 584 |     data, target, target_names = load_data(module_path, 'breast_cancer.csv')\n 585 |     csv_filename = join(module_path, 'data', 'breast_cancer.csv')\n 586 | \n 587 |     with open(join(module_path, 'descr', 'breast_cancer.rst')) as rst_file:\n 588 |         fdescr = rst_file.read()\n 589 | \n 590 |     feature_names = np.array(['mean radius', 'mean texture',\n 591 |                               'mean perimeter', 'mean area',\n 592 |                               'mean smoothness', 'mean compactness',\n 593 |                               'mean concavity', 'mean concave points',\n 594 |                               'mean symmetry', 'mean fractal dimension',\n 595 |                               'radius error', 'texture error',\n 596 |                               'perimeter error', 'area error',\n 597 |                               'smoothness error', 'compactness error',\n 598 |                               'concavity error', 'concave points error',\n 599 |                               'symmetry error', 'fractal dimension error',\n 600 |                               'worst radius', 'worst texture',\n 601 |                               'worst perimeter', 'worst area',\n 602 |                               'worst smoothness', 'worst compactness',\n 603 |                               'worst concavity', 'worst concave points',\n 604 |                               'worst symmetry', 'worst fractal dimension'])\n 605 | \n 606 |     frame = None\n 607 |     target_columns = ['target', ]\n 608 |     if as_frame:\n 609 |         frame, data, target = _convert_data_dataframe(\"load_breast_cancer\",\n 610 |                                                       data,\n 611 |                                                       target,\n 612 |                                                       feature_names,\n 613 |                                                       target_columns)\n 614 | \n 615 |     if return_X_y:\n 616 |         return data, target\n 617 | \n 618 |     return Bunch(data=data,\n 619 |                  target=target,\n 620 |                  frame=frame,\n 621 |                  target_names=target_names,\n 622 |                  DESCR=fdescr,\n 623 |                  feature_names=feature_names,\n 624 |                  filename=csv_filename)\n 625 | \n 626 | \n 627 | @_deprecate_positional_args\n 628 | def load_digits(*, n_class=10, return_X_y=False, as_frame=False):\n 629 |     \"\"\"Load and return the digits dataset (classification).\n 630 | \n 631 |     Each datapoint is a 8x8 image of a digit.\n 632 | \n 633 |     =================   ==============\n 634 |     Classes                         10\n 635 |     Samples per class             ~180\n 636 |     Samples total                 1797\n 637 |     Dimensionality                  64\n 638 |     Features             integers 0-16\n 639 |     =================   ==============\n 640 | \n 641 |     Read more in the :ref:`User Guide <digits_dataset>`.\n 642 | \n 643 |     Parameters\n 644 |     ----------\n 645 |     n_class : int, default=10\n 646 |         The number of classes to return. Between 0 and 10.\n 647 | \n 648 |     return_X_y : bool, default=False\n 649 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 650 |         See below for more information about the `data` and `target` object.\n 651 | \n 652 |         .. versionadded:: 0.18\n 653 | \n 654 |     as_frame : bool, default=False\n 655 |         If True, the data is a pandas DataFrame including columns with\n 656 |         appropriate dtypes (numeric). The target is\n 657 |         a pandas DataFrame or Series depending on the number of target columns.\n 658 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 659 |         DataFrames or Series as described below.\n 660 | \n 661 |         .. versionadded:: 0.23\n 662 | \n 663 |     Returns\n 664 |     -------\n 665 |     data : :class:`~sklearn.utils.Bunch`\n 666 |         Dictionary-like object, with the following attributes.\n 667 | \n 668 |         data : {ndarray, dataframe} of shape (1797, 64)\n 669 |             The flattened data matrix. If `as_frame=True`, `data` will be\n 670 |             a pandas DataFrame.\n 671 |         target: {ndarray, Series} of shape (1797,)\n 672 |             The classification target. If `as_frame=True`, `target` will be\n 673 |             a pandas Series.\n 674 |         feature_names: list\n 675 |             The names of the dataset columns.\n 676 |         target_names: list\n 677 |             The names of target classes.\n 678 | \n 679 |             .. versionadded:: 0.20\n 680 | \n 681 |         frame: DataFrame of shape (1797, 65)\n 682 |             Only present when `as_frame=True`. DataFrame with `data` and\n 683 |             `target`.\n 684 | \n 685 |             .. versionadded:: 0.23\n 686 |         images: {ndarray} of shape (1797, 8, 8)\n 687 |             The raw image data.\n 688 |         DESCR: str\n 689 |             The full description of the dataset.\n 690 | \n 691 |     (data, target) : tuple if ``return_X_y`` is True\n 692 | \n 693 |         .. versionadded:: 0.18\n 694 | \n 695 |     This is a copy of the test set of the UCI ML hand-written digits datasets\n 696 |     https://archive.ics.uci.edu/ml/datasets/Optical+Recognition+of+Handwritten+Digits\n 697 | \n 698 |     Examples\n 699 |     --------\n 700 |     To load the data and visualize the images::\n 701 | \n 702 |         >>> from sklearn.datasets import load_digits\n 703 |         >>> digits = load_digits()\n 704 |         >>> print(digits.data.shape)\n 705 |         (1797, 64)\n 706 |         >>> import matplotlib.pyplot as plt #doctest: +SKIP\n 707 |         >>> plt.gray() #doctest: +SKIP\n 708 |         >>> plt.matshow(digits.images[0]) #doctest: +SKIP\n 709 |         >>> plt.show() #doctest: +SKIP\n 710 |     \"\"\"\n 711 |     module_path = dirname(__file__)\n 712 |     data = np.loadtxt(join(module_path, 'data', 'digits.csv.gz'),\n 713 |                       delimiter=',')\n 714 |     with open(join(module_path, 'descr', 'digits.rst')) as f:\n 715 |         descr = f.read()\n 716 |     target = data[:, -1].astype(int, copy=False)\n 717 |     flat_data = data[:, :-1]\n 718 |     images = flat_data.view()\n 719 |     images.shape = (-1, 8, 8)\n 720 | \n 721 |     if n_class < 10:\n 722 |         idx = target < n_class\n 723 |         flat_data, target = flat_data[idx], target[idx]\n 724 |         images = images[idx]\n 725 | \n 726 |     feature_names = ['pixel_{}_{}'.format(row_idx, col_idx)\n 727 |                      for row_idx in range(8)\n 728 |                      for col_idx in range(8)]\n 729 | \n 730 |     frame = None\n 731 |     target_columns = ['target', ]\n 732 |     if as_frame:\n 733 |         frame, flat_data, target = _convert_data_dataframe(\"load_digits\",\n 734 |                                                            flat_data,\n 735 |                                                            target,\n 736 |                                                            feature_names,\n 737 |                                                            target_columns)\n 738 | \n 739 |     if return_X_y:\n 740 |         return flat_data, target\n 741 | \n 742 |     return Bunch(data=flat_data,\n 743 |                  target=target,\n 744 |                  frame=frame,\n 745 |                  feature_names=feature_names,\n 746 |                  target_names=np.arange(10),\n 747 |                  images=images,\n 748 |                  DESCR=descr)\n 749 | \n 750 | \n 751 | @_deprecate_positional_args\n 752 | def load_diabetes(*, return_X_y=False, as_frame=False):\n 753 |     \"\"\"Load and return the diabetes dataset (regression).\n 754 | \n 755 |     ==============   ==================\n 756 |     Samples total    442\n 757 |     Dimensionality   10\n 758 |     Features         real, -.2 < x < .2\n 759 |     Targets          integer 25 - 346\n 760 |     ==============   ==================\n 761 | \n 762 |     Read more in the :ref:`User Guide <diabetes_dataset>`.\n 763 | \n 764 |     Parameters\n 765 |     ----------\n 766 |     return_X_y : bool, default=False.\n 767 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 768 |         See below for more information about the `data` and `target` object.\n 769 | \n 770 |         .. versionadded:: 0.18\n 771 | \n 772 |     as_frame : bool, default=False\n 773 |         If True, the data is a pandas DataFrame including columns with\n 774 |         appropriate dtypes (numeric). The target is\n 775 |         a pandas DataFrame or Series depending on the number of target columns.\n 776 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 777 |         DataFrames or Series as described below.\n 778 | \n 779 |         .. versionadded:: 0.23\n 780 | \n 781 |     Returns\n 782 |     -------\n 783 |     data : :class:`~sklearn.utils.Bunch`\n 784 |         Dictionary-like object, with the following attributes.\n 785 | \n 786 |         data : {ndarray, dataframe} of shape (442, 10)\n 787 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 788 |             DataFrame.\n 789 |         target: {ndarray, Series} of shape (442,)\n 790 |             The regression target. If `as_frame=True`, `target` will be\n 791 |             a pandas Series.\n 792 |         feature_names: list\n 793 |             The names of the dataset columns.\n 794 |         frame: DataFrame of shape (442, 11)\n 795 |             Only present when `as_frame=True`. DataFrame with `data` and\n 796 |             `target`.\n 797 | \n 798 |             .. versionadded:: 0.23\n 799 |         DESCR: str\n 800 |             The full description of the dataset.\n 801 |         data_filename: str\n 802 |             The path to the location of the data.\n 803 |         target_filename: str\n 804 |             The path to the location of the target.\n 805 | \n 806 |     (data, target) : tuple if ``return_X_y`` is True\n 807 | \n 808 |         .. versionadded:: 0.18\n 809 |     \"\"\"\n 810 |     module_path = dirname(__file__)\n 811 |     base_dir = join(module_path, 'data')\n 812 |     data_filename = join(base_dir, 'diabetes_data.csv.gz')\n 813 |     data = np.loadtxt(data_filename)\n 814 |     target_filename = join(base_dir, 'diabetes_target.csv.gz')\n 815 |     target = np.loadtxt(target_filename)\n 816 | \n 817 |     with open(join(module_path, 'descr', 'diabetes.rst')) as rst_file:\n 818 |         fdescr = rst_file.read()\n 819 | \n 820 |     feature_names = ['age', 'sex', 'bmi', 'bp',\n 821 |                      's1', 's2', 's3', 's4', 's5', 's6']\n 822 | \n 823 |     frame = None\n 824 |     target_columns = ['target', ]\n 825 |     if as_frame:\n 826 |         frame, data, target = _convert_data_dataframe(\"load_diabetes\",\n 827 |                                                       data,\n 828 |                                                       target,\n 829 |                                                       feature_names,\n 830 |                                                       target_columns)\n 831 | \n 832 |     if return_X_y:\n 833 |         return data, target\n 834 | \n 835 |     return Bunch(data=data,\n 836 |                  target=target,\n 837 |                  frame=frame,\n 838 |                  DESCR=fdescr,\n 839 |                  feature_names=feature_names,\n 840 |                  data_filename=data_filename,\n 841 |                  target_filename=target_filename)\n 842 | \n 843 | \n 844 | @_deprecate_positional_args\n 845 | def load_linnerud(*, return_X_y=False, as_frame=False):\n 846 |     \"\"\"Load and return the physical excercise linnerud dataset.\n 847 | \n 848 |     This dataset is suitable for multi-ouput regression tasks.\n 849 | \n 850 |     ==============   ============================\n 851 |     Samples total    20\n 852 |     Dimensionality   3 (for both data and target)\n 853 |     Features         integer\n 854 |     Targets          integer\n 855 |     ==============   ============================\n 856 | \n 857 |     Read more in the :ref:`User Guide <linnerrud_dataset>`.\n 858 | \n 859 |     Parameters\n 860 |     ----------\n 861 |     return_X_y : bool, default=False\n 862 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 863 |         See below for more information about the `data` and `target` object.\n 864 | \n 865 |         .. versionadded:: 0.18\n 866 | \n 867 |     as_frame : bool, default=False\n 868 |         If True, the data is a pandas DataFrame including columns with\n 869 |         appropriate dtypes (numeric, string or categorical). The target is\n 870 |         a pandas DataFrame or Series depending on the number of target columns.\n 871 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 872 |         DataFrames or Series as described below.\n 873 | \n 874 |         .. versionadded:: 0.23\n 875 | \n 876 |     Returns\n 877 |     -------\n 878 |     data : :class:`~sklearn.utils.Bunch`\n 879 |         Dictionary-like object, with the following attributes.\n 880 | \n 881 |         data : {ndarray, dataframe} of shape (20, 3)\n 882 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 883 |             DataFrame.\n 884 |         target: {ndarray, dataframe} of shape (20, 3)\n 885 |             The regression targets. If `as_frame=True`, `target` will be\n 886 |             a pandas DataFrame.\n 887 |         feature_names: list\n 888 |             The names of the dataset columns.\n 889 |         target_names: list\n 890 |             The names of the target columns.\n 891 |         frame: DataFrame of shape (20, 6)\n 892 |             Only present when `as_frame=True`. DataFrame with `data` and\n 893 |             `target`.\n 894 | \n 895 |             .. versionadded:: 0.23\n 896 |         DESCR: str\n 897 |             The full description of the dataset.\n 898 |         data_filename: str\n 899 |             The path to the location of the data.\n 900 |         target_filename: str\n 901 |             The path to the location of the target.\n 902 | \n 903 |             .. versionadded:: 0.20\n 904 | \n 905 |     (data, target) : tuple if ``return_X_y`` is True\n 906 | \n 907 |         .. versionadded:: 0.18\n 908 |     \"\"\"\n 909 |     base_dir = join(dirname(__file__), 'data/')\n 910 |     data_filename = join(base_dir, 'linnerud_exercise.csv')\n 911 |     target_filename = join(base_dir, 'linnerud_physiological.csv')\n 912 | \n 913 |     # Read data\n 914 |     data_exercise = np.loadtxt(data_filename, skiprows=1)\n 915 |     data_physiological = np.loadtxt(target_filename, skiprows=1)\n 916 | \n 917 |     # Read header\n 918 |     with open(data_filename) as f:\n 919 |         header_exercise = f.readline().split()\n 920 |     with open(target_filename) as f:\n 921 |         header_physiological = f.readline().split()\n 922 | \n 923 |     with open(dirname(__file__) + '/descr/linnerud.rst') as f:\n 924 |         descr = f.read()\n 925 | \n 926 |     frame = None\n 927 |     if as_frame:\n 928 |         (frame,\n 929 |          data_exercise,\n 930 |          data_physiological) = _convert_data_dataframe(\"load_linnerud\",\n 931 |                                                        data_exercise,\n 932 |                                                        data_physiological,\n 933 |                                                        header_exercise,\n 934 |                                                        header_physiological)\n 935 |     if return_X_y:\n 936 |         return data_exercise, data_physiological\n 937 | \n 938 |     return Bunch(data=data_exercise,\n 939 |                  feature_names=header_exercise,\n 940 |                  target=data_physiological,\n 941 |                  target_names=header_physiological,\n 942 |                  frame=frame,\n 943 |                  DESCR=descr,\n 944 |                  data_filename=data_filename,\n 945 |                  target_filename=target_filename)\n 946 | \n 947 | \n 948 | @_deprecate_positional_args\n 949 | def load_boston(*, return_X_y=False):\n 950 |     \"\"\"Load and return the boston house-prices dataset (regression).\n 951 | \n 952 |     ==============   ==============\n 953 |     Samples total               506\n 954 |     Dimensionality               13\n 955 |     Features         real, positive\n 956 |     Targets           real 5. - 50.\n 957 |     ==============   ==============\n 958 | \n 959 |     Read more in the :ref:`User Guide <boston_dataset>`.\n 960 | \n 961 |     Parameters\n 962 |     ----------\n 963 |     return_X_y : bool, default=False\n 964 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 965 |         See below for more information about the `data` and `target` object.\n 966 | \n 967 |         .. versionadded:: 0.18\n 968 | \n 969 |     Returns\n 970 |     -------\n 971 |     data : :class:`~sklearn.utils.Bunch`\n 972 |         Dictionary-like object, with the following attributes.\n 973 | \n 974 |         data : ndarray of shape (506, 13)\n 975 |             The data matrix.\n 976 |         target : ndarray of shape (506, )\n 977 |             The regression target.\n 978 |         filename : str\n 979 |             The physical location of boston csv dataset.\n 980 | \n 981 |             .. versionadded:: 0.20\n 982 | \n 983 |         DESCR : str\n 984 |             The full description of the dataset.\n 985 |         feature_names : ndarray\n 986 |             The names of features\n 987 | \n 988 |     (data, target) : tuple if ``return_X_y`` is True\n 989 | \n 990 |         .. versionadded:: 0.18\n 991 | \n 992 |     Notes\n 993 |     -----\n 994 |         .. versionchanged:: 0.20\n 995 |             Fixed a wrong data point at [445, 0].\n 996 | \n 997 |     Examples\n 998 |     --------\n 999 |     >>> from sklearn.datasets import load_boston\n1000 |     >>> X, y = load_boston(return_X_y=True)\n1001 |     >>> print(X.shape)\n1002 |     (506, 13)\n1003 |     \"\"\"\n1004 |     module_path = dirname(__file__)\n1005 | \n1006 |     fdescr_name = join(module_path, 'descr', 'boston_house_prices.rst')\n1007 |     with open(fdescr_name) as f:\n1008 |         descr_text = f.read()\n1009 | \n1010 |     data_file_name = join(module_path, 'data', 'boston_house_prices.csv')\n1011 |     with open(data_file_name) as f:\n1012 |         data_file = csv.reader(f)\n1013 |         temp = next(data_file)\n1014 |         n_samples = int(temp[0])\n1015 |         n_features = int(temp[1])\n1016 |         data = np.empty((n_samples, n_features))\n1017 |         target = np.empty((n_samples,))\n1018 |         temp = next(data_file)  # names of features\n1019 |         feature_names = np.array(temp)\n1020 | \n1021 |         for i, d in enumerate(data_file):\n1022 |             data[i] = np.asarray(d[:-1], dtype=np.float64)\n1023 |             target[i] = np.asarray(d[-1], dtype=np.float64)\n1024 | \n1025 |     if return_X_y:\n1026 |         return data, target\n1027 | \n1028 |     return Bunch(data=data,\n1029 |                  target=target,\n1030 |                  # last column is target value\n1031 |                  feature_names=feature_names[:-1],\n1032 |                  DESCR=descr_text,\n1033 |                  filename=data_file_name)\n1034 | \n1035 | \n1036 | def load_sample_images():\n1037 |     \"\"\"Load sample images for image manipulation.\n1038 | \n1039 |     Loads both, ``china`` and ``flower``.\n1040 | \n1041 |     Read more in the :ref:`User Guide <sample_images>`.\n1042 | \n1043 |     Returns\n1044 |     -------\n1045 |     data : :class:`~sklearn.utils.Bunch`\n1046 |         Dictionary-like object, with the following attributes.\n1047 | \n1048 |         images : list of ndarray of shape (427, 640, 3)\n1049 |             The two sample image.\n1050 |         filenames : list\n1051 |             The filenames for the images.\n1052 |         DESCR : str\n1053 |             The full description of the dataset.\n1054 | \n1055 |     Examples\n1056 |     --------\n1057 |     To load the data and visualize the images:\n1058 | \n1059 |     >>> from sklearn.datasets import load_sample_images\n1060 |     >>> dataset = load_sample_images()     #doctest: +SKIP\n1061 |     >>> len(dataset.images)                #doctest: +SKIP\n1062 |     2\n1063 |     >>> first_img_data = dataset.images[0] #doctest: +SKIP\n1064 |     >>> first_img_data.shape               #doctest: +SKIP\n1065 |     (427, 640, 3)\n1066 |     >>> first_img_data.dtype               #doctest: +SKIP\n1067 |     dtype('uint8')\n1068 |     \"\"\"\n1069 |     # import PIL only when needed\n1070 |     from ..externals._pilutil import imread\n1071 | \n1072 |     module_path = join(dirname(__file__), \"images\")\n1073 |     with open(join(module_path, 'README.txt')) as f:\n1074 |         descr = f.read()\n1075 |     filenames = [join(module_path, filename)\n1076 |                  for filename in sorted(os.listdir(module_path))\n1077 |                  if filename.endswith(\".jpg\")]\n1078 |     # Load image data for each image in the source folder.\n1079 |     images = [imread(filename) for filename in filenames]\n1080 | \n1081 |     return Bunch(images=images,\n1082 |                  filenames=filenames,\n1083 |                  DESCR=descr)\n1084 | \n1085 | \n1086 | def load_sample_image(image_name):\n1087 |     \"\"\"Load the numpy array of a single sample image\n1088 | \n1089 |     Read more in the :ref:`User Guide <sample_images>`.\n1090 | \n1091 |     Parameters\n1092 |     ----------\n1093 |     image_name : {`china.jpg`, `flower.jpg`}\n1094 |         The name of the sample image loaded\n1095 | \n1096 |     Returns\n1097 |     -------\n1098 |     img : 3D array\n1099 |         The image as a numpy array: height x width x color\n1100 | \n1101 |     Examples\n1102 |     --------\n1103 | \n1104 |     >>> from sklearn.datasets import load_sample_image\n1105 |     >>> china = load_sample_image('china.jpg')   # doctest: +SKIP\n1106 |     >>> china.dtype                              # doctest: +SKIP\n1107 |     dtype('uint8')\n1108 |     >>> china.shape                              # doctest: +SKIP\n1109 |     (427, 640, 3)\n1110 |     >>> flower = load_sample_image('flower.jpg') # doctest: +SKIP\n1111 |     >>> flower.dtype                             # doctest: +SKIP\n1112 |     dtype('uint8')\n1113 |     >>> flower.shape                             # doctest: +SKIP\n1114 |     (427, 640, 3)\n1115 |     \"\"\"\n1116 |     images = load_sample_images()\n1117 |     index = None\n1118 |     for i, filename in enumerate(images.filenames):\n1119 |         if filename.endswith(image_name):\n1120 |             index = i\n1121 |             break\n1122 |     if index is None:\n1123 |         raise AttributeError(\"Cannot find sample image: %s\" % image_name)\n1124 |     return images.images[index]\n1125 | \n1126 | \n1127 | def _pkl_filepath(*args, **kwargs):\n1128 |     \"\"\"Return filename for Python 3 pickles\n1129 | \n1130 |     args[-1] is expected to be the \".pkl\" filename. For compatibility with\n1131 |     older scikit-learn versions, a suffix is inserted before the extension.\n1132 | \n1133 |     _pkl_filepath('/path/to/folder', 'filename.pkl') returns\n1134 |     '/path/to/folder/filename_py3.pkl'\n1135 | \n1136 |     \"\"\"\n1137 |     py3_suffix = kwargs.get(\"py3_suffix\", \"_py3\")\n1138 |     basename, ext = splitext(args[-1])\n1139 |     basename += py3_suffix\n1140 |     new_args = args[:-1] + (basename + ext,)\n1141 |     return join(*new_args)\n1142 | \n1143 | \n1144 | def _sha256(path):\n1145 |     \"\"\"Calculate the sha256 hash of the file at path.\"\"\"\n1146 |     sha256hash = hashlib.sha256()\n1147 |     chunk_size = 8192\n1148 |     with open(path, \"rb\") as f:\n1149 |         while True:\n1150 |             buffer = f.read(chunk_size)\n1151 |             if not buffer:\n1152 |                 break\n1153 |             sha256hash.update(buffer)\n1154 |     return sha256hash.hexdigest()\n1155 | \n1156 | \n1157 | def _fetch_remote(remote, dirname=None):\n1158 |     \"\"\"Helper function to download a remote dataset into path\n1159 | \n1160 |     Fetch a dataset pointed by remote's url, save into path using remote's\n1161 |     filename and ensure its integrity based on the SHA256 Checksum of the\n1162 |     downloaded file.\n1163 | \n1164 |     Parameters\n1165 |     ----------\n1166 |     remote : RemoteFileMetadata\n1167 |         Named tuple containing remote dataset meta information: url, filename\n1168 |         and checksum\n1169 | \n1170 |     dirname : string\n1171 |         Directory to save the file to.\n1172 | \n1173 |     Returns\n1174 |     -------\n1175 |     file_path: string\n1176 |         Full path of the created file.\n1177 |     \"\"\"\n1178 | \n1179 |     file_path = (remote.filename if dirname is None\n1180 |                  else join(dirname, remote.filename))\n1181 |     urlretrieve(remote.url, file_path)\n1182 |     checksum = _sha256(file_path)\n1183 |     if remote.checksum != checksum:\n1184 |         raise IOError(\"{} has an SHA256 checksum ({}) \"\n1185 |                       \"differing from expected ({}), \"\n1186 |                       \"file may be corrupted.\".format(file_path, checksum,\n1187 |                                                       remote.checksum))\n1188 |     return file_path\n1189 | \n```\n"}, {"content": "Based on my analysis, I can now provide the locations that need modification to implement the MD5 checksum validation for the ARFF files downloaded via `fetch_openml`. Here are the relevant locations:\n\n```\nsklearn/datasets/_openml.py\nline: 809-816\nfunction: _download_data_to_bunch\ndetails: This is where the actual download happens and where we need to add MD5 checksum validation\n\nsklearn/datasets/_openml.py\nline: 817-818\nfunction: fetch_openml\ndetails: Where the data description is fetched and where we can add checksum validation logic\n\nsklearn/datasets/_base.py\nline: 1144-1154\nfunction: _sha256\ndetails: Contains the core SHA256 checksum calculation functionality that can be reused for MD5\n\nsklearn/datasets/_base.py\nline: 1179-1188\nfunction: _fetch_remote\ndetails: Shows how to calculate and validate checksums - can serve as template for MD5 implementation\n\nsklearn/utils/validation.py\nline: 1344-1379\nfunction: _check_fit_params\ndetails: Contains validation utilities that might be useful for implementing checksum validation\n```\n\nThe main changes would need to be made in the `_download_data_to_bunch` function within `sklearn/datasets/_openml.py`, where the ARFF file is currently downloaded and processed. Currently, it uses `urlretrieve` to download the file but doesn't validate the checksum.\n\nThe code shows that similar functionality exists for SHA256 checksum validation in `_fetch_remote` and `_sha256` functions, which can serve as a template for implementing MD5 checksum validation.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 172991, "completion_tokens": 617}, "time": 86.76051592826843}]}}
{"instance_id": "scikit-learn__scikit-learn-30327", "found_files": [["sklearn/utils/_tags.py", "sklearn/base.py", "sklearn/utils/estimator_checks.py", "sklearn/utils/validation.py"]], "found_modules": [["sklearn/utils/estimator_checks.py:check_estimator_tags_renamed", "sklearn/utils/_array_api.py:_accept_device_cpu", "sklearn/externals/_packaging/version.py:Version", "sklearn/mixture/_base.py:BaseMixture", "sklearn/feature_selection/_sequential.py:SequentialFeatureSelector", "sklearn/externals/_arff.py:ArffException", "sklearn/utils/_tags.py:get_tags", "sklearn/exceptions.py:EstimatorCheckFailedWarning", "asv_benchmarks/benchmarks/linear_model.py:LassoBenchmark", "sklearn/utils/_tags.py:default_tags", "sklearn/ensemble/_bagging.py:BaseBagging", "sklearn/base.py:BaseEstimator", "sklearn/linear_model/_ridge.py:RidgeClassifierCV", "sklearn/utils/validation.py:validate_data"]], "found_entities": [["sklearn/utils/estimator_checks.py:check_estimator_tags_renamed", "sklearn/utils/_array_api.py:_accept_device_cpu", "sklearn/externals/_packaging/version.py:Version.__repr__", "sklearn/mixture/_base.py:BaseMixture._get_parameters", "sklearn/feature_selection/_sequential.py:SequentialFeatureSelector._get_support_mask", "sklearn/externals/_arff.py:ArffException.__str__", "sklearn/utils/_tags.py:get_tags", "sklearn/exceptions.py:EstimatorCheckFailedWarning.__str__", "asv_benchmarks/benchmarks/linear_model.py:LassoBenchmark.make_scorers", "sklearn/utils/_tags.py:default_tags", "sklearn/ensemble/_bagging.py:BaseBagging._parallel_args", "sklearn/base.py:BaseEstimator.__sklearn_tags__", "sklearn/linear_model/_ridge.py:RidgeClassifierCV.fit", "sklearn/utils/validation.py:validate_data"]], "raw_output_loc": ["Based on my analysis, I can now provide the locations that need modification to implement the requested feature. Here's the output in the requested format:\n\n```\nsklearn/utils/_tags.py\nline: 319-332\nfunction: get_tags\n# Main location where old/new tag conversion logic needs to be implemented\n\nsklearn/utils/_tags.py\nline: 246-250\nfunction: default_tags\n# Support function that gets called when __sklearn_tags__ is not present\n\nsklearn/base.py\nline: 392-399\nclass: BaseEstimator\nfunction: __sklearn_tags__\n# Base implementation that needs to be updated\n\nsklearn/utils/estimator_checks.py\nline: 4447-4466\nfunction: check_estimator_tags_renamed\n# Validation function that needs to be updated to handle tag conversion\n\nsklearn/utils/validation.py\nline: 2909-2910\nfunction: validate_data\n# Uses get_tags and needs to handle old/new tag compatibility\n```\n\nThese locations are critical for implementing the requested feature because:\n\n1. `get_tags` is the main function that needs to be modified to handle the conversion between old and new tag systems.\n\n2. `default_tags` is a supporting function that currently handles the fallback mechanism when `__sklearn_tags__` is not present.\n\n3. The `BaseEstimator` class is the foundation that defines the tag system, and its `__sklearn_tags__` method needs to be documented and enhanced.\n\n4. `check_estimator_tags_renamed` is responsible for validating the tag system and needs to be updated to handle the transition period.\n\n5. `validate_data` uses `get_tags` and needs to be modified to properly handle both old and new tag systems while maintaining compatibility.\n\nThe core functionality would need to:\n1. Detect whether an estimator is using the new or old system\n2. Provide appropriate warnings when transitioning between systems\n3. Maintain backward compatibility while updating the codebase\n4. Raise deprecation warnings for outdated practices"], "meta_data": {"repo": "scikit-learn/scikit-learn", "base_commit": "90a51c12d6159f72ab8990ea1a3ff835861ec81d", "problem_statement": "MAINT conversion old->new/new->old tags\nTowards #30298 \r\n\r\nThis PR provides a way to convert old tags into new tags and new tags into old tags.\r\nWe should make sure that:\r\n\r\n- An estimator implementing `_get_tags` or `_more_tags` get a warning but that the check_estimator should be working reasonably\r\n- `_safe_tags` should raise a deprecation warning\r\n- we should make sure that `get_tags` can get old tags and convert it to new tags. The tricky part is to detect whether `__sklearn_tags__` if present is implemented by the `BaseEstimator` from scikit-learn or the child class. If this is only the `BaseEstimator`, we should raise a warning to move to the new API and we should temporary use the `_get_tags`/`_safe_tags`, otherwise we are fine.\r\n\n", "patch": "diff --git a/sklearn/base.py b/sklearn/base.py\nindex d646f8d3e56bf..2c82cf05a6c5a 100644\n--- a/sklearn/base.py\n+++ b/sklearn/base.py\n@@ -389,6 +389,33 @@ def __setstate__(self, state):\n         except AttributeError:\n             self.__dict__.update(state)\n \n+    # TODO(1.7): Remove this method\n+    def _more_tags(self):\n+        \"\"\"This code should never be reached since our `get_tags` will fallback on\n+        `__sklearn_tags__` implemented below. We keep it for backward compatibility.\n+        It is tested in `test_base_estimator_more_tags` in\n+        `sklearn/utils/testing/test_tags.py`.\"\"\"\n+        from sklearn.utils._tags import _to_old_tags, default_tags\n+\n+        warnings.warn(\n+            \"The `_more_tags` method is deprecated in 1.6 and will be removed in \"\n+            \"1.7. Please implement the `__sklearn_tags__` method.\",\n+            category=FutureWarning,\n+        )\n+        return _to_old_tags(default_tags(self))\n+\n+    # TODO(1.7): Remove this method\n+    def _get_tags(self):\n+        from sklearn.utils._tags import _to_old_tags, get_tags\n+\n+        warnings.warn(\n+            \"The `_get_tags` method is deprecated in 1.6 and will be removed in \"\n+            \"1.7. Please implement the `__sklearn_tags__` method.\",\n+            category=FutureWarning,\n+        )\n+\n+        return _to_old_tags(get_tags(self))\n+\n     def __sklearn_tags__(self):\n         return Tags(\n             estimator_type=None,\ndiff --git a/sklearn/utils/_tags.py b/sklearn/utils/_tags.py\nindex ccbc9d2438268..1ba1913c37234 100644\n--- a/sklearn/utils/_tags.py\n+++ b/sklearn/utils/_tags.py\n@@ -1,7 +1,9 @@\n from __future__ import annotations\n \n import warnings\n+from collections import OrderedDict\n from dataclasses import dataclass, field\n+from itertools import chain\n \n from .fixes import _dataclass_args\n \n@@ -290,6 +292,71 @@ def default_tags(estimator) -> Tags:\n     )\n \n \n+# TODO(1.7): Remove this function\n+def _find_tags_provider(estimator, warn=True):\n+    \"\"\"Find the tags provider for an estimator.\n+\n+    Parameters\n+    ----------\n+    estimator : estimator object\n+        The estimator to find the tags provider for.\n+\n+    warn : bool, default=True\n+        Whether to warn if the tags provider is not found.\n+\n+    Returns\n+    -------\n+    tag_provider : str\n+        The tags provider for the estimator. Can be one of:\n+        - \"_get_tags\": to use the old tags infrastructure\n+        - \"__sklearn_tags__\": to use the new tags infrastructure\n+    \"\"\"\n+    mro_model = type(estimator).mro()\n+    tags_mro = OrderedDict()\n+    for klass in mro_model:\n+        tags_provider = []\n+        if \"_more_tags\" in vars(klass):\n+            tags_provider.append(\"_more_tags\")\n+        if \"_get_tags\" in vars(klass):\n+            tags_provider.append(\"_get_tags\")\n+        if \"__sklearn_tags__\" in vars(klass):\n+            tags_provider.append(\"__sklearn_tags__\")\n+        tags_mro[klass.__name__] = tags_provider\n+\n+    all_providers = set(chain.from_iterable(tags_mro.values()))\n+    if \"__sklearn_tags__\" not in all_providers:\n+        # default on the old tags infrastructure\n+        return \"_get_tags\"\n+\n+    tag_provider = \"__sklearn_tags__\"\n+    for klass in tags_mro:\n+        has_get_or_more_tags = any(\n+            provider in tags_mro[klass] for provider in (\"_get_tags\", \"_more_tags\")\n+        )\n+        has_sklearn_tags = \"__sklearn_tags__\" in tags_mro[klass]\n+\n+        if tags_mro[klass] and tag_provider == \"__sklearn_tags__\":  # is it empty\n+            if has_get_or_more_tags and not has_sklearn_tags:\n+                # Case where a class does not implement __sklearn_tags__ and we fallback\n+                # to _get_tags. We should therefore warn for implementing\n+                # __sklearn_tags__.\n+                tag_provider = \"_get_tags\"\n+                break\n+\n+    if warn and tag_provider == \"_get_tags\":\n+        warnings.warn(\n+            f\"The {estimator.__class__.__name__} or classes from which it inherits \"\n+            \"use `_get_tags` and `_more_tags`. Please define the \"\n+            \"`__sklearn_tags__` method, or inherit from `sklearn.base.BaseEstimator` \"\n+            \"and/or other appropriate mixins such as `sklearn.base.TransformerMixin`, \"\n+            \"`sklearn.base.ClassifierMixin`, `sklearn.base.RegressorMixin`, and \"\n+            \"`sklearn.base.OutlierMixin`. From scikit-learn 1.7, not defining \"\n+            \"`__sklearn_tags__` will raise an error.\",\n+            category=FutureWarning,\n+        )\n+    return tag_provider\n+\n+\n def get_tags(estimator) -> Tags:\n     \"\"\"Get estimator tags.\n \n@@ -316,19 +383,201 @@ def get_tags(estimator) -> Tags:\n         The estimator tags.\n     \"\"\"\n \n-    if hasattr(estimator, \"__sklearn_tags__\"):\n+    tag_provider = _find_tags_provider(estimator)\n+\n+    if tag_provider == \"__sklearn_tags__\":\n         tags = estimator.__sklearn_tags__()\n     else:\n-        warnings.warn(\n-            f\"Estimator {estimator} has no __sklearn_tags__ attribute, which is \"\n-            \"defined in `sklearn.base.BaseEstimator`. This will raise an error in \"\n-            \"scikit-learn 1.8. Please define the __sklearn_tags__ method, or inherit \"\n-            \"from `sklearn.base.BaseEstimator` and other appropriate mixins such as \"\n-            \"`sklearn.base.TransformerMixin`, `sklearn.base.ClassifierMixin`, \"\n-            \"`sklearn.base.RegressorMixin`, and `sklearn.base.ClusterMixin`, and \"\n-            \"`sklearn.base.OutlierMixin`.\",\n-            category=FutureWarning,\n+        # TODO(1.7): Remove this branch of the code\n+        # Let's go through the MRO and patch each class implementing _more_tags\n+        sklearn_tags_provider = {}\n+        more_tags_provider = {}\n+        class_order = []\n+        for klass in reversed(type(estimator).mro()):\n+            if \"__sklearn_tags__\" in vars(klass):\n+                sklearn_tags_provider[klass] = klass.__sklearn_tags__(estimator)  # type: ignore[attr-defined]\n+                class_order.append(klass)\n+            elif \"_more_tags\" in vars(klass):\n+                more_tags_provider[klass] = klass._more_tags(estimator)  # type: ignore[attr-defined]\n+                class_order.append(klass)\n+\n+        # Find differences between consecutive in the case of __sklearn_tags__\n+        # inheritance\n+        sklearn_tags_diff = {}\n+        items = list(sklearn_tags_provider.items())\n+        for current_item, next_item in zip(items[:-1], items[1:]):\n+            current_name, current_tags = current_item\n+            next_name, next_tags = next_item\n+            current_tags = _to_old_tags(current_tags)\n+            next_tags = _to_old_tags(next_tags)\n+\n+            # Compare tags and store differences\n+            diff = {}\n+            for key in current_tags:\n+                if current_tags[key] != next_tags[key]:\n+                    diff[key] = next_tags[key]\n+\n+            sklearn_tags_diff[next_name] = diff\n+\n+        tags = {}\n+        for klass in class_order:\n+            if klass in sklearn_tags_diff:\n+                tags.update(sklearn_tags_diff[klass])\n+            elif klass in more_tags_provider:\n+                tags.update(more_tags_provider[klass])\n+\n+        tags = _to_new_tags(\n+            {**_to_old_tags(default_tags(estimator)), **tags}, estimator\n         )\n-        tags = default_tags(estimator)\n \n     return tags\n+\n+\n+# TODO(1.7): Remove this function\n+def _safe_tags(estimator, key=None):\n+    warnings.warn(\n+        \"The `_safe_tags` function is deprecated in 1.6 and will be removed in \"\n+        \"1.7. Use the public `get_tags` function instead and make sure to implement \"\n+        \"the `__sklearn_tags__` method.\",\n+        category=FutureWarning,\n+    )\n+    tags = _to_old_tags(get_tags(estimator))\n+\n+    if key is not None:\n+        if key not in tags:\n+            raise ValueError(\n+                f\"The key {key} is not defined for the class \"\n+                f\"{estimator.__class__.__name__}.\"\n+            )\n+        return tags[key]\n+    return tags\n+\n+\n+# TODO(1.7): Remove this function\n+def _to_new_tags(old_tags, estimator=None):\n+    \"\"\"Utility function convert old tags (dictionary) to new tags (dataclass).\"\"\"\n+    input_tags = InputTags(\n+        one_d_array=\"1darray\" in old_tags[\"X_types\"],\n+        two_d_array=\"2darray\" in old_tags[\"X_types\"],\n+        three_d_array=\"3darray\" in old_tags[\"X_types\"],\n+        sparse=\"sparse\" in old_tags[\"X_types\"],\n+        categorical=\"categorical\" in old_tags[\"X_types\"],\n+        string=\"string\" in old_tags[\"X_types\"],\n+        dict=\"dict\" in old_tags[\"X_types\"],\n+        positive_only=old_tags[\"requires_positive_X\"],\n+        allow_nan=old_tags[\"allow_nan\"],\n+        pairwise=old_tags[\"pairwise\"],\n+    )\n+    target_tags = TargetTags(\n+        required=old_tags[\"requires_y\"],\n+        one_d_labels=\"1dlabels\" in old_tags[\"X_types\"],\n+        two_d_labels=\"2dlabels\" in old_tags[\"X_types\"],\n+        positive_only=old_tags[\"requires_positive_y\"],\n+        multi_output=old_tags[\"multioutput\"] or old_tags[\"multioutput_only\"],\n+        single_output=not old_tags[\"multioutput_only\"],\n+    )\n+    if estimator is not None and (\n+        hasattr(estimator, \"transform\") or hasattr(estimator, \"fit_transform\")\n+    ):\n+        transformer_tags = TransformerTags(\n+            preserves_dtype=old_tags[\"preserves_dtype\"],\n+        )\n+    else:\n+        transformer_tags = None\n+    estimator_type = getattr(estimator, \"_estimator_type\", None)\n+    if estimator_type == \"classifier\":\n+        classifier_tags = ClassifierTags(\n+            poor_score=old_tags[\"poor_score\"],\n+            multi_class=not old_tags[\"binary_only\"],\n+            multi_label=old_tags[\"multilabel\"],\n+        )\n+    else:\n+        classifier_tags = None\n+    if estimator_type == \"regressor\":\n+        regressor_tags = RegressorTags(\n+            poor_score=old_tags[\"poor_score\"],\n+            multi_label=old_tags[\"multilabel\"],\n+        )\n+    else:\n+        regressor_tags = None\n+    return Tags(\n+        estimator_type=estimator_type,\n+        target_tags=target_tags,\n+        transformer_tags=transformer_tags,\n+        classifier_tags=classifier_tags,\n+        regressor_tags=regressor_tags,\n+        input_tags=input_tags,\n+        array_api_support=old_tags[\"array_api_support\"],\n+        no_validation=old_tags[\"no_validation\"],\n+        non_deterministic=old_tags[\"non_deterministic\"],\n+        requires_fit=old_tags[\"requires_fit\"],\n+        _skip_test=old_tags[\"_skip_test\"],\n+    )\n+\n+\n+# TODO(1.7): Remove this function\n+def _to_old_tags(new_tags):\n+    \"\"\"Utility function convert old tags (dictionary) to new tags (dataclass).\"\"\"\n+    if new_tags.classifier_tags:\n+        binary_only = not new_tags.classifier_tags.multi_class\n+        multilabel_clf = new_tags.classifier_tags.multi_label\n+        poor_score_clf = new_tags.classifier_tags.poor_score\n+    else:\n+        binary_only = False\n+        multilabel_clf = False\n+        poor_score_clf = False\n+\n+    if new_tags.regressor_tags:\n+        multilabel_reg = new_tags.regressor_tags.multi_label\n+        poor_score_reg = new_tags.regressor_tags.poor_score\n+    else:\n+        multilabel_reg = False\n+        poor_score_reg = False\n+\n+    if new_tags.transformer_tags:\n+        preserves_dtype = new_tags.transformer_tags.preserves_dtype\n+    else:\n+        preserves_dtype = [\"float64\"]\n+\n+    tags = {\n+        \"allow_nan\": new_tags.input_tags.allow_nan,\n+        \"array_api_support\": new_tags.array_api_support,\n+        \"binary_only\": binary_only,\n+        \"multilabel\": multilabel_clf or multilabel_reg,\n+        \"multioutput\": new_tags.target_tags.multi_output,\n+        \"multioutput_only\": (\n+            not new_tags.target_tags.single_output and new_tags.target_tags.multi_output\n+        ),\n+        \"no_validation\": new_tags.no_validation,\n+        \"non_deterministic\": new_tags.non_deterministic,\n+        \"pairwise\": new_tags.input_tags.pairwise,\n+        \"preserves_dtype\": preserves_dtype,\n+        \"poor_score\": poor_score_clf or poor_score_reg,\n+        \"requires_fit\": new_tags.requires_fit,\n+        \"requires_positive_X\": new_tags.input_tags.positive_only,\n+        \"requires_y\": new_tags.target_tags.required,\n+        \"requires_positive_y\": new_tags.target_tags.positive_only,\n+        \"_skip_test\": new_tags._skip_test,\n+        \"stateless\": new_tags.requires_fit,\n+    }\n+    X_types = []\n+    if new_tags.input_tags.one_d_array:\n+        X_types.append(\"1darray\")\n+    if new_tags.input_tags.two_d_array:\n+        X_types.append(\"2darray\")\n+    if new_tags.input_tags.three_d_array:\n+        X_types.append(\"3darray\")\n+    if new_tags.input_tags.sparse:\n+        X_types.append(\"sparse\")\n+    if new_tags.input_tags.categorical:\n+        X_types.append(\"categorical\")\n+    if new_tags.input_tags.string:\n+        X_types.append(\"string\")\n+    if new_tags.input_tags.dict:\n+        X_types.append(\"dict\")\n+    if new_tags.target_tags.one_d_labels:\n+        X_types.append(\"1dlabels\")\n+    if new_tags.target_tags.two_d_labels:\n+        X_types.append(\"2dlabels\")\n+    tags[\"X_types\"] = X_types\n+    return tags\n"}, "usage": {"cost($)": "0", "prompt_tokens": 72379, "completion_tokens": 624}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'scikit-learn' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described execution flow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described execution flow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Clarify the Purpose of the Issue\n    - If expanding capabilities: Identify where and how are the new behavior, fields, or modules incorporated.\n- Reconstruct the execution flow\n    - Identify main entry points triggering the feature described in the issue.\n    - Trace function calls, class interactions, and sequences of events.\n    - Identify potential relevant points in the code workflow of the codebase.\n    - Use the unique artifacts provided to you to complement your understanding of the execution flow, or use as a hint.\n    Important: Keep the reconstructed flow focused on the problem, avoiding irrelevant details.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: MAINT conversion old->new/new->old tags\n\nTowards #30298 \r\n\r\nThis PR provides a way to convert old tags into new tags and new tags into old tags.\r\nWe should make sure that:\r\n\r\n- An estimator implementing `_get_tags` or `_more_tags` get a warning but that the check_estimator should be working reasonably\r\n- `_safe_tags` should raise a deprecation warning\r\n- we should make sure that `get_tags` can get old tags and convert it to new tags. The tricky part is to detect whether `__sklearn_tags__` if present is implemented by the `BaseEstimator` from scikit-learn or the child class. If this is only the `BaseEstimator`, we should raise a warning to move to the new API and we should temporary use the `_get_tags`/`_safe_tags`, otherwise we are fine.\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n"}, {"content": "I'll help analyze this issue systematically following the given steps.\n\n## Step 1: Let's first explore the repository structure to understand where the relevant code might be located.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['/']</parameter>\n<parameter=traversal_depth>2</parameter>\n<parameter=dependency_type_filter>['contains']</parameter>\n<parameter=entity_type_filter>['file', 'directory']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\n/\n\u251c\u2500\u2500 contains \u2500\u2500 .spin\n\u2502               \u2514\u2500\u2500 contains \u2500\u2500 .spin/cmds.py\n\u251c\u2500\u2500 contains \u2500\u2500 asv_benchmarks\n\u2502               \u2514\u2500\u2500 conta