ion: Union[str, int] = 'active',\n668 |     data_id: Optional[int] = None,\n669 |     data_home: Optional[str] = None,\n670 |     target_column: Optional[Union[str, List]] = 'default-target',\n671 |     cache: bool = True,\n672 |     return_X_y: bool = False,\n673 |     as_frame: bool = False\n674 | ):\n675 |     \"\"\"Fetch dataset from openml by name or dataset id.\n676 | \n677 |     Datasets are uniquely identified by either an integer ID or by a\n678 |     combination of name and version (i.e. there might be multiple\n679 |     versions of the 'iris' dataset). Please give either name or data_id\n680 |     (not both). In case a name is given, a version can also be\n681 |     provided.\n682 | \n683 |     Read more in the :ref:`User Guide <openml>`.\n684 | \n685 |     .. versionadded:: 0.20\n686 | \n687 |     .. note:: EXPERIMENTAL\n688 | \n689 |         The API is experimental (particularly the return value structure),\n690 |         and might have small backward-incompatible changes in future releases.\n691 | \n692 |     Parameters\n693 |     ----------\n694 |     name : str, default=None\n695 |         String identifier of the dataset. Note that OpenML can have multiple\n696 |         datasets with the same name.\n697 | \n698 |     version : int or 'active', default='active'\n699 |         Version of the dataset. Can only be provided if also ``name`` is given.\n700 |         If 'active' the oldest version that's still active is used. Since\n701 |         there may be more than one active version of a dataset, and those\n702 |         versions may fundamentally be different from one another, setting an\n703 |         exact version is highly recommended.\n704 | \n705 |     data_id : int, default=None\n706 |         OpenML ID of the dataset. The most specific way of retrieving a\n707 |         dataset. If data_id is not given, name (and potential version) are\n708 |         used to obtain a dataset.\n709 | \n710 |     data_home : str, default=None\n711 |         Specify another download and cache folder for the data sets. By default\n712 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n713 | \n714 |     target_column : str, list or None, default='default-target'\n715 |         Specify the column name in the data to use as target. If\n716 |         'default-target', the standard target column a stored on the server\n717 |         is used. If ``None``, all columns are returned as data and the\n718 |         target is ``None``. If list (of strings), all columns with these names\n719 |         are returned as multi-target (Note: not all scikit-learn classifiers\n720 |         can handle all types of multi-output combinations)\n721 | \n722 |     cache : bool, default=True\n723 |         Whether to cache downloaded datasets using joblib.\n724 | \n725 |     return_X_y : bool, default=False\n726 |         If True, returns ``(data, target)`` instead of a Bunch object. See\n727 |         below for more information about the `data` and `target` objects.\n728 | \n729 |     as_frame : bool or 'auto', default=False\n730 |         If True, the data is a pandas DataFrame including columns with\n731 |         appropriate dtypes (numeric, string or categorical). The target is\n732 |         a pandas DataFrame or Series depending on the number of target_columns.\n733 |         The Bunch will contain a ``frame`` attribute with the target and the\n734 |         data. If ``return_X_y`` is True, then ``(data, target)`` will be pandas\n735 |         DataFrames or Series as describe above.\n736 |         If as_frame is 'auto', the data and target will be converted to\n737 |         DataFrame or Series as if as_frame is set to True, unless the dataset\n738 |         is stored in sparse format.\n739 | \n740 |     Returns\n741 |     -------\n742 | \n743 |     data : :class:`~sklearn.utils.Bunch`\n744 |         Dictionary-like object, with the following attributes.\n745 | \n746 |         data : np.array, scipy.sparse.csr_matrix of floats, or pandas DataFrame\n747 |             The feature matrix. Categorical features are encoded as ordinals.\n748 |         target : np.array, pandas Series or DataFrame\n749 |             The regression target or classification labels, if applicable.\n750 |             Dtype is float if numeric, and object if categorical. If\n751 |             ``as_frame`` is True, ``target`` is a pandas object.\n752 |         DESCR : str\n753 |             The full description of the dataset\n754 |         feature_names : list\n755 |             The names of the dataset columns\n756 |         target_names: list\n757 |             The names of the target columns\n758 | \n759 |         .. versionadded:: 0.22\n760 | \n761 |         categories : dict or None\n762 |             Maps each categorical feature name to a list of values, such\n763 |             that the value encoded as i is ith in the list. If ``as_frame``\n764 |             is True, this is None.\n765 |         details : dict\n766 |             More metadata from OpenML\n767 |         frame : pandas DataFrame\n768 |             Only present when `as_frame=True`. DataFrame with ``data`` and\n769 |             ``target``.\n770 | \n771 |     (data, target) : tuple if ``return_X_y`` is True\n772 | \n773 |         .. note:: EXPERIMENTAL\n774 | \n775 |             This interface is **experimental** and subsequent releases may\n776 |             change attributes without notice (although there should only be\n777 |             minor changes to ``data`` and ``target``).\n778 | \n779 |         Missing values in the 'data' are represented as NaN's. Missing values\n780 |         in 'target' are represented as NaN's (numerical target) or None\n781 |         (categorical target)\n782 |     \"\"\"\n783 |     data_home = get_data_home(data_home=data_home)\n784 |     data_home = join(data_home, 'openml')\n785 |     if cache is False:\n786 |         # no caching will be applied\n787 |         data_home = None\n788 | \n789 |     # check valid function arguments. data_id XOR (name, version) should be\n790 |     # provided\n791 |     if name is not None:\n792 |         # OpenML is case-insensitive, but the caching mechanism is not\n793 |         # convert all data names (str) to lower case\n794 |         name = name.lower()\n795 |         if data_id is not None:\n796 |             raise ValueError(\n797 |                 \"Dataset data_id={} and name={} passed, but you can only \"\n798 |                 \"specify a numeric data_id or a name, not \"\n799 |                 \"both.\".format(data_id, name))\n800 |         data_info = _get_data_info_by_name(name, version, data_home)\n801 |         data_id = data_info['did']\n802 |     elif data_id is not None:\n803 |         # from the previous if statement, it is given that name is None\n804 |         if version != \"active\":\n805 |             raise ValueError(\n806 |                 \"Dataset data_id={} and version={} passed, but you can only \"\n807 |                 \"specify a numeric data_id or a version, not \"\n808 |                 \"both.\".format(data_id, name))\n809 |     else:\n810 |         raise ValueError(\n811 |             \"Neither name nor data_id are provided. Please provide name or \"\n812 |             \"data_id.\")\n813 | \n814 |     data_description = _get_data_description_by_id(data_id, data_home)\n815 |     if data_description['status'] != \"active\":\n816 |         warn(\"Version {} of dataset {} is inactive, meaning that issues have \"\n817 |              \"been found in the dataset. Try using a newer version from \"\n818 |              \"this URL: {}\".format(\n819 |                 data_description['version'],\n820 |                 data_description['name'],\n821 |                 data_description['url']))\n822 |     if 'error' in data_description:\n823 |         warn(\"OpenML registered a problem with the dataset. It might be \"\n824 |              \"unusable. Error: {}\".format(data_description['error']))\n825 |     if 'warning' in data_description:\n826 |         warn(\"OpenML raised a warning on the dataset. It might be \"\n827 |              \"unusable. Warning: {}\".format(data_description['warning']))\n828 | \n829 |     return_sparse = False\n830 |     if data_description['format'].lower() == 'sparse_arff':\n831 |         return_sparse = True\n832 | \n833 |     if as_frame == 'auto':\n834 |         as_frame = not return_sparse\n835 | \n836 |     if as_frame and return_sparse:\n837 |         raise ValueError('Cannot return dataframe with sparse data')\n838 | \n839 |     # download data features, meta-info about column types\n840 |     features_list = _get_data_features(data_id, data_home)\n841 | \n842 |     if not as_frame:\n843 |         for feature in features_list:\n844 |             if 'true' in (feature['is_ignore'], feature['is_row_identifier']):\n845 |                 continue\n846 |             if feature['data_type'] == 'string':\n847 |                 raise ValueError('STRING attributes are not supported for '\n848 |                                  'array representation. Try as_frame=True')\n849 | \n850 |     if target_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |        