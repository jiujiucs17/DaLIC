mport check_random_state\n 25 | from ..utils import shuffle as shuffle_method\n 26 | from ..utils.validation import _deprecate_positional_args\n 27 | \n 28 | \n 29 | # The original data can be found at:\n 30 | # https://archive.ics.uci.edu/ml/machine-learning-databases/kddcup99-mld/kddcup.data.gz\n 31 | ARCHIVE = RemoteFileMetadata(\n 32 |     filename='kddcup99_data',\n 33 |     url='https://ndownloader.figshare.com/files/5976045',\n 34 |     checksum=('3b6c942aa0356c0ca35b7b595a26c89d'\n 35 |               '343652c9db428893e7494f837b274292'))\n 36 | \n 37 | # The original data can be found at:\n 38 | # https://archive.ics.uci.edu/ml/machine-learning-databases/kddcup99-mld/kddcup.data_10_percent.gz\n 39 | ARCHIVE_10_PERCENT = RemoteFileMetadata(\n 40 |     filename='kddcup99_10_data',\n 41 |     url='https://ndownloader.figshare.com/files/5976042',\n 42 |     checksum=('8045aca0d84e70e622d1148d7df78249'\n 43 |               '6f6333bf6eb979a1b0837c42a9fd9561'))\n 44 | \n 45 | logger = logging.getLogger(__name__)\n```\n\nFound code snippet in file `sklearn/datasets/_lfw.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Labeled Faces in the Wild (LFW) dataset\n  2 | \n  3 | This dataset is a collection of JPEG pictures of famous people collected\n  4 | over the internet, all details are available on the official website:\n  5 | \n  6 |     http://vis-www.cs.umass.edu/lfw/\n  7 | \"\"\"\n  8 | # Copyright (c) 2011 Olivier Grisel <olivier.grisel@ensta.org>\n  9 | # License: BSD 3 clause\n 10 | \n 11 | from os import listdir, makedirs, remove\n 12 | from os.path import dirname, join, exists, isdir\n 13 | \n 14 | import logging\n 15 | \n 16 | import numpy as np\n 17 | import joblib\n 18 | from joblib import Memory\n 19 | \n 20 | from ._base import get_data_home, _fetch_remote, RemoteFileMetadata\n 21 | from ..utils import Bunch\n 22 | from ..utils.validation import _deprecate_positional_args\n 23 | from ..utils.fixes import parse_version\