if  ``s`` is a key in ``data``.\n2743 | \n2744 |         **kwargs : `.Rectangle` properties\n2745 | \n2746 |         %(Rectangle:kwdoc)s\n2747 | \n2748 |         See Also\n2749 |         --------\n2750 |         bar : Plot a vertical bar plot.\n2751 | \n2752 |         Notes\n2753 |         -----\n2754 |         Stacked bars can be achieved by passing individual *left* values per\n2755 |         bar. See\n2756 |         :doc:`/gallery/lines_bars_and_markers/horizontal_barchart_distribution`.\n2757 |         \"\"\"\n2758 |         kwargs.setdefault('orientation', 'horizontal')\n2759 |         patches = self.bar(x=left, height=height, width=width, bottom=y,\n2760 |                            align=align, data=data, **kwargs)\n2761 |         return patches\n```\n\nFound function `lib/matplotlib/pyplot.py:bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2969 | def bar(\n2970 |     x: float | ArrayLike,\n2971 |     height: float | ArrayLike,\n2972 |     width: float | ArrayLike = 0.8,\n2973 |     bottom: float | ArrayLike | None = None,\n2974 |     *,\n2975 |     align: Literal[\"center\", \"edge\"] = \"center\",\n2976 |     data=None,\n2977 |     **kwargs,\n2978 | ) -> BarContainer:\n2979 |     return gca().bar(\n2980 |         x,\n2981 |         height,\n2982 |         width=width,\n2983 |         bottom=bottom,\n2984 |         align=align,\n2985 |         **({\"data\": data} if data is not None else {}),\n2986 |         **kwargs,\n2987 |     )\n```\n\nFound class `lib/matplotlib/patches.py:ConnectionStyle.Bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3083 | class Bar(_Base):\n3084 |         \"\"\"\n3085 |         A line with *angle* between A and B with *armA* and *armB*. One of the\n3086 |         arms is extended so that they are connected in a right angle. The\n3087 |         length of *armA* is determined by (*armA* + *fraction* x AB distance).\n3088 |         Same for *armB*.\n3089 |         \"\"\"\n3090 | \n3091 |         def __init__(self, armA=0., armB=0., fraction=0.3, angle=None):\n3092 |             \"\"\"\n3093 |             Parameters\n3094 |             ----------\n3095 |             armA : float\n3096 |                 Minimum length of armA.\n3097 | \n3098 |             armB : float\n3099 |                 Minimum length of armB.\n3100 | \n3101 |             fraction : float\n3102 |                 A fraction of the distance between two points that will be\n3103 |                 added to armA and armB.\n3104 | \n3105 |             angle : float or None\n3106 |                 Angle of the connecting line (if None, parallel to A and B).\n3107 |             \"\"\"\n3108 |             self.armA = armA\n3109 |             self.armB = armB\n3110 |             self.fraction = fraction\n3111 |             self.angle = angle\n3112 | \n3113 |         def connect(self, posA, posB):\n3114 |             x1, y1 = posA\n3115 |             x20, y20 = x2, y2 = posB\n3116 | \n3117 |             theta1 = math.atan2(y2 - y1, x2 - x1)\n3118 |             dx, dy = x2 - x1, y2 - y1\n3119 |             dd = (dx * dx + dy * dy) ** .5\n3120 |             ddx, ddy = dx / dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be horizontal.\n65 | \n66 |     \"\"\"\n67 | \n68 |     def __init__(self, patches, errorbar=None, *, datavalues=None,\n69 |                  orientation=None, **kwargs):\n70 |         self.patches = patches\n71 |         self.errorbar = errorbar\n72 |         self.datavalues = datavalues\n73 |         self.orientation = orientation\n74 |         super().__init__(patches, **kwargs)\n```\n\n\n\n##Searching for term \"def bar(\"...