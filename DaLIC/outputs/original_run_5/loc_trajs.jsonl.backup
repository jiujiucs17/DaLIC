or(\n309 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n310 |         )\n311 |         minlocator = TimeSeries_DateLocator(\n312 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n313 |         )\n314 |         subplot.xaxis.set_major_locator(majlocator)\n315 |         subplot.xaxis.set_minor_locator(minlocator)\n316 | \n317 |         majformatter = TimeSeries_DateFormatter(\n318 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n319 |         )\n320 |         minformatter = TimeSeries_DateFormatter(\n321 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n322 |         )\n323 |         subplot.xaxis.set_major_formatter(majformatter)\n324 |         subplot.xaxis.set_minor_formatter(minformatter)\n325 | \n326 |         # x and y coord info\n327 |         subplot.format_coord = functools.partial(_format_coord, freq)\n328 | \n329 |     elif isinstance(index, ABCTimedeltaIndex):\n330 |         subplot.xaxis.set_major_formatter(TimeSeries_TimedeltaFormatter())\n331 |     else:\n332 |         raise TypeError(\"index type not supported\")\n333 | \n334 |     pylab.draw_if_interactive()\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \