n.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n593 | def fit(self, X, y=None):\n594 |         \"\"\"Learn model for the data X with variational Bayes method.\n595 | \n596 |         When `learning_method` is 'online', use mini-batch update.\n597 |         Otherwise, use batch update.\n598 | \n599 |         Parameters\n600 |         ----------\n601 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n602 |             Document word matrix.\n603 | \n604 |         y : Ignored\n605 |             Not used, present here for API consistency by convention.\n606 | \n607 |         Returns\n608 |         -------\n609 |         self\n610 |             Fitted estimator.\n611 |         \"\"\"\n612 |         self._check_params()\n613 |         X = self._check_non_neg_array(\n614 |             X, reset_n_features=True, whom=\"LatentDirichletAllocation.fit\"\n615 |         )\n616 |         n_samples, n_features = X.shape\n617 |         max_iter = self.max_iter\n618 |         evaluate_every = self.evaluate_every\n619 |         learning_method = self.learning_method\n620 | \n621 |         batch_size = self.batch_size\n622 | \n623 |         # initialize parameters\n624 |         self._init_latent_vars(n_features)\n625 |         # change to perplexity later\n626 |         last_bound = None\n627 |         n_jobs = effective_n_jobs(self.n_jobs)\n628 |         with Parallel(n_jobs=n_jobs, verbose=max(0, self.verbose - 1)) as parallel:\n629 |             for i in range(max_iter):\n630 |                 if learning_method == \"online\":\n631 |                     for idx_slice in gen_batches(n_samples, batch_size):\n632 |                         self._em_step(\n633 |                             X[idx_slice, :],\n634 |                             total_samples=n_samples,\n635 |                             batch_update=False,\n636 |                             parallel=parallel,\n637 |                         )\n638 |                 else:\n639 |                     # batch update\n640 |                     self._em_step(\n641 |                         X, total_samples=n_samples, batch_update=True, parallel=parallel\n642 |                     )\n643 | \n644 |                 # check perplexity\n645 |                 if evaluate_every > 0 and (i + 1) % evaluate_every == 0:\n646 |                     doc_topics_distr, _ = self._e_step(\n647 |                         X, cal_sstats=False, random_init=False, parallel=parallel\n648 |                     )\n649 |                     bound = self._perplexity_precomp_distr(\n650 |                         X, doc_topics_distr, sub_sampling=False\n651 |                     )\n652 |                     if self.verbose:\n653 |                         print(\n654 |                             \"iteration: %d of max_iter: %d, perplexity: %.4f\"\n655 |                             % (i + 1, max_iter, bound)\n656 |                         )\n657 | \n658 |                     if last_bound and abs(last_bound - bound) < self.perp_tol:\n659 |                         break\n660 |                     last_bound = bound\n661 | \n662 |                 elif self.verbose:\n663 |                     print(\"iteration: %d of max_iter: %d\" % (i + 1, max_iter))\n664 |                 self.n_iter_ += 1\n665 | \n666 |         # calculate final perplexity value on train set\n667 |         doc_topics_distr, _ = self._e_step(\n668 |             X, cal_sstats=False, random_init=False, parallel=parallel\n669 |         )\n670 |         self.bound_ = self._perplexity_precomp_distr(\n671 |             X, doc_topics_distr, sub_sampling=False\n672 |         )\n673 | \n674 |         return self\n```\n\n\n\n##Searching for term \"kullback-leibler\"...\n### Search Result:\nFound function `sklearn/base.py:clone`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 32 | def clone(estimator, *, safe=True):\n 33 |     \"\"\"Construct a new unfitted estimator with the same parameters.\n 34 | \n 35 |     Clone does a deep copy of the model in an estimator\n 36 |     without actually copying attached data. It returns a new estimator\n 37 |     with the same parameters that has not been fitted on any data.\n 38 | \n 39 |     Parameters\n 40 |     ----------\n 41 |     estimator : {list, tuple, set} of estimator instance or a single \\\n 42 |             estimator instance\n 43 |         The estimator or group of estimators to be cloned.\n 44 |     safe : bool, default=True\n 45 |         If safe is False, clone will fall back to a deep copy on objects\n 46 |         that are not estimators.\n 47 | \n 48 |     Returns\n 49 |     -------\n 50 |     estimator : object\n 51 |         The deep copy of the input, an estimator if input is an estimator.\n 52 | \n 53 |     Notes\n 54 |     -----\n 55 |     If the estimator's `random_state` parameter is an integer (or if the\n 56 |     estimator doesn't have a `random_state` parameter), an *exact clone* is\n 57 |     returned: the clone and the original estimator will give the exact same\n 58 |     results. Otherwise, *statistical clone* is returned: the clone might\n 59 |     return different results from the original estimator. More details can be\n 60 |     found in :ref:`randomness`.\n 61 |     \"\"\"\n 62 |     estimator_type = type(estimator)\n 63 |     # XXX: not handling dictionaries\n 64 |     if estimator_type in (list, tuple, set, frozenset):\n 65 |         return estimator_type([clone(e, safe=safe) for e in estimator])\n 66 |     elif not hasattr(estimator, \"get_params\") or isinstance(estimator, type):\n 67 |         if not safe:\n 68 |             return copy.deepcopy(estimator)\n 69 |         else:\n 70 |             if isinstance(estimator, type):\n 71 |                 raise TypeError(\n 72 |                     \"Cannot clone object. \"\n 73 |                     + \"You should provide an instance of \"\n 74 |                     + \"scikit-learn estimator instead of a class.\"\n 75 |                 )\n 76 |             else:\n 77 |                 raise TypeError(\n 78 |                     \"Cannot clone object '%s' (type %s): \"\n 79 |                     \"it does not seem to be a scikit-learn \"\n 80 |                     \"estimator as it does not implement a \"\n 81 |                     \"'get_params' method.\" % (repr(estimator), type(estimator))\n 82 |                 )\n 83 | \n 84 |     klass = estimator.__class__\n 85 |     new_object_params = estimator.get_params(deep=False)\n 86 |     for name, param in new_object_params.items():\n 87 |         new_object_params[name] = clone(param, safe=False)\n 88 |     new_object = klass(**new_object_params)\n 89 |     params_set = new_object.get_params(deep=False)\n 90 | \n 91 |     # quick sanity check of the parameters of the clone\n 92 |     for name in new_object_params:\n 93 |         param1 = new_object_params[name]\n 94 |         param2 = params_set[name]\n 95 |         if param1 is not param2:\n 96 |             raise RuntimeError(\n 97 |                 \"Cannot clone object %s, as the constructor \"\n 98 |                 \"either does not set or modifies parameter %s\" % (estimator, name)\n 99 |             )\n100 |     return new_object\n```\n\nFound function `sklearn/decomposition/_nmf.py:_beta_loss_to_float`.\nSource: Retrieved code content using keyword search (bm25).\n```\n218 | def _beta_loss_to_float(beta_loss):\n219 |     \"\"\"Convert string beta_loss to float.\"\"\"\n220 |     allowed_beta_loss = {\"frobenius\": 2, \"kullback-leibler\": 1, \"itakura-saito\": 0}\n221 |     if isinstance(beta_loss, str) and beta_loss in allowed_beta_loss:\n222 |         beta_loss = allowed_beta_loss[beta_loss]\n223 | \n224 |     if not isinstance(beta_loss, numbers.Number):\n225 |         raise ValueError(\n226 |             \"Invalid beta_loss parameter: got %r instead of one of %r, or a float.\"\n227 |             % (beta_loss, allowed_beta_loss.keys())\n228 |         )\n229 |     return beta_loss\n```\n