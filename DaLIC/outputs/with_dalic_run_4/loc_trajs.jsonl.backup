`cquantiles``: A `~.collections.LineCollection` instance created\n8670 |               to identify the quantiles values of each of the violin's\n8671 |               distribution.\n8672 | \n8673 |         See Also\n8674 |         --------\n8675 |         violinplot :\n8676 |             Draw a violin plot from data instead of pre-computed statistics.\n8677 |         \"\"\"\n8678 | \n8679 |         # Statistical quantities to be plotted on the violins\n8680 |         means = []\n8681 |         mins = []\n8682 |         maxes = []\n8683 |         medians = []\n8684 |         quantiles = []\n8685 | \n8686 |         qlens = []  # Number of quantiles in each dataset.\n8687 | \n8688 |         artists = {}  # Collections to be returned\n8689 | \n8690 |         N = len(vpstats)\n8691 |         datashape_message = (\"List of violinplot statistics and `{0}` \"\n8692 |                              \"values must have the same length\")\n8693 | \n8694 |         # vert and orientation parameters are linked until vert's\n8695 |         # deprecation period expires. If both are selected,\n8696 |         # vert takes precedence.\n8697 |         if vert is not None:\n8698 |             _api.warn_deprecated(\n8699 |                 \"3.11\",\n8700 |                 name=\"vert: bool\",\n8701 |                 alternative=\"orientation: {'vertical', 'horizontal'}\",\n8702 |             )\n8703 |             orientation = 'vertical' if vert else 'horizontal'\n8704 |         _api.check_in_list(['horizontal', 'vertical'], orientation=orientation)\n8705 | \n8706 |         # Validate positions\n8707 |         if positions is None:\n8708 |             positions = range(1, N + 1)\n8709 |         elif len(positions) != N:\n8710 |             raise ValueError(datashape_message.format(\"positions\"))\n8711 | \n8712 |         # Validate widths\n8713 |         if np.isscalar(widths):\n8714 |             widths = [widths] * N\n8715 |         elif len(widths) != N:\n8716 |             raise ValueError(datashape_message.format(\"widths\"))\n8717 | \n8718 |         # Validate side\n8719 |         _api.check_in_list([\"both\", \"low\", \"high\"], side=side)\n8720 | \n8721 |         # Calculate ranges for statistics lines (shape (2, N)).\n8722 |         line_ends = [[-0.25 if side in ['both', 'low'] else 0],\n8723 |                      [0.25 if side in ['both', 'high'] else 0]] \\\n8724 |                           * np.array(widths) + positions\n8725 | \n8726 |         # Colors.\n8727 |         if mpl.rcParams['_internal.classic_mode']:\n8728 |             fillcolor = 'y'\n8729 |             linecolor = 'r'\n8730 |         else:\n8731 |             fillcolor = linecolor = self._get_lines.get_next_color()\n8732 | \n8733 |         # Check whether we are rendering vertically or horizontally\n8734 |         if orientation == 'vertical':\n8735 |             fill = self.fill_betweenx\n8736 |             if side in ['low', 'high']:\n8737 |                 perp_lines = functools.partial(self.hlines, colors=linecolor,\n8738 |                                                 capstyle='projecting')\n8739 |                 par_lines = functools.partial(self.vlines, colors=linecolor,\n8740 |                                                 capstyle='projecting')\n8741 |             else:\n8742 |                 perp_lines = functools.partial(self.hlines, colors=linecolor)\n8743 |                 par_lines = functools.partial(self.vlines, colors=linecolor)\n8744 |         else:\n8745 |             fill = self.fill_between\n8746 |             if side in ['low', 'high']:\n8747 |                 perp_lines = functools.partial(self.vlines, colors=linecolor,\n8748 |                                                 capstyle='projecting')\n8749 |                 par_lines = functools.partial(self.hlines, colors=linecolor,\n8750 |                                                 capstyle='projecting')\n8751 |             else:\n8752 |                 perp_lines = functools.partial(self.vl