v_bench/benchmarks/io/excel.py:WriteExcelStyled.time_write_excel_style\n\u2502                 \u2514\u2500\u2500 invokes-by \u2500\u2500 asv_bench/benchmarks/io/excel.py:ReadExcel.setup_cache\n\u2514\u2500\u2500 invokes-by \u2500\u2500 pandas/io/formats/style.py:Styler.to_excel\n"}, {"content": "Let me look at the actual implementation of the ExcelFormatter to see how merge_cells is handled:\n\n<function=get_entity_contents>\n<parameter=entity_names>['pandas/io/formats/excel.py:ExcelFormatter']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/io/formats/excel.py:ExcelFormatter`...\n### Search Result:\nFound class `pandas/io/formats/excel.py:ExcelFormatter`.\nSource: Exact match found for entity name `pandas/io/formats/excel.py:ExcelFormatter`.\n```\n506 | class ExcelFormatter:\n507 |     \"\"\"\n508 |     Class for formatting a DataFrame to a list of ExcelCells,\n509 | \n510 |     Parameters\n511 |     ----------\n512 |     df : DataFrame or Styler\n513 |     na_rep: na representation\n514 |     float_format : str, default None\n515 |         Format string for floating point numbers\n516 |     cols : sequence, optional\n517 |         Columns to write\n518 |     header : bool or sequence of str, default True\n519 |         Write out column names. If a list of string is given it is\n520 |         assumed to be aliases for the column names\n521 |     index : bool, default True\n522 |         output row names (index)\n523 |     index_label : str or sequence, default None\n524 |         Column label for index column(s) if desired. If None is given, and\n525 |         `header` and `index` are True, then the index names are used. A\n526 |         sequence should be given if the DataFrame uses MultiIndex.\n527 |     merge_cells : bool or 'columns', default False\n528 |         Format MultiIndex column headers and Hierarchical Rows as merged cells\n529 |         if True. Merge MultiIndex column headers only if 'columns'.\n530 |         .. versionchanged:: 3.0.0\n531 |             Added the 'columns' option.\n532 |     inf_rep : str, default `'inf'`\n533 |         representation for np.inf values (which aren't representable in Excel)\n534 |         A `'-'` sign will be added in front of -inf.\n535 |     style_converter : callable, optional\n536 |         This translates Styler styles (CSS) into ExcelWriter styles.\n537 |         Defaults to ``CSSToExcelConverter()``.\n538 |         It should have signature css_declarations string -> excel style.\n539 |         This is only called for body cells.\n540 |     \"\"\"\n541 | \n542 |     max_rows = 2**20\n543 |     max_cols = 2**14\n544 | \n545 |     def __init__(\n546 |         self,\n547 |         df,\n548 |         na_rep: str = \"\",\n549 |         float_format: str | None = None,\n550 |         cols: Sequence[Hashable] | None = None,\n551 |         header: Sequence[Hashable] | bool = True,\n552 |         index: bool = True,\n553 |         index_label: IndexLabel | None = None,\n554 |         merge_cells: ExcelWriterMergeCells = False,\n555 |         inf_rep: str = \"inf\",\n556 |         style_converter: Callable | None = None,\n557 |     ) -> None:\n558 |         self.rowcounter = 0\n559 |         self.na_rep = na_rep\n560 |         if not isinstance(df, DataFrame):\n561 |             self.styler = df\n562 |             self.styler._compute()  # calculate applied styles\n563 |             df = df.data\n564 |             if style_converter is None:\n565 |                 style_converter = CSSToExcelConverter()\n566 |             self.style_converter: Callable | None = style_converter\n567 |         else:\n568 |             self.styler = None\n569 |             self.style_converter = None\n570 |         self.df = df\n571 |         if cols is not None:\n572 |             # all missing, raise\n573 |             if not len(Index(cols).intersection(df.columns)):\n574 |                 raise KeyError(\"passes columns are not ALL present dataframe\")\n575 | \n576 |             if len(Index(cols).intersection(df.columns)) != len(set(cols)):\n577 |                 # Deprecated in GH#17295, enforced in 1.0.0\n578 |                 raise KeyError(\"Not all names specified in 'columns' are found\")\n579 | \n580 |             self.df = df.reindex(columns=cols)\n581 | \n582 |         self.columns = self.df.columns\n583 |         self.float_format = float_format\n584 |         self.index = index\n585 |         self.index_label = index_label\n586 |         self.header = header\n587 | \n588 |         if not isinstance(merge_cells, bool) and merge_cells != \"columns\":\n589 |             raise ValueError(f\"Unexpected value for {merge_cells=}.\")\n590 |         self.merge_cells = merge_cells\n591 |         self.inf_rep = inf_rep\n592 | \n593 |     def _format_value(self, val):\n594 |         if is_scalar(val) and missing.isna(val):\n595 |             val = self.na_rep\n596 |         elif is_float(val):\n597 |             if missing.isposinf_scalar(val):\n598 |                 val = self.inf_rep\n599 |             elif missing.isneginf_scalar(val):\n600 |                 val = f\"-{self.inf_rep}\"\n601 |             elif self.float_format is not None:\n602 |                 val = float(self.float_format % val)\n603 |         if getattr(val, \"tzinfo\", None) is not None:\n604 |             raise ValueError(\n605 |                 \"Excel does not support datetimes with \"\n606 |                 \"timezones. Please ensure that datetimes \"\n607 |                 \"are timezone unaware before writing to Excel.\"\n608 |             )\n609 |         return val\n610 | \n611 |     def _format_header_mi(self) -> Iterable[ExcelCell]:\n612 |         if self.columns.nlevels > 1:\n613 |             if not self.index:\n614 |                 raise NotImplementedError(\n615 |                     \"Writing to Excel with MultiIndex columns and no \"\n616 |                     \"index ('index'=False) is not yet implemented.\"\n617 |                 )\n618 | \n619 |         if not (self._has_aliases or self.header):\n620 |             return\n621 | \n622 |         columns = self.columns\n623 |         level_strs = columns._format_multi(\n624 |             sparsify=self.merge_cells in {True, \"columns\"}, include_names=False\n625 |         )\n626 |         level_lengths = get_level_lengths(level_strs)\n627 |         coloffset = 0\n628 |         lnum = 0\n629 | \n630 |         if self.index and isinstance(self.df.index, MultiIndex):\n631 |             coloffset = self.df.index.nlevels - 1\n632 | \n633 |         if self.merge_cells in {True, \"columns\"}:\n634 |             # Format multi-index as a merged cells.\n635 |             for lnum, name in enumerate(columns.names):\n636 |                 yield ExcelCell(\n637 |                     row=lnum,\n638 |                     col=coloffset,\n639 |                     val=name,\n640 |                     style=None,\n641 |                 )\n642 | \n643 |             for lnum, (spans, levels, level_codes) in enumerate(\n644 |                 zip(level_lengths, columns.levels, columns.codes)\n645 |             ):\n646 |                 values = levels.take(level_codes)\n647 |                 for i, span_val in spans.items():\n648 |                     mergestart, mergeend = None, None\n649 |                     if span_val > 1:\n650 |                         mergestart, mergeend = lnum, coloffset + i + span_val\n651 |                     yield CssExcelCell(\n652 |                         row=lnum,\n653 |                         col=coloffset + i + 1,\n654 |                         val=values[i],\n655 |                         style=None,\n656 |                         css_styles=getattr(self.styler, \"ctx_columns\", None),\n657 |                         css_row=lnum,\n658 |                         css_col=i,\n659 |                         css_converter=self.style_converter,\n660 |                         mergestart=mergestart,\n661 |                         mergeend=mergeend,\n662 |                     )\n663 |         else:\n664 |             # Format in legacy format with dots to indicate levels.\n665 |             for i, values in enumerate(zip(*level_strs)):\n666 |                 v = \".\".join(map(pprint_thing, values))\n667 |                 yield CssExcelCell(\n668 |                     row=lnum,\n669 |                     col=coloffset + i + 1,\n670 |                     val=v,\n671 |                     style=None,\n672 |                     css_styles=getattr(self.styler, \"ctx_columns\", None),\n673 |                     css_row=lnum,\n674 |                     css_col=i,\n675 |                     css_converter=self.style_converter,\n676 |                 )\n677 | \n678 |         self.rowcounter = lnum\n679 | \n680 |     def _format_header_regular(self) -> Iterable[ExcelCell]:\n681 |         if self._has_aliases or self.header:\n682 |             coloffset = 0\n683 | \n684 |             if self.index:\n685 |                 coloffset = 1\n686 |                 if isinstance(self.df.index, MultiIndex):\n687 |                     coloffset = len(self.df.index.names)\n688 | \n689 |             colnames = self.columns\n690 |             if self._has_aliases:\n691 |                 self.header = cast(Sequence, self.header)\n692 |                 if len(self.header) != len(self.columns):\n693 |                     raise ValueError(\n694 |                         f\"Writing {len(self.columns)} cols \"\n695 |                         f\"but got {len(self.header)} aliases\"\n696 |                     )\n697 |                 colnames = self.header\n698 | \n699 |             for colindex, colname in enumerate(colnames):\n700 |                 yield CssExcelCell(\n701 |                     row=self.rowcounter,\n702 |                     col=colindex + coloffset,\n703 |                     val=colname,\n704 |                     style=None,\n705 |                     css_styles=getattr(self.styler, \"ctx_columns\", None),\n706 |                     css_row=0,\n707 |                     css_col=colindex,\n708 |                     css_converter=self.style_converter,\n709 |                 )\n710 | \n711 |     def _format_header(self) -> Iterable[ExcelCell]:\n712 |         gen: Iterable[ExcelCell]\n713 | \n714 |         if isinstance(self.columns, MultiIndex):\n715 |             gen = self._format_header_mi()\n716 |         else:\n717 |             gen = self._format_header_regular()\n718 | \n719 |         gen2: Iterable[ExcelCell] = ()\n720 | \n721 |         if self.df.index.names:\n722 |             row = [x if x is not None else \"\" for x in self.df.index.names] + [\n723 |                 \"\"\n724 |             ] * len(self.columns)\n725 |             if functools.reduce(lambda x, y: x and y, (x != \"\" for x in row)):\n726 |                 gen2 = (\n727 |                     ExcelCell(self.rowcounter, colindex, val, None)\n728 |                     for colindex, val in enumerate(row)\n729 |                 )\n730 |                 self.rowcounter += 1\n731 |         return itertools.chain(gen, gen2)\n732 | \n733 |     def _format_body(self) -> Iterable[ExcelCell]:\n734 |         if isinstance(self.df.index, MultiIndex):\n735 |             return self._format_hierarchical_rows()\n736 |         else:\n737 |             return self._format_regular_rows()\n738 | \n739 |     def _format_regular_rows(self) -> Iterable[ExcelCell]:\n740 |         if self._has_aliases or self.header:\n741 |             self.rowcounter += 1\n742 | \n743 |         # output index and index_label?\n744 |         if self.index:\n745 |             # check aliases\n746 |             # if list only take first as this is not a MultiIndex\n747 |             if self.index_label and isinstance(\n748 |                 self.index_label, (list, tuple, np.ndarray, Index)\n749 |             ):\n750 |                 index_label = self.index_label[0]\n751 |             # if string good to go\n752 |             elif self.index_label and isinstance(self.index_label, str):\n753 |                 index_label = self.index_label\n754 |             else:\n755 |                 index_label = self.df.index.names[0]\n756 | \n757 |             if isinstance(self.columns, MultiIndex):\n758 |                 self.rowcounter += 1\n759 | \n760 |             if index_label and self.header is not False:\n761 |                 yield ExcelCell(self.rowcounter - 1, 0, index_label, None)\n762 | \n763 |             # write index_values\n764 |             index_values = self.df.index\n765 |             if isinstance(self.df.index, PeriodIndex):\n766 |                 index_values = self.df.index.to_timestamp()\n767 | \n768 |             for idx, idxval in enumerate(index_values):\n769 |                 yield CssExcelCell(\n770 |                     row=self.rowcounter + idx,\n771 |                     col=0,\n772 |                     val=idxval,\n773 |                     style=None,\n774 |                     css_styles=getattr(self.styler, \"ctx_index\", None),\n775 |                     css_row=idx,\n776 |                     css_col=0,\n777 |                     css_converter=self.style_converter,\n778 |                 )\n779 |             coloffset = 1\n780 |         else:\n781 |             coloffset = 0\n782 | \n783 |         yield from self._generate_body(coloffset)\n784 | \n785 |     def _format_hierarchical_rows(self) -> Iterable[ExcelCell]:\n786 |         if self._has_aliases or self.header:\n787 |             self.rowcounter += 1\n788 | \n789 |         gcolidx = 0\n790 | \n791 |         if self.index:\n792 |             index_labels = self.df.index.names\n793 |             # check for aliases\n794 |             if self.index_label and isinstance(\n795 |                 self.index_label, (list, tuple, np.ndarray, Index)\n796 |             ):\n797 |                 index_labels = self.index_label\n798 | \n799 |             # MultiIndex columns require an extra row\n800 |             # with index names (blank if None) for\n801 |             # unambiguous round-trip, unless not merging,\n802 |             # in which case the names all go on one row Issue #11328\n803 |             if isinstance(self.columns, MultiIndex) and (\n804 |                 self.merge_cells in {True, \"columns\"}\n805 |             ):\n806 |                 self.rowcounter += 1\n807 | \n808 |             # if index labels are not empty go ahead and dump\n809 |             if com.any_not_none(*index_labels) and self.header is not False:\n810 |                 for cidx, name in enumerate(index_labels):\n811 |                     yield ExcelCell(self.rowcounter - 1, cidx, name, None)\n812 | \n813 |             if self.merge_cells and self.merge_cells != \"columns\":\n814 |                 # Format hierarchical rows as merged cells.\n815 |                 level_strs = self.df.index._format_multi(\n816 |                     sparsify=True, include_names=False\n817 |                 )\n818 |                 level_lengths = get_level_lengths(level_strs)\n819 | \n820 |                 for spans, levels, level_codes in zip(\n821 |                     level_lengths, self.df.index.levels, self.df.index.codes\n822 |                 ):\n823 |                     values = levels.take(\n824 |                         level_codes,\n825 |                         allow_fill=levels._can_hold_na,\n826 |                         fill_value=levels._na_value,\n827 |                     )\n828 | \n829 |                     for i, span_val in spans.items():\n830 |                         mergestart, mergeend = None, None\n831 |                         if span_val > 1:\n832 |                             mergestart = self.rowcounter + i + span_val - 1\n833 |                             mergeend = gcolidx\n834 |                         yield CssExcelCell(\n835 |                          