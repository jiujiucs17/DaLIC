 63 |             # extra_args > 0\n  64 |             args_msg = [\n  65 |                 \"{}={}\".format(name, arg)\n  66 |                 for name, arg in zip(kwonly_args[:extra_args], args[-extra_args:])\n  67 |             ]\n  68 |             args_msg = \", \".join(args_msg)\n  69 |             warnings.warn(\n  70 |                 (\n  71 |                     f\"Pass {args_msg} as keyword args. From version \"\n  72 |                     f\"{version} passing these as positional arguments \"\n  73 |                     \"will result in an error\"\n  74 |                 ),\n  75 |                 FutureWarning,\n  76 |             )\n  77 |             kwargs.update(zip(sig.parameters, args))\n  78 |             return f(**kwargs)\n  79 | \n  80 |         return inner_f\n  81 | \n  82 |     if func is not None:\n  83 |         return _inner_deprecate_positional_args(func)\n  84 | \n  85 |     return _inner_deprecate_positional_args\n  86 | \n  87 | \n  88 | def _assert_all_finite(\n  89 |     X, allow_nan=False, msg_dtype=None, estimator_name=None, input_name=\"\"\n  90 | ):\n  91 |     \"\"\"Like assert_all_finite, but only for ndarray.\"\"\"\n  92 | \n  93 |     xp, is_array_api = get_namespace(X)\n  94 | \n  95 |     if _get_config()[\"assume_finite\"]:\n  96 |         return\n  97 | \n  98 |     X = xp.asarray(X)\n  99 | \n 100 |     # for object dtype data, we only check for NaNs (GH-13254)\n 101 |     if not is_array_api and X.dtype == np.dtype(\"object\") and not allow_nan:\n 102 |         if _object_dtype_isnan(X).any():\n 103 |             raise ValueError(\"Input contains NaN\")\n 104 | \n 105 |     # We need only consider float arrays, hence can early return for all else.\n 106 |     if not xp.isdtype(X.dtype, (\"real floating\", \"complex floating\")):\n 107 |         return\n 108 | \n 109 |     # First try an O(n) time, O(1) space solution for the common case that\n 110 |     # everything is finite; fall back to O(n) space `np.isinf/isnan` o