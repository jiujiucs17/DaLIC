_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n\nFound function `sklearn/manifold/_t_sne.py:_kl_divergence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n126 | def _kl_divergence(\n127 |     params,\n128 |     P,\n129 |     degrees_of_freedom,\n130 |     n_samples,\n131 |     n_components,\n132 |     skip_num_points=0,\n133 |     compute_error=True,\n134 | ):\n135 |     \"\"\"t-SNE objective function: gradient of the KL divergence\n136 |     of p_ijs and q_ijs and the absolute error.\n137 | \n138 |     Parameters\n139 |     ----------\n140 |     params : ndarray of shape (n_params,)\n141 |         Unraveled embedding.\n142 | \n143 |     P : ndarray of shape (n_samples * (n_samples-1) / 2,)\n144 |         Condensed joint probability matrix.\n145 | \n146 |     degrees_of_freedom : int\n147 |         Degrees of freedom of the Student's-t distribution.\n148 | \n149 |     n_samples : int\n150 |         Number of samples.\n151 | \n152 |     n_components : int\n153 |         Dimension of the embedded space.\n154 | \n155 |     skip_num_points : int, default=0\n156 |         This does not compute the gradient for points with indices below\n157 |         `skip_num_points`. This is useful when computing transforms of new\n158 |         data where you'd like to keep the old data fixed.\n159 | \n160 |     compute_error: bool, default=True\n161 |         If False, the kl_divergence is not computed and returns NaN.\n162 | \n163 |     Returns\n164 |     -------\n165 |     kl_divergence : float\n166 |         Kullback-Leibler divergence of p_ij and q_ij.\n167 | \n168 |     grad : ndarray of shape (n_params,)\n169 |         Unraveled gradient of the Kullback-Leibler divergence with respect to\n170 |         the embedding.\n171 |     \"\"\"\n172 |     X_embedded = params.reshape(n_samples, n_components)\n173 | \n174 |     # Q is a heavy-tailed distribution: Student's t-distribution\n175 |     dist = pdist(X_embedded, \"sqeuclidean\")\n176 |     dist /= degrees_of_freedom\n177 |     dist += 1.0\n178 |     dist **= (degrees_of_freedom + 1.0) / -2.0\n179 |     Q = np.maximum(dist / (2.0 * np.sum(dist)), MACHINE_EPSILON)\n180 | \n181 |     # Optimization trick below: np.dot(x, y) is faster than\n182 |     # np.sum(x * y) because it calls BLAS\n183 | \n184 |     # Objective: C (Kullback-Leibler divergence of P and Q)\n185 |     if compute_error:\n186 |         kl_divergence = 2.0 * np.dot(P, np.log(np.maximum(P, MACHINE_EPSILON) / Q))\n187 |     else:\n188 |         kl_divergence = np.nan\n189 | \n190 |     # Gradient: dC/dY\n191 |     # pdist always returns double precision distances. Thus we need to take\n192 |     grad = np.ndarray((n_samples, n_components), dtype=params.dtype)\n193 |     PQd = squareform((P - Q) * dist)\n194 |     for i in range(skip_num_points, n_samples):\n195 |         grad[i] = np.dot(np.ravel(PQd[i], order=\"K\"), X_embedded[i] - X_embedded)\n196 |     grad = grad.ravel()\n197 |     c = 2.0 * (degrees_of_freedom + 1.0) / degrees_of_freedom\n198 |     grad *= c\n199 | \n200 |     return kl_divergence, grad\n```\n\n\n\n##Searching for term \"online learning_method kullback-leibler\"...\n### Search Result:\nFound function `examples/model_selection/plot_learning_curve.py:plot_learning_curve`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 29 | def plot_learning_curve(\n 30 |     estimator,\n 31 |     title,\n 32 |     X,\n 33 |     y,\n 34 |     axes=None,\n 35 |     ylim=None,\n 36 |     cv=None,\n 37 |     n_jobs=None,\n 38 |     train_sizes=np.linspace(0.1, 1.0, 5),\n 39 | ):\n 40 |     \"\"\"\n 41 |     Generate 3 plots: the test and training learning curve, the training\n 42 |     samples vs fit times curve, the fit times vs score curve.\n 43 | \n 44 |     Parameters\n 45 |     ----------\n 46 |     estimator : estimator instance\n 47 |         An estimator instance implementing `fit` and `predict` methods which\n 48 |         will be cloned for each validation.\n 49 | \n 50 |     title : str\n 51 |         Title for the chart.\n 52 | \n 53 |     X : array-like of shape (n_samples, n_features)\n 54 |         Training vector, where ``n_samples`` is the number of samples and\n 55 |         ``n_features`` is the number of features.\n 56 | \n 57 |     y : array-like of shape (n_samples) or (n_samples, n_features)\n 58 |         Target relative to ``X`` for classification or regression;\n 59 |         None for unsupervised learning.\n 60 | \n 61 |     axes : array-like of shape (3,), default=None\n 62 |         Axes to use for plotting the curves.\n 63 | \n 64 |     ylim : tuple of shape (2,), default=None\n 65 |         Defines minimum and maximum y-values plotted, e.g. (ymin, ymax).\n 66 | \n 67 |     cv : int, cross-validation generator or an iterable, default=None\n 68 |         Determines the cross-validation splitting strategy.\n 69 |         Possible inputs for cv are:\n 70 | \n 71 |           - None, to use the default 5-fold cross-validation,\n 72 |           - integer, to specify the number of folds.\n 73 |           - :term:`CV splitter`,\n 74 |           - An iterable yielding (train, test) splits as arrays of indices.\n 75 | \n 76 |         For integer/None inputs, if ``y`` is binary or multiclass,\n 77 |         :class:`StratifiedKFold` used. If the estimator is not a classifier\n 78 |         or if ``y`` is neither binary nor multiclass, :class:`KFold` is used.\n 79 | \n 80 |         Refer :ref:`User Guide <cross_validation>` for the various\n 81 |         cross-validators that can be used here.\n 82 | \n 83 |     n_jobs : int or None, default=None\n 84 |         Number of jobs to run in parallel.\n 85 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 86 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 87 |         for more details.\n 88 | \n 89 |     train_sizes : array-like of shape (n_ticks,)\n 90 |         Relative or absolute numbers of training examples that will be used to\n 91 |         generate the learning curve. If the ``dtype`` is float, it is regarded\n 92 |         as a fraction of the maximum size of the training set (that is\n 93 |         determined by the selected validation method), i.e. it has to be within\n 94 |         (0, 1]. Otherwise it is interpreted as absolute sizes of the training\n 95 |         sets. Note that for classification the number of samples usually have\n 96 |         to be big enough to contain at least one sample from each class.\n 97 |         (default: np.linspace(0.1, 1.0, 5))\n 98 |     \"\"\"\n 99 |     if axes is None:\n100 |         _, axes = plt.subplots(1, 3, figsize=(20, 5))\n101 | \n102 |     axes[0].set_title(title)\n103 |     if ylim is not None:\n104 |         axes[0].set_ylim(*ylim)\n105 |     axes[0].set_xlabel(\"Training examples\")\n106 |     axes[0].set_ylabel(\"Score\")\n107 | \n108 |     train_sizes, train_scores, test_scores, fit_times, _ = learning_curve(\n109 |         estimator,\n110 |         X,\n111 |         y,\n112 |         cv=cv,\n113 |         n_jobs=n_jobs,\n114 |         train_sizes=train_sizes,\n115 |         return_times=True,\n116 |     )\n117 |     train_scores_mean = np.mean(train_scores, axis=1)\n118 |     train_scores_std = np.std(train_scores, axis=1)\n119 |     test_scores_mean = np.mean(test_scores, axis=1)\n120 |     test_scores_std = np.std(test_scores, axis=1)\n121 |     fit_times_mean = np.mean(fit_times, axis=1)\n122 |     fit_times_std = np.std(fit_times, axis=1)\n123 | \n124 |     # Plot learning curve\n125 |     axes[0].grid()\n126 |     axes[0].fill_between(\n127 |         train_sizes,\n128 |         train_scores_mean - train_scores_std,\n129 |         train_scores_mean + train_scores_std,\n130 |         alpha=0.1,\n131 |         color=\"r\",\n132 |     )\n133 |     axes[0].fill_between(\n134 |         train_sizes,\n135 |         test_scores_mean - test_scores_std,\n136 |         test_scores_mean + test_scores_std,\n137 |         alpha=0.1,\n138 |         color=\"g\",\n139 |     )\n140 |     axes[0].plot(\n141 |         train_sizes, train_scores_mean, \"o-\", color=\"r\", label=\"Training score\"\n142 |     )\n143 |     axes[0].plot(\n144 |         train_sizes, test_scores_mean, \"o-\", color=\"g\", label=\"Cross-validation score\"\n145 |     )\n146 |     axes[0].legend(loc=\"best\")\n147 | \n148 |     # Plot n_samples vs fit_times\n149 |     axes[1].grid()\n150 |     axes[1].plot(train_sizes, fit_times_mean, \"o-\")\n151 |     axes[1].fill_between(\n152 |         train_sizes,\n153 |         fit_times_mean - fit_times_std,\n154 |         fit_times_mean + fit_times_std,\n155 |         alpha=0.1,\n156 |     )\n157 |     axes[1].set_xlabel(\"Training examples\")\n158 |     axes[1].set_ylabel(\"fit_times\")\n159 |     axes[1].set_title(\"Scalability of the model\")\n160 | \n161 |     # Plot fit_time vs score\n162 |     fit_time_argsort = fit_times_mean.argsort()\n163 |     fit_time_sorted = fit_times_mean[fit_time_argsort]\n164 |     test_scores_mean_sorted = test_scores_mean[fit_time_argsort]\n165 |     test_scores_std_sorted = test_scores_std[fit_time_argsort]\n166 |     axes[2].grid()\n167 |     axes[2].plot(fit_time_sorted, test_scores_mean_sorted, \"o-\")\n168 |     axes[2].fill_between(\n169 |         fit_time_sorted,\n170 |         test_scores_mean_sorted - test_scores_std_sorted,\n171 |         test_scores_mean_sorted + test_scores_std_sorted,\n172 |         alpha=0.1,\n173 |     )\n174 |     axes[2].set_xlabel(\"fit_times\")\n175 |     axes[2].set_ylabel(\"Score\")\n176 |     axes[2].set_title(\"Performance of the model\")\n177 | \n178 |     return plt\n```\n\nFound file `examples/model_selection/plot_learning_curve.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/m