25 |         If True, returns ``(data, target)`` instead of a Bunch object.\n1026 |         See below for more information about the `data` and `target` object.\n1027 | \n1028 |         .. versionadded:: 0.18\n1029 | \n1030 |     as_frame : bool, default=False\n1031 |         If True, the data is a pandas DataFrame including columns with\n1032 |         appropriate dtypes (numeric, string or categorical). The target is\n1033 |         a pandas DataFrame or Series depending on the number of target columns.\n1034 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n1035 |         DataFrames or Series as described below.\n1036 | \n1037 |         .. versionadded:: 0.23\n1038 | \n1039 |     Returns\n1040 |     -------\n1041 |     data : :class:`~sklearn.utils.Bunch`\n1042 |         Dictionary-like object, with the following attributes.\n1043 | \n1044 |         data : {ndarray, dataframe} of shape (20, 3)\n1045 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n1046 |             DataFrame.\n1047 |         target: {ndarray, dataframe} of shape (20, 3)\n1048 |             The regression targets. If `as_frame=True`, `target` will be\n1049 |             a pandas DataFrame.\n1050 |         feature_names: list\n1051 |             The names of the dataset columns.\n1052 |         target_names: list\n1053 |             The names of the target columns.\n1054 |         frame: DataFrame of shape (20, 6)\n1055 |             Only present when `as_frame=True`. DataFrame with `data` and\n1056 |             `target`.\n1057 | \n1058 |             .. versionadded:: 0.23\n1059 |         DESCR: str\n1060 |             The full description of the dataset.\n1061 |         data_filename: str\n1062 |             The path to the location of the data.\n1063 |         target_filename: str\n1064 |             The path to the location of the target.\n1065 | \n1066 |             .. versionadded:: 0.20\n1067 | \n1068 |     (data, target) : tuple if ``return_X_y`` is True\n1069 | \n1070 |         .. versionadded:: 0.18\n1071 |     \"\"\"\n1072 |     data_filename = \"linnerud_exercise.csv\"\n1073 |     target_filename = \"linnerud_physiological.csv\"\n1074 | \n1075 |     # Read header and data\n1076 |     with resources.open_text(DATA_MODULE, data_filename) as f:\n1077 |         header_exercise = f.readline().split()\n1078 |         f.seek(0)  # reset file obj\n1079 |         data_exercise = np.loadtxt(f, skiprows=1)\n1080 | \n1081 |     with resources.open_text(DATA_MODULE, target_filename) as f:\n1082 |         header_physiological = f.readline().split()\n1083 |         f.seek(0)  # reset file obj\n1084 |         data_physiological = np.loadtxt(f, skiprows=1)\n1085 | \n1086 |     fdescr = load_descr(\"linnerud.rst\")\n1087 | \n1088 |     frame = None\n1089 |     if as_frame:\n1090 |         (frame, data_exercise, data_physiological) = _convert_data_dataframe(\n1091 |             \"load_linnerud\",\n1092 |             data_exercise,\n1093 |             data_physiological,\n1094 |             header_exercise,\n1095 |             header_physiological,\n1096 |         )\n1097 |     if return_X_y:\n1098 |         return data_exercise, data_physiological\n1099 | \n1100 |     return Bunch(\n1101 |         data=data_exercise,\n1102 |         feature_names=header_exercise,\n1103 |         target=data_physiological,\n1104 |         target_names=header_physiological,\n1105 |         frame=frame,\n1106 |         DESCR=fdescr,\n1107 |         data_filename=data_filename,\n1108 |         target_filename=target_filename,\n1109 |         data_module=DATA_MODULE,\n1110 |     )\n```\n\nFound function `sklearn/calibration.py:_sigmoid_calibration`.\nSource: Retrieved entity using keyword search (bm25).\n```\n722 | def _sigmoid_calibration(predictions, y, sample_weight=None):\n723 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n724 | \n725 |     Parameters\n726 |     ----------\n727 |     predictions : ndarray of shape (n_samples,)\n728 |         The decision function or predict proba for the samples.\n729 | \n730 |     y : ndarray of shape (n_samples,)\n731 |         The targets.\n732 | \n733 |     sample_weight : array-like of shape (n_samples,), default=None\n734 |         Sample weights. If None, then samples are equally weighted.\n735 | \n736 |     Returns\n737 |     -------\n738 |     a : float\n739 |         The slope.\n740 | \n741 |     b : float\n742 |         The intercept.\n743 | \n744 |     References\n745 |     ----------\n746 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n747 |     \"\"\"\n748 |     predictions = column_or_1d(predictions)\n749 |     y = column_or_1d(y)\n750 | \n751 |     F = predictions  # F follows Platt's notations\n752 | \n753 |     # Bayesian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n```\n\nFound function `sklearn/utils/validation.py:_get_feature_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1595 | def _get_feature_names(X):\n1596 |     \"\"\"Get feature names from X.\n1597 | \n1598 |     Support for other array containers should place its implementation here.\n1599 | \n1600 |     Parameters\n1601 |     ----------\n1602 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n1603 |         Array container to extract feature names.\n1604 | \n1605 |         - pandas dataframe : The columns will be considered to be feature\n1606 |           names. If the dataframe contains non-string feature names, `None` is\n1607 |           returned.\n1608 |         - All other array containers will return `None`.\n1609 | \n1610 |     Returns\n1611 |     -------\n1612 |     names: ndarray or None\n1613 |         Feature names of `X`. Unrecognized array containers will return `None`.\n1614 |     \"\"\"\n1615 |     feature_names = None\n1616 | \n1617 |     # extract feature names for support array containers\n1618 |     if hasattr(X, \"columns\"):\n1619 |         feature_names = np.asarray(X.columns)\n1620 | \n1621 |     if feature_names is None or len(feature_names) == 0:\n1622 |         return\n1623 | \n1624 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n1625 | \n1626 |     # Warn when types are mixed.\n1627 |     # ints and strings do not warn\n1628 |     if len(types) > 1 or not (types[0].startswith(\"int\") or types[0] == \"str\"):\n1629 |         # TODO: Convert to an error in 1.2\n1630 |         warnings.warn(\n1631 |             \"Feature names only support names that are all strings. \"\n1632 |             f\"Got feature names with dtypes: {types}. An error will be raised \"\n1633 |             \"in 1.2.\",\n1634 |             FutureWarning,\n1635 |         )\n1636 |         return\n1637 | \n1638 |     # Only feature names of all strings are supported\n1639 |     if types[0] == \"str\":\n1640 |         return feature_names\n```\n\nFound function `sklearn/datasets/_base.py:load_diabetes`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 911 | def load_diabetes(*, return_X_y=False, as_frame=False):\n 912 |     \"\"\"Load and return the diabetes dataset (regression).\n 913 | \n 914 |     ==============   ==================\n 915 |     Samples total    442\n 916 |     Dimensionality   10\n 917 |     Features         real, -.2 < x < .2\n 918 |     Targets          integer 25 - 346\n 919 |     ==============   ==================\n 920 | \n 921 |     .. note::\n 922 |        The meaning of each feature (i.e. `feature_names`) might be unclear\n 923 |        (especially for `ltg`) as the documentation of the original dataset is\n 924 |        not explicit. We provide information that seems correct in regard with\n 925 |        the scientific literature in this field of research.\n 926 | \n 927 |     Read more in the :ref:`User Guide <diabetes_dataset>`.\n 928 | \n 929 |     Parameters\n 930 |     ----------\n 931 |     return_X_y : bool, default=False.\n 932 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 933 |         See below for more information about the `data` and `target` object.\n 934 | \n 935 |         .. versionadded:: 0.18\n 936 | \n 937 |     as_frame : bool, default=False\n 938 |         If True, the data is a pandas DataFrame including columns with\n 939 |         appropriate dtypes (numeric). The target is\n 940 |         a pandas DataFrame or Series depending on the number of target columns.\n 941 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 942 |         DataFrames or Series as described below.\n 943 | \n 944 |         .. versionadded:: 0.23\n 945 | \n 946 |     Returns\n 947 |     -------\n 948 |     data : :class:`~sklearn.utils.Bunch`\n 949 |         Dictionary-like object, with the following attributes.\n 950 | \n 951 |         data : {ndarray, datafram