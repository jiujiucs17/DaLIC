rations needed so that the\n281 |         # last iterations evaluates less than `factor` candidates.\n282 |         n_required_iterations = 1 + floor(log(len(candidate_params), self.factor))\n283 | \n284 |         if self.min_resources == \"exhaust\":\n285 |             # To exhaust the resources, we want to start with the biggest\n286 |             # min_resources possible so that the last (required) iteration\n287 |             # uses as many resources as possible\n288 |             last_iteration = n_required_iterations - 1\n289 |             self.min_resources_ = max(\n290 |                 self.min_resources_,\n291 |                 self.max_resources_ // self.factor**last_iteration,\n292 |             )\n293 | \n294 |         # n_possible_iterations is the number of iterations that we can\n295 |         # actually do starting from min_resources and without exceeding\n296 |         # max_resources. Depending on max_resources and the number of\n297 |         # candidates, this may be higher or smaller than\n298 |         # n_required_iterations.\n299 |         n_possible_iterations = 1 + floor(\n300 |             log(self.max_resources_ // self.min_resources_, self.factor)\n301 |         )\n302 | \n303 |         if self.aggressive_elimination:\n304 |             n_iterations = n_required_iterations\n305 |         else:\n306 |             n_iterations = min(n_possible_iterations, n_required_iterations)\n307 | \n308 |         if self.verbose:\n309 |             print(f\"n_iterations: {n_iterations}\")\n310 |             print(f\"n_required_iterations: {n_required_iterations}\")\n311 |             print(f\"n_possible_iterations: {n_possible_iterations}\")\n312 |             print(f\"min_resources_: {self.min_resources_}\")\n313 |             print(f\"max_resources_: {self.max_resources_}\")\n314 |             print(f\"aggressive_elimination: {self.aggressive_elimination}\")\n315 |             print(f\"factor: {self.factor}\")\n316 | \n317 |         self.n_resources_ = []\n318 |         self.n_candidates_ = []\n319 | \n320 |         for itr in range(n_iterations):\n321 | \n322 |             power = itr  # default\n323 |             if self.aggressive_elimination:\n324 |                 # this will set n_resources to the initial value (i.e. the\n325 |                 # value of n_resources at the first iteration) for as many\n326 |                 # iterations as needed (while candidates are being\n327 |                 # eliminated), and then go on as usual.\n328 |                 power = max(0, itr - n_required_iterations + n_possible_iterations)\n329 | \n330 |             n_resources = int(self.factor**power * self.min_resources_)\n331 |             # guard, probably not needed\n332 |             n_resources = min(n_resources, self.max_resources_)\n333 |             self.n_resources_.append(n_resources)\n334 | \n335 |             n_candidates = len(candidate_params)\n336 |             self.n_candidates_.append(n_candidates)\n337 | \n338 |             if self.verbose:\n339 |                 print(\"-\" * 10)\n340 |                 print(f\"iter: {itr}\")\n341 |                 print(f\"n_candidates: {n_candidates}\")\n342 |                 print(f\"n_resources: {n_resources}\")\n343 | \n344 |             if self.resource == \"n_samples\":\n345 |                 # subsampling will be done in cv.split()\n346 |                 cv = _SubsampleMetaSplitter(\n347 |                     base_cv=self._checked_cv_orig,\n348 |                     fraction=n_resources / self._n_samples_orig,\n349 |                     subsample_test=True,\n350 |                     random_state=self.random_state,\n351 |                 )\n352 | \n353 |             else:\n354 |                 # Need copy so that the n_resources of next iteration does\n355 |                 # not overwrite\n356 |                 candidate_params = [c.copy() for c in candidate_params]\n357 |                 for candidate in candidate_params:\n358 |                     cand