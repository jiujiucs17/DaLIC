ify(A)\n 197 |         >>> isinstance(B, Basic)\n 198 |         True\n 199 |     \"\"\"\n 200 |     __slots__ = ('_mhash',              # hash value\n 201 |                  '_args',               # arguments\n 202 |                  '_assumptions'\n 203 |                 )\n 204 | \n 205 |     _args: tuple[Basic, ...]\n 206 |     _mhash: int | None\n 207 | \n 208 |     @property\n 209 |     def __sympy__(self):\n 210 |         return True\n 211 | \n 212 |     def __init_subclass__(cls):\n 213 |         # Initialize the default_assumptions FactKB and also any assumptions\n 214 |         # property methods. This method will only be called for subclasses of\n 215 |         # Basic but not for Basic itself so we call\n 216 |         # _prepare_class_assumptions(Basic) below the class definition.\n 217 |         super().__init_subclass__()\n 218 |         _prepare_class_assumptions(cls)\n 219 | \n 220 |     # To be overridden with True in the appropriate subclasses\n 221 |     is_number = False\n 222 |     is_Atom = False\n 223 |     is_Symbol = False\n 224 |     is_symbol = False\n 225 |     is_Indexed = False\n 226 |     is_Dummy = False\n 227 |     is_Wild = False\n 228 |     is_Function = False\n 229 |     is_Add = False\n 230 |     is_Mul = False\n 231 |     is_Pow = False\n 232 |     is_Number = False\n 233 |     is_Float = False\n 234 |     is_Rational = False\n 235 |     is_Integer = False\n 236 |     is_NumberSymbol = False\n 237 |     is_Order = False\n 238 |     is_Derivative = False\n 239 |     is_Piecewise = False\n 240 |     is_Poly = False\n 241 |     is_AlgebraicNumber = False\n 242 |     is_Relational = False\n 243 |     is_Equality = False\n 244 |     is_Boolean = False\n 245 |     is_Not = False\n 246 |     is_Matrix = False\n 247 |     is_Vector = False\n 248 |     is_Point = False\n 249 |     is_MatAdd = False\n 250 |     is_MatMul = False\n 251 | \n 252 |     default_assumptions: ClassVar[StdFactKB]\n 253 | \n 254 |     is_composite: bool | None\n 255 |     is_noninteger: bool | None\n 256 |     is_extended_positive: bool | None\n 257 |     is_negative: bool | None\n 258 |     is_complex: bool | None\n 259 |     is_extended_nonpositive: bool | None\n 260 |     is_integer: bool | None\n 261 |     is_positive: bool | None\n 262 |     is_rational: bool | None\n 263 |     is_extended_nonnegative: bool | None\n 264 |     is_infinite: bool | None\n 265 |     is_antihermitian: bool | None\n 266 |     is_extended_negative: bool | None\n 267 |     is_extended_real: bool | None\n 268 |     is_finite: bool | None\n 269 |     is_polar: bool | None\n 270 |     is_imaginary: bool | None\n 271 |     is_transcendental: bool | None\n 272 |     is_extended_nonzero: bool | None\n 273 |     is_nonzero: bool | None\n 274 |     is_odd: bool | None\n 275 |     is_algebraic: bool | None\n 276 |     is_prime: bool | None\n 277 |     is_commutative: bool | None\n 278 |     is_nonnegative: bool | None\n 279 |     is_nonpositive: bool | None\n 280 |     is_hermitian: bool | None\n 281 |     is_irrational: bool | None\n 282 |     is_real: bool | None\n 283 |     is_zero: bool | None\n 284 |     is_even: bool | None\n 285 | \n 286 |     kind: Kind = UndefinedKind\n 287 | \n 288 |     def __new__(cls, *args):\n 289 |         obj = object.__new__(cls)\n 290 |         obj._assumptions = cls.default_assumptions\n 291 |         obj._mhash = None  # will be set by __hash__ method.\n 292 | \n 293 |         obj._args = args  # all items in args must be Basic objects\n 294 |         return obj\n 295 | \n 296 |     def copy(self):\n 297 |         return self.func(*self.args)\n 298 | \n 299 |     def __getnewargs__(self):\n 300 |         return self.args\n 301 | \n 302 |     def __getstate__(self):\n 303 |         return None\n 304 | \n 305 |     def __setstate__(self, state):\n 306 |         for name, value in state.items():\n 307 |             setattr(self, name, value)\n 308 | \n 309 |     def __reduce_ex__(self, protocol):\n 310 |         if protocol < 2:\n 311 |             msg = \"Only pickle protocol 2 or higher is supported by SymPy\"\n 312 |             raise NotImplementedError(msg)\n 313 |         return super().__reduce_ex__(protocol)\n 314 | \n 315 |     def __hash__(self) -> int:\n 316 |         # hash cannot be cached using cache_it because infinite recurrence\n 317 |         # occurs as hash is needed for setting cache dictionary keys\n 318 |         h = self._mhash\n 319 |         if h is None:\n 320 |             h = hash((type(self).__name__,) + self._hashable_content())\n 321 |             self._mhash = h\n 322 |         return h\n 323 | \n 324 |     def _hashable_content(self):\n 325 |         \"\"\"Return a tuple of information about self that can be used to\n 326 |         compute the hash. If a class defines additional attributes,\n 327 |         like ``name`` in Symbol, then this method should be updated\n 328 |         accordingly to return such relevant attributes.\n 329 | \n 330 |         Defining more than _hashable_content is necessary if __eq__ has\n 331 |         been defined by a class. See note about this in Basic.__eq__.\"\"\"\n 332 |         return self._args\n 333 | \n 334 |     @property\n 335 |     def assumptions0(self):\n 336 |         \"\"\"\n 337 |         Return object `type` assumptions.\n 338 | \n 339 |         For example:\n 340 | \n 341 |           Symbol('x', real=True)\n 342 |           Symbol('x', integer=True)\n 343 | \n 344 |         are different objects. In other words, besides Python type (Symbol in\n 345 |         this case), the initial assumptions are also forming their typeinfo.\n 346 | \n 347 |         Examples\n 348 |         ========\n 349 | \n 350 |         >>> from sympy import Symbol\n 351 |         >>> from sympy.abc import x\n 352 |         >>> x.assumptions0\n 353 |         {'commutative': True}\n 354 |         >>> x = Symbol(\"x\", positive=True)\n 355 |         >>> x.assumptions0\n 356 |         {'commutative': True, 'complex': True, 'extended_negative': False,\n 357 |          'extended_nonnegative': True, 'extended_nonpositive': False,\n 358 |          'extended_nonzero': True, 'extended_positive': True, 'extended_real':\n 359 |          True, 'finite': True, 'hermitian': True, 'imaginary': False,\n 360 |          'infinite': False, 'negative': False, 'nonnegative': True,\n 361 |          'nonpositive': False, 'nonzero': True, 'positive': True, 'real':\n 362 |          True, 'zero': False}\n 363 |         \"\"\"\n 364 |         return {}\n 365 | \n 366 |     def compare(self, other):\n 367 |         \"\"\"\n 368 |         Return -1, 0, 1 if the object is less than, equal,\n 369 |         or greater than other in a canonical sense.\n 370 |         Non-Basic are always greater than Basic.\n 371 |         If both names of the classes being compared appear\n 372 |         in the `ordering_of_classes` then the ordering will\n 373 |         depend on the appearance of the names there.\n 374 |         If either does not appear in that list, then the\n 375 |         comparison is based on the class name.\n 376 |         If the names are the same then a comparison is made\n 377 |         on the length of the hashable content.\n 378 |         Items of the equal-lengthed contents are then\n 379 |         successively compared using the same rules. If there\n 380 |         is never a difference then 0 is returned.\n 381 | \n 382 |         Examples\n 383 |         ========\n 384 | \n 385 |         >>> from sympy.abc import x, y\n 386 |         >>> x.compare(y)\n 387 |         -1\n 388 |         >>> x.compare(x)\n 389 |         0\n 390 |         >>> y.compare(x)\n 391 |         1\n 392 | \n 393 |         \"\"\"\n 394 |         # all redefinitions of __cmp__ method should start with the\n 395 |         # following lines:\n 396 |         if self is other:\n 397 |             return 0\n 398 |         n1 = self.__class__\n 399 |         n2 = other.__class__\n 400 |         c = _cmp_name(n1, n2)\n 401 |         if c:\n 402 |             return c\n 403 |         #\n 404 |         st = self._hashable_content()\n 405 |         ot = other._hashable_content()\n 406 |         len_st = len(st)\n 407 |         len_ot = len(ot)\n 408 |         c = (len_st > len_ot) - (len_st < len_ot)\n 409 |         if c:\n 410 |             return c\n 411 |         for l, r in zip(st, ot):\n 412 |             if isinstance(l, Basic):\n 413 |                 c = l.compare(r)\n 414 |             elif isinstance(l, frozenset):\n 415 |                 l = Basic(*l) if isinstance(l, frozenset) else l\n 416 |                 r = Basic(*r) if isinstance(r, frozenset) else r\n 417 |                 c = l.compare(r)\n 418 |             else:\n 419 |                 c = (l > r) - (l < r)\n 420 |             if c:\n 421 |                 return c\n 422 |         return 0\n 423 | \n 424 |     @classmethod\n 425 |     def fromiter(cls, args, **assumptions):\n 426 |         \"\"\"\n 427 |         Create a new object from an iterable.\n 428 | \n 429 |         This is a convenience function that allows one to create objects from\n 430 |         any iterable, without having to convert to a list or tuple first.\n 431 | \n 432 |         Examples\n 433 |         ========\n 434 | \n 435 |         >>> from sympy import Tuple\n 436 |         >>> Tuple.fromiter(i for i in range(5))\n 437 |         (0, 1, 2, 3, 4)\n 438 | \n 439 |         \"\"\"\n 440 |         return cls(*tuple(args), **assumptions)\n 441 | \n 442 |     @classmethod\n 443 |     def class_key(cls) -> tuple[int, int, str]:\n 444 |         \"\"\"Nice order of classes.\"\"\"\n 445 |         return 5, 0, cls.__name__\n 446 | \n 447 |     @cacheit\n 448 |     def sort_key(self, order=None):\n 449 |         \"\"\"\n 450 |         Return a sort key.\n 451 | \n 452 |         Examples\n 453 |         ========\n 454 | \n 455 |         >>> from sympy import S, I\n 456 | \n 457 |         >>> sorted([S(1)/2, I, -I], key=lambda x: x.sort_key())\n 458 |         [1/2, -I, I]\n 459 | \n 460 |         >>> S(\"[x, 1/x, 1/x**2, x**2, x**(1/2), x**(1/4), x**(3/2)]\")\n 461 |         [x, 1/x, x**(-2), x**2, sqrt(x), x**(1/4), x**(3/2)]\n 462 |         >>> sorted(_, key=lambda x: x.sort_key())\n 463 |         [x**(-2), 1/x, x**(1/4), sqrt(x), x, x**(3/2), x**2]\n 464 | \n 465 |         \"\"\"\n 466 | \n 467 |         # XXX: remove this when issue 5169 is fixed\n 468 |         def inner_key(arg):\n 469 |             if isinstance(arg, Basic):\n 470 |                 return arg.sort_key(order)\n 471 |             else:\n 472 |                 return arg\n 473 | \n 474 |         args = self._sorted_args\n 475 |         args = len(args), tuple([inner_key(arg) for arg in args])\n 476 |         return self.class_key(), args, S.One.sort_key(), S.One\n 477 | \n 478 |     def _do_eq_sympify(self, other):\n 479 |         \"\"\"Returns a boolean indicating whether a == b when either a\n 480 |         or b is not a Basic. This is only done for types that were either\n 481 |         added to `converter` by a 3rd party or when the object has `_sympy_`\n 482 |         defined. This essentially reuses the code in `_sympify` that is\n 483 |         specific for this use case. Non-user defined types that are meant\n 484 |         to work with SymPy should be handled directly in the __eq__ methods\n 485 |         of the `Basic` classes it could equate to and not be converted. Note\n 486 |         that after conversion, `==`  is used again since it is not\n 487 |         necessarily clear whether `self` or `other`'s __eq__ method needs\n 488 |         to be used.\"\"\"\n 489 |         for superclass in type(other).__mro__:\n 490 |             conv = _external_converter.get(superclass)\n 491 |             if conv is not None:\n 492 |                 return self == conv(other)\n 493 |         if hasattr(other, '_sympy_'):\n 494 |             return self == other._sympy_()\n 495 |         return NotImplemented\n 496 | \n 497 |     def __eq__(self, other):\n 498 |         \"\"\"Return a boolean indicating whether a == b on the basis of\n 499 |         their symbolic trees.\n 500 | \n 501 |         This is the same as a.compare(b) == 0 but faster.\n 502 | \n 503 |         Notes\n 504 |         =====\n 505 | \n 506 |         If a class that overrides __eq__() needs to retain the\n 507 |         implementation of __hash__() from a parent class, the\n 508 |         interpreter must be told this explicitly by setting\n 509 |         __hash__ : Callable[[object], int] = <ParentClass>.__hash__.\n 510 |         Otherwise the inheritance of __hash__() will be blocked,\n 511 |         just as if __hash__ had been explicitly set to None.\n 512 | \n 513 |         References\n 514 |         ==========\n 515 | \n 516 |         from https://docs.python.org/dev/reference/datamodel.html#object.__hash__\n 517 |         \"\"\"\n 518 |         if self is other:\n 519 |             return True\n 520 | \n 521 |         if not isinstance(other, Basic):\n 522 |             return self._do_eq_sympify(other)\n 523 | \n 524 |         # check for pure number expr\n 525 |         if  not (self.is_Number and other.is_Number) and (\n 526 |                 type(self) != type(other)):\n 527 |             return False\n 528 |         a, b = self._hashable_content(), other._hashable_content()\n 529 |         if a != b:\n 530 |             return False\n 531 |         # check number *in* an expression\n 532 |         for a, b in zip(a, b):\n 533 |             if not isinstance(a, Basic):\n 534 |                 continue\n 535 |             if a.is_Number and type(a) != type(b):\n 536 |                 return False\n 537 |         return True\n 538 | \n 539 |     def __ne__(self, other):\n 540 |         \"\"\"``a != b``  -> Compare two symbolic trees and see whether they are different\n 541 | \n 542 |         this is the same as:\n 543 | \n 544 |         ``a.compare(b) != 0``\n 545 | \n 546 |         but faster\n 547 |         \"\"\"\n 548 |         return not self == other\n 549 | \n 550 |     def dummy_eq(self, other, symbol=None):\n 551 |         \"\"\"\n 552 |         Compare two expressions and handle dummy symbols.\n 553 | \n 554 |         Examples\n 555 |         ========\n 556 | \n 557 |         >>> from sympy import Dummy\n 558 |         >>> from sympy.abc import x, y\n 559 | \n 560 |         >>> u = Dummy('u')\n 561 | \n 562 |         >>> (u**2 + 1).dummy_eq(x**2 + 1)\n 563 |         True\n 564 |         >>> (u**2 + 1) == (x**2 + 1)\n 565 |         False\n 566 | \n 567 |         >>> (u**2 + y).dummy_eq(x**2 + y, x)\n 568 |         True\n 569 |         >>> (u**2 + y).dummy_eq(x**2 + y, y)\n 570 |         False\n 571 | \n 572 |         \"\"\"\n 573 |         s = self.as_dummy()\n 574 |         o = _sympify(other)\n 575 |         o = o.as_dummy()\n 576 | \n 577 |         dummy_symbols = [i for i in s.free_symbols if i.is_Dummy]\n 578 | \n 579 |         if len(dummy_symbols) == 1:\n 580 |             dummy = dummy_symbols.pop()\n 581 |         else:\n 582 |             return s == o\n 583 | \n 584 |         if symbol is None:\n 585 |             symbols = o.free_symbols\n 586 | \n 587 |             if len(symbols) == 1:\n 588 |                 symbol = symbols.pop()\n 589 |             else:\n 590 |                 return s == o\n 591 | \n 592 |         tmp = dummy.__class__()\n 593 | \n 594 |         return s.xreplace({dummy: tmp}) == o.xreplace({symbol: tmp})\n 595 | \n 596 |     @overload\n 597 |     def atoms(self) -> set[Basic]: ...\n 598 |     @overload\n 599 |     def atoms(self, *types: Tbasic | type[Tbasic]) -> set[Tbasic]: ...\n 600 | \n 601 |     def atoms(self, *types: Tbasic | type[Tbasic]) -> set[Basic] | set[Tbasic]:\n 602 |         \"\"\"Returns the atoms that form the current object.\n 603 | \n 604 |         By default, only objects that are truly atomic and cannot\n 605 |         be divided into smaller pieces are returned: symbols, numbers,\n 606 |         and number symbols like I and pi. It is possible to request\n 607 |         atoms of any type, however, as demonstrated below.\n 608 | \n 609 |         Examples\n 610 |         ========\n 611 | \n 612 |         >>> from sympy import I, pi, sin\n 613 |         >>> from sympy.abc import x, y\n 614 |         >>> (1 + x + 2*sin(y + I*pi)).atoms()\n 615 |         {1, 2, I, pi, x, y}\n 616 | \n 617 |         If one or more types are given, the results will contain only\n 618 |         those types of atoms.\n 619 | \n 620 |         >>> from sympy import Number, NumberSymbol, Symbol\n 621 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Symbol)\n 622 |         {x, y}\n 623 | \n 624 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number)\n 625 |         {1, 2}\n 626 | \n 627 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number, NumberSymbol)\n 628 |         {1, 2, pi}\n 629 | \n 630 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number, NumberSymbol, I)\n 631 |         {1, 2, I, pi}\n 632 | \n 633 |         Note that I (imaginary unit) and zoo (complex infinity) are special\n 634 |         types of number symbols and are not part of the NumberSymbol class.\n 635 | \n 636 |         The type can be given implicitly, too:\n 637 | \n 638 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(x) # x is a Symbol\n 639 |         {x, y}\n 640 | \n 641 |         Be careful to check your assumptions when using the implicit option\n 642 |         since ``S(1).is_Integer = True`` but ``type(S(1))`` is ``One``, a special type\n 643 |         of SymPy atom, while ``type(S(2))`` is type ``Integer`` and will find all\n 644 |         integers in an expression:\n 645 | \n 646 |         >>> from sympy import S\n 647 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(S(1))\n 648 |         {1}\n 649 | \n 650 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(S(2))\n 651 |         {1, 2}\n 652 | \n 653 |         Finally, arguments to atoms() can select more than atomic atoms: any\n 654 |         SymPy type (loaded in core/__init__.py) can be listed as an argument\n 655 |         and those types of \"atoms\" as found in scanning the arguments of the\n 656 |         expression recursively:\n 657 | \n 658 |         >>> from sympy import Function, Mul\n 659 |         >>> from sympy.core.function import AppliedUndef\n 660 |         >>> f = Function('f')\n 661 |         >>> (1 + f(x) + 2*sin(y + I*pi)).atoms(Function)\n 662 |         {f(x), sin(y + I*pi)}\n 663 |         >>> (1 + f(x) + 2*sin(y + I*pi)).atoms(AppliedUndef)\n 664 |         {f(x)}\n 665 | \n 666 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Mul)\n 667 |         {I*pi, 2*sin(y + I*pi)}\n 668 | \n 669 |         \"\"\"\n 670 |         nodes = _preorder_traversal(self)\n 671 |         if types:\n 672 |             types2 = tuple([t if isinstance(t, type) else type(t) for t in types])\n 673 |             return {node for node in nodes if isinstance(node, types2)}\n 674 |         else:\n 675 |             return {node for node in nodes if not node.args}\n 676 | \n 677 |     @property\n 678 |     def free_symbols(self) -> set[Basic]:\n 679 |         \"\"\"Return from the atoms of self those which are free symbols.\n 680 | \n 681 |         Not all free symbols are ``Symbol`` (see examples)\n 682 | \n 683 |         For most expressions, all symbols are free symbols. For some classes\n 684 |         this is not true. e.g. Integrals use Symbols for the dummy variables\n 685 |         which are bound variables, so Integral has a method to return all\n 686 |         symbols except those. Derivative keeps track of symbols with respect\n 687 |         to which it will perform a derivative; those are\n 688 |         bound variables, too, so it has its own free_symbols method.\n 689 | \n 690 |         Any other method that uses bound variables should implement a\n 691 |         free_symbols method.\n 692 | \n 693 |         Examples\n 694 |         ========\n 695 | \n 696 |         >>> from sympy import Derivative, Integral, IndexedBase\n 697 |         >>> from sympy.abc import x, y, n\n 698 |         >>> (x + 1).free_symbols\n 699 |         {x}\n 700 |         >>> Integral(x, y).free_symbols\n 701 |         {x, y}\n 702 | \n 703 |         Not all free symbols are actually symbols:\n 704 | \n 705 |         >>> IndexedBase('F')[0].free_symbols\n 706 |         {F, F[0]}\n 707 | \n 708 |         The symbols of differentiation are not included unless they\n 709 |         appear in the expression being differentiated.\n 710 | \n 711 |         >>> Derivative(x + y, y).free_symbols\n 712 |         {x, y}\n 713 |         >>> Derivative(x, y).free_symbols\n 714 |         {x}\n 715 |         >>> Derivative(x, (y, n)).free_symbols\n 716 |         {n, x}\n 717 | \n 718 |         If you want to know if a symbol is in the variables of the\n 719 |         Derivative you can do so as follows:\n 720 | \n 721 |         >>> Derivative(x, y).has_free(y)\n 722 |         True\n 723 |         \"\"\"\n 724 |         empty: set[Basic] = set()\n 725 |         return empty.union(*(a.free_symbols for a in self.args))\n 726 | \n 727 |     @property\n 728 |     def expr_free_symbols(self):\n 729 |         sympy_deprecation_warning(\"\"\"\n 730 |         The expr_free_symbols property is deprecated. Use free_symbols to get\n 731 |         the free symbols of an expression.\n 732 |         \"\"\",\n 733 |             deprecated_since_version=\"1.9\",\n 734 |             active_deprecations_target=\"deprecated-expr-free-symbols\")\n 735 |         return set()\n 736 | \n 737 |     def as_dummy(self) -> \"Self\":\n 738 |         \"\"\"Return the expression with any objects having structurally\n 739 |         bound symbols replaced with unique, canonical symbols within\n 740 |         the object in which they appear and having only the default\n 741 |         assumption for commutativity being True. When applied to a\n 742 |         symbol a new symbol having only the same commutativity will be\n 743 |         returned.\n 744 | \n 745 |         Examples\n 746 |         ========\n 747 | \n 748 |         >>> from sympy import Integral, Symbol\n 749 |         >>> from sympy.abc import x\n 750 |         >>> r = Symbol('r', real=True)\n 751 |         >>> Integral(r, (r, x)).as_dummy()\n 752 |         Integral(_0, (_0, x))\n 753 |         >>> _.variables[0].is_real is None\n 754 |         True\n 755 |         >>> r.as_dummy()\n 756 |         _r\n 757 | \n 758 |         Notes\n 759 |         =====\n 760 | \n 761 |         Any object that has structurally bound variables should have\n 762 |         a property, ``bound_symbols`` that returns those symbols\n 763 |         appearing in the object.\n 764 |         \"\"\"\n 765 |         from .symbol import Dummy, Symbol\n 766 |         def can(x):\n 767 |             # mask free that shadow bound\n 768 |             free = x.free_symbols\n 769 |             bound = set(x.bound_symbols)\n 770 |             d = {i: Dummy() for i in bound & free}\n 771 |             x = x.subs(d)\n 772 |             # replace bound with canonical names\n 773 |             x = x.xreplace(x.canonical_variables)\n 774 |             # return after undoing masking\n 775 |             return x.xreplace({v: k for k, v in d.items()})\n 776 |         if not self.has(Symbol):\n 777 |             return self\n 778 |         return self.replace(\n 779 |             lambda x: hasattr(x, 'bound_symbols'),\n 780 |             can,\n 781 |             simultaneous=False) # type:ignore\n 782 | \n 783 |     @property\n 784 |     def canonical_variables(self) -> dict[Basic, Symbol]:\n 785 |         \"\"\"Return a dictionary mapping any variable defined in\n 786 |         ``self.bound_symbols`` to Symbols that do not clash\n 787 |         with any free symbols in the expression.\n 788 | \n 789 |         Examples\n 790 |         ========\n 791 | \n 792 |         >>> from sympy import Lambda\n 793 |         >>> from sympy.abc import x\n 794 |         >>> Lambda(x, 2*x).canonical_variables\n 795 |         {x: _0}\n 796 |         \"\"\"\n 797 |         bound: list[Basic] | None = getattr(self, 'bound_symbols', None)\n 798 |         if bound is None:\n 799 |             return {}\n 800 |         dums = numbered_symbols('_')\n 801 |         reps = {}\n 802 |         # watch out for free symbol that are not in bound symbols;\n 803 |         # those that are in bound symbols are about to get changed\n 804 | \n 805 |         # XXX: free_symbols only returns particular kinds of expressions that\n 806 |         # generally have a .name attribute. There is not a proper class/type\n 807 |         # that represents this.\n 808 |         names = {i.name for i in self.free_symbols - set(bound)} # type: ignore\n 809 |         for b in bound:\n 810 |             d = next(dums)\n 811 |             if b.is_Symbol:\n 812 |                 while d.name in names:\n 813 |                     d = next(dums)\n 814 |             reps[b] = d\n 815 |         return reps\n 816 | \n 817 |     def rcall(self, *args):\n 818 |         \"\"\"Apply on the argument recursively through the expression tree.\n 819 | \n 820 |         This method is used to simulate a common abuse of notation for\n 821 |         operators. For instance, in SymPy the following will not work:\n 822 | \n 823 |         ``(x+Lambda(y, 2*y))(z) == x+2*z``,\n 824 | \n 825 |         however, you can use:\n 826 | \n 827 |         >>> from sympy import Lambda\n 828 |         >>> from sympy.abc import x, y, z\n 829 |         >>> (x + Lambda(y, 2*y)).rcall(z)\n 830 |         x + 2*z\n 831 |         \"\"\"\n 832 |         if callable(self):\n 833 |             return self(*args)\n 834 |         elif self.args:\n 835 |             newargs = [sub.rcall(*args) for sub in self.args]\n 836 |             return self.func(*newargs)\n 837 |         else:\n 838 |             return self\n 839 | \n 840 |     def is_hypergeometric(self, k):\n 841 |         from sympy.simplify.simplify import hypersimp\n 842 |         from sympy.functions.elementary.piecewise import Piecewise\n 843 |         if self.has(Piecewise):\n 844 |             return None\n 845 |         return hypersimp(self, k) is not None\n 846 | \n 847 |     @property\n 848 |     def is_comparable(self):\n 849 |         \"\"\"Return True if self can be computed to a real number\n 850 |         (or already is a real number) with precision, else False.\n 851 | \n 852 |         Examples\n 853 |         ========\n 854 | \n 855 |         >>> from sympy import exp_polar, pi, I\n 856 |         >>> (I*exp_polar(I*pi/2)).is_comparable\n 857 |         True\n 858 |         >>> (I*exp_polar(I*pi*2)).is_comparable\n 859 |         False\n 860 | \n 861 |         A False result does not mean that `self` cannot be rewritten\n 862 |         into a form that would be comparable. For example, the\n 863 |         difference computed below is zero but without simplification\n 864 |         it does not evaluate to a zero with precision:\n 865 | \n 866 |         >>> e = 2**pi*(1 + 2**pi)\n 867 |         >>> dif = e - e.expand()\n 868 |         >>> dif.is_comparable\n 869 |         False\n 870 |         >>> dif.n(2)._prec\n 871 |         1\n 872 | \n 873 |         \"\"\"\n 874 |         return self._eval_is_comparable()\n 875 | \n 876 |     def _eval_is_comparable(self) -> bool:\n 877 |         # Expr.is_comparable overrides this\n 878 |         return False\n 879 | \n 880 |     @property\n 881 |     def func(self):\n 882 |         \"\"\"\n 883 |         The top-level function in an expression.\n 884 | \n 885 |         The following should hold for all objects::\n 886 | \n 887 |             >> x == x.func(*x.args)\n 888 | \n 889 |         Examples\n 890 |         ========\n 891 | \n 892 |         >>> from sympy.abc import x\n 893 |         >>> a = 2*x\n 894 |         >>> a.func\n 895 |         <class 'sympy.core.mul.Mul'>\n 896 |         >>> a.args\n 897 |         (2, x)\n 898 |         >>> a.func(*a.args)\n 899 |         2*x\n 900 |         >>> a == a.func(*a.args)\n 901 |         True\n 902 | \n 903 |         \"\"\"\n 904 |         return self.__class__\n 905 | \n 906 |     @property\n 907 |     def args(self) -> tuple[Basic, ...]:\n 908 |         \"\"\"Returns a tuple of arguments of 'self'.\n 909 | \n 910 |         Examples\n 911 |         ========\n 912 | \n 913 |         >>> from sympy import cot\n 914 |         >>> from sympy.abc import x, y\n 915 | \n 916 |         >>> cot(x).args\n 917 |         (x,)\n 918 | \n 919 |         >>> cot(x).args[0]\n 920 |         x\n 921 | \n 922 |         >>> (x*y).args\n 923 |         (x, y)\n 924 | \n 925 |         >>> (x*y).args[1]\n 926 |         y\n 927 | \n 928 |         Notes\n 929 |         =====\n 930 | \n 931 |         Never use self._args, always use self.args.\n 932 |         Only use _args in __new__ when creating a new function.\n 933 |         Do not override .args() from Basic (so that it is easy to\n 934 |         change the interface in the future if needed).\n 935 |         \"\"\"\n 936 |         return self._args\n 937 | \n 938 |     @property\n 939 |     def _sorted_args(self):\n 940 |         \"\"\"\n 941 |         The same as ``args``.  Derived classes which do not fix an\n 942 |         order on their arguments should override this method to\n 943 |         produce the sorted representation.\n 944 |         \"\"\"\n 945 |         return self.args\n 946 | \n 947 |     def as_content_primitive(self, radical=False, clear=True):\n 948 |         \"\"\"A stub to allow Basic args (like Tuple) to be skipped when computing\n 949 |         the content and primitive components of an expression.\n 950 | \n 951 |         See Also\n 952 |         ========\n 953 | \n 954 |         sympy.core.expr.Expr.as_content_primitive\n 955 |         \"\"\"\n 956 |         return S.One, self\n 957 | \n 958 |     @overload\n 959 |     def subs(self: Expr, arg1: dict[Expr, Expr | int], arg2: None=None) -> Expr: ... # type: ignore\n 960 |     @overload\n 961 |     def subs(self: Expr, arg1: Expr, arg2: Expr | int) -> Expr: ... # type: ignore\n 962 |     @overload\n 963 |     def subs(self: Basic, arg1: dict[Basic, Basic], arg2: None=None) -> Basic: ...\n 964 |     @overload\n 965 |     def subs(self: Basic, arg1: Basic, arg2: Basic) -> Basic: ...\n 966 | \n 967 |     def subs(self, *args, **kwargs):\n 968 |         \"\"\"\n 969 |         Substitutes old for new in an expression after sympifying args.\n 970 | \n 971 |         `args` is either:\n 972 |           - two arguments, e.g. foo.subs(old, new)\n 973 |           - one iterable argument, e.g. foo.subs(iterable). The iterable may be\n 974 |              o an iterable container with (old, new) pairs. In this case the\n 975 |                replacements are processed in the order given with successive\n 976 |                patterns possibly affecting replacements already made.\n 977 |              o a dict or set whose key/value items correspond to old/new pairs.\n 978 |                In this case the old/new pairs will be sorted by op count and in\n 979 |                case of a tie, by number of args and the default_sort_key. The\n 980 |                resulting sorted list is then processed as an iterable container\n 981 |                (see previous).\n 982 | \n 983 |         If the keyword ``simultaneous`` is True, the subexpressions will not be\n 984 |         evaluated until all the substitutions have been made.\n 985 | \n 986 |         Examples\n 987 |         ========\n 988 | \n 989 |         >>> from sympy import pi, exp, limit, oo\n 990 |         >>> from sympy.abc import x, y\n 991 |         >>> (1 + x*y).subs(x, pi)\n 992 |         pi*y + 1\n 993 |         >>> (1 + x*y).subs({x:pi, y:2})\n 994 |         1 + 2*pi\n 995 |         >>> (1 + x*y).subs([(x, pi), (y, 2)])\n 996 |         1 + 2*pi\n 997 |         >>> reps = [(y, x**2), (x, 2)]\n 998 |         >>> (x + y).subs(reps)\n 999 |         6\n1000 |         >>> (x + y).subs(reversed(reps))\n1001 |         x**2 + 2\n1002 | \n1003 |         >>> (x**2 + x**4).subs(x**2, y)\n1004 |         y**2 + y\n1005 | \n1006 |         To replace only the x**2 but not the x**4, use xreplace:\n1007 | \n1008 |         >>> (x**2 + x**4).xreplace({x**2: y})\n1009 |         x**4 + y\n1010 | \n1011 |         To delay evaluation until all substitutions have been made,\n1012 |         set the keyword ``simultaneous`` to True:\n1013 | \n1014 |         >>> (x/y).subs([(x, 0), (y, 0)])\n1015 |         0\n1016 |         >>> (x/y).subs([(x, 0), (y, 0)], simultaneous=True)\n1017 |         nan\n1018 | \n1019 |         This has the added feature of not allowing subsequent substitutions\n1020 |         to affect those already made:\n1021 | \n1022 |         >>> ((x + y)/y).subs({x + y: y, y: x + y})\n1023 |         1\n1024 |         >>> ((x + y)/y).subs({x + y: y, y: x + y}, simultaneous=True)\n1025 |         y/(x + y)\n1026 | \n1027 |         In order to obtain a canonical result, unordered iterables are\n1028 |         sorted by count_op length, number of arguments and by the\n1029 |         default_sort_key to break any ties. All other iterables are left\n1030 |         unsorted.\n1031 | \n1032 |         >>> from sympy import sqrt, sin, cos\n1033 |         >>> from sympy.abc import a, b, c, d, e\n1034 | \n1035 |         >>> A = (sqrt(sin(2*x)), a)\n1036 |         >>> B = (sin(2*x), b)\n1037 |         >>> C = (cos(2*x), c)\n1038 |         >>> D = (x, d)\n1039 |         >>> E = (exp(x), e)\n1040 | \n1041 |         >>> expr = sqrt(sin(2*x))*sin(exp(x)*x)*cos(2*x) + sin(2*x)\n1042 | \n1043 |         >>> expr.subs(dict([A, B, C, D, E]))\n1044 |         a*c*sin(d*e) + b\n1045 | \n1046 |         The resulting expression represents a literal replacement of the\n1047 |         old arguments with the new arguments. This may not reflect the\n1048 |         limiting behavior of the expression:\n1049 | \n1050 |         >>> (x**3 - 3*x).subs({x: oo})\n1051 |         nan\n1052 | \n1053 |         >>> limit(x**3 - 3*x, x, oo)\n1054 |         oo\n1055 | \n1056 |         If the substitution will be followed by numerical\n1057 |         evaluation, it is better to pass the substitution to\n1058 |         evalf as\n1059 | \n1060 |         >>> (1/x).evalf(subs={x: 3.0}, n=21)\n1061 |         0.333333333333333333333\n1062 | \n1063 |         rather than\n1064 | \n1065 |         >>> (1/x).subs({x: 3.0}).evalf(21)\n1066 |         0.333333333333333314830\n1067 | \n1068 |         as the former will ensure that the desired level of precision is\n1069 |         obtained.\n1070 | \n1071 |         See Also\n1072 |         ========\n1073 |         replace: replacement capable of doing wildcard-like matching,\n1074 |                  parsing of match, and conditional replacements\n1075 |         xreplace: exact node replacement in expr tree; also capable of\n1076 |                   using matching rules\n1077 |         sympy.core.evalf.EvalfMixin.evalf: calculates the given formula to a desired level of precision\n1078 | \n1079 |         \"\"\"\n1080 |         from .containers import Dict\n1081 |         from .symbol import Dummy, Symbol\n1082 |         from .numbers import _illegal\n1083 | \n1084 |         unordered = False\n1085 |         if len(args) == 1:\n1086 | \n1087 |             sequence = args[0]\n1088 |             if isinstance(sequence, set):\n1089 |                 unordered = True\n1090 |             elif isinstance(sequence, (Dict, Mapping)):\n1091 |                 unordered = True\n1092 |                 sequence = sequence.items()\n1093 |             elif not iterable(sequence):\n1094 |                 raise ValueError(filldedent(\"\"\"\n1095 |                    When a single argument is passed to subs\n1096 |                    it should be a dictionary of old: new pairs or an iterable\n1097 |                    of (old, new) tuples.\"\"\"))\n1098 |         elif len(args) == 2:\n1099 |             sequence = [args]\n1100 |         else:\n1101 |             raise ValueError(\"subs accepts either 1 or 2 arguments\")\n1102 | \n1103 |         def sympify_old(old):\n1104 |             if isinstance(old, str):\n1105 |                 # Use Symbol rather than parse_expr for old\n1106 |                 return Symbol(old)\n1107 |             elif isinstance(old, type):\n1108 |                 # Allow a type e.g. Function('f') or sin\n1109 |                 return sympify(old, strict=False)\n1110 |             else:\n1111 |                 return sympify(old, strict=True)\n1112 | \n1113 |         def sympify_new(new):\n1114 |             if isinstance(new, (str, type)):\n1115 |                 # Allow a type or parse a string input\n1116 |                 return sympify(new, strict=False)\n1117 |             else:\n1118 |                 return sympify(new, strict=True)\n1119 | \n1120 |         sequence = [(sympify_old(s1), sympify_new(s2)) for s1, s2 in sequence]\n1121 | \n1122 |         # skip if there is no change\n1123 |         sequence = [(s1, s2) for s1, s2 in sequence if not _aresame(s1, s2)]\n1124 | \n1125 |         simultaneous = kwargs.pop('simultaneous', False)\n1126 | \n1127 |         if unordered:\n1128 |             from .sorting import _nodes, default_sort_key\n1129 |             sequence = dict(sequence)\n1130 |             # order so more complex items are first and items\n1131 |             # of identical complexity are ordered so\n1132 |             # f(x) < f(y) < x < y\n1133 |             # \\___ 2 __/    \\_1_/  <- number of nodes\n1134 |             #\n1135 |             # For more complex ordering use an unordered sequence.\n1136 |             k = list(ordered(sequence, default=False, keys=(\n1137 |                 lambda x: -_nodes(x),\n1138 |                 default_sort_key,\n1139 |                 )))\n1140 |             sequence = [(k, sequence[k]) for k in k]\n1141 |             # do infinities first\n1142 |             if not simultaneous:\n1143 |                 redo = [i for i, seq in enumerate(sequence) if seq[1] in _illegal]\n1144 |                 for i in reversed(redo):\n1145 |                     sequence.insert(0, sequence.pop(i))\n1146 | \n1147 |         if simultaneous:  # XXX should this be the default for dict subs?\n1148 |             reps = {}\n1149 |             rv = self\n1150 |             kwargs['hack2'] = True\n1151 |             m = Dummy('subs_m')\n1152 |             for old, new in sequence:\n1153 |                 com = new.is_commutative\n1154 |                 if com is None:\n1155 |                     com = True\n1156 |                 d = Dummy('subs_d', commutative=com)\n1157 |                 # using d*m so Subs will be used on dummy variables\n1158 |                 # in things like Derivative(f(x, y), x) in which x\n1159 |                 # is both free and bound\n1160 |                 rv = rv._subs(old, d*m, **kwargs)\n1161 |                 if not isinstance(rv, Basic):\n1162 |                     break\n1163 |                 reps[d] = new\n1164 |             reps[m] = S.One  # get rid of m\n1165 |             return rv.xreplace(reps)\n1166 |         else:\n1167 |             rv = self\n1168 |             for old, new in sequence:\n1169 |                 rv = rv._subs(old, new, **kwargs)\n1170 |                 if not isinstance(rv, Basic):\n1171 |                     break\n1172 |             return rv\n1173 | \n1174 |     @cacheit\n1175 |     def _subs(self, old, new, **hints):\n1176 |         \"\"\"Substitutes an expression old -> new.\n1177 | \n1178 |         If self is not equal to old then _eval_subs is called.\n1179 |         If _eval_subs does not want to make any special replacement\n1180 |         then a None is received which indicates that the fallback\n1181 |         should be applied wherein a search for replacements is made\n1182 |         amongst the arguments of self.\n1183 | \n1184 |         >>> from sympy import Add\n1185 |         >>> from sympy.abc import x, y, z\n1186 | \n1187 |         Examples\n1188 |         ========\n1189 | \n1190 |         Add's _eval_subs knows how to target x + y in the following\n1191 |         so it makes the change:\n1192 | \n1193 |         >>> (x + y + z).subs(x + y, 1)\n1194 |         z + 1\n1195 | \n1196 |         Add's _eval_subs does not need to know how to find x + y in\n1197 |         the following:\n1198 | \n1199 |         >>> Add._eval_subs(z*(x + y) + 3, x + y, 1) is None\n1200 |         True\n1201 | \n1202 |         The returned None will cause the fallback routine to traverse the args and\n1203 |         pass the z*(x + y) arg to Mul where the change will take place and the\n1204 |         substitution will succeed:\n1205 | \n1206 |         >>> (z*(x + y) + 3).subs(x + y, 1)\n1207 |         z + 3\n1208 | \n1209 |         ** Developers Notes **\n1210 | \n1211 |         An _eval_subs routine for a class should be written if:\n1212 | \n1213 |             1) any arguments are not instances of Basic (e.g. bool, tuple);\n1214 | \n1215 |             2) some arguments should not be targeted (as in integration\n1216 |                variables);\n1217 | \n1218 |             3) if there is something other than a literal replacement\n1219 |                that should be attempted (as in Piecewise where the condition\n1220 |                may be updated without doing a replacement).\n1221 | \n1222 |         If it is overridden, here are some special cases that might arise:\n1223 | \n1224 |             1) If it turns out that no special change was made and all\n1225 |                the original sub-arguments should be checked for\n1226 |                replacements then None should be returned.\n1227 | \n1228 |             2) If it is necessary to do substitutions on a portion of\n1229 |                the expression then _subs should be called. _subs will\n1230 |                handle the case of any sub-expression being equal to old\n1231 |                (which usually would not be the case) while its fallback\n1232 |                will handle the recursion into the sub-arguments. For\n1233 |                example, after Add's _eval_subs removes some matching terms\n1234 |                it must process the remaining terms so it calls _subs\n1235 |                on each of the un-matched terms and then adds them\n1236 |                onto the terms previously obtained.\n1237 | \n1238 |            3) If the initial expression should remain unchanged then\n1239 |               the original expression should be returned. (Whenever an\n1240 |               expression is returned, modified or not, no further\n1241 |               substitution of old -> new is attempted.) Sum's _eval_subs\n1242 |               routine uses this strategy when a substitution is attempted\n1243 |               on any of its summation variables.\n1244 |         \"\"\"\n1245 | \n1246 |         def fallback(self, old, new):\n1247 |             \"\"\"\n1248 |             Try to replace old with new in any of self's arguments.\n1249 |             \"\"\"\n1250 |             hit = False\n1251 |             args = list(self.args)\n1252 |             for i, arg in enumerate(args):\n1253 |                 if not hasattr(arg, '_eval_subs'):\n1254 |                     continue\n1255 |                 arg = arg._subs(old, new, **hints)\n1256 |                 if not _aresame(arg, args[i]):\n1257 |                     hit = True\n1258 |                     args[i] = arg\n1259 |             if hit:\n1260 |                 rv = self.func(*args)\n1261 |                 hack2 = hints.get('hack2', False)\n1262 |                 if hack2 and self.is_Mul and not rv.is_Mul:  # 2-arg hack\n1263 |                     coeff = S.One\n1264 |                     nonnumber = []\n1265 |                     for i in args:\n1266 |                         if i.is_Number:\n1267 |                             coeff *= i\n1268 |                         else:\n1269 |                             nonnumber.append(i)\n1270 |                     nonnumber = self.func(*nonnumber)\n1271 |                     if coeff is S.One:\n1272 |                         return nonnumber\n1273 |                     else:\n1274 |                         return self.func(coeff, nonnumber, evaluate=False)\n1275 |                 return rv\n1276 |             return self\n1277 | \n1278 |         if _aresame(self, old):\n1279 |             return new\n1280 | \n1281 |         rv = self._eval_subs(old, new)\n1282 |         if rv is None:\n1283 |             rv = fallback(self, old, new)\n1284 |         return rv\n1285 | \n1286 |     def _eval_subs(self, old, new) -> Basic | None:\n1287 |         \"\"\"Override this stub if you want to do anything more than\n1288 |         attempt a replacement of old with new in the arguments of self.\n1289 | \n1290 |         See also\n1291 |         ========\n1292 | \n1293 |         _subs\n1294 |         \"\"\"\n1295 |         return None\n1296 | \n1297 |     def xreplace(self, rule):\n1298 |         \"\"\"\n1299 |         Replace occurrences of objects within the expression.\n1300 | \n1301 |         Parameters\n1302 |         ==========\n1303 | \n1304 |         rule : dict-like\n1305 |             Expresses a replacement rule\n1306 | \n1307 |         Returns\n1308 |         =======\n1309 | \n1310 |         xreplace : the result of the replacement\n1311 | \n1312 |         Examples\n1313 |         ========\n1314 | \n1315 |         >>> from sympy import symbols, pi, exp\n1316 |         >>> x, y, z = symbols('x y z')\n1317 |         >>> (1 + x*y).xreplace({x: pi})\n1318 |         pi*y + 1\n1319 |         >>> (1 + x*y).xreplace({x: pi, y: 2})\n1320 |         1 + 2*pi\n1321 | \n1322 |         Replacements occur only if an entire node in the expression tree is\n1323 |         matched:\n1324 | \n1325 |         >>> (x*y + z).xreplace({x*y: pi})\n1326 |         z + pi\n1327 |         >>> (x*y*z).xreplace({x*y: pi})\n1328 |         x*y*z\n1329 |         >>> (2*x).xreplace({2*x: y, x: z})\n1330 |         y\n1331 |         >>> (2*2*x).xreplace({2*x: y, x: z})\n1332 |         4*z\n1333 |         >>> (x + y + 2).xreplace({x + y: 2})\n1334 |         x + y + 2\n1335 |         >>> (x + 2 + exp(x + 2)).xreplace({x + 2: y})\n1336 |         x + exp(y) + 2\n1337 | \n1338 |         xreplace does not differentiate between free and bound symbols. In the\n1339 |         following, subs(x, y) would not change x since it is a bound symbol,\n1340 |         but xreplace does:\n1341 | \n1342 |         >>> from sympy import Integral\n1343 |         >>> Integral(x, (x, 1, 2*x)).xreplace({x: y})\n1344 |         Integral(y, (y, 1, 2*y))\n1345 | \n1346 |         Trying to replace x with an expression raises an error:\n1347 | \n1348 |         >>> Integral(x, (x, 1, 2*x)).xreplace({x: 2*y}) # doctest: +SKIP\n1349 |         ValueError: Invalid limits given: ((2*y, 1, 4*y),)\n1350 | \n1351 |         See Also\n1352 |         ========\n1353 |         replace: replacement capable of doing wildcard-like matching,\n1354 |                  parsing of match, and conditional replacements\n1355 |         subs: substitution of subexpressions as defined by the objects\n1356 |               themselves.\n1357 | \n1358 |         \"\"\"\n1359 |         value, _ = self._xreplace(rule)\n1360 |         return value\n1361 | \n1362 |     def _xreplace(self, rule):\n1363 |         \"\"\"\n1364 |         Helper for xreplace. Tracks whether a replacement actually occurred.\n1365 |         \"\"\"\n1366 |         if self in rule:\n1367 |             return rule[self], True\n1368 |         elif rule:\n1369 |             args = []\n1370 |             changed = False\n1371 |             for a in self.args:\n1372 |                 _xreplace = getattr(a, '_xreplace', None)\n1373 |                 if _xreplace is not None:\n1374 |                     a_xr = _xreplace(rule)\n1375 |                     args.append(a_xr[0])\n1376 |                     changed |= a_xr[1]\n1377 |                 else:\n1378 |                     args.append(a)\n1379 |             args = tuple(args)\n1380 |             if changed:\n1381 |                 return self.func(*args), True\n1382 |         return self, False\n1383 | \n1384 |     @cacheit\n1385 |     def has(self, *patterns):\n1386 |         \"\"\"\n1387 |         Test whether any subexpression matches any of the patterns.\n1388 | \n1389 |         Examples\n1390 |         ========\n1391 | \n1392 |         >>> from sympy import sin\n1393 |         >>> from sympy.abc import x, y, z\n1394 |         >>> (x**2 + sin(x*y)).has(z)\n1395 |         False\n1396 |         >>> (x**2 + sin(x*y)).has(x, y, z)\n1397 |         True\n1398 |         >>> x.has(x)\n1399 |         True\n1400 | \n1401 |         Note ``has`` is a structural algorithm with no knowledge of\n1402 |         mathematics. Consider the following half-open interval:\n1403 | \n1404 |         >>> from sympy import Interval\n1405 |         >>> i = Interval.Lopen(0, 5); i\n1406 |         Interval.Lopen(0, 5)\n1407 |         >>> i.args\n1408 |         (0, 5, True, False)\n1409 |         >>> i.has(4)  # there is no \"4\" in the arguments\n1410 |         False\n1411 |         >>> i.has(0)  # there *is* a \"0\" in the arguments\n1412 |         True\n1413 | \n1414 |         Instead, use ``contains`` to determine whether a number is in the\n1415 |         interval or not:\n1416 | \n1417 |         >>> i.contains(4)\n1418 |         True\n1419 |         >>> i.contains(0)\n1420 |         False\n1421 | \n1422 | \n1423 |         Note that ``expr.has(*patterns)`` is exactly equivalent to\n1424 |         ``any(expr.has(p) for p in patterns)``. In particular, ``False`` is\n1425 |         returned when the list of patterns is empty.\n1426 | \n1427 |         >>> x.has()\n1428 |         False\n1429 | \n1430 |         \"\"\"\n1431 |         return self._has(iterargs, *patterns)\n1432 | \n1433 |     def has_xfree(self, s: set[Basic]):\n1434 |         \"\"\"Return True if self has any of the patterns in s as a\n1435 |         free argument, else False. This is like `Basic.has_free`\n1436 |         but this will only report exact argument matches.\n1437 | \n1438 |         Examples\n1439 |         ========\n1440 | \n1441 |         >>> from sympy import Function\n1442 |         >>> from sympy.abc import x, y\n1443 |         >>> f = Function('f')\n1444 |         >>> f(x).has_xfree({f})\n1445 |         False\n1446 |         >>> f(x).has_xfree({f(x)})\n1447 |         True\n1448 |         >>> f(x + 1).has_xfree({x})\n1449 |         True\n1450 |         >>> f(x + 1).has_xfree({x + 1})\n1451 |         True\n1452 |         >>> f(x + y + 1).has_xfree({x + 1})\n1453 |         False\n1454 |         \"\"\"\n1455 |         # protect O(1) containment check by requiring:\n1456 |         if type(s) is not set:\n1457 |             raise TypeError('expecting set argument')\n1458 |         return any(a in s for a in iterfreeargs(self))\n1459 | \n1460 |     @cacheit\n1461 |     def has_free(self, *patterns):\n1462 |         \"\"\"Return True if self has object(s) ``x`` as a free expression\n1463 |         else False.\n1464 | \n1465 |         Examples\n1466 |         ========\n1467 | \n1468 |         >>> from sympy import Integral, Function\n1469 |         >>> from sympy.abc import x, y\n1470 |         >>> f = Function('f')\n1471 |         >>> g = Function('g')\n1472 |         >>> expr = Integral(f(x), (f(x), 1, g(y)))\n1473 |         >>> expr.free_symbols\n1474 |         {y}\n1475 |         >>> expr.has_free(g(y))\n1476 |         True\n1477 |         >>> expr.has_free(*(x, f(x)))\n1478 |         False\n1479 | \n1480 |         This works for subexpressions and types, too:\n1481 | \n1482 |         >>> expr.has_free(g)\n1483 |         True\n1484 |         >>> (x + y + 1).has_free(y + 1)\n1485 |         True\n1486 |         \"\"\"\n1487 |         if not patterns:\n1488 |             return False\n1489 |         p0 = patterns[0]\n1490 |         if len(patterns) == 1 and iterable(p0) and not isinstance(p0, Basic):\n1491 |             # Basic can contain iterables (though not non-Basic, ideally)\n1492 |             # but don't encourage mixed passing patterns\n1493 |             raise TypeError(filldedent('''\n1494 |                 Expecting 1 or more Basic args, not a single\n1495 |                 non-Basic iterable. Don't forget to unpack\n1496 |                 iterables: `eq.has_free(*patterns)`'''))\n1497 |         # try quick test first\n1498 |         s = set(patterns)\n1499 |         rv = self.has_xfree(s)\n1500 |         if rv:\n1501 |             return rv\n1502 |         # now try matching through slower _has\n1503 |         return self._has(iterfreeargs, *patterns)\n1504 | \n1505 |     def _has(self, iterargs, *patterns):\n1506 |         # separate out types and unhashable objects\n1507 |         type_set = set()  # only types\n1508 |         p_set = set()  # hashable non-types\n1509 |         for p in patterns:\n1510 |             if isinstance(p, type) and issubclass(p, Basic):\n1511 |                 type_set.add(p)\n1512 |                 continue\n1513 |             if not isinstance(p, Basic):\n1514 |                 try:\n1515 |                     p = _sympify(p)\n1516 |                 except SympifyError:\n1517 |                     continue  # Basic won't have this in it\n1518 |             p_set.add(p)  # fails if object defines __eq__ but\n1519 |                           # doesn't define __hash__\n1520 |         types = tuple(type_set)   #\n1521 |         for i in iterargs(self):  #\n1522 |             if i in p_set:        # <--- here, too\n1523 |                 return True\n1524 |             if isinstance(i, types):\n1525 |                 return True\n1526 | \n1527 |         # use matcher if defined, e.g. operations defines\n1528 |         # matcher that checks for exact subset containment,\n1529 |         # (x + y + 1).has(x + 1) -> True\n1530 |         for i in p_set - type_set:  # types don't have matchers\n1531 |             if not hasattr(i, '_has_matcher'):\n1532 |                 continue\n1533 |             match = i._has_matcher()\n1534 |             if any(match(arg) for arg in iterargs(self)):\n1535 |                 return True\n1536 | \n1537 |         # no success\n1538 |         return False\n1539 | \n1540 |     def replace(self, query, value, map=False, simultaneous=True, exact=None) -> Basic:\n1541 |         \"\"\"\n1542 |         Replace matching subexpressions of ``self`` with ``value``.\n1543 | \n1544 |         If ``map = True`` then also return the mapping {old: new} where ``old``\n1545 |         was a sub-expression found with query and ``new`` is the replacement\n1546 |         value for it. If the expression itself does not match the query, then\n1547 |         the returned value will be ``self.xreplace(map)`` otherwise it should\n1548 |         be ``self.subs(ordered(map.items()))``.\n1549 | \n1550 |         Traverses an expression tree and performs replacement of matching\n1551 |         subexpressions from the bottom to the top of the tree. The default\n1552 |         approach is to do the replacement in a simultaneous fashion so\n1553 |         changes made are targeted only once. If this is not desired or causes\n1554 |         problems, ``simultaneous`` can be set to False.\n1555 | \n1556 |         In addition, if an expression containing more than one Wild symbol\n1557 |         is being used to match subexpressions and the ``exact`` flag is None\n1558 |         it will be set to True so the match will only succeed if all non-zero\n1559 |         values are received for each Wild that appears in the match pattern.\n1560 |         Setting this to False accepts a match of 0; while setting it True\n1561 |         accepts all matches that have a 0 in them. See example below for\n1562 |         cautions.\n1563 | \n1564 |         The list of possible combinations of queries and replacement values\n1565 |         is listed below:\n1566 | \n1567 |         Examples\n1568 |         ========\n1569 | \n1570 |         Initial setup\n1571 | \n1572 |         >>> from sympy import log, sin, cos, tan, Wild, Mul, Add\n1573 |         >>> from sympy.abc import x, y\n1574 |         >>> f = log(sin(x)) + tan(sin(x**2))\n1575 | \n1576 |         1.1. type -> type\n1577 |             obj.replace(type, newtype)\n1578 | \n1579 |             When object of type ``type`` is found, replace it with the\n1580 |             result of passing its argument(s) to ``newtype``.\n1581 | \n1582 |             >>> f.replace(sin, cos)\n1583 |             log(cos(x)) + tan(cos(x**2))\n1584 |             >>> sin(x).replace(sin, cos, map=True)\n1585 |             (cos(x), {sin(x): cos(x)})\n1586 |             >>> (x*y).replace(Mul, Add)\n1587 |             x + y\n1588 | \n1589 |         1.2. type -> func\n1590 |             obj.replace(type, func)\n1591 | \n1592 |             When object of type ``type`` is found, apply ``func`` to its\n1593 |             argument(s). ``func`` must be written to handle the number\n1594 |             of arguments of ``type``.\n1595 | \n1596 |             >>> f.replace(sin, lambda arg: sin(2*arg))\n1597 |             log(sin(2*x)) + tan(sin(2*x**2))\n1598 |             >>> (x*y).replace(Mul, lambda *args: sin(2*Mul(*args)))\n1599 |             sin(2*x*y)\n1600 | \n1601 |         2.1. pattern -> expr\n1602 |             obj.replace(pattern(wild), expr(wild))\n1603 | \n1604 |             Replace subexpressions matching ``pattern`` with the expression\n1605 |             written in terms of the Wild symbols in ``pattern``.\n1606 | \n1607 |             >>> a, b = map(Wild, 'ab')\n1608 |             >>> f.replace(sin(a), tan(a))\n1609 |             log(tan(x)) + tan(tan(x**2))\n1610 |             >>> f.replace(sin(a), tan(a/2))\n1611 |             log(tan(x/2)) + tan(tan(x**2/2))\n1612 |             >>> f.replace(sin(a), a)\n1613 |             log(x) + tan(x**2)\n1614 |             >>> (x*y).replace(a*x, a)\n1615 |             y\n1616 | \n1617 |             Matching is exact by default when more than one Wild symbol\n1618 |             is used: matching fails unless the match gives non-zero\n1619 |             values for all Wild symbols:\n1620 | \n1621 |             >>> (2*x + y).replace(a*x + b, b - a)\n1622 |             y - 2\n1623 |             >>> (2*x).replace(a*x + b, b - a)\n1624 |             2*x\n1625 | \n1626 |             When set to False, the results may be non-intuitive:\n1627 | \n1628 |             >>> (2*x).replace(a*x + b, b - a, exact=False)\n1629 |             2/x\n1630 | \n1631 |         2.2. pattern -> func\n1632 |             obj.replace(pattern(wild), lambda wild: expr(wild))\n1633 | \n1634 |             All behavior is the same as in 2.1 but now a function in terms of\n1635 |             pattern variables is used rather than an expression:\n1636 | \n1637 |             >>> f.replace(sin(a), lambda a: sin(2*a))\n1638 |             log(sin(2*x)) + tan(sin(2*x**2))\n1639 | \n1640 |         3.1. func -> func\n1641 |             obj.replace(filter, func)\n1642 | \n1643 |             Replace subexpression ``e`` with ``func(e)`` if ``filter(e)``\n1644 |             is True.\n1645 | \n1646 |             >>> g = 2*sin(x**3)\n1647 |             >>> g.replace(lambda expr: expr.is_Number, lambda expr: expr**2)\n1648 |             4*sin(x**9)\n1649 | \n1650 |         The expression itself is also targeted by the query but is done in\n1651 |         such a fashion that changes are not made twice.\n1652 | \n1653 |             >>> e = x*(x*y + 1)\n1654 |             >>> e.replace(lambda x: x.is_Mul, lambda x: 2*x)\n1655 |             2*x*(2*x*y + 1)\n1656 | \n1657 |         When matching a single symbol, `exact` will default to True, but\n1658 |         this may or may not be the behavior that is desired:\n1659 | \n1660 |         Here, we want `exact=False`:\n1661 | \n1662 |         >>> from sympy import Function\n1663 |         >>> f = Function('f')\n1664 |         >>> e = f(1) + f(0)\n1665 |         >>> q = f(a), lambda a: f(a + 1)\n1666 |         >>> e.replace(*q, exact=False)\n1667 |         f(1) + f(2)\n1668 |         >>> e.replace(*q, exact=True)\n1669 |         f(0) + f(2)\n1670 | \n1671 |         But here, the nature of matching makes selecting\n1672 |         the right setting tricky:\n1673 | \n1674 |         >>> e = x**(1 + y)\n1675 |         >>> (x**(1 + y)).replace(x**(1 + a), lambda a: x**-a, exact=False)\n1676 |         x\n1677 |         >>> (x**(1 + y)).replace(x**(1 + a), lambda a: x**-a, exact=True)\n1678 |         x**(-x - y + 1)\n1679 |         >>> (x**y).replace(x**(1 + a), lambda a: x**-a, exact=False)\n1680 |         x\n1681 |         >>> (x**y).replace(x**(1 + a), lambda a: x**-a, exact=True)\n1682 |         x**(1 - y)\n1683 | \n1684 |         It is probably better to use a different form of the query\n1685 |         that describes the target expression more precisely:\n1686 | \n1687 |         >>> (1 + x**(1 + y)).replace(\n1688 |         ... lambda x: x.is_Pow and x.exp.is_Add and x.exp.args[0] == 1,\n1689 |         ... lambda x: x.base**(1 - (x.exp - 1)))\n1690 |         ...\n1691 |         x**(1 - y) + 1\n1692 | \n1693 |         See Also\n1694 |         ========\n1695 | \n1696 |         subs: substitution of subexpressions as defined by the objects\n1697 |               themselves.\n1698 |         xreplace: exact node replacement in expr tree; also capable of\n1699 |                   using matching rules\n1700 | \n1701 |         \"\"\"\n1702 | \n1703 |         try:\n1704 |             query = _sympify(query)\n1705 |         except SympifyError:\n1706 |             pass\n1707 |         try:\n1708 |             value = _sympify(value)\n1709 |         except SympifyError:\n1710 |             pass\n1711 |         if isinstance(query, type):\n1712 |             _query = lambda expr: isinstance(expr, query)\n1713 | \n1714 |             if isinstance(value, type):\n1715 |                 _value = lambda expr, result: value(*expr.args)\n1716 |             elif callable(value):\n1717 |                 _value = lambda expr, result: value(*expr.args)\n1718 |             else:\n1719 |                 raise TypeError(\n1720 |                     \"given a type, replace() expects another \"\n1721 |                     \"type or a callable\")\n1722 |         elif isinstance(query, Basic):\n1723 |             _query = lambda expr: expr.match(query)\n1724 |             if exact is None:\n1725 |                 from .symbol import Wild\n1726 |                 exact = (len(query.atoms(Wild)) > 1)\n1727 | \n1728 |             if isinstance(value, Basic):\n1729 |                 if exact:\n1730 |                     _value = lambda expr, result: (value.subs(result)\n1731 |                         if all(result.values()) else expr)\n1732 |                 else:\n1733 |                     _value = lambda expr, result: value.subs(result)\n1734 |             elif callable(value):\n1735 |                 # match dictionary keys get the trailing underscore stripped\n1736 |                 # from them and are then passed as keywords to the callable;\n1737 |                 # if ``exact`` is True, only accept match if there are no null\n1738 |                 # values amongst those matched.\n1739 |                 if exact:\n1740 |                     _value = lambda expr, result: (value(**\n1741 |                         {str(k)[:-1]: v for k, v in result.items()})\n1742 |                         if all(val for val in result.values()) else expr)\n1743 |                 else:\n1744 |                     _value = lambda expr, result: value(**\n1745 |                         {str(k)[:-1]: v for k, v in result.items()})\n1746 |             else:\n1747 |                 raise TypeError(\n1748 |                     \"given an expression, replace() expects \"\n1749 |                     \"another expression or a callable\")\n1750 |         elif callable(query):\n1751 |             _query = query\n1752 | \n1753 |             if callable(value):\n1754 |                 _value = lambda expr, result: value(expr)\n1755 |             else:\n1756 |                 raise TypeError(\n1757 |                     \"given a callable, replace() expects \"\n1758 |                     \"another callable\")\n1759 |         else:\n1760 |             raise TypeError(\n1761 |                 \"first argument to replace() must be a \"\n1762 |                 \"type, an expression or a callable\")\n1763 | \n1764 |         def walk(rv, F):\n1765 |             \"\"\"Apply ``F`` to args and then to result.\n1766 |             \"\"\"\n1767 |             args = getattr(rv, 'args', None)\n1768 |             if args is not None:\n1769 |                 if args:\n1770 |                     newargs = tuple([walk(a, F) for a in args])\n1771 |                     if args != newargs:\n1772 |                         rv = rv.func(*newargs)\n1773 |                         if simultaneous:\n1774 |                             # if rv is something that was already\n1775 |                             # matched (that was changed) then skip\n1776 |                             # applying F again\n1777 |                             for i, e in enumerate(args):\n1778 |                                 if rv == e and e != newargs[i]:\n1779 |                                     return rv\n1780 |                 rv = F(rv)\n1781 |             return rv\n1782 | \n1783 |         mapping = {}  # changes that took place\n1784 | \n1785 |         def rec_replace(expr):\n1786 |             result = _query(expr)\n1787 |             if result or result == {}:\n1788 |                 v = _value(expr, result)\n1789 |                 if v is not None and v != expr:\n1790 |                     if map:\n1791 |                         mapping[expr] = v\n1792 |                     expr = v\n1793 |             return expr\n1794 | \n1795 |         rv = walk(self, rec_replace)\n1796 |         return (rv, mapping) if map else rv # type: ignore\n1797 | \n1798 |     def find(self, query, group=False):\n1799 |         \"\"\"Find all subexpressions matching a query.\"\"\"\n1800 |         query = _make_find_query(query)\n1801 |         results = list(filter(query, _preorder_traversal(self)))\n1802 | \n1803 |         if not group:\n1804 |             return set(results)\n1805 |         else:\n1806 |             groups = {}\n1807 | \n1808 |             for result in results:\n1809 |                 if result in groups:\n1810 |                     groups[result] += 1\n1811 |                 else:\n1812 |                     groups[result] = 1\n1813 | \n1814 |             return groups\n1815 | \n1816 |     def count(self, query):\n1817 |         \"\"\"Count the number of matching subexpressions.\"\"\"\n1818 |         query = _make_find_query(query)\n1819 |         return sum(bool(query(sub)) for sub in _preorder_traversal(self))\n1820 | \n1821 |     def matches(self, expr, repl_dict=None, old=False):\n1822 |         \"\"\"\n1823 |         Helper method for match() that looks for a match between Wild symbols\n1824 |         in self and expressions in expr.\n1825 | \n1826 |         Examples\n1827 |         ========\n1828 | \n1829 |         >>> from sympy import symbols, Wild, Basic\n1830 |         >>> a, b, c = symbols('a b c')\n1831 |         >>> x = Wild('x')\n1832 |         >>> Basic(a + x, x).matches(Basic(a + b, c)) is None\n1833 |         True\n1834 |         >>> Basic(a + x, x).matches(Basic(a + b + c, b + c))\n1835 |         {x_: b + c}\n1836 |         \"\"\"\n1837 |         expr = sympify(expr)\n1838 |         if not isinstance(expr, self.__class__):\n1839 |             return None\n1840 | \n1841 |         if repl_dict is None:\n1842 |             repl_dict = {}\n1843 |         else:\n1844 |             repl_dict = repl_dict.copy()\n1845 | \n1846 |         if self == expr:\n1847 |             return repl_dict\n1848 | \n1849 |         if len(self.args) != len(expr.args):\n1850 |             return None\n1851 | \n1852 |         d = repl_dict  # already a copy\n1853 |         for arg, other_arg in zip(self.args, expr.args):\n1854 |             if arg == other_arg:\n1855 |                 continue\n1856 |             if arg.is_Relational:\n1857 |                 try:\n1858 |                     d = arg.xreplace(d).matches(other_arg, d, old=old)\n1859 |                 except TypeError: # Should be InvalidComparisonError when introduced\n1860 |                     d = None\n1861 |             else:\n1862 |                     d = arg.xreplace(d).matches(other_arg, d, old=old)\n1863 |             if d is None:\n1864 |                 return None\n1865 |         return d\n1866 | \n1867 |     def match(self, pattern, old=False):\n1868 |         \"\"\"\n1869 |         Pattern matching.\n1870 | \n1871 |         Wild symbols match all.\n1872 | \n1873 |         Return ``None`` when expression (self) does not match with pattern.\n1874 |         Otherwise return a dictionary such that::\n1875 | \n1876 |           pattern.xreplace(self.match(pattern)) == self\n1877 | \n1878 |         Examples\n1879 |         ========\n1880 | \n1881 |         >>> from sympy import Wild, Sum\n1882 |         >>> from sympy.abc import x, y\n1883 |         >>> p = Wild(\"p\")\n1884 |         >>> q = Wild(\"q\")\n1885 |         >>> r = Wild(\"r\")\n1886 |         >>> e = (x+y)**(x+y)\n1887 |         >>> e.match(p**p)\n1888 |         {p_: x + y}\n1889 |         >>> e.match(p**q)\n1890 |         {p_: x + y, q_: x + y}\n1891 |         >>> e = (2*x)**2\n1892 |         >>> e.match(p*q**r)\n1893 |         {p_: 4, q_: x, r_: 2}\n1894 |         >>> (p*q**r).xreplace(e.match(p*q**r))\n1895 |         4*x**2\n1896 | \n1897 |         Since match is purely structural expressions that are equivalent up to\n1898 |         bound symbols will not match:\n1899 | \n1900 |         >>> print(Sum(x, (x, 1, 2)).match(Sum(y, (y, 1, p))))\n1901 |         None\n1902 | \n1903 |         An expression with bound symbols can be matched if the pattern uses\n1904 |         a distinct ``Wild`` for each bound symbol:\n1905 | \n1906 |         >>> Sum(x, (x, 1, 2)).match(Sum(q, (q, 1, p)))\n1907 |         {p_: 2, q_: x}\n1908 | \n1909 |         The ``old`` flag will give the old-style pattern matching where\n1910 |         expressions and patterns are essentially solved to give the match. Both\n1911 |         of the following give None unless ``old=True``:\n1912 | \n1913 |         >>> (x - 2).match(p - x, old=True)\n1914 |         {p_: 2*x - 2}\n1915 |         >>> (2/x).match(p*x, old=True)\n1916 |         {p_: 2/x**2}\n1917 | \n1918 |         See Also\n1919 |         ========\n1920 | \n1921 |         matches: pattern.matches(expr) is the same as expr.match(pattern)\n1922 |         xreplace: exact structural replacement\n1923 |         replace: structural replacement with pattern matching\n1924 |         Wild: symbolic placeholders for expressions in pattern matching\n1925 |         \"\"\"\n1926 |         pattern = sympify(pattern)\n1927 |         return pattern.matches(self, old=old)\n1928 | \n1929 |     def count_ops(self, visual=False):\n1930 |         \"\"\"Wrapper for count_ops that returns the operation count.\"\"\"\n1931 |         from .function import count_ops\n1932 |         return count_ops(self, visual)\n1933 | \n1934 |     def doit(self, **hints):\n1935 |         \"\"\"Evaluate objects that are not evaluated by default like limits,\n1936 |         integrals, sums and products. All objects of this kind will be\n1937 |         evaluated recursively, unless some species were excluded via 'hints'\n1938 |         or unless the 'deep' hint was set to 'False'.\n1939 | \n1940 |         >>> from sympy import Integral\n1941 |         >>> from sympy.abc import x\n1942 | \n1943 |         >>> 2*Integral(x, x)\n1944 |         2*Integral(x, x)\n1945 | \n1946 |         >>> (2*Integral(x, x)).doit()\n1947 |         x**2\n1948 | \n1949 |         >>> (2*Integral(x, x)).doit(deep=False)\n1950 |         2*Integral(x, x)\n1951 | \n1952 |         \"\"\"\n1953 |         if hints.get('deep', True):\n1954 |             terms = [term.doit(**hints) if isinstance(term, Basic) else term\n1955 |                                          for term in self.args]\n1956 |             return self.func(*terms)\n1957 |         else:\n1958 |             return self\n1959 | \n1960 |     @overload\n1961 |     def simplify(self: Expr, **kwargs) -> Expr: ... # type: ignore\n1962 |     @overload\n1963 |     def simplify(self: Basic, **kwargs) -> Basic: ...\n1964 | \n1965 |     def simplify(self, **kwargs):\n1966 |         \"\"\"See the simplify function in sympy.simplify\"\"\"\n1967 |         from sympy.simplify.simplify import simplify\n1968 |         return simplify(self, **kwargs)\n1969 | \n1970 |     def refine(self, assumption=True):\n1971 |         \"\"\"See the refine function in sympy.assumptions\"\"\"\n1972 |         from sympy.assumptions.refine import refine\n1973 |         return refine(self, assumption)\n1974 | \n1975 |     def _eval_derivative_n_times(self, s, n):\n1976 |         # This is the default evaluator for derivatives (as called by `diff`\n1977 |         # and `Derivative`), it will attempt a loop to derive the expression\n1978 |         # `n` times by calling the corresponding `_eval_derivative` method,\n1979 |         # while leaving the derivative unevaluated if `n` is symbolic.  This\n1980 |         # method should be overridden if the object has a closed form for its\n1981 |         # symbolic n-th derivative.\n1982 |         from .numbers import Integer\n1983 |         if isinstance(n, (int, Integer)):\n1984 |             obj = self\n1985 |             for i in range(n):\n1986 |                 prev = obj\n1987 |                 obj = obj._eval_derivative(s)\n1988 |                 if obj is None:\n1989 |                     return None\n1990 |                 elif obj == prev:\n1991 |                     break\n1992 |             return obj\n1993 |         else:\n1994 |             return None\n1995 | \n1996 |     def rewrite(self, *args, deep=True, **hints):\n1997 |         \"\"\"\n1998 |         Rewrite *self* using a defined rule.\n1999 | \n2000 |         Rewriting transforms an expression to another, which is mathematically\n2001 |         equivalent but structurally different. For example you can rewrite\n2002 |         trigonometric functions as complex exponentials or combinatorial\n2003 |         functions as gamma function.\n2004 | \n2005 |         This method takes a *pattern* and a *rule* as positional arguments.\n2006 |         *pattern* is optional parameter which defines the types of expressions\n2007 |         that will be transformed. If it is not passed, all possible expressions\n2008 |         will be rewritten. *rule* defines how the expression will be rewritten.\n2009 | \n2010 |         Parameters\n2011 |         ==========\n2012 | \n2013 |         args : Expr\n2014 |             A *rule*, or *pattern* and *rule*.\n2015 |             - *pattern* is a type or an iterable of types.\n2016 |             - *rule* can be any object.\n2017 | \n2018 |         deep : bool, optional\n2019 |             If ``True``, subexpressions are recursively transformed. Default is\n2020 |             ``True``.\n2021 | \n2022 |         Examples\n2023 |         ========\n2024 | \n2025 |         If *pattern* is unspecified, all possible expressions are transformed.\n2026 | \n2027 |         >>> from sympy import cos, sin, exp, I\n2028 |         >>> from sympy.abc import x\n2029 |         >>> expr = cos(x) + I*sin(x)\n2030 |         >>> expr.rewrite(exp)\n2031 |         exp(I*x)\n2032 | \n2033 |         Pattern can be a type or an iterable of types.\n2034 | \n2035 |         >>> expr.rewrite(sin, exp)\n2036 |         exp(I*x)/2 + cos(x) - exp(-I*x)/2\n2037 |         >>> expr.rewrite([cos,], exp)\n2038 |         exp(I*x)/2 + I*sin(x) + exp(-I*x)/2\n2039 |         >>> expr.rewrite([cos, sin], exp)\n2040 |         exp(I*x)\n2041 | \n2042 |         Rewriting behavior can be implemented by defining ``_eval_rewrite()``\n2043 |         method.\n2044 | \n2045 |         >>> from sympy import Expr, sqrt, pi\n2046 |         >>> class MySin(Expr):\n2047 |         ...     def _eval_rewrite(self, rule, args, **hints):\n2048 |         ...         x, = args\n2049 |         ...         if rule == cos:\n2050 |         ...             return cos(pi/2 - x, evaluate=False)\n2051 |         ...         if rule == sqrt:\n2052 |         ...             return sqrt(1 - cos(x)**2)\n2053 |         >>> MySin(MySin(x)).rewrite(cos)\n2054 |         cos(-cos(-x + pi/2) + pi/2)\n2055 |         >>> MySin(x).rewrite(sqrt)\n2056 |         sqrt(1 - cos(x)**2)\n2057 | \n2058 |         Defining ``_eval_rewrite_as_[...]()`` method is supported for backwards\n2059 |         compatibility reason. This may be removed in the future and using it is\n2060 |         discouraged.\n2061 | \n2062 |         >>> class MySin(Expr):\n2063 |         ...     def _eval_rewrite_as_cos(self, *args, **hints):\n2064 |         ...         x, = args\n2065 |         ...         return cos(pi/2 - x, evaluate=False)\n2066 |         >>> MySin(x).rewrite(cos)\n2067 |         cos(-x + pi/2)\n2068 | \n2069 |         \"\"\"\n2070 |         if not args:\n2071 |             return self\n2072 | \n2073 |         hints.update(deep=deep)\n2074 | \n2075 |         pattern = args[:-1]\n2076 |         rule = args[-1]\n2077 | \n2078 |         # support old design by _eval_rewrite_as_[...] method\n2079 |         if isinstance(rule, str):\n2080 |             method = \"_eval_rewrite_as_%s\" % rule\n2081 |         elif hasattr(rule, \"__name__\"):\n2082 |             # rule is class or function\n2083 |             clsname = rule.__name__\n2084 |             method = \"_eval_rewrite_as_%s\" % clsname\n2085 |         else:\n2086 |             # rule is instance\n2087 |             clsname = rule.__class__.__name__\n2088 |             method = \"_eval_rewrite_as_%s\" % clsname\n2089 | \n2090 |         if pattern:\n2091 |             if iterable(pattern[0]):\n2092 |                 pattern = pattern[0]\n2093 |             pattern = tuple(p for p in pattern if self.has(p))\n2094 |             if not pattern:\n2095 |                 return self\n2096 |         # hereafter, empty pattern is interpreted as all pattern.\n2097 | \n2098 |         return self._rewrite(pattern, rule, method, **hints)\n2099 | \n2100 |     def _rewrite(self, pattern, rule, method, **hints):\n2101 |         deep = hints.pop('deep', True)\n2102 |         if deep:\n2103 |             args = [a._rewrite(pattern, rule, method, **hints)\n2104 |                     for a in self.args]\n2105 |         else:\n2106 |             args = self.args\n2107 |         if not pattern or any(isinstance(self, p) for p in pattern):\n2108 |             meth = getattr(self, method, None)\n2109 |             if meth is not None:\n2110 |                 rewritten = meth(*args, **hints)\n2111 |             else:\n2112 |                 rewritten = self._eval_rewrite(rule, args, **hints)\n2113 |             if rewritten is not None:\n2114 |                 return rewritten\n2115 |         if not args:\n2116 |             return self\n2117 |         return self.func(*args)\n2118 | \n2119 |     def _eval_rewrite(self, rule, args, **hints):\n2120 |         return None\n2121 | \n2122 |     _constructor_postprocessor_mapping = {}  # type: ignore\n2123 | \n2124 |     @classmethod\n2125 |     def _exec_constructor_postprocessors(cls, obj):\n2126 |         # WARNING: This API is experimental.\n2127 | \n2128 |         # This is an experimental API that introduces constructor\n2129 |         # postprosessors for SymPy Core elements. If an argument of a SymPy\n2130 |         # expression has a `_constructor_postprocessor_mapping` attribute, it will\n2131 |         # be interpreted as a dictionary containing lists of postprocessing\n2132 |         # functions for matching expression node names.\n2133 | \n2134 |         clsname = obj.__class__.__name__\n2135 |         postprocessors = set()\n2136 |         for i in obj.args:\n2137 |             for f in _get_postprocessors(clsname, type(i)):\n2138 |                 postprocessors.add(f)\n2139 | \n2140 |         for f in postprocessors:\n2141 |             obj = f(obj)\n2142 | \n2143 |         return obj\n2144 | \n2145 |     def _sage_(self):\n2146 |         \"\"\"\n2147 |         Convert *self* to a symbolic expression of SageMath.\n2148 | \n2149 |         This version of the method is merely a placeholder.\n2150 |         \"\"\"\n2151 |         old_method = self._sage_\n2152 |         from sage.interfaces.sympy import sympy_init # type: ignore\n2153 |         sympy_init()  # may monkey-patch _sage_ method into self's class or superclasses\n2154 |         if old_method == self._sage_:\n2155 |             raise NotImplementedError('conversion to SageMath is not implemented')\n2156 |         else:\n2157 |             # call the freshly monkey-patched method\n2158 |             return self._sage_()\n2159 | \n2160 |     def could_extract_minus_sign(self) -> bool:\n2161 |         return False  # see Expr.could_extract_minus_sign\n2162 | \n2163 |     def is_same(a, b, approx=None):\n2164 |         \"\"\"Return True if a and b are structurally the same, else False.\n2165 |         If `approx` is supplied, it will be used to test whether two\n2166 |         numbers are the same or not. By default, only numbers of the\n2167 |         same type will compare equal, so S.Half != Float(0.5).\n2168 | \n2169 |         Examples\n2170 |         ========\n2171 | \n2172 |         In SymPy (unlike Python) two numbers do not compare the same if they are\n2173 |         not of the same type:\n2174 | \n2175 |         >>> from sympy import S\n2176 |         >>> 2.0 == S(2)\n2177 |         False\n2178 |         >>> 0.5 == S.Half\n2179 |         False\n2180 | \n2181 |         By supplying a function with which to compare two numbers, such\n2182 |         differences can be ignored. e.g. `equal_valued` will return True\n2183 |         for decimal numbers having a denominator that is a power of 2,\n2184 |         regardless of precision.\n2185 | \n2186 |         >>> from sympy import Float\n2187 |         >>> from sympy.core.numbers import equal_valued\n2188 |         >>> (S.Half/4).is_same(Float(0.125, 1), equal_valued)\n2189 |         True\n2190 |         >>> Float(1, 2).is_same(Float(1, 10), equal_valued)\n2191 |         True\n2192 | \n2193 |         But decimals without a power of 2 denominator will compare\n2194 |         as not being the same.\n2195 | \n2196 |         >>> Float(0.1, 9).is_same(Float(0.1, 10), equal_valued)\n2197 |         False\n2198 | \n2199 |         But arbitrary differences can be ignored by supplying a function\n2200 |         to test the equivalence of two numbers:\n2201 | \n2202 |         >>> import math\n2203 |         >>> Float(0.1, 9).is_same(Float(0.1, 10), math.isclose)\n2204 |         True\n2205 | \n2206 |         Other objects might compare the same even though types are not the\n2207 |         same. This routine will only return True if two expressions are\n2208 |         identical in terms of class types.\n2209 | \n2210 |         >>> from sympy import eye, Basic\n2211 |         >>> eye(1) == S(eye(1))  # mutable vs immutable\n2212 |         True\n2213 |         >>> Basic.is_same(eye(1), S(eye(1)))\n2214 |         False\n2215 | \n2216 |         \"\"\"\n2217 |         from .numbers import Number\n2218 |         from .traversal import postorder_traversal as pot\n2219 |         for t in zip_longest(pot(a), pot(b)):\n2220 |             if None in t:\n2221 |                 return False\n2222 |             a, b = t\n2223 |             if isinstance(a, Number):\n2224 |                 if not isinstance(b, Number):\n2225 |                     return False\n2226 |                 if approx:\n2227 |                     return approx(a, b)\n2228 |             if not (a == b and a.__class__ == b.__class__):\n2229 |                 return False\n2230 |         return True\n```\n"}, {"content": "Based on my analysis of the codebase and the issue description, I can now provide the locations that need modification to implement the requested feature. The issue requests special-casing of the `abs()` function to call `rewrite(Abs)` instead of the generic `_eval_rewrite` mechanism.\n\nHere are the relevant locations:\n\n```\nsympy/core/basic.py\nline: 2073\nline: 2079-2088\nfunction: Basic.rewrite\n\nsympy/functions/elementary/complexes.py\nline: 446\nclass: Abs\nfunction: _eval_rewrite_as_abs\n\nsympy/core/basic.py\nline: 2119\nfunction: Basic._eval_rewrite\n\nsympy/core/basic.py\nline: 2107-2113\nfunction: Basic._rewrite\n```\n\nThe issue requires modifying the `rewrite` functionality to detect when the `abs()` function is being called and redirect it to `Abs` rewrite rules, while leaving other functions alone. The key areas that need to be examined are:\n\n1. The main `rewrite` implementation in `sympy/core/basic.py`, which handles the dispatching of rewriting rules.\n2. The `Abs` class implementation which defines the `_eval_rewrite_as_abs` method that should be called when `abs()` is detected.\n3. The basic rewrite handling logic in `Basic._eval_rewrite`.\n4. The `_rewrite` method that performs the actual transformation.\n\nThese locations form the minimal set of code that needs to be understood and potentially modified to implement the requested feature. The issue specifically mentions that `abs()` is a built-in Python function that converts to `Abs` internally, so the implementation should detect this case and use the `Abs`-specific rewriting rules.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 218980, "completion_tokens": 586}, "time": 148.8358862400055}]}}
{"instance_id": "pandas-dev__pandas-60457", "found_files": [["pandas/core/generic.py", "pandas/io/formats/csvs.py", "pandas/io/formats/format.py"]], "found_modules": [["pandas/core/strings/accessor.py:cat_safe", "pandas/core/generic.py:NDFrame", "pandas/io/formats/csvs.py:CSVFormatter", "pandas/core/groupby/generic.py:SeriesGroupBy.skew", "pandas/core/arrays/masked.py:BaseMaskedArray", "pandas/core/groupby/generic.py:SeriesGroupBy", "pandas/core/indexes/multi.py:MultiIndex", "pandas/io/formats/format.py:FloatArrayFormatter._value_formatter", "pandas/io/excel/_base.py:ExcelWriter", "pandas/io/formats/format.py:FloatArrayFormatter", "pandas/core/groupby/ops.py:BinGrouper", "pandas/core/arrays/datetimelike.py:DatetimeLikeArrayMixin", "pandas/io/stata.py:StataReader", "pandas/core/apply.py:FrameRowApply", "pandas/core/indexing.py:_LocationIndexer", "pandas/io/formats/format.py:_GenericArrayFormatter"]], "found_entities": [["pandas/core/strings/accessor.py:cat_safe", "pandas/core/generic.py:NDFrame.to_csv", "pandas/io/formats/csvs.py:CSVFormatter.float_format", "pandas/core/groupby/generic.py:SeriesGroupBy.skew.alt", "pandas/core/arrays/masked.py:BaseMaskedArray.mean", "pandas/core/groupby/generic.py:SeriesGroupBy.plot", "pandas/core/indexes/multi.py:MultiIndex._constructor", "pandas/io/formats/format.py:FloatArrayFormatter._value_formatter.base_formatter", "pandas/io/formats/format.py:FloatArrayFormatter._value_formatter.decimal_formatter", "pandas/io/excel/_base.py:ExcelWriter.__fspath__", "pandas/io/formats/format.py:FloatArrayFormatter._value_formatter", "pandas/core/groupby/ops.py:BinGrouper.names", "pandas/core/arrays/datetimelike.py:DatetimeLikeArrayMixin._add_offset", "pandas/io/stata.py:StataReader.__enter__", "pandas/core/apply.py:FrameRowApply.result_columns", "pandas/io/excel/_base.py:ExcelWriter.supported_extensions", "pandas/core/indexing.py:_LocationIndexer._getitem_tuple", "pandas/io/formats/format.py:_GenericArrayFormatter._format_strings", "pandas/io/formats/csvs.py:CSVFormatter.save"]], "raw_output_loc": ["Based on my analysis, I can now provide the locations that need modification to add examples for the float_format parameter in the to_csv documentation. Here's the output in the requested format:\n\n```\npandas/core/generic.py\nline: 3767-3769\nclass: NDFrame\nfunction: to_csv\n\npandas/io/formats/csvs.py\nline: 106-107\nclass: CSVFormatter\nfunction: float_format\n\npandas/io/formats/format.py\nline: 1266-1320\nclass: FloatArrayFormatter\nfunction: _value_formatter\n\npandas/io/formats/format.py\nline: 1180-1202\nclass: _GenericArrayFormatter\nfunction: _format_strings\n\npandas/io/formats/csvs.py\nline: 1191-1212\nclass: CSVFormatter\nfunction: save\n```\n\nThe changes needed are primarily focused on the documentation of these files, specifically:\n\n1. pandas/core/generic.py: This is the main file containing the to_csv method. The float_format parameter's documentation needs to be enhanced with examples.\n\n2. pandas/io/formats/csvs.py: This file contains the CSVFormatter class which processes the float_format option during CSV conversion. The float_format() method here simply returns the float_format value.\n\n3. pandas/io/formats/format.py: This contains the FloatArrayFormatter class which handles the actual formatting of floating-point numbers. The _value_formatter() function shows how the float_format parameter is applied to format numbers.\n\n4. pandas/io/formats/format.py: The _GenericArrayFormatter class's _format_strings method shows how formatted values are constructed and combined into the final CSV output.\n\n5. pandas/io/formats/csvs.py: The CSVFormatter's save() method brings everything together and writes the CSV data to the output.\n\nThese locations form the complete chain of how the float_format parameter is processed and documented, making them ideal spots for adding practical examples of its usage."], "meta_data": {"repo": "pandas-dev/pandas", "base_commit": "844b3191bd45b95cbaae341048bf7f367f086f2f", "problem_statement": "DOC: Add examples for float_format in to_csv documentation\n### Pandas version checks\r\n\r\n- [X] I have checked that the issue still exists on the latest versions of the docs on `main` [here](https://pandas.pydata.org/docs/dev/)\r\n\r\n\r\n### Location of the documentation\r\n\r\nhttps://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.to_csv.html\r\n\r\n### Documentation problem\r\n\r\nThe float_format parameter in to_csv is explained but lacks examples. Users might struggle to understand how to apply this parameter effectively without concrete examples in the documentation.\r\n\r\n### Suggested fix for documentation\r\n\r\nI suggest adding examples for float_format to make the documentation more beginner-friendly. Examples could include:\r\n\r\n```\r\n# Format floats to two decimal places\r\ndf.to_csv(\"example1.csv\", float_format=\"%.2f\")\r\n\r\n# Use scientific notation\r\ndf.to_csv(\"example2.csv\", float_format=\"{:.2e}\".format)\r\n```\n", "patch": "diff --git a/pandas/core/generic.py b/pandas/core/generic.py\nindex a6be17a654aa7..3a48cc8a66076 100644\n--- a/pandas/core/generic.py\n+++ b/pandas/core/generic.py\n@@ -3878,6 +3878,14 @@ def to_csv(\n         >>> import os  # doctest: +SKIP\n         >>> os.makedirs(\"folder/subfolder\", exist_ok=True)  # doctest: +SKIP\n         >>> df.to_csv(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n+\n+        Format floats to two decimal places:\n+\n+        >>> df.to_csv(\"out1.csv\", float_format=\"%.2f\")  # doctest: +SKIP\n+\n+        Format floats using scientific notation:\n+\n+        >>> df.to_csv(\"out2.csv\", float_format=\"{{:.2e}}\".format)  # doctest: +SKIP\n         \"\"\"\n         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n \n"}, "usage": {"cost($)": "0", "prompt_tokens": 168980, "completion_tokens": 660}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven 