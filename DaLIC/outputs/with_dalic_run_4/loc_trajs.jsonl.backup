[str, Any]\n114 |     condition: str | None\n115 | \n116 |     def __init__(self, op: str, lhs, rhs, queryables: dict[str, Any], encoding) -> None:\n117 |         super().__init__(op, lhs, rhs)\n118 |         self.queryables = queryables\n119 |         self.encoding = encoding\n120 |         self.condition = None\n121 | \n122 |     def _disallow_scalar_only_bool_ops(self) -> None:\n123 |         pass\n124 | \n125 |     def prune(self, klass):\n126 |         def pr(left, right):\n127 |             \"\"\"create and return a new specialized BinOp from myself\"\"\"\n128 |             if left is None:\n129 |                 return right\n130 |             elif right is None:\n131 |                 return left\n132 | \n133 |             k = klass\n134 |             if isinstance(left, ConditionBinOp):\n135 |                 if isinstance(right, ConditionBinOp):\n136 |                     k = JointConditionBinOp\n137 |                 elif isinstance(left, k):\n138 |                     return left\n139 |                 elif isinstance(right, k):\n140 |                     return right\n141 | \n142 |             elif isinstance(left, FilterBinOp):\n143 |                 if isinstance(right, FilterBinOp):\n144 |                     k = JointFilterBinOp\n145 |                 elif isinstance(left, k):\n146 |                     return left\n147 |                 elif isinstance(right, k):\n148 |                     return right\n149 | \n150 |             return k(\n151 |                 self.op, left, right, queryables=self.queryables, encoding=self.encoding\n152 |             ).evaluate()\n153 | \n154 |         left, right = self.lhs, self.rhs\n155 | \n156 |         if is_term(left) and is_term(right):\n157 |             res = pr(left.value, right.value)\n158 |         elif not is_term(left) and is_term(right):\n159 |             res = pr(left.prune(klass), right.value)\n160 |         elif is_term(left) and not is_term(right):\n161 |             res = pr(left.value, right.