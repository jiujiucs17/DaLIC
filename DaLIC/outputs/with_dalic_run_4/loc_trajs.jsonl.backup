hine to see the interactivity.\n 15 | \n 16 |     You can copy and paste individual parts, or download the entire example\n 17 |     using the link at the bottom of the page.\n 18 | \"\"\"\n 19 | \n 20 | import matplotlib.pyplot as plt\n 21 | import numpy as np\n 22 | \n 23 | from matplotlib.backend_bases import MouseButton\n 24 | from matplotlib.patches import PathPatch\n 25 | from matplotlib.path import Path\n 26 | \n 27 | fig, ax = plt.subplots()\n 28 | \n 29 | pathdata = [\n 30 |     (Path.MOVETO, (1.58, -2.57)),\n 31 |     (Path.CURVE4, (0.35, -1.1)),\n 32 |     (Path.CURVE4, (-1.75, 2.0)),\n 33 |     (Path.CURVE4, (0.375, 2.0)),\n 34 |     (Path.LINETO, (0.85, 1.15)),\n 35 |     (Path.CURVE4, (2.2, 3.2)),\n 36 |     (Path.CURVE4, (3, 0.05)),\n 37 |     (Path.CURVE4, (2.0, -0.5)),\n 38 |     (Path.CLOSEPOLY, (1.58, -2.57)),\n 39 | ]\n 40 | \n 41 | codes, verts = zip(*pathdata)\n 42 | path = Path(verts, codes)\n 43 | patch = PathPatch(\n 44 |     path, facecolor='green', edgecolor='yellow', alpha=0.5)\n 45 | ax.add_patch(patch)\n```\n\nFound function `lib/matplotlib/path.py:Path._iter_connected_components`.\nSource: Retrieved entity using keyword search (bm25).\n```\n460 | def _iter_connected_components(self):\n461 |         \"\"\"Return subpaths split at MOVETOs.\"\"\"\n462 |         if self.codes is None:\n463 |             yield self\n464 |         else:\n465 |             idxs = np.append((self.codes == Path.MOVETO).nonzero()[0], len(self.codes))\n466 |             for sl in map(slice, idxs, idxs[1:]):\n467 |                 yield Path._fast_from_codes_and_verts(\n468 |                     self.vertices[sl], self.codes[sl], self)\n```\n\nFound function `lib/matplotlib/path.py:Path.unit_circle_righthalf`.\nSource: Retrieved entity using keyword search (bm25).\n```\n890 | def unit_circle_righthalf(cls):\n891 |         \"\"\"\n892 |         Return a `Path` of the right half of a unit circle.\n893 | \n894 |         See `Path.circle` for the reference on the appr