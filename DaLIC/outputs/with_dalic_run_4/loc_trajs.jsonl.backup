 patch.sticky_edges.x[:] = patch.sticky_edges.y[:] = []\n7106 | \n7107 |         elif histtype.startswith('step'):\n7108 |             # these define the perimeter of the polygon\n7109 |             x = np.zeros(4 * len(bins) - 3)\n7110 |             y = np.zeros(4 * len(bins) - 3)\n7111 | \n7112 |             x[0:2*len(bins)-1:2], x[1:2*len(bins)-1:2] = bins, bins[:-1]\n7113 |             x[2*len(bins)-1:] = x[1:2*len(bins)-1][::-1]\n7114 | \n7115 |             if bottom is None:\n7116 |                 bottom = 0\n7117 | \n7118 |             y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = bottom\n7119 |             y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7120 | \n7121 |             if log:\n7122 |                 if orientation == 'horizontal':\n7123 |                     self.set_xscale('log', nonpositive='clip')\n7124 |                 else:  # orientation == 'vertical'\n7125 |                     self.set_yscale('log', nonpositive='clip')\n7126 | \n7127 |             if align == 'left':\n7128 |                 x -= 0.5*(bins[1]-bins[0])\n7129 |             elif align == 'right':\n7130 |                 x += 0.5*(bins[1]-bins[0])\n7131 | \n7132 |             # If fill kwarg is set, it will be passed to the patch collection,\n7133 |             # overriding this\n7134 |             fill = (histtype == 'stepfilled')\n7135 | \n7136 |             xvals, yvals = [], []\n7137 |             for top in tops:\n7138 |                 if stacked:\n7139 |                     # top of the previous polygon becomes the bottom\n7140 |                     y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7141 |                 # set the top of this polygon\n7142 |                 y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = top + bottom\n7143 | \n7144 |                 # The starting point of the polygon has not yet been\n7145 |                 # updated. So far only the endpoint was adjusted. This\n7146 |                 # assignment closes the polygon. The redundant endpoint is\n