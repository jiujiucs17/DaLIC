0 |         --------\n5141 |         hist2d : 2D histogram rectangular bins\n5142 |         \"\"\"\n5143 |         self._process_unit_info([(\"x\", x), (\"y\", y)], kwargs, convert=False)\n5144 | \n5145 |         x, y, C = cbook.delete_masked_points(x, y, C)\n5146 | \n5147 |         # Set the size of the hexagon grid\n5148 |         if np.iterable(gridsize):\n5149 |             nx, ny = gridsize\n5150 |         else:\n5151 |             nx = gridsize\n5152 |             ny = int(nx / math.sqrt(3))\n5153 |         # Count the number of data in each hexagon\n5154 |         x = np.asarray(x, float)\n5155 |         y = np.asarray(y, float)\n5156 | \n5157 |         # Will be log()'d if necessary, and then rescaled.\n5158 |         tx = x\n5159 |         ty = y\n5160 | \n5161 |         if xscale == 'log':\n5162 |             if np.any(x <= 0.0):\n5163 |                 raise ValueError(\n5164 |                     \"x contains non-positive values, so cannot be log-scaled\")\n5165 |             tx = np.log10(tx)\n5166 |         if yscale == 'log':\n5167 |             if np.any(y <= 0.0):\n5168 |                 raise ValueError(\n5169 |                     \"y contains non-positive values, so cannot be log-scaled\")\n5170 |             ty = np.log10(ty)\n5171 |         if extent is not None:\n5172 |             xmin, xmax, ymin, ymax = extent\n5173 |             if xmin > xmax:\n5174 |                 raise ValueError(\"In extent, xmax must be greater than xmin\")\n5175 |             if ymin > ymax:\n5176 |                 raise ValueError(\"In extent, ymax must be greater than ymin\")\n5177 |         else:\n5178 |             xmin, xmax = (tx.min(), tx.max()) if len(x) else (0, 1)\n5179 |             ymin, ymax = (ty.min(), ty.max()) if len(y) else (0, 1)\n5180 | \n5181 |             # to avoid issues with singular data, expand the min/max pairs\n5182 |             xmin, xmax = mtransforms.nonsingular(xmin, xmax, expander=0.1)\n5183 |             ymin, ymax = mtransforms.nonsingular(ymin, ymax, expander=0.1)\n5184 | \n5185 |         nx1 = nx + 1\n5186 |         ny1 = ny + 1\n5187 |         nx2 = nx\n5188 |         ny2 = ny\n5189 |         n = nx1 * ny1 + nx2 * ny2\n5190 | \n5191 |         # In the x-direction, the hexagons exactly cover the region from\n5192 |         # xmin to xmax. Need some padding to avoid roundoff errors.\n5193 |         padding = 1.e-9 * (xmax - xmin)\n5194 |         xmin -= padding\n5195 |         xmax += padding\n5196 |         sx = (xmax - xmin) / nx\n5197 |         sy = (ymax - ymin) / ny\n5198 |         # Positions in hexagon index coordinates.\n5199 |         ix = (tx - xmin) / sx\n5200 |         iy = (ty - ymin) / sy\n5201 |         ix1 = np.round(ix).astype(int)\n5202 |         iy1 = np.round(iy).astype(int)\n5203 |         ix2 = np.floor(ix).astype(int)\n5204 |         iy2 = np.floor(iy).astype(int)\n5205 |         # flat indices, plus one so that out-of-range points go to position 0.\n5206 |         i1 = np.where((0 <= ix1) & (ix1 < nx1) & (0 <= iy1) & (iy1 < ny1),\n5207 |                       ix1 * ny1 + iy1 + 1, 0)\n5208 |         i2 = np.where((0 <= ix2) & (ix2 < nx2) & (0 <= iy2) & (iy2 < ny2),\n5209 |                       ix2 * ny2 + iy2 + 1, 0)\n5210 | \n5211 |         d1 = (ix - ix1) ** 2 + 3.0 * (iy - iy1) ** 2\n5212 |         d2 = (ix - ix2 - 0.5) ** 2 + 3.0 * (iy - iy2 - 0.5) ** 2\n5213 |         bdist = (d1 < d2)\n5214 | \n5215 |         if C is None:  # [1:] drops out-of-range points.\n5216 |             counts1 = np.bincount(i1[bdist], minlength=1 + nx1 * ny1)[1:]\n5217 |             counts2 = np.bincount(i2[~bdist], minlength=1 + nx2 * ny2)[1:]\n5218 |             accum = np.concatenate([counts1, counts2]).astype(float)\n5219 |             if mincnt is not None:\n5220 |                 accum[accum < mincnt] = np.nan\n5221 |             C = np.ones(len(x))\n5222 |         else:\n5223 |             # store the C values in a list per hexagon index\n5224 |             Cs_at_i1 = [[] for _