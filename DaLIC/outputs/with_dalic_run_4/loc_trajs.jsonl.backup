ine : for vertical lines\n949 | \n950 |         Examples\n951 |         --------\n952 |         Draw a thick red line passing through (0, 0) and (1, 1)::\n953 | \n954 |             >>> axline((0, 0), (1, 1), linewidth=4, color='r')\n955 |         \"\"\"\n956 |         if slope is not None and (self.get_xscale() != 'linear' or\n957 |                                   self.get_yscale() != 'linear'):\n958 |             raise TypeError(\"'slope' cannot be used with non-linear scales\")\n959 | \n960 |         datalim = [xy1] if xy2 is None else [xy1, xy2]\n961 |         if \"transform\" in kwargs:\n962 |             # if a transform is passed (i.e. line points not in data space),\n963 |             # data limits should not be adjusted.\n964 |             datalim = []\n965 | \n966 |         line = mlines.AxLine(xy1, xy2, slope, **kwargs)\n967 |         # Like add_line, but correctly handling data limits.\n968 |         self._set_artist_props(line)\n969 |         if line.get_clip_path() is None:\n970 |             line.set_clip_path(self.patch)\n971 |         if not line.get_label():\n972 |             line.set_label(f\"_child{len(self._children)}\")\n973 |         self._children.append(line)\n974 |         line._remove_method = self._children.remove\n975 |         self.update_datalim(datalim)\n976 | \n977 |         self._request_autoscale_view()\n978 |         return line\n```\n\nFound function `lib/matplotlib/axes/_axes.py:Axes.loglog`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1869 | def loglog(self, *args, **kwargs):\n1870 |         \"\"\"\n1871 |         Make a plot with log scaling on both the x- and y-axis.\n1872 | \n1873 |         Call signatures::\n1874 | \n1875 |             loglog([x], y, [fmt], data=None, **kwargs)\n1876 |             loglog([x], y, [fmt], [x2], y2, [fmt2], ..., **kwargs)\n1877 | \n1878 |         This is just a thin wrapper around `.plot` which additionally changes\n1879 |         both the x-axis and the y-axis to log scaling. All the concepts and\n1880 |         parameters of plot can be used here as well.\n1881 | \n1882 |         The additional parameters *base*, *subs* and *nonpositive* control the\n1883 |         x/y-axis properties. They are just forwarded to `.Axes.set_xscale` and\n1884 |         `.Axes.set_yscale`. To use different properties on the x-axis and the\n1885 |         y-axis, use e.g.\n1886 |         ``ax.set_xscale(\"log\", base=10); ax.set_yscale(\"log\", base=2)``.\n1887 | \n1888 |         Parameters\n1889 |         ----------\n1890 |         base : float, default: 10\n1891 |             Base of the logarithm.\n1892 | \n1893 |         subs : sequence, optional\n1894 |             The location of the minor ticks. If *None*, reasonable locations\n1895 |             are automatically chosen depending on the number of decades in the\n1896 |             plot. See `.Axes.set_xscale`/`.Axes.set_yscale` for details.\n1897 | \n1898 |         nonpositive : {'mask', 'clip'}, default: 'clip'\n1899 |             Non-positive values can be masked as invalid, or clipped to a very\n1900 |             small positive number.\n1901 | \n1902 |         **kwargs\n1903 |             All parameters supported by `.plot`.\n1904 | \n1905 |         Returns\n1906 |         -------\n1907 |         list of `.Line2D`\n1908 |             Objects representing the plotted data.\n1909 |         \"\"\"\n1910 |         dx = {k: v for k, v in kwargs.items()\n1911 |               if k in ['base', 'subs', 'nonpositive',\n1912 |                        'basex', 'subsx', 'nonposx']}\n1913 |         self.set_xscale('log', **dx)\n1914 |         dy = {k: v for k, v in kwargs.items()\n1915 |               if k in ['base', 'subs', 'nonpositive',\n1916 |                        'basey', 'subsy', 'nonposy']}\n1917 |         self.set_yscale('log', **dy)\n1918 |         return self.plot(\n1919 |             *args, **{k: v for k, v in kwargs.items() if k not in {*dx, *dy}})\n```\n\nFound function `lib/matplotlib/axes/_