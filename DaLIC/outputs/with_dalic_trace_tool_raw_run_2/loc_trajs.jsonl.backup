a if sp.issparse(X) else X,\n210 |         allow_nan=allow_nan,\n211 |         estimator_name=estimator_name,\n212 |         input_name=input_name,\n213 |     )\n```\n\nFound function `sklearn/utils/validation.py:_check_pos_label_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2529 | def _check_pos_label_consistency(pos_label, y_true):\n2530 |     \"\"\"Check if `pos_label` need to be specified or not.\n2531 | \n2532 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2533 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2534 |     `pos_label` parameters.\n2535 | \n2536 |     Parameters\n2537 |     ----------\n2538 |     pos_label : int, float, bool, str or None\n2539 |         The positive label.\n2540 |     y_true : ndarray of shape (n_samples,)\n2541 |         The target vector.\n2542 | \n2543 |     Returns\n2544 |     -------\n2545 |     pos_label : int, float, bool or str\n2546 |         If `pos_label` can be inferred, it will be returned.\n2547 | \n2548 |     Raises\n2549 |     ------\n2550 |     ValueError\n2551 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2552 |         it will raise a `ValueError`.\n2553 |     \"\"\"\n2554 |     # ensure binary classification if pos_label is not specified\n2555 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2556 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2557 |     # when elements in the two arrays are not comparable.\n2558 |     if pos_label is None:\n2559 |         # Compute classes only if pos_label is not specified:\n2560 |         classes = np.unique(y_true)\n2561 |         if classes.dtype.kind in \"OUS\" or not (\n2562 |             np.array_equal(classes, [0, 1])\n2563 |             or np.array_equal(classes, [-1, 1])\n2564 |             or np.array_equal(classes, [0])\n2565 |             or np.array_equal(classes, [-1])\n2566 |             or np.array_equal(classes, [1])\n2567 |         ):\n2568 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2569 |             raise ValueError(\n2570 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2571 |                 \"specified: either make y_true take value in {0, 1} or \"\n2572 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2573 |             )\n2574 |         pos_label = 1\n2575 | \n2576 |     return pos_label\n```\n"}, {"content": "Let me search for the actual implementation of the testing utilities since that's where the new function would be implemented.\n\n<function=search_code_snippets>\n<parameter=search_terms>['sklearn/utils/_testing.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nNo results for test files: `sklearn/utils/_testing.py`. Please do not search for any test files.\n"}, {"content": "Let me explore the validation module where I think the new function should be implemented.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/utils/validation.py']</parameter>\n<parameter=direction>both</parameter>\n<parameter=dependency_type_filter>['imports', 'invokes']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\nsklearn/utils/validation.py\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/__init__.py\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:config_context\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:get_config\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:set_config\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/__check_build/__init__.py\n\u2502              \u251