 |     ----------\n 36 |     triangulation : `.Triangulation`\n 37 |         An already created triangular grid.\n 38 |     x, y, triangles, mask\n 39 |         Parameters defining the triangular grid. See `.Triangulation`.\n 40 |         This is mutually exclusive with specifying *triangulation*.\n 41 |     c : array-like\n 42 |         The color values, either for the points or for the triangles. Which one\n 43 |         is automatically inferred from the length of *c*, i.e. does it match\n 44 |         the number of points or the number of triangles. If there are the same\n 45 |         number of points and triangles in the triangulation it is assumed that\n 46 |         color values are defined at points; to force the use of color values at\n 47 |         triangles use the keyword argument ``facecolors=c`` instead of just\n 48 |         ``c``.\n 49 |         This parameter is position-only.\n 50 |     facecolors : array-like, optional\n 51 |         Can be used alternatively to *c* to specify colors at the triangle\n 52 |         faces. This parameter takes precedence over *c*.\n 53 |     shading : {'flat', 'gouraud'}, default: 'flat'\n 54 |         If  'flat' and the color values *c* are defined at points, the color\n 55 |         values used for each triangle are from the mean c of the triangle's\n 56 |         three points. If *shading* is 'gouraud' then color values must be\n 57 |         defined at points.\n 58 |     %(cmap_doc)s\n 59 | \n 60 |     %(norm_doc)s\n 61 | \n 62 |     %(vmin_vmax_doc)s\n 63 | \n 64 |     %(colorizer_doc)s\n 65 | \n 66 |     Returns\n 67 |     -------\n 68 |     `~matplotlib.collections.PolyCollection` or `~matplotlib.collections.TriMesh`\n 69 |         The result depends on *shading*: For ``shading='flat'`` the result is a\n 70 |         `.PolyCollection`, for ``shading='gouraud'`` the result is a `.TriMesh`.\n 71 | \n 72 |     Other Parameters\n 73 |     ----------------\n 74 |     **kwargs : `~matplotlib.collections.Collection` properties\n 75 | \n 76 |         %(Collection:kwdoc)s\n 77 |     \"\"\"\n 78 |     _api.check_in_list(['flat', 'gouraud'], shading=shading)\n 79 | \n 80 |     tri, args, kwargs = Triangulation.get_from_args_and_kwargs(*args, **kwargs)\n 81 | \n 82 |     # Parse the color to be in one of (the other variable will be None):\n 83 |     # - facecolors: if specified at the triangle faces\n 84 |     # - point_colors: if specified at the points\n 85 |     if facecolors is not None:\n 86 |         if args:\n 87 |             _api.warn_external(\n 88 |                 \"Positional parameter c has no effect when the keyword \"\n 89 |                 \"facecolors is given\")\n 90 |         point_colors = None\n 91 |         if len(facecolors) != len(tri.triangles):\n 92 |             raise ValueError(\"The length of facecolors must match the number \"\n 93 |                              \"of triangles\")\n 94 |     else:\n 95 |         # Color from positional parameter c\n 96 |         if not args:\n 97 |             raise TypeError(\n 98 |                 \"tripcolor() missing 1 required positional argument: 'c'; or \"\n 99 |                 \"1 required keyword-only argument: 'facecolors'\")\n100 |         elif len(args) > 1:\n101 |             raise TypeError(f\"Unexpected positional parameters: {args[1:]!r}\")\n102 |         c = np.asarray(args[0])\n103 |         if len(c) == len(tri.x):\n104 |             # having this before the len(tri.triangles) comparison gives\n105 |             # precedence to nodes if there are as many nodes as triangles\n106 |             point_colors = c\n107 |             facecolors = None\n108 |         elif len(c) == len(tri.triangles):\n109 |             point_colors = None\n110 |             facecolors = c\n111 |         else:\n112 |             raise ValueError('The length of c must match either the number '\n113 |                              'of points or the number of triangles')\n114 | \n115 |     # Handling of linewidths, shading, edgecolors and antialiased as\n116 |     # in Axes.pcolor\n117 |     linewidths = (0.25,)\n118 |     if 'linewidth' in kwargs:\n119 |         kwargs['linewidths'] = kwargs.pop('linewidth')\n120 |     kwargs.setdefault('linewidths', linewidths)\n121 | \n122 |     edgecolors = 'none'\n123 |     if 'edgecolor' in kwargs:\n124 |         kwargs['edgecolors'] = kwargs.pop('edgecolor')\n125 |     ec = kwargs.setdefault('edgecolors', edgecolors)\n126 | \n127 |     if 'antialiased' in kwargs:\n128 |         kwargs['antialiaseds'] = kwargs.pop('antialiased')\n129 |     if 'antialiaseds' not in kwargs and ec.lower() == \"none\":\n130 |         kwargs['antialiaseds'] = False\n131 | \n132 |     if shading == 'gouraud':\n133 |         if facecolors is not None:\n134 |             raise ValueError(\n135 |                 \"shading='gouraud' can only be used when the colors \"\n136 |                 \"are specified at the points, not at the faces.\")\n137 |         collection = TriMesh(tri, alpha=alpha, array=point_colors,\n138 |                              cmap=cmap, norm=norm, **kwargs)\n139 |     else:  # 'flat'\n140 |         # Vertices of triangles.\n141 |         maskedTris = tri.get_masked_triangles()\n142 |         verts = np.stack((tri.x[maskedTris], tri.y[maskedTris]), axis=-1)\n143 | \n144 |         # Color values.\n145 |         if facecolors is None:\n146 |             # One color per triangle, the mean of the 3 vertex color values.\n147 |             colors = point_colors[maskedTris].mean(axis=1)\n148 |         elif tri.mask is not None:\n149 |             # Remove color values of masked triangles.\n150 |             colors = facecolors[~tri.mask]\n151 |         else:\n152 |             colors = facecolors\n153 |         collection = PolyCollection(verts, alpha=alpha, array=colors,\n154 |                                     cmap=cmap, norm=norm, **kwargs)\n155 | \n156 |     collection._scale_norm(norm, vmin, vmax)\n157 |     ax.grid(False)\n158 | \n159 |     minx = tri