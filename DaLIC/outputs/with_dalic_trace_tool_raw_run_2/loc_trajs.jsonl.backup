e\n135 | \n136 |             if typ == \"property\":\n137 |                 f = _create_delegator_property(name)\n138 |             else:\n139 |                 f = _create_delegator_method(name)\n140 | \n141 |             # don't overwrite existing methods/properties\n142 |             if overwrite or not hasattr(cls, name):\n143 |                 setattr(cls, name, f)\n```\n\nFound function `pandas/core/accessor.py:delegate_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n146 | def delegate_names(\n147 |     delegate,\n148 |     accessors: list[str],\n149 |     typ: str,\n150 |     overwrite: bool = False,\n151 |     accessor_mapping: Callable[[str], str] = lambda x: x,\n152 |     raise_on_missing: bool = True,\n153 | ):\n154 |     \"\"\"\n155 |     Add delegated names to a class using a class decorator.  This provides\n156 |     an alternative usage to directly calling `_add_delegate_accessors`\n157 |     below a class definition.\n158 | \n159 |     Parameters\n160 |     ----------\n161 |     delegate : object\n162 |         The class to get methods/properties & doc-strings.\n163 |     accessors : Sequence[str]\n164 |         List of accessor to add.\n165 |     typ : {'property', 'method'}\n166 |     overwrite : bool, default False\n167 |        Overwrite the method/property in the target class if it exists.\n168 |     accessor_mapping: Callable, default lambda x: x\n169 |         Callable to map the delegate's function to the cls' function.\n170 |     raise_on_missing: bool, default True\n171 |         Raise if an accessor does not exist on delegate.\n172 |         False skips the missing accessor.\n173 | \n174 |     Returns\n175 |     -------\n176 |     callable\n177 |         A class decorator.\n178 | \n179 |     Examples\n180 |     --------\n181 |     @delegate_names(Categorical, [\"categories\", \"ordered\"], \"property\")\n182 |     class CategoricalAccessor(PandasDelegate):\n183 |         [...]\n184 |     \"\"\"\n185 | \n186 |    