vals.real, encoding, hash_key, categorize)\n304 |         hash_imag = _hash_ndarray(vals.imag, encoding, hash_key, categorize)\n305 |         return hash_real + 23 * hash_imag\n306 | \n307 |     # First, turn whatever array this is into unsigned 64-bit ints, if we can\n308 |     # manage it.\n309 |     if dtype == bool:\n310 |         vals = vals.astype(\"u8\")\n311 |     elif issubclass(dtype.type, (np.datetime64, np.timedelta64)):\n312 |         vals = vals.view(\"i8\").astype(\"u8\", copy=False)\n313 |     elif issubclass(dtype.type, np.number) and dtype.itemsize <= 8:\n314 |         vals = vals.view(f\"u{vals.dtype.itemsize}\").astype(\"u8\")\n315 |     else:\n316 |         # With repeated values, its MUCH faster to categorize object dtypes,\n317 |         # then hash and rename categories. We allow skipping the categorization\n318 |         # when the values are known/likely to be unique.\n319 |         if categorize:\n320 |             from pandas import (\n321 |                 Categorical,\n322 |                 Index,\n323 |                 factorize,\n324 |             )\n325 | \n326 |             codes, categories = factorize(vals, sort=False)\n327 |             dtype = CategoricalDtype(categories=Index(categories), ordered=False)\n328 |             cat = Categorical._simple_new(codes, dtype)\n329 |             return cat._hash_pandas_object(\n330 |                 encoding=encoding, hash_key=hash_key, categorize=False\n331 |             )\n332 | \n333 |         try:\n334 |             vals = hash_object_array(vals, hash_key, encoding)\n335 |         except TypeError:\n336 |             # we have mixed types\n337 |             vals = hash_object_array(\n338 |                 vals.astype(str).astype(object), hash_key, encoding\n339 |             )\n340 | \n341 |     # Then, redistribute these 64-bit ints within the space of 64-bit ints\n342 |     vals ^= vals >> 30\n343 |     vals *= np.uint64(0xBF58476D1CE4E5B9)\n344 |     vals ^= vals >> 27\n345 |     va