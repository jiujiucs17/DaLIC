      bins = np.array(bins, float)  # causes problems if float16\n7037 |         if stacked:\n7038 |             tops = tops.cumsum(axis=0)\n7039 |             # If a stacked density plot, normalize so the area of all the\n7040 |             # stacked histograms together is 1\n7041 |             if density:\n7042 |                 tops = (tops / np.diff(bins)) / tops[-1].sum()\n7043 |         if cumulative:\n7044 |             slc = slice(None)\n7045 |             if isinstance(cumulative, Number) and cumulative < 0:\n7046 |                 slc = slice(None, None, -1)\n7047 |             if density:\n7048 |                 tops = (tops * np.diff(bins))[:, slc].cumsum(axis=1)[:, slc]\n7049 |             else:\n7050 |                 tops = tops[:, slc].cumsum(axis=1)[:, slc]\n7051 | \n7052 |         patches = []\n7053 | \n7054 |         if histtype.startswith('bar'):\n7055 | \n7056 |             totwidth = np.diff(bins)\n7057 | \n7058 |             if rwidth is not None:\n7059 |                 dr = np.clip(rwidth, 0, 1)\n7060 |             elif (len(tops) > 1 and\n7061 |                   ((not stacked) or mpl.rcParams['_internal.classic_mode'])):\n7062 |                 dr = 0.8\n7063 |             else:\n7064 |                 dr = 1.0\n7065 | \n7066 |             if histtype == 'bar' and not stacked:\n7067 |                 width = dr * totwidth / nx\n7068 |                 dw = width\n7069 |                 boffset = -0.5 * dr * totwidth * (1 - 1 / nx)\n7070 |             elif histtype == 'barstacked' or stacked:\n7071 |                 width = dr * totwidth\n7072 |                 boffset, dw = 0.0, 0.0\n7073 | \n7074 |             if align == 'mid':\n7075 |                 boffset += 0.5 * totwidth\n7076 |             elif align == 'right':\n7077 |                 boffset += totwidth\n7078 | \n7079 |             if orientation == 'horizontal':\n7080 |                 _barfunc = self.barh\n7081 |                 bottom_kwarg = 'left'\n7082 |             else:  