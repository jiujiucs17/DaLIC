dices=None):\n1345 |     \"\"\"Check and validate the parameters passed during `fit`.\n1346 | \n1347 |     Parameters\n1348 |     ----------\n1349 |     X : array-like of shape (n_samples, n_features)\n1350 |         Data array.\n1351 | \n1352 |     fit_params : dict\n1353 |         Dictionary containing the parameters passed at fit.\n1354 | \n1355 |     indices : array-like of shape (n_samples,), default=None\n1356 |         Indices to be selected if the parameter has the same size as `X`.\n1357 | \n1358 |     Returns\n1359 |     -------\n1360 |     fit_params_validated : dict\n1361 |         Validated parameters. We ensure that the values support indexing.\n1362 |     \"\"\"\n1363 |     from . import _safe_indexing\n1364 |     fit_params_validated = {}\n1365 |     for param_key, param_value in fit_params.items():\n1366 |         if (not _is_arraylike(param_value) or\n1367 |                 _num_samples(param_value) != _num_samples(X)):\n1368 |             # Non-indexable pass-through (for now for backward-compatibility).\n1369 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n1370 |             fit_params_validated[param_key] = param_value\n1371 |         else:\n1372 |             # Any other fit_params should support indexing\n1373 |             # (e.g. for cross-validation).\n1374 |             fit_params_validated[param_key] = _make_indexable(param_value)\n1375 |             fit_params_validated[param_key] = _safe_indexing(\n1376 |                 fit_params_validated[param_key], indices\n1377 |             )\n1378 | \n1379 |     return fit_params_validated\n```\n\nFound file `sklearn/manifold/_mds.py`.\nFound file `sklearn/manifold/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"download\"...\n### Search Result:\nFound code snippet in file `doc/tutorial/text_analytics/data/movie_reviews/fetch_data.py`.\nSource: R