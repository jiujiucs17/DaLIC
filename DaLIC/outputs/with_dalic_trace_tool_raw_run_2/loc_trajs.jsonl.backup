4 |         See Also\n10995 |         --------\n10996 |         DataFrame.corrwith : Compute pairwise correlation with another\n10997 |             DataFrame or Series.\n10998 |         Series.corr : Compute the correlation between two Series.\n10999 | \n11000 |         Notes\n11001 |         -----\n11002 |         Pearson, Kendall and Spearman correlation are currently computed using pairwise complete observations.\n11003 | \n11004 |         * `Pearson correlation coefficient <https://en.wikipedia.org/wiki/Pearson_correlation_coefficient>`_\n11005 |         * `Kendall rank correlation coefficient <https://en.wikipedia.org/wiki/Kendall_rank_correlation_coefficient>`_\n11006 |         * `Spearman's rank correlation coefficient <https://en.wikipedia.org/wiki/Spearman%27s_rank_correlation_coefficient>`_\n11007 | \n11008 |         Examples\n11009 |         --------\n11010 |         >>> def histogram_intersection(a, b):\n11011 |         ...     v = np.minimum(a, b).sum().round(decimals=1)\n11012 |         ...     return v\n11013 |         >>> df = pd.DataFrame(\n11014 |         ...     [(0.2, 0.3), (0.0, 0.6), (0.6, 0.0), (0.2, 0.1)],\n11015 |         ...     columns=[\"dogs\", \"cats\"],\n11016 |         ... )\n11017 |         >>> df.corr(method=histogram_intersection)\n11018 |               dogs  cats\n11019 |         dogs   1.0   0.3\n11020 |         cats   0.3   1.0\n11021 | \n11022 |         >>> df = pd.DataFrame(\n11023 |         ...     [(1, 1), (2, np.nan), (np.nan, 3), (4, 4)], columns=[\"dogs\", \"cats\"]\n11024 |         ... )\n11025 |         >>> df.corr(min_periods=3)\n11026 |               dogs  cats\n11027 |         dogs   1.0   NaN\n11028 |         cats   NaN   1.0\n11029 |         \"\"\"  # noqa: E501\n11030 |         data = self._get_numeric_data() if numeric_only else self\n11031 |         cols = data.columns\n11032 |         idx = cols.copy()\n11033 |         mat = data.to_numpy(dtype=float, na_value=np.nan, copy=False)\n11034 | \n11035 |         if method == \"pearson\":\n11036 |             correl = libalgos.nancorr(mat, minp=min_periods)\n11037 |         elif method == \"spearman\":\n11038 |             correl = libalgos.nancorr_spearman(mat, minp=min_periods)\n11039 |         elif method == \"kendall\" or callable(method):\n11040 |             if min_periods is None:\n11041 |                 min_periods = 1\n11042 |             mat = mat.T\n11043 |             corrf = nanops.get_corr_func(method)\n11044 |             K = len(cols)\n11045 |             correl = np.empty((K, K), dtype=float)\n11046 |             mask = np.isfinite(mat)\n11047 |             for i, ac in enumerate(mat):\n11048 |                 for j, bc in enumerate(mat):\n11049 |                     if i > j:\n11050 |                         continue\n11051 | \n11052 |                     valid = mask[i] & mask[j]\n11053 |                     if valid.sum() < min_periods:\n11054 |                         c = np.nan\n11055 |                     elif i == j:\n11056 |                         c = 1.0\n11057 |                     elif not valid.all():\n11058 |                         c = corrf(ac[valid], bc[valid])\n11059 |                     else:\n11060 |                         c = corrf(ac, bc)\n11061 |                     correl[i, j] = c\n11062 |                     correl[j, i] = c\n11063 |         else:\n11064 |             raise ValueError(\n11065 |                 \"method must be either 'pearson', \"\n11066 |                 \"'spearman', 'kendall', or a callable, \"\n11067 |                 f\"'{method}' was supplied\"\n11068 |             )\n11069 | \n11070 |         result = self._constructor(correl, index=idx, columns=cols, copy=False)\n11071 |         return result.__finalize__(self, method=\"corr\")\n```\n\nFound class `asv_bench/benchmarks/frame_methods.py:Round`.\nSource: Retrieved entity using keyword search (bm25).\n```\n807 | class Round:\n808 |     def setup(self):\n809 |         self.df = DataFrame(np.random.randn(10000, 10