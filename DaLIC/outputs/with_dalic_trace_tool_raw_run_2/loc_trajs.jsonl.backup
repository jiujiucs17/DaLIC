arn/calibration.py:_fit_calibrator\n##Searching for term \"calibration_curve\"...\n### Search Result:\nFound function `sklearn/calibration.py:calibration_curve`.\nSource: Match found for entity name `calibration_curve`.\n```\n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n\n##Searching for term \"calibration plot\"...\n### Search Result:\nFound function `benchmarks/bench_saga.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n238 | def plot(outname=None):\n239 |     import pandas as pd\n240 | \n241 |     with open(\"bench_saga.json\", \"r\") as f:\n242 |         f = json.load(f)\n243 |     res = pd.DataFrame(f)\n244 |     res.set_index([\"single_target\"], inplace=True)\n245 | \n246 |     grouped = res.groupby(level=[\"single_target\"])\n247 | \n248 |     colors = {\"saga\": \"C0\", \"liblinear\": \"C1\", \"lightning\": \"C2\"}\n249 |     linestyles = {\"float32\": \"--\", \"float64\": \"-\"}\n250 |     alpha = {\"float64\": 0.5, \"float32\": 1}\n251 | \n252 |     for idx, group in grouped:\n253 |         single_target = idx\n254 |         fig, axes = plt.subplots(figsize=(12, 4), ncols=4)\n255 |         ax = axes[0]\n256 | \n257 |         for scores, times, solver, dtype in zip(\n258 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n259 |         ):\n260 |             ax.plot(\n261 |                 times,\n262 |                 scores,\n263 |                 label=\"%s - %s\" % (solver, dtype),\n264 |                 color=colors[solver],\n265 |                 alpha=alpha[dtype],\n266 |                 marker=\".\",\n267 |                 linestyle=linestyles[dtype],\n268 |             )\n269 |             ax.axvline(\n270 |                 times[-1],\n271 |                 color=colors[solver],\n272 |                 alpha=alpha[dtype],\n273 |                 linestyle=linestyles[dtype],\n274 |             )\n275 |         ax.set_xlabel(\"Time (s)\")\n276 |         ax.set_ylabel(\"Training objective (relative to min)\")\n277 |         ax.set_yscale(\"log\")\n278 | \n279 |         ax = axes[1]\n280 | \n281 |         for scores, times, solver, dtype in zip(\n282 |             group[\"test_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n283 |         ):\n284 |             ax.plot(\n285 |                 times,\n286 |                 scores,\n287 |                 label=solver,\n288 |                 color=colors[solver],\n289 |                 linestyle=linestyles[dtype],\n290 |                 marker=\".\",\n291 |                 alpha=alpha[dtype],\n292 |             )\n293 |             ax.axvline(\n294 |                 times[-1],\n295 |                 color=colors[solver],\n296 |                 alpha=alpha[dtype],\n297 |                 linestyle=linestyles[dtype],\n298 |             )\n299 | \n300 |         ax.set_xlabel(\"Time (s)\")\n301 |         ax.set_ylabel(\"Test objective (relative to min)\")\n302 |         ax.set_yscale(\"log\")\n303 | \n304 |         ax = axes[2]\n305 |         for accuracy, times, solver, dtype in zip(\n306 |             group[\"accuracies\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n307 |         ):\n308 |             ax.plot(\n309 |                 times,\n310 |                 accuracy,\n311 |                 label=\"%s - %s\" % (solver, dtype),\n312 |                 alpha=alpha[dtype],\n313 |                 marker=\".\",\n314 |                 color=colors[solver],\n315 |                 linestyle=linestyles[dtype],\n316 |             )\n317 |             ax.axvline(\n318 |                 times[-1],\n319 |                 color=colors[solver],\n320 |                 alpha=alpha[dtype],\n321 |                 linestyle=linestyles[dtype],\n322 |             )\n323 | \n324 |         ax.set_xlabel(\"Time (s)\")\n325 |         ax.set_ylabel(\"Test accuracy\")\n326 |         ax.legend()\n327 |         name = \"single_target\" if single_target else \"multi_target\"\n328 |         name += \"_%s\" % penalty\n329 |         plt.suptitle(name)\n330 |         if outname is None:\n331 |             outname = name + \".png\"\n332 |         fig.tight_layout()\n333 |         fig.subplots_adjust(top=0.9)\n334 | \n335 |         ax = axes[3]\n336 |         for scores, times, solver, dtype in zip(\n337 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n338 |         ):\n339 |             ax.plot(\n340 |                 np.arange(len(scores)),\n341 |                 scores,\n342 |                 label=\"%s - %s\" % (solver, dtype),\n343 |                 marker=\".\",\n344 |                 alpha=alpha[dtype],\n345 |                 color=colors[solver],\n346 |                 linestyle=linestyles[dtype],\n347 |             )\n348 | \n349 |         ax.set_yscale(\"log\")\n350 |         ax.set_xlabel(\"# iterations\")\n351 |         ax.set_ylabel(\"Objective function\")\n352 |         ax.legend()\n353 | \n354 |         plt.savefig(outname)\n```\n\nFound function `benchmarks/bench_plot_parallel_pairwise.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n12 | def plot(func):\n13 |     random_state = check_random_state(0)\n14 |     one_core = []\n15 |     multi_core = []\n16 |     sample_sizes = range(1000, 6000, 1000)\n17 | \n18 |     for n_samples in sample_sizes:\n19 |         X = random_state.rand(n_samples, 300)\n20 | \n21 |         start = time.time()\n22 |         func(X, n_jobs=1)\n23 |         one_core.append(time.time() - start)\n24 | \n25 |         start = time.time()\n26 |         func(X, n_jobs=-1)\n27 |         multi_core.append(time.time() - start)\n28 | \n29 |     plt.figure(\"scikit-learn parallel %s benchmark results\" % func.__name__)\n30 |     plt.plot(sample_sizes, one_core, label=\"one core\")\n31 |     plt.plot(sample_sizes, multi_core, label=\"multi core\")\n32 |     plt.xlabel(\"n_samples\")\n33 |     plt.ylabel(\"Time (s)\")\n34 |     plt.title(\"Parallel %s\" % func.__name__)\n35 |     plt.legend()\n```\n\nFound function `sklearn/calibration.py:_fit_calibrator`.\nSource: Retrieved entity using keyword search (bm25).\n```\n569 | def _fit_calibrator(clf, predictions, y, classes, method, sample_weight=None):\n570 |     \"\"\"Fit calibrator(s) and return a `_CalibratedClassifier`\n571 |     instance.\n572 | \n573 |     `n_classes` (i.e. `len(clf.classes_)`) calibrators are fitted.\n574 |     However, if `n_classes` equals 2, one calibrator is fitted.\n575 | \n576 |     Parameters\n577 |     ----------\n578 |     clf : estimator instance\n579 |         Fitted classifier.\n580 | \n581 |     predictions : array-like, shape (n_samples, n_classes) or (n_samples, 1) \\\n582 |                     when binary.\n583 |         Raw predictions returned by the un-calibrated base classifier.\n584 | \n585 |     y : array-like, shape (n_samples,)\n586 |         The targets.\n587 | \n588 |     classes : ndarray, shape (n_classes,)\n589 |         All the prediction classes.\n590 | \n591 |     method : {'sigmoid', 'isotonic'}\n592 |         The method to use for calibration.\n593 | \n594 |     sample_weight : ndarray, shape (n_samples,), default=None\n595 |         Sample weights. If None, then samples are equally weighted.\n596 | \n597 |     Returns\n598 |     -------\n599 |     pipeline : _CalibratedClassifier instance\n600 |     \"\"\"\n601 |     Y = label_binarize(y, classes=classes)\n602 |     label_encoder = LabelEncoder().fit(classes)\n603 |     pos_class_indices = label_encoder.transform(clf.classes_)\n604 |     calibrators = []\n605 |     for class_idx, this_pred in zip(pos_class_indices, predictions.T):\n606 |         if method == \"isotonic\":\n607 |             calibrator = IsotonicRegression(out_of_bounds=\"clip\")\n608 |         elif method == \"sigmoid\":\n609 |             calibrator = _SigmoidCalibration()\n610 |         else:\n611 |             raise ValueError(\n612 |                 f\"'method' should be one of: 'sigmoid' or 'isotonic'. Got {method}.\"\n613 |             )\n614 |         calibrator.fit(this_pred, Y[:, class_idx], sample_weight)\n615 |         calibrators.append(calibrator)\n616 | \n617 |     pipeline = _CalibratedClassifier(clf, calibrators, method=method, classes=classes)\n618 |     return pipeline\n```\n\nFound class `sklearn/calibration.py:_CalibratedClassifier`.\nSource: Retrieved code content using keyword search (bm25).\n```\n621 | class _CalibratedClassifier:\n622 |     \"\"\"Pipeline-like chaining a fitted classifier and its fitted calibrators.\n623 | \n624 |     Parameters\n625 |     ----------\n626 |     base_estimator : estimator instance\n627 |         Fitted classifier.\n628 | \n629 |     calibrators : list of fitted estimator instances\n630 |         List of fitted calibrators (either 'IsotonicRegression' or\n631 |         '_SigmoidCalibration'). The number of calibrators equals the number of\n632 |         classes. However, if there are 2 classes, the list contains only one\n633 |         fitted calibrator.\n634 | \n635 |     classes : array-like of shape (n_classes,)\n636 |         All the prediction classes.\n637 | \n638 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n639 |         The method to use for calibration. Can be 'sigmoid' which\n640 |         corresponds to Platt's method or 'isotonic' which is a\n641 |         non-parametric approach based on isotonic regression.\n642 | \n643 |     Attributes\n644 |     ----------\n645 |     calibrators_ : list of fitted estimator instances\n646 |         Same as `calibrators`. Exposed for backward-compatibility. Use\n647 |         `calibrators` instead.\n648 | \n649 |         .. deprecated:: 0.24\n650 |            `calibrators_` is deprecated from 0.24 and will be removed in\n651 |            1.1 (renaming of 0.26). Use `calibrators` instead.\n652 |     \"\"\"\n653 | \n654 |     def __init__(self, base_estimator, calibrators, *, classes, method=\"sigmoid\"):\n655 |         self.base_estimator = base_estimator\n656 |         self.calibrators = calibrators\n657 |         self.classes = classes\n658 |         self.method = method\n659 | \n660 |     # TODO: Remove in 1.1\n661 |     # mypy error: Decorated property not supported\n662 |     @deprecated(  # type: ignore\n663 |         \"`calibrators_` is deprecated in 0.24 and will be removed in 1.1\"\n664 |         \"(renaming of 0.26). Use `calibrators` instead.\"\n665 |     )\n666 |     @property\n667 |     def calibrators_(self):\n668 |         return self.calibrators\n669 | \n670 |     def predict_proba(self, X):\n671 |         \"\"\"Calculate calibrated probabilities.\n672 | \n673 |         Calculates classification calibrated probabilities\n674 |         for each class, in a one-vs-all manner, for `X`.\n675 | \n676 |         Parameters\n677 |         ----------\n678 |         X : ndarray of shape (n_samples, n_features)\n679 |             The sample data.\n680 | \n681 |         Returns\n682 |         -------\n683 |         proba : array, shape (n_samples, n_classes)\n684 |             The predicted probabilities. Can be exact zeros.\n685 |         \"\"\"\n686 |         n_classes = len(self.classes)\n687 |         pred_method, method_name = _get_prediction_method(self.base_estimator)\n688 |         predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n689 | \n690 |         label_encoder = LabelEncoder().fit(self.classes)\n691 |         pos_class_indices = label_encoder.transform(self.base_estimator.classes_)\n692 | \n693 |         proba = np.zeros((_num_samples(X), n_classes))\n694 |         for class_idx, this_pred, calibrator in zip(\n695 |             pos_class_indices, predictions.T, self.calibrators\n696 |         ):\n697 |             if n_classes == 2:\n698 |                 # When binary, `predictions` consists only of predictions for\n699 |                 # clf.classes_[1] but `pos_class_indices` = 0\n700 |                 class_idx += 1\n701 |             proba[:, class_idx] = calibrator.predict(this_pred)\n702 | \n703 |         # Normalize the probabilities\n704 |         if n_classes == 2:\n705 |             proba[:, 0] = 1.0 - proba[:, 1]\n706 |         else:\n707 |             denominator = np.sum(proba, axis=1)[:, np.newaxis]\n708 |             # In the edge case where for each class calibrator returns a null\n709 |             # probability for a given sample, use the uniform distribution\n710 |             # instead.\n711 |             uniform_proba = np.full_like(proba, 1 / n_classes)\n712 |             proba = np.divide(\n713 |                 proba, denominator, out=uniform_proba, where=denominator != 0\n714 |             )\n715 | \n716 |         # Deal with cases where the predicted probability minimally exceeds 1.0\n717 |         proba[(1.0 < proba) & (proba <= 1.0 + 1e-5)] = 1.0\n718 | \n719 |         return proba\n```\n\nFound function `examples/calibration/plot_calibration_curve.py:plot_calibration_curve`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 72 | def plot_calibration_curve(est, name, fig_index):\n 73 |     \"\"\"Plot calibration curve for est w/o and with calibration. \"\"\"\n 74 |     # Calibrated with isotonic calibration\n 75 |     isotonic = CalibratedClassifierCV(est, cv=2, method='isotonic')\n 76 | \n 77 |     # Calibrated with sigmoid calibration\n 78 |     sigmoid = CalibratedClassifierCV(est, cv=2, method='sigmoid')\n 79 | \n 80 |     # Logistic regression with no calibration as baseline\n 81 |     lr = LogisticRegression(C=1.)\n 82 | \n 83 |     fig = plt.figure(fig_index, figsize=(10, 10))\n 84 |     ax1 = plt.subplot2grid((3, 1), (0, 0), rowspan=2, fig=fig)\n 85 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\nFound file `sklearn/calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/calibration.py` for the full content if needed.\n"}, {"content": "Let me analyze the DaLIC trace artifacts to get more context.\n\n<function=get_trace_artifacts>\n<parameter=artifact_type>all</parameter>\n<parameter=start>0</parameter>\n<parameter=limit>5</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_trace_artifacts", "content": "OBSERVATION:\n{\n  \"instance_id\": \"scikit-learn__scikit-learn-17443\",\n  \"trace_summary\": {\n    \"unique_function_count\": 708,\n    \"returned_count\": 5,\n    \"filtered_count\": 708\n  },\n  \"applied_filters\": {\n    \"artifact_type\": \"all\",\n    \"path_contains\": null,\n    \"name_contains\": null,\n    \"start\": 0,\n    \"limit\": 5\n  },\n  \"artifacts\": [\n    {\n      \"qualified_name\": \"amax\",\n      \"path\": \"data point 125/DaLIC/<__array_function__ internals>\",\n      \"definition_type\": \"function\",\n      \"defined_line\": null,\n      \"end_line\": null,\n      \"event_count\": 48,\n      \"call_count\": 6,\n      \"max_call_depth\": 19\n    },\n    {\n      \"qualified_name\": \"amin\",\n      \"path\": \"data point 125/DaLIC/<__array_function__ internals>\",\n      \"definition_type\": \"function\",\n      \"defined_line\": null,\n      \"end_line\": null,\n      \"event_count\": 16,\n      \"call_count\": 2,\n      \"max_call_depth\": 7\n    },\n    {\n      \"qualified_name\": \"array_split\",\n      \"path\": \"data point 125/DaLIC/<__array_function__ internals>\",\