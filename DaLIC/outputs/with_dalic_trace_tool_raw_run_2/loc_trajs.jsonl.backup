168 |         train : record array, shape = (1624,)\n169 |             The training points for the data.  Each point has three fields:\n170 | \n171 |             - train['species'] is the species name\n172 |             - train['dd long'] is the longitude, in degrees\n173 |             - train['dd lat'] is the latitude, in degrees\n174 |         test : record array, shape = (620,)\n175 |             The test points for the data.  Same format as the training data.\n176 |         Nx, Ny : integers\n177 |             The number of longitudes (x) and latitudes (y) in the grid\n178 |         x_left_lower_corner, y_left_lower_corner : floats\n179 |             The (x,y) position of the lower-left corner, in degrees\n180 |         grid_size : float\n181 |             The spacing between points of the grid, in degrees\n182 | \n183 |     References\n184 |     ----------\n185 | \n186 |     * `\"Maximum entropy modeling of species geographic distributions\"\n187 |       <http://rob.schapire.net/papers/ecolmod.pdf>`_\n188 |       S. J. Phillips, R. P. Anderson, R. E. Schapire - Ecological Modelling,\n189 |       190:231-259, 2006.\n190 | \n191 |     Notes\n192 |     -----\n193 | \n194 |     This dataset represents the geographic distribution of species.\n195 |     The dataset is provided by Phillips et. al. (2006).\n196 | \n197 |     The two species are:\n198 | \n199 |     - `\"Bradypus variegatus\"\n200 |       <http://www.iucnredlist.org/details/3038/0>`_ ,\n201 |       the Brown-throated Sloth.\n202 | \n203 |     - `\"Microryzomys minutus\"\n204 |       <http://www.iucnredlist.org/details/13408/0>`_ ,\n205 |       also known as the Forest Small Rice Rat, a rodent that lives in Peru,\n206 |       Colombia, Ecuador, Peru, and Venezuela.\n207 | \n208 |     - For an example of using this dataset with scikit-learn, see\n209 |       :ref:`examples/applications/plot_species_distribution_modeling.py\n210 |       <sphx_glr_auto_examples_applications_plot_species_distribution_modeling.py>`.\n211 |     \"\"\"\n212 |     data_home = get_data_home(data_home)\n213 |     if not exists(data_home):\n214 |         makedirs(data_home)\n215 | \n216 |     # Define parameters for the data files.  These should not be changed\n217 |     # unless the data model changes.  They will be saved in the npz file\n218 |     # with the downloaded data.\n219 |     extra_params = dict(x_left_lower_corner=-94.8,\n220 |                         Nx=1212,\n221 |                         y_left_lower_corner=-56.05,\n222 |                         Ny=1592,\n223 |                         grid_size=0.05)\n224 |     dtype = np.int16\n225 | \n226 |     archive_path = _pkl_filepath(data_home, DATA_ARCHIVE_NAME)\n227 | \n228 |     if not exists(archive_path):\n229 |         if not download_if_missing:\n230 |             raise IOError(\"Data not found and `download_if_missing` is False\")\n231 |         logger.info('Downloading species data from %s to %s' % (\n232 |             SAMPLES.url, data_home))\n233 |         samples_path = _fetch_remote(SAMPLES, dirname=data_home)\n234 |         with np.load(samples_path) as X:  # samples.zip is a valid npz\n235 |             for f in X.files:\n236 |                 fhandle = BytesIO(X[f])\n237 |                 if 'train' in f:\n238 |                     train = _load_csv(fhandle)\n239 |                 if 'test' in f:\n240 |                     test = _load_csv(fhandle)\n241 |         remove(samples_path)\n242 | \n243 |         logger.info('Downloading coverage data from %s to %s' % (\n244 |             COVERAGES.url, data_home))\n245 |         coverages_path = _fetch_remote(COVERAGES, dirname=data_home)\n246 |         with np.load(coverages_path) as X:  # coverages.zip is a valid npz\n247 |             coverages = []\n248 |             for f in X.files:\n249 |                 fhandle = BytesIO(X[f])\n250 |                 logger.debug(' - converting {}'.format(f))\n251 |                 coverages.append(_load_coverage(fhandle))\n252 |             coverages = np.asarray(coverages, dtype=dtype)\n253 |         remove(coverages_path)\n254 | \n255 |         bunch = Bunch(coverages=coverages,\n256 |                       test=test,\n257 |                       train=train,\n258 |                       **extra_params)\n259 |         joblib.dump(bunch, archive_path, compress=9)\n260 |     else:\n261 |         bunch = joblib.load(archive_path)\n262 | \n263 |     return bunch\n```\n\nFound function `sklearn/datasets/_lfw.py:_check_fetch_lfw`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 74 | def _check_fetch_lfw(data_home=None, funneled=True, download_if_missing=True):\n 75 |     \"\"\"Helper function to download any missing LFW data\"\"\"\n 76 | \n 77 |     data_home = get_data_home(data_home=data_home)\n 78 |     lfw_home = join(data_home, \"lfw_home\")\n 79 | \n 80 |     if not exists(lfw_home):\n 81 |         makedirs(lfw_home)\n 82 | \n 83 |     for target in TARGETS:\n 84 |         target_filepath = join(lfw_home, target.filename)\n 85 |         if not exists(target_filepath):\n 86 |             if download_if_missing:\n 87 |                 logger.info(\"Downloading LFW metadata: %s\", target.url)\n 88 |                 _fetch_remote(target, dirname=lfw_home)\n 89 |             else:\n 90 |                 raise IOError(\"%s is missing\" % target_filepath)\n 91 | \n 92 |     if funneled:\n 93 |         data_folder_path = join(lfw_home, \"lfw_funneled\")\n 94 |         archive = FUNNELED_ARCHIVE\n 95 |     else:\n 96 |         data_folder_path = join(lfw_home, \"lfw\")\n 97 |         archive = ARCHIVE\n 98 | \n 99 |     if not exists(data_folder_path):\n100 |         archive_path = join(lfw_home, archive.filename)\n101 |         if not exists(archive_path):\n102 |             if download_if_missing:\n103 |                 logger.info(\"Downloading LFW data (~200MB): %s\",\n104 |                             archive.url)\n105 |                 _fetch_remote(archive, dirname=lfw_home)\n106 |             else:\n107 |                 raise IOError(\"%s is missing\" % archive_path)\n108 | \n109 |         import tarfile\n110 |         logger.debug(\"Decompressing the data archive to %s\", data_folder_path)\n111 |         tarfile.open(archive_path, \"r:gz\").extractall(path=lfw_home)\n112 |         remove(archive_path)\n113 | \n114 |     return lfw_home, data_folder_path\n```\n\nFound function `examples/applications/plot_out_of_core_classification.py:stream_reuters_documents`.\nSource: Retrieved code content using keyword search (bm25).\n```\n136 | def stream_reuters_documents(data_path=None):\n137 |     \"\"\"Iterate over documents of the Reuters dataset.\n138 | \n139 |     The Reuters archive will automatically be downloaded and uncompressed if\n140 |     the `data_path` directory does not exist.\n141 | \n142 |     Documents are represented as dictionaries with 'body' (str),\n143 |     'title' (str), 'topics' (list(str)) keys.\n144 | \n145 |     \"\"\"\n146 | \n147 |     DOWNLOAD_URL = ('http://archive.ics.uci.edu/ml/machine-learning-databases/'\n148 |                     'reuters21578-mld/reuters21578.tar.gz')\n149 |     ARCHIVE_FILENAME = 'reuters21578.tar.gz'\n150 | \n151 |     if data_path is None:\n152 |         data_path = os.path.join(get_data_home(), \"reuters\")\n153 |     if not os.path.exists(data_path):\n154 |         \"\"\"Download the dataset.\"\"\"\n155 |         print(\"downloading dataset (once and for all) into %s\" %\n156 |               data_path)\n157 |         os.mkdir(data_path)\n158 | \n159 |         def progress(blocknum, bs, size):\n160 |             total_sz_mb = '%.2f MB' % (size / 1e6)\n161 |             current_sz_mb = '%.2f MB' % ((blocknum * bs) / 1e6)\n162 |             if _not_in_sphinx():\n163 |                 sys.stdout.write(\n164 |                     '\\rdownloaded %s / %s' % (current_sz_mb, total_sz_mb))\n165 | \n166 |         archive_path = os.path.join(data_path, ARCHIVE_FILENAME)\n167 |         urlretrieve(DOWNLOAD_URL, filename=archive_path,\n168 |                     reporthook=progress)\n169 |         if _not_in_sphinx():\n170 |             sys.stdout.write('\\r')\n171 |         print(\"untarring Reuters dataset...\")\n172 |         tarfile.open(archive_path, 'r:gz').extractall(data_path)\n173 |         print(\"done.\")\n174 | \n175 |     parser = ReutersParser()\n176 |     for filename in glob(os.path.join(data_path, \"*.sgm\")):\n177 |         for doc in parser.parse(open(filename, 'rb')):\n178 |             yield doc\n```\n\n\n\n##Searching for term \"download\", \"checksum md5 download\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch`.\nSource: Retrieved entity using keyword search (bm25).\n```\n509 | def _download_data_to_bunch(\n510 |     url: str,\n511 |     sparse: bool,\n512 |     data_home: Optional[str],\n513 |     *,\n514 |     as_frame: bool,\n515 |     features_list: List,\n516 |     data_columns: List[int],\n517 |     target_columns: List,\n518 |     shape: Optional[Tuple[int, int]]\n519 | ):\n520 |     \"\"\"Download OpenML ARFF and convert to Bunch of data\n521 |     \"\"\"\n522 |     # NB: this function is long in order to handle retry for any failure\n523 |     #     during the streaming parse of the ARFF.\n524 | \n525 |     # Prepare which columns and data types should be returned for the X and y\n526 |     features_dict = {feature['name']: feature for feature in features_list}\n527 | \n528 |     # XXX: col_slice_y should be all nominal or all numeric\n529 |     _verify_target_data_type(features_dict, target_columns)\n530 | \n531 |     col_slice_y = [int(features_dict[col_name]['index'])\n532 |                    for col_name in target_columns]\n533 | \n534 |     col_slice_x = [int(features_dict[col_name]['index'])\n535 |                    for col_name in data_columns]\n536 |     for col_idx in col_slice_y:\n537 |         feat = features_list[col_idx]\n538 |         nr_missing = int(feat['number_of_missing_values'])\n539 |         if nr_missing > 0:\n540 |             raise ValueError('Target column {} has {} missing values. '\n541 |                              'Missing values are not supported for target '\n542 |                              'columns. '.format(feat['name'], nr_missing))\n543 | \n544 |     # Access an ARFF file on the OpenML server. Documentation:\n545 |     # https://www.openml.org/api_data_docs#!/data/get_download_id\n546 | \n547 |     if sparse is True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n```\n\nFound function `sklearn/datasets/_twenty_newsgroups.py:_download_20newsgroups`.\nSource: Retrieved entity using keyword search (bm25).\n```\n65 | def _download_20newsgroups(target_dir, cache_path):\n66 |     \"\"\"Download the 20 newsgroups data and stored it as a zipped pickle.\"\"\"\n67 |     train_path = os.path.join(target_dir, TRAIN_FOLDER)\n68 |     test_path = os.path.join(target_dir, TEST_FOLDER)\n69 | \n70 |     if not os.path.exists(target_dir):\n71 |         os.makedirs(target_dir)\n72 | \n73 |     logger.info(\"Downloading dataset from %s (14 MB)\", ARCHIVE.url)\n74 |     archive_path = _fetch_remote(ARCHIVE, dirname=target_dir)\n75 | \n76 |     logger.debug(\"Decompressing %s\", archive_path)\n77 |     tarfile.open(archive_path, \"r:gz\").extractall(path=target_dir)\n78 |     os.remove(archive_path)\n79 | \n80 |     # Store a zipped pickle\n81 |     cache = dict(train=load_files(train_path, encoding='latin1'),\n82 |                  test=load_files(test_path, encoding='latin1'))\n83 |     compressed_content = codecs.encode(pickle.dumps(cache), 'zlib_codec')\n84 |     with open(cache_path, 'wb') as f:\n85 |         f.write(compressed_content)\n86 | \n87 |     shutil.rmtree(target_dir)\n88 |     return cache\n```\n\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch.postprocess`.\nSource: Retrieved entity using keyword search (bm25).\n```\n582 | def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in e