urn result\n480 |     # Handle single values.\n481 |     # Note that this occurs *after* handling inputs that are already arrays, as\n482 |     # `to_rgba(c, alpha)` (below) is expensive for such inputs, due to the need\n483 |     # to format the array in the ValueError message(!).\n484 |     if cbook._str_lower_equal(c, \"none\"):\n485 |         return np.zeros((0, 4), float)\n486 |     try:\n487 |         if np.iterable(alpha):\n488 |             return np.array([to_rgba(c, a) for a in alpha], float)\n489 |         else:\n490 |             return np.array([to_rgba(c, alpha)], float)\n491 |     except TypeError:\n492 |         pass\n493 |     except ValueError as e:\n494 |         if e.args == (\"'alpha' must be between 0 and 1, inclusive\", ):\n495 |             # ValueError is from _to_rgba_no_colorcycle().\n496 |             raise e\n497 |     if isinstance(c, str):\n498 |         raise ValueError(f\"{c!r} is not a valid color value.\")\n499 | \n500 |     if len(c) == 0:\n501 |         return np.zeros((0, 4), float)\n502 | \n503 |     # Quick path if the whole sequence can be directly converted to a numpy\n504 |     # array in one shot.\n505 |     if isinstance(c, Sequence):\n506 |         lens = {len(cc) if isinstance(cc, (list, tuple)) else -1 for cc in c}\n507 |         if lens == {3}:\n508 |             rgba = np.column_stack([c, np.ones(len(c))])\n509 |         elif lens == {4}:\n510 |             rgba = np.array(c)\n511 |         else:\n512 |             rgba = np.array([to_rgba(cc) for cc in c])\n513 |     else:\n514 |         rgba = np.array([to_rgba(cc) for cc in c])\n515 | \n516 |     if alpha is not None:\n517 |         rgba[:, 3] = alpha\n518 |         if isinstance(c, Sequence):\n519 |             # ensure that an explicit alpha does not overwrite full transparency\n520 |             # for \"none\"\n521 |             none_mask = [cbook._str_equal(cc, \"none\") for cc in c]\n522 |             rgba[:, 3][none_mask] = 0\n523 |     return rgba\n```\n"},