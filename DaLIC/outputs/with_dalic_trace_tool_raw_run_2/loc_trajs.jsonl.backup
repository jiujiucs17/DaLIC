": np.column_stack([vals, a, a]),\n1115 |         }\n1116 | \n1117 |         return LinearSegmentedColormap(name, cdict, N, gamma)\n```\n\nFound file `galleries/users_explain/colors/colors.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/users_explain/colors/colors.py` for the full content if needed.\n\n\n\n##Searching for term \"facecolor\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.voxels`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3353 | def voxels(self, *args, facecolors=None, edgecolors=None, shade=True,\n3354 |                lightsource=None, axlim_clip=False, **kwargs):\n3355 |         \"\"\"\n3356 |         ax.voxels([x, y, z,] /, filled, facecolors=None, edgecolors=None, \\\n3357 | **kwargs)\n3358 | \n3359 |         Plot a set of filled voxels\n3360 | \n3361 |         All voxels are plotted as 1x1x1 cubes on the axis, with\n3362 |         ``filled[0, 0, 0]`` placed with its lower corner at the origin.\n3363 |         Occluded faces are not plotted.\n3364 | \n3365 |         Parameters\n3366 |         ----------\n3367 |         filled : 3D np.array of bool\n3368 |             A 3D array of values, with truthy values indicating which voxels\n3369 |             to fill\n3370 | \n3371 |         x, y, z : 3D np.array, optional\n3372 |             The coordinates of the corners of the voxels. This should broadcast\n3373 |             to a shape one larger in every dimension than the shape of\n3374 |             *filled*.  These can be used to plot non-cubic voxels.\n3375 | \n3376 |             If not specified, defaults to increasing integers along each axis,\n3377 |             like those returned by :func:`~numpy.indices`.\n3378 |             As indicated by the ``/`` in the function signature, these\n3379 |             arguments can only be passed positionally.\n3380 | \n3381 |         facecolors, edgecolors : array-like, optional\n3382 |             The color to draw the faces and edges of the voxels. Can only be\n3383 |             passed as keyword arguments.\n3384 |             These parameters can be:\n3385 | \n3386 |             - A single color value, to color all voxels the same color. This\n3387 |               can be either a string, or a 1D RGB/RGBA array\n3388 |             - ``None``, the default, to use a single color for the faces, and\n3389 |               the style default for the edges.\n3390 |             - A 3D `~numpy.ndarray` of color names, with each item the color\n3391 |               for the corresponding voxel. The size must match the voxels.\n3392 |             - A 4D `~numpy.ndarray` of RGB/RGBA data, with the components\n3393 |               along the last axis.\n3394 | \n3395 |         shade : bool, default: True\n3396 |             Whether to shade the facecolors.\n3397 | \n3398 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3399 |             The lightsource to use when *shade* is True.\n3400 | \n3401 |         axlim_clip : bool, default: False\n3402 |             Whether to hide voxels with points outside the axes view limits.\n3403 | \n3404 |             .. versionadded:: 3.10\n3405 | \n3406 |         **kwargs\n3407 |             Additional keyword arguments to pass onto\n3408 |             `~mpl_toolkits.mplot3d.art3d.Poly3DCollection`.\n3409 | \n3410 |         Returns\n3411 |         -------\n3412 |         faces : dict\n3413 |             A dictionary indexed by coordinate, where ``faces[i, j, k]`` is a\n3414 |             `.Poly3DCollection` of the faces drawn for the voxel\n3415 |             ``filled[i, j, k]``. If no faces were drawn for a given voxel,\n3416 |             either because it was not asked to be drawn, or it is fully\n3417 |             occluded, then ``(i, j, k) not in faces``.\n3418 | \n3419 |         Examples\n3420 |         --------\n3421 |         .. plot:: gallery/mplot3d/voxels.py\n3422 |         .. plot:: gallery/mplot3d/voxels_rgb.py\n3423 |         .. plot:: gallery/mplot3d/voxels_torus.py\n3424 |         .. plot:: gallery/mplot3d/voxels_numpy_logo.py\n3425 |         \"\"\"\n3426 | \n3427 |         # work out which signature we should be using, and use it to parse\n3428 |         # the arguments. Name must be voxels for the correct error message\n3429 |         if len(args) >= 3:\n3430 |             # underscores indicate position only\n3431 |             def voxels(__x, __y, __z, filled, **kwargs):\n3432 |                 return (__x, __y, __z), filled, kwargs\n3433 |         else:\n3434 |             def voxels(filled, **kwargs):\n3435 |                 return None, filled, kwargs\n3436 | \n3437 |         xyz, filled, kwargs = voxels(*args, **kwargs)\n3438 | \n3439 |         # check dimensions\n3440 |         if filled.ndim != 3:\n3441 |             raise ValueError(\"Argument filled must be 3-dimensional\")\n3442 |         size = np.array(filled.shape, dtype=np.intp)\n3443 | \n3444 |         # check xyz coordinates, which are one larger than the filled shape\n3445 |         coord_shape = tuple(size + 1)\n3446 |         if xyz is None:\n3447 |             x, y, z = np.indices(coord_shape)\n3448 |         else:\n3449 |             x, y, z = (np.broadcast_to(c, coord_shape) for c in xyz)\n3450 | \n3451 |         def _broadcast_color_arg(color, name):\n3452 |             if np.ndim(color) in (0, 1):\n3453 |                 # single color, like \"red\" or [1, 0, 0]\n3454 |                 return np.broadcast_to(color, filled.shape + np.shape(color))\n3455 |             elif np.ndim(color) in (3, 4):\n3456 |                 # 3D array of strings, or 4D array with last axis rgb\n3457 |                 if np.shape(color)[:3] != filled.shape:\n3458 |                     raise ValueError(\n3459 |                         f\"When multidimensional, {name} must match the shape \"\n3460 |                         \"of filled\")\n3461 |                 return color\n3462 |             else:\n3463 |                 raise ValueError(f\"Invalid {name} argument\")\n3464 | \n3465 |         # broadcast and default on facecolors\n3466 |         if facecolors is None:\n3467 |             facecolors = self._get_patches_for_fill.get_next_color()\n3468 |         facecolors = _broadcast_color_arg(facecolors, 'facecolors')\n3469 | \n3470 |         # broadcast but no default on edgecolors\n3471 |         edgecolors = _broadcast_color_arg(edgecolors, 'edgecolors')\n3472 | \n3473 |         # scale to the full array, even if the data is only in the center\n3474 |         self.auto_scale_xyz(x, y, z)\n3475 | \n3476 |         # points lying on corners of a square\n3477 |         square = np.array([\n3478 |             [0, 0, 0],\n3479 |             [1, 0, 0],\n3480 |             [1, 1, 0],\n3481 |             [0, 1, 0],\n3482 |         ], dtype=np.intp)\n3483 | \n3484 |         voxel_faces = defaultdict(list)\n3485 | \n3486 |         def permutation_matrices(n):\n3487 |             \"\"\"Generate cyclic permutation matrices.\"\"\"\n3488 |             mat = np.eye(n, dtype=np.intp)\n3489 |             for i in range(n):\n3490 |                 yield mat\n3491 |                 mat = np.roll(mat, 1, axis=0)\n3492 | \n3493 |         # iterate over each of the YZ, ZX, and XY orientations, finding faces\n3494 |         # to render\n3495 |         for permute in permutation_matrices(3):\n3496 |             # find the set of ranges to iterate over\n3497 |             pc, qc, rc = permute.T.dot(size)\n3498 |             pinds = np.arange(pc)\n3499 |             qinds = np.arange(qc)\n3500 |             rinds = np.arange(rc)\n3501 | \n3502 |             square_rot_pos = square.dot(permute.T)\n3503 |             square_rot_neg = square_rot_pos[::-1]\n3504 | \n3505 |             # iterate within the current plane\n3506 |             for p in pinds:\n3507 |                 for q in qinds:\n3508 |                     # iterate perpendicularly to the current plane, handling\n3509 |                     # b