rray if necessary\n180 |     result = None\n181 | \n182 |     if _can_use_numexpr(None, \"where\", a, b, \"where\"):\n183 |         result = ne.evaluate(\n184 |             \"where(cond_value, a_value, b_value)\",\n185 |             local_dict={\"cond_value\": cond, \"a_value\": a, \"b_value\": b},\n186 |             casting=\"safe\",\n187 |         )\n188 | \n189 |     if result is None:\n190 |         result = _where_standard(cond, a, b)\n191 | \n192 |     return result\n193 | \n194 | \n195 | # turn myself on\n196 | set_use_numexpr(get_option(\"compute.use_numexpr\"))\n197 | \n198 | \n199 | def _has_bool_dtype(x):\n200 |     try:\n201 |         return x.dtype == bool\n202 |     except AttributeError:\n203 |         return isinstance(x, (bool, np.bool_))\n204 | \n205 | \n206 | _BOOL_OP_UNSUPPORTED = {\"+\": \"|\", \"*\": \"&\", \"-\": \"^\"}\n207 | \n208 | \n209 | def _bool_arith_fallback(op_str, a, b) -> bool:\n210 |     \"\"\"\n211 |     Check if we should fallback to the python `_evaluate_standard` in case\n212 |     of an unsupported operation by numexpr, which is the case for some\n213 |     boolean ops.\n214 |     \"\"\"\n215 |     if _has_bool_dtype(a) and _has_bool_dtype(b):\n216 |         if op_str in _BOOL_OP_UNSUPPORTED:\n217 |             warnings.warn(\n218 |                 f\"evaluating in Python space because the {op_str!r} \"\n219 |                 \"operator is not supported by numexpr for the bool dtype, \"\n220 |                 f\"use {_BOOL_OP_UNSUPPORTED[op_str]!r} instead.\",\n221 |                 stacklevel=find_stack_level(),\n222 |             )\n223 |             return True\n224 |     return False\n225 | \n226 | \n227 | def evaluate(op, a, b, use_numexpr: bool = True):\n228 |     \"\"\"\n229 |     Evaluate and return the expression of the op on a and b.\n230 | \n231 |     Parameters\n232 |     ----------\n233 |     op : the actual operand\n234 |     a : left operand\n235 |     b : right operand\n236 |     use_numexpr : bool, default Tr