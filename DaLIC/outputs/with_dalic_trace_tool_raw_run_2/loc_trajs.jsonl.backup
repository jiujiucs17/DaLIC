should\n298 |     fall-back to the default tags.\n299 | \n300 |     For scikit-learn built-in estimators, we should still rely on\n301 |     `self.__sklearn_tags__()`. `get_tags(est)` should be used when we\n302 |     are not sure where `est` comes from: typically\n303 |     `get_tags(self.estimator)` where `self` is a meta-estimator, or in\n304 |     the common checks.\n305 | \n306 |     .. versionadded:: 1.6\n307 | \n308 |     Parameters\n309 |     ----------\n310 |     estimator : estimator object\n311 |         The estimator from which to get the tag.\n312 | \n313 |     Returns\n314 |     -------\n315 |     tags : :class:`~.sklearn.utils.Tags`\n316 |         The estimator tags.\n317 |     \"\"\"\n318 | \n319 |     if hasattr(estimator, \"__sklearn_tags__\"):\n320 |         tags = estimator.__sklearn_tags__()\n321 |     else:\n322 |         warnings.warn(\n323 |             f\"Estimator {estimator} has no __sklearn_tags__ attribute, which is \"\n324 |             \"defined in `sklearn.base.BaseEstimator`. This will raise an error in \"\n325 |             \"scikit-learn 1.8. Please define the __sklearn_tags__ method, or inherit \"\n326 |             \"from `sklearn.base.BaseEstimator` and other appropriate mixins such as \"\n327 |             \"`sklearn.base.TransformerMixin`, `sklearn.base.ClassifierMixin`, \"\n328 |             \"`sklearn.base.RegressorMixin`, and `sklearn.base.ClusterMixin`, and \"\n329 |             \"`sklearn.base.OutlierMixin`.\",\n330 |             category=FutureWarning,\n331 |         )\n332 |         tags = default_tags(estimator)\n333 | \n334 |     return tags\n```\n\n\n\n##Searching for term \"_get_tags\", \"_safe_tags _get_tags\"...\n### Search Result:\nFound function `sklearn/utils/estimator_checks.py:check_estimator_tags_renamed`.\nSource: Retrieved code content using keyword search (bm25).\n```\n4447 | def check_estimator_tags_renamed(name, estimator_orig):\n4448 |     help = \"\"\"{tags_func}() was removed in 1.6. Please use __sklearn_tags__ instead.\n4449 | You can implement both __sklearn_tags__() and {tags_func}() to support multiple\n4450 | scikit-learn versions.\n4451 | \"\"\"\n4452 | \n4453 |     for klass in type(estimator_orig).mro():\n4454 |         if (\n4455 |             # Here we check vars(...) because we want to check if the method is\n4456 |             # explicitly defined in the class instead of inherited from a parent class.\n4457 |             (\"_more_tags\" in vars(klass) or \"_get_tags\" in vars(klass))\n4458 |             and \"__sklearn_tags__\" not in vars(klass)\n4459 |         ):\n4460 |             raise TypeError(\n4461 |                 f\"Estimator {name} has defined either `_more_tags` or `_get_tags`,\"\n4462 |                 \" but not `__sklearn_tags__`. If you're customizing tags, and need to\"\n4463 |                 \" support multiple scikit-learn versions, you can implement both\"\n4464 |                 \" `__sklearn_tags__` and `_more_tags` or `_get_tags`. This change was\"\n4465 |                 \" introduced in scikit-learn=1.6\"\n4466 |             )\n```\n\n\n\n##Searching for term \"estimator\"...\n### Search Result:\nFound class `asv_benchmarks/benchmarks/common.py:Estimator`.\nSource: Match found for entity name `estimator`.\n```\n120 | class Estimator(ABC):\n121 |     \"\"\"Abstract base class for all benchmarks of estimators\"\"\"\n122 | \n123 |     @abstractmethod\n124 |     def make_data(self, params):\n125 |         \"\"\"Return the dataset for a combination of parameters\"\"\"\n126 |         # The datasets are cached using joblib.Memory so it's fast and can be\n127 |         # called for each repeat\n128 |         pass\n129 | \n130 |     @abstractmethod\n131 |     def make_estimator(self, params):\n132 |         \"\"\"Return an instance of the estimator for a combination of parameters\"\"\"\n133 |         pass\n134 | \n135 |     def skip(self, params):\n136 |         \"\"\"Return True if the benchmark should be skipped for these params\"\"\"\n137 |         return False\n138 | \n139 |     def setup_cache(self):\n140 |         \"\"\"Pickle a fitted estimator for all combinations of parameters\"\"\"\n141 |         # This is run once per benchmark class.\n142 | \n143 |         clear_tmp()\n144 | \n145 |         param_grid = list(itertools.product(*self.params))\n146 | \n147 |         for params in param_grid:\n148 |             if self.skip(params):\n149 |                 continue\n150 | \n151 |             estimator = self.make_estimator(params)\n152 |             X, _, y, _ = self.make_data(params)\n153 | \n154 |             estimator.fit(X, y)\n155 | \n156 |             est_path = get_estimator_path(\n157 |                 self, Benchmark.save_dir, params, Benchmark.save_estimators\n158 |             )\n159 |             with est_path.open(mode=\"wb\") as f:\n160 |                 pickle.dump(estimator, f)\n161 | \n162 |     def setup(self, *params):\n163 |         \"\"\"Generate dataset and load the fitted estimator\"\"\"\n164 |         # This is run once per combination of parameters and per repeat so we\n165 |         # need to avoid doing expensive operations there.\n166 | \n167 |         if self.skip(params):\n168 |             raise NotImplementedError\n169 | \n170 |         self.X, self.X_val, self.y, self.y_val = self.make_data(params)\n171 | \n172 |         est_path = get_estimator_path(\n173 |             self, Benchmark.save_dir, params, Benchmark.save_estimators\n174 |         )\n175 |         with est_path.open(mode=\"rb\") as f:\n176 |             self.estimator = pickle.load(f)\n177 | \n178 |         self.make_scorers()\n179 | \n180 |     def time_fit(self, *args):\n181 |         self.estimator.fit(self.X, self.y)\n182 | \n183 |     def peakmem_fit(self, *args):\n184 |         self.estimator.fit(self.X, self.y)\n185 | \n186 |     def track_train_score(self, *args):\n187 |         if hasattr(self.estimator, \"predict\"):\n188 |             y_pred = self.estimator.predict(self.X)\n189 |         else:\n190 |             y_pred = None\n191 |         return float(self.train_scorer(self.y, y_pred))\n192 | \n193 |     def track_test_score(self, *args):\n194 |         if hasattr(self.estimator, \"predict\"):\n195 |             y_val_pred = self.estimator.predict(self.X_val)\n196 |         else:\n197 |             y_val_pred = None\n198 |         return float(self.test_scorer(self.y_val, y_val_pred))\n```\n\n\n\n##Searching for term \"_safe_tags _get_tags\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/__init__.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Utilities to load popular datasets and artificial data generators.\"\"\"\n  2 | \n  3 | # Authors: The scikit-learn developers\n  4 | # SPDX-License-Identifier: BSD-3-Clause\n  5 | \n  6 | import textwrap\n  7 | \n  8 | from ._base import (\n  9 |     clear_data_home,\n 10 |     fetch_file,\n 11 |     get_data_home,\n 12 |     load_breast_cancer,\n 13 |     load_diabetes,\n 14 |     load_digits,\n 15 |     load_files,\n 16 |     load_iris,\n 17 |     load_linnerud,\n 18 |     load_sample_image,\n 19 |     load_sample_images,\n 20 |     load_wine,\n 21 | )\n 22 | from ._california_housing import fetch_california_housing\n 23 | from ._covtype import fetch_covtype\n 24 | from ._kddcup99 import fetch_kddcup99\n 25 | from ._lfw import fetch_lfw_pairs, fetch_lfw_people\n 26 | from ._olivetti_faces import fetch_olivetti_faces\n 27 | from ._openml import fetch_openml\n 28 | from ._rcv1 import fetch_rcv1\n 29 | from ._samples_generator import (\n 30 |     make_biclusters,\n 31 |     make_blobs,\n 32 |     make_checkerboard,\n 33 |     make_circles,\n 34 |     make_classification,\n 35 |     make_friedman1,\n 36 |     make_friedman2,\n 37 |     make_friedman3,\n 38 |     make_gaussian_quantiles,\n 39 |     make_hastie_10_2,\n 40 |     make_low_rank_matrix,\n 41 |     make_moons,\n 42 |     make_multilabel_classification,\n 43 |     make_regression,\n