options: StorageOptions | None = None,\n2168 |         engine_kwargs: dict[str, Any] | None = None,\n2169 |     ) -> None:\n2170 |         \"\"\"\n2171 |         Write {klass} to an Excel sheet.\n2172 | \n2173 |         To write a single {klass} to an Excel .xlsx file it is only necessary to\n2174 |         specify a target file name. To write to multiple sheets it is necessary to\n2175 |         create an `ExcelWriter` object with a target file name, and specify a sheet\n2176 |         in the file to write to.\n2177 | \n2178 |         Multiple sheets may be written to by specifying unique `sheet_name`.\n2179 |         With all data written to the file it is necessary to save the changes.\n2180 |         Note that creating an `ExcelWriter` object with a file name that already\n2181 |         exists will result in the contents of the existing file being erased.\n2182 | \n2183 |         Parameters\n2184 |         ----------\n2185 |         excel_writer : path-like, file-like, or ExcelWriter object\n2186 |             File path or existing ExcelWriter.\n2187 |         sheet_name : str, default 'Sheet1'\n2188 |             Name of sheet which will contain DataFrame.\n2189 |         na_rep : str, default ''\n2190 |             Missing data representation.\n2191 |         float_format : str, optional\n2192 |             Format string for floating point numbers. For example\n2193 |             ``float_format=\"%.2f\"`` will format 0.1234 to 0.12.\n2194 |         columns : sequence or list of str, optional\n2195 |             Columns to write.\n2196 |         header : bool or list of str, default True\n2197 |             Write out the column names. If a list of string is given it is\n2198 |             assumed to be aliases for the column names.\n2199 |         index : bool, default True\n2200 |             Write row names (index).\n2201 |         index_label : str or sequence, optional\n2202 |             Column label for index column(s) if desired. If not specified, and\n2203 |             `header` and `index` are True, then the index names are used. A\n2204 |             sequence should be given if the DataFrame uses MultiIndex.\n2205 |         startrow : int, default 0\n2206 |             Upper left cell row to dump data frame.\n2207 |         startcol : int, default 0\n2208 |             Upper left cell column to dump data frame.\n2209 |         engine : str, optional\n2210 |             Write engine to use, 'openpyxl' or 'xlsxwriter'. You can also set this\n2211 |             via the options ``io.excel.xlsx.writer`` or\n2212 |             ``io.excel.xlsm.writer``.\n2213 | \n2214 |         merge_cells : bool, default True\n2215 |             Write MultiIndex and Hierarchical Rows as merged cells.\n2216 |         {encoding_parameter}\n2217 |         inf_rep : str, default 'inf'\n2218 |             Representation for infinity (there is no native representation for\n2219 |             infinity in Excel).\n2220 |         {verbose_parameter}\n2221 |         freeze_panes : tuple of int (length 2), optional\n2222 |             Specifies the one-based bottommost row and rightmost column that\n2223 |             is to be frozen.\n2224 |         {storage_options}\n2225 | \n2226 |             .. versionadded:: {storage_options_versionadded}\n2227 |         {extra_parameters}\n2228 |         See Also\n2229 |         --------\n2230 |         to_csv : Write DataFrame to a comma-separated values (csv) file.\n2231 |         ExcelWriter : Class for writing DataFrame objects into excel sheets.\n2232 |         read_excel : Read an Excel file into a pandas DataFrame.\n2233 |         read_csv : Read a comma-separated values (csv) file into DataFrame.\n2234 |         io.formats.style.Styler.to_excel : Add styles to Excel sheet.\n2235 | \n2236 |         Notes\n2237 |         -----\n2238 |         For compatibility with :meth:`~DataFrame.to_csv`,\n2239 |         to_excel serializes lists and dicts to strings before writing.\n2240 | \n2241 |         Once a workbook has been saved it is not possible to write further\n2242 |         data without rewriting the whole workbook.\n2243 | \n2244 |         pandas will check the number of rows, columns,\n2245 |         and cell character count does not exceed Excel's limitations.\n2246 |         All other limitations must be checked by the user.\n2247 | \n2248 |         Examples\n2249 |         --------\n2250 | \n2251 |         Create, write to and save a workbook:\n2252 | \n2253 |         >>> df1 = pd.DataFrame(\n2254 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2255 |         ...     index=[\"row 1\", \"row 2\"],\n2256 |         ...     columns=[\"col 1\", \"col 2\"],\n2257 |         ... )\n2258 |         >>> df1.to_excel(\"output.xlsx\")  # doctest: +SKIP\n2259 | \n2260 |         To specify the sheet name:\n2261 | \n2262 |         >>> df1.to_excel(\"output.xlsx\", sheet_name=\"Sheet_name_1\")  # doctest: +SKIP\n2263 | \n2264 |         If you wish to write to more than one sheet in the workbook, it is\n2265 |         necessary to specify an ExcelWriter object:\n2266 | \n2267 |         >>> df2 = df1.copy()\n2268 |         >>> with pd.ExcelWriter(\"output.xlsx\") as writer:  # doctest: +SKIP\n2269 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_1\")\n2270 |         ...     df2.to_excel(writer, sheet_name=\"Sheet_name_2\")\n2271 | \n2272 |         ExcelWriter can also be used to append to an existing Excel file:\n2273 | \n2274 |         >>> with pd.ExcelWriter(\"output.xlsx\", mode=\"a\") as writer:  # doctest: +SKIP\n2275 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_3\")\n2276 | \n2277 |         To set the library that is used to write the Excel file,\n2278 |         you can pass the `engine` keyword (the default engine is\n2279 |         automatically chosen depending on the file extension):\n2280 | \n2281 |         >>> df1.to_excel(\"output1.xlsx\", engine=\"xlsxwriter\")  # doctest: +SKIP\n2282 |         \"\"\"\n2283 |         if engine_kwargs is None:\n2284 |             engine_kwargs = {}\n2285 | \n2286 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n2287 | \n2288 |         from pandas.io.formats.excel import ExcelFormatter\n2289 | \n2290 |         formatter = ExcelFormatter(\n2291 |             df,\n2292 |             na_rep=na_rep,\n2293 |             cols=columns,\n2294 |             header=header,\n2295 |             float_format=float_format,\n2296 |             index=index,\n2297 |             index_label=index_label,\n2298 |             merge_cells=merge_cells,\n2299 |             inf_rep=inf_rep,\n2300 |         )\n2301 |         formatter.write(\n2302 |             excel_writer,\n2303 |             sheet_name=sheet_name,\n2304 |             startrow=startrow,\n2305 |             startcol=startcol,\n2306 |             freeze_panes=freeze_panes,\n2307 |             engine=engine,\n2308 |             storage_options=storage_options,\n2309 |             engine_kwargs=engine_kwargs,\n2310 |         )\n```\n\nFound function `pandas/core/generic.py:NDFrame.to_json`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2317 | def to_json(\n2318 |         self,\n2319 |         path_or_buf: FilePath | WriteBuffer[bytes] | WriteBuffer[str] | None = None,\n2320 |         *,\n2321 |         orient: Literal[\"split\", \"records\", \"index\", \"table\", \"columns\", \"values\"]\n2322 |         | None = None,\n2323 |         date_format: str | None = None,\n2324 |         double_precision: int = 10,\n2325 |         force_ascii: bool = True,\n2326 |         date_unit: TimeUnit = \"ms\",\n2327 |         default_handler: Callable[[Any], JSONSerializable] | None = None,\n2328 |         lines: bool = False,\n2329 |         compression: CompressionOptions = \"infer\",\n2330 |         index: bool | None = None,\n2331 |         indent: int | None = None,\n2332 |         storage_options: StorageOptions | None = None,\n2333 |         mode: Literal[\"a\", \"w\"] = \"w\",\n2334 |     ) -> str | None:\n2335 |         \"\"\"\n2336 |         Convert the object to a JSON string.\n2337 | \n2338 |         Note NaN's and None will be converted to null and datetime objects\n2339 |         will be converted to UNIX timestamps.\n2340 | \n2341 |         Parameters\n2342 |         ----------\n2343 |         path_or_buf : str, path object, file-like object, or None, default None\n2344 |             String, path object (implementing os.PathLike[str]), or file-like\n2345 |             object implementing a write() function. If None, the result is\n2346 |             returned as a string.\n2347 |         orient : str\n2348 |             Indication of expected JSON string format.\n2349 | \n2350 |             * Series:\n2351 | \n2352 |                 - default is 'index'\n2353 |                 - allowed values are: {{'split', 'records', 'index', 'table'}}.\n2354 | \n2355 |             * DataFrame:\n2356 | \n2357 |                 - default is 'columns'\n2358 |                 - allowed values are: {{'split', 'records', 'index', 'columns',\n2359 |                   'values', 'table'}}.\n2360 | \n2361 |             * The format of the JSON string:\n2362 | \n2363 |                 - 'split' : dict like {{'index' -> [index], 'columns' -> [columns],\n2364 |                   'data' -> [values]}}\n2365 |                 - 'records' : list like [{{column -> value}}, ... , {{column -> value}}]\n2366 |                 - 'index' : dict like {{index -> {{column -> value}}}}\n2367 |                 - 'columns' : dict like {{column -> {{index -> value}}}}\n2368 |                 - 'values' : just the values array\n2369 |                 - 'table' : dict like {{'schema': {{schema}}, 'data': {{data}}}}\n2370 | \n2371 |                 Describing the data, where data component is like ``orient='records'``.\n2372 | \n2373 |         date_format : {{None, 'epoch', 'iso'}}\n2374 |             Type of date conversion. 'epoch' = epoch milliseconds,\n2375 |             'iso' = ISO8601. The default depends on the `orient`. For\n2376 |             ``orient='table'``, the default is 'iso'. For all other orients,\n2377 |             the default is 'epoch'.\n2378 | \n2379 |             .. deprecated:: 3.0.0\n2380 |                 'epoch' date format is deprecated and will be removed in a future\n2381 |                 version, please use 'iso' instead.\n2382 | \n2383 |         double_precision : int, default 10\n2384 |             The number of decimal places to use when encoding\n2385 |             floating point values. The possible maximal value is 15.\n2386 |             Passing double_precision greater than 15 will raise a ValueError.\n2387 |         force_ascii : bool, default True\n2388 |             Force encoded string to be ASCII.\n2389 |         date_unit : str, default 'ms' (milliseconds)\n2390 |             The time unit to encode to, governs timestamp and ISO8601\n2391 |             precision.  One of 's', 'ms', 'us', 'ns' for second, millisecond,\n2392 |             microsecond, and nanosecond respectively.\n2393 |         default_handler : callable, default None\n2394 |             Handler to call if object cannot otherwise be converted to a\n2395 |             suitable format for JSON. Should receive a single argument which is\n2396 |             the object to convert and return a serialisable object.\n2397 |         lines : bool, default False\n2398 |             If 'orient' is 'records' write out line-delimited json format. Will\n2399 |             throw ValueError if incorrect 'orient' since others are not\n2400 |             list-like.\n2401 |         {compression_options}\n2402 | \n2403 |             .. versionchanged:: 1.4.0 Zstandard support.\n2404 | \n2405 |         index : bool or None, default None\n2406 |             The index is only used when 'orient' is 'split', 'index', 'column',\n2407 |             or 'table'. Of these, 'index' and 'column' do not support\n2408 |             `index=False`. The string 'index' as a column name with empty :class:`Index`\n2409 |             or if it is 'index' will raise a ``ValueError``.\n2410 | \n2411 |         indent : int, optional\n2412 |            Length of whitespace used to indent each record.\n2413 | \n2414 |         {storage_options}\n2415 | \n2416 |         mode : str, default 'w' (writing)\n2417 |             Specify the IO mode for output when supplying a path_or_buf.\n2418 |             Accepted args are 'w' (writing) and 'a' (append) only.\n2419 |             mode='a' is only supported when lines is True and orient is 'records'.\n2420 | \n2421 |         Returns\n2422 |         -------\n2423 |         None or str\n2424 |             If path_or_buf is None, returns the resulting json format as a\n2425 |             string. Otherwise returns None.\n2426 | \n2427 |         See Also\n2428 |         --------\n2429 |         read_json : Convert a JSON string to pandas object.\n2430 | \n2431 |         Notes\n2432 |         -----\n2433 |         The behavior of ``indent=0`` varies from the stdlib, which does not\n2434 |         indent the output but does insert newlines. Currently, ``indent=0``\n2435 |         and the default ``indent=None`` are equivalent in pandas, though this\n2436 |         may change in a future release.\n2437 | \n2438 |         ``orient='table'`` contains a 'pandas_version' field under 'schema'.\n2439 |         This stores the version of `pandas` used in the latest revision of the\n2440 |         schema.\n2441 | \n2442 |         Examples\n2443 |         --------\n2444 |         >>> from json import loads, dumps\n2445 |         >>> df = pd.DataFrame(\n2446 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2447 |         ...     index=[\"row 1\", \"row 2\"],\n2448 |         ...     columns=[\"col 1\", \"col 2\"],\n2449 |         ... )\n2450 | \n2451 |         >>> result = df.to_json(orient=\"split\")\n2452 |         >>> parsed = loads(result)\n2453 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2454 |         {{\n2455 |             \"columns\": [\n2456 |                 \"col 1\",\n2457 |                 \"col 2\"\n2458 |             ],\n2459 |             \"index\": [\n2460 |                 \"row 1\",\n2461 |                 \"row 2\"\n2462 |             ],\n2463 |             \"data\": [\n2464 |                 [\n2465 |                     \"a\",\n2466 |                     \"b\"\n2467 |                 ],\n2468 |                 [\n2469 |                     \"c\",\n2470 |                     \"d\"\n2471 |                 ]\n2472 |             ]\n2473 |         }}\n2474 | \n2475 |         Encoding/decoding a Dataframe using ``'records'`` formatted JSON.\n2476 |         Note that index labels are not preserved with this encoding.\n2477 | \n2478 |         >>> result = df.to_json(orient=\"records\")\n2479 |         >>> parsed = loads(result)\n2480 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2481 |         [\n2482 |             {{\n2483 |                 \"col 1\": \"a\",\n2484 |                 \"col 2\": \"b\"\n2485 |             }},\n2486 |             {{\n2487 |                 \"col 1\": \"c\",\n2488 |                 \"col 2\": \"d\"\n2489 |             }}\n2490 |         ]\n2491 | \n2492 |         Encoding/decoding a Dataframe using ``'index'`` formatted JSON:\n2493 | \n2494 |         >>> result = df.to_json(orient=\"index\")\n2495 |         >>> parsed = loads(result)\n2496 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2497 |         {{\n2498 |             \"row 1\": {{\n2499 |                 \"col 1\": \"a\",\n2500 |                 \"col 2\": \"b\"\n2501 |             }},\n2502 |             \"row 2\": {{\n2503 |                 \"col 1\": \"c\",\n2504 |                 \"col 2\": \"d\"\n2505 |             }}\n2506 |         }}\n2507 | \n2508 |         Encoding/decoding a Dataframe using ``'columns'`` formatted JSON:\n2509 | \n2510 |         >>> result = df.to_json(orient=\"columns\")\n2511 |         >>> parsed = loads(result)\n2512 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2513 |         {{\n2514 |             \"col 1\": {{\n2515 |                 \"row 1\": \"a\",\n2516 |                 \"row 2\": \"c\"\n2517 |             }},\n2518 |             \"col 2\": {{\n2519 |                 \"row 1\": \"b\",\n2520 |                 \"row 2\": \"d\"\n2521 |             }}\n2522 |         }}\n2523 | \n2524 |         Encoding/decoding a Dataframe using ``'values'`` formatted JSON:\n2525 | \n2526 |         >>> result = df.to_json(orient=\"values\")\n2527 |         >>> parsed = loads(result)\n2528 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2529 |         [\n2530 |             [\n2531 |                 \"a\",\n2532 |                 \"b\"\n2533 |             ],\n2534 |             [\n2535 |                 \"c\",\n2536 |                 \"d\"\n2537 |             ]\n2538 |         ]\n2539 | \n2540 |         Encoding with Table Schema:\n2541 | \n2542 |         >>> result = df.to_json(orient=\"table\")\n2543 |         >>> parsed = loads(result)\n2544 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2545 |         {{\n2546 |             \"schema\": {{\n2547 |                 \"fields\": [\n2548 |                     {{\n2549 |                         \"name\": \"index\",\n2550 |                         \"type\": \"string\"\n2551 |                     }},\n2552 |                     {{\n2553 |                         \"name\": \"col 1\",\n2554 |                         \"type\": \"string\"\n2555 |                     }},\n2556 |                     {{\n2557 |                         \"name\": \"col 2\",\n2558 |                         \"type\": \"string\"\n2559 |                     }}\n2560 |                 ],\n2561 |                 \"primaryKey\": [\n2562 |                     \"index\"\n2563 |                 ],\n2564 |                 \"pandas_version\": \"1.4.0\"\n2565 |             }},\n2566 |             \"data\": [\n2567 |                 {{\n2568 |                     \"index\": \"row 1\",\n2569 |                     \"col 1\": \"a\",\n2570 |                     \"col 2\": \"b\"\n2571 |                 }},\n2572 |                 {{\n2573 |                     \"index\": \"row 2\",\n2574 |                     \"col 1\": \"c\",\n2575 |                     \"col 2\": \"d\"\n2576 |                 }}\n2577 |             ]\n2578 |         }}\n2579 |         \"\"\"\n2580 |         from pandas.io import json\n2581 | \n2582 |         if date_format is None and orient == \"table\":\n2583 |             date_format = \"iso\"\n2584 |         elif date_format is None:\n2585 |             date_format = \"epoch\"\n2586 |             dtypes = self.dtypes if self.ndim == 2 else [self.dtype]\n2587 |             if any(lib.is_np_dtype(dtype, \"mM\") for dtype in dtypes):\n2588 |                 warnings.warn(\n2589 |                     \"The default 'epoch' date format is deprecated and will be removed \"\n2590 |                     \"in a future version, please use 'iso' date format instead.\",\n2591 |                     FutureWarning,\n2592 |                     stacklevel=find_stack_level(),\n2593 |                 )\n2594 |         elif date_format == \"epoch\":\n2595 |             # GH#57063\n2596 |             warnings.warn(\n2597 |                 \"'epoch' date format is deprecated and will be removed in a future \"\n2598 |                 \"version, please use 'iso' date format instead.\",\n2599 |                 FutureWarning,\n2600 |                 stacklevel=find_stack_level(),\n2601 |             )\n2602 | \n2603 |         config.is_nonnegative_int(indent)\n2604 |         indent = indent or 0\n2605 | \n2606 |         return json.to_json(\n2607 |             path_or_buf=path_or_buf,\n2608 |             obj=self,\n2609 |             orient=orient,\n2610 |             date_format=date_format,\n2611 |             double_precision=double_precision,\n2612 |             force_ascii=force_ascii,\n2613 |             