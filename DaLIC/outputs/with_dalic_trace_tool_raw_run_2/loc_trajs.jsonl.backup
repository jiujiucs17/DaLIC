TIGUOUS / C / CONTIGUOUS\n249 |           - F_CONTIGUOUS / F / FORTRAN\n250 |           - OWNDATA / O\n251 |           - WRITEABLE / W\n252 |           - ALIGNED / A\n253 |           - WRITEBACKIFCOPY / X\n254 |           - UPDATEIFCOPY / U\n255 | \n256 |     Returns\n257 |     -------\n258 |     klass : ndpointer type object\n259 |         A type object, which is an ``_ndtpr`` instance containing\n260 |         dtype, ndim, shape and flags information.\n261 | \n262 |     Raises\n263 |     ------\n264 |     TypeError\n265 |         If a given array does not satisfy the specified restrictions.\n266 | \n267 |     Examples\n268 |     --------\n269 |     >>> clib.somefunc.argtypes = [np.ctypeslib.ndpointer(dtype=np.float64,\n270 |     ...                                                  ndim=1,\n271 |     ...                                                  flags='C_CONTIGUOUS')]\n272 |     ... #doctest: +SKIP\n273 |     >>> clib.somefunc(np.array([1, 2, 3], dtype=np.float64))\n274 |     ... #doctest: +SKIP\n275 | \n276 |     \"\"\"\n277 | \n278 |     # normalize dtype to an Optional[dtype]\n279 |     if dtype is not None:\n280 |         dtype = _dtype(dtype)\n281 | \n282 |     # normalize flags to an Optional[int]\n283 |     num = None\n284 |     if flags is not None:\n285 |         if isinstance(flags, str):\n286 |             flags = flags.split(',')\n287 |         elif isinstance(flags, (int, integer)):\n288 |             num = flags\n289 |             flags = _flags_fromnum(num)\n290 |         elif isinstance(flags, flagsobj):\n291 |             num = flags.num\n292 |             flags = _flags_fromnum(num)\n293 |         if num is None:\n294 |             try:\n295 |                 flags = [x.strip().upper() for x in flags]\n296 |             except Exception as e:\n297 |                 raise TypeError(\"invalid flags specification\") from e\n298 |             num = _num_fromflags(flags)\n299 | \n300 |     # normalize shape to an Optional[tuple]\n301 |     if shape is not None:\n302 |         try:\n303 |             shape = tuple(shape)\n304 |         except TypeError:\n305 |             # single integer -> 1-tuple\n306 |             shape = (shape,)\n307 | \n308 |     cache_key = (dtype, ndim, shape, num)\n309 | \n310 |     try:\n311 |         return _pointer_type_cache[cache_key]\n312 |     except KeyError:\n313 |         pass\n314 | \n315 |     # produce a name for the new type\n316 |     if dtype is None:\n317 |         name = 'any'\n318 |     elif dtype.names is not None:\n319 |         name = str(id(dtype))\n320 |     else:\n321 |         name = dtype.str\n322 |     if ndim is not None:\n323 |         name += \"_%dd\" % ndim\n324 |     if shape is not None:\n325 |         name += \"_\"+\"x\".join(str(x) for x in shape)\n326 |     if flags is not None:\n327 |         name += \"_\"+\"_\".join(flags)\n328 | \n329 |     if dtype is not None and shape is not None:\n330 |         base = _concrete_ndptr\n331 |     else:\n332 |         base = _ndptr\n333 | \n334 |     klass = type(\"ndpointer_%s\"%name, (base,),\n335 |                  {\"_dtype_\": dtype,\n336 |                   \"_shape_\" : shape,\n337 |                   \"_ndim_\" : ndim,\n338 |                   \"_flags_\" : num})\n339 |     _pointer_type_cache[cache_key] = klass\n340 |     return klass\n```\n\nFound file `numpy/linalg/linalg.py`.\nFound file `benchmarks/benchmarks/bench_indexing.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"sliding\", \"moving_average sliding\"...\n### Search Result:\nFound function `numpy/core/setup_common.py:long_double_representation`.\nSource: Retrieved code content using keyword search (bm25).\n```\n354 | def long_double_representation(lines):\n355 |     \"\"\"Given a binary dump as given by GNU od -b, look for long double\n356 |     representation.\"\"\"\n357 | \n358 |     # Read contains a list of 32 items, each item is a byte (in octal\n359 |     # representation, as a string). We 'slide' over the output until read is of\n360 |     # the form before_seq + content + after_sequence, where content is the long double\n361 |     # representation:\n362 |     #  - content is 12 bytes: 80 bits Intel representation\n363 |     #  - content is 16 bytes: 80 bits Intel representation (64 bits) or quad precision\n364 |     #  - content is 8 bytes: same as double (not implemented yet)\n365 |     read = [''] * 32\n366 |     saw = None\n367 |     for line in lines:\n368 |         # we skip the first word, as od -b output an index at the beginning of\n369 |         # each line\n370 |         for w in line.split()[1:]:\n371 |             read.pop(0)\n372 |             read.append(w)\n373 | \n374 |             # If the end of read is equal to the after_sequence, read contains\n375 |             # the long double\n376 |             if read[-8:] == _AFTER_SEQ:\n377 |                 saw = copy.copy(read)\n378 |                 # if the content was 12 bytes, we only have 32 - 8 - 12 = 12\n379 |                 # \"before\" bytes. In other words the first 4 \"before\" bytes went\n380 |                 # past the sliding window.\n381 |                 if read[:12] == _BEFORE_SEQ[4:]:\n382 |                     if read[12:-8] == _INTEL_EXTENDED_12B:\n383 |                         return 'INTEL_EXTENDED_12_BYTES_LE'\n384 |                     if read[12:-8] == _MOTOROLA_EXTENDED_12B:\n385 |                         return 'MOTOROLA_EXTENDED_12_BYTES_BE'\n386 |                 # if the content was 16 bytes, we are left with 32-8-16 = 16\n387 |                 # \"before\" bytes, so 8 went past the sliding window.\n388 |                 elif read[:8] == _BEFORE_SEQ[8:]:\n389 |                     if read[8:-8] == _INTEL_EXTENDED_16B:\n390 |                         return 'INTEL_EXTENDED_16_BYTES_LE'\n391 |                     elif read[8:-8] == _IEEE_QUAD_PREC_BE:\n392 |                         return 'IEEE_QUAD_BE'\n393 |                     elif read[8:-8] == _IEEE_QUAD_PREC_LE:\n394 |                         return 'IEEE_QUAD_LE'\n395 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_LE:\n396 |                         return 'IBM_DOUBLE_DOUBLE_LE'\n397 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_BE:\n398 |                         return 'IBM_DOUBLE_DOUBLE_BE'\n399 |                 # if the content was 8 bytes, left with 32-8-8 = 16 bytes\n400 |                 elif read[:16] == _BEFORE_SEQ:\n401 |                     if read[16:-8] == _IEEE_DOUBLE_LE:\n402 |                         return 'IEEE_DOUBLE_LE'\n403 |                     elif read[16:-8] == _IEEE_DOUBLE_BE:\n404 |                         return 'IEEE_DOUBLE_BE'\n405 | \n406 |     if saw is not None:\n407 |         raise ValueError(\"Unrecognized format (%s)\" % saw)\n408 |     else:\n409 |         # We never detected the after_sequence\n410 |         raise ValueError(\"Could not lock sequences (%s)\" % saw)\n```\n\nFound function `numpy/core/numeric.py:convolve`.\nSource: Retrieved code content using keyword search (bm25).\n```\n754 | def convolve(a, v, mode='full'):\n755 |     \"\"\"\n756 |     Returns the discrete, linear convolution of two one-dimensional sequences.\n757 | \n758 |     The convolution operator is often seen in signal processing, where it\n759 |     models the effect of a linear time-invariant system on a signal [1]_.  In\n760 |     probability theory, the sum of two independent random variables is\n761 |     distributed according to the convolution of their individual\n762 |     distributions.\n763 | \n764 |     If `v` is longer than `a`, the arrays are swapped before computation.\n765 | \n766 |     Parameters\n767 |     ----------\n768 |     a : (N,) array_like\n769 |         First one-dimensional input array.\n770 |     v : (M,) array_like\n771 |         Second one-dimensional input array.\n772 |     mode : {'full', 'valid', 'same'}, optional\n773 |         'full':\n774 |           By default, mode is 'full'.  This returns the convolution\n775 |           at each point of overlap, with an output shape of (N+M-1,). At\n776 |           the end-points of the convolution, the signals do not overlap\n777 |           completely, and boundary effects may be seen.\n778 | \n779 |         'same':\n780 |           Mode 'same' returns output of length ``max(M, N)``.  Boundary\n781 |           effects are still visible.\n782 | \n783 |         'valid':\n784 |           Mode 'valid' returns output of length\n785 |           ``max(M, N) - min(M, N) + 1``.  The convolution product is only given\n786 |           for points where the signals overlap completely.  Values outside\n787 |           the signal boundary have no effect.\n788 | \n789 |     Returns\n790 |     -------\n791 |     out : ndarray\n792 |         Discrete, linear convolution of `a` and `v`.\n793 | \n794 |     See Also\n795 |     --------\n796 |     scipy.signal.fftconvolve : Convolve two arrays using the Fast Fourier\n797 |                                Transform.\n798 |     scipy.linalg.toeplitz : Used to construct the convolution operator.\n799 |     polymul : Polynomial multiplication. Same output as convolve, but also\n800 |               accepts poly1d objects as input.\n801 | \n802 |     Notes\n803 |     -----\n804 |     The discrete convolution operation is defined as\n805 | \n806 |     .. math:: (a * v)[n] = \\\\sum_{m = -\\\\infty}^{\\\\infty} a[m] v[n - m]\n807 | \n808 |     It can be shown that a convolution :math:`x(t) * y(t)` in time/space\n809 |     is equivalent to the multiplication :math:`X(f) Y(f)` in the Fourier\n810 |     domain, after appropriate padding (padding is necessary to prevent\n811 |     circular convolution).  Since multiplication is more efficient (faster)\n812 |     than convolution, the function `scipy.signal.fftconvolve` exploits the\n813 |     FFT to calculate the convolution of large data-sets.\n814 | \n815 |     References\n816 |     ----------\n817 |     .. [1] Wikipedia, \"Convolution\",\n818 |         https://en.wikipedia.org/wiki/Convolution\n819 | \n820 |     Examples\n821 |     --------\n822 |     Note how the convolution operator flips the second array\n823 |     before \"sliding\" the two across one another:\n824 | \n825 |     >>> np.convolve([1, 2, 3], [0, 1, 0.5])\n826 |     array([0. , 1. , 2.5, 4. , 1.5])\n827 | \n828 |     Only return the middle values of the convolution.\n829 |     Contains boundary effects, where zeros are taken\n830 |     into account:\n831 | \n832 |     >>> np.convolve([1,2,3],[0,1,0.5], 'same')\n833 |     array([1. ,  2.5,  4. ])\n834 | \n835 |     The two arrays are of the same length, so there\n836 |     is only one position where they completely overlap:\n837 | \n838 |     >>> np.convolve([1,2,3],[0,1,0.5], 'valid')\n839 |     array([2.5])\n840 | \n841 |     \"\"\"\n842 |     a, v = array(a, copy=False, ndmin=1), array(v, copy=False, ndmin=1)\n843 |     if (len(v) > len(a)):\n844 |         a, v = v, a\n845 |     if len(a) == 0:\n846 |         raise ValueError('a cannot be empty')\n847 |     if len(v) == 0:\n848 |         raise ValueError('v cannot be empty')\n849 |     mode = _mode_from_name(mode)\n850 |     return multiarray.correlate(a, v[::-1], mode)\n```\n\nFound function `numpy/core/numeric.py:_outer_dispatcher`.\nSource: Retrieved code content using keyword search (bm25).\n```\n853 | def _outer_dispatcher(a, b, out=None):\n854 |     return (a, b, out)\n```\n\n\n\n##Searching for term \"moving_average sliding\"...\n### Search Result:\nFound `numpy/distutils/command/autodist.py:check_inline`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"This module implements additional tests ala autoconf which can be useful.\n  2 | \n  3 | \"\"\"\n  4 | import textwrap\n  5 | \n  6 | # We put them here since they could be easily reused outside numpy.distutils\n  7 | \n  8 | def check_inline(cmd):\n  9 |     \"\"\"Return the 