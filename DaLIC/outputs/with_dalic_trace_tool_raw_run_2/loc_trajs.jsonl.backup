rame: bool,\n515 |     features_list: List,\n516 |     data_columns: List[int],\n517 |     target_columns: List,\n518 |     shape: Optional[Tuple[int, int]]\n519 | ):\n520 |     \"\"\"Download OpenML ARFF and convert to Bunch of data\n521 |     \"\"\"\n522 |     # NB: this function is long in order to handle retry for any failure\n523 |     #     during the streaming parse of the ARFF.\n524 | \n525 |     # Prepare which columns and data types should be returned for the X and y\n526 |     features_dict = {feature['name']: feature for feature in features_list}\n527 | \n528 |     # XXX: col_slice_y should be all nominal or all numeric\n529 |     _verify_target_data_type(features_dict, target_columns)\n530 | \n531 |     col_slice_y = [int(features_dict[col_name]['index'])\n532 |                    for col_name in target_columns]\n533 | \n534 |     col_slice_x = [int(features_dict[col_name]['index'])\n535 |                    for col_name in data_columns]\n536 |     for col_idx in col_slice_y:\n537 |         feat = features_list[col_idx]\n538 |         nr_missing = int(feat['number_of_missing_values'])\n539 |         if nr_missing > 0:\n540 |             raise ValueError('Target column {} has {} missing values. '\n541 |                              'Missing values are not supported for target '\n542 |                              'columns. '.format(feat['name'], nr_missing))\n543 | \n544 |     # Access an ARFF file on the OpenML server. Documentation:\n545 |     # https://www.openml.org/api_data_docs#!/data/get_download_id\n546 | \n547 |     if sparse is True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n```\n\nFound function `sklearn/datasets/_rcv1.py:fetch_rcv1`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 80 | def fetch_rcv1(*, data_home=None, subset='all', download_if_missing=True,\n 81 |                random_state=None, shuffle=False, return_X_y=False):\n 82 |     \"\"\"Load the RCV1 multilabel dataset (classification).\n 83 | \n 84 |     Download it if necessary.\n 85 | \n 86 |     Version: RCV1-v2, vectors, full sets, topics multilabels.\n 87 | \n 88 |     =================   =====================\n 89 |     Classes                               103\n 90 |     Samples total                      804414\n 91 |     Dimensionality                      47236\n 92 |     Features            real, between 0 and 1\n 93 |     =================   =====================\n 94 | \n 95 |     Read more in the :ref:`User Guide <rcv1_dataset>`.\n 96 | \n 97 |     .. versionadded:: 0.17\n 98 | \n 99 |     Parameters\n100 |     ----------\n101 |     data_home : str, default=None\n102 |         Specify another download and cache folder for the datasets. By default\n103 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n104 | \n105 |     subset : {'train', 'test', 'all'}, default='all'\n106 |         Select the dataset to load: 'train' for the training set\n107 |         (23149 samples), 'test' for the test set (781265 samples),\n108 |         'all' for both, with the training samples first if shuffle is False.\n109 |         This follows the official LYRL2004 chronological split.\n110 | \n111 |     download_if_missing : bool, default=True\n112 |         If False, raise a IOError if the data is not locally available\n113 |         instead of trying to download the data from the source site.\n114 | \n115 |     random_state : int or RandomState instance, default=None\n116 |         Determines random number generation for dataset shuffling. Pass an int\n117 |         for reproducible output across multiple function calls.\n118 |         See :term:`Glossary <random_state>`.\n119 | \n120 |     shuffle : bool, default=False\n121 |         Whether to shuffle dataset.\n122 | \n123 |     return_X_y : bool, default=False\n124 |         If True, returns ``(dataset.data, dataset.target)`` instead of a Bunch\n125 |         object. See below for more information about the `dataset.data` and\n126 |         `dataset.target` object.\n127 | \n128 |         .. versionadded:: 0.20\n129 | \n130 |     Returns\n131 |     -------\n132 |     dataset : :class:`~sklearn.utils.Bunch`\n133 |         Dictionary-like object, with the following attributes.\n134 | \n135 |         data : scipy csr array, dtype np.float64, shape (804414, 47236)\n136 |             The array has 0.16% of non zero values.\n137 |         target : scipy csr array, dtype np.uint8, shape (804414, 103)\n138 |             Each sample has a value of 1 in its categories, and 0 in others.\n139 |             The array has 3.15% of non zero values.\n140 |         sample_id : numpy array, dtype np.uint32, shape (804414,)\n141 |             Identification number of each sample, as ordered in dataset.data.\n142 |         target_names : numpy array, dtype object, length (103)\n143 |             Names of each target (RCV1 topics), as ordered in dataset.target.\n144 |         DESCR : string\n145 |             Description of the RCV1 dataset.\n146 | \n147 |     (data, target) : tuple if ``return_X_y`` is True\n148 | \n149 |         .. versionadded:: 0.20\n150 |     \"\"\"\n151 |     N_SAMPLES = 804414\n152 |     N_FEATURES = 47236\n153 |     N_CATEGORIES = 103\n154 |     N_TRAIN = 23149\n155 | \n156 |     data_home = get_data_home(data_home=data_home)\n157 |     rcv1_dir = join(data_home, \"RCV1\")\n158 |     if download_if_missing:\n159 |         if not exists(rcv1_dir):\n160 |             makedirs(rcv1_dir)\n161 | \n162 |     samples_path = _pkl_filepath(rcv1_dir, \"samples.pkl\")\n163 |     sample_id_path = _pkl_filepath(rcv1_dir, \"sample_id.pkl\")\n164 |     sample_topics_path = _pkl_filepath(rcv1_dir, \"sample_topics.pkl\")\n165 |     topics_path = _pkl_filepath(rcv1_dir, \"topics_names.pkl\")\n166 | \n167 |     # load data (X) and sample_id\n168 |     if download_if_missing and (not exists(samples_path) or\n169 |                                 not exists(sample_id_path)):\n170 |         files = []\n171 |         for each in XY_METADATA:\n172 |             logger.info(\"Downloading %s\" % each.url)\n173 |             file_path = _fetch_remote(each, dirname=rcv1_dir)\n174 |             files.append(GzipFile(filename=file_path))\n175 | \n176 |         Xy = load_svmlight_files(files, n_features=N_FEATURES)\n177 | \n178 |         # Training data is before testing data\n179 |         X = sp.vstack([Xy[8], Xy[0], Xy[2], Xy[4], Xy[6]]).tocsr()\n180 |         sample_id = np.hstack((Xy[9], Xy[1], Xy[3], Xy[5], Xy[7]))\n181 |         sample_id = sample_id.astype(np.uint32, copy=False)\n182 | \n183 |         joblib.dump(X, samples_path, compress=9)\n184 |         joblib.dump(sample_id, sample_id_path, compress=9)\n185 | \n186 |         # delete archives\n187 |         for f in files:\n188 |             f.close()\n189 |             remove(f.name)\n190 |     else:\n191 |         X = joblib.load(samples_path)\n192 |         sample_id = joblib.load(sample_id_path)\n193 | \n194 |     # load target (y), categories, and sample_id_bis\n195 |     if download_if_missing and (not exists(sample_topics_path) or\n196 |                                 not exists(topics_path)):\n197 |         logger.info(\"Downloading %s\" % TOPICS_METADATA.url)\n198 |         topics_archive_path = _fetch_remote(TOPICS_METADATA,\n199 |                                             dirname=rcv1_dir)\n200 | \n201 |         # parse the target file\n202 |         n_cat = -1\n203 |         n_doc = -1\n204 |         doc_previous = -1\n205 |         y = np.zeros((N_SAMPLES, N_CATEGORIES), dtype=np.uint8)\n206 |         sample_id_bis = np.zeros(N_SAMPLES, dtype=np.int32)\n207 |         category_names = {}\n208 |         with GzipFile(filename=topics_archive_path, mode='rb') as f:\n209 |             for line in f:\n210 |                 line_components = line.decode(\"ascii\").split(\" \")\n211 |                 if len(line_components) == 3:\n212 |                     cat, doc, _ = line_components\n213 |                     if cat not in category_names:\n214 |                         n_cat += 1\n215 |                         category_names[cat] = n_cat\n216 | \n217 |                     doc = int(doc)\n218 |                     if doc != doc_previous:\n219 |                         doc_previous = doc\n220 |                         n_doc += 1\n221 |                         sample_id_bis[n_doc] = doc\n222 |                     y[n_doc, category_names[cat]] = 1\n223 | \n224 |         # delete archive\n225 |         remove(topics_archive_path)\n226 | \n227 |         # Samples in X are ordered with sample_id,\n228 |         # whereas in y, they are ordered with sample_id_bis.\n229 |         permutation = _find_permutation(sample_id_bis, sample_id)\n230 |         y = y[permutation, :]\n231 | \n232 |         # save category names in a list, with same order than y\n233 |         categories = np.empty(N_CATEGORIES, dtype=object)\n234 |         for k in category_names.keys():\n235 |             categories[category_names[k]] = k\n236 | \n237 |         # reorder categories in lexicographic order\n238 |         order = np.argsort(categories)\n239 |         categories = categories[order]\n240 |         y = sp.csr_matrix(y[:, order])\n241 | \n242 |         joblib.dump(y, sample_topics_path, compress=9)\n243 |         joblib.dump(categories, topics_path, compress=9)\n244 |     else:\n245 |         y = joblib.load(sample_topics_path)\n246 |         categories = joblib.load(topics_path)\n247 | \n248 |     if subset == 'all':\n249 |         pass\n250 |     elif subset == 'train':\n251 |         X = X[:N_TRAIN, :]\n252 |         y = y[:N_TRAIN, :]\n253 |         sample_id = sample_id[:N_TRAIN]\n254 |     elif subset == 'test':\n255 |         X = X[N_TRAIN:, :]\n256 |         y = y[N_TRAIN:, :]\n257 |         sample_id = sample_id[N_TRAIN:]\n258 |     else:\n259 |         raise ValueError(\"Unknown subset parameter. Got '%s' instead of one\"\n260 |                          \" of ('all', 'train', test')\" % subset)\n261 | \n262 |     if shuffle:\n263 |         X, y, sample_id = shuffle_(X, y, sample_id, random_state=random_state)\n264 | \n265 |     module_path = dirname(__file__)\n266 |     with open(join(module_path, 'descr', 'rcv1.rst')) as rst_file:\n267 |         fdescr = rst_file.read()\n268 | \n269 |     if return_X_y:\n270 |         return X, y\n271 | \n272 |     return Bunch(data=X, target=y, sample_id=sample_id,\n273 |                  target_names=categories, DESCR=fdescr)\n```\n\nFound function `sklearn/datasets/_openml.py:_get_data_features`.\nSource: Retrieved entity using keyword search 