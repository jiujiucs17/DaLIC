n128 |     if _TEST_MODE:\n129 |         _store_test_result(result is not None)\n130 | \n131 |     if result is None:\n132 |         result = _evaluate_standard(op, op_str, a, b)\n133 | \n134 |     return result\n135 | \n136 | \n137 | _op_str_mapping = {\n138 |     operator.add: \"+\",\n139 |     roperator.radd: \"+\",\n140 |     operator.mul: \"*\",\n141 |     roperator.rmul: \"*\",\n142 |     operator.sub: \"-\",\n143 |     roperator.rsub: \"-\",\n144 |     operator.truediv: \"/\",\n145 |     roperator.rtruediv: \"/\",\n146 |     # floordiv not supported by numexpr 2.x\n147 |     operator.floordiv: None,\n148 |     roperator.rfloordiv: None,\n149 |     # we require Python semantics for mod of negative for backwards compatibility\n150 |     # see https://github.com/pydata/numexpr/issues/365\n151 |     # so sticking with unaccelerated for now GH#36552\n152 |     operator.mod: None,\n153 |     roperator.rmod: None,\n154 |     operator.pow: \"**\",\n155 |     roperator.rpow: \"**\",\n156 |     operator.eq: \"==\",\n157 |     operator.ne: \"!=\",\n158 |     operator.le: \"<=\",\n159 |     operator.lt: \"<\",\n160 |     operator.ge: \">=\",\n161 |     operator.gt: \">\",\n162 |     operator.and_: \"&\",\n163 |     roperator.rand_: \"&\",\n164 |     operator.or_: \"|\",\n165 |     roperator.ror_: \"|\",\n166 |     operator.xor: \"^\",\n167 |     roperator.rxor: \"^\",\n168 |     divmod: None,\n169 |     roperator.rdivmod: None,\n170 | }\n171 | \n172 | \n173 | def _where_standard(cond, a, b):\n174 |     # Caller is responsible for extracting ndarray if necessary\n175 |     return np.where(cond, a, b)\n176 | \n177 | \n178 | def _where_numexpr(cond, a, b):\n179 |     # Caller is responsible for extracting ndarray if necessary\n180 |     result = None\n181 | \n182 |     if _can_use_numexpr(None, \"where\", a, b, \"where\"):\n183 |         result = ne.evaluate(\n184 |             \"where(cond_value, a_value, b_value)\",\n185 |             local_dict={\"cond_value\": cond, \"a