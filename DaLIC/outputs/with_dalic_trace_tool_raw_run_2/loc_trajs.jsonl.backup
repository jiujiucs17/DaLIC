n >= parse_version(\"1.7\"):\n  34 |     # Starting in scipy 1.7 pinv2 was deprecated in favor of pinv.\n  35 |     # pinv now uses the svd to compute the pseudo-inverse.\n  36 |     from scipy.linalg import pinv as pinv2\n  37 | else:\n  38 |     from scipy.linalg import pinv2\n```\n\nFound function `sklearn/utils/validation.py:check_consistent_length`.\nSource: Retrieved entity using keyword search (bm25).\n```\n451 | def check_consistent_length(*arrays):\n452 |     \"\"\"Check that all arrays have consistent first dimensions.\n453 | \n454 |     Checks whether all objects in arrays have the same shape or length.\n455 | \n456 |     Parameters\n457 |     ----------\n458 |     *arrays : list or tuple of input objects.\n459 |         Objects that will be checked for consistent length.\n460 | \n461 |     Examples\n462 |     --------\n463 |     >>> from sklearn.utils.validation import check_consistent_length\n464 |     >>> a = [1, 2, 3]\n465 |     >>> b = [2, 3, 4]\n466 |     >>> check_consistent_length(a, b)\n467 |     \"\"\"\n468 | \n469 |     lengths = [_num_samples(X) for X in arrays if X is not None]\n470 |     uniques = np.unique(lengths)\n471 |     if len(uniques) > 1:\n472 |         raise ValueError(\n473 |             \"Found input variables with inconsistent numbers of samples: %r\"\n474 |             % [int(l) for l in lengths]\n475 |         )\n```\n\nFound function `sklearn/utils/validation.py:_to_object_array`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2579 | def _to_object_array(sequence):\n2580 |     \"\"\"Convert sequence to a 1-D NumPy array of object dtype.\n2581 | \n2582 |     numpy.array constructor has a similar use but it's output\n2583 |     is ambiguous. It can be 1-D NumPy array of object dtype if\n2584 |     the input is a ragged array, but if the input is a list of\n2585 |     equal length arrays, then the output is a 2D numpy.array.\n2586 |     _to_object_array solves this ambiguity by guarantying that\n2587 |     the output is a 1-D NumPy array of objects for any input.\n2588 | \n2589 |     Parameters\n2590 |     ----------\n2591 |     sequence : array-like of shape (n_elements,)\n2592 |         The sequence to be converted.\n2593 | \n2594 |     Returns\n2595 |     -------\n2596 |     out : ndarray of shape (n_elements,), dtype=object\n2597 |         The converted sequence into a 1-D NumPy array of object dtype.\n2598 | \n2599 |     Examples\n2600 |     --------\n2601 |     >>> import numpy as np\n2602 |     >>> from sklearn.utils.validation import _to_object_array\n2603 |     >>> _to_object_array([np.array([0]), np.array([1])])\n2604 |     array([array([0]), array([1])], dtype=object)\n2605 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2606 |     array([array([0]), array([1, 2])], dtype=object)\n2607 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2608 |     array([array([0]), array([1, 2])], dtype=object)\n2609 |     \"\"\"\n2610 |     out = np.empty(len(sequence), dtype=object)\n2611 |     out[:] = sequence\n2612 |     return out\n```\n\nFound function `doc/conftest.py:setup_compose`.\nSource: Retrieved entity using keyword search (bm25).\n```\n58 | def setup_compose():\n59 |     try:\n60 |         import pandas  # noqa\n61 |     except ImportError:\n62 |         raise SkipTest(\"Skipping compose.rst, pandas not installed\")\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_pinv2_old`.\nSource: Retrieved code content using keyword search (bm25).\n```\n41 | def _pinv2_old(a):\n42 |     # Used previous scipy pinv2 that was updated in:\n43 |     # https://github.com/scipy/scipy/pull/10067\n44 |     # We can not set `cond` or `rcond` for pinv2 in scipy >= 1.3 to keep the\n45 |     # same behavior of pinv2 for scipy < 1.3, because the condition used to\n46 |     # determine the rank is dependent on the output of svd.\n47 |     u, s, vh = svd(a, full_matrices=False, check_finite=False)\n48 | \n49 |     t = u.dtype.char.lower()\n50 |     factor = {\"f\": 1e3, \"d\": 1e6}\n51 |     cond = np.max(s) * factor[t] * np.finfo(t).eps\n52 |     rank = np.sum(s > cond)\n53 | \n54 |     u = u[:, :rank]\n55 |     u /= s[:rank]\n56 |     return np.transpose(np.conjugate(np.dot(u, vh[:rank])))\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_get_first_singular_vectors_power_method`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 59 | def _get_first_singular_vectors_power_method(\n 60 |     X, Y, mode=\"A\", max_iter=500, tol=1e-06, norm_y_weights=False\n 61 | ):\n 62 |     \"\"\"Return the first left and right singular vectors of X'Y.\n 63 | \n 64 |     Provides an alternative to the svd(X'Y) and uses the power method instead.\n 65 |     With norm_y_weights to True and in mode A, this corresponds to the\n 66 |     algorithm section 11.3 of the Wegelin's review, except this starts at the\n 67 |     \"update saliences\" part.\n 68 |     \"\"\"\n 69 | \n 70 |     eps = np.finfo(X.dtype).eps\n 71 |     try:\n 72 |         y_score = next(col for col in Y.T if np.any(np.abs(col) > eps))\n 73 |     except StopIteration as e:\n 74 |         raise StopIteration(\"y residual is constant\") from e\n 75 | \n 76 |     x_weights_old = 100  # init to big value for first convergence check\n 77 | \n 78 |     if mode == \"B\":\n 79 |         # Precompute pseudo inverse matrices\n 80 |         # Basically: X_pinv = (X.T X)^-1 X.T\n 81 |         # Which requires inverting a (n_features, n_features) matrix.\n 82 |         # As a result, and as detailed in the Wegelin's review, CCA (i.e. mode\n 83 |         # B) will be unstable if n_features > n_samples or n_targets >\n 84 |         # n_samples\n 85 |         X_pinv, Y_pinv = _pinv2_old(X), _pinv2_old(Y)\n 86 | \n 87 |     for i in range(max_iter):\n 88 |         if mode == \"B\":\n 89 |             x_weights = np.dot(X_pinv, y_score)\n 90 |         else:\n 91 |             x_weights = np.dot(X.T, y_score) / np.dot(y_score, y_score)\n 92 | \n 93 |         x_weights /= np.sqrt(np.dot(x_weights, x_weights)) + eps\n 94 |         x_score = np.dot(X, x_weights)\n 95 | \n 96 |         if mode == \"B\":\n 97 |             y_weights = np.dot(Y_pinv, x_score)\n 98 |         else:\n 99 |             y_weights = np.dot(Y.T, x_score) / np.dot(x_score.T, x_score)\n100 | \n101 |         if norm_y_weights:\n102 |             y_weights /= np.sqrt(np.dot(y_weights, y_weights)) + eps\n103 | \n104 |         y_score = np.dot(Y, y_weights) / (np.dot(y_weights, y_weights) + eps)\n105 | \n106 |         x_weights_diff = x_weights - x_weights_old\n107 |         if np.dot(x_weights_diff, x_weights_diff) < tol or Y.shape[1] == 1:\n108 |             break\n109 |         x_weights_old = x_weights\n110 | \n111 |     n_iter = i + 1\n112 |     if n_iter == max_iter:\n113 |         warnings.warn(\"Maximum number of iterations reached\", ConvergenceWarning)\n114 | \n115 |     return x_weights, y_weights, n_iter\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_center_scale_xy`.\nSource: Retrieved code content using keyword search (bm25).\n```\n128 | def _center_scale_xy(X, Y, scale=True):\n129 |     \"\"\"Center X, Y and scale if the scale parameter==True\n130 | \n131 |     Returns\n132 |     -------\n133 |         X, Y, x_mean, y_mean, x_std, y_std\n134 |     \"\"\"\n135 |     # center\n136 |     x_mean = X.mean(axis=0)\n137 |     X -= x_mean\n138 |     y_mean = Y.mean(axis=0)\n139 |     Y -= y_mean\n140 |     # scale\n141 |     if scale:\n142 |         x_std = X.std(axis=0, ddof=1)\n143 |         x_std[x_std == 0.0] = 1.0\n144 |         X /= x_std\n145 |         y_std = Y.std(axis=0, ddof=1)\n146 |         y_std[y_std == 0.0] = 1.0\n147 |         Y /= y_std\n148 |     else:\n149 |         x_std = np.ones(X.shape[1])\n150 |         y_std = np.ones(Y.shape[1])\n151 |     return X, Y, x_mean, y_mean, x_std, y_std\n```\n\nFound file `doc/conftest.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `doc/conftest.py