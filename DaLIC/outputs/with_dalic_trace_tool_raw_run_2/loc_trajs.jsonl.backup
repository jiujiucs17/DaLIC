needed.\n\nFound function `pandas/core/reshape/merge.py:merge_ordered`.\nSource: Retrieved code content using keyword search (bm25).\n```\n510 | def merge_ordered(\n511 |     left: DataFrame | Series,\n512 |     right: DataFrame | Series,\n513 |     on: IndexLabel | None = None,\n514 |     left_on: IndexLabel | None = None,\n515 |     right_on: IndexLabel | None = None,\n516 |     left_by=None,\n517 |     right_by=None,\n518 |     fill_method: str | None = None,\n519 |     suffixes: Suffixes = (\"_x\", \"_y\"),\n520 |     how: JoinHow = \"outer\",\n521 | ) -> DataFrame:\n522 |     \"\"\"\n523 |     Perform a merge for ordered data with optional filling/interpolation.\n524 | \n525 |     Designed for ordered data like time series data. Optionally\n526 |     perform group-wise merge (see examples).\n527 | \n528 |     Parameters\n529 |     ----------\n530 |     left : DataFrame or named Series\n531 |         First pandas object to merge.\n532 |     right : DataFrame or named Series\n533 |         Second pandas object to merge.\n534 |     on : label or list\n535 |         Field names to join on. Must be found in both DataFrames.\n536 |     left_on : label or list, or array-like\n537 |         Field names to join on in left DataFrame. Can be a vector or list of\n538 |         vectors of the length of the DataFrame to use a particular vector as\n539 |         the join key instead of columns.\n540 |     right_on : label or list, or array-like\n541 |         Field names to join on in right DataFrame or vector/list of vectors per\n542 |         left_on docs.\n543 |     left_by : column name or list of column names\n544 |         Group left DataFrame by group columns and merge piece by piece with\n545 |         right DataFrame. Must be None if either left or right are a Series.\n546 |     right_by : column name or list of column names\n547 |         Group right DataFrame by group columns and merge piece by piece with\n548 |         left DataFrame. Must be None if either left or right are a Series.\n549 |     fill_method : {'ffill', None}, default None\n550 |         Interpolation method for data.\n551 |     suffixes : list-like, default is (\"_x\", \"_y\")\n552 |         A length-2 sequence where each element is optionally a string\n553 |         indicating the suffix to add to overlapping column names in\n554 |         `left` and `right` respectively. Pass a value of `None` instead\n555 |         of a string to indicate that the column name from `left` or\n556 |         `right` should be left as-is, with no suffix. At least one of the\n557 |         values must not be None.\n558 | \n559 |     how : {'left', 'right', 'outer', 'inner'}, default 'outer'\n560 |         * left: use only keys from left frame (SQL: left outer join)\n561 |         * right: use only keys from right frame (SQL: right outer join)\n562 |         * outer: use union of keys from both frames (SQL: full outer join)\n563 |         * inner: use intersection of keys from both frames (SQL: inner join).\n564 | \n565 |     Returns\n566 |     -------\n567 |     DataFrame\n568 |         The merged DataFrame output type will be the same as\n569 |         'left', if it is a subclass of DataFrame.\n570 | \n571 |     See Also\n572 |     --------\n573 |     merge : Merge with a database-style join.\n574 |     merge_asof : Merge on nearest keys.\n575 | \n576 |     Examples\n577 |     --------\n578 |     >>> from pandas import merge_ordered\n579 |     >>> df1 = pd.DataFrame(\n580 |     ...     {\n581 |     ...         \"key\": [\"a\", \"c\", \"e\", \"a\", \"c\", \"e\"],\n582 |     ...         \"lvalue\": [1, 2, 3, 1, 2, 3],\n583 |     ...         \"group\": [\"a\", \"a\", \"a\", \"b\", \"b\", \"b\"],\n584 |     ...     }\n585 |     ... )\n586 |     >>> df1\n587 |       key  lvalue group\n588 |     0   a       1     a\n589 |     1   c       2     a\n590 |     2   e       3     a\n591 |     3   a       1     b\n592 |     4   c       2     b\n593 |     5   e       3     b\n594 | \n595 |     >>> df2 = pd.DataFrame({\"key\": [\"b\", \"c\", \"d\"], \"rvalue\": [1, 2, 3]})\n596 |     >>> df2\n597 |       key  rvalue\n598 |     0   b       1\n599 |     1   c       2\n600 |     2   d       3\n601 | \n602 |     >>> merge_ordered(df1, df2, fill_method=\"ffill\", left_by=\"group\")\n603 |       key  lvalue group  rvalue\n604 |     0   a       1     a     NaN\n605 |     1   b       1     a     1.0\n606 |     2   c       2     a     2.0\n607 |     3   d       2     a     3.0\n608 |     4   e       3     a     3.0\n609 |     5   a       1     b     NaN\n610 |     6   b       1     b     1.0\n611 |     7   c       2     b     2.0\n612 |     8   d       2     b     3.0\n613 |     9   e       3     b     3.0\n614 |     \"\"\"\n615 | \n616 |     def _merger(x, y) -> DataFrame:\n617 |         # perform the ordered merge operation\n618 |         op = _OrderedMerge(\n619 |             x,\n620 |             y,\n621 |             on=on,\n622 |             left_on=left_on,\n623 |             right_on=right_on,\n624 |             suffixes=suffixes,\n625 |             fill_method=fill_method,\n626 |             how=how,\n627 |         )\n628 |         return op.get_result()\n629 | \n630 |     if left_by is not None and right_by is not None:\n631 |         raise ValueError(\"Can only group either left or right frames\")\n632 |     if left_by is not None:\n633 |         if isinstance(left_by, str):\n634 |             left_by = [left_by]\n635 |         check = set(left_by).difference(left.columns)\n636 |         if len(check) != 0:\n637 |             raise KeyError(f\"{check} not found in left columns\")\n638 |         result, _ = _groupby_and_merge(left_by, left, right, lambda x, y: _merger(x, y))\n639 |     elif right_by is not None:\n640 |         if isinstance(right_by, str):\n641 |             right_by = [right_by]\n642 |         check = set(right_by).difference(right.columns)\n643 |         if len(check) != 0:\n644 |             raise KeyError(f\"{check} not found in right columns\")\n645 |         result, _ = _groupby_and_merge(\n646 |             right_by, right, left, lambda x, y: _merger(y, x)\n647 |         )\n648 |     else:\n649 |         result = _merger(left, right)\n650 |     return result\n```\n\nFound function `pandas/core/frame.py:DataFrame.T`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3842 | def T(self) -> DataFrame:\n3843 |         \"\"\"\n3844 |         The transpose of the DataFrame.\n3845 | \n3846 |         Returns\n3847 |         -------\n3848 |         DataFrame\n3849 |             The transposed DataFrame.\n3850 | \n3851 |         See Also\n3852 |         --------\n3853 |         DataFrame.transpose : Transpose index and columns.\n3854 | \n3855 |         Examples\n3856 |         --------\n3857 |         >>> df = pd.DataFrame({\"col1\": [1, 2], \"col2\": [3, 4]})\n3858 |         >>> df\n3859 |            col1  col2\n3860 |         0     1     3\n3861 |         1     2     4\n3862 | \n3863 |         >>> df.T\n3864 |               0  1\n3865 |         col1  1  2\n3866 |         col2  3  4\n3867 |         \"\"\"\n3868 |         return self.transpose()\n```\n\nFound function `pandas/core/frame.py:DataFrame._replace_columnwise`.\nSource: Retrieved entity using keyword search (bm25).\n```\n5664 | def _replace_columnwise(\n5665 |         self, mapping: dict[Hashable, tuple[Any, Any]], inplace: bool, regex\n5666 |     ) -> Self | None:\n5667 |         \"\"\"\n5668 |         Dispatch to Series.replace column-wise.\n5669 | \n5670 |         Parameters\n5671 |         ----------\n5672 |         mapping : dict\n5673 |             of the form {col: (target, value)}\n5674 |         inplace : bool\n5675 |         regex : bool or same types as `to_replace` in DataFrame.replace\n5676 | \n5677 |         Returns\n5678 |         -------\n5679 |         DataFrame or None\n5680 |         \"\"\"\n5681 |         # Operate column-wise\n5682 |         res = self if inplace else self.copy(deep=False)\n5683 |         a