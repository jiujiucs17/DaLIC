ata == 0] = EPSILON\n585 | \n586 |         if beta_loss == 1:\n587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n588 |         elif beta_loss == 0:\n589 |             # speeds up computation time\n590 |             # refer to /numpy/numpy/issues/9363\n591 |             WH_safe_X_data **= -1\n592 |             WH_safe_X_data **= 2\n593 |             # element-wise multiplication\n594 |             WH_safe_X_data *= X_data\n595 |         else:\n596 |             WH_safe_X_data **= beta_loss - 2\n597 |             # element-wise multiplication\n598 |             WH_safe_X_data *= X_data\n599 | \n600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n602 | \n603 |         # Denominator\n604 |         if beta_loss == 1:\n605 |             if H_sum is None:\n606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n607 |             denominator = H_sum[np.newaxis, :]\n608 | \n609 |         else:\n610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n611 |             if sp.issparse(X):\n612 |                 # memory efficient computation\n613 |                 # (compute row by row, avoiding the dense matrix WH)\n614 |                 WHHt = np.empty(W.shape)\n615 |                 for i in range(X.shape[0]):\n616 |                     WHi = np.dot(W[i, :], H)\n617 |                     if beta_loss - 1 < 0:\n618 |                         WHi[WHi == 0] = EPSILON\n619 |                     WHi **= beta_loss - 1\n620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n621 |             else:\n622 |                 WH **= beta_loss - 1\n623 |                 WHHt = np.dot(WH, H.T)\n624 |             denominator = WHHt\n625 | \n626 |     # Add L1 and L2 regularization\n627 |     if l1_reg_W > 0:\n628 |         denominator += l1_reg_W\n629 |     if l2_reg_W > 0:\n630 |         denominator = denominator + l2_reg_W * W\n631 |     d