keyword search (bm25).\n```\n8282 | def clip(\n8283 |         self,\n8284 |         lower=None,\n8285 |         upper=None,\n8286 |         *,\n8287 |         axis: Axis | None = None,\n8288 |         inplace: bool = False,\n8289 |         **kwargs,\n8290 |     ) -> Self | None:\n8291 |         \"\"\"\n8292 |         Trim values at input threshold(s).\n8293 | \n8294 |         Assigns values outside boundary to boundary values. Thresholds\n8295 |         can be singular values or array like, and in the latter case\n8296 |         the clipping is performed element-wise in the specified axis.\n8297 | \n8298 |         Parameters\n8299 |         ----------\n8300 |         lower : float or array-like, default None\n8301 |             Minimum threshold value. All values below this\n8302 |             threshold will be set to it. A missing\n8303 |             threshold (e.g `NA`) will not clip the value.\n8304 |         upper : float or array-like, default None\n8305 |             Maximum threshold value. All values above this\n8306 |             threshold will be set to it. A missing\n8307 |             threshold (e.g `NA`) will not clip the value.\n8308 |         axis : {{0 or 'index', 1 or 'columns', None}}, default None\n8309 |             Align object with lower and upper along the given axis.\n8310 |             For `Series` this parameter is unused and defaults to `None`.\n8311 |         inplace : bool, default False\n8312 |             Whether to perform the operation in place on the data.\n8313 |         **kwargs\n8314 |             Additional keywords have no effect but might be accepted\n8315 |             for compatibility with numpy.\n8316 | \n8317 |         Returns\n8318 |         -------\n8319 |         Series or DataFrame or None\n8320 |             Same type as calling object with the values outside the\n8321 |             clip boundaries replaced or None if ``inplace=True``.\n8322 | \n8323 |         See Also\n8324 |         --------\n8325 |         Series.clip : Trim values at input threshold in series.\n8326 |         DataFrame.clip : Trim values at input threshold in DataFrame.\n8327 |         numpy.clip : Clip (limit) the values in an array.\n8328 | \n8329 |         Examples\n8330 |         --------\n8331 |         >>> data = {\"col_0\": [9, -3, 0, -1, 5], \"col_1\": [-2, -7, 6, 8, -5]}\n8332 |         >>> df = pd.DataFrame(data)\n8333 |         >>> df\n8334 |            col_0  col_1\n8335 |         0      9     -2\n8336 |         1     -3     -7\n8337 |         2      0      6\n8338 |         3     -1      8\n8339 |         4      5     -5\n8340 | \n8341 |         Clips per column using lower and upper thresholds:\n8342 | \n8343 |         >>> df.clip(-4, 6)\n8344 |            col_0  col_1\n8345 |         0      6     -2\n8346 |         1     -3     -4\n8347 |         2      0      6\n8348 |         3     -1      6\n8349 |         4      5     -4\n8350 | \n8351 |         Clips using specific lower and upper thresholds per column:\n8352 | \n8353 |         >>> df.clip([-2, -1], [4, 5])\n8354 |             col_0  col_1\n8355 |         0      4     -1\n8356 |         1     -2     -1\n8357 |         2      0      5\n8358 |         3     -1      5\n8359 |         4      4     -1\n8360 | \n8361 |         Clips using specific lower and upper thresholds per column element:\n8362 | \n8363 |         >>> t = pd.Series([2, -4, -1, 6, 3])\n8364 |         >>> t\n8365 |         0    2\n8366 |         1   -4\n8367 |         2   -1\n8368 |         3    6\n8369 |         4    3\n8370 |         dtype: int64\n8371 | \n8372 |         >>> df.clip(t, t + 4, axis=0)\n8373 |            col_0  col_1\n8374 |         0      6      2\n8375 |         1     -3     -4\n8376 |         2      0      3\n8377 |         3      6      8\n8378 |         4      5      3\n8379 | \n8380 |         Clips using specific lower threshold per column element, with missing values:\n8381 | \n8382 |         >>> t = pd.Series([2, -4, np.nan, 6, 3])\n8383 |         >>> t\n8384 |         0    2.0\n8385 |         1   -4.0\n8386 |         2    NaN\n8387 |         3    6.0\n8388 |         4    3.0\n8389 |         dtype: float64\n8390 | \n8391 |         >>> df.clip(t, axis=0)\n8392 |         col_0  col_1\n8393 |         0      9.0    2.0\n8394 |         1     -3.0   -4.0\n8395 |         2      0.0    6.0\n8396 |         3      6.0    8.0\n8397 |         4      5.0    3.0\n8398 |         \"\"\"\n8399 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n8400 | \n8401 |         if inplace:\n8402 |             if not PYPY:\n8403 |                 if sys.getrefcount(self) <= REF_COUNT:\n8404 |                     warnings.warn(\n8405 |                         _chained_assignment_method_msg,\n8406 |                         ChainedAssignmentError,\n8407 |                         stacklevel=2,\n8408 |                     )\n8409 | \n8410 |         axis = nv.validate_clip_with_axis(axis, (), kwargs)\n8411 |         if axis is not None:\n8412 |             axis = self._get_axis_number(axis)\n8413 | \n8414 |         # GH 17276\n8415 |         # numpy doesn't like NaN as a clip value\n8416 |         # so ignore\n8417 |         # GH 19992\n8418 |         # numpy doesn't drop a list-like bound containing NaN\n8419 |         isna_lower = isna(lower)\n8420 |         if not is_list_like(lower):\n8421 |             if np.any(isna_lower):\n8422 |                 lower = None\n8423 |         elif np.all(isna_lower):\n8424 |             lower = None\n8425 |         isna_upper = isna(upper)\n8426 |         if not is_list_like(upper):\n8427 |             if np.any(isna_upper):\n8428 |                 upper = None\n8429 |         elif np.all(isna_upper):\n8430 |             upper = None\n8431 | \n8432 |         # GH 2747 (arguments were reversed)\n8433 |         if (\n8434 |             lower is not None\n8435 |             and upper is not None\n8436 |             and is_scalar(lower)\n8437 |             and is_scalar(upper)\n8438 |         ):\n8