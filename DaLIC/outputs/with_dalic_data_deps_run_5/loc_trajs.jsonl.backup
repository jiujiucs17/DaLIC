lue of *bottom* (e.g. timedelta).\n2349 | \n2350 |         width : float or array-like, default: 0.8\n2351 |             The width(s) of the bars.\n2352 | \n2353 |             Note that if *x* has units (e.g. datetime), then *width* should be in\n2354 |             units that are a difference (e.g. timedelta) around the *x* values.\n2355 | \n2356 |         bottom : float or array-like, default: 0\n2357 |             The y coordinate(s) of the bottom side(s) of the bars.\n2358 | \n2359 |             Note that if *bottom* has units, then the y-axis will get a Locator and\n2360 |             Formatter appropriate for the units (e.g. dates, or categorical).\n2361 | \n2362 |         align : {'center', 'edge'}, default: 'center'\n2363 |             Alignment of the bars to the *x* coordinates:\n2364 | \n2365 |             - 'center': Center the base on the *x* positions.\n2366 |             - 'edge': Align the left edges of the bars with the *x* positions.\n2367 | \n2368 |             To align the bars on the right edge pass a negative *width* and\n2369 |             ``align='edge'``.\n2370 | \n2371 |         Returns\n2372 |         -------\n2373 |         `.BarContainer`\n2374 |             Container with all the bars and optionally errorbars.\n2375 | \n2376 |         Other Parameters\n2377 |         ----------------\n2378 |         color : :mpltype:`color` or list of :mpltype:`color`, optional\n2379 |             The colors of the bar faces.\n2380 | \n2381 |         edgecolor : :mpltype:`color` or list of :mpltype:`color`, optional\n2382 |             The colors of the bar edges.\n2383 | \n2384 |         linewidth : float or array-like, optional\n2385 |             Width of the bar edge(s). If 0, don't draw edges.\n2386 | \n2387 |         tick_label : str or list of str, optional\n2388 |             The tick labels of the bars.\n2389 |             Default: None (Use default numeric labels.)\n2390 | \n2391 |         label : str or list of str, optional\n2392 |             A single label is attached to the resulting `.BarContainer` as a\n2393 |             label for the whole dataset.\n2394 |             If a list is provided, it must be the same length as *x* and\n2395 |             labels the individual bars. Repeated labels are not de-duplicated\n2396 |             and will cause repeated label entries, so this is best used when\n2397 |             bars also differ in style (e.g., by passing a list to *color*.)\n2398 | \n2399 |         xerr, yerr : float or array-like of shape(N,) or shape(2, N), optional\n2400 |             If not *None*, add horizontal / vertical errorbars to the bar tips.\n2401 |             The values are +/- sizes relative to the data:\n2402 | \n2403 |             - scalar: symmetric +/- values for all bars\n2404 |             - shape(N,): symmetric +/- values for each bar\n2405 |             - shape(2, N): Separate - and + values for each bar. First row\n2406 |               contains the lower errors, the second row contains the upper\n2407 |               errors.\n2408 |             - *None*: No errorbar. (Default)\n2409 | \n2410 |             See :doc:`/gallery/statistics/errorbar_features` for an example on\n2411 |             the usage of *xerr* and *yerr*.\n2412 | \n2413 |         ecolor : :mpltype:`color` or list of :mpltype:`color`, default: 'black'\n2414 |             The line color of the errorbars.\n2415 | \n2416 |         capsize : float, default: :rc:`errorbar.capsize`\n2417 |            The length of the error bar caps in points.\n2418 | \n2419 |         error_kw : dict, optional\n2420 |             Dictionary of keyword arguments to be passed to the\n2421 |             `~.Axes.errorbar` method. Values of *ecolor* or *capsize* defined\n2422 |             here take precedence over the independent keyword arguments.\n2423 | \n2424 |         log : bool, default: False\n2425 |             If *True*, set the y-axis to be log scale.\n2426 | \n2427 |         data : indexable object, optional\n2428 |             DATA_PARAMETER_PLACEHOLDER\n2429 | \n2430 |         **kwargs : `.Rectangle` properties\n2431 | \n2432 |         %(Rectangle:kwdoc)s\n2433 | \n2434 |         See Also\n2435 |         --------\n2436 |         barh : Plot a horizontal bar plot.\n2437 | \n2438 |         Notes\n2439 |         -----\n2440 |         Stacked bars can be achieved by passing individual *bottom* values per\n2441 |         bar. See :doc:`/gallery/lines_bars_and_markers/bar_stacked`.\n2442 |         \"\"\"\n2443 |         kwargs = cbook.normalize_kwargs(kwargs, mpatches.Patch)\n2444 |         color = kwargs.pop('color', None)\n2445 |         if color is None:\n2446 |             color = self._get_patches_for_fill.get_next_color()\n2447 |         edgecolor = kwargs.pop('edgecolor', None)\n2448 |         linewidth = kwargs.pop('linewidth', None)\n2449 |         hatch = kwargs.pop('hatch', None)\n2450 | \n2451 |         # Because xerr and yerr will be passed to errorbar, most dimension\n2452 |         # checking and processing will be left to the errorbar method.\n2453 |         xerr = kwargs.pop('xerr', None)\n2454 |         yerr = kwargs.pop('yerr', None)\n2455 |         error_kw = kwargs.pop('error_kw', None)\n2456 |         error_kw = {} if error_kw is None else error_kw.copy()\n2457 |         ezorder = error_kw.pop('zorder', None)\n2458 |         if ezorder is None:\n2459 |             ezorder = kwargs.get('zorder', None)\n2460 |             if ezorder is not None:\n2461 |                 # If using the bar zorder, increment slightly to make sure\n2462 |                 # errorbars are drawn on top of bars\n2463 |                 ezorder += 0.01\n2464 |         error_kw.setdefault('zorder', ezorder)\n2465 |         ecolor = kwargs.pop('ecolor', 'k')\n2466 |         capsize = kwargs.pop('capsize', mpl.rcParams[\"errorbar.capsize\"])\n2467 |         error_kw.setdefault('ecolor', ecolor)\n2468 |         error_kw.setdefault('capsize', capsize)\n2469 | \n2470 |         # The keyword argument *orientation* is used by barh() to defer all\n2471 |         # logic and drawing to bar(). It is considered internal and is\n2472 |         # intentionally not mentioned in the docstring.\n2473 |         orientation = kwargs.pop('orientation', 'vertical')\n2474 |         _api.check_in_list(['vertical', 'horizontal'], orientation=orientation)\n2475 |         log = kwargs.pop('log', False)\n2476 |         label = kwargs.pop('label', '')\n2477 |         tick_labels = kwargs.pop('tick_label', None)\n2478 | \n2479 |         y = bottom  # Matches barh call signature.\n2480 |         if orientation == 'vertical':\n2481 |             if y is None:\n2482 |                 y = 0\n2483 |         else:  # horizontal\n2484 |             if x is None:\n2485 |                 x = 0\n2486 | \n2487 |         if orientation == 'vertical':\n2488 |             # It is possible for y (bottom) to contain unit information.\n2489 |             # However, it is also possible for y=0 for the default and height\n2490 |             # to contain unit information.  This will prioritize the units of y.\n2491 |             self._process_unit_info(\n2492 |                 [(\"x\", x), (\"y\", y), (\"y\", height)], kwargs, convert=False)\n2493 |             if log:\n2494 |                 self.set_yscale('log', nonpositive='clip')\n2495 |         else:  # horizontal\n2496 |             # It is possible for x (left) to contain unit information.\n2497 |             # However, it is also possible for x=0 for the default and width\n2498 |             # to contain unit information.  This will prioritize the units of x.\n2499 |             self._process_unit_info(\n2500 |                 [(\"x\", x), (\"x\", width), (\"y\", y)], kwargs, convert=False)\n2501 |             if log:\n2502 |                 self.set_xscale('log', nonpositive='clip')\n2503 | \n2504 |         # lets do some conversions now since some types cannot be\n2505 |         # subtracted uniformly\n2506 |         if self.xaxis is not None:\n2507 |             x0 = x\n2508 |             x = np.asarray(self.convert_xunits(x))\n2509 |             width = self._convert_dx(width, x0, x, self.convert_xunits)\n2510 |             if xerr is not None:\n2511 |                 xerr = self._convert_dx(xerr, x0, x, self.convert_xunits)\n2512 |         if self.yaxis is not None:\n2513 |             y0 = y\n2514 |             y = np.asarray(self.convert_yunits(y))\n2515 |             height = self._convert_dx(height, y0, y, self.convert_yunits)\n2516 |             if yerr is not None:\n2517 |                 yerr = self._convert_dx(yerr, y0, y, self.convert_yunits)\n2518 | \n2519 |         x, height, width, y, linewidth, hatch = np.broadcast_arrays(\n2520 |             # Make args iterable too.\n2521 |             np.atleast_1d(x), height, width, y, linewidth, hatch)\n2522 | \n2523 |         # Now that units have been converted, set the tick locations.\n2524 |         if orientation == 'vertical':\n2525 |             tick_label_axis = self.xaxis\n2526 |             tick_label_position = x\n2527 |         else:  # horizontal\n2528 |             tick_label_axis = self.yaxis\n2529 |             tick_label_position = y\n2530 | \n2531 |         if not isinstance(label, str) and np.iterable(label):\n2532 |             bar_container_label = '_nolegend_'\n2533 |             patch_labels = label\n2534 |         else:\n2535 |             bar_container_label = label\n2536 |             patch_labels = ['_nolegend_'] * len(x)\n2537 |         if len(patch_labels) != len(x):\n2538 |             raise ValueError(f'number of labels ({len(patch_labels)}) '\n2539 |                              f'does not match number of bars ({len(x)}).')\n2540 | \n2541 |         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n2542 |         hatch = itertools.cycle(np.atleast_1d(hatch))\n2543 |         color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n2544 |                                 # Fallback if color == \"none\".\n2545 |                                 itertools.repeat('none'))\n2546 |         if edgecolor is None:\n2547 |             edgecolor = itertools.repeat(None)\n2548 |         else:\n2549 |             edgecolor = itertools.chain(\n2550 |                 itertools.cycle(mcolors.to_rgba_array(edgecolor)),\n2551 |                 # Fallback if edgecolor == \"none\".\n2552 |                 itertools.repeat('none'))\n2553 | \n2554 |         # We will now resolve the alignment and really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                                     f'and width ({width.dtype}) '\n2564 |                                     f'are incompatible') from e\n2565 |                 bottom = y\n2566 |             else:  # horizontal\n2567 |                 try:\n2568 |                     bottom = y - height / 2\n2569 |                 except TypeError as e:\n2570 |                     raise TypeError(f'the dtypes of parameters y ({y.dtype}) '\n2571 |                                     f'and height ({height.dtype}) '\n2572 |                                     f'are incompatible') from e\n2573 |                 left = x\n2574 |         else:  # edge\n2575 |             left = x\n2576 |             bottom = y\n2577 | \n2578 |         patches = []\n2579 |         args = zip(left, bottom, width, height, color, edgecolor, linewidth,\n2580 |                    hatch, patch_labels)\n2581 |         for l, b, w, h, c, e, lw, htch, lbl in args:\n2582 |             r = mpatches.Rectangle(\n2583 |                 xy=(l, b), width=w, height=h,\n2584 |                 facecolor=c,\n2585 |                 edgecolor=e,\n2586 |                 linewidth=lw,\n2587 |                 label=lbl,\n2588 |                 hatch=htch,\n2589 |                 )\n2590 |             r._internal_update(kwargs)\n2591 |             r.get_path()._interpolation_steps = 100\n2592 |             if orientation == 'vertical':\n2593 |                 r.sticky_edges.y.append(b)\n2594 |             else:  # horizontal\n2595 |                 r.sticky_edges.x.append(l)\n2596 |             self.add_patch(r)\n2597 |             patches.append(r)\n2598 | \n2599 |         if xerr is not None or yerr is not None:\n2600 |             if orientation == 'vertical':\n2601 |                 # using list comps rather than arrays to preserve unit info\n2602 |                 ex = [l + 0.5 * w for l, w in zip(left, width)]\n2603 |                 ey = [b + h for b, h in zip(bottom, height)]\n2604 | \n2605 |             else:  # horizontal\n2606 |                 # using list comps rather than arrays to preserve unit info\n2607 |                 ex = [l + w for l, w in zip(left, width)]\n2608 |                 ey = [b + 0.5 * h for b, h in zip(bottom, height)]\n2609 | \n2610 |             error_kw.setdefault(\"label\", '_nolegend_')\n2611 | \n2612 |             errorbar = self.errorbar(ex, ey, yerr=yerr, xerr=xerr, fmt='none',\n2613 |                                      **error_kw)\n2614 |         else:\n2615 |             errorbar = None\n2616 | \n2617 |         self._request_autoscale_view()\n2618 | \n2619 |         if orientation == 'vertical':\n2620 |             datavalues = height\n2621 |         else:  # horizontal\n2622 |             datavalues = width\n2623 | \n2624 |         bar_container = BarContainer(patches, errorbar, datavalues=datavalues,\n2625 |                                      orientation=orientation,\n2626 |                                      label=bar_container_label)\n2627 |         self.add_container(bar_container)\n2628 | \n2629 |         if tick_labels is not None:\n2630 |             tick_labels = np.broadcast_to(tick_labels, len(patches))\n2631 |             tick_label_axis.set_ticks(tick_label_position)\n2632 |             tick_label_axis.set_ticklabels(tick_labels)\n2633 | \n2634 |         return bar_container\n```\n"}, {"content": "Now that we have the complete implementation of the `bar` function in `lib/matplotlib/axes/_axes.py`, we need to look for where `facecolor` is handled. Additionally, we'll check how `color` and `edgecolor` are processed to ensure the feature fits into the overall functionality of the codebase.\n\nLet's search specifically for `facecolor` in `lib/matplotlib/axes/_axes.py`.\n\n<function=search_code_snippets>\n<parameter=search_terms>[\"facecolor\"]</parameter>\n<parameter=file_path_or_pattern>\"lib/matplotlib/axes/_axes.py\"</parameter>\nline_nums>[2582, 2583]</line_nums>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\ngalleries/examples/mplot3d/intersecting_planes.py:plot_quadrants\nlib/matplotlib/backends/backend_pdf.py:RendererPdf.draw_path_collection\nlib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.voxels\nlib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow.new_line\nlib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle:6\nlib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow\nlib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow.__init__\nlib/matplotlib/axes/_axes.py:Axes._parse_scatter_color_args\nlib/matplotlib/animation.py:Animation.save\nlib/matplotlib/tri/_tripcolor.py:tripcolor\nlib/mpl_toolkits/mplot3d/art3d.py:Poly3DCollection.__init__\nlib/matplotlib/axes/_axes.py:Axes._parse_scatter_color_args\nlib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.set_title\nlib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar3d\nNo files found for file pattern '\"lib/matplotlib/axes/_axes.py\"'. Will search all files.\n...\n##Searching for term \"facecolor\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.voxels`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3353 | def voxels(self, *args, facecolors=None, edgecolors=None, shade=True,\n3354 |                lightsource=None, axlim_clip=False, **kwargs):\n3355 |         \"\"\"\n3356 |         ax.voxels([x, y, z,] /, filled, facecolors=None, edgecolors=None, \\\n3357 | **kwargs)\n3358 | \n3359 |         Plot a set of filled voxels\n3360 | \n3361 |         All voxels are plotted as 1x1x1 cubes on the axis, with\n3362 |         ``filled[0, 0, 0]`` placed with its lower corner at the origin.\n3363 |         Occluded faces are not plotted.\n3364 | \n3365 |         Parameters\n3366 |         ----------\n3367 |         filled : 3D np.array of bool\n3368 |             A 3D array of values, with truthy values indicating which voxels\n3369 |             to fill\n3370 | \n3371 |         x, y, z : 3D np.array, optional\n3372 |             The coordinates of the corners of the voxels. This should broadcast\n3373 |             to a shape one larger in every dimension than the shape of\n3374 |             *filled*.  These can be used to plot non-cubic voxels.\n3375 | \n3376 |             If not specified, defaults to increasing integers along each axis,\n3377 |             like those returned by :func:`~numpy.indices`.\n3378 |             As indicated by the ``/`` in the function signature, these\n3379 |             arguments can only be passed positionally.\n3380 | \n3381 |         facecolors, edgecolors : array-like, optional\n3382 |             The color to draw the faces and edges of the voxels. Can only be\n3383 |             passed as keyword arguments.\n3384 |             These parameters can be:\n3385 | \n3386 |             - A single color value, to color all voxels the same color. This\n3387 |               can be either a string, or a 1D RGB/RGBA array\n3388 |             - ``None``, the default, to use a single color for the faces, and\n3389 |               the style default for the edges.\n3390 |             - A 3D `~numpy.ndarray` of color names, with each item the color\n3391 |               for the corresponding voxel. The size must match the voxels.\n3392 |             - A 4D `~numpy.ndarray` of RGB/RGBA data, with the components\n3393 |               along the last axis.\n3394 | \n3395 |         shade : bool, default: True\n3396 |             Whether to shade the facecolors.\n3397 | \n3398 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3399 |             The lightsource to use when *shade* is True.\n3400 | \n3401 |         axlim_clip : bool, default: False\n3402 |             Whether to hide voxels with points outside the axes view limits.\n3403 | \n3404 |             .. versionadded:: 3.10\n3405 | \n3406 |         **kwargs\n3407 |             Additional keyword arguments to pass onto\n3408 |             `~mpl_toolkits.mplot3d.art3d.Poly3DCollection`.\n3409 | \n3410 |         Returns\n3411 |         -------\n3412 |         faces : dict\n3413 |             A dictionary indexed by coordinate, where ``faces[i, j, k]`` is a\n3414 |             `.Poly3DCollection` of the faces drawn for the voxel\n3415 |             ``filled[i, j, k]``. If no faces were drawn for a given voxel,\n3416 |             either because it was not asked to be drawn, or it is fully\n3417 |             occluded, then ``(i, j, k) not in faces``.\n3418 | \n3419 |         Examples\n3420 |         --------\n3421 |         .. plot:: gallery/mplot3d/voxels.py\n3422 |         .. plot:: gallery/mplot3d/voxels_rgb.py\n3423 |         .. plot:: gallery/mplot3d/voxels_torus.py\n3424 |         .. plot:: gallery/mplot3d/voxels_numpy_logo.py\n3425 |         \"\"\"\n3426 | \n3427 |         # work out which signature we should be using, and use it to parse\n3428 |         # the arguments. Name must be voxels for the correct error message\n3429 |         if len(args) >= 3:\n3430 |             # underscores indicate position only\n3431 |             def voxels(__x, __y, __z, filled, **kwargs):\n3432 |                 return (__x, __y, __z), filled, kwargs\n3433 |         else:\n3434 |             def voxels(filled, **kwargs):\n3435 |                 return None, filled, kwargs\n3436 | \n3437 |         xyz, filled, kwargs = voxels(*args, **kwargs)\n3438 | \n3439 |         # check dimensions\n3440 |         if filled.ndim != 3:\n3441 |             raise ValueError(\"Argument filled must be 3-dimensional\")\n3442 |         size = np.array(filled.shape, dtype=np.intp)\n3443 | \n3444 |         # check xyz coordinates, which are one larger than the filled shape\n3445 |         coord_shape = tuple(size + 1)\n3446 |         if xyz is None:\n3447 |             x, y, z = np.indices(coord_shape)\n3448 |         else:\n3449 |             x, y, z = (np.broadcast_to(c, coord_shape) for c in xyz)\n3450 | \n3451 |         def _broadcast_color_arg(color, name):\n3452 |             if np.ndim(color) in (0, 1):\n3453 |                 # single color, like \"red\" or [1, 0, 0]\n3454 |                 return np.broadcast_to(color, filled.shape + np.shape(color))\n3455 |             elif np.ndim(color) in (3, 4):\n3456 |                 # 3D array of strings, or 4D array with last axis rgb\n3457 |                 if np.shape(color)[:3] != filled.shape:\n3458 |                     raise ValueError(\n3459 |                         f\"When multidimensional, {name} must match the shape \"\n3460 |                         \"of filled\")\n3461 |                 return color\n3462 |             else:\n3463 |                 raise ValueError(f\"Invalid {name} argument\")\n3464 | \n3465 |         # broadcast and default on facecolors\n3466 |         if facecolors is None:\n3467 |             facecolors = self._get_patches_for_fill.get_next_color()\n3468 |         facecolors = _broadcast_color_arg(facecolors, 'facecolors')\n3469 | \n3470 |         # broadcast but no default on edgecolors\n3471 |         edgecolors = _broadcast_color_arg(edgecolors, 'edgecolors')\n3472 | \n3473 |         # scale to the full array, even if the data is only in the center\n3474 |         self.auto_scale_xyz(x, y, z)\n3475 | \n3476 |         # points lying on corners of a square\n3477 |         square = np.array([\n3478 |             [0, 0, 0],\n3479 |             [1, 0, 0],\n3480 |             [1, 1, 0],\n3481 |             [0, 1, 0],\n3482 |         ], dtype=np.intp)\n3483 | \n3484 |         voxel_faces = defaultdict(list)\n3485 | \n3486 |         def permutation_matrices(n):\n3487 |             \"\"\"Generate cyclic permutation matrices.\"\"\"\n3488 |             mat = np.eye(n, dtype=np.intp)\n3489 |             for i in range(n):\n3490 |                 yield mat\n3491 |                 mat = np.roll(mat, 1, axis=0)\n3492 | \n3493 |         # iterate over each of the YZ, ZX, and XY orientations, finding faces\n3494 |         # to render\n3495 |         for permute in permutation_matrices(3):\n3496 |             # find the set of ranges to iterate over\n3497 |             pc, qc, rc = permute.T.dot(size)\n3498 |             pinds = np.arange(pc)\n3499 |             qinds = np.arange(qc)\n3500 |             rinds = np.arange(rc)\n3501 | \n3502 |             square_rot_pos = square.dot(permute.T)\n3503 |             square_rot_neg = square_rot_pos[::-1]\n3504 | \n3505 |             # iterate within the current plane\n3506 |             for p in pinds:\n3507 |                 for q in qinds:\n3508 |                     # iterate perpendicularly to the current plane, handling\n3509 |                     # boundaries. We only draw faces between a voxel and an\n3510 |                     # empty space, to avoid drawing internal faces.\n3511 | \n3512 |                     # draw lower faces\n3513 |                     p0 = permute.dot([p, q, 0])\n3514 |                     i0 = tuple(p0)\n3515 |                     if filled[i0]:\n3516 |                         voxel_faces[i0].append(p0 + square_rot_neg)\n3517 | \n3518 |                     # draw middle faces\n3519 |                     for r1, r2 in itertools.pairwise(rinds):\n3520 |                         p1 = permute.dot([p, q, r1])\n3521 |                         p2 = permute.dot([p, q, r2])\n3522 | \n3523 |                         i1 = tuple(p1)\n3524 |                         i2 = tuple(p2)\n3525 | \n3526 |                         if filled[i1] and not filled[i2]:\n3527 |                             voxel_faces[i1].append(p2 + square_rot_pos)\n3528 |                         elif not filled[i1] and filled[i2]:\n3529 |                             voxel_faces[i2].append(p2 + square_rot_neg)\n3530 | \n3531 |                     # draw upper faces\n3532 |                     pk = permute.dot([p, q, rc-1])\n3533 |                     pk2 = permute.dot([p, q, rc])\n3534 |                     ik = tuple(pk)\n3535 |                     if filled[ik]:\n3536 |                         voxel_faces[ik].append(pk2 + square_rot_pos)\n3537 | \n3538 |         # iterate over the faces, and generate a Poly3DCollection for each\n3539 |         # voxel\n3540 |         polygons = {}\n3541 |         for coord, faces_inds in voxel_faces.items():\n3542 |             # convert indices into 3D positions\n3543 |             if xyz is None:\n3544 |                 faces = faces_inds\n3545 |             else:\n3546 |                 faces = []\n3547 |                 for face_inds in faces_inds:\n3548 |                     ind = face_inds[:, 0], face_inds[:, 1], face_inds[:, 2]\n3549 |                     face = np.empty(face_inds.shape)\n3550 |                     face[:, 0] = x[ind]\n3551 |                     face[:, 1] = y[ind]\n3552 |                     face[:, 2] = z[ind]\n3553 |                     faces.append(face)\n3554 | \n3555 |             # shade the faces\n3556 |             facecolor = facecolors[coord]\n3557 |             edgecolor = edgecolors[coord]\n3558 | \n3559 | 