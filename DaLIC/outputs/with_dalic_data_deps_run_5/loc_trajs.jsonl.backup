| \n 307 |     def __new__(\n 308 |         cls,\n 309 |         data=None,\n 310 |         freq: Frequency | lib.NoDefault = lib.no_default,\n 311 |         tz=lib.no_default,\n 312 |         ambiguous: TimeAmbiguous = \"raise\",\n 313 |         dayfirst: bool = False,\n 314 |         yearfirst: bool = False,\n 315 |         dtype: Dtype | None = None,\n 316 |         copy: bool = False,\n 317 |         name: Hashable | None = None,\n 318 |     ) -> Self:\n 319 |         if is_scalar(data):\n 320 |             cls._raise_scalar_data_error(data)\n 321 | \n 322 |         # - Cases checked above all return/raise before reaching here - #\n 323 | \n 324 |         name = maybe_extract_name(name, data, cls)\n 325 | \n 326 |         if (\n 327 |             isinstance(data, DatetimeArray)\n 328 |             and freq is lib.no_default\n 329 |             and tz is lib.no_default\n 330 |             and dtype is None\n 331 |         ):\n 332 |             # fastpath, similar logic in TimedeltaIndex.__new__;\n 333 |             # Note in this particular case we retain non-nano.\n 334 |             if copy:\n 335 |                 data = data.copy()\n 336 |             return cls._simple_new(data, name=name)\n 337 | \n 338 |         dtarr = DatetimeArray._from_sequence_not_strict(\n 339 |             data,\n 340 |             dtype=dtype,\n 341 |             copy=copy,\n 342 |             tz=tz,\n 343 |             freq=freq,\n 344 |             dayfirst=dayfirst,\n 345 |             yearfirst=yearfirst,\n 346 |             ambiguous=ambiguous,\n 347 |         )\n 348 |         refs = None\n 349 |         if not copy and isinstance(data, (Index, ABCSeries)):\n 350 |             refs = data._references\n 351 | \n 352 |         subarr = cls._simple_new(dtarr, name=name, refs=refs)\n 353 |         return subarr\n 354 | \n 355 |     # --------------------------------------------------------------------\n 356 | \n 357 |     @cache_readonly\n 358 |     def _is_dates_only(self) -> bool:\n 359 |         \"\"\"\n 360 |         Return a boolean if we are only dates (and don't have a timezone)\n 361 | \n 362 |         Returns\n 363 |         -------\n 364 |         bool\n 365 |         \"\"\"\n 366 |         if isinstance(self.freq, Tick):\n 367 |             delta = Timedelta(self.freq)\n 368 | \n 369 |             if delta % dt.timedelta(days=1) != dt.timedelta(days=0):\n 370 |                 return False\n 371 | \n 372 |         return self._values._is_dates_only\n 373 | \n 374 |     def __reduce__(self):\n 375 |         d = {\"data\": self._data, \"name\": self.name}\n 376 |         return _new_DatetimeIndex, (type(self), d), None\n 377 | \n 378 |     def _is_comparable_dtype(self, dtype: DtypeObj) -> bool:\n 379 |         \"\"\"\n 380 |         Can we compare values of the given dtype to our own?\n 381 |         \"\"\"\n 382 |         if self.tz is not None:\n 383 |             # If we have tz, we can compare to tzaware\n 384 |             return isinstance(dtype, DatetimeTZDtype)\n 385 |         # if we dont have tz, we can only compare to tznaive\n 386 |         return lib.is_np_dtype(dtype, \"M\")\n 387 | \n 388 |     # --------------------------------------------------------------------\n 389 |     # Rendering Methods\n 390 | \n 391 |     @cache_readonly\n 392 |     def _formatter_func(self):\n 393 |         # Note this is equivalent to the DatetimeIndexOpsMixin method but\n 394 |         #  uses the maybe-cached self._is_dates_only instead of re-computing it.\n 395 |         from pandas.io.formats.format import get_format_datetime64\n 396 | \n 397 |         formatter = get_format_datetime64(is_dates_only=self._is_dates_only)\n 398 |         return lambda x: f\"'{formatter(x)}'\"\n 399 | \n 400 |     # --------------------------------------------------------------------\n 401 |     # Set Operation Methods\n 402 | \n 403 |     def _can_range_setop(self, other) -> bool:\n 404 |         # GH 46702: If self or other have non-UTC tzs, DST transitions prevent\n 405 |         # range representation due to no singular step\n 406 |         if (\n 407 |             self.tz is not None\n 408 |             and not timezones.is_utc(self.tz)\n 409 |             and not timezones.is_fixed_offset(self.tz)\n 410 |         ):\n 411 |             return False\n 412 |         if (\n 413 |             other.tz is not None\n 414 |             and not timezones.is_utc(other.tz)\n 415 |             and not timezones.is_fixed_offset(other.tz)\n 416 |         ):\n 417 |             return False\n 418 |         return super()._can_range_setop(other)\n 419 | \n 420 |     # --------------------------------------------------------------------\n 421 | \n 422 |     def _get_time_micros(self) -> npt.NDArray[np.int64]:\n 423 |         \"\"\"\n 424 |         Return the number of microseconds since midnight.\n 425 | \n 426 |         Returns\n 427 |         -------\n 428 |         ndarray[int64_t]\n 429 |         \"\"\"\n 430 |         values = self._data._local_timestamps()\n 431 | \n 432 |         ppd = periods_per_day(self._data._creso)\n 433 | \n 434 |         frac = values % ppd\n 435 |         if self.unit == \"ns\":\n 436 |             micros = frac // 1000\n 437 |         elif self.unit == \"us\":\n 438 |             micros = frac\n 439 |         elif self.unit == \"ms\":\n 440 |             micros = frac * 1000\n 441 |         elif self.unit == \"s\":\n 442 |             micros = frac * 1_000_000\n 443 |         else:  # pragma: no cover\n 444 |             raise NotImplementedError(self.unit)\n 445 | \n 446 |         micros[self._isnan] = -1\n 447 |         return micros\n 448 | \n 449 |     def snap(self, freq: Frequency = \"S\") -> DatetimeIndex:\n 450 |         \"\"\"\n 451 |         Snap time stamps to nearest occurring frequency.\n 452 | \n 453 |         Parameters\n 454 |         ----------\n 455 |         freq : str, Timedelta, datetime.timedelta, or DateOffset, default 'S'\n 456 |             Frequency strings can have multiples, e.g. '5h'. See\n 457 |             :ref:`here <timeseries.offset_aliases>` for a list of\n 458 |             frequency aliases.\n 459 | \n 460 |         Returns\n 461 |         -------\n 462 |         DatetimeIndex\n 463 |             Time stamps to nearest occurring `freq`.\n 464 | \n 465 |         See Also\n 466 |         --------\n 467 |         DatetimeIndex.round : Perform round operation on the data to the\n 468 |             specified `freq`.\n 469 |         DatetimeIndex.floor : Perform floor operation on the data to the\n 470 |             specified `freq`.\n 471 | \n 472 |         Examples\n 473 |         --------\n 474 |         >>> idx = pd.DatetimeIndex(\n 475 |         ...     [\"2023-01-01\", \"2023-01-02\", \"2023-02-01\", \"2023-02-02\"],\n 476 |         ...     dtype=\"M8[ns]\",\n 477 |         ... )\n 478 |         >>> idx\n 479 |         DatetimeIndex(['2023-01-01', '2023-01-02', '2023-02-01', '2023-02-02'],\n 480 |         dtype='datetime64[ns]', freq=None)\n 481 |         >>> idx.snap(\"MS\")\n 482 |         DatetimeIndex(['2023-01-01', '2023-01-01', '2023-02-01', '2023-02-01'],\n 483 |         dtype='datetime64[ns]', freq=None)\n 484 |         \"\"\"\n 485 |         # Superdumb, punting on any optimizing\n 486 |         freq = to_offset(freq)\n 487 | \n 488 |         dta = self._data.copy()\n 489 | \n 490 |         for i, v in enumerate(self):\n 491 |             s = v\n 492 |             if not freq.is_on_offset(s):\n 493 |                 t0 = freq.rollback(s)\n 494 |                 t1 = freq.rollforward(s)\n 495 |                 if abs(s - t0) < abs(t1 - s):\n 496 |                     s = t0\n 497 |                 else:\n 498 |                     s = t1\n 499 |             dta[i] = s\n 500 | \n 501 |         return DatetimeIndex._simple_new(dta, name=self.name)\n 502 | \n 503 |     # --------------------------------------------------------------------\n 504 |     # Indexing Methods\n 505 | \n 506 |     def _parsed_string_to_bounds(\n 507 |         self, reso: Resolution, parsed: dt.datetime\n 508 |     ) -> tuple[Timestamp, Timestamp]:\n 509 |         \"\"\"\n 510 |         Calculate datetime bounds for parsed time string and its resolution.\n 511 | \n 512 |         Parameters\n 513 |         ----------\n 514 |         reso : Resolution\n 515 |             Resolution provided by parsed string.\n 516 |         parsed : datetime\n 517 |             Datetime from parsed string.\n 518 | \n 519 |         Returns\n 520 |         -------\n 521 |         lower, upper: pd.Timestamp\n 522 |         \"\"\"\n 523 |         freq = OFFSET_TO_PERIOD_FREQSTR.get(reso.attr_abbrev, reso.attr_abbrev)\n 524 |         per = Period(parsed, freq=freq)\n 525 |         start, end = per.start_time, per.end_time\n 526 |         start = start.as_unit(self.unit)\n 527 |         end = end.as_unit(self.unit)\n 528 | \n 529 |         # GH 24076\n 530 |         # If an incoming date string contained a UTC offset, need to localize\n 531 |         # the parsed date to this offset first before aligning with the index's\n 532 |         # timezone\n 533 |         start = start.tz_localize(parsed.tzinfo)\n 534 |         end = end.tz_localize(parsed.tzinfo)\n 535 | \n 536 |         if parsed.tzinfo is not None:\n 537 |             if self.tz is None:\n 538 |                 raise ValueError(\n 539 |                     \"The index must be timezone aware when indexing \"\n 540 |                     \"with a date string with a UTC offset\"\n 541 |                 )\n 542 |         # The flipped case with parsed.tz is None and self.tz is not None\n 543 |         #  is ruled out bc parsed and reso are produced by _parse_with_reso,\n 544 |         #  which localizes parsed.\n 545 |         return start, end\n 546 | \n 547 |     def _parse_with_reso(self, label: str) -> tuple[Timestamp, Resolution]:\n 548 |         parsed, reso = super()._parse_with_reso(label)\n 549 | \n 550 |         parsed = Timestamp(parsed)\n 551 | \n 552 |         if self.tz is not None and parsed.tzinfo is None:\n 553 |             # we special-case timezone-naive strings and timezone-aware\n 554 |             #  DatetimeIndex\n 555 |             # https://github.com/pandas-dev/pandas/pull/36148#issuecomment-687883081\n 556 |             parsed = parsed.tz_localize(self.tz)\n 557 | \n 558 |         return parsed, reso\n 559 | \n 560 |     def _disallow_mismatched_indexing(self, key) -> None:\n 561 |         \"\"\"\n 562 |         Check for mismatched-tzawareness indexing and re-raise as KeyError.\n 563 |         \"\"\"\n 564 |         # we get here with isinstance(key, self._data._recognized_scalars)\n 565 |         try:\n 566 |             # GH#36148\n 567 |             self._data._assert_tzawareness_compat(key)\n 568 |         except TypeError as err:\n 569 |             raise KeyError(key) from err\n 570 | \n 571 |     def get_loc(self, key):\n 572 |         \"\"\"\n 573 |         Get integer location for requested label\n 574 | \n 575 |         Returns\n 576 |         -------\n 577 |         loc : int\n 578 |         \"\"\"\n 579 |         self._check_indexing_error(key)\n 580 | \n 581 |         orig_key = key\n 582 |         if is_valid_na_for_dtype(key, self.dtype):\n 583 |             key = NaT\n 584 | \n 585 |         if isinstance(key, self._data._recognized_scalars):\n 586 |             # needed to localize naive datetimes\n 587 |             self._disallow_mismatched_indexing(key)\n 588 |             key = Timestamp(key)\n 589 | \n 590 |         elif isinstance(key, str):\n 591 |             try:\n 592 |                 parsed, reso = self._parse_with_reso(key)\n 593 |             except ValueError as err:\n 594 |                 raise KeyError(key) from err\n 595 |             self._disallow_mismatched_indexing(parsed)\n 596 | \n 597 |             if self._can_partial_date_slice(reso):\n 598 |                 try:\n 599 |                     return self._partial_date_slice(reso, parsed)\n 600 |                 except KeyError as err:\n 601 |                     raise KeyError(key) from err\n 602 | \n 603 |             key = parsed\n 604 | \n 605 |         elif isinstance(key, dt.timedelta):\n 606 |             # GH#20464\n 607 |             raise TypeError(\n 608 |                 f\"Cannot index {type(self).__name__} with {type(key).__name__}\"\n 609 |             )\n 610 | \n 611 |         elif isinstance(key, dt.time):\n 612 |             return self.indexer_at_time(key)\n 613 | \n 614 |         else:\n 615 |             # unrecognized type\n 616 |             raise KeyError(key)\n 617 | \n 618 |         try:\n 619 |             return Index.get_loc(self, key)\n 620 |         except KeyError as err:\n 621 |             raise KeyError(orig_key) from err\n 622 | \n 623 |     @doc(DatetimeTimedeltaMixin._maybe_cast_slice_bound)\n 624 |     def _maybe_cast_slice_bound(self, label, side: str):\n 625 |         # GH#42855 handle date here instead of get_slice_bound\n 626 |         if isinstance(label, dt.date) and not isinstance(label, dt.datetime):\n 627 |             # Pandas supports slicing with dates, treated as datetimes at midnight.\n 628 |             # https://github.com/pandas-dev/pandas/issues/31501\n 629 |             label = Timestamp(label).to_pydatetime()\n 630 | \n 631 |         label = super()._maybe_cast_slice_bound(label, side)\n 632 |         self._data._assert_tzawareness_compat(label)\n 633 |         return Timestamp(label)\n 634 | \n 635 |     def slice_indexer(self, start=None, end=None, step=None):\n 636 |         \"\"\"\n 637 |         Return indexer for specified label slice.\n 638 |         Index.slice_indexer, customized to handle time slicing.\n 639 | \n 640 |         In addition to functionality provided by Index.slice_indexer, does the\n 641 |         following:\n 642 | \n 643 |         - if both `start` and `end` are instances of `datetime.time`, it\n 644 |           invokes `indexer_between_time`\n 645 |         - if `start` and `end` are both either string or None perform\n 646 |           value-based selection in non-monotonic cases.\n 647 | \n 648 |         \"\"\"\n 649 |         # For historical reasons DatetimeIndex supports slices between two\n 650 |         # instances of datetime.time as if it were applying a slice mask to\n 651 |         # an array of (self.hour, self.minute, self.seconds, self.microsecond).\n 652 |         if isinstance(start, dt.time) and isinstance(end, dt.time):\n 653 |             if step is not None and step != 1:\n 654 |                 raise ValueError(\"Must have step size of 1 with time slices\")\n 655 |             return self.indexer_between_time(start, end)\n 656 | \n 657 |         if isinstance(start, dt.time) or isinstance(end, dt.time):\n 658 |             raise KeyError(\"Cannot mix time and non-time slice keys\")\n 659 | \n 660 |         def check_str_or_none(point) -> bool:\n 661 |             return point is not None and not isinstance(point, str)\n 662 | \n 663 |         # GH#33146 if start and end are combinations of str and None and Index is not\n 664 |         # monotonic, we can not use Index.slice_indexer because it does not honor the\n 665 |         # actual elements, is only searching for start and end\n 666 |         if (\n 667 |             check_str_or_none(start)\n 668 |             or check_str_or_none(end)\n 669 |             or self.is_monotonic_increasing\n 670 |         ):\n 671 |             return Index.slice_indexer(self, start, end, step)\n 672 | \n 673 |         mask = np.array(True)\n 674 |         in_index = True\n 675 |         if start is not None:\n 676 |             start_casted = self._maybe_cast_slice_bound(start, \"left\")\n 677 |             mask = start_casted <= self\n 678 |             in_index &= (start_casted == self).any()\n 679 | \n 680 |         if end is not None:\n 681 |             end_casted = self._maybe_cast_slice_bound(end, \"right\")\n 682 |             mask = (self <= end_casted) & mask\n 683 |             in_index &= (end_casted == self).any()\n 684 | \n 685 |         if not in_index:\n 686 |             raise KeyError(\n 687 |                 \"Value based partial slicing on non-monotonic DatetimeIndexes \"\n 688 |                 \"with non-existing keys is not allowed.\",\n 689 |             )\n 690 |         indexer = mask.nonzero()[0][::step]\n 691 |         if len(indexer) == len(self):\n 692 |             return slice(None)\n 693 |         else:\n 694 |             return indexer\n 695 | \n 696 |     # --------------------------------------------------------------------\n 697 | \n 698 |     @property\n 699 |     def inferred_type(self) -> str:\n 700 |         # b/c datetime is represented as microseconds since the epoch, make\n 701 |         # sure we can't have ambiguous indexing\n 702 |         return \"datetime64\"\n 703 | \n 704 |     def indexer_at_time(self, time, asof: bool = False) -> npt.NDArray[np.intp]:\n 705 |         \"\"\"\n 706 |         Return index locations of values at particular time of day.\n 707 | \n 708 |         Parameters\n 709 |         ----------\n 710 |         time : datetime.time or str\n 711 |             Time passed in either as object (datetime.time) or as string in\n 712 |             appropriate format (\"%H:%M\", \"%H%M\", \"%I:%M%p\", \"%I%M%p\",\n 713 |             \"%H:%M:%S\", \"%H%M%S\", \"%I:%M:%S%p\", \"%I%M%S%p\").\n 714 |         asof : bool, default False\n 715 |             This parameter is currently not supported.\n 716 | \n 717 |         Returns\n 718 |         -------\n 719 |         np.ndarray[np.intp]\n 720 |             Index locations of values at given `time` of day.\n 721 | \n 722 |         See Also\n 723 |         --------\n 724 |         indexer_between_time : Get index locations of values between particular\n 725 |             times of day.\n 726 |         DataFrame.at_time : Select values at particular time of day.\n 727 | \n 728 |         Examples\n 729 |         --------\n 730 |         >>> idx = pd.DatetimeIndex(\n 731 |         ...     [\"1/1/2020 10:00\", \"2/1/2020 11:00\", \"3/1/2020 10:00\"]\n 732 |         ... )\n 733 |         >>> idx.indexer_at_time(\"10:00\")\n 734 |         array([0, 2])\n 735 |         \"\"\"\n 736 |         if asof:\n 737 |             raise NotImplementedError(\"'asof' argument is not supported\")\n 738 | \n 739 |         if isinstance(time, str):\n 740 |             from dateutil.parser import parse\n 741 | \n 742 |             time = parse(time).time()\n 743 | \n 744 |         if time.tzinfo:\n 745 |             if self.tz is None:\n 746 |                 raise ValueError(\"Index must be timezone aware.\")\n 747 |             time_micros = self.tz_convert(time.tzinfo)._get_time_micros()\n 748 |         else:\n 749 |             time_micros = self._get_time_micros()\n 750 |         micros = _time_to_micros(time)\n 751 |         return (time_micros == micros).nonzero()[0]\n 752 | \n 753 |     def indexer_between_time(\n 754 |         self, start_time, end_time, include_start: bool = True, include_end: bool = True\n 755 |     ) -> npt.NDArray[np.intp]:\n 756 |         \"\"\"\n 757 |         Return index locations of values between particular times of day.\n 758 | \n 759 |         Parameters\n 760 |         ----------\n 761 |         start_time, end_time : datetime.time, str\n 762 |             Time passed either as object (datetime.time) or as string in\n 763 |             appropriate format (\"%H:%M\", \"%H%M\", \"%I:%M%p\", \"%I%M%p\",\n 764 |             \"%H:%M:%S\", \"%H%M%S\", \"%I:%M:%S%p\",\"%I%M%S%p\").\n 765 |         include_start : bool, default True\n 766 |             Include boundaries; whether to set start bound as closed or open.\n 767 |         include_end : bool, default True\n 768 |             Include boundaries; whether to set end bound as closed or open.\n 769 | \n 770 |         Returns\n 771 |         -------\n 772 |         np.ndarray[np.intp]\n 773 |             Index locations of values between particular times of day.\n 774 | \n 775 |         See Also\n 776 |         --------\n 777 |         indexer_at_time : Get index locations of values at particular time of day.\n 778 |         DataFrame.between_time : Select values between particular times of day.\n 779 | \n 780 |         Examples\n 781 |         --------\n 782 |         >>> idx = pd.date_range(\"2023-01-01\", periods=4, freq=\"h\")\n 783 |         >>> idx\n 784 |         DatetimeIndex(['2023-01-01 00:00:00', '2023-01-01 01:00:00',\n 785 |                            '2023-01-01 02:00:00', '2023-01-01 03:00:00'],\n 786 |                           dtype='datetime64[ns]', freq='h')\n 787 |         >>> idx.indexer_between_time(\"00:00\", \"2:00\", include_end=False)\n 788 |         array([0, 1])\n 789 |         \"\"\"\n 790 |         start_time = to_time(start_time)\n 791 |         end_time = to_time(end_time)\n 792 |         time_micros = self._get_time_micros()\n 793 |         start_micros = _time_to_micros(start_time)\n 794 |         end_micros = _time_to_micros(end_time)\n 795 | \n 796 |         if include_start and include_end:\n 797 |             lop = rop = operator.le\n 798 |         elif include_start:\n 799 |             lop = operator.le\n 800 |             rop = operator.lt\n 801 |         elif include_end:\n 802 |             lop = operator.lt\n 803 |             rop = operator.le\n 804 |         else:\n 805 |             lop = rop = operator.lt\n 806 | \n 807 |         if start_time <= end_time:\n 808 |             join_op = operator.and_\n 809 |         else:\n 810 |             join_op = operator.or_\n 811 | \n 812 |         mask = join_op(lop(start_micros, time_micros), rop(time_micros, end_micros))\n 813 | \n 814 |         return mask.nonzero()[0]\n 815 | \n 816 | \n 817 | def date_range(\n 818 |     start=None,\n 819 |     end=None,\n 820 |     periods=None,\n 821 |     freq=None,\n 822 |     tz=None,\n 823 |     normalize: bool = False,\n 824 |     name: Hashable | None = None,\n 825 |     inclusive: IntervalClosedType = \"both\",\n 826 |     *,\n 827 |     unit: str | None = None,\n 828 |     **kwargs,\n 829 | ) -> DatetimeIndex:\n 830 |     \"\"\"\n 831 |     Return a fixed frequency DatetimeIndex.\n 832 | \n 833 |     Returns the range of equally spaced time points (where the difference between any\n 834 |     two adjacent points is specified by the given frequency) such that they fall in the\n 835 |     range `[start, end]` , where the first one and the last one are, resp., the first\n 836 |     and last time points in that range that fall on the boundary of ``freq`` (if given\n 837 |     as a frequency string) or that are valid for ``freq`` (if given as a\n 838 |     :class:`pandas.tseries.offsets.DateOffset`). If ``freq`` is positive, the points\n 839 |     satisfy `start <[=] x <[=] end`, and if ``freq`` is negative, the points satisfy\n 840 |     `end <[=] x <[=] start`. (If exactly one of ``start``, ``end``, or ``freq`` is *not*\n 841 |     specified, this missing parameter can be computed given ``periods``, the number of\n 842 |     timesteps in the range. See the note below.)\n 843 | \n 844 |     Parameters\n 845 |     ----------\n 846 |     start : str or datetime-like, optional\n 847 |         Left bound for generating dates.\n 848 |     end : str or datetime-like, optional\n 849 |         Right bound for generating dates.\n 850 |     periods : int, optional\n 851 |         Number of periods to generate.\n 852 |     freq : str, Timedelta, datetime.timedelta, or DateOffset, default 'D'\n 853 |         Frequency strings can have multiples, e.g. '5h'. See\n 854 |         :ref:`here <timeseries.offset_aliases>` for a list of\n 855 |         frequency aliases.\n 856 |     tz : str or tzinfo, optional\n 857 |         Time zone name for returning localized DatetimeIndex, for example\n 858 |         'Asia/Hong_Kong'. By default, the resulting DatetimeIndex is\n 859 |         timezone-naive unless timezone-aware datetime-likes are passed.\n 860 |     normalize : bool, default False\n 861 |         Normalize start/end dates to midnight before generating date range.\n 862 |     name : str, default None\n 863 |         Name of the resulting DatetimeIndex.\n 864 |     inclusive : {\"both\", \"neither\", \"left\", \"right\"}, default \"both\"\n 865 |         Include boundaries; Whether to set each bound as closed or open.\n 866 | \n 867 |         .. versionadded:: 1.4.0\n 868 |     unit : str, default None\n 869 |         Specify the desired resolution of the result.\n 870 | \n 871 |         .. versionadded:: 2.0.0\n 872 |     **kwargs\n 873 |         For compatibility. Has no effect on the result.\n 874 | \n 875 |     Returns\n 876 |     -------\n 877 |     DatetimeIndex\n 878 |         A DatetimeIndex object of the generated dates.\n 879 | \n 880 |     See Also\n 881 |     --------\n 882 |     DatetimeIndex : An immutable container for datetimes.\n 883 |     timedelta_range : Return a fixed frequency TimedeltaIndex.\n 884 |     period_range : Return a fixed frequency PeriodIndex.\n 885 |     interval_range : Return a fixed frequency IntervalIndex.\n 886 | \n 887 |     Notes\n 888 |     -----\n 889 |     Of the four parameters ``start``, ``end``, ``periods``, and ``freq``,\n 890 |     exactly three must be specified. If ``freq`` is omitted, the resulting\n 891 |     ``DatetimeIndex`` will have ``periods`` linearly spaced elements between\n 892 |     ``start`` and ``end`` (closed on both sides).\n 893 | \n 894 |     To learn more about the frequency strings, please see\n 895 |     :ref:`this link<timeseries.offset_aliases>`.\n 896 | \n 897 |     Examples\n 898 |     --------\n 899 |     **Specifying the values**\n 900 | \n 901 |     The next four examples generate the same `DatetimeIndex`, but vary\n 902 |     the combination of `start`, `end` and `periods`.\n 903 | \n 904 |     Specify `start` and `end`, with the default daily frequency.\n 905 | \n 906 |     >>> pd.date_range(start=\"1/1/2018\", end=\"1/08/2018\")\n 907 |     DatetimeIndex(['2018-01-01', '2018-01-02', '2018-01-03', '2018-01-04',\n 908 |                    '2018-01-05', '2018-01-06', '2018-01-07', '2018-01-08'],\n 909 |                   dtype='datetime64[ns]', freq='D')\n 910 | \n 911 |     Specify timezone-aware `start` and `end`, with the default daily frequency.\n 912 | \n 913 |     >>> pd.date_range(\n 914 |     ...     start=pd.to_datetime(\"1/1/2018\").tz_localize(\"Europe/Berlin\"),\n 915 |     ...     end=pd.to_datetime(\"1/08/2018\").tz_localize(\"Europe/Berlin\"),\n 916 |     ... )\n 917 |     DatetimeIndex(['2018-01-01 00:00:00+01:00', '2018-01-02 00:00:00+01:00',\n 918 |                    '2018-01-03 00:00:00+01:00', '2018-01-04 00:00:00+01:00',\n 919 |                    '2018-01-05 00:00:00+01:00', '2018-01-06 00:00:00+01:00',\n 920 |                    '2018-01-07 00:00:00+01:00', '2018-01-08 00:00:00+01:00'],\n 921 |                   dtype='datetime64[ns, Europe/Berlin]', freq='D')\n 922 | \n 923 |     Specify `start` and `periods`, the number of periods (days).\n 924 | \n 925 |     >>> pd.date_range(start=\"1/1/2018\", periods=8)\n 926 |     DatetimeIndex(['2018-01-01', '2018-01-02', '2018-01-03', '2018-01-04',\n 927 |                    '2018-01-05', '2018-01-06', '2018-01-07', '2018-01-08'],\n 928 |                   dtype='datetime64[ns]', freq='D')\n 929 | \n 930 |     Specify `end` and `periods`, the number of periods (days).\n 931 | \n 932 |     >>> pd.date_range(end=\"1/1/2018\", periods=8)\n 933 |     DatetimeIndex(['2017-12-25', '2017-12-26', '2017-12-27', '2017-12-28',\n 934 |                    '2017-12-29', '2017-12-30', '2017-12-31', '2018-01-01'],\n 935 |                   dtype='datetime64[ns]', freq='D')\n 936 | \n 937 |     Specify `start`, `end`, and `periods`; the frequency is generated\n 938 |     automatically (linearly spaced).\n 939 | \n 940 |     >>> pd.date_range(start=\"2018-04-24\", end=\"2018-04-27\", periods=3)\n 941 |     DatetimeIndex(['2018-04-24 00:00:00', '2018-04-25 12:00:00',\n 942 |                    '2018-04-27 00:00:00'],\n 943 |                   dtype='datetime64[ns]', freq=None)\n 944 | \n 945 |     **Other Parameters**\n 946 | \n 947 |     Changed the `freq` (frequency) to ``'ME'`` (month end frequency).\n 948 | \n 949 |     >>> pd.date_range(start=\"1/1/2018\", periods=5, freq=\"ME\")\n 950 |     DatetimeIndex(['2018-01-31', '2018-02-28', '2018-03-31', '2018-04-30',\n 951 |                    '2018-05-31'],\n 952 |                   dtype='datetime64[ns]', freq='ME')\n 953 | \n 954 |     Multiples are allowed\n 955 | \n 956 |     >>> pd.date_range(start=\"1/1/2018\", periods=5, freq=\"3ME\")\n 957 |     DatetimeIndex(['2018-01-31', '2018-04-30', '2018-07-31', '2018-10-31',\n 958 |                    '2019-01-31'],\n 959 |                   dtype='datetime64[ns]', freq='3ME')\n 960 | \n 961 |     `freq` can also be specified as an Offset object.\n 962 | \n 963 |     >>> pd.date_range(start=\"1/1/2018\", periods=5, freq=pd.offsets.MonthEnd(3))\n 964 |     DatetimeIndex(['2018-01-31', '2018-04-30', '2018-07-31', '2018-10-31',\n 965 |                    '2019-01-31'],\n 966 |                   dtype='datetime64[ns]', freq='3ME')\n 967 | \n 968 |     Specify `tz` to set the timezone.\n 969 | \n 970 |     >>> pd.date_range(start=\"1/1/2018\", periods=5, tz=\"Asia/Tokyo\")\n 971 |     DatetimeIndex(['2018-01-01 00:00:00+09:00', '2018-01-02 00:00:00+09:00',\n 972 |                    '2018-01-03 00:00:00+09:00', '2018-01-04 00:00:00+09:00',\n 973 |                    '2018-01-05 00:00:00+09:00'],\n 974 |                   dtype='datetime64[ns, Asia/Tokyo]', freq='D')\n 975 | \n 976 |     `inclusive` controls whether to include `start` and `end` that are on the\n 977 |     boundary. The default, \"both\", includes boundary points on either end.\n 978 | \n 979 |     >>> pd.date_range(start=\"2017-01-01\", end=\"2017-01-04\", inclusive=\"both\")\n 980 |     DatetimeIndex(['2017-01-01', '2017-01-02', '2017-01-03', '2017-01-04'],\n 981 |                   dtype='datetime64[ns]', freq='D')\n 982 | \n 983 |     Use ``inclusive='left'`` to exclude `end` if it falls on the boundary.\n 984 | \n 985 |     >>> pd.date_range(start=\"2017-01-01\", end=\"2017-01-04\", inclusive=\"left\")\n 986 |     DatetimeIndex(['2017-01-01', '2017-01-02', '2017-01-03'],\n 987 |                   dtype='datetime64[ns]', freq='D')\n 988 | \n 989 |     Use ``inclusive='right'`` to exclude `start` if it falls on the boundary, and\n 990 |     similarly ``inclusive='neither'`` will exclude both `start` and `end`.\n 991 | \n 992 |     >>> pd.date_range(start=\"2017-01-01\", end=\"2017-01-04\", inclusive=\"right\")\n 993 |     DatetimeIndex(['2017-01-02', '2017-01-03', '2017-01-04'],\n 994 |                   dtype='datetime64[ns]', freq='D')\n 995 | \n 996 |     **Specify a unit**\n 997 | \n 998 |     >>> pd.date_range(start=\"2017-01-01\", periods=10, freq=\"100YS\", unit=\"s\")\n 999 |     DatetimeIndex(['2017-01-01', '2117-01-01', '2217-01-01', '2317-01-01',\n1000 |                    '2417-01-01', '2517-01-01', '2617-01-01', '2717-01-01',\n1001 |                    '2817-01-01', '2917-01-01'],\n1002 |                   dtype='datetime64[s]', freq='100YS-JAN')\n1003 |     \"\"\"\n1004 |     if freq is None and com.any_none(periods, start, end):\n1005 |         freq = \"D\"\n1006 | \n1007 |     dtarr = DatetimeArray._generate_range(\n1008 |         start=start,\n1009 |         end=end,\n1010 |         periods=periods,\n1011 |         freq=freq,\n1012 |         tz=tz,\n1013 |         normalize=normalize,\n1014 |         inclusive=inclusive,\n1015 |         unit=unit,\n1016 |         **kwargs,\n1017 |     )\n1018 |     return DatetimeIndex._simple_new(dtarr, name=name)\n1019 | \n1020 | \n1021 | def bdate_range(\n1022 |     start=None,\n1023 |     end=None,\n1024 |     periods: int | None = None,\n1025 |     freq: Frequency | dt.timedelta = \"B\",\n1026 |     tz=None,\n1027 |     normalize: bool = True,\n1028 |     name: Hashable | None = None,\n1029 |     weekmask=None,\n1030 |     holidays=None,\n1031 |     inclusive: IntervalClosedType = \"both\",\n1032 |     **kwargs,\n1033 | ) -> DatetimeIndex:\n1034 |     \"\"\"\n1035 |     Return a fixed frequency DatetimeIndex with business day as the default.\n1036 | \n1037 |     Parameters\n1038 |     ----------\n1039 |     start : str or datetime-like, default None\n1040 |         Left bound for generating dates.\n1041 |     end : str or datetime-like, default None\n1042 |         Right bound for generating dates.\n1043 |     periods : int, default None\n1044 |         Number of periods to generate.\n1045 |     freq : str, Timedelta, datetime.timedelta, or DateOffset, default 'B'\n1046 |         Frequency strings can have multiples, e.g. '5h'. The default is\n1047 |         business daily ('B').\n1048 |     tz : str or None\n1049 |         Time zone name for returning localized DatetimeIndex, for example\n1050 |         Asia/Beijing.\n1051 |     normalize : bool, default False\n1052 |         Normalize start/end dates to midnight before generating date range.\n1053 |     name : str, default None\n1054 |         Name of the resulting DatetimeIndex.\n1055 |     weekmask : str or None, default None\n1056 |         Weekmask of valid business days, passed to ``numpy.busdaycalendar``,\n1057 |         only used when custom frequency strings are passed.  The default\n1058 |         value None is equivalent to 'Mon Tue Wed Thu Fri'.\n1059 |     holidays : list-like or None, default None\n1060 |         Dates to exclude from the set of valid business days, passed to\n1061 |         ``numpy.busdaycalendar``, only used when custom frequency strings\n1062 |         are passed.\n1063 |     inclusive : {\"both\", \"neither\", \"left\", \"right\"}, default \"both\"\n1064 |         Include boundaries; Whether to set each bound as closed or open.\n1065 | \n1066 |         .. versionadded:: 1.4.0\n1067 |     **kwargs\n1068 |         For compatibility. Has no effect on the result.\n1069 | \n1070 |     Returns\n1071 |     -------\n1072 |     DatetimeIndex\n1073 |         Fixed frequency DatetimeIndex.\n1074 | \n1075 |     See Also\n1076 |     --------\n1077 |     date_range : Return a fixed frequency DatetimeIndex.\n1078 |     period_range : Return a fixed frequency PeriodIndex.\n1079 |     timedelta_range : Return a fixed frequency TimedeltaIndex.\n1080 | \n1081 |     Notes\n1082 |     -----\n1083 |     Of the four parameters: ``start``, ``end``, ``periods``, and ``freq``,\n1084 |     exactly three must be specified.  Specifying ``freq`` is a requirement\n1085 |     for ``bdate_range``.  Use ``date_range`` if specifying ``freq`` is not\n1086 |     desired.\n1087 | \n1088 |     To learn more about the frequency strings, please see\n1089 |     :ref:`this link<timeseries.offset_aliases>`.\n1090 | \n1091 |     Examples\n1092 |     --------\n1093 |     Note how the two weekend days are skipped in the result.\n1094 | \n1095 |     >>> pd.bdate_range(start=\"1/1/2018\", end=\"1/08/2018\")\n1096 |     DatetimeIndex(['2018-01-01', '2018-01-02', '2018-01-03', '2018-01-04',\n1097 |                '2018-01-05', '2018-01-08'],\n1098 |               dtype='datetime64[ns]', freq='B')\n1099 |     \"\"\"\n1100 |     if freq is None:\n1101 |         msg = \"freq must be specified for bdate_range; use date_range instead\"\n1102 |         raise TypeError(msg)\n1103 | \n1104 |     if isinstance(freq, str) and freq.startswith(\"C\"):\n1105 |         try:\n1106 |             weekmask = weekmask or \"Mon Tue Wed Thu Fri\"\n1107 |             freq = prefix_mapping[freq](holidays=holidays, weekmask=weekmask)\n1108 |         except (KeyError, TypeError) as err:\n1109 |             msg = f\"invalid custom frequency string: {freq}\"\n1110 |             raise ValueError(msg) from err\n1111 |     elif holidays or weekmask:\n1112 |         msg = (\n1113 |             \"a custom frequency string is required when holidays or \"\n1114 |             f\"weekmask are passed, got frequency {freq}\"\n1115 |         )\n1116 |         raise ValueError(msg)\n1117 | \n1118 |     return date_range(\n1119 |         start=start,\n1120 |         end=end,\n1121 |         periods=periods,\n1122 |         freq=freq,\n1123 |         tz=tz,\n1124 |         normalize=normalize,\n1125 |         name=name,\n1126 |         inclusive=inclusive,\n1127 |         **kwargs,\n1128 |     )\n1129 | \n1130 | \n1131 | def _time_to_micros(time_obj: dt.time) -> int:\n1132 |     seconds = time_obj.hour * 60 * 60 + 60 * time_obj.minute + time_obj.second\n1133 |     return 1_000_000 * seconds + time_obj.microsecond\n1134 | \n```\n"}, {"content": "Based on my analysis, I can now provide the locations that need modification to implement the suggested feature:\n\n```\npandas/core/series.py\nline: 2481-2486\nfunction: Series.round\nclass: N/A\n\npandas/core/arrays/datetimelike.py\nline: 2183-2189\nclass: TimelikeOps\nfunction: round\n\npandas/core/accessor.py\nline: 146-194\nfunction: delegate_names\nfunction: _register_accessor\n\npandas/core/indexes/datetimes.py\nline: 246-2487\nclass: DatetimeIndex\nfunction: round\n```\n\nThese locations are critical for implementing the requested feature because:\n\n1. The main `Series.round()` implementation in pandas/core/series.py is where the docstring needs to be updated to include the `Series.dt.round` reference in the \"See also\" section.\n\n2. The `TimelikeOps.round()` implementation in pandas/core/arrays/datetimelike.py shows how the date-related rounding operations are implemented and would be relevant for understanding the documentation needs.\n\n3. The `delegate_names` and `_register_accessor` functions in pandas/core/accessor.py show how accessor properties are added to pandas objects, which helps understand how the dt accessor group is organized.\n\n4. The existing DatetimeIndex.round implementation in pandas/core/indexes/datetimes.py provides insight into the existing documentation structure and patterns for similar time-related methods.\n\nThe issue requests adding a reference to `Series.dt.round` in the \"See also\" section of the Series.round documentation, which these locations help confirm exists as the correct place to update. The implementation should follow the existing pattern where related time-related operations are grouped together.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 142651, "completion_tokens": 622}, "time": 128.87698793411255}]}}
