and int16 columns\n526 |     are checked for violations of the value restrictions and upcast if needed.\n527 |     int64 data is not usable in Stata, and so it is downcast to int32 whenever\n528 |     the value are in the int32 range, and sidecast to float64 when larger than\n529 |     this range.  If the int64 values are outside of the range of those\n530 |     perfectly representable as float64 values, a warning is raised.\n531 | \n532 |     bool columns are cast to int8.  uint columns are converted to int of the\n533 |     same size if there is no loss in precision, otherwise are upcast to a\n534 |     larger type.  uint64 is currently not supported since it is concerted to\n535 |     object in a DataFrame.\n536 |     \"\"\"\n537 |     ws = \"\"\n538 |     # original, if small, if large\n539 |     conversion_data: tuple[\n540 |         tuple[type, type, type],\n541 |         tuple[type, type, type],\n542 |         tuple[type, type, type],\n543 |         tuple[type, type, type],\n544 |         tuple[type, type, type],\n545 |     ] = (\n546 |         (np.bool_, np.int8, np.int8),\n547 |         (np.uint8, np.int8, np.int16),\n548 |         (np.uint16, np.int16, np.int32),\n549 |         (np.uint32, np.int32, np.int64),\n550 |         (np.uint64, np.int64, np.float64),\n551 |     )\n552 | \n553 |     float32_max = struct.unpack(\"<f\", b\"\\xff\\xff\\xff\\x7e\")[0]\n554 |     float64_max = struct.unpack(\"<d\", b\"\\xff\\xff\\xff\\xff\\xff\\xff\\xdf\\x7f\")[0]\n555 | \n556 |     for col in data:\n557 |         # Cast from unsupported types to supported types\n558 |         is_nullable_int = (\n559 |             isinstance(data[col].dtype, ExtensionDtype)\n560 |             and data[col].dtype.kind in \"iub\"\n561 |         )\n562 |         # We need to find orig_missing before altering data below\n563 |         orig_missing = data[col].isna()\n564 |         if is_nullable_int:\n565 |             fv = 0 if data[col].dtype.kind in \"iu\" else False\n566 |             