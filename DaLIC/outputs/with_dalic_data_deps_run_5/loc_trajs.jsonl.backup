ce, None, None\n  87 | \n  88 | \n  89 | def _check_array_api_dispatch(array_api_dispatch):\n  90 |     \"\"\"Check that array_api_compat is installed and NumPy version is compatible.\n  91 | \n  92 |     array_api_compat follows NEP29, which has a higher minimum NumPy version than\n  93 |     scikit-learn.\n  94 |     \"\"\"\n  95 |     if array_api_dispatch:\n  96 |         try:\n  97 |             import array_api_compat  # noqa\n  98 |         except ImportError:\n  99 |             raise ImportError(\n 100 |                 \"array_api_compat is required to dispatch arrays using the API\"\n 101 |                 \" specification\"\n 102 |             )\n 103 | \n 104 |         numpy_version = parse_version(numpy.__version__)\n 105 |         min_numpy_version = \"1.21\"\n 106 |         if numpy_version < parse_version(min_numpy_version):\n 107 |             raise ImportError(\n 108 |                 f\"NumPy must be {min_numpy_version} or newer (found\"\n 109 |                 f\" {numpy.__version__}) to dispatch array using\"\n 110 |                 \" the array API specification\"\n 111 |             )\n 112 | \n 113 |         scipy_version = parse_version(scipy.__version__)\n 114 |         min_scipy_version = \"1.14.0\"\n 115 |         if scipy_version < parse_version(min_scipy_version):\n 116 |             raise ImportError(\n 117 |                 f\"SciPy must be {min_scipy_version} or newer\"\n 118 |                 \" (found {scipy.__version__}) to dispatch array using\"\n 119 |                 \" the array API specification\"\n 120 |             )\n 121 | \n 122 |         if os.environ.get(\"SCIPY_ARRAY_API\") != \"1\":\n 123 |             raise RuntimeError(\n 124 |                 \"Scikit-learn array API support was enabled but scipy's own support is \"\n 125 |                 \"not enabled. Please set the SCIPY_ARRAY_API=1 environment variable \"\n 126 |                 \"before importing sklearn or scipy. More details at: \"\n 127 |                 \"https://docs.scipy.org/doc/scipy/dev/api-dev/array_api.html\"\n 128 |             )\n 129 | \n 130 | \n 131 | def _single_array_device(array):\n 132 |     \"\"\"Hardware device where the array data resides on.\"\"\"\n 133 |     if isinstance(array, (numpy.ndarray, numpy.generic)) or not hasattr(\n 134 |         array, \"device\"\n 135 |     ):\n 136 |         return \"cpu\"\n 137 |     else:\n 138 |         return array.device\n 139 | \n 140 | \n 141 | def device(*array_list, remove_none=True, remove_types=(str,)):\n 142 |     \"\"\"Hardware device where the array data resides on.\n 143 | \n 144 |     If the hardware device is not the same for all arrays, an error is raised.\n 145 | \n 146 |     Parameters\n 147 |     ----------\n 148 |     *array_list : arrays\n 149 |         List of array instances from NumPy or an array API compatible library.\n 150 | \n 151 |     remove_none : bool, default=True\n 152 |         Whether to ignore None objects passed in array_list.\n 153 | \n 154 |     remove_types : tuple or list, default=(str,)\n 155 |         Types to ignore in array_list.\n 156 | \n 157 |     Returns\n 158 |     -------\n 159 |     out : device\n 160 |         `device` object (see the \"Device Support\" section of the array API spec).\n 161 |     \"\"\"\n 162 |     array_list = _remove_non_arrays(\n 163 |         *array_list, remove_none=remove_none, remove_types=remove_types\n 164 |     )\n 165 | \n 166 |     if not array_list:\n 167 |         return None\n 168 | \n 169 |     device_ = _single_array_device(array_list[0])\n 170 | \n 171 |     # Note: here we cannot simply use a Python `set` as it requires\n 172 |     # hashable members which is not guaranteed for Array API device\n 173 |     # objects. In particular, CuPy devices are not hashable at the\n 174 |     # time of writing.\n 175 |     for array in array_list[1:]:\n 176 |         device_other = _single_array_device(array)\n 177 |         if device_ != device_other:\n 178 |             raise ValueError(\n 179 |                 f\"Input arrays use different devices: {str(device_)}, \"\n 180 |                 f\"{str(device_other)}\"\n 181 |             )\n 182 | \n 183 |     return device_\n 184 | \n 185 | \n 186 | def size(x):\n 187 |     \"\"\"Return the total number of elements of x.\n 188 | \n 189 |     Parameters\n 190 |     ----------\n 191 |     x : array\n 192 |         Array instance from NumPy or an array API compatible library.\n 193 | \n 194 |     Returns\n 195 |     -------\n 196 |     out : int\n 197 |         Total number of elements.\n 198 |     \"\"\"\n 199 |     return math.prod(x.shape)\n 200 | \n 201 | \n 202 | def _is_numpy_namespace(xp):\n 203 |     \"\"\"Return True if xp is backed by NumPy.\"\"\"\n 204 |     return xp.__name__ in _NUMPY_NAMESPACE_NAMES\n 205 | \n 206 | \n 207 | def _union1d(a, b, xp):\n 208 |     if _is_numpy_namespace(xp):\n 209 |         # avoid circular import\n 210 |         from ._unique import cached_unique\n 211 | \n 212 |         a_unique, b_unique = cached_unique(a, b, xp=xp)\n 213 |         return xp.asarray(numpy.union1d(a_unique, b_unique))\n 214 |     assert a.ndim == b.ndim == 1\n 215 |     return xp.unique_values(xp.concat([xp.unique_values(a), xp.unique_values(b)]))\n 216 | \n 217 | \n 218 | def isdtype(dtype, kind, *, xp):\n 219 |     \"\"\"Returns a boolean indicating whether a provided dtype is of type \"kind\".\n 220 | \n 221 |     Included in the v2022.12 of the Array API spec.\n 222 |     https://data-apis.org/array-api/latest/API_specification/generated/array_api.isdtype.html\n 223 |     \"\"\"\n 224 |     if isinstance(kind, tuple):\n 225 |         return any(_isdtype_single(dtype, k, xp=xp) for k in kind)\n 226 |     else:\n 227 |         return _isdtype_single(dtype, kind, xp=xp)\n 228 | \n 229 | \n 230 | def _isdtype_single(dtype, kind, *, xp):\n 231 |     if isinstance(kind, str):\n 232 |         if kind == \"bool\":\n 233 |             return dtype == xp.bool\n 234 |         elif kind == \"signed integer\":\n 235 |             return dtype in {xp.int8, xp.int16, xp.int32, xp.int64}\n 236 |         elif kind == \"unsigned integer\":\n 237 |             return dtype in {xp.uint8, xp.uint16, xp.uint32, xp.uint64}\n 238 |         elif kind == \"integral\":\n 239 |             return any(\n 240 |                 _isdtype_single(dtype, k, xp=xp)\n 241 |                 for k in (\"signed integer\", \"unsigned integer\")\n 242 |             )\n 243 |         elif kind == \"real floating\":\n 244 |             return dtype in supported_float_dtypes(xp)\n 245 |         elif kind == \"complex floating\":\n 246 |             # Some name spaces might not have support for complex dtypes.\n 247 |             complex_dtypes = set()\n 248 |             if hasattr(xp, \"complex64\"):\n 249 |                 complex_dtypes.add(xp.complex64)\n 250 |             if hasattr(xp, \"complex128\"):\n 251 |                 complex_dtypes.add(xp.complex128)\n 252 |             return dtype in complex_dtypes\n 253 |         elif kind == \"numeric\":\n 254 |             return any(\n 255 |                 _isdtype_single(dtype, k, xp=xp)\n 256 |                 for k in (\"integral\", \"real floating\", \"complex floating\")\n 257 |             )\n 258 |         else:\n 259 |             raise ValueError(f\"Unrecognized data type kind: {kind!r}\")\n 260 |     else:\n 261 |         return dtype == kind\n 262 | \n 263 | \n 264 | def supported_float_dtypes(xp):\n 265 |     \"\"\"Supported floating point types for the namespace.\n 266 | \n 267 |     Note: float16 is not officially part of the Array API spec at the\n 268 |     time of writing but scikit-learn estimators and functions can choose\n 269 |     to accept it when xp.float16 is defined.\n 270 | \n 271 |     https://data-apis.org/array-api/latest/API_specification/data_types.html\n 272 |     \"\"\"\n 273 |     if hasattr(xp, \"float16\"):\n 274 |         return (xp.float64, xp.float32, xp.float16)\n 275 |     else:\n 276 |         return (xp.float64, xp.float32)\n 277 | \n 278 | \n 279 | def ensure_common_namespace_device(reference, *arrays):\n 280 |     \"\"\"Ensure that all arrays use the same namespace and device as reference.\n 281 | \n 282 |     If necessary the arrays are moved to the same namespace and device as\n 283 |     the reference array.\n 284 | \n 285 |     Parameters\n 286 |     ----------\n 287 |     reference : array\n 288 |         Reference array.\n 289 | \n 290 |     *arrays : array\n 291 |         Arrays to check.\n 292 | \n 293 |     Returns\n 294 |     -------\n 295 |     arrays : list\n 296 |         Arrays with the same namespace and device as reference.\n 297 |     \"\"\"\n 298 |     xp, is_array_api = get_namespace(reference)\n 299 | \n 300 |     if is_array_api:\n 301 |         device_ = device(reference)\n 302 |         # Move arrays to the same namespace and device as the reference array.\n 303 |         return [xp.asarray(a, device=device_) for a in arrays]\n 304 |     else:\n 305 |         return arrays\n 306 | \n 307 | \n 308 | def _check_device_cpu(device):  # noqa\n 309 |     if device not in {\"cpu\", None}:\n 310 |         raise ValueError(f\"Unsupported device for NumPy: {device!r}\")\n 311 | \n 312 | \n 313 | def _accept_device_cpu(func):\n 314 |     @wraps(func)\n 315 |     def wrapped_func(*args, **kwargs):\n 316 |         _check_device_cpu(kwargs.pop(\"device\", None))\n 317 |         return func(*args, **kwargs)\n 318 | \n 319 |     return wrapped_func\n 320 | \n 321 | \n 322 | class _NumPyAPIWrapper:\n 323 |     \"\"\"Array API compat wrapper for any numpy version\n 324 | \n 325 |     NumPy < 2 does not implement the namespace. NumPy 2 and later should\n 326 |     progressively implement more an more of the latest Array API spec but this\n 327 |     is still work in progress at this time.\n 328 | \n 329 |     This wrapper makes it possible to write code that uses the standard Array\n 330 |     API while working with any version of NumPy supported by scikit-learn.\n 331 | \n 332 |     See the `get_namespace()` public function for more details.\n 333 |     \"\"\"\n 334 | \n 335 |     # TODO: once scikit-learn drops support for NumPy < 2, this class can be\n 336 |     # removed, assuming Array API compliance of NumPy 2 is actually sufficient\n 337 |     # for scikit-learn's needs.\n 338 | \n 339 |     # Creation functions in spec:\n 340 |     # https://data-apis.org/array-api/latest/API_specification/creation_functions.html\n 341 |     _CREATION_FUNCS = {\n 342 |         \"arange\",\n 343 |         \"empty\",\n 344 |         \"empty_like\",\n 345 |         \"eye\",\n 346 |         \"full\",\n 347 |         \"full_like\",\n 348 |         \"linspace\",\n 349 |         \"ones\",\n 350 |         \"ones_like\",\n 351 |         \"zeros\",\n 352 |         \"zeros_like\",\n 353 |     }\n 354 |     # Data types in spec\n 355 |     # https://data-apis.org/array-api/latest/API_specification/data_types.html\n 356 |     _DTYPES = {\n 357 |         \"int8\",\n 358 |         \"int16\",\n 359 |         \"int32\",\n 360 |         \"int64\",\n 361 |         \"uint8\",\n 362 |         \"uint16\",\n 363 |         \"uint32\",\n 364 |         \"uint64\",\n 365 |         # XXX: float16 is not part of the Array API spec but exposed by\n 366 |         # some namespaces.\n 367 |         \"float16\",\n 368 |         \"float32\",\n 369 |         \"float64\",\n 370 |         \"complex64\",\n 371 |         \"complex128\",\n 372 |     }\n 373 | \n 374 |     def __getattr__(self, name):\n 375 |         attr = getattr(numpy, name)\n 376 | \n 377 |         # Support device kwargs and make sure they are on the CPU\n 378 |         if name in self._CREATION_FUNCS:\n 379 |             return _accept_device_cpu(attr)\n 380 | \n 381 |         # Convert to dtype objects\n 382 |         if name in self._DTYPES:\n 383 |             return numpy.dtype(attr)\n 384 |         return attr\n 385 | \n 386 |     @property\n 387 |     def bool(self):\n 388 |         return numpy.bool_\n 389 | \n 390 |     def astype(self, x, dtype, *, copy=True, casting=\"unsafe\"):\n 391 |         # astype is not defined in the top level NumPy namespace\n 392 |         return x.astype(dtype, copy=copy, casting=casting)\n 393 | \n 394 |     def asarray(self, x, *, dtype=None, device=None, copy=None):  # noqa\n 395 |         _check_device_cpu(device)\n 396 |         # Support copy in NumPy namespace\n 397 |         if copy is True:\n 398 |             return numpy.array(x, copy=True, dtype=dtype)\n 399 |         else:\n 400 |             return numpy.asarray(x, dtype=dtype)\n 401 | \n 402 |     def unique_inverse(self, x):\n 403 |         return numpy.unique(x, return_inverse=True)\n 404 | \n 405 |     def unique_counts(self, x):\n 406 |         return numpy.unique(x, return_counts=True)\n 407 | \n 408 |     def unique_values(self, x):\n 409 |         return numpy.unique(x)\n 410 | \n 411 |     def unique_all(self, x):\n 412 |         return numpy.unique(\n 413 |             x, return_index=True, return_inverse=True, return_counts=True\n 414 |         )\n 415 | \n 416 |     def concat(self, arrays, *, axis=None):\n 417 |         return numpy.concatenate(arrays, axis=axis)\n 418 | \n 419 |     def reshape(self, x, shape, *, copy=None):\n 420 |         \"\"\"Gives a new shape to an array without changing its data.\n 421 | \n 422 |         The Array API specification requires shape to be a tuple.\n 423 |         https://data-apis.org/array-api/latest/API_specification/generated/array_api.reshape.html\n 424 |         \"\"\"\n 425 |         if not isinstance(shape, tuple):\n 426 |             raise TypeError(\n 427 |                 f\"shape must be a tuple, got {shape!r} of type {type(shape)}\"\n 428 |             )\n 429 | \n 430 |         if copy is True:\n 431 |             x = x.copy()\n 432 |         return numpy.reshape(x, shape)\n 433 | \n 434 |     def isdtype(self, dtype, kind):\n 435 |         try:\n 436 |             return isdtype(dtype, kind, xp=self)\n 437 |         except TypeError:\n 438 |             # In older versions of numpy, data types that arise from outside\n 439 |             # numpy like from a Polars Series raise a TypeError.\n 440 |             # e.g. TypeError: Cannot interpret 'Int64' as a data type.\n 441 |             # Therefore, we return False.\n 442 |             # TODO: Remove when minimum supported version of numpy is >= 1.21.\n 443 |             return False\n 444 | \n 445 |     def pow(self, x1, x2):\n 446 |         return numpy.power(x1, x2)\n 447 | \n 448 | \n 449 | _NUMPY_API_WRAPPER_INSTANCE = _NumPyAPIWrapper()\n 450 | \n 451 | \n 452 | def _remove_non_arrays(*arrays, remove_none=True, remove_types=(str,)):\n 453 |     \"\"\"Filter arrays to exclude None and/or specific types.\n 454 | \n 455 |     Raise ValueError if no arrays are left after filtering.\n 456 | \n 457 |     Sparse arrays are always filtered out.\n 458 | \n 459 |     Parameters\n 460 |     ----------\n 461 |     *arrays : array objects\n 462 |         Array objects.\n 463 | \n 464 |     remove_none : bool, default=True\n 465 |         Whether to ignore None objects passed in arrays.\n 466 | \n 467 |     remove_types : tuple or list, default=(str,)\n 468 |         Types to ignore in the arrays.\n 469 | \n 470 |     Returns\n 471 |     -------\n 472 |     filtered_arrays : list\n 473 |         List of arrays filtered as requested. An empty list is returned if no input\n 474 |         passes the filters.\n 475 |     \"\"\"\n 476 |     filtered_arrays = []\n 477 |     remove_types = tuple(remove_types)\n 478 |     for array in arrays:\n 479 |         if remove_none and array is None:\n 480 |             continue\n 481 |         if isinstance(array, remove_types):\n 482 |             continue\n 483 |         if sp.issparse(array):\n 484 |             continue\n 485 |         filtered_arrays.append(array)\n 486 | \n 487 |     return filtered_arrays\n 488 | \n 489 | \n 490 | def get_namespace(*arrays, remove_none=True, remove_types=(str,), xp=None):\n 491 |     \"\"\"Get namespace of arrays.\n 492 | \n 493 |     Introspect `arrays` arguments and return their common Array API compatible\n 494 |     namespace object, if any.\n 495 | \n 496 |     Note that sparse arrays are filtered by default.\n 497 | \n 498 |     See: https://numpy.org/neps/nep-0047-array-api-standard.html\n 499 | \n 500 |     If `arrays` are regular numpy arrays, an instance of the `_NumPyAPIWrapper`\n 501 |     compatibility wrapper is returned instead.\n 502 | \n 503 |     Namespace support is not enabled by default. To enabled it call:\n 504 | \n 505 |       sklearn.set_config(array_api_dispatch=True)\n 506 | \n 507 |     or:\n 508 | \n 509 |       with sklearn.config_context(array_api_dispatch=True):\n 510 |           # your code here\n 511 | \n 512 |     Otherwise an instance of the `_NumPyAPIWrapper` compatibility wrapper is\n 513 |     always returned irrespective of the fact that arrays implement the\n 514 |     `__array_namespace__` protocol or not.\n 515 | \n 516 |     Note that if no arrays pass the set filters, ``_NUMPY_API_WRAPPER_INSTANCE, False``\n 517 |     is returned.\n 518 | \n 519 |     Parameters\n 520 |     ----------\n 521 |     *arrays : array objects\n 522 |         Array objects.\n 523 | \n 524 |     remove_none : bool, default=True\n 525 |         Whether to ignore None objects passed in arrays.\n 526 | \n 527 |     remove_types : tuple or list, default=(str,)\n 528 |         Types to ignore in the arrays.\n 529 | \n 530 |     xp : module, default=None\n 531 |         Precomputed array namespace module. When passed, typically from a caller\n 532 |         that has already performed inspection of its own inputs, skips array\n 533 |         namespace inspection.\n 534 | \n 535 |     Returns\n 536 |     -------\n 537 |     namespace : module\n 538 |         Namespace shared by array objects. If any of the `arrays` are not arrays,\n 539 |         the namespace defaults to NumPy.\n 540 | \n 541 |     is_array_api_compliant : bool\n 542 |         True if the arrays are containers that implement the Array API spec.\n 543 |         Always False when array_api_dispatch=False.\n 544 |     \"\"\"\n 545 |     array_api_dispatch = get_config()[\"array_api_dispatch\"]\n 546 |     if not array_api_dispatch:\n 547 |         if xp is not None:\n 548 |             return xp, False\n 549 |         else:\n 550 |             return _NUMPY_API_WRAPPER_INSTANCE, False\n 551 | \n 552 |     if xp is not None:\n 553 |         return xp, True\n 554 | \n 555 |     arrays = _remove_non_arrays(\n 556 |         *arrays,\n 557 |         remove_none=remove_none,\n 558 |         remove_types=remove_types,\n 559 |     )\n 560 | \n 561 |     if not arrays:\n 562 |         return _NUMPY_API_WRAPPER_INSTANCE, False\n 563 | \n 564 |     _check_array_api_dispatch(array_api_dispatch)\n 565 | \n 566 |     # array-api-compat is a required dependency of scikit-learn only when\n 567 |     # configuring `array_api_dispatch=True`. Its import should therefore be\n 568 |     # protected by _check_array_api_dispatch to display an informative error\n 569 |     # message in case it is missing.\n 570 |     import array_api_compat\n 571 | \n 572 |     namespace, is_array_api_compliant = array_api_compat.get_namespace(*arrays), True\n 573 | \n 574 |     if namespace.__name__ == \"array_api_strict\" and hasattr(\n 575 |         namespace, \"set_array_api_strict_flags\"\n 576 |     ):\n 577 |         namespace.set_array_api_strict_flags(api_version=\"2023.12\")\n 578 | \n 579 |     return namespace, is_array_api_compliant\n 580 | \n 581 | \n 582 | def get_namespace_and_device(*array_list, remove_none=True, remove_types=(str,)):\n 583 |     \"\"\"Combination into one single function of `get_namespace` and `device`.\n 584 | \n 585 |     Parameters\n 586 |     ----------\n 587 |     *array_list : array objects\n 588 |         Array objects.\n 589 |     remove_none : bool, default=True\n 590 |         Whether to ignore None objects passed in arrays.\n 591 |     remove_types : tuple or list, default=(str,)\n 592 |         Types to ignore in the arrays.\n 593 | \n 594 |     Returns\n 595 |     -------\n 596 |     namespace : module\n 597 |         Namespace shared by array objects. If any of the `arrays` are not arrays,\n 598 |         the namespace defaults to NumPy.\n 599 |     is_array_api_compliant : bool\n 600 |         True if the arrays are containers that implement the Array API spec.\n 601 |         Always False when array_api_dispatch=False.\n 602 |     device : device\n 603 |         `device` object (see the \"Device Support\" section of the array API spec).\n 604 |     \"\"\"\n 605 |     array_list = _remove_non_arrays(\n 606 |         *array_list,\n 607 |         remove_none=remove_none,\n 608 |         remove_types=remove_types,\n 609 |     )\n 610 | \n 611 |     skip_remove_kwargs = dict(remove_none=False, remove_types=[])\n 612 | \n 613 |     xp, is_array_api = get_namespace(*array_list, **skip_remove_kwargs)\n 614 |     arrays_device = device(*array_list, **skip_remove_kwargs)\n 615 |     if is_array_api:\n 616 |         return xp, is_array_api, arrays_device\n 617 |     else:\n 618 |         return xp, False, arrays_device\n 619 | \n 620 | \n 621 | def _expit(X, xp=None):\n 622 |     xp, _ = get_namespace(X, xp=xp)\n 623 |     if _is_numpy_namespace(xp):\n 624 |         return xp.asarray(special.expit(numpy.asarray(X)))\n 625 | \n 626 |     return 1.0 / (1.0 + xp.exp(-X))\n 627 | \n 628 | \n 629 | def _fill_or_add_to_diagonal(array, value, xp, add_value=True, wrap=False):\n 630 |     \"\"\"Implementation to facilitate adding or assigning specified values to the\n 631 |     diagonal of a 2-d array.\n 632 | \n 633 |     If ``add_value`` is `True` then the values will be added to the diagonal\n 634 |     elements otherwise the values will be assigned to the diagonal elements.\n 635 |     By default, ``add_value`` is set to `True. This is currently only\n 636 |     supported for 2-d arrays.\n 637 | \n 638 |     The implementation is taken from the `numpy.fill_diagonal` function:\n 639 |     https://github.com/numpy/numpy/blob/v2.0.0/numpy/lib/_index_tricks_impl.py#L799-L929\n 640 |     \"\"\"\n 641 |     if array.ndim != 2:\n 642 |         raise ValueError(\n 643 |             f\"array should be 2-d. Got array with shape {tuple(array.shape)}\"\n 644 |         )\n 645 | \n 646 |     value = xp.asarray(value, dtype=array.dtype, device=device(array))\n 647 |     end = None\n 648 |     # Explicit, fast formula for the common case.  For 2-d arrays, we\n 649 |     # accept rectangular ones.\n 650 |     step = array.shape[1] + 1\n 651 |     if not wrap:\n 652 |         end = array.shape[1] * array.shape[1]\n 653 | \n 654 |     array_flat = xp.reshape(array, (-1,))\n 655 |     if add_value:\n 656 |         array_flat[:end:step] += value\n 657 |     else:\n 658 |         array_flat[:end:step] = value\n 659 | \n 660 | \n 661 | def _max_precision_float_dtype(xp, device):\n 662 |     \"\"\"Return the float dtype with the highest precision supported by the device.\"\"\"\n 663 |     # TODO: Update to use `__array_namespace__info__()` from array-api v2023.12\n 664 |     # when/if that becomes more widespread.\n 665 |     xp_name = xp.__name__\n 666 |     if xp_name in {\"array_api_compat.torch\", \"torch\"} and (\n 667 |         str(device).startswith(\"mps\")\n 668 |     ):  # pragma: no cover\n 669 |         return xp.float32\n 670 |     return xp.float64\n 671 | \n 672 | \n 673 | def _find_matching_floating_dtype(*arrays, xp):\n 674 |     \"\"\"Find a suitable floating point dtype when computing with arrays.\n 675 | \n 676 |     If any of the arrays are floating point, return the dtype with the highest\n 677 |     precision by following official type promotion rules:\n 678 | \n 679 |     https://data-apis.org/array-api/latest/API_specification/type_promotion.html\n 680 | \n 681 |     If there are no floating point input arrays (all integral inputs for\n 682 |     instance), return the default floating point dtype for the namespace.\n 683 |     \"\"\"\n 684 |     dtyped_arrays = [a for a in arrays if hasattr(a, \"dtype\")]\n 685 |     floating_dtypes = [\n 686 |         a.dtype for a in dtyped_arrays if xp.isdtype(a.dtype, \"real floating\")\n 687 |     ]\n 688 |     if floating_dtypes:\n 689 |         # Return the floating dtype with the highest precision:\n 690 |         return xp.result_type(*floating_dtypes)\n 691 | \n 692 |     # If none of the input arrays have a floating point dtype, they must be all\n 693 |     # integer arrays or containers of Python scalars: return the default\n 694 |     # floating point dtype for the namespace (implementation specific).\n 695 |     return xp.asarray(0.0).dtype\n 696 | \n 697 | \n 698 | def _average(a, axis=None, weights=None, normalize=True, xp=None):\n 699 |     \"\"\"Partial port of np.average to support the Array API.\n 700 | \n 701 |     It does a best effort at mimicking the return dtype rule described at\n 702 |     https://numpy.org/doc/stable/reference/generated/numpy.average.html but\n 703 |     only for the common cases needed in scikit-learn.\n 704 |     \"\"\"\n 705 |     xp, _, device_ = get_namespace_and_device(a, weights)\n 706 | \n 707 |     if _is_numpy_namespace(xp):\n 708 |         if normalize:\n 709 |             return xp.asarray(numpy.average(a, axis=axis, weights=weights))\n 710 |         elif axis is None and weights is not None:\n 711 |             return xp.asarray(numpy.dot(a, weights))\n 712 | \n 713 |     a = xp.asarray(a, device=device_)\n 714 |     if weights is not None:\n 715 |         weights = xp.asarray(weights, device=device_)\n 716 | \n 717 |     if weights is not None and a.shape != weights.shape:\n 718 |         if axis is None:\n 719 |             raise TypeError(\n 720 |                 f\"Axis must be specified when the shape of a {tuple(a.shape)} and \"\n 721 |                 f\"weights {tuple(weights.shape)} differ.\"\n 722 |             )\n 723 | \n 724 |         if tuple(weights.shape) != (a.shape[axis],):\n 725 |             raise ValueError(\n 726 |                 f\"Shape of weights weights.shape={tuple(weights.shape)} must be \"\n 727 |                 f\"consistent with a.shape={tuple(a.shape)} and {axis=}.\"\n 728 |             )\n 729 | \n 730 |         # If weights are 1D, add singleton dimensions for broadcasting\n 731 |         shape = [1] * a.ndim\n 732 |         shape[axis] = a.shape[axis]\n 733 |         weights = xp.reshape(weights, shape)\n 734 | \n 735 |     if xp.isdtype(a.dtype, \"complex floating\"):\n 736 |         raise NotImplementedError(\n 737 |             \"Complex floating point values are not supported by average.\"\n 738 |         )\n 739 |     if weights is not None and xp.isdtype(weights.dtype, \"complex floating\"):\n 740 |         raise NotImplementedError(\n 741 |             \"Complex floating point values are not supported by average.\"\n 742 |         )\n 743 | \n 744 |     output_dtype = _find_matching_floating_dtype(a, weights, xp=xp)\n 745 |     a = xp.astype(a, output_dtype)\n 746 | \n 747 |     if weights is None:\n 748 |         return (xp.mean if normalize else xp.sum)(a, axis=axis)\n 749 | \n 750 |     weights = xp.astype(weights, output_dtype)\n 751 | \n 752 |     sum_ = xp.sum(xp.multiply(a, weights), axis=axis)\n 753 | \n 754 |     if not normalize:\n 755 |         return sum_\n 756 | \n 757 |     scale = xp.sum(weights, axis=axis)\n 758 |     if xp.any(scale == 0.0):\n 759 |         raise ZeroDivisionError(\"Weights sum to zero, can't be normalized\")\n 760 | \n 761 |     return sum_ / scale\n 762 | \n 763 | \n 764 | def _nanmin(X, axis=None, xp=None):\n 765 |     # TODO: refactor once nan-aware reductions are standardized:\n 766 |     # https://github.com/data-apis/array-api/issues/621\n 767 |     xp, _ = get_namespace(X, xp=xp)\n 768 |     if _is_numpy_namespace(xp):\n 769 |         return xp.asarray(numpy.nanmin(X, axis=axis))\n 770 | \n 771 |     else:\n 772 |         mask = xp.isnan(X)\n 773 |         X = xp.min(xp.where(mask, xp.asarray(+xp.inf, device=device(X)), X), axis=axis)\n 774 |         # Replace Infs from all NaN slices with NaN again\n 775 |         mask = xp.all(mask, axis=axis)\n 776 |         if xp.any(mask):\n 777 |             X = xp.where(mask, xp.asarray(xp.nan), X)\n 778 |         return X\n 779 | \n 780 | \n 781 | def _nanmax(X, axis=None, xp=None):\n 782 |     # TODO: refactor once nan-aware reductions are standardized:\n 783 |     # https://github.com/data-apis/array-api/issues/621\n 784 |     xp, _ = get_namespace(X, xp=xp)\n 785 |     if _is_numpy_namespace(xp):\n 786 |         return xp.asarray(numpy.nanmax(X, axis=axis))\n 787 | \n 788 |     else:\n 789 |         mask = xp.isnan(X)\n 790 |         X = xp.max(xp.where(mask, xp.asarray(-xp.inf, device=device(X)), X), axis=axis)\n 791 |         # Replace Infs from all NaN slices with NaN again\n 792 |         mask = xp.all(mask, axis=axis)\n 793 |         if xp.any(mask):\n 794 |             X = xp.where(mask, xp.asarray(xp.nan), X)\n 795 |         return X\n 796 | \n 797 | \n 798 | def _asarray_with_order(\n 799 |     array, dtype=None, order=None, copy=None, *, xp=None, device=None\n 800 | ):\n 801 |     \"\"\"Helper to support the order kwarg only for NumPy-backed arrays\n 802 | \n 803 |     Memory layout parameter `order` is not exposed in the Array API standard,\n 804 |     however some input validation code in scikit-learn needs to work both\n 805 |     for classes and functions that will leverage Array API only operations\n 806 |     and for code that inherently relies on NumPy backed data containers with\n 807 |     specific memory layout constraints (e.g. our own Cython code). The\n 808 |     purpose of this helper is to make it possible to share code for data\n 809 |     container validation without memory copies for both downstream use cases:\n 810 |     the `order` parameter is only enforced if the input array implementation\n 811 |     is NumPy based, otherwise `order` is just silently ignored.\n 812 |     \"\"\"\n 813 |     xp, _ = get_namespace(array, xp=xp)\n 814 |     if _is_numpy_namespace(xp):\n 815 |         # Use NumPy API to support order\n 816 |         if copy is True:\n 817 |             array = numpy.array(array, order=order, dtype=dtype)\n 818 |         else:\n 819 |             array = numpy.asarray(array, order=order, dtype=dtype)\n 820 | \n 821 |         # At this point array is a NumPy ndarray. We convert it to an array\n 822 |         # container that is consistent with the input's namespace.\n 823 |         return xp.asarray(array)\n 824 |     else:\n 825 |         return xp.asarray(array, dtype=dtype, copy=copy, device=device)\n 826 | \n 827 | \n 828 | def _ravel(array, xp=None):\n 829 |     \"\"\"Array API compliant version of np.ravel.\n 830 | \n 831 |     For non numpy namespaces, it just returns a flattened array, that might\n 832 |     be or not be a copy.\n 833 |     \"\"\"\n 834 |     xp, _ = get_namespace(array, xp=xp)\n 835 |     if _is_numpy_namespace(xp):\n 836 |         array = numpy.asarray(array)\n 837 |         return xp.asarray(numpy.ravel(array, order=\"C\"))\n 838 | \n 839 |     return xp.reshape(array, shape=(-1,))\n 840 | \n 841 | \n 842 | def _convert_to_numpy(array, xp):\n 843 |     \"\"\"Convert X into a NumPy ndarray on the CPU.\"\"\"\n 844 |     xp_name = xp.__name__\n 845 | \n 846 |     if xp_name in {\"array_api_compat.torch\", \"torch\"}:\n 847 |         return array.cpu().numpy()\n 848 |     elif xp_name in {\"array_api_compat.cupy\", \"cupy\"}:  # pragma: nocover\n 849 |         return array.get()\n 850 | \n 851 |     return numpy.asarray(array)\n 852 | \n 853 | \n 854 | def _estimator_with_converted_arrays(estimator, converter):\n 855 |     \"\"\"Create new estimator which converting all attributes that are arrays.\n 856 | \n 857 |     The converter is called on all NumPy arrays and arrays that support the\n 858 |     `DLPack interface <https://dmlc.github.io/dlpack/latest/>`__.\n 859 | \n 860 |     Parameters\n 861 |     ----------\n 862 |     estimator : Estimator\n 863 |         Estimator to convert\n 864 | \n 865 |     converter : callable\n 866 |         Callable that takes an array attribute and returns the converted array.\n 867 | \n 868 |     Returns\n 869 |     -------\n 870 |     new_estimator : Estimator\n 871 |         Convert estimator\n 872 |     \"\"\"\n 873 |     from sklearn.base import clone\n 874 | \n 875 |     new_estimator = clone(estimator)\n 876 |     for key, attribute in vars(estimator).items():\n 877 |         if hasattr(attribute, \"__dlpack__\") or isinstance(attribute, numpy.ndarray):\n 878 |             attribute = converter(attribute)\n 879 |         setattr(new_estimator, key, attribute)\n 880 |     return new_estimator\n 881 | \n 882 | \n 883 | def _atol_for_type(dtype_or_dtype_name):\n 884 |     \"\"\"Return the absolute tolerance for a given numpy dtype.\"\"\"\n 885 |     if dtype_or_dtype_name is None:\n 886 |         # If no dtype is specified when running tests for a given namespace, we\n 887 |         # expect the same floating precision level as NumPy's default floating\n 888 |         # point dtype.\n 889 |         dtype_or_dtype_name = numpy.float64\n 890 |     return numpy.finfo(dtype_or_dtype_name).eps * 100\n 891 | \n 892 | \n 893 | def indexing_dtype(xp):\n 894 |     \"\"\"Return a platform-specific integer dtype suitable for indexing.\n 895 | \n 896 |     On 32-bit platforms, this will typically return int32 and int64 otherwise.\n 897 | \n 898 |     Note: using dtype is recommended for indexing transient array\n 899 |     datastructures. For long-lived arrays, such as the fitted attributes of\n 900 |     estimators, it is instead recommended to use platform-independent int32 if\n 901 |     we do not expect to index more 2B elements. Using fixed dtypes simplifies\n 902 |     the handling of serialized models, e.g. to deploy a model fit on a 64-bit\n 903 |     platform to a target 32-bit platform such as WASM/pyodide.\n 904 |     \"\"\"\n 905 |     # Currently this is implemented with simple hack that assumes that\n 906 |     # following \"may be\" statements in the Array API spec always hold:\n 907 |     # > The default integer data type should be the same across platforms, but\n 908 |     # > the default may vary depending on whether Python is 32-bit or 64-bit.\n 909 |     # > The default array index data type may be int32 on 32-bit platforms, but\n 910 |     # > the default should be int64 otherwise.\n 911 |     # https://data-apis.org/array-api/latest/API_specification/data_types.html#default-data-types\n 912 |     # TODO: once sufficiently adopted, we might want to instead rely on the\n 913 |     # newer inspection API: https://github.com/data-apis/array-api/issues/640\n 914 |     return xp.asarray(0).dtype\n 915 | \n 916 | \n 917 | def _searchsorted(xp, a, v, *, side=\"left\", sorter=None):\n 918 |     # Temporary workaround needed as long as searchsorted is not widely\n 919 |     # adopted by implementers of the Array API spec. This is a quite\n 920 |     # recent addition to the spec:\n 921 |     # https://data-apis.org/array-api/latest/API_specification/generated/array_api.searchsorted.html # noqa\n 922 |     if hasattr(xp, \"searchsorted\"):\n 923 |         return xp.searchsorted(a, v, side=side, sorter=sorter)\n 924 | \n 925 |     a_np = _convert_to_numpy(a, xp=xp)\n 926 |     v_np = _convert_to_numpy(v, xp=xp)\n 927 |     indices = numpy.searchsorted(a_np, v_np, side=side, sorter=sorter)\n 928 |     return xp.asarray(indices, device=device(a))\n 929 | \n 930 | \n 931 | def _setdiff1d(ar1, ar2, xp, assume_unique=False):\n 932 |     \"\"\"Find the set difference of two arrays.\n 933 | \n 934 |     Return the unique values in `ar1` that are not in `ar2`.\n 935 |     \"\"\"\n 936 |     if _is_numpy_namespace(xp):\n 937 |         return xp.asarray(\n 938 |             numpy.setdiff1d(\n 939 |                 ar1=ar1,\n 940 |                 ar2=ar2,\n 941 |                 assume_unique=assume_unique,\n 942 |             )\n 943 |         )\n 944 | \n 945 |     if assume_unique:\n 946 |         ar1 = xp.reshape(ar1, (-1,))\n 947 |     else:\n 948 |         ar1 = xp.unique_values(ar1)\n 949 |         ar2 = xp.unique_values(ar2)\n 950 |     return ar1[_in1d(ar1=ar1, ar2=ar2, xp=xp, assume_unique=True, invert=True)]\n 951 | \n 952 | \n 953 | def _isin(element, test_elements, xp, assume_unique=False, invert=False):\n 954 |     \"\"\"Calculates ``element in test_elements``, broadcasting over `element`\n 955 |     only.\n 956 | \n 957 |     Returns a boolean array of the same shape as `element` that is True\n 958 |     where an element of `element` is in `test_elements` and False otherwise.\n 959 |     \"\"\"\n 960 |     if _is_numpy_namespace(xp):\n 961 |         return xp.asarray(\n 962 |             numpy.isin(\n 963 |                 element=element,\n 964 |                 test_elements=test_elements,\n 965 |                 assume_unique=assume_unique,\n 966 |                 invert=invert,\n 967 |             )\n 968 |         )\n 969 | \n 970 |     original_element_shape = element.shape\n 971 |     element = xp.reshape(element, (-1,))\n 972 |     test_elements = xp.reshape(test_elements, (-1,))\n 973 |     return xp.reshape(\n 974 |         _in1d(\n 975 |             ar1=element,\n 976 |             ar2=test_elements,\n 977 |             xp=xp,\n 978 |             assume_unique=assume_unique,\n 979 |             invert=invert,\n 980 |         ),\n 981 |         original_element_shape,\n 982 |     )\n 983 | \n 984 | \n 985 | # Note: This is a helper for the functions `_isin` and\n 986 | # `_setdiff1d`. It is not meant to be called directly.\n 987 | def _in1d(ar1, ar2, xp, assume_unique=False, invert=False):\n 988 |     \"\"\"Checks whether each element of an array is also present in a\n 989 |     second array.\n 990 | \n 991 |     Returns a boolean array the same length as `ar1` that is True\n 992 |     where an element of `ar1` is in `ar2` and False otherwise.\n 993 | \n 994 |     This function has been adapted using the original implementation\n 995 |     present in numpy:\n 996 |     https://github.com/numpy/numpy/blob/v1.26.0/numpy/lib/arraysetops.py#L524-L758\n 997 |     \"\"\"\n 998 |     xp, _ = get_namespace(ar1, ar2, xp=xp)\n 999 | \n1000 |     # This code is run to make the code significantly faster\n1001 |     if ar2.shape[0] < 10 * ar1.shape[0] ** 0.145:\n1002 |         if invert:\n1003 |             mask = xp.ones(ar1.shape[0], dtype=xp.bool, device=device(ar1))\n1004 |             for a in ar2:\n1005 |                 mask &= ar1 != a\n1006 |         else:\n1007 |             mask = xp.zeros(ar1.shape[0], dtype=xp.bool, device=device(ar1))\n1008 |             for a in ar2:\n1009 |                 mask |= ar1 == a\n1010 |         return mask\n1011 | \n1012 |     if not assume_unique:\n1013 |         ar1, rev_idx = xp.unique_inverse(ar1)\n1014 |         ar2 = xp.unique_values(ar2)\n1015 | \n1016 |     ar = xp.concat((ar1, ar2))\n1017 |     device_ = device(ar)\n1018 |     # We need this to be a stable sort.\n1019 |     order = xp.argsort(ar, stable=True)\n1020 |     reverse_order = xp.argsort(order, stable=True)\n1021 |     sar = xp.take(ar, order, axis=0)\n1022 |     if invert:\n1023 |         bool_ar = sar[1:] != sar[:-1]\n1024 |     else:\n1025 |         bool_ar = sar[1:] == sar[:-1]\n1026 |     flag = xp.concat((bool_ar, xp.asarray([invert], device=device_)))\n1027 |     ret = xp.take(flag, reverse_order, axis=0)\n1028 | \n1029 |     if assume_unique:\n1030 |         return ret[: ar1.shape[0]]\n1031 |     else:\n1032 |         return xp.take(ret, rev_idx, axis=0)\n1033 | \n1034 | \n1035 | def _count_nonzero(X, xp, device, axis=None, sample_weight=None):\n1036 |     \"\"\"A variant of `sklearn.utils.sparsefuncs.count_nonzero` for the Array API.\n1037 | \n1038 |     It only supports 2D arrays.\n1039 |     \"\"\"\n1040 |     assert X.ndim == 2\n1041 | \n1042 |     weights = xp.ones_like(X, device=device)\n1043 |     if sample_weight is not None:\n1044 |         sample_weight = xp.asarray(sample_weight, device=device)\n1045 |         sample_weight = xp.reshape(sample_weight, (sample_weight.shape[0], 1))\n1046 |         weights = xp.astype(weights, sample_weight.dtype) * sample_weight\n1047 | \n1048 |     zero_scalar = xp.asarray(0, device=device, dtype=weights.dtype)\n1049 |     return xp.sum(xp.where(X != 0, weights, zero_scalar), axis=axis)\n1050 | \n1051 | \n1052 | def _modify_in_place_if_numpy(xp, func, *args, out=None, **kwargs):\n1053 |     if _is_numpy_namespace(xp):\n1054 |         func(*args, out=out, **kwargs)\n1055 |     else:\n1056 |         out = func(*args, **kwargs)\n1057 |     return out\n1058 | \n```\n"}, {"content": "Now, let's examine the `validation.py` file to see how `_check_reg_targets` is implemented:\n\n<function=get_entity_contents>\n<parameter=entity_names>\n['sklearn/utils/validation.py']\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `sklearn/utils/validation.py`...\n### Search Result:\nFound file `sklearn/utils/validation.py`.\nSource: Exact match found for entity name `sklearn/utils/validation.py`.\n```\n   1 | \"\"\"Functions to validate input and parameters within scikit-learn estimators.\"\"\"\n   2 | \n   3 | # Authors: The scikit-learn developers\n   4 | # SPDX-License-Identifier: BSD-3-Clause\n   5 | \n   6 | import numbers\n   7 | import operator\n   8 | import sys\n   9 | import warnings\n  10 | from collections.abc import Sequence\n  11 | from contextlib import suppress\n  12 | from functools import reduce, wraps\n  13 | from inspect import Parameter, isclass, signature\n  14 | \n  15 | import joblib\n  16 | import numpy as np\n  17 | import scipy.sparse as sp\n  18 | \n  19 | from .. import get_config as _get_config\n  20 | from ..exceptions import DataConversionWarning, NotFittedError, PositiveSpectrumWarning\n  21 | from ..utils._array_api import _asarray_with_order, _is_numpy_namespace, get_namespace\n  22 | from ..utils.deprecation import _deprecate_force_all_finite\n  23 | from ..utils.fixes import ComplexWarning, _preserve_dia_indices_dtype\n  24 | from ._isfinite import FiniteStatus, cy_isfinite\n  25 | from ._tags import get_tags\n  26 | from .fixes import _object_dtype_isnan\n  27 | \n  28 | FLOAT_DTYPES = (np.float64, np.float32, np.float16)\n  29 | \n  30 | \n  31 | # This function is not used anymore at this moment in the code base but we keep it in\n  32 | # case that we merge a new public function without kwarg only by mistake, which would\n  33 | # require a deprecation cycle to fix.\n  34 | def _deprecate_positional_args(func=None, *, version=\"1.3\"):\n  35 |     \"\"\"Decorator for methods that issues warnings for positional arguments.\n  36 | \n  37 |     Using the keyword-only argument syntax in pep 3102, arguments after the\n  38 |     * will issue a warning when passed as a positional argument.\n  39 | \n  40 |     Parameters\n  41 |     ----------\n  42 |     func : callable, default=None\n  43 |         Function to check arguments on.\n  44 |     version : callable, default=\"1.3\"\n  45 |         The version when positional arguments will result in error.\n  46 |     \"\"\"\n  47 | \n  48 |     def _inner_deprecate_positional_args(f):\n  49 |         sig = signature(f)\n  50 |         kwonly_args = []\n  51 |         all_args = []\n  52 | \n  53 |         for name, param in sig.parameters.items():\n  54 |             if param.kind == Parameter.POSITIONAL_OR_KEYWORD:\n  55 |                 all_args.append(name)\n  56 |             elif param.kind == Parameter.KEYWORD_ONLY:\n  57 |                 kwonly_args.append(name)\n  58 | \n  59 |         @wraps(f)\n  60 |         def inner_f(*args, **kwargs):\n  61 |             extra_args = len(args) - len(all_args)\n  62 |             if extra_args <= 0:\n  63 |                 return f(*args, **kwargs)\n  64 | \n  65 |             # extra_args > 0\n  66 |             args_msg = [\n  67 |                 \"{}={}\".format(name, arg)\n  68 |                 for name, arg in zip(kwonly_args[:extra_args], args[-extra_args:])\n  69 |             ]\n  70 |             args_msg = \", \".join(args_msg)\n  71 |             warnings.warn(\n  72 |                 (\n  73 |                     f\"Pass {args_msg} as keyword args. From version \"\n  74 |                     f\"{version} passing these as positional arguments \"\n  75 |                     \"will result in an error\"\n  76 |                 ),\n  77 |                 FutureWarning,\n  78 |             )\n  79 |             kwargs.update(zip(sig.parameters, args))\n  80 |             return f(**kwargs)\n  81 | \n  82 |         return inner_f\n  83 | \n  84 |     if func is not None:\n  85 |         return _inner_deprecate_positional_args(func)\n  86 | \n  87 |     return _inner_deprecate_positional_args\n  88 | \n  89 | \n  90 | def _assert_all_finite(\n  91 |     X, allow_nan=False, msg_dtype=None, estimator_name=None, input_name=\"\"\n  92 | ):\n  93 |     \"\"\"Like assert_all_finite, but only for ndarray.\"\"\"\n  94 | \n  95 |     xp, is_array_api = get_namespace(X)\n  96 | \n  97 |     if _get_config()[\"assume_finite\"]:\n  98 |         return\n  99 | \n 100 |     X = xp.asarray(X)\n 101 | \n 102 |     # for object dtype data, we only check for NaNs (GH-13254)\n 103 |     if not is_array_api and X.dtype == np.dtype(\"object\") and not allow_nan:\n 104 |         if _object_dtype_isnan(X).any():\n 105 |             raise ValueError(\"Input contains NaN\")\n 106 | \n 107 |     # We need only consider float arrays, hence can early return for all else.\n 108 |     if not xp.isdtype(X.dtype, (\"real floating\", \"complex floating\")):\n 109 |         return\n 110 | \n 111 |     # First try an O(n) time, O(1) space solution for the common case that\n 112 |     # everything is finite; fall back to O(n) space `np.isinf/isnan` or custom\n 113 |     # Cython implementation to prevent false positives and provide a detailed\n 114 |     # error message.\n 115 |     with np.errstate(over=\"ignore\"):\n 116 |         first_pass_isfinite = xp.isfinite(xp.sum(X))\n 117 |     if first_pass_isfinite:\n 118 |         return\n 119 | \n 120 |     _assert_all_finite_element_wise(\n 121 |         X,\n 122 |         xp=xp,\n 123 |         allow_nan=allow_nan,\n 124 |         msg_dtype=msg_dtype,\n 125 |         estimator_name=estimator_name,\n 126 |         input_name=input_name,\n 127 |     )\n 128 | \n 129 | \n 130 | def _assert_all_finite_element_wise(\n 131 |     X, *, xp, allow_nan, msg_dtype=None, estimator_name=None, input_name=\"\"\n 132 | ):\n 133 |     # Cython implementation doesn't support FP16 or complex numbers\n 134 |     use_cython = (\n 135 |         xp is np and X.data.contiguous and X.dtype.type in {np.float32, np.float64}\n 136 |     )\n 137 |     if use_cython:\n 138 |         out = cy_isfinite(X.reshape(-1), allow_nan=allow_nan)\n 139 |         has_nan_error = False if allow_nan else out == FiniteStatus.has_nan\n 140 |         has_inf = out == FiniteStatus.has_infinite\n 141 |     else:\n 142 |         has_inf = xp.any(xp.isinf(X))\n 143 |         has_nan_error = False if allow_nan else xp.any(xp.isnan(X))\n 144 |     if has_inf or has_nan_error:\n 145 |         if has_nan_error:\n 146 |             type_err = \"NaN\"\n 147 |         else:\n 148 |             msg_dtype = msg_dtype if msg_dtype is not None else X.dtype\n 149 |             type_err = f\"infinity or a value too large for {msg_dtype!r}\"\n 150 |         padded_input_name = input_name + \" \" if input_name else \"\"\n 151 |         msg_err = f\"Input {padded_input_name}contains {type_err}.\"\n 152 |         if estimator_name and input_name == \"X\" and has_nan_error:\n 153 |             # Improve the error message on how to handle missing values in\n 154 |             # scikit-learn.\n 155 |             msg_err += (\n 156 |                 f\"\\n{estimator_name} does not accept missing values\"\n 157 |                 \" encoded as NaN natively. For supervised learning, you might want\"\n 158 |                 \" to consider sklearn.ensemble.HistGradientBoostingClassifier and\"\n 159 |                 \" Regressor which accept missing values encoded as NaNs natively.\"\n 160 |                 \" Alternatively, it is possible to preprocess the data, for\"\n 161 |                 \" instance by using an imputer transformer in a pipeline or drop\"\n 162 |                 \" samples with missing values. See\"\n 163 |                 \" https://scikit-learn.org/stable/modules/impute.html\"\n 164 |                 \" You can find a list of all estimators that handle NaN values\"\n 165 |                 \" at the following page:\"\n 166 |                 \" https://scikit-learn.org/stable/modules/impute.html\"\n 167 |                 \"#estimators-that-handle-nan-values\"\n 168 |             )\n 169 |         raise ValueError(msg_err)\n 170 | \n 171 | \n 172 | def assert_all_finite(\n 173 |     X,\n 174 |     *,\n 175 |     allow_nan=False,\n 176 |     estimator_name=None,\n 177 |     input_name=\"\",\n 178 | ):\n 179 |     \"\"\"Throw a ValueError if X contains NaN or infinity.\n 180 | \n 181 |     Parameters\n 182 |     ----------\n 183 |     X : {ndarray, sparse matrix}\n 184 |         The input data.\n 185 | \n 186 |     allow_nan : bool, default=False\n 187 |         If True, do not throw error when `X` contains NaN.\n 188 | \n 189 |     estimator_name : str, default=None\n 190 |         The estimator name, used to construct the error message.\n 191 | \n 192 |     input_name : str, default=\"\"\n 193 |         The data name used to construct the error message. In particular\n 194 |         if `input_name` is \"X\" and the data has NaN values and\n 195 |         allow_nan is False, the error message will link to the imputer\n 196 |         documentation.\n 197 | \n 198 |     Examples\n 199 |     --------\n 200 |     >>> from sklearn.utils import assert_all_finite\n 201 |     >>> import numpy as np\n 202 |     >>> array = np.array([1, np.inf, np.nan, 4])\n 203 |     >>> try:\n 204 |     ...     assert_all_finite(array)\n 205 |     ...     print(\"Test passed: Array contains only finite values.\")\n 206 |     ... except ValueError:\n 207 |     ...     print(\"Test failed: Array contains non-finite values.\")\n 208 |     Test failed: Array contains non-finite values.\n 209 |     \"\"\"\n 210 |     _assert_all_finite(\n 211 |         X.data if sp.issparse(X) else X,\n 212 |         allow_nan=allow_nan,\n 213 |         estimator_name=estimator_name,\n 214 |         input_name=input_name,\n 215 |     )\n 216 | \n 217 | \n 218 | def as_float_array(\n 219 |     X, *, copy=True, force_all_finite=\"deprecated\", ensure_all_finite=None\n 220 | ):\n 221 |     \"\"\"Convert an array-like to an array of floats.\n 222 | \n 223 |     The new dtype will be np.float32 or np.float64, depending on the original\n 224 |     type. The function can create a copy or modify the argument depending\n 225 |     on the argument copy.\n 226 | \n 227 |     Parameters\n 228 |     ----------\n 229 |     X : {array-like, sparse matrix}\n 230 |         The input data.\n 231 | \n 232 |     copy : bool, default=True\n 233 |         If True, a copy of X will be created. If False, a copy may still be\n 234 |         returned if X's dtype is not a floating point type.\n 235 | \n 236 |     force_all_finite : bool or 'allow-nan', default=True\n 237 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 238 |         possibilities are:\n 239 | \n 240 |         - True: Force all values of X to be finite.\n 241 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 242 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 243 |           be infinite.\n 244 | \n 245 |         .. versionadded:: 0.20\n 246 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n 247 | \n 248 |         .. versionchanged:: 0.23\n 249 |            Accepts `pd.NA` and converts it into `np.nan`\n 250 | \n 251 |         .. deprecated:: 1.6\n 252 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n 253 |            in 1.8.\n 254 | \n 255 |     ensure_all_finite : bool or 'allow-nan', default=True\n 256 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 257 |         possibilities are:\n 258 | \n 259 |         - True: Force all values of X to be finite.\n 260 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 261 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 262 |           be infinite.\n 263 | \n 264 |         .. versionadded:: 1.6\n 265 |            `force_all_finite` was renamed to `ensure_all_finite`.\n 266 | \n 267 |     Returns\n 268 |     -------\n 269 |     XT : {ndarray, sparse matrix}\n 270 |         An array of type float.\n 271 | \n 272 |     Examples\n 273 |     --------\n 274 |     >>> from sklearn.utils import as_float_array\n 275 |     >>> import numpy as np\n 276 |     >>> array = np.array([0, 0, 1, 2, 2], dtype=np.int64)\n 277 |     >>> as_float_array(array)\n 278 |     array([0., 0., 1., 2., 2.])\n 279 |     \"\"\"\n 280 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n 281 | \n 282 |     if isinstance(X, np.matrix) or (\n 283 |         not isinstance(X, np.ndarray) and not sp.issparse(X)\n 284 |     ):\n 285 |         return check_array(\n 286 |             X,\n 287 |             accept_sparse=[\"csr\", \"csc\", \"coo\"],\n 288 |             dtype=np.float64,\n 289 |             copy=copy,\n 290 |             ensure_all_finite=ensure_all_finite,\n 291 |             ensure_2d=False,\n 292 |         )\n 293 |     elif sp.issparse(X) and X.dtype in [np.float32, np.float64]:\n 294 |         return X.copy() if copy else X\n 295 |     elif X.dtype in [np.float32, np.float64]:  # is numpy array\n 296 |         return X.copy(\"F\" if X.flags[\"F_CONTIGUOUS\"] else \"C\") if copy else X\n 297 |     else:\n 298 |         if X.dtype.kind in \"uib\" and X.dtype.itemsize <= 4:\n 299 |             return_dtype = np.float32\n 300 |         else:\n 301 |             return_dtype = np.float64\n 302 |         return X.astype(return_dtype)\n 303 | \n 304 | \n 305 | def _is_arraylike(x):\n 306 |     \"\"\"Returns whether the input is array-like.\"\"\"\n 307 |     if sp.issparse(x):\n 308 |         return False\n 309 | \n 310 |     return hasattr(x, \"__len__\") or hasattr(x, \"shape\") or hasattr(x, \"__array__\")\n 311 | \n 312 | \n 313 | def _is_arraylike_not_scalar(array):\n 314 |     \"\"\"Return True if array is array-like and not a scalar\"\"\"\n 315 |     return _is_arraylike(array) and not np.isscalar(array)\n 316 | \n 317 | \n 318 | def _use_interchange_protocol(X):\n 319 |     \"\"\"Use interchange protocol for non-pandas dataframes that follow the protocol.\n 320 | \n 321 |     Note: at this point we chose not to use the interchange API on pandas dataframe\n 322 |     to ensure strict behavioral backward compatibility with older versions of\n 323 |     scikit-learn.\n 324 |     \"\"\"\n 325 |     return not _is_pandas_df(X) and hasattr(X, \"__dataframe__\")\n 326 | \n 327 | \n 328 | def _num_features(X):\n 329 |     \"\"\"Return the number of features in an array-like X.\n 330 | \n 331 |     This helper function tries hard to avoid to materialize an array version\n 332 |     of X unless necessary. For instance, if X is a list of lists,\n 333 |     this function will return the length of the first element, assuming\n 334 |     that subsequent elements are all lists of the same length without\n 335 |     checking.\n 336 |     Parameters\n 337 |     ----------\n 338 |     X : array-like\n 339 |         array-like to get the number of features.\n 340 | \n 341 |     Returns\n 342 |     -------\n 343 |     features : int\n 344 |         Number of features\n 345 |     \"\"\"\n 346 |     type_ = type(X)\n 347 |     if type_.__module__ == \"builtins\":\n 348 |         type_name = type_.__qualname__\n 349 |     else:\n 350 |         type_name = f\"{type_.__module__}.{type_.__qualname__}\"\n 351 |     message = f\"Unable to find the number of features from X of type {type_name}\"\n 352 |     if not hasattr(X, \"__len__\") and not hasattr(X, \"shape\"):\n 353 |         if not hasattr(X, \"__array__\"):\n 354 |             raise TypeError(message)\n 355 |         # Only convert X to a numpy array if there is no cheaper, heuristic\n 356 |         # option.\n 357 |         X = np.asarray(X)\n 358 | \n 359 |     if hasattr(X, \"shape\"):\n 360 |         if not hasattr(X.shape, \"__len__\") or len(X.shape) <= 1:\n 361 |             message += f\" with shape {X.shape}\"\n 362 |             raise TypeError(message)\n 363 |         return X.shape[1]\n 364 | \n 365 |     first_sample = X[0]\n 366 | \n 367 |     # Do not consider an array-like of strings or dicts to be a 2D array\n 368 |     if isinstance(first_sample, (str, bytes, dict)):\n 369 |         message += f\" where the samples are of type {type(first_sample).__qualname__}\"\n 370 |         raise TypeError(message)\n 371 | \n 372 |     try:\n 373 |         # If X is a list of lists, for instance, we assume that all nested\n 374 |         # lists have the same length without checking or converting to\n 375 |         # a numpy array to keep this function call as cheap as possible.\n 376 |         return len(first_sample)\n 377 |     except Exception as err:\n 378 |         raise TypeError(message) from err\n 379 | \n 380 | \n 381 | def _num_samples(x):\n 382 |     \"\"\"Return number of samples in array-like x.\"\"\"\n 383 |     message = \"Expected sequence or array-like, got %s\" % type(x)\n 384 |     if hasattr(x, \"fit\") and callable(x.fit):\n 385 |         # Don't get num_samples from an ensembles length!\n 386 |         raise TypeError(message)\n 387 | \n 388 |     if _use_interchange_protocol(x):\n 389 |         return x.__dataframe__().num_rows()\n 390 | \n 391 |     if not hasattr(x, \"__len__\") and not hasattr(x, \"shape\"):\n 392 |         if hasattr(x, \"__array__\"):\n 393 |             x = np.asarray(x)\n 394 |         else:\n 395 |             raise TypeError(message)\n 396 | \n 397 |     if hasattr(x, \"shape\") and x.shape is not None:\n 398 |         if len(x.shape) == 0:\n 399 |             raise TypeError(\n 400 |                 \"Singleton array %r cannot be considered a valid collection.\" % x\n 401 |             )\n 402 |         # Check that shape is returning an integer or default to len\n 403 |         # Dask dataframes may not return numeric shape[0] value\n 404 |         if isinstance(x.shape[0], numbers.Integral):\n 405 |             return x.shape[0]\n 406 | \n 407 |     try:\n 408 |         return len(x)\n 409 |     except TypeError as type_error:\n 410 |         raise TypeError(message) from type_error\n 411 | \n 412 | \n 413 | def check_memory(memory):\n 414 |     \"\"\"Check that ``memory`` is joblib.Memory-like.\n 415 | \n 416 |     joblib.Memory-like means that ``memory`` can be converted into a\n 417 |     joblib.Memory instance (typically a str denoting the ``location``)\n 418 |     or has the same interface (has a ``cache`` method).\n 419 | \n 420 |     Parameters\n 421 |     ----------\n 422 |     memory : None, str or object with the joblib.Memory interface\n 423 |         - If string, the location where to create the `joblib.Memory` interface.\n 424 |         - If None, no caching is done and the Memory object is completely transparent.\n 425 | \n 426 |     Returns\n 427 |     -------\n 428 |     memory : object with the joblib.Memory interface\n 429 |         A correct joblib.Memory object.\n 430 | \n 431 |     Raises\n 432 |     ------\n 433 |     ValueError\n 434 |         If ``memory`` is not joblib.Memory-like.\n 435 | \n 436 |     Examples\n 437 |     --------\n 438 |     >>> from sklearn.utils.validation import check_memory\n 439 |     >>> check_memory(\"caching_dir\")\n 440 |     Memory(location=caching_dir/joblib)\n 441 |     \"\"\"\n 442 |     if memory is None or isinstance(memory, str):\n 443 |         memory = joblib.Memory(location=memory, verbose=0)\n 444 |     elif not hasattr(memory, \"cache\"):\n 445 |         raise ValueError(\n 446 |             \"'memory' should be None, a string or have the same\"\n 447 |             \" interface as joblib.Memory.\"\n 448 |             \" Got memory='{}' instead.\".format(memory)\n 449 |         )\n 450 |     return memory\n 451 | \n 452 | \n 453 | def check_consistent_length(*arrays):\n 454 |     \"\"\"Check that all arrays have consistent first dimensions.\n 455 | \n 456 |     Checks whether all objects in arrays have the same shape or length.\n 457 | \n 458 |     Parameters\n 459 |     ----------\n 460 |     *arrays : list or tuple of input objects.\n 461 |         Objects that will be checked for consistent length.\n 462 | \n 463 |     Examples\n 464 |     --------\n 465 |     >>> from sklearn.utils.validation import check_consistent_length\n 466 |     >>> a = [1, 2, 3]\n 467 |     >>> b = [2, 3, 4]\n 468 |     >>> check_consistent_length(a, b)\n 469 |     \"\"\"\n 470 | \n 471 |     lengths = [_num_samples(X) for X in arrays if X is not None]\n 472 |     uniques = np.unique(lengths)\n 473 |     if len(uniques) > 1:\n 474 |         raise ValueError(\n 475 |             \"Found input variables with inconsistent numbers of samples: %r\"\n 476 |             % [int(l) for l in lengths]\n 477 |         )\n 478 | \n 479 | \n 480 | def _make_indexable(iterable):\n 481 |     \"\"\"Ensure iterable supports indexing or convert to an indexable variant.\n 482 | \n 483 |     Convert sparse matrices to csr and other non-indexable iterable to arrays.\n 484 |     Let `None` and indexable objects (e.g. pandas dataframes) pass unchanged.\n 485 | \n 486 |     Parameters\n 487 |     ----------\n 488 |     iterable : {list, dataframe, ndarray, sparse matrix} or None\n 489 |         Object to be converted to an indexable iterable.\n 490 |     \"\"\"\n 491 |     if sp.issparse(iterable):\n 492 |         return iterable.tocsr()\n 493 |     elif hasattr(iterable, \"__getitem__\") or hasattr(iterable, \"iloc\"):\n 494 |         return iterable\n 495 |     elif iterable is None:\n 496 |         return iterable\n 497 |     return np.array(iterable)\n 498 | \n 499 | \n 500 | def indexable(*iterables):\n 501 |     \"\"\"Make arrays indexable for cross-validation.\n 502 | \n 503 |     Checks consistent length, passes through None, and ensures that everything\n 504 |     can be indexed by converting sparse matrices to csr and converting\n 505 |     non-iterable objects to arrays.\n 506 | \n 507 |     Parameters\n 508 |     ----------\n 509 |     *iterables : {lists, dataframes, ndarrays, sparse matrices}\n 510 |         List of objects to ensure sliceability.\n 511 | \n 512 |     Returns\n 513 |     -------\n 514 |     result : list of {ndarray, sparse matrix, dataframe} or None\n 515 |         Returns a list containing indexable arrays (i.e. NumPy array,\n 516 |         sparse matrix, or dataframe) or `None`.\n 517 | \n 518 |     Examples\n 519 |     --------\n 520 |     >>> from sklearn.utils import indexable\n 521 |     >>> from scipy.sparse import csr_matrix\n 522 |     >>> import numpy as np\n 523 |     >>> iterables = [\n 524 |     ...     [1, 2, 3], np.array([2, 3, 4]), None, csr_matrix([[5], [6], [7]])\n 525 |     ... ]\n 526 |     >>> indexable(*iterables)\n 527 |     [[1, 2, 3], array([2, 3, 4]), None, <...Sparse...dtype 'int64'...shape (3, 1)>]\n 528 |     \"\"\"\n 529 | \n 530 |     result = [_make_indexable(X) for X in iterables]\n 531 |     check_consistent_length(*result)\n 532 |     return result\n 533 | \n 534 | \n 535 | def _ensure_sparse_format(\n 536 |     sparse_container,\n 537 |     accept_sparse,\n 538 |     dtype,\n 539 |     copy,\n 540 |     ensure_all_finite,\n 541 |     accept_large_sparse,\n 542 |     estimator_name=None,\n 543 |     input_name=\"\",\n 544 | ):\n 545 |     \"\"\"Convert a sparse container to a given format.\n 546 | \n 547 |     Checks the sparse format of `sparse_container` and converts if necessary.\n 548 | \n 549 |     Parameters\n 550 |     ----------\n 551 |     sparse_container : sparse matrix or array\n 552 |         Input to validate and convert.\n 553 | \n 554 |     accept_sparse : str, bool or list/tuple of str\n 555 |         String[s] representing allowed sparse matrix formats ('csc',\n 556 |         'csr', 'coo', 'dok', 'bsr', 'lil', 'dia'). If the input is sparse but\n 557 |         not in the allowed format, it will be converted to the first listed\n 558 |         format. True allows the input to be any format. False means\n 559 |         that a sparse matrix input will raise an error.\n 560 | \n 561 |     dtype : str, type or None\n 562 |         Data type of result. If None, the dtype of the input is preserved.\n 563 | \n 564 |     copy : bool\n 565 |         Whether a forced copy will be triggered. If copy=False, a copy might\n 566 |         be triggered by a conversion.\n 567 | \n 568 |     ensure_all_finite : bool or 'allow-nan'\n 569 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 570 |         possibilities are:\n 571 | \n 572 |         - True: Force all values of X to be finite.\n 573 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 574 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 575 |           be infinite.\n 576 | \n 577 |         .. versionadded:: 0.20\n 578 |            ``ensure_all_finite`` accepts the string ``'allow-nan'``.\n 579 | \n 580 |         .. versionchanged:: 0.23\n 581 |            Accepts `pd.NA` and converts it into `np.nan`\n 582 | \n 583 | \n 584 |     estimator_name : str, default=None\n 585 |         The estimator name, used to construct the error message.\n 586 | \n 587 |     input_name : str, default=\"\"\n 588 |         The data name used to construct the error message. In particular\n 589 |         if `input_name` is \"X\" and the data has NaN values and\n 590 |         allow_nan is False, the error message will link to the imputer\n 591 |         documentation.\n 592 | \n 593 |     Returns\n 594 |     -------\n 595 |     sparse_container_converted : sparse matrix or array\n 596 |         Sparse container (matrix/array) that is ensured to have an allowed type.\n 597 |     \"\"\"\n 598 |     if dtype is None:\n 599 |         dtype = sparse_container.dtype\n 600 | \n 601 |     changed_format = False\n 602 |     sparse_container_type_name = type(sparse_container).__name__\n 603 | \n 604 |     if isinstance(accept_sparse, str):\n 605 |         accept_sparse = [accept_sparse]\n 606 | \n 607 |     # Indices dtype validation\n 608 |     _check_large_sparse(sparse_container, accept_large_sparse)\n 609 | \n 610 |     if accept_sparse is False:\n 611 |         padded_input = \" for \" + input_name if input_name else \"\"\n 612 |         raise TypeError(\n 613 |             f\"Sparse data was passed{padded_input}, but dense data is required. \"\n 614 |             \"Use '.toarray()' to convert to a dense numpy array.\"\n 615 |         )\n 616 |     elif isinstance(accept_sparse, (list, tuple)):\n 617 |         if len(accept_sparse) == 0:\n 618 |             raise ValueError(\n 619 |                 \"When providing 'accept_sparse' as a tuple or list, it must contain at \"\n 620 |                 \"least one string value.\"\n 621 |             )\n 622 |         # ensure correct sparse format\n 623 |         if sparse_container.format not in accept_sparse:\n 624 |             # create new with correct sparse\n 625 |             sparse_container = sparse_container.asformat(accept_sparse[0])\n 626 |             changed_format = True\n 627 |     elif accept_sparse is not True:\n 628 |         # any other type\n 629 |         raise ValueError(\n 630 |             \"Parameter 'accept_sparse' should be a string, boolean or list of strings.\"\n 631 |             f\" You provided 'accept_sparse={accept_sparse}'.\"\n 632 |         )\n 633 | \n 634 |     if dtype != sparse_container.dtype:\n 635 |         # convert dtype\n 636 |         sparse_container = sparse_container.astype(dtype)\n 637 |     elif copy and not changed_format:\n 638 |         # force copy\n 639 |         sparse_container = sparse_container.copy()\n 640 | \n 641 |     if ensure_all_finite:\n 642 |         if not hasattr(sparse_container, \"data\"):\n 643 |             warnings.warn(\n 644 |                 f\"Can't check {sparse_container.format} sparse matrix for nan or inf.\",\n 645 |                 stacklevel=2,\n 646 |             )\n 647 |         else:\n 648 |             _assert_all_finite(\n 649 |                 sparse_container.data,\n 650 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n 651 |                 estimator_name=estimator_name,\n 652 |                 input_name=input_name,\n 653 |             )\n 654 | \n 655 |     # TODO: Remove when the minimum version of SciPy supported is 1.12\n 656 |     # With SciPy sparse arrays, conversion from DIA format to COO, CSR, or BSR\n 657 |     # triggers the use of `np.int64` indices even if the data is such that it could\n 658 |     # be more efficiently represented with `np.int32` indices.\n 659 |     # https://github.com/scipy/scipy/issues/19245 Since not all scikit-learn\n 660 |     # algorithms support large indices, the following code downcasts to `np.int32`\n 661 |     # indices when it's safe to do so.\n 662 |     if changed_format:\n 663 |         # accept_sparse is specified to a specific format and a conversion occurred\n 664 |         requested_sparse_format = accept_sparse[0]\n 665 |         _preserve_dia_indices_dtype(\n 666 |             sparse_container, sparse_container_type_name, requested_sparse_format\n 667 |         )\n 668 | \n 669 |     return sparse_container\n 670 | \n 671 | \n 672 | def _ensure_no_complex_data(array):\n 673 |     if (\n 674 |         hasattr(array, \"dtype\")\n 675 |         and array.dtype is not None\n 676 |         and hasattr(array.dtype, \"kind\")\n 677 |         and array.dtype.kind == \"c\"\n 678 |     ):\n 679 |         raise ValueError(\"Complex data not supported\\n{}\\n\".format(array))\n 680 | \n 681 | \n 682 | def _check_estimator_name(estimator):\n 683 |     if estimator is not None:\n 684 |         if isinstance(estimator, str):\n 685 |             return estimator\n 686 |         else:\n 687 |             return estimator.__class__.__name__\n 688 |     return None\n 689 | \n 690 | \n 691 | def _pandas_dtype_needs_early_conversion(pd_dtype):\n 692 |     \"\"\"Return True if pandas extension pd_dtype need to be converted early.\"\"\"\n 693 |     # Check these early for pandas versions without extension dtypes\n 694 |     from pandas import SparseDtype\n 695 |     from pandas.api.types import (\n 696 |         is_bool_dtype,\n 697 |         is_float_dtype,\n 698 |         is_integer_dtype,\n 699 |     )\n 700 | \n 701 |     if is_bool_dtype(pd_dtype):\n 702 |         # bool and extension booleans need early conversion because __array__\n 703 |         # converts mixed dtype dataframes into object dtypes\n 704 |         return True\n 705 | \n 706 |     if isinstance(pd_dtype, SparseDtype):\n 707 |         # Sparse arrays will be converted later in `check_array`\n 708 |         return False\n 709 | \n 710 |     try:\n 711 |         from pandas.api.types import is_extension_array_dtype\n 712 |     except ImportError:\n 713 |         return False\n 714 | \n 715 |     if isinstance(pd_dtype, SparseDtype) or not is_extension_array_dtype(pd_dtype):\n 716 |         # Sparse arrays will be converted later in `check_array`\n 717 |         # Only handle extension arrays for integer and floats\n 718 |         return False\n 719 |     elif is_float_dtype(pd_dtype):\n 720 |         # Float ndarrays can normally support nans. They need to be converted\n 721 |         # first to map pd.NA to np.nan\n 722 |         return True\n 723 |     elif is_integer_dtype(pd_dtype):\n 724 |         # XXX: Warn when converting from a high integer to a float\n 725 |         return True\n 726 | \n 727 |     return False\n 728 | \n 729 | \n 730 | def _is_extension_array_dtype(array):\n 731 |     # Pandas extension arrays have a dtype with an na_value\n 732 |     return hasattr(array, \"dtype\") and hasattr(array.dtype, \"na_value\")\n 733 | \n 734 | \n 735 | def check_array(\n 736 |     array,\n 737 |     accept_sparse=False,\n 738 |     *,\n 739 |     accept_large_sparse=True,\n 740 |     dtype=\"numeric\",\n 741 |     order=None,\n 742 |     copy=False,\n 743 |     force_writeable=False,\n 744 |     force_all_finite=\"deprecated\",\n 745 |     ensure_all_finite=None,\n 746 |     ensure_non_negative=False,\n 747 |     ensure_2d=True,\n 748 |     allow_nd=False,\n 749 |     ensure_min_samples=1,\n 750 |     ensure_min_features=1,\n 751 |     estimator=None,\n 752 |     input_name=\"\",\n 753 | ):\n 754 |     \"\"\"Input validation on an array, list, sparse matrix or similar.\n 755 | \n 756 |     By default, the input is checked to be a non-empty 2D array containing\n 757 |     only finite values. If the dtype of the array is object, attempt\n 758 |     converting to float, raising on failure.\n 759 | \n 760 |     Parameters\n 761 |     ----------\n 762 |     array : object\n 763 |         Input object to check / convert.\n 764 | \n 765 |     accept_sparse : str, bool or list/tuple of str, default=False\n 766 |         String[s] representing allowed sparse matrix formats, such as 'csc',\n 767 |         'csr', etc. If the input is sparse but not in the allowed format,\n 768 |         it will be converted to the first listed format. True allows the input\n 769 |         to be any format. False means that a sparse matrix input will\n 770 |         raise an error.\n 771 | \n 772 |     accept_large_sparse : bool, default=True\n 773 |         If a CSR, CSC, COO or BSR sparse matrix is supplied and accepted by\n 774 |         accept_sparse, accept_large_sparse=False will cause it to be accepted\n 775 |         only if its indices are stored with a 32-bit dtype.\n 776 | \n 777 |         .. versionadded:: 0.20\n 778 | \n 779 |     dtype : 'numeric', type, list of type or None, default='numeric'\n 780 |         Data type of result. If None, the dtype of the input is preserved.\n 781 |         If \"numeric\", dtype is preserved unless array.dtype is object.\n 782 |         If dtype is a list of types, conversion on the first type is only\n 783 |         performed if the dtype of the input is not in the list.\n 784 | \n 785 |     order : {'F', 'C'} or None, default=None\n 786 |         Whether an array will be forced to be fortran or c-style.\n 787 |         When order is None (default), then if copy=False, nothing is ensured\n 788 |         about the memory layout of the output array; otherwise (copy=True)\n 789 |         the memory layout of the returned array is kept as close as possible\n 790 |         to the original array.\n 791 | \n 792 |     copy : bool, default=False\n 793 |         Whether a forced copy will be triggered. If copy=False, a copy might\n 794 |         be triggered by a conversion.\n 795 | \n 796 |     force_writeable : bool, default=False\n 797 |         Whether to force the output array to be writeable. If True, the returned array\n 798 |         is guaranteed to be writeable, which may require a copy. Otherwise the\n 799 |         writeability of the input array is preserved.\n 800 | \n 801 |         .. versionadded:: 1.6\n 802 | \n 803 |     force_all_finite : bool or 'allow-nan', default=True\n 804 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 805 |         possibilities are:\n 806 | \n 807 |         - True: Force all values of array to be finite.\n 808 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 809 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 810 |           cannot be infinite.\n 811 | \n 812 |         .. versionadded:: 0.20\n 813 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n 814 | \n 815 |         .. versionchanged:: 0.23\n 816 |            Accepts `pd.NA` and converts it into `np.nan`\n 817 | \n 818 |         .. deprecated:: 1.6\n 819 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n 820 |            in 1.8.\n 821 | \n 822 |     ensure_all_finite : bool or 'allow-nan', default=True\n 823 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 824 |         possibilities are:\n 825 | \n 826 |         - True: Force all values of array to be finite.\n 827 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 828 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 829 |           cannot be infinite.\n 830 | \n 831 |         .. versionadded:: 1.6\n 832 |            `force_all_finite` was renamed to `ensure_all_finite`.\n 833 | \n 834 |     ensure_non_negative : bool, default=False\n 835 |         Make sure the array has only non-negative values. If True, an array that\n 836 |         contains negative values will raise a ValueError.\n 837 | \n 838 |         .. versionadded:: 1.6\n 839 | \n 840 |     ensure_2d : bool, default=True\n 841 |         Whether to raise a value error if array is not 2D.\n 842 | \n 843 |     allow_nd : bool, default=False\n 844 |         Whether to allow array.ndim > 2.\n 845 | \n 846 |     ensure_min_samples : int, default=1\n 847 |         Make sure that the array has a minimum number of samples in its first\n 848 |         axis (rows for a 2D array). Setting to 0 disables this check.\n 849 | \n 850 |     ensure_min_features : int, default=1\n 851 |         Make sure that the 2D array has some minimum number of features\n 852 |         (columns). The default value of 1 rejects empty datasets.\n 853 |         This check is only enforced when the input data has effectively 2\n 854 |         dimensions or is originally 1D and ``ensure_2d`` is True. Setting to 0\n 855 |         disables this check.\n 856 | \n 857 |     estimator : str or estimator instance, default=None\n 858 |         If passed, include the name of the estimator in warning messages.\n 859 | \n 860 |     input_name : str, default=\"\"\n 861 |         The data name used to construct the error message. In particular\n 862 |         if `input_name` is \"X\" and the data has NaN values and\n 863 |         allow_nan is False, the error message will link to the imputer\n 864 |         documentation.\n 865 | \n 866 |         .. versionadded:: 1.1.0\n 867 | \n 868 |     Returns\n 869 |     -------\n 870 |     array_converted : object\n 871 |         The converted and validated array.\n 872 | \n 873 |     Examples\n 874 |     --------\n 875 |     >>> from sklearn.utils.validation import check_array\n 876 |     >>> X = [[1, 2, 3], [4, 5, 6]]\n 877 |     >>> X_checked = check_array(X)\n 878 |     >>> X_checked\n 879 |     array([[1, 2, 3], [4, 5, 6]])\n 880 |     \"\"\"\n 881 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n 882 | \n 883 |     if isinstance(array, np.matrix):\n 884 |         raise TypeError(\n 885 |             \"np.matrix is not supported. Please convert to a numpy array with \"\n 886 |             \"np.asarray. For more information see: \"\n 887 |             \"https://numpy.org/doc/stable/reference/generated/numpy.matrix.html\"\n 888 |         )\n 889 | \n 890 |     xp, is_array_api_compliant = get_namespace(array)\n 891 | \n 892 |     # store reference to original array to check if copy is needed when\n 893 |     # function returns\n 894 |     array_orig = array\n 895 | \n 896 |     # store whether originally we wanted numeric dtype\n 897 |     dtype_numeric = isinstance(dtype, str) and dtype == \"numeric\"\n 898 | \n 899 |     dtype_orig = getattr(array, \"dtype\", None)\n 900 |     if not is_array_api_compliant and not hasattr(dtype_orig, \"kind\"):\n 901 |         # not a data type (e.g. a column named dtype in a pandas DataFrame)\n 902 |         dtype_orig = None\n 903 | \n 904 |     # check if the object contains several dtypes (typically a pandas\n 905 |     # DataFrame), and store them. If not, store None.\n 906 |     dtypes_orig = None\n 907 |     pandas_requires_conversion = False\n 908 |     # track if we have a Series-like object to raise a better error message\n 909 |     type_if_series = None\n 910 |     if hasattr(array, \"dtypes\") and hasattr(array.dtypes, \"__array__\"):\n 911 |         # throw warning if columns are sparse. If all columns are sparse, then\n 912 |         # array.sparse exists and sparsity will be preserved (later).\n 913 |         with suppress(ImportError):\n 914 |             from pandas import SparseDtype\n 915 | \n 916 |             def is_sparse(dtype):\n 917 |                 return isinstance(dtype, SparseDtype)\n 918 | \n 919 |             if not hasattr(array, \"sparse\") and array.dtypes.apply(is_sparse).any():\n 920 |                 warnings.warn(\n 921 |                     \"pandas.DataFrame with sparse columns found.\"\n 922 |                     \"It will be converted to a dense numpy array.\"\n 923 |                 )\n 924 | \n 925 |         dtypes_orig = list(array.dtypes)\n 926 |         pandas_requires_conversion = any(\n 927 |             _pandas_dtype_needs_early_conversion(i) for i in dtypes_orig\n 928 |         )\n 929 |         if all(isinstance(dtype_iter, np.dtype) for dtype_iter in dtypes_orig):\n 930 |             dtype_orig = np.result_type(*dtypes_orig)\n 931 |         elif pandas_requires_conversion and any(d == object for d in dtypes_orig):\n 932 |             # Force object if any of the dtypes is an object\n 933 |             dtype_orig = object\n 934 | \n 935 |     elif (_is_extension_array_dtype(array) or hasattr(array, \"iloc\")) and hasattr(\n 936 |         array, \"dtype\"\n 937 |     ):\n 938 |         # array is a pandas series\n 939 |         type_if_series = type(array)\n 940 |         pandas_requires_conversion = _pandas_dtype_needs_early_conversion(array.dtype)\n 941 |         if isinstance(array.dtype, np.dtype):\n 942 |             dtype_orig = array.dtype\n 943 |         else:\n 944 |             # Set to None to let array.astype work out the best dtype\n 945 |             dtype_orig = None\n 946 | \n 947 |     if dtype_numeric:\n 948 |         if (\n 949 |             dtype_orig is not None\n 950 |             and hasattr(dtype_orig, \"kind\")\n 951 |             and dtype_orig.kind == \"O\"\n 952 |         ):\n 953 |             # if input is object, convert to float.\n 954 |             dtype = xp.float64\n 955 |         else:\n 956 |             dtype = None\n 957 | \n 958 |     if isinstance(dtype, (list, tuple)):\n 959 |         if dtype_orig is not None and dtype_orig in dtype:\n 960 |             # no dtype conversion required\n 961 |             dtype = None\n 962 |         else:\n 963 |             # dtype conversion required. Let's select the first element of the\n 964 |             # list of accepted types.\n 965 |             dtype = dtype[0]\n 966 | \n 967 |     if pandas_requires_conversion:\n 968 |         # pandas dataframe requires conversion earlier to handle extension dtypes with\n 969 |         # nans\n 970 |         # Use the original dtype for conversion if dtype is None\n 971 |         new_dtype = dtype_orig if dtype is None else dtype\n 972 |         array = array.astype(new_dtype)\n 973 |         # Since we converted here, we do not need to convert again later\n 974 |         dtype = None\n 975 | \n 976 |     if ensure_all_finite not in (True, False, \"allow-nan\"):\n 977 |         raise ValueError(\n 978 |             \"ensure_all_finite should be a bool or 'allow-nan'. Got \"\n 979 |             f\"{ensure_all_finite!r} instead.\"\n 980 |         )\n 981 | \n 982 |     if dtype is not None and _is_numpy_namespace(xp):\n 983 |         # convert to dtype object to conform to Array API to be use `xp.isdtype` later\n 984 |         dtype = np.dtype(dtype)\n 985 | \n 986 |     estimator_name = _check_estimator_name(estimator)\n 987 |     context = \" by %s\" % estimator_name if estimator is not None else \"\"\n 988 | \n 989 |     # When all dataframe columns are sparse, convert to a sparse array\n 990 |     if hasattr(array, \"sparse\") and array.ndim > 1:\n 991 |         with suppress(ImportError):\n 992 |             from pandas import SparseDtype  # noqa: F811\n 993 | \n 994 |             def is_sparse(dtype):\n 995 |                 return isinstance(dtype, SparseDtype)\n 996 | \n 997 |             if array.dtypes.apply(is_sparse).all():\n 998 |                 # DataFrame.sparse only supports `to_coo`\n 999 |                 array = array.sparse.to_coo()\n1000 |                 if array.dtype == np.dtype(\"object\"):\n1001 |                     unique_dtypes = set([dt.subtype.name for dt in array_orig.dtypes])\n1002 |                     if len(unique_dtypes) > 1:\n1003 |                         raise ValueError(\n1004 |                             \"Pandas DataFrame with mixed sparse extension arrays \"\n1005 |                             \"generated a sparse matrix with object dtype which \"\n1006 |                             \"can not be converted to a scipy sparse matrix.\"\n1007 |                             \"Sparse extension arrays should all have the same \"\n1008 |                             \"numeric type.\"\n1009 |                         )\n1010 | \n1011 |     if sp.issparse(array):\n1012 |         _ensure_no_complex_data(array)\n1013 |         array = _ensure_sparse_format(\n1014 |             array,\n1015 |             accept_sparse=accept_sparse,\n1016 |             dtype=dtype,\n1017 |             copy=copy,\n1018 |             ensure_all_finite=ensure_all_finite,\n1019 |             accept_large_sparse=accept_large_sparse,\n1020 |             estimator_name=estimator_name,\n1021 |             input_name=input_name,\n1022 |         )\n1023 |         if ensure_2d and array.ndim < 2:\n1024 |             raise ValueError(\n1025 |                 f\"Expected 2D input, got input with shape {array.shape}.\\n\"\n1026 |                 \"Reshape your data either using array.reshape(-1, 1) if \"\n1027 |                 \"your data has a single feature or array.reshape(1, -1) \"\n1028 |                 \"if it contains a single sample.\"\n1029 |             )\n1030 |     else:\n1031 |         # If np.array(..) gives ComplexWarning, then we convert the warning\n1032 |         # to an error. This is needed because specifying a non complex\n1033 |         # dtype to the function converts complex to real dtype,\n1034 |         # thereby passing the test made in the lines following the scope\n1035 |         # of warnings context manager.\n1036 |         with warnings.catch_warnings():\n1037 |             try:\n1038 |                 warnings.simplefilter(\"error\", ComplexWarning)\n1039 |                 if dtype is not None and xp.isdtype(dtype, \"integral\"):\n1040 |                     # Conversion float -> int should not contain NaN or\n1041 |                     # inf (numpy#14412). We cannot use casting='safe' because\n1042 |                     # then conversion float -> int would be disallowed.\n1043 |                     array = _asarray_with_order(array, order=order, xp=xp)\n1044 |                     if xp.isdtype(array.dtype, (\"real floating\", \"complex floating\")):\n1045 |                         _assert_all_finite(\n1046 |                             array,\n1047 |                             allow_nan=False,\n1048 |                             msg_dtype=dtype,\n1049 |                             estimator_name=estimator_name,\n1050 |                             input_name=input_name,\n1051 |                         )\n1052 |                     array = xp.astype(array, dtype, copy=False)\n1053 |                 else:\n1054 |                     array = _asarray_with_order(array, order=order, dtype=dtype, xp=xp)\n1055 |             except ComplexWarning as complex_warning:\n1056 |                 raise ValueError(\n1057 |                     \"Complex data not supported\\n{}\\n\".format(array)\n1058 |                 ) from complex_warning\n1059 | \n1060 |         # It is possible that the np.array(..) gave no warning. This happens\n1061 |         # when no dtype conversion happened, for example dtype = None. The\n1062 |         # result is that np.array(..) produces an array of complex dtype\n1063 |         # and we need to catch and raise exception for such cases.\n1064 |         _ensure_no_complex_data(array)\n1065 | \n1066 |         if ensure_2d:\n1067 |             # If input is scalar raise error\n1068 |             if array.ndim == 0:\n1069 |                 raise ValueError(\n1070 |                     \"Expected 2D array, got scalar array instead:\\narray={}.\\n\"\n1071 |                     \"Reshape your data either using array.reshape(-1, 1) if \"\n1072 |                     \"your data has a single feature or array.reshape(1, -1) \"\n1073 |                     \"if it contains a single sample.\".format(array)\n1074 |                 )\n1075 |             # If input is 1D raise error\n1076 |             if array.ndim == 1:\n1077 |                 # If input is a Series-like object (eg. pandas Series or polars Series)\n1078 |                 if type_if_series is not None:\n1079 |                     msg = (\n1080 |                         f\"Expected a 2-dimensional container but got {type_if_series} \"\n1081 |                         \"instead. Pass a DataFrame containing a single row (i.e. \"\n1082 |                         \"single sample) or a single column (i.e. single feature) \"\n1083 |                         \"instead.\"\n1084 |                     )\n1085 |                 else:\n1086 |                     msg = (\n1087 |                         f\"Expected 2D array, got 1D array instead:\\narray={array}.\\n\"\n1088 |                         \"Reshape your data either using array.reshape(-1, 1) if \"\n1089 |                         \"your data has a single feature or array.reshape(1, -1) \"\n1090 |                         \"if it contains a single sample.\"\n1091 |                     )\n1092 |                 raise ValueError(msg)\n1093 | \n1094 |         if dtype_numeric and hasattr(array.dtype, \"kind\") and array.dtype.kind in \"USV\":\n1095 |             raise ValueError(\n1096 |                 \"dtype='numeric' is not compatible with arrays of bytes/strings.\"\n1097 |                 \"Convert your data to numeric values explicitly instead.\"\n1098 |             )\n1099 |         if not allow_nd and array.ndim >= 3:\n1100 |             raise ValueError(\n1101 |                 \"Found array with dim %d. %s expected <= 2.\"\n1102 |                 % (array.ndim, estimator_name)\n1103 |             )\n1104 | \n1105 |         if ensure_all_finite:\n1106 |             _assert_all_finite(\n1107 |                 array,\n1108 |                 input_name=input_name,\n1109 |                 estimator_name=estimator_name,\n1110 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n1111 |             )\n1112 | \n1113 |         if copy:\n1114 |             if _is_numpy_namespace(xp):\n1115 |                 # only make a copy if `array` and `array_orig` may share memory`\n1116 |                 if np.may_share_memory(array, array_orig):\n1117 |                     array = _asarray_with_order(\n1118 |                         array, dtype=dtype, order=order, copy=True, xp=xp\n1119 |                     )\n1120 |             else:\n1121 |                 # always make a copy for non-numpy arrays\n1122 |                 array = _asarray_with_order(\n1123 |                     array, dtype=dtype, order=order, copy=True, xp=xp\n1124 |                 )\n1125 | \n1126 |     if ensure_min_samples > 0:\n1127 |         n_samples = _num_samples(array)\n1128 |         if n_samples < ensure_min_samples:\n1129 |             raise ValueError(\n1130 |                 \"Found array with %d sample(s) (shape=%s) while a\"\n1131 |                 \" minimum of %d is required%s.\"\n1132 |                 % (n_samples, array.shape, ensure_min_samples, context)\n1133 |             )\n1134 | \n1135 |     if ensure_min_features > 0 and array.ndim == 2:\n1136 |         n_features = array.shape[1]\n1137 |         if n_features < ensure_min_features:\n1138 |             raise ValueError(\n1139 |                 \"Found array with %d feature(s) (shape=%s) while\"\n1140 |                 \" a minimum of %d is required%s.\"\n1141 |                 % (n_features, array.shape, ensure_min_features, context)\n1142 |             )\n1143 | \n1144 |     if ensure_non_negative:\n1145 |         whom = input_name\n1146 |         if estimator_name:\n1147 |             whom += f\" in {estimator_name}\"\n1148 |         check_non_negative(array, whom)\n1149 | \n1150 |     if force_writeable:\n1151 |         # By default, array.copy() creates a C-ordered copy. We set order=K to\n1152 |         # preserve the order of the array.\n1153 |         copy_params = {\"order\": \"K\"} if not sp.issparse(array) else {}\n1154 | \n1155 |         array_data = array.data if sp.issparse(array) else array\n1156 |         flags = getattr(array_data, \"flags\", None)\n1157 |         if not getattr(flags, \"writeable\", True):\n1158 |             # This situation can only happen when copy=False, the array is read-only and\n1159 |             # a writeable output is requested. This is an ambiguous setting so we chose\n1160 |             # to always (except for one specific setting, see below) make a copy to\n1161 |             # ensure that the output is writeable, even if avoidable, to not overwrite\n1162 |             # the user's data by surprise.\n1163 | \n1164 |             if _is_pandas_df_or_series(array_orig):\n1165 |                 try:\n1166 |                     # In pandas >= 3, np.asarray(df), called earlier in check_array,\n1167 |                     # returns a read-only intermediate array. It can be made writeable\n1168 |                     # safely without copy because if the original DataFrame was backed\n1169 |                     # by a read-only array, trying to change the flag would raise an\n1170 |                     # error, in which case we make a copy.\n1171 |                     array_data.flags.writeable = True\n1172 |                 except ValueError:\n1173 |                     array = array.copy(**copy_params)\n1174 |             else:\n1175 |                 array = array.copy(**copy_params)\n1176 | \n1177 |     return array\n1178 | \n1179 | \n1180 | def _check_large_sparse(X, accept_large_sparse=False):\n1181 |     \"\"\"Raise a ValueError if X has 64bit indices and accept_large_sparse=False\"\"\"\n1182 |     if not accept_large_sparse:\n1183 |         supported_indices = [\"int32\"]\n1184 |         if X.format == \"coo\":\n1185 |             index_keys = [\"col\", \"row\"]\n1186 |         elif X.format in [\"csr\", \"csc\", \"bsr\"]:\n1187 |             index_keys = [\"indices\", \"indptr\"]\n1188 |         else:\n1189 |             return\n1190 |         for key in index_keys:\n1191 |             indices_datatype = getattr(X, key).dtype\n1192 |             if indices_datatype not in supported_indices:\n1193 |                 raise ValueError(\n1194 |                     \"Only sparse matrices with 32-bit integer indices are accepted.\"\n1195 |                     f\" Got {indices_datatype} indices. Please do report a minimal\"\n1196 |                     \" reproducer on scikit-learn issue tracker so that support for\"\n1197 |                     \" your use-case can be studied by maintainers. See:\"\n1198 |                     \" https://scikit-learn.org/dev/developers/minimal_reproducer.html\"\n1199 |                 )\n1200 | \n1201 | \n1202 | def check_X_y(\n1203 |     X,\n1204 |     y,\n1205 |     accept_sparse=False,\n1206 |     *,\n1207 |     accept_large_sparse=True,\n1208 |     dtype=\"numeric\",\n1209 |     order=None,\n1210 |     copy=False,\n1211 |     force_writeable=False,\n1212 |     force_all_finite=\"deprecated\",\n1213 |     ensure_all_finite=None,\n1214 |     ensure_2d=True,\n1215 |     allow_nd=False,\n1216 |     multi_output=False,\n1217 |     ensure_min_samples=1,\n1218 |     ensure_min_features=1,\n1219 |     y_numeric=False,\n1220 |     estimator=None,\n1221 | ):\n1222 |     \"\"\"Input validation for standard estimators.\n1223 | \n1224 |     Checks X and y for consistent length, enforces X to be 2D and y 1D. By\n1225 |     default, X is checked to be non-empty and containing only finite values.\n1226 |     Standard input checks are also applied to y, such as checking that y\n1227 |     does not have np.nan or np.inf targets. For multi-label y, set\n1228 |     multi_output=True to allow 2D and sparse y. If the dtype of X is\n1229 |     object, attempt converting to float, raising on failure.\n1230 | \n1231 |     Parameters\n1232 |     ----------\n1233 |     X : {ndarray, list, sparse matrix}\n1234 |         Input data.\n1235 | \n1236 |     y : {ndarray, list, sparse matrix}\n1237 |         Labels.\n1238 | \n1239 |     accept_sparse : str, bool or list of str, default=False\n1240 |         String[s] representing allowed sparse matrix formats, such as 'csc',\n1241 |         'csr', etc. If the input is sparse but not in the allowed format,\n1242 |         it will be converted to the first listed format. True allows the input\n1243 |         to be any format. False means that a sparse matrix input will\n1244 |         raise an error.\n1245 | \n1246 |     accept_large_sparse : bool, default=True\n1247 |         If a CSR, CSC, COO or BSR sparse matrix is supplied and accepted by\n1248 |         accept_sparse, accept_large_sparse will cause it to be accepted only\n1249 |         if its indices are stored with a 32-bit dtype.\n1250 | \n1251 |         .. versionadded:: 0.20\n1252 | \n1253 |     dtype : 'numeric', type, list of type or None, default='numeric'\n1254 |         Data type of result. If None, the dtype of the input is preserved.\n1255 |         If \"numeric\", dtype is preserved unless array.dtype is object.\n1256 |         If dtype is a list of types, conversion on the first type is only\n1257 |         performed if the dtype of the input is not in the list.\n1258 | \n1259 |     order : {'F', 'C'}, default=None\n1260 |         Whether an array will be forced to be fortran or c-style. If\n1261 |         `None`, then the input data's order is preserved when possible.\n1262 | \n1263 |     copy : bool, default=False\n1264 |         Whether a forced copy will be triggered. If copy=False, a copy might\n1265 |         be triggered by a conversion.\n1266 | \n1267 |     force_writeable : bool, default=False\n1268 |         Whether to force the output array to be writeable. If True, the returned array\n1269 |         is guaranteed to be writeable, which may require a copy. Otherwise the\n1270 |         writeability of the input array is preserved.\n1271 | \n1272 |         .. versionadded:: 1.6\n1273 | \n1274 |     force_all_finite : bool or 'allow-nan', default=True\n1275 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. This parameter\n1276 |         does not influence whether y can have np.inf, np.nan, pd.NA values.\n1277 |         The possibilities are:\n1278 | \n1279 |         - True: Force all values of X to be finite.\n1280 |         - False: accepts np.inf, np.nan, pd.NA in X.\n1281 |         - 'allow-nan': accepts only np.nan or pd.NA values in X. Values cannot\n1282 |           be infinite.\n1283 | \n1284 |         .. versionadded:: 0.20\n1285 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n1286 | \n1287 |         .. versionchanged:: 0.23\n1288 |            Accepts `pd.NA` and converts it into `np.nan`\n1289 | \n1290 |         .. deprecated:: 1.6\n1291 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n1292 |            in 1.8.\n1293 | \n1294 |     ensure_all_finite : bool or 'allow-nan', default=True\n1295 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. This parameter\n1296 |         does not influence whether y can have np.inf, np.nan, pd.NA values.\n1297 |         The possibilities are:\n1298 | \n1299 |         - True: Force all values of X to be finite.\n1300 |         - False: accepts np.inf, np.nan, pd.NA in X.\n1301 |         - 'allow-nan': accepts only np.nan or pd.NA values in X. Values cannot\n1302 |           be infinite.\n1303 | \n1304 |         .. versionadded:: 1.6\n1305 |            `force_all_finite` was renamed to `ensure_all_finite`.\n1306 | \n1307 |     ensure_2d : bool, default=True\n1308 |         Whether to raise a value error if X is not 2D.\n1309 | \n1310 |     allow_nd : bool, default=False\n1311 |         Whether to allow X.ndim > 2.\n1312 | \n1313 |     multi_output : bool, default=False\n1314 |         Whether to allow 2D y (array or sparse matrix). If false, y will be\n1315 |         validated as a vector. y cannot have np.nan or np.inf values if\n1316 |         multi_output=True.\n1317 | \n1318 |     ensure_min_samples : int, default=1\n1319 |         Make sure that X has a minimum number of samples in its first\n1320 |         axis (rows for a 2D array).\n1321 | \n1322 |     ensure_min_features : int, default=1\n1323 |         Make sure that the 2D array has some minimum number of features\n1324 |         (columns). The default value of 1 rejects empty datasets.\n1325 |         This check is only enforced when X has effectively 2 dimensions or\n1326 |         is originally 1D and ``ensure_2d`` is True. Setting to 0 disables\n1327 |         this check.\n1328 | \n1329 |     y_numeric : bool, default=False\n1330 |         Whether to ensure that y has a numeric type. If dtype of y is object,\n1331 |         it is converted to float64. Should only be used for regression\n1332 |         algorithms.\n1333 | \n1334 |     estimator : str or estimator instance, default=None\n1335 |         If passed, include the name of the estimator in warning messages.\n1336 | \n1337 |     Returns\n1338 |     -------\n1339 |     X_converted : object\n1340 |         The converted and validated X.\n1341 | \n1342 |     y_converted : object\n1343 |         The converted and validated y.\n1344 | \n1345 |     Examples\n1346 |     --------\n1347 |     >>> from sklearn.utils.validation import check_X_y\n1348 |     >>> X = [[1, 2], [3, 4], [5, 6]]\n1349 |     >>> y = [1, 2, 3]\n1350 |     >>> X, y = check_X_y(X, y)\n1351 |     >>> X\n1352 |     array([[1, 2],\n1353 |           [3, 4],\n1354 |           [5, 6]])\n1355 |     >>> y\n1356 |     array([1, 2, 3])\n1357 |     \"\"\"\n1358 |     if y is None:\n1359 |         if estimator is None:\n1360 |             estimator_name = \"estimator\"\n1361 |         else:\n1362 |             estimator_name = _check_estimator_name(estimator)\n1363 |         raise ValueError(\n1364 |             f\"{estimator_name} requires y to be passed, but the target y is None\"\n1365 |         )\n1366 | \n1367 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n1368 | \n1369 |     X = check_array(\n1370 |         X,\n1371 |         accept_sparse=accept_sparse,\n1372 |         accept_large_sparse=accept_large_sparse,\n1373 |         dtype=dtype,\n1374 |         order=order,\n1375 |         copy=copy,\n1376 |         force_writeable=force_writeable,\n1377 |         ensure_all_finite=ensure_all_finite,\n1378 |         ensure_2d=ensure_2d,\n1379 |         allow_nd=allow_nd,\n1380 |         ensure_min_samples=ensure_min_samples,\n1381 |         ensure_min_features=ensure_min_features,\n1382 |         estimator=estimator,\n1383 |         input_name=\"X\",\n1384 |     )\n1385 | \n1386 |     y = _check_y(y, multi_output=multi_output, y_numeric=y_numeric, estimator=estimator)\n1387 | \n1388 |     check_consistent_length(X, y)\n1389 | \n1390 |     return X, y\n1391 | \n1392 | \n1393 | def _check_y(y, multi_output=False, y_numeric=False, estimator=None):\n1394 |     \"\"\"Isolated part of check_X_y dedicated to y validation\"\"\"\n1395 |     if multi_output:\n1396 |         y = check_array(\n1397 |             y,\n1398 |             accept_sparse=\"csr\",\n1399 |             ensure_all_finite=True,\n1400 |             ensure_2d=False,\n1401 |             dtype=None,\n1402 |             input_name=\"y\",\n1403 |             estimator=estimator,\n1404 |         )\n1405 |     else:\n1406 |         estimator_name = _check_estimator_name(estimator)\n1407 |         y = column_or_1d(y, warn=True)\n1408 |         _assert_all_finite(y, input_name=\"y\", estimator_name=estimator_name)\n1409 |         _ensure_no_complex_data(y)\n1410 |     if y_numeric and hasattr(y.dtype, \"kind\") and y.dtype.kind == \"O\":\n1411 |         y = y.astype(np.float64)\n1412 | \n1413 |     return y\n1414 | \n1415 | \n1416 | def column_or_1d(y, *, dtype=None, warn=False):\n1417 |     \"\"\"Ravel column or 1d numpy array, else raises an error.\n1418 | \n1419 |     Parameters\n1420 |     ----------\n1421 |     y : array-like\n1422 |        Input data.\n1423 | \n1424 |     dtype : data-type, default=None\n1425 |         Data type for `y`.\n1426 | \n1427 |         .. versionadded:: 1.2\n1428 | \n1429 |     warn : bool, default=False\n1430 |        To control display of warnings.\n1431 | \n1432 |     Returns\n1433 |     -------\n1434 |     y : ndarray\n1435 |        Output data.\n1436 | \n1437 |     Raises\n1438 |     ------\n1439 |     ValueError\n1440 |         If `y` is not a 1D array or a 2D array with a single row or column.\n1441 | \n1442 |     Examples\n1443 |     --------\n1444 |     >>> from sklearn.utils.validation import column_or_1d\n1445 |     >>> column_or_1d([1, 1])\n1446 |     array([1, 1])\n1447 |     \"\"\"\n1448 |     xp, _ = get_namespace(y)\n1449 |     y = check_array(\n1450 |         y,\n1451 |         ensure_2d=False,\n1452 |         dtype=dtype,\n1453 |         input_name=\"y\",\n1454 |         ensure_all_finite=False,\n1455 |         ensure_min_samples=0,\n1456 |     )\n1457 | \n1458 |     shape = y.shape\n1459 |     if len(shape) == 1:\n1460 |         return _asarray_with_order(xp.reshape(y, (-1,)), order=\"C\", xp=xp)\n1461 |     if len(shape) == 2 and shape[1] == 1:\n1462 |         if warn:\n1463 |             warnings.warn(\n1464 |                 (\n1465 |                     \"A column-vector y was passed when a 1d array was\"\n1466 |                     \" expected. Please change the shape of y to \"\n1467 |                     \"(n_samples, ), for example using ravel().\"\n1468 |                 ),\n1469 |                 DataConversionWarning,\n1470 |                 stacklevel=2,\n1471 |             )\n1472 |         return _asarray_with_order(xp.reshape(y, (-1,)), order=\"C\", xp=xp)\n1473 | \n1474 |     raise ValueError(\n1475 |         \"y should be a 1d array, got an array of shape {} instead.\".format(shape)\n1476 |     )\n1477 | \n1478 | \n1479 | def check_random_state(seed):\n1480 |     \"\"\"Turn seed into a np.random.RandomState instance.\n1481 | \n1482 |     Parameters\n1483 |     ----------\n1484 |     seed : None, int or instance of RandomState\n1485 |         If seed is None, return the RandomState singleton used by np.random.\n1486 |         If seed is an int, return a new RandomState instance seeded with seed.\n1487 |         If seed is already a RandomState instance, return it.\n1488 |         Otherwise raise ValueError.\n1489 | \n1490 |     Returns\n1491 |     -------\n1492 |     :class:`numpy:numpy.random.RandomState`\n1493 |         The random state object based on `seed` parameter.\n1494 | \n1495 |     Examples\n1496 |     --------\n1497 |     >>> from sklearn.utils.validation import check_random_state\n1498 |     >>> check_random_state(42)\n1499 |     RandomState(MT19937) at 0x...\n1500 |     \"\"\"\n1501 |     if seed is None or seed is np.random:\n1502 |         return np.random.mtrand._rand\n1503 |     if isinstance(seed, numbers.Integral):\n1504 |         return np.random.RandomState(seed)\n1505 |     if isinstance(seed, np.random.RandomState):\n1506 |         return seed\n1507 |     raise ValueError(\n1508 |         \"%r cannot be used to seed a numpy.random.RandomState instance\" % seed\n1509 |     )\n1510 | \n1511 | \n1512 | def has_fit_parameter(estimator, parameter):\n1513 |     \"\"\"Check whether the estimator's fit method supports the given parameter.\n1514 | \n1515 |     Parameters\n1516 |     ----------\n1517 |     estimator : object\n1518 |         An estimator to inspect.\n1519 | \n1520 |     parameter : str\n1521 |         The searched parameter.\n1522 | \n1523 |     Returns\n1524 |     -------\n1525 |     is_parameter : bool\n1526 |         Whether the parameter was found to be a named parameter of the\n1527 |         estimator's fit method.\n1528 | \n1529 |     Examples\n1530 |     --------\n1531 |     >>> from sklearn.svm import SVC\n1532 |     >>> from sklearn.utils.validation import has_fit_parameter\n1533 |     >>> has_fit_parameter(SVC(), \"sample_weight\")\n1534 |     True\n1535 |     \"\"\"\n1536 |     return (\n1537 |         # This is used during test collection in common tests. The\n1538 |         # hasattr(estimator, \"fit\") makes it so that we don't fail for an estimator\n1539 |         # that does not have a `fit` method during collection of checks. The right\n1540 |         # checks will fail later.\n1541 |         hasattr(estimator, \"fit\")\n1542 |         and parameter in signature(estimator.fit).parameters\n1543 |     )\n1544 | \n1545 | \n1546 | def check_symmetric(array, *, tol=1e-10, raise_warning=True, raise_exception=False):\n1547 |     \"\"\"Make sure that array is 2D, square and symmetric.\n1548 | \n1549 |     If the array is not symmetric, then a symmetrized version is returned.\n1550 |     Optionally, a warning or exception is raised if the matrix is not\n1551 |     symmetric.\n1552 | \n1553 |     Parameters\n1554 |     ----------\n1555 |     array : {ndarray, sparse matrix}\n1556 |         Input object to check / convert. Must be two-dimensional and square,\n1557 |         otherwise a ValueError will be raised.\n1558 | \n1559 |     tol : float, default=1e-10\n1560 |         Absolute tolerance for equivalence of arrays. Default = 1E-10.\n1561 | \n1562 |     raise_warning : bool, default=True\n1563 |         If True then raise a warning if conversion is required.\n1564 | \n1565 |     raise_exception : bool, default=False\n1566 |         If True then raise an exception if array is not symmetric.\n1567 | \n1568 |     Returns\n1569 |     -------\n1570 |     array_sym : {ndarray, sparse matrix}\n1571 |         Symmetrized version of the input array, i.e. the average of array\n1572 |         and array.transpose(). If sparse, then duplicate entries are first\n1573 |         summed and zeros are eliminated.\n1574 | \n1575 |     Examples\n1576 |     --------\n1577 |     >>> import numpy as np\n1578 |     >>> from sklearn.utils.validation import check_symmetric\n1579 |     >>> symmetric_array = np.array([[0, 1, 2], [1, 0, 1], [2, 1, 0]])\n1580 |     >>> check_symmetric(symmetric_array)\n1581 |     array([[0, 1, 2],\n1582 |            [1, 0, 1],\n1583 |            [2, 1, 0]])\n1584 |     >>> from scipy.sparse import csr_matrix\n1585 |     >>> sparse_symmetric_array = csr_matrix(symmetric_array)\n1586 |     >>> check_symmetric(sparse_symmetric_array)\n1587 |     <Compressed Sparse Row sparse matrix of dtype 'int64'\n1588 |         with 6 stored elements and shape (3, 3)>\n1589 |     \"\"\"\n1590 |     if (array.ndim != 2) or (array.shape[0] != array.shape[1]):\n1591 |         raise ValueError(\n1592 |             \"array must be 2-dimensional and square. shape = {0}\".format(array.shape)\n1593 |         )\n1594 | \n1595 |     if sp.issparse(array):\n1596 |         diff = array - array.T\n1597 |         # only csr, csc, and coo have `data` attribute\n1598 |         if diff.format not in [\"csr\", \"csc\", \"coo\"]:\n1599 |             diff = diff.tocsr()\n1600 |         symmetric = np.all(abs(diff.data) < tol)\n1601 |     else:\n1602 |         symmetric = np.allclose(array, array.T, atol=tol)\n1603 | \n1604 |     if not symmetric:\n1605 |         if raise_exception:\n1606 |             raise ValueError(\"Array must be symmetric\")\n1607 |         if raise_warning:\n1608 |             warnings.warn(\n1609 |                 (\n1610 |                     \"Array is not symmetric, and will be converted \"\n1611 |                     \"to symmetric by average with its transpose.\"\n1612 |                 ),\n1613 |                 stacklevel=2,\n1614 |             )\n1615 |         if sp.issparse(array):\n1616 |             conversion = \"to\" + array.format\n1617 |             array = getattr(0.5 * (array + array.T), conversion)()\n1618 |         else:\n1619 |             array = 0.5 * (array + array.T)\n1620 | \n1621 |     return array\n1622 | \n1623 | \n1624 | def _is_fitted(estimator, attributes=None, all_or_any=all):\n1625 |     \"\"\"Determine if an estimator is fitted\n1626 | \n1627 |     Parameters\n1628 |     ----------\n1629 |     estimator : estimator instance\n1630 |         Estimator instance for which the check is performed.\n1631 | \n1632 |     attributes : str, list or tuple of str, default=None\n1633 |         Attribute name(s) given as string or a list/tuple of strings\n1634 |         Eg.: ``[\"coef_\", \"estimator_\", ...], \"coef_\"``\n1635 | \n1636 |         If `None`, `estimator` is considered fitted if there exist an\n1637 |         attribute that ends with a underscore and does not start with double\n1638 |         underscore.\n1639 | \n1640 |     all_or_any : callable, {all, any}, default=all\n1641 |         Specify whether all or any of the given attributes must exist.\n1642 | \n1643 |     Returns\n1644 |     -------\n1645 |     fitted : bool\n1646 |         Whether the estimator is fitted.\n1647 |     \"\"\"\n1648 |     if attributes is not None:\n1649 |         if not isinstance(attributes, (list, tuple)):\n1650 |             attributes = [attributes]\n1651 |         return all_or_any([hasattr(estimator, attr) for attr in attributes])\n1652 | \n1653 |     if hasattr(estimator, \"__sklearn_is_fitted__\"):\n1654 |         return estimator.__sklearn_is_fitted__()\n1655 | \n1656 |     fitted_attrs = [\n1657 |         v for v in vars(estimator) if v.endswith(\"_\") and not v.startswith(\"__\")\n1658 |     ]\n1659 |     return len(fitted_attrs) > 0\n1660 | \n1661 | \n1662 | def check_is_fitted(estimator, attributes=None, *, msg=None, all_or_any=all):\n1663 |     \"\"\"Perform is_fitted validation for estimator.\n1664 | \n1665 |     Checks if the estimator is fitted by verifying the presence of\n1666 |     fitted attributes (ending with a trailing underscore) and otherwise\n1667 |     raises a :class:`~sklearn.exceptions.NotFittedError` with the given message.\n1668 | \n1669 |     If an estimator does not set any attributes with a trailing underscore, it\n1670 |     can define a ``__sklearn_is_fitted__`` method returning a boolean to\n1671 |     specify if the estimator is fitted or not. See\n1672 |     :ref:`sphx_glr_auto_examples_developing_estimators_sklearn_is_fitted.py`\n1673 |     for an example on how to use the API.\n1674 | \n1675 |     If no `attributes` are passed, this fuction will pass if an estimator is stateless.\n1676 |     An estimator can indicate it's stateless by setting the `requires_fit` tag. See\n1677 |     :ref:`estimator_tags` for more information. Note that the `requires_fit` tag\n1678 |     is ignored if `attributes` are passed.\n1679 | \n1680 |     Parameters\n1681 |     ----------\n1682 |     estimator : estimator instance\n1683 |         Estimator instance for which the check is performed.\n1684 | \n1685 |     attributes : str, list or tuple of str, default=None\n1686 |         Attribute name(s) given as string or a list/tuple of strings\n1687 |         Eg.: ``[\"coef_\", \"estimator_\", ...], \"coef_\"``\n1688 | \n1689 |         If `None`, `estimator` is considered fitted if there exist an\n1690 |         attribute that ends with a underscore and does not start with double\n1691 |         underscore.\n1692 | \n1693 |     msg : str, default=None\n1694 |         The default error message is, \"This %(name)s instance is not fitted\n1695 |         yet. Call 'fit' with appropriate arguments before using this\n1696 |         estimator.\"\n1697 | \n1698 |         For custom messages if \"%(name)s\" is present in the message string,\n1699 |         it is substituted for the estimator name.\n1700 | \n1701 |         Eg. : \"Estimator, %(name)s, must be fitted before sparsifying\".\n1702 | \n1703 |     all_or_any : callable, {all, any}, default=all\n1704 |         Specify whether all or any of the given attributes must exist.\n1705 | \n1706 |     Raises\n1707 |     ------\n1708 |     TypeError\n1709 |         If the estimator is a class or not an estimator instance\n1710 | \n1711 |     NotFittedError\n1712 |         If the attributes are not found.\n1713 | \n1714 |     Examples\n1715 |     --------\n1716 |     >>> from sklearn.linear_model import LogisticRegression\n1717 |     >>> from sklearn.utils.validation import check_is_fitted\n1718 |     >>> from sklearn.exceptions import NotFittedError\n1719 |     >>> lr = LogisticRegression()\n1720 |     >>> try:\n1721 |     ...     check_is_fitted(lr)\n1722 |     ... except NotFittedError as exc:\n1723 |     ...     print(f\"Model is not fitted yet.\")\n1724 |     Model is not fitted yet.\n1725 |     >>> lr.fit([[1, 2], [1, 3]], [1, 0])\n1726 |     LogisticRegression()\n1727 |     >>> check_is_fitted(lr)\n1728 |     \"\"\"\n1729 |     if isclass(estimator):\n1730 |         raise TypeError(\"{} is a class, not an instance.\".format(estimator))\n1731 |     if msg is None:\n1732 |         msg = (\n1733 |             \"This %(name)s instance is not fitted yet. Call 'fit' with \"\n1734 |             \"appropriate arguments before using this estimator.\"\n1735 |         )\n1736 | \n1737 |     if not hasattr(estimator, \"fit\"):\n1738 |         raise TypeError(\"%s is not an estimator instance.\" % (estimator))\n1739 | \n1740 |     tags = get_tags(estimator)\n1741 | \n1742 |     if not tags.requires_fit and attributes is None:\n1743 |         return\n1744 | \n1745 |     if not _is_fitted(estimator, attributes, all_or_any):\n1746 |         raise NotFittedError(msg % {\"name\": type(estimator).__name__})\n1747 | \n1748 | \n1749 | def _estimator_has(attr, *, delegates=(\"estimator_\", \"estimator\")):\n1750 |     \"\"\"Check if we can delegate a method to the underlying estimator.\n1751 | \n1752 |     We check the `delegates` in the order they are passed. By default, we first check\n1753 |     the fitted estimator if available, otherwise we check the unfitted estimator.\n1754 | \n1755 |     Parameters\n1756 |     ----------\n1757 |     attr : str\n1758 |         Name of the attribute the delegate might or might not have.\n1759 | \n1760 |     delegates: tuple of str, default=(\"estimator_\", \"estimator\")\n1761 |         A tuple of sub-estimator(s) to check if we can delegate the `attr` method.\n1762 | \n1763 |     Returns\n1764 |     -------\n1765 |     check : function\n1766 |         Function to check if the delegate has the attribute.\n1767 | \n1768 |     Raises\n1769 |     ------\n1770 |     ValueError\n1771 |         Raised when none of the delegates are present in the object.\n1772 |     \"\"\"\n1773 | \n1774 |     def check(self):\n1775 |         for delegate in delegates:\n1776 |             # In meta estimators with multiple sub estimators,\n1777 |             # only the attribute of the first sub estimator is checked,\n1778 |             # assuming uniformity across all sub estimators.\n1779 |             if hasattr(self, delegate):\n1780 |                 delegator = getattr(self, delegate)\n1781 |                 if isinstance(delegator, Sequence):\n1782 |                     return getattr(delegator[0], attr)\n1783 |                 else:\n1784 |                     return getattr(delegator, attr)\n1785 | \n1786 |         raise ValueError(f\"None of the delegates {delegates} are present in the class.\")\n1787 | \n1788 |     return check\n1789 | \n1790 | \n1791 | def check_non_negative(X, whom):\n1792 |     \"\"\"\n1793 |     Check if there is any negative value in an array.\n1794 | \n1795 |     Parameters\n1796 |     ----------\n1797 |     X : {array-like, sparse matrix}\n1798 |         Input data.\n1799 | \n1800 |     whom : str\n1801 |         Who passed X to this function.\n1802 |     \"\"\"\n1803 |     xp, _ = get_namespace(X)\n1804 |     # avoid X.min() on sparse matrix since it also sorts the indices\n1805 |     if sp.issparse(X):\n1806 |         if X.format in [\"lil\", \"dok\"]:\n1807 |             X = X.tocsr()\n1808 |         if X.data.size == 0:\n1809 |             X_min = 0\n1810 |         else:\n1811 |             X_min = X.data.min()\n1812 |     else:\n1813 |         X_min = xp.min(X)\n1814 | \n1815 |     if X_min < 0:\n1816 |         raise ValueError(f\"Negative values in data passed to {whom}.\")\n1817 | \n1818 | \n1819 | def check_scalar(\n1820 |     x,\n1821 |     name,\n1822 |     target_type,\n1823 |     *,\n1824 |     min_val=None,\n1825 |     max_val=None,\n1826 |     include_boundaries=\"both\",\n1827 | ):\n1828 |     \"\"\"Validate scalar parameters type and value.\n1829 | \n1830 |     Parameters\n1831 |     ----------\n1832 |     x : object\n1833 |         The scalar parameter to validate.\n1834 | \n1835 |     name : str\n1836 |         The name of the parameter to be printed in error messages.\n1837 | \n1838 |     target_type : type or tuple\n1839 |         Acceptable data types for the parameter.\n1840 | \n1841 |     min_val : float or int, default=None\n1842 |         The minimum valid value the parameter can take. If None (default) it\n1843 |         is implied that the parameter does not have a lower bound.\n1844 | \n1845 |     max_val : float or int, default=None\n1846 |         The maximum valid value the parameter can take. If None (default) it\n1847 |         is implied that the parameter does not have an upper bound.\n1848 | \n1849 |     include_boundaries : {\"left\", \"right\", \"both\", \"neither\"}, default=\"both\"\n1850 |         Whether the interval defined by `min_val` and `max_val` should include\n1851 |         the boundaries. Possible choices are:\n1852 | \n1853 |         - `\"left\"`: only `min_val` is included in the valid interval.\n1854 |           It is equivalent to the interval `[ min_val, max_val )`.\n1855 |         - `\"right\"`: only `max_val` is included in the valid interval.\n1856 |           It is equivalent to the interval `( min_val, max_val ]`.\n1857 |         - `\"both\"`: `min_val` and `max_val` are included in the valid interval.\n1858 |           It is equivalent to the interval `[ min_val, max_val ]`.\n1859 |         - `\"neither\"`: neither `min_val` nor `max_val` are included in the\n1860 |           valid interval. It is equivalent to the interval `( min_val, max_val )`.\n1861 | \n1862 |     Returns\n1863 |     -------\n1864 |     x : numbers.Number\n1865 |         The validated number.\n1866 | \n1867 |     Raises\n1868 |     ------\n1869 |     TypeError\n1870 |         If the parameter's type does not match the desired type.\n1871 | \n1872 |     ValueError\n1873 |         If the parameter's value violates the given bounds.\n1874 |         If `min_val`, `max_val` and `include_boundaries` are inconsistent.\n1875 | \n1876 |     Examples\n1877 |     --------\n1878 |     >>> from sklearn.utils.validation import check_scalar\n1879 |     >>> check_scalar(10, \"x\", int, min_val=1, max_val=20)\n1880 |     10\n1881 |     \"\"\"\n1882 | \n1883 |     def type_name(t):\n1884 |         \"\"\"Convert type into humman readable string.\"\"\"\n1885 |         module = t.__module__\n1886 |         qualname = t.__qualname__\n1887 |         if module == \"builtins\":\n1888 |             return qualname\n1889 |         elif t == numbers.Real:\n1890 |             return \"float\"\n1891 |         elif t == numbers.Integral:\n1892 |             return \"int\"\n1893 |         return f\"{module}.{qualname}\"\n1894 | \n1895 |     if not isinstance(x, target_type):\n1896 |         if isinstance(target_type, tuple):\n1897 |             types_str = \", \".join(type_name(t) for t in target_type)\n1898 |             target_type_str = f\"{{{types_str}}}\"\n1899 |         else:\n1900 |             target_type_str = type_name(target_type)\n1901 | \n1902 |         raise TypeError(\n1903 |             f\"{name} must be an instance of {target_type_str}, not\"\n1904 |             f\" {type(x).__qualname__}.\"\n1905 |         )\n1906 | \n1907 |     expected_include_boundaries = (\"left\", \"right\", \"both\", \"neither\")\n1908 |     if include_boundaries not in expected_include_boundaries:\n1909 |         raise ValueError(\n1910 |             f\"Unknown value for `include_boundaries`: {repr(include_boundaries)}. \"\n1911 |             f\"Possible values are: {expected_include_boundaries}.\"\n1912 |         )\n1913 | \n1914 |     if max_val is None and include_boundaries == \"right\":\n1915 |         raise ValueError(\n1916 |             \"`include_boundaries`='right' without specifying explicitly `max_val` \"\n1917 |             \"is inconsistent.\"\n1918 |         )\n1919 | \n1920 |     if min_val is None and include_boundaries == \"left\":\n1921 |         raise ValueError(\n1922 |             \"`include_boundaries`='left' without specifying explicitly `min_val` \"\n1923 |             \"is inconsistent.\"\n1924 |         )\n1925 | \n1926 |     comparison_operator = (\n1927 |         operator.lt if include_boundaries in (\"left\", \"both\") else operator.le\n1928 |     )\n1929 |     if min_val is not None and comparison_operator(x, min_val):\n1930 |         raise ValueError(\n1931 |             f\"{name} == {x}, must be\"\n1932 |             f\" {'>=' if include_boundaries in ('left', 'both') else '>'} {min_val}.\"\n1933 |         )\n1934 | \n1935 |     comparison_operator = (\n1936 |         operator.gt if include_boundaries in (\"right\", \"both\") else operator.ge\n1937 |     )\n1938 |     if max_val is not None and comparison_operator(x, max_val):\n1939 |         raise ValueError(\n1940 |             f\"{name} == {x}, must be\"\n1941 |             f\" {'<=' if include_boundaries in ('right', 'both') else '<'} {max_val}.\"\n1942 |         )\n1943 | \n1944 |     return x\n1945 | \n1946 | \n1947 | def _check_psd_eigenvalues(lambdas, enable_warnings=False):\n1948 |     \"\"\"Check the eigenvalues of a positive semidefinite (PSD) matrix.\n1949 | \n1950 |     Checks the provided array of PSD matrix eigenvalues for numerical or\n1951 |     conditioning issues and returns a fixed validated version. This method\n1952 |     should typically be used if the PSD matrix is user-provided (e.g. a\n1953 |     Gram matrix) or computed using a user-provided dissimilarity metric\n1954 |     (e.g. kernel function), or if the decomposition process uses approximation\n1955 |     methods (randomized SVD, etc.).\n1956 | \n1957 |     It checks for three things:\n1958 | \n1959 |     - that there are no significant imaginary parts in eigenvalues (more than\n1960 |       1e-5 times the maximum real part). If this check fails, it raises a\n1961 |       ``ValueError``. Otherwise all non-significant imaginary parts that may\n1962 |       remain are set to zero. This operation is traced with a\n1963 |       ``PositiveSpectrumWarning`` when ``enable_warnings=True``.\n1964 | \n1965 |     - that eigenvalues are not all negative. If this check fails, it raises a\n1966 |       ``ValueError``\n1967 | \n1968 |     - that there are no significant negative eigenvalues with absolute value\n1969 |       more than 1e-10 (1e-6) and more than 1e-5 (5e-3) times the largest\n1970 |       positive eigenvalue in double (simple) precision. If this check fails,\n1971 |       it raises a ``ValueError``. Otherwise all negative eigenvalues that may\n1972 |       remain are set to zero. This operation is traced with a\n1973 |       ``PositiveSpectrumWarning`` when ``enable_warnings=True``.\n1974 | \n1975 |     Finally, all the positive eigenvalues that are too small (with a value\n1976 |     smaller than the maximum eigenvalue multiplied by 1e-12 (2e-7)) are set to\n1977 |     zero. This operation is traced with a ``PositiveSpectrumWarning`` when\n1978 |     ``enable_warnings=True``.\n1979 | \n1980 |     Parameters\n1981 |     ----------\n1982 |     lambdas : array-like of shape (n_eigenvalues,)\n1983 |         Array of eigenvalues to check / fix.\n1984 | \n1985 |     enable_warnings : bool, default=False\n1986 |         When this is set to ``True``, a ``PositiveSpectrumWarning`` will be\n1987 |         raised when there are imaginary parts, negative eigenvalues, or\n1988 |         extremely small non-zero eigenvalues. Otherwise no warning will be\n1989 |         raised. In both cases, imaginary parts, negative eigenvalues, and\n1990 |         extremely small non-zero eigenvalues will be set to zero.\n1991 | \n1992 |     Returns\n1993 |     -------\n1994 |     lambdas_fixed : ndarray of shape (n_eigenvalues,)\n1995 |         A fixed validated copy of the array of eigenvalues.\n1996 | \n1997 |     Examples\n1998 |     --------\n1999 |     >>> from sklearn.utils.validation import _check_psd_eigenvalues\n2000 |     >>> _check_psd_eigenvalues([1, 2])      # nominal case\n2001 |     array([1, 2])\n2002 |     >>> _check_psd_eigenvalues([5, 5j])     # significant imag part\n2003 |     Traceback (most recent call last):\n2004 |         ...\n2005 |     ValueError: There are significant imaginary parts in eigenvalues (1\n2006 |         of the maximum real part). Either the matrix is not PSD, or there was\n2007 |         an issue while computing the eigendecomposition of the matrix.\n2008 |     >>> _check_psd_eigenvalues([5, 5e-5j])  # insignificant imag part\n2009 |     array([5., 0.])\n2010 |     >>> _check_psd_eigenvalues([-5, -1])    # all negative\n2011 |     Traceback (most recent call last):\n2012 |         ...\n2013 |     ValueError: All eigenvalues are negative (maximum is -1). Either the\n2014 |         matrix is not PSD, or there was an issue while computing the\n2015 |         eigendecomposition of the matrix.\n2016 |     >>> _check_psd_eigenvalues([5, -1])     # significant negative\n2017 |     Traceback (most recent call last):\n2018 |         ...\n2019 |     ValueError: There are significant negative eigenvalues (0.2 of the\n2020 |         maximum positive). Either the matrix is not PSD, or there was an issue\n2021 |         while computing the eigendecomposition of the matrix.\n2022 |     >>> _check_psd_eigenvalues([5, -5e-5])  # insignificant negative\n2023 |     array([5., 0.])\n2024 |     >>> _check_psd_eigenvalues([5, 4e-12])  # bad conditioning (too small)\n2025 |     array([5., 0.])\n2026 | \n2027 |     \"\"\"\n2028 | \n2029 |     lambdas = np.array(lambdas)\n2030 |     is_double_precision = lambdas.dtype == np.float64\n2031 | \n2032 |     # note: the minimum value available is\n2033 |     #  - single-precision: np.finfo('float32').eps = 1.2e-07\n2034 |     #  - double-precision: np.finfo('float64').eps = 2.2e-16\n2035 | \n2036 |     # the various thresholds used for validation\n2037 |     # we may wish to change the value according to precision.\n2038 |     significant_imag_ratio = 1e-5\n2039 |     significant_neg_ratio = 1e-5 if is_double_precision else 5e-3\n2040 |     significant_neg_value = 1e-10 if is_double_precision else 1e-6\n2041 |     small_pos_ratio = 1e-12 if is_double_precision else 2e-7\n2042 | \n2043 |     # Check that there are no significant imaginary parts\n2044 |     if not np.isreal(lambdas).all():\n2045 |         max_imag_abs = np.abs(np.imag(lambdas)).max()\n2046 |         max_real_abs = np.abs(np.real(lambdas)).max()\n2047 |         if max_imag_abs > significant_imag_ratio * max_real_abs:\n2048 |             raise ValueError(\n2049 |                 \"There are significant imaginary parts in eigenvalues (%g \"\n2050 |                 \"of the maximum real part). Either the matrix is not PSD, or \"\n2051 |                 \"there was an issue while computing the eigendecomposition \"\n2052 |                 \"of the matrix.\" % (max_imag_abs / max_real_abs)\n2053 |             )\n2054 | \n2055 |         # warn about imaginary parts being removed\n2056 |         if enable_warnings:\n2057 |             warnings.warn(\n2058 |                 \"There are imaginary parts in eigenvalues (%g \"\n2059 |                 \"of the maximum real part). Either the matrix is not\"\n2060 |                 \" PSD, or there was an issue while computing the \"\n2061 |                 \"eigendecomposition of the matrix. Only the real \"\n2062 |                 \"parts will be kept.\" % (max_imag_abs / max_real_abs),\n2063 |                 PositiveSpectrumWarning,\n2064 |             )\n2065 | \n2066 |     # Remove all imaginary parts (even if zero)\n2067 |     lambdas = np.real(lambdas)\n2068 | \n2069 |     # Check that there are no significant negative eigenvalues\n2070 |     max_eig = lambdas.max()\n2071 |     if max_eig < 0:\n2072 |         raise ValueError(\n2073 |             \"All eigenvalues are negative (maximum is %g). \"\n2074 |             \"Either the matrix is not PSD, or there was an \"\n2075 |             \"issue while computing the eigendecomposition of \"\n2076 |             \"the matrix.\" % max_eig\n2077 |         )\n2078 | \n2079 |     else:\n2080 |         min_eig = lambdas.min()\n2081 |         if (\n2082 |             min_eig < -significant_neg_ratio * max_eig\n2083 |             and min_eig < -significant_neg_value\n2084 |         ):\n2085 |             raise ValueError(\n2086 |                 \"There are significant negative eigenvalues (%g\"\n2087 |                 \" of the maximum positive). Either the matrix is \"\n2088 |                 \"not PSD, or there was an issue while computing \"\n2089 |                 \"the eigendecomposition of the matrix.\" % (-min_eig / max_eig)\n2090 |             )\n2091 |         elif min_eig < 0:\n2092 |             # Remove all negative values and warn about it\n2093 |             if enable_warnings:\n2094 |                 warnings.warn(\n2095 |                     \"There are negative eigenvalues (%g of the \"\n2096 |                     \"maximum positive). Either the matrix is not \"\n2097 |                     \"PSD, or there was an issue while computing the\"\n2098 |                     \" eigendecomposition of the matrix. Negative \"\n2099 |                     \"eigenvalues will be replaced with 0.\" % (-min_eig / max_eig),\n2100 |                     PositiveSpectrumWarning,\n2101 |                 )\n2102 |             lambdas[lambdas < 0] = 0\n2103 | \n2104 |     # Check for conditioning (small positive non-zeros)\n2105 |     too_small_lambdas = (0 < lambdas) & (lambdas < small_pos_ratio * max_eig)\n2106 |     if too_small_lambdas.any():\n2107 |         if enable_warnings:\n2108 |             warnings.warn(\n2109 |                 \"Badly conditioned PSD matrix spectrum: the largest \"\n2110 |                 \"eigenvalue is more than %g times the smallest. \"\n2111 |                 \"Small eigenvalues will be replaced with 0.\"\n2112 |                 \"\" % (1 / small_pos_ratio),\n2113 |                 PositiveSpectrumWarning,\n2114 |             )\n2115 |         lambdas[too_small_lambdas] = 0\n2116 | \n2117 |     return lambdas\n2118 | \n2119 | \n2120 | def _check_sample_weight(\n2121 |     sample_weight, X, dtype=None, copy=False, ensure_non_negative=False\n2122 | ):\n2123 |     \"\"\"Validate sample weights.\n2124 | \n2125 |     Note that passing sample_weight=None will output an array of ones.\n2126 |     Therefore, in some cases, you may want to protect the call with:\n2127 |     if sample_weight is not None:\n2128 |         sample_weight = _check_sample_weight(...)\n2129 | \n2130 |     Parameters\n2131 |     ----------\n2132 |     sample_weight : {ndarray, Number or None}, shape (n_samples,)\n2133 |         Input sample weights.\n2134 | \n2135 |     X : {ndarray, list, sparse matrix}\n2136 |         Input data.\n2137 | \n2138 |     ensure_non_negative : bool, default=False,\n2139 |         Whether or not the weights are expected to be non-negative.\n2140 | \n2141 |         .. versionadded:: 1.0\n2142 | \n2143 |     dtype : dtype, default=None\n2144 |         dtype of the validated `sample_weight`.\n2145 |         If None, and the input `sample_weight` is an array, the dtype of the\n2146 |         input is preserved; otherwise an array with the default numpy dtype\n2147 |         is be allocated.  If `dtype` is not one of `float32`, `float64`,\n2148 |         `None`, the output will be of dtype `float64`.\n2149 | \n2150 |     copy : bool, default=False\n2151 |         If True, a copy of sample_weight will be created.\n2152 | \n2153 |     Returns\n2154 |     -------\n2155 |     sample_weight : ndarray of shape (n_samples,)\n2156 |         Validated sample weight. It is guaranteed to be \"C\" contiguous.\n2157 |     \"\"\"\n2158 |     n_samples = _num_samples(X)\n2159 | \n2160 |     if dtype is not None and dtype not in [np.float32, np.float64]:\n2161 |         dtype = np.float64\n2162 | \n2163 |     if sample_weight is None:\n2164 |         sample_weight = np.ones(n_samples, dtype=dtype)\n2165 |     elif isinstance(sample_weight, numbers.Number):\n2166 |         sample_weight = np.full(n_samples, sample_weight, dtype=dtype)\n2167 |     else:\n2168 |         if dtype is None:\n2169 |             dtype = [np.float64, np.float32]\n2170 |         sample_weight = check_array(\n2171 |             sample_weight,\n2172 |             accept_sparse=False,\n2173 |             ensure_2d=False,\n2174 |             dtype=dtype,\n2175 |             order=\"C\",\n2176 |             copy=copy,\n2177 |             input_name=\"sample_weight\",\n2178 |         )\n2179 |         if sample_weight.ndim != 1:\n2180 |             raise ValueError(\"Sample weights must be 1D array or scalar\")\n2181 | \n2182 |         if sample_weight.shape != (n_samples,):\n2183 |             raise ValueError(\n2184 |                 \"sample_weight.shape == {}, expected {}!\".format(\n2185 |                     sample_weight.shape, (n_samples,)\n2186 |                 )\n2187 |             )\n2188 | \n2189 |     if ensure_non_negative:\n2190 |         check_non_negative(sample_weight, \"`sample_weight`\")\n2191 | \n2192 |     return sample_weight\n2193 | \n2194 | \n2195 | def _allclose_dense_sparse(x, y, rtol=1e-7, atol=1e-9):\n2196 |     \"\"\"Check allclose for sparse and dense data.\n2197 | \n2198 |     Both x and y need to be either sparse or dense, they\n2199 |     can't be mixed.\n2200 | \n2201 |     Parameters\n2202 |     ----------\n2203 |     x : {array-like, sparse matrix}\n2204 |         First array to compare.\n2205 | \n2206 |     y : {array-like, sparse matrix}\n2207 |         Second array to compare.\n2208 | \n2209 |     rtol : float, default=1e-7\n2210 |         Relative tolerance; see numpy.allclose.\n2211 | \n2212 |     atol : float, default=1e-9\n2213 |         absolute tolerance; see numpy.allclose. Note that the default here is\n2214 |         more tolerant than the default for numpy.testing.assert_allclose, where\n2215 |         atol=0.\n2216 |     \"\"\"\n2217 |     if sp.issparse(x) and sp.issparse(y):\n2218 |         x = x.tocsr()\n2219 |         y = y.tocsr()\n2220 |         x.sum_duplicates()\n2221 |         y.sum_duplicates()\n2222 |         return (\n2223 |             np.array_equal(x.indices, y.indices)\n2224 |             and np.array_equal(x.indptr, y.indptr)\n2225 |             and np.allclose(x.data, y.data, rtol=rtol, atol=atol)\n2226 |         )\n2227 |     elif not sp.issparse(x) and not sp.issparse(y):\n2228 |         return np.allclose(x, y, rtol=rtol, atol=atol)\n2229 |     raise ValueError(\n2230 |         \"Can only compare two sparse matrices, not a sparse matrix and an array\"\n2231 |     )\n2232 | \n2233 | \n2234 | def _check_response_method(estimator, response_method):\n2235 |     \"\"\"Check if `response_method` is available in estimator and return it.\n2236 | \n2237 |     .. versionadded:: 1.3\n2238 | \n2239 |     Parameters\n2240 |     ----------\n2241 |     estimator : estimator instance\n2242 |         Classifier or regressor to check.\n2243 | \n2244 |     response_method : {\"predict_proba\", \"predict_log_proba\", \"decision_function\",\n2245 |             \"predict\"} or list of such str\n2246 |         Specifies the response method to use get prediction from an estimator\n2247 |         (i.e. :term:`predict_proba`, :term:`predict_log_proba`,\n2248 |         :term:`decision_function` or :term:`predict`). Possible choices are:\n2249 |         - if `str`, it corresponds to the name to the method to return;\n2250 |         - if a list of `str`, it provides the method names in order of\n2251 |           preference. The method returned corresponds to the first method in\n2252 |           the list and which is implemented by `estimator`.\n2253 | \n2254 |     Returns\n2255 |     -------\n2256 |     prediction_method : callable\n2257 |         Prediction method of estimator.\n2258 | \n2259 |     Raises\n2260 |     ------\n2261 |     AttributeError\n2262 |         If `response_method` is not available in `estimator`.\n2263 |     \"\"\"\n2264 |     if isinstance(response_method, str):\n2265 |         list_methods = [response_method]\n2266 |     else:\n2267 |         list_methods = response_method\n2268 | \n2269 |     prediction_method = [getattr(estimator, method, None) for method in list_methods]\n2270 |     prediction_method = reduce(lambda x, y: x or y, prediction_method)\n2271 |     if prediction_method is None:\n2272 |         raise AttributeError(\n2273 |             f\"{estimator.__class__.__name__} has none of the following attributes: \"\n2274 |             f\"{', '.join(list_methods)}.\"\n2275 |         )\n2276 | \n2277 |     return prediction_method\n2278 | \n2279 | \n2280 | def _check_method_params(X, params, indices=None):\n2281 |     \"\"\"Check and validate the parameters passed to a specific\n2282 |     method like `fit`.\n2283 | \n2284 |     Parameters\n2285 |     ----------\n2286 |     X : array-like of shape (n_samples, n_features)\n2287 |         Data array.\n2288 | \n2289 |     params : dict\n2290 |         Dictionary containing the parameters passed to the method.\n2291 | \n2292 |     indices : array-like of shape (n_samples,), default=None\n2293 |         Indices to be selected if the parameter has the same size as `X`.\n2294 | \n2295 |     Returns\n2296 |     -------\n2297 |     method_params_validated : dict\n2298 |         Validated parameters. We ensure that the values support indexing.\n2299 |     \"\"\"\n2300 |     from . import _safe_indexing\n2301 | \n2302 |     method_params_validated = {}\n2303 |     for param_key, param_value in params.items():\n2304 |         if (\n2305 |             not _is_arraylike(param_value)\n2306 |             and not sp.issparse(param_value)\n2307 |             or _num_samples(param_value) != _num_samples(X)\n2308 |         ):\n2309 |             # Non-indexable pass-through (for now for backward-compatibility).\n2310 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n2311 |             method_params_validated[param_key] = param_value\n2312 |         else:\n2313 |             # Any other method_params should support indexing\n2314 |             # (e.g. for cross-validation).\n2315 |             method_params_validated[param_key] = _make_indexable(param_value)\n2316 |             method_params_validated[param_key] = _safe_indexing(\n2317 |                 method_params_validated[param_key], indices\n2318 |             )\n2319 | \n2320 |     return method_params_validated\n2321 | \n2322 | \n2323 | def _is_pandas_df_or_series(X):\n2324 |     \"\"\"Return True if the X is a pandas dataframe or series.\"\"\"\n2325 |     try:\n2326 |         pd = sys.modules[\"pandas\"]\n2327 |     except KeyError:\n2328 |         return False\n2329 |     return isinstance(X, (pd.DataFrame, pd.Series))\n2330 | \n2331 | \n2332 | def _is_pandas_df(X):\n2333 |     \"\"\"Return True if the X is a pandas dataframe.\"\"\"\n2334 |     try:\n2335 |         pd = sys.modules[\"pandas\"]\n2336 |     except KeyError:\n2337 |         return False\n2338 |     return isinstance(X, pd.DataFrame)\n2339 | \n2340 | \n2341 | def _is_polars_df_or_series(X):\n2342 |     \"\"\"Return True if the X is a polars dataframe or series.\"\"\"\n2343 |     try:\n2344 |         pl = sys.modules[\"polars\"]\n2345 |     except KeyError:\n2346 |         return False\n2347 |     return isinstance(X, (pl.DataFrame, pl.Series))\n2348 | \n2349 | \n2350 | def _is_polars_df(X):\n2351 |     \"\"\"Return True if the X is a polars dataframe.\"\"\"\n2352 |     try:\n2353 |         pl = sys.modules[\"polars\"]\n2354 |     except KeyError:\n2355 |         return False\n2356 |     return isinstance(X, pl.DataFrame)\n2357 | \n2358 | \n2359 | def _get_feature_names(X):\n2360 |     \"\"\"Get feature names from X.\n2361 | \n2362 |     Support for other array containers should place its implementation here.\n2363 | \n2364 |     Parameters\n2365 |     ----------\n2366 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n2367 |         Array container to extract feature names.\n2368 | \n2369 |         - pandas dataframe : The columns will be considered to be feature\n2370 |           names. If the dataframe contains non-string feature names, `None` is\n2371 |           returned.\n2372 |         - All other array containers will return `None`.\n2373 | \n2374 |     Returns\n2375 |     -------\n2376 |     names: ndarray or None\n2377 |         Feature names of `X`. Unrecognized array containers will return `None`.\n2378 |     \"\"\"\n2379 |     feature_names = None\n2380 | \n2381 |     # extract feature names for support array containers\n2382 |     if _is_pandas_df(X):\n2383 |         # Make sure we can inspect columns names from pandas, even with\n2384 |         # versions too old to expose a working implementation of\n2385 |         # __dataframe__.column_names() and avoid introducing any\n2386 |         # additional copy.\n2387 |         # TODO: remove the pandas-specific branch once the minimum supported\n2388 |         # version of pandas has a working implementation of\n2389 |         # __dataframe__.column_names() that is guaranteed to not introduce any\n2390 |         # additional copy of the data without having to impose allow_copy=False\n2391 |         # that could fail with other libraries. Note: in the longer term, we\n2392 |         # could decide to instead rely on the __dataframe_namespace__ API once\n2393 |         # adopted by our minimally supported pandas version.\n2394 |         feature_names = np.asarray(X.columns, dtype=object)\n2395 |     elif hasattr(X, \"__dataframe__\"):\n2396 |         df_protocol = X.__dataframe__()\n2397 |         feature_names = np.asarray(list(df_protocol.column_names()), dtype=object)\n2398 | \n2399 |     if feature_names is None or len(feature_names) == 0:\n2400 |         return\n2401 | \n2402 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n2403 | \n2404 |     # mixed type of string and non-string is not supported\n2405 |     if len(types) > 1 and \"str\" in types:\n2406 |         raise TypeError(\n2407 |             \"Feature names are only supported if all input features have string names, \"\n2408 |             f\"but your input has {types} as feature name / column name types. \"\n2409 |             \"If you want feature names to be stored and validated, you must convert \"\n2410 |             \"them all to strings, by using X.columns = X.columns.astype(str) for \"\n2411 |             \"example. Otherwise you can remove feature / column names from your input \"\n2412 |             \"data, or convert them all to a non-string data type.\"\n2413 |         )\n2414 | \n2415 |     # Only feature names of all strings are supported\n2416 |     if len(types) == 1 and types[0] == \"str\":\n2417 |         return feature_names\n2418 | \n2419 | \n2420 | def _check_feature_names_in(estimator, input_features=None, *, generate_names=True):\n2421 |     \"\"\"Check `input_features` and generate names if needed.\n2422 | \n2423 |     Commonly used in :term:`get_feature_names_out`.\n2424 | \n2425 |     Parameters\n2426 |     ----------\n2427 |     input_features : array-like of str or None, default=None\n2428 |         Input features.\n2429 | \n2430 |         - If `input_features` is `None`, then `feature_names_in_` is\n2431 |           used as feature names in. If `feature_names_in_` is not defined,\n2432 |           then the following input feature names are generated:\n2433 |           `[\"x0\", \"x1\", ..., \"x(n_features_in_ - 1)\"]`.\n2434 |         - If `input_features` is an array-like, then `input_features` must\n2435 |           match `feature_names_in_` if `feature_names_in_` is defined.\n2436 | \n2437 |     generate_names : bool, default=True\n2438 |         Whether to generate names when `input_features` is `None` and\n2439 |         `estimator.feature_names_in_` is not defined. This is useful for transformers\n2440 |         that validates `input_features` but do not require them in\n2441 |         :term:`get_feature_names_out` e.g. `PCA`.\n2442 | \n2443 |     Returns\n2444 |     -------\n2445 |     feature_names_in : ndarray of str or `None`\n2446 |         Feature names in.\n2447 |     \"\"\"\n2448 | \n2449 |     feature_names_in_ = getattr(estimator, \"feature_names_in_\", None)\n2450 |     n_features_in_ = getattr(estimator, \"n_features_in_\", None)\n2451 | \n2452 |     if input_features is not None:\n2453 |         input_features = np.asarray(input_features, dtype=object)\n2454 |         if feature_names_in_ is not None and not np.array_equal(\n2455 |             feature_names_in_, input_features\n2456 |         ):\n2457 |             raise ValueError(\"input_features is not equal to feature_names_in_\")\n2458 | \n2459 |         if n_features_in_ is not None and len(input_features) != n_features_in_:\n2460 |             raise ValueError(\n2461 |                 \"input_features should have length equal to number of \"\n2462 |                 f\"features ({n_features_in_}), got {len(input_features)}\"\n2463 |             )\n2464 |         return input_features\n2465 | \n2466 |     if feature_names_in_ is not None:\n2467 |         return feature_names_in_\n2468 | \n2469 |     if not generate_names:\n2470 |         return\n2471 | \n2472 |     # Generates feature names if `n_features_in_` is defined\n2473 |     if n_features_in_ is None:\n2474 |         raise ValueError(\"Unable to generate feature names without n_features_in_\")\n2475 | \n2476 |     return np.asarray([f\"x{i}\" for i in range(n_features_in_)], dtype=object)\n2477 | \n2478 | \n2479 | def _generate_get_feature_names_out(estimator, n_features_out, input_features=None):\n2480 |     \"\"\"Generate feature names out for estimator using the estimator name as the prefix.\n2481 | \n2482 |     The input_feature names are validated but not used. This function is useful\n2483 |     for estimators that generate their own names based on `n_features_out`, i.e. PCA.\n2484 | \n2485 |     Parameters\n2486 |     ----------\n2487 |     estimator : estimator instance\n2488 |         Estimator producing output feature names.\n2489 | \n2490 |     n_feature_out : int\n2491 |         Number of feature names out.\n2492 | \n2493 |     input_features : array-like of str or None, default=None\n2494 |         Only used to validate feature names with `estimator.feature_names_in_`.\n2495 | \n2496 |     Returns\n2497 |     -------\n2498 |     feature_names_in : ndarray of str or `None`\n2499 |         Feature names in.\n2500 |     \"\"\"\n2501 |     _check_feature_names_in(estimator, input_features, generate_names=False)\n2502 |     estimator_name = estimator.__class__.__name__.lower()\n2503 |     return np.asarray(\n2504 |         [f\"{estimator_name}{i}\" for i in range(n_features_out)], dtype=object\n2505 |     )\n2506 | \n2507 | \n2508 | def _check_monotonic_cst(estimator, monotonic_cst=None):\n2509 |     \"\"\"Check the monotonic constraints and return the corresponding array.\n2510 | \n2511 |     This helper function should be used in the `fit` method of an estimator\n2512 |     that supports monotonic constraints and called after the estimator has\n2513 |     introspected input data to set the `n_features_in_` and optionally the\n2514 |     `feature_names_in_` attributes.\n2515 | \n2516 |     .. versionadded:: 1.2\n2517 | \n2518 |     Parameters\n2519 |     ----------\n2520 |     estimator : estimator instance\n2521 | \n2522 |     monotonic_cst : array-like of int, dict of str or None, default=None\n2523 |         Monotonic constraints for the features.\n2524 | \n2525 |         - If array-like, then it should contain only -1, 0 or 1. Each value\n2526 |             will be checked to be in [-1, 0, 1]. If a value is -1, then the\n2527 |             corresponding feature is required to be monotonically decreasing.\n2528 |         - If dict, then it the keys should be the feature names occurring in\n2529 |             `estimator.feature_names_in_` and the values should be -1, 0 or 1.\n2530 |         - If None, then an array of 0s will be allocated.\n2531 | \n2532 |     Returns\n2533 |     -------\n2534 |     monotonic_cst : ndarray of int\n2535 |         Monotonic constraints for each feature.\n2536 |     \"\"\"\n2537 |     original_monotonic_cst = monotonic_cst\n2538 |     if monotonic_cst is None or isinstance(monotonic_cst, dict):\n2539 |         monotonic_cst = np.full(\n2540 |             shape=estimator.n_features_in_,\n2541 |             fill_value=0,\n2542 |             dtype=np.int8,\n2543 |         )\n2544 |         if isinstance(original_monotonic_cst, dict):\n2545 |             if not hasattr(estimator, \"feature_names_in_\"):\n2546 |                 raise ValueError(\n2547 |                     f\"{estimator.__class__.__name__} was not fitted on data \"\n2548 |                     \"with feature names. Pass monotonic_cst as an integer \"\n2549 |                     \"array instead.\"\n2550 |                 )\n2551 |             unexpected_feature_names = list(\n2552 |                 set(original_monotonic_cst) - set(estimator.feature_names_in_)\n2553 |             )\n2554 |             unexpected_feature_names.sort()  # deterministic error message\n2555 |             n_unexpeced = len(unexpected_feature_names)\n2556 |             if unexpected_feature_names:\n2557 |                 if len(unexpected_feature_names) > 5:\n2558 |                     unexpected_feature_names = unexpected_feature_names[:5]\n2559 |                     unexpected_feature_names.append(\"...\")\n2560 |                 raise ValueError(\n2561 |                     f\"monotonic_cst contains {n_unexpeced} unexpected feature \"\n2562 |                     f\"names: {unexpected_feature_names}.\"\n2563 |                 )\n2564 |             for feature_idx, feature_name in enumerate(estimator.feature_names_in_):\n2565 |                 if feature_name in original_monotonic_cst:\n2566 |                     cst = original_monotonic_cst[feature_name]\n2567 |                     if cst not in [-1, 0, 1]:\n2568 |                         raise ValueError(\n2569 |                             f\"monotonic_cst['{feature_name}'] must be either \"\n2570 |                             f\"-1, 0 or 1. Got {cst!r}.\"\n2571 |                         )\n2572 |                     monotonic_cst[feature_idx] = cst\n2573 |     else:\n2574 |         unexpected_cst = np.setdiff1d(monotonic_cst, [-1, 0, 1])\n2575 |         if unexpected_cst.shape[0]:\n2576 |             raise ValueError(\n2577 |                 \"monotonic_cst must be an array-like of -1, 0 or 1. Observed \"\n2578 |                 f\"values: {unexpected_cst.tolist()}.\"\n2579 |             )\n2580 | \n2581 |         monotonic_cst = np.asarray(monotonic_cst, dtype=np.int8)\n2582 |         if monotonic_cst.shape[0] != estimator.n_features_in_:\n2583 |             raise ValueError(\n2584 |                 f\"monotonic_cst has shape {monotonic_cst.shape} but the input data \"\n2585 |                 f\"X has {estimator.n_features_in_} features.\"\n2586 |             )\n2587 |     return monotonic_cst\n2588 | \n2589 | \n2590 | def _check_pos_label_consistency(pos_label, y_true):\n2591 |     \"\"\"Check if `pos_label` need to be specified or not.\n2592 | \n2593 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2594 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2595 |     `pos_label` parameters.\n2596 | \n2597 |     Parameters\n2598 |     ----------\n2599 |     pos_label : int, float, bool, str or None\n2600 |         The positive label.\n2601 |     y_true : ndarray of shape (n_samples,)\n2602 |         The target vector.\n2603 | \n2604 |     Returns\n2605 |     -------\n2606 |     pos_label : int, float, bool or str\n2607 |         If `pos_label` can be inferred, it will be returned.\n2608 | \n2609 |     Raises\n2610 |     ------\n2611 |     ValueError\n2612 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2613 |         it will raise a `ValueError`.\n2614 |     \"\"\"\n2615 |     # ensure binary classification if pos_label is not specified\n2616 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2617 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2618 |     # when elements in the two arrays are not comparable.\n2619 |     if pos_label is None:\n2620 |         # Compute classes only if pos_label is not specified:\n2621 |         classes = np.unique(y_true)\n2622 |         if classes.dtype.kind in \"OUS\" or not (\n2623 |             np.array_equal(classes, [0, 1])\n2624 |             or np.array_equal(classes, [-1, 1])\n2625 |             or np.array_equal(classes, [0])\n2626 |             or np.array_equal(classes, [-1])\n2627 |             or np.array_equal(classes, [1])\n2628 |         ):\n2629 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2630 |             raise ValueError(\n2631 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2632 |                 \"specified: either make y_true take value in {0, 1} or \"\n2633 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2634 |             )\n2635 |         pos_label = 1\n2636 | \n2637 |     return pos_label\n2638 | \n2639 | \n2640 | def _to_object_array(sequence):\n2641 |     \"\"\"Convert sequence to a 1-D NumPy array of object dtype.\n2642 | \n2643 |     numpy.array constructor has a similar use but it's output\n2644 |     is ambiguous. It can be 1-D NumPy array of object dtype if\n2645 |     the input is a ragged array, but if the input is a list of\n2646 |     equal length arrays, then the output is a 2D numpy.array.\n2647 |     _to_object_array solves this ambiguity by guarantying that\n2648 |     the output is a 1-D NumPy array of objects for any input.\n2649 | \n2650 |     Parameters\n2651 |     ----------\n2652 |     sequence : array-like of shape (n_elements,)\n2653 |         The sequence to be converted.\n2654 | \n2655 |     Returns\n2656 |     -------\n2657 |     out : ndarray of shape (n_elements,), dtype=object\n2658 |         The converted sequence into a 1-D NumPy array of object dtype.\n2659 | \n2660 |     Examples\n2661 |     --------\n2662 |     >>> import numpy as np\n2663 |     >>> from sklearn.utils.validation import _to_object_array\n2664 |     >>> _to_object_array([np.array([0]), np.array([1])])\n2665 |     array([array([0]), array([1])], dtype=object)\n2666 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2667 |     array([array([0]), array([1, 2])], dtype=object)\n2668 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2669 |     array([array([0]), array([1, 2])], dtype=object)\n2670 |     \"\"\"\n2671 |     out = np.empty(len(sequence), dtype=object)\n2672 |     out[:] = sequence\n2673 |     return out\n2674 | \n2675 | \n2676 | def _check_feature_names(estimator, X, *, reset):\n2677 |     \"\"\"Set or check the `feature_names_in_` attribute of an estimator.\n2678 | \n2679 |     .. versionadded:: 1.0\n2680 | \n2681 |     .. versionchanged:: 1.6\n2682 |         Moved from :class:`~sklearn.base.BaseEstimator` to\n2683 |         :mod:`sklearn.utils.validation`.\n2684 | \n2685 |     Parameters\n2686 |     ----------\n2687 |     estimator : estimator instance\n2688 |         The estimator to validate the input for.\n2689 | \n2690 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n2691 |         The input samples.\n2692 | \n2693 |     reset : bool\n2694 |         Whether to reset the `feature_names_in_` attribute.\n2695 |         If False, the input will be checked for consistency with\n2696 |         feature names of data provided when reset was last True.\n2697 |         .. note::\n2698 |            It is recommended to call `reset=True` in `fit` and in the first\n2699 |            call to `partial_fit`. All other methods that validate `X`\n2700 |            should set `reset=False`.\n2701 |     \"\"\"\n2702 | \n2703 |     if reset:\n2704 |         feature_names_in = _get_feature_names(X)\n2705 |         if feature_names_in is not None:\n2706 |             estimator.feature_names_in_ = feature_names_in\n2707 |         elif hasattr(estimator, \"feature_names_in_\"):\n2708 |             # Delete the attribute when the estimator is fitted on a new dataset\n2709 |             # that has no feature names.\n2710 |             delattr(estimator, \"feature_names_in_\")\n2711 |         return\n2712 | \n2713 |     fitted_feature_names = getattr(estimator, \"feature_names_in_\", None)\n2714 |     X_feature_names = _get_feature_names(X)\n2715 | \n2716 |     if fitted_feature_names is None and X_feature_names is None:\n2717 |         # no feature names seen in fit and in X\n2718 |         return\n2719 | \n2720 |     if X_feature_names is not None and fitted_feature_names is None:\n2721 |         warnings.warn(\n2722 |             f\"X has feature names, but {estimator.__class__.__name__} was fitted \"\n2723 |             \"without feature names\"\n2724 |         )\n2725 |         return\n2726 | \n2727 |     if X_feature_names is None and fitted_feature_names is not None:\n2728 |         warnings.warn(\n2729 |             \"X does not have valid feature names, but\"\n2730 |             f\" {estimator.__class__.__name__} was fitted with feature names\"\n2731 |         )\n2732 |         return\n2733 | \n2734 |     # validate the feature names against the `feature_names_in_` attribute\n2735 |     if len(fitted_feature_names) != len(X_feature_names) or np.any(\n2736 |         fitted_feature_names != X_feature_names\n2737 |     ):\n2738 |         message = \"The feature names should match those that were passed during fit.\\n\"\n2739 |         fitted_feature_names_set = set(fitted_feature_names)\n2740 |         X_feature_names_set = set(X_feature_names)\n2741 | \n2742 |         unexpected_names = sorted(X_feature_names_set - fitted_feature_names_set)\n2743 |         missing_names = sorted(fitted_feature_names_set - X_feature_names_set)\n2744 | \n2745 |         def add_names(names):\n2746 |             output = \"\"\n2747 |             max_n_names = 5\n2748 |             for i, name in enumerate(names):\n2749 |                 if i >= max_n_names:\n2750 |                     output += \"- ...\\n\"\n2751 |                     break\n2752 |                 output += f\"- {name}\\n\"\n2753 |             return output\n2754 | \n2755 |         if unexpected_names:\n2756 |             message += \"Feature names unseen at fit time:\\n\"\n2757 |             message += add_names(unexpected_names)\n2758 | \n2759 |         if missing_names:\n2760 |             message += \"Feature names seen at fit time, yet now missing:\\n\"\n2761 |             message += add_names(missing_names)\n2762 | \n2763 |         if not missing_names and not unexpected_names:\n2764 |             message += \"Feature names must be in the same order as they were in fit.\\n\"\n2765 | \n2766 |         raise ValueError(message)\n2767 | \n2768 | \n2769 | def _check_n_features(estimator, X, reset):\n2770 |     \"\"\"Set the `n_features_in_` attribute, or check against it on an estimator.\n2771 | \n2772 |     .. versionchanged:: 1.6\n2773 |         Moved from :class:`~sklearn.base.BaseEstimator` to\n2774 |         :mod:`~sklearn.utils.validation`.\n2775 | \n2776 |     Parameters\n2777 |     ----------\n2778 |     estimator : estimator instance\n2779 |         The estimator to validate the input for.\n2780 | \n2781 |     X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n2782 |         The input samples.\n2783 | \n2784 |     reset : bool\n2785 |         If True, the `n_features_in_` attribute is set to `X.shape[1]`.\n2786 |         If False and the attribute exists, then check that it is equal to\n2787 |         `X.shape[1]`. If False and the attribute does *not* exist, then\n2788 |         the check is skipped.\n2789 |         .. note::\n2790 |            It is recommended to call reset=True in `fit` and in the first\n2791 |            call to `partial_fit`. All other methods that validate `X`\n2792 |            should set `reset=False`.\n2793 |     \"\"\"\n2794 |     try:\n2795 |         n_features = _num_features(X)\n2796 |     except TypeError as e:\n2797 |         if not reset and hasattr(estimator, \"n_features_in_\"):\n2798 |             raise ValueError(\n2799 |                 \"X does not contain any features, but \"\n2800 |                 f\"{estimator.__class__.__name__} is expecting \"\n2801 |                 f\"{estimator.n_features_in_} features\"\n2802 |             ) from e\n2803 |         # If the number of features is not defined and reset=True,\n2804 |         # then we skip this check\n2805 |         return\n2806 | \n2807 |     if reset:\n2808 |         estimator.n_features_in_ = n_features\n2809 |         return\n2810 | \n2811 |     if not hasattr(estimator, \"n_features_in_\"):\n2812 |         # Skip this check if the expected number of expected input features\n2813 |         # was not recorded by calling fit first. This is typically the case\n2814 |         # for stateless transformers.\n2815 |         return\n2816 | \n2817 |     if n_features != estimator.n_features_in_:\n2818 |         raise ValueError(\n2819 |             f\"X has {n_features} features, but {estimator.__class__.__name__} \"\n2820 |             f\"is expecting {estimator.n_features_in_} features as input.\"\n2821 |         )\n2822 | \n2823 | \n2824 | def validate_data(\n2825 |     _estimator,\n2826 |     /,\n2827 |     X=\"no_validation\",\n2828 |     y=\"no_validation\",\n2829 |     reset=True,\n2830 |     validate_separately=False,\n2831 |     skip_check_array=False,\n2832 |     **check_params,\n2833 | ):\n2834 |     \"\"\"Validate input data and set or check feature names and counts of the input.\n2835 | \n2836 |     This helper function should be used in an estimator that requires input\n2837 |     validation. This mutates the estimator and sets the `n_features_in_` and\n2838 |     `feature_names_in_` attributes if `reset=True`.\n2839 | \n2840 |     .. versionadded:: 1.6\n2841 | \n2842 |     Parameters\n2843 |     ----------\n2844 |     _estimator : estimator instance\n2845 |         The estimator to validate the input for.\n2846 | \n2847 |     X : {array-like, sparse matrix, dataframe} of shape \\\n2848 |             (n_samples, n_features), default='no validation'\n2849 |         The input samples.\n2850 |         If `'no_validation'`, no validation is performed on `X`. This is\n2851 |         useful for meta-estimator which can delegate input validation to\n2852 |         their underlying estimator(s). In that case `y` must be passed and\n2853 |         the only accepted `check_params` are `multi_output` and\n2854 |         `y_numeric`.\n2855 | \n2856 |     y : array-like of shape (n_samples,), default='no_validation'\n2857 |         The targets.\n2858 | \n2859 |         - If `None`, :func:`~sklearn.utils.check_array` is called on `X`. If\n2860 |           the estimator's `requires_y` tag is True, then an error will be raised.\n2861 |         - If `'no_validation'`, :func:`~sklearn.utils.check_array` is called\n2862 |           on `X` and the estimator's `requires_y` tag is ignored. This is a default\n2863 |           placeholder and is never meant to be explicitly set. In that case `X` must be\n2864 |           passed.\n2865 |         - Otherwise, only `y` with `_check_y` or both `X` and `y` are checked with\n2866 |           either :func:`~sklearn.utils.check_array` or\n2867 |           :func:`~sklearn.utils.check_X_y` depending on `validate_separately`.\n2868 | \n2869 |     reset : bool, default=True\n2870 |         Whether to reset the `n_features_in_` attribute.\n2871 |         If False, the input will be checked for consistency with data\n2872 |         provided when reset was last True.\n2873 | \n2874 |         .. note::\n2875 | \n2876 |            It is recommended to call `reset=True` in `fit` and in the first\n2877 |            call to `partial_fit`. All other methods that validate `X`\n2878 |            should set `reset=False`.\n2879 | \n2880 |     validate_separately : False or tuple of dicts, default=False\n2881 |         Only used if `y` is not `None`.\n2882 |         If `False`, call :func:`~sklearn.utils.check_X_y`. Else, it must be a tuple of\n2883 |         kwargs to be used for calling :func:`~sklearn.utils.check_array` on `X` and `y`\n2884 |         respectively.\n2885 | \n2886 |         `estimator=self` is automatically added to these dicts to generate\n2887 |         more informative error message in case of invalid input data.\n2888 | \n2889 |     skip_check_array : bool, default=False\n2890 |         If `True`, `X` and `y` are unchanged and only `feature_names_in_` and\n2891 |         `n_features_in_` are checked. Otherwise, :func:`~sklearn.utils.check_array`\n2892 |         is called on `X` and `y`.\n2893 | \n2894 |     **check_params : kwargs\n2895 |         Parameters passed to :func:`~sklearn.utils.check_array` or\n2896 |         :func:`~sklearn.utils.check_X_y`. Ignored if validate_separately\n2897 |         is not False.\n2898 | \n2899 |         `estimator=self` is automatically added to these params to generate\n2900 |         more informative error message in case of invalid input data.\n2901 | \n2902 |     Returns\n2903 |     -------\n2904 |     out : {ndarray, sparse matrix} or tuple of these\n2905 |         The validated input. A tuple is returned if both `X` and `y` are\n2906 |         validated.\n2907 |     \"\"\"\n2908 |     _check_feature_names(_estimator, X, reset=reset)\n2909 |     tags = get_tags(_estimator)\n2910 |     if y is None and tags.target_tags.required:\n2911 |         raise ValueError(\n2912 |             f\"This {_estimator.__class__.__name__} estimator \"\n2913 |             \"requires y to be passed, but the target y is None.\"\n2914 |         )\n2915 | \n2916 |     no_val_X = isinstance(X, str) and X == \"no_validation\"\n2917 |     no_val_y = y is None or isinstance(y, str) and y == \"no_validation\"\n2918 | \n2919 |     if no_val_X and no_val_y:\n2920 |         raise ValueError(\"Validation should be done on X, y or both.\")\n2921 | \n2922 |     default_check_params = {\"estimator\": _estimator}\n2923 |     check_params = {**default_check_params, **check_params}\n2924 | \n2925 |     if skip_check_array:\n2926 |         if not no_val_X and no_val_y:\n2927 |             out = X\n2928 |         elif no_val_X and not no_val_y:\n2929 |             out = y\n2930 |         else:\n2931 |             out = X, y\n2932 |     elif not no_val_X and no_val_y:\n2933 |         out = check_array(X, input_name=\"X\", **check_params)\n2934 |     elif no_val_X and not no_val_y:\n2935 |         out = _check_y(y, **check_params)\n2936 |     else:\n2937 |         if validate_separately:\n2938 |             # We need this because some estimators validate X and y\n2939 |             # separately, and in general, separately calling check_array()\n2940 |             # on X and y isn't equivalent to just calling check_X_y()\n2941 |             # :(\n2942 |             check_X_params, check_y_params = validate_separately\n2943 |             if \"estimator\" not in check_X_params:\n2944 |                 check_X_params = {**default_check_params, **check_X_params}\n2945 |             X = check_array(X, input_name=\"X\", **check_X_params)\n2946 |             if \"estimator\" not in check_y_params:\n2947 |                 check_y_params = {**default_check_params, **check_y_params}\n2948 |             y = check_array(y, input_name=\"y\", **check_y_params)\n2949 |         else:\n2950 |             X, y = check_X_y(X, y, **check_params)\n2951 |         out = X, y\n2952 | \n2953 |     if not no_val_X and check_params.get(\"ensure_2d\", True):\n2954 |         _check_n_features(_estimator, X, reset=reset)\n2955 | \n2956 |     return out\n2957 | \n```\n"}, {"content": "Let's review the collected files to pinpoint the relevant locations for feature implementation:\n\n- `sklearn/metrics/_regression.py`: Contains `_check_reg_targets` and `_find_matching_floating_dtype` calls. `_check_reg_targets` seems to be a good candidate for incorporating the dtype logic.\n- `sklearn/utils/_array_api.py`: Contains `_find_matching_floating_dtype`, which is the function we want to integrate into `_check_reg_targets`.\n- `sklearn/utils/validation.py`: Contains `_check_reg_targets` which has a different implementation from `_regression.py` and does not call `_find_matching_floating_dtype`. However, it is related to input validation.\n- `sklearn/_config.py`: Related to configuration settings, particularly `array_api_dispatch`.\n- `sklearn/utils/_param_validation.py`: Related to parameter validation, but not directly to the feature described.\n\nBased on the above analysis, we should focus on modifying `_check_reg_targets` in `_regression.py` to incorporate the `_find_matching_floating_dtype` logic from `_array_api.py`.\n\nHere are the relevant files and locations:\n\n```\nsklearn/metrics/_regression.py\nline: 58\nline: 70\nline: 207\nline: 214\nline: 497\nline: 504\nfunction: _check_reg_targets\n\nsklearn/utils/_array_api.py\nline: 634\nfunction: _find_matching_floating_dtype\n```\n\n<finish></finish>", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 226783, "completion_tokens": 593}, "time": 152.71168994903564}]}}
{"instance_id": "scikit-learn__scikit-learn-28678", "found_files": [["sklearn/feature_extraction/text.py", "sklearn/utils/validation.py"]], "found_modules": [["sklearn/feature_extraction/text.py:_VectorizerMixin", "sklearn/utils/validation.py:assert_all_finite", "sklearn/utils/validation.py:_assert_all_finite"]], "found_entities": [["sklearn/feature_extraction/text.py:_VectorizerMixin._check_stop_words_consistency", "sklearn/utils/validation.py:assert_all_finite", "sklearn/utils/validation.py:_assert_all_finite"]], "raw_output_loc": ["```\nsklearn/utils/_testing.py\nline: 699\nfunction: assert_docstring_consistency\n\nsklearn/utils/_testing.py\nline: 765\nfunction: _create_args\n\nsklearn/feature_extraction/text.py\nfunction: _VectorizerMixin._check_stop_words_consistency\n\nsklearn/utils/validation.py\nfunction: assert_all_finite\n\nsklearn/utils/validation.py\nfunction: _assert_all_finite\n```"], "meta_data": {"repo": "scikit-learn/scikit-learn", "base_commit": "2cbf3345bce979b261f7007616cc3465f33a51d3", "problem_statement": "[WIP] : Added assert_consistent_docs() and related tests\n\r\nFixes #9388 \r\n\r\nAdded a function to check for consistency between docstring of objects.\r\n\r\nIn this approach there is a python dictionary for each of Parameters, Attributes and Returns. Indexed by the name of the parameter/attribute/return with the value being a Python dictionary containing its type definition and description. The function checks for each object if the docstring is identical (excluding whitespaces) for a given parameter/attribute/return in the main dictionary. If a new parameter/attribute/return are found they are added in the main dictionary.\n", "patch": "diff --git a/sklearn/metrics/_classification.py b/sklearn/metrics/_classification.py\nindex 0175966a21b74..b69855633a730 100644\n--- a/sklearn/metrics/_classification.py\n+++ b/sklearn/metrics/_classification.py\n@@ -1727,14 +1727,18 @@ def precision_recall_fscore_support(\n         \"assigned\" 0 samples. For multilabel targets, labels are column indices.\n         By default, all labels in `y_true` and `y_pred` are used in sorted order.\n \n+        .. versionchanged:: 0.17\n+           Parameter `labels` improved for multiclass problem.\n+\n     pos_label : int, float, bool or str, default=1\n         The class to report if `average='binary'` and the data is binary,\n         otherwise this parameter is ignored.\n         For multiclass or multilabel targets, set `labels=[pos_label]` and\n         `average != 'binary'` to report metrics for one label only.\n \n-    average : {'binary', 'micro', 'macro', 'samples', 'weighted'}, \\\n-            default=None\n+    average : {'micro', 'macro', 'samples', 'weighted', 'binary'} or None, \\\n+            default='binary'\n+        This parameter is required for multiclass/multilabel targets.\n         If ``None``, the metrics for each class are returned. Otherwise, this\n         determines the type of averaging performed on the data:\n \n"}, "usage": {"cost($)": "0", "prompt_tokens": 230135, "completion_tokens": 678}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'scikit-learn' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY