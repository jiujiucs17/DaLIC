 **d)\n  94 |     else:\n  95 |         with warnings.catch_warnings():\n  96 |             # TODO: If we knew what was going in to **d, we might be able to\n  97 |             #  go through _simple_new instead\n  98 |             warnings.simplefilter(\"ignore\")\n  99 |             result = cls.__new__(cls, **d)\n 100 | \n 101 |     return result\n 102 | \n 103 | \n 104 | @inherit_names(\n 105 |     DatetimeArray._field_ops\n 106 |     + [\n 107 |         method\n 108 |         for method in DatetimeArray._datetimelike_methods\n 109 |         if method not in (\"tz_localize\", \"tz_convert\", \"strftime\")\n 110 |     ],\n 111 |     DatetimeArray,\n 112 |     wrap=True,\n 113 | )\n 114 | @inherit_names([\"is_normalized\"], DatetimeArray, cache=True)\n 115 | @inherit_names(\n 116 |     [\n 117 |         \"tz\",\n 118 |         \"tzinfo\",\n 119 |         \"dtype\",\n 120 |         \"to_pydatetime\",\n 121 |         \"date\",\n 122 |         \"time\",\n 123 |         \"timetz\",\n 124 |         \"std\",\n 125 |     ]\n 126 |     + DatetimeArray._bool_ops,\n 127 |     DatetimeArray,\n 128 | )\n 129 | class DatetimeIndex(DatetimeTimedeltaMixin):\n 130 |     \"\"\"\n 131 |     Immutable ndarray-like of datetime64 data.\n 132 | \n 133 |     Represented internally as int64, and which can be boxed to Timestamp objects\n 134 |     that are subclasses of datetime and carry metadata.\n 135 | \n 136 |     .. versionchanged:: 2.0.0\n 137 |         The various numeric date/time attributes (:attr:`~DatetimeIndex.day`,\n 138 |         :attr:`~DatetimeIndex.month`, :attr:`~DatetimeIndex.year` etc.) now have dtype\n 139 |         ``int32``. Previously they had dtype ``int64``.\n 140 | \n 141 |     Parameters\n 142 |     ----------\n 143 |     data : array-like (1-dimensional)\n 144 |         Datetime-like data to construct index with.\n 145 |     freq : str or pandas offset object, optional\n 146 |         One of pandas date offset strings or corresponding objects. The string\n 147 |         'infer' can be passed in order to set the frequency of the index as the\n 148 |         inferred frequency upon creation.\n 149 |     tz : zoneinfo.ZoneInfo, pytz.timezone, dateutil.tz.tzfile, datetime.tzinfo or str\n 150 |         Set the Timezone of the data.\n 151 |     ambiguous : 'infer', bool-ndarray, 'NaT', default 'raise'\n 152 |         When clocks moved backward due to DST, ambiguous times may arise.\n 153 |         For example in Central European Time (UTC+01), when going from 03:00\n 154 |         DST to 02:00 non-DST, 02:30:00 local time occurs both at 00:30:00 UTC\n 155 |         and at 01:30:00 UTC. In such a situation, the `ambiguous` parameter\n 156 |         dictates how ambiguous times should be handled.\n 157 | \n 158 |         - 'infer' will attempt to infer fall dst-transition hours based on\n 159 |           order\n 160 |         - bool-ndarray where True signifies a DST time, False signifies a\n 161 |           non-DST time (note that this flag is only applicable for ambiguous\n 162 |           times)\n 163 |         - 'NaT' will return NaT where there are ambiguous times\n 164 |         - 'raise' will raise a ValueError if there are ambiguous times.\n 165 |     dayfirst : bool, default False\n 166 |         If True, parse dates in `data` with the day first order.\n 167 |     yearfirst : bool, default False\n 168 |         If True parse dates in `data` with the year first order.\n 169 |     dtype : numpy.dtype or DatetimeTZDtype or str, default None\n 170 |         Note that the only NumPy dtype allowed is `datetime64[ns]`.\n 171 |     copy : bool, default False\n 172 |         Make a copy of input ndarray.\n 173 |     name : label, default None\n 174 |         Name to be stored in the index.\n 175 | \n 176 |     Attributes\n 177 |     ----------\n 178 |     year\n 179 |     month\n 180 |     day\n 181 |     hour\n 182 |     minute\n 183 |     second\n 184 |     microsecond\n 185 |     nanosecond\n 186 |     date\n 187 |     time\n 188 |     timetz\n 189 |     dayofyear\n 190 |     day_of_year\n 191 |     dayofweek\n 192 |     day_of_week\n 193 |     weekday\n 194 |     quarter\n 195 |     tz\n 196 |     freq\n 197 |     freqstr\n 198 |     is_month_start\n 199 |     is_month_end\n 200 |     is_quarter_start\n 201 |     is_quarter_end\n 202 |     is_year_start\n 203 |     is_year_end\n 204 |     is_leap_year\n 205 |     inferred_freq\n 206 | \n 207 |     Methods\n 208 |     -------\n 209 |     normalize\n 210 |     strftime\n 211 |     snap\n 212 |     tz_convert\n 213 |     tz_localize\n 214 |     round\n 215 |     floor\n 216 |     ceil\n 217 |     to_period\n 218 |     to_pydatetime\n 219 |     to_series\n 220 |     to_frame\n 221 |     month_name\n 222 |     day_name\n 223 |     mean\n 224 |     std\n 225 | \n 226 |     See Also\n 227 |     --------\n 228 |     Index : The base pandas Index type.\n 229 |     TimedeltaIndex : Index of timedelta64 data.\n 230 |     PeriodIndex : Index of Period data.\n 231 |     to_datetime : Convert argument to datetime.\n 232 |     date_range : Create a fixed-frequency DatetimeIndex.\n 233 | \n 234 |     Notes\n 235 |     -----\n 236 |     To learn more about the frequency strings, please see\n 237 |     :ref:`this link<timeseries.offset_aliases>`.\n 238 | \n 239 |     Examples\n 240 |     --------\n 241 |     >>> idx = pd.DatetimeIndex([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n 242 |     >>> idx\n 243 |     DatetimeIndex(['2020-01-01 10:00:00+00:00', '2020-02-01 11:00:00+00:00'],\n 244 |     dtype='datetime64[s, UTC]', freq=None)\n 245 |     \"\"\"\n 246 | \n 247 |     _typ = \"datetimeindex\"\n 248 | \n 249 |     _data_cls = DatetimeArray\n 250 |     _supports_partial_string_indexing = True\n 251 | \n 252 |     @property\n 253 |     def _engine_type(self) -> type[libindex.DatetimeEngine]:\n 254 |         return libindex.DatetimeEngine\n 255 | \n 256 |     _data: DatetimeArray\n 257 |     _values: DatetimeArray\n 258 |     tz: dt.tzinf