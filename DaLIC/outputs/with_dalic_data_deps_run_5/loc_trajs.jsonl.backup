n 55 |         estimator, where the data needs to be indexed on both axes.\n 56 |         Specifically, this tag is used by\n 57 |         `sklearn.utils.metaestimators._safe_split` to slice rows and\n 58 |         columns.\n 59 |     \"\"\"\n 60 | \n 61 |     one_d_array: bool = False\n 62 |     two_d_array: bool = True\n 63 |     three_d_array: bool = False\n 64 |     sparse: bool = False\n 65 |     categorical: bool = False\n 66 |     string: bool = False\n 67 |     dict: bool = False\n 68 |     positive_only: bool = False\n 69 |     allow_nan: bool = False\n 70 |     pairwise: bool = False\n 71 | \n 72 | \n 73 | @dataclass(**_dataclass_args())\n 74 | class TargetTags:\n 75 |     \"\"\"Tags for the target data.\n 76 | \n 77 |     Parameters\n 78 |     ----------\n 79 |     required : bool\n 80 |         Whether the estimator requires y to be passed to `fit`,\n 81 |         `fit_predict` or `fit_transform` methods. The tag is ``True``\n 82 |         for estimators inheriting from `~sklearn.base.RegressorMixin`\n 83 |         and `~sklearn.base.ClassifierMixin`.\n 84 | \n 85 |     one_d_labels : bool, default=False\n 86 |         Whether the input is a 1D labels (y).\n 87 | \n 88 |     two_d_labels : bool, default=False\n 89 |         Whether the input is a 2D labels (y).\n 90 | \n 91 |     positive_only : bool, default=False\n 92 |         Whether the estimator requires a positive y (only applicable\n 93 |         for regression).\n 94 | \n 95 |     multi_output : bool, default=False\n 96 |         Whether a regressor supports multi-target outputs or a classifier supports\n 97 |         multi-class multi-output.\n 98 | \n 99 |     single_output : bool, default=True\n100 |         Whether the target can be single-output. This can be ``False`` if the\n101 |         estimator supports only multi-output cases.\n102 |     \"\"\"\n103 | \n104 |     required: bool\n105 |     one_d_labels: bool = False\n106 |     two_d_labels: bool = False\n107 |     positive_only: bool = False\n108 |     multi_output: bool = False\n109 |     single_output: bool = True\n110 | \n111 | \n112 | @dataclass(**_dataclass_args())\n113 | class TransformerTags:\n114 |     \"\"\"Tags for the transformer.\n115 | \n116 |     Parameters\n117 |     ----------\n118 |     preserves_dtype : list[str], default=[\"float64\"]\n119 |         Applies only on transformers. It corresponds to the data types\n120 |         which will be preserved such that `X_trans.dtype` is the same\n121 |         as `X.dtype` after calling `transformer.transform(X)`. If this\n122 |         list is empty, then the transformer is not expected to\n123 |         preserve the data type. The first value in the list is\n124 |         considered as the default data type, corresponding to the data\n125 |         type of the output when the input data type is not going to be\n126 |         preserved.\n127 |     \"\"\"\n128 | \n129 |     preserves_dtype: list[str] = field(default_factory=lambda: [\"float64\"])\n130 | \n131 | \n132 | @dataclass(**_dataclass_args())\n133 | class ClassifierTags:\n134 |     \"\"\"Tags for the classifier.\n135 | \n136 |     Parameters\n137 |     ----------\n138 |     poor_score : bool, default=False\n139 |         Whether the estimator fails to provide a \"reasonable\" test-set\n140 |         score, which currently for classification is an accuracy of\n141 |         0.83 on ``make_blobs(n_samples=300, random_state=0)``. The\n142 |         datasets and values are based on current estimators in scikit-learn\n143 |         and might be replaced by something more systematic.\n144 | \n145 |     multi_class : bool, default=True\n146 |         Whether the classifier can handle multi-class\n147 |         classification. Note that all classifiers support binary\n148 |         classification. Therefore this flag indicates whether the\n149 |         classifier is a binary-classifier-only or not.\n150 | \n151 |     multi_label : bool, default=False\n152 |         Whether the classifier supports multi-label output.\n153 |     \"\"\"\n154 | \n155 |     poor_score: bool = False\n156 |     multi_class: bool = True\n157 |     multi_label: bool = False\n158 | \n159 | \n160 | @dataclass(**_dataclass_args())\n161 | class RegressorTags:\n162 |     \"\"\"Tags for the regressor.\n163 | \n164 |     Parameters\n165 |     ----------\n166 |     poor_score : bool, default=False\n167 |         Whether the estimator fails to provide a \"reasonable\" test-set\n168 |         score, which currently for regression is an R2 of 0.5 on\n169 |         ``make_regression(n_samples=200, n_features=10,\n170 |         n_informative=1, bias=5.0, noise=20, random_state=42)``. The\n171 |         dataset and values are based on current estimators in scikit-learn\n172 |         and might be replaced by something more systematic.\n173 | \n174 |     multi_label : bool, default=False\n175 |         Whether the regressor supports multilabel output.\n176 |     \"\"\"\n177 | \n178 |     poor_score: bool = False\n179 |     multi_label: bool = False\n180 | \n181 | \n182 | @dataclass(**_dataclass_args())\n183 | class Tags:\n184 |     \"\"\"Tags for the estimator.\n185 | \n186 |     See :ref:`estimator_tags` for more information.\n187 | \n188 |     Parameters\n189 |     ----------\n190 |     estimator_type : str or None\n191 |         The type of the estimator. Can be one of:\n192 |         - \"classifier\"\n193 |         - \"regressor\"\n194 |         - \"transformer\"\n195 |         - \"clusterer\"\n196 |         - \"outlier_detector\"\n197 |         - \"density_estimator\"\n198 | \n199 |     target_tags : :class:`TargetTags`\n200 |         The target(y) tags.\n201 | \n202 |     transformer_tags : :class:`TransformerTags` or None\n203 |         The transformer tags.\n204 | \n205 |     classifier_tags : :class:`ClassifierTags` or None\n206 |         The classifier tags.\n207 | \n208 |     regressor_tags : :class:`RegressorTags` or None\n209 |         The regressor tags.\n210 | \n211 |    