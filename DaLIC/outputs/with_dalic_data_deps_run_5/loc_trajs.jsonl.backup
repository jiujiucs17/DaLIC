h (bm25).\n```\n560 | def generate_min_dependency_table(app):\n561 |     \"\"\"Generate min dependency table for docs.\"\"\"\n562 |     from sklearn._min_dependencies import dependent_packages\n563 | \n564 |     # get length of header\n565 |     package_header_len = max(len(package) for package in dependent_packages) + 4\n566 |     version_header_len = len(\"Minimum Version\") + 4\n567 |     tags_header_len = max(len(tags) for _, tags in dependent_packages.values()) + 4\n568 | \n569 |     output = StringIO()\n570 |     output.write(\n571 |         \" \".join(\n572 |             [\"=\" * package_header_len, \"=\" * version_header_len, \"=\" * tags_header_len]\n573 |         )\n574 |     )\n575 |     output.write(\"\\n\")\n576 |     dependency_title = \"Dependency\"\n577 |     version_title = \"Minimum Version\"\n578 |     tags_title = \"Purpose\"\n579 | \n580 |     output.write(\n581 |         f\"{dependency_title:<{package_header_len}} \"\n582 |         f\"{version_title:<{version_header_len}} \"\n583 |         f\"{tags_title}\\n\"\n584 |     )\n585 | \n586 |     output.write(\n587 |         \" \".join(\n588 |             [\"=\" * package_header_len, \"=\" * version_header_len, \"=\" * tags_header_len]\n589 |         )\n590 |     )\n591 |     output.write(\"\\n\")\n592 | \n593 |     for package, (version, tags) in dependent_packages.items():\n594 |         output.write(\n595 |             f\"{package:<{package_header_len}} {version:<{version_header_len}} {tags}\\n\"\n596 |         )\n597 | \n598 |     output.write(\n599 |         \" \".join(\n600 |             [\"=\" * package_header_len, \"=\" * version_header_len, \"=\" * tags_header_len]\n601 |         )\n602 |     )\n603 |     output.write(\"\\n\")\n604 |     output = output.getvalue()\n605 | \n606 |     with (Path(\".\") / \"min_dependency_table.rst\").open(\"w\") as f:\n607 |         f.write(output)\n```\n\nFound function `doc/conf.py:generate_min_dependency_substitutions`.\nSource: Retrieved code content usin