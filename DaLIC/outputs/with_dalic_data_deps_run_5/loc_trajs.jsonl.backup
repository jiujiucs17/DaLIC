s = subplots\n171 | \n172 |         if sharex is None:\n173 | \n174 |             # if by is defined, subplots are used and sharex should be False\n175 |             if ax is None and by is None:\n176 |                 self.sharex = True\n177 |             else:\n178 |                 # if we get an axis, the users should do the visibility\n179 |                 # setting...\n180 |                 self.sharex = False\n181 |         else:\n182 |             self.sharex = sharex\n183 | \n184 |         self.sharey = sharey\n185 |         self.figsize = figsize\n186 |         self.layout = layout\n187 | \n188 |         self.xticks = xticks\n189 |         self.yticks = yticks\n190 |         self.xlim = xlim\n191 |         self.ylim = ylim\n192 |         self.title = title\n193 |         self.use_index = use_index\n194 |         self.xlabel = xlabel\n195 |         self.ylabel = ylabel\n196 | \n197 |         self.fontsize = fontsize\n198 | \n199 |         if rot is not None:\n200 |             self.rot = rot\n201 |             # need to know for format_date_labels since it's rotated to 30 by\n202 |             # default\n203 |             self._rot_set = True\n204 |         else:\n205 |             self._rot_set = False\n206 |             self.rot = self._default_rot\n207 | \n208 |         if grid is None:\n209 |             grid = False if secondary_y else plt.rcParams[\"axes.grid\"]\n210 | \n211 |         self.grid = grid\n212 |         self.legend = legend\n213 |         self.legend_handles: list[Artist] = []\n214 |         self.legend_labels: list[Hashable] = []\n215 | \n216 |         self.logx = kwds.pop(\"logx\", False)\n217 |         self.logy = kwds.pop(\"logy\", False)\n218 |         self.loglog = kwds.pop(\"loglog\", False)\n219 |         self.label = kwds.pop(\"label\", None)\n220 |         self.style = kwds.pop(\"style\", None)\n221 |         self.mark_right = kwds.pop(\"mark_right\", True)\n222 |         self.stacked = kwds.pop(\"stacked\", False)\n223 | \n224 |         self.ax = ax\n225 |         self.fig = fig\n226 |         self.axes = np.array([], dtype=object)  # \"real\" version get set in `generate`\n227 | \n228 |         # parse errorbar input if given\n229 |         xerr = kwds.pop(\"xerr\", None)\n230 |         yerr = kwds.pop(\"yerr\", None)\n231 |         self.errors = {\n232 |             kw: self._parse_errorbars(kw, err)\n233 |             for kw, err in zip([\"xerr\", \"yerr\"], [xerr, yerr])\n234 |         }\n235 | \n236 |         if not isinstance(secondary_y, (bool, tuple, list, np.ndarray, ABCIndex)):\n237 |             secondary_y = [secondary_y]\n238 |         self.secondary_y = secondary_y\n239 | \n240 |         # ugly TypeError if user passes matplotlib's `cmap` name.\n241 |         # Probably better to accept either.\n242 |         if \"cmap\" in kwds and colormap:\n243 |             raise TypeError(\"Only specify one of `cmap` and `colormap`.\")\n244 |         elif \"cmap\" in kwds:\n245 |             self.colormap = kwds.pop(\"cmap\")\n246 |         else:\n247 |             self.colormap = colormap\n248 | \n249 |         self.table = table\n250 |         self.include_bool = include_bool\n251 | \n252 |         self.kwds = kwds\n253 | \n254 |         self._validate_color_args()\n255 | \n256 |     def _validate_color_args(self):\n257 |         if (\n258 |             \"color\" in self.kwds\n259 |             and self.nseries == 1\n260 |             and not is_list_like(self.kwds[\"color\"])\n261 |         ):\n262 |             # support series.plot(color='green')\n263 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n264 | \n265 |         if (\n266 |             \"color\" in self.kwds\n267 |             and isinstance(self.kwds[\"color\"], tuple)\n268 |             and self.nseries == 1\n269 |             and len(self.kwds[\"color\"]) in (3, 4)\n270 |         ):\n271 |             # support RGB and RGBA tuples in series plot\n272 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n273 | \n274 |         if (\n275 |             \"color\" in self.kwds or \"colors\" in self.kwds\n276 |         ) and self.colormap is not None:\n277 |             warnings.warn(\n278 |                 \"'color' and 'colormap' cannot be used simultaneously. Using 'color'\"\n279 |             )\n280 | \n281 |         if \"color\" in self.kwds and self.style is not None:\n282 |             if is_list_like(self.style):\n283 |                 styles = self.style\n284 |             else:\n285 |                 styles = [self.style]\n286 |             # need only a single match\n287 |             for s in styles:\n288 |                 if _color_in_style(s):\n289 |                     raise ValueError(\n290 |                         \"Cannot pass 'style' string with a color symbol and \"\n291 |                         \"'color' keyword argument. Please use one or the \"\n292 |                         \"other or pass 'style' without a color symbol\"\n293 |                     )\n294 | \n295 |     def _iter_data(self, data=None, keep_index=False, fillna=None):\n296 |         if data is None:\n297 |             data = self.data\n298 |         if fillna is not None:\n299 |             data = data.fillna(fillna)\n300 | \n301 |         for col, values in data.items():\n302 |             if keep_index is True:\n303 |                 yield col, values\n304 |             else:\n305 |                 yield col, values.values\n306 | \n307 |     @property\n308 |     def nseries(self) -> int:\n309 | \n310 |         # When `by` is explicitly assigned, grouped data size will be defined, and\n311 |         # this will determine number of subplots to have, aka `self.nseries`\n312 |         if self.data.ndim == 1:\n313 |             return 1\n314 |         elif self.by is not None and self._kind == \"hist\":\n315 |             return len(self._grouped)\n316 |         elif self.by is not None and self._kind == \"box\":\n317 |             return len(self.columns)\n318 |         else:\n319 |             return self.data.shape[1]\n320 | \n321 |     def draw(self):\n322 |         self.plt.draw_if_interactive()\n323 | \n324 |     def generate(self):\n325 |         self._args_adjust()\n326 |         self._compute_plot_data()\n327 |         self._setup_subplots()\n328 |         self._make_plot()\n329 |         self._add_table()\n330 |         self._make_legend()\n331 |         self._adorn_subplots()\n332 | \n333 |         for ax in self.axes:\n334 |             self._post_plot_logic_common(ax, self.data)\n335 |             self._post_plot_logic(ax, self.data)\n336 | \n337 |     def _args_adjust(self):\n338 |         pass\n339 | \n340 |     def _has_plotted_object(self, ax: Axes) -> bool:\n341 |         \"\"\"check whether ax has data\"\"\"\n342 |         return len(ax.lines) != 0 or len(ax.artists) != 0 or len(ax.containers) != 0\n343 | \n344 |     def _maybe_right_yaxis(self, ax: Axes, axes_num):\n345 |         if not self.on_right(axes_num):\n346 |             # secondary axes may be passed via ax kw\n347 |             return self._get_ax_layer(ax)\n348 | \n349 |         if hasattr(ax, \"right_ax\"):\n350 |             # if it has right_ax property, ``ax`` must be left axes\n351 |             return ax.right_ax\n352 |         elif hasattr(ax, \"left_ax\"):\n353 |             # if it has left_ax property, ``ax`` must be right axes\n354 |             return ax\n355 |         else:\n356 |             # otherwise, create twin axes\n357 |             orig_ax, new_ax = ax, ax.twinx()\n358 |             # TODO: use Matplotlib public API when available\n359 |             new_ax._get_lines = orig_ax._get_lines\n360 |             new_ax._get_patches_for_fill = orig_ax._get_patches_for_fill\n361 |             orig_ax.right_ax, new_ax.left_ax = new_ax, orig_ax\n362 | \n363 |             if not self._has_plotted_object(orig_ax):  # no data on left y\n364 |                 orig_ax.get_yaxis().set_visible(False)\n365 | \n366 |             if self.logy is True or self.loglog is True:\n367 |                 new_ax.set_yscale(\"log\")\n368 |             elif self.logy == \"sym\" or self.loglog == \"sym\":\n369 |                 new_ax.set_yscale(\"symlog\")\n370 |             return new_ax\n371 | \n372 |     def _setup_subplots(self):\n373 |         if self.subplots:\n374 |             fig, axes = create_subplots(\n375 |                 naxes=self.nseries,\n376 |                 sharex=self.sharex,\n377 |                 sharey=self.sharey,\n378 |                 figsize=self.figsize,\n379 |                 ax=self.ax,\n380 |                 layout=self.layout,\n381 |                 layout_type=self._layout_type,\n382 |             )\n383 |         else:\n384 |             if self.ax is None:\n385 |                 fig = self.plt.figure(figsize=self.figsize)\n386 |                 axes = fig.add_subplot(111)\n387 |             else:\n388 |                 fig = self.ax.get_figure()\n389 |                 if self.figsize is not None:\n390 |                     fig.set_size_inches(self.figsize)\n391 |                 axes = self.ax\n392 | \n393 |         axes = flatten_axes(axes)\n394 | \n395 |         valid_log = {False, True, \"sym\", None}\n396 |         input_log = {self.logx, self.logy, self.loglog}\n397 |         if input_log - valid_log:\n398 |             invalid_log = next(iter(input_log - valid_log))\n399 |             raise ValueError(\n400 |                 f\"Boolean, None and 'sym' are valid options, '{invalid_log}' is given.\"\n401 |             )\n402 | \n403 |         if self.logx is True or self.loglog is True:\n404 |             [a.set_xscale(\"log\") for a in axes]\n405 |         elif self.logx == \"sym\" or self.loglog == \"sym\":\n406 |             [a.set_xscale(\"symlog\") for a in axes]\n407 | \n408 |         if self.logy is True or self.loglog is True:\n409 |             [a.set_yscale(\"log\") for a in axes]\n410 |         elif self.logy == \"sym\" or self.loglog == \"sym\":\n411 |             [a.set_yscale(\"symlog\") for a in axes]\n412 | \n413 |         self.fig = fig\n414 |         self.axes = axes\n415 | \n416 |     @property\n417 |     def result(self):\n418 |         \"\"\"\n419 |         Return result axes\n420 |         \"\"\"\n421 |         if self.subplots:\n422 |             if self.layout is not None and not is_list_like(self.ax):\n423 |                 return self.axes.reshape(*self.layout)\n424 |             else:\n425 |                 return self.axes\n426 |         else:\n427 |             sec_true = isinstance(self.secondary_y, bool) and self.secondary_y\n428 |             all_sec = (\n429 |                 is_list_like(self.secondary_y) and len(self.secondary_y) == self.nseries\n430 |             )\n431 |             if sec_true or all_sec:\n432 |                 # if all data is plotted on secondary, return right axes\n433 |                 return self._get_ax_layer(self.axes[0], primary=False)\n434 |             else:\n435 |                 return self.axes[0]\n436 | \n437 |     def _convert_to_ndarray(self, data):\n438 |         # GH31357: categorical columns are processed separately\n439 |         if is_categorical_dtype(data):\n440 |             return data\n441 | \n442 |         # GH32073: cast to float if values contain nulled integers\n443 |         if (\n444 |             is_integer_dtype(data.dtype) or is_float_dtype(data.dtype)\n445 |         ) and is_extension_array_dtype(data.dtype):\n446 |             return data.to_numpy(dtype=\"float\", na_value=np.nan)\n447 | \n448 |         # GH25587: cast ExtensionArray of pandas (IntegerArray, etc.) to\n449 |         # np.ndarray before plot.\n450 |         if len(data) > 0:\n451 |             return np.asarray(data)\n452 | \n453 |         return data\n454 | \n455 |     def _compute_plot_data(self):\n456 |         data = self.data\n457 | \n458 |         if isinstance(data, ABCSeries):\n459 |             label = self.label\n460 |             if label is None and data.name is None:\n461 |                 label = \"\"\n462 |             if label is None:\n463 |                 # We'll end up with columns of [0] instead of [None]\n464 |                 data = data.to_frame()\n465 |             else:\n466 |                 data = data.to_frame(name=label)\n467 |         elif self._kind in (\"hist\", \"box\"):\n468 |             cols = self.columns if self.by is None else self.columns + self.by\n469 |             data = data.loc[:, cols]\n470 | \n471 |         # GH15079 reconstruct data if by is defined\n472 |         if self.by is not None:\n473 |             self.subplots = True\n474 |             data = reconstruct_data_with_by(self.data, by=self.by, cols=self.columns)\n475 | \n476 |         # GH16953, _convert is needed as fallback, for ``Series``\n477 |         # with ``dtype == object``\n478 |         data = data._convert(datetime=True, timedelta=True)\n479 |         include_type = [np.number, \"datetime\", \"datetimetz\", \"timedelta\"]\n480 | \n481 |         # GH23719, allow plotting boolean\n482 |         if self.include_bool is True:\n483 |             include_type.append(np.bool_)\n484 | \n485 |         # GH22799, exclude datetime-like type for boxplot\n486 |         exclude_type = None\n487 |         if self._kind == \"box\":\n488 |             # TODO: change after solving issue 27881\n489 |             include_type = [np.number]\n490 |             exclude_type = [\"timedelta\"]\n491 | \n492 |         # GH 18755, include object and category type for scatter plot\n493 |         if self._kind == \"scatter\":\n494 |             include_type.extend([\"object\", \"category\"])\n495 | \n496 |         numeric_data = data.select_dtypes(include=include_type, exclude=exclude_type)\n497 | \n498 |         try:\n499 |             is_empty = numeric_data.columns.empty\n500 |         except AttributeError:\n501 |             is_empty = not len(numeric_data)\n502 | \n503 |         # no non-numeric frames or series allowed\n504 |         if is_empty:\n505 |             raise TypeError(\"no numeric data to plot\")\n506 | \n507 |         self.data = numeric_data.apply(self._convert_to_ndarray)\n508 | \n509 |     def _make_plot(self):\n510 |         raise AbstractMethodError(self)\n511 | \n512 |     def _add_table(self):\n513 |         if self.table is False:\n514 |             return\n515 |         elif self.table is True:\n516 |             data = self.data.transpose()\n517 |         else:\n518 |             data = self.table\n519 |         ax = self._get_ax(0)\n520 |         table(ax, data)\n521 | \n522 |     def _post_plot_logic_common(self, ax, data):\n523 |         \"\"\"Common post process for each axes\"\"\"\n524 |         if self.orientation == \"vertical\" or self.orientation is None:\n525 |             self._apply_axis_properties(ax.xaxis, rot=self.rot, fontsize=self.fontsize)\n526 |             self._apply_axis_properties(ax.yaxis, fontsize=self.fontsize)\n527 | \n528 |             if hasattr(ax, \"right_ax\"):\n529 |                 self._apply_axis_properties(ax.right_ax.yaxis, fontsize=self.fontsize)\n530 | \n531 |         elif self.orientation == \"horizontal\":\n532 |             self._apply_axis_properties(ax.yaxis, rot=self.rot, fontsize=self.fontsize)\n533 |             self._apply_axis_properties(ax.xaxis, fontsize=self.fontsize)\n534 | \n535 |             if hasattr(ax, \"right_ax\"):\n536 |                 self._apply_axis_properties(ax.right_ax.yaxis, fontsize=self.fontsize)\n537 |         else:  # pragma no cover\n538 |             raise ValueError\n539 | \n540 |     def _post_plot_logic(self, ax, data):\n541 |         \"\"\"Post process for each axes. Overridden in child classes\"\"\"\n542 |         pass\n543 | \n544 |     def _adorn_subplots(self):\n545 |         \"\"\"Common post process unrelated to data\"\"\"\n546 |         if len(self.axes) > 0:\n547 |             all_axes = self._get_subplots()\n548 |             nrows, ncols = self._get_axes_layout()\n549 |             handle_shared_axes(\n550 |                 axarr=all_axes,\n551 |                 nplots=len(all_axes),\n552 |                 naxes=nrows * ncols,\n553 |                 nrows=nrows,\n554 |                 ncols=ncols,\n555 |                 sharex=self.sharex,\n556 |                 sharey=self.sharey,\n557 |             )\n558 | \n559 |         for ax in self.axes:\n560 |             if self.yticks is not None:\n561 |                 ax.set_yticks(self.yticks)\n562 | \n563 |             if self.xticks is not None:\n564 |                 ax.set_xticks(self.xticks)\n565 | \n566 |             if self.ylim is not None:\n567 |                 ax.set_ylim(self.ylim)\n568 | \n569 |             if self.xlim is not None:\n570 |                 ax.set_xlim(self.xlim)\n571 | \n572 |             # GH9093, currently Pandas does not show ylabel, so if users provide\n573 |             # ylabel will set it as ylabel in the plot.\n574 |             if self.ylabel is not None:\n575 |                 ax.set_ylabel(pprint_thing(self.ylabel))\n576 | \n577 |             ax.grid(self.grid)\n578 | \n579 |         if self.title:\n580 |             if self.subplots:\n581 |                 if is_list_like(self.title):\n582 |                     if len(self.title) != self.nseries:\n583 |                         raise ValueError(\n584 |                             \"The length of `title` must equal the number \"\n585 |                             \"of columns if using `title` of type `list` \"\n586 |                             \"and `subplots=True`.\\n\"\n587 |                             f\"length of title = {len(self.title)}\\n\"\n588 |                             f\"number of columns = {self.nseries}\"\n589 |                         )\n590 | \n591 |                     for (ax, title) in zip(self.axes, self.title):\n592 |                         ax.set_title(title)\n593 |                 else:\n594 |                     self.fig.suptitle(self.title)\n595 |             else:\n596 |                 if is_list_like(self.title):\n597 |                     msg = (\n598 |                         \"Using `title` of type `list` is not supported \"\n599 |                         \"unless `subplots=True` is passed\"\n600 |                     )\n601 |                     raise ValueError(msg)\n602 |                 self.axes[0].set_title(self.title)\n603 | \n604 |     def _apply_axis_properties(self, axis: Axis, rot=None, fontsize=None):\n605 |         \"\"\"\n606 |         Tick creation within matplotlib is reasonably expensive and is\n607 |         internally deferred until accessed as Ticks are created/destroyed\n608 |         multiple times per draw. It's therefore beneficial for us to avoid\n609 |         accessing unless we will act on the Tick.\n610 |         \"\"\"\n611 |         if rot is not None or fontsize is not None:\n612 |             # rot=0 is a valid setting, hence the explicit None check\n613 |             labels = axis.get_majorticklabels() + axis.get_minorticklabels()\n614 |             for label in labels:\n615 |                 if rot is not None:\n616 |                     label.set_rotation(rot)\n617 |                 if fontsize is not None:\n618 |                     label.set_fontsize(fontsize)\n619 | \n620 |     @property\n621 |     def legend_title(self) -> str | None:\n622 |         if not isinstance(self.data.columns, ABCMultiIndex):\n623 |             name = self.data.columns.name\n624 |             if name is not None:\n625 |                 name = pprint_thing(name)\n626 |             return name\n627 |         else:\n628 |             stringified = map(pprint_thing, self.data.columns.names)\n629 |             return \",\".join(stringified)\n630 | \n631 |     def _mark_right_label(self, label: str, index: int) -> str:\n632 |         \"\"\"\n633 |         Append ``(right)`` to the label of a line if it's plotted on the right axis.\n634 | \n635 |         Note that ``(right)`` is only appended when ``subplots=False``.\n636 |         \"\"\"\n637 |         if not self.subplots and self.mark_right and self.on_right(index):\n638 |             label += \" (right)\"\n639 |         return label\n640 | \n641 |     def _append_legend_handles_labels(self, handle: Artist, label: str) -> None:\n642 |         \"\"\"\n643 |         Append current handle and label to ``legend_handles`` and ``legend_labels``.\n644 | \n645 |         These will be used to make the legend.\n646 |         \"\"\"\n647 |         self.legend_handles.append(handle)\n648 |         self.legend_labels.append(label)\n649 | \n650 |     def _make_legend(self) -> None:\n651 |         ax, leg = self._get_ax_legend(self.axes[0])\n652 | \n653 |         handles = []\n654 |         labels = []\n655 |         title = \"\"\n656 | \n657 |         if not self.subplots:\n658 |             if leg is not None:\n659 |                 title = leg.get_title().get_text()\n660 |                 # Replace leg.LegendHandles because it misses marker info\n661 |                 handles = leg.legendHandles\n662 |                 labels = [x.get_text() for x in leg.get_texts()]\n663 | \n664 |             if self.legend:\n665 |                 if self.legend == \"reverse\":\n666 |                     handles += reversed(self.legend_handles)\n667 |                     labels += reversed(self.legend_labels)\n668 |                 else:\n669 |                     handles += self.legend_handles\n670 |                     labels += self.legend_labels\n671 | \n672 |                 if self.legend_title is not None:\n673 |                     title = self.legend_title\n674 | \n675 |             if len(handles) > 0:\n676 |                 ax.legend(handles, labels, loc=\"best\", title=title)\n677 | \n678 |         elif self.subplots and self.legend:\n679 |             for ax in self.axes:\n680 |                 if ax.get_visible():\n681 |                     ax.legend(loc=\"best\")\n682 | \n683 |     def _get_ax_legend(self, ax: Axes):\n684 |         \"\"\"\n685 |         Take in axes and return ax and legend under different scenarios\n686 |         \"\"\"\n687 |         leg = ax.get_legend()\n688 | \n689 |         other_ax = getattr(ax, \"left_ax\", None) or getattr(ax, \"right_ax\", None)\n690 |         other_leg = None\n691 |         if other_ax is not None:\n692 |             other_leg = other_ax.get_legend()\n693 |         if leg is None and other_leg is not None:\n694 |             leg = other_leg\n695 |             ax = other_ax\n696 |         return ax, leg\n697 | \n698 |     @cache_readonly\n699 |     def plt(self):\n700 |         import matplotlib.pyplot as plt\n701 | \n702 |         return plt\n703 | \n704 |     _need_to_set_index = False\n705 | \n706 |     def _get_xticks(self, convert_period: bool = False):\n707 |         index = self.data.index\n708 |         is_datetype = index.inferred_type in (\"datetime\", \"date\", \"datetime64\", \"time\")\n709 | \n710 |         if self.use_index:\n711 |             if convert_period and isinstance(index, ABCPeriodIndex):\n712 |                 self.data = self.data.reindex(index=index.sort_values())\n713 |                 x = self.data.index.to_timestamp()._mpl_repr()\n714 |             elif index.is_numeric():\n715 |                 \"\"\"\n716 |                 Matplotlib supports numeric values or datetime objects as\n717 |                 xaxis values. Taking LBYL approach here, by the time\n718 |                 matplotlib raises exception when using non numeric/datetime\n719 |                 values for xaxis, several actions are already taken by plt.\n720 |                 \"\"\"\n721 |                 x = index._mpl_repr()\n722 |             elif is_datetype:\n723 |                 self.data = self.data[notna(self.data.index)]\n724 |                 self.data = self.data.sort_index()\n725 |                 x = self.data.index._mpl_repr()\n726 |             else:\n727 |                 self._need_to_set_index = True\n728 |                 x = list(range(len(index)))\n729 |         else:\n730 |             x = list(range(len(index)))\n731 | \n732 |         return x\n733 | \n734 |     @classmethod\n735 |     @register_pandas_matplotlib_converters\n736 |     def _plot(cls, ax: Axes, x, y, style=None, is_errorbar: bool = False, **kwds):\n737 |         mask = isna(y)\n738 |         if mask.any():\n739 |             y = np.ma.array(y)\n740 |             y = np.ma.masked_where(mask, y)\n741 | \n742 |         if isinstance(x, ABCIndex):\n743 |             x = x._mpl_repr()\n744 | \n745 |         if is_errorbar:\n746 |             if \"xerr\" in kwds:\n747 |                 kwds[\"xerr\"] = np.array(kwds.get(\"xerr\"))\n748 |             if \"yerr\" in kwds:\n749 |                 kwds[\"yerr\"] = np.array(kwds.get(\"yerr\"))\n750 |             return ax.errorbar(x, y, **kwds)\n751 |         else:\n752 |             # prevent style kwarg from going to errorbar, where it is unsupported\n753 |             args = (x, y, style) if style is not None else (x, y)\n754 |             return ax.plot(*args, **kwds)\n755 | \n756 |     def _get_custom_index_name(self):\n757 |         \"\"\"Specify whether xlabel/ylabel should be used to override index name\"\"\"\n758 |         return self.xlabel\n759 | \n760 |     def _get_index_name(self) -> str | None:\n761 |         if isinstance(self.data.index, ABCMultiIndex):\n762 |             name = self.data.index.names\n763 |             if com.any_not_none(*name):\n764 |                 name = \",\".join([pprint_thing(x) for x in name])\n765 |             else:\n766 |                 name = None\n767 |         else:\n768 |             name = self.data.index.name\n769 |             if name is not None:\n770 |                 name = pprint_thing(name)\n771 | \n772 |         # GH 45145, override the default axis label if one is provided.\n773 |         index_name = self._get_custom_index_name()\n774 |         if index_name is not None:\n775 |             name = pprint_thing(index_name)\n776 | \n777 |         return name\n778 | \n779 |     @classmethod\n780 |     def _get_ax_layer(cls, ax, primary=True):\n781 |         \"\"\"get left (primary) or right (secondary) axes\"\"\"\n782 |         if primary:\n783 |             return getattr(ax, \"left_ax\", ax)\n784 |         else:\n785 |             return getattr(ax, \"right_ax\", ax)\n786 | \n787 |     def _get_ax(self, i: int):\n788 |         # get the twinx ax if appropriate\n789 |         if self.subplots:\n790 |             ax = self.axes[i]\n791 |             ax = self._maybe_right_yaxis(ax, i)\n792 |             self.axes[i] = ax\n793 |         else:\n794 |             ax = self.axes[0]\n795 |             ax = self._maybe_right_yaxis(ax, i)\n796 | \n797 |         ax.get_yaxis().set_visible(True)\n798 |         return ax\n799 | \n800 |     @classmethod\n801 |     def get_default_ax(cls, ax):\n802 |         import matplotlib.pyplot as plt\n803 | \n804 |         if ax is None and len(plt.get_fignums()) > 0:\n805 |             with plt.rc_context():\n806 |                 ax = plt.gca()\n807 |             ax = cls._get_ax_layer(ax)\n808 | \n809 |     def on_right(self, i):\n810 |         if isinstance(self.secondary_y, bool):\n811 |             return self.secondary_y\n812 | \n813 |         if isinstance(self.secondary_y, (tuple, list, np.ndarray, ABCIndex)):\n814 |             return self.data.columns[i] in self.secondary_y\n815 | \n816 |     def _apply_style_colors(self, colors, kwds, col_num, label):\n817 |         \"\"\"\n818 |         Manage style and color based on column number and its label.\n819 |         Returns tuple of appropriate style and kwds which \"color\" may be added.\n820 |         \"\"\"\n821 |         style = None\n822 |         if self.style is not None:\n823 |             if isinstance(self.style, list):\n824 |                 try:\n825 |                     style = self.style[col_num]\n826 |                 except IndexError:\n827 |                     pass\n828 |             elif isinstance(self.style, dict):\n829 |                 style = self.style.get(label, style)\n830 |             else:\n831 |                 style = self.style\n832 | \n833 |         has_color = \"color\" in kwds or self.colormap is not None\n834 |         nocolor_style = style is None or not _color_in_style(style)\n835 |         if (has_color or self.subplots) and nocolor_style:\n836 |             if isinstance(colors, dict):\n837 |                 kwds[\"color\"] = colors[label]\n838 |             else:\n839 |                 kwds[\"color\"] = colors[col_num % len(colors)]\n840 |         return style, kwds\n841 | \n842 |     def _get_colors(self, num_colors=None, color_kwds=\"color\"):\n843 |         if num_colors is None:\n844 |             num_colors = self.nseries\n845 | \n846 |         return get_standard_colors(\n847 |             num_colors=num_colors,\n848 |             colormap=self.colormap,\n849 |             color=self.kwds.get(color_kwds),\n850 |         )\n851 | \n852 |     def _parse_errorbars(self, label, err):\n853 |         \"\"\"\n854 |         Look for error keyword arguments and return the actual errorbar data\n855 |         or return the error DataFrame/dict\n856 | \n857 |         Error bars can be specified in several ways:\n858 |             Series: the user provides a pandas.Series object of the same\n859 |                     length as the data\n860 |             ndarray: provides a np.ndarray of the same length as the data\n861 |             DataFrame/dict: error values are paired with keys matching the\n862 |                     key in the plotted DataFrame\n863 |             str: the name of the column within the plotted DataFrame\n864 | \n865 |         Asymmetrical error bars are also supported, however raw error values\n866 |         must be provided in this case. For a ``N`` length :class:`Series`, a\n867 |         ``2xN`` array should be provided indicating lower and upper (or left\n868 |         and right) errors. For a ``MxN`` :class:`DataFrame`, asymmetrical errors\n869 |         should be in a ``Mx2xN`` array.\n870 |         \"\"\"\n871 |         if err is None:\n872 |             return None\n873 | \n874 |         def match_labels(data, e):\n875 |             e = e.reindex(data.index)\n876 |             return e\n877 | \n878 |         # key-matched DataFrame\n879 |         if isinstance(err, ABCDataFrame):\n880 | \n881 |             err = match_labels(self.data, err)\n882 |         # key-matched dict\n883 |         elif isinstance(err, dict):\n884 |             pass\n885 | \n886 |         # Series of error values\n887 |         elif isinstance(err, ABCSeries):\n888 |             # broadcast error series across data\n889 |             err = match_labels(self.data, err)\n890 |             err = np.atleast_2d(err)\n891 |             err = np.tile(err, (self.nseries, 1))\n892 | \n893 |         # errors are a column in the dataframe\n894 |         elif isinstance(err, str):\n895 |             evalues = self.data[err].values\n896 |             self.data = self.data[self.data.columns.drop(err)]\n897 |             err = np.atleast_2d(evalues)\n898 |             err = np.tile(err, (self.nseries, 1))\n899 | \n900 |         elif is_list_like(err):\n901 |             if is_iterator(err):\n902 |                 err = np.atleast_2d(list(err))\n903 |             else:\n904 |                 # raw error values\n905 |                 err = np.atleast_2d(err)\n906 | \n907 |             err_shape = err.shape\n908 | \n909 |             # asymmetrical error bars\n910 |             if isinstance(self.data, ABCSeries) and err_shape[0] == 2:\n911 |                 err = np.expand_dims(err, 0)\n912 |                 err_shape = err.shape\n913 |                 if err_shape[2] != len(self.data):\n914 |                     raise ValueError(\n915 |                         \"Asymmetrical error bars should be provided \"\n916 |                         f\"with the shape (2, {len(self.data)})\"\n917 |                     )\n918 |             elif isinstance(self.data, ABCDataFrame) and err.ndim == 3:\n919 |                 if (\n920 |                     (err_shape[0] != self.nseries)\n921 |                     or (err_shape[1] != 2)\n922 |                     or (err_shape[2] != len(self.data))\n923 |                 ):\n924 |                     raise ValueError(\n925 |                         \"Asymmetrical error bars should be provided \"\n926 |                         f\"with the shape ({self.nseries}, 2, {len(self.data)})\"\n927 |                     )\n928 | \n929 |             # broadcast errors to each data series\n930 |             if len(err) == 1:\n931 |                 err = np.tile(err, (self.nseries, 1))\n932 | \n933 |         elif is_number(err):\n934 |             err = np.tile([err], (self.nseries, len(self.data)))\n935 | \n936 |         else:\n937 |             msg = f\"No valid {label} detected\"\n938 |             raise ValueError(msg)\n939 | \n940 |         return err\n941 | \n942 |     def _get_errorbars(self, label=None, index=None, xerr=True, yerr=True):\n943 |         errors = {}\n944 | \n945 |         for kw, flag in zip([\"xerr\", \"yerr\"], [xerr, yerr]):\n946 |             if flag:\n947 |                 err = self.errors[kw]\n948 |                 # user provided label-matched dataframe of errors\n949 |                 if isinstance(err, (ABCDataFrame, dict)):\n950 |                     if label is not None and label in err.keys():\n951 |                         err = err[label]\n952 |                     else:\n953 |                         err = None\n954 |                 elif index is not None and err is not None:\n955 |                     err = err[index]\n956 | \n957 |                 if err is not None:\n958 |                     errors[kw] = err\n959 |         return errors\n960 | \n961 |     def _get_subplots(self):\n962 |         from matplotlib.axes import Subplot\n963 | \n964 |         return [\n965 |             ax for ax in self.axes[0].get_figure().get_axes() if isinstance(ax, Subplot)\n966 |         ]\n967 | \n968 |     def _get_axes_layout(self) -> tuple[int, int]:\n969 |         axes = self._get_subplots()\n970 |         x_set = set()\n971 |         y_set = set()\n972 |         for ax in axes:\n973 |             # check axes coordinates to estimate layout\n974 |             points = ax.get_position().get_points()\n975 |             x_set.add(points[0][0])\n976 |             y_set.add(points[0][1])\n977 |         return (len(y_set), len(x_set))\n```\n"}, {"content": "Let me also check the PlotAccessor class:\n\n<function=get_entity_contents>\n<parameter=entity_names>['pandas/plotting/_core.py:PlotAccessor']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/plotting/_core.py:PlotAccessor`...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Exact match found for entity name `pandas/plotting/_core.py:PlotAccessor`.\n```\n 620 | class PlotAccessor(PandasObject):\n 621 |     \"\"\"\n 622 |     Make plots of Series or DataFrame.\n 623 | \n 624 |     Uses the backend specified by the\n 625 |     option ``plotting.backend``. By default, matplotlib is used.\n 626 | \n 627 |     Parameters\n 628 |     ----------\n 629 |     data : Series or DataFrame\n 630 |         The object for which the method is called.\n 631 |     x : label or position, default None\n 632 |         Only used if data is a DataFrame.\n 633 |     y : label, position or list of label, positions, default None\n 634 |         Allows plotting of one column versus another. Only used if data is a\n 635 |         DataFrame.\n 636 |     kind : str\n 637 |         The kind of plot to produce:\n 638 | \n 639 |         - 'line' : line plot (default)\n 640 |         - 'bar' : vertical bar plot\n 641 |         - 'barh' : horizontal bar plot\n 642 |         - 'hist' : histogram\n 643 |         - 'box' : boxplot\n 644 |         - 'kde' : Kernel Density Estimation plot\n 645 |         - 'density' : same as 'kde'\n 646 |         - 'area' : area plot\n 647 |         - 'pie' : pie plot\n 648 |         - 'scatter' : scatter plot (DataFrame only)\n 649 |         - 'hexbin' : hexbin plot (DataFrame only)\n 650 |     ax : matplotlib axes object, default None\n 651 |         An axes of the current figure.\n 652 |     subplots : bool, default False\n 653 |         Make separate subplots for each column.\n 654 |     sharex : bool, default True if ax is None else False\n 655 |         In case ``subplots=True``, share x axis and set some x axis labels\n 656 |         to invisible; defaults to True if ax is None otherwise False if\n 657 |         an ax is passed in; Be aware, that passing in both an ax and\n 658 |         ``sharex=True`` will alter all x axis labels for all axis in a figure.\n 659 |     sharey : bool, default False\n 660 |         In case ``subplots=True``, share y axis and set some y axis labels to invisible.\n 661 |     layout : tuple, optional\n 662 |         (rows, columns) for the layout of subplots.\n 663 |     figsize : a tuple (width, height) in inches\n 664 |         Size of a figure object.\n 665 |     use_index : bool, default True\n 666 |         Use index as ticks for x axis.\n 667 |     title : str or list\n 668 |         Title to use for the plot. If a string is passed, print the string\n 669 |         at the top of the figure. If a list is passed and `subplots` is\n 670 |         True, print each item in the list above the corresponding subplot.\n 671 |     grid : bool, default None (matlab style default)\n 672 |         Axis grid lines.\n 673 |     legend : bool or {'reverse'}\n 674 |         Place legend on axis subplots.\n 675 |     style : list or dict\n 676 |         The matplotlib line style per column.\n 677 |     logx : bool or 'sym', default False\n 678 |         Use log scaling or symlog scaling on x axis.\n 679 |         .. versionchanged:: 0.25.0\n 680 | \n 681 |     logy : bool or 'sym' default False\n 682 |         Use log scaling or symlog scaling on y axis.\n 683 |         .. versionchanged:: 0.25.0\n 684 | \n 685 |     loglog : bool or 'sym', default False\n 686 |         Use log scaling or symlog scaling on both x and y axes.\n 687 |         .. versionchanged:: 0.25.0\n 688 | \n 689 |     xticks : sequence\n 690 |         Values to use for the xticks.\n 691 |     yticks : sequence\n 692 |         Values to use for the yticks.\n 693 |     xlim : 2-tuple/list\n 694 |         Set the x limits of the current axes.\n 695 |     ylim : 2-tuple/list\n 696 |         Set the y limits of the current axes.\n 697 |     xlabel : label, optional\n 698 |         Name to use for the xlabel on x-axis. Default uses index name as xlabel, or the\n 699 |         x-column name for planar plots.\n 700 | \n 701 |         .. versionadded:: 1.1.0\n 702 | \n 703 |         .. versionchanged:: 1.2.0\n 704 | \n 705 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 706 | \n 707 |     ylabel : label, optional\n 708 |         Name to use for the ylabel on y-axis. Default will show no ylabel, or the\n 709 |         y-column name for planar plots.\n 710 | \n 711 |         .. versionadded:: 1.1.0\n 712 | \n 713 |         .. versionchanged:: 1.2.0\n 714 | \n 715 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 716 | \n 717 |     rot : int, default None\n 718 |         Rotation for ticks (xticks for vertical, yticks for horizontal\n 719 |         plots).\n 720 |     fontsize : int, default None\n 721 |         Font size for xticks and yticks.\n 722 |     colormap : str or matplotlib colormap object, default None\n 723 |         Colormap to select colors from. If string, load colormap with that\n 724 |         name from matplotlib.\n 725 |     colorbar : bool, optional\n 726 |         If True, plot colorbar (only relevant for 'scatter' and 'hexbin'\n 727 |         plots).\n 728 |     position : float\n 729 |         Specify relative alignments for bar plot layout.\n 730 |         From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 731 |         (center).\n 732 |     table : bool, Series or DataFrame, default False\n 733 |         If True, draw a table using the data in the DataFrame and the data\n 734 |         will be transposed to meet matplotlib's default layout.\n 735 |         If a Series or DataFrame is passed, use passed data to draw a\n 736 |         table.\n 737 |     yerr : DataFrame, Series, array-like, dict and str\n 738 |         See :ref:`Plotting with Error Bars <visualization.errorbars>` for\n 739 |         detail.\n 740 |     xerr : DataFrame, Series, array-like, dict and str\n 741 |         Equivalent to yerr.\n 742 |     stacked : bool, default False in line and bar plots, and True in area plot\n 743 |         If True, create stacked plot.\n 744 |     sort_columns : bool, default False\n 745 |         Sort column names to determine plot ordering.\n 746 |     secondary_y : bool or sequence, default False\n 747 |         Whether to plot on the secondary y-axis if a list/tuple, which\n 748 |         columns to plot on secondary y-axis.\n 749 |     mark_right : bool, default True\n 750 |         When using a secondary_y axis, automatically mark the column\n 751 |         labels with \"(right)\" in the legend.\n 752 |     include_bool : bool, default is False\n 753 |         If True, boolean values can be plotted.\n 754 |     backend : str, default None\n 755 |         Backend to use instead of the backend specified in the option\n 756 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n 757 |         specify the ``plotting.backend`` for the whole session, set\n 758 |         ``pd.options.plotting.backend``.\n 759 | \n 760 |         .. versionadded:: 1.0.0\n 761 | \n 762 |     **kwargs\n 763 |         Options to pass to matplotlib plotting method.\n 764 | \n 765 |     Returns\n 766 |     -------\n 767 |     :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n 768 |         If the backend is not the default matplotlib one, the return value\n 769 |         will be the object returned by the backend.\n 770 | \n 771 |     Notes\n 772 |     -----\n 773 |     - See matplotlib documentation online for more on this subject\n 774 |     - If `kind` = 'bar' or 'barh', you can specify relative alignments\n 775 |       for bar plot layout by `position` keyword.\n 776 |       From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 777 |       (center)\n 778 |     \"\"\"\n 779 | \n 780 |     _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n 781 |     _series_kinds = (\"pie\",)\n 782 |     _dataframe_kinds = (\"scatter\", \"hexbin\")\n 783 |     _kind_aliases = {\"density\": \"kde\"}\n 784 |     _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n 785 | \n 786 |     def __init__(self, data) -> None:\n 787 |         self._parent = data\n 788 | \n 789 |     @staticmethod\n 790 |     def _get_call_args(backend_name, data, args, kwargs):\n 791 |         \"\"\"\n 792 |         This function makes calls to this accessor `__call__` method compatible\n 793 |         with the previous `SeriesPlotMethods.__call__` and\n 794 |         `DataFramePlotMethods.__call__`. Those had slightly different\n 795 |         signatures, since `DataFramePlotMethods` accepted `x` and `y`\n 796 |         parameters.\n 797 |         \"\"\"\n 798 |         if isinstance(data, ABCSeries):\n 799 |             arg_def = [\n 800 |                 (\"kind\", \"line\"),\n 801 |                 (\"ax\", None),\n 802 |                 (\"figsize\", None),\n 803 |                 (\"use_index\", True),\n 804 |                 (\"title\", None),\n 805 |                 (\"grid\", None),\n 806 |                 (\"legend\", False),\n 807 |                 (\"style\", None),\n 808 |                 (\"logx\", False),\n 809 |                 (\"logy\", False),\n 810 |                 (\"loglog\", False),\n 811 |                 (\"xticks\", None),\n 812 |                 (\"yticks\", None),\n 813 |                 (\"xlim\", None),\n 814 |                 (\"ylim\", None),\n 815 |                 (\"rot\", None),\n 816 |                 (\"fontsize\", None),\n 817 |                 (\"colormap\", None),\n 818 |                 (\"table\", False),\n 819 |                 (\"yerr\", None),\n 820 |                 (\"xerr\", None),\n 821 |                 (\"label\", None),\n 822 |                 (\"secondary_y\", False),\n 823 |                 (\"xlabel\", None),\n 824 |                 (\"ylabel\", None),\n 825 |             ]\n 826 |         elif isinstance(data, ABCDataFrame):\n 827 |             arg_def = [\n 828 |                 (\"x\", None),\n 829 |                 (\"y\", None),\n 830 |                 (\"kind\", \"line\"),\n 831 |                 (\"ax\", None),\n 832 |                 (\"subplots\", False),\n 833 |                 (\"sharex\", None),\n 834 |                 (\"sharey\", False),\n 835 |                 (\"layout\", None),\n 836 |                 (\"figsize\", None),\n 837 |                 (\"use_index\", True),\n 838 |                 (\"title\", None),\n 839 |                 (\"grid\", None),\n 840 |                 (\"legend\", True),\n 841 |                 (\"style\", None),\n 842 |                 (\"logx\", False),\n 843 |                 (\"logy\", False),\n 844 |                 (\"loglog\", False),\n 845 |                 (\"xticks\", None),\n 846 |                 (\"yticks\", None),\n 847 |                 (\"xlim\", None),\n 848 |                 (\"ylim\", None),\n 849 |                 (\"rot\", None),\n 850 |                 (\"fontsize\", None),\n 851 |                 (\"colormap\", None),\n 852 |                 (\"table\", False),\n 853 |                 (\"yerr\", None),\n 854 |                 (\"xerr\", None),\n 855 |                 (\"secondary_y\", False),\n 856 |                 (\"sort_columns\", False),\n 857 |                 (\"xlabel\", None),\n 858 |                 (\"ylabel\", None),\n 859 |             ]\n 860 |         else:\n 861 |             raise TypeError(\n 862 |                 f\"Called plot accessor for type {type(data).__name__}, \"\n 863 |                 \"expected Series or DataFrame\"\n 864 |             )\n 865 | \n 866 |         if args and isinstance(data, ABCSeries):\n 867 |             positional_args = str(args)[1:-1]\n 868 |             keyword_args = \", \".join(\n 869 |                 [f\"{name}={repr(value)}\" for (name, _), value in zip(arg_def, args)]\n 870 |             )\n 871 |             msg = (\n 872 |                 \"`Series.plot()` should not be called with positional \"\n 873 |                 \"arguments, only keyword arguments. The order of \"\n 874 |                 \"positional arguments will change in the future. \"\n 875 |                 f\"Use `Series.plot({keyword_args})` instead of \"\n 876 |                 f\"`Series.plot({positional_args})`.\"\n 877 |             )\n 878 |             raise TypeError(msg)\n 879 | \n 880 |         pos_args = {name: value for (name, _), value in zip(arg_def, args)}\n 881 |         if backend_name == \"pandas.plotting._matplotlib\":\n 882 |             kwargs = dict(arg_def, **pos_args, **kwargs)\n 883 |         else:\n 884 |             kwargs = dict(pos_args, **kwargs)\n 885 | \n 886 |         x = kwargs.pop(\"x\", None)\n 887 |         y = kwargs.pop(\"y\", None)\n 888 |         kind = kwargs.pop(\"kind\", \"line\")\n 889 |         return x, y, kind, kwargs\n 890 | \n 891 |     def __call__(self, *args, **kwargs):\n 892 |         plot_backend = _get_plot_backend(kwargs.pop(\"backend\", None))\n 893 | \n 894 |         x, y, kind, kwargs = self._get_call_args(\n 895 |             plot_backend.__name__, self._parent, args, kwargs\n 896 |         )\n 897 | \n 898 |         kind = self._kind_aliases.get(kind, kind)\n 899 | \n 900 |         # when using another backend, get out of the way\n 901 |         if plot_backend.__name__ != \"pandas.plotting._matplotlib\":\n 902 |             return plot_backend.plot(self._parent, x=x, y=y, kind=kind, **kwargs)\n 903 | \n 904 |         if kind not in self._all_kinds:\n 905 |             raise ValueError(f\"{kind} is not a valid plot kind\")\n 906 | \n 907 |         # The original data structured can be transformed before passed to the\n 908 |         # backend. For example, for DataFrame is common to set the index as the\n 909 |         # `x` parameter, and return a Series with the parameter `y` as values.\n 910 |         data = self._parent.copy()\n 911 | \n 912 |         if isinstance(data, ABCSeries):\n 913 |             kwargs[\"reuse_plot\"] = True\n 914 | \n 915 |         if kind in self._dataframe_kinds:\n 916 |             if isinstance(data, ABCDataFrame):\n 917 |                 return plot_backend.plot(data, x=x, y=y, kind=kind, **kwargs)\n 918 |             else:\n 919 |                 raise ValueError(f\"plot kind {kind} can only be used for data frames\")\n 920 |         elif kind in self._series_kinds:\n 921 |             if isinstance(data, ABCDataFrame):\n 922 |                 if y is None and kwargs.get(\"subplots\") is False:\n 923 |                     raise ValueError(\n 924 |                         f\"{kind} requires either y column or 'subplots=True'\"\n 925 |                     )\n 926 |                 elif y is not None:\n 927 |                     if is_integer(y) and not data.columns.holds_integer():\n 928 |                         y = data.columns[y]\n 929 |                     # converted to series actually. copy to not modify\n 930 |                     data = data[y].copy()\n 931 |                     data.index.name = y\n 932 |         elif isinstance(data, ABCDataFrame):\n 933 |             data_cols = data.columns\n 934 |             if x is not None:\n 935 |                 if is_integer(x) and not data.columns.holds_integer():\n 936 |                     x = data_cols[x]\n 937 |                 elif not isinstance(data[x], ABCSeries):\n 938 |                     raise ValueError(\"x must be a label or position\")\n 939 |                 data = data.set_index(x)\n 940 |             if y is not None:\n 941 |                 # check if we have y as int or list of ints\n 942 |                 int_ylist = is_list_like(y) and all(is_integer(c) for c in y)\n 943 |                 int_y_arg = is_integer(y) or int_ylist\n 944 |                 if int_y_arg and not data.columns.holds_integer():\n 945 |                     y = data_cols[y]\n 946 | \n 947 |                 label_kw = kwargs[\"label\"] if \"label\" in kwargs else False\n 948 |                 for kw in [\"xerr\", \"yerr\"]:\n 949 |                     if kw in kwargs and (\n 950 |                         isinstance(kwargs[kw], str) or is_integer(kwargs[kw])\n 951 |                     ):\n 952 |                         try:\n 953 |                             kwargs[kw] = data[kwargs[kw]]\n 954 |                         except (IndexError, KeyError, TypeError):\n 955 |                             pass\n 956 | \n 957 |                 # don't overwrite\n 958 |                 data = data[y].copy()\n 959 | \n 960 |                 if isinstance(data, ABCSeries):\n 961 |                     label_name = label_kw or y\n 962 |                     data.name = label_name\n 963 |                 else:\n 964 |                     match = is_list_like(label_kw) and len(label_kw) == len(y)\n 965 |                     if label_kw and not match:\n 966 |                         raise ValueError(\n 967 |                             \"label should be list-like and same length as y\"\n 968 |                         )\n 969 |                     label_name = label_kw or data.columns\n 970 |                     data.columns = label_name\n 971 | \n 972 |         return plot_backend.plot(data, kind=kind, **kwargs)\n 973 | \n 974 |     __call__.__doc__ = __doc__\n 975 | \n 976 |     @Appender(\n 977 |         \"\"\"\n 978 |         See Also\n 979 |         --------\n 980 |         matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n 981 | \n 982 |         Examples\n 983 |         --------\n 984 | \n 985 |         .. plot::\n 986 |             :context: close-figs\n 987 | \n 988 |             >>> s = pd.Series([1, 3, 2])\n 989 |             >>> s.plot.line()\n 990 |             <AxesSubplot:ylabel='Density'>\n 991 | \n 992 |         .. plot::\n 993 |             :context: close-figs\n 994 | \n 995 |             The following example shows the populations for some animals\n 996 |             over the years.\n 997 | \n 998 |             >>> df = pd.DataFrame({\n 999 |             ...    'pig': [20, 18, 489, 675, 1776],\n1000 |             ...    'horse': [4, 25, 281, 600, 1900]\n1001 |             ...    }, index=[1990, 1997, 2003, 2009, 2014])\n1002 |             >>> lines = df.plot.line()\n1003 | \n1004 |         .. plot::\n1005 |            :context: close-figs\n1006 | \n1007 |            An example with subplots, so an array of axes is returned.\n1008 | \n1009 |            >>> axes = df.plot.line(subplots=True)\n1010 |            >>> type(axes)\n1011 |            <class 'numpy.ndarray'>\n1012 | \n1013 |         .. plot::\n1014 |            :context: close-figs\n1015 | \n1016 |            Let's repeat the same example, but specifying colors for\n1017 |            each column (in this case, for each animal).\n1018 | \n1019 |            >>> axes = df.plot.line(\n1020 |            ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n1021 |            ... )\n1022 | \n1023 |         .. plot::\n1024 |             :context: close-figs\n1025 | \n1026 |             The following example shows the relationship between both\n1027 |             populations.\n1028 | \n1029 |             >>> lines = df.plot.line(x='pig', y='horse')\n1030 |         \"\"\"\n1031 |     )\n1032 |     @Substitution(kind=\"line\")\n1033 |     @Appender(_bar_or_line_doc)\n1034 |     def line(self, x=None, y=None, **kwargs):\n1035 |         \"\"\"\n1036 |         Plot Series or DataFrame as lines.\n1037 | \n1038 |         This function is useful to plot lines using DataFrame's values\n1039 |         as coordinates.\n1040 |         \"\"\"\n1041 |         return self(kind=\"line\", x=x, y=y, **kwargs)\n1042 | \n1043 |     @Appender(\n1044 |         \"\"\"\n1045 |         See Also\n1046 |         --------\n1047 |         DataFrame.plot.barh : Horizontal bar plot.\n1048 |         DataFrame.plot : Make plots of a DataFrame.\n1049 |         matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n1050 | \n1051 |         Examples\n1052 |         --------\n1053 |         Basic plot.\n1054 | \n1055 |         .. plot::\n1056 |             :context: close-figs\n1057 | \n1058 |             >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n1059 |             >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n1060 | \n1061 |         Plot a whole dataframe to a bar plot. Each column is assigned a\n1062 |         distinct color, and each row is nested in a group along the\n1063 |         horizontal axis.\n1064 | \n1065 |         .. plot::\n1066 |             :context: close-figs\n1067 | \n1068 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1069 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1070 |             >>> index = ['snail', 'pig', 'elephant',\n1071 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1072 |             >>> df = pd.DataFrame({'speed': speed,\n1073 |             ...                    'lifespan': lifespan}, index=index)\n1074 |             >>> ax = df.plot.bar(rot=0)\n1075 | \n1076 |         Plot stacked bar charts for the DataFrame\n1077 | \n1078 |         .. plot::\n1079 |             :context: close-figs\n1080 | \n1081 |             >>> ax = df.plot.bar(stacked=True)\n1082 | \n1083 |         Instead of nesting, the figure can be split by column with\n1084 |         ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n1085 |         :class:`matplotlib.axes.Axes` are returned.\n1086 | \n1087 |         .. plot::\n1088 |             :context: close-figs\n1089 | \n1090 |             >>> axes = df.plot.bar(rot=0, subplots=True)\n1091 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1092 | \n1093 |         If you don't like the default colours, you can specify how you'd\n1094 |         like each column to be colored.\n1095 | \n1096 |         .. plot::\n1097 |             :context: close-figs\n1098 | \n1099 |             >>> axes = df.plot.bar(\n1100 |             ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n1101 |             ... )\n1102 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1103 | \n1104 |         Plot a single column.\n1105 | \n1106 |         .. plot::\n1107 |             :context: close-figs\n1108 | \n1109 |             >>> ax = df.plot.bar(y='speed', rot=0)\n1110 | \n1111 |         Plot only selected categories for the DataFrame.\n1112 | \n1113 |         .. plot::\n1114 |             :context: close-figs\n1115 | \n1116 |             >>> ax = df.plot.bar(x='lifespan', rot=0)\n1117 |     \"\"\"\n1118 |     )\n1119 |     @Substitution(kind=\"bar\")\n1120 |     @Appender(_bar_or_line_doc)\n1121 |     def bar(self, x=None, y=None, **kwargs):\n1122 |         \"\"\"\n1123 |         Vertical bar plot.\n1124 | \n1125 |         A bar plot is a plot that presents categorical data with\n1126 |         rectangular bars with lengths proportional to the values that they\n1127 |         represent. A bar plot shows comparisons among discrete categories. One\n1128 |         axis of the plot shows the specific categories being compared, and the\n1129 |         other axis represents a measured value.\n1130 |         \"\"\"\n1131 |         return self(kind=\"bar\", x=x, y=y, **kwargs)\n1132 | \n1133 |     @Appender(\n1134 |         \"\"\"\n1135 |         See Also\n1136 |         --------\n1137 |         DataFrame.plot.bar: Vertical bar plot.\n1138 |         DataFrame.plot : Make plots of DataFrame using matplotlib.\n1139 |         matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n1140 | \n1141 |         Examples\n1142 |         --------\n1143 |         Basic example\n1144 | \n1145 |         .. plot::\n1146 |             :context: close-figs\n1147 | \n1148 |             >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n1149 |             >>> ax = df.plot.barh(x='lab', y='val')\n1150 | \n1151 |         Plot a whole DataFrame to a horizontal bar plot\n1152 | \n1153 |         .. plot::\n1154 |             :context: close-figs\n1155 | \n1156 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1157 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1158 |             >>> index = ['snail', 'pig', 'elephant',\n1159 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1160 |             >>> df = pd.DataFrame({'speed': speed,\n1161 |             ...                    'lifespan': lifespan}, index=index)\n1162 |             >>> ax = df.plot.barh()\n1163 | \n1164 |         Plot stacked barh charts for the DataFrame\n1165 | \n1166 |         .. plot::\n1167 |             :context: close-figs\n1168 | \n1169 |             >>> ax = df.plot.barh(stacked=True)\n1170 | \n1171 |         We can specify colors for each column\n1172 | \n1173 |         .. plot::\n1174 |             :context: close-figs\n1175 | \n1176 |             >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n1177 | \n1178 |         Plot a column of the DataFrame to a horizontal bar plot\n1179 | \n1180 |         .. plot::\n1181 |             :context: close-figs\n1182 | \n1183 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1184 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1185 |             >>> index = ['snail', 'pig', 'elephant',\n1186 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1187 |             >>> df = pd.DataFrame({'speed': speed,\n1188 |             ...                    'lifespan': lifespan}, index=index)\n1189 |             >>> ax = df.plot.barh(y='speed')\n1190 | \n1191 |         Plot DataFrame versus the desired column\n1192 | \n1193 |         .. plot::\n1194 |             :context: close-figs\n1195 | \n1196 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1197 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1198 |             >>> index = ['snail', 'pig', 'elephant',\n1199 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1200 |             >>> df = pd.DataFrame({'speed': speed,\n1201 |             ...                    'lifespan': lifespan}, index=index)\n1202 |             >>> ax = df.plot.barh(x='lifespan')\n1203 |     \"\"\"\n1204 |     )\n1205 |     @Substitution(kind=\"bar\")\n1206 |     @Appender(_bar_or_line_doc)\n1207 |     def barh(self, x=None, y=None, **kwargs):\n1208 |         \"\"\"\n1209 |         Make a horizontal bar plot.\n1210 | \n1211 |         A horizontal bar plot is a plot that presents quantitative data with\n1212 |         rectangular bars with lengths proportional to the values that they\n1213 |         represent. A bar plot shows comparisons among discrete categories. One\n1214 |         axis of the plot shows the specific categories being compared, and the\n1215 |         other axis represents a measured value.\n1216 |         \"\"\"\n1217 |         return self(kind=\"barh\", x=x, y=y, **kwargs)\n1218 | \n1219 |     def box(self, by=None, **kwargs):\n1220 |         r\"\"\"\n1221 |         Make a box plot of the DataFrame columns.\n1222 | \n1223 |         A box plot is a method for graphically depicting groups of numerical\n1224 |         data through their quartiles.\n1225 |         The box extends from the Q1 to Q3 quartile values of the data,\n1226 |         with a line at the median (Q2). The whiskers extend from the edges\n1227 |         of box to show the range of the data. The position of the whiskers\n1228 |         is set by default to 1.5*IQR (IQR = Q3 - Q1) from the edges of the\n1229 |         box. Outlier points are those past the end of the whiskers.\n1230 | \n1231 |         For further details see Wikipedia's\n1232 |         entry for `boxplot <https://en.wikipedia.org/wiki/Box_plot>`__.\n1233 | \n1234 |         A consideration when using this chart is that the box and the whiskers\n1235 |         can overlap, which is very common when plotting small sets of data.\n1236 | \n1237 |         Parameters\n1238 |         ----------\n1239 |         by : str or sequence\n1240 |             Column in the DataFrame to group by.\n1241 | \n1242 |             .. versionchanged:: 1.4.0\n1243 | \n1244 |                Previously, `by` is silently ignore and makes no groupings\n1245 | \n1246 |         **kwargs\n1247 |             Additional keywords are documented in\n1248 |             :meth:`DataFrame.plot`.\n1249 | \n1250 |         Returns\n1251 |         -------\n1252 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1253 | \n1254 |         See Also\n1255 |         --------\n1256 |         DataFrame.boxplot: Another method to draw a box plot.\n1257 |         Series.plot.box: Draw a box plot from a Series object.\n1258 |         matplotlib.pyplot.boxplot: Draw a box plot in matplotlib.\n1259 | \n1260 |         Examples\n1261 |         --------\n1262 |         Draw a box plot from a DataFrame with four columns of randomly\n1263 |         generated data.\n1264 | \n1265 |         .. plot::\n1266 |             :context: close-figs\n1267 | \n1268 |             >>> data = np.random.randn(25, 4)\n1269 |             >>> df = pd.DataFrame(data, columns=list('ABCD'))\n1270 |             >>> ax = df.plot.box()\n1271 | \n1272 |         You can also generate groupings if you specify the `by` parameter (which\n1273 |         can take a column name, or a list or tuple of column names):\n1274 | \n1275 |         .. versionchanged:: 1.4.0\n1276 | \n1277 |         .. plot::\n1278 |             :context: close-figs\n1279 | \n1280 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1281 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1282 |             >>> ax = df.plot.box(column=\"age\", by=\"gender\", figsize=(10, 8))\n1283 |         \"\"\"\n1284 |         return self(kind=\"box\", by=by, **kwargs)\n1285 | \n1286 |     def hist(self, by=None, bins=10, **kwargs):\n1287 |         \"\"\"\n1288 |         Draw one histogram of the DataFrame's columns.\n1289 | \n1290 |         A histogram is a representation of the distribution of data.\n1291 |         This function groups the values of all given Series in the DataFrame\n1292 |         into bins and draws all bins in one :class:`matplotlib.axes.Axes`.\n1293 |         This is useful when the DataFrame's Series are in a similar scale.\n1294 | \n1295 |         Parameters\n1296 |         ----------\n1297 |         by : str or sequence, optional\n1298 |             Column in the DataFrame to group by.\n1299 | \n1300 |             .. versionchanged:: 1.4.0\n1301 | \n1302 |                Previously, `by` is silently ignore and makes no groupings\n1303 | \n1304 |         bins : int, default 10\n1305 |             Number of histogram bins to be used.\n1306 |         **kwargs\n1307 |             Additional keyword arguments are documented in\n1308 |             :meth:`DataFrame.plot`.\n1309 | \n1310 |         Returns\n1311 |         -------\n1312 |         class:`matplotlib.AxesSubplot`\n1313 |             Return a histogram plot.\n1314 | \n1315 |         See Also\n1316 |         --------\n1317 |         DataFrame.hist : Draw histograms per DataFrame's Series.\n1318 |         Series.hist : Draw a histogram with Series' data.\n1319 | \n1320 |         Examples\n1321 |         --------\n1322 |         When we roll a die 6000 times, we expect to get each value around 1000\n1323 |         times. But when we roll two dice and sum the result, the distribution\n1324 |         is going to be quite different. A histogram illustrates those\n1325 |         distributions.\n1326 | \n1327 |         .. plot::\n1328 |             :context: close-figs\n1329 | \n1330 |             >>> df = pd.DataFrame(\n1331 |             ...     np.random.randint(1, 7, 6000),\n1332 |             ...     columns = ['one'])\n1333 |             >>> df['two'] = df['one'] + np.random.randint(1, 7, 6000)\n1334 |             >>> ax = df.plot.hist(bins=12, alpha=0.5)\n1335 | \n1336 |         A grouped histogram can be generated by providing the parameter `by` (which\n1337 |         can be a column name, or a list of column names):\n1338 | \n1339 |         .. plot::\n1340 |             :context: close-figs\n1341 | \n1342 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1343 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1344 |             >>> ax = df.plot.hist(column=[\"age\"], by=\"gender\", figsize=(10, 8))\n1345 |         \"\"\"\n1346 |         return self(kind=\"hist\", by=by, bins=bins, **kwargs)\n1347 | \n1348 |     def kde(self, bw_method=None, ind=None, **kwargs):\n1349 |         \"\"\"\n1350 |         Generate Kernel Density Estimate plot using Gaussian kernels.\n1351 | \n1352 |         In statistics, `kernel density estimation`_ (KDE) is a non-parametric\n1353 |         way to estimate the probability density function (PDF) of a random\n1354 |         variable. This function uses Gaussian kernels and includes automatic\n1355 |         bandwidth determination.\n1356 | \n1357 |         .. _kernel density estimation:\n1358 |             https://en.wikipedia.org/wiki/Kernel_density_estimation\n1359 | \n1360 |         Parameters\n1361 |         ----------\n1362 |         bw_method : str, scalar or callable, optional\n1363 |             The method used to calculate the estimator bandwidth. This can be\n1364 |             'scott', 'silverman', a scalar constant or a callable.\n1365 |             If None (default), 'scott' is used.\n1366 |             See :class:`scipy.stats.gaussian_kde` for more information.\n1367 |         ind : NumPy array or int, optional\n1368 |             Evaluation points for the estimated PDF. If None (default),\n1369 |             1000 equally spaced points are used. If `ind` is a NumPy array, the\n1370 |             KDE is evaluated at the points passed. If `ind` is an integer,\n1371 |             `ind` number of equally spaced points are used.\n1372 |         **kwargs\n1373 |             Additional keyword arguments are documented in\n1374 |             :meth:`DataFrame.plot`.\n1375 | \n1376 |         Returns\n1377 |         -------\n1378 |         matplotlib.axes.Axes or numpy.ndarray of them\n1379 | \n1380 |         See Also\n1381 |         --------\n1382 |         scipy.stats.gaussian_kde : Representation of a kernel-density\n1383 |             estimate using Gaussian kernels. This is the function used\n1384 |             internally to estimate the PDF.\n1385 | \n1386 |         Examples\n1387 |         --------\n1388 |         Given a Series of points randomly sampled from an unknown\n1389 |         distribution, estimate its PDF using KDE with automatic\n1390 |         bandwidth determination and plot the results, evaluating them at\n1391 |         1000 equally spaced points (default):\n1392 | \n1393 |         .. plot::\n1394 |             :context: close-figs\n1395 | \n1396 |             >>> s = pd.Series([1, 2, 2.5, 3, 3.5, 4, 5])\n1397 |             >>> ax = s.plot.kde()\n1398 | \n1399 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1400 |         lead to over-fitting, while using a large bandwidth value may result\n1401 |         in under-fitting:\n1402 | \n1403 |         .. plot::\n1404 |             :context: close-figs\n1405 | \n1406 |             >>> ax = s.plot.kde(bw_method=0.3)\n1407 | \n1408 |         .. plot::\n1409 |             :context: close-figs\n1410 | \n1411 |             >>> ax = s.plot.kde(bw_method=3)\n1412 | \n1413 |         Finally, the `ind` parameter determines the evaluation points for the\n1414 |         plot of the estimated PDF:\n1415 | \n1416 |         .. plot::\n1417 |             :context: close-figs\n1418 | \n1419 |             >>> ax = s.plot.kde(ind=[1, 2, 3, 4, 5])\n1420 | \n1421 |         For DataFrame, it works in the same way:\n1422 | \n1423 |         .. plot::\n1424 |             :context: close-figs\n1425 | \n1426 |             >>> df = pd.DataFrame({\n1427 |             ...     'x': [1, 2, 2.5, 3, 3.5, 4, 5],\n1428 |             ...     'y': [4, 4, 4.5, 5, 5.5, 6, 6],\n1429 |             ... })\n1430 |             >>> ax = df.plot.kde()\n1431 | \n1432 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1433 |         lead to over-fitting, while using a large bandwidth value may result\n1434 |         in under-fitting:\n1435 | \n1436 |         .. plot::\n1437 |             :context: close-figs\n1438 | \n1439 |             >>> ax = df.plot.kde(bw_method=0.3)\n1440 | \n1441 |         .. plot::\n1442 |             :context: close-figs\n1443 | \n1444 |             >>> ax = df.plot.kde(bw_method=3)\n1445 | \n1446 |         Finally, the `ind` parameter determines the evaluation points for the\n1447 |         plot of the estimated PDF:\n1448 | \n1449 |         .. plot::\n1450 |             :context: close-figs\n1451 | \n1452 |             >>> ax = df.plot.kde(ind=[1, 2, 3, 4, 5, 6])\n1453 |         \"\"\"\n1454 |         return self(kind=\"kde\", bw_method=bw_method, ind=ind, **kwargs)\n1455 | \n1456 |     density = kde\n1457 | \n1458 |     def area(self, x=None, y=None, **kwargs):\n1459 |         \"\"\"\n1460 |         Draw a stacked area plot.\n1461 | \n1462 |         An area plot displays quantitative data visually.\n1463 |         This function wraps the matplotlib area function.\n1464 | \n1465 |         Parameters\n1466 |         ----------\n1467 |         x : label or position, optional\n1468 |             Coordinates for the X axis. By default uses the index.\n1469 |         y : label or position, optional\n1470 |             Column to plot. By default uses all columns.\n1471 |         stacked : bool, default True\n1472 |             Area plots are stacked by default. Set to False to create a\n1473 |             unstacked plot.\n1474 |         **kwargs\n1475 |             Additional keyword arguments are documented in\n1476 |             :meth:`DataFrame.plot`.\n1477 | \n1478 |         Returns\n1479 |         -------\n1480 |         matplotlib.axes.Axes or numpy.ndarray\n1481 |             Area plot, or array of area plots if subplots is True.\n1482 | \n1483 |         See Also\n1484 |         --------\n1485 |         DataFrame.plot : Make plots of DataFrame using matplotlib / pylab.\n1486 | \n1487 |         Examples\n1488 |         --------\n1489 |         Draw an area plot based on basic business metrics:\n1490 | \n1491 |         .. plot::\n1492 |             :context: close-figs\n1493 | \n1494 |             >>> df = pd.DataFrame({\n1495 |             ...     'sales': [3, 2, 3, 9, 10, 6],\n1496 |             ...     'signups': [5, 5, 6, 12, 14, 13],\n1497 |             ...     'visits': [20, 42, 28, 62, 81, 50],\n1498 |             ... }, index=pd.date_range(start='2018/01/01', end='2018/07/01',\n1499 |             ...                        freq='M'))\n1500 |             >>> ax = df.plot.area()\n1501 | \n1502 |         Area plots are stacked by default. To produce an unstacked plot,\n1503 |         pass ``stacked=False``:\n1504 | \n1505 |         .. plot::\n1506 |             :context: close-figs\n1507 | \n1508 |             >>> ax = df.plot.area(stacked=False)\n1509 | \n1510 |         Draw an area plot for a single column:\n1511 | \n1512 |         .. plot::\n1513 |             :context: close-figs\n1514 | \n1515 |             >>> ax = df.plot.area(y='sales')\n1516 | \n1517 |         Draw with a different `x`:\n1518 | \n1519 |         .. plot::\n1520 |             :context: close-figs\n1521 | \n1522 |             >>> df = pd.DataFrame({\n1523 |             ...     'sales': [3, 2, 3],\n1524 |             ...     'visits': [20, 42, 28],\n1525 |             ...     'day': [1, 2, 3],\n1526 |             ... })\n1527 |             >>> ax = df.plot.area(x='day')\n1528 |         \"\"\"\n1529 |         return self(kind=\"area\", x=x, y=y, **kwargs)\n1530 | \n1531 |     def pie(self, **kwargs):\n1532 |         \"\"\"\n1533 |         Generate a pie plot.\n1534 | \n1535 |         A pie plot is a proportional representation of the numerical data in a\n1536 |         column. This function wraps :meth:`matplotlib.pyplot.pie` for the\n1537 |         specified column. If no column reference is passed and\n1538 |         ``subplots=True`` a pie plot is drawn for each numerical column\n1539 |         independently.\n1540 | \n1541 |         Parameters\n1542 |         ----------\n1543 |         y : int or label, optional\n1544 |             Label or position of the column to plot.\n1545 |             If not provided, ``subplots=True`` argument must be passed.\n1546 |         **kwargs\n1547 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1548 | \n1549 |         Returns\n1550 |         -------\n1551 |         matplotlib.axes.Axes or np.ndarray of them\n1552 |             A NumPy array is returned when `subplots` is True.\n1553 | \n1554 |         See Also\n1555 |         --------\n1556 |         Series.plot.pie : Generate a pie plot for a Series.\n1557 |         DataFrame.plot : Make plots of a DataFrame.\n1558 | \n1559 |         Examples\n1560 |         --------\n1561 |         In the example below we have a DataFrame with the information about\n1562 |         planet's mass and radius. We pass the 'mass' column to the\n1563 |         pie function to get a pie plot.\n1564 | \n1565 |         .. plot::\n1566 |             :context: close-figs\n1567 | \n1568 |             >>> df = pd.DataFrame({'mass': [0.330, 4.87 , 5.97],\n1569 |             ...                    'radius': [2439.7, 6051.8, 6378.1]},\n1570 |             ...                   index=['Mercury', 'Venus', 'Earth'])\n1571 |             >>> plot = df.plot.pie(y='mass', figsize=(5, 5))\n1572 | \n1573 |         .. plot::\n1574 |             :context: close-figs\n1575 | \n1576 |             >>> plot = df.plot.pie(subplots=True, figsize=(11, 6))\n1577 |         \"\"\"\n1578 |         if (\n1579 |             isinstance(self._parent, ABCDataFrame)\n1580 |             and kwargs.get(\"y\", None) is None\n1581 |             and not kwargs.get(\"subplots\", False)\n1582 |         ):\n1583 |             raise ValueError(\"pie requires either y column or 'subplots=True'\")\n1584 |         return self(kind=\"pie\", **kwargs)\n1585 | \n1586 |     def scatter(self, x, y, s=None, c=None, **kwargs):\n1587 |         \"\"\"\n1588 |         Create a scatter plot with varying marker point size and color.\n1589 | \n1590 |         The coordinates of each point are defined by two dataframe columns and\n1591 |         filled circles are used to represent each point. This kind of plot is\n1592 |         useful to see complex correlations between two variables. Points could\n1593 |         be for instance natural 2D coordinates like longitude and latitude in\n1594 |         a map or, in general, any pair of metrics that can be plotted against\n1595 |         each other.\n1596 | \n1597 |         Parameters\n1598 |         ----------\n1599 |         x : int or str\n1600 |             The column name or column position to be used as horizontal\n1601 |             coordinates for each point.\n1602 |         y : int or str\n1603 |             The column name or column position to be used as vertical\n1604 |             coordinates for each point.\n1605 |         s : str, scalar or array-like, optional\n1606 |             The size of each point. Possible values are:\n1607 | \n1608 |             - A string with the name of the column to be used for marker's size.\n1609 | \n1610 |             - A single scalar so all points have the same size.\n1611 | \n1612 |             - A sequence of scalars, which will be used for each point's size\n1613 |               recursively. For instance, when passing [2,14] all points size\n1614 |               will be either 2 or 14, alternatively.\n1615 | \n1616 |               .. versionchanged:: 1.1.0\n1617 | \n1618 |         size : str, scalar or array-like, optional\n1619 |             Alias for s.\n1620 | \n1621 |             .. versionadded:: 1.5.0\n1622 | \n1623 |         c : str, int or array-like, optional\n1624 |             The color of each point. Possible values are:\n1625 | \n1626 |             - A single color string referred to by name, RGB or RGBA code,\n1627 |               for instance 'red' or '#a98d19'.\n1628 | \n1629 |             - A sequence of color strings referred to by name, RGB or RGBA\n1630 |               code, which will be used for each point's color recursively. For\n1631 |               instance ['green','yellow'] all points will be filled in green or\n1632 |               yellow, alternatively.\n1633 | \n1634 |             - A column name or position whose values will be used to color the\n1635 |               marker points according to a colormap.\n1636 |         color : str, int or array-like, optional\n1637 |             Alias for c.\n1638 | \n1639 |             .. versionadded:: 1.5.0\n1640 | \n1641 |         **kwargs\n1642 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1643 | \n1644 |         Returns\n1645 |         -------\n1646 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1647 | \n1648 |         See Also\n1649 |         --------\n1650 |         matplotlib.pyplot.scatter : Scatter plot using multiple input data\n1651 |             formats.\n1652 | \n1653 |         Examples\n1654 |         --------\n1655 |         Let's see how to draw a scatter plot using coordinates from the values\n1656 |         in a DataFrame's columns.\n1657 | \n1658 |         .. plot::\n1659 |             :context: close-figs\n1660 | \n1661 |             >>> df = pd.DataFrame([[5.1, 3.5, 0], [4.9, 3.0, 0], [7.0, 3.2, 1],\n1662 |             ...                    [6.4, 3.2, 1], [5.9, 3.0, 2]],\n1663 |             ...                   columns=['length', 'width', 'species'])\n1664 |             >>> ax1 = df.plot.scatter(x='length',\n1665 |             ...                       y='width',\n1666 |             ...                       c='DarkBlue')\n1667 | \n1668 |         And now with the color determined by a column as well.\n1669 | \n1670 |         .. plot::\n1671 |             :context: close-figs\n1672 | \n1673 |             >>> ax2 = df.plot.scatter(x='length',\n1674 |             ...                       y='width',\n1675 |             ...                       c='species',\n1676 |             ...                       colormap='viridis')\n1677 |         \"\"\"\n1678 |         size = kwargs.pop(\"size\", None)\n1679 |         if s is not None and size is not None:\n1680 |             raise TypeError(\"Specify exactly one of `s` and `size`\")\n1681 |         elif s is not None or size is not None:\n1682 |             kwargs[\"s\"] = s if s is not None else size\n1683 | \n1684 |         color = kwargs.pop(\"color\", None)\n1685 |         if c is not None and color is not None:\n1686 |             raise TypeError(\"Specify exactly one of `c` and `color`\")\n1687 |         elif c is not None or color is not None:\n1688 |             kwargs[\"c\"] = c if c is not None else color\n1689 | \n1690 |         return self(kind=\"scatter\", x=x, y=y, **kwargs)\n1691 | \n1692 |     def hexbin(self, x, y, C=None, reduce_C_function=None, gridsize=None, **kwargs):\n1693 |         \"\"\"\n1694 |         Generate a hexagonal binning plot.\n1695 | \n1696 |         Generate a hexagonal binning plot of `x` versus `y`. If `C` is `None`\n1697 |         (the default), this is a histogram of the number of occurrences\n1698 |         of the observations at ``(x[i], y[i])``.\n1699 | \n1700 |         If `C` is specified, specifies values at given coordinates\n1701 |         ``(x[i], y[i])``. These values are accumulated for each hexagonal\n1702 |         bin and then reduced according to `reduce_C_function`,\n1703 |         having as default the NumPy's mean function (:meth:`numpy.mean`).\n1704 |         (If `C` is specified, it must also be a 1-D sequence\n1705 |         of the same length as `x` and `y`, or a column label.)\n1706 | \n1707 |         Parameters\n1708 |         ----------\n1709 |         x : int or str\n1710 |             The column label or position for x points.\n1711 |         y : int or str\n1712 |             The column label or position for y points.\n1713 |         C : int or str, optional\n1714 |             The column label or position for the value of `(x, y)` point.\n1715 |         reduce_C_function : callable, default `np.mean`\n1716 |             Function of one argument that reduces all the values in a bin to\n1717 |             a single number (e.g. `np.mean`, `np.max`, `np.sum`, `np.std`).\n1718 |         gridsize : int or tuple of (int, int), default 100\n1719 |             The number of hexagons in the x-direction.\n1720 |             The corresponding number of hexagons in the y-direction is\n1721 |             chosen in a way that the hexagons are approximately regular.\n1722 |             Alternatively, gridsize can be a tuple with two elements\n1723 |             specifying the number of hexagons in the x-direction and the\n1724 |             y-direction.\n1725 |         **kwargs\n1726 |             Additional keyword arguments are documented in\n1727 |             :meth:`DataFrame.plot`.\n1728 | \n1729 |         Returns\n1730 |         -------\n1731 |         matplotlib.AxesSubplot\n1732 |             The matplotlib ``Axes`` on which the hexbin is plotted.\n1733 | \n1734 |         See Also\n1735 |         --------\n1736 |         DataFrame.plot : Make plots of a DataFrame.\n1737 |         matplotlib.pyplot.hexbin : Hexagonal binning plot using matplotlib,\n1738 |             the matplotlib function that is used under the hood.\n1739 | \n1740 |         Examples\n1741 |         --------\n1742 |         The following examples are generated with random data from\n1743 |         a normal distribution.\n1744 | \n1745 |         .. plot::\n1746 |             :context: close-figs\n1747 | \n1748 |             >>> n = 10000\n1749 |             >>> df = pd.DataFrame({'x': np.random.randn(n),\n1750 |             ...                    'y': np.random.randn(n)})\n1751 |             >>> ax = df.plot.hexbin(x='x', y='y', gridsize=20)\n1752 | \n1753 |         The next example uses `C` and `np.sum` as `reduce_C_function`.\n1754 |         Note that `'observations'` values ranges from 1 to 5 but the result\n1755 |         plot shows values up to more than 25. This is because of the\n1756 |         `reduce_C_function`.\n1757 | \n1758 |         .. plot::\n1759 |             :context: close-figs\n1760 | \n1761 |             >>> n = 500\n1762 |             >>> df = pd.DataFrame({\n1763 |             ...     'coord_x': np.random.uniform(-3, 3, size=n),\n1764 |             ...     'coord_y': np.random.uniform(30, 50, size=n),\n1765 |             ...     'observations': np.random.randint(1,5, size=n)\n1766 |             ...     })\n1767 |             >>> ax = df.plot.hexbin(x='coord_x',\n1768 |             ...                     y='coord_y',\n1769 |             ...                     C='observations',\n1770 |             ...                     reduce_C_function=np.sum,\n1771 |             ...                     gridsize=10,\n1772 |             ...                     cmap=\"viridis\")\n1773 |         \"\"\"\n1774 |         if reduce_C_function is not None:\n1775 |             kwargs[\"reduce_C_function\"] = reduce_C_function\n1776 |         if gridsize is not None:\n1777 |             kwargs[\"gridsize\"] = gridsize\n1778 | \n1779 |         return self(kind=\"hexbin\", x=x, y=y, C=C, **kwargs)\n```\n"}, {"content": "Based on my analysis, I'll identify the key locations that need to be modified to implement the requested feature. Here's the output in the requested format:\n\n```\npandas/plotting/_matplotlib/core.py\nline: 103\nline: 140\nline: 374-382\nclass: MPLPlot\nfunction: _setup_subplots\n\npandas/plotting/_matplotlib/core.py\nline: 544\nline: 545-560\nclass: MPLPlot\nfunction: _adorn_subplots\n\npandas/plotting/_core.py\nline: 652\nline: 653\nclass: PlotAccessor\nfunction: __init__\n\npandas/plotting/_matplotlib/tools.py\nline: 132\nline: 217-312\nfunction: create_subplots\n\npandas/plotting/_matplotlib/core.py\nline: 724-731\nclass: MPLPlot\nfunction: _get_xticks\n```\n\nThese locations are critical because:\n\n1. `pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots` - This is where the subplot creation logic lives. Currently, it creates one subplot per column when `subplots=True`. This needs to be modified to handle grouped columns.\n\n2. `pandas/plotting/_matplotlib/core.py:MPLPlot._adorn_subplots` - Handles the decoration of subplots after creation. Will need to be modified to handle grouped plots properly.\n\n3. `pandas/plotting/_core.py:PlotAccessor.__init__` - This is where the `subplots` parameter is processed. Need to add validation for the new grouped format.\n\n4. `pandas/plotting/_matplotlib/tools.py:create_subplots` - The function that actually creates the subplots. Will need modifications to support grouping.\n\n5. `pandas/plotting/_matplotlib/core.py:MPLPlot._get_xticks` - Handles the x-axis ticks and labels. May need updates to handle grouped plots correctly.\n\nThe main changes would need to happen in `MPLPlot._setup_subplots` and supporting functions, as this is where the core subplot creation and arrangement happens. The implementation would need to interpret the new group format and create appropriate subplots while sharing axes where appropriate.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 248011, "completion_tokens": 762}, "time": 201.80390191078186}]}}
{"instance_id": "scikit-learn__scikit-learn-17443", "found_files": [["sklearn/calibration.py", "sklearn/metrics/_plot/base.py", "sklearn/utils/__init__.py", "sklearn/preprocessing/_label.py", "sklearn/utils/validation.py"]], "found_modules": [["sklearn/base.py:MultiOutputMixin", "sklearn/neighbors/_base.py:_tree_query_radius_parallel_helper", "sklearn/mixture/_bayesian_mixture.py:BayesianGaussianMixture", "sklearn/feature_extraction/text.py:HashingVectorizer", "sklearn/ensemble/_gb_losses.py:MultinomialDeviance", "sklearn/naive_bayes.py:MultinomialNB", "sklearn/externals/_arff.py:ArffDecoder._decode", "sklearn/multiclass.py:OneVsOneClassifier", "sklearn/ensemble/_gb.py:BaseGradientBoosting", "sklearn/ensemble/_forest.py:ForestClassifier", "sklearn/ensemble/_gb_losses.py:ExponentialLoss", "sklearn/multioutput.py:RegressorChain", "doc/tutorial/machine_learning_map/pyparsing.py:ParseResults", "sklearn/calibration.py:calibration_curve", "examples/cluster/plot_agglomerative_clustering_metrics.py:sqr", "benchmarks/bench_sparsify.py:sparsity_ratio", "examples/cluster/plot_inductive_clustering.py:InductiveClusterer", "examples/cluster/plot_adjusted_for_chance_measures.py:ami_score", "examples/linear_model/plot_logistic_multinomial.py:plot_hyperplane", "sklearn/externals/_packaging/_structures.py:NegativeInfinityType", "examples/neural_networks/plot_rbm_logistic_classification.py:nudge_dataset", "examples/linear_model/plot_sgd_iris.py:plot_hyperplane", "sklearn/linear_model/_glm/link.py:IdentityLink", "asv_benchmarks/benchmarks/linear_model.py:RidgeBenchmark", "sklearn/utils/_pprint.py:KeyValTuple", "examples/text/plot_document_classification_20newsgroups.py:is_interactive", "sklearn/linear_model/_glm/link.py:LogLink", "doc/sphinxext/sphinx_issues.py:IssueRole", "examples/gaussian_process/plot_gpr_on_structured_data.py:SequenceKernel", "examples/applications/plot_out_of_core_classification.py:ReutersParser", "examples/text/plot_document_clustering.py:is_interactive", "exampl