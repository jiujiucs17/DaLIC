n454 |     mask=None,\n455 |     **kwargs,\n456 | ) -> None:\n457 |     \"\"\"\n458 |     Logic for the 1-d interpolation.  The input\n459 |     indices and yvalues will each be 1-d arrays of the same length.\n460 | \n461 |     Bounds_error is currently hardcoded to False since non-scipy ones don't\n462 |     take it as an argument.\n463 | \n464 |     Notes\n465 |     -----\n466 |     Fills 'yvalues' in-place.\n467 |     \"\"\"\n468 |     if mask is not None:\n469 |         invalid = mask\n470 |     else:\n471 |         invalid = isna(yvalues)\n472 |     valid = ~invalid\n473 | \n474 |     if not valid.any():\n475 |         return\n476 | \n477 |     if valid.all():\n478 |         return\n479 | \n480 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n481 |     all_nans = np.flatnonzero(invalid)\n482 | \n483 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n484 |     if first_valid_index is None:  # no nan found in start\n485 |         first_valid_index = 0\n486 |     start_nans = np.arange(first_valid_index)\n487 | \n488 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n489 |     if last_valid_index is None:  # no nan found in end\n490 |         last_valid_index = len(yvalues)\n491 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n492 | \n493 |     # preserve_nans contains indices of invalid values,\n494 |     # but in this case, it is the final set of indices that need to be\n495 |     # preserved as NaN after the interpolation.\n496 | \n497 |     # For example if limit_direction='forward' then preserve_nans will\n498 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n499 |     # are more than 'limit' away from the prior non-NaN.\n500 | \n501 |     # set preserve_nans based on direction using _interp_limit\n502 |     if limit_direction == \"forward\":\n503 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n504 |     elif limit_direction == \"backward\":\n505 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n506 |     else:\n507 |         # both directions... just use _interp_limit\n508 |         preserve_nans = np.unique(_interp_limit(invalid, limit, limit))\n509 | \n510 |     # if limit_area is set, add either mid or outside indices\n511 |     # to preserve_nans GH #16284\n512 |     if limit_area == \"inside\":\n513 |         # preserve NaNs on the outside\n514 |         preserve_nans = np.union1d(preserve_nans, start_nans)\n515 |         preserve_nans = np.union1d(preserve_nans, end_nans)\n516 |     elif limit_area == \"outside\":\n517 |         # preserve NaNs on the inside\n518 |         mid_nans = np.setdiff1d(all_nans, start_nans, assume_unique=True)\n519 |         mid_nans = np.setdiff1d(mid_nans, end_nans, assume_unique=True)\n520 |         preserve_nans = np.union1d(preserve_nans, mid_nans)\n521 | \n522 |     is_datetimelike = yvalues.dtype.kind in \"mM\"\n523 | \n524 |     if is_datetimelike:\n525 |         yvalues = yvalues.view(\"i8\")\n526 | \n527 |     if method in NP_METHODS:\n528 |         # np.interp requires sorted X values, #21037\n529 | \n530 |         indexer = np.argsort(indices[valid])\n531 |         yvalues[invalid] = np.interp(\n532 |             indices[invalid], indices[valid][indexer], yvalues[valid][indexer]\n533 |         )\n534 |     else:\n535 |         yvalues[invalid] = _interpolate_scipy_wrapper(\n536 |             indices[valid],\n537 |             yvalues[valid],\n538 |             indices[invalid],\n539 |             method=method,\n540 |             fill_value=fill_value,\n541 |             bounds_error=bounds_error,\n542 |             order=order,\n543 |             **kwargs,\n544 |         )\n545 | \n546 |     if mask is not None:\n547 |         mask[:] = False\n548 |         mask[preserve_nans] = True\n549 |     elif is_datetimelike:\n550 |         yvalues[preserve_nans] = NaT.value\n551 |     else:\n552 |         yvalues[preserve_nans] = np.nan\n553 |     return\n```\n\nFound class `pandas/core/computation/pytables.py:PyTablesExpr`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PyTablesExpr(expr.Expr):\n\n    _visitor: PyTablesExprVisitor | None\n    env: PyTablesScope\n    expr: str\n\n    def __init__(\n        self,\n        where,\n        queryables: dict[str, Any] | None = None,\n        encoding=None,\n        scope_level: int = 0,\n    ) -> None:\n...\n    def __repr__(self) -> str:\n...\n    def evaluate(self):\n\n```\nHint: Search `pandas/core/computation/pytables.py:PyTablesExpr` to get the full content if needed.\n\nFound function `web/pandas_web.py:main`.\nSource: Retrieved code content using keyword search (bm25).\n```\n434 | def main(\n435 |     source_path: str,\n436 |     target_path: str,\n437 | ) -> int:\n438 |     \"\"\"\n439 |     Copy every file in the source directory to the target directory.\n440 | \n441 |     For ``.md`` and ``.html`` files, render them with the context\n442 |     before copying them. ``.md`` files are transformed to HTML.\n443 |     \"\"\"\n444 |     config_fname = os.path.join(source_path, \"config.yml\")\n445 | \n446 |     shutil.rmtree(target_path, ignore_errors=True)\n447 |     os.makedirs(target_path, exist_ok=True)\n448 | \n449 |     sys.stderr.write(\"Generating context...\\n\")\n450 |     context = get_context(config_fname, target_path=target_path)\n451 |     sys.stderr.write(\"Context generated\\n\")\n452 | \n453 |     templates_path = os.path.join(source_path, context[\"main\"][\"templates_path\"])\n454 |     jinja_env = jinja2.Environment(loader=jinja2.FileSystemLoader(templates_path))\n455 | \n456 |     for fname in get_source_files(source_path):\n457 |         if os.path.normpath(fname) in context[\"main\"][\"ignore\"]:\n458 |             continue\n459 | \n460 |         sys.stderr.write(f\"Processing {fname}\\n\")\n461 |         dirname = os.path.dirname(fname)\n462 |         os.makedirs(os.path.join(target_path, dirname), exist_ok=True)\n463 | \n464 |         extension = os.path.splitext(fname)[-1]\n465 |         if extension in (\".html\", \".md\"):\n466 |             with open(os.path.join(source_path, fname), encoding=\"utf-8\") as f:\n467 |                 content = f.read()\n468 |             if extension == \".md\":\n469 |                 body = markdown.markdown(\n470 |                     content, extensions=context[\"main\"][\"markdown_extensions\"]\n471 |                 )\n472 |                 # Apply Bootstrap's table formatting manually\n473 |                 # Python-Markdown doesn't let us config table attributes by hand\n474 |                 body = body.replace(\"<table>\", '<table class=\"table table-bordered\">')\n475 |                 content = extend_base_template(body, context[\"main\"][\"base_template\"])\n476 |             context[\"base_url\"] = \"\".join([\"../\"] * os.path.normpath(fname).count(\"/\"))\n477 |             content = jinja_env.from_string(content).render(**context)\n478 |             fname_html = os.path.splitext(fname)[0] + \".html\"\n479 |             with open(\n480 |                 os.path.join(target_path, fname_html), \"w\", encoding=\"utf-8\"\n481 |             ) as f:\n482 |                 f.write(content)\n483 |         else:\n484 |             shutil.copy(\n485 |                 os.path.join(source_path, fname), os.path.join(target_path, dirname)\n486 |             )\n```\n\nFound function `pandas/core/computation/pytables.py:_validate_where`.\nSource: Retrieved code content using keyword search (bm25).\n```\n504 | def _validate_where(w):\n505 |     \"\"\"\n506 |     Validate that the where statement is of the right type.\n507 | \n508 |     The type may either be String, Expr, or list-like of Exprs.\n509 | \n510 |     Parameters\n511 |     ----------\n512 |     w : String term expression, Expr, or list-like of Exprs.\n513 | \n51