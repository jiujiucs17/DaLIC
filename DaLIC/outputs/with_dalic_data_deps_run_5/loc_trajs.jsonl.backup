      if pickle_kwargs is None:\n742 |             pickle_kwargs = {}\n743 |         try:\n744 |             array = pickle.load(fp, **pickle_kwargs)\n745 |         except UnicodeError as err:\n746 |             # Friendlier error message\n747 |             raise UnicodeError(\"Unpickling a python object failed: %r\\n\"\n748 |                                \"You may need to pass the encoding= option \"\n749 |                                \"to numpy.load\" % (err,)) from err\n750 |     else:\n751 |         if isfileobj(fp):\n752 |             # We can use the fast fromfile() function.\n753 |             array = numpy.fromfile(fp, dtype=dtype, count=count)\n754 |         else:\n755 |             # This is not a real file. We have to read it the\n756 |             # memory-intensive way.\n757 |             # crc32 module fails on reads greater than 2 ** 32 bytes,\n758 |             # breaking large reads from gzip streams. Chunk reads to\n759 |             # BUFFER_SIZE bytes to avoid issue and reduce memory overhead\n760 |             # of the read. In non-chunked case count < max_read_count, so\n761 |             # only one read is performed.\n762 | \n763 |             # Use np.ndarray instead of np.empty since the latter does\n764 |             # not correctly instantiate zero-width string dtypes; see\n765 |             # https://github.com/numpy/numpy/pull/6430\n766 |             array = numpy.ndarray(count, dtype=dtype)\n767 | \n768 |             if dtype.itemsize > 0:\n769 |                 # If dtype.itemsize == 0 then there's nothing more to read\n770 |                 max_read_count = BUFFER_SIZE // min(BUFFER_SIZE, dtype.itemsize)\n771 | \n772 |                 for i in range(0, count, max_read_count):\n773 |                     read_count = min(max_read_count, count - i)\n774 |                     read_size = int(read_count * dtype.itemsize)\n775 |                     data = _read_bytes(fp, read_size, \"array data\")\n776 |                     array[i:i+r