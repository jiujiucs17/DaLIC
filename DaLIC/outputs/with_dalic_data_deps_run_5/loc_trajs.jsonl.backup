g ranges\n732 |         int_low = max(first.start, second.start)\n733 |         int_high = min(first.stop, second.stop)\n734 |         if int_high <= int_low:\n735 |             return self._simple_new(_empty_range)\n736 | \n737 |         # Method hint: linear Diophantine equation\n738 |         # solve intersection problem\n739 |         # performance hint: for identical step sizes, could use\n740 |         # cheaper alternative\n741 |         gcd, s, _ = self._extended_gcd(first.step, second.step)\n742 | \n743 |         # check whether element sets intersect\n744 |         if (first.start - second.start) % gcd:\n745 |             return self._simple_new(_empty_range)\n746 | \n747 |         # calculate parameters for the RangeIndex describing the\n748 |         # intersection disregarding the lower bounds\n749 |         tmp_start = first.start + (second.start - first.start) * first.step // gcd * s\n750 |         new_step = first.step * second.step // gcd\n751 | \n752 |         # adjust index to limiting interval\n753 |         new_start = min_fitting_element(tmp_start, new_step, int_low)\n754 |         new_range = range(new_start, int_high, new_step)\n755 | \n756 |         if (self.step < 0 and other.step < 0) is not (new_range.step < 0):\n757 |             new_range = new_range[::-1]\n758 | \n759 |         return self._simple_new(new_range)\n```\n\n\n\n##Searching for term \"type hint\", \"typing type hint :param\"...\n### Search Result:\nFound function `pandas/core/common.py:pipe`.\nSource: Retrieved code content using keyword search (bm25).\n```\n491 | def pipe(\n492 |     obj: _T,\n493 |     func: Callable[Concatenate[_T, P], T] | tuple[Callable[..., T], str],\n494 |     *args: Any,\n495 |     **kwargs: Any,\n496 | ) -> T:\n497 |     \"\"\"\n498 |     Apply a function ``func`` to object ``obj`` either by passing obj as the\n499 |     first argument to the function or, in the case that the func is a tuple,\n500 |     interpret the first element of the tuple as a