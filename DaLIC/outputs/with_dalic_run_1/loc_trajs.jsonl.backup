__floordiv__(self, other) -> Expr:\n 284 |         from sympy.functions.elementary.integers import floor\n 285 |         return floor(self / other)\n 286 | \n 287 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 288 |     @call_highest_priority('__floordiv__')\n 289 |     def __rfloordiv__(self, other) -> Expr:\n 290 |         from sympy.functions.elementary.integers import floor\n 291 |         return floor(other / self)\n 292 | \n 293 | \n 294 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 295 |     @call_highest_priority('__rdivmod__')\n 296 |     def __divmod__(self, other) -> tuple[Expr, Expr]:\n 297 |         from sympy.functions.elementary.integers import floor\n 298 |         return floor(self / other), Mod(self, other)\n 299 | \n 300 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 301 |     @call_highest_priority('__divmod__')\n 302 |     def __rdivmod__(self, other) -> tuple[Expr, Expr]:\n 303 |         from sympy.functions.elementary.integers import floor\n 304 |         return floor(other / self), Mod(other, self)\n 305 | \n 306 |     def __int__(self) -> int:\n 307 |         if not self.is_number:\n 308 |             raise TypeError(\"Cannot convert symbols to int\")\n 309 |         r = self.round(2)\n 310 |         if not r.is_Number:\n 311 |             raise TypeError(\"Cannot convert complex to int\")\n 312 |         if r in (S.NaN, S.Infinity, S.NegativeInfinity):\n 313 |             raise TypeError(\"Cannot convert %s to int\" % r)\n 314 |         i = int(r)\n 315 |         if not i:\n 316 |             return i\n 317 |         if int_valued(r):\n 318 |             # non-integer self should pass one of these tests\n 319 |             if (self > i) is S.true:\n 320 |                 return i\n 321 |             if (self < i) is S.true:\n 322 |                 return i - 1\n 323 |             ok = self.equals(i)\n 324 |             if ok is None:\n 325 |                 raise TypeError('cannot compute int value accurately')\n 326 |             if ok:\n 327 |                 return i\n 328 |             # off by one\n 329 |             return i - (1 if i > 0 else -1)\n 330 |         return i\n 331 | \n 332 |     def __float__(self) -> float:\n 333 |         # Don't bother testing if it's a number; if it's not this is going\n 334 |         # to fail, and if it is we still need to check that it evalf'ed to\n 335 |         # a number.\n 336 |         result = self.evalf()\n 337 |         if result.is_Number:\n 338 |             return float(result)\n 339 |         if result.is_number and result.as_real_imag()[1]:\n 340 |             raise TypeError(\"Cannot convert complex to float\")\n 341 |         raise TypeError(\"Cannot convert expression to float\")\n 342 | \n 343 |     def __complex__(self) -> complex:\n 344 |         result = self.evalf()\n 345 |         re, im = result.as_real_imag()\n 346 |         return complex(float(re), float(im))\n 347 | \n 348 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 349 |     def __ge__(self, other):\n 350 |         from .relational import GreaterThan\n 351 |         return GreaterThan(self, other)\n 352 | \n 353 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 354 |     def __le__(self, other):\n 355 |         from .relational import LessThan\n 356 |         return LessThan(self, other)\n 357 | \n 358 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 359 |     def __gt__(self, other):\n 360 |         from .relational import StrictGreaterThan\n 361 |         return StrictGreaterThan(self, other)\n 362 | \n 363 |     @sympify_return([('other', 'Expr')], NotImplemented)\n 364 |     def __lt__(self, other):\n 365 |         from .relational import StrictLessThan\n 366 |         return StrictLessThan(self, other)\n 367 | \n 368 |     def __trunc__(self):\n 369 |         if not self.is_number:\n 370 |             raise TypeError(\"Cannot truncate symbols and expressions\")\n 371 |         else:\n 372 |             return Integer(self)\n 373 | \n 374 |     def __format__(self, format_spec: str):\n 375 |         if self.is_number:\n 376 |             mt = re.match(r'\\+?\\d*\\.(\\d+)f', format_spec)\n 377 |             if mt:\n 378 |                 prec = int(mt.group(1))\n 379 |                 rounded = self.round(prec)\n 380 |                 if rounded.is_Integer:\n 381 |                     return format(int(rounded), format_spec)\n 382 |                 if rounded.is_Float:\n 383 |                     return format(rounded, format_spec)\n 384 |         return super().__format__(format_spec)\n 385 | \n 386 |     @staticmethod\n 387 |     def _from_mpmath(x, prec):\n 388 |         if hasattr(x, \"_mpf_\"):\n 389 |             return Float._new(x._mpf_, prec)\n 390 |         elif hasattr(x, \"_mpc_\"):\n 391 |             re, im = x._mpc_\n 392 |             re = Float._new(re, prec)\n 393 |             im = Float._new(im, prec)*S.ImaginaryUnit\n 394 |             return re + im\n 395 |         else:\n 396 |             raise TypeError(\"expected mpmath number (mpf or mpc)\")\n 397 | \n 398 |     @property\n 399 |     def is_number(self):\n 400 |         \"\"\"Returns True if ``self`` has no free symbols and no\n 401 |         undefined functions (AppliedUndef, to be precise). It will be\n 402 |         faster than ``if not self.free_symbols``, however, since\n 403 |         ``is_number`` will fail as soon as it hits a free symbol\n 404 |         or undefined function.\n 405 | \n 406 |         Examples\n 407 |         ========\n 408 | \n 409 |         >>> from sympy import Function, Integral, cos, sin, pi\n 410 |         >>> from sympy.abc import x\n 411 |         >>> f = Function('f')\n 412 | \n 413 |         >>> x.is_number\n 414 |         False\n 415 |         >>> f(1).is_number\n 416 |         False\n 417 |         >>> (2*x).is_number\n 418 |         False\n 419 |         >>> (2 + Integral(2, x)).is_number\n 420 |         False\n 421 |         >>> (2 + Integral(2, (x, 1, 2))).is_number\n 422 |         True\n 423 | \n 424 |         Not all numbers are Numbers in the SymPy sense:\n 425 | \n 426 |         >>> pi.is_number, pi.is_Number\n 427 |         (True, False)\n 428 | \n 429 |         If something is a number it should evaluate to a number with\n 430 |         real and imaginary parts that are Numbers; the result may not\n 431 |         be comparable, however, since the real and/or imaginary part\n 432 |         of the result may not have precision.\n 433 | \n 434 |         >>> cos(1).is_number and cos(1).is_comparable\n 435 |         True\n 436 | \n 437 |         >>> z = cos(1)**2 + sin(1)**2 - 1\n 438 |         >>> z.is_number\n 439 |         True\n 440 |         >>> z.is_comparable\n 441 |         False\n 442 | \n 443 |         See Also\n 444 |         ========\n 445 | \n 446 |         sympy.core.basic.Basic.is_comparable\n 447 |         \"\"\"\n 448 |         return all(obj.is_number for obj in self.args)\n 449 | \n 450 |     def _eval_is_comparable(self):\n 451 |         # Basic._eval_is_comparable always returns False, so we override it\n 452 |         # here\n 453 |         is_extended_real = self.is_extended_real\n 454 |         if is_extended_real is False:\n 455 |             return False\n 456 |         if not self.is_number:\n 457 |             return False\n 458 | \n 459 |         # XXX: as_real_imag() can be a very expensive operation. It should not\n 460 |         # be used here because is_comparable is used implicitly in many places.\n 461 |         # Probably this method should just return self.evalf(2).is_Number.\n 462 | \n 463 |         n, i = self.as_real_imag()\n 464 | \n 465 |         if not n.is_Number:\n 466 |             n = n.evalf(2)\n 467 |             if not n.is_Number:\n 468 |                 return False\n 469 | \n 470 |         if not i.is_Number:\n 471 |             i = i.evalf(2)\n 472 |             if not i.is_Number:\n 473 |                 return False\n 474 | \n 475 |         if i:\n 476 |             # if _prec = 1 we can't decide and if not,\n 477 |             # the answer is False because numbers with\n 478 |             # imaginary parts can't be compared\n 479 |             # so return False\n 480 |             return False\n 481 |         else:\n 482 |             return n._prec != 1\n 483 | \n 484 |     def _random(self, n=None, re_min=-1, im_min=-1, re_max=1, im_max=1):\n 485 |         \"\"\"Return self evaluated, if possible, replacing free symbols with\n 486 |         random complex values, if necessary.\n 487 | \n 488 |         Explanation\n 489 |         ===========\n 490 | \n 491 |         The random complex value for each free symbol is generated\n 492 |         by the random_complex_number routine giving real and imaginary\n 493 |         parts in the range given by the re_min, re_max, im_min, and im_max\n 494 |         values. The returned value is evaluated to a precision of n\n 495 |         (if given) else the maximum of 15 and the precision needed\n 496 |         to get more than 1 digit of precision. If the expression\n 497 |         could not be evaluated to a number, or could not be evaluated\n 498 |         to more than 1 digit of precision, then None is returned.\n 499 | \n 500 |         Examples\n 501 |         ========\n 502 | \n 503 |         >>> from sympy import sqrt\n 504 |         >>> from sympy.abc import x, y\n 505 |         >>> x._random()                         # doctest: +SKIP\n 506 |         0.0392918155679172 + 0.916050214307199*I\n 507 |         >>> x._random(2)                        # doctest: +SKIP\n 508 |         -0.77 - 0.87*I\n 509 |         >>> (x + y/2)._random(2)                # doctest: +SKIP\n 510 |         -0.57 + 0.16*I\n 511 |         >>> sqrt(2)._random(2)\n 512 |         1.4\n 513 | \n 514 |         See Also\n 515 |         ========\n 516 | \n 517 |         sympy.core.random.random_complex_number\n 518 |         \"\"\"\n 519 | \n 520 |         free = self.free_symbols\n 521 |         prec = 1\n 522 |         if free:\n 523 |             from sympy.core.random import random_complex_number\n 524 |             a, c, b, d = re_min, re_max, im_min, im_max\n 525 |             reps = dict(list(zip(free, [random_complex_number(a, b, c, d, rational=True)\n 526 |                            for zi in free])))\n 527 |             try:\n 528 |                 nmag = abs(self.evalf(2, subs=reps))\n 529 |             except (ValueError, TypeError):\n 530 |                 # if an out of range value resulted in evalf problems\n 531 |                 # then return None -- XXX is there a way to know how to\n 532 |                 # select a good random number for a given expression?\n 533 |                 # e.g. when calculating n! negative values for n should not\n 534 |                 # be used\n 535 |                 return None\n 536 |         else:\n 537 |             reps = {}\n 538 |             nmag = abs(self.evalf(2))\n 539 | \n 540 |         if not hasattr(nmag, '_prec'):\n 541 |             # e.g. exp_polar(2*I*pi) doesn't evaluate but is_number is True\n 542 |             return None\n 543 | \n 544 |         if nmag._prec == 1:\n 545 |             # increase the precision up to the default maximum\n 546 |             # precision to see if we can get any significance\n 547 | \n 548 |             # evaluate\n 549 |             for prec in giant_steps(2, DEFAULT_MAXPREC):\n 550 |                 nmag = abs(self.evalf(prec, subs=reps))\n 551 |                 if nmag._prec != 1:\n 552 |                     break\n 553 | \n 554 |         if nmag._prec != 1:\n 555 |             if n is None:\n 556 |                 n = max(prec, 15)\n 557 |             return self.evalf(n, subs=reps)\n 558 | \n 559 |         # never got any significance\n 560 |         return None\n 561 | \n 562 |     def is_constant(self, *wrt, **flags):\n 563 |         \"\"\"Return True if self is constant, False if not, or None if\n 564 |         the constancy could not be determined conclusively.\n 565 | \n 566 |         Explanation\n 567 |         ===========\n 568 | \n 569 |         If an expression has no free symbols then it is a constant. If\n 570 |         there are free symbols it is possible that the expression is a\n 571 |         constant, perhaps (but not necessarily) zero. To test such\n 572 |         expressions, a few strategies are tried:\n 573 | \n 574 |         1) numerical evaluation at two random points. If two such evaluations\n 575 |         give two different values and the values have a precision greater than\n 576 |         1 then self is not constant. If the evaluations agree or could not be\n 577 |         obtained with any precision, no decision is made. The numerical testing\n 578 |         is done only if ``wrt`` is different than the free symbols.\n 579 | \n 580 |         2) differentiation with respect to variables in 'wrt' (or all free\n 581 |         symbols if omitted) to see if the expression is constant or not. This\n 582 |         will not always lead to an expression that is zero even though an\n 583 |         expression is constant (see added test in test_expr.py). If\n 584 |         all derivatives are zero then self is constant with respect to the\n 585 |         given symbols.\n 586 | \n 587 |         3) finding out zeros of denominator expression with free_symbols.\n 588 |         It will not be constant if there are zeros. It gives more negative\n 589 |         answers for expression that are not constant.\n 590 | \n 591 |         If neither evaluation nor differentiation can prove the expression is\n 592 |         constant, None is returned unless two numerical values happened to be\n 593 |         the same and the flag ``failing_number`` is True -- in that case the\n 594 |         numerical value will be returned.\n 595 | \n 596 |         If flag simplify=False is passed, self will not be simplified;\n 597 |         the default is True since self should be simplified before testing.\n 598 | \n 599 |         Examples\n 600 |         ========\n 601 | \n 602 |         >>> from sympy import cos, sin, Sum, S, pi\n 603 |         >>> from sympy.abc import a, n, x, y\n 604 |         >>> x.is_constant()\n 605 |         False\n 606 |         >>> S(2).is_constant()\n 607 |         True\n 608 |         >>> Sum(x, (x, 1, 10)).is_constant()\n 609 |         True\n 610 |         >>> Sum(x, (x, 1, n)).is_constant()\n 611 |         False\n 612 |         >>> Sum(x, (x, 1, n)).is_constant(y)\n 613 |         True\n 614 |         >>> Sum(x, (x, 1, n)).is_constant(n)\n 615 |         False\n 616 |         >>> Sum(x, (x, 1, n)).is_constant(x)\n 617 |         True\n 618 |         >>> eq = a*cos(x)**2 + a*sin(x)**2 - a\n 619 |         >>> eq.is_constant()\n 620 |         True\n 621 |         >>> eq.subs({x: pi, a: 2}) == eq.subs({x: pi, a: 3}) == 0\n 622 |         True\n 623 | \n 624 |         >>> (0**x).is_constant()\n 625 |         False\n 626 |         >>> x.is_constant()\n 627 |         False\n 628 |         >>> (x**x).is_constant()\n 629 |         False\n 630 |         >>> one = cos(x)**2 + sin(x)**2\n 631 |         >>> one.is_constant()\n 632 |         True\n 633 |         >>> ((one - 1)**(x + 1)).is_constant() in (True, False) # could be 0 or 1\n 634 |         True\n 635 |         \"\"\"\n 636 | \n 637 |         simplify = flags.get('simplify', True)\n 638 | \n 639 |         if self.is_number:\n 640 |             return True\n 641 |         free = self.free_symbols\n 642 |         if not free:\n 643 |             return True  # assume f(1) is some constant\n 644 | \n 645 |         # if we are only interested in some symbols and they are not in the\n 646 |         # free symbols then this expression is constant wrt those symbols\n 647 |         wrt = set(wrt)\n 648 |         if wrt and not wrt & free:\n 649 |             return True\n 650 |         wrt = wrt or free\n 651 | \n 652 |         # simplify unless this has already been done\n 653 |         expr = self\n 654 |         if simplify:\n 655 |             expr = expr.simplify()\n 656 | \n 657 |         # is_zero should be a quick assumptions check; it can be wrong for\n 658 |         # numbers (see test_is_not_constant test), giving False when it\n 659 |         # shouldn't, but hopefully it will never give True unless it is sure.\n 660 |         if expr.is_zero:\n 661 |             return True\n 662 | \n 663 |         # Don't attempt substitution or differentiation with non-number symbols\n 664 |         wrt_number = {sym for sym in wrt if sym.kind is NumberKind}\n 665 | \n 666 |         # try numerical evaluation to see if we get two different values\n 667 |         failing_number = None\n 668 |         if wrt_number == free:\n 669 |             # try 0 (for a) and 1 (for b)\n 670 |             try:\n 671 |                 a = expr.subs(list(zip(free, [0]*len(free))),\n 672 |                     simultaneous=True)\n 673 |                 if a is S.NaN:\n 674 |                     # evaluation may succeed when substitution fails\n 675 |                     a = expr._random(None, 0, 0, 0, 0)\n 676 |             except ZeroDivisionError:\n 677 |                 a = None\n 678 |             if a is not None and a is not S.NaN:\n 679 |                 try:\n 680 |                     b = expr.subs(list(zip(free, [1]*len(free))),\n 681 |                         simultaneous=True)\n 682 |                     if b is S.NaN:\n 683 |                         # evaluation may succeed when substitution fails\n 684 |                         b = expr._random(None, 1, 0, 1, 0)\n 685 |                 except ZeroDivisionError:\n 686 |                     b = None\n 687 |                 if b is not None and b is not S.NaN and b.equals(a) is False:\n 688 |                     return False\n 689 |                 # try random real\n 690 |                 b = expr._random(None, -1, 0, 1, 0)\n 691 |                 if b is not None and b is not S.NaN and b.equals(a) is False:\n 692 |                     return False\n 693 |                 # try random complex\n 694 |                 b = expr._random()\n 695 |                 if b is not None and b is not S.NaN:\n 696 |                     if b.equals(a) is False:\n 697 |                         return False\n 698 |                     failing_number = a if a.is_number else b\n 699 | \n 700 |         # now we will test each wrt symbol (or all free symbols) to see if the\n 701 |         # expression depends on them or not using differentiation. This is\n 702 |         # not sufficient for all expressions, however, so we don't return\n 703 |         # False if we get a derivative other than 0 with free symbols.\n 704 |         for w in wrt_number:\n 705 |             deriv = expr.diff(w)\n 706 |             if simplify:\n 707 |                 deriv = deriv.simplify()\n 708 |             if deriv != 0:\n 709 |                 if not (pure_complex(deriv, or_real=True)):\n 710 |                     if flags.get('failing_number', False):\n 711 |                         return failing_number\n 712 |                 return False\n 713 |         from sympy.solvers.solvers import denoms\n 714 |         return fuzzy_not(fuzzy_or(den.is_zero for den in denoms(self)))\n 715 | \n 716 |     def equals(self, other, failing_expression=False):\n 717 |         \"\"\"Return True if self == other, False if it does not, or None. If\n 718 |         failing_expression is True then the expression which did not simplify\n 719 |         to a 0 will be returned instead of None.\n 720 | \n 721 |         Explanation\n 722 |         ===========\n 723 | \n 724 |         If ``self`` is a Number (or complex number) that is not zero, then\n 725 |         the result is False.\n 726 | \n 727 |         If ``self`` is a number and has not evaluated to zero, evalf will be\n 728 |         used to test whether the expression evaluates to zero. If it does so\n 729 |         and the result has significance (i.e. the precision is either -1, for\n 730 |         a Rational result, or is greater than 1) then the evalf value will be\n 731 |         used to return True or False.\n 732 | \n 733 |         \"\"\"\n 734 |         from sympy.simplify.simplify import nsimplify, simplify\n 735 |         from sympy.solvers.solvers import solve\n 736 |         from sympy.polys.polyerrors import NotAlgebraic\n 737 |         from sympy.polys.numberfields import minimal_polynomial\n 738 | \n 739 |         other = sympify(other)\n 740 | \n 741 |         if not isinstance(other, Expr):\n 742 |             return False\n 743 | \n 744 |         if self == other:\n 745 |             return True\n 746 | \n 747 |         # they aren't the same so see if we can make the difference 0;\n 748 |         # don't worry about doing simplification steps one at a time\n 749 |         # because if the expression ever goes to 0 then the subsequent\n 750 |         # simplification steps that are done will be very fast.\n 751 |         diff = factor_terms(simplify(self - other), radical=True)\n 752 | \n 753 |         if not diff:\n 754 |             return True\n 755 | \n 756 |         if not diff.has(Add, Mod):\n 757 |             # if there is no expanding to be done after simplifying\n 758 |             # then this can't be a zero\n 759 |             return False\n 760 | \n 761 |         factors = diff.as_coeff_mul()[1]\n 762 |         if len(factors) > 1:  # avoid infinity recursion\n 763 |             fac_zero = [fac.equals(0) for fac in factors]\n 764 |             if None not in fac_zero:  # every part can be decided\n 765 |                 return any(fac_zero)\n 766 | \n 767 |         constant = diff.is_constant(simplify=False, failing_number=True)\n 768 | \n 769 |         if constant is False:\n 770 |             return False\n 771 | \n 772 |         if not diff.is_number:\n 773 |             if constant is None:\n 774 |                 # e.g. unless the right simplification is done, a symbolic\n 775 |                 # zero is possible (see expression of issue 6829: without\n 776 |                 # simplification constant will be None).\n 777 |                 return\n 778 | \n 779 |         if constant is True:\n 780 |             # this gives a number whether there are free symbols or not\n 781 |             ndiff = diff._random()\n 782 |             # is_comparable will work whether the result is real\n 783 |             # or complex; it could be None, however.\n 784 |             if ndiff and ndiff.is_comparable:\n 785 |                 return False\n 786 | \n 787 |         # sometimes we can use a simplified result to give a clue as to\n 788 |         # what the expression should be; if the expression is *not* zero\n 789 |         # then we should have been able to compute that and so now\n 790 |         # we can just consider the cases where the approximation appears\n 791 |         # to be zero -- we try to prove it via minimal_polynomial.\n 792 |         #\n 793 |         # removed\n 794 |         # ns = nsimplify(diff)\n 795 |         # if diff.is_number and (not ns or ns == diff):\n 796 |         #\n 797 |         # The thought was that if it nsimplifies to 0 that's a sure sign\n 798 |         # to try the following to prove it; or if it changed but wasn't\n 799 |         # zero that might be a sign that it's not going to be easy to\n 800 |         # prove. But tests seem to be working without that logic.\n 801 |         #\n 802 |         if diff.is_number:\n 803 |             # try to prove via self-consistency\n 804 |             surds = [s for s in diff.atoms(Pow) if s.args[0].is_Integer]\n 805 |             # it seems to work better to try big ones first\n 806 |             surds.sort(key=lambda x: -x.args[0])\n 807 |             for s in surds:\n 808 |                 try:\n 809 |                     # simplify is False here -- this expression has already\n 810 |                     # been identified as being hard to identify as zero;\n 811 |                     # we will handle the checking ourselves using nsimplify\n 812 |                     # to see if we are in the right ballpark or not and if so\n 813 |                     # *then* the simplification will be attempted.\n 814 |                     sol = solve(diff, s, simplify=False)\n 815 |                     if sol:\n 816 |                         if s in sol:\n 817 |                             # the self-consistent result is present\n 818 |                             return True\n 819 |                         if all(si.is_Integer for si in sol):\n 820 |                             # perfect powers are removed at instantiation\n 821 |                             # so surd s cannot be an integer\n 822 |                             return False\n 823 |                         if all(i.is_algebraic is False for i in sol):\n 824 |                             # a surd is algebraic\n 825 |                             return False\n 826 |                         if any(si in surds for si in sol):\n 827 |                             # it wasn't equal to s but it is in surds\n 828 |                             # and different surds are not equal\n 829 |                             return False\n 830 |                         if any(nsimplify(s - si) == 0 and\n 831 |                                 simplify(s - si) == 0 for si in sol):\n 832 |                             return True\n 833 |                         if s.is_real:\n 834 |                             if any(nsimplify(si, [s]) == s and simplify(si) == s\n 835 |                                     for si in sol):\n 836 |                                 return True\n 837 |                 except NotImplementedError:\n 838 |                     pass\n 839 | \n 840 |             # try to prove with minimal_polynomial but know when\n 841 |             # *not* to use this or else it can take a long time. e.g. issue 8354\n 842 |             if True:  # change True to condition that assures non-hang\n 843 |                 try:\n 844 |                     mp = minimal_polynomial(diff)\n 845 |                     if mp.is_Symbol:\n 846 |                         return True\n 847 |                     return False\n 848 |                 except (NotAlgebraic, NotImplementedError):\n 849 |                     pass\n 850 | \n 851 |         # diff has not simplified to zero; constant is either None, True\n 852 |         # or the number with significance (is_comparable) that was randomly\n 853 |         # calculated twice as the same value.\n 854 |         if constant not in (True, None) and constant != 0:\n 855 |             return False\n 856 | \n 857 |         if failing_expression:\n 858 |             return diff\n 859 |         return None\n 860 | \n 861 |     def _eval_is_extended_positive_negative(self, positive):\n 862 |         from sympy.polys.numberfields import minimal_polynomial\n 863 |         from sympy.polys.polyerrors import NotAlgebraic\n 864 |         if self.is_number:\n 865 |             # check to see that we can get a value\n 866 |             try:\n 867 |                 n2 = self._eval_evalf(2)\n 868 |             # XXX: This shouldn't be caught here\n 869 |             # Catches ValueError: hypsum() failed to converge to the requested\n 870 |             # 34 bits of accuracy\n 871 |             except ValueError:\n 872 |                 return None\n 873 |             if n2 is None:\n 874 |                 return None\n 875 |             if getattr(n2, '_prec', 1) == 1:  # no significance\n 876 |                 return None\n 877 |             if n2 is S.NaN:\n 878 |                 return None\n 879 | \n 880 |             f = self.evalf(2)\n 881 |             if f.is_Float:\n 882 |                 match = f, S.Zero\n 883 |             else:\n 884 |                 match = pure_complex(f)\n 885 |             if match is None:\n 886 |                 return False\n 887 |             r, i = match\n 888 |             if not (i.is_Number and r.is_Number):\n 889 |                 return False\n 890 |             if r._prec != 1 and i._prec != 1:\n 891 |                 return bool(not i and ((r > 0) if positive else (r < 0)))\n 892 |             elif r._prec == 1 and (not i or i._prec == 1) and \\\n 893 |                     self._eval_is_algebraic() and not self.has(Function):\n 894 |                 try:\n 895 |                     if minimal_polynomial(self).is_Symbol:\n 896 |                         return False\n 897 |                 except (NotAlgebraic, NotImplementedError):\n 898 |                     pass\n 899 | \n 900 |     def _eval_is_extended_positive(self):\n 901 |         return self._eval_is_extended_positive_negative(positive=True)\n 902 | \n 903 |     def _eval_is_extended_negative(self):\n 904 |         return self._eval_is_extended_positive_negative(positive=False)\n 905 | \n 906 |     def _eval_interval(self, x, a, b):\n 907 |         \"\"\"\n 908 |         Returns evaluation over an interval.  For most functions this is:\n 909 | \n 910 |         self.subs(x, b) - self.subs(x, a),\n 911 | \n 912 |         possibly using limit() if NaN is returned from subs, or if\n 913 |         singularities are found between a and b.\n 914 | \n 915 |         If b or a is None, it only evaluates -self.subs(x, a) or self.subs(b, x),\n 916 |         respectively.\n 917 | \n 918 |         \"\"\"\n 919 |         from sympy.calculus.accumulationbounds import AccumBounds\n 920 |         from sympy.functions.elementary.exponential import log\n 921 |         from sympy.series.limits import limit, Limit\n 922 |         from sympy.sets.sets import Interval\n 923 |         from sympy.solvers.solveset import solveset\n 924 | \n 925 |         if (a is None and b is None):\n 926 |             raise ValueError('Both interval ends cannot be None.')\n 927 | \n 928 |         def _eval_endpoint(left):\n 929 |             c = a if left else b\n 930 |             if c is None:\n 931 |                 return S.Zero\n 932 |             else:\n 933 |                 C = self.subs(x, c)\n 934 |                 if C.has(S.NaN, S.Infinity, S.NegativeInfinity,\n 935 |                          S.ComplexInfinity, AccumBounds):\n 936 |                     if (a < b) != False:\n 937 |                         C = limit(self, x, c, \"+\" if left else \"-\")\n 938 |                     else:\n 939 |                         C = limit(self, x, c, \"-\" if left else \"+\")\n 940 | \n 941 |                     if isinstance(C, Limit):\n 942 |                         raise NotImplementedError(\"Could not compute limit\")\n 943 |             return C\n 944 | \n 945 |         if a == b:\n 946 |             return S.Zero\n 947 | \n 948 |         A = _eval_endpoint(left=True)\n 949 |         if A is S.NaN:\n 950 |             return A\n 951 | \n 952 |         B = _eval_endpoint(left=False)\n 953 | \n 954 |         if (a and b) is None:\n 955 |             return B - A\n 956 | \n 957 |         value = B - A\n 958 | \n 959 |         if a.is_comparable and b.is_comparable:\n 960 |             if a < b:\n 961 |                 domain = Interval(a, b)\n 962 |             else:\n 963 |                 domain = Interval(b, a)\n 964 |             # check the singularities of self within the interval\n 965 |             # if singularities is a ConditionSet (not iterable), catch the exception and pass\n 966 |             singularities = solveset(self.cancel().as_numer_denom()[1], x,\n 967 |                 domain=domain)\n 968 |             for logterm in self.atoms(log):\n 969 |                 singularities = singularities | solveset(logterm.args[0], x,\n 970 |                     domain=domain)\n 971 |             try:\n 972 |                 for s in singularities:\n 973 |                     if value is S.NaN:\n 974 |                         # no need to keep adding, it will stay NaN\n 975 |                         break\n 976 |                     if not s.is_comparable:\n 977 |                         continue\n 978 |                     if (a < s) == (s < b) == True:\n 979 |                         value += -limit(self, x, s, \"+\") + limit(self, x, s, \"-\")\n 980 |                     elif (b < s) == (s < a) == True:\n 981 |                         value += limit(self, x, s, \"+\") - limit(self, x, s, \"-\")\n 982 |             except TypeError:\n 983 |                 pass\n 984 | \n 985 |         return value\n 986 | \n 987 |     def _eval_power(self, expt) -> Expr | None:\n 988 |         # subclass to compute self**other for cases when\n 989 |         # other is not NaN, 0, or 1\n 990 |         return None\n 991 | \n 992 |     def _eval_conjugate(self):\n 993 |         if self.is_extended_real:\n 994 |             return self\n 995 |         elif self.is_imaginary:\n 996 |             return -self\n 997 | \n 998 |     def conjugate(self):\n 999 |         \"\"\"Returns the complex conjugate of 'self'.\"\"\"\n1000 |         from sympy.functions.elementary.complexes import conjugate as c\n1001 |         return c(self)\n1002 | \n1003 |     def dir(self, x, cdir):\n1004 |         if self.is_zero:\n1005 |             return S.Zero\n1006 |         from sympy.functions.elementary.exponential import log\n1007 |         minexp = S.Zero\n1008 |         arg = self\n1009 |         while arg:\n1010 |             minexp += S.One\n1011 |             arg = arg.diff(x)\n1012 |             coeff = arg.subs(x, 0)\n1013 |             if coeff is S.NaN:\n1014 |                 coeff = arg.limit(x, 0)\n1015 |             if coeff is S.ComplexInfinity:\n1016 |                 try:\n1017 |                     coeff, _ = arg.leadterm(x)\n1018 |                     if coeff.has(log(x)):\n1019 |                         raise ValueError()\n1020 |                 except ValueError:\n1021 |                     coeff = arg.limit(x, 0)\n1022 |             if coeff != S.Zero:\n1023 |                 break\n1024 |         return coeff*cdir**minexp\n1025 | \n1026 |     def _eval_transpose(self):\n1027 |         from sympy.functions.elementary.complexes import conjugate\n1028 |         if (self.is_complex or self.is_infinite):\n1029 |             return self\n1030 |         elif self.is_hermitian:\n1031 |             return conjugate(self)\n1032 |         elif self.is_antihermitian:\n1033 |             return -conjugate(self)\n1034 | \n1035 |     def transpose(self):\n1036 |         from sympy.functions.elementary.complexes import transpose\n1037 |         return transpose(self)\n1038 | \n1039 |     def _eval_adjoint(self):\n1040 |         from sympy.functions.elementary.complexes import conjugate, transpose\n1041 |         if self.is_hermitian:\n1042 |             return self\n1043 |         elif self.is_antihermitian:\n1044 |             return -self\n1045 |         obj = self._eval_conjugate()\n1046 |         if obj is not None:\n1047 |             return transpose(obj)\n1048 |         obj = self._eval_transpose()\n1049 |         if obj is not None:\n1050 |             return conjugate(obj)\n1051 | \n1052 |     def adjoint(self):\n1053 |         from sympy.functions.elementary.complexes import adjoint\n1054 |         return adjoint(self)\n1055 | \n1056 |     @classmethod\n1057 |     def _parse_order(cls, order):\n1058 |         \"\"\"Parse and configure the ordering of terms. \"\"\"\n1059 |         from sympy.polys.orderings import monomial_key\n1060 | \n1061 |         startswith = getattr(order, \"startswith\", None)\n1062 |         if startswith is None:\n1063 |             reverse = False\n1064 |         else:\n1065 |             reverse = startswith('rev-')\n1066 |             if reverse:\n1067 |                 order = order[4:]\n1068 | \n1069 |         monom_key = monomial_key(order)\n1070 | \n1071 |         def neg(monom):\n1072 |             return tuple([neg(m) if isinstance(m, tuple) else -m for m in monom])\n1073 | \n1074 |         def key(term):\n1075 |             _, ((re, im), monom, ncpart) = term\n1076 | \n1077 |             monom = neg(monom_key(monom))\n1078 |             ncpart = tuple([e.sort_key(order=order) for e in ncpart])\n1079 |             coeff = ((bool(im), im), (re, im))\n1080 | \n1081 |             return monom, ncpart, coeff\n1082 | \n1083 |         return key, reverse\n1084 | \n1085 |     def as_ordered_factors(self, order=None):\n1086 |         \"\"\"Return list of ordered factors (if Mul) else [self].\"\"\"\n1087 |         return [self]\n1088 | \n1089 |     def as_poly(self, *gens, **args):\n1090 |         \"\"\"Converts ``self`` to a polynomial or returns ``None``.\n1091 | \n1092 |         Explanation\n1093 |         ===========\n1094 | \n1095 |         >>> from sympy import sin\n1096 |         >>> from sympy.abc import x, y\n1097 | \n1098 |         >>> print((x**2 + x*y).as_poly())\n1099 |         Poly(x**2 + x*y, x, y, domain='ZZ')\n1100 | \n1101 |         >>> print((x**2 + x*y).as_poly(x, y))\n1102 |         Poly(x**2 + x*y, x, y, domain='ZZ')\n1103 | \n1104 |         >>> print((x**2 + sin(y)).as_poly(x, y))\n1105 |         None\n1106 | \n1107 |         \"\"\"\n1108 |         from sympy.polys.polyerrors import PolynomialError, GeneratorsNeeded\n1109 |         from sympy.polys.polytools import Poly\n1110 | \n1111 |         try:\n1112 |             poly = Poly(self, *gens, **args)\n1113 | \n1114 |             if not poly.is_Poly:\n1115 |                 return None\n1116 |             else:\n1117 |                 return poly\n1118 |         except (PolynomialError, GeneratorsNeeded):\n1119 |             # PolynomialError is caught for e.g. exp(x).as_poly(x)\n1120 |             # GeneratorsNeeded is caught for e.g. S(2).as_poly()\n1121 |             return None\n1122 | \n1123 |     def as_ordered_terms(self, order=None, data=False):\n1124 |         \"\"\"\n1125 |         Transform an expression to an ordered list of terms.\n1126 | \n1127 |         Examples\n1128 |         ========\n1129 | \n1130 |         >>> from sympy import sin, cos\n1131 |         >>> from sympy.abc import x\n1132 | \n1133 |         >>> (sin(x)**2*cos(x) + sin(x)**2 + 1).as_ordered_terms()\n1134 |         [sin(x)**2*cos(x), sin(x)**2, 1]\n1135 | \n1136 |         \"\"\"\n1137 | \n1138 |         from .numbers import Number, NumberSymbol\n1139 | \n1140 |         if order is None and self.is_Add:\n1141 |             # Spot the special case of Add(Number, Mul(Number, expr)) with the\n1142 |             # first number positive and the second number negative\n1143 |             key = lambda x:not isinstance(x, (Number, NumberSymbol))\n1144 |             add_args = sorted(Add.make_args(self), key=key)\n1145 |             if (len(add_args) == 2\n1146 |                 and isinstance(add_args[0], (Number, NumberSymbol))\n1147 |                 and isinstance(add_args[1], Mul)):\n1148 |                 mul_args = sorted(Mul.make_args(add_args[1]), key=key)\n1149 |                 if (len(mul_args) == 2\n1150 |                     and isinstance(mul_args[0], Number)\n1151 |                     and add_args[0].is_positive\n1152 |                     and mul_args[0].is_negative):\n1153 |                     return add_args\n1154 | \n1155 |         key, reverse = self._parse_order(order)\n1156 |         terms, gens = self.as_terms()\n1157 | \n1158 |         if not any(term.is_Order for term, _ in terms):\n1159 |             ordered = sorted(terms, key=key, reverse=reverse)\n1160 |         else:\n1161 |             _terms, _order = [], []\n1162 | \n1163 |             for term, repr in terms:\n1164 |                 if not term.is_Order:\n1165 |                     _terms.append((term, repr))\n1166 |                 else:\n1167 |                     _order.append((term, repr))\n1168 | \n1169 |             ordered = sorted(_terms, key=key, reverse=True) \\\n1170 |                 + sorted(_order, key=key, reverse=True)\n1171 | \n1172 |         if data:\n1173 |             return ordered, gens\n1174 |         else:\n1175 |             return [term for term, _ in ordered]\n1176 | \n1177 |     def as_terms(self):\n1178 |         \"\"\"Transform an expression to a list of terms. \"\"\"\n1179 |         from .exprtools import decompose_power\n1180 | \n1181 |         gens, terms = set(), []\n1182 | \n1183 |         for term in Add.make_args(self):\n1184 |             coeff, _term = term.as_coeff_Mul()\n1185 | \n1186 |             coeff = complex(coeff)\n1187 |             cpart, ncpart = {}, []\n1188 | \n1189 |             if _term is not S.One:\n1190 |                 for factor in Mul.make_args(_term):\n1191 |                     if factor.is_number:\n1192 |                         try:\n1193 |                             coeff *= complex(factor)\n1194 |                         except (TypeError, ValueError):\n1195 |                             pass\n1196 |                         else:\n1197 |                             continue\n1198 | \n1199 |                     if factor.is_commutative:\n1200 |                         base, exp = decompose_power(factor)\n1201 | \n1202 |                         cpart[base] = exp\n1203 |                         gens.add(base)\n1204 |                     else:\n1205 |                         ncpart.append(factor)\n1206 | \n1207 |             coeff = coeff.real, coeff.imag\n1208 |             ncpart = tuple(ncpart)\n1209 | \n1210 |             terms.append((term, (coeff, cpart, ncpart)))\n1211 | \n1212 |         gens = sorted(gens, key=default_sort_key)\n1213 | \n1214 |         k, indices = len(gens), {}\n1215 | \n1216 |         for i, g in enumerate(gens):\n1217 |             indices[g] = i\n1218 | \n1219 |         result = []\n1220 | \n1221 |         for term, (coeff, cpart, ncpart) in terms:\n1222 |             monom = [0]*k\n1223 | \n1224 |             for base, exp in cpart.items():\n1225 |                 monom[indices[base]] = exp\n1226 | \n1227 |             result.append((term, (coeff, tuple(monom), ncpart)))\n1228 | \n1229 |         return result, gens\n1230 | \n1231 |     def removeO(self) -> Expr:\n1232 |         \"\"\"Removes the additive O(..) symbol if there is one\"\"\"\n1233 |         return self\n1234 | \n1235 |     def getO(self) -> Expr | None:\n1236 |         \"\"\"Returns the additive O(..) symbol if there is one, else None.\"\"\"\n1237 |         return None\n1238 | \n1239 |     def getn(self):\n1240 |         \"\"\"\n1241 |         Returns the order of the expression.\n1242 | \n1243 |         Explanation\n1244 |         ===========\n1245 | \n1246 |         The order is determined either from the O(...) term. If there\n1247 |         is no O(...) term, it returns None.\n1248 | \n1249 |         Examples\n1250 |         ========\n1251 | \n1252 |         >>> from sympy import O\n1253 |         >>> from sympy.abc import x\n1254 |         >>> (1 + x + O(x**2)).getn()\n1255 |         2\n1256 |         >>> (1 + x).getn()\n1257 | \n1258 |         \"\"\"\n1259 |         o = self.getO()\n1260 |         if o is None:\n1261 |             return None\n1262 |         elif o.is_Order:\n1263 |             o = o.expr\n1264 |             if o is S.One:\n1265 |                 return S.Zero\n1266 |             if o.is_Symbol:\n1267 |                 return S.One\n1268 |             if o.is_Pow:\n1269 |                 return o.args[1]\n1270 |             if o.is_Mul:  # x**n*log(x)**n or x**n/log(x)**n\n1271 |                 for oi in o.args:\n1272 |                     if oi.is_Symbol:\n1273 |                         return S.One\n1274 |                     if oi.is_Pow:\n1275 |                         from .symbol import Dummy, Symbol\n1276 |                         syms = oi.atoms(Symbol)\n1277 |                         if len(syms) == 1:\n1278 |                             x = syms.pop()\n1279 |                             oi = oi.subs(x, Dummy('x', positive=True))\n1280 |                             if oi.base.is_Symbol and oi.exp.is_Rational:\n1281 |                                 return abs(oi.exp)\n1282 | \n1283 |         raise NotImplementedError('not sure of order of %s' % o)\n1284 | \n1285 |     def count_ops(self, visual=None):\n1286 |         from .function import count_ops\n1287 |         return count_ops(self, visual)\n1288 | \n1289 |     def args_cnc(self, cset=False, warn=True, split_1=True):\n1290 |         \"\"\"Return [commutative factors, non-commutative factors] of self.\n1291 | \n1292 |         Explanation\n1293 |         ===========\n1294 | \n1295 |         self is treated as a Mul and the ordering of the factors is maintained.\n1296 |         If ``cset`` is True the commutative factors will be returned in a set.\n1297 |         If there were repeated factors (as may happen with an unevaluated Mul)\n1298 |         then an error will be raised unless it is explicitly suppressed by\n1299 |         setting ``warn`` to False.\n1300 | \n1301 |         Note: -1 is always separated from a Number unless split_1 is False.\n1302 | \n1303 |         Examples\n1304 |         ========\n1305 | \n1306 |         >>> from sympy import symbols, oo\n1307 |         >>> A, B = symbols('A B', commutative=0)\n1308 |         >>> x, y = symbols('x y')\n1309 |         >>> (-2*x*y).args_cnc()\n1310 |         [[-1, 2, x, y], []]\n1311 |         >>> (-2.5*x).args_cnc()\n1312 |         [[-1, 2.5, x], []]\n1313 |         >>> (-2*x*A*B*y).args_cnc()\n1314 |         [[-1, 2, x, y], [A, B]]\n1315 |         >>> (-2*x*A*B*y).args_cnc(split_1=False)\n1316 |         [[-2, x, y], [A, B]]\n1317 |         >>> (-2*x*y).args_cnc(cset=True)\n1318 |         [{-1, 2, x, y}, []]\n1319 | \n1320 |         The arg is always treated as a Mul:\n1321 | \n1322 |         >>> (-2 + x + A).args_cnc()\n1323 |         [[], [x - 2 + A]]\n1324 |         >>> (-oo).args_cnc() # -oo is a singleton\n1325 |         [[-1, oo], []]\n1326 |         \"\"\"\n1327 |         args = list(Mul.make_args(self))\n1328 | \n1329 |         for i, mi in enumerate(args):\n1330 |             if not mi.is_commutative:\n1331 |                 c = args[:i]\n1332 |                 nc = args[i:]\n1333 |                 break\n1334 |         else:\n1335 |             c = args\n1336 |             nc = []\n1337 | \n1338 |         if c and split_1 and (\n1339 |             c[0].is_Number and\n1340 |             c[0].is_extended_negative and\n1341 |                 c[0] is not S.NegativeOne):\n1342 |             c[:1] = [S.NegativeOne, -c[0]]\n1343 | \n1344 |         if cset:\n1345 |             clen = len(c)\n1346 |             c = set(c)\n1347 |             if clen and warn and len(c) != clen:\n1348 |                 raise ValueError('repeated commutative arguments: %s' %\n1349 |                                  [ci for ci in c if list(self.args).count(ci) > 1])\n1350 |         return [c, nc]\n1351 | \n1352 |     def coeff(self, x: Expr, n=1, right=False, _first=True):\n1353 |         \"\"\"\n1354 |         Returns the coefficient from the term(s) containing ``x**n``. If ``n``\n1355 |         is zero then all terms independent of ``x`` will be returned.\n1356 | \n1357 |         Explanation\n1358 |         ===========\n1359 | \n1360 |         When ``x`` is noncommutative, the coefficient to the left (default) or\n1361 |         right of ``x`` can be returned. The keyword 'right' is ignored when\n1362 |         ``x`` is commutative.\n1363 | \n1364 |         Examples\n1365 |         ========\n1366 | \n1367 |         >>> from sympy import symbols\n1368 |         >>> from sympy.abc import x, y, z\n1369 | \n1370 |         You can select terms that have an explicit negative in front of them:\n1371 | \n1372 |         >>> (-x + 2*y).coeff(-1)\n1373 |         x\n1374 |         >>> (x - 2*y).coeff(-1)\n1375 |         2*y\n1376 | \n1377 |         You can select terms with no Rational coefficient:\n1378 | \n1379 |         >>> (x + 2*y).coeff(1)\n1380 |         x\n1381 |         >>> (3 + 2*x + 4*x**2).coeff(1)\n1382 |         0\n1383 | \n1384 |         You can select terms independent of x by making n=0; in this case\n1385 |         expr.as_independent(x)[0] is returned (and 0 will be returned instead\n1386 |         of None):\n1387 | \n1388 |         >>> (3 + 2*x + 4*x**2).coeff(x, 0)\n1389 |         3\n1390 |         >>> eq = ((x + 1)**3).expand() + 1\n1391 |         >>> eq\n1392 |         x**3 + 3*x**2 + 3*x + 2\n1393 |         >>> [eq.coeff(x, i) for i in reversed(range(4))]\n1394 |         [1, 3, 3, 2]\n1395 |         >>> eq -= 2\n1396 |         >>> [eq.coeff(x, i) for i in reversed(range(4))]\n1397 |         [1, 3, 3, 0]\n1398 | \n1399 |         You can select terms that have a numerical term in front of them:\n1400 | \n1401 |         >>> (-x - 2*y).coeff(2)\n1402 |         -y\n1403 |         >>> from sympy import sqrt\n1404 |         >>> (x + sqrt(2)*x).coeff(sqrt(2))\n1405 |         x\n1406 | \n1407 |         The matching is exact:\n1408 | \n1409 |         >>> (3 + 2*x + 4*x**2).coeff(x)\n1410 |         2\n1411 |         >>> (3 + 2*x + 4*x**2).coeff(x**2)\n1412 |         4\n1413 |         >>> (3 + 2*x + 4*x**2).coeff(x**3)\n1414 |         0\n1415 |         >>> (z*(x + y)**2).coeff((x + y)**2)\n1416 |         z\n1417 |         >>> (z*(x + y)**2).coeff(x + y)\n1418 |         0\n1419 | \n1420 |         In addition, no factoring is done, so 1 + z*(1 + y) is not obtained\n1421 |         from the following:\n1422 | \n1423 |         >>> (x + z*(x + x*y)).coeff(x)\n1424 |         1\n1425 | \n1426 |         If such factoring is desired, factor_terms can be used first:\n1427 | \n1428 |         >>> from sympy import factor_terms\n1429 |         >>> factor_terms(x + z*(x + x*y)).coeff(x)\n1430 |         z*(y + 1) + 1\n1431 | \n1432 |         >>> n, m, o = symbols('n m o', commutative=False)\n1433 |         >>> n.coeff(n)\n1434 |         1\n1435 |         >>> (3*n).coeff(n)\n1436 |         3\n1437 |         >>> (n*m + m*n*m).coeff(n) # = (1 + m)*n*m\n1438 |         1 + m\n1439 |         >>> (n*m + m*n*m).coeff(n, right=True) # = (1 + m)*n*m\n1440 |         m\n1441 | \n1442 |         If there is more than one possible coefficient 0 is returned:\n1443 | \n1444 |         >>> (n*m + m*n).coeff(n)\n1445 |         0\n1446 | \n1447 |         If there is only one possible coefficient, it is returned:\n1448 | \n1449 |         >>> (n*m + x*m*n).coeff(m*n)\n1450 |         x\n1451 |         >>> (n*m + x*m*n).coeff(m*n, right=1)\n1452 |         1\n1453 | \n1454 |         See Also\n1455 |         ========\n1456 | \n1457 |         as_coefficient: separate the expression into a coefficient and factor\n1458 |         as_coeff_Add: separate the additive constant from an expression\n1459 |         as_coeff_Mul: separate the multiplicative constant from an expression\n1460 |         as_independent: separate x-dependent terms/factors from others\n1461 |         sympy.polys.polytools.Poly.coeff_monomial: efficiently find the single coefficient of a monomial in Poly\n1462 |         sympy.polys.polytools.Poly.nth: like coeff_monomial but powers of monomial terms are used\n1463 |         \"\"\"\n1464 |         x = sympify(x)\n1465 |         if not isinstance(x, Basic):\n1466 |             return S.Zero\n1467 | \n1468 |         n = as_int(n)\n1469 | \n1470 |         if not x:\n1471 |             return S.Zero\n1472 | \n1473 |         if x == self:\n1474 |             if n == 1:\n1475 |                 return S.One\n1476 |             return S.Zero\n1477 | \n1478 |         if x is S.One:\n1479 |             co = [a for a in Add.make_args(self)\n1480 |                   if a.as_coeff_Mul()[0] is S.One]\n1481 |             if not co:\n1482 |                 return S.Zero\n1483 |             return Add(*co)\n1484 | \n1485 |         if n == 0:\n1486 |             if x.is_Add and self.is_Add:\n1487 |                 c = self.coeff(x, right=right)\n1488 |                 if not c:\n1489 |                     return S.Zero\n1490 |                 if not right:\n1491 |                     return self - Add(*[a*x for a in Add.make_args(c)])\n1492 |                 return self - Add(*[x*a for a in Add.make_args(c)])\n1493 |             return self.as_independent(x, as_Add=True)[0]\n1494 | \n1495 |         # continue with the full method, looking for this power of x:\n1496 |         x = x**n\n1497 | \n1498 |         def incommon(l1, l2):\n1499 |             if not l1 or not l2:\n1500 |                 return []\n1501 |             n = min(len(l1), len(l2))\n1502 |             for i in range(n):\n1503 |                 if l1[i] != l2[i]:\n1504 |                     return l1[:i]\n1505 |             return l1[:]\n1506 | \n1507 |         def find(l, sub, first=True):\n1508 |             \"\"\" Find where list sub appears in list l. When ``first`` is True\n1509 |             the first occurrence from the left is returned, else the last\n1510 |             occurrence is returned. Return None if sub is not in l.\n1511 | \n1512 |             Examples\n1513 |             ========\n1514 | \n1515 |             >> l = range(5)*2\n1516 |             >> find(l, [2, 3])\n1517 |             2\n1518 |             >> find(l, [2, 3], first=0)\n1519 |             7\n1520 |             >> find(l, [2, 4])\n1521 |             None\n1522 | \n1523 |             \"\"\"\n1524 |             if not sub or not l or len(sub) > len(l):\n1525 |                 return None\n1526 |             n = len(sub)\n1527 |             if not first:\n1528 |                 l.reverse()\n1529 |                 sub.reverse()\n1530 |             for i in range(len(l) - n + 1):\n1531 |                 if all(l[i + j] == sub[j] for j in range(n)):\n1532 |                     break\n1533 |             else:\n1534 |                 i = None\n1535 |             if not first:\n1536 |                 l.reverse()\n1537 |                 sub.reverse()\n1538 |             if i is not None and not first:\n1539 |                 i = len(l) - (i + n)\n1540 |             return i\n1541 | \n1542 |         co = []\n1543 |         args = Add.make_args(self)\n1544 |         self_c = self.is_commutative\n1545 |         x_c = x.is_commutative\n1546 |         if self_c and not x_c:\n1547 |             return S.Zero\n1548 |         if _first and self.is_Add and not self_c and not x_c:\n1549 |             # get the part that depends on x exactly\n1550 |             xargs = Mul.make_args(x)\n1551 |             d = Add(*[i for i in Add.make_args(self.as_independent(x)[1])\n1552 |                 if all(xi in Mul.make_args(i) for xi in xargs)])\n1553 |             rv = d.coeff(x, right=right, _first=False)\n1554 |             if not rv.is_Add or not right:\n1555 |                 return rv\n1556 |             c_part, nc_part = zip(*[i.args_cnc() for i in rv.args])\n1557 |             if has_variety(c_part):\n1558 |                 return rv\n1559 |             return Add(*[Mul._from_args(i) for i in nc_part])\n1560 | \n1561 |         one_c = self_c or x_c\n1562 |         xargs, nx = x.args_cnc(cset=True, warn=bool(not x_c))\n1563 |         # find the parts that pass the commutative terms\n1564 |         for a in args:\n1565 |             margs, nc = a.args_cnc(cset=True, warn=bool(not self_c))\n1566 |             if nc is None:\n1567 |                 nc = []\n1568 |             if len(xargs) > len(margs):\n1569 |                 continue\n1570 |             resid = margs.difference(xargs)\n1571 |             if len(resid) + len(xargs) == len(margs):\n1572 |                 if one_c:\n1573 |                     co.append(Mul(*(list(resid) + nc)))\n1574 |                 else:\n1575 |                     co.append((resid, nc))\n1576 |         if one_c:\n1577 |             if co == []:\n1578 |                 return S.Zero\n1579 |             elif co:\n1580 |                 return Add(*co)\n1581 |         else:  # both nc\n1582 |             # now check the non-comm parts\n1583 |             if not co:\n1584 |                 return S.Zero\n1585 |             if all(n == co[0][1] for r, n in co):\n1586 |                 ii = find(co[0][1], nx, right)\n1587 |                 if ii is not None:\n1588 |                     if not right:\n1589 |                         return Mul(Add(*[Mul(*r) for r, c in co]), Mul(*co[0][1][:ii]))\n1590 |                     else:\n1591 |                         return Mul(*co[0][1][ii + len(nx):])\n1592 |             beg = reduce(incommon, (n[1] for n in co))\n1593 |             if beg:\n1594 |                 ii = find(beg, nx, right)\n1595 |                 if ii is not None:\n1596 |                     if not right:\n1597 |                         gcdc = co[0][0]\n1598 |                         for i in range(1, len(co)):\n1599 |                             gcdc = gcdc.intersection(co[i][0])\n1600 |                             if not gcdc:\n1601 |                                 break\n1602 |                         return Mul(*(list(gcdc) + beg[:ii]))\n1603 |                     else:\n1604 |                         m = ii + len(nx)\n1605 |                         return Add(*[Mul(*(list(r) + n[m:])) for r, n in co])\n1606 |             end = list(reversed(\n1607 |                 reduce(incommon, (list(reversed(n[1])) for n in co))))\n1608 |             if end:\n1609 |                 ii = find(end, nx, right)\n1610 |                 if ii is not None:\n1611 |                     if not right:\n1612 |                         return Add(*[Mul(*(list(r) + n[:-len(end) + ii])) for r, n in co])\n1613 |                     else:\n1614 |                         return Mul(*end[ii + len(nx):])\n1615 |             # look for single match\n1616 |             hit = None\n1617 |             for i, (r, n) in enumerate(co):\n1618 |                 ii = find(n, nx, right)\n1619 |                 if ii is not None:\n1620 |                     if not hit:\n1621 |                         hit = ii, r, n\n1622 |                     else:\n1623 |                         break\n1624 |             else:\n1625 |                 if hit:\n1626 |                     ii, r, n = hit\n1627 |                     if not right:\n1628 |                         return Mul(*(list(r) + n[:ii]))\n1629 |                     else:\n1630 |                         return Mul(*n[ii + len(nx):])\n1631 | \n1632 |             return S.Zero\n1633 | \n1634 |     def as_expr(self, *gens):\n1635 |         \"\"\"\n1636 |         Convert a polynomial to a SymPy expression.\n1637 | \n1638 |         Examples\n1639 |         ========\n1640 | \n1641 |         >>> from sympy import sin\n1642 |         >>> from sympy.abc import x, y\n1643 | \n1644 |         >>> f = (x**2 + x*y).as_poly(x, y)\n1645 |         >>> f.as_expr()\n1646 |         x**2 + x*y\n1647 | \n1648 |         >>> sin(x).as_expr()\n1649 |         sin(x)\n1650 | \n1651 |         \"\"\"\n1652 |         return self\n1653 | \n1654 |     def as_coefficient(self, expr: Expr) -> Expr | None:\n1655 |         \"\"\"\n1656 |         Extracts symbolic coefficient at the given expression. In\n1657 |         other words, this functions separates 'self' into the product\n1658 |         of 'expr' and 'expr'-free coefficient. If such separation\n1659 |         is not possible it will return None.\n1660 | \n1661 |         Examples\n1662 |         ========\n1663 | \n1664 |         >>> from sympy import E, pi, sin, I, Poly\n1665 |         >>> from sympy.abc import x\n1666 | \n1667 |         >>> E.as_coefficient(E)\n1668 |         1\n1669 |         >>> (2*E).as_coefficient(E)\n1670 |         2\n1671 |         >>> (2*sin(E)*E).as_coefficient(E)\n1672 | \n1673 |         Two terms have E in them so a sum is returned. (If one were\n1674 |         desiring the coefficient of the term exactly matching E then\n1675 |         the constant from the returned expression could be selected.\n1676 |         Or, for greater precision, a method of Poly can be used to\n1677 |         indicate the desired term from which the coefficient is\n1678 |         desired.)\n1679 | \n1680 |         >>> (2*E + x*E).as_coefficient(E)\n1681 |         x + 2\n1682 |         >>> _.args[0]  # just want the exact match\n1683 |         2\n1684 |         >>> p = Poly(2*E + x*E); p\n1685 |         Poly(x*E + 2*E, x, E, domain='ZZ')\n1686 |         >>> p.coeff_monomial(E)\n1687 |         2\n1688 |         >>> p.nth(0, 1)\n1689 |         2\n1690 | \n1691 |         Since the following cannot be written as a product containing\n1692 |         E as a factor, None is returned. (If the coefficient ``2*x`` is\n1693 |         desired then the ``coeff`` method should be used.)\n1694 | \n1695 |         >>> (2*E*x + x).as_coefficient(E)\n1696 |         >>> (2*E*x + x).coeff(E)\n1697 |         2*x\n1698 | \n1699 |         >>> (E*(x + 1) + x).as_coefficient(E)\n1700 | \n1701 |         >>> (2*pi*I).as_coefficient(pi*I)\n1702 |         2\n1703 |         >>> (2*I).as_coefficient(pi*I)\n1704 | \n1705 |         See Also\n1706 |         ========\n1707 | \n1708 |         coeff: return sum of terms have a given factor\n1709 |         as_coeff_Add: separate the additive constant from an expression\n1710 |         as_coeff_Mul: separate the multiplicative constant from an expression\n1711 |         as_independent: separate x-dependent terms/factors from others\n1712 |         sympy.polys.polytools.Poly.coeff_monomial: efficiently find the single coefficient of a monomial in Poly\n1713 |         sympy.polys.polytools.Poly.nth: like coeff_monomial but powers of monomial terms are used\n1714 | \n1715 | \n1716 |         \"\"\"\n1717 | \n1718 |         r = self.extract_multiplicatively(expr)\n1719 |         if r and not r.has(expr):\n1720 |             return r\n1721 |         else:\n1722 |             return None\n1723 | \n1724 |     def as_independent(self, *deps, **hint) -> tuple[Expr, Expr]:\n1725 |         \"\"\"\n1726 |         A mostly naive separation of a Mul or Add into arguments that are not\n1727 |         are dependent on deps. To obtain as complete a separation of variables\n1728 |         as possible, use a separation method first, e.g.:\n1729 | \n1730 |         * separatevars() to change Mul, Add and Pow (including exp) into Mul\n1731 |         * .expand(mul=True) to change Add or Mul into Add\n1732 |         * .expand(log=True) to change log expr into an Add\n1733 | \n1734 |         The only non-naive thing that is done here is to respect noncommutative\n1735 |         ordering of variables and to always return (0, 0) for `self` of zero\n1736 |         regardless of hints.\n1737 | \n1738 |         For nonzero `self`, the returned tuple (i, d) has the\n1739 |         following interpretation:\n1740 | \n1741 |         * i will has no variable that appears in deps\n1742 |         * d will either have terms that contain variables that are in deps, or\n1743 |           be equal to 0 (when self is an Add) or 1 (when self is a Mul)\n1744 |         * if self is an Add then self = i + d\n1745 |         * if self is a Mul then self = i*d\n1746 |         * otherwise (self, S.One) or (S.One, self) is returned.\n1747 | \n1748 |         To force the expression to be treated as an Add, use the hint as_Add=True\n1749 | \n1750 |         Examples\n1751 |         ========\n1752 | \n1753 |         -- self is an Add\n1754 | \n1755 |         >>> from sympy import sin, cos, exp\n1756 |         >>> from sympy.abc import x, y, z\n1757 | \n1758 |         >>> (x + x*y).as_independent(x)\n1759 |         (0, x*y + x)\n1760 |         >>> (x + x*y).as_independent(y)\n1761 |         (x, x*y)\n1762 |         >>> (2*x*sin(x) + y + x + z).as_independent(x)\n1763 |         (y + z, 2*x*sin(x) + x)\n1764 |         >>> (2*x*sin(x) + y + x + z).as_independent(x, y)\n1765 |         (z, 2*x*sin(x) + x + y)\n1766 | \n1767 |         -- self is a Mul\n1768 | \n1769 |         >>> (x*sin(x)*cos(y)).as_independent(x)\n1770 |         (cos(y), x*sin(x))\n1771 | \n1772 |         non-commutative terms cannot always be separated out when self is a Mul\n1773 | \n1774 |         >>> from sympy import symbols\n1775 |         >>> n1, n2, n3 = symbols('n1 n2 n3', commutative=False)\n1776 |         >>> (n1 + n1*n2).as_independent(n2)\n1777 |         (n1, n1*n2)\n1778 |         >>> (n2*n1 + n1*n2).as_independent(n2)\n1779 |         (0, n1*n2 + n2*n1)\n1780 |         >>> (n1*n2*n3).as_independent(n1)\n1781 |         (1, n1*n2*n3)\n1782 |         >>> (n1*n2*n3).as_independent(n2)\n1783 |         (n1, n2*n3)\n1784 |         >>> ((x-n1)*(x-y)).as_independent(x)\n1785 |         (1, (x - y)*(x - n1))\n1786 | \n1787 |         -- self is anything else:\n1788 | \n1789 |         >>> (sin(x)).as_independent(x)\n1790 |         (1, sin(x))\n1791 |         >>> (sin(x)).as_independent(y)\n1792 |         (sin(x), 1)\n1793 |         >>> exp(x+y).as_independent(x)\n1794 |         (1, exp(x + y))\n1795 | \n1796 |         -- force self to be treated as an Add:\n1797 | \n1798 |         >>> (3*x).as_independent(x, as_Add=True)\n1799 |         (0, 3*x)\n1800 | \n1801 |         -- force self to be treated as a Mul:\n1802 | \n1803 |         >>> (3+x).as_independent(x, as_Add=False)\n1804 |         (1, x + 3)\n1805 |         >>> (-3+x).as_independent(x, as_Add=False)\n1806 |         (1, x - 3)\n1807 | \n1808 |         Note how the below differs from the above in making the\n1809 |         constant on the dep term positive.\n1810 | \n1811 |         >>> (y*(-3+x)).as_independent(x)\n1812 |         (y, x - 3)\n1813 | \n1814 |         -- use .as_independent() for true independence testing instead\n1815 |            of .has(). The former considers only symbols in the free\n1816 |            symbols while the latter considers all symbols\n1817 | \n1818 |         >>> from sympy import Integral\n1819 |         >>> I = Integral(x, (x, 1, 2))\n1820 |         >>> I.has(x)\n1821 |         True\n1822 |         >>> x in I.free_symbols\n1823 |         False\n1824 |         >>> I.as_independent(x) == (I, 1)\n1825 |         True\n1826 |         >>> (I + x).as_independent(x) == (I, x)\n1827 |         True\n1828 | \n1829 |         Note: when trying to get independent terms, a separation method\n1830 |         might need to be used first. In this case, it is important to keep\n1831 |         track of what you send to this routine so you know how to interpret\n1832 |         the returned values\n1833 | \n1834 |         >>> from sympy import separatevars, log\n1835 |         >>> separatevars(exp(x+y)).as_independent(x)\n1836 |         (exp(y), exp(x))\n1837 |         >>> (x + x*y).as_independent(y)\n1838 |         (x, x*y)\n1839 |         >>> separatevars(x + x*y).as_independent(y)\n1840 |         (x, y + 1)\n1841 |         >>> (x*(1 + y)).as_independent(y)\n1842 |         (x, y + 1)\n1843 |         >>> (x*(1 + y)).expand(mul=True).as_independent(y)\n1844 |         (x, x*y)\n1845 |         >>> a, b=symbols('a b', positive=True)\n1846 |         >>> (log(a*b).expand(log=True)).as_independent(b)\n1847 |         (log(a), log(b))\n1848 | \n1849 |         See Also\n1850 |         ========\n1851 | \n1852 |         separatevars\n1853 |         expand_log\n1854 |         sympy.core.add.Add.as_two_terms\n1855 |         sympy.core.mul.Mul.as_two_terms\n1856 |         as_coeff_mul\n1857 |         \"\"\"\n1858 |         from .symbol import Symbol\n1859 |         from .add import _unevaluated_Add\n1860 |         from .mul import _unevaluated_Mul\n1861 | \n1862 |         if self is S.Zero:\n1863 |             return (self, self)\n1864 | \n1865 |         func = self.func\n1866 |         if hint.get('as_Add', isinstance(self, Add) ):\n1867 |             want = Add\n1868 |         else:\n1869 |             want = Mul\n1870 | \n1871 |         # sift out deps into symbolic and other and ignore\n1872 |         # all symbols but those that are in the free symbols\n1873 |         sym = set()\n1874 |         other = []\n1875 |         for d in deps:\n1876 |             if isinstance(d, Symbol):  # Symbol.is_Symbol is True\n1877 |                 sym.add(d)\n1878 |             else:\n1879 |                 other.append(d)\n1880 | \n1881 |         def has(e):\n1882 |             \"\"\"return the standard has() if there are no literal symbols, else\n1883 |             check to see that symbol-deps are in the free symbols.\"\"\"\n1884 |             has_other = e.has(*other)\n1885 |             if not sym:\n1886 |                 return has_other\n1887 |             return has_other or e.has(*(e.free_symbols & sym))\n1888 | \n1889 |         if (want is not func or\n1890 |                 func is not Add and func is not Mul):\n1891 |             if has(self):\n1892 |                 return (want.identity, self)\n1893 |             else:\n1894 |                 return (self, want.identity)\n1895 |         else:\n1896 |             if func is Add:\n1897 |                 args = list(self.args)\n1898 |             else:\n1899 |                 args, nc = self.args_cnc()\n1900 | \n1901 |         d = sift(args, has)\n1902 |         depend = d[True]\n1903 |         indep = d[False]\n1904 |         if func is Add:  # all terms were treated as commutative\n1905 |             return (Add(*indep), _unevaluated_Add(*depend))\n1906 |         else:  # handle noncommutative by stopping at first dependent term\n1907 |             for i, n in enumerate(nc):\n1908 |                 if has(n):\n1909 |                     depend.extend(nc[i:])\n1910 |                     break\n1911 |                 indep.append(n)\n1912 |             return Mul(*indep), _unevaluated_Mul(*depend)\n1913 | \n1914 |     def as_real_imag(self, deep=True, **hints) -> tuple[Expr, Expr]:\n1915 |         \"\"\"Performs complex expansion on 'self' and returns a tuple\n1916 |            containing collected both real and imaginary parts. This\n1917 |            method cannot be confused with re() and im() functions,\n1918 |            which does not perform complex expansion at evaluation.\n1919 | \n1920 |            However it is possible to expand both re() and im()\n1921 |            functions and get exactly the same results as with\n1922 |            a single call to this function.\n1923 | \n1924 |            >>> from sympy import symbols, I\n1925 | \n1926 |            >>> x, y = symbols('x,y', real=True)\n1927 | \n1928 |            >>> (x + y*I).as_real_imag()\n1929 |            (x, y)\n1930 | \n1931 |            >>> from sympy.abc import z, w\n1932 | \n1933 |            >>> (z + w*I).as_real_imag()\n1934 |            (re(z) - im(w), re(w) + im(z))\n1935 | \n1936 |         \"\"\"\n1937 |         if hints.get('ignore') == self:\n1938 |             return None  # type: ignore\n1939 |         else:\n1940 |             from sympy.functions.elementary.complexes import im, re\n1941 |             return (re(self), im(self))\n1942 | \n1943 |     def as_powers_dict(self):\n1944 |         \"\"\"Return self as a dictionary of factors with each factor being\n1945 |         treated as a power. The keys are the bases of the factors and the\n1946 |         values, the corresponding exponents. The resulting dictionary should\n1947 |         be used with caution if the expression is a Mul and contains non-\n1948 |         commutative factors since the order that they appeared will be lost in\n1949 |         the dictionary.\n1950 | \n1951 |         See Also\n1952 |         ========\n1953 |         as_ordered_factors: An alternative for noncommutative applications,\n1954 |                             returning an ordered list of factors.\n1955 |         args_cnc: Similar to as_ordered_factors, but guarantees separation\n1956 |                   of commutative and noncommutative factors.\n1957 |         \"\"\"\n1958 |         d = defaultdict(int)\n1959 |         d.update([self.as_base_exp()])\n1960 |         return d\n1961 | \n1962 |     def as_coefficients_dict(self, *syms):\n1963 |         \"\"\"Return a dictionary mapping terms to their Rational coefficient.\n1964 |         Since the dictionary is a defaultdict, inquiries about terms which\n1965 |         were not present will return a coefficient of 0.\n1966 | \n1967 |         If symbols ``syms`` are provided, any multiplicative terms\n1968 |         independent of them will be considered a coefficient and a\n1969 |         regular dictionary of syms-dependent generators as keys and\n1970 |         their corresponding coefficients as values will be returned.\n1971 | \n1972 |         Examples\n1973 |         ========\n1974 | \n1975 |         >>> from sympy.abc import a, x, y\n1976 |         >>> (3*x + a*x + 4).as_coefficients_dict()\n1977 |         {1: 4, x: 3, a*x: 1}\n1978 |         >>> _[a]\n1979 |         0\n1980 |         >>> (3*a*x).as_coefficients_dict()\n1981 |         {a*x: 3}\n1982 |         >>> (3*a*x).as_coefficients_dict(x)\n1983 |         {x: 3*a}\n1984 |         >>> (3*a*x).as_coefficients_dict(y)\n1985 |         {1: 3*a*x}\n1986 | \n1987 |         \"\"\"\n1988 |         d = defaultdict(list)\n1989 |         if not syms:\n1990 |             for ai in Add.make_args(self):\n1991 |                 c, m = ai.as_coeff_Mul()\n1992 |                 d[m].append(c)\n1993 |             for k, v in d.items():\n1994 |                 if len(v) == 1:\n1995 |                     d[k] = v[0]\n1996 |                 else:\n1997 |                     d[k] = Add(*v)\n1998 |         else:\n1999 |             ind, dep = self.as_independent(*syms, as_Add=True)\n2000 |             for i in Add.make_args(dep):\n2001 |                 if i.is_Mul:\n2002 |                     c, x = i.as_coeff_mul(*syms)\n2003 |                     if c is S.One:\n2004 |                         d[i].append(c)\n2005 |                     else:\n2006 |                         d[i._new_rawargs(*x)].append(c)\n2007 |                 elif i:\n2008 |                     d[i].append(S.One)\n2009 |             d = {k: Add(*d[k]) for k in d}\n2010 |             if ind is not S.Zero:\n2011 |                 d.update({S.One: ind})\n2012 |         di = defaultdict(int)\n2013 |         di.update(d)\n2014 |         return di\n2015 | \n2016 |     def as_base_exp(self) -> tuple[Expr, Expr]:\n2017 |         # a -> b ** e\n2018 |         return self, S.One\n2019 | \n2020 |     def as_coeff_mul(self, *deps, **kwargs) -> tuple[Expr, tuple[Expr, ...]]:\n2021 |         \"\"\"Return the tuple (c, args) where self is written as a Mul, ``m``.\n2022 | \n2023 |         c should be a Rational multiplied by any factors of the Mul that are\n2024 |         independent of deps.\n2025 | \n2026 |         args should be a tuple of all other factors of m; args is empty\n2027 |         if self is a Number or if self is independent of deps (when given).\n2028 | \n2029 |         This should be used when you do not know if self is a Mul or not but\n2030 |         you want to treat self as a Mul or if you want to process the\n2031 |         individual arguments of the tail of self as a Mul.\n2032 | \n2033 |         - if you know self is a Mul and want only the head, use self.args[0];\n2034 |         - if you do not want to process the arguments of the tail but need the\n2035 |           tail then use self.as_two_terms() which gives the head and tail;\n2036 |         - if you want to split self into an independent and dependent parts\n2037 |           use ``self.as_independent(*deps)``\n2038 | \n2039 |         >>> from sympy import S\n2040 |         >>> from sympy.abc import x, y\n2041 |         >>> (S(3)).as_coeff_mul()\n2042 |         (3, ())\n2043 |         >>> (3*x*y).as_coeff_mul()\n2044 |         (3, (x, y))\n2045 |         >>> (3*x*y).as_coeff_mul(x)\n2046 |         (3*y, (x,))\n2047 |         >>> (3*y).as_coeff_mul(x)\n2048 |         (3*y, ())\n2049 |         \"\"\"\n2050 |         if deps:\n2051 |             if not self.has(*deps):\n2052 |                 return self, ()\n2053 |         return S.One, (self,)\n2054 | \n2055 |     def as_coeff_add(self, *deps) -> tuple[Expr, tuple[Expr, ...]]:\n2056 |         \"\"\"Return the tuple (c, args) where self is written as an Add, ``a``.\n2057 | \n2058 |         c should be a Rational added to any terms of the Add that are\n2059 |         independent of deps.\n2060 | \n2061 |         args should be a tuple of all other terms of ``a``; args is empty\n2062 |         if self is a Number or if self is independent of deps (when given).\n2063 | \n2064 |         This should be used when you do not know if self is an Add or not but\n2065 |         you want to treat self as an Add or if you want to process the\n2066 |         individual arguments of the tail of self as an Add.\n2067 | \n2068 |         - if you know self is an Add and want only the head, use self.args[0];\n2069 |         - if you do not want to process the arguments of the tail but need the\n2070 |           tail then use self.as_two_terms() which gives the head and tail.\n2071 |         - if you want to split self into an independent and dependent parts\n2072 |           use ``self.as_independent(*deps)``\n2073 | \n2074 |         >>> from sympy import S\n2075 |         >>> from sympy.abc import x, y\n2076 |         >>> (S(3)).as_coeff_add()\n2077 |         (3, ())\n2078 |         >>> (3 + x).as_coeff_add()\n2079 |         (3, (x,))\n2080 |         >>> (3 + x + y).as_coeff_add(x)\n2081 |         (y + 3, (x,))\n2082 |         >>> (3 + y).as_coeff_add(x)\n2083 |         (y + 3, ())\n2084 | \n2085 |         \"\"\"\n2086 |         if deps:\n2087 |             if not self.has_free(*deps):\n2088 |                 return self, ()\n2089 |         return S.Zero, (self,)\n2090 | \n2091 |     def primitive(self) -> tuple[Number, Expr]:\n2092 |         \"\"\"Return the positive Rational that can be extracted non-recursively\n2093 |         from every term of self (i.e., self is treated like an Add). This is\n2094 |         like the as_coeff_Mul() method but primitive always extracts a positive\n2095 |         Rational (never a negative or a Float).\n2096 | \n2097 |         Examples\n2098 |         ========\n2099 | \n2100 |         >>> from sympy.abc import x\n2101 |         >>> (3*(x + 1)**2).primitive()\n2102 |         (3, (x + 1)**2)\n2103 |         >>> a = (6*x + 2); a.primitive()\n2104 |         (2, 3*x + 1)\n2105 |         >>> b = (x/2 + 3); b.primitive()\n2106 |         (1/2, x + 6)\n2107 |         >>> (a*b).primitive() == (1, a*b)\n2108 |         True\n2109 |         \"\"\"\n2110 |         if not self:\n2111 |             return S.One, S.Zero\n2112 |         c, r = self.as_coeff_Mul(rational=True)\n2113 |         if c.is_negative:\n2114 |             c, r = -c, -r\n2115 |         return c, r\n2116 | \n2117 |     def as_content_primitive(self, radical=False, clear=True):\n2118 |         \"\"\"This method should recursively remove a Rational from all arguments\n2119 |         and return that (content) and the new self (primitive). The content\n2120 |         should always be positive and ``Mul(*foo.as_content_primitive()) == foo``.\n2121 |         The primitive need not be in canonical form and should try to preserve\n2122 |         the underlying structure if possible (i.e. expand_mul should not be\n2123 |         applied to self).\n2124 | \n2125 |         Examples\n2126 |         ========\n2127 | \n2128 |         >>> from sympy import sqrt\n2129 |         >>> from sympy.abc import x, y, z\n2130 | \n2131 |         >>> eq = 2 + 2*x + 2*y*(3 + 3*y)\n2132 | \n2133 |         The as_content_primitive function is recursive and retains structure:\n2134 | \n2135 |         >>> eq.as_content_primitive()\n2136 |         (2, x + 3*y*(y + 1) + 1)\n2137 | \n2138 |         Integer powers will have Rationals extracted from the base:\n2139 | \n2140 |         >>> ((2 + 6*x)**2).as_content_primitive()\n2141 |         (4, (3*x + 1)**2)\n2142 |         >>> ((2 + 6*x)**(2*y)).as_content_primitive()\n2143 |         (1, (2*(3*x + 1))**(2*y))\n2144 | \n2145 |         Terms may end up joining once their as_content_primitives are added:\n2146 | \n2147 |         >>> ((5*(x*(1 + y)) + 2*x*(3 + 3*y))).as_content_primitive()\n2148 |         (11, x*(y + 1))\n2149 |         >>> ((3*(x*(1 + y)) + 2*x*(3 + 3*y))).as_content_primitive()\n2150 |         (9, x*(y + 1))\n2151 |         >>> ((3*(z*(1 + y)) + 2.0*x*(3 + 3*y))).as_content_primitive()\n2152 |         (1, 6.0*x*(y + 1) + 3*z*(y + 1))\n2153 |         >>> ((5*(x*(1 + y)) + 2*x*(3 + 3*y))**2).as_content_primitive()\n2154 |         (121, x**2*(y + 1)**2)\n2155 |         >>> ((x*(1 + y) + 0.4*x*(3 + 3*y))**2).as_content_primitive()\n2156 |         (1, 4.84*x**2*(y + 1)**2)\n2157 | \n2158 |         Radical content can also be factored out of the primitive:\n2159 | \n2160 |         >>> (2*sqrt(2) + 4*sqrt(10)).as_content_primitive(radical=True)\n2161 |         (2, sqrt(2)*(1 + 2*sqrt(5)))\n2162 | \n2163 |         If clear=False (default is True) then content will not be removed\n2164 |         from an Add if it can be distributed to leave one or more\n2165 |         terms with integer coefficients.\n2166 | \n2167 |         >>> (x/2 + y).as_content_primitive()\n2168 |         (1/2, x + 2*y)\n2169 |         >>> (x/2 + y).as_content_primitive(clear=False)\n2170 |         (1, x/2 + y)\n2171 |         \"\"\"\n2172 |         return S.One, self\n2173 | \n2174 |     def as_numer_denom(self) -> tuple[Expr, Expr]:\n2175 |         \"\"\"Return the numerator and the denominator of an expression.\n2176 | \n2177 |         expression -> a/b -> a, b\n2178 | \n2179 |         This is just a stub that should be defined by\n2180 |         an object's class methods to get anything else.\n2181 | \n2182 |         See Also\n2183 |         ========\n2184 | \n2185 |         normal: return ``a/b`` instead of ``(a, b)``\n2186 | \n2187 |         \"\"\"\n2188 |         return self, S.One\n2189 | \n2190 |     def normal(self):\n2191 |         \"\"\"Return the expression as a fraction.\n2192 | \n2193 |         expression -> a/b\n2194 | \n2195 |         See Also\n2196 |         ========\n2197 | \n2198 |         as_numer_denom: return ``(a, b)`` instead of ``a/b``\n2199 | \n2200 |         \"\"\"\n2201 |         from .mul import _unevaluated_Mul\n2202 |         n, d = self.as_numer_denom()\n2203 |         if d is S.One:\n2204 |             return n\n2205 |         if d.is_Number:\n2206 |             return _unevaluated_Mul(n, 1/d)\n2207 |         else:\n2208 |             return n/d\n2209 | \n2210 |     def extract_multiplicatively(self, c: Expr) -> Expr | None:\n2211 |         \"\"\"Return None if it's not possible to make self in the form\n2212 |            c * something in a nice way, i.e. preserving the properties\n2213 |            of arguments of self.\n2214 | \n2215 |            Examples\n2216 |            ========\n2217 | \n2218 |            >>> from sympy import symbols, Rational\n2219 | \n2220 |            >>> x, y = symbols('x,y', real=True)\n2221 | \n2222 |            >>> ((x*y)**3).extract_multiplicatively(x**2 * y)\n2223 |            x*y**2\n2224 | \n2225 |            >>> ((x*y)**3).extract_multiplicatively(x**4 * y)\n2226 | \n2227 |            >>> (2*x).extract_multiplicatively(2)\n2228 |            x\n2229 | \n2230 |            >>> (2*x).extract_multiplicatively(3)\n2231 | \n2232 |            >>> (Rational(1, 2)*x).extract_multiplicatively(3)\n2233 |            x/6\n2234 | \n2235 |         \"\"\"\n2236 |         from sympy.functions.elementary.exponential import exp\n2237 |         from .add import _unevaluated_Add\n2238 |         c = sympify(c)\n2239 |         if self is S.NaN:\n2240 |             return None\n2241 |         if c is S.One:\n2242 |             return self\n2243 |         elif c == self:\n2244 |             return S.One\n2245 | \n2246 |         if c.is_Add:\n2247 |             cc, pc = c.primitive()\n2248 |             if cc is not S.One:\n2249 |                 c = Mul(cc, pc, evaluate=False)\n2250 | \n2251 |         if c.is_Mul:\n2252 |             a, b = c.as_two_terms() # type: ignore\n2253 |             x = self.extract_multiplicatively(a)\n2254 |             if x is not None:\n2255 |                 return x.extract_multiplicatively(b)\n2256 |             else:\n2257 |                 return x\n2258 | \n2259 |         quotient = self / c\n2260 |         if self.is_Number:\n2261 |             if self is S.Infinity:\n2262 |                 if c.is_positive:\n2263 |                     return S.Infinity\n2264 |             elif self is S.NegativeInfinity:\n2265 |                 if c.is_negative:\n2266 |                     return S.Infinity\n2267 |                 elif c.is_positive:\n2268 |                     return S.NegativeInfinity\n2269 |             elif self is S.ComplexInfinity:\n2270 |                 if not c.is_zero:\n2271 |                     return S.ComplexInfinity\n2272 |             elif self.is_Integer:\n2273 |                 if not quotient.is_Integer:\n2274 |                     return None\n2275 |                 elif self.is_positive and quotient.is_negative:\n2276 |                     return None\n2277 |                 else:\n2278 |                     return quotient\n2279 |             elif self.is_Rational:\n2280 |                 if not quotient.is_Rational:\n2281 |                     return None\n2282 |                 elif self.is_positive and quotient.is_negative:\n2283 |                     return None\n2284 |                 else:\n2285 |                     return quotient\n2286 |             elif self.is_Float:\n2287 |                 if not quotient.is_Float:\n2288 |                     return None\n2289 |                 elif self.is_positive and quotient.is_negative:\n2290 |                     return None\n2291 |                 else:\n2292 |                     return quotient\n2293 |         elif self.is_NumberSymbol or self.is_Symbol or self is S.ImaginaryUnit:\n2294 |             if quotient.is_Mul and len(quotient.args) == 2:\n2295 |                 if quotient.args[0].is_Integer and quotient.args[0].is_positive and quotient.args[1] == self:\n2296 |                     return quotient\n2297 |             elif quotient.is_Integer and c.is_Number:\n2298 |                 return quotient\n2299 |         elif self.is_Add:\n2300 |             cs, ps = self.primitive()\n2301 |             # assert cs >= 1\n2302 |             if c.is_Number and c is not S.NegativeOne:\n2303 |                 # assert c != 1 (handled at top)\n2304 |                 if cs is not S.One:\n2305 |                     if c.is_negative:\n2306 |                         xc = cs.extract_multiplicatively(-c)\n2307 |                         if xc is not None:\n2308 |                             xc = -xc\n2309 |                     else:\n2310 |                         xc = cs.extract_multiplicatively(c)\n2311 |                     if xc is not None:\n2312 |                         return xc*ps  # rely on 2-arg Mul to restore Add\n2313 |                 return None # |c| != 1 can only be extracted from cs\n2314 |             if c == ps:\n2315 |                 return cs\n2316 |             # check args of ps\n2317 |             newargs = []\n2318 |             arg: Expr\n2319 |             for arg in ps.args: # type: ignore\n2320 |                 newarg = arg.extract_multiplicatively(c)\n2321 |                 if newarg is None:\n2322 |                     return None # all or nothing\n2323 |                 newargs.append(newarg)\n2324 |             if cs is not S.One:\n2325 |                 args = [cs*t for t in newargs]\n2326 |                 # args may be in different order\n2327 |                 return _unevaluated_Add(*args)\n2328 |             else:\n2329 |                 return Add._from_args(newargs)\n2330 |         elif self.is_Mul:\n2331 |             args: list[Expr] = list(self.args) # type: ignore\n2332 |             for i, arg in enumerate(args):\n2333 |                 newarg = arg.extract_multiplicatively(c)\n2334 |                 if newarg is not None:\n2335 |                     args[i] = newarg\n2336 |                     return Mul(*args)\n2337 |         elif self.is_Pow or isinstance(self, exp):\n2338 |             sb, se = self.as_base_exp()\n2339 |             cb, ce = c.as_base_exp()\n2340 |             if cb == sb:\n2341 |                 new_exp = se.extract_additively(ce)\n2342 |                 if new_exp is not None:\n2343 |                     return Pow(sb, new_exp)\n2344 |             elif c == sb:\n2345 |                 new_exp = se.extract_additively(1)\n2346 |                 if new_exp is not None:\n2347 |                     return Pow(sb, new_exp)\n2348 | \n2349 |         return None\n2350 | \n2351 |     def extract_additively(self, c):\n2352 |         \"\"\"Return self - c if it's possible to subtract c from self and\n2353 |         make all matching coefficients move towards zero, else return None.\n2354 | \n2355 |         Examples\n2356 |         ========\n2357 | \n2358 |         >>> from sympy.abc import x, y\n2359 |         >>> e = 2*x + 3\n2360 |         >>> e.extract_additively(x + 1)\n2361 |         x + 2\n2362 |         >>> e.extract_additively(3*x)\n2363 |         >>> e.extract_additively(4)\n2364 |         >>> (y*(x + 1)).extract_additively(x + 1)\n2365 |         >>> ((x + 1)*(x + 2*y + 1) + 3).extract_additively(x + 1)\n2366 |         (x + 1)*(x + 2*y) + 3\n2367 | \n2368 |         See Also\n2369 |         ========\n2370 |         extract_multiplicatively\n2371 |         coeff\n2372 |         as_coefficient\n2373 | \n2374 |         \"\"\"\n2375 | \n2376 |         c = sympify(c)\n2377 |         if self is S.NaN:\n2378 |             return None\n2379 |         if c.is_zero:\n2380 |             return self\n2381 |         elif c == self:\n2382 |             return S.Zero\n2383 |         elif self == S.Zero:\n2384 |             return None\n2385 | \n2386 |         if self.is_Number:\n2387 |             if not c.is_Number:\n2388 |                 return None\n2389 |             co = self\n2390 |             diff = co - c\n2391 |             # XXX should we match types? i.e should 3 - .1 succeed?\n2392 |             if (co > 0 and diff >= 0 and diff < co or\n2393 |                     co < 0 and diff <= 0 and diff > co):\n2394 |                 return diff\n2395 |             return None\n2396 | \n2397 |         if c.is_Number:\n2398 |             co, t = self.as_coeff_Add()\n2399 |             xa = co.extract_additively(c)\n2400 |             if xa is None:\n2401 |                 return None\n2402 |             return xa + t\n2403 | \n2404 |         # handle the args[0].is_Number case separately\n2405 |         # since we will have trouble looking for the coeff of\n2406 |         # a number.\n2407 |         if c.is_Add and c.args[0].is_Number:\n2408 |             # whole term as a term factor\n2409 |             co = self.coeff(c)\n2410 |             xa0 = (co.extract_additively(1) or 0)*c\n2411 |             if xa0:\n2412 |                 diff = self - co*c\n2413 |                 return (xa0 + (diff.extract_additively(c) or diff)) or None\n2414 |             # term-wise\n2415 |             h, t = c.as_coeff_Add()\n2416 |             sh, st = self.as_coeff_Add()\n2417 |             xa = sh.extract_additively(h)\n2418 |             if xa is None:\n2419 |                 return None\n2420 |             xa2 = st.extract_additively(t)\n2421 |             if xa2 is None:\n2422 |                 return None\n2423 |             return xa + xa2\n2424 | \n2425 |         # whole term as a term factor\n2426 |         co, diff = _corem(self, c)\n2427 |         xa0 = (co.extract_additively(1) or 0)*c\n2428 |         if xa0:\n2429 |             return (xa0 + (diff.extract_additively(c) or diff)) or None\n2430 |         # term-wise\n2431 |         coeffs = []\n2432 |         for a in Add.make_args(c):\n2433 |             ac, at = a.as_coeff_Mul()\n2434 |             co = self.coeff(at)\n2435 |             if not co:\n2436 |                 return None\n2437 |             coc, cot = co.as_coeff_Add()\n2438 |             xa = coc.extract_additively(ac)\n2439 |             if xa is None:\n2440 |                 return None\n2441 |             self -= co*at\n2442 |             coeffs.append((cot + xa)*at)\n2443 |         coeffs.append(self)\n2444 |         return Add(*coeffs)\n2445 | \n2446 |     @property\n2447 |     def expr_free_symbols(self):\n2448 |         \"\"\"\n2449 |         Like ``free_symbols``, but returns the free symbols only if\n2450 |         they are contained in an expression node.\n2451 | \n2452 |         Examples\n2453 |         ========\n2454 | \n2455 |         >>> from sympy.abc import x, y\n2456 |         >>> (x + y).expr_free_symbols # doctest: +SKIP\n2457 |         {x, y}\n2458 | \n2459 |         If the expression is contained in a non-expression object, do not return\n2460 |         the free symbols. Compare:\n2461 | \n2462 |         >>> from sympy import Tuple\n2463 |         >>> t = Tuple(x + y)\n2464 |         >>> t.expr_free_symbols # doctest: +SKIP\n2465 |         set()\n2466 |         >>> t.free_symbols\n2467 |         {x, y}\n2468 |         \"\"\"\n2469 |         sympy_deprecation_warning(\"\"\"\n2470 |         The expr_free_symbols property is deprecated. Use free_symbols to get\n2471 |         the free symbols of an expression.\n2472 |         \"\"\",\n2473 |             deprecated_since_version=\"1.9\",\n2474 |             active_deprecations_target=\"deprecated-expr-free-symbols\")\n2475 |         return {j for i in self.args for j in i.expr_free_symbols}\n2476 | \n2477 |     def could_extract_minus_sign(self) -> bool:\n2478 |         \"\"\"Return True if self has -1 as a leading factor or has\n2479 |         more literal negative signs than positive signs in a sum,\n2480 |         otherwise False.\n2481 | \n2482 |         Examples\n2483 |         ========\n2484 | \n2485 |         >>> from sympy.abc import x, y\n2486 |         >>> e = x - y\n2487 |         >>> {i.could_extract_minus_sign() for i in (e, -e)}\n2488 |         {False, True}\n2489 | \n2490 |         Though the ``y - x`` is considered like ``-(x - y)``, since it\n2491 |         is in a product without a leading factor of -1, the result is\n2492 |         false below:\n2493 | \n2494 |         >>> (x*(y - x)).could_extract_minus_sign()\n2495 |         False\n2496 | \n2497 |         To put something in canonical form wrt to sign, use `signsimp`:\n2498 | \n2499 |         >>> from sympy import signsimp\n2500 |         >>> signsimp(x*(y - x))\n2501 |         -x*(x - y)\n2502 |         >>> _.could_extract_minus_sign()\n2503 |         True\n2504 |         \"\"\"\n2505 |         return False\n2506 | \n2507 |     def extract_branch_factor(self, allow_half=False):\n2508 |         \"\"\"\n2509 |         Try to write self as ``exp_polar(2*pi*I*n)*z`` in a nice way.\n2510 |         Return (z, n).\n2511 | \n2512 |         >>> from sympy import exp_polar, I, pi\n2513 |         >>> from sympy.abc import x, y\n2514 |         >>> exp_polar(I*pi).extract_branch_factor()\n2515 |         (exp_polar(I*pi), 0)\n2516 |         >>> exp_polar(2*I*pi).extract_branch_factor()\n2517 |         (1, 1)\n2518 |         >>> exp_polar(-pi*I).extract_branch_factor()\n2519 |         (exp_polar(I*pi), -1)\n2520 |         >>> exp_polar(3*pi*I + x).extract_branch_factor()\n2521 |         (exp_polar(x + I*pi), 1)\n2522 |         >>> (y*exp_polar(-5*pi*I)*exp_polar(3*pi*I + 2*pi*x)).extract_branch_factor()\n2523 |         (y*exp_polar(2*pi*x), -1)\n2524 |         >>> exp_polar(-I*pi/2).extract_branch_factor()\n2525 |         (exp_polar(-I*pi/2), 0)\n2526 | \n2527 |         If allow_half is True, also extract exp_polar(I*pi):\n2528 | \n2529 |         >>> exp_polar(I*pi).extract_branch_factor(allow_half=True)\n2530 |         (1, 1/2)\n2531 |         >>> exp_polar(2*I*pi).extract_branch_factor(allow_half=True)\n2532 |         (1, 1)\n2533 |         >>> exp_polar(3*I*pi).extract_branch_factor(allow_half=True)\n2534 |         (1, 3/2)\n2535 |         >>> exp_polar(-I*pi).extract_branch_factor(allow_half=True)\n2536 |         (1, -1/2)\n2537 |         \"\"\"\n2538 |         from sympy.functions.elementary.exponential import exp_polar\n2539 |         from sympy.functions.elementary.integers import ceiling\n2540 | \n2541 |         n = S.Zero\n2542 |         res = S.One\n2543 |         args = Mul.make_args(self)\n2544 |         exps = []\n2545 |         for arg in args:\n2546 |             if isinstance(arg, exp_polar):\n2547 |                 exps += [arg.exp]\n2548 |             else:\n2549 |                 res *= arg\n2550 |         piimult = S.Zero\n2551 |         extras = []\n2552 | \n2553 |         ipi = S.Pi*S.ImaginaryUnit\n2554 |         while exps:\n2555 |             exp = exps.pop()\n2556 |             if exp.is_Add:\n2557 |                 exps += exp.args\n2558 |                 continue\n2559 |             if exp.is_Mul:\n2560 |                 coeff = exp.as_coefficient(ipi)\n2561 |                 if coeff is not None:\n2562 |                     piimult += coeff\n2563 |                     continue\n2564 |             extras += [exp]\n2565 |         if piimult.is_number:\n2566 |             coeff = piimult\n2567 |             tail = ()\n2568 |         else:\n2569 |             coeff, tail = piimult.as_coeff_add(*piimult.free_symbols)\n2570 |         # round down to nearest multiple of 2\n2571 |         branchfact = ceiling(coeff/2 - S.Half)*2\n2572 |         n += branchfact/2\n2573 |         c = coeff - branchfact\n2574 |         if allow_half:\n2575 |             nc = c.extract_additively(1)\n2576 |             if nc is not None:\n2577 |                 n += S.Half\n2578 |                 c = nc\n2579 |         newexp = ipi*Add(*((c, ) + tail)) + Add(*extras)\n2580 |         if newexp != 0:\n2581 |             res *= exp_polar(newexp)\n2582 |         return res, n\n2583 | \n2584 |     def is_polynomial(self, *syms):\n2585 |         r\"\"\"\n2586 |         Return True if self is a polynomial in syms and False otherwise.\n2587 | \n2588 |         This checks if self is an exact polynomial in syms.  This function\n2589 |         returns False for expressions that are \"polynomials\" with symbolic\n2590 |         exponents.  Thus, you should be able to apply polynomial algorithms to\n2591 |         expressions for which this returns True, and Poly(expr, \\*syms) should\n2592 |         work if and only if expr.is_polynomial(\\*syms) returns True. The\n2593 |         polynomial does not have to be in expanded form.  If no symbols are\n2594 |         given, all free symbols in the expression will be used.\n2595 | \n2596 |         This is not part of the assumptions system.  You cannot do\n2597 |         Symbol('z', polynomial=True).\n2598 | \n2599 |         Examples\n2600 |         ========\n2601 | \n2602 |         >>> from sympy import Symbol, Function\n2603 |         >>> x = Symbol('x')\n2604 |         >>> ((x**2 + 1)**4).is_polynomial(x)\n2605 |         True\n2606 |         >>> ((x**2 + 1)**4).is_polynomial()\n2607 |         True\n2608 |         >>> (2**x + 1).is_polynomial(x)\n2609 |         False\n2610 |         >>> (2**x + 1).is_polynomial(2**x)\n2611 |         True\n2612 |         >>> f = Function('f')\n2613 |         >>> (f(x) + 1).is_polynomial(x)\n2614 |         False\n2615 |         >>> (f(x) + 1).is_polynomial(f(x))\n2616 |         True\n2617 |         >>> (1/f(x) + 1).is_polynomial(f(x))\n2618 |         False\n2619 | \n2620 |         >>> n = Symbol('n', nonnegative=True, integer=True)\n2621 |         >>> (x**n + 1).is_polynomial(x)\n2622 |         False\n2623 | \n2624 |         This function does not attempt any nontrivial simplifications that may\n2625 |         result in an expression that does not appear to be a polynomial to\n2626 |         become one.\n2627 | \n2628 |         >>> from sympy import sqrt, factor, cancel\n2629 |         >>> y = Symbol('y', positive=True)\n2630 |         >>> a = sqrt(y**2 + 2*y + 1)\n2631 |         >>> a.is_polynomial(y)\n2632 |         False\n2633 |         >>> factor(a)\n2634 |         y + 1\n2635 |         >>> factor(a).is_polynomial(y)\n2636 |         True\n2637 | \n2638 |         >>> b = (y**2 + 2*y + 1)/(y + 1)\n2639 |         >>> b.is_polynomial(y)\n2640 |         False\n2641 |         >>> cancel(b)\n2642 |         y + 1\n2643 |         >>> cancel(b).is_polynomial(y)\n2644 |         True\n2645 | \n2646 |         See also .is_rational_function()\n2647 | \n2648 |         \"\"\"\n2649 |         if syms:\n2650 |             syms = set(map(sympify, syms))\n2651 |         else:\n2652 |             syms = self.free_symbols\n2653 |             if not syms:\n2654 |                 return True\n2655 | \n2656 |         return self._eval_is_polynomial(syms)\n2657 | \n2658 |     def _eval_is_polynomial(self, syms) -> bool | None:\n2659 |         if self in syms:\n2660 |             return True\n2661 |         if not self.has_free(*syms):\n2662 |             # constant polynomial\n2663 |             return True\n2664 |         # subclasses should return True or False\n2665 |         return None\n2666 | \n2667 |     def is_rational_function(self, *syms):\n2668 |         \"\"\"\n2669 |         Test whether function is a ratio of two polynomials in the given\n2670 |         symbols, syms. When syms is not given, all free symbols will be used.\n2671 |         The rational function does not have to be in expanded or in any kind of\n2672 |         canonical form.\n2673 | \n2674 |         This function returns False for expressions that are \"rational\n2675 |         functions\" with symbolic exponents.  Thus, you should be able to call\n2676 |         .as_numer_denom() and apply polynomial algorithms to the result for\n2677 |         expressions for which this returns True.\n2678 | \n2679 |         This is not part of the assumptions system.  You cannot do\n2680 |         Symbol('z', rational_function=True).\n2681 | \n2682 |         Examples\n2683 |         ========\n2684 | \n2685 |         >>> from sympy import Symbol, sin\n2686 |         >>> from sympy.abc import x, y\n2687 | \n2688 |         >>> (x/y).is_rational_function()\n2689 |         True\n2690 | \n2691 |         >>> (x**2).is_rational_function()\n2692 |         True\n2693 | \n2694 |         >>> (x/sin(y)).is_rational_function(y)\n2695 |         False\n2696 | \n2697 |         >>> n = Symbol('n', integer=True)\n2698 |         >>> (x**n + 1).is_rational_function(x)\n2699 |         False\n2700 | \n2701 |         This function does not attempt any nontrivial simplifications that may\n2702 |         result in an expression that does not appear to be a rational function\n2703 |         to become one.\n2704 | \n2705 |         >>> from sympy import sqrt, factor\n2706 |         >>> y = Symbol('y', positive=True)\n2707 |         >>> a = sqrt(y**2 + 2*y + 1)/y\n2708 |         >>> a.is_rational_function(y)\n2709 |         False\n2710 |         >>> factor(a)\n2711 |         (y + 1)/y\n2712 |         >>> factor(a).is_rational_function(y)\n2713 |         True\n2714 | \n2715 |         See also is_algebraic_expr().\n2716 | \n2717 |         \"\"\"\n2718 |         if syms:\n2719 |             syms = set(map(sympify, syms))\n2720 |         else:\n2721 |             syms = self.free_symbols\n2722 |             if not syms:\n2723 |                 return self not in _illegal\n2724 | \n2725 |         return self._eval_is_rational_function(syms)\n2726 | \n2727 |     def _eval_is_rational_function(self, syms) -> bool | None:\n2728 |         if self in syms:\n2729 |             return True\n2730 |         if not self.has_xfree(syms):\n2731 |             return True\n2732 |         # subclasses should return True or False\n2733 |         return None\n2734 | \n2735 |     def is_meromorphic(self, x, a):\n2736 |         \"\"\"\n2737 |         This tests whether an expression is meromorphic as\n2738 |         a function of the given symbol ``x`` at the point ``a``.\n2739 | \n2740 |         This method is intended as a quick test that will return\n2741 |         None if no decision can be made without simplification or\n2742 |         more detailed analysis.\n2743 | \n2744 |         Examples\n2745 |         ========\n2746 | \n2747 |         >>> from sympy import zoo, log, sin, sqrt\n2748 |         >>> from sympy.abc import x\n2749 | \n2750 |         >>> f = 1/x**2 + 1 - 2*x**3\n2751 |         >>> f.is_meromorphic(x, 0)\n2752 |         True\n2753 |         >>> f.is_meromorphic(x, 1)\n2754 |         True\n2755 |         >>> f.is_meromorphic(x, zoo)\n2756 |         True\n2757 | \n2758 |         >>> g = x**log(3)\n2759 |         >>> g.is_meromorphic(x, 0)\n2760 |         False\n2761 |         >>> g.is_meromorphic(x, 1)\n2762 |         True\n2763 |         >>> g.is_meromorphic(x, zoo)\n2764 |         False\n2765 | \n2766 |         >>> h = sin(1/x)*x**2\n2767 |         >>> h.is_meromorphic(x, 0)\n2768 |         False\n2769 |         >>> h.is_meromorphic(x, 1)\n2770 |         True\n2771 |         >>> h.is_meromorphic(x, zoo)\n2772 |         True\n2773 | \n2774 |         Multivalued functions are considered meromorphic when their\n2775 |         branches are meromorphic. Thus most functions are meromorphic\n2776 |         everywhere except at essential singularities and branch points.\n2777 |         In particular, they will be meromorphic also on branch cuts\n2778 |         except at their endpoints.\n2779 | \n2780 |         >>> log(x).is_meromorphic(x, -1)\n2781 |         True\n2782 |         >>> log(x).is_meromorphic(x, 0)\n2783 |         False\n2784 |         >>> sqrt(x).is_meromorphic(x, -1)\n2785 |         True\n2786 |         >>> sqrt(x).is_meromorphic(x, 0)\n2787 |         False\n2788 | \n2789 |         \"\"\"\n2790 |         if not x.is_symbol:\n2791 |             raise TypeError(\"{} should be of symbol type\".format(x))\n2792 |         a = sympify(a)\n2793 | \n2794 |         return self._eval_is_meromorphic(x, a)\n2795 | \n2796 |     def _eval_is_meromorphic(self, x, a) -> bool | None:\n2797 |         if self == x:\n2798 |             return True\n2799 |         if not self.has_free(x):\n2800 |             return True\n2801 |         # subclasses should return True or False\n2802 |         return None\n2803 | \n2804 |     def is_algebraic_expr(self, *syms):\n2805 |         \"\"\"\n2806 |         This tests whether a given expression is algebraic or not, in the\n2807 |         given symbols, syms. When syms is not given, all free symbols\n2808 |         will be used. The rational function does not have to be in expanded\n2809 |         or in any kind of canonical form.\n2810 | \n2811 |         This function returns False for expressions that are \"algebraic\n2812 |         expressions\" with symbolic exponents. This is a simple extension to the\n2813 |         is_rational_function, including rational exponentiation.\n2814 | \n2815 |         Examples\n2816 |         ========\n2817 | \n2818 |         >>> from sympy import Symbol, sqrt\n2819 |         >>> x = Symbol('x', real=True)\n2820 |         >>> sqrt(1 + x).is_rational_function()\n2821 |         False\n2822 |         >>> sqrt(1 + x).is_algebraic_expr()\n2823 |         True\n2824 | \n2825 |         This function does not attempt any nontrivial simplifications that may\n2826 |         result in an expression that does not appear to be an algebraic\n2827 |         expression to become one.\n2828 | \n2829 |         >>> from sympy import exp, factor\n2830 |         >>> a = sqrt(exp(x)**2 + 2*exp(x) + 1)/(exp(x) + 1)\n2831 |         >>> a.is_algebraic_expr(x)\n2832 |         False\n2833 |         >>> factor(a).is_algebraic_expr()\n2834 |         True\n2835 | \n2836 |         See Also\n2837 |         ========\n2838 | \n2839 |         is_rational_function\n2840 | \n2841 |         References\n2842 |         ==========\n2843 | \n2844 |         .. [1] https://en.wikipedia.org/wiki/Algebraic_expression\n2845 | \n2846 |         \"\"\"\n2847 |         if syms:\n2848 |             syms = set(map(sympify, syms))\n2849 |         else:\n2850 |             syms = self.free_symbols\n2851 |             if not syms:\n2852 |                 return True\n2853 | \n2854 |         return self._eval_is_algebraic_expr(syms)\n2855 | \n2856 |     def _eval_is_algebraic_expr(self, syms) -> bool | None:\n2857 |         if self in syms:\n2858 |             return True\n2859 |         if not self.has_free(*syms):\n2860 |             return True\n2861 |         # subclasses should return True or False\n2862 |         return None\n2863 | \n2864 |     ###################################################################################\n2865 |     ##################### SERIES, LEADING TERM, LIMIT, ORDER METHODS ##################\n2866 |     ###################################################################################\n2867 | \n2868 |     def series(self, x=None, x0=0, n=6, dir=\"+\", logx=None, cdir=0):\n2869 |         \"\"\"\n2870 |         Series expansion of \"self\" around ``x = x0`` yielding either terms of\n2871 |         the series one by one (the lazy series given when n=None), else\n2872 |         all the terms at once when n != None.\n2873 | \n2874 |         Returns the series expansion of \"self\" around the point ``x = x0``\n2875 |         with respect to ``x`` up to ``O((x - x0)**n, x, x0)`` (default n is 6).\n2876 | \n2877 |         If ``x=None`` and ``self`` is univariate, the univariate symbol will\n2878 |         be supplied, otherwise an error will be raised.\n2879 | \n2880 |         Parameters\n2881 |         ==========\n2882 | \n2883 |         expr : Expression\n2884 |                The expression whose series is to be expanded.\n2885 | \n2886 |         x : Symbol\n2887 |             It is the variable of the expression to be calculated.\n2888 | \n2889 |         x0 : Value\n2890 |              The value around which ``x`` is calculated. Can be any value\n2891 |              from ``-oo`` to ``oo``.\n2892 | \n2893 |         n : Value\n2894 |             The value used to represent the order in terms of ``x**n``,\n2895 |             up to which the series is to be expanded.\n2896 | \n2897 |         dir : String, optional\n2898 |               The series-expansion can be bi-directional. If ``dir=\"+\"``,\n2899 |               then (x->x0+). If ``dir=\"-\", then (x->x0-). For infinite\n2900 |               ``x0`` (``oo`` or ``-oo``), the ``dir`` argument is determined\n2901 |               from the direction of the infinity (i.e., ``dir=\"-\"`` for\n2902 |               ``oo``).\n2903 | \n2904 |         logx : optional\n2905 |                It is used to replace any log(x) in the returned series with a\n2906 |                symbolic value rather than evaluating the actual value.\n2907 | \n2908 |         cdir : optional\n2909 |                It stands for complex direction, and indicates the direction\n2910 |                from which the expansion needs to be evaluated.\n2911 | \n2912 |         Examples\n2913 |         ========\n2914 | \n2915 |         >>> from sympy import cos, exp, tan\n2916 |         >>> from sympy.abc import x, y\n2917 |         >>> cos(x).series()\n2918 |         1 - x**2/2 + x**4/24 + O(x**6)\n2919 |         >>> cos(x).series(n=4)\n2920 |         1 - x**2/2 + O(x**4)\n2921 |         >>> cos(x).series(x, x0=1, n=2)\n2922 |         cos(1) - (x - 1)*sin(1) + O((x - 1)**2, (x, 1))\n2923 |         >>> e = cos(x + exp(y))\n2924 |         >>> e.series(y, n=2)\n2925 |         cos(x + 1) - y*sin(x + 1) + O(y**2)\n2926 |         >>> e.series(x, n=2)\n2927 |         cos(exp(y)) - x*sin(exp(y)) + O(x**2)\n2928 | \n2929 |         If ``n=None`` then a generator of the series terms will be returned.\n2930 | \n2931 |         >>> term=cos(x).series(n=None)\n2932 |         >>> [next(term) for i in range(2)]\n2933 |         [1, -x**2/2]\n2934 | \n2935 |         For ``dir=+`` (default) the series is calculated from the right and\n2936 |         for ``dir=-`` the series from the left. For smooth functions this\n2937 |         flag will not alter the results.\n2938 | \n2939 |         >>> abs(x).series(dir=\"+\")\n2940 |         x\n2941 |         >>> abs(x).series(dir=\"-\")\n2942 |         -x\n2943 |         >>> f = tan(x)\n2944 |         >>> f.series(x, 2, 6, \"+\")\n2945 |         tan(2) + (1 + tan(2)**2)*(x - 2) + (x - 2)**2*(tan(2)**3 + tan(2)) +\n2946 |         (x - 2)**3*(1/3 + 4*tan(2)**2/3 + tan(2)**4) + (x - 2)**4*(tan(2)**5 +\n2947 |         5*tan(2)**3/3 + 2*tan(2)/3) + (x - 2)**5*(2/15 + 17*tan(2)**2/15 +\n2948 |         2*tan(2)**4 + tan(2)**6) + O((x - 2)**6, (x, 2))\n2949 | \n2950 |         >>> f.series(x, 2, 3, \"-\")\n2951 |         tan(2) + (2 - x)*(-tan(2)**2 - 1) + (2 - x)**2*(tan(2)**3 + tan(2))\n2952 |         + O((x - 2)**3, (x, 2))\n2953 | \n2954 |         For rational expressions this method may return original expression without the Order term.\n2955 |         >>> (1/x).series(x, n=8)\n2956 |         1/x\n2957 | \n2958 |         Returns\n2959 |         =======\n2960 | \n2961 |         Expr : Expression\n2962 |             Series expansion of the expression about x0\n2963 | \n2964 |         Raises\n2965 |         ======\n2966 | \n2967 |         TypeError\n2968 |             If \"n\" and \"x0\" are infinity objects\n2969 | \n2970 |         PoleError\n2971 |             If \"x0\" is an infinity object\n2972 | \n2973 |         \"\"\"\n2974 |         if x is None:\n2975 |             syms = self.free_symbols\n2976 |             if not syms:\n2977 |                 return self\n2978 |             elif len(syms) > 1:\n2979 |                 raise ValueError('x must be given for multivariate functions.')\n2980 |             x = syms.pop()\n2981 | \n2982 |         from .symbol import Dummy, Symbol\n2983 |         if isinstance(x, Symbol):\n2984 |             dep = x in self.free_symbols\n2985 |         else:\n2986 |             d = Dummy()\n2987 |             dep = d in self.xreplace({x: d}).free_symbols\n2988 |         if not dep:\n2989 |             if n is None:\n2990 |                 return (s for s in [self])\n2991 |             else:\n2992 |                 return self\n2993 | \n2994 |         if len(dir) != 1 or dir not in '+-':\n2995 |             raise ValueError(\"Dir must be '+' or '-'\")\n2996 | \n2997 |         if n is not None:\n2998 |             n = int(n)\n2999 |             if n < 0:\n3000 |                 raise ValueError(\"Number of terms should be nonnegative\")\n3001 | \n3002 |         x0 = sympify(x0)\n3003 |         cdir = sympify(cdir)\n3004 |         from sympy.functions.elementary.complexes import im, sign\n3005 | \n3006 |         if not cdir.is_zero:\n3007 |             if cdir.is_real:\n3008 |                 dir = '+' if cdir.is_positive else '-'\n3009 |             else:\n3010 |                 dir = '+' if im(cdir).is_positive else '-'\n3011 |         else:\n3012 |             if x0 and x0.is_infinite:\n3013 |                 cdir = sign(x0).simplify()\n3014 |             elif str(dir) == \"+\":\n3015 |                 cdir = S.One\n3016 |             elif str(dir) == \"-\":\n3017 |                 cdir = S.NegativeOne\n3018 |             elif cdir == S.Zero:\n3019 |                 cdir = S.One\n3020 | \n3021 |         cdir = cdir/abs(cdir)\n3022 | \n3023 |         if x0 and x0.is_infinite:\n3024 |             from .function import PoleError\n3025 |             try:\n3026 |                 s = self.subs(x, cdir/x).series(x, n=n, dir='+', cdir=1)\n3027 |                 if n is None:\n3028 |                     return (si.subs(x, cdir/x) for si in s)\n3029 |                 return s.subs(x, cdir/x)\n3030 |             except PoleError:\n3031 |                 s = self.subs(x, cdir*x).aseries(x, n=n)\n3032 |                 return s.subs(x, cdir*x)\n3033 | \n3034 |         # use rep to shift origin to x0 and change sign (if dir is negative)\n3035 |         # and undo the process with rep2\n3036 |         if x0 or cdir != 1:\n3037 |             s = self.subs({x: x0 + cdir*x}).series(x, x0=0, n=n, dir='+', logx=logx, cdir=1)\n3038 |             if n is None:  # lseries...\n3039 |                 return (si.subs({x: x/cdir - x0/cdir}) for si in s)\n3040 |             return s.subs({x: x/cdir - x0/cdir})\n3041 | \n3042 |         # from here on it's x0=0 and dir='+' handling\n3043 | \n3044 |         if x.is_positive is x.is_negative is None or x.is_Symbol is not True:\n3045 |             # replace x with an x that has a positive assumption\n3046 |             xpos = Dummy('x', positive=True)\n3047 |             rv = self.subs(x, xpos).series(xpos, x0, n, dir, logx=logx, cdir=cdir)\n3048 |             if n is None:\n3049 |                 return (s.subs(xpos, x) for s in rv)\n3050 |             else:\n3051 |                 return rv.subs(xpos, x)\n3052 | \n3053 |         from sympy.series.order import Order\n3054 |         if n is not None:  # nseries handling\n3055 |             s1 = self._eval_nseries(x, n=n, logx=logx, cdir=cdir)\n3056 |             o = s1.getO() or S.Zero\n3057 |             if o:\n3058 |                 # make sure the requested order is returned\n3059 |                 ngot = o.getn()\n3060 |                 if ngot > n:\n3061 |                     # leave o in its current form (e.g. with x*log(x)) so\n3062 |                     # it eats terms properly, then replace it below\n3063 |                     if n != 0:\n3064 |                         s1 += o.subs(x, x**Rational(n, ngot))\n3065 |                     else:\n3066 |                         s1 += Order(1, x)\n3067 |                 elif ngot < n:\n3068 |                     # increase the requested number of terms to get the desired\n3069 |                     # number keep increasing (up to 9) until the received order\n3070 |                     # is different than the original order and then predict how\n3071 |                     # many additional terms are needed\n3072 |                     from sympy.functions.elementary.integers import ceiling\n3073 |                     for more in range(1, 9):\n3074 |                         s1 = self._eval_nseries(x, n=n + more, logx=logx, cdir=cdir)\n3075 |                         newn = s1.getn()\n3076 |                         if newn != ngot:\n3077 |                             ndo = n + ceiling((n - ngot)*more/(newn - ngot))\n3078 |                             s1 = self._eval_nseries(x, n=ndo, logx=logx, cdir=cdir)\n3079 |                             while s1.getn() < n:\n3080 |                                 s1 = self._eval_nseries(x, n=ndo, logx=logx, cdir=cdir)\n3081 |                                 ndo += 1\n3082 |                             break\n3083 |                     else:\n3084 |                         raise ValueError('Could not calculate %s terms for %s'\n3085 |                                          % (str(n), self))\n3086 |                     s1 += Order(x**n, x)\n3087 |                 o = s1.getO()\n3088 |                 s1 = s1.removeO()\n3089 |             elif s1.has(Order):\n3090 |                 # asymptotic expansion\n3091 |                 return s1\n3092 |             else:\n3093 |                 o = Order(x**n, x)\n3094 |                 s1done = s1.doit()\n3095 |                 try:\n3096 |                     if (s1done + o).removeO() == s1done:\n3097 |                         o = S.Zero\n3098 |                 except NotImplementedError:\n3099 |                     return s1\n3100 | \n3101 |             try:\n3102 |                 from sympy.simplify.radsimp import collect\n3103 |                 return collect(s1, x) + o\n3104 |             except NotImplementedError:\n3105 |                 return s1 + o\n3106 | \n3107 |         else:  # lseries handling\n3108 |             def yield_lseries(s):\n3109 |                 \"\"\"Return terms of lseries one at a time.\"\"\"\n3110 |                 for si in s:\n3111 |                     if not si.is_Add:\n3112 |                         yield si\n3113 |                         continue\n3114 |                     # yield terms 1 at a time if possible\n3115 |                     # by increasing order until all the\n3116 |                     # terms have been returned\n3117 |                     yielded = 0\n3118 |                     o = Order(si, x)*x\n3119 |                     ndid = 0\n3120 |                     ndo = len(si.args)\n3121 |                     while 1:\n3122 |                         do = (si - yielded + o).removeO()\n3123 |                         o *= x\n3124 |                         if not do or do.is_Order:\n3125 |                             continue\n3126 |                         if do.is_Add:\n3127 |                             ndid += len(do.args)\n3128 |                         else:\n3129 |                             ndid += 1\n3130 |                         yield do\n3131 |                         if ndid == ndo:\n3132 |                             break\n3133 |                         yielded += do\n3134 | \n3135 |             return yield_lseries(self.removeO()._eval_lseries(x, logx=logx, cdir=cdir))\n3136 | \n3137 |     def aseries(self, x=None, n=6, bound=0, hir=False):\n3138 |         \"\"\"Asymptotic Series expansion of self.\n3139 |         This is equivalent to ``self.series(x, oo, n)``.\n3140 | \n3141 |         Parameters\n3142 |         ==========\n3143 | \n3144 |         self : Expression\n3145 |                The expression whose series is to be expanded.\n3146 | \n3147 |         x : Symbol\n3148 |             It is the variable of the expression to be calculated.\n3149 | \n3150 |         n : Value\n3151 |             The value used to represent the order in terms of ``x**n``,\n3152 |             up to which the series is to be expanded.\n3153 | \n3154 |         hir : Boolean\n3155 |               Set this parameter to be True to produce hierarchical series.\n3156 |               It stops the recursion at an early level and may provide nicer\n3157 |               and more useful results.\n3158 | \n3159 |         bound : Value, Integer\n3160 |                 Use the ``bound`` parameter to give limit on rewriting\n3161 |                 coefficients in its normalised form.\n3162 | \n3163 |         Examples\n3164 |         ========\n3165 | \n3166 |         >>> from sympy import sin, exp\n3167 |         >>> from sympy.abc import x\n3168 | \n3169 |         >>> e = sin(1/x + exp(-x)) - sin(1/x)\n3170 | \n3171 |         >>> e.aseries(x)\n3172 |         (1/(24*x**4) - 1/(2*x**2) + 1 + O(x**(-6), (x, oo)))*exp(-x)\n3173 | \n3174 |         >>> e.aseries(x, n=3, hir=True)\n3175 |         -exp(-2*x)*sin(1/x)/2 + exp(-x)*cos(1/x) + O(exp(-3*x), (x, oo))\n3176 | \n3177 |         >>> e = exp(exp(x)/(1 - 1/x))\n3178 | \n3179 |         >>> e.aseries(x)\n3180 |         exp(exp(x)/(1 - 1/x))\n3181 | \n3182 |         >>> e.aseries(x, bound=3) # doctest: +SKIP\n3183 |         exp(exp(x)/x**2)*exp(exp(x)/x)*exp(-exp(x) + exp(x)/(1 - 1/x) - exp(x)/x - exp(x)/x**2)*exp(exp(x))\n3184 | \n3185 |         For rational expressions this method may return original expression without the Order term.\n3186 |         >>> (1/x).aseries(x, n=8)\n3187 |         1/x\n3188 | \n3189 |         Returns\n3190 |         =======\n3191 | \n3192 |         Expr\n3193 |             Asymptotic series expansion of the expression.\n3194 | \n3195 |         Notes\n3196 |         =====\n3197 | \n3198 |         This algorithm is directly induced from the limit computational algorithm provided by Gruntz.\n3199 |         It majorly uses the mrv and rewrite sub-routines. The overall idea of this algorithm is first\n3200 |         to look for the most rapidly varying subexpression w of a given expression f and then expands f\n3201 |         in a series in w. Then same thing is recursively done on the leading coefficient\n3202 |         till we get constant coefficients.\n3203 | \n3204 |         If the most rapidly varying subexpression of a given expression f is f itself,\n3205 |         the algorithm tries to find a normalised representation of the mrv set and rewrites f\n3206 |         using this normalised representation.\n3207 | \n3208 |         If the expansion contains an order term, it will be either ``O(x ** (-n))`` or ``O(w ** (-n))``\n3209 |         where ``w`` belongs to the most rapidly varying expression of ``self``.\n3210 | \n3211 |         References\n3212 |         ==========\n3213 | \n3214 |         .. [1] Gruntz, Dominik. A new algorithm for computing asymptotic series.\n3215 |                In: Proc. 1993 Int. Symp. Symbolic and Algebraic Computation. 1993.\n3216 |                pp. 239-244.\n3217 |         .. [2] Gruntz thesis - p90\n3218 |         .. [3] https://en.wikipedia.org/wiki/Asymptotic_expansion\n3219 | \n3220 |         See Also\n3221 |         ========\n3222 | \n3223 |         Expr.aseries: See the docstring of this function for complete details of this wrapper.\n3224 |         \"\"\"\n3225 | \n3226 |         from .symbol import Dummy\n3227 | \n3228 |         if x.is_positive is x.is_negative is None:\n3229 |             xpos = Dummy('x', positive=True)\n3230 |             return self.subs(x, xpos).aseries(xpos, n, bound, hir).subs(xpos, x)\n3231 | \n3232 |         from .function import PoleError\n3233 |         from sympy.series.gruntz import mrv, rewrite\n3234 | \n3235 |         try:\n3236 |             om, exps = mrv(self, x)\n3237 |         except PoleError:\n3238 |             return self\n3239 | \n3240 |         # We move one level up by replacing `x` by `exp(x)`, and then\n3241 |         # computing the asymptotic series for f(exp(x)). Then asymptotic series\n3242 |         # can be obtained by moving one-step back, by replacing x by ln(x).\n3243 | \n3244 |         from sympy.functions.elementary.exponential import exp, log\n3245 |         from sympy.series.order import Order\n3246 | \n3247 |         if x in om:\n3248 |             s = self.subs(x, exp(x)).aseries(x, n, bound, hir).subs(x, log(x))\n3249 |             if s.getO():\n3250 |                 return s + Order(1/x**n, (x, S.Infinity))\n3251 |             return s\n3252 | \n3253 |         k = Dummy('k', positive=True)\n3254 |         # f is rewritten in terms of omega\n3255 |         func, logw = rewrite(exps, om, x, k)\n3256 | \n3257 |         if self in om:\n3258 |             if bound <= 0:\n3259 |                 return self\n3260 |             s = (self.exp).aseries(x, n, bound=bound)\n3261 |             s = s.func(*[t.removeO() for t in s.args])\n3262 |             try:\n3263 |                 res = exp(s.subs(x, 1/x).as_leading_term(x).subs(x, 1/x))\n3264 |             except PoleError:\n3265 |                 res = self\n3266 | \n3267 |             func = exp(self.args[0] - res.args[0]) / k\n3268 |             logw = log(1/res)\n3269 | \n3270 |         s = func.series(k, 0, n)\n3271 |         from sympy.core.function import expand_mul\n3272 |         s = expand_mul(s)\n3273 |         # Hierarchical series\n3274 |         if hir:\n3275 |             return s.subs(k, exp(logw))\n3276 | \n3277 |         o = s.getO()\n3278 |         terms = sorted(Add.make_args(s.removeO()), key=lambda i: int(i.as_coeff_exponent(k)[1]))\n3279 |         s = S.Zero\n3280 |         has_ord = False\n3281 | \n3282 |         # Then we recursively expand these coefficients one by one into\n3283 |         # their asymptotic series in terms of their most rapidly varying subexpressions.\n3284 |         for t in terms:\n3285 |             coeff, expo = t.as_coeff_exponent(k)\n3286 |             if coeff.has(x):\n3287 |                 # Recursive step\n3288 |                 snew = coeff.aseries(x, n, bound=bound-1)\n3289 |                 if has_ord and snew.getO():\n3290 |                     break\n3291 |                 elif snew.getO():\n3292 |                     has_ord = True\n3293 |                 s += (snew * k**expo)\n3294 |             else:\n3295 |                 s += t\n3296 | \n3297 |         if not o or has_ord:\n3298 |             return s.subs(k, exp(logw))\n3299 |         return (s + o).subs(k, exp(logw))\n3300 | \n3301 | \n3302 |     def taylor_term(self, n, x, *previous_terms):\n3303 |         \"\"\"General method for the taylor term.\n3304 | \n3305 |         This method is slow, because it differentiates n-times. Subclasses can\n3306 |         redefine it to make it faster by using the \"previous_terms\".\n3307 |         \"\"\"\n3308 |         from .symbol import Dummy\n3309 |         from sympy.functions.combinatorial.factorials import factorial\n3310 | \n3311 |         x = sympify(x)\n3312 |         _x = Dummy('x')\n3313 |         return self.subs(x, _x).diff(_x, n).subs(_x, x).subs(x, 0) * x**n / factorial(n)\n3314 | \n3315 |     def lseries(self, x=None, x0=0, dir='+', logx=None, cdir=0):\n3316 |         \"\"\"\n3317 |         Wrapper for series yielding an iterator of the terms of the series.\n3318 | \n3319 |         Note: an infinite series will yield an infinite iterator. The following,\n3320 |         for exaxmple, will never terminate. It will just keep printing terms\n3321 |         of the sin(x) series::\n3322 | \n3323 |           for term in sin(x).lseries(x):\n3324 |               print term\n3325 | \n3326 |         The advantage of lseries() over nseries() is that many times you are\n3327 |         just interested in the next term in the series (i.e. the first term for\n3328 |         example), but you do not know how many you should ask for in nseries()\n3329 |         using the \"n\" parameter.\n3330 | \n3331 |         See also nseries().\n3332 |         \"\"\"\n3333 |         return self.series(x, x0, n=None, dir=dir, logx=logx, cdir=cdir)\n3334 | \n3335 |     def _eval_lseries(self, x, logx=None, cdir=0):\n3336 |         # default implementation of lseries is using nseries(), and adaptively\n3337 |         # increasing the \"n\". As you can see, it is not very efficient, because\n3338 |         # we are calculating the series over and over again. Subclasses should\n3339 |         # override this method and implement much more efficient yielding of\n3340 |         # terms.\n3341 |         n = 0\n3342 |         series = self._eval_nseries(x, n=n, logx=logx, cdir=cdir)\n3343 | \n3344 |         while series.is_Order:\n3345 |             n += 1\n3346 |             series = self._eval_nseries(x, n=n, logx=logx, cdir=cdir)\n3347 | \n3348 |         e = series.removeO()\n3349 |         yield e\n3350 |         if e is S.Zero:\n3351 |             return\n3352 | \n3353 |         while 1:\n3354 |             while 1:\n3355 |                 n += 1\n3356 |                 series = self._eval_nseries(x, n=n, logx=logx, cdir=cdir).removeO()\n3357 |                 if e != series:\n3358 |                     break\n3359 |                 if (series - self).cancel() is S.Zero:\n3360 |                     return\n3361 |             yield series - e\n3362 |             e = series\n3363 | \n3364 |     def nseries(self, x=None, x0=0, n=6, dir='+', logx=None, cdir=0):\n3365 |         \"\"\"\n3366 |         Wrapper to _eval_nseries if assumptions allow, else to series.\n3367 | \n3368 |         If x is given, x0 is 0, dir='+', and self has x, then _eval_nseries is\n3369 |         called. This calculates \"n\" terms in the innermost expressions and\n3370 |         then builds up the final series just by \"cross-multiplying\" everything\n3371 |         out.\n3372 | \n3373 |         The optional ``logx`` parameter can be used to replace any log(x) in the\n3374 |         returned series with a symbolic value to avoid evaluating log(x) at 0. A\n3375 |         symbol to use in place of log(x) should be provided.\n3376 | \n3377 |         Advantage -- it's fast, because we do not have to determine how many\n3378 |         terms we need to calculate in advance.\n3379 | \n3380 |         Disadvantage -- you may end up with less terms than you may have\n3381 |         expected, but the O(x**n) term appended will always be correct and\n3382 |         so the result, though perhaps shorter, will also be correct.\n3383 | \n3384 |         If any of those assumptions is not met, this is treated like a\n3385 |         wrapper to series which will try harder to return the correct\n3386 |         number of terms.\n3387 | \n3388 |         See also lseries().\n3389 | \n3390 |         Examples\n3391 |         ========\n3392 | \n3393 |         >>> from sympy import sin, log, Symbol\n3394 |         >>> from sympy.abc import x, y\n3395 |         >>> sin(x).nseries(x, 0, 6)\n3396 |         x - x**3/6 + x**5/120 + O(x**6)\n3397 |         >>> log(x+1).nseries(x, 0, 5)\n3398 |         x - x**2/2 + x**3/3 - x**4/4 + O(x**5)\n3399 | \n3400 |         Handling of the ``logx`` parameter --- in the following example the\n3401 |         expansion fails since ``sin`` does not have an asymptotic expansion\n3402 |         at -oo (the limit of log(x) as x approaches 0):\n3403 | \n3404 |         >>> e = sin(log(x))\n3405 |         >>> e.nseries(x, 0, 6)\n3406 |         Traceback (most recent call last):\n3407 |         ...\n3408 |         PoleError: ...\n3409 |         ...\n3410 |         >>> logx = Symbol('logx')\n3411 |         >>> e.nseries(x, 0, 6, logx=logx)\n3412 |         sin(logx)\n3413 | \n3414 |         In the following example, the expansion works but only returns self\n3415 |         unless the ``logx`` parameter is used:\n3416 | \n3417 |         >>> e = x**y\n3418 |         >>> e.nseries(x, 0, 2)\n3419 |         x**y\n3420 |         >>> e.nseries(x, 0, 2, logx=logx)\n3421 |         exp(logx*y)\n3422 | \n3423 |         \"\"\"\n3424 |         if x and x not in self.free_symbols:\n3425 |             return self\n3426 |         if x is None or x0 or dir != '+':  # {see XPOS above} or (x.is_positive == x.is_negative == None):\n3427 |             return self.series(x, x0, n, dir, cdir=cdir)\n3428 |         else:\n3429 |             return self._eval_nseries(x, n=n, logx=logx, cdir=cdir)\n3430 | \n3431 |     def _eval_nseries(self, x, n, logx, cdir):\n3432 |         \"\"\"\n3433 |         Return terms of series for self up to O(x**n) at x=0\n3434 |         from the positive direction.\n3435 | \n3436 |         This is a method that should be overridden in subclasses. Users should\n3437 |         never call this method directly (use .nseries() instead), so you do not\n3438 |         have to write docstrings for _eval_nseries().\n3439 |         \"\"\"\n3440 |         raise NotImplementedError(filldedent(\"\"\"\n3441 |                      The _eval_nseries method should be added to\n3442 |                      %s to give terms up to O(x**n) at x=0\n3443 |                      from the positive direction so it is available when\n3444 |                      nseries calls it.\"\"\" % self.func)\n3445 |                      )\n3446 | \n3447 |     def limit(self, x, xlim, dir='+'):\n3448 |         \"\"\" Compute limit x->xlim.\n3449 |         \"\"\"\n3450 |         from sympy.series.limits import limit\n3451 |         return limit(self, x, xlim, dir)\n3452 | \n3453 |     def compute_leading_term(self, x, logx=None):\n3454 |         \"\"\"Deprecated function to compute the leading term of a series.\n3455 | \n3456 |         as_leading_term is only allowed for results of .series()\n3457 |         This is a wrapper to compute a series first.\n3458 |         \"\"\"\n3459 |         from sympy.utilities.exceptions import SymPyDeprecationWarning\n3460 | \n3461 |         SymPyDeprecationWarning(\n3462 |             feature=\"compute_leading_term\",\n3463 |             useinstead=\"as_leading_term\",\n3464 |             issue=21843,\n3465 |             deprecated_since_version=\"1.12\"\n3466 |         ).warn()\n3467 | \n3468 |         from sympy.functions.elementary.piecewise import Piecewise, piecewise_fold\n3469 |         if self.has(Piecewise):\n3470 |             expr = piecewise_fold(self)\n3471 |         else:\n3472 |             expr = self\n3473 |         if self.removeO() == 0:\n3474 |             return self\n3475 | \n3476 |         from .symbol import Dummy\n3477 |         from sympy.functions.elementary.exponential import log\n3478 |         from sympy.series.order import Order\n3479 | \n3480 |         _logx = logx\n3481 |         logx = Dummy('logx') if logx is None else logx\n3482 |         res = Order(1)\n3483 |         incr = S.One\n3484 |         while res.is_Order:\n3485 |             res = expr._eval_nseries(x, n=1+incr, logx=logx).cancel().powsimp().trigsimp()\n3486 |             incr *= 2\n3487 | \n3488 |         if _logx is None:\n3489 |             res = res.subs(logx, log(x))\n3490 | \n3491 |         return res.as_leading_term(x)\n3492 | \n3493 |     @cacheit\n3494 |     def as_leading_term(self, *symbols, logx=None, cdir=0):\n3495 |         \"\"\"\n3496 |         Returns the leading (nonzero) term of the series expansion of self.\n3497 | \n3498 |         The _eval_as_leading_term routines are used to do this, and they must\n3499 |         always return a non-zero value.\n3500 | \n3501 |         Examples\n3502 |         ========\n3503 | \n3504 |         >>> from sympy.abc import x\n3505 |         >>> (1 + x + x**2).as_leading_term(x)\n3506 |         1\n3507 |         >>> (1/x**2 + x + x**2).as_leading_term(x)\n3508 |         x**(-2)\n3509 | \n3510 |         \"\"\"\n3511 |         if len(symbols) > 1:\n3512 |             c = self\n3513 |             for x in symbols:\n3514 |                 c = c.as_leading_term(x, logx=logx, cdir=cdir)\n3515 |             return c\n3516 |         elif not symbols:\n3517 |             return self\n3518 |         x = sympify(symbols[0])\n3519 |         cdir = sympify(cdir)\n3520 |         if not x.is_symbol:\n3521 |             raise ValueError('expecting a Symbol but got %s' % x)\n3522 |         if x not in self.free_symbols:\n3523 |             return self\n3524 |         obj = self._eval_as_leading_term(x, logx=logx, cdir=cdir)\n3525 |         if obj is not None:\n3526 |             from sympy.simplify.powsimp import powsimp\n3527 |             return powsimp(obj, deep=True, combine='exp')\n3528 |         raise NotImplementedError('as_leading_term(%s, %s)' % (self, x))\n3529 | \n3530 |     def _eval_as_leading_term(self, x, logx, cdir):\n3531 |         return self\n3532 | \n3533 |     def as_coeff_exponent(self, x) -> tuple[Expr, Expr]:\n3534 |         \"\"\" ``c*x**e -> c,e`` where x can be any symbolic expression.\n3535 |         \"\"\"\n3536 |         from sympy.simplify.radsimp import collect\n3537 |         s = collect(self, x)\n3538 |         c, p = s.as_coeff_mul(x)\n3539 |         if len(p) == 1:\n3540 |             b, e = p[0].as_base_exp()\n3541 |             if b == x:\n3542 |                 return c, e\n3543 |         return s, S.Zero\n3544 | \n3545 |     def leadterm(self, x, logx=None, cdir=0):\n3546 |         \"\"\"\n3547 |         Returns the leading term a*x**b as a tuple (a, b).\n3548 | \n3549 |         Examples\n3550 |         ========\n3551 | \n3552 |         >>> from sympy.abc import x\n3553 |         >>> (1+x+x**2).leadterm(x)\n3554 |         (1, 0)\n3555 |         >>> (1/x**2+x+x**2).leadterm(x)\n3556 |         (1, -2)\n3557 | \n3558 |         \"\"\"\n3559 |         from .symbol import Dummy\n3560 |         from sympy.functions.elementary.exponential import log\n3561 |         l = self.as_leading_term(x, logx=logx, cdir=cdir)\n3562 |         d = Dummy('logx')\n3563 |         if l.has(log(x)):\n3564 |             l = l.subs(log(x), d)\n3565 |         c, e = l.as_coeff_exponent(x)\n3566 |         if x in c.free_symbols:\n3567 |             raise ValueError(filldedent(\"\"\"\n3568 |                 cannot compute leadterm(%s, %s). The coefficient\n3569 |                 should have been free of %s but got %s\"\"\" % (self, x, x, c)))\n3570 |         c = c.subs(d, log(x))\n3571 |         return c, e\n3572 | \n3573 |     def as_coeff_Mul(self, rational: bool = False) -> tuple['Number', Expr]:\n3574 |         \"\"\"Efficiently extract the coefficient of a product.\"\"\"\n3575 |         return S.One, self\n3576 | \n3577 |     def as_coeff_Add(self, rational=False) -> tuple['Number', Expr]:\n3578 |         \"\"\"Efficiently extract the coefficient of a summation.\"\"\"\n3579 |         return S.Zero, self\n3580 | \n3581 |     def fps(self, x=None, x0=0, dir=1, hyper=True, order=4, rational=True,\n3582 |             full=False):\n3583 |         \"\"\"\n3584 |         Compute formal power power series of self.\n3585 | \n3586 |         See the docstring of the :func:`fps` function in sympy.series.formal for\n3587 |         more information.\n3588 |         \"\"\"\n3589 |         from sympy.series.formal import fps\n3590 | \n3591 |         return fps(self, x, x0, dir, hyper, order, rational, full)\n3592 | \n3593 |     def fourier_series(self, limits=None):\n3594 |         \"\"\"Compute fourier sine/cosine series of self.\n3595 | \n3596 |         See the docstring of the :func:`fourier_series` in sympy.series.fourier\n3597 |         for more information.\n3598 |         \"\"\"\n3599 |         from sympy.series.fourier import fourier_series\n3600 | \n3601 |         return fourier_series(self, limits)\n3602 | \n3603 |     ###################################################################################\n3604 |     ##################### DERIVATIVE, INTEGRAL, FUNCTIONAL METHODS ####################\n3605 |     ###################################################################################\n3606 | \n3607 |     def diff(self, *symbols, **assumptions):\n3608 |         assumptions.setdefault(\"evaluate\", True)\n3609 |         return _derivative_dispatch(self, *symbols, **assumptions)\n3610 | \n3611 |     ###########################################################################\n3612 |     ###################### EXPRESSION EXPANSION METHODS #######################\n3613 |     ###########################################################################\n3614 | \n3615 |     # Relevant subclasses should override _eval_expand_hint() methods.  See\n3616 |     # the docstring of expand() for more info.\n3617 | \n3618 |     def _eval_expand_complex(self, **hints):\n3619 |         real, imag = self.as_real_imag(**hints)\n3620 |         return real + S.ImaginaryUnit*imag\n3621 | \n3622 |     @staticmethod\n3623 |     def _expand_hint(expr, hint, deep=True, **hints):\n3624 |         \"\"\"\n3625 |         Helper for ``expand()``.  Recursively calls ``expr._eval_expand_hint()``.\n3626 | \n3627 |         Returns ``(expr, hit)``, where expr is the (possibly) expanded\n3628 |         ``expr`` and ``hit`` is ``True`` if ``expr`` was truly expanded and\n3629 |         ``False`` otherwise.\n3630 |         \"\"\"\n3631 |         hit = False\n3632 |         # XXX: Hack to support non-Basic args\n3633 |         #              |\n3634 |         #              V\n3635 |         if deep and getattr(expr, 'args', ()) and not expr.is_Atom:\n3636 |             sargs = []\n3637 |             for arg in expr.args:\n3638 |                 arg, arghit = Expr._expand_hint(arg, hint, **hints)\n3639 |                 hit |= arghit\n3640 |                 sargs.append(arg)\n3641 | \n3642 |             if hit:\n3643 |                 expr = expr.func(*sargs)\n3644 | \n3645 |         if hasattr(expr, hint):\n3646 |             newexpr = getattr(expr, hint)(**hints)\n3647 |             if newexpr != expr:\n3648 |                 return (newexpr, True)\n3649 | \n3650 |         return (expr, hit)\n3651 | \n3652 |     @cacheit\n3653 |     def expand(self, deep=True, modulus=None, power_base=True, power_exp=True,\n3654 |             mul=True, log=True, multinomial=True, basic=True, **hints):\n3655 |         \"\"\"\n3656 |         Expand an expression using hints.\n3657 | \n3658 |         See the docstring of the expand() function in sympy.core.function for\n3659 |         more information.\n3660 | \n3661 |         \"\"\"\n3662 |         from sympy.simplify.radsimp import fraction\n3663 | \n3664 |         hints.update(power_base=power_base, power_exp=power_exp, mul=mul,\n3665 |            log=log, multinomial=multinomial, basic=basic)\n3666 | \n3667 |         expr = self\n3668 |         # default matches fraction's default\n3669 |         _fraction = lambda x: fraction(x, hints.get('exact', False))\n3670 |         if hints.pop('frac', False):\n3671 |             n, d = [a.expand(deep=deep, modulus=modulus, **hints)\n3672 |                     for a in _fraction(self)]\n3673 |             return n/d\n3674 |         elif hints.pop('denom', False):\n3675 |             n, d = _fraction(self)\n3676 |             return n/d.expand(deep=deep, modulus=modulus, **hints)\n3677 |         elif hints.pop('numer', False):\n3678 |             n, d = _fraction(self)\n3679 |             return n.expand(deep=deep, modulus=modulus, **hints)/d\n3680 | \n3681 |         # Although the hints are sorted here, an earlier hint may get applied\n3682 |         # at a given node in the expression tree before another because of how\n3683 |         # the hints are applied.  e.g. expand(log(x*(y + z))) -> log(x*y +\n3684 |         # x*z) because while applying log at the top level, log and mul are\n3685 |         # applied at the deeper level in the tree so that when the log at the\n3686 |         # upper level gets applied, the mul has already been applied at the\n3687 |         # lower level.\n3688 | \n3689 |         # Additionally, because hints are only applied once, the expression\n3690 |         # may not be expanded all the way.   For example, if mul is applied\n3691 |         # before multinomial, x*(x + 1)**2 won't be expanded all the way.  For\n3692 |         # now, we just use a special case to make multinomial run before mul,\n3693 |         # so that at least polynomials will be expanded all the way.  In the\n3694 |         # future, smarter heuristics should be applied.\n3695 |         # TODO: Smarter heuristics\n3696 | \n3697 |         def _expand_hint_key(hint):\n3698 |             \"\"\"Make multinomial come before mul\"\"\"\n3699 |             if hint == 'mul':\n3700 |                 return 'mulz'\n3701 |             return hint\n3702 | \n3703 |         for hint in sorted(hints.keys(), key=_expand_hint_key):\n3704 |             use_hint = hints[hint]\n3705 |             if use_hint:\n3706 |                 hint = '_eval_expand_' + hint\n3707 |                 expr, hit = Expr._expand_hint(expr, hint, deep=deep, **hints)\n3708 | \n3709 |         while True:\n3710 |             was = expr\n3711 |             if hints.get('multinomial', False):\n3712 |                 expr, _ = Expr._expand_hint(\n3713 |                     expr, '_eval_expand_multinomial', deep=deep, **hints)\n3714 |             if hints.get('mul', False):\n3715 |                 expr, _ = Expr._expand_hint(\n3716 |                     expr, '_eval_expand_mul', deep=deep, **hints)\n3717 |             if hints.get('log', False):\n3718 |                 expr, _ = Expr._expand_hint(\n3719 |                     expr, '_eval_expand_log', deep=deep, **hints)\n3720 |             if expr == was:\n3721 |                 break\n3722 | \n3723 |         if modulus is not None:\n3724 |             modulus = sympify(modulus)\n3725 | \n3726 |             if not modulus.is_Integer or modulus <= 0:\n3727 |                 raise ValueError(\n3728 |                     \"modulus must be a positive integer, got %s\" % modulus)\n3729 | \n3730 |             terms = []\n3731 | \n3732 |             for term in Add.make_args(expr):\n3733 |                 coeff, tail = term.as_coeff_Mul(rational=True)\n3734 | \n3735 |                 coeff %= modulus\n3736 | \n3737 |                 if coeff:\n3738 |                     terms.append(coeff*tail)\n3739 | \n3740 |             expr = Add(*terms)\n3741 | \n3742 |         return expr\n3743 | \n3744 |     ###########################################################################\n3745 |     ################### GLOBAL ACTION VERB WRAPPER METHODS ####################\n3746 |     ###########################################################################\n3747 | \n3748 |     def integrate(self, *args, **kwargs):\n3749 |         \"\"\"See the integrate function in sympy.integrals\"\"\"\n3750 |         from sympy.integrals.integrals import integrate\n3751 |         return integrate(self, *args, **kwargs)\n3752 | \n3753 |     def nsimplify(self, constants=(), tolerance=None, full=False):\n3754 |         \"\"\"See the nsimplify function in sympy.simplify\"\"\"\n3755 |         from sympy.simplify.simplify import nsimplify\n3756 |         return nsimplify(self, constants, tolerance, full)\n3757 | \n3758 |     def separate(self, deep=False, force=False):\n3759 |         \"\"\"See the separate function in sympy.simplify\"\"\"\n3760 |         from .function import expand_power_base\n3761 |         return expand_power_base(self, deep=deep, force=force)\n3762 | \n3763 |     def collect(self, syms, func=None, evaluate=True, exact=False, distribute_order_term=True):\n3764 |         \"\"\"See the collect function in sympy.simplify\"\"\"\n3765 |         from sympy.simplify.radsimp import collect\n3766 |         return collect(self, syms, func, evaluate, exact, distribute_order_term)\n3767 | \n3768 |     def together(self, *args, **kwargs):\n3769 |         \"\"\"See the together function in sympy.polys\"\"\"\n3770 |         from sympy.polys.rationaltools import together\n3771 |         return together(self, *args, **kwargs)\n3772 | \n3773 |     def apart(self, x=None, **args):\n3774 |         \"\"\"See the apart function in sympy.polys\"\"\"\n3775 |         from sympy.polys.partfrac import apart\n3776 |         return apart(self, x, **args)\n3777 | \n3778 |     def ratsimp(self):\n3779 |         \"\"\"See the ratsimp function in sympy.simplify\"\"\"\n3780 |         from sympy.simplify.ratsimp import ratsimp\n3781 |         return ratsimp(self)\n3782 | \n3783 |     def trigsimp(self, **args):\n3784 |         \"\"\"See the trigsimp function in sympy.simplify\"\"\"\n3785 |         from sympy.simplify.trigsimp import trigsimp\n3786 |         return trigsimp(self, **args)\n3787 | \n3788 |     def radsimp(self, **kwargs):\n3789 |         \"\"\"See the radsimp function in sympy.simplify\"\"\"\n3790 |         from sympy.simplify.radsimp import radsimp\n3791 |         return radsimp(self, **kwargs)\n3792 | \n3793 |     def powsimp(self, *args, **kwargs):\n3794 |         \"\"\"See the powsimp function in sympy.simplify\"\"\"\n3795 |         from sympy.simplify.powsimp import powsimp\n3796 |         return powsimp(self, *args, **kwargs)\n3797 | \n3798 |     def combsimp(self):\n3799 |         \"\"\"See the combsimp function in sympy.simplify\"\"\"\n3800 |         from sympy.simplify.combsimp import combsimp\n3801 |         return combsimp(self)\n3802 | \n3803 |     def gammasimp(self):\n3804 |         \"\"\"See the gammasimp function in sympy.simplify\"\"\"\n3805 |         from sympy.simplify.gammasimp import gammasimp\n3806 |         return gammasimp(self)\n3807 | \n3808 |     def factor(self, *gens, **args):\n3809 |         \"\"\"See the factor() function in sympy.polys.polytools\"\"\"\n3810 |         from sympy.polys.polytools import factor\n3811 |         return factor(self, *gens, **args)\n3812 | \n3813 |     def cancel(self, *gens, **args):\n3814 |         \"\"\"See the cancel function in sympy.polys\"\"\"\n3815 |         from sympy.polys.polytools import cancel\n3816 |         return cancel(self, *gens, **args)\n3817 | \n3818 |     def invert(self, g, *gens, **args):\n3819 |         \"\"\"Return the multiplicative inverse of ``self`` mod ``g``\n3820 |         where ``self`` (and ``g``) may be symbolic expressions).\n3821 | \n3822 |         See Also\n3823 |         ========\n3824 |         sympy.core.intfunc.mod_inverse, sympy.polys.polytools.invert\n3825 |         \"\"\"\n3826 |         if self.is_number and getattr(g, 'is_number', True):\n3827 |             return mod_inverse(self, g)\n3828 |         from sympy.polys.polytools import invert\n3829 |         return invert(self, g, *gens, **args)\n3830 | \n3831 |     def round(self, n=None):\n3832 |         \"\"\"Return x rounded to the given decimal place.\n3833 | \n3834 |         If a complex number would results, apply round to the real\n3835 |         and imaginary components of the number.\n3836 | \n3837 |         Examples\n3838 |         ========\n3839 | \n3840 |         >>> from sympy import pi, E, I, S, Number\n3841 |         >>> pi.round()\n3842 |         3\n3843 |         >>> pi.round(2)\n3844 |         3.14\n3845 |         >>> (2*pi + E*I).round()\n3846 |         6 + 3*I\n3847 | \n3848 |         The round method has a chopping effect:\n3849 | \n3850 |         >>> (2*pi + I/10).round()\n3851 |         6\n3852 |         >>> (pi/10 + 2*I).round()\n3853 |         2*I\n3854 |         >>> (pi/10 + E*I).round(2)\n3855 |         0.31 + 2.72*I\n3856 | \n3857 |         Notes\n3858 |         =====\n3859 | \n3860 |         The Python ``round`` function uses the SymPy ``round`` method so it\n3861 |         will always return a SymPy number (not a Python float or int):\n3862 | \n3863 |         >>> isinstance(round(S(123), -2), Number)\n3864 |         True\n3865 |         \"\"\"\n3866 |         x = self\n3867 | \n3868 |         if not x.is_number:\n3869 |             raise TypeError(\"Cannot round symbolic expression\")\n3870 |         if not x.is_Atom:\n3871 |             if not pure_complex(x.n(2), or_real=True):\n3872 |                 raise TypeError(\n3873 |                     'Expected a number but got %s:' % func_name(x))\n3874 |         elif x in _illegal:\n3875 |             return x\n3876 |         if not (xr := x.is_extended_real):\n3877 |             r, i = x.as_real_imag()\n3878 |             if xr is False:\n3879 |                 return r.round(n) + S.ImaginaryUnit*i.round(n)\n3880 |             if i.equals(0):\n3881 |                 return r.round(n)\n3882 |         if not x:\n3883 |             return S.Zero if n is None else x\n3884 | \n3885 |         p = as_int(n or 0)\n3886 | \n3887 |         if x.is_Integer:\n3888 |             return Integer(round(int(x), p))\n3889 | \n3890 |         digits_to_decimal = _mag(x)  # _mag(12) = 2, _mag(.012) = -1\n3891 |         allow = digits_to_decimal + p\n3892 |         precs = [f._prec for f in x.atoms(Float)]\n3893 |         dps = prec_to_dps(max(precs)) if precs else None\n3894 |         if dps is None:\n3895 |             # assume everything is exact so use the Python\n3896 |             # float default or whatever was requested\n3897 |             dps = max(15, allow)\n3898 |         else:\n3899 |             allow = min(allow, dps)\n3900 |         # this will shift all digits to right of decimal\n3901 |         # and give us dps to work with as an int\n3902 |         shift = -digits_to_decimal + dps\n3903 |         extra = 1  # how far we look past known digits\n3904 |         # NOTE\n3905 |         # mpmath will calculate the binary representation to\n3906 |         # an arbitrary number of digits but we must base our\n3907 |         # answer on a finite number of those digits, e.g.\n3908 |         # .575 2589569785738035/2**52 in binary.\n3909 |         # mpmath shows us that the first 18 digits are\n3910 |         #     >>> Float(.575).n(18)\n3911 |         #     0.574999999999999956\n3912 |         # The default precision is 15 digits and if we ask\n3913 |         # for 15 we get\n3914 |         #     >>> Float(.575).n(15)\n3915 |         #     0.575000000000000\n3916 |         # mpmath handles rounding at the 15th digit. But we\n3917 |         # need to be careful since the user might be asking\n3918 |         # for rounding at the last digit and our semantics\n3919 |         # are to round toward the even final digit when there\n3920 |         # is a tie. So the extra digit will be used to make\n3921 |         # that decision. In this case, the value is the same\n3922 |         # to 15 digits:\n3923 |         #     >>> Float(.575).n(16)\n3924 |         #     0.5750000000000000\n3925 |         # Now converting this to the 15 known digits gives\n3926 |         #     575000000000000.0\n3927 |         # which rounds to integer\n3928 |         #    5750000000000000\n3929 |         # And now we can round to the desired digt, e.g. at\n3930 |         # the second from the left and we get\n3931 |         #    5800000000000000\n3932 |         # and rescaling that gives\n3933 |         #    0.58\n3934 |         # as the final result.\n3935 |         # If the value is made slightly less than 0.575 we might\n3936 |         # still obtain the same value:\n3937 |         #    >>> Float(.575-1e-16).n(16)*10**15\n3938 |         #    574999999999999.8\n3939 |         # What 15 digits best represents the known digits (which are\n3940 |         # to the left of the decimal? 5750000000000000, the same as\n3941 |         # before. The only way we will round down (in this case) is\n3942 |         # if we declared that we had more than 15 digits of precision.\n3943 |         # For example, if we use 16 digits of precision, the integer\n3944 |         # we deal with is\n3945 |         #    >>> Float(.575-1e-16).n(17)*10**16\n3946 |         #    5749999999999998.4\n3947 |         # and this now rounds to 5749999999999998 and (if we round to\n3948 |         # the 2nd digit from the left) we get 5700000000000000.\n3949 |         #\n3950 |         xf = x.n(dps + extra)*Pow(10, shift)\n3951 |         if xf.is_Number and xf._prec == 1:  # xf.is_Add will raise below\n3952 |             # is x == 0?\n3953 |             if x.equals(0):\n3954 |                 return Float(0)\n3955 |             raise ValueError('not computing with precision')\n3956 |         xi = Integer(xf)\n3957 |         # use the last digit to select the value of xi\n3958 |         # nearest to x before rounding at the desired digit\n3959 |         sign = 1 if x > 0 else -1\n3960 |         dif2 = sign*(xf - xi).n(extra)\n3961 |         if dif2 < 0:\n3962 |             raise NotImplementedError(\n3963 |                 'not expecting int(x) to round away from 0')\n3964 |         if dif2 > .5:\n3965 |             xi += sign  # round away from 0\n3966 |         elif dif2 == .5:\n3967 |             xi += sign if xi%2 else -sign  # round toward even\n3968 |         # shift p to the new position\n3969 |         ip = p - shift\n3970 |         # let Python handle the int rounding then r