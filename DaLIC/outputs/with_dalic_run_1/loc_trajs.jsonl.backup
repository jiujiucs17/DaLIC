rt get_option\n 18 | \n 19 | from pandas.util._exceptions import find_stack_level\n 20 | \n 21 | from pandas.core import roperator\n 22 | from pandas.core.computation.check import NUMEXPR_INSTALLED\n 23 | \n 24 | if NUMEXPR_INSTALLED:\n 25 |     import numexpr as ne\n 26 | \n 27 | if TYPE_CHECKING:\n 28 |     from pandas._typing import FuncType\n 29 | \n 30 | _TEST_MODE: bool | None = None\n 31 | _TEST_RESULT: list[bool] = []\n 32 | USE_NUMEXPR = NUMEXPR_INSTALLED\n 33 | _evaluate: FuncType | None = None\n 34 | _where: FuncType | None = None\n 35 | \n 36 | # the set of dtypes that we will allow pass to numexpr\n 37 | _ALLOWED_DTYPES = {\n 38 |     \"evaluate\": {\"int64\", \"int32\", \"float64\", \"float32\", \"bool\"},\n 39 |     \"where\": {\"int64\", \"float64\", \"bool\"},\n 40 | }\n 41 | \n 42 | # the minimum prod shape that we will use numexpr\n 43 | _MIN_ELEMENTS = 1_000_000\n 44 | \n 45 | \n 46 | def set_use_numexpr(v: bool = True) -> None:\n 47 |     # set/unset to use numexpr\n 48 |     global USE_NUMEXPR\n 49 |     if NUMEXPR_INSTALLED:\n 50 |         USE_NUMEXPR = v\n 51 | \n 52 |     # choose what we are going to do\n 53 |     global _evaluate, _where\n 54 | \n 55 |     _evaluate = _evaluate_numexpr if USE_NUMEXPR else _evaluate_standard\n 56 |     _where = _where_numexpr if USE_NUMEXPR else _where_standard\n 57 | \n 58 | \n 59 | def set_numexpr_threads(n=None) -> None:\n 60 |     # if we are using numexpr, set the threads to n\n 61 |     # otherwise reset\n 62 |     if NUMEXPR_INSTALLED and USE_NUMEXPR:\n 63 |         if n is None:\n 64 |             n = ne.detect_number_of_cores()\n 65 |         ne.set_num_threads(n)\n 66 | \n 67 | \n 68 | def _evaluate_standard(op, op_str, a, b):\n 69 |     \"\"\"\n 70 |     Standard evaluation.\n 71 |     \"\"\"\n 72 |     if _TEST_MODE:\n 73 |         _store_test_result(False)\n 74 |     return op(a, b)\n 75 | \n 76 | \n 77 | def _can_use_numexpr(op, op_str, a, b, dtype_check) -> bool:\n 78 |     \"\"\"return a boo