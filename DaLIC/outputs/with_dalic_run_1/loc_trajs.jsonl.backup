  40 |             co.append(ci)\n  41 |     return Add(*co), Add(*non)\n  42 | \n  43 | \n  44 | @sympify_method_args\n  45 | class Expr(Basic, EvalfMixin):\n  46 |     \"\"\"\n  47 |     Base class for algebraic expressions.\n  48 | \n  49 |     Explanation\n  50 |     ===========\n  51 | \n  52 |     Everything that requires arithmetic operations to be defined\n  53 |     should subclass this class, instead of Basic (which should be\n  54 |     used only for argument storage and expression manipulation, i.e.\n  55 |     pattern matching, substitutions, etc).\n  56 | \n  57 |     If you want to override the comparisons of expressions:\n  58 |     Should use _eval_is_ge for inequality, or _eval_is_eq, with multiple dispatch.\n  59 |     _eval_is_ge return true if x >= y, false if x < y, and None if the two types\n  60 |     are not comparable or the comparison is indeterminate\n  61 | \n  62 |     See Also\n  63 |     ========\n  64 | \n  65 |     sympy.core.basic.Basic\n  66 |     \"\"\"\n  67 | \n  68 |     __slots__: tuple[str, ...] = ()\n  69 | \n  70 |     is_scalar = True  # self derivative is 1\n  71 | \n  72 |     @property\n  73 |     def _diff_wrt(self):\n  74 |         \"\"\"Return True if one can differentiate with respect to this\n  75 |         object, else False.\n  76 | \n  77 |         Explanation\n  78 |         ===========\n  79 | \n  80 |         Subclasses such as Symbol, Function and Derivative return True\n  81 |         to enable derivatives wrt them. The implementation in Derivative\n  82 |         separates the Symbol and non-Symbol (_diff_wrt=True) variables and\n  83 |         temporarily converts the non-Symbols into Symbols when performing\n  84 |         the differentiation. By default, any object deriving from Expr\n  85 |         will behave like a scalar with self.diff(self) == 1. If this is\n  86 |         not desired then the object must also set `is_scalar = False` or\n  87 |         else define an _eval_derivative routine.\n  88 | \n  89 |         Note, see the docstring of Derivative for how this should work\n  90 |         mathematically. In particular, note that expr.subs(yourclass, Symbol)\n  91 |         should be well-defined on a structural level, or this will lead to\n  92 |         inconsistent results.\n  93 | \n  94 |         Examples\n  95 |         ========\n  96 | \n  97 |         >>> from sympy import Expr\n  98 |         >>> e = Expr()\n  99 |         >>> e._diff_wrt\n 100 |         False\n 101 |         >>> class MyScalar(Expr):\n 102 |         ...     _diff_wrt = True\n 103 |         ...\n 104 |         >>> MyScalar().diff(MyScalar())\n 105 |         1\n 106 |         >>> class MySymbol(Expr):\n 107 |         ...     _diff_wrt = True\n 108 |         ...     is_scalar = False\n 109 |         ...\n 110 |         >>> MySymbol().diff(MySymbol())\n 111 |         Derivative(MySymbol(), MySymbol())\n 112 |         \"\"\"\n 113 |         return False\n 114 | \n 115 |     @cacheit\n 116 |     def sort_key(self, order=None):\n 117 | \n 118 |         coeff, expr = self.as_coeff_Mul()\n 119 | \n 120 |         if expr.is_Pow:\n 121 |             base, exp = expr.as_base_exp()\n 122 |             if base is S.Exp1:\n 123 |                 # If we remove this, many doctests will go crazy:\n 124 |                 # (keeps E**x sorted like the exp(x) function,\n 125 |                 #  part of exp(x) to E**x transition)\n 126 |                 base, exp = Function(\"exp\")(exp), S.One\n 127 |             expr = base\n 128 |         else:\n 129 |             exp = S.One\n 130 | \n 131 |         if expr.is_Dummy:\n 132 |             args = (expr.sort_key(),)\n 133 |         elif expr.is_Atom:\n 134 |             args = (str(expr),)\n 135 |         else:\n 136 |             if expr.is_Add:\n 137 |                 args = expr.as_ordered_terms(order=order)\n 138 |             elif expr.is_Mul:\n 139 |                 args = expr.as_ordered_factors(order=order)\n 140 |             else:\n 141 |                 args = expr.args\n 142 | \n 143 |             args = tuple(\n 144 |                 [ default_sort_key(arg, order=order) for arg in args ])\n 145 | \n 146 |         args = (len(args), tuple(args))\n 147 |         exp = exp.sort_key(order=order)\n 148 | \n 149 |         return expr.class_key(), args, exp, coeff\n 150 | \n 151 |     def _hashable_content(self):\n 152 |         \"\"\"Return a tuple of information about self that can be used to\n 153 |         compute the hash. If a class defines additional attributes,\n 154 |         like ``name`` in Symbol, then this method should be updated\n 155 |         accordingly to return such relevant attributes.\n 156 |         Defining more than _hashable_content is necessary if __eq__ has\n 157 |         been defined by a class. See note about this in Basic.__eq__.\"\"\"\n 158 |         return self._args\n 159 | \n 160 |     # ***************\n 161 |     # * Arithmetics *\n 162 |     # ***************\n 163 |     # Expr and its subclasses use _op_priority to determine which object\n 164 |     # passed to a binary special method (__mul__, etc.) will handle the\n 165 |     # operation. In general, the 'call_highest_priority' decorator will choose\n 166 |     # the object with the highest _op_priority to handle the call.\n 167 |     # Custom subclasses that want to define their own binary special methods\n 168 |     # should set an _op_priority value that is higher than the default.\n 169 |     #\n 170 |     # **NOTE**:\n 171 |     # This is a temporary fix, and will eventually be replaced with\n 172 |     # something better and more powerful.  See issue 5510.\n 173 |     _op_priority = 10.0\n 174 | \n 175 |     @property\n 176 |     def _add_handler(self):\n 177 |         return Add\n 178 | \n 179 |     @property\n 180 |     def _mul_handler(self):\n 181 |         return Mul\n 182 | \n 183 |     def __pos__(self) -> Expr:\n 184 |         return self\n 185 | \n 186 |     def __neg__(self) -> Expr:\n 187 |   