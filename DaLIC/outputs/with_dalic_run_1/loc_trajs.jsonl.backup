s/S(10)**mag_first_dig) < 10\n4075 |         mag_first_dig += 1\n4076 |     return mag_first_dig\n4077 | \n4078 | \n4079 | class UnevaluatedExpr(Expr):\n4080 |     \"\"\"\n4081 |     Expression that is not evaluated unless released.\n4082 | \n4083 |     Examples\n4084 |     ========\n4085 | \n4086 |     >>> from sympy import UnevaluatedExpr\n4087 |     >>> from sympy.abc import x\n4088 |     >>> x*(1/x)\n4089 |     1\n4090 |     >>> x*UnevaluatedExpr(1/x)\n4091 |     x*1/x\n4092 | \n4093 |     \"\"\"\n4094 | \n4095 |     def __new__(cls, arg, **kwargs):\n4096 |         arg = _sympify(arg)\n4097 |         obj = Expr.__new__(cls, arg, **kwargs)\n4098 |         return obj\n4099 | \n4100 |     def doit(self, **hints):\n4101 |         if hints.get(\"deep\", True):\n4102 |             return self.args[0].doit(**hints)\n4103 |         else:\n4104 |             return self.args[0]\n4105 | \n4106 | \n4107 | \n4108 | def unchanged(func, *args):\n4109 |     \"\"\"Return True if `func` applied to the `args` is unchanged.\n4110 |     Can be used instead of `assert foo == foo`.\n4111 | \n4112 |     Examples\n4113 |     ========\n4114 | \n4115 |     >>> from sympy import Piecewise, cos, pi\n4116 |     >>> from sympy.core.expr import unchanged\n4117 |     >>> from sympy.abc import x\n4118 | \n4119 |     >>> unchanged(cos, 1)  # instead of assert cos(1) == cos(1)\n4120 |     True\n4121 | \n4122 |     >>> unchanged(cos, pi)\n4123 |     False\n4124 | \n4125 |     Comparison of args uses the builtin capabilities of the object's\n4126 |     arguments to test for equality so args can be defined loosely. Here,\n4127 |     the ExprCondPair arguments of Piecewise compare as equal to the\n4128 |     tuples that can be used to create the Piecewise:\n4129 | \n4130 |     >>> unchanged(Piecewise, (x, x > 1), (0, True))\n4131 |     True\n4132 |     \"\"\"\n4133 |     f = func(*args)\n4134 |     return f.func == func and f.args == args\n4135 | \n4136 | \n4137 | class ExprBuilder:\n4138 |     def _