pe = \"vertical\"\n  95 |     _default_rot = 0\n  96 |     orientation: str | None = None\n  97 | \n  98 |     axes: np.ndarray  # of Axes objects\n  99 | \n 100 |     def __init__(\n 101 |         self,\n 102 |         data,\n 103 |         kind=None,\n 104 |         by: IndexLabel | None = None,\n 105 |         subplots=False,\n 106 |         sharex=None,\n 107 |         sharey=False,\n 108 |         use_index=True,\n 109 |         figsize=None,\n 110 |         grid=None,\n 111 |         legend=True,\n 112 |         rot=None,\n 113 |         ax=None,\n 114 |         fig=None,\n 115 |         title=None,\n 116 |         xlim=None,\n 117 |         ylim=None,\n 118 |         xticks=None,\n 119 |         yticks=None,\n 120 |         xlabel: Hashable | None = None,\n 121 |         ylabel: Hashable | None = None,\n 122 |         sort_columns=False,\n 123 |         fontsize=None,\n 124 |         secondary_y=False,\n 125 |         colormap=None,\n 126 |         table=False,\n 127 |         layout=None,\n 128 |         include_bool=False,\n 129 |         column: IndexLabel | None = None,\n 130 |         **kwds,\n 131 |     ) -> None:\n 132 | \n 133 |         import matplotlib.pyplot as plt\n 134 | \n 135 |         self.data = data\n 136 | \n 137 |         # if users assign an empty list or tuple, raise `ValueError`\n 138 |         # similar to current `df.box` and `df.hist` APIs.\n 139 |         if by in ([], ()):\n 140 |             raise ValueError(\"No group keys passed!\")\n 141 |         self.by = com.maybe_make_list(by)\n 142 | \n 143 |         # Assign the rest of columns into self.columns if by is explicitly defined\n 144 |         # while column is not, only need `columns` in hist/box plot when it's DF\n 145 |         # TODO: Might deprecate `column` argument in future PR (#28373)\n 146 |         if isinstance(data, DataFrame):\n 147 |             if column:\n 148 |                 self.columns = com.maybe_make_list(column)\n 149 |             else:\n 150 |                 if self.by is None:\n 151 |                     self.columns = [\n 152 |                         col for col in data.columns if is_numeric_dtype(data[col])\n 153 |                     ]\n 154 |                 else:\n 155 |                     self.columns = [\n 156 |                         col\n 157 |                         for col in data.columns\n 158 |                         if col not in self.by and is_numeric_dtype(data[col])\n 159 |                     ]\n 160 | \n 161 |         # For `hist` plot, need to get grouped original data before `self.data` is\n 162 |         # updated later\n 163 |         if self.by is not None and self._kind == \"hist\":\n 164 |             self._grouped = data.groupby(self.by)\n 165 | \n 166 |         self.kind = kind\n 167 | \n 168 |         self.sort_columns = sort_columns\n 169 | \n 170 |         self.subplots = subplots\n 171 | \n 172 |         if sharex is None:\n 173 | \n 174 |             # if by is defined, subplots are used and sharex should be False\n 175 |             if ax is None and by is None:\n 176 |                 self.sharex = True\n 177 |             else:\n 178 |                 # if we get an axis, the users should do the visibility\n 179 |                 # setting...\n 180 |                 self.sharex = False\n 181 |         else:\n 182 |             self.sharex = sharex\n 183 | \n 184 |         self.sharey = sharey\n 185 |         self.figsize = figsize\n 186 |         self.layout = layout\n 187 | \n 188 |         self.xticks = xticks\n 189 |         self.yticks = yticks\n 190 |         self.xlim = xlim\n 191 |         self.ylim = ylim\n 192 |         self.title = title\n 193 |         self.use_index = use_index\n 194 |         self.xlabel = xlabel\n 195 |         self.ylabel = ylabel\n 196 | \n 197 |         self.fontsize = fontsize\n 198 | \n 199 |         if rot is not None:\n 200 |             self.rot = rot\n 201 |             # need to know for format_date_labels since it's rotated to 30 by\n 202 |             # default\n 203 |             self._rot_set = True\n 204 |         else:\n 205 |             self._rot_set = False\n 206 |             self.rot = self._default_rot\n 207 | \n 208 |         if grid is None:\n 209 |             grid = False if secondary_y else plt.rcParams[\"axes.grid\"]\n 210 | \n 211 |         self.grid = grid\n 212 |         self.legend = legend\n 213 |         self.legend_handles: list[Artist] = []\n 214 |         self.legend_labels: list[Hashable] = []\n 215 | \n 216 |         self.logx = kwds.pop(\"logx\", False)\n 217 |         self.logy = kwds.pop(\"logy\", False)\n 218 |         self.loglog = kwds.pop(\"loglog\", False)\n 219 |         self.label = kwds.pop(\"label\", None)\n 220 |         self.style = kwds.pop(\"style\", None)\n 221 |         self.mark_right = kwds.pop(\"mark_right\", True)\n 222 |         self.stacked = kwds.pop(\"stacked\", False)\n 223 | \n 224 |         self.ax = ax\n 225 |         self.fig = fig\n 226 |         self.axes = np.array([], dtype=object)  # \"real\" version get set in `generate`\n 227 | \n 228 |         # parse errorbar input if given\n 229 |         xerr = kwds.pop(\"xerr\", None)\n 230 |         yerr = kwds.pop(\"yerr\", None)\n 231 |         self.errors = {\n 232 |             kw: self._parse_errorbars(kw, err)\n 233 |             for kw, err in zip([\"xerr\", \"yerr\"], [xerr, yerr])\n 234 |         }\n 235 | \n 236 |         if not isinstance(secondary_y, (bool, tuple, list, np.ndarray, ABCIndex)):\n 237 |             secondary_y = [secondary_y]\n 238 |         self.secondary_y = secondary_y\n 239 | \n 240 |         # ugly TypeError if user passes matplotlib's `cmap` name.\n 241 |         # Probably better to accept either.\n 242 |         if \"cmap\" in kwds and colormap:\n 243 |             raise TypeError(\"Only specify one of `cmap` and `colormap`.\")\n 244 |         elif \"cmap\" in kwds:\n 245 |             self.colormap = kwds.pop(\"cmap\")\n 246 |         else:\n 247 |             self.colormap = colormap\n 248 | \n 249 |         self.table = table\n 250 |         self.include_bool = include_bool\n 251 | \n 252 |         self.kwds = kwds\n 253 | \n 254 |         self._validate_color_args()\n 255 | \n 256 |     def _validate_color_args(self):\n 257 |         if (\n 258 |             \"color\" in self.kwds\n 259 |             and self.nseries == 1\n 260 |             and not is_list_like(self.kwds[\"color\"])\n 261 |         ):\n 262 |             # support series.plot(color='green')\n 263 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n 264 | \n 265 |         if (\n 266 |             \"color\" in self.kwds\n 267 |             and isinstance(self.kwds[\"color\"], tuple)\n 268 |             and self.nseries == 1\n 269 |             and len(self.kwds[\"color\"]) in (3, 4)\n 270 |         ):\n 271 |             # support RGB and RGBA tuples in series plot\n 272 |             self.kwds[\"color\"] = [self.kwds[\"color\"]]\n 273 | \n 274 |         if (\n 275 |             \"color\" in self.kwds or \"colors\" in self.kwds\n 276 |         ) and self.colormap is not None:\n 277 |             warnings.warn(\n 278 |                 \"'color' and 'colormap' cannot be used simultaneously. Using 'color'\"\n 279 |             )\n 280 | \n 281 |         if \"color\" in self.kwds and self.style is not None:\n 282 |             if is_list_like(self.style):\n 283 |                 styles = self.style\n 284 |             else:\n 285 |                 styles = [self.style]\n 286 |             # need only a single match\n 287 |             for s in styles:\n 288 |                 if _color_in_style(s):\n 289 |                     raise ValueError(\n 290 |                         \"Cannot pass 'style' string with a color symbol and \"\n 291 |                         \"'color' keyword argument. Please use one or the \"\n 292 |                         \"other or pass 'style' without a color symbol\"\n 293 |                     )\n 294 | \n 295 |     def _iter_data(self, data=None, keep_index=False, fillna=None):\n 296 |         if data is None:\n 297 |             data = self.data\n 298 |         if fillna is not None:\n 299 |             data = data.fillna(fillna)\n 300 | \n 301 |         for col, values in data.items():\n 302 |             if keep_index is True:\n 303 |                 yield col, values\n 304 |             else:\n 305 |                 yield col, values.values\n 306 | \n 307 |     @property\n 308 |     def nseries(self) -> int:\n 309 | \n 310 |         # When `by` is explicitly assigned, grouped data size will be defined, and\n 311 |         # this will determine number of subplots to have, aka `self.nseries`\n 312 |         if self.data.ndim == 1:\n 313 |             return 1\n 314 |         elif self.by is not None and self._kind == \"hist\":\n 315 |             return len(self._grouped)\n 316 |         elif self.by is not None and self._kind == \"box\":\n 317 |             return len(self.columns)\n 318 |         else:\n 319 |             return self.data.shape[1]\n 320 | \n 321 |     def draw(self):\n 322 |         self.plt.draw_if_interactive()\n 323 | \n 324 |     def generate(self):\n 325 |         self._args_adjust()\n 326 |         self._compute_plot_data()\n 327 |         self._setup_subplots()\n 328 |         self._make_plot()\n 329 |         self._add_table()\n 330 |         self._make_legend()\n 331 |         self._adorn_subplots()\n 332 | \n 333 |         for ax in self.axes:\n 334 |             self._post_plot_logic_common(ax, self.data)\n 335 |             self._post_plot_logic(ax, self.data)\n 336 | \n 337 |     def _args_adjust(self):\n 338 |         pass\n 339 | \n 340 |     def _has_plotted_object(self, ax: Axes) -> bool:\n 341 |         \"\"\"check whether ax has data\"\"\"\n 342 |         return len(ax.lines) != 0 or len(ax.artists) != 0 or len(ax.containers) != 0\n 343 | \n 344 |     def _maybe_right_yaxis(self, ax: Axes, axes_num):\n 345 |         if not self.on_right(axes_num):\n 346 |             # secondary axes may be passed via ax kw\n 347 |             return self._get_ax_layer(ax)\n 348 | \n 349 |         if hasattr(ax, \"right_ax\"):\n 350 |             # if it has right_ax property, ``ax`` must be left axes\n 351 |             return ax.right_ax\n 352 |         elif hasattr(ax, \"left_ax\"):\n 353 |             # if it has left_ax property, ``ax`` must be right axes\n 354 |             return ax\n 355 |         else:\n 356 |             # otherwise, create twin axes\n 357 |             orig_ax, new_ax = ax, ax.twinx()\n 358 |             # TODO: use Matplotlib public API when available\n 359 |             new_ax._get_lines = orig_ax._get_lines\n 360 |             new_ax._get_patches_for_fill = orig_ax._get_patches_for_fill\n 361 |             orig_ax.right_ax, new_ax.left_ax = new_ax, orig_ax\n 362 | \n 363 |             if not self._has_plotted_object(orig_ax):  # no data on left y\n 364 |                 orig_ax.get_yaxis().set_visible(False)\n 365 | \n 366 |             if self.logy is True or self.loglog is True:\n 367 |                 new_ax.set_yscale(\"log\")\n 368 |             elif self.logy == \"sym\" or self.loglog == \"sym\":\n 369 |                 new_ax.set_yscale(\"symlog\")\n 370 |             return new_ax\n 371 | \n 372 |     def _setup_subplots(self):\n 373 |         if self.subplots:\n 374 |             fig, axes = create_subplots(\n 375 |                 naxes=self.nseries,\n 376 |                 sharex=self.sharex,\n 377 |                 sharey=self.sharey,\n 378 |                 figsize=self.figsize,\n 379 |                 ax=self.ax,\n 380 |                 layout=self.layout,\n 381 |                 layout_type=self._layout_type,\n 382 |             )\n 383 |         else:\n 384 |             if self.ax is None:\n 385 |                 fig = self.plt.figure(figsize=self.figsize)\n 386 |                 axes = fig.add_subplot(111)\n 387 |             else:\n 388 |                 fig = self.ax.get_figure()\n 389 |                 if self.figsize is not None:\n 390 |                     fig.set_size_inches(self.figsize)\n 391 |                 axes = self.ax\n 392 | \n 393 |         axes = flatten_axes(axes)\n 394 | \n 395 |         valid_log = {False, True, \"sym\", None}\n 396 |         input_log = {self.logx, self.logy, self.loglog}\n 397 |         if input_log - valid_log:\n 398 |             invalid_log = next(iter(input_log - valid_log))\n 399 |             raise ValueError(\n 400 |                 f\"Boolean, None and 'sym' are valid options, '{invalid_log}' is given.\"\n 401 |             )\n 402 | \n 403 |         if self.logx is True or self.loglog is True:\n 404 |             [a.set_xscale(\"log\") for a in axes]\n 405 |         elif self.logx == \"sym\" or self.loglog == \"sym\":\n 406 |             [a.set_xscale(\"symlog\") for a in axes]\n 407 | \n 408 |         if self.logy is True or self.loglog is True:\n 409 |             [a.set_yscale(\"log\") for a in axes]\n 410 |         elif self.logy == \"sym\" or self.loglog == \"sym\":\n 411 |             [a.set_yscale(\"symlog\") for a in axes]\n 412 | \n 413 |         self.fig = fig\n 414 |         self.axes = axes\n 415 | \n 416 |     @property\n 417 |     def result(self):\n 418 |         \"\"\"\n 419 |         Return result axes\n 420 |         \"\"\"\n 421 |         if self.subplots:\n 422 |             if self.layout is not None and not is_list_like(self.ax):\n 423 |                 return self.axes.reshape(*self.layout)\n 424 |             else:\n 425 |                 return self.axes\n 426 |         else:\n 427 |             sec_true = isinstance(self.secondary_y, bool) and self.secondary_y\n 428 |             all_sec = (\n 429 |                 is_list_like(self.secondary_y) and len(self.secondary_y) == self.nseries\n 430 |             )\n 431 |             if sec_true or all_sec:\n 432 |                 # if all data is plotted on secondary, return right axes\n 433 |                 return self._get_ax_layer(self.axes[0], primary=False)\n 434 |             else:\n 435 |                 return self.axes[0]\n 436 | \n 437 |     def _convert_to_ndarray(self, data):\n 438 |         # GH31357: categorical columns are processed separately\n 439 |         if is_categorical_dtype(data):\n 440 |             return data\n 441 | \n 442 |         # GH32073: cast to float if values contain nulled integers\n 443 |         if (\n 444 |             is_integer_dtype(data.dtype) or is_float_dtype(data.dtype)\n 445 |         ) and is_extension_array_dtype(data.dtype):\n 446 |             return data.to_numpy(dtype=\"float\", na_value=np.nan)\n 447 | \n 448 |         # GH25587: cast ExtensionArray of pandas (IntegerArray, etc.) to\n 449 |         # np.ndarray before plot.\n 450 |         if len(data) > 0:\n 451 |             return np.asarray(data)\n 452 | \n 453 |         return data\n 454 | \n 455 |     def _compute_plot_data(self):\n 456 |         data = self.data\n 457 | \n 458 |         if isinstance(data, ABCSeries):\n 459 |             label = self.label\n 460 |             if label is None and data.name is None:\n 461 |                 label = \"\"\n 462 |             if label is None:\n 463 |                 # We'll end up with columns of [0] instead of [None]\n 464 |                 data = data.to_frame()\n 465 |             else:\n 466 |                 data = data.to_frame(name=label)\n 467 |         elif self._kind in (\"hist\", \"box\"):\n 468 |             cols = self.columns if self.by is None else self.columns + self.by\n 469 |             data = data.loc[:, cols]\n 470 | \n 471 |         # GH15079 reconstruct data if by is defined\n 472 |         if self.by is not None:\n 473 |             self.subplots = True\n 474 |             data = reconstruct_data_with_by(self.data, by=self.by, cols=self.columns)\n 475 | \n 476 |         # GH16953, _convert is needed as fallback, for ``Series``\n 477 |         # with ``dtype == object``\n 478 |         data = data._convert(datetime=True, timedelta=True)\n 479 |         include_type = [np.number, \"datetime\", \"datetimetz\", \"timedelta\"]\n 480 | \n 481 |         # GH23719, allow plotting boolean\n 482 |         if self.include_bool is True:\n 483 |             include_type.append(np.bool_)\n 484 | \n 485 |         # GH22799, exclude datetime-like type for boxplot\n 486 |         exclude_type = None\n 487 |         if self._kind == \"box\":\n 488 |             # TODO: change after solving issue 27881\n 489 |             include_type = [np.number]\n 490 |             exclude_type = [\"timedelta\"]\n 491 | \n 492 |         # GH 18755, include object and category type for scatter plot\n 493 |         if self._kind == \"scatter\":\n 494 |             include_type.extend([\"object\", \"category\"])\n 495 | \n 496 |         numeric_data = data.select_dtypes(include=include_type, exclude=exclude_type)\n 497 | \n 498 |         try:\n 499 |             is_empty = numeric_data.columns.empty\n 500 |         except AttributeError:\n 501 |             is_empty = not len(numeric_data)\n 502 | \n 503 |         # no non-numeric frames or series allowed\n 504 |         if is_empty:\n 505 |             raise TypeError(\"no numeric data to plot\")\n 506 | \n 507 |         self.data = numeric_data.apply(self._convert_to_ndarray)\n 508 | \n 509 |     def _make_plot(self):\n 510 |         raise AbstractMethodError(self)\n 511 | \n 512 |     def _add_table(self):\n 513 |         if self.table is False:\n 514 |             return\n 515 |         elif self.table is True:\n 516 |             data = self.data.transpose()\n 517 |         else:\n 518 |             data = self.table\n 519 |         ax = self._get_ax(0)\n 520 |         table(ax, data)\n 521 | \n 522 |     def _post_plot_logic_common(self, ax, data):\n 523 |         \"\"\"Common post process for each axes\"\"\"\n 524 |         if self.orientation == \"vertical\" or self.orientation is None:\n 525 |             self._apply_axis_properties(ax.xaxis, rot=self.rot, fontsize=self.fontsize)\n 526 |             self._apply_axis_properties(ax.yaxis, fontsize=self.fontsize)\n 527 | \n 528 |             if hasattr(ax, \"right_ax\"):\n 529 |                 self._apply_axis_properties(ax.right_ax.yaxis, fontsize=self.fontsize)\n 530 | \n 531 |         elif self.orientation == \"horizontal\":\n 532 |             self._apply_axis_properties(ax.yaxis, rot=self.rot, fontsize=self.fontsize)\n 533 |             self._apply_axis_properties(ax.xaxis, fontsize=self.fontsize)\n 534 | \n 535 |             if hasattr(ax, \"right_ax\"):\n 536 |                 self._apply_axis_properties(ax.right_ax.yaxis, fontsize=self.fontsize)\n 537 |         else:  # pragma no cover\n 538 |             raise ValueError\n 539 | \n 540 |     def _post_plot_logic(self, ax, data):\n 541 |         \"\"\"Post process for each axes. Overridden in child classes\"\"\"\n 542 |         pass\n 543 | \n 544 |     def _adorn_subplots(self):\n 545 |         \"\"\"Common post process unrelated to data\"\"\"\n 546 |         if len(self.axes) > 0:\n 547 |             all_axes = self._get_subplots()\n 548 |             nrows, ncols = self._get_axes_layout()\n 549 |             handle_shared_axes(\n 550 |                 axarr=all_axes,\n 551 |                 nplots=len(all_axes),\n 552 |                 naxes=nrows * ncols,\n 553 |                 nrows=nrows,\n 554 |                 ncols=ncols,\n 555 |                 sharex=self.sharex,\n 556 |                 sharey=self.sharey,\n 557 |             )\n 558 | \n 559 |         for ax in self.axes:\n 560 |             if self.yticks is not None:\n 561 |                 ax.set_yticks(self.yticks)\n 562 | \n 563 |             if self.xticks is not None:\n 564 |                 ax.set_xticks(self.xticks)\n 565 | \n 566 |             if self.ylim is not None:\n 567 |                 ax.set_ylim(self.ylim)\n 568 | \n 569 |             if self.xlim is not None:\n 570 |                 ax.set_xlim(self.xlim)\n 571 | \n 572 |             # GH9093, currently Pandas does not show ylabel, so if users provide\n 573 |             # ylabel will set it as ylabel in the plot.\n 574 |             if self.ylabel is not None:\n 575 |                 ax.set_ylabel(pprint_thing(self.ylabel))\n 576 | \n 577 |             ax.grid(self.grid)\n 578 | \n 579 |         if self.title:\n 580 |             if self.subplots:\n 581 |                 if is_list_like(self.title):\n 582 |                     if len(self.title) != self.nseries:\n 583 |                         raise ValueError(\n 584 |                             \"The length of `title` must equal the number \"\n 585 |                             \"of columns if using `title` of type `list` \"\n 586 |                             \"and `subplots=True`.\\n\"\n 587 |                             f\"length of title = {len(self.title)}\\n\"\n 588 |                             f\"number of columns = {self.nseries}\"\n 589 |                         )\n 590 | \n 591 |                     for (ax, title) in zip(self.axes, self.title):\n 592 |                         ax.set_title(title)\n 593 |                 else:\n 594 |                     self.fig.suptitle(self.title)\n 595 |             else:\n 596 |                 if is_list_like(self.title):\n 597 |                     msg = (\n 598 |                         \"Using `title` of type `list` is not supported \"\n 599 |                         \"unless `subplots=True` is passed\"\n 600 |                     )\n 601 |                     raise ValueError(msg)\n 602 |                 self.axes[0].set_title(self.title)\n 603 | \n 604 |     def _apply_axis_properties(self, axis: Axis, rot=None, fontsize=None):\n 605 |         \"\"\"\n 606 |         Tick creation within matplotlib is reasonably expensive and is\n 607 |         internally deferred until accessed as Ticks are created/destroyed\n 608 |         multiple times per draw. It's therefore beneficial for us to avoid\n 609 |         accessing unless we will act on the Tick.\n 610 |         \"\"\"\n 611 |         if rot is not None or fontsize is not None:\n 612 |             # rot=0 is a valid setting, hence the explicit None check\n 613 |             labels = axis.get_majorticklabels() + axis.get_minorticklabels()\n 614 |             for label in labels:\n 615 |                 if rot is not None:\n 616 |                     label.set_rotation(rot)\n 617 |                 if fontsize is not None:\n 618 |                     label.set_fontsize(fontsize)\n 619 | \n 620 |     @property\n 621 |     def legend_title(self) -> str | None:\n 622 |         if not isinstance(self.data.columns, ABCMultiIndex):\n 623 |             name = self.data.columns.name\n 624 |             if name is not None:\n 625 |                 name = pprint_thing(name)\n 626 |             return name\n 627 |         else:\n 628 |             stringified = map(pprint_thing, self.data.columns.names)\n 629 |             return \",\".join(stringified)\n 630 | \n 631 |     def _mark_right_label(self, label: str, index: int) -> str:\n 632 |         \"\"\"\n 633 |         Append ``(right)`` to the label of a line if it's plotted on the right axis.\n 634 | \n 635 |         Note that ``(right)`` is only appended when ``subplots=False``.\n 636 |         \"\"\"\n 637 |         if not self.subplots and self.mark_right and self.on_right(index):\n 638 |             label += \" (right)\"\n 639 |         return label\n 640 | \n 641 |     def _append_legend_handles_labels(self, handle: Artist, label: str) -> None:\n 642 |         \"\"\"\n 643 |         Append current handle and label to ``legend_handles`` and ``legend_labels``.\n 644 | \n 645 |         These will be used to make the legend.\n 646 |         \"\"\"\n 647 |         self.legend_handles.append(handle)\n 648 |         self.legend_labels.append(label)\n 649 | \n 650 |     def _make_legend(self) -> None:\n 651 |         ax, leg = self._get_ax_legend(self.axes[0])\n 652 | \n 653 |         handles = []\n 654 |         labels = []\n 655 |         title = \"\"\n 656 | \n 657 |         if not self.subplots:\n 658 |             if leg is not None:\n 659 |                 title = leg.get_title().get_text()\n 660 |                 # Replace leg.LegendHandles because it misses marker info\n 661 |                 handles = leg.legendHandles\n 662 |                 labels = [x.get_text() for x in leg.get_texts()]\n 663 | \n 664 |             if self.legend:\n 665 |                 if self.legend == \"reverse\":\n 666 |                     handles += reversed(self.legend_handles)\n 667 |                     labels += reversed(self.legend_labels)\n 668 |                 else:\n 669 |                     handles += self.legend_handles\n 670 |                     labels += self.legend_labels\n 671 | \n 672 |                 if self.legend_title is not None:\n 673 |                     title = self.legend_title\n 674 | \n 675 |             if len(handles) > 0:\n 676 |                 ax.legend(handles, labels, loc=\"best\", title=title)\n 677 | \n 678 |         elif self.subplots and self.legend:\n 679 |             for ax in self.axes:\n 680 |                 if ax.get_visible():\n 681 |                     ax.legend(loc=\"best\")\n 682 | \n 683 |     def _get_ax_legend(self, ax: Axes):\n 684 |         \"\"\"\n 685 |         Take in axes and return ax and legend under different scenarios\n 686 |         \"\"\"\n 687 |         leg = ax.get_legend()\n 688 | \n 689 |         other_ax = getattr(ax, \"left_ax\", None) or getattr(ax, \"right_ax\", None)\n 690 |         other_leg = None\n 691 |         if other_ax is not None:\n 692 |             other_leg = other_ax.get_legend()\n 693 |         if leg is None and other_leg is not None:\n 694 |             leg = other_leg\n 695 |             ax = other_ax\n 696 |         return ax, leg\n 697 | \n 698 |     @cache_readonly\n 699 |     def plt(self):\n 700 |         import matplotlib.pyplot as plt\n 701 | \n 702 |         return plt\n 703 | \n 704 |     _need_to_set_index = False\n 705 | \n 706 |     def _get_xticks(self, convert_period: bool = False):\n 707 |         index = self.data.index\n 708 |         is_datetype = index.inferred_type in (\"datetime\", \"date\", \"datetime64\", \"time\")\n 709 | \n 710 |         if self.use_index:\n 711 |             if convert_period and isinstance(index, ABCPeriodIndex):\n 712 |                 self.data = self.data.reindex(index=index.sort_values())\n 713 |                 x = self.data.index.to_timestamp()._mpl_repr()\n 714 |             elif index.is_numeric():\n 715 |                 \"\"\"\n 716 |                 Matplotlib supports numeric values or datetime objects as\n 717 |                 xaxis values. Taking LBYL approach here, by the time\n 718 |                 matplotlib raises exception when using non numeric/datetime\n 719 |                 values for xaxis, several actions are already taken by plt.\n 720 |                 \"\"\"\n 721 |                 x = index._mpl_repr()\n 722 |             elif is_datetype:\n 723 |                 self.data = self.data[notna(self.data.index)]\n 724 |                 self.data = self.data.sort_index()\n 725 |                 x = self.data.index._mpl_repr()\n 726 |             else:\n 727 |                 self._need_to_set_index = True\n 728 |                 x = list(range(len(index)))\n 729 |         else:\n 730 |             x = list(range(len(index)))\n 731 | \n 732 |         return x\n 733 | \n 734 |     @classmethod\n 735 |     @register_pandas_matplotlib_converters\n 736 |     def _plot(cls, ax: Axes, x, y, style=None, is_errorbar: bool = False, **kwds):\n 737 |         mask = isna(y)\n 738 |         if mask.any():\n 739 |             y = np.ma.array(y)\n 740 |             y = np.ma.masked_where(mask, y)\n 741 | \n 742 |         if isinstance(x, ABCIndex):\n 743 |             x = x._mpl_repr()\n 744 | \n 745 |         if is_errorbar:\n 746 |             if \"xerr\" in kwds:\n 747 |                 kwds[\"xerr\"] = np.array(kwds.get(\"xerr\"))\n 748 |             if \"yerr\" in kwds:\n 749 |                 kwds[\"yerr\"] = np.array(kwds.get(\"yerr\"))\n 750 |             return ax.errorbar(x, y, **kwds)\n 751 |         else:\n 752 |             # prevent style kwarg from going to errorbar, where it is unsupported\n 753 |             args = (x, y, style) if style is not None else (x, y)\n 754 |             return ax.plot(*args, **kwds)\n 755 | \n 756 |     def _get_custom_index_name(self):\n 757 |         \"\"\"Specify whether xlabel/ylabel should be used to override index name\"\"\"\n 758 |         return self.xlabel\n 759 | \n 760 |     def _get_index_name(self) -> str | None:\n 761 |         if isinstance(self.data.index, ABCMultiIndex):\n 762 |             name = self.data.index.names\n 763 |             if com.any_not_none(*name):\n 764 |                 name = \",\".join([pprint_thing(x) for x in name])\n 765 |             else:\n 766 |                 name = None\n 767 |         else:\n 768 |             name = self.data.index.name\n 769 |             if name is not None:\n 770 |                 name = pprint_thing(name)\n 771 | \n 772 |         # GH 45145, override the default axis label if one is provided.\n 773 |         index_name = self._get_custom_index_name()\n 774 |         if index_name is not None:\n 775 |             name = pprint_thing(index_name)\n 776 | \n 777 |         return name\n 778 | \n 779 |     @classmethod\n 780 |     def _get_ax_layer(cls, ax, primary=True):\n 781 |         \"\"\"get left (primary) or right (secondary) axes\"\"\"\n 782 |         if primary:\n 783 |             return getattr(ax, \"left_ax\", ax)\n 784 |         else:\n 785 |             return getattr(ax, \"right_ax\", ax)\n 786 | \n 787 |     def _get_ax(self, i: int):\n 788 |         # get the twinx ax if appropriate\n 789 |         if self.subplots:\n 790 |             ax = self.axes[i]\n 791 |             ax = self._maybe_right_yaxis(ax, i)\n 792 |             self.axes[i] = ax\n 793 |         else:\n 794 |             ax = self.axes[0]\n 795 |             ax = self._maybe_right_yaxis(ax, i)\n 796 | \n 797 |         ax.get_yaxis().set_visible(True)\n 798 |         return ax\n 799 | \n 800 |     @classmethod\n 801 |     def get_default_ax(cls, ax):\n 802 |         import matplotlib.pyplot as plt\n 803 | \n 804 |         if ax is None and len(plt.get_fignums()) > 0:\n 805 |             with plt.rc_context():\n 806 |                 ax = plt.gca()\n 807 |             ax = cls._get_ax_layer(ax)\n 808 | \n 809 |     def on_right(self, i):\n 810 |         if isinstance(self.secondary_y, bool):\n 811 |             return self.secondary_y\n 812 | \n 813 |         if isinstance(self.secondary_y, (tuple, list, np.ndarray, ABCIndex)):\n 814 |             return self.data.columns[i] in self.secondary_y\n 815 | \n 816 |     def _apply_style_colors(self, colors, kwds, col_num, label):\n 817 |         \"\"\"\n 818 |         Manage style and color based on column number and its label.\n 819 |         Returns tuple of appropriate style and kwds which \"color\" may be added.\n 820 |         \"\"\"\n 821 |         style = None\n 822 |         if self.style is not None:\n 823 |             if isinstance(self.style, list):\n 824 |                 try:\n 825 |                     style = self.style[col_num]\n 826 |                 except IndexError:\n 827 |                     pass\n 828 |             elif isinstance(self.style, dict):\n 829 |                 style = self.style.get(label, style)\n 830 |             else:\n 831 |                 style = self.style\n 832 | \n 833 |         has_color = \"color\" in kwds or self.colormap is not None\n 834 |         nocolor_style = style is None or not _color_in_style(style)\n 835 |         if (has_color or self.subplots) and nocolor_style:\n 836 |             if isinstance(colors, dict):\n 837 |                 kwds[\"color\"] = colors[label]\n 838 |             else:\n 839 |                 kwds[\"color\"] = colors[col_num % len(colors)]\n 840 |         return style, kwds\n 841 | \n 842 |     def _get_colors(self, num_colors=None, color_kwds=\"color\"):\n 843 |         if num_colors is None:\n 844 |             num_colors = self.nseries\n 845 | \n 846 |         return get_standard_colors(\n 847 |             num_colors=num_colors,\n 848 |             colormap=self.colormap,\n 849 |             color=self.kwds.get(color_kwds),\n 850 |         )\n 851 | \n 852 |     def _parse_errorbars(self, label, err):\n 853 |         \"\"\"\n 854 |         Look for error keyword arguments and return the actual errorbar data\n 855 |         or return the error DataFrame/dict\n 856 | \n 857 |         Error bars can be specified in several ways:\n 858 |             Series: the user provides a pandas.Series object of the same\n 859 |                     length as the data\n 860 |             ndarray: provides a np.ndarray of the same length as the data\n 861 |             DataFrame/dict: error values are paired with keys matching the\n 862 |                     key in the plotted DataFrame\n 863 |             str: the name of the column within the plotted DataFrame\n 864 | \n 865 |         Asymmetrical error bars are also supported, however raw error values\n 866 |         must be provided in this case. For a ``N`` length :class:`Series`, a\n 867 |         ``2xN`` array should be provided indicating lower and upper (or left\n 868 |         and right) errors. For a ``MxN`` :class:`DataFrame`, asymmetrical errors\n 869 |         should be in a ``Mx2xN`` array.\n 870 |         \"\"\"\n 871 |         if err is None:\n 872 |             return None\n 873 | \n 874 |         def match_labels(data, e):\n 875 |             e = e.reindex(data.index)\n 876 |             return e\n 877 | \n 878 |         # key-matched DataFrame\n 879 |         if isinstance(err, ABCDataFrame):\n 880 | \n 881 |             err = match_labels(self.data, err)\n 882 |         # key-matched dict\n 883 |         elif isinstance(err, dict):\n 884 |             pass\n 885 | \n 886 |         # Series of error values\n 887 |         elif isinstance(err, ABCSeries):\n 888 |             # broadcast error series across data\n 889 |             err = match_labels(self.data, err)\n 890 |             err = np.atleast_2d(err)\n 891 |             err = np.tile(err, (self.nseries, 1))\n 892 | \n 893 |         # errors are a column in the dataframe\n 894 |         elif isinstance(err, str):\n 895 |             evalues = self.data[err].values\n 896 |             self.data = self.data[self.data.columns.drop(err)]\n 897 |             err = np.atleast_2d(evalues)\n 898 |             err = np.tile(err, (self.nseries, 1))\n 899 | \n 900 |         elif is_list_like(err):\n 901 |             if is_iterator(err):\n 902 |                 err = np.atleast_2d(list(err))\n 903 |             else:\n 904 |                 # raw error values\n 905 |                 err = np.atleast_2d(err)\n 906 | \n 907 |             err_shape = err.shape\n 908 | \n 909 |             # asymmetrical error bars\n 910 |             if isinstance(self.data, ABCSeries) and err_shape[0] == 2:\n 911 |                 err = np.expand_dims(err, 0)\n 912 |                 err_shape = err.shape\n 913 |                 if err_shape[2] != len(self.data):\n 914 |                     raise ValueError(\n 915 |                         \"Asymmetrical error bars should be provided \"\n 916 |                         f\"with the shape (2, {len(self.data)})\"\n 917 |                     )\n 918 |             elif isinstance(self.data, ABCDataFrame) and err.ndim == 3:\n 919 |                 if (\n 920 |                     (err_shape[0] != self.nseries)\n 921 |                     or (err_shape[1] != 2)\n 922 |                     or (err_shape[2] != len(self.data))\n 923 |                 ):\n 924 |                     raise ValueError(\n 925 |                         \"Asymmetrical error bars should be provided \"\n 926 |                         f\"with the shape ({self.nseries}, 2, {len(self.data)})\"\n 927 |                     )\n 928 | \n 929 |             # broadcast errors to each data series\n 930 |             if len(err) == 1:\n 931 |                 err = np.tile(err, (self.nseries, 1))\n 932 | \n 933 |         elif is_number(err):\n 934 |             err = np.tile([err], (self.nseries, len(self.data)))\n 935 | \n 936 |         else:\n 937 |             msg = f\"No valid {label} detected\"\n 938 |             raise ValueError(msg)\n 939 | \n 940 |         return err\n 941 | \n 942 |     def _get_errorbars(self, label=None, index=None, xerr=True, yerr=True):\n 943 |         errors = {}\n 944 | \n 945 |         for kw, flag in zip([\"xerr\", \"yerr\"], [xerr, yerr]):\n 946 |             if flag:\n 947 |                 err = self.errors[kw]\n 948 |                 # user provided label-matched dataframe of errors\n 949 |                 if isinstance(err, (ABCDataFrame, dict)):\n 950 |                     if label is not None and label in err.keys():\n 951 |                         err = err[label]\n 952 |                     else:\n 953 |                         err = None\n 954 |                 elif index is not None and err is not None:\n 955 |                     err = err[index]\n 956 | \n 957 |                 if err is not None:\n 958 |                     errors[kw] = err\n 959 |         return errors\n 960 | \n 961 |     def _get_subplots(self):\n 962 |         from matplotlib.axes import Subplot\n 963 | \n 964 |         return [\n 965 |             ax for ax in self.axes[0].get_figure().get_axes() if isinstance(ax, Subplot)\n 966 |         ]\n 967 | \n 968 |     def _get_axes_layout(self) -> tuple[int, int]:\n 969 |         axes = self._get_subplots()\n 970 |         x_set = set()\n 971 |         y_set = set()\n 972 |         for ax in axes:\n 973 |             # check axes coordinates to estimate layout\n 974 |             points = ax.get_position().get_points()\n 975 |             x_set.add(points[0][0])\n 976 |             y_set.add(points[0][1])\n 977 |         return (len(y_set), len(x_set))\n 978 | \n 979 | \n 980 | class PlanePlot(MPLPlot):\n 981 |     \"\"\"\n 982 |     Abstract class for plotting on plane, currently scatter and hexbin.\n 983 |     \"\"\"\n 984 | \n 985 |     _layout_type = \"single\"\n 986 | \n 987 |     def __init__(self, data, x, y, **kwargs) -> None:\n 988 |         MPLPlot.__init__(self, data, **kwargs)\n 989 |         if x is None or y is None:\n 990 |             raise ValueError(self._kind + \" requires an x and y column\")\n 991 |         if is_integer(x) and not self.data.columns.holds_integer():\n 992 |             x = self.data.columns[x]\n 993 |         if is_integer(y) and not self.data.columns.holds_integer():\n 994 |             y = self.data.columns[y]\n 995 | \n 996 |         # Scatter plot allows to plot objects data\n 997 |         if self._kind == \"hexbin\":\n 998 |             if len(self.data[x]._get_numeric_data()) == 0:\n 999 |                 raise ValueError(self._kind + \" requires x column to be numeric\")\n1000 |             if len(self.data[y]._get_numeric_data()) == 0:\n1001 |                 raise ValueError(self._kind + \" requires y column to be numeric\")\n1002 | \n1003 |         self.x = x\n1004 |         self.y = y\n1005 | \n1006 |     @property\n1007 |     def nseries(self) -> int:\n1008 |         return 1\n1009 | \n1010 |     def _post_plot_logic(self, ax: Axes, data):\n1011 |         x, y = self.x, self.y\n1012 |         xlabel = self.xlabel if self.xlabel is not None else pprint_thing(x)\n1013 |         ylabel = self.ylabel if self.ylabel is not None else pprint_thing(y)\n1014 |         ax.set_xlabel(xlabel)\n1015 |         ax.set_ylabel(ylabel)\n1016 | \n1017 |     def _plot_colorbar(self, ax: Axes, **kwds):\n1018 |         # Addresses issues #10611 and #10678:\n1019 |         # When plotting scatterplots and hexbinplots in IPython\n1020 |         # inline backend the colorbar axis height tends not to\n1021 |         # exactly match the parent axis height.\n1022 |         # The difference is due to small fractional differences\n1023 |         # in floating points with similar representation.\n1024 |         # To deal with this, this method forces the colorbar\n1025 |         # height to take the height of the parent axes.\n1026 |         # For a more detailed description of the issue\n1027 |         # see the following link:\n1028 |         # https://github.com/ipython/ipython/issues/11215\n1029 | \n1030 |         # GH33389, if ax is used multiple times, we should always\n1031 |         # use the last one which contains the latest information\n1032 |         # about the ax\n1033 |         img = ax.collections[-1]\n1034 |         return self.fig.colorbar(img, ax=ax, **kwds)\n1035 | \n1036 | \n1037 | class ScatterPlot(PlanePlot):\n1038 |     _kind = \"scatter\"\n1039 | \n1040 |     def __init__(self, data, x, y, s=None, c=None, **kwargs) -> None:\n1041 |         if s is None:\n1042 |             # hide the matplotlib default for size, in case we want to change\n1043 |             # the handling of this argument later\n1044 |             s = 20\n1045 |         elif is_hashable(s) and s in data.columns:\n1046 |             s = data[s]\n1047 |         super().__init__(data, x, y, s=s, **kwargs)\n1048 |         if is_integer(c) and not self.data.columns.holds_integer():\n1049 |             c = self.data.columns[c]\n1050 |         self.c = c\n1051 | \n1052 |     def _make_plot(self):\n1053 |         x, y, c, data = self.x, self.y, self.c, self.data\n1054 |         ax = self.axes[0]\n1055 | \n1056 |         c_is_column = is_hashable(c) and c in self.data.columns\n1057 | \n1058 |         color_by_categorical = c_is_column and is_categorical_dtype(self.data[c])\n1059 | \n1060 |         # pandas uses colormap, matplotlib uses cmap.\n1061 |         cmap = self.colormap or \"Greys\"\n1062 |         cmap = self.plt.cm.get_cmap(cmap)\n1063 |         color = self.kwds.pop(\"color\", None)\n1064 |         if c is not None and color is not None:\n1065 |             raise TypeError(\"Specify exactly one of `c` and `color`\")\n1066 |         elif c is None and color is None:\n1067 |             c_values = self.plt.rcParams[\"patch.facecolor\"]\n1068 |         elif color is not None:\n1069 |             c_values = color\n1070 |         elif color_by_categorical:\n1071 |             c_values = self.data[c].cat.codes\n1072 |         elif c_is_column:\n1073 |             c_values = self.data[c].values\n1074 |         else:\n1075 |             c_values = c\n1076 | \n1077 |         if color_by_categorical:\n1078 |             from matplotlib import colors\n1079 | \n1080 |             n_cats = len(self.data[c].cat.categories)\n1081 |             cmap = colors.ListedColormap([cmap(i) for i in range(cmap.N)])\n1082 |             bounds = np.linspace(0, n_cats, n_cats + 1)\n1083 |             norm = colors.BoundaryNorm(bounds, cmap.N)\n1084 |         else:\n1085 |             norm = self.kwds.pop(\"norm\", None)\n1086 |         # plot colorbar if\n1087 |         # 1. colormap is assigned, and\n1088 |         # 2.`c` is a column containing only numeric values\n1089 |         plot_colorbar = self.colormap or c_is_column\n1090 |         cb = self.kwds.pop(\"colorbar\", is_numeric_dtype(c_values) and plot_colorbar)\n1091 | \n1092 |         if self.legend and hasattr(self, \"label\"):\n1093 |             label = self.label\n1094 |         else:\n1095 |             label = None\n1096 |         scatter = ax.scatter(\n1097 |             data[x].values,\n1098 |             data[y].values,\n1099 |             c=c_values,\n1100 |             label=label,\n1101 |             cmap=cmap,\n1102 |             norm=norm,\n1103 |             **self.kwds,\n1104 |         )\n1105 |         if cb:\n1106 |             cbar_label = c if c_is_column else \"\"\n1107 |             cbar = self._plot_colorbar(ax, la