is not None:\n134 |             raise ValueError(\n135 |                 \"shading='gouraud' can only be used when the colors \"\n136 |                 \"are specified at the points, not at the faces.\")\n137 |         collection = TriMesh(tri, alpha=alpha, array=point_colors,\n138 |                              cmap=cmap, norm=norm, **kwargs)\n139 |     else:  # 'flat'\n140 |         # Vertices of triangles.\n141 |         maskedTris = tri.get_masked_triangles()\n142 |         verts = np.stack((tri.x[maskedTris], tri.y[maskedTris]), axis=-1)\n143 | \n144 |         # Color values.\n145 |         if facecolors is None:\n146 |             # One color per triangle, the mean of the 3 vertex color values.\n147 |             colors = point_colors[maskedTris].mean(axis=1)\n148 |         elif tri.mask is not None:\n149 |             # Remove color values of masked triangles.\n150 |             colors = facecolors[~tri.mask]\n151 |         else:\n152 |             colors = facecolors\n153 |         collection = PolyCollection(verts, alpha=alpha, array=colors,\n154 |                                     cmap=cmap, norm=norm, **kwargs)\n155 | \n156 |     collection._scale_norm(norm, vmin, vmax)\n157 |     ax.grid(False)\n158 | \n159 |     minx = tri.x.min()\n160 |     maxx = tri.x.max()\n161 |     miny = tri.y.min()\n162 |     maxy = tri.y.max()\n163 |     corners = (minx, miny), (maxx, maxy)\n164 |     ax.update_datalim(corners)\n165 |     ax.autoscale_view()\n166 |     ax.add_collection(collection)\n167 |     return collection\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Patch3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n728 | def get_facecolor(self):\n729 |         return self._maybe_depth_shade_and_sort_colors(super().get_facecolor())\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Path3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n914 | def get_facecolor(self):\n91