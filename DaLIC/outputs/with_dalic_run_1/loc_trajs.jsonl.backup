{"instance_id": "pandas-dev__pandas-29944", "found_files": [["pandas/plotting/_matplotlib/core.py", "pandas/plotting/_matplotlib/tools.py", "pandas/plotting/_core.py"]], "found_modules": [["pandas/io/formats/latex.py:TableBuilderAbstract", "pandas/plotting/_matplotlib/converter.py:MilliSecondLocator", "pandas/core/strings/object_array.py:ObjectStringArrayMixin", "pandas/core/arrays/numpy_.py:PandasArray", "asv_bench/benchmarks/arithmetic.py:AddOverflowScalar", "pandas/io/formats/info.py:BaseInfo", "asv_bench/benchmarks/groupby.py:FillNA", "pandas/core/indexes/accessors.py:TimedeltaProperties", "pandas/io/formats/latex.py:GenericTableBuilder", "asv_bench/benchmarks/arithmetic.py:AddOverflowArray", "pandas/plotting/_matplotlib/core.py:MPLPlot", "pandas/core/computation/engines.py:PythonEngine", "pandas/core/internals/array_manager.py:BaseArrayManager", "pandas/core/apply.py:Apply", "pandas/core/strings/base.py:BaseStringArrayMethods", "asv_bench/benchmarks/io/csv.py:ToCSVIndexes", "asv_bench/benchmarks/io/json.py:ToJSON", "pandas/core/arrays/sparse/dtype.py:SparseDtype", "asv_bench/benchmarks/multiindex_object.py:Sortlevel", "pandas/plotting/_matplotlib/hist.py:KdePlot", "pandas/plotting/_matplotlib/converter.py:TimeConverter", "asv_bench/benchmarks/frame_methods.py:Iteration", "pandas/core/indexes/period.py:PeriodIndex", "pandas/util/version/__init__.py:LegacyVersion", "asv_bench/benchmarks/groupby.py:Int64", "asv_bench/benchmarks/series_methods.py:All", "pandas/io/sas/sas7bdat.py:SAS7BDATReader", "pandas/_typing.py:ReadPickleBuffer", "asv_bench/benchmarks/timeseries.py:AsOf", "asv_bench/benchmarks/reshape.py:Crosstab", "pandas/_config/config.py:DictWrapper", "asv_bench/benchmarks/inference.py:ToDatetimeFormat", "asv_bench/benchmarks/groupby.py:CountMultiDtype", "asv_bench/benchmarks/arithmetic.py:Ops2", "asv_bench/benchmarks/multiindex_object.py:SetOperations", "asv_bench/benchmarks/indexing.py:MultiIndexing", "pandas/_config/config.py:CallableDynamicDoc", "pandas/c