n;\n 166 |     - feature names validation.\n 167 | \n 168 |     Read more in the :ref:`User Guide <rolling_your_own_estimator>`.\n 169 | \n 170 | \n 171 |     Notes\n 172 |     -----\n 173 |     All estimators should specify all the parameters that can be set\n 174 |     at the class level in their ``__init__`` as explicit keyword\n 175 |     arguments (no ``*args`` or ``**kwargs``).\n 176 | \n 177 |     Examples\n 178 |     --------\n 179 |     >>> import numpy as np\n 180 |     >>> from sklearn.base import BaseEstimator\n 181 |     >>> class MyEstimator(BaseEstimator):\n 182 |     ...     def __init__(self, *, param=1):\n 183 |     ...         self.param = param\n 184 |     ...     def fit(self, X, y=None):\n 185 |     ...         self.is_fitted_ = True\n 186 |     ...         return self\n 187 |     ...     def predict(self, X):\n 188 |     ...         return np.full(shape=X.shape[0], fill_value=self.param)\n 189 |     >>> estimator = MyEstimator(param=2)\n 190 |     >>> estimator.get_params()\n 191 |     {'param': 2}\n 192 |     >>> X = np.array([[1, 2], [2, 3], [3, 4]])\n 193 |     >>> y = np.array([1, 0, 1])\n 194 |     >>> estimator.fit(X, y).predict(X)\n 195 |     array([2, 2, 2])\n 196 |     >>> estimator.set_params(param=3).fit(X, y).predict(X)\n 197 |     array([3, 3, 3])\n 198 |     \"\"\"\n 199 | \n 200 |     @classmethod\n 201 |     def _get_param_names(cls):\n 202 |         \"\"\"Get parameter names for the estimator\"\"\"\n 203 |         # fetch the constructor or the original constructor before\n 204 |         # deprecation wrapping if any\n 205 |         init = getattr(cls.__init__, \"deprecated_original\", cls.__init__)\n 206 |         if init is object.__init__:\n 207 |             # No explicit constructor to introspect\n 208 |             return []\n 209 | \n 210 |         # introspect the constructor arguments to find the model parameters\n 211 |         # to represent\n 212 |         init_signature = inspect.signature(init)\n 213 |         # Consider the constructor parameters excluding 'self'\n 214 |         parameters = [\n 215 |             p\n 216 |             for p in init_signature.parameters.values()\n 217 |             if p.name != \"self\" and p.kind != p.VAR_KEYWORD\n 218 |         ]\n 219 |         for p in parameters:\n 220 |             if p.kind == p.VAR_POSITIONAL:\n 221 |                 raise RuntimeError(\n 222 |                     \"scikit-learn estimators should always \"\n 223 |                     \"specify their parameters in the signature\"\n 224 |                     \" of their __init__ (no varargs).\"\n 225 |                     \" %s with constructor %s doesn't \"\n 226 |                     \" follow this convention.\" % (cls, init_signature)\n 227 |                 )\n 228 |         # Extract and sort argument names excluding 'self'\n 229 |         return sorted([p.name for p in parameters])\n 230 | \n 231 |     def get_params(self, deep=True):\n 232 |         \"\"\"\n 233 |         Get parameters for this estimator.\n 234 | \n 235 |         Parameters\n 236 |         ----------\n 237 |         deep : bool, default=True\n 238 |             If True, will return the parameters for this estimator and\n 239 |             contained subobjects that are estimators.\n 240 | \n 241 |         Returns\n 242 |         -------\n 243 |         params : dict\n 244 |             Parameter names mapped to their values.\n 245 |         \"\"\"\n 246 |         out = dict()\n 247 |         for key in self._get_param_names():\n 248 |             value = getattr(self, key)\n 249 |             if deep and hasattr(value, \"get_params\") and not isinstance(value, type):\n 250 |                 deep_items = value.get_params().items()\n 251 |                 out.update((key + \"__\" + k, val) for k, val in deep_items)\n 252 |             out[key] = value\n 253 |         return out\n 254 | \n 255 |     def set_params(self, **params):\n 256 |         \"\"\"Set the parameters of this estimator.\n 257 | \n 258 |         The method works on simple estimators as well as on nested objects\n 259 |         (such as :class:`~sklearn.pipeline.Pipeline`). The latter have\n 260 |         parameters of the form ``<component>__<parameter>`` so that it's\n 261 |         possible to update each component of a nested object.\n 262 | \n 263 |         Parameters\n 264 |         ----------\n 265 |         **params : dict\n 266 |             Estimator parameters.\n 267 | \n 268 |         Returns\n 269 |         -------\n 270 |         self : estimator instance\n 271 |             Estimator instance.\n 272 |         \"\"\"\n 273 |         if not params:\n 274 |             # Simple optimization to gain speed (inspect is slow)\n 275 |             return self\n 276 |         valid_params = self.get_params(deep=True)\n 277 | \n 278 |         nested_params = defaultdict(dict)  # grouped by prefix\n 279 |         for key, value in params.items():\n 280 |             key, delim, sub_key = key.partition(\"__\")\n 281 |             if key not in valid_params:\n 282 |                 local_valid_params = self._get_param_names()\n 283 |                 raise ValueError(\n 284 |                     f\"Invalid parameter {key!r} for estimator {self}. \"\n 285 |                     f\"Valid parameters are: {local_valid_params!r}.\"\n 286 |                 )\n 287 | \n 288 |             if delim:\n 289 |                 nested_params[key][sub_key] = value\n 290 |             else:\n 291 |                 setattr(self, key, value)\n 292 |                 valid_params[key] = value\n 293 | \n 294 |         for key, sub_params in nested_params.items():\n 295 |             valid_params[key].set_params(**sub_params)\n 296 | \n 297 |         return self\n 298 | \n 299 |     def __sklearn_clone__(self):\n 300 |         return _clone_parametrized(self)\n 301 | \n 302 |     def __repr__(self, N_CHAR_MAX=700):\n 303 |         # N_CHAR_MAX is the (approximate) maximum number of non-blank\n 304 |         # characters to render. We pass it as an optional parameter to ease\n 305 |         # the tests.\n 306 | \n 307 |         from .utils._pprint import _EstimatorPrettyPrinter\n 308 | \n 309 |         N_MAX_ELEMENTS_TO_SHOW = 30  # number of elements to show in sequences\n 310 | \n 311 |         # use ellipsis for sequences with a lot of elements\n 312 |         pp = _EstimatorPrettyPrinter(\n 313 |             compact=True,\n 314 |             indent=1,\n 315 |             indent_at_name=True,\n 316 |             n_max_elements_to_show=N_MAX_ELEMENTS_TO_SHOW,\n 317 |         )\n 318 | \n 319 |         repr_ = pp.pformat(self)\n 320 | \n 321 |         # Use bruteforce ellipsis when there are a lot of non-blank characters\n 322 |         n_nonblank = len(\"\".join(repr_.split()))\n 323 |         if n_nonblank > N_CHAR_MAX:\n 324 |             lim = N_CHAR_MAX // 2  # apprx number of chars to keep on both ends\n 325 |             regex = r\"^(\\s*\\S){%d}\" % lim\n 326 |             # The regex '^(\\s*\\S){%d}' % n\n 327 |             # matches from the start of the string until the nth non-blank\n 328 |             # character:\n 329 |             # - ^ matches the start of string\n 330 |             # - (pattern){n} matches n repetitions of pattern\n 331 |             # - \\s*\\S matches a non-blank char following zero or more blanks\n 332 |             left_lim = re.match(regex, repr_).end()\n 333 |             right_lim = re.match(regex, repr_[::-1]).end()\n 334 | \n 335 |             if \"\\n\" in repr_[left_lim:-right_lim]:\n 336 |                 # The left side and right side aren't on the same line.\n 337 |                 # To avoid weird cuts, e.g.:\n 338 |                 # categoric...ore',\n 339 |                 # we need to start the right side with an appropriate newline\n 340 |                 # character so that it renders properly as:\n 341 |                 # categoric...\n 342 |                 # handle_unknown='ignore',\n 343 |                 # so we add [^\\n]*\\n which matches until the next \\n\n 344 |                 regex += r\"[^\\n]*\\n\"\n 345 |                 right_lim = re.match(regex, repr_[::-1]).end()\n 346 | \n 347 |             ellipsis = \"...\"\n 348 |             if left_lim + len(ellipsis) < len(repr_) - right_lim:\n 349 |                 # Only add ellipsis if it results in a shorter repr\n 350 |                 repr_ = repr_[:left_lim] + \"...\" + repr_[-right_lim:]\n 351 | \n 352 |         return repr_\n 353 | \n 354 |     def __getstate__(self):\n 355 |         if getattr(self, \"__slots__\", None):\n 356 |             raise TypeError(\n 357 |                 \"You cannot use `__slots__` in objects inheriting from \"\n 358 |                 \"`sklearn.base.BaseEstimator`.\"\n 359 |             )\n 360 | \n 361 |         try:\n 362 |             state = super().__getstate__()\n 363 |             if state is None:\n 364 |                 # For Python 3.11+, empty instance (no `__slots__`,\n 365 |                 # and `__dict__`) will return a state equal to `None`.\n 366 |                 state = self.__dict__.copy()\n 367 |         except AttributeError:\n 368 |             # Python < 3.11\n 369 |             state = self.__dict__.copy()\n 370 | \n 371 |         if type(self).__module__.startswith(\"sklearn.\"):\n 372 |             return dict(state.items(), _sklearn_version=__version__)\n 373 |         else:\n 374 |             return state\n 375 | \n 376 |     def __setstate__(self, state):\n 377 |         if type(self).__module__.startswith(\"sklearn.\"):\n 378 |             pickle_version = state.pop(\"_sklearn_version\", \"pre-0.18\")\n 379 |             if pickle_version != __version__:\n 380 |                 warnings.warn(\n 381 |                     InconsistentVersionWarning(\n 382 |                         estimator_name=self.__class__.__name__,\n 383 |                         current_sklearn_version=__version__,\n 384 |                         original_sklearn_version=pickle_version,\n 385 |                     ),\n 386 |                 )\n 387 |         try:\n 388 |             super().__setstate__(state)\n 389 |         except AttributeError:\n 390 |             self.__dict__.update(state)\n 391 | \n 392 |     def __sklearn_tags__(self):\n 393 |         return Tags(\n 394 |             estimator_type=None,\n 395 |             target_tags=TargetTags(required=False),\n 396 |             transformer_tags=None,\n 397 |             regressor_tags=None,\n 398 |             classifier_tags=None,\n 399 |         )\n 400 | \n 401 |     def _validate_params(self):\n 402 |         \"\"\"Validate types and values of constructor parameters\n 403 | \n 404 |         The expected type and values must be defined in the `_parameter_constraints`\n 405 |         class attribute, which is a dictionary `param_name: list of constraints`. See\n 406 |         the docstring of `validate_parameter_constraints` for a description of the\n 407 |         accepted constraints.\n 408 |         \"\"\"\n 409 |         validate_parameter_constraints(\n 410 |             self._parameter_constraints,\n 411 |             self.get_params(deep=False),\n 412 |             caller_name=self.__class__.__name__,\n 413 |         )\n 414 | \n 415 |     @property\n 416 |     def _repr_html_(self):\n 417 |         \"\"\"HTML representation of estimator.\n 418 | \n 419 |         This is redundant with the logic of `_repr_mimebundle_`. The latter\n 420 |         should be favorted in the long term, `_repr_html_` is only\n 421 |         implemented for consumers who do not interpret `_repr_mimbundle_`.\n 422 |         \"\"\"\n 423 |         if get_config()[\"display\"] != \"diagram\":\n 424 |             raise AttributeError(\n 425 |                 \"_repr_html_ is only defined when the \"\n 426 |                 \"'display' configuration option is set to \"\n 427 |                 \"'diagram'\"\n 428 |             )\n 429 |         return self._repr_html_inner\n 430 | \n 431 |     def _repr_html_inner(self):\n 432 |         \"\"\"This function is returned by the @property `_repr_html_` to make\n 433 |         `hasattr(estimator, \"_repr_html_\") return `True` or `False` depending\n 434 |         on `get_config()[\"display\"]`.\n 435 |         \"\"\"\n 436 |         return estimator_html_repr(self)\n 437 | \n 438 |     def _repr_mimebundle_(self, **kwargs):\n 439 |         \"\"\"Mime bundle used by jupyter kernels to display estimator\"\"\"\n 440 |         output = {\"text/plain\": repr(self)}\n 441 |         if get_config()[\"display\"] == \"diagram\":\n 442 |             output[\"text/html\"] = estimator_html_repr(self)\n 443 |         return output\n 444 | \n 445 |     # TODO(1.7): Remove this method\n 446 |     def _validate_data(self, *args, **kwargs):\n 447 |         warnings.warn(\n 448 |             \"`BaseEstimator._validate_data` is deprecated in 1.6 and will be removed \"\n 449 |             \"in 1.7. Use `sklearn.utils.validation.validate_data` instead. This \"\n 450 |             \"function becomes public and is part of the scikit-learn developer API.\",\n 451 |             FutureWarning,\n 452 |         )\n 453 |         return validate_data(self, *args, **kwargs)\n 454 | \n 455 |     # TODO(1.7): Remove this method\n 456 |     def _check_n_features(self, *args, **kwargs):\n 457 |         warnings.warn(\n 458 |             \"`BaseEstimator._check_n_features` is deprecated in 1.6 and will be \"\n 459 |             \"removed in 1.7. Use `sklearn.utils.validation._check_n_features` instead.\",\n 460 |             FutureWarning,\n 461 |         )\n 462 |         _check_n_features(self, *args, **kwargs)\n 463 | \n 464 |     # TODO(1.7): Remove this method\n 465 |     def _check_feature_names(self, *args, **kwargs):\n 466 |         warnings.warn(\n 467 |             \"`BaseEstimator._check_feature_names` is deprecated in 1.6 and will be \"\n 468 |             \"removed in 1.7. Use `sklearn.utils.validation._check_feature_names` \"\n 469 |             \"instead.\",\n 470 |             FutureWarning,\n 471 |         )\n 472 |         _check_feature_names(self, *args, **kwargs)\n 473 | \n 474 | \n 475 | class ClassifierMixin:\n 476 |     \"\"\"Mixin class for all classifiers in scikit-learn.\n 477 | \n 478 |     This mixin defines the following functionality:\n 479 | \n 480 |     - set estimator type to `\"classifier\"` through the `estimator_type` tag;\n 481 |     - `score` method that default to :func:`~sklearn.metrics.accuracy_score`.\n 482 |     - enforce that `fit` requires `y` to be passed through the `requires_y` tag,\n 483 |       which is done by setting the classifier type tag.\n 484 | \n 485 |     Read more in the :ref:`User Guide <rolling_your_own_estimator>`.\n 486 | \n 487 |     Examples\n 488 |     --------\n 489 |     >>> import numpy as np\n 490 |     >>> from sklearn.base import BaseEstimator, ClassifierMixin\n 491 |     >>> # Mixin classes should always be on the left-hand side for a correct MRO\n 492 |     >>> class MyEstimator(ClassifierMixin, BaseEstimator):\n 493 |     ...     def __init__(self, *, param=1):\n 494 |     ...         self.param = param\n 495 |     ...     def fit(self, X, y=None):\n 496 |     ...         self.is_fitted_ = True\n 497 |     ...         return self\n 498 |     ...     def predict(self, X):\n 499 |     ...         return np.full(shape=X.shape[0], fill_value=self.param)\n 500 |     >>> estimator = MyEstimator(param=1)\n 501 |     >>> X = np.array([[1, 2], [2, 3], [3, 4]])\n 502 |     >>> y = np.array([1, 0, 1])\n 503 |     >>> estimator.fit(X, y).predict(X)\n 504 |     array([1, 1, 1])\n 505 |     >>> estimator.score(X, y)\n 506 |     0.66...\n 507 |     \"\"\"\n 508 | \n 509 |     # TODO(1.8): Remove this attribute\n 510 |     _estimator_type = \"classifier\"\n 511 | \n 512 |     def __sklearn_tags__(self):\n 513 |         tags = super().__sklearn_tags__()\n 514 |         tags.estimator_type = \"classifier\"\n 515 |         tags.classifier_tags = ClassifierTags()\n 516 |         tags.target_tags.required = True\n 517 |         return tags\n 518 | \n 519 |     def score(self, X, y, sample_weight=None):\n 520 |         \"\"\"\n 521 |         Return the mean accuracy on the given test data and labels.\n 522 | \n 523 |         In multi-label classification, this is the subset accuracy\n 524 |         which is a harsh metric since you require for each sample that\n 525 |         each label set be correctly predicted.\n 526 | \n 527 |         Parameters\n 528 |         ----------\n 529 |         X : array-like of shape (n_samples, n_features)\n 530 |             Test samples.\n 531 | \n 532 |         y : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 533 |             True labels for `X`.\n 534 | \n 535 |         sample_weight : array-like of shape (n_samples,), default=None\n 536 |             Sample weights.\n 537 | \n 538 |         Returns\n 539 |         -------\n 540 |         score : float\n 541 |             Mean accuracy of ``self.predict(X)`` w.r.t. `y`.\n 542 |         \"\"\"\n 543 |         from .metrics import accuracy_score\n 544 | \n 545 |         return accuracy_score(y, self.predict(X), sample_weight=sample_weight)\n 546 | \n 547 | \n 548 | class RegressorMixin:\n 549 |     \"\"\"Mixin class for all regression estimators in scikit-learn.\n 550 | \n 551 |     This mixin defines the following functionality:\n 552 | \n 553 |     - set estimator type to `\"regressor\"` through the `estimator_type` tag;\n 554 |     - `score` method that default to :func:`~sklearn.metrics.r2_score`.\n 555 |     - enforce that `fit` requires `y` to be passed through the `requires_y` tag,\n 556 |       which is done by setting the regressor type tag.\n 557 | \n 558 |     Read more in the :ref:`User Guide <rolling_your_own_estimator>`.\n 559 | \n 560 |     Examples\n 561 |     --------\n 562 |     >>> import numpy as np\n 563 |     >>> from sklearn.base import BaseEstimator, RegressorMixin\n 564 |     >>> # Mixin classes should always be on the left-hand side for a correct MRO\n 565 |     >>> class MyEstimator(RegressorMixin, BaseEstimator):\n 566 |     ...     def __init__(self, *, param=1):\n 567 |     ...         self.param = param\n 568 |     ...     def fit(self, X, y=None):\n 569 |     ...         self.is_fitted_ = True\n 570 |     ...         return self\n 571 |     ...     def predict(self, X):\n 572 |     ...         return np.full(shape=X.shape[0], fill_value=self.param)\n 573 |     >>> estimator = MyEstimator(param=0)\n 574 |     >>> X = np.array([[1, 2], [2, 3], [3, 4]])\n 575 |     >>> y = np.array([-1, 0, 1])\n 576 |     >>> estimator.fit(X, y).predict(X)\n 577 |     array([0, 0, 0])\n 578 |     >>> estimator.score(X, y)\n 579 |     0.0\n 580 |     \"\"\"\n 581 | \n 582 |     # TODO(1.8): Remove this attribute\n 583 |     _estimator_type = \"regressor\"\n 584 | \n 585 |     def __sklearn_tags__(self):\n 586 |         tags = super().__sklearn_tags__()\n 587 |         tags.estimator_type = \"regressor\"\n 588 |         tags.regressor_tags = RegressorTags()\n 589 |         tags.target_tags.required = True\n 590 |         return tags\n 591 | \n 592 |     def score(self, X, y, sample_weight=None):\n 593 |         \"\"\"Return the coefficient of determination of the prediction.\n 594 | \n 595 |         The coefficient of determination :math:`R^2` is defined as\n 596 |         :math:`(1 - \\\\frac{u}{v})`, where :math:`u` is the residual\n 597 |         sum of squares ``((y_true - y_pred)** 2).sum()`` and :math:`v`\n 598 |         is the total sum of squares ``((y_true - y_true.mean()) ** 2).sum()``.\n 599 |         The best possible score is 1.0 and it can be negative (because the\n 600 |         model can be arbitrarily worse). A constant model that always predicts\n 601 |         the expected value of `y`, disregarding the input features, would get\n 602 |         a :math:`R^2` score of 0.0.\n 603 | \n 604 |         Parameters\n 605 |         ----------\n 606 |         X : array-like of shape (n_samples, n_features)\n 607 |             Test samples. For some estimators this may be a precomputed\n 608 |             kernel matrix or a list of generic objects instead with shape\n 609 |             ``(n_samples, n_samples_fitted)``, where ``n_samples_fitted``\n 610 |             is the number of samples used in the fitting for the estimator.\n 611 | \n 612 |         y : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 613 |             True values for `X`.\n 614 | \n 615 |         sample_weight : array-like of shape (n_samples,), default=None\n 616 |             Sample weights.\n 617 | \n 618 |         Returns\n 619 |         -------\n 620 |         score : float\n 621 |             :math:`R^2` of ``self.predict(X)`` w.r.t. `y`.\n 622 | \n 623 |         Notes\n 624 |         -----\n 625 |         The :math:`R^2` score used when calling ``score`` on a regressor uses\n 626 |         ``multioutput='uniform_average'`` from version 0.23 to keep consistent\n 627 |         with default value of :func:`~sklearn.metrics.r2_score`.\n 628 |         This influences the ``score`` method of all the multioutput\n 629 |         regressors (except for\n 630 |         :class:`~sklearn.multioutput.MultiOutputRegressor`).\n 631 |         \"\"\"\n 632 | \n 633 |         from .metrics import r2_score\n 634 | \n 635 |         y_pred = self.predict(X)\n 636 |         return r2_score(y, y_pred, sample_weight=sample_weight)\n 637 | \n 638 | \n 639 | class ClusterMixin:\n 640 |     \"\"\"Mixin class for all cluster estimators in scikit-learn.\n 641 | \n 642 |     - set estimator type to `\"clusterer\"` through the `estimator_type` tag;\n 643 |     - `fit_predict` method returning the cluster labels associated to each sample.\n 644 | \n 645 |     Examples\n 646 |     --------\n 647 |     >>> import numpy as np\n 648 |     >>> from sklearn.base import BaseEstimator, ClusterMixin\n 649 |     >>> class MyClusterer(ClusterMixin, BaseEstimator):\n 650 |     ...     def fit(self, X, y=None):\n 651 |     ...         self.labels_ = np.ones(shape=(len(X),), dtype=np.int64)\n 652 |     ...         return self\n 653 |     >>> X = [[1, 2], [2, 3], [3, 4]]\n 654 |     >>> MyClusterer().fit_predict(X)\n 655 |     array([1, 1, 1])\n 656 |     \"\"\"\n 657 | \n 658 |     # TODO(1.8): Remove this attribute\n 659 |     _estimator_type = \"clusterer\"\n 660 | \n 661 |     def __sklearn_tags__(self):\n 662 |         tags = super().__sklearn_tags__()\n 663 |         tags.estimator_type = \"clusterer\"\n 664 |         if tags.transformer_tags is not None:\n 665 |             tags.transformer_tags.preserves_dtype = []\n 666 |         return tags\n 667 | \n 668 |     def fit_predict(self, X, y=None, **kwargs):\n 669 |         \"\"\"\n 670 |         Perform clustering on `X` and returns cluster labels.\n 671 | \n 672 |         Parameters\n 673 |         ----------\n 674 |         X : array-like of shape (n_samples, n_features)\n 675 |             Input data.\n 676 | \n 677 |         y : Ignored\n 678 |             Not used, present for API consistency by convention.\n 679 | \n 680 |         **kwargs : dict\n 681 |             Arguments to be passed to ``fit``.\n 682 | \n 683 |             .. versionadded:: 1.4\n 684 | \n 685 |         Returns\n 686 |         -------\n 687 |         labels : ndarray of shape (n_samples,), dtype=np.int64\n 688 |             Cluster labels.\n 689 |         \"\"\"\n 690 |         # non-optimized default implementation; override when a better\n 691 |         # method is possible for a given clustering algorithm\n 692 |         self.fit(X, **kwargs)\n 693 |         return self.labels_\n 694 | \n 695 | \n 696 | class BiclusterMixin:\n 697 |     \"\"\"Mixin class for all bicluster estimators in scikit-learn.\n 698 | \n 699 |     This mixin defines the following functionality:\n 700 | \n 701 |     - `biclusters_` property that returns the row and column indicators;\n 702 |     - `get_indices` method that returns the row and column indices of a bicluster;\n 703 |     - `get_shape` method that returns the shape of a bicluster;\n 704 |     - `get_submatrix` method that returns the submatrix corresponding to a bicluster.\n 705 | \n 706 |     Examples\n 707 |     --------\n 708 |     >>> import numpy as np\n 709 |     >>> from sklearn.base import BaseEstimator, BiclusterMixin\n 710 |     >>> class DummyBiClustering(BiclusterMixin, BaseEstimator):\n 711 |     ...     def fit(self, X, y=None):\n 712 |     ...         self.rows_ = np.ones(shape=(1, X.shape[0]), dtype=bool)\n 713 |     ...         self.columns_ = np.ones(shape=(1, X.shape[1]), dtype=bool)\n 714 |     ...         return self\n 715 |     >>> X = np.array([[1, 1], [2, 1], [1, 0],\n 716 |     ...               [4, 7], [3, 5], [3, 6]])\n 717 |     >>> bicluster = DummyBiClustering().fit(X)\n 718 |     >>> hasattr(bicluster, \"biclusters_\")\n 719 |     True\n 720 |     >>> bicluster.get_indices(0)\n 721 |     (array([0, 1, 2, 3, 4, 5]), array([0, 1]))\n 722 |     \"\"\"\n 723 | \n 724 |     @property\n 725 |     def biclusters_(self):\n 726 |         \"\"\"Convenient way to get row and column indicators together.\n 727 | \n 728 |         Returns the ``rows_`` and ``columns_`` members.\n 729 |         \"\"\"\n 730 |         return self.rows_, self.columns_\n 731 | \n 732 |     def get_indices(self, i):\n 733 |         \"\"\"Row and column indices of the `i`'th bicluster.\n 734 | \n 735 |         Only works if ``rows_`` and ``columns_`` attributes exist.\n 736 | \n 737 |         Parameters\n 738 |         ----------\n 739 |         i : int\n 740 |             The index of the cluster.\n 741 | \n 742 |         Returns\n 743 |         -------\n 744 |         row_ind : ndarray, dtype=np.intp\n 745 |             Indices of rows in the dataset that belong to the bicluster.\n 746 |         col_ind : ndarray, dtype=np.intp\n 747 |             Indices of columns in the dataset that belong to the bicluster.\n 748 |         \"\"\"\n 749 |         rows = self.rows_[i]\n 750 |         columns = self.columns_[i]\n 751 |         return np.nonzero(rows)[0], np.nonzero(columns)[0]\n 752 | \n 753 |     def get_shape(self, i):\n 754 |         \"\"\"Shape of the `i`'th bicluster.\n 755 | \n 756 |         Parameters\n 757 |         ----------\n 758 |         i : int\n 759 |             The index of the cluster.\n 760 | \n 761 |         Returns\n 762 |         -------\n 763 |         n_rows : int\n 764 |             Number of rows in the bicluster.\n 765 | \n 766 |         n_cols : int\n 767 |             Number of columns in the bicluster.\n 768 |         \"\"\"\n 769 |         indices = self.get_indices(i)\n 770 |         return tuple(len(i) for i in indices)\n 771 | \n 772 |     def get_submatrix(self, i, data):\n 773 |         \"\"\"Return the submatrix corresponding to bicluster `i`.\n 774 | \n 775 |         Parameters\n 776 |         ----------\n 777 |         i : int\n 778 |             The index of the cluster.\n 779 |         data : array-like of shape (n_samples, n_features)\n 780 |             The data.\n 781 | \n 782 |         Returns\n 783 |         -------\n 784 |         submatrix : ndarray of shape (n_rows, n_cols)\n 785 |             The submatrix corresponding to bicluster `i`.\n 786 | \n 787 |         Notes\n 788 |         -----\n 789 |         Works with sparse matrices. Only works if ``rows_`` and\n 790 |         ``columns_`` attributes exist.\n 791 |         \"\"\"\n 792 | \n 793 |         data = check_array(data, accept_sparse=\"csr\")\n 794 |         row_ind, col_ind = self.get_indices(i)\n 795 |         return data[row_ind[:, np.newaxis], col_ind]\n 796 | \n 797 | \n 798 | class TransformerMixin(_SetOutputMixin):\n 799 |     \"\"\"Mixin class for all transformers in scikit-learn.\n 800 | \n 801 |     This mixin defines the following functionality:\n 802 | \n 803 |     - a `fit_transform` method that delegates to `fit` and `transform`;\n 804 |     - a `set_output` method to output `X` as a specific container type.\n 805 | \n 806 |     If :term:`get_feature_names_out` is defined, then :class:`BaseEstimator` will\n 807 |     automatically wrap `transform` and `fit_transform` to follow the `set_output`\n 808 |     API. See the :ref:`developer_api_set_output` for details.\n 809 | \n 810 |     :class:`OneToOneFeatureMixin` and\n 811 |     :class:`ClassNamePrefixFeaturesOutMixin` are helpful mixins for\n 812 |     defining :term:`get_feature_names_out`.\n 813 | \n 814 |     Examples\n 815 |     --------\n 816 |     >>> import numpy as np\n 817 |     >>> from sklearn.base import BaseEstimator, TransformerMixin\n 818 |     >>> class MyTransformer(TransformerMixin, BaseEstimator):\n 819 |     ...     def __init__(self, *, param=1):\n 820 |     ...         self.param = param\n 821 |     ...     def fit(self, X, y=None):\n 822 |     ...         return self\n 823 |     ...     def transform(self, X):\n 824 |     ...         return np.full(shape=len(X), fill_value=self.param)\n 825 |     >>> transformer = MyTransformer()\n 826 |     >>> X = [[1, 2], [2, 3], [3, 4]]\n 827 |     >>> transformer.fit_transform(X)\n 828 |     array([1, 1, 1])\n 829 |     \"\"\"\n 830 | \n 831 |     def __sklearn_tags__(self):\n 832 |         tags = super().__sklearn_tags__()\n 833 |         tags.transformer_tags = TransformerTags()\n 834 |         return tags\n 835 | \n 836 |     def fit_transform(self, X, y=None, **fit_params):\n 837 |         \"\"\"\n 838 |         Fit to data, then transform it.\n 839 | \n 840 |         Fits transformer to `X` and `y` with optional parameters `fit_params`\n 841 |         and returns a transformed version of `X`.\n 842 | \n 843 |         Parameters\n 844 |         ----------\n 845 |         X : array-like of shape (n_samples, n_features)\n 846 |             Input samples.\n 847 | \n 848 |         y :  array-like of shape (n_samples,) or (n_samples, n_outputs), \\\n 849 |                 default=None\n 850 |             Target values (None for unsupervised transformations).\n 851 | \n 852 |         **fit_params : dict\n 853 |             Additional fit parameters.\n 854 | \n 855 |         Returns\n 856 |         -------\n 857 |         X_new : ndarray array of shape (n_samples, n_features_new)\n 858 |             Transformed array.\n 859 |         \"\"\"\n 860 |         # non-optimized default implementation; override when a better\n 861 |         # method is possible for a given clustering algorithm\n 862 | \n 863 |         # we do not route parameters here, since consumers don't route. But\n 864 |         # since it's possible for a `transform` method to also consume\n 865 |         # metadata, we check if that's the case, and we raise a warning telling\n 866 |         # users that they should implement a custom `fit_transform` method\n 867 |         # to forward metadata to `transform` as well.\n 868 |         #\n 869 |         # For that, we calculate routing and check if anything would be routed\n 870 |         # to `transform` if we were to route them.\n 871 |         if _routing_enabled():\n 872 |             transform_params = self.get_metadata_routing().consumes(\n 873 |                 method=\"transform\", params=fit_params.keys()\n 874 |             )\n 875 |             if transform_params:\n 876 |                 warnings.warn(\n 877 |                     (\n 878 |                         f\"This object ({self.__class__.__name__}) has a `transform`\"\n 879 |                         \" method which consumes metadata, but `fit_transform` does not\"\n 880 |                         \" forward metadata to `transform`. Please implement a custom\"\n 881 |                         \" `fit_transform` method to forward metadata to `transform` as\"\n 882 |                         \" well. Alternatively, you can explicitly do\"\n 883 |                         \" `set_transform_request`and set all values to `False` to\"\n 884 |                         \" disable metadata routed to `transform`, if that's an option.\"\n 885 |                     ),\n 886 |                     UserWarning,\n 887 |                 )\n 888 | \n 889 |         if y is None:\n 890 |             # fit method of arity 1 (unsupervised transformation)\n 891 |             return self.fit(X, **fit_params).transform(X)\n 892 |         else:\n 893 |             # fit method of arity 2 (supervised transformation)\n 894 |             return self.fit(X, y, **fit_params).transform(X)\n 895 | \n 896 | \n 897 | class OneToOneFeatureMixin:\n 898 |     \"\"\"Provides `get_feature_names_out` for simple transformers.\n 899 | \n 900 |     This mixin assumes there's a 1-to-1 correspondence between input features\n 901 |     and output features, such as :class:`~sklearn.preprocessing.StandardScaler`.\n 902 | \n 903 |     Examples\n 904 |     --------\n 905 |     >>> import numpy as np\n 906 |     >>> from sklearn.base import OneToOneFeatureMixin, BaseEstimator\n 907 |     >>> class MyEstimator(OneToOneFeatureMixin, BaseEstimator):\n 908 |     ...     def fit(self, X, y=None):\n 909 |     ...         self.n_features_in_ = X.shape[1]\n 910 |     ...         return self\n 911 |     >>> X = np.array([[1, 2], [3, 4]])\n 912 |     >>> MyEstimator().fit(X).get_feature_names_out()\n 913 |     array(['x0', 'x1'], dtype=object)\n 914 |     \"\"\"\n 915 | \n 916 |     def get_feature_names_out(self, input_features=None):\n 917 |         \"\"\"Get output feature names for transformation.\n 918 | \n 919 |         Parameters\n 920 |         ----------\n 921 |         input_features : array-like of str or None, default=None\n 922 |             Input features.\n 923 | \n 924 |             - If `input_features` is `None`, then `feature_names_in_` is\n 925 |               used as feature names in. If `feature_names_in_` is not defined,\n 926 |               then the following input feature names are generated:\n 927 |               `[\"x0\", \"x1\", ..., \"x(n_features_in_ - 1)\"]`.\n 928 |             - If `input_features` is an array-like, then `input_features` must\n 929 |               match `feature_names_in_` if `feature_names_in_` is defined.\n 930 | \n 931 |         Returns\n 932 |         -------\n 933 |         feature_names_out : ndarray of str objects\n 934 |             Same as input features.\n 935 |         \"\"\"\n 936 |         # Note that passing attributes=\"n_features_in_\" forces check_is_fitted\n 937 |         # to check if the attribute is present. Otherwise it will pass on\n 938 |         # stateless estimators (requires_fit=False)\n 939 |         check_is_fitted(self, attributes=\"n_features_in_\")\n 940 |         return _check_feature_names_in(self, input_features)\n 941 | \n 942 | \n 943 | class ClassNamePrefixFeaturesOutMixin:\n 944 |     \"\"\"Mixin class for transformers that generate their own names by prefixing.\n 945 | \n 946 |     This mixin is useful when the transformer needs to generate its own feature\n 947 |     names out, such as :class:`~sklearn.decomposition.PCA`. For example, if\n 948 |     :class:`~sklearn.decomposition.PCA` outputs 3 features, then the generated feature\n 949 |     names out are: `[\"pca0\", \"pca1\", \"pca2\"]`.\n 950 | \n 951 |     This mixin assumes that a `_n_features_out` attribute is defined when the\n 952 |     transformer is fitted. `_n_features_out` is the number of output features\n 953 |     that the transformer will return in `transform` of `fit_transform`.\n 954 | \n 955 |     Examples\n 956 |     --------\n 957 |     >>> import numpy as np\n 958 |     >>> from sklearn.base import ClassNamePrefixFeaturesOutMixin, BaseEstimator\n 959 |     >>> class MyEstimator(ClassNamePrefixFeaturesOutMixin, BaseEstimator):\n 960 |     ...     def fit(self, X, y=None):\n 961 |     ...         self._n_features_out = X.shape[1]\n 962 |     ...         return self\n 963 |     >>> X = np.array([[1, 2], [3, 4]])\n 964 |     >>> MyEstimator().fit(X).get_feature_names_out()\n 965 |     array(['myestimator0', 'myestimator1'], dtype=object)\n 966 |     \"\"\"\n 967 | \n 968 |     def get_feature_names_out(self, input_features=None):\n 969 |         \"\"\"Get output feature names for transformation.\n 970 | \n 971 |         The feature names out will prefixed by the lowercased class name. For\n 972 |         example, if the transformer outputs 3 features, then the feature names\n 973 |         out are: `[\"class_name0\", \"class_name1\", \"class_name2\"]`.\n 974 | \n 975 |         Parameters\n 976 |         ----------\n 977 |         input_features : array-like of str or None, default=None\n 978 |             Only used to validate feature names with the names seen in `fit`.\n 979 | \n 980 |         Returns\n 981 |         -------\n 982 |         feature_names_out : ndarray of str objects\n 983 |             Transformed feature names.\n 984 |         \"\"\"\n 985 |         check_is_fitted(self, \"_n_features_out\")\n 986 |         return _generate_get_feature_names_out(\n 987 |             self, self._n_features_out, input_features=input_features\n 988 |         )\n 989 | \n 990 | \n 991 | class DensityMixin:\n 992 |     \"\"\"Mixin class for all density estimators in scikit-learn.\n 993 | \n 994 |     This mixin defines the following functionality:\n 995 | \n 996 |     - sets estimator type to `\"density_estimator\"` through the `estimator_type` tag;\n 997 |     - `score` method that default that do no-op.\n 998 | \n 999 |     Examples\n1000 |     --------\n1001 |     >>> from sklearn.base import DensityMixin\n1002 |     >>> class MyEstimator(DensityMixin):\n1003 |     ...     def fit(self, X, y=None):\n1004 |     ...         self.is_fitted_ = True\n1005 |     ...         return self\n1006 |     >>> estimator = MyEstimator()\n1007 |     >>> hasattr(estimator, \"score\")\n1008 |     True\n1009 |     \"\"\"\n1010 | \n1011 |     # TODO(1.8): Remove this attribute\n1012 |     _estimator_type = \"DensityEstimator\"\n1013 | \n1014 |     def __sklearn_tags__(self):\n1015 |         tags = super().__sklearn_tags__()\n1016 |         tags.estimator_type = \"density_estimator\"\n1017 |         return tags\n1018 | \n1019 |     def score(self, X, y=None):\n1020 |         \"\"\"Return the score of the model on the data `X`.\n1021 | \n1022 |         Parameters\n1023 |         ----------\n1024 |         X : array-like of shape (n_samples, n_features)\n1025 |             Test samples.\n1026 | \n1027 |         y : Ignored\n1028 |             Not used, present for API consistency by convention.\n1029 | \n1030 |         Returns\n1031 |         -------\n1032 |         score : float\n1033 |         \"\"\"\n1034 |         pass\n1035 | \n1036 | \n1037 | class OutlierMixin:\n1038 |     \"\"\"Mixin class for all outlier detection estimators in scikit-learn.\n1039 | \n1040 |     This mixin defines the following functionality:\n1041 | \n1042 |     - set estimator type to `\"outlier_detector\"` through the `estimator_type` tag;\n1043 |     - `fit_predict` method that default to `fit` and `predict`.\n1044 | \n1045 |     Examples\n1046 |     --------\n1047 |     >>> import numpy as np\n1048 |     >>> from sklearn.base import BaseEstimator, OutlierMixin\n1049 |     >>> class MyEstimator(OutlierMixin):\n1050 |     ...     def fit(self, X, y=None):\n1051 |     ...         self.is_fitted_ = True\n1052 |     ...         return self\n1053 |     ...     def predict(self, X):\n1054 |     ...         return np.ones(shape=len(X))\n1055 |     >>> estimator = MyEstimator()\n1056 |     >>> X = np.array([[1, 2], [2, 3], [3, 4]])\n1057 |     >>> estimator.fit_predict(X)\n1058 |     array([1., 1., 1.])\n1059 |     \"\"\"\n1060 | \n1061 |     # TODO(1.8): Remove this attribute\n1062 |     _estimator_type = \"outlier_detector\"\n1063 | \n1064 |     def __sklearn_tags__(self):\n1065 |         tags = super().__sklearn_tags__()\n1066 |         tags.estimator_type = \"outlier_detector\"\n1067 |         return tags\n1068 | \n1069 |     def fit_predict(self, X, y=None, **kwargs):\n1070 |         \"\"\"Perform fit on X and returns labels for X.\n1071 | \n1072 |         Returns -1 for outliers and 1 for inliers.\n1073 | \n1074 |         Parameters\n1075 |         ----------\n1076 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1077 |             The input samples.\n1078 | \n1079 |         y : Ignored\n1080 |             Not used, present for API consistency by convention.\n1081 | \n1082 |         **kwargs : dict\n1083 |             Arguments to be passed to ``fit``.\n1084 | \n1085 |             .. versionadded:: 1.4\n1086 | \n1087 |         Returns\n1088 |         -------\n1089 |         y : ndarray of shape (n_samples,)\n1090 |             1 for inliers, -1 for outliers.\n1091 |         \"\"\"\n1092 |         # we do not route parameters here, since consumers don't route. But\n1093 |         # since it's possible for a `predict` method to also consume\n1094 |         # metadata, we check if that's the case, and we raise a warning telling\n1095 |         # users that they should implement a custom `fit_predict` method\n1096 |         # to forward metadata to `predict` as well.\n1097 |         #\n1098 |         # For that, we calculate routing and check if anything would be routed\n1099 |         # to `predict` if we were to route them.\n1100 |         if _routing_enabled():\n1101 |             transform_params = self.get_metadata_routing().consumes(\n1102 |                 method=\"predict\", params=kwargs.keys()\n1103 |             )\n1104 |             if transform_params:\n1105 |                 warnings.warn(\n1106 |                     (\n1107 |                         f\"This object ({self.__class__.__name__}) has a `predict` \"\n1108 |                         \"method which consumes metadata, but `fit_predict` does not \"\n1109 |                         \"forward metadata to `predict`. Please implement a custom \"\n1110 |                         \"`fit_predict` method to forward metadata to `predict` as well.\"\n1111 |                         \"Alternatively, you can explicitly do `set_predict_request`\"\n1112 |                         \"and set all values to `False` to disable metadata routed to \"\n1113 |                         \"`predict`, if that's an option.\"\n1114 |                     ),\n1115 |                     UserWarning,\n1116 |                 )\n1117 | \n1118 |         # override for transductive outlier detectors like LocalOulierFactor\n1119 |         return self.fit(X, **kwargs).predict(X)\n1120 | \n1121 | \n1122 | class MetaEstimatorMixin:\n1123 |     \"\"\"Mixin class for all meta estimators in scikit-learn.\n1124 | \n1125 |     This mixin is empty, and only exists to indicate that the estimator is a\n1126 |     meta-estimator.\n1127 | \n1128 |     .. versionchanged:: 1.6\n1129 |         The `_required_parameters` is now removed and is unnecessary since tests are\n1130 |         refactored and don't use this anymore.\n1131 | \n1132 |     Examples\n1133 |     --------\n1134 |     >>> from sklearn.base import MetaEstimatorMixin\n1135 |     >>> from sklearn.datasets import load_iris\n1136 |     >>> from sklearn.linear_model import LogisticRegression\n1137 |     >>> class MyEstimator(MetaEstimatorMixin):\n1138 |     ...     def __init__(self, *, estimator=None):\n1139 |     ...         self.estimator = estimator\n1140 |     ...     def fit(self, X, y=None):\n1141 |     ...         if self.estimator is None:\n1142 |     ...             self.estimator_ = LogisticRegression()\n1143 |     ...         else:\n1144 |     ...             self.estimator_ = self.estimator\n1145 |     ...         return self\n1146 |     >>> X, y = load_iris(return_X_y=True)\n1147 |     >>> estimator = MyEstimator().fit(X, y)\n1148 |     >>> estimator.estimator_\n1149 |     LogisticRegression()\n1150 |     \"\"\"\n1151 | \n1152 | \n1153 | class MultiOutputMixin:\n1154 |     \"\"\"Mixin to mark estimators that support multioutput.\"\"\"\n1155 | \n1156 |     def __sklearn_tags__(self):\n1157 |         tags = super().__sklearn_tags__()\n1158 |         tags.target_tags.multi_output = True\n1159 |         return tags\n1160 | \n1161 | \n1162 | class _UnstableArchMixin:\n1163 |     \"\"\"Mark estimators that are non-determinstic on 32bit or PowerPC\"\"\"\n1164 | \n1165 |     def __sklearn_tags__(self):\n1166 |         tags = super().__sklearn_tags__()\n1167 |         tags.non_deterministic = _IS_32BIT or platform.machine().startswith(\n1168 |             (\"ppc\", \"powerpc\")\n1169 |         )\n1170 |         return tags\n1171 | \n1172 | \n1173 | def is_classifier(estimator):\n1174 |     \"\"\"Return True if the given estimator is (probably) a classifier.\n1175 | \n1176 |     Parameters\n1177 |     ----------\n1178 |     estimator : object\n1179 |         Estimator object to test.\n1180 | \n1181 |     Returns\n1182 |     -------\n1183 |     out : bool\n1184 |         True if estimator is a classifier and False otherwise.\n1185 | \n1186 |     Examples\n1187 |     --------\n1188 |     >>> from sklearn.base import is_classifier\n1189 |     >>> from sklearn.cluster import KMeans\n1190 |     >>> from sklearn.svm import SVC, SVR\n1191 |     >>> classifier = SVC()\n1192 |     >>> regressor = SVR()\n1193 |     >>> kmeans = KMeans()\n1194 |     >>> is_classifier(classifier)\n1195 |     True\n1196 |     >>> is_classifier(regressor)\n1197 |     False\n1198 |     >>> is_classifier(kmeans)\n1199 |     False\n1200 |     \"\"\"\n1201 |     # TODO(1.8): Remove this check\n1202 |     if isinstance(estimator, type):\n1203 |         warnings.warn(\n1204 |             f\"passing a class to {print(inspect.stack()[0][3])} is deprecated and \"\n1205 |             \"will be removed in 1.8. Use an instance of the class instead.\",\n1206 |             FutureWarning,\n1207 |         )\n1208 |         return getattr(estimator, \"_estimator_type\", None) == \"classifier\"\n1209 | \n1210 |     return get_tags(estimator).estimator_type == \"classifier\"\n1211 | \n1212 | \n1213 | def is_regressor(estimator):