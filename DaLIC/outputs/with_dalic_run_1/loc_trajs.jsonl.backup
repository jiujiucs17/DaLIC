return type is `np.float64`\n561 |         if `a` is of integer type and floats smaller than `float64`, or the\n562 |         input data-type, otherwise. If returned, `sum_of_weights` is always\n563 |         `float64`.\n564 | \n565 |     Examples\n566 |     --------\n567 |     >>> a = np.ma.array([1., 2., 3., 4.], mask=[False, False, True, True])\n568 |     >>> np.ma.average(a, weights=[3, 1, 0, 0])\n569 |     1.25\n570 | \n571 |     >>> x = np.ma.arange(6.).reshape(3, 2)\n572 |     >>> x\n573 |     masked_array(\n574 |       data=[[0., 1.],\n575 |             [2., 3.],\n576 |             [4., 5.]],\n577 |       mask=False,\n578 |       fill_value=1e+20)\n579 |     >>> avg, sumweights = np.ma.average(x, axis=0, weights=[1, 2, 3],\n580 |     ...                                 returned=True)\n581 |     >>> avg\n582 |     masked_array(data=[2.6666666666666665, 3.6666666666666665],\n583 |                  mask=[False, False],\n584 |            fill_value=1e+20)\n585 | \n586 |     \"\"\"\n587 |     a = asarray(a)\n588 |     m = getmask(a)\n589 | \n590 |     # inspired by 'average' in numpy/lib/function_base.py\n591 | \n592 |     if weights is None:\n593 |         avg = a.mean(axis)\n594 |         scl = avg.dtype.type(a.count(axis))\n595 |     else:\n596 |         wgt = np.asanyarray(weights)\n597 | \n598 |         if issubclass(a.dtype.type, (np.integer, np.bool_)):\n599 |             result_dtype = np.result_type(a.dtype, wgt.dtype, 'f8')\n600 |         else:\n601 |             result_dtype = np.result_type(a.dtype, wgt.dtype)\n602 | \n603 |         # Sanity checks\n604 |         if a.shape != wgt.shape:\n605 |             if axis is None:\n606 |                 raise TypeError(\n607 |                     \"Axis must be specified when shapes of a and weights \"\n608 |                     \"differ.\")\n609 |             if wgt.ndim != 1:\n610 |                 raise TypeError(\n611 |                     \"1D weights expected when shapes of a and weights differ.\")\n612 |             if wgt.shape[0] != a.shape[axis]:\n613 |                 raise ValueError(\n614 |                     \"Length of weights not compatible with specified axis.\")\n615 | \n616 |             # setup wgt to broadcast along axis\n617 |             wgt = np.broadcast_to(wgt, (a.ndim-1)*(1,) + wgt.shape)\n618 |             wgt = wgt.swapaxes(-1, axis)\n619 | \n620 |         if m is not nomask:\n621 |             wgt = wgt*(~a.mask)\n622 | \n623 |         scl = wgt.sum(axis=axis, dtype=result_dtype)\n624 |         avg = np.multiply(a, wgt, dtype=result_dtype).sum(axis)/scl\n625 | \n626 |     if returned:\n627 |         if scl.shape != avg.shape:\n628 |             scl = np.broadcast_to(scl, avg.shape).copy()\n629 |         return avg, scl\n630 |     else:\n631 |         return avg\n```\n\nFound function `numpy/lib/function_base.py:_average_dispatcher`.\nSource: Retrieved entity using keyword search (bm25).\n```\n276 | def _average_dispatcher(a, axis=None, weights=None, returned=None):\n277 |     return (a, weights)\n```\n\n\n\n##Searching for term \"moving_average\", \"sliding_window_view moving_average\"...\n### Search Result:\nFound function `numpy/lib/function_base.py:average`.\nSource: Retrieved entity using keyword search (bm25).\n```\n281 | def average(a, axis=None, weights=None, returned=False):\n282 |     \"\"\"\n283 |     Compute the weighted average along the specified axis.\n284 | \n285 |     Parameters\n286 |     ----------\n287 |     a : array_like\n288 |         Array containing data to be averaged. If `a` is not an array, a\n289 |         conversion is attempted.\n290 |     axis : None or int or tuple of ints, optional\n291 |         Axis or axes along which to average `a`.  The default,\n292 |         axis=None, will average over all of the elements of the input array.\n293 |         If axis is negative it counts from the last to the first axis.\n294 | \n295 |         .. versionadded:: 1.7.0\n296 | \n297 |         If axis is a tuple of ints, a