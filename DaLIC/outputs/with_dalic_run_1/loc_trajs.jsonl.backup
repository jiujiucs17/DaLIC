d, a, b, use_numexpr: bool = True):\n248 |     \"\"\"\n249 |     Evaluate the where condition cond on a and b.\n250 | \n251 |     Parameters\n252 |     ----------\n253 |     cond : np.ndarray[bool]\n254 |     a : return if cond is True\n255 |     b : return if cond is False\n256 |     use_numexpr : bool, default True\n257 |         Whether to try to use numexpr.\n258 |     \"\"\"\n259 |     assert _where is not None\n260 |     return _where(cond, a, b) if use_numexpr else _where_standard(cond, a, b)\n261 | \n262 | \n263 | def set_test_mode(v: bool = True) -> None:\n264 |     \"\"\"\n265 |     Keeps track of whether numexpr was used.\n266 | \n267 |     Stores an additional ``True`` for every successful use of evaluate with\n268 |     numexpr since the last ``get_test_result``.\n269 |     \"\"\"\n270 |     global _TEST_MODE, _TEST_RESULT\n271 |     _TEST_MODE = v\n272 |     _TEST_RESULT = []\n273 | \n274 | \n275 | def _store_test_result(used_numexpr: bool) -> None:\n276 |     if used_numexpr:\n277 |         _TEST_RESULT.append(used_numexpr)\n278 | \n279 | \n280 | def get_test_result() -> list[bool]:\n281 |     \"\"\"\n282 |     Get test result and reset test_results.\n283 |     \"\"\"\n284 |     global _TEST_RESULT\n285 |     res = _TEST_RESULT\n286 |     _TEST_RESULT = []\n287 |     return res\n288 | \n```\n"}, {"content": "Let me analyze the dependencies of the expressions module:\n\n<function=explore_tree_structure>\n<parameter=start_entities>['pandas/core/computation/expressions.py']</parameter>\n<parameter=direction>both</parameter>\n<parameter=traversal_depth>2</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\npandas/core/computation/expressions.py\n\u251c\u2500\u2500 contains \u2500\u2500 pandas/core/computation/expressions.py:set_use_numexpr\n\u251c\u2500\u2500 contains \u2500\u2500 pandas/core/computation/expressions.py:set_n