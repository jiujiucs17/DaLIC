tations:\n```\n\n\n# Create dataset of classification task with many redundant and few\n# informative features\nX, y = datasets.make_classification(n_samples=100000, n_features=20,\n                                    n_informative=2, n_redundant=10,\n                                    random_state=42)\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.99,\n                                                    random_state=42)\n\n\ndef plot_calibration_curve(est, name, fig_index):\n...\n\n```\nHint: Search `examples/calibration/plot_calibration_curve.py` to get the full content if needed.\n\nFound function `examples/calibration/plot_calibration_curve.py:plot_calibration_curve`.\nSource: Match found for entity name `plot_calibration_curve`.\n```\n 72 | def plot_calibration_curve(est, name, fig_index):\n 73 |     \"\"\"Plot calibration curve for est w/o and with calibration. \"\"\"\n 74 |     # Calibrated with isotonic calibration\n 75 |     isotonic = CalibratedClassifierCV(est, cv=2, method='isotonic')\n 76 | \n 77 |     # Calibrated with sigmoid calibration\n 78 |     sigmoid = CalibratedClassifierCV(est, cv=2, method='sigmoid')\n 79 | \n 80 |     # Logistic regression with no calibration as baseline\n 81 |     lr = LogisticRegression(C=1.)\n 82 | \n 83 |     fig = plt.figure(fig_index, figsize=(10, 10))\n 84 |     ax1 = plt.subplot2grid((3, 1), (0, 0), rowspan=2, fig=fig)\n 85 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\n\n\n##Searching for term \"CalibrationDisplay\"...\n### Search Result:\nFound function `sklearn/datasets/_base.py:load_digits`.\nSource: Retrieved code content using keyword search (bm25).\n```\n783 | def load_digits(*, n_class=10, return_X_y=False, as_frame=False):\n784 |     \"\"\"Load and return the digits dataset (classification).\n785 | \n786 |     Each datapoint is a 8x8 image of a digit.\n787 | \n788 |     =================   ==============\n789 |     Classes                         10\n790 |     Samples per class             ~180\n791 |     Samples total                 1797\n792 |     Dimensionality                  64\n793 |     Features             integers 0-16\n794 |     =================   ==============\n795 | \n796 |     Read more in the :ref:`User Guide <digits_dataset>`.\n797 | \n798 |     Parameters\n799 |     ----------\n800 |     n_class : int, default=10\n801 |         The number of classes to return. Between 0 and 10.\n802 | \n803 |     return_X_y : bool, default=False\n804 |         If True, returns ``(data, target)`` instead of a Bunch object.\n805 |         See below for more information about the `data` and `target` object.\n806 | \n807 |         .. versionadded:: 0.18\n808 | \n809 |     as_frame : bool, default=False\n810 |         If True, the data is a pandas DataFrame including columns with\n811 |         appropriate dtypes (numeric). The target is\n812 |         a pandas DataFrame or Series depending on the number of target columns.\n813 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n814 |         DataFrames or Series as described below.\n815 | \n816 |         .. versionadded:: 0.23\n817 | \n818 |     Returns\n819 |     -------\n820 |     data : :class:`~sklearn.utils.Bunch`\n821 |         Dictionary-like object, with the following attributes.\n822 | \n823 |         data : {ndarray, dataframe} of shape (1797, 64)\n824 |             The flattened data matrix. If `as_frame=True`, `data` will be\n825 |             a pandas DataFrame.\n826 |         target: {ndarray, Series} of shape (1797,)\n827 |             The classification target. If `as_frame=True`, `target` will be\n828 |             a pandas Series.\n829 |         feature_names: list\n830 |             The names of the dataset columns.\n831 |         target_names: list\n832 |             The names of target classes.\n833 | \n834 |             .. versionadded:: 0.20\n835 | \n836 |         frame: DataFrame of shape (1797, 65)\n837 |             Only present when `as_frame=True`. DataFrame with `data` and\n838 |             `target`.\n839 | \n840 |             .. versionadded:: 0.23\n841 |         images: {ndarray} of shape (1797, 8, 8)\n842 |             The raw image data.\n843 |         DESCR: str\n844 |             The full description of the dataset.\n845 | \n846 |     (data, target) : tuple if ``return_X_y`` is True\n847 | \n848 |         .. versionadded:: 0.18\n849 | \n850 |     This is a copy of the test set of the UCI ML hand-written digits datasets\n851 |     https://archive.ics.uci.edu/ml/datasets/Optical+Recognition+of+Handwritten+Digits\n852 | \n853 |     Examples\n854 |     --------\n855 |     To load the data and visualize the images::\n856 | \n857 |         >>> from sklearn.datasets import load_digits\n858 |         >>> digits = load_digits()\n859 |         >>> print(digits.data.shape)\n860 |         (1797, 64)\n861 |         >>> import matplotlib.pyplot as plt\n862 |         >>> plt.gray()\n863 |         >>> plt.matshow(digits.images[0])\n864 |         <...>\n865 |         >>> plt.show()\n866 |     \"\"\"\n867 | \n868 |     data, fdescr = load_gzip_compressed_csv_data(\n869 |         data_file_name=\"digits.csv.gz\", descr_file_name=\"digits.rst\", delimiter=\",\"\n870 |     )\n871 | \n872 |     target = data[:, -1].astype(int, copy=False)\n873 |     flat_data = data[:, :-1]\n874 |     images = flat_data.view()\n875 |     images.shape = (-1, 8, 8)\n876 | \n877 |     if n_class < 10:\n878 |         idx = target < n_class\n879 |         flat_data, target = flat_data[idx], target[idx]\n880 |         images = images[idx]\n881 | \n882 |     feature_names = [\n883 |         \"pixel_{}_{}\".format(row_idx, col_idx)\n884 |         for row_idx in range(8)\n885 |         for col_idx in range(8)\n886 |     ]\n887 | \n888 |     frame = None\n889 |     target_columns = [\n890 |         \"target\",\n891 |     ]\n892 |     if as_frame:\n893 |         frame, flat_data, target = _convert_data_dataframe(\n894 |             \"load_digits\", flat_data, target, feature_names, target_columns\n895 |         )\n896 | \n897 |     if return_X_y:\n898 |         return flat_data, target\n899 | \n900 |     return Bunch(\n901 |         data=flat_data,\n902 |         target=target,\n903 |         frame=frame,\n904 |         feature_names=feature_names,\n905 |         target_names=np.arange(10),\n906 |         images=images,\n907 |         DESCR=fdescr,\n908 |     )\n```\n\nFound function `sklearn/datasets/_base.py:load_linnerud`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1008 | def load_linnerud(*, return_X_y=False, as_frame=False):\n1009 |     \"\"\"Load and return the physical excercise linnerud dataset.\n1010 | \n1011 |     This dataset is suitable for multi-ouput regression tasks.\n1012 | \n1013 |     ==============   ============================\n1014 |     Samples total    20\n1015 |     Dimensionality   3 (for both data and target)\n1016 |     Features         integer\n1017 |     Targets          integer\n1018 |     ==============   ============================\n1019 | \n1020 |     Read more in the :ref:`User Guide <linnerrud_dataset>`.\n1021 | \n1022 |     Parameters\n1023 |     ----------\n1024 |     return_X_y : bool, default=False\n1025 |         If True, returns ``(data, target)`` instead of a Bunch object.\n1026 |         See below for more information about the `data` and `target` object.\n1027 | \n1028 |         .. versionadded:: 0.18\n1029 | \n1030 |     as_frame : bool, default=False\n1031 |         If True, the data is a pandas DataFrame including columns with\n1032 |         appropriate dtypes (numeric, string or categorical). The target is\n1033 |         a pandas DataFrame or Series depending on the number of target columns.\n1034 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n1035 |         DataFrames or Series as described below.\n1036 | \n1037 |         .. versionadded:: 0.23\n1038 | \n1039 |     Returns\n1040 |     -------\n1041 |     data : :class:`~sklearn.utils.Bunch`\n1042 |         Dictionary-like object, with the following attributes.\n1043 | \n1044 |         data : {ndarray, dataframe} of shape (20, 3)\n1045 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n1046 |             DataFrame.\n1047 |         target: {ndarray, dataframe} of shape (20, 3)\n1048 |             The regression targets. If `as_frame=True`, `target` will be\n1049 |             a pandas DataFrame.\n1050 |         feature_names: list\n1051 |             The names of the dataset columns.\n1052 |         target_names: list\n1053 |             The names of the target columns.\n1054 |         frame: DataFrame of shape (20, 6)\n1055 |             Only present when `as_frame=True`. DataFrame with `data` and\n1056 |             `target`.\n1057 | \n1058 |             .. versionadded:: 0.23\n1059 |         DESCR: str\n1060 |             The full description of the dataset.\n1061 |         data_filename: str\n1062 |             The path to the location of the data.\n1063 |         target_filename: str\n1064 |             The path to the location of the target.\n1065 | \n1066 |             .. versionadded:: 0.20\n1067 | \n1068 |     (data, target) : tuple if ``return_X_y`` is True\n1069 | \n1070 |         .. versionadded:: 0.18\n1071 |     \"\"\"\n1072 |     data_filename = \"linnerud_exercise.csv\"\n1073 |     target_filename = \"linnerud_physiological.csv\"\n1074 | \n1075 |     # Read header and data\n1076 |     with resources.open_text(DATA_MODULE, data_filename) as f:\n1077 |         header_exercise = f.readline().split()\n1078 |         f.seek(0)  # reset file obj\n1079 |         data_exercise = np.loadtxt(f, skiprows=1)\n1080 | \n1081 |     with resources.open_text(DATA_MODULE, target_filename) as f:\n1082 |         header_physiological = f.readline().split()\n1083 |         f.seek(0)  # reset file obj\n1084 |         data_physiological = np.loadtxt(f, skiprows=1)\n1085 | \n1086 |     fdescr = load_descr(\"linnerud.rst\")\n1087 | \n1088 |     frame = None\n1089 |     if as_frame:\n1090 |         (frame, data_exercise, data_physiological) = _convert_data_dataframe(\n1091 |             \"load_linnerud\",\n1092 |             data_exercise,\n1093 |             data_physiological,\n1094 |             header_exercise,\n1095 |             header_physiological,\n1096 |         )\n1097 |     if return_X_y:\n1098 |         return data_exercise, data_physiological\n1099 | \n1100 |     return Bunch(\n1101 |         data=data_exercise,\n1102 |         feature_names=header_exercise,\n1103 |         target=data_physiological,\n1104 |         target_names=header_physiological,\n1105 |         frame=frame,\n1106 |         DESCR=fdescr,\n1107 |         data_filename=data_filename,\n1108 |         target_filename=target_filename,\n1109 |         data_module=DATA_MODULE,\n1110 |     )\n```\n\nFound function `sklearn/calibration.py:_sigmoid_calibration`.\nSource: Retrieved entity using keyword search (bm25).\n```\n722 | def _sigmoid_calibration(predictions, y, sample_weight=None):\n723 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n724 | \n725 |     Parameters\n726 |     ----------\n727 |     predictions : ndarray of shape (n_samples,)\n728 |         The decision function or predict proba for the samples.\n729 | \n730 |     y : ndarray of shape (n_samples,)\n731 |         The targets.\n732 | \n733 |     sample_weight : array-like of shape (n_samples,), default=None\n734 |         Sample weights. If None, then samples are equally weighted.\n735 | \n736 |     Returns\n737 |     -------\n738 |     a : float\n739 |         The slope.\n740 | \n741 |     b : float\n742 |         The intercept.\n743 | \n744 |     References\n745 |     ----------\n746 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n747 |     \"\"\"\n748 |     predictions = column_or_1d(predictions)\n749 |     y = column_or_1d(y)\n750 | \n751 |     F = predictions  # F follows Platt's notations\n752 | \n753 |     # Bayesian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n```\n\nFound function `sklearn/utils/validation.py:_get_feature_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1595 | def _get_feature_names(X):\n1596 |     \"\"\"Get feature names from X.\n1597 | \n1598 |     Support for other array containers should place its implementation here.\n1599 | \n1600 |     Parameters\n1601 |     ----------\n1602 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n1603 |         Array container to extract feature names.\n1604 | \n1605 |         - pandas dataframe : The columns will be considered to be feature\n1606 |           names. If the dataframe contains non-string feature names, `None` is\n1607 |           returned.\n1608 |         - All other array containers will return `None`.\n1609 | \n1610 |     Returns\n1611 |     -------\n1612 |     names: ndarray or None\n1613 |         Feature names of `X`. Unrecognized array containers will return `None`.\n1614 |     \"\"\"\n1615 |     feature_names = None\n1616 | \n1617 |     # extract feature names for support array containers\n1618 |     if hasattr(X, \"columns\"):\n1619 |         feature_names = np.asarray(X.columns)\n1620 | \n1621 |     if feature_names is None or len(feature_names) == 0:\n1622 |         return\n1623 | \n1624 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n1625 | \n1626 |     # Warn when types are mixed.\n1627 |     # ints and strings do not warn\n1628 |     if len(types) > 1 or not (types[0].startswith(\"int\") or types[0] == \"str\"):\n1629 |         # TODO: Convert to an error in 1.2\n1630 |         warnings.warn(\n1631 |             \"Feature names only support names that are all strings. \"\n1632 |             f\"Got feature names with dtypes: {types}. An error will be raised \"\n1633 |             \"in 1.2.\",\n1634 |             FutureWarning,\n1635 |         )\n1636 |         return\n1637 | \n1638 |     # Only feature names of all strings are supported\n1639 |     if types[0] == \"str\":\n1640 |         return feature_names\n```\n\nFound function `sklearn/datasets/_base.py:load_diabetes`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 911 | def load_diabetes(*, return_X_y=False, as_frame=False):\n 912 |     \"\"\"Load and return the diabetes dataset (regression).\n 913 | \n 914 |     ==============   ==================\n 915 |     Samples total    442\n 916 |     Dimensionality   10\n 917 |     Features         real, -.2 < x < .2\n 918 |     Targets          integer 25 - 346\n 919 |     ==============   ==================\n 920 | \n 921 |     .. note::\n 922 |        The meaning of each feature (i.e. `feature_names`) might be unclear\n 923 |        (especially for `ltg`) as the documentation of the original dataset is\n 924 |        not explicit