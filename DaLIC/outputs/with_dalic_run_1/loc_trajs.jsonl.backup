 artists\nefficiently.\n\n\"\"\"\n\nimport itertools\nimport math\nimport numpy as np\n\nfrom matplotlib import _api, artist, cbook, colors as mcolors, transforms\nfrom matplotlib._enums import JoinStyle, CapStyle\nfrom matplotlib.artist import allow_rasterization\nfrom .path import Path\nfrom .transforms import Affine2D\n\n__all__ = ['Collection', 'PolyCollection', 'LineCollection', 'PatchCollection',\n           'EventCollection', 'BrokenBarHCollection', 'EllipseCollection',\n           'QuadMesh', 'RegularPolyCollection', 'StarPolygonCollection']\n\nLINECOLLECTION_DOCSTRING = \"\"\"\nA collection of 1-D segments.\n\nParameters\n----------\nsegments : sequence of array-like\n    A sequence of the form ``[segment0, segment1, ...]``, where each\n    ``segmenti`` is an array of shape ``(Ni, 2)``, representing the\n    sequence of (x, y) points for the i-th line.\n\n%(collection)s\n\nSee Also\n--------\n`~matplotlib.collections.PolyCollection`\n`~matplotlib.collections.RegularPolyCollection`\n`~matplotlib.collections.StarPolygonCollection`\n\nNotes\n-----\nThe datalim of the enclosing Axes will automatically be updated to encompass\nthe data in the collection.\n\nThe hit testing for this collection assumes that all lines are straight. If\nany of the lines are curved, the hit testing will not work as expected.\n\"\"\"\n\nclass Collection(artist.Artist, Iterable):\n...\n\nclass LineCollection(Collection):\n    \"\"\"\n    A collection of 1-D segments.\n\n    Parameters\n    ----------\n    segments : sequence of array-like\n        A sequence of the form ``[segment0, segment1, ...]``, where each\n        ``segmenti`` is an array of shape ``(Ni, 2)``, representing the\n        sequence of (x, y) points for the i-th line.\n\n    %(collection)s\n\n    See Also\n    --------\n    `~matplotlib.collections.PolyCollection`\n    `~matplotlib.collections.RegularPolyCollection`\n    `~matplotlib.collections.StarPolygonCollection`\n\n    Notes\n    -----\n    The datalim of the en