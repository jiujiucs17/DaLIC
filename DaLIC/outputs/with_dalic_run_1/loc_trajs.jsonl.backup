mA = armA\n3109 |             self.armB = armB\n3110 |             self.fraction = fraction\n3111 |             self.angle = angle\n3112 | \n3113 |         def connect(self, posA, posB):\n3114 |             x1, y1 = posA\n3115 |             x20, y20 = x2, y2 = posB\n3116 | \n3117 |             theta1 = math.atan2(y2 - y1, x2 - x1)\n3118 |             dx, dy = x2 - x1, y2 - y1\n3119 |             dd = (dx * dx + dy * dy) ** .5\n3120 |             ddx, ddy = dx / dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\n\n\n##Searching for term \"bar()\"...\n### Search Result:\nFound function `lib/matplotlib/axes/_axes.py:Axes.bar`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2326 | def bar(self, x, height, width=0.8