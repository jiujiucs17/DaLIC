 | \n829 |     return_sparse = False\n830 |     if data_description['format'].lower() == 'sparse_arff':\n831 |         return_sparse = True\n832 | \n833 |     if as_frame == 'auto':\n834 |         as_frame = not return_sparse\n835 | \n836 |     if as_frame and return_sparse:\n837 |         raise ValueError('Cannot return dataframe with sparse data')\n838 | \n839 |     # download data features, meta-info about column types\n840 |     features_list = _get_data_features(data_id, data_home)\n841 | \n842 |     if not as_frame:\n843 |         for feature in features_list:\n844 |             if 'true' in (feature['is_ignore'], feature['is_row_identifier']):\n845 |                 continue\n846 |             if feature['data_type'] == 'string':\n847 |                 raise ValueError('STRING attributes are not supported for '\n848 |                                  'array representation. Try as_frame=True')\n849 | \n850 |     if target_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |                         \"Should be str, list or None. Got: \"\n866 |                         \"{}\".format(type(target_column)))\n867 |     data_columns = _valid_data_column_names(features_list,\n868 |                                             target_columns)\n869 | \n870 |     shape: Optional[Tuple[int, int]]\n871 |     # determine arff encoding to return\n872 |     if not return_sparse:\n873 |         # The shape must include the ignored features to keep the right indexes\n874 |         # during the arff data conversion.\n875 |         data_qualities = _get_data_qualities(data_id, data_home)\n876 |         shape = _get_num_samples(data_qualities), len(features_list)\n877 |     else:\n878 |         shape = None\n879 | \n880 |     # obtain the data\n881 |     url = _DATA_FILE.format(data_description['file_id'])\n882 |     bunch = _download_data_to_bunch(url, return_sparse, data_home,\n883 |                                     as_frame=as_frame,\n884 |                                     features_list=features_list, shape=shape,\n885 |                                     target_columns=target_columns,\n886 |                                     data_columns=data_columns)\n887 | \n888 |     if return_X_y:\n889 |         return bunch.data, bunch.target\n890 | \n891 |     description = \"{}\\n\\nDownloaded from openml.org.\".format(\n892 |         data_description.pop('description'))\n893 | \n894 |     bunch.update(\n895 |         DESCR=description, details=data_description,\n896 |         url=\"https://www.openml.org/d/{}\".format(data_id))\n897 | \n898 |     return bunch\n```\n\nFound file `sklearn/decomposition/_base.py`.\nFound file `sklearn/datasets/_species_distributions.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"download\"...\n### Search Result:\nFound function `sklearn/datasets/_twenty_newsgroups.py:_download_20newsgroups`.\nSource: Retrieved entity using keyword search (bm25).\n```\n65 | def _download_20newsgroups(target_dir, cache_path):\n66 |     \"\"\"Download the 20 newsgroups data and stored it as a zipped pickle.\"\"\"\n67 |     train_path = os.path.join(target_dir, TRAIN_FOLDER)\n68 |     test_path = os.path.join(target_dir, TEST_FOLDER)\n69 | \n70 |     if not os.path.exists(target_dir):\n71 |         os.makedirs(target_dir)\n72 | \n73 |     logger.info(\"Downloading dataset from %s (14 MB)\", ARCHIVE.url)\n74 |     archive_path = _fetch_remote(ARCHIVE, dirname=target_dir)\n75 | \n76 |     logger.debug(\"Decompressing %s\", archive_path)\n77 |     tarfile.open(archive_path, \"r:gz\").extractall(path=target_dir)\n78 |     os.remove(archive_path)\n79 | \n80 |     # Store a zipped pickle\n81 |     cache = dict(train=load_files(train_path, encoding='latin1'),\n82 |                  test=load_files(test_path, encoding='latin1'))\n83 |     compressed_content = codecs.encode(pickle.dumps(cache), 'zlib_codec')\n84 |     with open(cache_path, 'wb') as f:\n85 |         f.write(compressed_content)\n86 | \n87 |     shutil.rmtree(target_dir)\n88 |     return cache\n```\n\n\n\n##Searching for term \"download\", \"ARFF\", \"data_set_description download ARFF\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch`.\nSource: Retrieved entity using keyword search (bm25).\n```\n509 | def _download_data_to_bunch(\n510 |     url: str,\n511 |     sparse: bool,\n512 |     data_home: Optional[str],\n513 |     *,\n514 |     as_frame: bool,\n515 |     features_list: List,\n516 |     data_columns: List[int],\n517 |     target_columns: List,\n518 |     shape: Optional[Tuple[int, int]]\n519 | ):\n520 |     \"\"\"Download OpenML ARFF and convert to Bunch of data\n521 |     \"\"\"\n522 |     # NB: this function is long in order to handle retry for any failure\n523 |     #     during the streaming parse of the ARFF.\n524 | \n525 |     # Prepare which columns and data types should be returned for the X and y\n526 |     features_dict = {feature['name']: feature for feature in features_list}\n527 | \n528 |     # XXX: col_slice_y should be all nominal or all numeric\n529 |     _verify_target_data_type(features_dict, target_columns)\n530 | \n531 |     col_slice_y = [int(features_dict[col_name]['index'])\n532 |                    for col_name in target_columns]\n533 | \n534 |     col_slice_x = [int(features_dict[col_name]['index'])\n535 |                    for col_name in data_columns]\n536 |     for col_idx in col_slice_y:\n537 |         feat = features_list[col_idx]\n538 |         nr_missing = int(feat['number_of_missing_values'])\n539 |         if nr_missing > 0:\n540 |             raise ValueError('Target column {} has {} missing values. '\n541 |                              'Missing values are not supported for target '\n542 |                              'columns. '.format(feat['name'], nr_missing))\n543 | \n544 |     # Access an ARFF file on the OpenML server. Documentation:\n545 |     # https://www.openml.org/api_data_docs#!/data/get_download_id\n546 | \n547 |     if sparse is True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n```\n\n\n\n##Searching for term \"download\", \"data_set_description download ARFF\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch.postprocess`.\nSource: Retrieved entity using keyword search (bm25).\n```\n582 | def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n```\n\n\n\n##Searching for term \"ARFF\"...\n### Search Result:\nFound class `sklearn/feature_