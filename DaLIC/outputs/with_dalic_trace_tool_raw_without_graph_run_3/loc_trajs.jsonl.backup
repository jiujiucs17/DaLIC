@property\n2380 |     def _is_dates_only(self) -> bool:\n2381 |         \"\"\"\n2382 |         Check if we are round times at midnight (and no timezone), which will\n2383 |         be given a more compact __repr__ than other cases. For TimedeltaArray\n2384 |         we are checking for multiples of 24H.\n2385 |         \"\"\"\n2386 |         if not lib.is_np_dtype(self.dtype):\n2387 |             # i.e. we have a timezone\n2388 |             return False\n2389 | \n2390 |         values_int = self.asi8\n2391 |         consider_values = values_int != iNaT\n2392 |         reso = get_unit_from_dtype(self.dtype)\n2393 |         ppd = periods_per_day(reso)\n2394 | \n2395 |         # TODO: can we reuse is_date_array_normalized?  would need a skipna kwd\n2396 |         #  (first attempt at this was less performant than this implementation)\n2397 |         even_days = np.logical_and(consider_values, values_int % ppd != 0).sum() == 0\n2398 |         return even_days\n2399 | \n2400 | \n2401 | # -------------------------------------------------------------------\n2402 | # Shared Constructor Helpers\n2403 | \n2404 | \n2405 | def ensure_arraylike_for_datetimelike(\n2406 |     data, copy: bool, cls_name: str\n2407 | ) -> tuple[ArrayLike, bool]:\n2408 |     if not hasattr(data, \"dtype\"):\n2409 |         # e.g. list, tuple\n2410 |         if not isinstance(data, (list, tuple)) and np.ndim(data) == 0:\n2411 |             # i.e. generator\n2412 |             data = list(data)\n2413 | \n2414 |         data = construct_1d_object_array_from_listlike(data)\n2415 |         copy = False\n2416 |     elif isinstance(data, ABCMultiIndex):\n2417 |         raise TypeError(f\"Cannot create a {cls_name} from a MultiIndex.\")\n2418 |     else:\n2419 |         data = extract_array(data, extract_numpy=True)\n2420 | \n2421 |     if isinstance(data, IntegerArray) or (\n2422 |         isinstance(data, ArrowExtensionArray) and data.dtype.kind in \"iu\"\n2423 |     ):\n2424 |         data = data.to_nump