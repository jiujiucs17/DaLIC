y:Pipeline._validate_steps`.\nSource: Retrieved entity using keyword search (bm25).\n```\n143 | def _validate_steps(self):\n144 |         names, estimators = zip(*self.steps)\n145 | \n146 |         # validate names\n147 |         self._validate_names(names)\n148 | \n149 |         # validate estimators\n150 |         transformers = estimators[:-1]\n151 |         estimator = estimators[-1]\n152 | \n153 |         for t in transformers:\n154 |             if t is None or t == 'passthrough':\n155 |                 continue\n156 |             if (not (hasattr(t, \"fit\") or hasattr(t, \"fit_transform\")) or not\n157 |                     hasattr(t, \"transform\")):\n158 |                 raise TypeError(\"All intermediate steps should be \"\n159 |                                 \"transformers and implement fit and transform \"\n160 |                                 \"or be the string 'passthrough' \"\n161 |                                 \"'%s' (type %s) doesn't\" % (t, type(t)))\n162 | \n163 |         # We allow last estimator to be None as an identity transformation\n164 |         if (estimator is not None and estimator != 'passthrough'\n165 |                 and not hasattr(estimator, \"fit\")):\n166 |             raise TypeError(\n167 |                 \"Last step of Pipeline should implement fit \"\n168 |                 \"or be the string 'passthrough'. \"\n169 |                 \"'%s' (type %s) doesn't\" % (estimator, type(estimator)))\n```\n\nFound function `sklearn/pipeline.py:FeatureUnion._validate_transformers`.\nSource: Retrieved entity using keyword search (bm25).\n```\n855 | def _validate_transformers(self):\n856 |         names, transformers = zip(*self.transformer_list)\n857 | \n858 |         # validate names\n859 |         self._validate_names(names)\n860 | \n861 |         # validate estimators\n862 |         for t in transformers:\n863 |             if t == 'drop':\n864 |                 continue\n865 |             if (not (hasattr(t, \"fit\") or hasat