_matrix(\n835 |             (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n836 |         )\n837 |         X_new = [X_step]\n838 | \n839 |         log_step_nz = sample_interval * np.log(X.data)\n840 |         step_nz = 2 * X.data * sample_interval\n841 | \n842 |         for j in range(1, sample_steps):\n843 |             factor_nz = np.sqrt(step_nz / np.cosh(np.pi * j * sample_interval))\n844 | \n845 |             data_step = factor_nz * np.cos(j * log_step_nz)\n846 |             X_step = sp.csr_matrix(\n847 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n848 |             )\n849 |             X_new.append(X_step)\n850 | \n851 |             data_step = factor_nz * np.sin(j * log_step_nz)\n852 |             X_step = sp.csr_matrix(\n853 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n854 |             )\n855 |             X_new.append(X_step)\n856 | \n857 |         return sp.hstack(X_new)\n```\n\nFound function `sklearn/random_projection.py:_sparse_random_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n202 | def _sparse_random_matrix(n_components, n_features, density=\"auto\", random_state=None):\n203 |     \"\"\"Generalized Achlioptas random sparse matrix for random projection.\n204 | \n205 |     Setting density to 1 / 3 will yield the original matrix by Dimitris\n206 |     Achlioptas while setting a lower value will yield the generalization\n207 |     by Ping Li et al.\n208 | \n209 |     If we note :math:`s = 1 / density`, the components of the random matrix are\n210 |     drawn from:\n211 | \n212 |       - -sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n213 |       -  0                              with probability 1 - 1 / s\n214 |       - +sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n215 | \n216 |     Read more in the :ref:`User Guide <sparse_random_matrix>`.\n217 | \n218 |     Parameters\n219 |     ----------\n220 |     n_components : int,\n221 |         Dimensionality of the target projection space.\n222 | \n223 |     n_features : int,\n224 |         Dimensionality of the original source space.\n225 | \n226 |     density : float or 'auto', default='auto'\n227 |         Ratio of non-zero component in the random projection matrix in the\n228 |         range `(0, 1]`\n229 | \n230 |         If density = 'auto', the value is set to the minimum density\n231 |         as recommended by Ping Li et al.: 1 / sqrt(n_features).\n232 | \n233 |         Use density = 1 / 3.0 if you want to reproduce the results from\n234 |         Achlioptas, 2001.\n235 | \n236 |     random_state : int, RandomState instance or None, default=None\n237 |         Controls the pseudo random number generator used to generate the matrix\n238 |         at fit time.\n239 |         Pass an int for reproducible output across multiple function calls.\n240 |         See :term:`Glossary <random_state>`.\n241 | \n242 |     Returns\n243 |     -------\n244 |     components : {ndarray, sparse matrix} of shape (n_components, n_features)\n245 |         The generated Gaussian random matrix. Sparse matrix will be of CSR\n246 |         format.\n247 | \n248 |     See Also\n249 |     --------\n250 |     SparseRandomProjection\n251 | \n252 |     References\n253 |     ----------\n254 | \n255 |     .. [1] Ping Li, T. Hastie and K. W. Church, 2006,\n256 |            \"Very Sparse Random Projections\".\n257 |            https://web.stanford.edu/~hastie/Papers/Ping/KDD06_rp.pdf\n258 | \n259 |     .. [2] D. Achlioptas, 2001, \"Database-friendly random projections\",\n260 |            https://cgi.di.uoa.gr/~optas/papers/jl.pdf\n261 | \n262 |     \"\"\"\n263 |     _check_input_size(n_components, n_features)\n264 |     density = _check_density(density, n_features)\n265 |     rng = check_random_state(random_state)\n266 | \n267 |     if density == 1:\n268 |         # skip index generation if totally dense\n269 |         components = rng.binomial(1, 0.5, (n_components, n_features)) * 2 - 1\n270 |         return 1 / np.sqrt(n_components) * components\n271 | \n272 |     else:\n273 |         # Generate location of non zero elements\n274 |         indices = []\n275 |         offset = 0\n276 |         indptr = [offset]\n277 |         for _ in range(n_components):\n278 |             # find the indices of the non-zero components for row i\n279 |             n_nonzero_i = rng.binomial(n_features, density)\n280 |             indices_i = sample_without_replacement(\n281 |                 n_features, n_nonzero_i, random_state=rng\n282 |             )\n283 |             indices.append(indices_i)\n284 |             offset += n_nonzero_i\n285 |             indptr.append(offset)\n286 | \n287 |         indices = np.concatenate(indices)\n288 | \n289 |         # Among non zero components the probability of the sign is 50%/50%\n290 |         data = rng.binomial(1, 0.5, size=np.size(indices)) * 2 - 1\n291 | \n292 |         # build the CSR structure by concatenating the rows\n293 |         components = sp.csr_matrix(\n294 |             (data, indices, indptr), shape=(n_components, n_features)\n295 |         )\n296 | \n297 |         return np.sqrt(1 / density) / np.sqrt(n_components) * components\n```\n\nFound function `sklearn/utils/validation.py:_check_pos_label_consistency`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2183 | def _check_pos_label_consistency(pos_label, y_true):\n2184 |     \"\"\"Check if `pos_label` need to be specified or not.\n2185 | \n2186 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2187 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2188 |     `pos_label` parameters.\n2189 | \n2190 |     Parameters\n2191 |     ----------\n2192 |     pos_label : int, float, bool, str or None\n2193 |         The positive label.\n2194 |     y_true : ndarray of shape (n_samples,)\n2195 |         The target vector.\n2196 | \n2197 |     Returns\n2198 |     -------\n2199 |     pos_label : int, float, bool or str\n2200 |         If `pos_label` can be inferred, it will be returned.\n2201 | \n2202 |     Raises\n2203 |     ------\n2204 |     ValueError\n2205 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2206 |         it will raise a `ValueError`.\n2207 |     \"\"\"\n2208 |     # ensure binary classification if pos_label is not specified\n2209 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2210 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2211 |     # when elements in the two arrays are not comparable.\n2212 |     classes = np.unique(y_true)\n2213 |     if pos_label is None and (\n2214 |         classes.dtype.kind in \"OUS\"\n2215 |         or not (\n2216 |             np.array_equal(classes, [0, 1])\n2217 |             or np.array_equal(classes, [-1, 1])\n2218 |             or np.array_equal(classes, [0])\n2219 |             or np.array_equal(classes, [-1])\n2220 |             or np.array_equal(classes, [1])\n2221 |         )\n2222 |     ):\n2223 |         classes_repr = \", \".join(repr(c) for c in classes)\n2224 |         raise ValueError(\n2225 |             f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2226 |             \"specified: either make y_true take value in {0, 1} or \"\n2227 |             \"{-1, 1} or pass pos_label explicitly.\"\n2228 |         )\n2229 |     elif pos_label is None:\n2230 |         pos_label = 1\n2231 | \n2232 |     return pos_label\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 985 | def fit(self, X, Y):\n 986 |         \"\"\"Fit model to data.\n 987 | \n 988 |         Parameters\n 989 |         ----------\n 990 |         X : array-like of shape (n_samples, n_features)\n 991 |             Training samples.\n 992 | \n 993 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets)\n 994 |             Targets.\n 995 | \n 996 |         Returns\n 997 |         -------\n 998 |         self : object\n 999 |             Fitted estimator.\n1000 |         \"\"\"\n1001 |         self._validate_params()\n1002 | \n1003 |         check_consistent_length(X, Y)\n1004 |         X = self._validate_data(\n1005 |             X, dtype=np.float64, copy=self.copy, ensure_min_samples=2\n1006 |         )\n1007 |         Y = check_array(\n1008 |             Y, input_name=\"Y\", dtype=np.float64, copy=self.copy, ensure_2d=False\n1009 |         )\n1010 |         if Y.ndim == 1:\n1011 |             Y = Y.reshape(-1, 1)\n1012 | \n1013 |         # we'll compute the SVD of the cross-covariance matrix = X.T.dot(Y)\n1014 |         # This matrix rank is at most min(n_samples, n_features, n_targets) so\n1015 |         # n_components cannot be bigger than that.\n1016 |         n_components = self.n_components\n1017 |         rank_upper_bound = min(X.shape[0], X.shape[1], Y.shape[1])\n1018 |         if n_components > rank_upper_bound:\n1019 |             raise ValueError(\n1020 |                 f\"`n_components` upper bound is {rank_upper_bound}. \"\n1021 |                 f\"Got {n_components} instead. Reduce `n_components`.\"\n1022 |             )\n1023 | \n1024 |         X, Y, self._x_mean, self._y_mean, self._x_std, self._y_std = _center_scale_xy(\n1025 |             X, Y, self.scale\n1026 |         )\n1027 | \n1028 |         # Compute SVD of cross-covariance matrix\n1029 |         C = np.dot(X.T, Y)\n1030 |         U, s, Vt = svd(C, full_matrices=False)\n1031 |         U = U[:, :n_components]\n1032 |         Vt = Vt[:n_components]\n1033 |         U, Vt = svd_flip(U, Vt)\n1034 |         V = Vt.T\n1035 | \n1036 |         self.x_weights_ = U\n1037 |         self.y_weights_ = V\n1038 |         self._n_features_out = self.x_weights_.shape[1]\n1039 |         return self\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1041 | def transform(self, X, Y=None):\n1042 |         \"\"\"\n1043 |         Apply the dimensionality reduction.\n1044 | \n1045 |         Parameters\n1046 |         ----------\n1047 |         X : array-like of shape (n_samples, n_features)\n1048 |             Samples to be transformed.\n1049 | \n1050 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets), \\\n1051 |                 default=None\n1052 |             Targets.\n1053 | \n1054 |         Returns\n1055 |         -------\n1056 |         x_scores : array-like or tuple of array-like\n1057 |             The transformed data `X_transformed` if `Y is not None`,\n1058 |             `(X_transformed, Y_transformed)` otherwise.\n1059 |         \"\"\"\n1060 |         check_is_fitted(self)\n1061 |         X = self._validate_data(X, dtype=np.float64, reset=False)\n1062 |         Xr = (X - self._x_mean) / self._x_std\n1063 |         x_scores = np.dot(Xr, self.x_weights_)\n1064 |         if Y is not None:\n1065 |             Y = check_array(Y, input_name=\"Y\", ensure_2d=False, dtype=np.float64)\n1066 |             if Y.ndim == 1:\n1067 |                 Y = Y.reshape(-1, 1)\n1068 |             Yr = (Y - self._y_mean) / self._y_std\n1069 |             y_scores = np.dot(Yr, self.y_weights_)\n1070 |             return x_scores, y_scores\n1071 |         return x_scores\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit_transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1073 | def fit_transform(self, X, y=None):\n1074 |         \"\"\"Learn and apply the dimensionality reduction.\n1075 | \n1076 |         Parameters\n1077 |         ----------\n1078 |         X : array-like of shape (n_samples, n_features)\n1079 |             Training samples.\n1080 | \n1081 |         y : array-like of shape (n_samples,) or (n_samples, n_targets), \\\n1082 |                 default=None\n1083 |             Targets.\n1084 | \n108