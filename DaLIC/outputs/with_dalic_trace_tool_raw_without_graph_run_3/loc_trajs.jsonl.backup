    --------\n1240 |         >>> import pandas as pd\n1241 |         >>> idx = pd.RangeIndex(10, 30, 10)\n1242 |         >>> idx.round(decimals=-1)\n1243 |         RangeIndex(start=10, stop=30, step=10)\n1244 |         >>> idx = pd.RangeIndex(10, 15, 1)\n1245 |         >>> idx.round(decimals=-1)\n1246 |         Index([10, 10, 10, 10, 10], dtype='int64')\n1247 |         \"\"\"\n1248 |         if decimals >= 0:\n1249 |             return self.copy()\n1250 |         elif self.start % 10**-decimals == 0 and self.step % 10**-decimals == 0:\n1251 |             # e.g. RangeIndex(10, 30, 10).round(-1) doesn't need rounding\n1252 |             return self.copy()\n1253 |         else:\n1254 |             return super().round(decimals=decimals)\n```\n\n\n##Searching for entity `pandas/core/indexes/base.py:Index.round`...\n### Search Result:\nFound function `pandas/core/indexes/base.py:Index.round`.\nSource: Exact match found for entity name `pandas/core/indexes/base.py:Index.round`.\n```\n7022 | def round(self, decimals: int = 0) -> Self:\n7023 |         \"\"\"\n7024 |         Round each value in the Index to the given number of decimals.\n7025 | \n7026 |         Parameters\n7027 |         ----------\n7028 |         decimals : int, optional\n7029 |             Number of decimal places to round to. If decimals is negative,\n7030 |             it specifies the number of positions to the left of the decimal point.\n7031 | \n7032 |         Returns\n7033 |         -------\n7034 |         Index\n7035 |             A new Index with the rounded values.\n7036 | \n7037 |         Examples\n7038 |         --------\n7039 |         >>> import pandas as pd\n7040 |         >>> idx = pd.Index([10.1234, 20.5678, 30.9123, 40.4567, 50.7890])\n7041 |         >>> idx.round(decimals=2)\n7042 |         Index([10.12, 20.57, 30.91, 40.46, 50.79], dtype='float64')\n7043 | \n7044 |         \"\"\"\n7045 |         return self._constructor(self.to_series().round(decimals))\n```\n"}, {"content": "```\npandas