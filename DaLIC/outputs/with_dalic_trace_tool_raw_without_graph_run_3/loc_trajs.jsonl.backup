ull content if needed.\n\nFound file `asv_bench/benchmarks/io/style.py`.\nSource: Match found for entity name `style`.\n```\n 1 | import numpy as np\n 2 | \n 3 | from pandas import (\n 4 |     DataFrame,\n 5 |     IndexSlice,\n 6 | )\n 7 | \n 8 | \n 9 | class Render:\n10 |     params = [[12, 24, 36], [12, 120]]\n11 |     param_names = [\"cols\", \"rows\"]\n12 | \n13 |     def setup(self, cols, rows):\n14 |         self.df = DataFrame(\n15 |             np.random.randn(rows, cols),\n16 |             columns=[f\"float_{i+1}\" for i in range(cols)],\n17 |             index=[f\"row_{i+1}\" for i in range(rows)],\n18 |         )\n19 | \n20 |     def time_apply_render(self, cols, rows):\n21 |         self._style_apply()\n22 |         self.st._render_html(True, True)\n23 | \n24 |     def peakmem_apply_render(self, cols, rows):\n25 |         self._style_apply()\n26 |         self.st._render_html(True, True)\n27 | \n28 |     def time_classes_render(self, cols, rows):\n29 |         self._style_classes()\n30 |         self.st._render_html(True, True)\n31 | \n32 |     def peakmem_classes_render(self, cols, rows):\n33 |         self._style_classes()\n34 |         self.st._render_html(True, True)\n35 | \n36 |     def time_tooltips_render(self, cols, rows):\n37 |         self._style_tooltips()\n38 |         self.st._render_html(True, True)\n39 | \n40 |     def peakmem_tooltips_render(self, cols, rows):\n41 |         self._style_tooltips()\n42 |         self.st._render_html(True, True)\n43 | \n44 |     def time_format_render(self, cols, rows):\n45 |         self._style_format()\n46 |         self.st._render_html(True, True)\n47 | \n48 |     def peakmem_format_render(self, cols, rows):\n49 |         self._style_format()\n50 |         self.st._render_html(True, True)\n51 | \n52 |     def time_apply_format_hide_render(self, cols, rows):\n53 |         self._style_apply_format_hide()\n54 |         self.st._render_html(True, True)\n55 | \n56 |     def peakmem_apply_format_hide_render(self, cols, rows):\n57 |         self._style_apply_format_hide()\n58 |         self.st._render_html(True, True)\n59 | \n60 |     def _style_apply(self):\n61 |         def _apply_func(s):\n62 |             return [\n63 |                 \"background-color: lightcyan\" if s.name == \"row_1\" else \"\" for v in s\n64 |             ]\n65 | \n66 |         self.st = self.df.style.apply(_apply_func, axis=1)\n67 | \n68 |     def _style_classes(self):\n69 |         classes = self.df.map(lambda v: (\"cls-1\" if v > 0 else \"\"))\n70 |         classes.index, classes.columns = self.df.index, self.df.columns\n71 |         self.st = self.df.style.set_td_classes(classes)\n72 | \n73 |     def _style_format(self):\n74 |         ic = int(len(self.df.columns) / 4 * 3)\n75 |         ir = int(len(self.df.index) / 4 * 3)\n76 |         # apply a formatting function\n77 |         # subset is flexible but hinders vectorised solutions\n78 |         self.st = self.df.style.format(\n79 |             \"{:,.3f}\",\n80 |             subset=IndexSlice[\"row_1\" : f\"row_{ir}\", \"float_1\" : f\"float_{ic}\"],\n81 |         )\n82 | \n83 |     def _style_apply_format_hide(self):\n84 |         self.st = self.df.style.map(lambda v: \"color: red;\")\n85 |         self.st.format(\"{:.3f}\")\n86 |         self.st.hide(self.st.index[1:], axis=0)\n87 |         self.st.hide(self.st.columns[1:], axis=1)\n88 | \n89 |     def _style_tooltips(self):\n90 |         ttips = DataFrame(\"abc\", index=self.df.index[::2], columns=self.df.columns[::2])\n91 |         self.st = self.df.style.set_tooltips(ttips)\n92 |         self.st.hide(self.st.index[12:], axis=0)\n93 |         self.st.hide(self.st.columns[12:], axis=1)\n94 | \n```\n\nFound function `pandas/core/frame.py:DataFrame.style`.\nSource: Match found for entity name `style`.\n```\n1381 | def style(self) -> Styler:\n1382 |         \"\"\"\n1383 |         Returns a Styler object.\n1384 | \n1385 |         Contains methods for building a styled HTML representation of t