TScalarOrNaT:\n 240 |         \"\"\"\n 241 |         Construct a scalar type from a string.\n 242 | \n 243 |         Parameters\n 244 |         ----------\n 245 |         value : str\n 246 | \n 247 |         Returns\n 248 |         -------\n 249 |         Period, Timestamp, or Timedelta, or NaT\n 250 |             Whatever the type of ``self._scalar_type`` is.\n 251 | \n 252 |         Notes\n 253 |         -----\n 254 |         This should call ``self._check_compatible_with`` before\n 255 |         unboxing the result.\n 256 |         \"\"\"\n 257 |         raise AbstractMethodError(self)\n 258 | \n 259 |     def _unbox_scalar(\n 260 |         self, value: DTScalarOrNaT\n 261 |     ) -> np.int64 | np.datetime64 | np.timedelta64:\n 262 |         \"\"\"\n 263 |         Unbox the integer value of a scalar `value`.\n 264 | \n 265 |         Parameters\n 266 |         ----------\n 267 |         value : Period, Timestamp, Timedelta, or NaT\n 268 |             Depending on subclass.\n 269 | \n 270 |         Returns\n 271 |         -------\n 272 |         int\n 273 | \n 274 |         Examples\n 275 |         --------\n 276 |         >>> arr = pd.array(np.array([\"1970-01-01\"], \"datetime64[ns]\"))\n 277 |         >>> arr._unbox_scalar(arr[0])\n 278 |         numpy.datetime64('1970-01-01T00:00:00.000000000')\n 279 |         \"\"\"\n 280 |         raise AbstractMethodError(self)\n 281 | \n 282 |     def _check_compatible_with(self, other: DTScalarOrNaT) -> None:\n 283 |         \"\"\"\n 284 |         Verify that `self` and `other` are compatible.\n 285 | \n 286 |         * DatetimeArray verifies that the timezones (if any) match\n 287 |         * PeriodArray verifies that the freq matches\n 288 |         * Timedelta has no verification\n 289 | \n 290 |         In each case, NaT is considered compatible.\n 291 | \n 292 |         Parameters\n 293 |         ----------\n 294 |         other\n 295 | \n 296 |         Raises\n 297 |         ------\n 298 |         Exception\n 299 |         \"\"\"\n 300 |         raise AbstractMethodError(self)\n 301 | \n 302 |     # ------------------------------------------------------------------\n 303 | \n 304 |     def _box_func(self, x):\n 305 |         \"\"\"\n 306 |         box function to get object from internal representation\n 307 |         \"\"\"\n 308 |         raise AbstractMethodError(self)\n 309 | \n 310 |     def _box_values(self, values) -> np.ndarray:\n 311 |         \"\"\"\n 312 |         apply box func to passed values\n 313 |         \"\"\"\n 314 |         return lib.map_infer(values, self._box_func, convert=False)\n 315 | \n 316 |     def __iter__(self) -> Iterator:\n 317 |         if self.ndim > 1:\n 318 |             return (self[n] for n in range(len(self)))\n 319 |         else:\n 320 |             return (self._box_func(v) for v in self.asi8)\n 321 | \n 322 |     @property\n 323 |     def asi8(self) -> npt.NDArray[np.int64]:\n 324 |         \"\"\"\n 325 |         Integer representation of the values.\n 326 | \n 327 |         Returns\n 328 |         -------\n 329 |         ndarray\n 330 |             An ndarray with int64 dtype.\n 331 |         \"\"\"\n 332 |         # do not cache or you'll create a memory leak\n 333 |         return self._ndarray.view(\"i8\")\n 334 | \n 335 |     # ----------------------------------------------------------------\n 336 |     # Rendering Methods\n 337 | \n 338 |     def _format_native_types(\n 339 |         self, *, na_rep: str | float = \"NaT\", date_format=None\n 340 |     ) -> npt.NDArray[np.object_]:\n 341 |         \"\"\"\n 342 |         Helper method for astype when converting to strings.\n 343 | \n 344 |         Returns\n 345 |         -------\n 346 |         ndarray[str]\n 347 |         \"\"\"\n 348 |         raise AbstractMethodError(self)\n 349 | \n 350 |     def _formatter(self, boxed: bool = False) -> Callable[[object], str]:\n 351 |         # TODO: Remove Datetime & DatetimeTZ formatters.\n 352 |         return \"'{}'\".format\n 353 | \n 354 |     # ----------------------------------------------------------------\n 355 |     # Array-Like / EA-Interface Methods\n 356 | \n 357 |     def __array__(\n 358 |         self, dtype: NpDtype | None = None, copy: bool | None = None\n 359 |     ) -> np.ndarray:\n 360 |         # used for Timedelta/DatetimeArray, overwritten by PeriodArray\n 361 |         if is_object_dtype(dtype):\n 362 |             return np.array(list(self), dtype=object)\n 363 |         return self._ndarray\n 364 | \n 365 |     @overload\n 366 |     def __getitem__(self, key: ScalarIndexer) -> DTScalarOrNaT: ...\n 367 | \n 368 |     @overload\n 369 |     def __getitem__(\n 370 |         self,\n 371 |         key: SequenceIndexer | PositionalIndexerTuple,\n 372 |     ) -> Self: ...\n 373 | \n 374 |     def __getitem__(self, key: PositionalIndexer2D) -> Self | DTScalarOrNaT:\n 375 |         \"\"\"\n 376 |         This getitem defers to the underlying array, which by-definition can\n 377 |         only handle list-likes, slices, and integer scalars\n 378 |         \"\"\"\n 379 |         # Use cast as we know we will get back a DatetimeLikeArray or DTScalar,\n 380 |         # but skip evaluating the Union at runtime for performance\n 381 |         # (see https://github.com/pandas-dev/pandas/pull/44624)\n 382 |         result = cast(\"Union[Self, DTScalarOrNaT]\", super().__getitem__(key))\n 383 |         if lib.is_scalar(result):\n 384 |             return result\n 385 |         else:\n 386 |             # At this point we know the result is an array.\n 387 |             result = cast(Self, result)\n 388 |         result._freq = self._get_getitem_freq(key)\n 389 |         return result\n 390 | \n 391 |     def _get_getitem_freq(self, key) -> BaseOffset | None:\n 392 |         \"\"\"\n 393 |         Find the `freq` attribute to assign to the result of a __getitem__ lookup.\n 394 |         \"\"\"\n 395 |         is_period = isinstance(self.dtype, PeriodDtype)\n 396 |         if is_period:\n 397 |             freq = self.freq\n 398 |         elif self.ndim != 1:\n 399 |             freq = None\n 400 |         else:\n 401 |             key = check_array_indexer(self, key)  # maybe ndarray[bool] -> slice\n 402 |             freq = None\n 403 |             if isinstance(key, slice):\n 404 |                 if self.freq is not None and key.step is not None:\n 405 |                     freq = key.step * self.freq\n 406 |                 else:\n 407 |                     freq = self.freq\n 408 |             elif key is Ellipsis:\n 409 |                 # GH#21282 indexing with Ellipsis is similar to a full slice,\n 410 |                 #  should preserve `freq` attribute\n 411 |                 freq = self.freq\n 412 |             elif com.is_bool_indexer(key):\n 413 |                 new_key = lib.maybe_booleans_to_slice(key.view(np.uint8))\n 414 |                 if isinstance(new_key, slice):\n 415 |                     return self._get_getitem_freq(new_key)\n 416 |         return freq\n 417 | \n 418 |     # error: Argument 1 of \"__setitem__\" is incompatible with supertype\n 419 |     # \"ExtensionArray\"; supertype defines the argument type as \"Union[int,\n 420 |     # ndarray]\"\n 421 |     def __setitem__(\n 422 |         self,\n 423 |         key: int | Sequence[int] | Sequence[bool] | slice,\n 424 |         value: NaTType | Any | Sequence[Any],\n 425 |     ) -> None:\n 426 |         # I'm fudging the types a bit here. \"Any\" above really depends\n 427 |         # on type(self). For PeriodArray, it's Period (or stuff coercible\n 428 |         # to a period in from_sequence). For DatetimeArray, it's Timestamp...\n 429 |         # I don't know if mypy can do that, possibly with Generics.\n 430 |         # https://mypy.readthedocs.io/en/latest/generics.html\n 431 | \n 432 |         no_op = check_setitem_lengths(key, value, self)\n 433 | \n 434 |         # Calling super() before the no_op short-circuit means that we raise\n 435 |         #  on invalid 'value' even if this is a no-op, e.g. wrong-dtype empty array.\n 436 |         super().__setitem__(key, value)\n 437 | \n 438 |         if no_op:\n 439 |             return\n 440 | \n 441 |         self._maybe_clear_freq()\n 442 | \n 443 |     def _maybe_clear_freq(self) -> None:\n 444 |         # inplace operations like __setitem__ may invalidate the freq of\n 445 |         # DatetimeArray and TimedeltaArray\n 446 |         pass\n 447 | \n 448 |     def astype(self, dtype, copy: bool = True):\n 449 |         # Some notes on cases we don't have to handle here in the base class:\n 450 |         #   1. PeriodArray.astype handles period -> period\n 451 |         #   2. DatetimeArray.astype handles conversion between tz.\n 452 |         #   3. DatetimeArray.astype handles datetime -> period\n 453 |         dtype = pandas_dtype(dtype)\n 454 | \n 455 |         if dtype == object:\n 456 |             if self.dtype.kind == \"M\":\n 457 |                 self = cast(\"DatetimeArray\", self)\n 458 |                 # *much* faster than self._box_values\n 459 |                 #  for e.g. test_get_loc_tuple_monotonic_above_size_cutoff\n 460 |                 i8data = self.asi8\n 461 |                 converted = ints_to_pydatetime(\n 462 |                     i8data,\n 463 |                     tz=self.tz,\n 464 |                     box=\"timestamp\",\n 465 |                     reso=self._creso,\n 466 |                 )\n 467 |                 return converted\n 468 | \n 469 |             elif self.dtype.kind == \"m\":\n 470 |                 return ints_to_pytimedelta(self._ndarray, box=True)\n 471 | \n 472 |             return self._box_values(self.asi8.ravel()).reshape(self.shape)\n 473 | \n 474 |         elif is_string_dtype(dtype):\n 475 |             if isinstance(dtype, ExtensionDtype):\n 476 |                 arr_object = self._format_native_types(na_rep=dtype.na_value)  # type: ignore[arg-type]\n 477 |                 cls = dtype.construct_array_type()\n 478 |                 return cls._from_sequence(arr_object, dtype=dtype, copy=False)\n 479 |             else:\n 480 |                 return self._format_native_types()\n 481 | \n 482 |         elif isinstance(dtype, ExtensionDtype):\n 483 |             return super().astype(dtype, copy=copy)\n 484 |         elif dtype.kind in \"iu\":\n 485 |             # we deliberately ignore int32 vs. int64 here.\n 486 |             # See https://github.com/pandas-dev/pandas/issues/24381 for more.\n 487 |             values = self.asi8\n 488 |             if dtype != np.int64:\n 489 |                 raise TypeError(\n 490 |                     f\"Converting from {self.dtype} to {dtype} is not supported. \"\n 491 |                     \"Do obj.astype('int64').astype(dtype) instead\"\n 492 |                 )\n 493 | \n 494 |             if copy:\n 495 |                 values = values.copy()\n 496 |             return values\n 497 |         elif (dtype.kind in \"mM\" and self.dtype != dtype) or dtype.kind == \"f\":\n 498 |             # disallow conversion between datetime/timedelta,\n 499 |             # and conversions for any datetimelike to float\n 500 |             msg = f\"Cannot cast {type(self).__name__} to dtype {dtype}\"\n 501 |             raise TypeError(msg)\n 502 |         else:\n 503 |             return np.asarray(self, dtype=dtype)\n 504 | \n 505 |     @overload\n 506 |     def view(self) -> Self: ...\n 507 | \n 508 |     @overload\n 509 |     def view(self, dtype: Literal[\"M8[ns]\"]) -> DatetimeArray: ...\n 510 | \n 511 |     @overload\n 512 |     def view(self, dtype: Literal[\"m8[ns]\"]) -> TimedeltaArray: ...\n 513 | \n 514 |     @overload\n 515 |     def view(self, dtype: Dtype | None = ...) -> ArrayLike: ...\n 516 | \n 517 |     def view(self, dtype: Dtype | None = None) -> ArrayLike:\n 518 |         # we need to explicitly call super() method as long as the `@overload`s\n 519 |         #  are present in this file.\n 520 |         return super().view(dtype)\n 521 | \n 522 |     # ------------------------------------------------------------------\n 523 |     # Validation Methods\n 524 |     # TODO: try to de-duplicate these, ensure identical behavior\n 525 | \n 526 |     def _validate_comparison_value(self, other):\n 527 |         if isinstance(other, str):\n 528 |             try:\n 529 |                 # GH#18435 strings get a pass from tzawareness compat\n 530 |                 other = self._scalar_from_string(other)\n 531 |             except (ValueError, IncompatibleFrequency) as err:\n 532 |                 # failed to parse as Timestamp/Timedelta/Period\n 533 |                 raise InvalidComparison(other) from err\n 534 | \n 535 |         if isinstance(other, self._recognized_scalars) or other is NaT:\n 536 |             other = self._scalar_type(other)\n 537 |             try:\n 538 |                 self._check_compatible_with(other)\n 539 |             except (TypeError, IncompatibleFrequency) as err:\n 540 |                 # e.g. tzawareness mismatch\n 541 |                 raise InvalidComparison(other) from err\n 542 | \n 543 |         elif not is_list_like(other):\n 544 |             raise InvalidComparison(other)\n 545 | \n 546 |         elif len(other) != len(self):\n 547 |             raise ValueError(\"Lengths must match\")\n 548 | \n 549 |         else:\n 550 |             try:\n 551 |                 other = self._validate_listlike(other, allow_object=True)\n 552 |                 self._check_compatible_with(other)\n 553 |             except (TypeError, IncompatibleFrequency) as err:\n 554 |                 if is_object_dtype(getattr(other, \"dtype\", None)):\n 555 |                     # We will have to operate element-wise\n 556 |                     pass\n 557 |                 else:\n 558 |                     raise InvalidComparison(other) from err\n 559 | \n 560 |         return other\n 561 | \n 562 |     def _validate_scalar(\n 563 |         self,\n 564 |         value,\n 565 |         *,\n 566 |         allow_listlike: bool = False,\n 567 |         unbox: bool = True,\n 568 |     ):\n 569 |         \"\"\"\n 570 |         Validate that the input value can be cast to our scalar_type.\n 571 | \n 572 |         Parameters\n 573 |         ----------\n 574 |         value : object\n 575 |         allow_listlike: bool, default False\n 576 |             When raising an exception, whether the message should say\n 577 |             listlike inputs are allowed.\n 578 |         unbox : bool, default True\n 579 |             Whether to unbox the result before returning.  Note: unbox=False\n 580 |             skips the setitem compatibility check.\n 581 | \n 582 |         Returns\n 583 |         -------\n 584 |         self._scalar_type or NaT\n 585 |         \"\"\"\n 586 |         if isinstance(value, self._scalar_type):\n 587 |             pass\n 588 | \n 589 |         elif isinstance(value, str):\n 590 |             # NB: Careful about tzawareness\n 591 |             try:\n 592 |                 value = self._scalar_from_string(value)\n 593 |             except ValueError as err:\n 594 |                 msg = self._validation_error_message(value, allow_listlike)\n 595 |                 raise TypeError(msg) from err\n 596 | \n 597 |         elif is_valid_na_for_dtype(value, self.dtype):\n 598 |             # GH#18295\n 599 |             value = NaT\n 600 | \n 601 |         elif isna(value):\n 602 |             # if we are dt64tz and value is dt64(\"NaT\"), dont cast to NaT,\n 603 |             #  or else we'll fail to raise in _unbox_scalar\n 604 |             msg = self._validation_error_message(value, allow_listlike)\n 605 |             raise TypeError(msg)\n 606 | \n 607 |         elif isinstance(value, self._recognized_scalars):\n 608 |             # error: Argument 1 to \"Timestamp\" has incompatible type \"object\"; expected\n 609 |             # \"integer[Any] | float | str | date | datetime | datetime64\"\n 610 |             value = self._scalar_type(value)  # type: ignore[arg-type]\n 611 | \n 612 |         else:\n 613 |             msg = self._validation_error_message(value, allow_listlike)\n 614 |             raise TypeError(msg)\n 615 | \n 616 |         if not unbox:\n 617 |             # NB: In general NDArrayBackedExtensionArray will unbox here;\n 618 |             #  this option exists to prevent a performance hit in\n 619 |             #  TimedeltaIndex.get_loc\n 620 |             return value\n 621 |         return self._unbox_scalar(value)\n 622 | \n 623 |     def _validation_error_message(self, value, allow_listlike: bool = False) -> str:\n 624 |         \"\"\"\n 625 |         Construct an exception message on validation error.\n 626 | \n 627 |         Some methods allow only scalar inputs, while others allow either scalar\n 628 |         or listlike.\n 629 | \n 630 |         Parameters\n 631 |         ----------\n 632 |         allow_listlike: bool, default False\n 633 | \n 634 |         Returns\n 635 |         -------\n 636 |         str\n 637 |         \"\"\"\n 638 |         if hasattr(value, \"dtype\") and getattr(value, \"ndim\", 0) > 0:\n 639 |             msg_got = f\"{value.dtype} array\"\n 640 |         else:\n 641 |             msg_got = f\"'{type(value).__name__}'\"\n 642 |         if allow_listlike:\n 643 |             msg = (\n 644 |                 f\"value should be a '{self._scalar_type.__name__}', 'NaT', \"\n 645 |                 f\"or array of those. Got {msg_got} instead.\"\n 646 |             )\n 647 |         else:\n 648 |             msg = (\n 649 |                 f\"value should be a '{self._scalar_type.__name__}' or 'NaT'. \"\n 650 |                 f\"Got {msg_got} instead.\"\n 651 |             )\n 652 |         return msg\n 653 | \n 654 |     def _validate_listlike(self, value, allow_object: bool = False):\n 655 |         if isinstance(value, type(self)):\n 656 |             if self.dtype.kind in \"mM\" and not allow_object and self.unit != value.unit:  # type: ignore[attr-defined]\n 657 |                 # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 658 |                 value = value.as_unit(self.unit, round_ok=False)  # type: ignore[attr-defined]\n 659 |             return value\n 660 | \n 661 |         if isinstance(value, list) and len(value) == 0:\n 662 |             # We treat empty list as our own dtype.\n 663 |             return type(self)._from_sequence([], dtype=self.dtype)\n 664 | \n 665 |         if hasattr(value, \"dtype\") and value.dtype == object:\n 666 |             # `array` below won't do inference if value is an Index or Series.\n 667 |             #  so do so here.  in the Index case, inferred_type may be cached.\n 668 |             if lib.infer_dtype(value) in self._infer_matches:\n 669 |                 try:\n 670 |                     value = type(self)._from_sequence(value)\n 671 |                 except (ValueError, TypeError) as err:\n 672 |                     if allow_object:\n 673 |                         return value\n 674 |                     msg = self._validation_error_message(value, True)\n 675 |                     raise TypeError(msg) from err\n 676 | \n 677 |         # Do type inference if necessary up front (after unpacking\n 678 |         # NumpyExtensionArray)\n 679 |         # e.g. we passed PeriodIndex.values and got an ndarray of Periods\n 680 |         value = extract_array(value, extract_numpy=True)\n 681 |         value = pd_array(value)\n 682 |         value = extract_array(value, extract_numpy=True)\n 683 | \n 684 |         if is_all_strings(value):\n 685 |             # We got a StringArray\n 686 |             try:\n 687 |                 # TODO: Could use from_sequence_of_strings if implemented\n 688 |                 # Note: passing dtype is necessary for PeriodArray tests\n 689 |                 value = type(self)._from_sequence(value, dtype=self.dtype)\n 690 |             except ValueError:\n 691 |                 pass\n 692 | \n 693 |         if isinstance(value.dtype, CategoricalDtype):\n 694 |             # e.g. we have a Categorical holding self.dtype\n 695 |             if value.categories.dtype == self.dtype:\n 696 |                 # TODO: do we need equal dtype or just comparable?\n 697 |                 value = value._internal_get_values()\n 698 |                 value = extract_array(value, extract_numpy=True)\n 699 | \n 700 |         if allow_object and is_object_dtype(value.dtype):\n 701 |             pass\n 702 | \n 703 |         elif not type(self)._is_recognized_dtype(value.dtype):\n 704 |             msg = self._validation_error_message(value, True)\n 705 |             raise TypeError(msg)\n 706 | \n 707 |         if self.dtype.kind in \"mM\" and not allow_object:\n 708 |             # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 709 |             value = value.as_unit(self.unit, round_ok=False)  # type: ignore[attr-defined]\n 710 |         return value\n 711 | \n 712 |     def _validate_setitem_value(self, value):\n 713 |         if is_list_like(value):\n 714 |             value = self._validate_listlike(value)\n 715 |         else:\n 716 |             return self._validate_scalar(value, allow_listlike=True)\n 717 | \n 718 |         return self._unbox(value)\n 719 | \n 720 |     @final\n 721 |     def _unbox(self, other) -> np.int64 | np.datetime64 | np.timedelta64 | np.ndarray:\n 722 |         \"\"\"\n 723 |         Unbox either a scalar with _unbox_scalar or an instance of our own type.\n 724 |         \"\"\"\n 725 |         if lib.is_scalar(other):\n 726 |             other = self._unbox_scalar(other)\n 727 |         else:\n 728 |             # same type as self\n 729 |             self._check_compatible_with(other)\n 730 |             other = other._ndarray\n 731 |         return other\n 732 | \n 733 |     # ------------------------------------------------------------------\n 734 |     # Additional array methods\n 735 |     #  These are not part of the EA API, but we implement them because\n 736 |     #  pandas assumes they're there.\n 737 | \n 738 |     @ravel_compat\n 739 |     def map(self, mapper, na_action: Literal[\"ignore\"] | None = None):\n 740 |         from pandas import Index\n 741 | \n 742 |         result = map_array(self, mapper, na_action=na_action)\n 743 |         result = Index(result)\n 744 | \n 745 |         if isinstance(result, ABCMultiIndex):\n 746 |             return result.to_numpy()\n 747 |         else:\n 748 |             return result.array\n 749 | \n 750 |     def isin(self, values: ArrayLike) -> npt.NDArray[np.bool_]:\n 751 |         \"\"\"\n 752 |         Compute boolean array of whether each value is found in the\n 753 |         passed set of values.\n 754 | \n 755 |         Parameters\n 756 |         ----------\n 757 |         values : np.ndarray or ExtensionArray\n 758 | \n 759 |         Returns\n 760 |         -------\n 761 |         ndarray[bool]\n 762 |         \"\"\"\n 763 |         if values.dtype.kind in \"fiuc\":\n 764 |             # TODO: de-duplicate with equals, validate_comparison_value\n 765 |             return np.zeros(self.shape, dtype=bool)\n 766 | \n 767 |         values = ensure_wrapped_if_datetimelike(values)\n 768 | \n 769 |         if not isinstance(values, type(self)):\n 770 |             if values.dtype == object:\n 771 |                 values = lib.maybe_convert_objects(\n 772 |                     values,  # type: ignore[arg-type]\n 773 |                     convert_non_numeric=True,\n 774 |                     dtype_if_all_nat=self.dtype,\n 775 |                 )\n 776 |                 if values.dtype != object:\n 777 |                     return self.isin(values)\n 778 |                 else:\n 779 |                     # TODO: Deprecate this case\n 780 |                     # https://github.com/pandas-dev/pandas/pull/58645/files#r1604055791\n 781 |                     return isin(self.astype(object), values)\n 782 |             return np.zeros(self.shape, dtype=bool)\n 783 | \n 784 |         if self.dtype.kind in \"mM\":\n 785 |             self = cast(\"DatetimeArray | TimedeltaArray\", self)\n 786 |             # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 787 |             values = values.as_unit(self.unit)  # type: ignore[attr-defined]\n 788 | \n 789 |         try:\n 790 |             # error: Argument 1 to \"_check_compatible_with\" of \"DatetimeLikeArrayMixin\"\n 791 |             # has incompatible type \"ExtensionArray | ndarray[Any, Any]\"; expected\n 792 |             # \"Period | Timestamp | Timedelta | NaTType\"\n 793 |             self._check_compatible_with(values)  # type: ignore[arg-type]\n 794 |         except (TypeError, ValueError):\n 795 |             # Includes tzawareness mismatch and IncompatibleFrequencyError\n 796 |             return np.zeros(self.shape, dtype=bool)\n 797 | \n 798 |         # error: Item \"ExtensionArray\" of \"ExtensionArray | ndarray[Any, Any]\"\n 799 |         # has no attribute \"asi8\"\n 800 |         return isin(self.asi8, values.asi8)  # type: ignore[union-attr]\n 801 | \n 802 |     # ------------------------------------------------------------------\n 803 |     # Null Handling\n 804 | \n 805 |     def isna(self) -> npt.NDArray[np.bool_]:\n 806 |         return self._isnan\n 807 | \n 808 |     @property  # NB: override with cache_readonly in immutable subclasses\n 809 |     def _isnan(self) -> npt.NDArray[np.bool_]:\n 810 |         \"\"\"\n 811 |         return if each value is nan\n 812 |         \"\"\"\n 813 |         return self.asi8 == iNaT\n 814 | \n 815 |     @property  # NB: override with cache_readonly in immutable subclasses\n 816 |     def _hasna(self) -> bool:\n 817 |         \"\"\"\n 818 |         return if I have any nans; enables various perf speedups\n 819 |         \"\"\"\n 820 |         return bool(self._isnan.any())\n 821 | \n 822 |     def _maybe_mask_results(\n 823 |         self, result: np.ndarray, fill_value=iNaT, convert=None\n 824 |     ) -> np.ndarray:\n 825 |         \"\"\"\n 826 |         Parameters\n 827 |         ----------\n 828 |         result : np.ndarray\n 829 |         fill_value : object, default iNaT\n 830 |         convert : str, dtype or None\n 831 | \n 832 |         Returns\n 833 |         -------\n 834 |         result : ndarray with values replace by the fill_value\n 835 | \n 836 |         mask the result if needed, convert to the provided dtype if its not\n 837 |         None\n 838 | \n 839 |         This is an internal routine.\n 840 |         \"\"\"\n 841 |         if self._hasna:\n 842 |             if convert:\n 843 |                 result = result.astype(convert)\n 844 |             if fill_value is None:\n 845 |                 fill_value = np.nan\n 846 |             np.putmask(result, self._isnan, fill_value)\n 847 |         return result\n 848 | \n 849 |     # ------------------------------------------------------------------\n 850 |     # Frequency Properties/Methods\n 851 | \n 852 |     @property\n 853 |     def freqstr(self) -> str | None:\n 854 |         \"\"\"\n 855 |         Return the frequency object as a string if it's set, otherwise None.\n 856 | \n 857 |         See Also\n 858 |         --------\n 859 |         DatetimeIndex.inferred_freq : Returns a string representing a frequency\n 860 |             generated by infer_freq.\n 861 | \n 862 |         Examples\n 863 |         --------\n 864 |         For DatetimeIndex:\n 865 | \n 866 |         >>> idx = pd.DatetimeIndex([\"1/1/2020 10:00:00+00:00\"], freq=\"D\")\n 867 |         >>> idx.freqstr\n 868 |         'D'\n 869 | \n 870 |         The frequency can be inferred if there are more than 2 points:\n 871 | \n 872 |         >>> idx = pd.DatetimeIndex(\n 873 |         ...     [\"2018-01-01\", \"2018-01-03\", \"2018-01-05\"], freq=\"infer\"\n 874 |         ... )\n 875 |         >>> idx.freqstr\n 876 |         '2D'\n 877 | \n 878 |         For PeriodIndex:\n 879 | \n 880 |         >>> idx = pd.PeriodIndex([\"2023-1\", \"2023-2\", \"2023-3\"], freq=\"M\")\n 881 |         >>> idx.freqstr\n 882 |         'M'\n 883 |         \"\"\"\n 884 |         if self.freq is None:\n 885 |             return None\n 886 |         return self.freq.freqstr\n 887 | \n 888 |     @property  # NB: override with cache_readonly in immutable subclasses\n 889 |     def inferred_freq(self) -> str | None:\n 890 |         \"\"\"\n 891 |         Tries to return a string representing a frequency generated by infer_freq.\n 892 | \n 893 |         Returns None if it can't autodetect the frequency.\n 894 | \n 895 |         See Also\n 896 |         --------\n 897 |         DatetimeIndex.freqstr : Return the frequency object as a string if it's set,\n 898 |             otherwise None.\n 899 | \n 900 |         Examples\n 901 |         --------\n 902 |         For DatetimeIndex:\n 903 | \n 904 |         >>> idx = pd.DatetimeIndex([\"2018-01-01\", \"2018-01-03\", \"2018-01-05\"])\n 905 |         >>> idx.inferred_freq\n 906 |         '2D'\n 907 | \n 908 |         For TimedeltaIndex:\n 909 | \n 910 |         >>> tdelta_idx = pd.to_timedelta([\"0 days\", \"10 days\", \"20 days\"])\n 911 |         >>> tdelta_idx\n 912 |         TimedeltaIndex(['0 days', '10 days', '20 days'],\n 913 |                        dtype='timedelta64[ns]', freq=None)\n 914 |         >>> tdelta_idx.inferred_freq\n 915 |         '10D'\n 916 |         \"\"\"\n 917 |         if self.ndim != 1:\n 918 |             return None\n 919 |         try:\n 920 |             return frequencies.infer_freq(self)\n 921 |         except ValueError:\n 922 |             return None\n 923 | \n 924 |     @property  # NB: override with cache_readonly in immutable subclasses\n 925 |     def _resolution_obj(self) -> Resolution | None:\n 926 |         freqstr = self.freqstr\n 927 |         if freqstr is None:\n 928 |             return None\n 929 |         try:\n 930 |             return Resolution.get_reso_from_freqstr(freqstr)\n 931 |         except KeyError:\n 932 |             return None\n 933 | \n 934 |     @property  # NB: override with cache_readonly in immutable subclasses\n 935 |     def resolution(self) -> str:\n 936 |         \"\"\"\n 937 |         Returns day, hour, minute, second, millisecond or microsecond\n 938 |         \"\"\"\n 939 |         # error: Item \"None\" of \"Optional[Any]\" has no attribute \"attrname\"\n 940 |         return self._resolution_obj.attrname  # type: ignore[union-attr]\n 941 | \n 942 |     # monotonicity/uniqueness properties are called via frequencies.infer_freq,\n 943 |     #  see GH#23789\n 944 | \n 945 |     @property\n 946 |     def _is_monotonic_increasing(self) -> bool:\n 947 |         return algos.is_monotonic(self.asi8, timelike=True)[0]\n 948 | \n 949 |     @property\n 950 |     def _is_monotonic_decreasing(self) -> bool:\n 951 |         return algos.is_monotonic(self.asi8, timelike=True)[1]\n 952 | \n 953 |     @property\n 954 |     def _is_unique(self) -> bool:\n 955 |         return len(unique1d(self.asi8.ravel(\"K\"))) == self.size\n 956 | \n 957 |     # ------------------------------------------------------------------\n 958 |     # Arithmetic Methods\n 959 | \n 960 |     def _cmp_method(self, other, op):\n 961 |         if self.ndim > 1 and getattr(other, \"shape\", None) == self.shape:\n 962 |             # TODO: handle 2D-like listlikes\n 963 |             return op(self.ravel(), other.ravel()).reshape(self.shape)\n 964 | \n 965 |         try:\n 966 |             other = self._validate_comparison_value(other)\n 967 |         except InvalidComparison:\n 968 |             return invalid_comparison(self, other, op)\n 969 | \n 970 |         dtype = getattr(other, \"dtype\", None)\n 971 |         if is_object_dtype(dtype):\n 972 |             # We have to use comp_method_OBJECT_ARRAY instead of numpy\n 973 |             #  comparison otherwise it would raise when comparing to None\n 974 |             result = ops.comp_method_OBJECT_ARRAY(\n 975 |                 op, np.asarray(self.astype(object)), other\n 976 |             )\n 977 |             return result\n 978 |         if other is NaT:\n 979 |             if op is operator.ne:\n 980 |                 result = np.ones(self.shape, dtype=bool)\n 981 |             else:\n 982 |                 result = np.zeros(self.shape, dtype=bool)\n 983 |             return result\n 984 | \n 985 |         if not isinstance(self.dtype, PeriodDtype):\n 986 |             self = cast(TimelikeOps, self)\n 987 |             if self._creso != other._creso:\n 988 |                 if not isinstance(other, type(self)):\n 989 |                     # i.e. Timedelta/Timestamp, cast to ndarray and let\n 990 |                     #  compare_mismatched_resolutions handle broadcasting\n 991 |                     try:\n 992 |                         # GH#52080 see if we can losslessly cast to shared unit\n 993 |                         other = other.as_unit(self.unit, round_ok=False)\n 994 |                     except ValueError:\n 995 |                         other_arr = np.array(other.asm8)\n 996 |                         return compare_mismatched_resolutions(\n 997 |                             self._ndarray, other_arr, op\n 998 |                         )\n 999 |                 else:\n1000 |                     other_arr = other._ndarray\n1001 |                     return compare_mismatched_resolutions(self._ndarray, other_arr, op)\n1002 | \n1003 |         other_vals = self._unbox(other)\n1004 |         # GH#37462 comparison on i8 values is almost 2x faster than M8/m8\n1005 |         result = op(self._ndarray.view(\"i8\"), other_vals.view(\"i8\"))\n1006 | \n1007 |         o_mask = isna(other)\n1008 |         mask = self._isnan | o_mask\n1009 |         if mask.any():\n1010 |             nat_result = op is operator.ne\n1011 |             np.putmask(result, mask, nat_result)\n1012 | \n1013 |         return result\n1014 | \n1015 |     # pow is invalid for all three subclasses; TimedeltaArray will override\n1016 |     #  the multiplication and division ops\n1017 |     __pow__ = _make_unpacked_invalid_op(\"__pow__\")\n1018 |     __rpow__ = _make_unpacked_invalid_op(\"__rpow__\")\n1019 |     __mul__ = _make_unpacked_invalid_op(\"__mul__\")\n1020 |     __rmul__ = _make_unpacked_invalid_op(\"__rmul__\")\n1021 |     __truediv__ = _make_unpacked_invalid_op(\"__truediv__\")\n1022 |     __rtruediv__ = _make_unpacked_invalid_op(\"__rtruediv__\")\n1023 |     __floordiv__ = _make_unpacked_invalid_op(\"__floordiv__\")\n1024 |     __rfloordiv__ = _make_unpacked_invalid_op(\"__rfloordiv__\")\n1025 |     __mod__ = _make_unpacked_invalid_op(\"__mod__\")\n1026 |     __rmod__ = _make_unpacked_invalid_op(\"__rmod__\")\n1027 |     __divmod__ = _make_unpacked_invalid_op(\"__divmod__\")\n1028 |     __rdivmod__ = _make_unpacked_invalid_op(\"__rdivmod__\")\n1029 | \n1030 |     @final\n1031 |     def _get_i8_values_and_mask(\n1032 |         self, other\n1033 |     ) -> tuple[int | npt.NDArray[np.int64], None | npt.NDArray[np.bool_]]:\n1034 |         \"\"\"\n1035 |         Get the int64 values and b_mask to pass to add_overflowsafe.\n1036 |         \"\"\"\n1037 |         if isinstance(other, Period):\n1038 |             i8values = other.ordinal\n1039 |             mask = None\n1040 |         elif isinstance(other, (Timestamp, Timedelta)):\n1041 |             i8values = other._value\n1042 |             mask = None\n1043 |         else:\n1044 |             # PeriodArray, DatetimeArray, TimedeltaArray\n1045 |             mask = other._isnan\n1046 |             i8values = other.asi8\n1047 |         return i8values, mask\n1048 | \n1049 |     @final\n1050 |     def _get_arithmetic_result_freq(self, other) -> BaseOffset | None:\n1051 |         \"\"\"\n1052 |         Check if we can preserve self.freq in addition or subtraction.\n1053 |         \"\"\"\n1054 |         # Adding or subtracting a Timedelta/Timestamp scalar is freq-preserving\n1055 |         #  whenever self.freq is a Tick\n1056 |         if isinstance(self.dtype, PeriodDtype):\n1057 |             return self.freq\n1058 |         elif not lib.is_scalar(other):\n1059 |             return None\n1060 |         elif isinstance(self.freq, Tick):\n1061 |             # In these cases\n1062 |             return self.freq\n1063 |         return None\n1064 | \n1065 |     @final\n1066 |     def _add_datetimelike_scalar(self, other) -> DatetimeArray:\n1067 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1068 |             raise TypeError(\n1069 |                 f\"cannot add {type(self).__name__} and {type(other).__name__}\"\n1070 |             )\n1071 | \n1072 |         self = cast(\"TimedeltaArray\", self)\n1073 | \n1074 |         from pandas.core.arrays import DatetimeArray\n1075 |         from pandas.core.arrays.datetimes import tz_to_dtype\n1076 | \n1077 |         assert other is not NaT\n1078 |         if isna(other):\n1079 |             # i.e. np.datetime64(\"NaT\")\n1080 |             # In this case we specifically interpret NaT as a datetime, not\n1081 |             # the timedelta interpretation we would get by returning self + NaT\n1082 |             result = self._ndarray + NaT.to_datetime64().astype(f\"M8[{self.unit}]\")\n1083 |             # Preserve our resolution\n1084 |             return DatetimeArray._simple_new(result, dtype=result.dtype)\n1085 | \n1086 |         other = Timestamp(other)\n1087 |         self, other = self._ensure_matching_resos(other)\n1088 |         self = cast(\"TimedeltaArray\", self)\n1089 | \n1090 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1091 |         result = add_overflowsafe(self.asi8, np.asarray(other_i8, dtype=\"i8\"))\n1092 |         res_values = result.view(f\"M8[{self.unit}]\")\n1093 | \n1094 |         dtype = tz_to_dtype(tz=other.tz, unit=self.unit)\n1095 |         res_values = result.view(f\"M8[{self.unit}]\")\n1096 |         new_freq = self._get_arithmetic_result_freq(other)\n1097 |         return DatetimeArray._simple_new(res_values, dtype=dtype, freq=new_freq)\n1098 | \n1099 |     @final\n1100 |     def _add_datetime_arraylike(self, other: DatetimeArray) -> DatetimeArray:\n1101 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1102 |             raise TypeError(\n1103 |                 f\"cannot add {type(self).__name__} and {type(other).__name__}\"\n1104 |             )\n1105 | \n1106 |         # defer to DatetimeArray.__add__\n1107 |         return other + self\n1108 | \n1109 |     @final\n1110 |     def _sub_datetimelike_scalar(\n1111 |         self, other: datetime | np.datetime64\n1112 |     ) -> TimedeltaArray:\n1113 |         if self.dtype.kind != \"M\":\n1114 |             raise TypeError(f\"cannot subtract a datelike from a {type(self).__name__}\")\n1115 | \n1116 |         self = cast(\"DatetimeArray\", self)\n1117 |         # subtract a datetime from myself, yielding a ndarray[timedelta64[ns]]\n1118 | \n1119 |         if isna(other):\n1120 |             # i.e. np.datetime64(\"NaT\")\n1121 |             return self - NaT\n1122 | \n1123 |         ts = Timestamp(other)\n1124 | \n1125 |         self, ts = self._ensure_matching_resos(ts)\n1126 |         return self._sub_datetimelike(ts)\n1127 | \n1128 |     @final\n1129 |     def _sub_datetime_arraylike(self, other: DatetimeArray) -> TimedeltaArray:\n1130 |         if self.dtype.kind != \"M\":\n1131 |             raise TypeError(f\"cannot subtract a datelike from a {type(self).__name__}\")\n1132 | \n1133 |         if len(self) != len(other):\n1134 |             raise ValueError(\"cannot add indices of unequal length\")\n1135 | \n1136 |         self = cast(\"DatetimeArray\", self)\n1137 | \n1138 |         self, other = self._ensure_matching_resos(other)\n1139 |         return self._sub_datetimelike(other)\n1140 | \n1141 |     @final\n1142 |     def _sub_datetimelike(self, other: Timestamp | DatetimeArray) -> TimedeltaArray:\n1143 |         self = cast(\"DatetimeArray\", self)\n1144 | \n1145 |         from pandas.core.arrays import TimedeltaArray\n1146 | \n1147 |         try:\n1148 |             self._assert_tzawareness_compat(other)\n1149 |         except TypeError as err:\n1150 |             new_message = str(err).replace(\"compare\", \"subtract\")\n1151 |             raise type(err)(new_message) from err\n1152 | \n1153 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1154 |         res_values = add_overflowsafe(self.asi8, np.asarray(-other_i8, dtype=\"i8\"))\n1155 |         res_m8 = res_values.view(f\"timedelta64[{self.unit}]\")\n1156 | \n1157 |         new_freq = self._get_arithmetic_result_freq(other)\n1158 |         new_freq = cast(\"Tick | None\", new_freq)\n1159 |         return TimedeltaArray._simple_new(res_m8, dtype=res_m8.dtype, freq=new_freq)\n1160 | \n1161 |     @final\n1162 |     def _add_period(self, other: Period) -> PeriodArray:\n1163 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1164 |             raise TypeError(f\"cannot add Period to a {type(self).__name__}\")\n1165 | \n1166 |         # We will wrap in a PeriodArray and defer to the reversed operation\n1167 |         from pandas.core.arrays.period import PeriodArray\n1168 | \n1169 |         i8vals = np.broadcast_to(other.ordinal, self.shape)\n1170 |         dtype = PeriodDtype(other.freq)\n1171 |         parr = PeriodArray(i8vals, dtype=dtype)\n1172 |         return parr + self\n1173 | \n1174 |     def _add_offset(self, offset):\n1175 |         raise AbstractMethodError(self)\n1176 | \n1177 |     def _add_timedeltalike_scalar(self, other):\n1178 |         \"\"\"\n1179 |         Add a delta of a timedeltalike\n1180 | \n1181 |         Returns\n1182 |         -------\n1183 |         Same type as self\n1184 |         \"\"\"\n1185 |         if isna(other):\n1186 |             # i.e np.timedelta64(\"NaT\")\n1187 |             new_values = np.empty(self.shape, dtype=\"i8\").view(self._ndarray.dtype)\n1188 |             new_values.fill(iNaT)\n1189 |             return type(self)._simple_new(new_values, dtype=self.dtype)\n1190 | \n1191 |         # PeriodArray overrides, so we only get here with DTA/TDA\n1192 |         self = cast(\"DatetimeArray | TimedeltaArray\", self)\n1193 |         other = Timedelta(other)\n1194 |         self, other = self._ensure_matching_resos(other)\n1195 |         return self._add_timedeltalike(other)\n1196 | \n1197 |     def _add_timedelta_arraylike(self, other: TimedeltaArray) -> Self:\n1198 |         \"\"\"\n1199 |         Add a delta of a TimedeltaIndex\n1200 | \n1201 |         Returns\n1202 |         -------\n1203 |         Same type as self\n1204 |         \"\"\"\n1205 |         # overridden by PeriodArray\n1206 | \n1207 |         if len(self) != len(other):\n1208 |             raise ValueError(\"cannot add indices of unequal length\")\n1209 | \n1210 |         self, other = cast(\n1211 |             \"DatetimeArray | TimedeltaArray\", self\n1212 |         )._ensure_matching_resos(other)\n1213 |         return self._add_timedeltalike(other)\n1214 | \n1215 |     @final\n1216 |     def _add_timedeltalike(self, other: Timedelta | TimedeltaArray) -> Self:\n1217 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1218 |         new_values = add_overflowsafe(self.asi8, np.asarray(other_i8, dtype=\"i8\"))\n1219 |         res_values = new_values.view(self._ndarray.dtype)\n1220 | \n1221 |         new_freq = self._get_arithmetic_result_freq(other)\n1222 | \n1223 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of \"NDArrayBacked\"\n1224 |         return type(self)._simple_new(\n1225 |             res_values,\n1226 |             dtype=self.dtype,\n1227 |             freq=new_freq,  # type: ignore[call-arg]\n1228 |         )\n1229 | \n1230 |     @final\n1231 |     def _add_nat(self) -> Self:\n1232 |         \"\"\"\n1233 |         Add pd.NaT to self\n1234 |         \"\"\"\n1235 |         if isinstance(self.dtype, PeriodDtype):\n1236 |             raise TypeError(\n1237 |                 f\"Cannot add {type(self).__name__} and {type(NaT).__name__}\"\n1238 |             )\n1239 | \n1240 |         # GH#19124 pd.NaT is treated like a timedelta for both timedelta\n1241 |         # and datetime dtypes\n1242 |         result = np.empty(self.shape, dtype=np.int64)\n1243 |         result.fill(iNaT)\n1244 |         result = result.view(self._ndarray.dtype)  # preserve reso\n1245 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of \"NDArrayBacked\"\n1246 |         return type(self)._simple_new(\n1247 |             result,\n1248 |             dtype=self.dtype,\n1249 |             freq=None,  # type: ignore[call-arg]\n1250 |         )\n1251 | \n1252 |     @final\n1253 |     def _sub_nat(self) -> np.ndarray:\n1254 |         \"\"\"\n1255 |         Subtract pd.NaT from self\n1256 |         \"\"\"\n1257 |         # GH#19124 Timedelta - datetime is not in general well-defined.\n1258 |         # We make an exception for pd.NaT, which in this case quacks\n1259 |         # like a timedelta.\n1260 |         # For datetime64 dtypes by convention we treat NaT as a datetime, so\n1261 |         # this subtraction returns a timedelta64 dtype.\n1262 |         # For period dtype, timedelta64 is a close-enough return dtype.\n1263 |         result = np.empty(self.shape, dtype=np.int64)\n1264 |         result.fill(iNaT)\n1265 |         if self.dtype.kind in \"mM\":\n1266 |             # We can retain unit in dtype\n1267 |             self = cast(\"DatetimeArray| TimedeltaArray\", self)\n1268 |             return result.view(f\"timedelta64[{self.unit}]\")\n1269 |         else:\n1270 |             return result.view(\"timedelta64[ns]\")\n1271 | \n1272 |     @final\n1273 |     def _sub_periodlike(self, other: Period | PeriodArray) -> npt.NDArray[np.object_]:\n1274 |         # If the operation is well-defined, we return an object-dtype ndarray\n1275 |         # of DateOffsets.  Null entries are filled with pd.NaT\n1276 |         if not isinstance(self.dtype, PeriodDtype):\n1277 |             raise TypeError(\n1278 |                 f\"cannot subtract {type(other).__name__} from {type(self).__name__}\"\n1279 |             )\n1280 | \n1281 |         self = cast(\"PeriodArray\", self)\n1282 |         self._check_compatible_with(other)\n1283 | \n1284 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1285 |         new_i8_data = add_overflowsafe(self.asi8, np.asarray(-other_i8, dtype=\"i8\"))\n1286 |         new_data = np.array([self.freq.base * x for x in new_i8_data])\n1287 | \n1288 |         if o_mask is None:\n1289 |             # i.e. Period scalar\n1290 |             mask = self._isnan\n1291 |         else:\n1292 |             # i.e. PeriodArray\n1293 |             mask = self._isnan | o_mask\n1294 |         new_data[mask] = NaT\n1295 |         return new_data\n1296 | \n1297 |     @final\n1298 |     def _addsub_object_array(self, other: npt.NDArray[np.object_], op) -> np.ndarray:\n1299 |         \"\"\"\n1300 |         Add or subtract array-like of DateOffset objects\n1301 | \n1302 |         Parameters\n1303 |         ----------\n1304 |         other : np.ndarray[object]\n1305 |         op : {operator.add, operator.sub}\n1306 | \n1307 |         Returns\n1308 |         -------\n1309 |         np.ndarray[object]\n1310 |             Except in fastpath case with length 1 where we operate on the\n1311 |             contained scalar.\n1312 |         \"\"\"\n1313 |         assert op in [operator.add, operator.sub]\n1314 |         if len(other) == 1 and self.ndim == 1:\n1315 |             # Note: without this special case, we could annotate return type\n1316 |             #  as ndarray[object]\n1317 |             # If both 1D then broadcasting is unambiguous\n1318 |             return op(self, other[0])\n1319 | \n1320 |         if get_option(\"performance_warnings\"):\n1321 |             warnings.warn(\n1322 |                 \"Adding/subtracting object-dtype array to \"\n1323 |                 f\"{type(self).__name__} not vectorized.\",\n1324 |                 PerformanceWarning,\n1325 |                 stacklevel=find_stack_level(),\n1326 |             )\n1327 | \n1328 |         # Caller is responsible for broadcasting if necessary\n1329 |         assert self.shape == other.shape, (self.shape, other.shape)\n1330 | \n1331 |         res_values = op(self.astype(\"O\"), np.asarray(other))\n1332 |         return res_values\n1333 | \n1334 |     def _accumulate(self, name: str, *, skipna: bool = True, **kwargs) -> Self:\n1335 |         if name not in {\"cummin\", \"cummax\"}:\n1336 |             raise TypeError(f\"Accumulation {name} not supported for {type(self)}\")\n1337 | \n1338 |         op = getattr(datetimelike_accumulations, name)\n1339 |         result = op(self.copy(), skipna=skipna, **kwargs)\n1340 | \n1341 |         return type(self)._simple_new(result, dtype=self.dtype)\n1342 | \n1343 |     @unpack_zerodim_and_defer(\"__add__\")\n1344 |     def __add__(self, other):\n1345 |         other_dtype = getattr(other, \"dtype\", None)\n1346 |         other = ensure_wrapped_if_datetimelike(other)\n1347 | \n1348 |         # scalar others\n1349 |         if other is NaT:\n1350 |             result: np.ndarray | DatetimeLikeArrayMixin = self._add_nat()\n1351 |         elif isinstance(other, (Tick, timedelta, np.timedelta64)):\n1352 |             result = self._add_timedeltalike_scalar(other)\n1353 |         elif isinstance(other, BaseOffset):\n1354 |             # specifically _not_ a Tick\n1355 |             result = self._add_offset(other)\n1356 |         elif isinstance(other, (datetime, np.datetime64)):\n1357 |             result = self._add_datetimelike_scalar(other)\n1358 |         elif isinstance(other, Period) and lib.is_np_dtype(self.dtype, \"m\"):\n1359 |             result = self._add_period(other)\n1360 |         elif lib.is_integer(other):\n1361 |             # This check must come after the check for np.timedelta64\n1362 |             # as is_integer returns True for these\n1363 |             if not isinstance(self.dtype, PeriodDtype):\n1364 |                 raise integer_op_not_supported(self)\n1365 |             obj = cast(\"PeriodArray\", self)\n1366 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.add)\n1367 | \n1368 |         # array-like others\n1369 |         elif lib.is_np_dtype(other_dtype, \"m\"):\n1370 |             # TimedeltaIndex, ndarray[timedelta64]\n1371 |             result = self._add_timedelta_arraylike(other)\n1372 |         elif is_object_dtype(other_dtype):\n1373 |             # e.g. Array/Index of DateOffset objects\n1374 |             result = self._addsub_object_array(other, operator.add)\n1375 |         elif lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1376 |             other_dtype, DatetimeTZDtype\n1377 |         ):\n1378 |             # DatetimeIndex, ndarray[datetime64]\n1379 |             return self._add_datetime_arraylike(other)\n1380 |         elif is_integer_dtype(other_dtype):\n1381 |             if not isinstance(self.dtype, PeriodDtype):\n1382 |                 raise integer_op_not_supported(self)\n1383 |             obj = cast(\"PeriodArray\", self)\n1384 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.add)\n1385 |         else:\n1386 |             # Includes Categorical, other ExtensionArrays\n1387 |             # For PeriodDtype, if self is a TimedeltaArray and other is a\n1388 |             #  PeriodArray with  a timedelta-like (i.e. Tick) freq, this\n1389 |             #  operation is valid.  Defer to the PeriodArray implementation.\n1390 |             #  In remaining cases, this will end up raising TypeError.\n1391 |             return NotImplemented\n1392 | \n1393 |         if isinstance(result, np.ndarray) and lib.is_np_dtype(result.dtype, \"m\"):\n1394 |             from pandas.core.arrays import TimedeltaArray\n1395 | \n1396 |             return TimedeltaArray._from_sequence(result, dtype=result.dtype)\n1397 |         return result\n1398 | \n1399 |     def __radd__(self, other):\n1400 |         # alias for __add__\n1401 |         return self.__add__(other)\n1402 | \n1403 |     @unpack_zerodim_and_defer(\"__sub__\")\n1404 |     def __sub__(self, other):\n1405 |         other_dtype = getattr(other, \"dtype\", None)\n1406 |         other = ensure_wrapped_if_datetimelike(other)\n1407 | \n1408 |         # scalar others\n1409 |         if other is NaT:\n1410 |             result: np.ndarray | DatetimeLikeArrayMixin = self._sub_nat()\n1411 |         elif isinstance(other, (Tick, timedelta, np.timedelta64)):\n1412 |             result = self._add_timedeltalike_scalar(-other)\n1413 |         elif isinstance(other, BaseOffset):\n1414 |             # specifically _not_ a Tick\n1415 |             result = self._add_offset(-other)\n1416 |         elif isinstance(other, (datetime, np.datetime64)):\n1417 |             result = self._sub_datetimelike_scalar(other)\n1418 |         elif lib.is_integer(other):\n1419 |             # This check must come after the check for np.timedelta64\n1420 |             # as is_integer returns True for these\n1421 |             if not isinstance(self.dtype, PeriodDtype):\n1422 |                 raise integer_op_not_supported(self)\n1423 |             obj = cast(\"PeriodArray\", self)\n1424 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.sub)\n1425 | \n1426 |         elif isinstance(other, Period):\n1427 |             result = self._sub_periodlike(other)\n1428 | \n1429 |         # array-like others\n1430 |         elif lib.is_np_dtype(other_dtype, \"m\"):\n1431 |             # TimedeltaIndex, ndarray[timedelta64]\n1432 |             result = self._add_timedelta_arraylike(-other)\n1433 |         elif is_object_dtype(other_dtype):\n1434 |             # e.g. Array/Index of DateOffset objects\n1435 |             result = self._addsub_object_array(other, operator.sub)\n1436 |         elif lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1437 |             other_dtype, DatetimeTZDtype\n1438 |         ):\n1439 |             # DatetimeIndex, ndarray[datetime64]\n1440 |             result = self._sub_datetime_arraylike(other)\n1441 |         elif isinstance(other_dtype, PeriodDtype):\n1442 |             # PeriodIndex\n1443 |             result = self._sub_periodlike(other)\n1444 |         elif is_integer_dtype(other_dtype):\n1445 |             if not isinstance(self.dtype, PeriodDtype):\n1446 |                 raise integer_op_not_supported(self)\n1447 |             obj = cast(\"PeriodArray\", self)\n1448 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.sub)\n1449 |         else:\n1450 |             # Includes ExtensionArrays, float_dtype\n1451 |             return NotImplemented\n1452 | \n1453 |         if isinstance(result, np.ndarray) and lib.is_np_dtype(result.dtype, \"m\"):\n1454 |             from pandas.core.arrays import TimedeltaArray\n1455 | \n1456 |             return TimedeltaArray._from_sequence(result, dtype=result.dtype)\n1457 |         return result\n1458 | \n1459 |     def __rsub__(self, other):\n1460 |         other_dtype = getattr(other, \"dtype\", None)\n1461 |         other_is_dt64 = lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1462 |             other_dtype, DatetimeTZDtype\n1463 |         )\n1464 | \n1465 |         if other_is_dt64 and lib.is_np_dtype(self.dtype, \"m\"):\n1466 |             # ndarray[datetime64] cannot be subtracted from self, so\n1467 |             # we need to wrap in DatetimeArray/Index and flip the operation\n1468 |             if lib.is_scalar(other):\n1469 |                 # i.e. np.datetime64 object\n1470 |                 return Timestamp(other) - self\n1471 |             if not isinstance(other, DatetimeLikeArrayMixin):\n1472 |                 # Avoid down-casting DatetimeIndex\n1473 |                 from pandas.core.arrays import DatetimeArray\n1474 | \n1475 |                 other = DatetimeArray._from_sequence(other, dtype=other.dtype)\n1476 |             return other - self\n1477 |         elif self.dtype.kind == \"M\" and hasattr(other, \"dtype\") and not other_is_dt64:\n1478 |             # GH#19959 datetime - datetime is well-defined as timedelta,\n1479 |             # but any other type - datetime is not well-defined.\n1480 |             raise TypeError(\n1481 |                 f\"cannot subtract {type(self).__name__} from {type(other).__name__}\"\n1482 |             )\n1483 |         elif isinstance(self.dtype, PeriodDtype) and lib.is_np_dtype(other_dtype, \"m\"):\n1484 |             # TODO: Can we simplify/generalize these cases at all?\n1485 |             raise TypeError(f\"cannot subtract {type(self).__name__} from {other.dtype}\")\n1486 |         elif lib.is_np_dtype(self.dtype, \"m\"):\n1487 |             self = cast(\"TimedeltaArray\", self)\n1488 |             return (-self) + other\n1489 | \n1490 |         # We get here with e.g. datetime objects\n1491 |         return -(self - other)\n1492 | \n1493 |     def __iadd__(self, other) -> Self:\n1494 |         result = self + other\n1495 |         self[:] = result[:]\n1496 | \n1497 |         if not isinstance(self.dtype, PeriodDtype):\n1498 |             # restore freq, which is invalidated by setitem\n1499 |             self._freq = result.freq\n1500 |         return self\n1501 | \n1502 |     def __isub__(self, other) -> Self:\n1503 |         result = self - other\n1504 |         self[:] = result[:]\n1505 | \n1506 |         if not isinstance(self.dtype, PeriodDtype):\n1507 |             # restore freq, which is invalidated by setitem\n1508 |             self._freq = result.freq\n1509 |         return self\n1510 | \n1511 |     # --------------------------------------------------------------\n1512 |     # Reductions\n1513 | \n1514 |     @_period_dispatch\n1515 |     def _quantile(\n1516 |         self,\n1517 |         qs: npt.NDArray[np.float64],\n1518 |         interpolation: str,\n1519 |     ) -> Self:\n1520 |         return super()._quantile(qs=qs, interpolation=interpolation)\n1521 | \n1522 |     @_period_dispatch\n1523 |     def min(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1524 |         \"\"\"\n1525 |         Return the minimum value of the Array or minimum along\n1526 |         an axis.\n1527 | \n1528 |         See Also\n1529 |         --------\n1530 |         numpy.ndarray.min\n1531 |         Index.min : Return the minimum value in an Index.\n1532 |         Series.min : Return the minimum value in a Series.\n1533 |         \"\"\"\n1534 |         nv.validate_min((), kwargs)\n1535 |         nv.validate_minmax_axis(axis, self.ndim)\n1536 | \n1537 |         result = nanops.nanmin(self._ndarray, axis=axis, skipna=skipna)\n1538 |         return self._wrap_reduction_result(axis, result)\n1539 | \n1540 |     @_period_dispatch\n1541 |     def max(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1542 |         \"\"\"\n1543 |         Return the maximum value of the Array or maximum along\n1544 |         an axis.\n1545 | \n1546 |         See Also\n1547 |         --------\n1548 |         numpy.ndarray.max\n1549 |         Index.max : Return the maximum value in an Index.\n1550 |         Series.max : Return the maximum value in a Series.\n1551 |         \"\"\"\n1552 |         nv.validate_max((), kwargs)\n1553 |         nv.validate_minmax_axis(axis, self.ndim)\n1554 | \n1555 |         result = nanops.nanmax(self._ndarray, axis=axis, skipna=skipna)\n1556 |         return self._wrap_reduction_result(axis, result)\n1557 | \n1558 |     def mean(self, *, skipna: bool = True, axis: AxisInt | None = 0):\n1559 |         \"\"\"\n1560 |         Return the mean value of the Array.\n1561 | \n1562 |         Parameters\n1563 |         ----------\n1564 |         skipna : bool, default True\n1565 |             Whether to ignore any NaT elements.\n1566 |         axis : int, optional, default 0\n1567 |             Axis for the function to be applied on.\n1568 | \n1569 |         Returns\n1570 |         -------\n1571 |         scalar\n1572 |             Timestamp or Timedelta.\n1573 | \n1574 |         See Also\n1575 |         --------\n1576 |         numpy.ndarray.mean : Returns the average of array elements along a given axis.\n1577 |         Series.mean : Return the mean value in a Series.\n1578 | \n1579 |         Notes\n1580 |         -----\n1581 |         mean is only defined for Datetime and Timedelta dtypes, not for Period.\n1582 | \n1583 |         Examples\n1584 |         --------\n1585 |         For :class:`pandas.DatetimeIndex`:\n1586 | \n1587 |         >>> idx = pd.date_range(\"2001-01-01 00:00\", periods=3)\n1588 |         >>> idx\n1589 |         DatetimeIndex(['2001-01-01', '2001-01-02', '2001-01-03'],\n1590 |                       dtype='datetime64[ns]', freq='D')\n1591 |         >>> idx.mean()\n1592 |         Timestamp('2001-01-02 00:00:00')\n1593 | \n1594 |         For :class:`pandas.TimedeltaIndex`:\n1595 | \n1596 |         >>> tdelta_idx = pd.to_timedelta([1, 2, 3], unit=\"D\")\n1597 |         >>> tdelta_idx\n1598 |         TimedeltaIndex(['1 days', '2 days', '3 days'],\n1599 |                         dtype='timedelta64[ns]', freq=None)\n1600 |         >>> tdelta_idx.mean()\n1601 |         Timedelta('2 days 00:00:00')\n1602 |         \"\"\"\n1603 |         if isinstance(self.dtype, PeriodDtype):\n1604 |             # See discussion in GH#24757\n1605 |             raise TypeError(\n1606 |                 f\"mean is not implemented for {type(self).__name__} since the \"\n1607 |                 \"meaning is ambiguous.  An alternative is \"\n1608 |                 \"obj.to_timestamp(how='start').mean()\"\n1609 |             )\n1610 | \n1611 |         result = nanops.nanmean(\n1612 |             self._ndarray, axis=axis, skipna=skipna, mask=self.isna()\n1613 |         )\n1614 |         return self._wrap_reduction_result(axis, result)\n1615 | \n1616 |     @_period_dispatch\n1617 |     def median(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1618 |         nv.validate_median((), kwargs)\n1619 | \n1620 |         if axis is not None and abs(axis) >= self.ndim:\n1621 |             raise ValueError(\"abs(axis) must be less than ndim\")\n1622 | \n1623 |         result = nanops.nanmedian(self._ndarray, axis=axis, skipna=skipna)\n1624 |         return self._wrap_reduction_result(axis, result)\n1625 | \n1626 |     def _mode(self, dropna: bool = True):\n1627 |         mask = None\n1628 |         if dropna:\n1629 |             mask = self.isna()\n1630 | \n1631 |         i8modes = algorithms.mode(self.view(\"i8\"), mask=mask)\n1632 |         npmodes = i8modes.view(self._ndarray.dtype)\n1633 |         npmodes = cast(np.ndarray, npmodes)\n1634 |         return self._from_backing_data(npmodes)\n1635 | \n1636 |     # ------------------------------------------------------------------\n1637 |     # GroupBy Methods\n1638 | \n1639 |     def _groupby_op(\n1640 |         self,\n1641 |         *,\n1642 |         how: str,\n1643 |         has_dropped_na: bool,\n1644 |         min_count: int,\n1645 |         ngroups: int,\n1646 |         ids: npt.NDArray[np.intp],\n1647 |         **kwargs,\n1648 |     ):\n1649 |         dtype = self.dtype\n1650 |         if dtype.kind == \"M\":\n1651 |             # Adding/multiplying datetimes is not valid\n1652 |             if how in [\"sum\", \"prod\", \"cumsum\", \"cumprod\", \"var\", \"skew\"]:\n1653 |                 raise TypeError(f\"datetime64 type does not support operation '{how}'\")\n1654 |             if how in [\"any\", \"all\"]:\n1655 |                 # GH#34479\n1656 |                 raise TypeError(\n1657 |                     f\"'{how}' with datetime64 dtypes is no longer supported. \"\n1658 |                     f\"Use (obj != pd.Timestamp(0)).{how}() instead.\"\n1659 |                 )\n1660 | \n1661 |         elif isinstance(dtype, PeriodDtype):\n1662 |             # Adding/multiplying Periods is not valid\n1663 |             if how in [\"sum\", \"prod\", \"cumsum\", \"cumprod\", \"var\", \"skew\"]:\n1664 |                 raise TypeError(f\"Period type does not support {how} operations\")\n1665 |             if how in [\"any\", \"all\"]:\n1666 |                 # GH#34479\n1667 |                 raise TypeError(\n1668 |                     f\"'{how}' with PeriodDtype is no longer supported. \"\n1669 |                     f\"Use (obj != pd.Period(0, freq)).{how}() instead.\"\n1670 |                 )\n1671 |         else:\n1672 |             # timedeltas we can add but not multiply\n1673 |             if how in [\"prod\", \"cumprod\", \"skew\", \"var\"]:\n1674 |                 raise TypeError(f\"timedelta64 type does not support {how} operations\")\n1675 | \n1676 |         # All of the functions implemented here are ordinal, so we can\n1677 |         #  operate on the tz-naive equivalents\n1678 |         npvalues = self._ndarray.view(\"M8[ns]\")\n1679 | \n1680 |         from pandas.core.groupby.ops import WrappedCythonOp\n1681 | \n1682 |         kind = WrappedCythonOp.get_kind_from_how(how)\n1683 |         op = WrappedCythonOp(how=how, kind=kind, has_dropped_na=has_dropped_na)\n1684 | \n1685 |         res_values = op._cython_op_ndim_compat(\n1686 |             npvalues,\n1687 |             min_count=min_count,\n1688 |             ngroups=ngroups,\n1689 |             comp_ids=ids,\n1690 |             mask=None,\n1691 |             **kwargs,\n1692 |         )\n1693 | \n1694 |         if op.how in op.cast_blocklist:\n1695 |             # i.e. how in [\"rank\"], since other cast_blocklist methods don't go\n1696 |             #  through cython_operation\n1697 |             return res_values\n1698 | \n1699 |         # We did a view to M8[ns] above, now we go the other direction\n1700 |         assert res_values.dtype == \"M8[ns]\"\n1701 |         if how in [\"std\", \"sem\"]:\n1702 |             from pandas.core.arrays import TimedeltaArray\n1703 | \n1704 |             if isinstance(self.dtype, PeriodDtype):\n1705 |                 raise TypeError(\"'std' and 'sem' are not valid for PeriodDtype\")\n1706 |             self = cast(\"DatetimeArray | TimedeltaArray\", self)\n1707 |             new_dtype = f\"m8[{self.unit}]\"\n1708 |             res_values = res_values.view(new_dtype)\n1709 |             return TimedeltaArray._simple_new(res_values, dtype=res_values.dtype)\n1710 | \n1711 |         res_values = res_values.view(self._ndarray.dtype)\n1712 |         return self._from_backing_data(res_values)\n1713 | \n1714 | \n1715 | class DatelikeOps(DatetimeLikeArrayMixin):\n1716 |     \"\"\"\n1717 |     Common ops for DatetimeIndex/PeriodIndex, but not TimedeltaIndex.\n1718 |     \"\"\"\n1719 | \n1720 |     @Substitution(\n1721 |         URL=\"https://docs.python.org/3/library/datetime.html\"\n1722 |         \"#strftime-and-strptime-behavior\"\n1723 |     )\n1724 |     def strftime(self, date_format: str) -> npt.NDArray[np.object_]:\n1725 |         \"\"\"\n1726 |         Convert to Index using specified date_format.\n1727 | \n1728 |         Return an Index of formatted strings specified by date_format, which\n1729 |         supports the same string format as the python standard library. Details\n1730 |         of the string format can be found in `python string format\n1731 |         doc <%(URL)s>`__.\n1732 | \n1733 |         Formats supported by the C `strftime` API but not by the python string format\n1734 |         doc (such as `\"%%R\"`, `\"%%r\"`) are not officially supported and should be\n1735 |         preferably replaced with their supported equivalents (such as `\"%%H:%%M\"`,\n1736 |         `\"%%I:%%M:%%S %%p\"`).\n1737 | \n1738 |         Note that `PeriodIndex` support additional directives, detailed in\n1739 |         `Period.strftime`.\n1740 | \n1741 |         Parameters\n1742 |         ----------\n1743 |         date_format : str\n1744 |             Date format string (e.g. \"%%Y-%%m-%%d\").\n1745 | \n1746 |         Returns\n1747 |         -------\n1748 |         ndarray[object]\n1749 |             NumPy ndarray of formatted strings.\n1750 | \n1751 |         See Also\n1752 |         --------\n1753 |         to_datetime : Convert the given argument to datetime.\n1754 |         DatetimeIndex.normalize : Return DatetimeIndex with times to midnight.\n1755 |         DatetimeIndex.round : Round the DatetimeIndex to the specified freq.\n1756 |         DatetimeIndex.floor : Floor the DatetimeIndex to the specified freq.\n1757 |         Timestamp.strftime : Format a single Timestamp.\n1758 |         Period.strftime : Format a single Period.\n1759 | \n1760 |         Examples\n1761 |         --------\n1762 |         >>> rng = pd.date_range(pd.Timestamp(\"2018-03-10 09:00\"), periods=3, freq=\"s\")\n1763 |         >>> rng.strftime(\"%%B %%d, %%Y, %%r\")\n1764 |         Index(['March 10, 2018, 09:00:00 AM', 'March 10, 2018, 09:00:01 AM',\n1765 |                'March 10, 2018, 09:00:02 AM'],\n1766 |               dtype='object')\n1767 |         \"\"\"\n1768 |         result = self._format_native_types(date_format=date_format, na_rep=np.nan)\n1769 |         if using_string_dtype():\n1770 |             from pandas import StringDtype\n1771 | \n1772 |             return pd_array(result, dtype=StringDtype(na_value=np.nan))  # type: ignore[return-value]\n1773 |         return result.astype(object, copy=False)\n1774 | \n1775 | \n1776 | _round_doc = \"\"\"\n1777 |     Perform {op} operation on the data to the specified `freq`.\n1778 | \n1779 |     Parameters\n1780 |     ----------\n1781 |     freq : str or Offset\n1782 |         The frequency level to {op} the index to. Must be a fixed\n1783 |         frequency like 's' (second) not 'ME' (month end). See\n1784 |         :ref:`frequency aliases <timeseries.offset_aliases>` for\n1785 |         a list of possible `freq` values.\n1786 |     ambiguous : 'infer', bool-ndarray, 'NaT', default 'raise'\n1787 |         Only relevant for DatetimeIndex:\n1788 | \n1789 |         - 'infer' will attempt to infer fall dst-transition hours based on\n1790 |           order\n1791 |         - bool-ndarray where True signifies a DST time, False designates\n1792 |           a non-DST time (note that this flag is only applicable for\n1793 |           ambiguous times)\n1794 |         - 'NaT' will return NaT where there are ambiguous times\n1795 |         - 'raise' will raise a ValueError if there are ambiguous\n1796 |           times.\n1797 | \n1798 |     nonexistent : 'shift_forward', 'shift_backward', 'NaT', timedelta, default 'raise'\n1799 |         A nonexistent time does not exist in a particular timezone\n1800 |         where clocks moved forward due to DST.\n1801 | \n1802 |         - 'shift_forward' will shift the nonexistent time forward to the\n1803 |           closest existing time\n1804 |         - 'shift_backward' will shift the nonexistent time backward to the\n1805 |           closest existing time\n1806 |         - 'NaT' will return NaT where there are nonexistent times\n1807 |         - timedelta objects will shift nonexistent times by the timedelta\n1808 |         - 'raise' will raise a ValueError if there are\n1809 |           nonexistent times.\n1810 | \n1811 |     Returns\n1812 |     -------\n1813 |     DatetimeIndex, TimedeltaIndex, or Series\n1814 |         Index of the same type for a DatetimeIndex or TimedeltaIndex,\n1815 |         or a Series with the same index for a Series.\n1816 | \n1817 |     Raises\n1818 |     ------\n1819 |     ValueError if the `freq` cannot be converted.\n1820 | \n1821 |     See Also\n1822 |     --------\n1823 |     DatetimeIndex.floor : Perform floor operation on the data to the specified `freq`.\n1824 |     DatetimeIndex.snap : Snap time stamps to nearest occurring frequency.\n1825 | \n1826 |     Notes\n1827 |     -----\n1828 |     If the timestamps have a timezone, {op}ing will take place relative to the\n1829 |     local (\"wall\") time and re-localized to the same timezone. When {op}ing\n1830 |     near daylight savings time, use ``nonexistent`` and ``ambiguous`` to\n1831 |     control the re-localization behavior.\n1832 | \n1833 |     Examples\n1834 |     --------\n1835 |     **DatetimeIndex**\n1836 | \n1837 |     >>> rng = pd.date_range('1/1/2018 11:59:00', periods=3, freq='min')\n1838 |     >>> rng\n1839 |     DatetimeIndex(['2018-01-01 11:59:00', '2018-01-01 12:00:00',\n1840 |                    '2018-01-01 12:01:00'],\n1841 |                   dtype='datetime64[ns]', freq='min')\n1842 |     \"\"\"\n1843 | \n1844 | _round_example = \"\"\">>> rng.round('h')\n1845 |     DatetimeIndex(['2018-01-01 12:00:00', '2018-01-01 12:00:00',\n1846 |                    '2018-01-01 12:00:00'],\n1847 |                   dtype='datetime64[ns]', freq=None)\n1848 | \n1849 |     **Series**\n1850 | \n1851 |     >>> pd.Series(rng).dt.round(\"h\")\n1852 |     0   2018-01-01 12:00:00\n1853 |     1   2018-01-01 12:00:00\n1854 |     2   2018-01-01 12:00:00\n1855 |     dtype: datetime64[ns]\n1856 | \n1857 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1858 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1859 | \n1860 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 03:30:00\"], tz=\"Europe/Amsterdam\")\n1861 | \n1862 |     >>> rng_tz.floor(\"2h\", ambiguous=False)\n1863 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1864 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1865 | \n1866 |     >>> rng_tz.floor(\"2h\", ambiguous=True)\n1867 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1868 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1869 |     \"\"\"\n1870 | \n1871 | _floor_example = \"\"\">>> rng.floor('h')\n1872 |     DatetimeIndex(['2018-01-01 11:00:00', '2018-01-01 12:00:00',\n1873 |                    '2018-01-01 12:00:00'],\n1874 |                   dtype='datetime64[ns]', freq=None)\n1875 | \n1876 |     **Series**\n1877 | \n1878 |     >>> pd.Series(rng).dt.floor(\"h\")\n1879 |     0   2018-01-01 11:00:00\n1880 |     1   2018-01-01 12:00:00\n1881 |     2   2018-01-01 12:00:00\n1882 |     dtype: datetime64[ns]\n1883 | \n1884 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1885 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1886 | \n1887 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 03:30:00\"], tz=\"Europe/Amsterdam\")\n1888 | \n1889 |     >>> rng_tz.floor(\"2h\", ambiguous=False)\n1890 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1891 |                  dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1892 | \n1893 |     >>> rng_tz.floor(\"2h\", ambiguous=True)\n1894 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1895 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1896 |     \"\"\"\n1897 | \n1898 | _ceil_example = \"\"\">>> rng.ceil('h')\n1899 |     DatetimeIndex(['2018-01-01 12:00:00', '2018-01-01 12:00:00',\n1900 |                    '2018-01-01 13:00:00'],\n1901 |                   dtype='datetime64[ns]', freq=None)\n1902 | \n1903 |     **Series**\n1904 | \n1905 |     >>> pd.Series(rng).dt.ceil(\"h\")\n1906 |     0   2018-01-01 12:00:00\n1907 |     1   2018-01-01 12:00:00\n1908 |     2   2018-01-01 13:00:00\n1909 |     dtype: datetime64[ns]\n1910 | \n1911 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1912 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1913 | \n1914 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 01:30:00\"], tz=\"Europe/Amsterdam\")\n1915 | \n1916 |     >>> rng_tz.ceil(\"h\", ambiguous=False)\n1917 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1918 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1919 | \n1920 |     >>> rng_tz.ceil(\"h\", ambiguous=True)\n1921 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1922 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1923 |     \"\"\"\n1924 | \n1925 | \n1926 | class TimelikeOps(DatetimeLikeArrayMixin):\n1927 |     \"\"\"\n1928 |     Common ops for TimedeltaIndex/DatetimeIndex, but not PeriodIndex.\n1929 |     \"\"\"\n1930 | \n1931 |     @classmethod\n1932 |     def _validate_dtype(cls, values, dtype):\n1933 |         raise AbstractMethodError(cls)\n1934 | \n1935 |     @property\n1936 |     def freq(self):\n1937 |         \"\"\"\n1938 |         Return the frequency object if it is set, otherwise None.\n1939 | \n1940 |         To learn more about the frequency strings, please see\n1941 |         :ref:`this link<timeseries.offset_aliases>`.\n1942 | \n1943 |         See Also\n1944 |         --------\n1945 |         DatetimeIndex.freq : Return the frequency object if it is set, otherwise None.\n1946 |         PeriodIndex.freq : Return the frequency object if it is set, otherwise None.\n1947 | \n1948 |         Examples\n1949 |         --------\n1950 |         >>> datetimeindex = pd.date_range(\n1951 |         ...     \"2022-02-22 02:22:22\", periods=10, tz=\"America/Chicago\", freq=\"h\"\n1952 |         ... )\n1953 |         >>> datetimeindex\n1954 |         DatetimeIndex(['2022-02-22 02:22:22-06:00', '2022-02-22 03:22:22-06:00',\n1955 |                        '2022-02-22 04:22:22-06:00', '2022-02-22 05:22:22-06:00',\n1956 |                        '2022-02-22 06:22:22-06:00', '2022-02-22 07:22:22-06:00',\n1957 |                        '2022-02-22 08:22:22-06:00', '2022-02-22 09:22:22-06:00',\n1958 |                        '2022-02-22 10:22:22-06:00', '2022-02-22 11:22:22-06:00'],\n1959 |                       dtype='datetime64[ns, America/Chicago]', freq='h')\n1960 |         >>> datetimeindex.freq\n1961 |         <Hour>\n1962 |         \"\"\"\n1963 |         return self._freq\n1964 | \n1965 |     @freq.setter\n1966 |     def freq(self, value) -> None:\n1967 |         if value is not None:\n1968 |             value = to_offset(value)\n1969 |             self._validate_frequency(self, value)\n1970 |             if self.dtype.kind == \"m\" and not isinstance(value, Tick):\n1971 |                 raise TypeError(\"TimedeltaArray/Index freq must be a Tick\")\n1972 | \n1973 |             if self.ndim > 1:\n1974 |                 raise ValueError(\"Cannot set freq with ndim > 1\")\n1975 | \n1976 |         self._freq = value\n1977 | \n1978 |     @final\n1979 |     def _maybe_pin_freq(self, freq, validate_kwds: dict) -> None:\n1980 |         \"\"\"\n1981 |         Constructor helper to pin the appropriate `freq` attribute.  Assumes\n1982 |         that self._freq is currently set to any freq inferred in\n1983 |         _from_sequence_not_strict.\n1984 |         \"\"\"\n1985 |         if freq is None:\n1986 |             # user explicitly passed None -> override any inferred_freq\n1987 |             self._freq = None\n1988 |         elif freq == \"infer\":\n1989 |             # if self._freq is *not* None then we already inferred a freq\n1990 |             #  and there is nothing left to do\n1991 |             if self._freq is None:\n1992 |                 # Set _freq directly to bypass duplicative _validate_frequency\n1993 |                 # check.\n1994 |                 self._freq = to_offset(self.inferred_freq)\n1995 |         elif freq is lib.no_default:\n1996 |             # user did not specify anything, keep inferred freq if the original\n1997 |             #  data had one, otherwise do nothing\n1998 |             pass\n1999 |         elif self._freq is None:\n2000 |             # We cannot inherit a freq from the data, so we need to validate\n2001 |             #  the user-passed freq\n2002 |             freq = to_offset(freq)\n2003 |             type(self)._validate_frequency(self, freq, **validate_kwds)\n2004 |             self._freq = freq\n2005 |         else:\n2006 |             # Otherwise we just need to check that the user-passed freq\n2007 |             #  doesn't conflict with the one we already have.\n2008 |             freq = to_offset(freq)\n2009 |             _validate_inferred_freq(freq, self._freq)\n2010 | \n2011 |     @final\n2012 |     @classmethod\n2013 |     def _validate_frequency(cls, index, freq: BaseOffset, **kwargs) -> None:\n2014 |         \"\"\"\n2015 |         Validate that a frequency is compatible with the values of a given\n2016 |         Datetime Array/Index or Timedelta Array/Index\n2017 | \n2018 |         Parameters\n2019 |         ----------\n2020 |         index : DatetimeIndex or TimedeltaIndex\n2021 |             The index on which to determine if the given frequency is valid\n2022 |         freq : DateOffset\n2023 |             The frequency to validate\n2024 |         \"\"\"\n2025 |         inferred = index.inferred_freq\n2026 |         if index.size == 0 or inferred == freq.freqstr:\n2027 |             return None\n2028 | \n2029 |         try:\n2030 |             on_freq = cls._generate_range(\n2031 |                 start=index[0],\n2032 |                 end=None,\n2033 |                 periods=len(index),\n2034 |                 freq=freq,\n2035 |                 unit=index.unit,\n2036 |                 **kwargs,\n2037 |             )\n2038 |             if not np.array_equal(index.asi8, on_freq.asi8):\n2039 |                 raise ValueError\n2040 |         except ValueError as err:\n2041 |             if \"non-fixed\" in str(err):\n2042 |                 # non-fixed frequencies are not meaningful for timedelta64;\n2043 |                 #  we retain that error message\n2044 |                 raise err\n2045 |             # GH#11587 the main way this is reached is if the `np.array_equal`\n2046 |             #  check above is False.  This can also be reached if index[0]\n2047 |             #  is `NaT`, in which case the call to `cls._generate_range` will\n2048 |             #  raise a ValueError, which we re-raise with a more targeted\n2049 |             #  message.\n2050 |             raise ValueError(\n2051 |                 f\"Inferred frequency {inferred} from passed values \"\n2052 |                 f\"does not conform to passed frequency {freq.freqstr}\"\n2053 |             ) from err\n2054 | \n2055 |     @classmethod\n2056 |     def _generate_range(\n2057 |         cls, start, end, periods: int | None, freq, *args, **kwargs\n2058 |     ) -> Self:\n2059 |         raise AbstractMethodError(cls)\n2060 | \n2061 |     # --------------------------------------------------------------\n2062 | \n2063 |     @cache_readonly\n2064 |     def _creso(self) -> int:\n2065 |         return get_unit_from_dtype(self._ndarray.dtype)\n2066 | \n2067 |     @cache_readonly\n2068 |     def unit(self) -> str:\n2069 |         # e.g. \"ns\", \"us\", \"ms\"\n2070 |         # error: Argument 1 to \"dtype_to_unit\" has incompatible type\n2071 |         # \"ExtensionDtype\"; expected \"Union[DatetimeTZDtype, dtype[Any]]\"\n2072 |         return dtype_to_unit(self.dtype)  # type: ignore[arg-type]\n2073 | \n2074 |     def as_unit(self, unit: str, round_ok: bool = True) -> Self:\n2075 |         \"\"\"\n2076 |         Convert to a dtype with the given unit resolution.\n2077 | \n2078 |         The limits of timestamp representation depend on the chosen resolution.\n2079 |         Different resolutions can be converted to each other through as_unit.\n2080 | \n2081 |         Parameters\n2082 |         ----------\n2083 |         unit : {'s', 'ms', 'us', 'ns'}\n2084 |         round_ok : bool, default True\n2085 |             If False and the conversion requires rounding, raise ValueError.\n2086 | \n2087 |         Returns\n2088 |         -------\n2089 |         same type as self\n2090 |             Converted to the specified unit.\n2091 | \n2092 |         See Also\n2093 |         --------\n2094 |         Timestamp.as_unit : Convert to the given unit.\n2095 | \n2096 |         Examples\n2097 |         --------\n2098 |         For :class:`pandas.DatetimeIndex`:\n2099 | \n2100 |         >>> idx = pd.DatetimeIndex([\"2020-01-02 01:02:03.004005006\"])\n2101 |         >>> idx\n2102 |         DatetimeIndex(['2020-01-02 01:02:03.004005006'],\n2103 |                       dtype='datetime64[ns]', freq=None)\n2104 |         >>> idx.as_unit(\"s\")\n2105 |         DatetimeIndex(['2020-01-02 01:02:03'], dtype='datetime64[s]', freq=None)\n2106 | \n2107 |         For :class:`pandas.TimedeltaIndex`:\n2108 | \n2109 |         >>> tdelta_idx = pd.to_timedelta([\"1 day 3 min 2 us 42 ns\"])\n2110 |         >>> tdelta_idx\n2111 |         TimedeltaIndex(['1 days 00:03:00.000002042'],\n2112 |                         dtype='timedelta64[ns]', freq=None)\n2113 |         >>> tdelta_idx.as_unit(\"s\")\n2114 |         TimedeltaIndex(['1 days 00:03:00'], dtype='timedelta64[s]', freq=None)\n2115 |         \"\"\"\n2116 |         if unit not in [\"s\", \"ms\", \"us\", \"ns\"]:\n2117 |             raise ValueError(\"Supported units are 's', 'ms', 'us', 'ns'\")\n2118 | \n2119 |         dtype = np.dtype(f\"{self.dtype.kind}8[{unit}]\")\n2120 |         new_values = astype_overflowsafe(self._ndarray, dtype, round_ok=round_ok)\n2121 | \n2122 |         if isinstance(self.dtype, np.dtype):\n2123 |             new_dtype = new_values.dtype\n2124 |         else:\n2125 |             tz = cast(\"DatetimeArray\", self).tz\n2126 |             new_dtype = DatetimeTZDtype(tz=tz, unit=unit)\n2127 | \n2128 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of\n2129 |         # \"NDArrayBacked\"  [call-arg]\n2130 |         return type(self)._simple_new(\n2131 |             new_values,\n2132 |             dtype=new_dtype,\n2133 |             freq=self.freq,  # type: ignore[call-arg]\n2134 |         )\n2135 | \n2136 |     # TODO: annotate other as DatetimeArray | TimedeltaArray | Timestamp | Timedelta\n2137 |     #  with the return type matching input type.  TypeVar?\n2138 |     def _ensure_matching_resos(self, other):\n2139 |         if self._creso != other._creso:\n2140 |             # Just as with Timestamp/Timedelta, we cast to the higher resolution\n2141 |             if self._creso < other._creso:\n2142 |                 self = self.as_unit(other.unit)\n2143 |             else:\n2144 |                 other = other.as_unit(self.unit)\n2145 |         return self, other\n2146 | \n2147 |     # --------------------------------------------------------------\n2148 | \n2149 |     def __array_ufunc__(self, ufunc: np.ufunc, method: str, *inputs, **kwargs):\n2150 |         if (\n2151 |             ufunc in [np.isnan, np.isinf, np.isfinite]\n2152 |             and len(inputs) == 1\n2153 |             and inputs[0] is self\n2154 |         ):\n2155 |             # numpy 1.18 changed isinf and isnan to not raise on dt64/td64\n2156 |             return getattr(ufunc, method)(self._ndarray, **kwargs)\n2157 | \n2158 |         return super().__array_ufunc__(ufunc, method, *inputs, **kwargs)\n2159 | \n2160 |     def _round(self, freq, mode, ambiguous, nonexistent):\n2161 |         # round the local times\n2162 |         if isinstance(self.dtype, DatetimeTZDtype):\n2163 |             # operate on naive timestamps, then convert back to aware\n2164 |             self = cast(\"DatetimeArray\", self)\n2165 |             naive = self.tz_localize(None)\n2166 |             result = naive._round(freq, mode, ambiguous, nonexistent)\n2167 |             return result.tz_localize(\n2168 |                 self.tz, ambiguous=ambiguous, nonexistent=nonexistent\n2169 |             )\n2170 | \n2171 |         values = self.view(\"i8\")\n2172 |         values = cast(np.ndarray, values)\n2173 |         nanos = get_unit_for_round(freq, self._creso)\n2174 |         if nanos == 0:\n2175 |             # GH 52761\n2176 |             return self.copy()\n2177 |         result_i8 = round_nsint64(values, mode, nanos)\n2178 |         result = self._maybe_mask_results(result_i8, fill_value=iNaT)\n2179 |         result = result.view(self._ndarray.dtype)\n2180 |         return self._simple_new(result, dtype=self.dtype)\n2181 | \n2182 |     @Appender((_round_doc + _round_example).format(op=\"round\"))\n2183 |     def round(\n2184 |         self,\n2185 |         freq,\n2186 |         ambiguous: TimeAmbiguous = \"raise\",\n2187 |         nonexistent: TimeNonexistent = \"raise\",\n2188 |     ) -> Self:\n2189 |         return self._round(freq, RoundTo.NEAREST_HALF_EVEN, ambiguous, nonexistent)\n2190 | \n2191 |     @Appender((_round_doc + _floor_example).format(op=\"floor\"))\n2192 |     def floor(\n2193 |         self,\n2194 |         freq,\n2195 |         ambiguous: TimeAmbiguous = \"raise\",\n2196 |         nonexistent: TimeNonexistent = \"raise\",\n2197 |     ) -> Self:\n2198 |         return self._round(freq, RoundTo.MINUS_INFTY, ambiguous, nonexistent)\n2199 | \n2200 |     @Appender((_round_doc + _ceil_example).format(op=\"ceil\"))\n2201 |     def ceil(\n2202 |         self,\n2203 |         freq,\n2204 |         ambiguous: TimeAmbiguous = \"raise\",\n2205 |         nonexistent: TimeNonexistent = \"raise\",\n2206 |     ) -> Self:\n2207 |         return self._round(freq, RoundTo.PLUS_INFTY, ambiguous, nonexistent)\n2208 | \n2209 |     # --------------------------------------------------------------\n2210 |     # Reductions\n2211 | \n2212 |     def any(self, *, axis: AxisInt | None = None, skipna: bool = True) -> bool:\n2213 |         # GH#34479 the nanops call will raise a TypeError for non-td64 dtype\n2214 |         return nanops.nanany(self._ndarray, axis=axis, skipna=skipna, mask=self.isna())\n2215 | \n2216 |     def all(self, *, axis: AxisInt | None = None, skipna: bool = True) -> bool:\n2217 |         # GH#34479 the nanops call will raise a TypeError for non-td64 dtype\n2218 | \n2219 |         return nanops.nanall(self._ndarray, axis=axis, skipna=skipna, mask=self.isna())\n2220 | \n2221 |     # --------------------------------------------------------------\n2222 |     # Frequency Methods\n2223 | \n2224 |     def _maybe_clear_freq(self) -> None:\n2225 |         self._freq = None\n2226 | \n2227 |     def _with_freq(self, freq) -> Self:\n2228 |         \"\"\"\n2229 |         Helper to get a view on the same data, with a new freq.\n2230 | \n2231 |         Parameters\n2232 |         ----------\n2233 |         freq : DateOffset, None, or \"infer\"\n2234 | \n2235 |         Returns\n2236 |         -------\n2237 |         Same type as self\n2238 |         \"\"\"\n2239 |         # GH#29843\n2240 |         if freq is None:\n2241 |             # Always valid\n2242 |             pass\n2243 |         elif len(self) == 0 and isinstance(freq, BaseOffset):\n2244 |             # Always valid.  In the TimedeltaArray case, we require a Tick offset\n2245 |             if self.dtype.kind == \"m\" and not isinstance(freq, Tick):\n2246 |                 raise TypeError(\"TimedeltaArray/Index freq must be a Tick\")\n2247 |         else:\n2248 |             # As an internal method, we can ensure this assertion always holds\n2249 |             assert freq == \"infer\"\n2250 |             freq = to_offset(self.inferred_freq)\n2251 | \n2252 |         arr = self.view()\n2253 |         arr._freq = freq\n2254 |         return arr\n2255 | \n2256 |     # --------------------------------------------------------------\n2257 |     # ExtensionArray Interface\n2258 | \n2259 |     def _values_for_json(self) -> np.ndarray:\n2260 |         # Small performance bump vs the base class which calls np.asarray(self)\n2261 |         if isinstance(self.dtype, np.dtype):\n2262 |             return self._ndarray\n2263 |         return super()._values_for_json()\n2264 | \n2265 |     def factorize(\n2266 |         self,\n2267 |         use_na_sentinel: bool = True,\n2268 |         sort: bool = False,\n2269 |     ):\n2270 |         if self.freq is not None:\n2271 |             # We must be unique, so can short-circuit (and retain freq)\n2272 |             if sort and self.freq.n < 0:\n2273 |                 codes = np.arange(len(self) - 1, -1, -1, dtype=np.intp)\n2274 |                 uniques = self[::-1]\n2275 |    