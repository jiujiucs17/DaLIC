es of each member of a *LineCollection* default to their values\n1601 |     in :rc:`lines.*` instead of :rc:`patch.*`, and the property *colors* is\n1602 |     added in place of *edgecolors*.\n1603 |     \"\"\"\n1604 | \n1605 |     _edge_default = True\n1606 | \n1607 |     def __init__(self, segments,  # Can be None.\n1608 |                  *,\n1609 |                  zorder=2,        # Collection.zorder is 1\n1610 |                  **kwargs\n1611 |                  ):\n1612 |         \"\"\"\n1613 |         Parameters\n1614 |         ----------\n1615 |         segments : list of array-like\n1616 |             A sequence (*line0*, *line1*, *line2*) of lines, where each line is a list\n1617 |             of points::\n1618 | \n1619 |                 lineN = [(x0, y0), (x1, y1), ... (xm, ym)]\n1620 | \n1621 |             or the equivalent Mx2 numpy array with two columns. Each line\n1622 |             can have a different number of segments.\n1623 |         linewidths : float or list of float, default: :rc:`lines.linewidth`\n1624 |             The width of each line in points.\n1625 |         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n1626 |             A sequence of RGBA tuples (e.g., arbitrary color strings, etc, not\n1627 |             allowed).\n1628 |         antialiaseds : bool or list of bool, default: :rc:`lines.antialiased`\n1629 |             Whether to use antialiasing for each line.\n1630 |         zorder : float, default: 2\n1631 |             zorder of the lines once drawn.\n1632 | \n1633 |         facecolors : :mpltype:`color` or list of :mpltype:`color`, default: 'none'\n1634 |             When setting *facecolors*, each line is interpreted as a boundary\n1635 |             for an area, implicitly closing the path from the last point to the\n1636 |             first point. The enclosed area is filled with *facecolor*.\n1637 |             In order to manually specify what should count as the \"interior\" of\n1638 |             each line, please use `.PathCollection` instead, where the\n1639 |             \"interior\" can be specified by appropriate usage of\n1640 |             `~.path.Path.CLOSEPOLY`.\n1641 | \n1642 |         **kwargs\n1643 |             Forwarded to `.Collection`.\n1644 |         \"\"\"\n1645 |         # Unfortunately, mplot3d needs this explicit setting of 'facecolors'.\n1646 |         kwargs.setdefault('facecolors', 'none')\n1647 |         super().__init__(\n1648 |             zorder=zorder,\n1649 |             **kwargs)\n1650 |         self.set_segments(segments)\n1651 | \n1652 |     def set_segments(self, segments):\n1653 |         if segments is None:\n1654 |             return\n1655 | \n1656 |         self._paths = [mpath.Path(seg) if isinstance(seg, np.ma.MaskedArray)\n1657 |                        else mpath.Path(np.asarray(seg, float))\n1658 |                        for seg in segments]\n1659 |         self.stale = True\n1660 | \n1661 |     set_verts = set_segments  # for compatibility with PolyCollection\n1662 |     set_paths = set_segments\n1663 | \n1664 |     def get_segments(self):\n1665 |         \"\"\"\n1666 |         Returns\n1667 |         -------\n1668 |         list\n1669 |             List of segments in the LineCollection. Each list item contains an\n1670 |             array of vertices.\n1671 |         \"\"\"\n1672 |         segments = []\n1673 | \n1674 |         for path in self._paths:\n1675 |             vertices = [\n1676 |                 vertex\n1677 |                 for vertex, _\n1678 |                 # Never simplify here, we want to get the data-space values\n1679 |                 # back and there in no way to know the \"right\" simplification\n1680 |                 # threshold so never try.\n1681 |                 in path.iter_segments(simplify=False)\n1682 |             ]\n1683 |             vertices = np.asarray(vertices)\n1684 |             segments.append(vertices)\n1685 | \n1686 |         return segments\n1687 | \n1688 |     def _get_default_linewidth(self):\n1689 |         return mpl.rcParams['lines.linewidth']\n1690 | \n1691 |     def _get_default_antialiased(self):\n1692 |         return mpl.rcParams['lines.antialiased']\n1693 | \n1694 |     def _get_default_edgecolor(self):\n1695 |         return mpl.rcParams['lines.color']\n1696 | \n1697 |     def _get_default_facecolor(self):\n1698 |         return 'none'\n1699 | \n1700 |     def set_alpha(self, alpha):\n1701 |         # docstring inherited\n1702 |         super().set_alpha(alpha)\n1703 |         if self._gapcolor is not None:\n1704 |             self.set_gapcolor(self._original_gapcolor)\n1705 | \n1706 |     def set_color(self, c):\n1707 |         \"\"\"\n1708 |         Set the edgecolor(s) of the LineCollection.\n1709 | \n1710 |         Parameters\n1711 |         ----------\n1712 |         c : :mpltype:`color` or list of :mpltype:`color`\n1713 |             Single color (all lines have same color), or a\n1714 |             sequence of RGBA tuples; if it is a sequence the lines will\n1715 |             cycle through the sequence.\n1716 |         \"\"\"\n1717 |         self.set_edgecolor(c)\n1718 | \n1719 |     set_colors = set_color\n1720 | \n1721 |     def get_color(self):\n1722 |         return self._edgecolors\n1723 | \n1724 |     get_colors = get_color  # for compatibility with old versions\n1725 | \n1726 |     def set_gapcolor(self, gapcolor):\n1727 |         \"\"\"\n1728 |         Set a color to fill the gaps in the dashed line style.\n1729 | \n1730 |         .. note::\n1731 | \n1732 |             Striped lines are created by drawing two interleaved dashed lines.\n1733 |             There can be overlaps between those two, which may result in\n1734 |             artifacts when using transparency.\n1735 | \n1736 |             This functionality is experimental and may change.\n1737 | \n1738 |         Parameters\n1739 |         ----------\n1740 |         gapcolor : :mpltype:`color` or list of :mpltype:`color` or None\n1741 |             The color with which to fill the gaps. If None, the gaps are\n1742 |             unfilled.\n1743 |         \"\"\"\n1744 |         self._original_gapcolor = gapcolor\n1745 |         self._set_gapcolor(gapcolor)\n1746 | \n1747 |     def _set_gapcolor(self, gapcolor):\n1748 |         if gapcolor is not None:\n1749 |             gapcolor = mcolors.to_rgba_array(gapcolor, self._alpha)\n1750 |         self._gapcolor = gapcolor\n1751 |         self.stale = True\n1752 | \n1753 |     def get_gapcolor(self):\n1754 |         return self._gapcolor\n1755 | \n1756 |     def _get_inverse_paths_linestyles(self):\n1757 |         \"\"\"\n1758 |         Returns the path and pattern for the gaps in the non-solid lines.\n1759 | \n1760 |         This path and pattern is the inverse of the path and pattern used to\n1761 |         construct the non-solid lines. For solid lines, we set the inverse path\n1762 |         to nans to prevent drawing an inverse line.\n1763 |         \"\"\"\n1764 |         path_patterns = [\n1765 |             (mpath.Path(np.full((1, 2), np.nan)), ls)\n1766 |             if ls == (0, None) else\n1767 |             (path, mlines._get_inverse_dash_pattern(*ls))\n1768 |             for (path, ls) in\n1769 |             zip(self._paths, itertools.cycle(self._linestyles))]\n1770 | \n1771 |         return zip(*path_patterns)\n```\n"}, {"content": "Let me also check for any related docstring handling utilities:\n\n<function=search_code_snippets>\n<parameter=search_terms>['_docstring', 'update_docstring']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nlib/matplotlib/artist.py:_get_tightbbox_for_layout_only\nlib/matplotlib/artist.py:ArtistInspector.__init__\nlib/matplotlib/artist.py:ArtistInspector\nlib/matplotlib/artist.py:ArtistInspector:3\nlib/matplotlib/artist.py:ArtistInspector.get_aliases\nlib/matplotlib/artist.py:ArtistI