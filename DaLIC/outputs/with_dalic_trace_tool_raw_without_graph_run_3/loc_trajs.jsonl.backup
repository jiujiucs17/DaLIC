| None\n2479 | ) -> BaseOffset | None:\n2480 |     \"\"\"\n2481 |     If the user passes a freq and another freq is inferred from passed data,\n2482 |     require that they match.\n2483 | \n2484 |     Parameters\n2485 |     ----------\n2486 |     freq : DateOffset or None\n2487 |     inferred_freq : DateOffset or None\n2488 | \n2489 |     Returns\n2490 |     -------\n2491 |     freq : DateOffset or None\n2492 |     \"\"\"\n2493 |     if inferred_freq is not None:\n2494 |         if freq is not None and freq != inferred_freq:\n2495 |             raise ValueError(\n2496 |                 f\"Inferred frequency {inferred_freq} from passed \"\n2497 |                 \"values does not conform to passed frequency \"\n2498 |                 f\"{freq.freqstr}\"\n2499 |             )\n2500 |         if freq is None:\n2501 |             freq = inferred_freq\n2502 | \n2503 |     return freq\n2504 | \n2505 | \n2506 | def dtype_to_unit(dtype: DatetimeTZDtype | np.dtype | ArrowDtype) -> str:\n2507 |     \"\"\"\n2508 |     Return the unit str corresponding to the dtype's resolution.\n2509 | \n2510 |     Parameters\n2511 |     ----------\n2512 |     dtype : DatetimeTZDtype or np.dtype\n2513 |         If np.dtype, we assume it is a datetime64 dtype.\n2514 | \n2515 |     Returns\n2516 |     -------\n2517 |     str\n2518 |     \"\"\"\n2519 |     if isinstance(dtype, DatetimeTZDtype):\n2520 |         return dtype.unit\n2521 |     elif isinstance(dtype, ArrowDtype):\n2522 |         if dtype.kind not in \"mM\":\n2523 |             raise ValueError(f\"{dtype=} does not have a resolution.\")\n2524 |         return dtype.pyarrow_dtype.unit\n2525 |     return np.datetime_data(dtype)[0]\n2526 | \n```\n"}, {"content": "Let me also check the implementation of `Series.round()`:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/core/series.py:Series.round']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"pandas/core/series.py:Series.round\"...\n### Search Result:\nFound function `pandas/core/series.py:Series.round`.\nSource: Exact match found for entity name `pandas/core/series.py:Series.round`.\n```\n2463 | def round(self, decimals: int = 0, *args, **kwargs) -> Series:\n2464 |         \"\"\"\n2465 |         Round each value in a Series to the given number of decimals.\n2466 | \n2467 |         Parameters\n2468 |         ----------\n2469 |         decimals : int, default 0\n2470 |             Number of decimal places to round to. If decimals is negative,\n2471 |             it specifies the number of positions to the left of the decimal point.\n2472 |         *args, **kwargs\n2473 |             Additional arguments and keywords have no effect but might be\n2474 |             accepted for compatibility with NumPy.\n2475 | \n2476 |         Returns\n2477 |         -------\n2478 |         Series\n2479 |             Rounded values of the Series.\n2480 | \n2481 |         See Also\n2482 |         --------\n2483 |         numpy.around : Round values of an np.array.\n2484 |         DataFrame.round : Round values of a DataFrame.\n2485 | \n2486 |         Notes\n2487 |         -----\n2488 |         For values exactly halfway between rounded decimal values, pandas rounds\n2489 |         to the nearest even value (e.g. -0.5 and 0.5 round to 0.0, 1.5 and 2.5\n2490 |         round to 2.0, etc.).\n2491 | \n2492 |         Examples\n2493 |         --------\n2494 |         >>> s = pd.Series([-0.5, 0.1, 2.5, 1.3, 2.7])\n2495 |         >>> s.round()\n2496 |         0   -0.0\n2497 |         1    0.0\n2498 |         2    2.0\n2499 |         3    1.0\n2500 |         4    3.0\n2501 |         dtype: float64\n2502 |         \"\"\"\n2503 |         nv.validate_round(args, kwargs)\n2504 |         new_mgr = self._mgr.round(decimals=decimals)\n2505 |         return self._constructor_from_mgr(new_mgr, axes=new_mgr.axe