yword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass DatetimeTZDtype(PandasExtensionDtype):\n\n    type: type[Timestamp] = Timestamp\n    kind: str_type = \"M\"\n    num = 101\n    _metadata = (\"unit\", \"tz\")\n    _match = re.compile(r\"(datetime64|M8)\\[(?P<unit>.+), (?P<tz>.+)\\]\")\n    _cache_dtypes: dict[str_type, PandasExtensionDtype] = {}\n    _supports_2d = True\n    _can_fast_transpose = True\n\n    @property\n    def na_value(self) -> NaTType:\n...\n    @cache_readonly\n    def base(self) -> DtypeObj:\n...\n    # error: Signature of \"str\" incompatible with supertype \"PandasExtensionDtype\"\n    @cache_readonly\n    def str(self) -> str:\n...\n    def __init__(self, unit: str_type | DatetimeTZDtype = \"ns\", tz=None) -> None:\n...\n    @cache_readonly\n    def _creso(self) -> int:\n...\n    @property\n    def unit(self) -> str_type:\n...\n    @property\n    def tz(self) -> tzinfo:\n...\n    @classmethod\n    def construct_array_type(cls) -> type_t[DatetimeArray]:\n...\n    @classmethod\n    def construct_from_string(cls, string: str_type) -> DatetimeTZDtype:\n...\n    def __str__(self) -> str_type:\n...\n    @property\n    def name(self) -> str_type:\n...\n    def __hash__(self) -> int:\n...\n    def __eq__(self, other: object) -> bool:\n...\n    def __from_arrow__(self, array: pa.Array | pa.ChunkedArray) -> DatetimeArray:\n...\n    def __setstate__(self, state) -> None:\n...\n    def _get_common_dtype(self, dtypes: list[DtypeObj]) -> DtypeObj | None:\n...\n    @cache_readonly\n    def index_class(self) -> type_t[DatetimeIndex]:\n\n```\nHint: Search `pandas/core/dtypes/dtypes.py:DatetimeTZDtype` to get the full content if needed.\n\nFound class `pandas/core/dtypes/dtypes.py:ArrowDtype`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass ArrowDtype(StorageExtensionDtype):\n\n    _metadata = (\"storage\", \"py