|         storage_options: StorageOptions | None = None,\n3751 |     ) -> str | None:\n3752 |         r\"\"\"\n3753 |         Write object to a comma-separated values (csv) file.\n3754 | \n3755 |         Parameters\n3756 |         ----------\n3757 |         path_or_buf : str, path object, file-like object, or None, default None\n3758 |             String, path object (implementing os.PathLike[str]), or file-like\n3759 |             object implementing a write() function. If None, the result is\n3760 |             returned as a string. If a non-binary file object is passed, it should\n3761 |             be opened with `newline=''`, disabling universal newlines. If a binary\n3762 |             file object is passed, `mode` might need to contain a `'b'`.\n3763 |         sep : str, default ','\n3764 |             String of length 1. Field delimiter for the output file.\n3765 |         na_rep : str, default ''\n3766 |             Missing data representation.\n3767 |         float_format : str, Callable, default None\n3768 |             Format string for floating point numbers. If a Callable is given, it takes\n3769 |             precedence over other numeric formatting parameters, like decimal.\n3770 |         columns : sequence, optional\n3771 |             Columns to write.\n3772 |         header : bool or list of str, default True\n3773 |             Write out the column names. If a list of strings is given it is\n3774 |             assumed to be aliases for the column names.\n3775 |         index : bool, default True\n3776 |             Write row names (index).\n3777 |         index_label : str or sequence, or False, default None\n3778 |             Column label for index column(s) if desired. If None is given, and\n3779 |             `header` and `index` are True, then the index names are used. A\n3780 |             sequence should be given if the object uses MultiIndex. If\n3781 |             False do not print fields for index names. Use index_label=False\n3782 |             for easier importing in R.\n3783 |         mode : {{'w', 'x', 'a'}}, default 'w'\n3784 |             Forwarded to either `open(mode=)` or `fsspec.open(mode=)` to control\n3785 |             the file opening. Typical values include:\n3786 | \n3787 |             - 'w', truncate the file first.\n3788 |             - 'x', exclusive creation, failing if the file already exists.\n3789 |             - 'a', append to the end of file if it exists.\n3790 | \n3791 |         encoding : str, optional\n3792 |             A string representing the encoding to use in the output file,\n3793 |             defaults to 'utf-8'. `encoding` is not supported if `path_or_buf`\n3794 |             is a non-binary file object.\n3795 |         {compression_options}\n3796 | \n3797 |                May be a dict with key 'method' as compression mode\n3798 |                and other entries as additional compression options if\n3799 |                compression mode is 'zip'.\n3800 | \n3801 |                Passing compression options as keys in dict is\n3802 |                supported for compression modes 'gzip', 'bz2', 'zstd', and 'zip'.\n3803 |         quoting : optional constant from csv module\n3804 |             Defaults to csv.QUOTE_MINIMAL. If you have set a `float_format`\n3805 |             then floats are converted to strings and thus csv.QUOTE_NONNUMERIC\n3806 |             will treat them as non-numeric.\n3807 |         quotechar : str, default '\\\"'\n3808 |             String of length 1. Character used to quote fields.\n3809 |         lineterminator : str, optional\n3810 |             The newline character or character sequence to use in the output\n3811 |             file. Defaults to `os.linesep`, which depends on the OS in which\n3812 |             this method is called ('\\\\n' for linux, '\\\\r\\\\n' for Windows, i.e.).\n3813 | \n3814 |             .. versionchanged:: 1.5.0\n3815 | \n3816 |                 Previously was line_terminator, changed for consistency with\n3817 |                 read_csv and the standard library 'csv' module.\n3818 | \n3819 |         chunksize : int or None\n3820 |             Rows to write at a time.\n3821 |         date_format : str, default None\n3822 |             Format string for datetime objects.\n3823 |         doublequote : bool, default True\n3824 |             Control quoting of `quotechar` inside a field.\n3825 |         escapechar : str, default None\n3826 |             String of length 1. Character used to escape `sep` and `quotechar`\n3827 |             when appropriate.\n3828 |         decimal : str, default '.'\n3829 |             Character recognized as decimal separator. E.g. use ',' for\n3830 |             European data.\n3831 |         errors : str, default 'strict'\n3832 |             Specifies how encoding and decoding errors are to be handled.\n3833 |             See the errors argument for :func:`open` for a full list\n3834 |             of options.\n3835 | \n3836 |         {storage_options}\n3837 | \n3838 |         Returns\n3839 |         -------\n3840 |         None or str\n3841 |             If path_or_buf is None, returns the resulting csv format as a\n3842 |             string. Otherwise returns None.\n3843 | \n3844 |         See Also\n3845 |         --------\n3846 |         read_csv : Load a CSV file into a DataFrame.\n3847 |         to_excel : Write DataFrame to an Excel file.\n3848 | \n3849 |         Examples\n3850 |         --------\n3851 |         Create 'out.csv' containing 'df' without indices\n3852 | \n3853 |         >>> df = pd.DataFrame(\n3854 |         ...     [[\"Raphael\", \"red\", \"sai\"], [\"Donatello\", \"purple\", \"bo staff\"]],\n3855 |         ...     columns=[\"name\", \"mask\", \"weapon\"],\n3856 |         ... )\n3857 |         >>> df.to_csv(\"out.csv\", index=False)  # doctest: +SKIP\n3858 | \n3859 |         Create 'out.zip' containing 'out.csv'\n3860 | \n3861 |         >>> df.to_csv(index=False)\n3862 |         'name,mask,weapon\\nRaphael,red,sai\\nDonatello,purple,bo staff\\n'\n3863 |         >>> compression_opts = dict(\n3864 |         ...     method=\"zip\", archive_name=\"out.csv\"\n3865 |         ... )  # doctest: +SKIP\n3866 |         >>> df.to_csv(\n3867 |         ...     \"out.zip\", index=False, compression=compression_opts\n3868 |         ... )  # doctest: +SKIP\n3869 | \n3870 |         To write a csv file to a new folder or nested folder you will first\n3871 |         need to create it using either Pathlib or os:\n3872 | \n3873 |         >>> from pathlib import Path  # doctest: +SKIP\n3874 |         >>> filepath = Path(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3875 |         >>> filepath.parent.mkdir(parents=True, exist_ok=True)  # doctest: +SKIP\n3876 |         >>> df.to_csv(filepath)  # doctest: +SKIP\n3877 | \n3878 |         >>> import os  # doctest: +SKIP\n3879 |         >>> os.makedirs(\"folder/subfolder\", exist_ok=True)  # doctest: +SKIP\n3880 |         >>> df.to_csv(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3881 |         \"\"\"\n3882 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n3883 | \n3884 |         formatter = DataFrameFormatter(\n3885 |             frame=df,\n3886 |             header=header,\n3887 |             index=index,\n3888 |             na_rep=na_rep,\n3889 |             float_format=float_format,\n3890 |             decimal=decimal,\n3891 |         )\n3892 | \n3893 |         return DataFrameRenderer(formatter).to_csv(\n3894 |             path_or_buf,\n3895 |             lineterminator=lineterminator,\n3896 |             sep=sep,\n3897 |             encoding=encoding,\n3898 |             errors=errors,\n3899 |             compression=compression,\n3900 |             quoting=quoting,\n3901 |             columns=columns,\n3902 |             index_label=index_label,\n3903 |             mode=mode,\n3904 |             chunksize=chunksize,\n3905 |             quotechar=quotechar,\n3906 |             date_format=date_format,\n3907 |   