.\",\n444 |         bold_rows: bool = False,\n445 |         escape: bool = True,\n446 |     ) -> None:\n447 |         self.frame = frame\n448 |         self.columns = self._initialize_columns(columns)\n449 |         self.col_space = self._initialize_colspace(col_space)\n450 |         self.header = header\n451 |         self.index = index\n452 |         self.na_rep = na_rep\n453 |         self.formatters = self._initialize_formatters(formatters)\n454 |         self.justify = self._initialize_justify(justify)\n455 |         self.float_format = float_format\n456 |         self.sparsify = self._initialize_sparsify(sparsify)\n457 |         self.show_index_names = index_names\n458 |         self.decimal = decimal\n459 |         self.bold_rows = bold_rows\n460 |         self.escape = escape\n461 |         self.max_rows = max_rows\n462 |         self.min_rows = min_rows\n463 |         self.max_cols = max_cols\n464 |         self.show_dimensions = show_dimensions\n465 | \n466 |         self.max_cols_fitted = self._calc_max_cols_fitted()\n467 |         self.max_rows_fitted = self._calc_max_rows_fitted()\n468 | \n469 |         self.tr_frame = self.frame\n470 |         self.truncate()\n471 |         self.adj = printing.get_adjustment()\n472 | \n473 |     def get_strcols(self) -> list[list[str]]:\n474 |         \"\"\"\n475 |         Render a DataFrame to a list of columns (as lists of strings).\n476 |         \"\"\"\n477 |         strcols = self._get_strcols_without_index()\n478 | \n479 |         if self.index:\n480 |             str_index = self._get_formatted_index(self.tr_frame)\n481 |             strcols.insert(0, str_index)\n482 | \n483 |         return strcols\n484 | \n485 |     @property\n486 |     def should_show_dimensions(self) -> bool:\n487 |         return self.show_dimensions is True or (\n488 |             self.show_dimensions == \"truncate\" and self.is_truncated\n489 |         )\n490 | \n491 |     @property\n492 |     def is_truncated(self) -> bool:\n493 |         return bool(self.is_truncated_horizontally or self.is_truncated_vertically)\n494 | \n495 |     @property\n496 |     def is_truncated_horizontally(self) -> bool:\n497 |         return bool(self.max_cols_fitted and (len(self.columns) > self.max_cols_fitted))\n498 | \n499 |     @property\n500 |     def is_truncated_vertically(self) -> bool:\n501 |         return bool(self.max_rows_fitted and (len(self.frame) > self.max_rows_fitted))\n502 | \n503 |     @property\n504 |     def dimensions_info(self) -> str:\n505 |         return f\"\\n\\n[{len(self.frame)} rows x {len(self.frame.columns)} columns]\"\n506 | \n507 |     @property\n508 |     def has_index_names(self) -> bool:\n509 |         return _has_names(self.frame.index)\n510 | \n511 |     @property\n512 |     def has_column_names(self) -> bool:\n513 |         return _has_names(self.frame.columns)\n514 | \n515 |     @property\n516 |     def show_row_idx_names(self) -> bool:\n517 |         return all((self.has_index_names, self.index, self.show_index_names))\n518 | \n519 |     @property\n520 |     def show_col_idx_names(self) -> bool:\n521 |         return all((self.has_column_names, self.show_index_names, self.header))\n522 | \n523 |     @property\n524 |     def max_rows_displayed(self) -> int:\n525 |         return min(self.max_rows or len(self.frame), len(self.frame))\n526 | \n527 |     def _initialize_sparsify(self, sparsify: bool | None) -> bool:\n528 |         if sparsify is None:\n529 |             return get_option(\"display.multi_sparse\")\n530 |         return sparsify\n531 | \n532 |     def _initialize_formatters(\n533 |         self, formatters: FormattersType | None\n534 |     ) -> FormattersType:\n535 |         if formatters is None:\n536 |             return {}\n537 |         elif len(self.frame.columns) == len(formatters) or isinstance(formatters, dict):\n538 |             return formatters\n539 |         else:\n540 |             raise ValueError(\n541 |                 f\"Formatters length({len(formatters)}) should match \"\n542 |                 f\"DataFrame number of columns({len(self.frame.columns)})\"\n543 |             )\n544 | \n545 |     def _initialize_justify(self, justify: str | None) -> str:\n546 |         if justify is None:\n547 |             return get_option(\"display.colheader_justify\")\n548 |         else:\n549 |             return justify\n550 | \n551 |     def _initialize_columns(self, columns: Axes | None) -> Index:\n552 |         if columns is not None:\n553 |             cols = ensure_index(columns)\n554 |             self.frame = self.frame[cols]\n555 |             return cols\n556 |         else:\n557 |             return self.frame.columns\n558 | \n559 |     def _initialize_colspace(self, col_space: ColspaceArgType | None) -> ColspaceType:\n560 |         result: ColspaceType\n561 | \n562 |         if col_space is None:\n563 |             result = {}\n564 |         elif isinstance(col_space, (int, str)):\n565 |             result = {\"\": col_space}\n566 |             result.update({column: col_space for column in self.frame.columns})\n567 |         elif isinstance(col_space, Mapping):\n568 |             for column in col_space.keys():\n569 |                 if column not in self.frame.columns and column != \"\":\n570 |                     raise ValueError(\n571 |                         f\"Col_space is defined for an unknown column: {column}\"\n572 |                     )\n573 |             result = col_space\n574 |         else:\n575 |             if len(self.frame.columns) != len(col_space):\n576 |                 raise ValueError(\n577 |                     f\"Col_space length({len(col_space)}) should match \"\n578 |                     f\"DataFrame number of columns({len(self.frame.columns)})\"\n579 |                 )\n580 |             result = dict(zip(self.frame.columns, col_space))\n581 |         return result\n582 | \n583 |     def _calc_max_cols_fitted(self) -> int | None:\n584 |         \"\"\"Number of columns fitting the screen.\"\"\"\n585 |         if not self._is_in_terminal():\n586 |             return self.max_cols\n587 | \n588 |         width, _ = get_terminal_size()\n589 |         if self._is_screen_narrow(width):\n590 |             return width\n591 |         else:\n592 |             return self.max_cols\n593 | \n594 |     def _calc_max_rows_fitted(self) -> int | None:\n595 |         \"\"\"Number of rows with data fitting the screen.\"\"\"\n596 |         max_rows: int | None\n597 | \n598 |         if self._is_in_terminal():\n599 |             _, height = get_terminal_size()\n600 |             if self.max_rows == 0:\n601 |                 # rows available to fill with actual data\n602 |                 return height - self._get_number_of_auxiliary_rows()\n603 | \n604 |             if self._is_screen_short(height):\n605 |                 max_rows = height\n606 |             else:\n607 |                 max_rows = self.max_rows\n608 |         else:\n609 |             max_rows = self.max_rows\n610 | \n611 |         return self._adjust_max_rows(max_rows)\n612 | \n613 |     def _adjust_max_rows(self, max_rows: int | None) -> int | None:\n614 |         \"\"\"Adjust max_rows using display logic.\n615 | \n616 |         See description here:\n617 |         https://pandas.pydata.org/docs/dev/user_guide/options.html#frequently-used-options\n618 | \n619 |         GH #37359\n620 |         \"\"\"\n621 |         if max_rows:\n622 |             if (len(self.frame) > max_rows) and self.min_rows:\n623 |                 # if truncated, set max_rows showed to min_rows\n624 |                 max_rows = min(self.min_rows, max_rows)\n625 |         return max_rows\n626 | \n627 |     def _is_in_terminal(self) -> bool:\n628 |         \"\"\"Check if the output is to be shown in terminal.\"\"\"\n629 |         return bool(self.max_cols == 0 or self.max_rows == 0)\n630 | \n631 |     def _is_screen_narrow(self, max_width) -> bool:\n632 |         return bool(self.max_cols == 0 and len(self.frame.columns) > max_width)\n633 | \n634 |     def _is_screen_short(self, max_height) -> bool:\n635 |         return bool(self.max_rows == 0 and len(self.frame) > max_height)\n636 | \n637 |     def _get_number_of_auxiliary_rows(self) -> int:\n638 |         \"\"\"Get number of rows occupied by prompt, dots and dimension info.\"\"\"\n639 |         dot_row = 1\n640 |         prompt_row = 1\n641 |         num_rows = dot_row + prompt_row\n642 | \n643 |         if self.show_dimensions:\n644 |             num_rows += len(self.dimensions_info.splitlines())\n645 | \n646 |         if self.header:\n647 |             num_rows += 1\n648 | \n649 |         return num_rows\n650 | \n651 |     def truncate(self) -> None:\n652 |         \"\"\"\n653 |         Check whether the frame should be truncated. If so, slice the frame up.\n654 |         \"\"\"\n655 |         if self.is_truncated_horizontally:\n656 |             self._truncate_horizontally()\n657 | \n658 |         if self.is_truncated_vertically:\n659 |             self._truncate_vertically()\n660 | \n661 |     def _truncate_horizontally(self) -> None:\n662 |         \"\"\"Remove columns, which are not to be displayed and adjust formatters.\n663 | \n664 |         Attributes affected:\n665 |             - tr_frame\n666 |             - formatters\n667 |             - tr_col_num\n668 |         \"\"\"\n669 |         assert self.max_cols_fitted is not None\n670 |         col_num = self.max_cols_fitted // 2\n671 |         if col_num >= 1:\n672 |             left = self.tr_frame.iloc[:, :col_num]\n673 |             right = self.tr_frame.iloc[:, -col_num:]\n674 |             self.tr_frame = concat((left, right), axis=1)\n675 | \n676 |             # truncate formatter\n677 |             if isinstance(self.formatters, (list, tuple)):\n678 |                 self.formatters = [\n679 |                     *self.formatters[:col_num],\n680 |                     *self.formatters[-col_num:],\n681 |                 ]\n682 |         else:\n683 |             col_num = cast(int, self.max_cols)\n684 |             self.tr_frame = self.tr_frame.iloc[:, :col_num]\n685 |         self.tr_col_num = col_num\n686 | \n687 |     def _truncate_vertically(self) -> None:\n688 |         \"\"\"Remove rows, which are not to be displayed.\n689 | \n690 |         Attributes affected:\n691 |             - tr_frame\n692 |             - tr_row_num\n693 |         \"\"\"\n694 |         assert self.max_rows_fitted is not None\n695 |         row_num = self.max_rows_fitted // 2\n696 |         if row_num >= 1:\n697 |             _len = len(self.tr_frame)\n698 |             _slice = np.hstack([np.arange(row_num), np.arange(_len - row_num, _len)])\n699 |             self.tr_frame = self.tr_frame.iloc[_slice]\n700 |         else:\n701 |             row_num = cast(int, self.max_rows)\n702 |             self.tr_frame = self.tr_frame.iloc[:row_num, :]\n703 |         self.tr_row_num = row_num\n704 | \n705 |     def _get_strcols_without_index(self) -> list[list[str]]:\n706 |         strcols: list[list[str]] = []\n707 | \n708 |         if not is_list_like(self.header) and not self.header:\n709 |             for i, c in enumerate(self.tr_frame):\n710 |                 fmt_values = self.format_col(i)\n711 |                 fmt_values = _make_fixed_width(\n712 |                     strings=fmt_values,\n713 |                     justify=self.justify,\n714 |                     minimum=int(self.col_space.get(c, 0)),\n715 |                     adj=self.adj,\n716 |                 )\n717 |                 strcols.append(fmt_values)\n718 |             return strcols\n719 | \n720 |         if is_list_like(self.header):\n721 |             # cast here since can't be bool if is_list_like\n722 |             self.header = cast(list[str], self.header)\n723 |             if len(self.header) != len(self.columns):\n724 |                 raise ValueError(\n725 |                     f\"Writing {len(self.columns)} cols \"\n726 |                     f\"but got {len(self.header)} aliases\"