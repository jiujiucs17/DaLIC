1497 |         @functools.wraps(fit_method)\n1498 |         def wrapper(estimator, *args, **kwargs):\n1499 |             global_skip_validation = get_config()[\"skip_parameter_validation\"]\n1500 | \n1501 |             # we don't want to validate again for each call to partial_fit\n1502 |             partial_fit_and_fitted = (\n1503 |                 fit_method.__name__ == \"partial_fit\" and _is_fitted(estimator)\n1504 |             )\n1505 | \n1506 |             if not global_skip_validation and not partial_fit_and_fitted:\n1507 |                 estimator._validate_params()\n1508 | \n1509 |             with config_context(\n1510 |                 skip_parameter_validation=(\n1511 |                     prefer_skip_nested_validation or global_skip_validation\n1512 |                 )\n1513 |             ):\n1514 |                 return fit_method(estimator, *args, **kwargs)\n1515 | \n1516 |         return wrapper\n1517 | \n1518 |     return decorator\n```\n"}, {"content": "Let me check the execution trace artifacts to see what's relevant to documentation.\n\n<function=get_trace_artifacts>\n<parameter=artifact_type>function</parameter>\n<parameter=name_contains>assert_consistent_docs</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_trace_artifacts", "content": "OBSERVATION:\n{\n  \"instance_id\": \"scikit-learn__scikit-learn-28678\",\n  \"trace_summary\": {\n    \"unique_function_count\": 37,\n    \"returned_count\": 0,\n    \"filtered_count\": 0\n  },\n  \"applied_filters\": {\n    \"artifact_type\": \"function\",\n    \"path_contains\": null,\n    \"name_contains\": \"assert_consistent_docs\",\n    \"start\": 0,\n    \"limit\": 8\n  },\n  \"artifacts\": [],\n  \"has_more\": false,\n  \"next_start\": 0\n}"}, {"content": "Let me check for test files that might reference this feature.\n\n<function=search_code_snippets>\n<parameter=search_terms>['test_assert_consistent_docs']</p