SITION = ['PLSCanonical', 'PLSRegression', 'CCA', 'PLSSVD']\n```\n\nFound function `sklearn/calibration.py:_sigmoid_calibration`.\nSource: Retrieved entity using keyword search (bm25).\n```\n452 | def _sigmoid_calibration(df, y, sample_weight=None):\n453 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n454 | \n455 |     Parameters\n456 |     ----------\n457 |     df : ndarray, shape (n_samples,)\n458 |         The decision function or predict proba for the samples.\n459 | \n460 |     y : ndarray, shape (n_samples,)\n461 |         The targets.\n462 | \n463 |     sample_weight : array-like of shape (n_samples,), default=None\n464 |         Sample weights. If None, then samples are equally weighted.\n465 | \n466 |     Returns\n467 |     -------\n468 |     a : float\n469 |         The slope.\n470 | \n471 |     b : float\n472 |         The intercept.\n473 | \n474 |     References\n475 |     ----------\n476 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n477 |     \"\"\"\n478 |     df = column_or_1d(df)\n479 |     y = column_or_1d(y)\n480 | \n481 |     F = df  # F follows Platt's notations\n482 | \n483 |     # Bayesian priors (see Platt end of section 2.2)\n484 |     prior0 = float(np.sum(y <= 0))\n485 |     prior1 = y.shape[0] - prior0\n486 |     T = np.zeros(y.shape)\n487 |     T[y > 0] = (prior1 + 1.) / (prior1 + 2.)\n488 |     T[y <= 0] = 1. / (prior0 + 2.)\n489 |     T1 = 1. - T\n490 | \n491 |     def objective(AB):\n492 |         # From Platt (beginning of Section 2.2)\n493 |         P = expit(-(AB[0] * F + AB[1]))\n494 |         loss = -(xlogy(T, P) + xlogy(T1, 1. - P))\n495 |         if sample_weight is not None:\n496 |             return (sample_weight * loss).sum()\n497 |         else:\n498 |             return loss.sum()\n499 | \n500 |     def grad(AB):\n501 |         # gradient of the objective function\n502 |         P = expit(-(AB[0] * F + AB[1]))\n503 |         TEP_minus_T1P = T - P\n504 |         if sample_weight is not None:\n505 |             TEP_minus_T1P *= sample_weight\n506 |         dA = np.dot(TEP_minus_T1P, F)\n507 |         dB = np.sum(TEP_minus_T1P)\n508 |         return np.array([dA, dB])\n509 | \n510 |     AB0 = np.array([0., log((prior0 + 1.) / (prior1 + 1.))])\n511 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n512 |     return AB_[0], AB_[1]\n```\n\nFound file `examples/calibration/plot_calibration.py`.\nFound file `sklearn/calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"import hashlib\", \"import hashlib md5_checksum\"...\n### Search Result:\nFound function `sklearn/datasets/_base.py:_pkl_filepath`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1127 | def _pkl_filepath(*args, **kwargs):\n1128 |     \"\"\"Return filename for Python 3 pickles\n1129 | \n1130 |     args[-1] is expected to be the \".pkl\" filename. For compatibility with\n1131 |     older scikit-learn versions, a suffix is inserted before the extension.\n1132 | \n1133 |     _pkl_filepath('/path/to/folder', 'filename.pkl') returns\n1134 |     '/path/to/folder/filename_py3.pkl'\n1135 | \n1136 |     \"\"\"\n1137 |     py3_suffix = kwargs.get(\"py3_suffix\", \"_py3\")\n1138 |     basename, ext = splitext(args[-1])\n1139 |     basename += py3_suffix\n1140 |     new_args = args[:-1] + (basename + ext,)\n1141 |     return join(*new_args)\n```\n\nFound function `sklearn/datasets/_base.py:_sha256`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1144 | def _sha256(path):\n1145 |     \"\"\"Calculate the sha256 hash of the file at path.\"\"\"\n1146 |     sha256hash = hashlib.sha256()\n1147 |     chunk_size = 8192\n1148 |     with open(path, \"rb\") as f:\n1149 |         while True:\n1150 |             buffer = f.read(chunk_size)\n1151 |             if not buffer:\n1152 |                 break\n1153 |             sha256hash.upda