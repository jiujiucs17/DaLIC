parately:\n2938 |             # We need this because some estimators validate X and y\n2939 |             # separately, and in general, separately calling check_array()\n2940 |             # on X and y isn't equivalent to just calling check_X_y()\n2941 |             # :(\n2942 |             check_X_params, check_y_params = validate_separately\n2943 |             if \"estimator\" not in check_X_params:\n2944 |                 check_X_params = {**default_check_params, **check_X_params}\n2945 |             X = check_array(X, input_name=\"X\", **check_X_params)\n2946 |             if \"estimator\" not in check_y_params:\n2947 |                 check_y_params = {**default_check_params, **check_y_params}\n2948 |             y = check_array(y, input_name=\"y\", **check_y_params)\n2949 |         else:\n2950 |             X, y = check_X_y(X, y, **check_params)\n2951 |         out = X, y\n2952 | \n2953 |     if not no_val_X and check_params.get(\"ensure_2d\", True):\n2954 |         _check_n_features(_estimator, X, reset=reset)\n2955 | \n2956 |     return out\n```\n\nFound function `sklearn/datasets/__init__.py:__getattr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n109 | def __getattr__(name):\n110 |     if name == \"load_boston\":\n111 |         msg = textwrap.dedent(\n112 |             \"\"\"\n113 |             `load_boston` has been removed from scikit-learn since version 1.2.\n114 | \n115 |             The Boston housing prices dataset has an ethical problem: as\n116 |             investigated in [1], the authors of this dataset engineered a\n117 |             non-invertible variable \"B\" assuming that racial self-segregation had a\n118 |             positive impact on house prices [2]. Furthermore the goal of the\n119 |             research that led to the creation of this dataset was to study the\n120 |             impact of air quality but it did not give adequate demonstration of the\n121 |             validity of this assumption.\n122 | \n123 |             The scikit-learn maintainers therefore strongly discourage the use of\n124 |             this dataset unless the purpose of the code is to study and educate\n125 |             about ethical issues in data science and machine learning.\n126 | \n127 |             In this special case, you can fetch the dataset from the original\n128 |             source::\n129 | \n130 |                 import pandas as pd\n131 |                 import numpy as np\n132 | \n133 |                 data_url = \"http://lib.stat.cmu.edu/datasets/boston\"\n134 |                 raw_df = pd.read_csv(data_url, sep=\"\\\\s+\", skiprows=22, header=None)\n135 |                 data = np.hstack([raw_df.values[::2, :], raw_df.values[1::2, :2]])\n136 |                 target = raw_df.values[1::2, 2]\n137 | \n138 |             Alternative datasets include the California housing dataset and the\n139 |             Ames housing dataset. You can load the datasets as follows::\n140 | \n141 |                 from sklearn.datasets import fetch_california_housing\n142 |                 housing = fetch_california_housing()\n143 | \n144 |             for the California housing dataset and::\n145 | \n146 |                 from sklearn.datasets import fetch_openml\n147 |                 housing = fetch_openml(name=\"house_prices\", as_frame=True)\n148 | \n149 |             for the Ames housing dataset.\n150 | \n151 |             [1] M Carlisle.\n152 |             \"Racist data destruction?\"\n153 |             <https://medium.com/@docintangible/racist-data-destruction-113e3eff54a8>\n154 | \n155 |             [2] Harrison Jr, David, and Daniel L. Rubinfeld.\n156 |             \"Hedonic housing prices and the demand for clean air.\"\n157 |             Journal of environmental economics and management 5.1 (1978): 81-102.\n158 |             <https://www.researchgate.net/publication/4974606_Hedonic_housing_prices_and_the_demand_for_clean_air>\n159 |             \"\"\"\n160 |         )\n161 |         raise ImportError(msg)\n162 |     try:\n163 |         return globals()[name]\n164 |     except KeyError:\n165 |         # This is turned into the appropriate ImportError\n166 |         raise AttributeError\n```\n\n\n\n##Searching for term \"_more_tags\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/__init__.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Utilities to load popular datasets and artificial data generators.\"\"\"\n  2 | \n  3 | # Authors: The scikit-learn developers\n  4 | # SPDX-License-Identifier: BSD-3-Clause\n  5 | \n  6 | import textwrap\n  7 | \n  8 | from ._base import (\n  9 |     clear_data_home,\n 10 |     fetch_file,\n 11 |     get_data_home,\n 12 |     load_breast_cancer,\n 13 |     load_diabetes,\n 14 |     load_digits,\n 15 |     load_files,\n 16 |     load_iris,\n 17 |     load_linnerud,\n 18 |     load_sample_image,\n 19 |     load_sample_images,\n 20 |     load_wine,\n 21 | )\n 22 | from ._california_housing import fetch_california_housing\n 23 | from ._covtype import fetch_covtype\n 24 | from ._kddcup99 import fetch_kddcup99\n 25 | from ._lfw import fetch_lfw_pairs, fetch_lfw_people\n 26 | from ._olivetti_faces import fetch_olivetti_faces\n 27 | from ._openml import fetch_openml\n 28 | from ._rcv1 import fetch_rcv1\n 29 | from ._samples_generator import (\n 30 |     make_biclusters,\n 31 |     make_blobs,\n 32 |     make_checkerboard,\n 33 |     make_circles,\n 34 |     make_classification,\n 35 |     make_friedman1,\n 36 |     make_friedman2,\n 37 |     make_friedman3,\n 38 |     make_gaussian_quantiles,\n 39 |     make_hastie_10_2,\n 40 |     make_low_rank_matrix,\n 41 |     make_moons,\n 42 |     make_multilabel_classification,\n 43 |     make_regression,\n 44 |     make_s_curve,\n 45 |     make_sparse_coded_signal,\n 46 |     make_sparse_spd_matrix,\n 47 |     make_sparse_uncorrelated,\n 48 |     make_spd_matrix,\n 49 |     make_swiss_roll,\n 50 | )\n 51 | from ._species_dist