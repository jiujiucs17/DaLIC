ned axis object:\n164 |         - if only one subplot is constructed (nrows=ncols=1), the resulting\n165 |         single Axis object is returned as a scalar.\n166 |         - for Nx1 or 1xN subplots, the returned object is a 1-d numpy object\n167 |         array of Axis objects are returned as numpy 1-d arrays.\n168 |         - for NxM subplots with N>1 and M>1 are returned as a 2d array.\n169 | \n170 |       If False, no squeezing is done: the returned axis object is always\n171 |       a 2-d array containing Axis instances, even if it ends up being 1x1.\n172 | \n173 |     subplot_kw : dict\n174 |       Dict with keywords passed to the add_subplot() call used to create each\n175 |       subplots.\n176 | \n177 |     ax : Matplotlib axis object, optional\n178 | \n179 |     layout : tuple\n180 |       Number of rows and columns of the subplot grid.\n181 |       If not specified, calculated from naxes and layout_type\n182 | \n183 |     layout_type : {'box', 'horizontal', 'vertical'}, default 'box'\n184 |       Specify how to layout the subplot grid.\n185 | \n186 |     fig_kw : Other keyword arguments to be passed to the figure() call.\n187 |         Note that all keywords not recognized above will be\n188 |         automatically included here.\n189 | \n190 |     Returns\n191 |     -------\n192 |     fig, ax : tuple\n193 |       - fig is the Matplotlib Figure object\n194 |       - ax can be either a single axis object or an array of axis objects if\n195 |       more than one subplot was created.  The dimensions of the resulting array\n196 |       can be controlled with the squeeze keyword, see above.\n197 | \n198 |     Examples\n199 |     --------\n200 |     x = np.linspace(0, 2*np.pi, 400)\n201 |     y = np.sin(x**2)\n202 | \n203 |     # Just a figure and one subplot\n204 |     f, ax = plt.subplots()\n205 |     ax.plot(x, y)\n206 |     ax.set_title('Simple plot')\n207 | \n208 |     # Two subplots, unpack the output array immediately\n209 |     f, (ax1, ax2) = plt.subplots(1, 2, sharey=True)\n210 |     ax1.plot(x, y)\n211 |     ax1.set_title('Sharing Y axis')\n212 |     ax2.scatter(x, y)\n213 | \n214 |     # Four polar axes\n215 |     plt.subplots(2, 2, subplot_kw=dict(polar=True))\n216 |     \"\"\"\n217 |     import matplotlib.pyplot as plt\n218 | \n219 |     if subplot_kw is None:\n220 |         subplot_kw = {}\n221 | \n222 |     if ax is None:\n223 |         fig = plt.figure(**fig_kw)\n224 |     else:\n225 |         if is_list_like(ax):\n226 |             if squeeze:\n227 |                 ax = flatten_axes(ax)\n228 |             if layout is not None:\n229 |                 warnings.warn(\n230 |                     \"When passing multiple axes, layout keyword is ignored.\",\n231 |                     UserWarning,\n232 |                 )\n233 |             if sharex or sharey:\n234 |                 warnings.warn(\n235 |                     \"When passing multiple axes, sharex and sharey \"\n236 |                     \"are ignored. These settings must be specified when creating axes.\",\n237 |                     UserWarning,\n238 |                     stacklevel=find_stack_level(),\n239 |                 )\n240 |             if ax.size == naxes:\n241 |                 fig = ax.flat[0].get_figure()\n242 |                 return fig, ax\n243 |             else:\n244 |                 raise ValueError(\n245 |                     f\"The number of passed axes must be {naxes}, the \"\n246 |                     \"same as the output plot\"\n247 |                 )\n248 | \n249 |         fig = ax.get_figure()\n250 |         # if ax is passed and a number of subplots is 1, return ax as it is\n251 |         if naxes == 1:\n252 |             if squeeze:\n253 |                 return fig, ax\n254 |             else:\n255 |                 return fig, flatten_axes(ax)\n256 |         else:\n257 |             warnings.warn(\n258 |                 \"To output multiple subplots, the figure containing \"\n259 |                 \"the passed axes is being cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sharex:\n276 |         subplot_kw[\"sharex\"] = ax0\n277 |     if sharey:\n278 |         subplot_kw[\"sharey\"] = ax0\n279 |     axarr[0] = ax0\n280 | \n281 |     # Note off-by-one counting because add_subplot uses the MATLAB 1-based\n282 |     # convention.\n283 |     for i in range(1, nplots):\n284 |         kwds = subplot_kw.copy()\n285 |         # Set sharex and sharey to None for blank/dummy axes, these can\n286 |         # interfere with proper axis limits on the visible axes if\n287 |         # they share axes e.g. issue #7528\n288 |         if i >= naxes:\n289 |             kwds[\"sharex\"] = None\n290 |             kwds[\"sharey\"] = None\n291 |         ax = fig.add_subplot(nrows, ncols, i + 1, **kwds)\n292 |         axarr[i] = ax\n293 | \n294 |     if naxes != nplots:\n295 |         for ax in axarr[naxes:]:\n296 |             ax.set_visible(False)\n297 | \n298 |     handle_shared_axes(axarr, nplots, naxes, nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 |             axes = axarr.reshape(nrows, ncols).squeeze()\n308 |     else:\n309 |         # returned axis array will be always 2-d, even if nrows=ncols=1\n310 |         axes = axarr.reshape(nrows, ncols)\n311 | \n312 |     return fig, axes\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |         return (1, nplots)\n112 |     elif layout_type == \"vertical\":\n113 |         return (nplots, 1)\n114 | \n115 |     layouts = {1: (1, 1), 2: (1, 2), 3: (2, 2), 4: (2, 2)}\n116 |     try:\n117 |         return layouts[nplots]\n118 |     except KeyError:\n119 |         k = 1\n120 |         while k**2 < nplots:\n121 |             k += 1\n122 | \n123 |         if (k - 1) * k >= nplots:\n124 |             return k, (k - 1)\n125 |         else:\n126 |             return k, k\n```\n\n\n\n##Searching for term \"DataFrame.plot plot.subplots\"...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PlotAccessor(PandasObject):\n\n    _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n    _series_kinds = (\"pie\",)\n    _dataframe_kinds = (\"scatter\", \"hexbin\")\n    _kind_aliases = {\"density\": \"kde\"}\n    _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n\n    def __init__(self, data) -> None:\n...\n    @staticmethod\n    def _get_call_args(backend_name, data, args, kwargs):\n...\n    def __call__(self, *args, **kwargs):\n...\n    __call__.__doc__ = __doc__\n\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n\n        Examples\n        --------\n\n        .. plot::\n            :context: close-figs\n\n            >>> s = pd.Series([1, 3, 2])\n            >>> s.plot.line()\n            <AxesSubplot:ylabel='Density'>\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the populations for some animals\n            over the years.\n\n            >>> df = pd.DataFrame({\n            ...    'pig': [20, 18, 489, 675, 1776],\n            ...    'horse': [4, 25, 281, 600, 1900]\n            ...    }, index=[1990, 1997, 2003, 2009, 2014])\n            >>> lines = df.plot.line()\n\n        .. plot::\n           :context: close-figs\n\n           An example with subplots, so an array of axes is returned.\n\n           >>> axes = df.plot.line(subplots=True)\n           >>> type(axes)\n           <class 'numpy.ndarray'>\n\n        .. plot::\n           :context: close-figs\n\n           Let's repeat the same example, but specifying colors for\n           each column (in this case, for each animal).\n\n           >>> axes = df.plot.line(\n           ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n           ... )\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the relationship between both\n            populations.\n\n            >>> lines = df.plot.line(x='pig', y='horse')\n        \"\"\"\n    )\n    @Substitution(kind=\"line\")\n    @Appender(_bar_or_line_doc)\n    def line(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.barh : Horizontal bar plot.\n        DataFrame.plot : Make plots of a DataFrame.\n        matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n\n        Examples\n        --------\n        Basic plot.\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n            >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n\n        Plot a whole dataframe to a bar plot. Each column is assigned a\n        distinct color, and each row is nested in a group along the\n        horizontal axis.\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.bar(rot=0)\n\n        Plot stacked bar charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(stacked=True)\n\n        Instead of nesting, the figure can be split by column with\n        ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n        :class:`matplotlib.axes.Axes` are returned.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(rot=0, subplots=True)\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        If you don't like the default colours, you can specify how you'd\n        like each column to be colored.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(\n            ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n            ... )\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        Plot a single column.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(y='speed', rot=0)\n\n        Plot only selected categories for the DataFrame.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(x='lifespan', rot=0)\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def bar(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.bar: Vertical bar plot.\n        DataFrame.plot : Make plots of DataFrame using matplotlib.\n        matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n\n        Examples\n        --------\n        Basic example\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n            >>> ax = df.plot.barh(x='lab', y='val')\n\n        Plot a whole DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh(