 entity name `plot`.\n```\n 44 | def plot(self, left, right, labels=None, vertical: bool = True):\n 45 |         \"\"\"\n 46 |         Plot left / right DataFrames in specified layout.\n 47 | \n 48 |         Parameters\n 49 |         ----------\n 50 |         left : list of DataFrames before operation is applied\n 51 |         right : DataFrame of operation result\n 52 |         labels : list of str to be drawn as titles of left DataFrames\n 53 |         vertical : bool, default True\n 54 |             If True, use vertical layout. If False, use horizontal layout.\n 55 |         \"\"\"\n 56 |         import matplotlib.gridspec as gridspec\n 57 |         import matplotlib.pyplot as plt\n 58 | \n 59 |         if not isinstance(left, list):\n 60 |             left = [left]\n 61 |         left = [self._conv(df) for df in left]\n 62 |         right = self._conv(right)\n 63 | \n 64 |         hcells, vcells = self._get_cells(left, right, vertical)\n 65 | \n 66 |         if vertical:\n 67 |             figsize = self.cell_width * hcells, self.cell_height * vcells\n 68 |         else:\n 69 |             # include margin for titles\n 70 |             figsize = self.cell_width * hcells, self.cell_height * vcells\n 71 |         fig = plt.figure(figsize=figsize)\n 72 | \n 73 |         if vertical:\n 74 |             gs = gridspec.GridSpec(len(left), hcells)\n 75 |             # left\n 76 |             max_left_cols = max(self._shape(df)[1] for df in left)\n 77 |             max_left_rows = max(self._shape(df)[0] for df in left)\n 78 |             for i, (l, label) in enumerate(zip(left, labels)):\n 79 |                 ax = fig.add_subplot(gs[i, 0:max_left_cols])\n 80 |                 self._make_table(ax, l, title=label, height=1.0 / max_left_rows)\n 81 |             # right\n 82 |             ax = plt.subplot(gs[:, max_left_cols:])\n 83 |             self._make_table(ax, right, title=\"Result\", height=1.05 / vcells)\n 84 |             fig.subplots_adjust(top=0.9, bottom=0.05, left=0.05, right=0.95)\n 85 |         else:\n 86 |             max_rows = max(self._shape(df)[0] for df in left + [right])\n 87 |             height = 1.0 / np.max(max_rows)\n 88 |             gs = gridspec.GridSpec(1, hcells)\n 89 |             # left\n 90 |             i = 0\n 91 |             for df, label in zip(left, labels):\n 92 |                 sp = self._shape(df)\n 93 |                 ax = fig.add_subplot(gs[0, i : i + sp[1]])\n 94 |                 self._make_table(ax, df, title=label, height=height)\n 95 |                 i += sp[1]\n 96 |             # right\n 97 |             ax = plt.subplot(gs[0, i:])\n 98 |             self._make_table(ax, right, title=\"Result\", height=height)\n 99 |             fig.subplots_adjust(top=0.85, bottom=0.05, left=0.05, right=0.95)\n100 | \n101 |         return fig\n```\n\nFound function `pandas/core/frame.py:DataFrame.T`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3468 | def T(self) -> DataFrame:\n3469 |         return self.transpose()\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.barh`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1207 | def barh(self, x=None, y=None, **kwargs):\n1208 |         \"\"\"\n1209 |         Make a horizontal bar plot.\n1210 | \n1211 |         A horizontal bar plot is a plot that presents quantitative data with\n1212 |         rectangular bars with lengths proportional to the values that they\n1213 |         represent. A bar plot shows comparisons among discrete categories. One\n1214 |         axis of the plot shows the specific categories being compared, and the\n1215 |         other axis represents a measured value.\n1216 |         \"\"\"\n1217 |         return self(kind=\"barh\", x=x, y=y, **kwargs)\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.box`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1219 | def box(self, by=None, **kwargs):\n1220 |         r\"\"\"\n1221 |         Make a box plot of the DataFrame columns.\n1222 | \n1223 |         A box plot is a method for graphically depicting groups of numerical\n1224 |         data through their quartiles.\n1225 |         The box extends from the Q1 to Q3 quartile values of the data,\n1226 |         with a line at the median (Q2). The whiskers extend from the edges\n1227 |         of box to show the range of the data. The position of the whiskers\n1228 |         is set by default to 1.5*IQR (IQR = Q3 - Q1) from the edges of the\n1229 |         box. Outlier points are those past the end of the whiskers.\n1230 | \n1231 |         For further details see Wikipedia's\n1232 |         entry for `boxplot <https://en.wikipedia.org/wiki/Box_plot>`__.\n1233 | \n1234 |         A consideration when using this chart is that the box and the whiskers\n1235 |         can overlap, which is very common when plotting small sets of data.\n1236 | \n1237 |         Parameters\n1238 |         ----------\n1239 |         by : str or sequence\n1240 |             Column in the DataFrame to group by.\n1241 | \n1242 |             .. versionchanged:: 1.4.0\n1243 | \n1244 |                Previously, `by` is silently ignore and makes no groupings\n1245 | \n1246 |         **kwargs\n1247 |             Additional keywords are documented in\n1248 |             :meth:`DataFrame.plot`.\n1249 | \n1250 |         Returns\n1251 |         -------\n1252 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1253 | \n1254 |         See Also\n1255 |         --------\n1256 |         DataFrame.boxplot: Another method to draw a box plot.\n1257 |         Series.plot.box: Draw a box plot from a Series object.\n1258 |         matplotlib.pyplot.boxplot: Draw a box plot in matplotlib.\n1259 | \n1260 |         Examples\n1261 |         --------\n1262 |         Draw a box plot from a DataFrame with four columns of randomly\n1263 |         generated data.\n1264 | \n1265 |         .. plot::\n1266 |             :context: close-figs\n1267 | \n1268 |             >>> data = np.random.randn(25, 4)\n1269 |             >>> df = pd.DataFrame(data, columns=list('ABCD'))\n1270 |             >>> ax = df.plot.box()\n1271 | \n1272 |         You can also generate groupings if you specify the `by` parameter (which\n1273 |         can take a column name, or a list or tuple of column names):\n1274 | \n1275 |         .. versionchanged:: 1.4.0\n1276 | \n1277 |         .. plot::\n1278 |             :context: close-figs\n1279 | \n1280 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1281 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1282 |             >>> ax = df.plot.box(column=\"age\", by=\"gender\", figsize=(10, 8))\n1283 |         \"\"\"\n1284 |         return self(kind=\"box\", by=by, **kwargs)\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.area`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1458 | def area(self, x=None, y=None, **kwargs):\n1459 |         \"\"\"\n1460 |         Draw a stacked area plot.\n1461 | \n1462 |         An area plot displays quantitative data visually.\n1463 |         This function wraps the matplotlib area function.\n1464 | \n1465 |         Parameters\n1466 |         ----------\n1467 |         x : label or position, optional\n1468 |             Coordinates for the X axis. By default uses the index.\n1469 |         y : label or position, optional\n1470 |             Column to plot. By default uses all columns.\n1471 |         stacked : bool, default True\n1472 |             Area plots are stacked by default. Set to False to create a\n1473 |             unstacked plot.\n1474 |         **kwargs\n1475 |             Additional keyword arguments are documented in\n1476 |             :meth:`DataFrame.plot`.\n1477 | \n1478 |         Returns\n1479 |         -------\n1480 |         matplotlib.axes.Axes or numpy.ndarray\n1481 |             Area plot, or array of area plots if subplots is True.\n1482 | \n1483 |         See Also\n1484 |         --------\n1485 |         DataFrame.plot : Make plots of DataFrame using matplotlib / pylab.\n1486 | \n1487 |         Examples\n1488 |         --------\n1489 |         Draw an area plot based on basic business metrics:\n1490 | \n1491 |         .. plot::\n1492 |             :context: close-figs\n1493 | \n1494 |             >>> df = pd.DataFrame({\n1495 |             ...     'sales': [3, 2, 3, 9, 10, 6],\n1496 |             ...     'signups': [5, 5, 6, 12, 14, 13],\n1497 |             ...     'visits': [20, 42, 28, 62, 81, 50],\n1498 |             ... }, index=pd.date_range(start='2018/01/01', end='2018/07/01',\n1499 |             ...                        freq='M'))\n1500 |             >>> ax = df.plot.area()\n1501 | \n1502 |         Area plots are stacked by default. To produce an unstacked plot,\n1503 |         pass ``stacked=False``:\n1504 | \n1505 |         .. plot::\n1506 |             :context: close-figs\n1507 | \n1508 |             >>> ax = df.plot.area(stacked=False)\n1509 | \n1510 |         Draw an area plot for a single column:\n1511 | \n1512 |         .. plot::\n1513 |             :context: close-figs\n1514 | \n1515 |             >>> ax = df.plot.area(y='sales')\n1516 | \n1517 |         Draw with a different `x`:\n1518 | \n1519 |         .. plot::\n1520 |             :context: close-figs\n1521 | \n1522 |             >>> df = pd.DataFrame({\n1523 |             ...     'sales': [3, 2, 3],\n1524 |             ...     'visits': [20, 42, 28],\n1525 |             ...     'day': [1, 2, 3],\n1526 |             ... })\n1527 |             >>> ax = df.plot.area(x='day')\n1528 |         \"\"\"\n1529 |         return self(kind=\"area\", x=x, y=y, **kwargs)\n```\n\nFound file `pandas/core/exchange/dataframe.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `pandas/core/exchange/dataframe.py` for the full content if needed.\n\n\n\n##Searching for term \"DataFrame.plot\", \"plot.subplots\", \"DataFrame.plot plot.subplots\"...\n### Search Result:\nFound function `pandas/plotting/_matplotlib/__init__.py:plot`.\nSource: Match found for entity name `plot`.\n```\n58 | def plot(data, kind, **kwargs):\n59 |     # Importing pyplot at the top of the file (before the converters are\n60 |     # registered) causes problems in matplotlib 2 (converters seem to not\n61 |     # work)\n62 |     import matplotlib.pyplot as plt\n63 | \n64 |     if kwargs.pop(\"reuse_plot\", False):\n65 |         ax = kwargs.get(\"ax\")\n66 |         if ax is None and len(plt.get_fignums()) > 0:\n67 |             with plt.rc_context():\n68 |                 ax = plt.gca()\n69 |             kwargs[\"ax\"] = getattr(ax, \"left_ax\", ax)\n70 |     plot_obj = PLOT_CLASSES[kind](data, **kwargs)\n71 |     plot_obj.generate()\n72 |     plot_obj.draw()\n73 |     return plot_obj.result\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.pie`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1531 | def pie(self, **kwargs):\n1532 |         \"\"\"\n1533 |         Generate a pie plot.\n1534 | \n1535 |         A pie plot is a proportional representation of the numerical data in a\n1536 |         column. This function wraps :meth:`matplotlib.pyplot.pie` for the\n1537 |         specified column. If no column reference is passed and\n1538 |         ``subplots=True`` a pie plot is drawn for each numerical column\n1539 |         independently.\n1540 | \n1541 |         Parameters\n1542 |         ----------\n1543 |         y : int or label, optional\n1544 |             Label or position of the column to plot.\n1545 |             If not provided, ``subplots=True`` argument must be passed.\n1546 |         **kwargs\n1547 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1548 | \n1549 |         Returns\n1550 |         -------\n1551 |         matplotlib.axes.Axes or np.ndarray of them\n1552 |             A NumPy array is returned when `subplots` is True.\n1553 | \n1554 |         See Also\n1555 |         --------\n1556 |         Series.plot.pie : Generate a pie plot for a Series.\n1557 |         DataFrame.plot : Make plots of a DataFrame.\n1558 | \n1559 |         Examples\n1560 |         --------\n1561 |         In the example below we have a DataFrame with the information about\n1562 |         planet's mass and radius. We pass the 'mass' column to the\n1563 |         pie function to get a pie plot.\n1564 | \n1565 |         .. plot::\n1566 |             :context: close-figs\n1567 | \n1568 |             >>> df = pd.DataFrame({'mass': [0.330, 4.87 , 5.97],\n1569 |             ...                    'radius': [2439.7, 6051.8, 6378.1]},\n1570 |             ...                   index=['Mercury', 'Venus', 'Earth'])\n1571 |             >>> plot = df.plot.pie(y='mass', figsize=(5, 5))\n1572 | \n1573 |         .. plot::\n1574 |             :context: close-figs\n1575 | \n1576 |             >>> plot = df.plot.pie(subplots=True, figsize=(11, 6))\n1577 |         \"\"\"\n1578 |         if (\n1579 |             isinstance(self._parent, ABCDataFrame)\n1580 |             and kwargs.get(\"y\", None) is None\n1581 |             and not kwargs.get(\"subplots\", False)\n1582 |         ):\n1583 |             raise ValueError(\"pie requires either y column or 'subplots=True'\")\n1584 |         return self(kind=\"pie\", **kwargs)\n```\n\nFound file `pandas/plotting/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `pandas/plotting/__init__.py` for the full content if needed.\n\n\n\n##Searching for term \"DataFrame.plot\", \"DataFrame.plot plot.subplots\"...\n### Search Result:\nFound function `pandas/plotting/_core.py:PlotAccessor.bar`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1121 | def bar(self, x=None, y=None, **kwargs):\n1122 |         \"\"\"\n1123 |         Vertical bar plot.\n1124 | \n1125 |         A bar plot is a plot that presents categorical data with\n1126 |         rectangular bars with lengths proportional to the values that they\n1127 |         represent. A bar plot shows comparisons among discrete categories. One\n1128 |         axis of the plot shows the specific categories being compared, and the\n1129 |         other axis represents a measured value.\n1130 |         \"\"\"\n1131 |         return self(kind=\"bar\", x=x, y=y, **kwargs)\n```\n\n\n\n##Searching for term \"plot.subplots\", \"DataFrame.plot plot.subplots\"...\n### Search Result:\nFound function `pandas/plotting/_core.py:boxplot_frame_groupby`.\nSource: Retrieved code content using keyword search (bm25).\n```\n526 | def boxplot_frame_groupby(\n527 |     grouped,\n528 |     subplots=True,\n529 |     column=None,\n530 |     fontsize=None,\n531 |     rot=0,\n532 |     grid=True,\n533 |     ax=None,\n534 |     figsize=None,\n535 |     layout=None,\n536 |     sharex=False,\n537 |     sharey=True,\n538 |     backend=None,\n539 |     **kwargs,\n540 | ):\n541 |     \"\"\"\n542 |     Make box plots from DataFrameGroupBy data.\n543 | \n544 |     Parameters\n545 |     ----------\n546 |     grouped : Grouped DataFrame\n547 |     subplots : bool\n548 |         * ``False`` - no subplots will be used\n549 |         * ``True`` - create a subplot for each group.\n550 | \n551 |     column : column name or list of names, or vector\n552 |         Can be any valid input to groupby.\n553 |     fontsize : int or str\n554 |     rot : label rotation angle\n555 |     grid : Setting this to True will show the grid\n556 |     ax : Matplotlib axis object, default None\n557 |     figsize : A tuple (width, height) in inches\n558 |     layout : tuple (optional)\n559 |         The layout of the plot: (rows, columns).\n560 |     sharex : bool, default False\n561 |         Whether x-axes will be shared among subplots.\n562 |     sharey : bool, default True\n563 |         Whether y-axes will be shared among subplots.\n564 |     backend : str, default None\n565 |         Backend to use instead of the backend specified in the option\n566 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n567 |         specify the ``plotting.backend`` for the whole session, set\n568 |         ``pd.options.plotting.backend``.\n569 | \n570 |         .. versionadded:: 1.0.0\n571 | \n572 |     **kwargs\n573 |         All other plotting keyword arguments to be passed to\n574 |         matplotlib's boxplot function.\n575 | \n576 |     Returns\n577 |     -------\n578 |     dict of key/value = group key/DataFrame.boxplot return value\n579 |     or DataFrame.boxplot return value in case subplots=figures=False\n580 | \n581 |     Examples\n582 |     --------\n583 |     You can create boxplots for grouped data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **