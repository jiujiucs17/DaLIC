np.array([[0, 1], [-1, 0]]) # matrix equiv. of the imaginary unit\n591 |     >>> matrix_power(i, 3) # should = -i\n592 |     array([[ 0, -1],\n593 |            [ 1,  0]])\n594 |     >>> matrix_power(i, 0)\n595 |     array([[1, 0],\n596 |            [0, 1]])\n597 |     >>> matrix_power(i, -3) # should = 1/(-i) = i, but w/ f.p. elements\n598 |     array([[ 0.,  1.],\n599 |            [-1.,  0.]])\n600 | \n601 |     Somewhat more sophisticated example\n602 | \n603 |     >>> q = np.zeros((4, 4))\n604 |     >>> q[0:2, 0:2] = -i\n605 |     >>> q[2:4, 2:4] = i\n606 |     >>> q # one of the three quaternion units not equal to 1\n607 |     array([[ 0., -1.,  0.,  0.],\n608 |            [ 1.,  0.,  0.,  0.],\n609 |            [ 0.,  0.,  0.,  1.],\n610 |            [ 0.,  0., -1.,  0.]])\n611 |     >>> matrix_power(q, 2) # = -np.eye(4)\n612 |     array([[-1.,  0.,  0.,  0.],\n613 |            [ 0., -1.,  0.,  0.],\n614 |            [ 0.,  0., -1.,  0.],\n615 |            [ 0.,  0.,  0., -1.]])\n616 | \n617 |     \"\"\"\n618 |     a = asanyarray(a)\n619 |     _assert_stacked_2d(a)\n620 |     _assert_stacked_square(a)\n621 | \n622 |     try:\n623 |         n = operator.index(n)\n624 |     except TypeError as e:\n625 |         raise TypeError(\"exponent must be an integer\") from e\n626 | \n627 |     # Fall back on dot for object arrays. Object arrays are not supported by\n628 |     # the current implementation of matmul using einsum\n629 |     if a.dtype != object:\n630 |         fmatmul = matmul\n631 |     elif a.ndim == 2:\n632 |         fmatmul = dot\n633 |     else:\n634 |         raise NotImplementedError(\n635 |             \"matrix_power not supported for stacks of object arrays\")\n636 | \n637 |     if n == 0:\n638 |         a = empty_like(a)\n639 |         a[...] = eye(a.shape[-2], dtype=a.dtype)\n640 |         return a\n641 | \n642 |     elif n < 0:\n643 |         a = inv(a)\n644 |         n = abs(n)\n645 | \n646 |     # short-cuts.\n647 |     if n == 1:\n648 |         return a\n649 | \n650 |     elif n == 2:\n651 |         return fmatmul(a, a)\n652 | \n653 |     elif n == 3:\n654 |         return fmatmul(fmatmul(a, a), a)\n655 | \n656 |     # Use binary decomposition to reduce the number of matrix multiplications.\n657 |     # Here, we iterate over the bits of n, from LSB to MSB, raise `a` to\n658 |     # increasing powers of 2, and multiply into the result as needed.\n659 |     z = result = None\n660 |     while n > 0:\n661 |         z = a if z is None else fmatmul(z, z)\n662 |         n, bit = divmod(n, 2)\n663 |         if bit:\n664 |             result = z if result is None else fmatmul(result, z)\n665 | \n666 |     return result\n```\n\nFound function `numpy/linalg/linalg.py:svd`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1483 | def svd(a, full_matrices=True, compute_uv=True, hermitian=False):\n1484 |     \"\"\"\n1485 |     Singular Value Decomposition.\n1486 | \n1487 |     When `a` is a 2D array, it is factorized as ``u @ np.diag(s) @ vh\n1488 |     = (u * s) @ vh``, where `u` and `vh` are 2D unitary arrays and `s` is a 1D\n1489 |     array of `a`'s singular values. When `a` is higher-dimensional, SVD is\n1490 |     applied in stacked mode as explained below.\n1491 | \n1492 |     Parameters\n1493 |     ----------\n1494 |     a : (..., M, N) array_like\n1495 |         A real or complex array with ``a.ndim >= 2``.\n1496 |     full_matrices : bool, optional\n1497 |         If True (default), `u` and `vh` have the shapes ``(..., M, M)`` and\n1498 |         ``(..., N, N)``, respectively.  Otherwise, the shapes are\n1499 |         ``(..., M, K)`` and ``(..., K, N)``, respectively, where\n1500 |         ``K = min(M, N)``.\n1501 |     compute_uv : bool, optional\n1502 |         Whether or not to compute `u` and `vh` in addition to `s`.  True\n1503 |         by default.\n1504 |     hermitian : bool, optional\n1505 |         If True, `a` is assumed to be Hermitian (symmetric if real-valued),\n1506 |         enabling a more efficient method for finding singular values.\n1507 |         Defaults to False.\n1508 | \n1509 |         .. versionadded:: 1.17.0\n1510 | \n1511 |     Returns\n1512 |     -------\n1513 |     u : { (..., M, M), (..., M, K) } array\n1514 |         Unitary array(s). The first ``a.ndim - 2`` dimensions have the same\n1515 |         size as those of the input `a`. The size of the last two dimensions\n1516 |         depends on the value of `full_matrices`. Only returned when\n1517 |         `compute_uv` is True.\n1518 |     s : (..., K) array\n1519 |         Vector(s) with the singular values, within each vector sorted in\n1520 |         descending order. The first ``a.ndim - 2`` dimensions have the same\n1521 |         size as those of the input `a`.\n1522 |     vh : { (..., N, N), (..., K, N) } array\n1523 |         Unitary array(s). The first ``a.ndim - 2`` dimensions have the same\n1524 |         size as those of the input `a`. The size of the last two dimensions\n1525 |         depends on the value of `full_matrices`. Only returned when\n1526 |         `compute_uv` is True.\n1527 | \n1528 |     Raises\n1529 |     ------\n1530 |     LinAlgError\n1531 |         If SVD computation does not converge.\n1532 | \n1533 |     See Also\n1534 |     --------\n1535 |     scipy.linalg.svd : Similar function in SciPy.\n1536 |     scipy.linalg.svdvals : Compute singular values of a matrix.\n1537 | \n1538 |     Notes\n1539 |     -----\n1540 | \n1541 |     .. versionchanged:: 1.8.0\n1542 |        Broadcasting rules apply, see the `numpy.linalg` documentation for\n1543 |        details.\n1544 | \n1545 |     The decomposition is performed using LAPACK routine ``_gesdd``.\n1546 | \n1547 |     SVD is usually described for the factorization of a 2D matrix :math:`A`.\n1548 |     The higher-dimensional case will be discussed below. In the 2D case, SVD is\n1549 |     written as :math:`A = U S V^H`, where :math:`A = a`, :math:`U= u`,\n1550 |     :math:`S= \\\\mathtt{np.diag}(s)` and :math:`V^H = vh`. The 1D array `s`\n1551 |     contains the singular values of `a` and `u` and `vh` are unitary. The rows\n1552 |     of `vh` are the eigenvectors of :math:`A^H A` and the columns of `u` are\n1553 |     the eigenvectors of :math:`A A^H`. In both cases the corresponding\n1554 |     (possibly non-zero) eigenvalues are given by ``s**2``.\n1555 | \n1556 |     If `a` has more than two dimensions, then broadcasting rules apply, as\n1557 |     explained in :ref:`routines.linalg-broadcasting`. This means that SVD is\n1558 |     working in \"stacked\" mode: it iterates over all indices of the first\n1559 |     ``a.ndim - 2`` dimensions and for each combination SVD is applied to the\n1560 |     last two indices. The matrix `a` can be reconstructed from the\n1561 |     decomposition with either ``(u * s[..., None, :]) @ vh`` or\n1562 |     ``u @ (s[..., None] * vh)``. (The ``@`` operator can be replaced by the\n1563 |     function ``np.matmul`` for python versions below 3.5.)\n1564 | \n1565 |     If `a` is a ``matrix`` object (as opposed to an ``ndarray``), then so are\n1566 |     all the return values.\n1567 | \n1568 |     Examples\n1569 |     --------\n1570 |     >>> a = np.random.randn(9, 6) + 1j*np.random.randn(9, 6)\n1571 |     >>> b = np.random.randn(2, 7, 8, 3) + 1j*np.random.randn(2, 7, 8, 3)\n1572 | \n1573 |     Reconstruction based on full SVD, 2D case:\n1574 | \n1575 |     >>> u, s, vh = np.linalg.svd(a, full_matrices=True)\n1576 |     >>> u.shape, s.shape, vh.shape\n1577 |     ((9, 9), (6,), (6, 6))\n1578 |     >>> np.allclose(a, np.dot(u[:, :6] * s, vh))\n1579 |     True\n1580 |     >>> smat = np.zeros((9, 6), dtype=complex)\n1581 |     >>> smat[:6, :6] = np.diag(s)\n1582 |     >>> np.allclose(a, np.dot(u, np.dot(smat, vh)))\n1583 |     True\n1584 | \n1585 |     Reconstruction based on reduced SVD, 2D case:\n1586 | \n1587 |     >>> u, s, vh = np.linalg.svd(a, full_matrices=False)\n1588 |     >>> u.shape, s.shape, vh.shape\n1589 |     ((9, 6), (6,