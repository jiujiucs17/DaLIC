position/_dict_learning.py:MiniBatchDictionaryLearning._check_convergence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2154 | def _check_convergence(\n2155 |         self, X, batch_cost, new_dict, old_dict, n_samples, step, n_steps\n2156 |     ):\n2157 |         \"\"\"Helper function to encapsulate the early stopping logic.\n2158 | \n2159 |         Early stopping is based on two factors:\n2160 |         - A small change of the dictionary between two minibatch updates. This is\n2161 |           controlled by the tol parameter.\n2162 |         - No more improvement on a smoothed estimate of the objective function for a\n2163 |           a certain number of consecutive minibatch updates. This is controlled by\n2164 |           the max_no_improvement parameter.\n2165 |         \"\"\"\n2166 |         batch_size = X.shape[0]\n2167 | \n2168 |         # counts steps starting from 1 for user friendly verbose mode.\n2169 |         step = step + 1\n2170 | \n2171 |         # Ignore 100 first steps or 1 epoch to avoid initializing the ewa_cost with a\n2172 |         # too bad value\n2173 |         if step <= min(100, n_samples / batch_size):\n2174 |             if self.verbose:\n2175 |                 print(f\"Minibatch step {step}/{n_steps}: mean batch cost: {batch_cost}\")\n2176 |             return False\n2177 | \n2178 |         # Compute an Exponentially Weighted Average of the cost function to\n2179 |         # monitor the convergence while discarding minibatch-local stochastic\n2180 |         # variability: https://en.wikipedia.org/wiki/Moving_average\n2181 |         if self._ewa_cost is None:\n2182 |             self._ewa_cost = batch_cost\n2183 |         else:\n2184 |             alpha = batch_size / (n_samples + 1)\n2185 |             alpha = min(alpha, 1)\n2186 |             self._ewa_cost = self._ewa_cost * (1 - alpha) + batch_cost * alpha\n2187 | \n2188 |         if self.verbose:\n2189 |             print(\n2190 |                 f\"Minibatch step {step}/{n_steps}: mean batch cost: \"\n2191 |                 f\"{batch_cost}, ewa cost: {self._ewa_cost}\"\n2192 |             )\n2193 | \n2194 |         # Early stopping based on change of dictionary\n2195 |         dict_diff = linalg.norm(new_dict - old_dict) / self._n_components\n2196 |         if self.tol > 0 and dict_diff <= self.tol:\n2197 |             if self.verbose:\n2198 |                 print(f\"Converged (small dictionary change) at step {step}/{n_steps}\")\n2199 |             return True\n2200 | \n2201 |         # Early stopping heuristic due to lack of improvement on smoothed\n2202 |         # cost function\n2203 |         if self._ewa_cost_min is None or self._ewa_cost < self._ewa_cost_min:\n2204 |             self._no_improvement = 0\n2205 |             self._ewa_cost_min = self._ewa_cost\n2206 |         else:\n2207 |             self._no_improvement += 1\n2208 | \n2209 |         if (\n2210 |             self.max_no_improvement is not None\n2211 |             and self._no_improvement >= self.max_no_improvement\n2212 |         ):\n2213 |             if self.verbose:\n2214 |                 print(\n2215 |                     \"Converged (lack of improvement in objective function) \"\n2216 |                     f\"at step {step}/{n_steps}\"\n2217 |                 )\n2218 |             return True\n2219 | \n2220 |         return False\n```\n\nFound function `sklearn/cluster/_kmeans.py:MiniBatchKMeans._mini_batch_convergence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1830 | def _mini_batch_convergence(\n1831 |         self, step, n_steps, n_samples, centers_squared_diff, batch_inertia\n1832 |     ):\n1833 |         \"\"\"Helper function to encapsulate the early stopping logic\"\"\"\n1834 |         # Normalize inertia to be able to compare values when\n1835 |         # batch_size changes\n1836 |         batch_inertia /= self._batch_size\n1837 | \n1838 |         # count steps starting from 1 for user friendly verbose mode.\n1839 |         step = step + 1\n1840 | \n1841 |         # Ignore first iteration because it's inertia from initialization.\n1842 |         if step == 1:\n1843 |             if self.verbose:\n1844 |                 print(\n1845 |                     f\"Minibatch step {step}/{n_steps}: mean batch \"\n1846 |                     f\"inertia: {batch_inertia}\"\n1847 |                 )\n1848 |             return False\n1849 | \n1850 |         # Compute an Exponentially Weighted Average of the inertia to\n1851 |         # monitor the convergence while discarding minibatch-local stochastic\n1852 |         # variability: https://en.wikipedia.org/wiki/Moving_average\n1853 |         if self._ewa_inertia is None:\n1854 |             self._ewa_inertia = batch_inertia\n1855 |         else:\n1856 |             alpha = self._batch_size * 2.0 / (n_samples + 1)\n1857 |             alpha = min(alpha, 1)\n1858 |             self._ewa_inertia = self._ewa_inertia * (1 - alpha) + batch_inertia * alpha\n1859 | \n1860 |         # Log progress to be able to monitor convergence\n1861 |         if self.verbose:\n1862 |             print(\n1863 |                 f\"Minibatch step {step}/{n_steps}: mean batch inertia: \"\n1864 |                 f\"{batch_inertia}, ewa inertia: {self._ewa_inertia}\"\n1865 |             )\n1866 | \n1867 |         # Early stopping based on absolute tolerance on squared change of\n1868 |         # centers position\n1869 |         if self._tol > 0.0 and centers_squared_diff <= self._tol:\n1870 |             if self.verbose:\n1871 |                 print(f\"Converged (small centers change) at step {step}/{n_steps}\")\n1872 |             return True\n1873 | \n1874 |         # Early stopping heuristic due to lack of improvement on smoothed\n1875 |         # inertia\n1876 |         if self._ewa_inertia_min is None or self._ewa_inertia < self._ewa_inertia_min:\n1877 |             self._no_improvement = 0\n1878 |             self._ewa_inertia_min = self._ewa_inertia\n187