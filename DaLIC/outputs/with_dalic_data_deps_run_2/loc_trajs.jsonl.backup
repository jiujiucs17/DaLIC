ult:\nFound function `sklearn/feature_extraction/text.py:_VectorizerMixin._check_stop_words_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n374 | def _check_stop_words_consistency(self, stop_words, preprocess, tokenize):\n375 |         \"\"\"Check if stop words are consistent\n376 | \n377 |         Returns\n378 |         -------\n379 |         is_consistent : True if stop words are consistent with the preprocessor\n380 |                         and tokenizer, False if they are not, None if the check\n381 |                         was previously performed, \"error\" if it could not be\n382 |                         performed (e.g. because of the use of a custom\n383 |                         preprocessor / tokenizer)\n384 |         \"\"\"\n385 |         if id(self.stop_words) == getattr(self, \"_stop_words_id\", None):\n386 |             # Stop words are were previously validated\n387 |             return None\n388 | \n389 |         # NB: stop_words is validated, unlike self.stop_words\n390 |         try:\n391 |             inconsistent = set()\n392 |             for w in stop_words or ():\n393 |                 tokens = list(tokenize(preprocess(w)))\n394 |                 for token in tokens:\n395 |                     if token not in stop_words:\n396 |                         inconsistent.add(token)\n397 |             self._stop_words_id = id(self.stop_words)\n398 | \n399 |             if inconsistent:\n400 |                 warnings.warn(\n401 |                     \"Your stop_words may be inconsistent with \"\n402 |                     \"your preprocessing. Tokenizing the stop \"\n403 |                     \"words generated tokens %r not in \"\n404 |                     \"stop_words.\" % sorted(inconsistent)\n405 |                 )\n406 |             return not inconsistent\n407 |         except Exception:\n408 |             # Failed to check stop words consistency (e.g. because a custom\n409 |             # preprocessor or tokenizer w