range(len(x)):\n5227 |                 if bdist[i]:\n5228 |                     Cs_at_i1[i1[i]].append(C[i])\n5229 |                 else:\n5230 |                     Cs_at_i2[i2[i]].append(C[i])\n5231 |             if mincnt is None:\n5232 |                 mincnt = 1\n5233 |             accum = np.array(\n5234 |                 [reduce_C_function(acc) if len(acc) >= mincnt else np.nan\n5235 |                  for Cs_at_i in [Cs_at_i1, Cs_at_i2]\n5236 |                  for acc in Cs_at_i[1:]],  # [1:] drops out-of-range points.\n5237 |                 float)\n5238 | \n5239 |         good_idxs = ~np.isnan(accum)\n5240 | \n5241 |         offsets = np.zeros((n, 2), float)\n5242 |         offsets[:nx1 * ny1, 0] = np.repeat(np.arange(nx1), ny1)\n5243 |         offsets[:nx1 * ny1, 1] = np.tile(np.arange(ny1), nx1)\n5244 |         offsets[nx1 * ny1:, 0] = np.repeat(np.arange(nx2) + 0.5, ny2)\n5245 |         offsets[nx1 * ny1:, 1] = np.tile(np.arange(ny2), nx2) + 0.5\n5246 |         offsets[:, 0] *= sx\n5247 |         offsets[:, 1] *= sy\n5248 |         offsets[:, 0] += xmin\n5249 |         offsets[:, 1] += ymin\n5250 |         # remove accumulation bins with no data\n5251 |         offsets = offsets[good_idxs, :]\n5252 |         accum = accum[good_idxs]\n5253 | \n5254 |         polygon = [sx, sy / 3] * np.array(\n5255 |             [[.5, -.5], [.5, .5], [0., 1.], [-.5, .5], [-.5, -.5], [0., -1.]])\n5256 | \n5257 |         if linewidths is None:\n5258 |             linewidths = [mpl.rcParams['patch.linewidth']]\n5259 | \n5260 |         if xscale == 'log' or yscale == 'log':\n5261 |             polygons = np.expand_dims(polygon, 0)\n5262 |             if xscale == 'log':\n5263 |                 polygons[:, :, 0] = 10.0 ** polygons[:, :, 0]\n5264 |                 xmin = 10.0 ** xmin\n5265 |                 xmax = 10.0 ** xmax\n5266 |                 self.set_xscale(xscale)\n5267 |             if yscale == 'log':\n5268 |                 polygons[:, :, 1] = 10.0 ** polygons[