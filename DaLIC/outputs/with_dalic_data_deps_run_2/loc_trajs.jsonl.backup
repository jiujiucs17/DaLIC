p.ndarray,\n446 |     yvalues: np.ndarray,\n447 |     method: str = \"linear\",\n448 |     limit: int | None = None,\n449 |     limit_direction: str = \"forward\",\n450 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n451 |     fill_value: Any | None = None,\n452 |     bounds_error: bool = False,\n453 |     order: int | None = None,\n454 |     mask=None,\n455 |     **kwargs,\n456 | ) -> None:\n457 |     \"\"\"\n458 |     Logic for the 1-d interpolation.  The input\n459 |     indices and yvalues will each be 1-d arrays of the same length.\n460 | \n461 |     Bounds_error is currently hardcoded to False since non-scipy ones don't\n462 |     take it as an argument.\n463 | \n464 |     Notes\n465 |     -----\n466 |     Fills 'yvalues' in-place.\n467 |     \"\"\"\n468 |     if mask is not None:\n469 |         invalid = mask\n470 |     else:\n471 |         invalid = isna(yvalues)\n472 |     valid = ~invalid\n473 | \n474 |     if not valid.any():\n475 |         return\n476 | \n477 |     if valid.all():\n478 |         return\n479 | \n480 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n481 |     all_nans = np.flatnonzero(invalid)\n482 | \n483 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n484 |     if first_valid_index is None:  # no nan found in start\n485 |         first_valid_index = 0\n486 |     start_nans = np.arange(first_valid_index)\n487 | \n488 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n489 |     if last_valid_index is None:  # no nan found in end\n490 |         last_valid_index = len(yvalues)\n491 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n492 | \n493 |     # preserve_nans contains indices of invalid values,\n494 |     # but in this case, it is the final set of indices that need to be\n495 |     # preserved as NaN after the interpolation.\n496 | \n497 |     # For example if limit_direction='forward' then preserve_nans will\n498 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n499 |     # are more than 'limit' away from the prior non-NaN.\n500 | \n501 |     # set preserve_nans based on direction using _interp_limit\n502 |     if limit_direction == \"forward\":\n503 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n504 |     elif limit_direction == \"backward\":\n505 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n506 |     else:\n507 |         # both directions... just use _interp_limit\n508 |         preserve_nans = np.unique(_interp_limit(invalid, limit, limit))\n509 | \n510 |     # if limit_area is set, add either mid or outside indices\n511 |     # to preserve_nans GH #16284\n512 |     if limit_area == \"inside\":\n513 |         # preserve NaNs on the outside\n514 |         preserve_nans = np.union1d(preserve_nans, start_nans)\n515 |         preserve_nans = np.union1d(preserve_nans, end_nans)\n516 |     elif limit_area == \"outside\":\n517 |         # preserve NaNs on the inside\n518 |         mid_nans = np.setdiff1d(all_nans, start_nans, assume_unique=True)\n519 |         mid_nans = np.setdiff1d(mid_nans, end_nans, assume_unique=True)\n520 |         preserve_nans = np.union1d(preserve_nans, mid_nans)\n521 | \n522 |     is_datetimelike = yvalues.dtype.kind in \"mM\"\n523 | \n524 |     if is_datetimelike:\n525 |         yvalues = yvalues.view(\"i8\")\n526 | \n527 |     if method in NP_METHODS:\n528 |         # np.interp requires sorted X values, #21037\n529 | \n530 |         indexer = np.argsort(indices[valid])\n531 |         yvalues[invalid] = np.interp(\n532 |             indices[invalid], indices[valid][indexer], yvalues[valid][indexer]\n533 |         )\n534 |     else:\n535 |         yvalues[invalid] = _interpolate_scipy_wrapper(\n536 |             indices[valid],\n537 |             yvalues[valid],\n538 |             indices[invalid],\n539 |             method=method,\n540 |             fill_value=fill_value,\n541 |             bounds_error=bounds_error,\n542 |             order=order,\n543 |             **kwargs,\n544 |         )\n545 | \n546 |     if mask is not None:\n547 |         mask[:] = False\n548 |         mask[preserve_nans] = True\n549 |     elif is_datetimelike:\n550 |         yvalues[preserve_nans] = NaT.value\n551 |     else:\n552 |         yvalues[preserve_nans] = np.nan\n553 |     return\n```\n"}, {"content": "Let me also check the resampling-related interpolation since it might provide additional context:\n\n<function=search_code_snippets>\n<parameter=search_terms>['resample', 'interpolate']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"resample\"...\n### Search Result:\nFound file `pandas/core/resample.py`.\nSource: Match found for entity name `resample`.\nJust show the structure of this file due to response length limitations:\n```\n\n\nclass Resampler(BaseGroupBy, PandasObject):\n\n    _grouper: BinGrouper\n    _timegrouper: TimeGrouper\n    binner: DatetimeIndex | TimedeltaIndex | PeriodIndex  # depends on subclass\n    exclusions: frozenset[Hashable] = frozenset()  # for SelectionMixin compat\n    _internal_names_set = set({\"obj\", \"ax\", \"_indexer\"})\n\n    # to the groupby descriptor\n    _attributes = [\n        \"freq\",\n        \"closed\",\n        \"label\",\n        \"convention\",\n        \"origin\",\n        \"offset\",\n    ]\n\n    def __init__(\n        self,\n        obj: NDFrame,\n        timegrouper: TimeGrouper,\n        *,\n        gpr_index: Index,\n        group_keys: bool = False,\n        selection=None,\n        include_groups: bool = True,\n    ) -> None:\n...\n    @final\n    def __str__(self) -> str:\n...\n    @final\n    def __getattr__(self, attr: str):\n...\n    @final\n    @property\n    def _from_selection(self) -> bool:\n...\n    def _convert_obj(self, obj: NDFrameT) -> NDFrameT:\n...\n    def _get_binner_for_time(self):\n...\n    @final\n    def _get_binner(self):\n...\n    @overload\n    def pipe(\n        self,\n        func: Callable[Concatenate[Self, P], T],\n        *args: P.args,\n        **kwargs: P.kwargs,\n    ) -> T:\n...\n    @overload\n    def pipe(\n        self,\n        func: tuple[Callable[..., T], str],\n        *args: Any,\n        **kwargs: Any,\n    ) -> T:\n...\n    @final\n    @Substitution(\n        klass=\"Resampler\",\n        examples=\"\"\"\n    >>> df = pd.DataFrame({'A': [1, 2, 3, 4]},\n    ...                   index=pd.date_range('2012-08-02', periods=4))\n    >>> df\n                A\n    2012-08-02  1\n    2012-08-03  2\n    2012-08-04  3\n    2012-08-05  4\n\n    To get the difference between each 2-day period's maximum and minimum\n    value in one pass, you can do\n\n    >>> df.resample('2D').pipe(lambda x: x.max() - x.min())\n                A\n    2012-08-02  1\n    2012-08-04  1\"\"\",\n    )\n    @Appender(_pipe_template)\n    def pipe(\n        self,\n        func: Callable[Concatenate[Self, P], T] | tuple[Callable[..., T], str],\n        *args: Any,\n        **kwargs: Any,\n    ) -> T:\n...\n    _agg_see_also_doc = dedent(\n        \"\"\"\n    See Also\n    --------\n    DataFrame.groupby.aggregate : Aggregate using callable, string, dict,\n        or list of string/callables.\n    DataFrame.resample.transform : Transforms the Series on each group\n        based on the given function.\n    DataFrame.aggregate: Aggregate using one or more\n        operations over the specified axis.\n    \"\"\"\n    )\n\n    _agg_examples_doc = dedent(\n        \"\"\"\n    Examples\n    --------\n    >>> s = pd.Series([1, 2, 3, 4, 5],\n    ...               index=pd.date_range('20130101', periods=5, freq='s'))\n    >>> s\n    2013-01-01 00:00:00    1\n    2013-01-01 00:00:01    2\n    2013-01-01 00:00:02    3\n    2013-01-01 00:00:03    4\n    2013-01-01 00:00:04    5\n    Freq: s, dtype: int64\n\n    >>> r = s.resample('2s')\n\n    >>> r.agg(\"sum\")\n    2013-01-01 00:00:00    3\n    2013-01-01 00:00:02    7\n    2013-01-01 00:00:04    5\n    Freq: 2s, dtype: int64\n\n    >>> r.agg(['sum', 'mean', 'max'])\n                         sum  mean  max\n    2013-01-01 00:00:00    3   1.5    2\n    2013-01-01 00:00:02    7   3.5    4\n    2013-01-01 00:00:04    5   5.0    5\n\n    >>> r.agg({'result': lambda x: x.mean() / x.std(),\n    ...        'total': \"sum\"})\n                           result  total\n    2013-01-01 00:00:00  2.121320      3\n    2013-01-01 00:00:02  4.949747      7\n    2013-01-01 00:00:04       NaN      5\n\n    >>> r.agg(average=\"mean\", total=\"sum\")\n                             average  total\n    2013-01-01 00:00:00      1.5      3\n    2013-01-01 00:00:02      3.5      7\n    2013-01-01 00:00:04      5.0      5\n    \"\"\"\n    )\n\n    @final\n    @doc(\n        _shared_docs[\"aggregate\"],\n        see_also=_agg_see_also_doc,\n        examples=_agg_examples_doc,\n        klass=\"DataFrame\",\n        axis=\"\",\n    )\n    def aggregate(self, func=None, *args, **kwargs):\n...\n    agg = aggregate\n    apply = aggregate\n\n    @final\n    def transform(self, arg, *args, **kwargs):\n...\n    def _downsample(self, how, **kwargs):\n...\n    def _upsample(self, f, limit: int | None = None, fill_value=None):\n...\n    def _gotitem(self, key, ndim: int, subset=None):\n...\n    def _groupby_and_aggregate(self, how, *args, **kwargs):\n...\n    @final\n    def _get_resampler_for_grouping(\n        self, groupby: GroupBy, key, include_groups: bool = True\n    ):\n...\n    def _wrap_result(self, result):\n...\n    @final\n    def ffill(self, limit: int | None = None):\n...\n    @final\n    def nearest(self, limit: int | None = None):\n...\n    @final\n    def bfill(self, limit: int | None = None):\n...\n    @final\n    def interpolate(\n        self,\n        method: InterpolateOptions = \"linear\",\n        *,\n        axis: Axis = 0,