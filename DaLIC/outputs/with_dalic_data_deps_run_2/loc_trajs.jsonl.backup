|                 random_state=self.random_state,\n1633 |             )\n1634 |         elif self.solver == \"mu\":\n1635 |             W, H, n_iter = _fit_multiplicative_update(\n1636 |                 X,\n1637 |                 W,\n1638 |                 H,\n1639 |                 self._beta_loss,\n1640 |                 self.max_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params