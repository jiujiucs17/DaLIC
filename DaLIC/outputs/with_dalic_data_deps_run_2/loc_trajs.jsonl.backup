features)\n625 |         # change to perplexity later\n626 |         last_bound = None\n627 |         n_jobs = effective_n_jobs(self.n_jobs)\n628 |         with Parallel(n_jobs=n_jobs, verbose=max(0, self.verbose - 1)) as parallel:\n629 |             for i in range(max_iter):\n630 |                 if learning_method == \"online\":\n631 |                     for idx_slice in gen_batches(n_samples, batch_size):\n632 |                         self._em_step(\n633 |                             X[idx_slice, :],\n634 |                             total_samples=n_samples,\n635 |                             batch_update=False,\n636 |                             parallel=parallel,\n637 |                         )\n638 |                 else:\n639 |                     # batch update\n640 |                     self._em_step(\n641 |                         X, total_samples=n_samples, batch_update=True, parallel=parallel\n642 |                     )\n643 | \n644 |                 # check perplexity\n645 |                 if evaluate_every > 0 and (i + 1) % evaluate_every == 0:\n646 |                     doc_topics_distr, _ = self._e_step(\n647 |                         X, cal_sstats=False, random_init=False, parallel=parallel\n648 |                     )\n649 |                     bound = self._perplexity_precomp_distr(\n650 |                         X, doc_topics_distr, sub_sampling=False\n651 |                     )\n652 |                     if self.verbose:\n653 |                         print(\n654 |                             \"iteration: %d of max_iter: %d, perplexity: %.4f\"\n655 |                             % (i + 1, max_iter, bound)\n656 |                         )\n657 | \n658 |                     if last_bound and abs(last_bound - bound) < self.perp_tol:\n659 |                         break\n660 |                     last_bound = bound\n661 | \n662 |                 elif self.verbose:\n663 |                     print(\"iteration: %d of max_iter: %d\" % (i + 1, ma