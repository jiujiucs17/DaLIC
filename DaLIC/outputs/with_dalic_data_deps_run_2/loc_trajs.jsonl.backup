                f\"for an unfilled marker ({marker!r}).  Matplotlib is \"\n4895 |                     \"ignoring the edgecolor in favor of the facecolor.  This \"\n4896 |                     \"behavior may change in the future.\"\n4897 |                 )\n4898 |             # We need to handle markers that cannot be filled (like\n4899 |             # '+' and 'x') differently than markers that can be\n4900 |             # filled, but have their fillstyle set to 'none'.  This is\n4901 |             # to get:\n4902 |             #\n4903 |             #  - respecting the fillestyle if set\n4904 |             #  - maintaining back-compatibility for querying the facecolor of\n4905 |             #    the un-fillable markers.\n4906 |             #\n4907 |             # While not an ideal situation, but is better than the\n4908 |             # alternatives.\n4909 |             if marker_obj.get_fillstyle() == 'none':\n4910 |                 # promote the facecolor to be the edgecolor\n4911 |                 edgecolors = colors\n4912 |                 # set the facecolor to 'none' (at the last chance) because\n4913 |                 # we cannot fill a path if the facecolor is non-null\n4914 |                 # (which is defendable at the renderer level).\n4915 |                 colors = 'none'\n4916 |             else:\n4917 |                 # if we are not nulling the face color we can do this\n4918 |                 # simpler\n4919 |                 edgecolors = 'face'\n4920 | \n4921 |             if linewidths is None:\n4922 |                 linewidths = mpl.rcParams['lines.linewidth']\n4923 |             elif np.iterable(linewidths):\n4924 |                 linewidths = [\n4925 |                     lw if lw is not None else mpl.rcParams['lines.linewidth']\n4926 |                     for lw in linewidths]\n4927 | \n4928 |         offsets = np.ma.column_stack([x, y])\n4929 | \n4930 |         collection = mcoll.PathCollection(\n4931 |             (path,), scales,\n4932 |