e no class weights for the One-Class SVM and they are\n2190 |         # therefore set to 1.\n2191 |         pos_weight = 1\n2192 |         neg_weight = 1\n2193 | \n2194 |         if self.average:\n2195 |             coef = self._standard_coef\n2196 |             intercept = self._standard_intercept\n2197 |             average_coef = self._average_coef\n2198 |             average_intercept = self._average_intercept\n2199 |         else:\n2200 |             coef = self.coef_\n2201 |             intercept = 1 - self.offset_\n2202 |             average_coef = None  # Not used\n2203 |             average_intercept = [0]  # Not used\n2204 | \n2205 |         coef, intercept, average_coef, average_intercept, self.n_iter_ = _plain_sgd(\n2206 |             coef,\n2207 |             intercept[0],\n2208 |             average_coef,\n2209 |             average_intercept[0],\n2210 |             self.loss_function_,\n2211 |             penalty_type,\n2212 |             alpha,\n2213 |             C,\n2214 |             self.l1_ratio,\n2215 |             dataset,\n2216 |             validation_mask,\n2217 |             self.early_stopping,\n2218 |             validation_score_cb,\n2219 |             int(self.n_iter_no_change),\n2220 |             max_iter,\n2221 |             tol,\n2222 |             int(self.fit_intercept),\n2223 |             int(self.verbose),\n2224 |             int(self.shuffle),\n2225 |             seed,\n2226 |             neg_weight,\n2227 |             pos_weight,\n2228 |             learning_rate_type,\n2229 |             self.eta0,\n2230 |             self.power_t,\n2231 |             one_class,\n2232 |             self.t_,\n2233 |             offset_decay,\n2234 |             self.average,\n2235 |         )\n2236 | \n2237 |         self.t_ += self.n_iter_ * n_samples\n2238 | \n2239 |         if self.average > 0:\n2240 | \n2241 |             self._average_intercept = np.atleast_1d(average_intercept)\n2242 |             self._standard_intercept = np.atleast_1d(intercept)\n2243 | \n2244 |             if self.average <= self.t_ - 1.0:\n2245 |                 # made enough updates for averaging to be taken into account\n2246 |                 self.coef_ = average_coef\n2247 |                 self.offset_ = 1 - np.atleast_1d(average_intercept)\n2248 |             else:\n2249 |                 self.coef_ = coef\n2250 |                 self.offset_ = 1 - np.atleast_1d(intercept)\n2251 | \n2252 |         else:\n2253 |             self.offset_ = 1 - np.atleast_1d(intercept)\n```\n\n\n\n##Searching for term \"partial_fit\"...\n### Search Result:\nFound function `sklearn/multiclass.py:OneVsRestClassifier.partial_fit`.\nFound function `sklearn/multiclass.py:OneVsOneClassifier.partial_fit`.\nFound function `sklearn/multioutput.py:_MultiOutputEstimator.partial_fit`.\nFound function `sklearn/multioutput.py:MultiOutputRegressor.partial_fit`.\nFound function `sklearn/naive_bayes.py:GaussianNB.partial_fit`.\nFound function `sklearn/naive_bayes.py:_BaseDiscreteNB.partial_fit`.\nFound function `sklearn/naive_bayes.py:CategoricalNB.partial_fit`.\nFound function `sklearn/cluster/_kmeans.py:MiniBatchKMeans.partial_fit`.\nFound function `sklearn/cluster/_birch.py:Birch.partial_fit`.\nFound function `sklearn/feature_extraction/text.py:HashingVectorizer.partial_fit`.\nFound function `sklearn/linear_model/_passive_aggressive.py:PassiveAggressiveClassifier.partial_fit`.\nFound function `sklearn/linear_model/_passive_aggressive.py:PassiveAggressiveRegressor.partial_fit`.\nFound function `sklearn/linear_model/_stochastic_gradient.py:BaseSGDClassifier.partial_fit`.\nFound function `sklearn/linear_model/_stochastic_gradient.py:BaseSGDRegressor.partial_fit`.\nFound function `sklearn/linear_model/_stochastic_gradient.py:SGDOneClassSVM.partial_fit`.\nFound function `sklearn/neural_network/_rbm.py:BernoulliRBM.partial_fit`.\nFound function `sklearn/neural_network/_multilayer_perceptron.py:BaseMultilayerPerceptron.partial_fit`.\nFound function `sklearn/