stimator(\n117 |         estimator,\n118 |         X,\n119 |         response_method=\"predict_proba\",\n120 |         plot_method=\"pcolormesh\",\n121 |         ax=ax,\n122 |         cmap=\"RdBu\",\n123 |         alpha=0.3,\n124 |     )\n125 |     DecisionBoundaryDisplay.from_estimator(\n126 |         estimator,\n127 |         X,\n128 |         response_method=\"predict_proba\",\n129 |         plot_method=\"contour\",\n130 |         ax=ax,\n131 |         alpha=1.0,\n132 |         levels=[0.5],\n133 |     )\n134 |     y_pred = estimator.predict(X)\n135 |     X_right, y_right = X[y == y_pred], y[y == y_pred]\n136 |     X_wrong, y_wrong = X[y != y_pred], y[y != y_pred]\n137 |     ax.scatter(X_right[:, 0], X_right[:, 1], c=y_right, s=20, cmap=cmap, alpha=0.5)\n138 |     ax.scatter(\n139 |         X_wrong[:, 0],\n140 |         X_wrong[:, 1],\n141 |         c=y_wrong,\n142 |         s=30,\n143 |         cmap=cmap,\n144 |         alpha=0.9,\n145 |         marker=\"x\",\n146 |     )\n147 |     ax.scatter(\n148 |         estimator.means_[:, 0],\n149 |         estimator.means_[:, 1],\n150 |         c=\"yellow\",\n151 |         s=200,\n152 |         marker=\"*\",\n153 |         edgecolor=\"black\",\n154 |     )\n155 | \n156 |     if isinstance(estimator, LinearDiscriminantAnalysis):\n157 |         covariance = [estimator.covariance_] * 2\n158 |     else:\n159 |         covariance = estimator.covariance_\n160 |     plot_ellipse(estimator.means_[0], covariance[0], \"tab:red\", ax)\n161 |     plot_ellipse(estimator.means_[1], covariance[1], \"tab:blue\", ax)\n162 | \n163 |     ax.set_box_aspect(1)\n164 |     ax.spines[\"top\"].set_visible(False)\n165 |     ax.spines[\"bottom\"].set_visible(False)\n166 |     ax.spines[\"left\"].set_visible(False)\n167 |     ax.spines[\"right\"].set_visible(False)\n168 |     ax.set(xticks=[], yticks=[])\n```\n\nFound function `sklearn/pipeline.py:Pipeline._estimator_type`.\nSource: Retrieved entity using keyword search (bm25).\n```\n407 | def _est