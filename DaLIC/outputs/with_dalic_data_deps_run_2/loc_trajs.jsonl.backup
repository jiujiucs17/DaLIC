ot used, present for API consistency by convention.\n1537 | \n1538 |         W : array-like of shape (n_samples, n_components)\n1539 |             If init='custom', it is used as initial guess for the solution.\n1540 | \n1541 |         H : array-like of shape (n_components, n_features)\n1542 |             If init='custom', it is used as initial guess for the solution.\n1543 | \n1544 |         Returns\n1545 |         -------\n1546 |         W : ndarray of shape (n_samples, n_components)\n1547 |             Transformed data.\n1548 |         \"\"\"\n1549 |         X = self._validate_data(\n1550 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n1551 |         )\n1552 | \n1553 |         with config_context(assume_finite=True):\n1554 |             W, H, n_iter = self._fit_transform(X, W=W, H=H)\n1555 | \n1556 |         self.reconstruction_err_ = _beta_divergence(\n1557 |             X, W, H, self._beta_loss, square_root=True\n1558 |         )\n1559 | \n1560 |         self.n_components_ = H.shape[0]\n1561 |         self.components_ = H\n1562 |         self.n_iter_ = n_iter\n1563 | \n1564 |         return W\n1565 | \n1566 |     def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n1567 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1568 | \n1569 |         Parameters\n1570 |         ----------\n1571 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1572 |             Data matrix to be decomposed\n1573 | \n1574 |         y : Ignored\n1575 | \n1576 |         W : array-like of shape (n_samples, n_components)\n1577 |             If init='custom', it is used as initial guess for the solution.\n1578 | \n1579 |         H : array-like of shape (n_components, n_features)\n1580 |             If init='custom', it is used as initial guess for the solution.\n1581 |             If update_H=False, it is used as a constant, to solve for W only.\n1582 | \n1583 |         update_H : b