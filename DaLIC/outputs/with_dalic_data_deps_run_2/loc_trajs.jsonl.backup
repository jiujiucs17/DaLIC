rks/bench_plot_polynomial_kernel_approximation.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_feature_expansions.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_sample_without_replacement.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_covertype.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_isotonic.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_parallel_pairwise.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_fastkmeans.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_nmf.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_ward.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_lasso_path.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting_categorical_only.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_tree.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting_adult.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_incremental_pca.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_multilabel_metrics.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_sparsify.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_20newsgroups.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_sgd_regression.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_online_ocsvm.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_components.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_saga.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_hierarchical.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_random_projections.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_samples.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_lof.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_glmnet.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_text_vectorizers.py\n\u2502               \u2514\u2500\u2500 contains \u2500\u2500 benchmarks/bench_glm.py\n\u251c\u2500\u2500 contains \u2500\u2500 build_tools\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 build_tools/generate_authors_table.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 build_tools/github\n\u2502               \u2514\u2500\u2500 contains \u2500\u2500 build_tools/circle\n\u2514\u2500\u2500 contains \u2500\u2500 doc\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/conftest.py\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/conf.py\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/tutorial\n                \u2514\u2500\u2500 contains \u2500\u2500 doc/sphinxext\n"}, {"content": "Let's look for calibration-related code in the calibration.py file since it's already listed in our exploration.\n\n<function=search_code_snippets>\n<parameter=search_terms>['sklearn/calibration.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"sklearn/calibration.py\"...\n### Search Result:\nFound file `sklearn/calibration.py`.\nSource: Exact match found for entity name `sklearn/calibration.py`.\n```\n  1 | \"\"\"Calibration of predicted probabilities.\"\"\"\n  2 | \n  3 | # Author: Alexandre Gramfort <alexandre.gramfort@telecom-paristech.fr>\n  4 | #         Balazs Kegl <balazs.kegl@gmail.com>\n  5 | #         Jan Hendrik Metzen <jhm@informatik.uni-bremen.de>\n  6 | #         Mathieu Blondel <mathieu@mblondel.org>\n  7 | #\n  8 | # License: BSD 3 clause\n  9 | \n 10 | import warnings\n 11 | from inspect import signature\n 12 | from functools import partial\n 13 | \n 14 | from math import log\n 15 | import numpy as np\n 16 | from joblib import Parallel\n 17 | \n 18 | from scipy.special import expit\n 19 | from scipy.special import xlogy\n 20 | from scipy.optimize import fmin_bfgs\n 21 | \n 22 | from .base import (\n 23 |     BaseEstimator,\n 24 |     ClassifierMixin,\n 25 |     RegressorMixin,\n 26 |     clone,\n 27 |     MetaEstimatorMixin,\n 28 | )\n 29 | from .preprocessing import label_binarize, LabelEncoder\n 30 | from .utils import (\n 31 |     column_or_1d,\n 32 |     deprecated,\n 33 |     indexable,\n 34 | )\n 35 | \n 36 | from .utils.multiclass import check_classification_targets\n 37 | from .utils.fixes import delayed\n 38 | from .utils.validation import check_is_fitted, check_consistent_length\n 39 | from .utils.validation import _check_sample_weight, _num_samples\n 40 | from .utils import _safe_indexing\n 41 | from .isotonic import IsotonicRegression\n 42 | from .svm import LinearSVC\n 43 | from .model_selection import check_cv, cross_val_predict\n 44 | \n 45 | \n 46 | class CalibratedClassifierCV(ClassifierMixin, MetaEstimatorMixin, BaseEstimator):\n 47 |     \"\"\"Probability calibration with isotonic regression or logistic regression.\n 48 | \n 49 |     This class uses cross-validation to both estimate the parameters of a\n 50 |     classifier and subsequently calibrate a classifier. With default\n 51 |     `ensemble=True`, for each cv split it\n 52 |     fits a copy of the base estimator to the training subset, and calibrates it\n 53 |     using the testing subset. For prediction, predicted probabilities are\n 54 |     averaged across these individual calibrated classifiers. When\n 55 |     `ensemble=False`, cross-validation is used to obtain unbiased predictions,\n 56 |     via :func:`~sklearn.model_selection.cross_val_predict`, which are then\n 57 |     used for calibration. For prediction, the base estimator, trained using all\n 58 |     the data, is used. This is the method implemented when `probabilities=True`\n 59 |     for :mod:`sklearn.svm` estimators.\n 60 | \n 61 |     Already fitted classifiers can be calibrated via the parameter\n 62 |     `cv=\"prefit\"`. In this case, no cross-validation is used and all provided\n 63 |     data is used for calibration. The user has to take care manually that data\n 64 |     for model fitting and calibration are disjoint.\n 65 | \n 66 |     The calibration is based on the :term:`decision_function` method of the\n 67 |     `base_estimator` if it exists, else on :term:`predict_proba`.\n 68 | \n 69 |     Read more in the :ref:`User Guide <calibration>`.\n 70 | \n 71 |     Parameters\n 72 |     ----------\n 73 |     base_estimator : estimator instance, default=None\n 74 |         The classifier whose output need to be calibrated to provide more\n 75 |         accurate `predict_proba` outputs. The default classifier is\n 76 |         a :class:`~sklearn.svm.LinearSVC`.\n 77 | \n 78 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n 79 |         The method to use for calibration. Can be 'sigmoid' which\n 80 |         corresponds to Platt's method (i.e. a logistic regression model) or\n 81 |         'isotonic' which is a non-parametric approach. It is not advised to\n 82 |         use isotonic calibration with too few calibration samples\n 83 |         ``(<<1000)`` since it tends to overfit.\n 84 | \n 85 |     cv : int, cross-validation generator, iterable or \"prefit\", \\\n 86 |             default=None\n 87 |         Determines the cross-validation splitting strategy.\n 88 |         Possible inputs for cv are:\n 89 | \n 90 |         - None, to use the default 5-fold cross-validation,\n 91 |         - integer, to specify the number of folds.\n 92 |         - :term:`CV splitter`,\n 93 |         - An iterable yielding (train, test) splits as arrays of indices.\n 94 | \n 95 |         For integer/None inputs, if ``y`` is binary or multiclass,\n 96 |         :class:`~sklearn.model_selection.StratifiedKFold` is used. If ``y`` is\n 97 |         neither binary nor multiclass, :class:`~sklearn.model_selection.KFold`\n 98 |         is used.\n 99 | \n100 |         Refer to the :ref:`User Guide <cross_validation>` for the various\n101 |         cross-validation strategies that can be used here.\n102 | \n103 |         If \"prefit\" is passed, it is assumed that `base_estimator` has been\n104 |         fitted already and all data is used for calibration.\n105 | \n106 |         .. versionchanged:: 0.22\n107 |             ``cv`` default value if None changed from 3-fold to 5-fold.\n108 | \n109 |     n_jobs : int, default=None\n110 |         Number of jobs to run in parallel.\n111 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n112 |         ``-1`` means using all processors.\n113 | \n114 |         Base estimator clones are fitted in parallel across cross-validation\n115 |         iterations. Therefore parallelism happens only when `cv != \"prefit\"`.\n116 | \n117 |         See :term:`Glossary <n_jobs>` for more details.\n118 | \n119 |         .. versionadded:: 0.24\n120 | \n121 |     ensemble : bool, default=True\n122 |         Determines how the calibrator is fitted when `cv` is not `'prefit'`.\n123 |         Ignored if `cv='prefit'`.\n124 | \n125 |         If `True`, the `base_estimator` is fitted using training data and\n126 |         calibrated using testing data, for each `cv` fold. The final estimator\n127 |         is an ensemble of `n_cv` fitted classifer and calibrator pairs, where\n128 |         `n_cv` is the number of cross-validation folds. The output is the\n129 |         average predicted probabilities of all pairs.\n130 | \n131 |         If `False`, `cv` is used to compute unbiased predictions, via\n132 |         :func:`~sklearn.model_selection.cross_val_predict`, which are then\n133 |         used for calibration. At prediction time, the classifier used is the\n134 |         `base_estimator` trained on all the data.\n135 |         Note that this method is also internally implemented  in\n136 |         :mod:`sklearn.svm` estimators with the `probabilities=True` parameter.\n137 | \n138 |         .. versionadded:: 0.24\n139 | \n140 |     Attributes\n141 |     ----------\n142 |     classes_ : ndarray of shape (n_classes,)\n143 |         The class labels.\n144 | \n145 |     n_features_in_ : int\n146 |         Number of features seen during :term:`fit`. Only defined if the\n147 |         underlying base_estimator exposes such an attribute when fit.\n148 | \n149 |         .. versionadded:: 0.24\n150 | \n151 |     feature_names_in_ : ndarray of shape (`n_features_in_`,)\n152 |         Names of features seen during :term:`fit`. Only defined if the\n153 |         underlying base_estimator exposes such an attribute when fit.\n154 | \n155 |         .. versionadded:: 1.0\n156 | \n157 |     calibrated_classifiers_ : list (len() equal to cv or 1 if `cv=\"prefit\"` \\\n158 |             or `ensemble=False`)\n159 |         The list of classifier and calibrator pairs.\n160 | \n161 |         - When `cv=\"prefit\"`, the fitted `base_estimator` and fitted\n162 |           calibrator.\n163 |         - When `cv` is not \"prefit\" and `ensemble=True`, `n_cv` fitted\n164 |           `base_estimator` and calibrator pairs. `n_cv` is the number of\n165 |           cross-validation folds.\n166 |         - When `cv` is not \"prefit\" and `ensemble=False`, the `base_estimator`,\n167 |           fitted on all the data, and fitted calibrator.\n168 | \n169 |         .. versionchanged:: 0.24\n170 |             Single calibrated classifier case when `ensemble=False`.\n171 | \n172 |     Examples\n173 |     --------\n174 |     >>> from sklearn.datasets import make_classification\n175 |     >>> from sklearn.naive_bayes import GaussianNB\n176 |     >>> from sklearn.calibration import CalibratedClassifierCV\n177 |     >>> X, y = make_classification(n_samples=100, n_features=2,\n178 |     ...                            n_redundant=0, random_state=42)\n179 |     >>> base_clf = GaussianNB()\n180 |     >>> calibrated_clf = CalibratedClassifierCV(base_estimator=base_clf, cv=3)\n181 |     >>> calibrated_clf.fit(X, y)\n182 |     CalibratedClassifierCV(base_estimator=GaussianNB(), cv=3)\n183 |     >>> len(calibrated_clf.calibrated_classifiers_)\n184 |     3\n185 |     >>> calibrated_clf.predict_proba(X)[:5, :]\n186 |     array([[0.110..., 0.889...],\n187 |            [0.072..., 0.927...],\n188 |            [0.928..., 0.071...],\n189 |            [0.928..., 0.071...],\n190 |            [0.071..., 0.928...]])\n191 | \n192 |     >>> from sklearn.model_selection import train_test_split\n193 |     >>> X, y = make_classification(n_samples=100, n_features=2,\n194 |     ...                            n_redundant=0, random_state=42)\n195 |     >>> X_train, X_calib, y_train, y_calib = train_test_split(\n196 |     ...        X, y, random_state=42\n197 |     ... )\n198 |     >>> base_clf = GaussianNB()\n199 |     >>> base_clf.fit(X_train, y_train)\n200 |     GaussianNB()\n201 |     >>> calibrated_clf = CalibratedClassifierCV(\n202 |     ...     base_estimator=base_clf,\n203 |     ...     cv=\"prefit\"\n204 |     ... )\n205 |     >>> calibrated_clf.fit(X_calib, y_calib)\n206 |     CalibratedClassifierCV(base_estimator=GaussianNB(), cv='prefit')\n207 |     >>> len(calibrated_clf.calibrated_classifiers_)\n208 |     1\n209 |     >>> calibrated_clf.predict_proba([[-0.5, 0.5]])\n210 |     array([[0.936..., 0.063...]])\n211 | \n212 |     References\n213 |     ----------\n214 |     .. [1] Obtaining calibrated probability estimates from decision trees\n215 |            and naive Bayesian classifiers, B. Zadrozny & C. Elkan, ICML 2001\n216 | \n217 |     .. [2] Transforming Classifier Scores into Accurate Multiclass\n218 |            Probability Estimates, B. Zadrozny & C. Elkan, (KDD 2002)\n219 | \n220 |     .. [3] Probabilistic Outputs for Support Vector Machines and Comparisons to\n221 |            Regularized Likelihood Methods, J. Platt, (1999)\n222 | \n223 |     .. [4] Predicting Good Probabilities with Supervised Learning,\n224 |            A. Niculescu-Mizil & R. Caruana, ICML 2005\n225 |     \"\"\"\n226 | \n227 |     def __init__(\n228 |         self,\n229 |         base_estimator=None,\n230 |         *,\n231 |         method=\"sigmoid\",\n232 |         cv=None,\n233 |         n_jobs=None,\n234 |         ensemble=True,\n235 |     ):\n236 |         self.base_estimator = base_estimator\n237 |         self.method = method\n238 |         self.cv = cv\n239 |         self.n_jobs = n_jobs\n240 |         self.ensemble = ensemble\n241 | \n242 |     def fit(self, X, y, sample_weight=None):\n243 |         \"\"\"Fit the calibrated model.\n244 | \n245 |         Parameters\n246 |         ----------\n247 |         X : array-like of shape (n_samples, n_features)\n248 |             Training data.\n249 | \n250 |         y : array-like of shape (n_samples,)\n251 |             Target values.\n252 | \n253 |         sample_weight : array-like of shape (n_samples,), default=None\n254 |             Sample weights. If None, then samples are equally weighted.\n255 | \n256 |         Returns\n257 |         -------\n258 |         self : object\n259 |             Returns an instance of self.\n260 |         \"\"\"\n261 |         check_classification_targets(y)\n262 |         X, y = indexable(X, y)\n263 | \n264 |         if self.base_estimator is None:\n265 |             # we want all classifiers that don't expose a random_state\n266 |             # to be deterministic (and we don't want to expose this one).\n267 |             base_estimator = LinearSVC(random_state=0)\n268 |         else:\n269 |             base_estimator = self.base_estimator\n270 | \n271 |         self.calibrated_classifiers_ = []\n272 |         if self.cv == \"prefit\":\n273 |             # `classes_` should be consistent with that of base_estimator\n274 |             check_is_fitted(self.base_estimator, attributes=[\"classes_\"])\n275 |             self.classes_ = self.base_estimator.classes_\n276 | \n277 |             pred_method, method_name = _get_prediction_method(base_estimator)\n278 |             n_classes = len(self.classes_)\n279 |             predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n280 | \n281 |             calibrated_classifier = _fit_calibrator(\n282 |                 base_estimator,\n283 |                 predictions,\n284 |                 y,\n285 |                 self.classes_,\n286 |                 self.method,\n287 |                 sample_weight,\n288 |             )\n289 |             self.calibrated_classifiers_.append(calibrated_classifier)\n290 |         else:\n291 |             # Set `classes_` using all `y`\n292 |             label_encoder_ = LabelEncoder().fit(y)\n293 |             self.classes_ = label_encoder_.classes_\n294 |             n_classes = len(self.classes_)\n295 | \n296 |             # sample_weight checks\n297 |             fit_parameters = signature(base_estimator.fit).parameters\n298 |             supports_sw = \"sample_weight\" in fit_parameters\n299 |             if sample_weight is not None:\n300 |                 sample_weight = _check_sample_weight(sample_weight, X)\n301 |                 if not supports_sw:\n302 |                     estimator_name = type(base_estimator).__name__\n303 |                     warnings.warn(\n304 |                         f\"Since {estimator_name} does not support \"\n305 |                         \"sample_weights, sample weights will only be\"\n306 |                         \" used for the calibration itself.\"\n307 |                     )\n308 | \n309 |             # Check that each cross-validation fold can have at least one\n310 |             # example per class\n311 |             if isinstance(self.cv, int):\n312 |                 n_folds = self.cv\n313 |             elif hasattr(self.cv, \"n_splits\"):\n314 |                 n_folds = self.cv.n_splits\n315 |             else:\n316 |                 n_folds = None\n317 |             if n_folds and np.any(\n318 |                 [np.sum(y == class_) < n_folds for class_ in self.classes_]\n319 |             ):\n320 |                 raise ValueError(\n321 |                     f\"Requesting {n_folds}-fold \"\n322 |                     \"cross-validation but provided less than \"\n323 |                     f\"{n_folds} examples for at least one class.\"\n324 |                 )\n325 |             cv = check_cv(self.cv, y, classifier=True)\n326 | \n327 |             if self.ensemble:\n328 |                 parallel = Parallel(n_jobs=self.n_jobs)\n329 | \n330 |                 self.calibrated_classifiers_ = parallel(\n331 |                     delayed(_fit_classifier_calibrator_pair)(\n332 |                         clone(base_estimator),\n333 |                         X,\n334 |                         y,\n335 |                         train=train,\n336 |                         test=test,\n337 |                         method=self.method,\n338 |                         classes=self.classes_,\n339 |                         supports_sw=supports_sw,\n340 |                         sample_weight=sample_weight,\n341 |                     )\n342 |                     for train, test in cv.split(X, y)\n343 |                 )\n344 |             else:\n345 |                 this_estimator = clone(base_estimator)\n346 |                 _, method_name = _get_prediction_method(this_estimator)\n347 |                 pred_method = partial(\n348 |                     cross_val_predict,\n349 |                     estimator=this_estimator,\n350 |                     X=X,\n351 |                     y=y,\n352 |                     cv=cv,\n353 |                     method=method_name,\n354 |                     n_jobs=self.n_jobs,\n355 |                 )\n356 |                 predictions = _compute_predictions(\n357 |                     pred_method, method_name, X, n_classes\n358 |                 )\n359 | \n360 |                 if sample_weight is not None and supports_sw:\n361 |                     this_estimator.fit(X, y, sample_weight)\n362 |                 else:\n363 |                     this_estimator.fit(X, y)\n364 |                 calibrated_classifier = _fit_calibrator(\n365 |                     this_estimator,\n366 |                     predictions,\n367 |                     y,\n368 |                     self.classes_,\n369 |                     self.method,\n370 |                     sample_weight,\n371 |                 )\n372 |                 self.calibrated_classifiers_.append(calibrated_classifier)\n373 | \n374 |         first_clf = self.calibrated_classifiers_[0].base_estimator\n375 |         if hasattr(first_clf, \"n_features_in_\"):\n376 |             self.n_features_in_ = first_clf.n_features_in_\n377 |         if hasattr(first_clf, \"feature_names_in_\"):\n378 |             self.feature_names_in_ = first_clf.feature_names_in_\n379 |         return self\n380 | \n381 |     def predict_proba(self, X):\n382 |         \"\"\"Calibrated probabilities of classification.\n383 | \n384 |         This function returns calibrated probabilities of classification\n385 |         according to each class on an array of test vectors X.\n386 | \n387 |         Parameters\n388 |         ----------\n389 |         X : The samples, as accepted by base_estimator.predict_proba\n390 | \n391 |         Returns\n392 |         -------\n393 |         C : ndarray of shape (n_samples, n_classes)\n394 |             The predicted probas.\n395 |         \"\"\"\n396 |         check_is_fitted(self)\n397 |         # Compute the arithmetic mean of the predictions of the calibrated\n398 |         # classifiers\n399 |         mean_proba = np.zeros((_num_samples(X), len(self.classes_)))\n400 |         for calibrated_classifier in self.calibrated_classifiers_:\n401 |             proba = calibrated_classifier.predict_proba(X)\n402 |             mean_proba += proba\n403 | \n404 |         mean_proba /= len(self.calibrated_classifiers_)\n405 | \n406 |         return mean_proba\n407 | \n408 |     def predict(self, X):\n409 |         \"\"\"Predict the target of new samples. The predicted class is the\n410 |         class that has the highest probability, and can thus be different\n411 |         from the prediction of the uncalibrated classifier.\n412 | \n413 |         Parameters\n414 |         ----------\n415 |         X : The samples, as accepted by base_estimator.predict\n416 | \n417 |         Returns\n418 |         -------\n419 |         C : ndarray of shape (n_samples,)\n420 |             The predicted class.\n421 |         \"\"\"\n422 |         check_is_fitted(self)\n423 |         return self.classes_[np.argmax(self.predict_proba(X), axis=1)]\n424 | \n425 |     def _more_tags(self):\n426 |         return {\n427 |             \"_xfail_checks\": {\n428 |                 \"check_sample_weights_invariance\": (\n429 |                     \"zero sample_weight is not equivalent to removing samples\"\n430 |                 ),\n431 |             }\n432 |         }\n433 | \n434 | \n435 | def _fit_classifier_calibrator_pair(\n436 |     estimator, X, y, train, test, supports_sw, method, classes, sample_weight=None\n437 | ):\n438 |     \"\"\"Fit a classifier/calibration pair on a given train/test split.\n439 | \n440 |     Fit the classifier on the train set, compute its predictions on the test\n441 |     set and use the predictions as input to fit the calibrator along with the\n442 |     test labels.\n443 | \n444 |     Parameters\n445 |     ----------\n446 |     estimator : estimator instance\n447 |         Cloned base estimator.\n448 | \n449 |     X : array-like, shape (n_samples, n_features)\n450 |         Sample data.\n451 | \n452 |     y : array-like, shape (n_samples,)\n453 |         Targets.\n454 | \n455 |     train : ndarray, shape (n_train_indicies,)\n456 |         Indices of the training subset.\n457 | \n458 |     test : ndarray, shape (n_test_indicies,)\n459 |         Indices of the testing subset.\n460 | \n461 |     supports_sw : bool\n462 |         Whether or not the `estimator` supports sample weights.\n463 | \n464 |     method : {'sigmoid', 'isotonic'}\n465 |         Method to use for calibration.\n466 | \n467 |     classes : ndarray, shape (n_classes,)\n468 |         The target classes.\n469 | \n470 |     sample_weight : array-like, default=None\n471 |         Sample weights for `X`.\n472 | \n473 |     Returns\n474 |     -------\n475 |     calibrated_classifier : _CalibratedClassifier instance\n476 |     \"\"\"\n477 |     X_train, y_train = _safe_indexing(X, train), _safe_indexing(y, train)\n478 |     X_test, y_test = _safe_indexing(X, test), _safe_indexing(y, test)\n479 |     if supports_sw and sample_weight is not None:\n480 |         sw_train = _safe_indexing(sample_weight, train)\n481 |         sw_test = _safe_indexing(sample_weight, test)\n482 |     else:\n483 |         sw_train = None\n484 |         sw_test = None\n485 | \n486 |     if supports_sw:\n487 |         estimator.fit(X_train, y_train, sample_weight=sw_train)\n488 |     else:\n489 |         estimator.fit(X_train, y_train)\n490 | \n491 |     n_classes = len(classes)\n492 |     pred_method, method_name = _get_prediction_method(estimator)\n493 |     predictions = _compute_predictions(pred_method, method_name, X_test, n_classes)\n494 | \n495 |     calibrated_classifier = _fit_calibrator(\n496 |         estimator, predictions, y_test, classes, method, sample_weight=sw_test\n497 |     )\n498 |     return calibrated_classifier\n499 | \n500 | \n501 | def _get_prediction_method(clf):\n502 |     \"\"\"Return prediction method.\n503 | \n504 |     `decision_function` method of `clf` returned, if it\n505 |     exists, otherwise `predict_proba` method returned.\n506 | \n507 |     Parameters\n508 |     ----------\n509 |     clf : Estimator instance\n510 |         Fitted classifier to obtain the prediction method from.\n511 | \n512 |     Returns\n513 |     -------\n514 |     prediction_method : callable\n515 |         The prediction method.\n516 |     method_name : str\n517 |         The name of the prediction method.\n518 |     \"\"\"\n519 |     if hasattr(clf, \"decision_function\"):\n520 |         method = getattr(clf, \"decision_function\")\n521 |         return method, \"decision_function\"\n522 |     elif hasattr(clf, \"predict_proba\"):\n523 |         method = getattr(clf, \"predict_proba\")\n524 |         return method, \"predict_proba\"\n525 |     else:\n526 |         raise RuntimeError(\n527 |             \"'base_estimator' has no 'decision_function' or 'predict_proba' method.\"\n528 |         )\n529 | \n530 | \n531 | def _compute_predictions(pred_method, method_name, X, n_classes):\n532 |     \"\"\"Return predictions for `X` and reshape binary outputs to shape\n533 |     (n_samples, 1).\n534 | \n535 |     Parameters\n536 |     ----------\n537 |     pred_method : callable\n538 |         Prediction method.\n539 | \n540 |     method_name: str\n541 |         Name of the prediction method\n542 | \n543 |     X : array-like or None\n544 |         Data used to obtain predictions.\n545 | \n546 |     n_classes : int\n547 |         Number of classes present.\n548 | \n549 |     Returns\n550 |     -------\n551 |     predictions : array-like, shape (X.shape[0], len(clf.classes_))\n552 |         The predictions. Note if there are 2 classes, array is of shape\n553 |         (X.shape[0], 1).\n554 |     \"\"\"\n555 |     predictions = pred_method(X=X)\n556 | \n557 |     if method_name == \"decision_function\":\n558 |         if predictions.ndim == 1:\n559 |             predictions = predictions[:, np.newaxis]\n560 |     elif method_name == \"predict_proba\":\n561 |         if n_classes == 2:\n562 |             predictions = predictions[:, 1:]\n563 |     else:  # pragma: no cover\n564 |         # this branch should be unreachable.\n565 |         raise ValueError(f\"Invalid prediction method: {method_name}\")\n566 |     return predictions\n567 | \n568 | \n569 | def _fit_calibrator(clf, predictions, y, classes, method, sample_weight=None):\n570 |     \"\"\"Fit calibrator(s) and return a `_CalibratedClassifier`\n571 |     instance.\n572 | \n573 |     `n_classes` (i.e. `len(clf.classes_)`) calibrators are fitted.\n574 |     However, if `n_classes` equals 2, one calibrator is fitted.\n575 | \n576 |     Parameters\n577 |     ----------\n578 |     clf : estimator instance\n579 |         Fitted classifier.\n580 | \n581 |     predictions : array-like, shape (n_samples, n_classes) or (n_samples, 1) \\\n582 |                     when binary.\n583 |         Raw predictions returned by the un-calibrated base classifier.\n584 | \n585 |     y : array-like, shape (n_samples,)\n586 |         The targets.\n587 | \n588 |     classes : ndarray, shape (n_classes,)\n589 |         All the prediction classes.\n590 | \n591 |     method : {'sigmoid', 'isotonic'}\n592 |         The method to use for calibration.\n593 | \n594 |     sample_weight : ndarray, shape (n_samples,), default=None\n595 |         Sample weights. If None, then samples are equally weighted.\n596 | \n597 |     Returns\n598 |     -------\n599 |     pipeline : _CalibratedClassifier instance\n600 |     \"\"\"\n601 |     Y = label_binarize(y, classes=classes)\n602 |     label_encoder = LabelEncoder().fit(classes)\n603 |     pos_class_indices = label_encoder.transform(clf.classes_)\n604 |     calibrators = []\n605 |     for class_idx, this_pred in zip(pos_class_indices, predictions.T):\n606 |         if method == \"isotonic\":\n607 |             calibrator = IsotonicRegression(out_of_bounds=\"clip\")\n608 |         elif method == \"sigmoid\":\n609 |             calibrator = _SigmoidCalibration()\n610 |         else:\n611 |             raise ValueError(\n612 |                 f\"'method' should be one of: 'sigmoid' or 'isotonic'. Got {method}.\"\n613 |             )\n614 |         calibrator.fit(this_pred, Y[:, class_idx], sample_weight)\n615 |         calibrators.append(calibrator)\n616 | \n617 |     pipeline = _CalibratedClassifier(clf, calibrators, method=method, classes=classes)\n618 |     return pipeline\n619 | \n620 | \n621 | class _CalibratedClassifier:\n622 |     \"\"\"Pipeline-like chaining a fitted classifier and its fitted calibrators.\n623 | \n624 |     Parameters\n625 |     ----------\n626 |     base_estimator : estimator instance\n627 |         Fitted classifier.\n628 | \n629 |     calibrators : list of fitted estimator instances\n630 |         List of fitted calibrators (either 'IsotonicRegression' or\n631 |         '_SigmoidCalibration'). The number of calibrators equals the number of\n632 |         classes. However, if there are 2 classes, the list contains only one\n633 |         fitted calibrator.\n634 | \n635 |     classes : array-like of shape (n_classes,)\n636 |         All the prediction classes.\n637 | \n638 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n639 |         The method to use for calibration. Can be 'sigmoid' which\n640 |         corresponds to Platt's method or 'isotonic' which is a\n641 |         non-parametric approach based on isotonic regression.\n642 | \n643 |     Attributes\n644 |     ----------\n645 |     calibrators_ : list of fitted estimator instances\n646 |         Same as `calibrators`. Exposed for backward-compatibility. Use\n647 |         `calibrators` instead.\n648 | \n649 |         .. deprecated:: 0.24\n650 |            `calibrators_` is deprecated from 0.24 and will be removed in\n651 |            1.1 (renaming of 0.26). Use `calibrators` instead.\n652 |     \"\"\"\n653 | \n654 |     def __init__(self, base_estimator, calibrators, *, classes, method=\"sigmoid\"):\n655 |         self.base_estimator = base_estimator\n656 |         self.calibrators = calibrators\n657 |         self.classes = classes\n658 |         self.method = method\n659 | \n660 |     # TODO: Remove in 1.1\n661 |     # mypy error: Decorated property not supported\n662 |     @deprecated(  # type: ignore\n663 |         \"`calibrators_` is deprecated in 0.24 and will be removed in 1.1\"\n664 |         \"(renaming of 0.26). Use `calibrators` instead.\"\n665 |     )\n666 |     @property\n667 |     def calibrators_(self):\n668 |         return self.calibrators\n669 | \n670 |     def predict_proba(self, X):\n671 |         \"\"\"Calculate calibrated probabilities.\n672 | \n673 |         Calculates classification calibrated probabilities\n674 |         for each class, in a one-vs-all manner, for `X`.\n675 | \n676 |         Parameters\n677 |         ----------\n678 |         X : ndarray of shape (n_samples, n_features)\n679 |             The sample data.\n680 | \n681 |         Returns\n682 |         -------\n683 |         proba : array, shape (n_samples, n_classes)\n684 |             The predicted probabilities. Can be exact zeros.\n685 |         \"\"\"\n686 |         n_classes = len(self.classes)\n687 |         pred_method, method_name = _get_prediction_method(self.base_estimator)\n688 |         predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n689 | \n690 |         label_encoder = LabelEncoder().fit(self.classes)\n691 |         pos_class_indices = label_encoder.transform(self.base_estimator.classes_)\n692 | \n693 |         proba = np.zeros((_num_samples(X), n_classes))\n694 |         for class_idx, this_pred, calibrator in zip(\n695 |             pos_class_indices, predictions.T, self.calibrators\n696 |         ):\n697 |             if n_classes == 2:\n698 |                 # When binary, `predictions` consists only of predictions for\n699 |                 # clf.classes_[1] but `pos_class_indices` = 0\n700 |                 class_idx += 1\n701 |             proba[:, class_idx] = calibrator.predict(this_pred)\n702 | \n703 |         # Normalize the probabilities\n704 |         if n_classes == 2:\n705 |             proba[:, 0] = 1.0 - proba[:, 1]\n706 |         else:\n707 |             denominator = np.sum(proba, axis=1)[:, np.newaxis]\n708 |             # In the edge case where for each class calibrator returns a null\n709 |             # probability for a given sample, use the uniform distribution\n710 |             # instead.\n711 |             uniform_proba = np.full_like(proba, 1 / n_classes)\n712 |             proba = np.divide(\n713 |                 proba, denominator, out=uniform_proba, where=denominator != 0\n714 |             )\n715 | \n716 |         # Deal with cases where the predicted probability minimally exceeds 1.0\n717 |         proba[(1.0 < proba) & (proba <= 1.0 + 1e-5)] = 1.0\n718 | \n719 |         return proba\n720 | \n721 | \n722 | def _sigmoid_calibration(predictions, y, sample_weight=None):\n723 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n724 | \n725 |     Parameters\n726 |     ----------\n727 |     predictions : ndarray of shape (n_samples,)\n728 |         The decision function or predict proba for the samples.\n729 | \n730 |     y : ndarray of shape (n_samples,)\n731 |         The targets.\n732 | \n733 |     sample_weight : array-like of shape (n_samples,), default=None\n734 |         Sample weights. If None, then samples are equally weighted.\n735 | \n736 |     Returns\n737 |     -------\n738 |     a : float\n739 |         The slope.\n740 | \n741 |     b : float\n742 |         The intercept.\n743 | \n744 |     References\n745 |     ----------\n746 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n747 |     \"\"\"\n748 |     predictions = column_or_1d(predictions)\n749 |     y = column_or_1d(y)\n750 | \n751 |     F = predictions  # F follows Platt's notations\n752 | \n753 |     # Bayesian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n783 | \n784 | \n785 | class _SigmoidCalibration(RegressorMixin, BaseEstimator):\n786 |     \"\"\"Sigmoid regression model.\n787 | \n788 |     Attributes\n789 |     ----------\n790 |     a_ : float\n791 |         The slope.\n792 | \n793 |     b_ : float\n794 |         The intercept.\n795 |     \"\"\"\n796 | \n797 |     def fit(self, X, y, sample_weight=None):\n798 |         \"\"\"Fit the model using X, y as training data.\n799 | \n800 |         Parameters\n801 |         ----------\n802 |         X : array-like of shape (n_samples,)\n803 |             Training data.\n804 | \n805 |         y : array-like of shape (n_samples,)\n806 |             Training target.\n807 | \n808 |         sample_weight : array-like of shape (n_samples,), default=None\n809 |             Sample weights. If None, then samples are equally weighted.\n810 | \n811 |         Returns\n812 |         -------\n813 |         self : object\n814 |             Returns an instance of self.\n815 |         \"\"\"\n816 |         X = column_or_1d(X)\n817 |         y = column_or_1d(y)\n818 |         X, y = indexable(X, y)\n819 | \n820 |         self.a_, self.b_ = _sigmoid_calibration(X, y, sample_weight)\n821 |         return self\n822 | \n823 |     def predict(self, T):\n824 |         \"\"\"Predict new data by linear interpolation.\n825 | \n826 |         Parameters\n827 |         ----------\n828 |         T : array-like of shape (n_samples,)\n829 |             Data to predict from.\n830 | \n831 |         Returns\n832 |         -------\n833 |         T_ : ndarray of shape (n_samples,)\n834 |             The predicted data.\n835 |         \"\"\"\n836 |         T = column_or_1d(T)\n837 |         return expit(-(self.a_ * T + self.b_))\n838 | \n839 | \n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n946 | \n```\n"}, {"content": "Let's also look for plotting-related code since we need the visualization functionality.\n\n<function=search_code_