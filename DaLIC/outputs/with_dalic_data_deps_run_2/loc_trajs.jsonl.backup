**DataFrame**\n1185 | \n1186 |         >>> df = pd.DataFrame(\n1187 |         ...     {\"num_legs\": [4, 4, 2], \"num_arms\": [0, 0, 2]}, [\"dog\", \"cat\", \"monkey\"]\n1188 |         ... )\n1189 |         >>> df\n1190 |                 num_legs  num_arms\n1191 |         dog            4         0\n1192 |         cat            4         0\n1193 |         monkey         2         2\n1194 |         >>> df = df.rename_axis(\"animal\")\n1195 |         >>> df\n1196 |                 num_legs  num_arms\n1197 |         animal\n1198 |         dog            4         0\n1199 |         cat            4         0\n1200 |         monkey         2         2\n1201 |         >>> df = df.rename_axis(\"limbs\", axis=\"columns\")\n1202 |         >>> df\n1203 |         limbs   num_legs  num_arms\n1204 |         animal\n1205 |         dog            4         0\n1206 |         cat            4         0\n1207 |         monkey         2         2\n1208 | \n1209 |         **MultiIndex**\n1210 | \n1211 |         >>> df.index = pd.MultiIndex.from_product(\n1212 |         ...     [[\"mammal\"], [\"dog\", \"cat\", \"monkey\"]], names=[\"type\", \"name\"]\n1213 |         ... )\n1214 |         >>> df\n1215 |         limbs          num_legs  num_arms\n1216 |         type   name\n1217 |         mammal dog            4         0\n1218 |                cat            4         0\n1219 |                monkey         2         2\n1220 | \n1221 |         >>> df.rename_axis(index={\"type\": \"class\"})\n1222 |         limbs          num_legs  num_arms\n1223 |         class  name\n1224 |         mammal dog            4         0\n1225 |                cat            4         0\n1226 |                monkey         2         2\n1227 | \n1228 |         >>> df.rename_axis(columns=str.upper)\n1229 |         LIMBS          num_legs  num_arms\n1230 |         type   name\n1231 |         mammal dog            4         0\n1232 |                cat            4         0\n1233 |                monkey      