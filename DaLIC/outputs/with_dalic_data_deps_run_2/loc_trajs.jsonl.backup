|         \"\"\"\n213 | \n214 |         def stringify(value):\n215 |             if self.encoding is not None:\n216 |                 return pprint_thing_encoded(value, encoding=self.encoding)\n217 |             return pprint_thing(value)\n218 | \n219 |         kind = ensure_decoded(self.kind)\n220 |         meta = ensure_decoded(self.meta)\n221 |         if kind == \"datetime\" or (kind and kind.startswith(\"datetime64\")):\n222 |             if isinstance(v, (int, float)):\n223 |                 v = stringify(v)\n224 |             v = ensure_decoded(v)\n225 |             v = Timestamp(v).as_unit(\"ns\")\n226 |             if v.tz is not None:\n227 |                 v = v.tz_convert(\"UTC\")\n228 |             return TermValue(v, v._value, kind)\n229 |         elif kind in (\"timedelta64\", \"timedelta\"):\n230 |             if isinstance(v, str):\n231 |                 v = Timedelta(v)\n232 |             else:\n233 |                 v = Timedelta(v, unit=\"s\")\n234 |             v = v.as_unit(\"ns\")._value\n235 |             return TermValue(int(v), v, kind)\n236 |         elif meta == \"category\":\n237 |             metadata = extract_array(self.metadata, extract_numpy=True)\n238 |             result: npt.NDArray[np.intp] | np.intp | int\n239 |             if v not in metadata:\n240 |                 result = -1\n241 |             else:\n242 |                 result = metadata.searchsorted(v, side=\"left\")\n243 |             return TermValue(result, result, \"integer\")\n244 |         elif kind == \"integer\":\n245 |             try:\n246 |                 v_dec = Decimal(v)\n247 |             except InvalidOperation:\n248 |                 # GH 54186\n249 |                 # convert v to float to raise float's ValueError\n250 |                 float(v)\n251 |             else:\n252 |                 v = int(v_dec.to_integral_exact(rounding=\"ROUND_HALF_EVEN\"))\n253 |             return TermValue(v, v, kind)\n254 |         elif kind == \"float\":\n255 |     