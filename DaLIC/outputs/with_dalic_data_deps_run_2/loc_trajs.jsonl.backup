 in the two arrays are not comparable.\n2212 |     classes = np.unique(y_true)\n2213 |     if pos_label is None and (\n2214 |         classes.dtype.kind in \"OUS\"\n2215 |         or not (\n2216 |             np.array_equal(classes, [0, 1])\n2217 |             or np.array_equal(classes, [-1, 1])\n2218 |             or np.array_equal(classes, [0])\n2219 |             or np.array_equal(classes, [-1])\n2220 |             or np.array_equal(classes, [1])\n2221 |         )\n2222 |     ):\n2223 |         classes_repr = \", \".join(repr(c) for c in classes)\n2224 |         raise ValueError(\n2225 |             f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2226 |             \"specified: either make y_true take value in {0, 1} or \"\n2227 |             \"{-1, 1} or pass pos_label explicitly.\"\n2228 |         )\n2229 |     elif pos_label is None:\n2230 |         pos_label = 1\n2231 | \n2232 |     return pos_label\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 985 | def fit(self, X, Y):\n 986 |         \"\"\"Fit model to data.\n 987 | \n 988 |         Parameters\n 989 |         ----------\n 990 |         X : array-like of shape (n_samples, n_features)\n 991 |             Training samples.\n 992 | \n 993 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets)\n 994 |             Targets.\n 995 | \n 996 |         Returns\n 997 |         -------\n 998 |         self : object\n 999 |             Fitted estimator.\n1000 |         \"\"\"\n1001 |         self._validate_params()\n1002 | \n1003 |         check_consistent_length(X, Y)\n1004 |         X = self._validate_data(\n1005 |             X, dtype=np.float64, copy=self.copy, ensure_min_samples=2\n1006 |         )\n1007 |         Y = check_array(\n1008 |             Y, input_name=\"Y\", dtype=np.float64, copy=self.copy, ensure_2d=False\n1009 |         )\n1010 |         if Y.ndim == 1:\n1011 |             Y = Y.reshape(-1, 1)\n1012 | \n1013 |         # we'll compute the SVD of the cross-covariance matrix = X.T.dot(Y)\n1014 |         # This matrix rank is at most min(n_samples, n_features, n_targets) so\n1015 |         # n_components cannot be bigger than that.\n1016 |         n_components = self.n_components\n1017 |         rank_upper_bound = min(X.shape[0], X.shape[1], Y.shape[1])\n1018 |         if n_components > rank_upper_bound:\n1019 |             raise ValueError(\n1020 |                 f\"`n_components` upper bound is {rank_upper_bound}. \"\n1021 |                 f\"Got {n_components} instead. Reduce `n_components`.\"\n1022 |             )\n1023 | \n1024 |         X, Y, self._x_mean, self._y_mean, self._x_std, self._y_std = _center_scale_xy(\n1025 |             X, Y, self.scale\n1026 |         )\n1027 | \n1028 |         # Compute SVD of cross-covariance matrix\n1029 |         C = np.dot(X.T, Y)\n1030 |         U, s, Vt = svd(C, full_matrices=False)\n1031 |         U = U[:, :n_components]\n1032 |         Vt = Vt[:n_components]\n1033 |         U, Vt = svd_flip(U, Vt)\n1034 |         V = Vt.T\n1035 | \n1036 |         self.x_weights_ = U\n1037 |         self.y_weights_ = V\n1038 |         self._n_features_out = self.x_weights_.shape[1]\n1039 |         return self\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1041 | def transform(self, X, Y=None):\n1042 |         \"\"\"\n1043 |         Apply the dimensionality reduction.\n1044 | \n1045 |         Parameters\n1046 |         ----------\n1047 |         X : array-like of shape (n_samples, n_features)\n1048 |             Samples to be transformed.\n1049 | \n1050 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets), \\\n1051 |                 default=None\n1052 |             Targets.\n1053 | \n1054 |         Returns\n1055 |         -------\n1056 |         x_scores : array-like or tuple of array-like\n1057 |             The transformed data `X_transformed` if `Y is not None`,\n1058 |             `(X_transformed, Y_transformed)` otherwise.\n1059 |         \"\"\"\n1060 |         check_is_fitted(self)\n1061 |         X = self._validate_data(X, dtype=np.float64, reset=False)\n1062 |         Xr = (X - self._x_mean) / self._x_std\n1063 |         x_scores = np.dot(Xr, self.x_weights_)\n1064 |         if Y is not None:\n1065 |             Y = check_array(Y, input_name=\"Y\", ensure_2d=False, dtype=np.float64)\n1066 |             if Y.ndim == 1:\n1067 |                 Y = Y.reshape(-1, 1)\n1068 |             Yr = (Y - self._y_mean) / self._y_std\n1069 |             y_scores = np.dot(Yr, self.y_weights_)\n1070 |             return x_scores, y_scores\n1071 |         return x_scores\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit_transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1073 | def fit_transform(self, X, y=None):\n1074 |         \"\"\"Learn and apply the dimensionality reduction.\n1075 | \n1076 |         Parameters\n1077 |         ----------\n1078 |         X : array-like of shape (n_samples, n_features)\n1079 |             Training samples.\n1080 | \n1081 |         y : array-like of shape (n_samples,) or (n_samples, n_targets), \\\n1082 |                 default=None\n1083 |             Targets.\n1084 | \n1085 |         Returns\n1086 |         -------\n1087 |         out : array-like or tuple of array-like\n1088 |             The transformed data `X_transformed` if `Y is not None`,\n1089 |             `(X_transformed, Y_transformed)` otherwise.\n1090 |         \"\"\"\n1091 |         return self.fit(X, y).transform(X, y)\n```\n\n\n\n##Searching for term \"sparse _check_array\"...\n### Search Result:\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==============================\n 3 | Lasso on dense and sparse data\n 4 | ==============================\n 5 | \n 6 | We show that linear_model.Lasso provides the same results for dense and sparse\n 7 | data and that in the case of sparse data the speed is improved.\n 8 | \n 9 | \"\"\"\n10 | \n11 | from time import time\n12 | from scipy import sparse\n13 | from scipy import linalg\n14 | \n15 | from sklearn.datasets import make_regression\n16 | from sklearn.linear_model import Lasso\n17 | \n18 | \n19 | # %%\n20 | # Comparing the two Lasso implementations on Dense data\n21 | # -----------------------------------------------------\n22 | #\n23 | # We create a linear regression problem that is suitable for the Lasso,\n24 | # that is to say, with more features than samples. We then store the data\n25 | # matrix in both dense (the usual) and sparse format, and train a Lasso on\n26 | # each. We compute the runtime of both and check that they learned the\n27 | # same model by computing the Euclidean norm of the difference between the\n28 | # coefficients they learned. Because the data is dense, we expect better\n29 | # runtime with a dense data format.\n30 | \n31 | X, y = make_regression(n_samples=200, n_features=5000, random_state=0)\n32 | # create a copy of X in sparse format\n33 | X_sp = sparse.coo_matrix(X)\n34 | \n35 | alpha = 1\n36 | sparse_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n37 | dense_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n38 | \n39 | t0 = time()\n40 | sparse_lasso.fit(X_sp, y)\n41 | print(f\"Sparse Lasso done in {(time() - t0):.3f}s\")\n42 | \n43 | t0 = time()\n44 | dense_lasso.fit(X, y)\n45 | print(f\"Dense Lasso done in {(time() - t0):.3f}s\")\n46 | \n47 | # compare the regression coefficients\n48 | coeff_diff = linalg.norm(sparse_lasso.coef_ - dense_lasso.coef_)\n49 | print(f\"Distance between coefficients : {coeff_diff:.2e}\")\n50 | \n51 | #\n52 | # %%\n53 | # Comparing the two Lasso implementations on Sparse data\n54 | # ------------------------------------------------------\n55 | #\n56 | # We make the previous problem sparse by replacing all small values with 0\n57 | # and run the same comparisons as above. Because the data is now sparse, we\n58 | # expect the implementation that uses the sparse data format to be faster.\n59 | \n60 | # make a copy of the previous data\n61 | Xs = X.copy()\n62 | # make Xs sparse by replacing the values lower than 2.5 with 0s\n63 | Xs[Xs < 2.5] = 0.0\n64 | # create a copy of Xs in sparse format\n```\n\nFound function `sklearn/utils/validation.py:check_array.is_sparse`.\nSource: Retrieved entity using keyword search (bm25).\n```\n869 | def is_sparse(dtype):\n870 |                 return isinstance(dtype, SparseDtype)\n```\n\nFound function `sklearn/datasets/_arff_parser.py:_sparse_data_to_array`.\nSource: Retrieved entity using keyword search (bm25).\n```\n56 | def _sparse_data_to_array(\n57 |     arff_data: ArffSparseDataType, include_columns: List\n58 | ) -> np.ndarray:\n59 |     # turns the sparse data back into an array (can't use toarray() function,\n60 |     # as this does only work on numeric data)\n61 |     num_obs = max(arff_data[1]) + 1\n62 |     y_shape = (num_obs, len(include_columns))\n63 |     reindexed_columns = {\n64 |         column_idx: array_idx for array_idx, column_idx in enumerate(include_columns)\n65 |     }\n66 |     # TODO: improve for efficiency\n67 |     y = np.empty(y_shape, dtype=np.float64)\n68 |     for val, row_idx, col_idx in zip(arff_data[0], arff_data[1], arff_data[2]):\n69 |         if col_idx in include_columns:\n70 |             y[row_idx, reindexed_columns[col_idx]] = val\n71 |     return y\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_estimator_sparse_data`.\nSource: Retrieved entity using keyword search (bm25).\n```\n850 | def check_estimator_sparse_data(name, estimator_orig):\n851 |     rng = np.random.RandomState(0)\n852 |     X = rng.uniform(size=(40, 3))\n853 |     X[X < 0.8] = 0\n854 |     X = _enforce_estimator_tags_X(estimator_orig, X)\n855 |     X_csr = sparse.csr_matrix(X)\n856 |     y = (4