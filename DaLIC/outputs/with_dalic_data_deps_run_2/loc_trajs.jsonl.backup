self._if_sheet_exists}' is not valid for if_sheet_exists. \"\n473 |                         \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n474 |                     )\n475 |             else:\n476 |                 wks = self.sheets[sheet_name]\n477 |         else:\n478 |             wks = self.book.create_sheet()\n479 |             wks.title = sheet_name\n480 | \n481 |         if validate_freeze_panes(freeze_panes):\n482 |             freeze_panes = cast(tuple[int, int], freeze_panes)\n483 |             wks.freeze_panes = wks.cell(\n484 |                 row=freeze_panes[0] + 1, column=freeze_panes[1] + 1\n485 |             )\n486 | \n487 |         for cell in cells:\n488 |             xcell = wks.cell(\n489 |                 row=startrow + cell.row + 1, column=startcol + cell.col + 1\n490 |             )\n491 |             xcell.value, fmt = self._value_with_fmt(cell.val)\n492 |             if fmt:\n493 |                 xcell.number_format = fmt\n494 | \n495 |             style_kwargs: dict[str, Serialisable] | None = {}\n496 |             if cell.style:\n497 |                 key = str(cell.style)\n498 |                 style_kwargs = _style_cache.get(key)\n499 |                 if style_kwargs is None:\n500 |                     style_kwargs = self._convert_to_style_kwargs(cell.style)\n501 |                     _style_cache[key] = style_kwargs\n502 | \n503 |             if style_kwargs:\n504 |                 for k, v in style_kwargs.items():\n505 |                     setattr(xcell, k, v)\n506 | \n507 |             if cell.mergestart is not None and cell.mergeend is not None:\n508 |                 wks.merge_cells(\n509 |                     start_row=startrow + cell.row + 1,\n510 |                     start_column=startcol + cell.col + 1,\n511 |                     end_column=startcol + cell.mergeend + 1,\n512 |                     end_row=startrow + cell.mergestart + 1,\n513 |                 )\n514 | \n515 |                 # When cells are