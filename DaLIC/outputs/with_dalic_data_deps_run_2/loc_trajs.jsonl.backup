{"instance_id": "pandas-dev__pandas-29944", "found_files": [["pandas/plotting/_matplotlib/core.py", "pandas/plotting/_matplotlib/tools.py", "pandas/plotting/_core.py"]], "found_modules": [["pandas/io/formats/latex.py:TableBuilderAbstract", "pandas/plotting/_matplotlib/converter.py:MilliSecondLocator", "pandas/plotting/_matplotlib/core.py:MPLPlot", "pandas/core/strings/object_array.py:ObjectStringArrayMixin", "pandas/core/arrays/numpy_.py:PandasArray", "asv_bench/benchmarks/arithmetic.py:AddOverflowScalar", "pandas/io/formats/info.py:BaseInfo", "asv_bench/benchmarks/groupby.py:FillNA", "pandas/core/indexes/accessors.py:TimedeltaProperties", "pandas/io/formats/latex.py:GenericTableBuilder", "asv_bench/benchmarks/arithmetic.py:AddOverflowArray", "pandas/core/series.py:Series", "pandas/io/excel/_base.py:BaseExcelReader", "pandas/plotting/_misc.py:_Options", "pandas/io/formats/info.py:SeriesInfo", "pandas/io/excel/_openpyxl.py:OpenpyxlReader", "pandas/core/window/expanding.py:Expanding", "pandas/io/formats/latex.py:LongTableBuilder", "pandas/core/arrays/string_arrow.py:ArrowStringArray", "asv_bench/benchmarks/frame_methods.py:Nunique", "asv_bench/benchmarks/frame_methods.py:SeriesNuniqueWithNan", "pandas/io/html.py:_BeautifulSoupHtml5LibFrameParser", "pandas/core/groupby/groupby.py:GroupByPlot.__getattr__", "pandas/core/computation/engines.py:PythonEngine", "pandas/core/internals/array_manager.py:BaseArrayManager", "pandas/core/apply.py:Apply", "pandas/core/strings/base.py:BaseStringArrayMethods", "asv_bench/benchmarks/io/csv.py:ToCSVIndexes", "asv_bench/benchmarks/io/json.py:ToJSON", "pandas/core/arrays/sparse/dtype.py:SparseDtype", "asv_bench/benchmarks/multiindex_object.py:Sortlevel", "pandas/plotting/_matplotlib/hist.py:KdePlot", "pandas/plotting/_matplotlib/converter.py:TimeConverter", "asv_bench/benchmarks/frame_methods.py:Iteration", "pandas/core/indexes/period.py:PeriodIndex", "pandas/util/version/__init__.py:LegacyVersion", "asv_bench/benchmarks/groupby.py:Int64