0 |     X_train = check_array(\n1041 |         X_train, order=\"C\", dtype=[np.float64, np.float32], copy=False\n1042 |     )\n1043 | \n1044 |     # Fortran-order dict better suited for the sparse coding which is the\n1045 |     # bottleneck of this algorithm.\n1046 |     dictionary = check_array(dictionary, order=\"F\", dtype=X_train.dtype, copy=False)\n1047 |     dictionary = np.require(dictionary, requirements=\"W\")\n1048 | \n1049 |     batches = gen_batches(n_samples, batch_size)\n1050 |     batches = itertools.cycle(batches)\n1051 | \n1052 |     # The covariance of the dictionary\n1053 |     if inner_stats is None:\n1054 |         A = np.zeros((n_components, n_components), dtype=X_train.dtype)\n1055 |         # The data approximation\n1056 |         B = np.zeros((n_features, n_components), dtype=X_train.dtype)\n1057 |     else:\n1058 |         A = inner_stats[0].copy()\n1059 |         B = inner_stats[1].copy()\n1060 | \n1061 |     # If n_iter is zero, we need to return zero.\n1062 |     ii = iter_offset - 1\n1063 | \n1064 |     for ii, batch in zip(range(iter_offset, iter_offset + n_iter), batches):\n1065 |         this_X = X_train[batch]\n1066 |         dt = time.time() - t0\n1067 |         if verbose == 1:\n1068 |             sys.stdout.write(\".\")\n1069 |             sys.stdout.flush()\n1070 |         elif verbose:\n1071 |             if verbose > 10 or ii % ceil(100.0 / verbose) == 0:\n1072 |                 print(\n1073 |                     \"Iteration % 3i (elapsed time: % 3is, % 4.1fmn)\" % (ii, dt, dt / 60)\n1074 |                 )\n1075 | \n1076 |         this_code = sparse_encode(\n1077 |             this_X,\n1078 |             dictionary,\n1079 |             algorithm=method,\n1080 |             alpha=alpha,\n1081 |             n_jobs=n_jobs,\n1082 |             check_input=False,\n1083 |             positive=positive_code,\n1084 |             max_iter=method_max_iter,\n1085 |             verbose=verbose,\n1086 |         )\n1087 | \n1088 |       