67 |         Series,\n 68 |     )\n 69 |     from pandas.core.arrays import (\n 70 |         DatetimeArray,\n 71 |         ExtensionArray,\n 72 |         TimedeltaArray,\n 73 |     )\n 74 | \n 75 | \n 76 | def array(\n 77 |     data: Sequence[object] | AnyArrayLike,\n 78 |     dtype: Dtype | None = None,\n 79 |     copy: bool = True,\n 80 | ) -> ExtensionArray:\n 81 |     \"\"\"\n 82 |     Create an array.\n 83 | \n 84 |     Parameters\n 85 |     ----------\n 86 |     data : Sequence of objects\n 87 |         The scalars inside `data` should be instances of the\n 88 |         scalar type for `dtype`. It's expected that `data`\n 89 |         represents a 1-dimensional array of data.\n 90 | \n 91 |         When `data` is an Index or Series, the underlying array\n 92 |         will be extracted from `data`.\n 93 | \n 94 |     dtype : str, np.dtype, or ExtensionDtype, optional\n 95 |         The dtype to use for the array. This may be a NumPy\n 96 |         dtype or an extension type registered with pandas using\n 97 |         :meth:`pandas.api.extensions.register_extension_dtype`.\n 98 | \n 99 |         If not specified, there are two possibilities:\n100 | \n101 |         1. When `data` is a :class:`Series`, :class:`Index`, or\n102 |            :class:`ExtensionArray`, the `dtype` will be taken\n103 |            from the data.\n104 |         2. Otherwise, pandas will attempt to infer the `dtype`\n105 |            from the data.\n106 | \n107 |         Note that when `data` is a NumPy array, ``data.dtype`` is\n108 |         *not* used for inferring the array type. This is because\n109 |         NumPy cannot represent all the types of data that can be\n110 |         held in extension arrays.\n111 | \n112 |         Currently, pandas will infer an extension dtype for sequences of\n113 | \n114 |         ============================== =======================================\n115 |         Scalar Type                    Array Type\n116 |         ============================== =======================================\n117 |         :class:`pandas.Interval`       :class:`pandas.arrays.IntervalArray`\n118 |         :class:`pandas.Period`         :class:`pandas.arrays.PeriodArray`\n119 |         :class:`datetime.datetime`     :class:`pandas.arrays.DatetimeArray`\n120 |         :class:`datetime.timedelta`    :class:`pandas.arrays.TimedeltaArray`\n121 |         :class:`int`                   :class:`pandas.arrays.IntegerArray`\n122 |         :class:`float`                 :class:`pandas.arrays.FloatingArray`\n123 |         :class:`str`                   :class:`pandas.arrays.StringArray` or\n124 |                                        :class:`pandas.arrays.ArrowStringArray`\n125 |         :class:`bool`                  :class:`pandas.arrays.BooleanArray`\n126 |         ============================== =======================================\n127 | \n128 |         The ExtensionArray created when the scalar type is :class:`str` is determined by\n129 |         ``pd.options.mode.string_storage`` if the dtype is not explicitly given.\n130 | \n131 |         For all other cases, NumPy's usual inference rules will be used.\n132 |     copy : bool, default True\n133 |         Whether to copy the data, even if not necessary. Depending\n134 |         on the type of `data`, creating the new array may require\n135 |         copying data, even if ``copy=False``.\n136 | \n137 |     Returns\n138 |     -------\n139 |     ExtensionArray\n140 |         The newly created array.\n141 | \n142 |     Raises\n143 |     ------\n144 |     ValueError\n145 |         When `data` is not 1-dimensional.\n146 | \n147 |     See Also\n148 |     --------\n149 |     numpy.array : Construct a NumPy array.\n150 |     Series : Construct a pandas Series.\n151 |     Index : Construct a pandas Index.\n152 |     arrays.NumpyExtensionArray : ExtensionArray wrapping a NumPy array.\n153 |     Series.array : Extract the array stored within a Series.\n154 | \n155 |     Notes\n156 |     -----\n157 |     Omitting the `dtype` argument means pandas will attempt to infer the\n158 |     best array type from the values in the data. As new array types are\n159 |     added by pandas and 3rd party libraries, the \"best\" array type may\n160 |     change. We recommend specifying `dtype` to ensure that\n161 | \n162 |     1. the correct array type for the data is returned\n163 |     2. the returned array type doesn't change as new extension types\n164 |        are added by pandas and third-party libraries\n165 | \n166 |     Additionally, if the underlying memory representation of the returned\n167 |     array matters, we recommend specifying the `dtype` as a concrete object\n168 |     rather than a string alias or allowing it to be inferred. For example,\n169 |     a future version of pandas or a 3rd-party library may include a\n170 |     dedicated ExtensionArray for string data. In this event, the following\n171 |     would no longer return a :class:`arrays.NumpyExtensionArray` backed by a\n172 |     NumPy array.\n173 | \n174 |     >>> pd.array([\"a\", \"b\"], dtype=str)\n175 |     <NumpyExtensionArray>\n176 |     ['a', 'b']\n177 |     Length: 2, dtype: str32\n178 | \n179 |     This would instead return the new ExtensionArray dedicated for string\n180 |     data. If you really need the new array to be backed by a  NumPy array,\n181 |     specify that in the dtype.\n182 | \n183 |     >>> pd.array([\"a\", \"b\"], dtype=np.dtype(\"<U1\"))\n184 |     <NumpyExtensionArray>\n185 |     ['a', 'b']\n186 |     Length: 2, dtype: str32\n187 | \n188 |     Finally, Pandas has arrays that mostly overlap with NumPy\n189 | \n190 |       * :class:`arrays.DatetimeArray`\n191 |       * :class:`arrays.TimedeltaArray`\n192 | \n193 |     When data with a ``datetime64[ns]`` or ``timedelta64[ns]`` dtype is\n194 |     passed, pandas will always return a ``DatetimeArray`` or ``TimedeltaArray``\n195 |     rather than a ``NumpyExtensionArray``. This is for symmetry with the case of\n196 |     timezone-aware data, which NumPy does not natively support.\n197 | \n198 |     >>> pd.array([\"2015\", \"2016\"], dtype=\"datetime64[ns]\")\n199 |     <DatetimeArray>\n200 |     ['2015-01-01 00:00:00', '2016-01-01 00:00:00']\n201 |     Length: 2, dtype: datetime64[ns]\n202 | \n203 |     >>> pd.array([\"1h\", \"2h\"], dtype=\"timedelta64[ns]\")\n204 |     <TimedeltaArray>\n205 |     ['0 days 01:00:00', '0 days 02:00:00']\n206 |     Length: 2, dtype: timedelta64[ns]\n207 | \n208 |     Examples\n209 |     --------\n210 |     If a dtype is not specified, pandas will infer the best dtype from the values.\n211 |     See the description of `dtype` for the types pandas infers for.\n212 | \n213 |     >>> pd.array([1, 2])\n214 |     <IntegerArray>\n215 |     [1, 2]\n216 |     Length: 2, dtype: Int64\n217 | \n218 |     >>> pd.array([1, 2, np.nan])\n219 |     <IntegerArray>\n220 |     [1, 2, <NA>]\n221 |     Length: 3, dtype: Int64\n222 | \n223 |     >>> pd.array([1.1, 2.2])\n224 |     <FloatingArray>\n225 |     [1.1, 2.2]\n226 |     Length: 2, dtype: Float64\n227 | \n228 |     >>> pd.array([\"a\", None, \"c\"])\n229 |     <StringArray>\n230 |     ['a', <NA>, 'c']\n231 |     Length: 3, dtype: string\n232 | \n233 |     >>> with pd.option_context(\"string_storage\", \"pyarrow\"):\n234 |     ...     arr = pd.array([\"a\", None, \"c\"])\n235 |     >>> arr\n236 |     <ArrowStringArray>\n237 |     ['a', <NA>, 'c']\n238 |     Length: 3, dtype: string\n239 | \n240 |     >>> pd.array([pd.Period(\"2000\", freq=\"D\"), pd.Period(\"2000\", freq=\"D\")])\n241 |     <PeriodArray>\n242 |     ['2000-01-01', '2000-01-01']\n243 |     Length: 2, dtype: period[D]\n244 | \n245 |     You can use the string alias for `dtype`\n246 | \n247 |     >>> pd.array([\"a\", \"b\", \"a\"], dtype=\"category\")\n248 |     ['a', 'b', 'a']\n249 |     Categories (2, object): ['a', 'b']\n250 | \n251 |     Or specify the actual dtype\n252 | \n253 |     >>> pd.array(\n254 |     ...     [\"a\", \"b\", \"a\"], dtype=pd.CategoricalDtype([\"a\", \"b\", \"c\"], ordered=True)\n255 |     ... )\n256 |     ['a', 'b', 'a']\n257 |     Categories (3, object): ['a' < 'b' < 'c']\n258 | \n259 |     If pandas does not infer a dedicated extension type a\n260 |     :class:`arrays.NumpyExtensionArray` is returned.\n261 | \n262 |     >>> pd.array([1 + 1j, 3 + 2j])\n263 |     <NumpyExtensionArray>\n264 |     [(1+1j), (3+2j)]\n265 |     Length: 2, dtype: complex128\n266 | \n267 |     As mentioned in the \"Notes\" section, new extension types may be added\n268 |     in the future (by pandas or 3rd party libraries), causing the return\n269 |     value to no longer be a :class:`arrays.NumpyExtensionArray`. Specify the\n270 |     `dtype` as a NumPy dtype if you need to ensure there's no future change in\n271 |     behavior.\n272 | \n273 |     >>> pd.array([1, 2], dtype=np.dtype(\"int32\"))\n274 |     <NumpyExtensionArray>\n275 |     [1, 2]\n276 |     Length: 2, dtype: int32\n277 | \n278 |     `data` must be 1-dimensional. A ValueError is raised when the input\n279 |     has the wrong dimensionality.\n280 | \n281 |     >>> pd.array(1)\n282 |     Traceback (most recent call last):\n283 |       ...\n284 |     ValueError: Cannot pass scalar '1' to 'pandas.array'.\n285 |     \"\"\"\n286 |     from pandas.core.arrays import (\n287 |         BooleanArray,\n288 |         DatetimeArray,\n289 |         ExtensionArray,\n290 |         FloatingArray,\n291 |         IntegerArray,\n292 |         NumpyExtensionArray,\n293 |         TimedeltaArray,\n294 |     )\n295 |     from pandas.core.arrays.string_ import StringDtype\n296 | \n297 |     if lib.is_scalar(data):\n298 |         msg = f\"Cannot pass scalar '{data}' to 'pandas.array'.\"\n299 |         raise ValueError(msg)\n300 |     elif isinstance(data, ABCDataFrame):\n301 |         raise TypeError(\"Cannot pass DataFrame to 'pandas.array'\")\n302 | \n303 |     if dtype is None and isinstance(data, (ABCSeries, ABCIndex, ExtensionArray)):\n304 |         # Note: we exclude np.ndarray here, will do type inference on it\n305 |         dtype = data.dtype\n306 | \n307 |     data = extract_array(data, extract_numpy=True)\n308 | \n309 |     # this returns None for not-found dtypes.\n310 |     if dtype is not None:\n311 |         dtype = pandas_dtype(dtype)\n312 | \n313 |     if isinstance(data, ExtensionArray) and (dtype is None or data.dtype == dtype):\n314 |         # e.g. TimedeltaArray[s], avoid casting to NumpyExtensionArray\n315 |         if copy:\n316 |             return data.copy()\n317 |         return data\n318 | \n319 |     if isinstance(dtype, ExtensionDtype):\n320 |         cls = dtype.construct_array_type()\n321 |         return cls._from_sequence(data, dtype=dtype, copy=copy)\n322 | \n323 |     if dtype is None:\n324 |         was_ndarray = isinstance(data, np.ndarray)\n325 |         # error: Item \"Sequence[object]\" of \"Sequence[object] | ExtensionArray |\n326 |         # ndarray[Any, Any]\" has no attribute \"dtype\"\n327 |         if not was_ndarray or data.dtype == object:  # type: ignore[union-attr]\n328 |             result = lib.maybe_convert_objects(\n329 |                 ensure_object(data),\n330 |                 convert_non_numeric=True,\n331 |                 convert_to_nullable_dtype=True,\n332 |                 dtype_if_all_nat=None,\n333 |             )\n334 |             result = ensure_wrapped_if_datetimelike(result)\n335 |             if isinstance(result, np.ndarray):\n336 |                 if len(result) == 0 and not was_ndarray:\n337 |                     # e.g. empty list\n338 |                     return FloatingArray._from_sequence(data, dtype=\"Float64\")\n339 |                 return NumpyExtensionArray._from_sequence(\n340 |                     data, dtype=result.dtype, copy=copy\n341 |                 )\n342 |             if result is data and copy:\n343 |                 return result.copy()\n344 |             return result\n345 | \n346 |         data = cast(np.ndarray, data)\n347 |         result = ensure_wrapped_if_datetimelike(data)\n348 |         if result is not data:\n349 |             result = cast(\"DatetimeArray | TimedeltaArray\", result)\n350 |             if copy and result.dtype == data.dtype:\n351 |                 return result.copy()\n352 |             return result\n353 | \n354 |         if data.dtype.kind in \"SU\":\n355 |             # StringArray/ArrowStringArray depending on pd.options.mode.string_storage\n356 |             dtype = StringDtype()\n357 |             cls = dtype.construct_array_type()\n358 |             return cls._from_sequence(data, dtype=dtype, copy=copy)\n359 | \n360 |         elif data.dtype.kind in \"iu\":\n361 |             dtype = IntegerArray._dtype_cls._get_dtype_mapping()[data.dtype]\n362 |             return IntegerArray._from_sequence(data, dtype=dtype, copy=copy)\n363 |         elif data.dtype.kind == \"f\":\n364 |             # GH#44715 Exclude np.float16 bc FloatingArray does not support it;\n365 |             #  we will fall back to NumpyExtensionArray.\n366 |             if data.dtype == np.float16:\n367 |                 return NumpyExtensionArray._from_sequence(\n368 |                     data, dtype=data.dtype, copy=copy\n369 |                 )\n370 |             dtype = FloatingArray._dtype_cls._get_dtype_mapping()[data.dtype]\n371 |             return FloatingArray._from_sequence(data, dtype=dtype, copy=copy)\n372 | \n373 |         elif data.dtype.kind == \"b\":\n374 |             return BooleanArray._from_sequence(data, dtype=\"boolean\", copy=copy)\n375 |         else:\n376 |             # e.g. complex\n377 |             return NumpyExtensionArray._from_sequence(data, dtype=data.dtype, copy=copy)\n378 | \n379 |     # Pandas overrides NumPy for\n380 |     #   1. datetime64[ns,us,ms,s]\n381 |     #   2. timedelta64[ns,us,ms,s]\n382 |     # so that a DatetimeArray is returned.\n383 |     if lib.is_np_dtype(dtype, \"M\") and is_supported_dtype(dtype):\n384 |         return DatetimeArray._from_sequence(data, dtype=dtype, copy=copy)\n385 |     if lib.is_np_dtype(dtype, \"m\") and is_supported_dtype(dtype):\n386 |         return TimedeltaArray._from_sequence(data, dtype=dtype, copy=copy)\n387 | \n388 |     elif lib.is_np_dtype(dtype, \"mM\"):\n389 |         raise ValueError(\n390 |             # GH#53817\n391 |             r\"datetime64 and timedelta64 dtype resolutions other than \"\n392 |             r\"'s', 'ms', 'us', and 'ns' are no longer supported.\"\n393 |         )\n394 | \n395 |     return NumpyExtensionArray._from_sequence(data, dtype=dtype, copy=copy)\n396 | \n397 | \n398 | _typs = frozenset(\n399 |     {\n400 |         \"index\",\n401 |         \"rangeindex\",\n402 |         \"multiindex\",\n403 |         \"datetimeindex\",\n404 |         \"timedeltaindex\",\n405 |         \"periodindex\",\n406 |         \"categoricalindex\",\n407 |         \"intervalindex\",\n408 |         \"series\",\n409 |     }\n410 | )\n411 | \n412 | \n413 | @overload\n414 | def extract_array(\n415 |     obj: Series | Index, extract_numpy: bool = ..., extract_range: bool = ...\n416 | ) -> ArrayLike: ...\n417 | \n418 | \n419 | @overload\n420 | def extract_array(\n421 |     obj: T, extract_numpy: bool = ..., extract_range: bool = ...\n422 | ) -> T | ArrayLike: ...\n423 | \n424 | \n425 | def extract_array(\n426 |     obj: T, extract_numpy: bool = False, extract_range: bool = False\n427 | ) -> T | ArrayLike:\n428 |     \"\"\"\n429 |     Extract the ndarray or ExtensionArray from a Series or Index.\n430 | \n431 |     For all other types, `obj` is just returned as is.\n432 | \n433 |     Parameters\n434 |     ----------\n435 |     obj : object\n436 |         For Series / Index, the underlying ExtensionArray is unboxed.\n437 | \n438 |     extract_numpy : bool, default False\n439 |         Whether to extract the ndarray from a NumpyExtensionArray.\n440 | \n441 |     extract_range : bool, default False\n442 |         If we have a RangeIndex, return range._values if True\n443 |         (which is a materialized integer ndarray), otherwise return unchanged.\n444 | \n445 |     Returns\n446 |     -------\n447 |     arr : object\n448 | \n449 |     Examples\n450 |     --------\n451 |     >>> extract_array(pd.Series([\"a\", \"b\", \"c\"], dtype=\"category\"))\n452 |     ['a', 'b', 'c']\n453 |     Categories (3, object): ['a', 'b', 'c']\n454 | \n455 |     Other objects like lists, arrays, and DataFrames are just passed through.\n456 | \n457 |     >>> extract_array([1, 2, 3])\n458 |     [1, 2, 3]\n459 | \n460 |     For an ndarray-backed Series / Index the ndarray is returned.\n461 | \n462 |     >>> extract_array(pd.Series([1, 2, 3]))\n463 |     array([1, 2, 3])\n464 | \n465 |     To extract all the way down to the ndarray, pass ``extract_numpy=True``.\n466 | \n467 |     >>> extract_array(pd.Series([1, 2, 3]), extract_numpy=True)\n468 |     array([1, 2, 3])\n469 |     \"\"\"\n470 |     typ = getattr(obj, \"_typ\", None)\n471 |     if typ in _typs:\n472 |         # i.e. isinstance(obj, (ABCIndex, ABCSeries))\n473 |         if typ == \"rangeindex\":\n474 |             if extract_range:\n475 |                 # error: \"T\" has no attribute \"_values\"\n476 |                 return obj._values  # type: ignore[attr-defined]\n477 |             return obj\n478 | \n479 |         # error: \"T\" has no attribute \"_values\"\n480 |         return obj._values  # type: ignore[attr-defined]\n481 | \n482 |     elif extract_numpy and typ == \"npy_extension\":\n483 |         # i.e. isinstance(obj, ABCNumpyExtensionArray)\n484 |         # error: \"T\" has no attribute \"to_numpy\"\n485 |         return obj.to_numpy()  # type: ignore[attr-defined]\n486 | \n487 |     return obj\n488 | \n489 | \n490 | def ensure_wrapped_if_datetimelike(arr):\n491 |     \"\"\"\n492 |     Wrap datetime64 and timedelta64 ndarrays in DatetimeArray/TimedeltaArray.\n493 |     \"\"\"\n494 |     if isinstance(arr, np.ndarray):\n495 |         if arr.dtype.kind == \"M\":\n496 |             from pandas.core.arrays import DatetimeArray\n497 | \n498 |             dtype = get_supported_dtype(arr.dtype)\n499 |             return DatetimeArray._from_sequence(arr, dtype=dtype)\n500 | \n501 |         elif arr.dtype.kind == \"m\":\n502 |             from pandas.core.arrays import TimedeltaArray\n503 | \n504 |             dtype = get_supported_dtype(arr.dtype)\n505 |             return TimedeltaArray._from_sequence(arr, dtype=dtype)\n506 | \n507 |     return arr\n508 | \n509 | \n510 | def sanitize_masked_array(data: ma.MaskedArray) -> np.ndarray:\n511 |     \"\"\"\n512 |     Convert numpy MaskedArray to ensure mask is softened.\n513 |     \"\"\"\n514 |     mask = ma.getmaskarray(data)\n515 |     if mask.any():\n516 |         dtype, fill_value = maybe_promote(data.dtype, np.nan)\n517 |         dtype = cast(np.dtype, dtype)\n518 |         data = ma.asarray(data.astype(dtype, copy=True))\n519 |         data.soften_mask()  # set hardmask False if it was True\n520 |         data[mask] = fill_value\n521 |     else:\n522 |         data = data.copy()\n523 |     return data\n524 | \n525 | \n526 | def sanitize_array(\n527 |     data,\n528 |     index: Index | None,\n529 |     dtype: DtypeObj | None = None,\n530 |     copy: bool = False,\n531 |     *,\n532 |     allow_2d: bool = False,\n533 | ) -> ArrayLike:\n534 |     \"\"\"\n535 |     Sanitize input data to an ndarray or ExtensionArray, copy if specified,\n536 |     coerce to the dtype if specified.\n537 | \n538 |     Parameters\n539 |     ----------\n540 |     data : Any\n541 |     index : Index or None, default None\n542 |     dtype : np.dtype, ExtensionDtype, or None, default None\n543 |     copy : bool, default False\n544 |     allow_2d : bool, default False\n545 |         If False, raise if we have a 2D Arraylike.\n546 | \n547 |     Returns\n548 |     -------\n549 |     np.ndarray or ExtensionArray\n550 |     \"\"\"\n551 |     original_dtype = dtype\n552 |     if isinstance(data, ma.MaskedArray):\n553 |         data = sanitize_mask