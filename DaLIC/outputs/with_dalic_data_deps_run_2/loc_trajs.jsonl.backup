({len(x)}).')\n2540 | \n2541 |         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n2542 |         hatch = itertools.cycle(np.atleast_1d(hatch))\n2543 |         color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n2544 |                                 # Fallback if color == \"none\".\n2545 |                                 itertools.repeat('none'))\n2546 |         if edgecolor is None:\n2547 |             edgecolor = itertools.repeat(None)\n2548 |         else:\n2549 |             edgecolor = itertools.chain(\n2550 |                 itertools.cycle(mcolors.to_rgba_array(edgecolor)),\n2551 |                 # Fallback if edgecolor == \"none\".\n2552 |                 itertools.repeat('none'))\n2553 | \n2554 |         # We will now resolve the alignment and really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                                     f'and width ({width.dtype}) '\n2564 |                                     f'are incompatible') from e\n2565 |                 bottom = y\n2566 |             else:  # horizontal\n2567 |                 try:\n2568 |                     bottom = y - height / 2\n2569 |                 except TypeError as e:\n2570 |                     raise TypeError(f'the dtypes of parameters y ({y.dtype}) '\n2571 |                                     f'and height ({height.dtype}) '\n2572 |                                     f'are incompatible') from e\n2573 |                 left = x\n2574 |         else:  # edge\n2575 |             left = x\n2576 |             bottom = y\n2577 | \n2578 |         patches = []\n2579 |         args = zi