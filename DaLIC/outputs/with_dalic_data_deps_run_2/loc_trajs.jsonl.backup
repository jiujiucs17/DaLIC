lues_object, skipna=True)\n206 |         integer_like = (\"floating\", \"integer\", \"mixed-integer-float\")\n207 |         if inferred_dtype not in (\"boolean\", \"empty\") + integer_like:\n208 |             raise TypeError(\"Need to pass bool-like values\")\n209 | \n210 |         # mypy does not narrow the type of mask_values to npt.NDArray[np.bool_]\n211 |         # within this branch, it assumes it can also be None\n212 |         mask_values = cast(\"npt.NDArray[np.bool_]\", isna(values_object))\n213 |         values = np.zeros(len(values), dtype=bool)\n214 |         values[~mask_values] = values_object[~mask_values].astype(bool)\n215 | \n216 |         # if the values were integer-like, validate it were actually 0/1's\n217 |         if (inferred_dtype in integer_like) and not (\n218 |             np.all(\n219 |                 values[~mask_values].astype(float)\n220 |                 == values_object[~mask_values].astype(float)\n221 |             )\n222 |         ):\n223 |             raise TypeError(\"Need to pass bool-like values\")\n224 | \n225 |     if mask is None and mask_values is None:\n226 |         mask = np.zeros(values.shape, dtype=bool)\n227 |     elif mask is None:\n228 |         mask = mask_values\n229 |     else:\n230 |         if isinstance(mask, np.ndarray) and mask.dtype == np.bool_:\n231 |             if mask_values is not None:\n232 |                 mask = mask | mask_values\n233 |             else:\n234 |                 if copy:\n235 |                     mask = mask.copy()\n236 |         else:\n237 |             mask = np.array(mask, dtype=bool)\n238 |             if mask_values is not None:\n239 |                 mask = mask | mask_values\n240 | \n241 |     if values.shape != mask.shape:\n242 |         raise ValueError(\"values.shape and mask.shape must match\")\n243 | \n244 |     return values, mask\n```\n\n\n\n##Searching for term \"str accessor string values inferred_dtype\"...\n### Search Result:\nFound function `pandas/core/strings