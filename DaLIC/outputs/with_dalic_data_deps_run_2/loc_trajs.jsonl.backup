 \"\"\"Compute dual coefficients and diagonal of G^-1.\n1929 | \n1930 |         Used when we have an SVD decomposition of X\n1931 |         (n_samples > n_features and X is dense).\n1932 |         \"\"\"\n1933 |         w = ((singvals_sq + alpha) ** -1) - (alpha**-1)\n1934 |         if self.fit_intercept:\n1935 |             # detect intercept column\n1936 |             normalized_sw = sqrt_sw / np.linalg.norm(sqrt_sw)\n1937 |             intercept_dim = _find_smallest_angle(normalized_sw, U)\n1938 |             # cancel the regularization for the intercept\n1939 |             w[intercept_dim] = -(alpha**-1)\n1940 |         c = np.dot(U, self._diag_dot(w, UT_y)) + (alpha**-1) * y\n1941 |         G_inverse_diag = self._decomp_diag(w, U) + (alpha**-1)\n1942 |         if len(y.shape) != 1:\n1943 |             # handle case where y is 2-d\n1944 |             G_inverse_diag = G_inverse_diag[:, np.newaxis]\n1945 |         return G_inverse_diag, c\n```\n\nFound function `sklearn/random_projection.py:_gaussian_random_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n162 | def _gaussian_random_matrix(n_components, n_features, random_state=None):\n163 |     \"\"\"Generate a dense Gaussian random matrix.\n164 | \n165 |     The components of the random matrix are drawn from\n166 | \n167 |         N(0, 1.0 / n_components).\n168 | \n169 |     Read more in the :ref:`User Guide <gaussian_random_matrix>`.\n170 | \n171 |     Parameters\n172 |     ----------\n173 |     n_components : int,\n174 |         Dimensionality of the target projection space.\n175 | \n176 |     n_features : int,\n177 |         Dimensionality of the original source space.\n178 | \n179 |     random_state : int, RandomState instance or None, default=None\n180 |         Controls the pseudo random number generator used to generate the matrix\n181 |         at fit time.\n182 |         Pass an int for reproducible output across multiple function calls.\n183 |         See :term:`Glossary <random_state>`.\n184 | \n185 |     Returns\n186 |     -------\n187 |     components : ndarray of shape (n_components, n_features)\n188 |         The generated Gaussian random matrix.\n189 | \n190 |     See Also\n191 |     --------\n192 |     GaussianRandomProjection\n193 |     \"\"\"\n194 |     _check_input_size(n_components, n_features)\n195 |     rng = check_random_state(random_state)\n196 |     components = rng.normal(\n197 |         loc=0.0, scale=1.0 / np.sqrt(n_components), size=(n_components, n_features)\n198 |     )\n199 |     return components\n```\n\nFound function `sklearn/utils/validation.py:_check_pos_label_consistency`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2183 | def _check_pos_label_consistency(pos_label, y_true):\n2184 |     \"\"\"Check if `pos_label` need to be specified or not.\n2185 | \n2186 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2187 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2188 |     `pos_label` parameters.\n2189 | \n2190 |     Parameters\n2191 |     ----------\n2192 |     pos_label : int, float, bool, str or None\n2193 |         The positive label.\n2194 |     y_true : ndarray of shape (n_samples,)\n2195 |         The target vector.\n2196 | \n2197 |     Returns\n2198 |     -------\n2199 |     pos_label : int, float, bool or str\n2200 |         If `pos_label` can be inferred, it will be returned.\n2201 | \n2202 |     Raises\n2203 |     ------\n2204 |     ValueError\n2205 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2206 |         it will raise a `ValueError`.\n2207 |     \"\"\"\n2208 |     # ensure binary classification if pos_label is not specified\n2209 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2210 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2211 |     # when elements in the two arrays are not comparable.\n2212 |     classes = np.unique(y_true)\n2213 |     if pos_label is None and (\n2214 |         classes.dtype.kind in \"OUS\"\n2215 |         or not (\n2216 |             np.array_equal(classes, [0, 1])\n2217 |             or np.array_equal(classes, [-1, 1])\n2218 |             or np.array_equal(classes, [0])\n2219 |             or np.array_equal(classes, [-1])\n2220 |             or np.array_equal(classes, [1])\n2221 |         )\n2222 |     ):\n2223 |         classes_repr = \", \".join(repr(c) for c in classes)\n2224 |         raise ValueError(\n2225 |             f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2226 |             \"specified: either make y_true take value in {0, 1} or \"\n2227 |             \"{-1, 1} or pass pos_label explicitly.\"\n2228 |         )\n2229 |     elif pos_label is None:\n2230 |         pos_label = 1\n2231 | \n2232 |     return pos_label\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 985 | def fit(self, X, Y):\n 986 |         \"\"\"Fit model to data.\n 987 | \n 988 |         Parameters\n 989 |         ----------\n 990 |         X : array-like of shape (n_samples, n_features)\n 991 |             Training samples.\n 992 | \n 993 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets)\n 994 |             Targets.\n 995 | \n 996 |         Returns\n 997 |         -------\n 998 |         self : object\n 999 |             Fitted estimator.\n1000 |         \"\"\"\n1001 |         self._validate_params()\n1002 | \n1003 |         check_consistent_length(X, Y)\n1004 |         X = self._validate_data(\n1005 |             X, dtype=np.float64, copy=self.copy, ensure_min_samples=2\n1006 |         )\n1007 |         Y = check_array(\n1008 |             Y, input_name=\"Y\", dtype=np.float64, copy=self.copy, ensure_2d=False\n1009 |         )\n1010 |         if Y.ndim == 1:\n1011 |             Y = Y.reshape(-1, 1)\n1012 | \n1013 |         # we'll compute the SVD of the cross-covaria