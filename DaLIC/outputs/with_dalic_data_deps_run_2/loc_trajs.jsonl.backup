      style=None,\n857 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n858 |                             css_row=idx,\n859 |                             css_col=gcolidx,\n860 |                             css_converter=self.style_converter,\n861 |                         )\n862 |                     gcolidx += 1\n863 | \n864 |         yield from self._generate_body(gcolidx)\n865 | \n866 |     @property\n867 |     def _has_aliases(self) -> bool:\n868 |         \"\"\"Whether the aliases for column names are present.\"\"\"\n869 |         return is_list_like(self.header)\n870 | \n871 |     def _generate_body(self, coloffset: int) -> Iterable[ExcelCell]:\n872 |         # Write the body of the frame data series by series.\n873 |         for colidx in range(len(self.columns)):\n874 |             series = self.df.iloc[:, colidx]\n875 |             for i, val in enumerate(series):\n876 |                 yield CssExcelCell(\n877 |                     row=self.rowcounter + i,\n878 |                     col=colidx + coloffset,\n879 |                     val=val,\n880 |                     style=None,\n881 |                     css_styles=getattr(self.styler, \"ctx\", None),\n882 |                     css_row=i,\n883 |                     css_col=colidx,\n884 |                     css_converter=self.style_converter,\n885 |                 )\n886 | \n887 |     def get_formatted_cells(self) -> Iterable[ExcelCell]:\n888 |         for cell in itertools.chain(self._format_header(), self._format_body()):\n889 |             cell.val = self._format_value(cell.val)\n890 |             yield cell\n891 | \n892 |     @doc(storage_options=_shared_docs[\"storage_options\"])\n893 |     def write(\n894 |         self,\n895 |         writer: FilePath | WriteExcelBuffer | ExcelWriter,\n896 |         sheet_name: str = \"Sheet1\",\n897 |         startrow: int = 0,\n898 |         startcol: int = 0,\n899 |         freeze_panes: tuple[int, int] | None = None,\n900 |         engine: str | None = None,\n901 |         storage_options: StorageOptions | None = None,\n902 |         engine_kwargs: dict | None = None,\n903 |     ) -> None:\n904 |         \"\"\"\n905 |         writer : path-like, file-like, or ExcelWriter object\n906 |             File path or existing ExcelWriter\n907 |         sheet_name : str, default 'Sheet1'\n908 |             Name of sheet which will contain DataFrame\n909 |         startrow :\n910 |             upper left cell row to dump data frame\n911 |         startcol :\n912 |             upper left cell column to dump data frame\n913 |         freeze_panes : tuple of integer (length 2), default None\n914 |             Specifies the one-based bottommost row and rightmost column that\n915 |             is to be frozen\n916 |         engine : string, default None\n917 |             write engine to use if writer is a path - you can also set this\n918 |             via the options ``io.excel.xlsx.writer``,\n919 |             or ``io.excel.xlsm.writer``.\n920 | \n921 |         {storage_options}\n922 | \n923 |         engine_kwargs: dict, optional\n924 |             Arbitrary keyword arguments passed to excel engine.\n925 |         \"\"\"\n926 |         from pandas.io.excel import ExcelWriter\n927 | \n928 |         num_rows, num_cols = self.df.shape\n929 |         if num_rows > self.max_rows or num_cols > self.max_cols:\n930 |             raise ValueError(\n931 |                 f\"This sheet is too large! Your sheet size is: {num_rows}, {num_cols} \"\n932 |                 f\"Max sheet size is: {self.max_rows}, {self.max_cols}\"\n933 |             )\n934 | \n935 |         if engine_kwargs is None:\n936 |             engine_kwargs = {}\n937 | \n938 |         formatted_cells = self.get_formatted_cells()\n939 |         if isinstance(writer, ExcelWriter):\n940 |             need_save = False\n941 |         else:\n942 |             writer = ExcelWriter(\n943 |                 writer,\n944 |                 engine=eng