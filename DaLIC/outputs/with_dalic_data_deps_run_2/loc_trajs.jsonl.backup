n168 | TimestampConvertibleTypes = Union[\n169 |     \"Timestamp\", date, np.datetime64, np.int64, float, str\n170 | ]\n171 | TimestampNonexistent = Union[\n172 |     Literal[\"shift_forward\", \"shift_backward\", \"NaT\", \"raise\"], timedelta\n173 | ]\n174 | TimedeltaConvertibleTypes = Union[\n175 |     \"Timedelta\", timedelta, np.timedelta64, np.int64, float, str\n176 | ]\n177 | Timezone = Union[str, tzinfo]\n178 | \n179 | ToTimestampHow = Literal[\"s\", \"e\", \"start\", \"end\"]\n180 | \n181 | # NDFrameT is stricter and ensures that the same subclass of NDFrame always is\n182 | # used. E.g. `def func(a: NDFrameT) -> NDFrameT: ...` means that if a\n183 | # Series is passed into a function, a Series is always returned and if a DataFrame is\n184 | # passed in, a DataFrame is always returned.\n185 | NDFrameT = TypeVar(\"NDFrameT\", bound=\"NDFrame\")\n186 | \n187 | IndexT = TypeVar(\"IndexT\", bound=\"Index\")\n188 | FreqIndexT = TypeVar(\"FreqIndexT\", \"DatetimeIndex\", \"PeriodIndex\", \"TimedeltaIndex\")\n189 | NumpyIndexT = TypeVar(\"NumpyIndexT\", np.ndarray, \"Index\")\n190 | \n191 | AxisInt = int\n192 | Axis = Union[AxisInt, Literal[\"index\", \"columns\", \"rows\"]]\n193 | IndexLabel = Union[Hashable, Sequence[Hashable]]\n194 | Level = Hashable\n195 | Shape = tuple[int, ...]\n196 | Suffixes = Sequence[Optional[str]]\n197 | Ordered = Optional[bool]\n198 | JSONSerializable = Optional[Union[PythonScalar, list, dict]]\n199 | Frequency = Union[str, \"BaseOffset\"]\n200 | Axes = ListLike\n201 | \n202 | RandomState = Union[\n203 |     int,\n204 |     np.ndarray,\n205 |     np.random.Generator,\n206 |     np.random.BitGenerator,\n207 |     np.random.RandomState,\n208 | ]\n209 | \n210 | # dtypes\n211 | NpDtype = Union[str, np.dtype, type_t[Union[str, complex, bool, object]]]\n212 | Dtype = Union[\"ExtensionDtype\", NpDtype]\n213 | AstypeArg = Union[\"ExtensionDtype\", \"npt.DTypeLike\"]\n214 | # DtypeArg specifies all allowable dtypes in a functions its dtype argument\n215 | DtypeArg = Union[Dtype, Mapping[Hashable, Dtype]]\n216 | DtypeObj = Union[np.dtype, \"ExtensionDtype\"]\n217 | \n218 | # converters\n219 | ConvertersArg = dict[Hashable, Callable[[Dtype], Dtype]]\n220 | \n221 | # parse_dates\n222 | ParseDatesArg = Union[\n223 |     bool, list[Hashable], list[list[Hashable]], dict[Hashable, list[Hashable]]\n224 | ]\n225 | \n226 | # For functions like rename that convert one label to another\n227 | Renamer = Union[Mapping[Any, Hashable], Callable[[Any], Hashable]]\n228 | \n229 | # to maintain type information across generic functions and parametrization\n230 | T = TypeVar(\"T\")\n231 | \n232 | # used in decorators to preserve the signature of the function it decorates\n233 | # see https://mypy.readthedocs.io/en/stable/generics.html#declaring-decorators\n234 | FuncType = Callable[..., Any]\n235 | F = TypeVar(\"F\", bound=FuncType)\n236 | TypeT = TypeVar(\"TypeT\", bound=type)\n237 | \n238 | # types of vectorized key functions for DataFrame::sort_values and\n239 | # DataFrame::sort_index, among others\n240 | ValueKeyFunc = Optional[Callable[[\"Series\"], Union[\"Series\", AnyArrayLike]]]\n241 | IndexKeyFunc = Optional[Callable[[\"Index\"], Union[\"Index\", AnyArrayLike]]]\n242 | \n243 | # types of `func` kwarg for DataFrame.aggregate and Series.aggregate\n244 | AggFuncTypeBase = Union[Callable, str]\n245 | AggFuncTypeDict = MutableMapping[\n246 |     Hashable, Union[AggFuncTypeBase, list[AggFuncTypeBase]]\n247 | ]\n248 | AggFuncType = Union[\n249 |     AggFuncTypeBase,\n250 |     list[AggFuncTypeBase],\n251 |     AggFuncTypeDict,\n252 | ]\n253 | AggObjType = Union[\n254 |     \"Series\",\n255 |     \"DataFrame\",\n256 |     \"GroupBy\",\n257 |     \"SeriesGroupBy\",\n258 |     \"DataFrameGroupBy\",\n259 |     \"BaseWindow\",\n260 |     \"Resampler\",\n261 | ]\n262 | \n263 | PythonFuncType = Callable[[Any], Any]\n264 | \n265 | # filenames and file-like-objects\n266 | AnyStr_co = TypeVar(\"AnyStr_co\", str, bytes, covariant=True)\n267 | AnyStr_contra = TypeVar(\"AnyStr_contra\", str, bytes, contravariant=True)\n268 | \n269 | \n270 | class BaseBuffer(Protocol):\n271 |     @property\n272 |     def mode(self) -> str:\n273 |         # for _get_filepath_or_buffer\n274 |         ...\n275 | \n276 |     def seek(self, __offset: int, __whence: int = ...) -> int:\n277 |         # with one argument: gzip.GzipFile, bz2.BZ2File\n278 |         # with two arguments: zip.ZipFile, read_sas\n279 |         ...\n280 | \n281 |     def seekable(self) -> bool:\n282 |         # for bz2.BZ2File\n283 |         ...\n284 | \n285 |     def tell(self) -> int:\n286 |         # for zip.ZipFile, read_stata, to_stata\n287 |         ...\n288 | \n289 | \n290 | class ReadBuffer(BaseBuffer, Protocol[AnyStr_co]):\n291 |     def read(self, __n: int = ...) -> AnyStr_co:\n292 |         # for BytesIOWrapper, gzip.GzipFile, bz2.BZ2File\n293 |         ...\n294 | \n295 | \n296 | class WriteBuffer(BaseBuffer, Protocol[AnyStr_contra]):\n297 |     def write(self, __b: AnyStr_contra) -> Any:\n298 |         # for gzip.GzipFile, bz2.BZ2File\n299 |         ...\n300 | \n301 |     def flush(self) -> Any:\n302 |         # for gzip.GzipFile, bz2.BZ2File\n303 |         ...\n304 | \n305 | \n306 | class ReadPickleBuffer(ReadBuffer[bytes], Protocol):\n307 |     def readline(self) -> bytes: ...\n308 | \n309 | \n310 | class WriteExcelBuffer(WriteBuffer[bytes], Protocol):\n311 |     def truncate(self, size: int | None = ..., /) -> int: ...\n312 | \n313 | \n314 | class ReadCsvBuffer(ReadBuffer[AnyStr_co], Protocol):\n315 |     def __iter__(self) -> Iterator[AnyStr_co]:\n316 |         # for engine=python\n317 |         ...\n318 | \n319 |     def fileno(self) -> int:\n320 |         # for _MMapWrapper\n321 |         ...\n322 | \n323 |     def readline(self) -> AnyStr_co:\n324 |         # for engine=python\n325 |         ...\n326 | \n327 |     @property\n328 |     def closed(self) -> bool:\n329 |         # for engine=pyarrow\n330 |         ...\n331 | \n332 | \n333 | FilePath = Union[str, \"PathLike[str]\"]\n334 | \n335 | # for arbitrary kwargs passed during reading/writing files\n336 | StorageOptions = Optional[dict[str, Any]]\n337 | \n338 | \n339 | # compression keywords and compression\n340 | CompressionDict = dict[str, Any]\n341 | CompressionOptions = Optional[\n342 |     Union[Literal[\"infer\", \"gzip\", \"bz2\", \"zip\", \"xz\", \"zstd\", \"tar\"], CompressionDict]\n343 | ]\n344 | \n345 | # types in DataFrameFormatter\n346 | FormattersType = Union[\n347 |     list[Callable], tuple[Callable, ...], Mapping[Union[str, int], Callable]\n348 | ]\n349 | ColspaceType = Mapping[Hashable, Union[str, int]]\n350 | FloatFormatType = Union[str, Callable, \"EngFormatter\"]\n351 | ColspaceArgType = Union[\n352 |     str, int, Sequence[Union[str, int]], Mapping[Hashable, Union[str, int]]\n353 | ]\n354 | \n355 | # Arguments for fillna()\n356 | FillnaOptions = Literal[\"backfill\", \"bfill\", \"ffill\", \"pad\"]\n357 | InterpolateOptions = Literal[\n358 |     \"linear\",\n359 |     \"time\",\n360 |     \"index\",\n361 |     \"values\",\n362 |     \"nearest\",\n363 |     \"zero\",\n364 |     \"slinear\",\n365 |     \"quadratic\",\n366 |     \"cubic\",\n367 |     \"barycentric\",\n368 |     \"polynomial\",\n369 |     \"krogh\",\n370 |     \"piecewise_polynomial\",\n371 |     \"spline\",\n372 |     \"pchip\",\n373 |     \"akima\",\n374 |     \"cubicspline\",\n375 |     \"from_derivatives\",\n376 | ]\n377 | \n378 | # internals\n379 | Manager = Union[\"BlockManager\", \"SingleBlockManager\"]\n380 | \n381 | # indexing\n382 | # PositionalIndexer -> valid 1D positional indexer, e.g. can pass\n383 | # to ndarray.__getitem__\n384 | # ScalarIndexer is for a single value as the index\n385 | # SequenceIndexer is for list like or slices (but not tuples)\n386 | # PositionalIndexerTuple is extends the PositionalIndexer for 2D arrays\n387 | # These are used in various __getitem__ overloads\n388 | # TODO(typing#684): add Ellipsis, see\n389 | # ht