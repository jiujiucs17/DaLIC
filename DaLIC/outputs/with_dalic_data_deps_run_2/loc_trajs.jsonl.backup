ate(row)\n729 |                 )\n730 |                 self.rowcounter += 1\n731 |         return itertools.chain(gen, gen2)\n732 | \n733 |     def _format_body(self) -> Iterable[ExcelCell]:\n734 |         if isinstance(self.df.index, MultiIndex):\n735 |             return self._format_hierarchical_rows()\n736 |         else:\n737 |             return self._format_regular_rows()\n738 | \n739 |     def _format_regular_rows(self) -> Iterable[ExcelCell]:\n740 |         if self._has_aliases or self.header:\n741 |             self.rowcounter += 1\n742 | \n743 |         # output index and index_label?\n744 |         if self.index:\n745 |             # check aliases\n746 |             # if list only take first as this is not a MultiIndex\n747 |             if self.index_label and isinstance(\n748 |                 self.index_label, (list, tuple, np.ndarray, Index)\n749 |             ):\n750 |                 index_label = self.index_label[0]\n751 |             # if string good to go\n752 |             elif self.index_label and isinstance(self.index_label, str):\n753 |                 index_label = self.index_label\n754 |             else:\n755 |                 index_label = self.df.index.names[0]\n756 | \n757 |             if isinstance(self.columns, MultiIndex):\n758 |                 self.rowcounter += 1\n759 | \n760 |             if index_label and self.header is not False:\n761 |                 yield ExcelCell(self.rowcounter - 1, 0, index_label, None)\n762 | \n763 |             # write index_values\n764 |             index_values = self.df.index\n765 |             if isinstance(self.df.index, PeriodIndex):\n766 |                 index_values = self.df.index.to_timestamp()\n767 | \n768 |             for idx, idxval in enumerate(index_values):\n769 |                 yield CssExcelCell(\n770 |                     row=self.rowcounter + idx,\n771 |                     col=0,\n772 |                     val=idxval,\n773 |                     style=None,\n774 |           