arch (bm25).\n```\n526 | def boxplot_frame_groupby(\n527 |     grouped,\n528 |     subplots=True,\n529 |     column=None,\n530 |     fontsize=None,\n531 |     rot=0,\n532 |     grid=True,\n533 |     ax=None,\n534 |     figsize=None,\n535 |     layout=None,\n536 |     sharex=False,\n537 |     sharey=True,\n538 |     backend=None,\n539 |     **kwargs,\n540 | ):\n541 |     \"\"\"\n542 |     Make box plots from DataFrameGroupBy data.\n543 | \n544 |     Parameters\n545 |     ----------\n546 |     grouped : Grouped DataFrame\n547 |     subplots : bool\n548 |         * ``False`` - no subplots will be used\n549 |         * ``True`` - create a subplot for each group.\n550 | \n551 |     column : column name or list of names, or vector\n552 |         Can be any valid input to groupby.\n553 |     fontsize : int or str\n554 |     rot : label rotation angle\n555 |     grid : Setting this to True will show the grid\n556 |     ax : Matplotlib axis object, default None\n557 |     figsize : A tuple (width, height) in inches\n558 |     layout : tuple (optional)\n559 |         The layout of the plot: (rows, columns).\n560 |     sharex : bool, default False\n561 |         Whether x-axes will be shared among subplots.\n562 |     sharey : bool, default True\n563 |         Whether y-axes will be shared among subplots.\n564 |     backend : str, default None\n565 |         Backend to use instead of the backend specified in the option\n566 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n567 |         specify the ``plotting.backend`` for the whole session, set\n568 |         ``pd.options.plotting.backend``.\n569 | \n570 |         .. versionadded:: 1.0.0\n571 | \n572 |     **kwargs\n573 |         All other plotting keyword arguments to be passed to\n574 |         matplotlib's boxplot function.\n575 | \n576 |     Returns\n577 |     -------\n578 |     dict of key/value = group key/DataFrame.boxplot return value\n579 |     or DataFrame.boxplot return value in case subplots=figures=False\n580 | \n581 |     Examples\n582 |     --------\n583 |     You can create boxplots for grouped data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **kwargs,\n617 |     )\n```\n\n\n\n##Searching for term \"DataFrame.plot subplots\"...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PlotAccessor(PandasObject):\n\n    _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n    _series_kinds = (\"pie\",)\n    _dataframe_kinds = (\"scatter\", \"hexbin\")\n    _kind_aliases = {\"density\": \"kde\"}\n    _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n\n    def __init__(self, data) -> None:\n...\n    @staticmethod\n    def _get_call_args(backend_name, data, args, kwargs):\n...\n    def __call__(self, *args, **kwargs):\n...\n    __call__.__doc__ = __doc__\n\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n\n        Examples\n        --------\n\n        .. plot::\n            :context: close-figs\n\n            >>> s = pd.Series([1, 3, 2])\n            >>> s.plot.line()\n            <AxesSubplot:ylabel='Density'>\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the populations for some animals\n            over the years.\n\n            >>> df = pd.DataFrame({\n            ...    'pig': [20, 18, 489, 675, 1776],\n            ...    'horse': [4, 25, 281, 600, 1900]\n            ...    }, index=[1990, 1997, 2003, 2009, 2014])\n            >>> lines = df.plot.line()\n\n        .. plot::\n           :context: close-figs\n\n           An example with subplots, so an array of axes is returned.\n\n           >>> axes = df.plot.line(subplots=True)\n           >>> type(axes)\n           <class 'numpy.ndarray'>\n\n        .. plot::\n           :context: close-figs\n\n           Let's repeat the same example, but specifying colors for\n           each column (in this case, for each animal).\n\n           >>> axes = df.plot.line(\n           ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n           ... )\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the relationship between both\n            populations.\n\n            >>> lines = df.plot.line(x='pig', y='horse')\n        \"\"\"\n    )\n    @Substitution(kind=\"line\")\n    @Appender(_bar_or_line_doc)\n    def line(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.barh : Horizontal bar plot.\n        DataFrame.plot : Make plots of a DataFrame.\n        matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n\n        Examples\n        --------\n        Basic plot.\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n            >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n\n        Plot a whole dataframe to a bar plot. Each column is assigned a\n        distinct color, and each row is nested in a group along the\n        horizontal axis.\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.bar(rot=0)\n\n        Plot stacked bar charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(stacked=True)\n\n        Instead of nesting, the figure can be split by column with\n        ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n        :class:`matplotlib.axes.Axes` are returned.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(rot=0, subplots=True)\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        If you don't like the default colours, you can specify how you'd\n        like each column to be colored.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(\n            ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n            ... )\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        Plot a single colum