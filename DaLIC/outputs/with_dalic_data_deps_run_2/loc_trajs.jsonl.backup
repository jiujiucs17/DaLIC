of sparse data the speed is improved.\n 8 | \n 9 | \"\"\"\n10 | \n11 | from time import time\n12 | from scipy import sparse\n13 | from scipy import linalg\n14 | \n15 | from sklearn.datasets import make_regression\n16 | from sklearn.linear_model import Lasso\n17 | \n18 | \n19 | # %%\n20 | # Comparing the two Lasso implementations on Dense data\n21 | # -----------------------------------------------------\n22 | #\n23 | # We create a linear regression problem that is suitable for the Lasso,\n24 | # that is to say, with more features than samples. We then store the data\n25 | # matrix in both dense (the usual) and sparse format, and train a Lasso on\n26 | # each. We compute the runtime of both and check that they learned the\n27 | # same model by computing the Euclidean norm of the difference between the\n28 | # coefficients they learned. Because the data is dense, we expect better\n29 | # runtime with a dense data format.\n30 | \n31 | X, y = make_regression(n_samples=200, n_features=5000, random_state=0)\n32 | # create a copy of X in sparse format\n33 | X_sp = sparse.coo_matrix(X)\n34 | \n35 | alpha = 1\n36 | sparse_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n37 | dense_lasso = Lasso(alpha=alpha, fit_intercept=False, max_iter=1000)\n38 | \n39 | t0 = time()\n40 | sparse_lasso.fit(X_sp, y)\n41 | print(f\"Sparse Lasso done in {(time() - t0):.3f}s\")\n42 | \n43 | t0 = time()\n44 | dense_lasso.fit(X, y)\n45 | print(f\"Dense Lasso done in {(time() - t0):.3f}s\")\n46 | \n47 | # compare the regression coefficients\n48 | coeff_diff = linalg.norm(sparse_lasso.coef_ - dense_lasso.coef_)\n49 | print(f\"Distance between coefficients : {coeff_diff:.2e}\")\n50 | \n51 | #\n52 | # %%\n53 | # Comparing the two Lasso implementations on Sparse data\n54 | # ------------------------------------------------------\n55 | #\n56 | # We make the previous problem sparse by replacing all small values with 0\n57 | # and run the same comparisons as above. Because the data is now sparse, we\n58 | # expect the implementation that uses the sparse data format to be faster.\n59 | \n60 | # make a copy of the previous data\n61 | Xs = X.copy()\n62 | # make Xs sparse by replacing the values lower than 2.5 with 0s\n63 | Xs[Xs < 2.5] = 0.0\n64 | # create a copy of Xs in sparse format\n```\n\nFound function `asv_benchmarks/benchmarks/datasets.py:_synth_regression_sparse_dataset`.\nSource: Retrieved entity using keyword search (bm25).\n```\n101 | def _synth_regression_sparse_dataset(\n102 |     n_samples=10000, n_features=10000, density=0.01, dtype=np.float32\n103 | ):\n104 |     X = sp.random(\n105 |         m=n_samples, n=n_features, density=density, format=\"csr\", random_state=0\n106 |     )\n107 |     X.data = np.random.RandomState(0).randn(X.getnnz())\n108 |     X = X.astype(dtype, copy=False)\n109 |     coefs = sp.random(m=n_features, n=1, density=0.5, random_state=0)\n110 |     coefs.data = np.random.RandomState(0).randn(coefs.getnnz())\n111 |     y = X.dot(coefs.toarray()).reshape(-1)\n112 |     y += 0.2 * y.std() * np.random.randn(n_samples)\n113 | \n114 |     X, X_val, y, y_val = train_test_split(X, y, test_size=0.1, random_state=0)\n115 |     return X, X_val, y, y_val\n```\n\nFound function `sklearn/kernel_approximation.py:AdditiveChi2Sampler._transform_sparse`.\nSource: Retrieved entity using keyword search (bm25).\n```\n829 | def _transform_sparse(X, sample_steps, sample_interval):\n830 |         indices = X.indices.copy()\n831 |         indptr = X.indptr.copy()\n832 | \n833 |         data_step = np.sqrt(X.data * sample_interval)\n834 |         X_step = sp.csr_matrix(\n835 |             (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n836 |         )\n837 |         X_new = [X_step]\n838 | \n839 |         log_step_nz = sample_interval * np.log(X.data)\n840 |         step_nz = 2 * X.data * sample_interval\n841 | \n842 |         for j in range(1, sample_steps):\n843 |             factor_nz = np.sqrt(step_nz / np.cosh(np.pi * j * sample_interval))\n844 | \n845 |             data_step = factor_nz * np.cos(j * log_step_nz)\n846 |             X_step = sp.csr_matrix(\n847 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n848 |             )\n849 |             X_new.append(X_step)\n850 | \n851 |             data_step = factor_nz * np.sin(j * log_step_nz)\n852 |             X_step = sp.csr_matrix(\n853 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n854 |             )\n855 |             X_new.append(X_step)\n856 | \n857 |         return sp.hstack(X_new)\n```\n\n\n\n##Searching for term \"sparse\", \"design_matrix sparse\"...\n### Search Result:\nFound function `sklearn/random_projection.py:_sparse_random_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n202 | def _sparse_random_matrix(n_components, n_features, density=\"auto\", random_state=None):\n203 |     \"\"\"Generalized Achlioptas random sparse matrix for random projection.\n204 | \n205 |     Setting density to 1 / 3 will yield the original matrix by Dimitris\n206 |     Achlioptas while setting a lower value will yield the generalization\n207 |     by Ping Li et al.\n208 | \n209 |     If we note :math:`s = 1 / density`, the components of the random matrix are\n210 |     drawn from:\n211 | \n212 |       - -sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n213 |       -  0                              with probability 1 - 1 / s\n214 |       - +sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n215 | \n216 |     Read more in the :ref:`User Guide <sparse_random_matrix>`.\n217 | \n218 |     Parameters\n219 |     ----------\n220 |     n_components : int,\n221 |         Dimensionality of the target projection space.\n222 | \n223 |     n_features : int,\n224 |         Dimensionality of the original source space.\n225 | \n226 |     density : float or 'auto', default='auto'\n227 |         Ratio of non-zero component in the random projection matrix in the\n228 |         range `(0, 1]`\n229 | \n230 |         If density = 'auto', the value is set to the minimum density\n231 |         as recommended by Ping Li et al.: 1 / sqrt(n_features).\n232 | \n233 |         Use density = 1 / 3.0 if you want to reproduce the results from\n234 |         Achlioptas, 2001.\n235 | \n236 |     random_state : int, RandomState instance or None, default=None\n237 |         Controls the pseudo random number generator used to generate the matrix\n238 |         at fit time.\n239 |         Pass an int for reproducible output across multiple function calls.\n240 |         See :term:`Glossary <random_state>`.\n241 | \n242 |     Returns\n243 |     -------\n244 |     components : {ndarray, sparse matrix} of shape (n_components, n_features)\n245 |         The generated Gaussian random matrix. Sparse matrix will be of CSR\n246 |         format.\n247 | \n248 |     See Also\n249 |     --------\n250 |     SparseRandomProjection\n251 | \n252 |     References\n253 |     ----------\n254 | \n255 |     .. [1] Ping Li, T. Hastie and K. W. Church, 2006,\n256 |            \"Very Sparse Random Projections\".\n257 |            https://web.stanford.edu/~hastie/Papers/Ping/KDD06_rp.pdf\n258 | \n259 |     .. [2] D. Achlioptas, 2001, \"Database-friendly random projections\",\n260 |            https://cgi.di.uoa.gr/~optas/papers/jl.pdf\n261 | \n262 |     \"\"\"\n263 |     _check_input_size(n_components, n_features)\n264 |     density = _check_density(density, n_features)\n265 |     rng = check_random_state(random_state)\n266 | \n267 |     if density == 1:\n268 |         # skip index generation if totally dense\n269 |         components = rng.binomial(1, 0.5, (n_components, n_features)) * 2 - 1\n270 |         return 1 / np.sqrt(n_components) * components\n271 | \n272 |     else:\n273 |         # Generate location of non zero elements\n274 |         indices = []\n275 |         offset = 0\n276 |         indptr = [offset]\n277 |         for _ in range(n_components):\n278 |             # find the indices of the non-zero components for row i\n279 |             n_nonzero_i = rng.binomial(n_features, density)\n280 |             indices_i = sample_without_replacement(\n281 |                 n_features, n_nonzero_i, random_state=rng\n282 |             )\n283 |             indices.append(indices_i)\n284 |             offset += n_nonzero_i\n285 |             indptr.append(offset)\n286 | \n287 |         indices = np.concatenate(indices)\n288 | \n289 |         # Among non zero components the probability of the sign is 50%/50%\n290 |         data = rng.binomial(1, 0.5, size=np.size(indices)) * 2 - 1\n291 | \n292 |         # build the CSR structure by concatenating the rows\n293 |         components = sp.csr_matrix(\n294 |             (data, indices, indptr), shape=(n_components, n_features)\n295 |         )\n296 | \n297 |         return np.sqrt(1 / density) / np.sqrt(n_components) * components\n```\n\nFound function `sklearn/utils/extmath.py:safe_sparse_dot`.\nSource: Retrieved code content using keyword search (bm25).\n```\n160 | def safe_sparse_dot(a, b, *, dense_output=False):\n161 |     \"\"\"Dot product that handle the sparse matrix case correctly.\n162 | \n163 |     Parameters\n164 |     ----------\n165 |     a : {ndarray, sparse matrix}\n166 |     b : {ndarray, sparse matrix}\n167 |     dense_output : bool, default=False\n168 |         When False, ``a`` and ``b`` both being sparse will yield sparse output.\n169 |         When True, output will always be a dense array.\n170 | \n171 |     Returns\n172 |     -------\n173 |     dot_product : {ndarray, sparse matrix}\n174 |         Sparse if ``a`` and ``b`` are sparse and ``dense_output=False``.\n175 |     \"\"\"\n176 |     if a.ndim > 2 or b.ndim > 2:\n177 |         if sparse.issparse(a):\n178 |             # sparse is always 2D. Implies b is 3D+\n179 |             # [i, j] @ [k, ..., l, m, n] -> [i, k, ..., l, n]\n180 |             b_ = np.rollaxis(b, -2)\n181 |             b_2d = b_.reshape((b.shape[-2], -1))\n182 |             ret = a @ b_2d\n183 |             ret = ret.reshape(a.shape[0], *b_.shape[1:])\n184 |         elif sparse.issparse(b):\n185 |             # sparse is always 2D. Implies a is 3D+\n186 |             # [k, ..., l, m] @ [i, j] -> [k, ..., l, j]\n187 |             a_2d = a.reshape(-1, a.shape[-1])\n188 |             ret = a_2d @ b\n189 |             ret = ret.reshape(*a.shape[:-1], b.shape[1])\n190 |         else:\n191 |             ret = np.dot(a, b)\n192 |     else:\n193 |         ret = a @ b\n194 | \n195 |     if (\n196 |         sparse.issparse(a)\n197 |         and sparse.issparse(b)\n198 |         and dense_output\n199 |         and hasattr(ret, \"toarray\")\n200 |     ):\n201 |         return ret.toarray()\n202 |     return ret\n```\n\nFound function `sklearn/metrics/pairwise.py:paired_distances`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1165 | def paired_distances(X, Y, *, metric=\"euclidean\", **kwds):\n1166 |     \"\"\"\n1167 |     Compute the paired distances between X and Y.\n1168 | \n1169 |     Compute the distances between (X[0], Y[0]), (X[1], Y[1]), etc...\n1170 | \n1171 |     Read more in the :ref:`User Guide <metrics>`.\n1172 | \n1173 |     Parameters\n1174 |     ----------\n1175 |     X : ndarray of shape (n_samples, n_features)\n1176 |         Array 1 for distance computation.\n1177 | \n1178 |     Y : ndarray of shape (n_samples, n_features)\n1179 |         Array 2 for distance computation.\n1180 | \n1181 |     metric : str or callable, default=\"euclidean\"\n1182 |         The metric to use when calculating distance between instances in a\n1183 |         feature array. If metric is a string, it must be one of the options\n1184 |         specified in PAIRED_DISTANCES, including \"euclidean\",\n1185 |         \"manhattan\", or \"cosine\".\n1186 |         Alternatively, if metric is a callable function, it is called on each\n1187 |         pair of instances (rows)