_name]\n462 |                     wks = self.book.create_sheet(sheet_name, target_index)\n463 |                 elif self._if_sheet_exists == \"error\":\n464 |                     raise ValueError(\n465 |                         f\"Sheet '{sheet_name}' already exists and \"\n466 |                         f\"if_sheet_exists is set to 'error'.\"\n467 |                     )\n468 |                 elif self._if_sheet_exists == \"overlay\":\n469 |                     wks = self.sheets[sheet_name]\n470 |                 else:\n471 |                     raise ValueError(\n472 |                         f\"'{self._if_sheet_exists}' is not valid for if_sheet_exists. \"\n473 |                         \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n474 |                     )\n475 |             else:\n476 |                 wks = self.sheets[sheet_name]\n477 |         else:\n478 |             wks = self.book.create_sheet()\n479 |             wks.title = sheet_name\n480 | \n481 |         if validate_freeze_panes(freeze_panes):\n482 |             freeze_panes = cast(tuple[int, int], freeze_panes)\n483 |             wks.freeze_panes = wks.cell(\n484 |                 row=freeze_panes[0] + 1, column=freeze_panes[1] + 1\n485 |             )\n486 | \n487 |         for cell in cells:\n488 |             xcell = wks.cell(\n489 |                 row=startrow + cell.row + 1, column=startcol + cell.col + 1\n490 |             )\n491 |             xcell.value, fmt = self._value_with_fmt(cell.val)\n492 |             if fmt:\n493 |                 xcell.number_format = fmt\n494 | \n495 |             style_kwargs: dict[str, Serialisable] | None = {}\n496 |             if cell.style:\n497 |                 key = str(cell.style)\n498 |                 style_kwargs = _style_cache.get(key)\n499 |                 if style_kwargs is None:\n500 |                     style_kwargs = self._convert_to_style_kwargs(cell.style)\n501 |                     _style_cache[key] = style_kwargs\n502 | \n503 |             if style_kwargs:\n504 |                 for k, v in style_kwargs.items():\n505 |                     setattr(xcell, k, v)\n506 | \n507 |             if cell.mergestart is not None and cell.mergeend is not None:\n508 |                 wks.merge_cells(\n509 |                     start_row=startrow + cell.row + 1,\n510 |                     start_column=startcol + cell.col + 1,\n511 |                     end_column=startcol + cell.mergeend + 1,\n512 |                     end_row=startrow + cell.mergestart + 1,\n513 |                 )\n514 | \n515 |                 # When cells are merged only the top-left cell is preserved\n516 |                 # The behaviour of the other cells in a merged range is\n517 |                 # undefined\n518 |                 if style_kwargs:\n519 |                     first_row = startrow + cell.row + 1\n520 |                     last_row = startrow + cell.mergestart + 1\n521 |                     first_col = startcol + cell.col + 1\n522 |                     last_col = startcol + cell.mergeend + 1\n523 | \n524 |                     for row in range(first_row, last_row + 1):\n525 |                         for col in range(first_col, last_col + 1):\n526 |                             if row == first_row and col == first_col:\n527 |                                 # Ignore first cell. It is already handled.\n528 |                                 continue\n529 |                             xcell = wks.cell(column=col, row=row)\n530 |                             for k, v in style_kwargs.items():\n531 |                                 setattr(xcell, k, v)\n```\n\nFound file `asv_bench/benchmarks/join_merge.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `asv_bench/benchmarks/join_merge.py` for the full content if needed.\n"}, {"content": "Let me check the implementation of ExcelFormatter since it's responsible for handling the merge_cells functionality:\n\n<function=search_code_snippets>\n<par