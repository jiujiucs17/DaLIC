         # Ignore 100 first steps or 1 epoch to avoid initializing the ewa_cost with a\n2172 |         # too bad value\n2173 |         if step <= min(100, n_samples / batch_size):\n2174 |             if self.verbose:\n2175 |                 print(f\"Minibatch step {step}/{n_steps}: mean batch cost: {batch_cost}\")\n2176 |             return False\n2177 | \n2178 |         # Compute an Exponentially Weighted Average of the cost function to\n2179 |         # monitor the convergence while discarding minibatch-local stochastic\n2180 |         # variability: https://en.wikipedia.org/wiki/Moving_average\n2181 |         if self._ewa_cost is None:\n2182 |             self._ewa_cost = batch_cost\n2183 |         else:\n2184 |             alpha = batch_size / (n_samples + 1)\n2185 |             alpha = min(alpha, 1)\n2186 |             self._ewa_cost = self._ewa_cost * (1 - alpha) + batch_cost * alpha\n2187 | \n2188 |         if self.verbose:\n2189 |             print(\n2190 |                 f\"Minibatch step {step}/{n_steps}: mean batch cost: \"\n2191 |                 f\"{batch_cost}, ewa cost: {self._ewa_cost}\"\n2192 |             )\n2193 | \n2194 |         # Early stopping based on change of dictionary\n2195 |         dict_diff = linalg.norm(new_dict - old_dict) / self._n_components\n2196 |         if self.tol > 0 and dict_diff <= self.tol:\n2197 |             if self.verbose:\n2198 |                 print(f\"Converged (small dictionary change) at step {step}/{n_steps}\")\n2199 |             return True\n2200 | \n2201 |         # Early stopping heuristic due to lack of improvement on smoothed\n2202 |         # cost function\n2203 |         if self._ewa_cost_min is None or self._ewa_cost < self._ewa_cost_min:\n2204 |             self._no_improvement = 0\n2205 |             self._ewa_cost_min = self._ewa_cost\n2206 |         else:\n2207 |             self._no_improvement += 1\n2208 | \n2209 |         if (\n2210 |             self.max_no_improvement is not None\n2211 |             and self._no_improvement >= self.max_no_improvement\n2212 |         ):\n2213 |             if self.verbose:\n2214 |                 print(\n2215 |                     \"Converged (lack of improvement in objective function) \"\n2216 |                     f\"at step {step}/{n_steps}\"\n2217 |                 )\n2218 |             return True\n2219 | \n2220 |         return False\n```\n\n\n\n##Searching for term \"Online\"...\n### Search Result:\nFound code snippet in file `examples/cluster/plot_dict_face_patches.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | Online learning of a dictionary of parts of faces\n 3 | =================================================\n 4 | \n 5 | This example uses a large dataset of faces to learn a set of 20 x 20\n 6 | images patches that constitute faces.\n 7 | \n 8 | From the programming standpoint, it is interesting because it shows how\n 9 | to use the online API of the scikit-learn to process a very large\n10 | dataset by chunks. The way we proceed is that we load an image at a time\n11 | and extract randomly 50 patches from this image. Once we have accumulated\n12 | 500 of these patches (using 10 images), we run the\n13 | :func:`~sklearn.cluster.MiniBatchKMeans.partial_fit` method\n14 | of the online KMeans object, MiniBatchKMeans.\n15 | \n16 | The verbose setting on the MiniBatchKMeans enables us to see that some\n17 | clusters are reassigned during the successive calls to\n18 | partial-fit. This is because the number of patches that they represent\n19 | has become too low, and it is better to choose a random new\n20 | cluster.\n21 | \n22 | \"\"\"\n23 | \n24 | # %%\n25 | # Load the data\n26 | # -------------\n27 | \n28 | from sklearn import datasets\n29 | \n30 | faces = datasets.fetch_olivetti_faces()\n31 | \n32 | # %%\n33 | # Learn the dictionary of images\n34 | # ------------------------------\n35 | \n36 | import time\n37 | \n38 | import numpy as np\n39 | \n40 | from sklearn.cluster import MiniBatchKMeans\n41 | from sklearn.feature_extraction.image import extract_patches_2d\n42 | \n43 | print(\"Learning the dictionary... \")\n44 | rng = np.random.RandomState(0)\n45 | kmeans = MiniBatchKMeans(n_clusters=81, random_state=rng, verbose=True)\n46 | patch_size = (20, 20)\n47 | \n48 | buffer = []\n49 | t0 = time.time()\n50 | \n51 | # The online learning part: cycle over the whole dataset 6 times\n52 | index = 0\n53 | for _ in range(6):\n54 |     for img in faces.images:\n55 |         data = extract_patches_2d(img, patch_size, max_patches=50, random_state=rng)\n56 |         data = np.reshape(data, (len(data), -1))\n57 |         buffer.append(data)\n58 |         index += 1\n59 |         if index % 10 == 0:\n60 |             data = np.concatenate(buffer, axis=0)\n61 |             data -= np.mean(data, axis=0)\n62 |             data /= np.std(data, axis=0)\n63 |             kmeans.partial_fit(data)\n64 |             buffer = []\n65 |         if index % 100 == 0:\n66 |             print(\"Partial fit of %4i out of %i\" % (index, 6 * len(faces.images)))\n67 | \n68 | dt = time.time() - t0\n69 | print(\"done in %.2fs.\" % dt)\n70 | \n71 | # %%\n72 | # Plot the results\n73 | # ----------------\n74 | \n75 | import matplotlib.pyplot as plt\n```\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation._em_step`.\nSource: Retrieved code content using keyword search (bm25).\n```\n475 | def _em_step(self, X, total_samples, batch_update, parallel=None):\n476 |         \"\"\"EM update for 1 iteration.\n477 | \n478 |         update `_component` by batch VB or online VB.\n479 | \n480 |         Parameters\n481 |         ----------\n482 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n483 |             Document word matrix.\n484 | \n485 |         total_samples : int\n486 |             Total number of documents. It is only used when\n487 |             batch_update is `False`.\n488 | \n489 |         batch_update : bool\n490 |             Parameter that controls updating method.\n491 |             `True` for batch learning, `False` for online learning.\n492 | \n493 |         parallel : joblib.Parallel, default=None\n494 |             Pre-initialized instance of joblib.Parallel\n495 | \n496 |         Returns\n497 |         -------\n498 |         doc_topic_distr : ndarray of shape (n_samples, n_components)\n499 |             Unnormalized document topic distribution.\n500 |         \"\"\"\n501 | \n502 |         # E-step\n503 |         _, suff_stats = self._e_step(\n504 |             X, cal_sstats=True, random_init=True, parallel=parallel\n505 |         )\n506 | \n507 |         # M-step\n508 |         if batch_update:\n509 |             self.components_ = self.topic_word_prior_ + suff_stats\n510 |         else:\n511 |             # online update\n512 |             # In the literature, the weight is `rho`\n513 |             weight = np.power(\n514 |                 self.learning_offset + self.n_batch_iter_, -self.learning_decay\n515 |             )\n516 |             doc_ratio = float(total_samples) / X.shape[0]\n517 |             self.components_ *= 1 - weight\n518 |             self.components_ += weight * (\n519 |                 self.topic_word_prior_ + doc_ratio * suff_stats\n520 |             )\n521 | \n522 |         # update `component_` related variables\n523 |         self.exp_dirichlet_component_ = np.exp(\n524 |             _dirichlet_expectation_2d(self.components_)\n525 |         )\n526 |         self.n_batch_iter_ += 1\n527 |         return\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:_update_dict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n415 | def _update_dict(\n416 |     dictionary,\n417 |     Y,\n418 |     code,\n419 |     A=None,\n420 |     B=None,\n421 |     verbose=False,\n422 |     random_state=None,\n423 |     positive=False,\n424 | ):\n425 |     \"\"\"Update the dense dictionary factor in place.\n426 | \n427 |     Parameters\n428 |     ----------\n429 |     dictionary : ndarray of shape (n_components, n_features)\n430 |         Value of the dictionary at the previous iteration.\n431 | \n432 |     Y : ndarray of shape (n_samples, n_features)\n433 |         Data matrix.\n434 | \n435 |     code : ndarray of shape (n_samples, n_components)\n436 |         Sparse coding of the data against which to optimize the dictionary.\n437 | \n438 |     A : ndarray of shape (n_components, n_components), default=None\n439 |         Together with `B`, sufficient stats of the online model to update the\n440 |         dictionary.\n441 | \n442 |     B : ndarray of shape (n_features, n_components), default=None\n443 |         Together with `A`, sufficient stats of the online model to update the\n444 |         dictionary.\n445 | \n446 |     verbose: bool, default=False\n447 |         Degree of output the procedure will print.\n448 | \n449 |     random_state : int, RandomState instance or None, default=None\n450 |         Used for randomly initializing the dictionary. Pass an int for\n451 |         reproducible results across multiple function calls.\n452 |         See :term:`Glossary <random_state>`.\n453 | \n454 |     positive : bool, default=False\n455 |         Whether to enforce positivity when finding the dictionary.\n456 | \n457 |         .. versionadded:: 0.20\n458 |     \"\"\"\n459 |     n_samples, n_components = code.shape\n460 |     random_state = check_random_state(random_state)\n461 | \n462 |     if A is None:\n463 |         A = code.T @ code\n464 |     if B is None:\n465 |         B = Y.T @ code\n466 | \n467 |     n_unused = 0\n468 | \n469 |     for k in range(n_components):\n470 |         if A[k, k] > 1e-6:\n471 |             # 1e-6 is arbitrary but consistent with the spams implementation\n472 |             dictionary[k] += (B[:, k] - A[k] @ dictionary) / A[k, k]\n473 |         else:\n474 |             # kth atom is almost never used -> sample a new one from the data\n475 |             newd = Y[random_state.choice(n_samples)]\n476 | \n477 |             # add small noise to avoid making the sparse coding ill conditioned\n478 |             noise_level = 0.01 * (newd.std() or 1)  # avoid 0 std\n479 |             noise = random_state.normal(0, noise_level, size=len(newd))\n480 | \n481 |             dictionary[k] = newd + noise\n482 |             code[:, k] = 0\n483 |             n_unused += 1\n484 | \n485 |         if positive:\n486 |             np.clip(dictionary[k], 0, None, out=dictionary[k])\n487 | \n488 |         # Projection on the constraint set ||V_k|| <= 1\n489 |         dictionary[k] /= max(linalg.norm(dictionary[k]), 1)\n490 | \n491 |     if verbose and n_unused > 0:\n492 |         print(f\"{n_unused} unused atoms resampled.\")\n```\n\nFound file `sklearn/ensemble/__init__.py`.\nFound file `sklearn/externals/__init__.py`.\nFound file `sklearn/pipeline.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"Online\", \"learning_method\", \"MiniBatch Online learning_method\"...\n### Search Result:\nFound class `sklearn/decomposition/_lda.py:LatentDirichletAllocation`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass LatentDirichletAllocation(\n    _ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator\n):\n\n    def __init__(\n        self,\n        n_components=10,\n        *,\n        doc_topic_prior=None,\n        topic_word_prior=None,\n        learning_method=\"batch\",\n        learning_decay=0.7,\n        learning_offset=10.0,\n        max_iter=10,\n        batch_size=128,\n        evaluate_every=-1,\n        total_samples=1e6,\n        perp_tol=1e-1,\n        mean_change_tol=1e-3,\n        max_doc_update_iter=100,\n        n_jobs=None,\n        verbose=0,\n        random_state=None,\n    ):\n...\n    def _check_params(self):\n...