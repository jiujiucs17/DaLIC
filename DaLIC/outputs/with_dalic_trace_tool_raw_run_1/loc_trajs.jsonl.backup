sic mode only:\n4963 |         # ensure there are margins to allow for the\n4964 |         # finite size of the symbols.  In v2.x, margins\n4965 |         # are present by default, so we disable this\n4966 |         # scatter-specific override.\n4967 |         if mpl.rcParams['_internal.classic_mode']:\n4968 |             if self._xmargin < 0.05 and x.size > 0:\n4969 |                 self.set_xmargin(0.05)\n4970 |             if self._ymargin < 0.05 and x.size > 0:\n4971 |                 self.set_ymargin(0.05)\n4972 | \n4973 |         self.add_collection(collection)\n4974 |         self._request_autoscale_view()\n4975 | \n4976 |         return collection\n```\n\nFound function `lib/matplotlib/pyplot.py:scatter`.\nSource: Match found for entity name `def scatter`.\n```\n3918 | def scatter(\n3919 |     x: float | ArrayLike,\n3920 |     y: float | ArrayLike,\n3921 |     s: float | ArrayLike | None = None,\n3922 |     c: ArrayLike | Sequence[ColorType] | ColorType | None = None,\n3923 |     marker: MarkerType | None = None,\n3924 |     cmap: str | Colormap | None = None,\n3925 |     norm: str | Normalize | None = None,\n3926 |     vmin: float | None = None,\n3927 |     vmax: float | None = None,\n3928 |     alpha: float | None = None,\n3929 |     linewidths: float | Sequence[float] | None = None,\n3930 |     *,\n3931 |     edgecolors: Literal[\"face\", \"none\"] | ColorType | Sequence[ColorType] | None = None,\n3932 |     colorizer: Colorizer | None = None,\n3933 |     plotnonfinite: bool = False,\n3934 |     data=None,\n3935 |     **kwargs,\n3936 | ) -> PathCollection:\n3937 |     __ret = gca().scatter(\n3938 |         x,\n3939 |         y,\n3940 |         s=s,\n3941 |         c=c,\n3942 |         marker=marker,\n3943 |         cmap=cmap,\n3944 |         norm=norm,\n3945 |         vmin=vmin,\n3946 |         vmax=vmax,\n3947 |         alpha=alpha,\n3948 |         linewidths=linewidths,\n3949 |         edgecolors=edgecolors,\n3950 |         colorizer=colorizer,\n3951 |