ckle_kwargs : dict, optional\n644 |         Additional keyword arguments to pass to pickle.dump, excluding\n645 |         'protocol'. These are only useful when pickling objects in object\n646 |         arrays on Python 3 to Python 2 compatible format.\n647 | \n648 |     Raises\n649 |     ------\n650 |     ValueError\n651 |         If the array cannot be persisted. This includes the case of\n652 |         allow_pickle=False and array being an object array.\n653 |     Various other errors\n654 |         If the array contains Python objects as part of its dtype, the\n655 |         process of pickling them may raise various errors if the objects\n656 |         are not picklable.\n657 | \n658 |     \"\"\"\n659 |     _check_version(version)\n660 |     _write_array_header(fp, header_data_from_array_1_0(array), version)\n661 | \n662 |     if array.itemsize == 0:\n663 |         buffersize = 0\n664 |     else:\n665 |         # Set buffer size to 16 MiB to hide the Python loop overhead.\n666 |         buffersize = max(16 * 1024 ** 2 // array.itemsize, 1)\n667 | \n668 |     if array.dtype.hasobject:\n669 |         # We contain Python objects so we cannot write out the data\n670 |         # directly.  Instead, we will pickle it out\n671 |         if not allow_pickle:\n672 |             raise ValueError(\"Object arrays cannot be saved when \"\n673 |                              \"allow_pickle=False\")\n674 |         if pickle_kwargs is None:\n675 |             pickle_kwargs = {}\n676 |         pickle.dump(array, fp, protocol=3, **pickle_kwargs)\n677 |     elif array.flags.f_contiguous and not array.flags.c_contiguous:\n678 |         if isfileobj(fp):\n679 |             array.T.tofile(fp)\n680 |         else:\n681 |             for chunk in numpy.nditer(\n682 |                     array, flags=['external_loop', 'buffered', 'zerosize_ok'],\n683 |                     buffersize=buffersize, order='F'):\n684 |                 fp.write(chunk.tobytes('C'))\n685 |     else:\n686 |      