eturn\n482 | \n483 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n484 |     all_nans = np.flatnonzero(invalid)\n485 | \n486 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n487 |     if first_valid_index is None:  # no nan found in start\n488 |         first_valid_index = 0\n489 |     start_nans = np.arange(first_valid_index)\n490 | \n491 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n492 |     if last_valid_index is None:  # no nan found in end\n493 |         last_valid_index = len(yvalues)\n494 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n495 | \n496 |     # preserve_nans contains indices of invalid values,\n497 |     # but in this case, it is the final set of indices that need to be\n498 |     # preserved as NaN after the interpolation.\n499 | \n500 |     # For example if limit_direction='forward' then preserve_nans will\n501 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n502 |     # are more than 'limit' away from the prior non-NaN.\n503 | \n504 |     # set preserve_nans based on direction using _interp_limit\n505 |     if limit_direction == \"forward\":\n506 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n507 |     elif limit_direction == \"backward\":\n508 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n509 |     else:\n510 |         # both directions... just use _interp_limit\n511 |         preserve_nans = np.unique(_interp_limit(invalid, limit, limit))\n512 | \n513 |     # if limit_area is set, add either mid or outside indices\n514 |     # to preserve_nans GH #16284\n515 |     if limit_area == \"inside\":\n516 |         # preserve NaNs on the outside\n517 |         preserve_nans = np.union1d(preserve_nans, start_nans)\n518 |         preserve_nans = np.union1d(preserve_nans, end_nans)\n519 |     elif limit_area == \"outside\":\n520 |         # preserve NaNs on the inside\n521 |         mid_nans = np.setdiff1d(all_nans, start_nans, assume_unique=True)\n522 |         mid_nans = np.setdiff1d(mid_nans, end_nans, assume_unique=True)\n523 |         preserve_nans = np.union1d(preserve_nans, mid_nans)\n524 | \n525 |     is_datetimelike = yvalues.dtype.kind in \"mM\"\n526 | \n527 |     if is_datetimelike:\n528 |         yvalues = yvalues.view(\"i8\")\n529 | \n530 |     if method in NP_METHODS:\n531 |         # np.interp requires sorted X values, #21037\n532 | \n533 |         indexer = np.argsort(indices[valid])\n534 |         yvalues[invalid] = np.interp(\n535 |             indices[invalid], indices[valid][indexer], yvalues[valid][indexer]\n536 |         )\n537 |     else:\n538 |         yvalues[invalid] = _interpolate_scipy_wrapper(\n539 |             indices[valid],\n540 |             yvalues[valid],\n541 |             indices[invalid],\n542 |             method=method,\n543 |             fill_value=fill_value,\n544 |             bounds_error=bounds_error,\n545 |             order=order,\n546 |             **kwargs,\n547 |         )\n548 | \n549 |     if mask is not None:\n550 |         mask[:] = False\n551 |         mask[preserve_nans] = True\n552 |     elif is_datetimelike:\n553 |         yvalues[preserve_nans] = NaT.value\n554 |     else:\n555 |         yvalues[preserve_nans] = np.nan\n556 |     return\n```\n\nFound function `pandas/core/missing.py:_interp_limit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1038 | def _interp_limit(\n1039 |     invalid: npt.NDArray[np.bool_], fw_limit: int | None, bw_limit: int | None\n1040 | ) -> np.ndarray:\n1041 |     \"\"\"\n1042 |     Get indexers of values that won't be filled\n1043 |     because they exceed the limits.\n1044 | \n1045 |     Parameters\n1046 |     ----------\n1047 |     invalid : np.ndarray[bool]\n1048 |     fw_limit : int or None\n1049 |         forward limit to index\n1050 |     bw_limit : int or None\n1051 |         backward limit to index\n1052 | \n1053 |     Returns\n1054 |     -------\n1055 |     set of indexers\n1056 | \n1057 |     Notes\n1058 |     -----\n1059 |     This is equivalent to the more readable, but slower\n1060 | \n1061 |     .. code-block:: python\n1062 | \n1063 |         def _interp_limit(invalid, fw_limit, bw_limit):\n1064 |             for x in np.where(invalid)[0]:\n1065 |                 if invalid[max(0, x - fw_limit) : x + bw_limit + 1].all():\n1066 |                     yield x\n1067 |     \"\"\"\n1068 |     # handle forward first; the backward direction is the same except\n1069 |     # 1. operate on the reversed array\n1070 |     # 2. subtract the returned indices from N - 1\n1071 |     N = len(invalid)\n1072 |     f_idx = np.array([], dtype=np.int64)\n1073 |     b_idx = np.array([], dtype=np.int64)\n1074 |     assume_unique = True\n1075 | \n1076 |     def inner(invalid, limit: int):\n1077 |         limit = min(limit, N)\n1078 |         windowed = np.lib.stride_tricks.sliding_window_view(invalid, limit + 1).all(1)\n1079 |         idx = np.union1d(\n1080 |             np.where(windowed)[0] + limit,\n1081 |             np.where((~invalid[: limit + 1]).cumsum() == 0)[0],\n1082 |         )\n1083 |         return idx\n1084 | \n1085 |     if fw_limit is not None:\n1086 |         if fw_limit == 0:\n1087 |             f_idx = np.where(invalid)[0]\n1088 |             assume_unique = False\n1089 |         else:\n1090 |             f_idx = inner(invalid, fw_limit)\n1091 | \n1092 |     if bw_limit is not None:\n1093 |         if bw_limit == 0:\n1094 |             # then we don't even need to care about backwards\n1095 |             # just use forwards\n1096 |             return f_idx\n1097 |         else:\n1098 |             b_idx = N - 1 - inner(invalid[::-1], bw_limit)\n1099 |             if fw_limit == 0:\n1100 |                 return b_idx\n1101 | \n1102 |     return np.intersect1d(f_idx, b_idx, assume_unique=assume_unique)\n```\n\nFound function `pandas/core/interchange/column.py:PandasColumn