ode=True, minor_locator=False, plot_obj=subplot\n319 |         )\n320 |         minformatter = TimeSeries_DateFormatter(\n321 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n322 |         )\n323 |         subplot.xaxis.set_major_formatter(majformatter)\n324 |         subplot.xaxis.set_minor_formatter(minformatter)\n325 | \n326 |         # x and y coord info\n327 |         subplot.format_coord = functools.partial(_format_coord, freq)\n328 | \n329 |     elif isinstance(index, ABCTimedeltaIndex):\n330 |         subplot.xaxis.set_major_formatter(TimeSeries_TimedeltaFormatter())\n331 |     else:\n332 |         raise TypeError(\"index type not supported\")\n333 | \n334 |     pylab.draw_if_interactive()\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |  