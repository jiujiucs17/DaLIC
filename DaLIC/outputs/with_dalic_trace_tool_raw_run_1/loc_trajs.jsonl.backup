\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_components.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_saga.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_hierarchical.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_random_projections.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_samples.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_lof.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_glmnet.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_text_vectorizers.py\n\u2502               \u2514\u2500\u2500 contains \u2500\u2500 benchmarks/bench_glm.py\n\u251c\u2500\u2500 contains \u2500\u2500 build_tools\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 build_tools/generate_authors_table.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 build_tools/github\n\u2502               \u2514\u2500\u2500 contains \u2500\u2500 build_tools/circle\n\u2514\u2500\u2500 contains \u2500\u2500 doc\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/conftest.py\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/conf.py\n                \u251c\u2500\u2500 contains \u2500\u2500 doc/tutorial\n                \u2514\u2500\u2500 contains \u2500\u2500 doc/sphinxext\n"}, {"content": "Based on the problem statement, we're looking for visualization functionality related to calibration curves. Let me search for relevant files and code:\n\n<function=search_code_snippets>\n<parameter=search_terms>['calibration_curve', 'plot_calibration']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"calibration_curve\"...\n### Search Result:\nFound function `sklearn/calibration.py:calibration_curve`.\nSource: Match found for entity name `calibration_curve`.\n```\n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n\n##Searching for term \"plot_calibration\"...\n### Search Result:\nFound file `examples/calibration/plot_calibration.py`.\nSource: Match found for entity name `plot_calibration`.\nJust show the structure of this file due to response length limitations:\n```\n\n\nn_samples = 50000\nn_bins = 3  # use 3 bins for calibration_curve as we have 3 clusters here\n\n# Generate 3 blobs with 2 classes where the second blob contains\n# half positive samples and half negative samples. Probability in this\n# blob is therefore 0.5.\ncenters = [(-5, -5), (0, 0), (5, 5)]\nX, y = make_blobs(n_samples=n_samples, centers=centers, shuffle=False,\n                  random_state=42)\n\ny[:n_samples // 2] = 0\ny[n_samples // 2:] = 1\nsample_weight = np.random.RandomState(42).rand(y.shape[0])\n\n# split train, test for calibration\nX_train, X_test, y_train, y_test, sw_train, sw_test = \\\n    train_test_split(X, y, sample_weight, test_size=0.9, random_state=42)\n\n# Gaussian Naive-Bayes with no calibration\nclf = GaussianNB()\nprob_pos_clf = clf.predict_proba(X_test)[:, 1]\n\n# Gaussian Naive-Bayes with isotonic calibration\nclf_isotonic = CalibratedClassifierCV(clf, cv=2, method='isotonic')\nprob_pos_isotonic = clf_isotonic.predict_proba(X_test)[:, 1]\n\n# Gaussian Naive-Bayes with sigmoid calibration\nclf_sigmoid = CalibratedClassifierCV(clf, cv=2, method='sigmoid')\nprob_pos_sigmoid = clf_sigmoid.predict_proba(X_test)[:, 1]\n\nclf_score = brier_score_loss(y_test, prob_pos_clf, sample_weight=sw_test)\n\nclf_isotonic_score = brier_score_loss(y_test, prob_pos_isotonic,\n                                      sample_weight=sw_test)\n\nclf_sigmoid_score = brier_score_loss(y_test, prob_pos_sigmoid,\n                                     sample_weight=sw_test)\ny_unique = np.unique(y)\ncolors = cm.rainbow(np.linspace(0.0, 1.0, y_unique.size))\norder = np.lexsort((prob_pos_clf, ))\n\n```\nHint: Search `examples/calibration/plot_calibration.py` to get the full content if needed.\n"}, {"content": "Let me also check for any plotting-related utilities:\n\n<function=search_code_snippets>\n<parameter=search_terms>['matplotlib', 'plot', 'seaborn']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/__init__.py:check_matplotlib_support\nsklearn/conftest.py:pyplot\nsklearn/conftest.py:pytest_configure\nsklearn/conftest.py:pytest_runtest_setup\nsklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay.plot\nsklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay.plot\nsklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay.__init__\ndoc/conf.py:impl:103\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_linnerud\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_linnerud\nsklearn/datasets/_base.py:load_boston\ndoc/conf.py:impl:103\nsklearn/utils/__init__.py:check_matplotlib_support\nsklearn/conftest.py:pyplot\nsklearn/conftest.py:pytest_configure\nsklearn/conftest.py:pytest_runtest_setup