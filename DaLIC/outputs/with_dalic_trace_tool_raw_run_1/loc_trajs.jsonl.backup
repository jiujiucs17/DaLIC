"Minibatch step {step}/{n_steps}: mean batch inertia: \"\n1864 |                 f\"{batch_inertia}, ewa inertia: {self._ewa_inertia}\"\n1865 |             )\n1866 | \n1867 |         # Early stopping based on absolute tolerance on squared change of\n1868 |         # centers position\n1869 |         if self._tol > 0.0 and centers_squared_diff <= self._tol:\n1870 |             if self.verbose:\n1871 |                 print(f\"Converged (small centers change) at step {step}/{n_steps}\")\n1872 |             return True\n1873 | \n1874 |         # Early stopping heuristic due to lack of improvement on smoothed\n1875 |         # inertia\n1876 |         if self._ewa_inertia_min is None or self._ewa_inertia < self._ewa_inertia_min:\n1877 |             self._no_improvement = 0\n1878 |             self._ewa_inertia_min = self._ewa_inertia\n1879 |         else:\n1880 |             self._no_improvement += 1\n1881 | \n1882 |         if (\n1883 |             self.max_no_improvement is not None\n1884 |             and self._no_improvement >= self.max_no_improvement\n1885 |         ):\n1886 |             if self.verbose:\n1887 |                 print(\n1888 |                     \"Converged (lack of improvement in inertia) at step \"\n1889 |                     f\"{step}/{n_steps}\"\n1890 |                 )\n1891 |             return True\n1892 | \n1893 |         return False\n```\n\nFound function `examples/applications/plot_out_of_core_classification.py:get_minibatch`.\nSource: Retrieved code content using keyword search (bm25).\n```\n212 | def get_minibatch(doc_iter, size, pos_class=positive_class):\n213 |     \"\"\"Extract a minibatch of examples, return a tuple X_text, y.\n214 | \n215 |     Note: size is before excluding invalid docs with no topics assigned.\n216 | \n217 |     \"\"\"\n218 |     data = [\n219 |         (\"{title}\\n\\n{body}\".format(**doc), pos_class in doc[\"topics\"])\n220 |         for doc in itertools.islice(doc_iter, size)\n221 |         if doc[\"topics\"