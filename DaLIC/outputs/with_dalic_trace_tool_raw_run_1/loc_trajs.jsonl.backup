n10877 |         of decimal places\n10878 | \n10879 |         >>> df.round(1)\n10880 |             dogs  cats\n10881 |         0   0.2   0.3\n10882 |         1   0.0   0.7\n10883 |         2   0.7   0.0\n10884 |         3   0.2   0.2\n10885 | \n10886 |         With a dict, the number of places for specific columns can be\n10887 |         specified with the column names as key and the number of decimal\n10888 |         places as value\n10889 | \n10890 |         >>> df.round({\"dogs\": 1, \"cats\": 0})\n10891 |             dogs  cats\n10892 |         0   0.2   0.0\n10893 |         1   0.0   1.0\n10894 |         2   0.7   0.0\n10895 |         3   0.2   0.0\n10896 | \n10897 |         Using a Series, the number of places for specific columns can be\n10898 |         specified with the column names as index and the number of\n10899 |         decimal places as value\n10900 | \n10901 |         >>> decimals = pd.Series([0, 1], index=[\"cats\", \"dogs\"])\n10902 |         >>> df.round(decimals)\n10903 |             dogs  cats\n10904 |         0   0.2   0.0\n10905 |         1   0.0   1.0\n10906 |         2   0.7   0.0\n10907 |         3   0.2   0.0\n10908 |         \"\"\"\n10909 |         from pandas.core.reshape.concat import concat\n10910 | \n10911 |         def _dict_round(df: DataFrame, decimals) -> Iterator[Series]:\n10912 |             for col, vals in df.items():\n10913 |                 try:\n10914 |                     yield _series_round(vals, decimals[col])\n10915 |                 except KeyError:\n10916 |                     yield vals\n10917 | \n10918 |         def _series_round(ser: Series, decimals: int) -> Series:\n10919 |             if is_integer_dtype(ser.dtype) or is_float_dtype(ser.dtype):\n10920 |                 return ser.round(decimals)\n10921 |             return ser\n10922 | \n10923 |         nv.validate_round(args, kwargs)\n10924 | \n10925 |         if isinstance(decimals, (dict, Series)):\n10926 |             if isinstance(decimals, Series) and not