en if the arrays in list_of columns have the wrong dtypes or content.\n3749 | \n3750 |     Parameters\n3751 |     ----------\n3752 |     list_of_columns : list of numpy arrays\n3753 |         List of arrays to be concatenated with sep;\n3754 |         these arrays may not contain NaNs!\n3755 |     sep : string\n3756 |         The separator string for concatenating the columns.\n3757 | \n3758 |     Returns\n3759 |     -------\n3760 |     nd.array\n3761 |         The concatenation of list_of_columns with sep.\n3762 |     \"\"\"\n3763 |     try:\n3764 |         result = cat_core(list_of_columns, sep)\n3765 |     except TypeError:\n3766 |         # if there are any non-string values (wrong dtype or hidden behind\n3767 |         # object dtype), np.sum will fail; catch and return with better message\n3768 |         for column in list_of_columns:\n3769 |             dtype = lib.infer_dtype(column, skipna=True)\n3770 |             if dtype not in [\"string\", \"empty\"]:\n3771 |                 raise TypeError(\n3772 |                     \"Concatenation requires list-likes containing only \"\n3773 |                     \"strings (or missing values). Offending values found in \"\n3774 |                     f\"column {dtype}\"\n3775 |                 ) from None\n3776 |     return result\n3777 | \n3778 | \n3779 | def cat_core(list_of_columns: list, sep: str):\n3780 |     \"\"\"\n3781 |     Auxiliary function for :meth:`str.cat`\n3782 | \n3783 |     Parameters\n3784 |     ----------\n3785 |     list_of_columns : list of numpy arrays\n3786 |         List of arrays to be concatenated with sep;\n3787 |         these arrays may not contain NaNs!\n3788 |     sep : string\n3789 |         The separator string for concatenating the columns.\n3790 | \n3791 |     Returns\n3792 |     -------\n3793 |     nd.array\n3794 |         The concatenation of list_of_columns with sep.\n3795 |     \"\"\"\n3796 |     if sep == \"\":\n3797 |         # no need to interleave sep if it is empty\n3798 |         arr_of_cols = np.asarray(list_of_columns, dtype=object)\n3799 |         return np.sum(arr_of_cols, axis=0)\n3800 |     list_with_sep = [sep] * (2 * len(list_of_columns) - 1)\n3801 |     list_with_sep[::2] = list_of_columns\n3802 |     arr_with_sep = np.asarray(list_with_sep, dtype=object)\n3803 |     return np.sum(arr_with_sep, axis=0)\n3804 | \n3805 | \n3806 | def _result_dtype(arr):\n3807 |     # workaround #27953\n3808 |     # ideally we just pass `dtype=arr.dtype` unconditionally, but this fails\n3809 |     # when the list of values is empty.\n3810 |     from pandas.core.arrays.string_ import StringDtype\n3811 | \n3812 |     if isinstance(arr.dtype, (ArrowDtype, StringDtype)):\n3813 |         return arr.dtype\n3814 |     return object\n3815 | \n3816 | \n3817 | def _get_single_group_name(regex: re.Pattern) -> Hashable:\n3818 |     if regex.groupindex:\n3819 |         return next(iter(regex.groupindex))\n3820 |     else:\n3821 |         return None\n3822 | \n3823 | \n3824 | def _get_group_names(regex: re.Pattern) -> list[Hashable] | range:\n3825 |     \"\"\"\n3826 |     Get named groups from compiled regex.\n3827 | \n3828 |     Unnamed groups are numbered.\n3829 | \n3830 |     Parameters\n3831 |     ----------\n3832 |     regex : compiled regex\n3833 | \n3834 |     Returns\n3835 |     -------\n3836 |     list of column labels\n3837 |     \"\"\"\n3838 |     rng = range(regex.groups)\n3839 |     names = {v: k for k, v in regex.groupindex.items()}\n3840 |     if not names:\n3841 |         return rng\n3842 |     result: list[Hashable] = [names.get(1 + i, i) for i in rng]\n3843 |     arr = np.array(result)\n3844 |     if arr.dtype.kind == \"i\" and lib.is_range_indexer(arr, len(arr)):\n3845 |         return rng\n3846 |     return result\n3847 | \n3848 | \n3849 | def str_extractall(arr, pat, flags: int = 0) -> DataFrame:\n3850 |     regex = re.compile(pat, flags=flags)\n3851 |     # the regex must contain capture groups.\n3852 |     if regex.groups == 0:\n3853 |         raise ValueError(\"pattern contains no capture groups\")\n3854 | \n3855 |     if isinstance(arr, ABCIndex):\n3856 |         arr = arr.to_series().reset_index(drop=True).astype(arr.dtype)\n3857 | \n3858 |     columns = _get_group_names(regex)\n3859 |     match_list = []\n3860 |     index_list = []\n3861 |     is_mi = arr.index.nlevels > 1\n3862 | \n3863 |     for subject_key, subject in arr.items():\n3864 |         if isinstance(subject, str):\n3865 |             if not is_mi:\n3866 |                 subject_key = (subject_key,)\n3867 | \n3868 |             for match_i, match_tuple in enumerate(regex.findall(subject)):\n3869 |                 if isinstance(match_tuple, str):\n3870 |                     match_tuple = (match_tuple,)\n3871 |                 na_tuple = [np.nan if group == \"\" else group for group in match_tuple]\n3872 |                 match_list.append(na_tuple)\n3873 |                 result_key = tuple(subject_key + (match_i,))\n3874 |                 index_list.append(result_key)\n3875 | \n3876 |     from pandas import MultiIndex\n3877 | \n3878 |     index = MultiIndex.from_tuples(index_list, names=arr.index.names + [\"match\"])\n3879 |     dtype = _result_dtype(arr)\n3880 | \n3881 |     result = arr._constructor_expanddim(\n3882 |         match_list, index=index, columns=columns, dtype=dtype\n3883 |     )\n3884 |     return result\n3885 | \n```\n"}, {"content": "Let me check for error handling related code:\n\n<function=search_code_snippets>\n<parameter=search_terms>['raise AttributeError', 'Invalid dtype']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\npandas/core/arrays/arrow/accessors.py:ArrowAccessor._is_valid_pyarrow_dtype\npandas/core/arrays/arrow/accessors.py:ArrowAccessor._pa_array\npandas/core/arrays/arrow/accessors.py:ArrowAccessor\npandas/core/arrays/arrow/accessors.py:ArrowAccessor.__init__\n