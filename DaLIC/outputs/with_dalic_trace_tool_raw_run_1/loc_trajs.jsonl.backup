         y : Ignored\n605 |             Not used, present here for API consistency by convention.\n606 | \n607 |         Returns\n608 |         -------\n609 |         self\n610 |             Fitted estimator.\n611 |         \"\"\"\n612 |         self._check_params()\n613 |         X = self._check_non_neg_array(\n614 |             X, reset_n_features=True, whom=\"LatentDirichletAllocation.fit\"\n615 |         )\n616 |         n_samples, n_features = X.shape\n617 |         max_iter = self.max_iter\n618 |         evaluate_every = self.evaluate_every\n619 |         learning_method = self.learning_method\n620 | \n621 |         batch_size = self.batch_size\n622 | \n623 |         # initialize parameters\n624 |         self._init_latent_vars(n_features)\n625 |         # change to perplexity later\n626 |         last_bound = None\n627 |         n_jobs = effective_n_jobs(self.n_jobs)\n628 |         with Parallel(n_jobs=n_jobs, verbose=max(0, self.verbose - 1)) as parallel:\n629 |             for i in range(max_iter):\n630 |                 if learning_method == \"online\":\n631 |                     for idx_slice in gen_batches(n_samples, batch_size):\n632 |                         self._em_step(\n633 |                             X[idx_slice, :],\n634 |                             total_samples=n_samples,\n635 |                             batch_update=False,\n636 |                             parallel=parallel,\n637 |                         )\n638 |                 else:\n639 |                     # batch update\n640 |                     self._em_step(\n641 |                         X, total_samples=n_samples, batch_update=True, parallel=parallel\n642 |                     )\n643 | \n644 |                 # check perplexity\n645 |                 if evaluate_every > 0 and (i + 1) % evaluate_every == 0:\n646 |                     doc_topics_distr, _ = self._e_step(\n647 |                         X, cal_sstats=False, random_init=False, parallel=parallel\n648 |                     )\n649 |                     bound = self._perplexity_precomp_distr(\n650 |                         X, doc_topics_distr, sub_sampling=False\n651 |                     )\n652 |                     if self.verbose:\n653 |                         print(\n654 |                             \"iteration: %d of max_iter: %d, perplexity: %.4f\"\n655 |                             % (i + 1, max_iter, bound)\n656 |                         )\n657 | \n658 |                     if last_bound and abs(last_bound - bound) < self.perp_tol:\n659 |                         break\n660 |                     last_bound = bound\n661 | \n662 |                 elif self.verbose:\n663 |                     print(\"iteration: %d of max_iter: %d\" % (i + 1, max_iter))\n664 |                 self.n_iter_ += 1\n665 | \n666 |         # calculate final perplexity value on train set\n667 |         doc_topics_distr, _ = self._e_step(\n668 |             X, cal_sstats=False, random_init=False, parallel=parallel\n669 |         )\n670 |         self.bound_ = self._perplexity_precomp_distr(\n671 |             X, doc_topics_distr, sub_sampling=False\n672 |         )\n673 | \n674 |         return self\n```\n\n\n\n##Searching for term \"MiniBatch Online learning_method\"...\n### Search Result:\nFound function `sklearn/decomposition/_dict_learning.py:dict_learning_online`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 738 | def dict_learning_online(\n 739 |     X,\n 740 |     n_components=2,\n 741 |     *,\n 742 |     alpha=1,\n 743 |     n_iter=\"deprecated\",\n 744 |     max_iter=None,\n 745 |     return_code=True,\n 746 |     dict_init=None,\n 747 |     callback=None,\n 748 |     batch_size=\"warn\",\n 749 |     verbose=False,\n 750 |     shuffle=True,\n 751 |     n_jobs=None,\n 752 |     method=\"lars\",\n 753 |     iter_offset=\"deprecated\",\n 754 |     random_state=None,\n 755 |     return_inner_stats=\"deprecated\",\n 756 |     inner_stats=\"deprecated\",\n 757 |     return_n_iter=\"deprecated\",\n 758 |     positive_dict=False,\n 759 |     positive_code=False,\n 760 |     method_max_iter=1000,\n 761 |     tol=1e-3,\n 762 |     max_no_improvement=10,\n 763 | ):\n 764 |     \"\"\"Solves a dictionary learning matrix factorization problem online.\n 765 | \n 766 |     Finds the best dictionary and the corresponding sparse code for\n 767 |     approximating the data matrix X by solving::\n 768 | \n 769 |         (U^*, V^*) = argmin 0.5 || X - U V ||_Fro^2 + alpha * || U ||_1,1\n 770 |                      (U,V)\n 771 |                      with || V_k ||_2 = 1 for all  0 <= k < n_components\n 772 | \n 773 |     where V is the dictionary and U is the sparse code. ||.||_Fro stands for\n 774 |     the Frobenius norm and ||.||_1,1 stands for the entry-wise matrix norm\n 775 |     which is the sum of the absolute values of all the entries in the matrix.\n 776 |     This is accomplished by repeatedly iterating over mini-batches by slicing\n 777 |     the input data.\n 778 | \n 779 |     Read more in the :ref:`User Guide <DictionaryLearning>`.\n 780 | \n 781 |     Parameters\n 782 |     ----------\n 783 |     X : ndarray of shape (n_samples, n_features)\n 784 |         Data matrix.\n 785 | \n 786 |     n_components : int or None, default=2\n 787 |         Number of dictionary atoms to extract. If None, then ``n_components``\n 788 |         is set to ``n_features``.\n 789 | \n 790 |     alpha : float, default=1\n 791 |         Sparsity controlling parameter.\n 792 | \n 793 |     n_iter : int, default=100\n 794 |         Number of mini-batch iterations to perform.\n 795 | \n 796 |         .. deprecated:: 1.1\n 797 |            `n_iter` is deprecated in 1.1 and will be removed in 1.3. Use\n 798 |            `max_iter` instead.\n 799 | \n 800 |     max_iter : int, default=None\n 801 |         Maximum number of iterations over the complete dataset before\n 802 |         stopping independently of any early stopping criterion heuristics.\n 803 |         If ``max_iter`` is not None, ``n_iter`` is ignored.\n 804 | \n 805 |         .. versionadded:: 1.1\n 806 | \n 807 |     return_code : bool, default=True\n 808 |         Whether to also return the code U or just the dictionary `V`.\n 809 | \n 810 |     dict_init : ndarray of shape (n_components, n_features), default=None\n 811 |         Initial value for the dictionary for warm restart scenarios.\n 812 | \n 813 |     callback : callable, default=None\n 814 |         A callable that gets invoked at the end of each iteration.\n 815 | \n 816 |     batch_size : int, default=3\n 817 |         The number of samples to take in each batch.\n 818 | \n 819 |     verbose : bool, default=False\n 820 |         To control the verbosity of the procedure.\n 821 | \n 822 |     shuffle : bool, default=True\n 823 |         Whether to shuffle the data before splitting it in batches.\n 824 | \n 825 |     n_jobs : int, default=None\n 826 |         Number of parallel jobs to run.\n 827 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 828 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 829 |         for more details.\n 830 | \n 831 |     method : {'lars', 'cd'}, default='lars'\n 832 |         * `'lars'`: uses the least angle regression method to solve the lasso\n 833 |           problem (`linear_model.lars_path`);\n 834 |         * `'cd'`: uses the coordinate descent method to compute the\n 835 |           Lasso solution (`linear_model.Lasso`). Lars will be faster if\n 836 |           the estimated components are sparse.\n 837 | \n 838 |     iter_offset : int, default=0\n 839 |         Number of previous iterations completed on the dictionary used for\n 840 |         initialization.\n 841 | \n 842 |         .. deprecated:: 1.1\n 843 |            `iter_offset` serves internal purpose only and will be removed in 1.3.\n 844 | \n 845 |     random_state : int, RandomState instance or None, default=None\n 846 |         Used for initializing the dictionary when ``dict_init`` is not\n 847 |         specified, randomly shuffling the data when ``shuffle`` is set to\n 848 |         ``True``, and updating the dictionary. Pass an int for reproducible\n 849 |         results across multiple function calls.\n 850 |         See :term:`Glossary <random_state>`.\n 851 | \n 852 |     return_inner_stats : bool, default=False\n 853 |         Return the inner statistics A (dictionary covariance) and B\n 854 |         (data approximation). Useful to restart the algorithm in an\n 855 |         online setting. If `return_inner_stats` is `True`, `return_code` is\n 856 |         ignored.\n 857 | \n 858 |         .. deprecated:: 1.1\n 859 |            `return_inner_stats` serves internal purpose only and will be removed in 1.3.\n 860 | \n 861 |     inner_stats : tuple of (A, B) ndarrays, default=None\n 862 |         Inner sufficient statistics that are kept by the algorithm.\n 863 |         Passing them at initialization is useful in online settings, to\n 864 |         avoid losing the history of the evolution.\n 865 |         `A` `(n_components, n_components)` is the dictionary covariance matrix.\n 866 |         `B` `(n_features, n_components)` is the data approximation matrix.\n 867 | \n 868 |         .. deprecated:: 1.1\n 869 |            `inner_stats` serves internal purpose only and will be removed in 1.3.\n 870 | \n 871 |     return_n_iter : bool, default=False\n 872 |         Whether or not to return the number of iterations.\n 873 | \n 874 |         .. deprecated:: 1.1\n 875 |            `return_n_iter` will be removed in 1.3 and n_iter will always be returned.\n 876 | \n 877 |     positive_dict : bool, default=False\n 878 |         Whether to enforce positivity when finding the dictionary.\n 879 | \n 880 |         .. versionadded:: 0.20\n 881 | \n 882 |     positive_code : bool, default=False\n 883 |         Whether to enforce positivity when finding the code.\n 884 | \n 885 |         .. versionadded:: 0.20\n 886 | \n 887 |     method_max_iter : int, default=1000\n 888 |         Maximum number of iterations to perform when solving the lasso problem.\n 889 | \n 890 |         .. versionadded:: 0.22\n 891 | \n 892 |     tol : float, default=1e-3\n 893 |         Control early stopping based on the norm of the differences in the\n 894 |         dictionary between 2 steps. Used only if `max_iter` is not None.\n 895 | \n 896 |         To disable early stopping based on changes in the dictionary, set\n 897 |         `tol` to 0.0.\n 898 | \n 899 |         .. versionadded:: 1.1\n 900 | \n 901 |     max_no_improvement : int, default=10\n 902 |         Control early stopping based on the consecutive number of mini batches\n 903 |         that does not yield an improvement on the smoothed cost function. Used only if\n 904 |         `max_iter` is not None.\n 905 | \n 906 |         To disable convergence detection based on cost function, set\n 907 |         `max_no_improvement` to None.\n 908 | \n 909 |         .. versionadded:: 1.1\n 910 | \n 911 |     Returns\n 912 |     -------\n 913 |     code : ndarray of shape (n_samples, n_components),\n 914 |         The sparse code (only returned if `return_code=True`).\n 915 | \n 916 |     dictionary : ndarray of shape (n_components, n_features),\n 917 |         The solutions to the dictionary learning problem.\n 918 | \n 919 |     n_iter : int\n 920 |         Number of iterations run. Returned only if `return_n_iter` is\n 921 |         set to `True`.\n 922 | \n 923 |     See Also\n 924 |     --------\n 925 |     dict_learning\n 926 |     DictionaryLearning\n 927 |     MiniBatchDictionaryLearning\n 928 |     SparsePCA\n 929 |     MiniBatchSparsePCA\n 930 |     \"\"\"\n 931 |     deps = (return_n_iter, return_inner_stats, iter_offset, inner_stats)\n 932 |     if max_iter is not None and not all(arg == \"deprecated\" for arg in deps):\n 933 |         raise ValueError(\n 934 |             \"The following arguments are incompatible with 'max_iter': \"\n 935 |             \"return_n_iter, return_inner_stats, iter_offset, inner_stats\"\n 936 |         )\n 937 | \n 938 |     iter_offset = _check_warn_deprecated(iter_offset, \"iter_offset\", default=0)\n 939 |     return_inner_stats = _check_warn_deprecated(\n 940 |         return_inner_stats,\n 941 |         \"return_inner_stats\",\n 942 |         default=False,\n 943 |         additional_message=\"From 1.3 inner_stats will never be returned.\",\n 944 |     )\n 945 |     inner_stats = _check_warn_deprecated(inner_stats, \"inner_stats\", default=None)\n 946 |     return_n_iter = _check_warn_deprecated(\n 947 |         return_n_iter,\n 948 |         \"return_n_iter\",\n 949 |         default=False,\n 950 |         additional_message=(\n 951 |             \"From 1.3 'n_iter' will never be returned. Refer to the 'n_iter_' and \"\n 952 |             \"'n_steps_' attributes of the MiniBatchDictionaryLearning object instead.\"\n 953 |         ),\n 954 |     )\n 955 | \n 956 |     if max_iter is not None:\n 957 |         transform_algorithm = \"lasso_\" + method\n 958 | \n 959 |         est = MiniBatchDictionaryLearning(\n 960 |             n_components=n_components,\n 961 |             alpha=alpha,\n 962 |             n_iter=n_iter,\n 963 |             n_jobs=n_jobs,\n 964 |             fit_algorithm=method,\n 965 |             batch_size=batch_size,\n 966 |             shuffle=shuffle,\n 967 |             dict_init=dict_init,\n 968 |             random_state=random_state,\n 969 |             transform_algorithm=transform_algorithm,\n 970 |             transform_alpha=alpha,\n 971 |             positive_code=positive_code,\n 972 |             positive_dict=positive_dict,\n 973 |             transform_max_iter=method_max_iter,\n 974 |             verbose=verbose,\n 975 |             callback=callback,\n 976 |             tol=tol,\n 977 |             max_no_improvement=max_no_improvement,\n 978 |         ).fit(X)\n 979 | \n 980 |         if not return_code:\n 981 |             return est.components_\n 982 |         else:\n 983 |             code = est.transform(X)\n 984 |             return code, est.components_\n 985 | \n 986 |     # TODO remove the whole old behavior in 1.3\n 987 |     # Fallback to old behavior\n 988 | \n 989 |     n_iter = _check_warn_deprecated(\n 990 |         n_iter, \"n_iter\", default=100, additional_message=\"Use 'max_iter' instead.\"\n 991 |     )\n 992 | \n 993 |     if batch_size == \"warn\":\n 994 |         warnings.warn(\n 995 |             \"The default value of batch_size will change from 3 to 256 in 1.3.\",\n 996 |             FutureWarning,\n 997 |         )\n 998 |         batch_size = 3\n 999 | \n1000 |     if n_components is None:\n1001 |         n_components = X.shape[1]\n1002 | \n1003 |     if method not in (\"lars\", \"cd\"):\n1004 |         raise ValueError(\"Coding method not supported as a fit algorithm.\")\n1005 | \n1006 |     _check_positive_coding(method, positive_code)\n1007 | \n1008 |     method = \"lasso_\" + method\n1009 | \n1010 |     t0 = time.time()\n1011 |     n_samples, n_features = X.shape\n1012 |     # Avoid integer division problems\n1013 |     alpha = float(alpha)\n1014 |     random_state = check_random_state(random_state)\n1015 | \n1016 |     # Init V with SVD of X\n1017 |     if dict_init is not None:\n1018 |         dictionary = dict_init\n1019 |     else:\n1020 |         _, S, dictionary = randomized_svd(X, n_components, random_state=random_state)\n1021 |         dictionary = S[:, np.newaxis] * dictionary\n1022 |     r = len(dictionary)\n1023 |     if n_components <= r:\n1024 |         dictionary = dictionary[:n_components, :]\n1025 |     else:\n1026 |         dictionary = np.r_[\n1027 |             dictionary,\n1028 |             np.zeros((n_components - r, dictionary.shape[1]), dtype=dictionary.dtype),\n1029 |         ]\n1030 | \n1031 |     if verbose == 1:\n1032 |         print(\"[dict_learning]\", end=\" \")\n1033 | \n1034 |     if shuffle:\n1035 |         X_train = X.copy()\n1036 |         random_state.shuffle(X_train)\n1037 |     else:\n1038 |         X_train = X\n1039 | \n1040 |     X_train = check_array(\n1041 |         X_train, order=\"C\", dtype=[np.float64, np.float32], copy=False\n1042 |     )\n1043 | \n1044 |     # Fortran-order dict better suited for the sparse coding which is the\n1045 |     # bottleneck of this algorithm.\n1046 |     dictionary = check_array(dictionary, order=\"F\", dtype=X_train.dtype, copy=False)\n1047 |     dictionary = np.require(dictionary, requirements=\"W\")\n1048 | \n1049 |     batches = gen_batches(n_samples, batch_size)\n1050 |     batches = itertools.cycle(batches)\n1051 | \n1052 |     # The covariance of the dictionary\n1053 |     if inner_stats is None:\n1054 |         A = np.zeros((n_components, n_components), dtype=X_train.dtype)\n1055 |         # The data approximation\n1056 |         B = np.zeros((n_features, n_components), dtype=X_train.dtype)\n1057 |     else:\n1058 |         A = inner_stats[0].copy()\n1059 |         B = inner_stats[1].copy()\n1060 | \n1061 |     # If n_iter is zero, we need to return zero.\n1062 |     ii = iter_offset - 1\n1063 | \n1064 |     for ii, batch in zip(range(iter_offset, iter_offset + n_iter), batches):\n1065 |         this_X = X_train[batch]\n1066 |         dt = time.time() - t0\n1067 |         if verbose == 1:\n1068 |             sys.stdout.write(\".\")\n1069 |             sys.stdout.flush()\n1070 |         elif verbose:\n1071 |             if verbose > 10 or ii % ceil(100.0 / verbose) == 0:\n1072 |                 print(\n1073 |                     \"Iteration % 3i (elapsed time: % 3is, % 4.1fmn)\" % (ii, dt, dt / 60)\n1074 |                 )\n1075 | \n1076 |         this_code = sparse_encode(\n1077 |             this_X,\n1078 |             dictionary,\n1079 |             algorithm=method,\n1080 |             alpha=alpha,\n1081 |             n_jobs=n_jobs,\n1082 |             check_input=False,\n1083 |             positive=positive_code,\n1084 |             max_iter=method_max_iter,\n1085 |             verbose=verbose,\n1086 |         )\n1087 | \n1088 |         # Update the auxiliary variables\n1089 |         if ii < batch_size - 1:\n1090 |             theta = float((ii + 1) * batch_size)\n1091 |         else:\n1092 |             theta = float(batch_size**2 + ii + 1 - batch_size)\n1093 |         beta = (theta + 1 - batch_size) / (theta + 1)\n1094 | \n1095 |         A *= beta\n1096 |         A += np.dot(this_code.T, this_code)\n1097 |         B *= beta\n1098 |         B += np.dot(this_X.T, this_code)\n1099 | \n1100 |         # Update dictionary in place\n1101 |         _update_dict(\n1102 |             dictionary,\n1103 |             this_X,\n1104 |             this_code,\n1105 |             A,\n1106 |             B,\n1107 |             verbose=verbose,\n1108 |             random_state=random_state,\n1109 |             positive=positive_dict,\n1110 |         )\n1111 | \n1112 |         # Maybe we need a stopping criteria based on the amount of\n1113 |         # modification in the dictionary\n1114 |         if callback is not None:\n1115 |             callback(locals())\n1116 | \n1117 |     if return_inner_stats:\n1118 |         if return_n_iter:\n1119 |             return dictionary, (A, B), ii - iter_offset + 1\n1120 |         else:\n1121 |             return dictionary, (A, B)\n1122 |     if return_code:\n1123 |         if verbose > 1:\n1124 |             print(\"Learning code...\", end=\" \")\n1125 |         elif verbose == 1:\n1126 |             print(\"|\", end=\" \")\n1127 |         code = sparse_encode(\n1128 |             X,\n1129 |             dictionary,\n1130 |             algorithm=method,\n1131 |             alpha=alpha,\n1132 |             n_jobs=n_jobs,\n1133 |             check_input=False,\n1134 |             positive=positive_code,\n1135 |             max_iter=method_max_iter,\n1136 |             verbose=verbose,\n1137 |         )\n1138 |         if verbose > 1:\n1139 |             dt = time.time() - t0\n1140 |             print(\"done (total time: % 3is, % 4.1fmn)\" % (dt, dt / 60))\n1141 |         if return_n_iter:\n1142 |             return code, dictionary, ii - iter_offset + 1\n1143 |         else:\n1144 |             return code, dictionary\n1145 | \n1146 |     if return_n_iter:\n1147 |         return dictionary, ii - iter_offset + 1\n1148 |     else:\n1149 |         return dictionary\n```\n\nFound function `sklearn/ensemble/_stacking.py:_BaseStacking._method_name`.\nSource: Retrieved entity using keyword search (bm25).\n```\n121 | def _method_name(name, estimator, method):\n122 |         if estimator == \"drop\":\n123 |             return None\n124 |         if method == \"auto\":\n125 |             if getattr(estimator, \"predict_proba\", None):\n126 |                 return \"predict_proba\"\n127 |             elif getattr(estimator, \"decision_function\", None):\n128 |                 return \"decision_function\"\n129 |             else:\n130 |                 return \"predict\"\n131 |         else:\n132 |             if not hasattr(estimator, method):\n133 |                 raise ValueError(\n134 |                     \"Underlying estimator {} does not implement the method {}.\".format(\n135 |                         name, method\n136 |                     )\n137 |                 )\n138 |             return method\n```\n\nFound file `doc/tutorial/machine_learning_map/parse_path.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `doc/tutorial/machine_learning_map/parse_path.py` for the full content if needed.\n"}, {"content": "Based on my analysis of the codebase and the feature request, I'll now provide the locations that need to be considered for implementing online NMF. Here's my final output in the requested format:\n\n```\nsklearn/decomposition/_nmf.py\nline: 1120\nclass: NMF\nfunction: _more_tags\n# Note: Need to update tags to include online learning capability\n\nsklearn/decomposition/_nmf.py\nline: 1197\nline: 1206\n# Note: Current solver options ('cd', 'mu') need modification to support online learning\n\nsklearn/decomposition/_nmf.py\nline: 1346\nfunction: __init__\n# Note: Need to add new parameters for online learning:\n# - learning_method: 'batch' or 'online'\n# - evaluate_every: int, check frequency of convergence\n# - batch_size: int, number of samples to process at a time\n\nsklearn/decomposition/_nmf.py\nline: 1566\nfunction: _fit_transform\n# Note: Core function that needs modification to support online learning:\n# - Needs to process data in batches rather than full matrix\n# - Implement batch update logic similar to LDA's _em_step\n# - Track iteration progress and handle convergence\n\nsklearn/decomposition/_nmf.py\nline: 1618\n# Note: Add new branch for 'mu' solver to handle online learning:\n# - Modify the multiplicative update rule to work on batches\n# - Update regularization terms for online case\n```\n\nThe key areas identified are:\n\n1. The main NMF class in sklearn/decomposition/_nmf.py which is the core implementation that needs to be modified to support online learning.\n\n2. The initialization parameters need to be extended to support:\n   - learning_method: to specify batch vs online mode\n   - evaluate_every: to monitor convergence\n   - batch_size: to control batch size\n\n3. The core _fit_transform method needs significant modifications:\n   - Process data in batches rather than working with the full matrix\n   - Implement batch-specific update rules\n   - Track iteration progress and manage convergence monitoring\n\n4. The multiplicative update solver section needs to be modified to handle online learning scenario properly.\n\nThis implementation should allow users to train NMF models in an online manner similar to LatentDirichletAllocation, supporting the beta-divergence family of loss functions.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}, {"type": "function", "function": {"name": "get_trace_artifacts", "description": "\nRead a compact raw slice of DaLIC execution-trace artifacts for the current instance.\nThis tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\nIt does not rank or recommend results. It only applies exact filters and pagination.\n\nNote:\n'<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n- executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n- tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n- then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n\nArgs:\n- `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`. \n    If not specified, it defaults to `all` and does not filter by artifact type.\n- `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`. \n    If not specified, it defaults to `None` and does not filter by file path.\n- `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`. \n    If not specified, it defaults to `None` and does not filter by qualified name.\n- `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n- `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n\nReturns:\nA JSON string encoding an object with the following top-level fields:\n- `instance_id`: The current DaLIC instance id.\n- `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n- `applied_filters`: The effective filter and pagination values used for this call.\n- `artifacts`: A JSON array of matched artifacts.\n- `has_more`: Whether more matched artifacts are available after this slice.\n- `next_start`: The pagination offset to use for the next slice.\n\nEach artifact in `artifacts` is a JSON object with the following fields:\n- `qualified_name`: The qualified name of the artifact.\n- `path`: The compact file path where the artifact is defined.\n- `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n- `defined_line`: The line number where the artifact is defined.\n- `end_line`: The ending line number of the artifact, if available.\n- `event_count`: The number of matching execution events in trace A.\n- `call_count`: The number of calls observed in trace A.\n- `max_call_depth`: The maximum observed call depth for this artifact.\n\nUsage suggestions:\n- Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n- Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n", "parameters": {"type": "object", "properties": {"artifact_type": {"type": "string", "enum": ["all", "function", "method", "class"], "default": "all", "description": "Optional exact filter for artifact definition type."}, "path_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the compact file path.", "default": null}, "name_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the qualified name.", "default": null}, "start": {"type": "integer", "default": 0, "description": "Zero-based pagination offset."}, "limit": {"type": "integer", "default": 8, "description": "Maximum number of artifacts to return in this slice."}}, "required": []}}}], "usage": {"prompt_tokens": 137126, "completion_tokens": 738}, "time": 188.1463327407837}]}}
