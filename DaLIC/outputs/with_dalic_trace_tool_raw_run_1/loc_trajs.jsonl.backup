ration.py:impl:50\nexamples/calibration/plot_calibration.py:docstring:11\nexamples/calibration/plot_calibration_multiclass.py:imports:6\nexamples/calibration/plot_calibration_multiclass.py:impl:36\nexamples/calibration/plot_compare_calibration.py:impl:44\nexamples/calibration/plot_compare_calibration.py:impl\nexamples/linear_model/plot_poisson_regression_non_normal_loss.py:impl:88\nexamples/linear_model/plot_poisson_regression_non_normal_loss.py:impl:107\nsklearn/calibration.py:_CalibratedClassifier.__init__\nsklearn/calibration.py:_CalibratedClassifier.calibrators_\nsklearn/calibration.py:_CalibratedClassifier\nsklearn/calibration.py:_fit_calibrator\n##Searching for term \"calibration_curve\"...\n### Search Result:\nFound function `sklearn/calibration.py:calibration_curve`.\nSource: Match found for entity name `calibration_curve`.\n```\n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n\n##Searching for term \"plot calibration\"...\n### Search Result:\nFound function `benchmarks/bench_saga.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n238 | def plot(outname=None):\n239 |     import pandas as pd\n240 | \n241 |     with open(\"bench_saga.json\", \"r\") as f:\n242 |         f = json.load(f)\n243 |     res = pd.DataFrame(f)\n244 |     res.set_index([\"single_target\"], inplace=Tr