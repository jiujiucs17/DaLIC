 |     --------\n320 |     api.extensions.ExtensionArray\n321 |         An example of a pandas extension mechanism that requires implementing\n322 |         specific abstract methods.\n323 |     NotImplementedError\n324 |         A built-in exception that can also be used for abstract methods but lacks\n325 |         the specificity of `AbstractMethodError` in indicating the need for subclass\n326 |         implementation.\n327 | \n328 |     Examples\n329 |     --------\n330 |     >>> class Foo:\n331 |     ...     @classmethod\n332 |     ...     def classmethod(cls):\n333 |     ...         raise pd.errors.AbstractMethodError(cls, methodtype=\"classmethod\")\n334 |     ...\n335 |     ...     def method(self):\n336 |     ...         raise pd.errors.AbstractMethodError(self)\n337 |     >>> test = Foo.classmethod()\n338 |     Traceback (most recent call last):\n339 |     AbstractMethodError: This classmethod must be defined in the concrete class Foo\n340 | \n341 |     >>> test2 = Foo().method()\n342 |     Traceback (most recent call last):\n343 |     AbstractMethodError: This classmethod must be defined in the concrete class Foo\n344 |     \"\"\"\n345 | \n346 |     def __init__(self, class_instance, methodtype: str = \"method\") -> None:\n347 |         types = {\"method\", \"classmethod\", \"staticmethod\", \"property\"}\n348 |         if methodtype not in types:\n349 |             raise ValueError(\n350 |                 f\"methodtype must be one of {methodtype}, got {types} instead.\"\n351 |             )\n352 |         self.methodtype = methodtype\n353 |         self.class_instance = class_instance\n354 | \n355 |     def __str__(self) -> str:\n356 |         if self.methodtype == \"classmethod\":\n357 |             name = self.class_instance.__name__\n358 |         else:\n359 |             name = type(self.class_instance).__name__\n360 |         return f\"This {self.methodtype} must be defined in the concrete class {name}\"\n```\n\nFound class `pandas/errors/__init__.