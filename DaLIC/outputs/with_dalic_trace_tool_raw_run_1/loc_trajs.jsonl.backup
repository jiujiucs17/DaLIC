 are assigned equal weight.\n1929 | \n1930 |             .. versionadded:: 0.20\n1931 | \n1932 |         Returns\n1933 |         -------\n1934 |         self : object\n1935 |             Fitted estimator.\n1936 |         \"\"\"\n1937 |         X = self._validate_data(\n1938 |             X,\n1939 |             accept_sparse=\"csr\",\n1940 |             dtype=[np.float64, np.float32],\n1941 |             order=\"C\",\n1942 |             accept_large_sparse=False,\n1943 |         )\n1944 | \n1945 |         self._check_params(X)\n1946 |         random_state = check_random_state(self.random_state)\n1947 |         sample_weight = _check_sample_weight(sample_weight, X, dtype=X.dtype)\n1948 |         self._n_threads = _openmp_effective_n_threads()\n1949 |         n_samples, n_features = X.shape\n1950 | \n1951 |         # Validate init array\n1952 |         init = self.init\n1953 |         if _is_arraylike_not_scalar(init):\n1954 |             init = check_array(init, dtype=X.dtype, copy=True, order=\"C\")\n1955 |             self._validate_center_shape(X, init)\n1956 | \n1957 |         self._check_mkl_vcomp(X, self._batch_size)\n1958 | \n1959 |         # precompute squared norms of data points\n1960 |         x_squared_norms = row_norms(X, squared=True)\n1961 | \n1962 |         # Validation set for the init\n1963 |         validation_indices = random_state.randint(0, n_samples, self._init_size)\n1964 |         X_valid = X[validation_indices]\n1965 |         sample_weight_valid = sample_weight[validation_indices]\n1966 |         x_squared_norms_valid = x_squared_norms[validation_indices]\n1967 | \n1968 |         # perform several inits with random subsets\n1969 |         best_inertia = None\n1970 |         for init_idx in range(self._n_init):\n1971 |             if self.verbose:\n1972 |                 print(f\"Init {init_idx + 1}/{self._n_init} with method {init}\")\n1973 | \n1974 |             # Initialize the centers using only a fraction of the data as we\n1975 |       