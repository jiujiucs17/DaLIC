ax_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params)\n1684 |         return self\n1685 | \n1686 |     def transform(self, X):\n1687 |         \"\"\"Transform the data X according to the fitted NMF model.\n1688 | \n1689 |         Parameters\n1690 |         ----------\n1691 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1692 |             Training vector, where `n_samples` is the number of samples\n1693 |             and `n_features` is the number of features.\n1694 | \n1695 |         Returns\n1696 |         -------\n1697 |         W : ndarray of shape (n_samples, n_components)\n1698 |             Transformed data.\n1699 |         \"\"\"\n1700 |         check_is_fitted(self)\n1701 |         X = self._validate_data(\n1702 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n1703 |         )\n1704 | \n1705 |         with config_context(assume_finite=True):\n1706 |             W, *_ = self._fit_transform(X, H=self.components_, update_H=False)\n1707 | \n1708 |         return W\n1709 | \n1710 |     def inverse_transform(self, W):\n1711 |         \"\"\"Transform data back to its original space.\n1712 | \n1713 |         .. versionadded:: 0.18\n1714 | \n1715 |         Parameters\n1716 |         ----------\n1717 |         W : {ndarray, sparse matrix} of shape (n_samples, n_components)\n1718 |             Transformed data matrix.\n1719 | \n1720 |         Returns\n1721 |         -------\n1722 |         X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n1723 |             Returns a data matrix of the original shape.\n1724 |         \"\"\"\n1725 |         check_is_fitted(self)\n1726 |         return np.dot(W, self.components_)\n1727 | \n1728 |     @property\n1729 |     def _n_features_out(self):\n1730 |         \"\"\"Number of transformed output features.\"\"\"\n1731 |         return self.components_.shape[0]\n```\n"}, {"content": "Let me check for any online-related artifacts or MiniBatchNMF implementation:\n\n<function=search_code_snippets>\n<parameter=search_terms>['MiniBatchNMF', 'OnlineNMF']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/validation.py:_generate_get_feature_names_out\nsklearn/cross_decomposition/_pls.py: