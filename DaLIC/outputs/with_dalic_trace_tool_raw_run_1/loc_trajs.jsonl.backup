029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |             # NOTE: Bugs could still occur if len(verts) > 0,\n3038 |             #       but the \"2nd dimension\" is empty.\n3039 |             xs, ys = zip(*verts)\n3040 |         else:\n3041 |             xs, ys = [], []\n3042 | \n3043 |         xs, ys, verts_zs = art3d.juggle_axes(xs, ys, verts_zs, zdir)\n3044 |         self.auto_scale_xyz(xs, ys, verts_zs, had_data)\n3045 | \n3046 |         return patches\n```\n\n\n\n##Searching for term \"def bar(\", \"def bar( bar plot\"...\n### Search Result:\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be horizontal.\n65 | \n66 |     \"\"\"\n67 | \n68 |     def __init__(self, patches, errorbar=None, *, datavalues=None,\n69 |                  orientation=None, **kwargs):\n70 |         self.patches = patches\n71 |         self.errorbar = errorbar\n72 |         self.datavalues = datavalues\n73 |         self.orientation = orientation\n74 |         super().__init__(patches, **kwargs)\n```\n\n\n\n##Searching for term \"bar plot\"...\n### Search Result:\nFound code snippet in file `galleries/examples/pie_and_polar_charts/polar_bar.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =======================\n 3 | Bar chart on polar axis\n 4 | =======================\n 5 | \n 6 | Demo of bar plot on a polar axis.\n 7 | \"\"\"\n 8 | import matplotlib.pyplot as plt\n 9 | import numpy as np\n10 | \n11 | # Fixing random state for reproducibility\n12 | np.random.seed(19680801)\n13 | \n14 | # Compute pie slices\n15 | N = 20\n16 | theta = np.linspace(0.0, 2 * np.pi, N, endpoint=False)\n17 | radii = 10 * np.random.rand(N)\n18 | width = np.pi / 4 * np.random.rand(N)\n19 | colors = plt.cm.viridis(radii / 10.)\n20 | \n21 | ax = plt.subplot(projection='polar')\n22 | ax.bar(theta, radii, width=width, bottom=0.0, color=colors, alpha=0.5)\n23 | \n24 | plt.show()\n25 | \n26 | # %%\n27 | #\n28 | # .. admonition:: References\n29 | #\n30 | #    The use of the following functions, methods, classes and modules is shown\n31 | #    in this example:\n32 | #\n33 | #    - `matplotlib.axes.Axes.bar` / `matplotlib.pyplot.bar`\n34 | #    - `matplotlib.projections.polar`\n35 | #\n36 | # .. tags::\n37 | #\n38 | #    plot-type: pie\n39 | #    plot-type: bar\n40 | #    level: beginner\n41 | #    purpose: showcase\n42 | \n```\n\nFound code snippet in file `galleries/examples/mplot3d/bars3d.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ========================================\n 3 | Create 2D bar graphs in different planes\n 4 | ========================================\n 5 | \n 6 | Demonstrates making a 3D plot which has 2D bar graphs projected onto\n 7 | planes y=0, y=1, etc.\n 8 | \"\"\"\n 9 | \n10 | import matplotlib.pyplot as plt\n11 | import numpy as np\n12 | \n13 | # Fixing random state for reproducibility\n14 | np.random.seed(19680801)\n15 | \n16 | \n17 | fig = plt.figure()\n18 | ax = fig.add_subplot(projection='3d')\n19 | \n20 | colors = ['r', 'g', 'b', 'y']\n21 | yticks = [3, 2, 1, 0]\n22 | for c, k in zip(colors, yticks):\n23 |     # Generate the random data for the y=k 'layer'.\n24 |     xs = np.arange(20)\n25 |     ys = np.random.rand(20)\n26 | \n27 |     # You can provide either a single color or an array with the same length as\n28 |     # xs and ys. To demonstrate this, we color the first bar of each set cyan.\n29 |     cs = [c] * len(xs)\n30 |     cs[0] = 'c'\n31 | \n32 |     # Plot the bar graph given by xs and ys on the plane y=k with 80% opacity.\n33 |     ax.bar(xs, ys, zs=k, zdir='y', color=cs, alpha=0.8)\n34 | \n35 | ax.set_xlabel('X')\n36 | ax.set_ylabel('Y')\n37 | ax.set_zlabel('Z')\n38 | \n39 | # On the y-axis let's only label the discrete values that we have data for.\n40 | ax.set_yticks(yticks)\n41 | \n42 | plt.show()\n43 | \n44 | # %%\n45 | # .. tags::\n46 | #    plot-type: 3D, plot-type: bar,\n47 | #    styling: color,\n48 | #    level: beginner\n49 | \n```\n\nFound code snippet in file `galleries/examples/pie_and_polar_charts/polar_error_caps.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =================================\n 3 | Error bar rendering on polar axis\n 4 | =================================\n 5 | \n 6 | Demo of error bar plot in polar coordinates.\n 7 | Theta error bars are curved lines ended with caps oriented towards the\n 8 | center.\n 9 | Radius error bars are straight lines oriented towards center with\n10 | perpendicular caps.\n11 | \"\"\"\n12 | import matplotlib.pyplot as plt\n13 | import numpy as np\n14 | \n15 | theta = 