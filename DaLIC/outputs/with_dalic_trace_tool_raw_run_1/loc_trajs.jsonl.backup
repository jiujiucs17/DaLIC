       if not allow_pickle:\n739 |             raise ValueError(\"Object arrays cannot be loaded when \"\n740 |                              \"allow_pickle=False\")\n741 |         if pickle_kwargs is None:\n742 |             pickle_kwargs = {}\n743 |         try:\n744 |             array = pickle.load(fp, **pickle_kwargs)\n745 |         except UnicodeError as err:\n746 |             # Friendlier error message\n747 |             raise UnicodeError(\"Unpickling a python object failed: %r\\n\"\n748 |                                \"You may need to pass the encoding= option \"\n749 |                                \"to numpy.load\" % (err,)) from err\n750 |     else:\n751 |         if isfileobj(fp):\n752 |             # We can use the fast fromfile() function.\n753 |             array = numpy.fromfile(fp, dtype=dtype, count=count)\n754 |         else:\n755 |             # This is not a real file. We have to read it the\n756 |             # memory-intensive way.\n757 |             # crc32 module fails on reads greater than 2 ** 32 bytes,\n758 |             # breaking large reads from gzip streams. Chunk reads to\n759 |             # BUFFER_SIZE bytes to avoid issue and reduce memory overhead\n760 |             # of the read. In non-chunked case count < max_read_count, so\n761 |             # only one read is performed.\n762 | \n763 |             # Use np.ndarray instead of np.empty since the latter does\n764 |             # not correctly instantiate zero-width string dtypes; see\n765 |             # https://github.com/numpy/numpy/pull/6430\n766 |             array = numpy.ndarray(count, dtype=dtype)\n767 | \n768 |             if dtype.itemsize > 0:\n769 |                 # If dtype.itemsize == 0 then there's nothing more to read\n770 |                 max_read_count = BUFFER_SIZE // min(BUFFER_SIZE, dtype.itemsize)\n771 | \n772 |                 for i in range(0, count, max_read_count):\n773 |                     read_count = min(max_read_count, count - i)\n774 |                     read_size = int(read_count * dtype.itemsize)\n775 |                     data = _read_bytes(fp, read_size, \"array data\")\n776 |                     array[i:i+read_count] = numpy.frombuffer(data, dtype=dtype,\n777 |                                                              count=read_count)\n778 | \n779 |         if fortran_order:\n780 |             array.shape = shape[::-1]\n781 |             array = array.transpose()\n782 |         else:\n783 |             array.shape = shape\n784 | \n785 |     return array\n```\n\nFound function `numpy/core/arrayprint.py:_leading_trailing`.\nSource: Retrieved entity using keyword search (bm25).\n```\n324 | def _leading_trailing(a, edgeitems, index=()):\n325 |     \"\"\"\n326 |     Keep only the N-D corners (leading and trailing edges) of an array.\n327 | \n328 |     Should be passed a base-class ndarray, since it makes no guarantees about\n329 |     preserving subclasses.\n330 |     \"\"\"\n331 |     axis = len(index)\n332 |     if axis == a.ndim:\n333 |         return a[index]\n334 | \n335 |     if a.shape[axis] > 2*edgeitems:\n336 |         return concatenate((\n337 |             _leading_trailing(a, edgeitems, index + np.index_exp[ :edgeitems]),\n338 |             _leading_trailing(a, edgeitems, index + np.index_exp[-edgeitems:])\n339 |         ), axis=axis)\n340 |     else:\n341 |         return _leading_trailing(a, edgeitems, index + np.index_exp[:])\n```\n\nFound function `numpy/distutils/command/autodist.py:check_restrict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n31 | def check_restrict(cmd):\n32 |     \"\"\"Return the restrict identifier (may be empty).\"\"\"\n33 |     cmd._check_compiler()\n34 |     body = textwrap.dedent(\"\"\"\n35 |         static int static_func (char * %(restrict)s a)\n36 |         {\n37 |             return 0;\n38 |         }\n39 |         \"\"\")\n40 | \n41 |     for kw in ['restrict', '__restrict__', '__restrict']:\n42 |         st = cmd.try_compile(body