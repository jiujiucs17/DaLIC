mport ListedColormap\n15 | from sklearn import neighbors, datasets\n16 | \n17 | n_neighbors = 15\n18 | \n19 | # import some data to play with\n20 | iris = datasets.load_iris()\n21 | \n22 | # we only take the first two features. We could avoid this ugly\n23 | # slicing by using a two-dim dataset\n24 | X = iris.data[:, :2]\n25 | y = iris.target\n26 | \n27 | h = .02  # step size in the mesh\n28 | \n29 | # Create color maps\n30 | cmap_light = ListedColormap(['orange', 'cyan', 'cornflowerblue'])\n31 | cmap_bold = ['darkorange', 'c', 'darkblue']\n32 | \n33 | for weights in ['uniform', 'distance']:\n34 |     # we create an instance of Neighbours Classifier and fit the data.\n35 |     clf = neighbors.KNeighborsClassifier(n_neighbors, weights=weights)\n36 |     clf.fit(X, y)\n37 | \n38 |     # Plot the decision boundary. For that, we will assign a color to each\n39 |     # point in the mesh [x_min, x_max]x[y_min, y_max].\n40 |     x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1\n41 |     y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1\n42 |     xx, yy = np.meshgrid(np.arange(x_min, x_max, h),\n43 |                          np.arange(y_min, y_max, h))\n44 |     Z = clf.predict(np.c_[xx.ravel(), yy.ravel()])\n45 | \n46 |     # Put the result into a color plot\n47 |     Z = Z.reshape(xx.shape)\n48 |     plt.figure(figsize=(8, 6))\n49 |     plt.contourf(xx, yy, Z, cmap=cmap_light)\n50 | \n51 |     # Plot also the training points\n52 |     sns.scatterplot(x=X[:, 0], y=X[:, 1], hue=iris.target_names[y],\n53 |                     palette=cmap_bold, alpha=1.0, edgecolor=\"black\")\n54 |     plt.xlim(xx.min(), xx.max())\n55 |     plt.ylim(yy.min(), yy.max())\n56 |     plt.title(\"3-Class classification (k = %i, weights = '%s')\"\n57 |               % (n_neighbors, weights))\n58 |     plt.xlabel(iris.feature_names[0])\n59 |     plt.ylabel(iris.feature_names[1])\n60 | \n61 | plt.show()\n62 | \n```\n\nFound code snippet in file `examples/model_selection/plot_grid_search_stats.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ==================================================\n  3 | Statistical comparison of models using grid search\n  4 | ==================================================\n  5 | \n  6 | This example illustrates how to statistically compare the performance of models\n  7 | trained and evaluated using :class:`~sklearn.model_selection.GridSearchCV`.\n  8 | \"\"\"\n  9 | \n 10 | # %%\n 11 | # We will start by simulating moon shaped data (where the ideal separation\n 12 | # between classes is non-linear), adding to it a moderate degree of noise.\n 13 | # Datapoints will belong to one of two possible classes to be predicted by two\n 14 | # features. We will simulate 50 samples for each class:\n 15 | \n 16 | print(__doc__)\n 17 | import matplotlib.pyplot as plt\n 18 | import seaborn as sns\n 19 | from sklearn.datasets import make_moons\n 20 | \n 21 | X, y = make_moons(noise=0.352, random_state=1, n_samples=100)\n 22 | \n 23 | sns.scatterplot(\n 24 |     x=X[:, 0], y=X[:, 1], hue=y,\n 25 |     marker='o', s=25, edgecolor='k', legend=False\n 26 | ).set_title(\"Data\")\n 27 | plt.show()\n 28 | \n 29 | # %%\n 30 | # We will compare the performance of :class:`~sklearn.svm.SVC` estimators that\n 31 | # vary on their `kernel` parameter, to decide which choice of this\n 32 | # hyper-parameter predicts our simulated data best.\n 33 | # We will evaluate the performance of the models using\n 34 | # :class:`~sklearn.model_selection.RepeatedStratifiedKFold`, repeating 10 times\n 35 | # a 10-fold stratified cross validation using a different randomization of the\n 36 | # data in each repetition. The performance will be evaluated using\n 37 | # :class:`~sklearn.metrics.roc_auc_score`.\n 38 | \n 39 | from sklearn.model_selection import GridSearchCV, RepeatedStratifiedKFold\n 40 | from sklearn.svm import SVC\n 41 | \n 42 | param_grid = [\n 43 |     {'kernel': ['linear']},\n 44 |     {'kernel': ['poly'], 'degree': [2, 3]},\n 45 |     {'kernel': ['rbf']}\n 46 | ]\n 47 | \n 48 | svc = SVC(random_state=0)\n 49 | \n 50 | cv = RepeatedStratifiedKFold(\n 51 |     n_splits=10, n_repeats=10, random_state=0\n 52 | )\n 53 | \n 54 | search = GridSearchCV(\n 55 |     estimator=svc, param_grid=param_grid,\n 56 |     scoring='roc_auc', cv=cv\n 57 | )\n 58 | search.fit(X, y)\n 59 | \n 60 | # %%\n 61 | # We can now inspect the results of our search, sorted by their\n 62 | # `mean_test_score`:\n 63 | \n 64 | import pandas as pd\n 65 | \n 66 | results_df = pd.DataFrame(search.cv_results_)\n 67 | results_df = results_df.sort_values(by=['rank_test_score'])\n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ======================================================================\n  3 | Common pitfalls in the interpretation of coefficients of linear models\n  4 | ======================================================================\n  5 | \n  6 | In linear models, the target value is modeled as\n  7 | a linear combination of the features (see the :ref:`linear_model` User Guide\n  8 | section for a description of a set of linear models available in\n  9 | scikit-learn).\n 10 | Coefficients in multiple linear models represent the relationship between the\n 11 | given feature, :math:`X_i` and the target, :math:`y`, assuming that all the\n 12 | other features remain constant (`conditional dependence\n 13 | <https://en.wikipedia.org/wiki/Conditional_dependence>`_).\n 14 | This is different from plotting :math:`X_i` versus :math:`y` and fitting a\n 15 | linear relationship: in that case all possible values of the other features are\n 16 | taken into account in the estimation (marginal dependence).\n 17 | \n 18 | This example will provide some hints in interpreting coefficient in linear\n 19 | models, pointing at problems that arise when either the linear model is not\n 20 | appropriate to describe the dataset, or when features are correlated.\n 21 | \n 22 | We will use data from the `\"Current Population Survey\"\n 23 | <https://www.openml.org/d/534>`_ from 1985 to predict\n 24 | wage as a function of various features such as experience, age, or education.\n 25 | \n 26 | .. contents::\n 27 |    :local:\n 28 |    :depth: 1\n 29 | \"\"\"\n 30 | \n 31 | print(__doc__)\n 32 | \n 33 | import numpy as np\n 34 | import scipy as sp\n 35 | import pandas as pd\n 36 | import matplotlib.pyplot as plt\n 37 | import seaborn as sns\n 38 | \n 39 | # %%\n 40 | # The dataset: wages\n 41 | # ------------------\n 42 | #\n 43 | # We fetch the data from `OpenML <http://openml.org/>`_.\n 44 | # Note that setting the parameter `as_frame` to True will retrieve the data\n 45 | # as a pandas dataframe.\n 46 | \n 47 | from sklearn.datasets import fetch_openml\n 48 | \n 49 | survey = fetch_openml(data_id=534, as_frame=True)\n 50 | \n 51 | # %%\n 52 | # Then, we identify features `X` and targets `y`: the column WAGE is our\n 53 | # target variable (i.e., the variable which we want to predict).\n 54 | #\n 55 | X = survey.data[survey.feature_names]\n 56 | X.describe(include=\"all\")\n 57 | \n 58 | # %%\n 59 | # Note that the dataset contains categorical and numerical variables.\n 60 | # We will need to take this into account when preprocessing the dataset\n 61 | # thereafter.\n 62 | \n 63 | X.head()\n 64 | \n 65 | # %%\n 66 | # Our target for prediction: the wage.\n 67 | # Wages are described as floating-point number in dollars per hour.\n 68 | y = survey.target.values.ravel()\n 69 | survey.target.head()\n 70 | \n 71 | # %%\n 72 | # We split the sample into a train and a test dataset.\n 73 | # Only the train dataset will be used in the following exploratory analysis.\n 74 | # This is a way to emulate a real situation where predictions are performed on\n 75 | # an unknown target, and we don't want our analysis and decisions to be biased\n 76 | # by our knowledge of the test data.\n 77 | \n 78 | from sklearn.model_selection import train_test_split\n```\n\nFound function `sklearn/pipeline.py:make_pipeline`.\nSource: Retrieved entity using keyword search (bm25).\n```\n742 | def make_pipeline(*steps, memory=None, verbose=False):\n743 |     \"\"\"Construct a Pipeline from the given estimators.\n744 | \n745 |     This is a shorthand for the Pipeline constructor; it does not require, and\n746 |     does not permit, naming the estimators. Instead, their names will be set\n747 |     to the lowercase of their types automatically.\n748 | \n749 |     Parameters\n750 |     ----------\n751 |     *steps : list of estimators.\n752 | \n753 |     memory : str or object with the joblib.Memory interface, default=None\n754 |         Used to cache the fitted transformers of the pipeline. By default,\n755 |         no caching is performed. If a string is given, it is the path to\n756 |         the caching directory. Enabling caching triggers a clone of\n757 |         the transformers before fitting. Therefore, the transformer\n758 |         instance given to the pipeline cannot be inspected\n759 |         directly. Use the attribute ``named_steps`` or ``steps`` to\n760 |         inspect estimators within the pipeline. Caching the\n761 |         transformers is advantageous when fitting is time consuming.\n762 | \n763 |     verbose : bool, default=False\n764 |         If True, the time elapsed while fitting each step will be printed as it\n765 |         is completed.\n766 | \n767 |     See Also\n768 |     --------\n769 |     Pipeline : Class for creating a pipeline of transforms with a final\n770 |         estimator.\n771 | \n772 |     Examples\n773 |     --------\n774 |     >>> from sklearn.naive_bayes import GaussianNB\n775 |     >>> from sklearn.preprocessing import StandardScaler\n776 |     >>> make_pipeline(StandardScaler(), GaussianNB(priors=None))\n777 |     Pipeline(steps=[('standardscaler', StandardScaler()),\n778 |                     ('gaussiannb', GaussianNB())])\n779 | \n780 |     Returns\n781 |     -------\n782 |     p : Pipeline\n783 |     \"\"\"\n784 |     return Pipeline(_name_estimators(steps), memory=memory, verbose=verbose)\n```\n"}, {"content": "Let me analyze the execution trace to see what visualizations are currently available:\n\n<function=get_trace_artifacts>\n<parameter=artifact_type>function</parameter>\n<parameter=name_contains>plot</parameter>\n<parameter=path_contains>metrics</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_trace_artifacts", "content": "OBSERVATION:\n{\n  \"instance_id\": \"scikit-learn__scikit-learn-17443\",\n  \"trace_summary\": {\n    \"unique_function_count\": 708,\n    \"returned_count\": 0,\n    \"filtered_count\": 0\n  },\n  \"applied_filters\": {\n    \"artifact_type\": \"function\",\n    \"path_contains\": \"metrics\",\n    \"name_contains\": \"plot\",\n    \"start\": 0,\n    \"limit\": 8\n  },\n  \"artifacts\": [],\n  \"has_more\": false,\n  \"next_start\": 0\n}"}, {"content": "Let me also check the calibration-related plots:\n\n<function=search_code_snippets>\n<parameter=search_terms>['CalibratedClassifier', 'plot_calibrated']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/validation.py:_get_feature_names\nsklearn/datasets/_base.py:load_digits\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_linnerud\nsklearn/datasets/_base.py:load_digits\nsklearn/datasets/_base.py:load_boston\nsklearn/datasets/_california_housing.py:fetch_california_housing\nsklearn/datasets/_base.py:load_sample_image\nsklearn/datasets/_base.py:load_linnerud\nexamples/calibration/plot_calibration.py:impl:50\nexamples/calibration/plot_calibration.py:impl:50\nexamples/calibration/plot_calibration.py:docstring:11\nsklearn/utils/validation.py:_get_feature_names