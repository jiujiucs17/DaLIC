Returns\n258 |     -------\n259 |     X : np.array or scipy.sparse.csr_matrix\n260 |     y : np.array\n261 |     \"\"\"\n262 |     arff_data = arff['data']\n263 |     if isinstance(arff_data, Generator):\n264 |         if shape is None:\n265 |             raise ValueError(\n266 |                 \"shape must be provided when arr['data'] is a Generator\"\n267 |             )\n268 |         if shape[0] == -1:\n269 |             count = -1\n270 |         else:\n271 |             count = shape[0] * shape[1]\n272 |         data = np.fromiter(itertools.chain.from_iterable(arff_data),\n273 |                            dtype='float64', count=count)\n274 |         data = data.reshape(*shape)\n275 |         X = data[:, col_slice_x]\n276 |         y = data[:, col_slice_y]\n277 |         return X, y\n278 |     elif isinstance(arff_data, tuple):\n279 |         arff_data_X = _split_sparse_columns(arff_data, col_slice_x)\n280 |         num_obs = max(arff_data[1]) + 1\n281 |         X_shape = (num_obs, len(col_slice_x))\n282 |         X = scipy.sparse.coo_matrix(\n283 |             (arff_data_X[0], (arff_data_X[1], arff_data_X[2])),\n284 |             shape=X_shape, dtype=np.float64)\n285 |         X = X.tocsr()\n286 |         y = _sparse_data_to_array(arff_data, col_slice_y)\n287 |         return X, y\n288 |     else:\n289 |         # This should never happen\n290 |         raise ValueError('Unexpected Data Type obtained from arff.')\n```\n\nFound function `sklearn/datasets/_openml.py:_convert_arff_data_dataframe`.\nSource: Retrieved entity using keyword search (bm25).\n```\n310 | def _convert_arff_data_dataframe(\n311 |     arff: ArffContainerType, columns: List, features_dict: Dict[str, Any]\n312 | ) -> Tuple:\n313 |     \"\"\"Convert the ARFF object into a pandas DataFrame.\n314 | \n315 |     Parameters\n316 |     ----------\n317 |     arff : dict\n318 |         As obtained from liac-arff object.\n319 | \n320 |     columns : list\n321 |         Columns from dataframe to return.\n322 | \n323 |     features_dict : dict\n324 |         Maps feature name to feature info from openml.\n325 | \n326 |     Returns\n327 |     -------\n328 |     result : tuple\n329 |         tuple with the resulting dataframe\n330 |     \"\"\"\n331 |     pd = check_pandas_support('fetch_openml with as_frame=True')\n332 | \n333 |     attributes = OrderedDict(arff['attributes'])\n334 |     arff_columns = list(attributes)\n335 | \n336 |     if not isinstance(arff['data'], Generator):\n337 |         raise ValueError(\n338 |             \"arff['data'] must be a generator when converting to pd.DataFrame.\"\n339 |         )\n340 | \n341 |     # calculate chunksize\n342 |     first_row = next(arff['data'])\n343 |     first_df = pd.DataFrame([first_row], columns=arff_columns)\n344 | \n345 |     row_bytes = first_df.memory_usage(deep=True).sum()\n346 |     chunksize = get_chunk_n_rows(row_bytes)\n347 | \n348 |     # read arff data with chunks\n349 |     columns_to_keep = [col for col in arff_columns if col in columns]\n350 |     dfs = []\n351 |     dfs.append(first_df[columns_to_keep])\n352 |     for data in _chunk_generator(arff['data'], chunksize):\n353 |         dfs.append(pd.DataFrame(data, columns=arff_columns)[columns_to_keep])\n354 |     df = pd.concat(dfs, ignore_index=True)\n355 | \n356 |     for column in columns_to_keep:\n357 |         dtype = _feature_to_dtype(features_dict[column])\n358 |         if dtype == 'category':\n359 |             dtype = pd.api.types.CategoricalDtype(attributes[column])\n360 |         df[column] = df[column].astype(dtype, copy=False)\n361 |     return (df, )\n```\n\nFound function `sklearn/externals/_arff.py:ArffDecoder.decode`.\nSource: Retrieved code content using keyword search (bm25).\n```\n895 | def decode(self, s, encode_nominal=False, return_type=DENSE):\n896 |         '''Returns the Python representation of a given ARFF file.\n897 | \n898 |         When a file object is passed as an argument, this method reads lines\n899 |        