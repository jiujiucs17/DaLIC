):\n1021 |             raise BadObject('Attributes not found.')\n1022 | \n1023 |         attribute_names = set()\n1024 |         for attr in obj['attributes']:\n1025 |             # Verify for bad object format\n1026 |             if not isinstance(attr, (tuple, list)) or \\\n1027 |                len(attr) != 2 or \\\n1028 |                not isinstance(attr[0], basestring):\n1029 |                 raise BadObject('Invalid attribute declaration \"%s\"'%str(attr))\n1030 | \n1031 |             if isinstance(attr[1], basestring):\n1032 |                 # Verify for invalid types\n1033 |                 if attr[1] not in _SIMPLE_TYPES:\n1034 |                     raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1035 | \n1036 |             # Verify for bad object format\n1037 |             elif not isinstance(attr[1], (tuple, list)):\n1038 |                 raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1039 | \n1040 |             # Verify attribute name is not used twice\n1041 |             if attr[0] in attribute_names:\n1042 |                 raise BadObject('Trying to use attribute name \"%s\" for the '\n1043 |                                 'second time.' % str(attr[0]))\n1044 |             else:\n1045 |                 attribute_names.add(attr[0])\n1046 | \n1047 |             yield self._encode_attribute(attr[0], attr[1])\n1048 |         yield u''\n1049 |         attributes = obj['attributes']\n1050 | \n1051 |         # DATA\n1052 |         yield _TK_DATA\n1053 |         if 'data' in obj:\n1054 |             data = _get_data_object_for_encoding(obj.get('data'))\n1055 |             for line in data.encode_data(obj.get('data'), attributes):\n1056 |                 yield line\n1057 | \n1058 |         yield u''\n```\n\nFound function `sklearn/externals/_arff.py:load`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1063 | def load(fp, encode_nominal=False, return_type=DENSE):\n1064 |     '''Load a file-like object containing the ARFF document and convert it into\n1065 |     a Python object.\n1066 | \n1067 |     :param fp: a file-like object.\n1068 |     :param encode_nominal: boolean, if True perform a label encoding\n1069 |         while reading the .arff file.\n1070 |     :param return_type: determines the data structure used to store the\n1071 |         dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n1072 |         `arff.DENSE_GEN` or `arff.LOD_GEN`.\n1073 |         Consult the sections on `working with sparse data`_ and `loading\n1074 |         progressively`_.\n1075 |     :return: a dictionary.\n1076 |      '''\n1077 |     decoder = ArffDecoder()\n1078 |     return decoder.decode(fp, encode_nominal=encode_nominal,\n1079 |                           return_type=return_type)\n```\n\n\n\n##Searching for term \"arff\", \"arff _download data_home\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_load_arff_response`.\nSource: Retrieved entity using keyword search (bm25).\n```\n491 | def _load_arff_response(\n492 |     url: str,\n493 |     data_home: Optional[str],\n494 |     return_type, encode_nominal: bool,\n495 |     parse_arff: Callable[[ArffContainerType], Tuple]\n496 | ) -> Tuple:\n497 |     \"\"\"Load arff data with url and parses arff response with parse_arff\"\"\"\n498 |     response = _open_openml_url(url, data_home)\n499 | \n500 |     with closing(response):\n501 |         # Note that if the data is dense, no reading is done until the data\n502 |         # generator is iterated.\n503 |         arff = _arff.load((line.decode('utf-8') for line in response),\n504 |                           return_type=return_type,\n505 |                           encode_nominal=encode_nominal)\n506 |         return parse_arff(arff)\n```\n\nFound function `sklearn/externals/_arff.py:loads`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1081 | def loads(s, encode_nominal=False, return_type=DENSE):\n1082 |     '''Convert a string instance co