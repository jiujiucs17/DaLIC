est: +SKIP\n2282 |         \"\"\"\n2283 |         if engine_kwargs is None:\n2284 |             engine_kwargs = {}\n2285 | \n2286 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n2287 | \n2288 |         from pandas.io.formats.excel import ExcelFormatter\n2289 | \n2290 |         formatter = ExcelFormatter(\n2291 |             df,\n2292 |             na_rep=na_rep,\n2293 |             cols=columns,\n2294 |             header=header,\n2295 |             float_format=float_format,\n2296 |             index=index,\n2297 |             index_label=index_label,\n2298 |             merge_cells=merge_cells,\n2299 |             inf_rep=inf_rep,\n2300 |         )\n2301 |         formatter.write(\n2302 |             excel_writer,\n2303 |             sheet_name=sheet_name,\n2304 |             startrow=startrow,\n2305 |             startcol=startcol,\n2306 |             freeze_panes=freeze_panes,\n2307 |             engine=engine,\n2308 |             storage_options=storage_options,\n2309 |             engine_kwargs=engine_kwargs,\n2310 |         )\n```\n\nFound function `pandas/core/generic.py:NDFrame.to_json`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2317 | def to_json(\n2318 |         self,\n2319 |         path_or_buf: FilePath | WriteBuffer[bytes] | WriteBuffer[str] | None = None,\n2320 |         *,\n2321 |         orient: Literal[\"split\", \"records\", \"index\", \"table\", \"columns\", \"values\"]\n2322 |         | None = None,\n2323 |         date_format: str | None = None,\n2324 |         double_precision: int = 10,\n2325 |         force_ascii: bool = True,\n2326 |         date_unit: TimeUnit = \"ms\",\n2327 |         default_handler: Callable[[Any], JSONSerializable] | None = None,\n2328 |         lines: bool = False,\n2329 |         compression: CompressionOptions = \"infer\",\n2330 |         index: bool | None = None,\n2331 |         indent: int | None = None,\n2332 |         storage_options: StorageOptions | None = None,\n2333 |         mode: Literal[\"a\", \"w\"] = \"w\",\n2334 |     ) -> str | None:\n2335 |         \"\"\"\n2336 |         Convert the object to a JSON string.\n2337 | \n2338 |         Note NaN's and None will be converted to null and datetime objects\n2339 |         will be converted to UNIX timestamps.\n2340 | \n2341 |         Parameters\n2342 |         ----------\n2343 |         path_or_buf : str, path object, file-like object, or None, default None\n2344 |             String, path object (implementing os.PathLike[str]), or file-like\n2345 |             object implementing a write() function. If None, the result is\n2346 |             returned as a string.\n2347 |         orient : str\n2348 |             Indication of expected JSON string format.\n2349 | \n2350 |             * Series:\n2351 | \n2352 |                 - default is 'index'\n2353 |                 - allowed values are: {{'split', 'records', 'index', 'table'}}.\n2354 | \n2355 |             * DataFrame:\n2356 | \n2357 |                 - default is 'columns'\n2358 |                 - allowed values are: {{'split', 'records', 'index', 'columns',\n2359 |                   'values', 'table'}}.\n2360 | \n2361 |             * The format of the JSON string:\n2362 | \n2363 |                 - 'split' : dict like {{'index' -> [index], 'columns' -> [columns],\n2364 |                   'data' -> [values]}}\n2365 |                 - 'records' : list like [{{column -> value}}, ... , {{column -> value}}]\n2366 |                 - 'index' : dict like {{index -> {{column -> value}}}}\n2367 |                 - 'columns' : dict like {{column -> {{index -> value}}}}\n2368 |                 - 'values' : just the values array\n2369 |                 - 'table' : dict like {{'schema': {{schema}}, 'data': {{data}}}}\n2370 | \n2371 |                 Describing the data, where data component is like ``orient='records'``.\n2372 | \n2373 |         date_format : {{None, 'epoch', 'iso'}}\n2374 |             Type of date conversion. 'epoch' = epoch milliseconds,\n2375 |             'iso' = ISO8601. The default depends on the `orient`. For\n2376 |             ``orient='table'``, the default is 'iso'. For all other orients,\n2377 |             the default is 'epoch'.\n2378 | \n2379 |             .. deprecated:: 3.0.0\n2380 |                 'epoch' date format is deprecated and will be removed in a future\n2381 |                 version, please use 'iso' instead.\n2382 | \n2383 |         double_precision : int, default 10\n2384 |             The number of decimal places to use when encoding\n2385 |             floating point values. The possible maximal value is 15.\n2386 |             Passing double_precision greater than 15 will raise a ValueError.\n2387 |         force_ascii : bool, default True\n2388 |             Force encoded string to be ASCII.\n2389 |         date_unit : str, default 'ms' (milliseconds)\n2390 |             The time unit to encode to, governs timestamp and ISO8601\n2391 |             precision.  One of 's', 'ms', 'us', 'ns' for second, millisecond,\n2392 |             microsecond, and nanosecond respectively.\n2393 |         default_handler : callable, default None\n2394 |             Handler to call if object cannot otherwise be converted to a\n2395 |             suitable format for JSON. Should receive a single argument which is\n2396 |             the object to convert and return a serialisable object.\n2397 |         lines : bool, default False\n2398 |             If 'orient' is 'records' write out line-delimited json format. Will\n2399 |             throw ValueError if incorrect 'orient' since others are not\n2400 |             list-like.\n2401 |         {compression_options}\n2402 | \n2403 |             .. versionchanged:: 1.4.0 Zstandard support.\n2404 | \n2405 |         index : bool or None, default None\n2406 |             The index is only used when 'orient' is 'split', 'index', 'column',\n2407 |             or 'table'. Of these, 'index' and 'column' do not support\n2408 |             `index=False`. The string 'index' as a column name with empty :class:`Index`\n2409 |             or if it is 'index' will raise a ``ValueError``.\n2410 | \n2411 |         indent : int, optional\n2412 |            Length of whitespace used to indent each record.\n2413 | \n2414 |         {storage_options}\n2415 | \n2416 |         mode : str, default 'w' (writing)\n2417 |             Specify the IO mode for output when supplying a path_or_buf.\n2418 |             Accepted args are 'w' (writing) and 'a' (append) only.\n2419 |             mode='a' is only supported when lines is True and orient is 'records'.\n2420 | \n2421 |         Returns\n2422 |         -------\n2423 |         None or str\n2424 |             If path_or_buf is None, returns the resulting json format as a\n2425 |             string. Otherwise returns None.\n2426 | \n2427 |         See Also\n2428 |         --------\n2429 |         read_json : Convert a JSON string to pandas object.\n2430 | \n2431 |         Notes\n2432 |         -----\n2433 |         The behavior of ``indent=0`` varies from the stdlib, which does not\n2434 |         indent the output but does insert newlines. Currently, ``indent=0``\n2435 |         and the default ``indent=None`` are equivalent in pandas, though this\n2436 |         may change in a future release.\n2437 | \n2438 |         ``orient='table'`` contains a 'pandas_version' field under 'schema'.\n2439 |         This stores the version of `pandas` used in the latest revision of the\n2440 |         schema.\n2441 | \n2442 |         Examples\n2443 |         --------\n2444 |         >>> from json import loads, dumps\n2445 |         >>> df = pd.DataFrame(\n2446 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2447 |         ...     index=[\"row 1\", \"row 2\"],\n2448 |         ...     columns=[\"col 1\", \"col 2\"],\n2449 |         ... )\n2450 | \n2451 |         >>> result = df.to_json(orient=\"split\")\n2452 |         >>> parsed = loads(result)\n2453 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2454 |         {{\n2455 |             \"columns\": [\n2456 |                 \"col 1\",\n2457 |                 \"col 2\"\n2458 |             ],\n2459 |             \"index\": [\n2460 |                 \"row 1\",\n2461 |                 \"row 2\"\n2462 |             ],\n2463 |             \"data\": [\n2464 |                 [\n2465 |                     \"a\",\n2466 |                     \"b\"\n2467 |                 ],\n2468 |                 [\n2469 |                     \"c\",\n2470 |                     \"d\"\n2471 |                 ]\n2472 |             ]\n2473 |         }}\n2474 | \n2475 |         Encoding/decoding a Dataframe using ``'records'`` formatted JSON.\n2476 |         Note that index labels are not preserved with this encoding.\n2477 | \n2478 |         >>> result = df.to_json(orient=\"records\")\n2479 |         >>> parsed = loads(result)\n2480 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2481 |         [\n2482 |             {{\n2483 |                 \"col 1\": \"a\",\n2484 |                 \"col 2\": \"b\"\n2485 |             }},\n2486 |             {{\n2487 |                 \"col 1\": \"c\",\n2488 |                 \"col 2\": \"d\"\n2489 |             }}\n2490 |         ]\n2491 | \n2492 |         Encoding/decoding a Dataframe using ``'index'`` formatted JSON:\n2493 | \n2494 |         >>> result = df.to_json(orient=\"index\")\n2495 |         >>> parsed = loads(result)\n2496 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2497 |         {{\n2498 |             \"row 1\": {{\n2499 |                 \"col 1\": \"a\",\n2500 |                 \"col 2\": \"b\"\n2501 |             }},\n2502 |             \"row 2\": {{\n2503 |                 \"col 1\": \"c\",\n2504 |                 \"col 2\": \"d\"\n2505 |             }}\n2506 |         }}\n2507 | \n2508 |         Encoding/decoding a Dataframe using ``'columns'`` formatted JSON:\n2509 | \n2510 |         >>> result = df.to_json(orient=\"columns\")\n2511 |         >>> parsed = loads(result)\n2512 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2513 |         {{\n2514 |             \"col 1\": {{\n2515 |                 \"row 1\": \"a\",\n2516 |                 \"row 2\": \"c\"\n2517 |             }},\n2518 |             \"col 2\": {{\n2519 |                 \"row 1\": \"b\",\n2520 |                 \"row 2\": \"d\"\n2521 |             }}\n2522 |         }}\n2523 | \n2524 |         Encoding/decoding a Dataframe using ``'values'`` formatted JSON:\n2525 | \n2526 |         >>> result = df.to_json(orient=\"values\")\n2527 |         >>> parsed = loads(result)\n2528 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2529 |         [\n2530 |             [\n2531 |                 \"a\",\n2532 |                 \"b\"\n2533 |             ],\n2534 |             [\n2535 |                 \"c\",\n2536 |                 \"d\"\n2537 |             ]\n2538 |         ]\n2539 | \n2540 |         Encoding with Table Schema:\n2541 | \n2542 |         >>> result = df.to_json(orient=\"table\")\n2543 |         >>> parsed = loads(result)\n2544 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2545 |         {{\n2546 |             \"schema\": {{\n2547 |                 \"fields\": [\n2548 |                     {{\n2549 |                         \"name\": \"index\",\n2550 |                         \"type\": \"string\"\n2551 |                     }},\n2552 |                     {{\n2553 |                         \"name\": \"col 1\",\n2554 |                         \"type\": \"string\"\n2555 |                     }},\n2556 |                     {{\n2557 |                         \"name\": \"col 2\",\n2558 |                         \"type\": \"string\"\n2559 |                     }}\n2560 |                 ],\n2561 |                 \"primaryKey\": [\n2562 |                     \"index\"\n2563 |                 ],\n2564 |                 \"pandas_version\": \"1.4.0\"\n2565 |             }},\n2566 |             \"data\": [\n2567 |                 {{\n2568 |                     \"index\": \"row 1\",\n2569 |                     \"col 1\": \"a\",\n2570 |                     \"col 2\": \"b\"\n2571 |                 }},\n2572 |                 {{\n2573 |                     \"index\": \"row 2\",\n2574 |                     \"col 1\": \"c\",\n2575 |                     \"col 2\": \"d\"\n2576 |                 }}\n2577 |             ]\n2578 |         }}\n2579 |         \"\"\"\n2580 |         from pandas.io import json\n2581 | \n2582 |         if date_format is None and orient == \"table\":\n2583 |             date_format = \"iso\"\n2584 |         elif date_format is None:\n2585 |             date_format = \"epoch\"\n2586 |             dtypes = self.dtypes if self.ndim == 2 else [self.dtype]\n2587 |             if any(lib.is_np_dtype(dtype, \"mM\") for dtype in dtypes):\n2588 |                 warnings.warn(\n2589 |                     \"The default 'epoch' date format is deprecated and will be removed \"\n2590 |                     \"in a future version, please use 'iso' date format instead.\",\n2591 |                     FutureWarning,\n2592 |                     stacklevel=find_stack_level(),\n2593 |                 )\n2594 |         elif date_format == \"epoch\":\n2595 |             # GH#57063\n2596 |             warnings.warn(\n2597 |                 \"'epoch' date format is deprecated and will be removed in a future \"\n2598 |                 \"version, please use 'iso' date format instead.\",\n2599 |                 FutureWarning,\n2600 |                 stacklevel=find_stack_level(),\n2601 |             )\n2602 | \n2603 |         config.is_nonnegative_int(indent)\n2604 |         indent = indent or 0\n2605 | \n2606 |         return json.to_json(\n2607 |             path_or_buf=path_or_buf,\n2608 |             obj=self,\n2609 |             orient=orient,\n2610 |             date_format=date_format,\n2611 |             double_precision=double_precision,\n2612 |             force_ascii=force_ascii,\n2613 |             date_unit=date_unit,\n2614 |             default_handler=default_handler,\n2615 |             lines=lines,\n2616 |             compression=compression,\n2617 |             index=index,\n2618 |             indent=indent,\n2619 |             storage_options=storage_options,\n2620 |             mode=mode,\n2621 |         )\n```\n\nFound class `asv_bench/benchmarks/join_merge.py:Concat`.\nSource: Retrieved entity using keyword search (bm25).\n```\n23 | class Concat:\n24 |     params = [0, 1]\n25 |     param_names = [\"axis\"]\n26 | \n27 |     def setup(self, axis):\n28 |         N = 1000\n29 |         s = Series(N, index=Index([f\"i-{i}\" for i in range(N)], dtype=object))\n30 |         self.series = [s[i:-i] for i in range(1, 10)] * 50\n31 |         self.small_frames = [DataFrame(np.random.randn(5, 4))] * 1000\n32 |         df = DataFrame(\n33 |             {\"A\": range(N)}, index=date_range(\"20130101\", periods=N, freq=\"s\")\n34 |         )\n35 |         self.empty_left = [DataFrame(), df]\n36 |         self.empty_right = [df, DataFrame()]\n37 |         self.mixed_ndims = [df, df.head(N // 2)]\n38 | \n39 |     def time_concat_series(self, axis):\n40 |         concat(self.series, axis=axis, sort=False)\n41 | \n42 |     def time_concat_small_frames(self, axis):\n43 |         concat(self.small_frames, axis=axis)\n44 | \n45 |     def time_concat_empty_right(self, axis):\n46 |         concat(self.empty_right, axis=axis)\n47 | \n48 |     def time_concat_empty_left(self, axis):\n49 |         concat(self.empty_left, axis=axis)\n50 | \n51 |     def time_concat_mixed_ndims(self, axis):\n52 |         concat(self.mixed_ndims, axis=axis)\n```\n\nFound function `pandas/io/formats/style.py:Styler.to_excel`.\nSource: Retrieved code content using keyword search (bm25).\n```\n571 | def to_excel(\n572 |         self,\n573 |         excel_writer: FilePath | WriteExcelBuffer | ExcelWriter,\n574 |         sheet_name: str = \"Sheet1\"