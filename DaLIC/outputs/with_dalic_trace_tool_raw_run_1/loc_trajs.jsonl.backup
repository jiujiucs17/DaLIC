t_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |                         \"Should be str, list or None. Got: \"\n866 |                         \"{}\".format(type(target_column)))\n867 |     data_columns = _valid_data_column_names(features_list,\n868 |                                             target_columns)\n869 | \n870 |     shape: Optional[Tuple[int, int]]\n871 |     # determine arff encoding to return\n872 |     if not return_sparse:\n873 |         # The shape must include the ignored features to keep the right indexes\n874 |         # during the arff data conversion.\n875 |         data_qualities = _get_data_qualities(data_id, data_home)\n876 |         shape = _get_num_samples(data_qualities), len(features_list)\n877 |     else:\n878 |         shape = None\n879 | \n880 |     # obtain the data\n881 |     url = _DATA_FILE.format(data_description['file_id'])\n882 |     bunch = _download_data_to_bunch(url, return_sparse, data_home,\n883 |                                     as_frame=as_frame,\n884 |                                     features_list=features_list, shape=shape,\n885 |                                     target_columns=target_columns,\n886 |                                     data_columns=data_columns)\n887 | \n888 |     if return_X_y:\n889 |         return bunch.data, bunch.target\n890 | \n891 |     description = \"{}\\n\\nDownloaded from openml.org.\".format(\n892 |         data_description.pop('description'))\n893 | \n894 |     bunch.update(\n895 |         DESCR=description, details=data_description,\n896 |         url=\"https://www.openml.org/d/{}\".format(data_id))\n897 | \n898 |     return bunch\n```\n\nFound function `sklearn/datasets/_openml.py:_download_data_to_bunch.postprocess`.\nSource: Retrieved entity using keyword search (bm25).\n```\n582 | def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n```\n\n\n\n##Searching for term \"data_home\"...\n### Search Result:\nFound function `sklearn/datasets/_species_distributions.py:fetch_species_distributions`.\nSource: Retrieved code content using keyword search (bm25).\n```\n142 | def fetch_species_distributions(*, data_home=None,\n143 |                                 download_if_missing=True):\n144 |     \"\"\"Loader for species distribution dataset from Phillips et. al. (2006)\n145 | \n146 |     Read more in the :ref:`User Guide <datasets>`.\n147 | \n148 |     Parameters\n149 |     ----------\n150 |     data_home : str, default=None\n151 |         Specify another download and cache folder for the datasets. By default\n152 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n153 | \n154 |     download_if_missing : bool, default=True\n155 |         If False, raise a IOError if the data is not locally available\n156 |         instead of trying to download the data from the source site.\n157 | \n158 |     Returns\n159 |     -------\n160 |     data : :class:`~sklearn.utils.Bunch`\n161 |         Dictionary-like object, with the following attributes.\n162 | \n163 |         coverages : array, shape = [14, 1592, 1212]\n164 |             These represent the 14 features measured\n165 |             at each point of the map grid.\n166 |             The latitude/longitude values for the grid are discussed below.\n167 |             Missing data is represented by the value -9999.\n168 |         train : record array, shape = (1624,)\n169 |             The training points for the data.  Each point has three fields:\n170 | \n171 |             - train['species'] is the species name\n172 |             - train['dd long'] is the longitude, in degrees\n173 |             - train['dd lat'] is the latitude, in degrees\n174 |         test : record array, shape = (620,)\n175 |             The test points for the data.  Same format as the training data.\n176 |         Nx, Ny : integers\n177 |             The number of longitudes (x) and latitudes (y) in the grid\n178 |         x_left_lower_corner, y_left_lower_corner : floats\n179 |             The (x,y) position of the lower-left corner, in degrees\n180 |         grid_size : float\n181 |             The spacing between points of the grid, in degrees\n182 | \n183 |     References\n184 |     ----------\n185 | \n186 |     * `\"Maximum entropy modeling of species geographic distributions\"\n187 |       <http://rob.schapire.net/papers/ecolmod.pdf>`_\n188 |       S. J. Phillips, R. P. Anderson, R. E. Schapire - Ecological Modelling,\n189 |       190:231-259, 2006.\n190 | \n191 |     Notes\n192 |     -----\n193 | \n194 |     This dataset represents the geographic distribution of species.\n195 |     The dataset is provided by Phillips et. al. (2006).\n196 | \n197 |     The two species are:\n198 | \n199 |     - `\"Bradypus variegatus\"\n200 |       <http://www.iucnredlist.org/details/3038/0>`_ ,\n201 |       the Brown-throated Sloth.\n202 | \n203 |     - `\"Microryzomys minutus\"\n204 |       <http://www.iucnredlist.org/details/13408/0>`_ ,\n205 |       also known as the Forest Small Rice Rat, a rodent that lives in Peru,\n206 |       Colombia, Ecuador, Peru, and Venezuela.\n207 | \n208 |     - For an example of using this dataset with scikit-learn, see\n209 |       :ref:`examples/applications/plot_species_distribution_modeling.py\n210 |       <sphx_glr_auto_examples_applications_plot_species_distribution_modeling.py>`.\n211 |     \"\"\"\n212 |     data_home = get_data_home(data_home)\n213 |     if not exists(data_home):\n214 |         makedirs(data_home)\n215 | \n216 |     # Define parameters for the data files.  These should not be changed\n217 |     # unless the data model changes.  They will be saved in the npz file\n218 |     # with the downloaded data.\n219 |     extra_params = dict(x_left_lower_corner=-94.8,\n220 |                         Nx=1212,\n221 |                         y_left_lower_corner=-56.05,\n222 |                         Ny=1592,\n223 |                         grid_size=0.05)\n224 |     dtype = np.int16\n225 | \n226 |     archive_path = _pkl_filepath(data_home, DATA_ARCHIVE_NAME)\n227 | \n228 |     if not exists(archive_path):\n229 |         if not download_if_missing:\n230 |             raise IOError(\"Data not found and `download_if_missing` is False\")\n231 |         logger.info('Downloading species data from %s to %s' % (\n232 |             SAMPLES.url, data_home))\n233 |         samples_path = _fetch_remote(SAMPLES, dirname=data_home)\n234 |         with np.load(samples_path) as X:  # samples.zip is a valid npz\n235 |             for f in X.files:\n236 |                 fhandle = BytesIO(X[f])\n237 |                 if 'train' in f:\n238 |                     train = _load_csv(fhandle)\n239 |                 if 'test' in f:\n240 |                     test = _load_csv(fhandle)\n241 |         remove(samples_path)\n242 | \n243 |         logger.info('Downloading coverage data from %s to %s' % (\n244 |             COVERAGES.url, data_home))\n245 |         coverages_path = _fetch_remote(COVERAGES, dirname=data_home)\n246 |         with np.load(coverages_path) as X:  # coverages.zip is a valid npz\n247 |             coverages = []\n248 |             for f in X.files:\n249 |                 fhandle = BytesIO(X[f])\n250 |                 logger.debug(' - converting {}'.format(f))\n251 |                 coverages.append(_load_coverage(fhandle))\n252 |             coverages = np.asarray(coverages, dtype=dtype)\n253 |         remove(coverages_path)\n254 | \n255 |         bunch = Bunch(coverages=coverages,\n256 |                       test=test,\n257 |                       train=train,\n258 |                       **extra_params)\n259 |         joblib.dump(bunch, archive_path, compress=9)\n260 |     else:\n261 |         bunch = joblib.load(archive_path)\n262 | \n263 |     return bunch\n```\n\nFound function `sklearn/datasets/_kddcup99.py:fetch_kddcup99`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 49 | def fetch_kddcup99(*, subset=None, data_home=None, shuffle=False,\n 50 |                    random_state=None,\n 51 |                    percent10=True, download_if_missing=True, return_X_y=False):\n 52 |     \"\"\"Load the kddcup99 dataset (classification).\n 53 | \n 54 |     Download it if necessary.\n 55 | \n 56 |     =================   ====================================\n 57 |     Classes                                               23\n 58 |     Samples total                                    4898431\n 59 |     Dimensionality                                        41\n 60 |     Features            discrete (int) or continuous (float)\n 61 |     =================   ====================================\n 62 | \n 63 |     Read more in the :ref:`User Guide <kddcup99_dataset>`.\n 64 | \n 65 |     .. versionadded:: 0.18\n 66 | \n 67 |     Parameters\n 68 |     ----------\n 69 |     subset : {'SA', 'SF', 'http', 'smtp'}, default=None\n 70 |         To return the corresponding classical subsets of kddcup 99.\n 71 |         If None, return the entire kddcup 99 dataset.\n 72 | \n 73 |     data_home : str, default=None\n 74 |         Specify another download and cache folder for the datasets. By default\n 75 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n 76 |         .. versionadded:: 0.19\n 77 | \n 78 |     shuffle : bool, default=False\n 79 |         Whether to shuffle dataset.\n 80 | \n 81 |     random_state : int or RandomState instance, default=None\n 82 |         Determines random number generation for dataset shuffling and for\n 83 |         selection of abnormal samples if `subset='SA'`. Pass an int for\n 84 |         reproducible output across multiple function calls.\n 85 |         See :term:`Glossary <random_state>`.\n 86 | \n 87 |     percent10 : bool, default=True\n 88 |         Whether to load only 10 percent of the data.\n 89 | \n 90 |     download_if_missing : bool, default=True\n 91 |         If False, raise a IOError if the data is not locally available\n 92 |         instead of trying to download the data from the source site.\n 93 | \n 94 |     return_X_y : bool, default=False\n 95 |         If True, returns ``(data, target)`` instead of a Bunch object. See\n 96 |         below for more information about the `data` and `target` object.\n 97 | \n 98 |         .. versionadded:: 0.20\n 99 | \n100 |     Returns\n101 |     -------\n102 |     data : :class:`~sklearn.utils.Bunch`\n103 |         Dictionary-like object, with the following attributes.\n104 | \n105 |         data : ndarray of shape (494021, 41)\n106 |             The data matrix to learn.\n107 |         target : ndarray of shape (494021,)\n108 |             The regression target for each sample.\n109 |         DESCR : str\n110 |             The full description of the dataset.\n111 | \n112 |     (data, target) : tuple if ``return_X_y`` is True\n113 | \n114 |         .. versionadded:: 0.20\n115 |     \"\"\"\n116 |     data_home = get_data_home(data_home=data_home)\n117 |     kddcup99 = _fetch_brute_kddcup99(data_home=data_home,\n118 |                                      percent10=percent10,\n119 |                                      download_if_missing=download_if_missing)\n120 | \n121 |     data = kddcup99.data\n122 |     target = kddcup99.target\n123 | \n124 |     if subset == 'SA':\n125 |         s = target == b'normal.'\n126 |         t = np.logical_not(s)\n127 |         normal_samples = data[s, :]\n128 |         normal_targets = target[s]\n129 |         abnormal_samples = data[t, :]\n130 |         abnormal_targets = target[t]\n131 | \n132 |         n_samples_abnormal = abnormal_samples.shape[0]\n133 |         # selected abnormal samples:\n134 |         random_state = check_random_state(random_state)\n135 |         r = random_state.randint(0, n_samples_abnormal, 3377)\n136 |         abnormal_samples = abnormal_samples[r]\n137 |         abnormal_targets = abnormal_targets[r]\n138 | \n139 |         data = np.r_[normal_samples, abnormal_samples]\n140 |         target = np.r_[normal_targets, abnormal_targets]\n141 | \n142 |     if subset == 'SF' or subset == 'http' or subset == 'smtp':\n143 |         # select all samples with positive logged_in attribute:\n144 |         s = data[:, 11] == 1\n145 |         data = np.c_[data[s, :11], data[s, 12:]]\n146 |         target = target[s]\n147 | \n148 |         data[:, 0] = np.log((data[:, 0] + 0.1).astype(float, copy=False))\n149 |         data[:, 4] = np.log((data[:, 4] + 0.1).astype(float, copy=False))\n150 |         data[:, 5] = np.log((data[:, 5] + 0.1).astype(float, copy=False))\n151 | \n152 |         if subset == 'http':\n153 |             s = data[:, 2] == b'http'\n154 |             data = data[s]\n155 |             target = target[s]\n156 |             data = np.c_[data[:, 0], data[:, 4], data[:, 5]]\n157 | \n158 |         if subset == 'smtp':\n159 |             s = data[:, 2] == b'smtp'\n160 |             data = data[s]\n161 |             target = target[s]\n162 |             data = np.c_[data[:, 0], data[:, 4], data[:, 5]]\n163 | \n164 |         if subset == 'SF':\n165 |             data = np.c_[data[:, 0], data[:, 2], data[:, 4], data[:, 5]]\n166 | \n167 |     if shuffle:\n168 |         data, target = shuffle_method(data, target, random_state=random_state)\n169 | \n170 |     module_path = dirname(__file__)\n171 |     with open(join(module_path, 'descr', 'kddcup99.rst')) as rst_file:\n172 |         fdescr = rst_file.read()\n173 | \n174 |     if return_X_y:\n175 |         return data, target\n176 | \n177 |     return Bunch(data=data, target=target, DESCR=fdescr)\n```\n\nFound function `sklearn/datasets/_base.py:get_data_home`.\nSource: Retrieved entity using keyword search (bm25).\n```\n30 | def get_data_home(data_home=None) -> str:\n31 |     \"\"\"Return the path of the scikit-learn data dir.\n32 | \n33 |     This folder is used by some large dataset loaders to avoid downloading the\n34 |     data several times.\n35 | \n36 |     By default the data dir is set to a folder named 'scikit_learn_data' in the\n37 |     user home folder.\n38 | \n39 |     Alternatively, it can be set by the 'SCIKIT_LEARN_DATA' environment\n40 |     variable or programmatically by giving an explicit folder path. The '~'\n41 |     symbol is expanded to the user home folder.\n42 | \n43 |     If the folder does not already exist, it is automatically created.\n44 | \n45 |     Parameters\n46 |     ----------\n47 |     data_home : str | None\n48 |         The path to scikit-learn data dir.\n49 |     \"\"\"\n50 |     if data_home is None:\n51 |         data_home = environ.get('SCIKIT_LEARN_DATA',\n52 |                                 join('~', 'scikit_learn_data'))\n53 |     data_home = expanduser(data_home)\n54 |     if not exists(data_home):\n55 |         makedirs(data_home)\n56 |     return data_home\n```\n\nFound function `sklearn/datasets/_base.py:clear_data_home`.\nSource: Retrieved entity using keyword search (bm25).\n```\n59 | def clear_data_home(data_home=None):\n60 |     \"\"\"Delete all the content of the data home cache.\n61 | \n62 |     Parameters\n63 |     ----------\n64 |     data_home : str | None\n65 |         The path to scikit-learn data dir.\n66 |     \"\"\"\n67 |     data_home = get_data_home(data_home)\n68 |     shutil.rmtree(data_home)\n```\n\nFound function `sklearn/datasets/_base.py:_convert_data_dataframe`.\nSource: Retrieved code content using keyword search (bm25).\n```\n71 | def _convert_data_dataframe(caller_name, data, target,\n72 |                             feature_names, target_names):\n73 |     pd = check_pandas_support('{} with as_frame=True'.format(caller_name))\n74 |     data_df = pd.DataFrame(data, columns=feature_names)\n75 |     target_df = pd.DataFrame(target, columns=target_names)\n76 |     combined_df = pd.concat([data_df, target_df], axis=1)\n77 |     X = combined_df[feature_names]\n78 |     y = combined_df[target_names]\n79 |     if y.shape[1] == 1:\n80 |         y = y.iloc[:, 0]\n81 |     return combined_df, X, y\n```\n\nFound funct