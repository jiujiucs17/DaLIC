       value displayed will be the length of that segment.\n2797 |               (useful for stacked bars, i.e.,\n2798 |               :doc:`/gallery/lines_bars_and_markers/bar_label_demo`)\n2799 | \n2800 |         padding : float, default: 0\n2801 |             Distance of label from the end of the bar, in points.\n2802 | \n2803 |         **kwargs\n2804 |             Any remaining keyword arguments are passed through to\n2805 |             `.Axes.annotate`. The alignment parameters (\n2806 |             *horizontalalignment* / *ha*, *verticalalignment* / *va*) are\n2807 |             not supported because the labels are automatically aligned to\n2808 |             the bars.\n2809 | \n2810 |         Returns\n2811 |         -------\n2812 |         list of `.Annotation`\n2813 |             A list of `.Annotation` instances for the labels.\n2814 |         \"\"\"\n2815 |         for key in ['horizontalalignment', 'ha', 'verticalalignment', 'va']:\n2816 |             if key in kwargs:\n2817 |                 raise ValueError(\n2818 |                     f\"Passing {key!r} to bar_label() is not supported.\")\n2819 | \n2820 |         a, b = self.yaxis.get_view_interval()\n2821 |         y_inverted = a > b\n2822 |         c, d = self.xaxis.get_view_interval()\n2823 |         x_inverted = c > d\n2824 | \n2825 |         # want to know whether to put label on positive or negative direction\n2826 |         # cannot use np.sign here because it will return 0 if x == 0\n2827 |         def sign(x):\n2828 |             return 1 if x >= 0 else -1\n2829 | \n2830 |         _api.check_in_list(['edge', 'center'], label_type=label_type)\n2831 | \n2832 |         bars = container.patches\n2833 |         errorbar = container.errorbar\n2834 |         datavalues = container.datavalues\n2835 |         orientation = container.orientation\n2836 | \n2837 |         if errorbar:\n2838 |             # check \"ErrorbarContainer\" for the definition of these elements\n2839 |             lines = errorbar.lines  # attribute of \"ErrorbarContainer\" (tuple)\n2840 |             barlinecols = lines[2]  # 0: data_line, 1: caplines, 2: barlinecols\n2841 |             barlinecol = barlinecols[0]  # the \"LineCollection\" of error bars\n2842 |             errs = barlinecol.get_segments()\n2843 |         else:\n2844 |             errs = []\n2845 | \n2846 |         if labels is None:\n2847 |             labels = []\n2848 | \n2849 |         annotations = []\n2850 | \n2851 |         for bar, err, dat, lbl in itertools.zip_longest(\n2852 |                 bars, errs, datavalues, labels\n2853 |         ):\n2854 |             (x0, y0), (x1, y1) = bar.get_bbox().get_points()\n2855 |             xc, yc = (x0 + x1) / 2, (y0 + y1) / 2\n2856 | \n2857 |             if orientation == \"vertical\":\n2858 |                 extrema = max(y0, y1) if dat >= 0 else min(y0, y1)\n2859 |                 length = abs(y0 - y1)\n2860 |             else:  # horizontal\n2861 |                 extrema = max(x0, x1) if dat >= 0 else min(x0, x1)\n2862 |                 length = abs(x0 - x1)\n2863 | \n2864 |             if err is None or np.size(err) == 0:\n2865 |                 endpt = extrema\n2866 |             elif orientation == \"vertical\":\n2867 |                 endpt = err[:, 1].max() if dat >= 0 else err[:, 1].min()\n2868 |             else:  # horizontal\n2869 |                 endpt = err[:, 0].max() if dat >= 0 else err[:, 0].min()\n2870 | \n2871 |             if label_type == \"center\":\n2872 |                 value = sign(dat) * length\n2873 |             else:  # edge\n2874 |                 value = extrema\n2875 | \n2876 |             if label_type == \"center\":\n2877 |                 xy = (0.5, 0.5)\n2878 |                 kwargs[\"xycoords\"] = (\n2879 |                     lambda r, b=bar:\n2880 |                         mtransforms.Bbox.intersection(\n2881 |                             b.get_window_extent(r), b.get_clip_box()\n2882 |                         ) or mtransforms.Bbox.null()\n2883 |                 )\n2884 |             else:  # edge\n2885 |                 if orientation == \"vertical\":\n2886 |                     xy = xc, endpt\n2887 |                 else:  # horizontal\n2888 |                     xy = endpt, yc\n2889 | \n2890 |             if orientation == \"vertical\":\n2891 |                 y_direction = -1 if y_inverted else 1\n2892 |                 xytext = 0, y_direction * sign(dat) * padding\n2893 |             else:  # horizontal\n2894 |                 x_direction = -1 if x_inverted else 1\n2895 |                 xytext = x_direction * sign(dat) * padding, 0\n2896 | \n2897 |             if label_type == \"center\":\n2898 |                 ha, va = \"center\", \"center\"\n2899 |             else:  # edge\n2900 |                 if orientation == \"vertical\":\n2901 |                     ha = 'center'\n2902 |                     if y_inverted:\n2903 |                         va = 'top' if dat > 0 else 'bottom'  # also handles NaN\n2904 |                     else:\n2905 |                         va = 'top' if dat < 0 else 'bottom'  # also handles NaN\n2906 |                 else:  # horizontal\n2907 |                     if x_inverted:\n2908 |                         ha = 'right' if dat > 0 else 'left'  # also handles NaN\n2909 |                     else:\n2910 |                         ha = 'right' if dat < 0 else 'left'  # also handles NaN\n2911 |                     va = 'center'\n2912 | \n2913 |             if np.isnan(dat):\n2914 |                 lbl = ''\n2915 | \n2916 |             if lbl is None:\n2917 |                 if isinstance(fmt, str):\n2918 |                     lbl = cbook._auto_format_str(fmt, value)\n2919 |                 elif callable(fmt):\n2920 |                     lbl = fmt(value)\n2921 |                 else:\n2922 |                     raise TypeError(\"fmt must be a str or callable\")\n2923 |             annotation = self.annotate(lbl,\n2924 |                                        xy