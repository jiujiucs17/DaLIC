s : int\n152 |       Number of required axes. Exceeded axes are set invisible. Default is\n153 |       nrows * ncols.\n154 | \n155 |     sharex : bool\n156 |       If True, the X axis will be shared amongst all subplots.\n157 | \n158 |     sharey : bool\n159 |       If True, the Y axis will be shared amongst all subplots.\n160 | \n161 |     squeeze : bool\n162 | \n163 |       If True, extra dimensions are squeezed out from the returned axis object:\n164 |         - if only one subplot is constructed (nrows=ncols=1), the resulting\n165 |         single Axis object is returned as a scalar.\n166 |         - for Nx1 or 1xN subplots, the returned object is a 1-d numpy object\n167 |         array of Axis objects are returned as numpy 1-d arrays.\n168 |         - for NxM subplots with N>1 and M>1 are returned as a 2d array.\n169 | \n170 |       If False, no squeezing is done: the returned axis object is always\n171 |       a 2-d array containing Axis instances, even if it ends up being 1x1.\n172 | \n173 |     subplot_kw : dict\n174 |       Dict with keywords passed to the add_subplot() call used to create each\n175 |       subplots.\n176 | \n177 |     ax : Matplotlib axis object, optional\n178 | \n179 |     layout : tuple\n180 |       Number of rows and columns of the subplot grid.\n181 |       If not specified, calculated from naxes and layout_type\n182 | \n183 |     layout_type : {'box', 'horizontal', 'vertical'}, default 'box'\n184 |       Specify how to layout the subplot grid.\n185 | \n186 |     fig_kw : Other keyword arguments to be passed to the figure() call.\n187 |         Note that all keywords not recognized above will be\n188 |         automatically included here.\n189 | \n190 |     Returns\n191 |     -------\n192 |     fig, ax : tuple\n193 |       - fig is the Matplotlib Figure object\n194 |       - ax can be either a single axis object or an array of axis objects if\n195 |       more than one subplot was created.  The dimensions of the resulting array\n196 |       can be controlled with the squeeze keyword, see above.\n197 | \n198 |     Examples\n199 |     --------\n200 |     x = np.linspace(0, 2*np.pi, 400)\n201 |     y = np.sin(x**2)\n202 | \n203 |     # Just a figure and one subplot\n204 |     f, ax = plt.subplots()\n205 |     ax.plot(x, y)\n206 |     ax.set_title('Simple plot')\n207 | \n208 |     # Two subplots, unpack the output array immediately\n209 |     f, (ax1, ax2) = plt.subplots(1, 2, sharey=True)\n210 |     ax1.plot(x, y)\n211 |     ax1.set_title('Sharing Y axis')\n212 |     ax2.scatter(x, y)\n213 | \n214 |     # Four polar axes\n215 |     plt.subplots(2, 2, subplot_kw=dict(polar=True))\n216 |     \"\"\"\n217 |     import matplotlib.pyplot as plt\n218 | \n219 |     if subplot_kw is None:\n220 |         subplot_kw = {}\n221 | \n222 |     if ax is None:\n223 |         fig = plt.figure(**fig_kw)\n224 |     else:\n225 |         if is_list_like(ax):\n226 |             if squeeze:\n227 |                 ax = flatten_axes(ax)\n228 |             if layout is not None:\n229 |                 warnings.warn(\n230 |                     \"When passing multiple axes, layout keyword is ignored.\",\n231 |                     UserWarning,\n232 |                 )\n233 |             if sharex or sharey:\n234 |                 warnings.warn(\n235 |                     \"When passing multiple axes, sharex and sharey \"\n236 |                     \"are ignored. These settings must be specified when creating axes.\",\n237 |                     UserWarning,\n238 |                     stacklevel=find_stack_level(),\n239 |                 )\n240 |             if ax.size == naxes:\n241 |                 fig = ax.flat[0].get_figure()\n242 |                 return fig, ax\n243 |             else:\n244 |                 raise ValueError(\n245 |                     f\"The number of passed axes must be {naxes}, the \"\n246 |                     \"same as the output plot\"\n247 |                 )\n248 | \n249 |         fig = ax.get_figure()\n250 |         # if ax is passed and a number of subplots is 1, return ax as it is\n251 |         if naxes == 1:\n252 |             if squeeze:\n253 |                 return fig, ax\n254 |             else:\n255 |                 return fig, flatten_axes(ax)\n256 |         else:\n257 |             warnings.warn(\n258 |                 \"To output multiple subplots, the figure containing \"\n259 |                 \"the passed axes is being cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sharex:\n276 |         subplot_kw[\"sharex\"] = ax0\n277 |     if sharey:\n278 |         subplot_kw[\"sharey\"] = ax0\n279 |     axarr[0] = ax0\n280 | \n281 |     # Note off-by-one counting because add_subplot uses the MATLAB 1-based\n282 |     # convention.\n283 |     for i in range(1, nplots):\n284 |         kwds = subplot_kw.copy()\n285 |         # Set sharex and sharey to None for blank/dummy axes, these can\n286 |         # interfere with proper axis limits on the visible axes if\n287 |         # they share axes e.g. issue #7528\n288 |         if i >= naxes:\n289 |             kwds[\"sharex\"] = None\n290 |             kwds[\"sharey\"] = None\n291 |         ax = fig.add_subplot(nrows, ncols, i + 1, **kwds)\n292 |         axarr[i] = ax\n293 | \n294 |     if naxes != nplots:\n295 |         for ax in axarr[naxes:]:\n296 |             ax.set_visible(False)\n297 | \n298 |     handle_shared_axes(axarr, nplots, naxes, nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 |             axes = axarr.reshape(nrows, ncols).squeeze()\n308 |     else:\n309 |         # returned axis array will be always 2-d, even if nrows=ncols=1\n310 |         axes = axarr.reshape(nrows, ncols)\n311 | \n312 |     return fig, axes\n```\n\n\n##Searching for entity `pandas/plotting/_core.py:PlotAccessor`...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Exact match found for entity name `pandas/plotting/_core.py:PlotAccessor`.\n```\n 620 | class PlotAccessor(PandasObject):\n 621 |     \"\"\"\n 622 |     Make plots of Series or DataFrame.\n 623 | \n 624 |     Uses the backend specified by the\n 625 |     option ``plotting.backend``. By default, matplotlib is used.\n 626 | \n 627 |     Parameters\n 628 |     ----------\n 629 |     data : Series or DataFrame\n 630 |         The object for which the method is called.\n 631 |     x : label or position, default None\n 632 |         Only used if data is a DataFrame.\n 633 |     y : label, position or list of label, positions, default None\n 634 |         Allows plotting of one column versus another. Only used if data is a\n 635 |         DataFrame.\n 636 |     kind : str\n 637 |         The kind of plot to produce:\n 638 | \n 639 |         - 'line' : line plot (default)\n 640 |         - 'bar' : vertical bar plot\n 641 |         - 'barh' : horizontal bar plot\n 642 |         - 'hist' : histogram\n 643 |         - 'box' : boxplot\n 644 |         - 'kde' : Kernel Density Estimation plot\n 645 |         - 'density' : same as 'kde'\n 646 |         - 'area' : area plot\n 647 |         - 'pie' : pie plot\n 648 |         - 'scatter' : scatter plot (DataFrame only)\n 649 |         - 'hexbin' : hexbin plot (DataFrame only)\n 650 |     ax : matplotlib axes object, default None\n 651 |         An axes of the current figure.\n 652 |     subplots : bool, default False\n 653 |         Make separate subplots for each column.\n 654 |     sharex : bool, default True if ax is None else False\n 655 |         In case ``subplots=True``, share x axis and set some x axis labels\n 656 |         to invisible; defaults to True if ax is None otherwise False if\n 657 |         an ax is passed in; Be aware, that passing in both an ax and\n 658 |         ``sharex=True`` will alter all x axis labels for all axis in a figure.\n 659 |     sharey : bool, default False\n 660 |         In case ``subplots=True``, share y axis and set some y axis labels to invisible.\n 661 |     layout : tuple, optional\n 662 |         (rows, columns) for the layout of subplots.\n 663 |     figsize : a tuple (width, height) in inches\n 664 |         Size of a figure object.\n 665 |     use_index : bool, default True\n 666 |         Use index as ticks for x axis.\n 667 |     title : str or list\n 668 |         Title to use for the plot. If a string is passed, print the string\n 669 |         at the top of the figure. If a list is passed and `subplots` is\n 670 |         True, print each item in the list above the corresponding subplot.\n 671 |     grid : bool, default None (matlab style default)\n 672 |         Axis grid lines.\n 673 |     legend : bool or {'reverse'}\n 674 |         Place legend on axis subplots.\n 675 |     style : list or dict\n 676 |         The matplotlib line style per column.\n 677 |     logx : bool or 'sym', default False\n 678 |         Use log scaling or symlog scaling on x axis.\n 679 |         .. versionchanged:: 0.25.0\n 680 | \n 681 |     logy : bool or 'sym' default False\n 682 |         Use log scaling or symlog scaling on y axis.\n 683 |         .. versionchanged:: 0.25.0\n 684 | \n 685 |     loglog : bool or 'sym', default False\n 686 |         Use log scaling or symlog scaling on both x and y axes.\n 687 |         .. versionchanged:: 0.25.0\n 688 | \n 689 |     xticks : sequence\n 690 |         Values to use for the xticks.\n 691 |     yticks : sequence\n 692 |         Values to use for the yticks.\n 693 |     xlim : 2-tuple/list\n 694 |         Set the x limits of the current axes.\n 695 |     ylim : 2-tuple/list\n 696 |         Set the y limits of the current axes.\n 697 |     xlabel : label, optional\n 698 |         Name to use for the xlabel on x-axis. Default uses index name as xlabel, or the\n 699 |         x-column name for planar plots.\n 700 | \n 701 |         .. versionadded:: 1.1.0\n 702 | \n 703 |         .. versionchanged:: 1.2.0\n 704 | \n 705 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 706 | \n 707 |     ylabel : label, optional\n 708 |         Name to use for the ylabel on y-axis. Default will show no ylabel, or the\n 709 |         y-column name for planar plots.\n 710 | \n 711 |         .. versionadded:: 1.1.0\n 712 | \n 713 |         .. versionchanged:: 1.2.0\n 714 | \n 715 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 716 | \n 717 |     rot : int, default None\n 718 |         Rotation for ticks (xticks for vertical, yticks for horizontal\n 719 |         plots).\n 720 |     fontsize : int, default None\n 721 |         Font size for xticks and yticks.\n 722 |     colormap : str or matplotlib colormap object, default None\n 723 |         Colormap to select colors from. If string, load colormap with that\n 724 |         name from matplotlib.\n 725 |     colorbar : bool, optional\n 726 |         If True, plot colorbar (only relevant for 'scatter' and 'hexbin'\n 727 |         plots).\n 728 |     position : float\n 729 |         Specify relative alignments for bar plot layout.\n 730 |         From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 731 |         (center).\n 732 |     table : bool, Series or DataFrame, default False\n 733 |         If True, draw a table using the data in the DataFrame and the data\n 734 |         will be transposed to meet matplotlib's default layout.\n 735 |         If a Series or DataFrame is passed, use passed data to draw a\n 736 |         table.\n 737 |     yerr : DataFrame, Series, array-like, dict and str\n 738 |         See :ref:`Plotting with Error Bars <visualization.errorbars>` for\n 739 |         detail.\n 740 |     xerr : DataFrame, Series, array-like, dict and str\n 741 |         Equivalent to yerr.\n 742 |     stacked : bool, default False in line and bar plots, and True in area plot\n 743 |         If True, create stacked plot.\n 744 |     sort_columns : bool, default False\n 745 |         Sort column names to determine plot ordering.\n 746 |     secondary_y : bool or sequence, default False\n 747 |         Whether to plot on the secondary y-axis if a list/tuple, which\n 748 |         columns to plot on secondary y-axis.\n 749 |     mark_right : bool, default True\n 750 |         When using a secondary_y axis, automatically mark the column\n 751 |         labels with \"(right)\" in the legend.\n 752 |     include_bool : bool, default is False\n 753 |         If True, boolean values can be plotted.\n 754 |     backend : str, default None\n 755 |         Backend to use instead of the backend specified in the option\n 756 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n 757 |         specify the ``plotting.backend`` for the whole session, set\n 758 |         ``pd.options.plotting.backend``.\n 759 | \n 760 |         .. versionadded:: 1.0.0\n 761 | \n 762 |     **kwargs\n 763 |         Options to pass to matplotlib plotting method.\n 764 | \n 765 |     Returns\n 766 |     -------\n 767 |     :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n 768 |         If the backend is not the default matplotlib one, the return value\n 769 |         will be the object returned by the backend.\n 770 | \n 771 |     Notes\n 772 |     -----\n 773 |     - See matplotlib documentation online for more on this subject\n 774 |     - If `kind` = 'bar' or 'barh', you can specify relative alignments\n 775 |       for bar plot layout by `position` keyword.\n 776 |       From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 777 |       (center)\n 778 |     \"\"\"\n 779 | \n 780 |     _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n 781 |     _series_kinds = (\"pie\",)\n 782 |     _dataframe_kinds = (\"scatter\", \"hexbin\")\n 783 |     _kind_aliases = {\"density\": \"kde\"}\n 784 |     _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n 785 | \n 786 |     def __init__(self, data) -> None:\n 787 |         self._parent = data\n 788 | \n 789 |     @staticmethod\n 790 |     def _get_call_args(backend_name, data, args, kwargs):\n 791 |         \"\"\"\n 792 |         This function makes calls to this accessor `__call__` method compatible\n 793 |         with the previous `SeriesPlotMethods.__call__` and\n 794 |         `DataFramePlotMethods.__call__`. Those had slightly different\n 795 |         signatures, since `DataFramePlotMethods` accepted `x` and `y`\n 796 |         parameters.\n 797 |         \"\"\"\n 798 |         if isinstance(data, ABCSeries):\n 799 |             arg_def = [\n 800 |                 (\"kind\", \"line\"),\n 801 |                 (\"ax\", None),\n 802 |                 (\"figsize\", None),\n 803 |                 (\"use_index\", True),\n 804 |                 (\"title\", None),\n 805 |                 (\"grid\", None),\n 806 |                 (\"legend\", False),\n 807 |                 (\"style\", None),\n 808 |                 (\"logx\", False),\n 809 |                 (\"logy\", False),\n 810 |                 (\"loglog\", False),\n 811 |                 (\"xticks\", None),\n 812 |                 (\"