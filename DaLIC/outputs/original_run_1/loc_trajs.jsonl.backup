differ from _interpolate_1d because it only\n375 |     includes what is needed for Block.interpolate.\n376 |     \"\"\"\n377 |     # validate the interp method\n378 |     clean_interp_method(method, index, **kwargs)\n379 | \n380 |     if is_valid_na_for_dtype(fill_value, data.dtype):\n381 |         fill_value = na_value_for_dtype(data.dtype, compat=False)\n382 | \n383 |     if method == \"time\":\n384 |         if not needs_i8_conversion(index.dtype):\n385 |             raise ValueError(\n386 |                 \"time-weighted interpolation only works \"\n387 |                 \"on Series or DataFrames with a \"\n388 |                 \"DatetimeIndex\"\n389 |             )\n390 |         method = \"values\"\n391 | \n392 |     limit_direction = validate_limit_direction(limit_direction)\n393 |     limit_area_validated = validate_limit_area(limit_area)\n394 | \n395 |     # default limit is unlimited GH #16282\n396 |     limit = algos.validate_limit(nobs=None, limit=limit)\n397 | \n398 |     indices = _index_to_interp_indices(index, method)\n399 | \n400 |     def func(yvalues: np.ndarray) -> None:\n401 |         # process 1-d slices in the axis direction\n402 | \n403 |         _interpolate_1d(\n404 |             indices=indices,\n405 |             yvalues=yvalues,\n406 |             method=method,\n407 |             limit=limit,\n408 |             limit_direction=limit_direction,\n409 |             limit_area=limit_area_validated,\n410 |             fill_value=fill_value,\n411 |             bounds_error=False,\n412 |             mask=mask,\n413 |             **kwargs,\n414 |         )\n415 | \n416 |     # error: No overload variant of \"apply_along_axis\" matches\n417 |     # argument types \"Callable[[ndarray[Any, Any]], None]\",\n418 |     # \"int\", \"ndarray[Any, Any]\"\n419 |     np.apply_along_axis(func, axis, data)\n```\n\nFound function `pandas/core/missing.py:_index_to_interp_indices`.\nSource: Retrieved entity using keyword search (bm25).\n```\n422 | def _index