 option.\n355 |         X = np.asarray(X)\n356 | \n357 |     if hasattr(X, \"shape\"):\n358 |         if not hasattr(X.shape, \"__len__\") or len(X.shape) <= 1:\n359 |             message += f\" with shape {X.shape}\"\n360 |             raise TypeError(message)\n361 |         return X.shape[1]\n362 | \n363 |     first_sample = X[0]\n364 | \n365 |     # Do not consider an array-like of strings or dicts to be a 2D array\n366 |     if isinstance(first_sample, (str, bytes, dict)):\n367 |         message += f\" where the samples are of type {type(first_sample).__qualname__}\"\n368 |         raise TypeError(message)\n369 | \n370 |     try:\n371 |         # If X is a list of lists, for instance, we assume that all nested\n372 |         # lists have the same length without checking or converting to\n373 |         # a numpy array to keep this function call as cheap as possible.\n374 |         return len(first_sample)\n375 |     except Exception as err:\n376 |         raise TypeError(message) from err\n```\n\nFound function `sklearn/utils/validation.py:indexable`.\nSource: Retrieved entity using keyword search (bm25).\n```\n498 | def indexable(*iterables):\n499 |     \"\"\"Make arrays indexable for cross-validation.\n500 | \n501 |     Checks consistent length, passes through None, and ensures that everything\n502 |     can be indexed by converting sparse matrices to csr and converting\n503 |     non-iterable objects to arrays.\n504 | \n505 |     Parameters\n506 |     ----------\n507 |     *iterables : {lists, dataframes, ndarrays, sparse matrices}\n508 |         List of objects to ensure sliceability.\n509 | \n510 |     Returns\n511 |     -------\n512 |     result : list of {ndarray, sparse matrix, dataframe} or None\n513 |         Returns a list containing indexable arrays (i.e. NumPy array,\n514 |         sparse matrix, or dataframe) or `None`.\n515 | \n516 |     Examples\n517 |     --------\n518 |     >>> from sklearn.utils import indexable\n519 |     >>> from scipy.sparse import csr_matrix\n520 |     >>> import numpy as np\n521 |     >>> iterables = [\n522 |     ...     [1, 2, 3], np.array([2, 3, 4]), None, csr_matrix([[5], [6], [7]])\n523 |     ... ]\n524 |     >>> indexable(*iterables)\n525 |     [[1, 2, 3], array([2, 3, 4]), None, <...Sparse...dtype 'int64'...shape (3, 1)>]\n526 |     \"\"\"\n527 | \n528 |     result = [_make_indexable(X) for X in iterables]\n529 |     check_consistent_length(*result)\n530 |     return result\n```\n\nFound function `sklearn/utils/_param_validation.py:validate_params`.\nSource: Retrieved code content using keyword search (bm25).\n```\n148 | def validate_params(parameter_constraints, *, prefer_skip_nested_validation):\n149 |     \"\"\"Decorator to validate types and values of functions and methods.\n150 | \n151 |     Parameters\n152 |     ----------\n153 |     parameter_constraints : dict\n154 |         A dictionary `param_name: list of constraints`. See the docstring of\n155 |         `validate_parameter_constraints` for a description of the accepted constraints.\n156 | \n157 |         Note that the *args and **kwargs parameters are not validated and must not be\n158 |         present in the parameter_constraints dictionary.\n159 | \n160 |     prefer_skip_nested_validation : bool\n161 |         If True, the validation of parameters of inner estimators or functions\n162 |         called by the decorated function will be skipped.\n163 | \n164 |         This is useful to avoid validating many times the parameters passed by the\n165 |         user from the public facing API. It's also useful to avoid validating\n166 |         parameters that we pass internally to inner functions that are guaranteed to\n167 |         be valid by the test suite.\n168 | \n169 |         It should be set to True for most functions, except for those that receive\n170 |         non-validated objects as parameters or that are just wrappers around classes\n171 |         because they only perform a partial validation.\n172 | \n173 |     Returns\n174 |     -------\n175 |     decorated_function : function or method\n176 |         The decorated function.\n177 |     \"\"\"\n178 | \n179 |     def decorator(func):\n180 |         # The dict of parameter constraints is set as an attribute of the function\n181 |         # to make it possible to dynamically introspect the constraints for\n182 |         # automatic testing.\n183 |         setattr(func, \"_skl_parameter_constraints\", parameter_constraints)\n184 | \n185 |         @functools.wraps(func)\n186 |         def wrapper(*args, **kwargs):\n187 |             global_skip_validation = get_config()[\"skip_parameter_validation\"]\n188 |             if global_skip_validation:\n189 |                 return func(*args, **kwargs)\n190 | \n191 |             func_sig = signature(func)\n192 | \n193 |             # Map *args/**kwargs to the function signature\n194 |             params = func_sig.bind(*args, **kwargs)\n195 |             params.apply_defaults()\n196 | \n197 |             # ignore self/cls and positional/keyword markers\n198 |             to_ignore = [\n199 |                 p.name\n200 |                 for p in func_sig.parameters.values()\n201 |                 if p.kind in (p.VAR_POSITIONAL, p.VAR_KEYWORD)\n202 |             ]\n203 |             to_ignore += [\"self\", \"cls\"]\n204 |             params = {k: v for k, v in params.arguments.items() if k not in to_ignore}\n205 | \n206 |             validate_parameter_constraints(\n207 |                 parameter_constraints, params, caller_name=func.__qualname__\n208 |             )\n209 | \n210 |             try:\n211 |                 with config_context(\n212 |                     skip_parameter_validation=(\n213 |                         prefer_skip_nested_validation or global_skip_validation\n214 |                     )\n215 |                 ):\n216 |                     return func(*args, **kwargs)\n217 |             except InvalidParameterError as e:\n218 |                 # When the function is just a wrapper around an estimator, we allow\n219 |                 # the function to delegate validation to the estimator, but we replace\n220 |                 # the name of the estimator by the name of the function in the error\n221 |                 # message to avoid confusion.\n222 |                 msg = re.sub(\n223 |                     r\"parameter of \\w+ must be\",\n224 |                     f\"parameter of {func.__qualname__} must be\",\n225 |                     str(e),\n226 |                 )\n227 |                 raise InvalidParameterError(msg) from e\n228 | \n229 |         return wrapper\n230 | \n231 |     return decorator\n```\n\nFound file `sklearn/utils/validation.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/utils/validation.py` for the full content if needed.\n\n\n\n##Searching for term \"assert_docstrings docstring_check docstring validation\"...\n### Search Result:\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ===================================================\n 3 | Recursive feature elimination with cross-validation\n 4 | ===================================================\n 5 | \n 6 | A Recursive Feature Elimination (RFE) example with automatic tuning of the\n 7 | number of features selected with cross-validation.\n 8 | \n 9 | \"\"\"\n10 | \n11 | # Authors: The scikit-learn developers\n12 | # SPDX-License-Identifier: BSD-3-Clause\n13 | \n14 | # %%\n15 | # Data generation\n16 | # ---------------\n17 | #\n18 | # We build a classification task using 3 informative features. The introduction\n19 | # of 2 additional redundant (i.e. correlated) features has the effect that the\n20 | # selected features vary depending on the cross-validation fold. The remaining\n21 | # features are non-informative as they are drawn at random.\n22 | \n23 | from sklearn.datasets import make_classification\n24 | \n25 | X, y = make_classification(\n26 |     n_samples=500,\n27 |     n_features=15,\n28 |     n_informative=3,\n29 |     n_redundant=2,\n30 |     n_repeated=0,\n31 |     n_classes=8,\n32 |     n_clusters_per_class=1,\n33 |     class_sep=0.8,\n34 |     random_state=0,\n35 | )\n36 | \n37 | # %%\n38 | # Model training and selection\n39 | # ----------------------------\n40 | #\n41 | # We create the RFE object and compute the cross-validated scores. The scoring\n42 | # strategy \"accuracy\" optimizes the proportion of correctly classified samples.\n43 | \n44 | from sklearn.feature_selection import RFECV\n45 | from sklearn.linear_model import LogisticRegression\n46 | from sklearn.model_selection import StratifiedKFold\n47 | \n48 | min_features_to_select = 1  # Minimum number of features to consider\n49 | clf = LogisticRegression()\n50 | cv = StratifiedKFold(5)\n51 | \n52 | rfecv = RFECV(\n53 |     estimator=clf,\n54 |     step=1,\n55 |     cv=cv,\n56 |     scoring=\"accuracy\",\n57 |     min_features_to_select=min_features_to_select,\n58 |     n_jobs=2,\n59 | )\n60 | rfecv.fit(X, y)\n61 | \n62 | print(f\"Optimal number of features: {rfecv.n_features_}\")\n63 | \n64 | # %%\n65 | # In the present case, the model with 3 features (which corresponds to the true\n66 | # generative model) is found to be the most optimal.\n67 | #\n68 | # Plot number of features VS. cross-validation scores\n69 | # ---------------------------------------------------\n70 | \n71 | import matplotlib.pyplot as plt\n72 | import pandas as pd\n73 | \n74 | cv_results = pd.DataFrame(rfecv.cv_results_)\n75 | plt.figure()\n76 | plt.xlabel(\"Number of features selected\")\n77 | plt.ylabel(\"Mean test accuracy\")\n78 | plt.errorbar(\n79 |     x=cv_results[\"n_features\"],\n80 |     y=cv_results[\"mean_test_score\"],\n81 |     yerr=cv_results[\"std_test_score\"],\n82 | )\n83 | plt.title(\"Recursive Feature Elimination \\nwith correlated features\")\n84 | plt.show()\n85 | \n86 | # %%\n87 | # From the plot above one can further notice a plateau of equivalent scores\n88 | # (similar mean value and overlapping errorbars) for 3 to 5 selected features.\n89 | # This is the result of introducing correlated features. Indeed, the optimal\n90 | # model selected by the RFE can lie within this range, depending on the\n91 | # cross-validation technique. The test accuracy decreases above 5 selected\n92 | # features, this is, keeping non-informative features leads to over-fitting and\n93 | # is therefore detrimental for the statistical performance of the models.\n94 | \n```\n\nFound code snippet in file `examples/model_selection/plot_validation_curve.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==========================\n 3 | Plotting Validation Curves\n 4 | ==========================\n 5 | \n 6 | In this plot you can see the training scores and validation scores of an SVM\n 7 | for different values of the kernel parameter gamma. For very low values of\n 8 | gamma, you can see that both the training score and the validation score are\n 9 | low. This is called underfitting. Medium values of gamma will result in high\n10 | values for both scores, i.e. the classifier is performing fairly well. If gamma\n11 | is too high, the classifier will overfit, which means that the training score\n12 | is good but the validation score is poor.\n13 | \n14 | \"\"\"\n15 | \n16 | # Authors: The scikit-learn developers\n17 | # SPDX-License-Identifier: BSD-3-Clause\n18 | \n19 | import matplotlib.pyplot as plt\n20 | import numpy as np\n21 | \n22 | from sklearn.datasets import load_digits\n23 | from sklearn.model_selection import ValidationCurveDisplay\n24 | from sklearn.svm import SVC\n25 | \n26 | X, y = load_digits(return_X_y=True)\n27 | subset_mask = np.isin(y, [1, 2])  # binary classification: 1 vs 2\n28 | X, y = X[subset_mask], y[subset_mask]\n29 | \n30 | disp = ValidationCurveDisplay.from_estimator(\n31 |     SVC(),\n32 |     X,\n33 |     y,\n34 |     param_name=\"gamma\",\n35 |     param_range=np.logspace(-6, -1, 5),\n36 |     score_type=\"both\",\n37 |     n_jobs=2,\n38 |     score_name=\"Accuracy\",\n39 | )\n40 | disp.ax_.set_title(\"Validation Curve for SVM with an RBF kernel\")\n41 | disp.ax_.set_xlabel(r\"gamma (inverse radius of the RBF kernel)\")\n42 | disp.ax_.set_ylim(0.0, 1.1)\n43 | plt.show()\n44 | \n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =============================================================\n  3 | Receiver Operating Characteristic (ROC) with cross validation\n  4 | =============================================================\n  5 | \n  6 | This example presents how to estimate and visualize the variance of the Receiver\n  7 | Operating Characteristic (ROC) metric using cross-validation.\n  8 | \n  9 | ROC curves typically feature true positive rate (TPR) on the Y axis, and false\n 10 | positive rate (FPR) on the X axis. This means that the top left corner of the\n 11 | plot is the \"ideal\" point - a FPR of zero, and a TPR of one. This is not very\n 12 | realistic, but it does mean that a larger Area Under the Curve (AUC) is usually\n 13 | better. The \"steepness\" of ROC curves is also important, since it is ideal to\n 14 | maximize the TPR while minimizing the FPR.\n 15 | \n 16 | This example shows the ROC response of different datasets, created from K-fold\n 17 | cross-validation. Taking all of these curves, it is possible to calculate the\n 18 | mean AUC, and see the variance of the curve when the\n 19 | training set is split into different subsets. This roughly shows how the\n 20 | classifier output is affected by changes in the training data, and how different\n 21 | the splits generated by K-fold cross-validation are from one another.\n 22 | \n 23 | .. note::\n 24 | \n 25 |     See :ref:`sphx_glr_auto_examples_model_selection_plot_roc.py` for a\n 26 |     complement of the present example explaining the averaging strategies to\n 27 |     generalize the metrics for multiclass classifiers.\n 28 | \"\"\"\n 29 | \n 30 | # Authors: The scikit-learn developers\n 31 | # SPDX-License-Identifier: BSD-3-Clause\n 32 | \n 33 | # %%\n 34 | # Load and prepare data\n 35 | # =====================\n 36 | #\n 37 | # We import the :ref:`iris_dataset` which contains 3 classes, each one\n 38 | # corresponding to a type of iris plant. One class is linearly separable from\n 39 | # the other 2; the latter are **not** linearly separable from each other.\n 40 | #\n 41 | # In the following we binarize the dataset by dropping the \"virginica\" class\n 42 | # (`class_id=2`). This means that the \"versicolor\" class (`class_id=1`) is\n 43 | # regarded as the positive class and \"setosa\" as the negative class\n 44 | # (`class_id=0`).\n 45 | \n 46 | import numpy as np\n 47 | \n 48 | from sklearn.datasets import load_iris\n 49 | \n 50 | iris = load_iris()\n 51 | target_names = iris.target_names\n 52 | X, y = iris.data, iris.target\n 53 | X, y = X[y != 2], y[y != 2]\n 54 | n_samples, n_features = X.shape\n 55 | \n 56 | # %%\n 57 | # We also add noisy features to make the problem harder.\n 58 | random_state = np.random.RandomState(0)\n 59 | X = np.concatenate([X, random_state.randn(n_samples, 200 * n_features)], axis=1)\n 60 | \n 61 | # %%\n 62 | # Classification and ROC analysis\n 63 | # -------------------------------\n 64 | #\n 65 | # Here we run a :class:`~sklearn.svm.SVC` classifier with cross-validation and\n 66 | # plot the ROC curves fold-wise. Notice that the baseline to define the chance\n 67 | # level (dashed ROC curve) is a classifier that would always predict the most\n 68 | # frequent class.\n 69 | \n 70 | import matplotlib.pyplot as plt\n 71 | \n 72 | from sklearn import svm\n 73 | from sklearn.metrics import RocCurveDisplay, auc\n 74 | from sklearn.model_selection import StratifiedKFold\n 75 | \n 76 | n_splits = 6\n```\n\nFound `sklearn/utils/_param_validation.py:InvalidParameterError`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | im