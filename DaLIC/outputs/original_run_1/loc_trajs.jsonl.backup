nce with Multicollinear or Correlated Features\n  4 | =================================================================\n  5 | \n  6 | In this example, we compute the\n  7 | :func:`~sklearn.inspection.permutation_importance` of the features to a trained\n  8 | :class:`~sklearn.ensemble.RandomForestClassifier` using the\n  9 | :ref:`breast_cancer_dataset`. The model can easily get about 97% accuracy on a\n 10 | test dataset. Because this dataset contains multicollinear features, the\n 11 | permutation importance shows that none of the features are important, in\n 12 | contradiction with the high test accuracy.\n 13 | \n 14 | We demo a possible approach to handling multicollinearity, which consists of\n 15 | hierarchical clustering on the features' Spearman rank-order correlations,\n 16 | picking a threshold, and keeping a single feature from each cluster.\n 17 | \n 18 | .. note::\n 19 |     See also\n 20 |     :ref:`sphx_glr_auto_examples_inspection_plot_permutation_importance.py`\n 21 | \n 22 | \"\"\"\n 23 | \n 24 | # Authors: The scikit-learn developers\n 25 | # SPDX-License-Identifier: BSD-3-Clause\n 26 | \n 27 | # %%\n 28 | # Random Forest Feature Importance on Breast Cancer Data\n 29 | # ------------------------------------------------------\n 30 | #\n 31 | # First, we define a function to ease the plotting:\n 32 | import matplotlib\n 33 | \n 34 | from sklearn.inspection import permutation_importance\n 35 | from sklearn.utils.fixes import parse_version\n```\n\nFound code snippet in file `examples/decomposition/plot_faces_decomposition.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 25 | import logging\n 26 | \n 27 | import matplotlib.pyplot as plt\n 28 | from numpy.random import RandomState\n 29 | \n 30 | from sklearn import cluster, decomposition\n 31 | from sklearn.datasets import fetch_olivetti_faces\n 32 | \n 33 | rng = RandomState(0)\n 34 | \n 35 | # Display progress logs on stdout\n 36 | logging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(message)s\")\n 37 | \n 38 | faces, _ = fetch_olivetti_faces(return_X_y=True, shuffle=True, random_state=rng)\n 39 | n_samples, n_features = faces.shape\n 40 | \n 41 | # Global centering (focus on one feature, centering all samples)\n 42 | faces_centered = faces - faces.mean(axis=0)\n 43 | \n 44 | # Local centering (focus on one sample, centering all features)\n 45 | faces_centered -= faces_centered.mean(axis=1).reshape(n_samples, -1)\n 46 | \n 47 | print(\"Dataset consists of %d faces\" % n_samples)\n 48 | \n 49 | # %%\n 50 | # Define a base function to plot the gallery of faces.\n 51 | \n 52 | n_row, n_col = 2, 3\n 53 | n_components = n_row * n_col\n 54 | image_shape = (64, 64)\n```\n\nFound `sklearn/utils/_indexing.py:_array_indexing`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | import numbers\n  5 | import sys\n  6 | import warnings\n  7 | from collections import UserList\n  8 | from itertools import compress, islice\n  9 | \n 10 | import numpy as np\n 11 | from scipy.sparse import issparse\n 12 | \n 13 | from ._array_api import _is_numpy_namespace, get_namespace\n 14 | from ._param_validation import Interval, validate_params\n 15 | from .extmath import _approximate_mode\n 16 | from .validation import (\n 17 |     _is_arraylike_not_scalar,\n 18 |     _is_pandas_df,\n 19 |     _is_polars_df_or_series,\n 20 |     _use_interchange_protocol,\n 21 |     check_array,\n 22 |     check_consistent_length,\n 23 |     check_random_state,\n 24 | )\n 25 | \n 26 | \n 27 | def _array_indexing(array, key, key_dtype, axis):\n 28 |     \"\"\"Index an array or scipy.sparse consistently across NumPy version.\"\"\"\n 29 |     xp, is_array_api = get_namespace(array)\n 30 |     if is_array_api:\n 31 |         return xp.take(array, key, axis=axis)\n 32 |     if issparse(array) and key_dtype == \"bool\":\n 33 |         key = np.asarray(key)\n 34 |     if isinstance(key, tuple):\n 35 |         key = list(key)\n 36 |     return array[key, ...] if axis == 0 else array[:, key]\n```\n\nFound function `sklearn/feature_extraction/text.py:_VectorizerMixin._check_stop_words_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n374 | def _check_stop_words_consistency(self, stop_words, preprocess, tokenize):\n375 |         \"\"\"Check if stop words are consistent\n376 | \n377 |         Returns\n378 |         -------\n379 |         is_consistent : True if stop words are consistent with the preprocessor\n380 |                         and tokenizer, False if they are not, None if the check\n381 |                         was previously performed, \"error\" if it could not be\n382 |                         performed (e.g. because of the use of a custom\n383 |                         preprocessor / tokenizer)\n384 |         \"\"\"\n385 |         if id(self.stop_words) == getattr(self, \"_stop_words_id\", None):\n386 |             # Stop words are were previously validated\n387 |             return None\n388 | \n389 |         # NB: stop_words is validated, unlike self.stop_words\n390 |         try:\n391 |             inconsistent = set()\n392 |             for w in stop_words or ():\n393 |                 tokens = list(tokenize(preprocess(w)))\n394 |                 for token in tokens:\n395 |                     if token not in stop_words:\n396 |                         inconsistent.add(token)\n397 |             self._stop_words_id = id(self.stop_words)\n398 | \n399 |             if inconsistent:\n400 |                 warnings.warn(\n401 |                     \"Your stop_words may be inconsistent with \"\n402 |                     \"your preprocessing. Tokenizing the stop \"\n403 |                     \"words generated tokens %r not in \"\n404 |                     \"stop_words.\" % sorted(inconsistent)\n405 |                 )\n406 |             return not inconsistent\n407 |         except Exception:\n408 |             # Failed to check stop words consistency (e.g. because a custo