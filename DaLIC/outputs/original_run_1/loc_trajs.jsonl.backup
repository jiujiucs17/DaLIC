 between A and B with *armA* and *armB*. One of the\n3086 |         arms is extended so that they are connected in a right angle. The\n3087 |         length of *armA* is determined by (*armA* + *fraction* x AB distance).\n3088 |         Same for *armB*.\n3089 |         \"\"\"\n3090 | \n3091 |         def __init__(self, armA=0., armB=0., fraction=0.3, angle=None):\n3092 |             \"\"\"\n3093 |             Parameters\n3094 |             ----------\n3095 |             armA : float\n3096 |                 Minimum length of armA.\n3097 | \n3098 |             armB : float\n3099 |                 Minimum length of armB.\n3100 | \n3101 |             fraction : float\n3102 |                 A fraction of the distance between two points that will be\n3103 |                 added to armA and armB.\n3104 | \n3105 |             angle : float or None\n3106 |                 Angle of the connecting line (if None, parallel to A and B).\n3107 |             \"\"\"\n3108 |             self.armA = armA\n3109 |             self.armB = armB\n3110 |             self.fraction = fraction\n3111 |             self.angle = angle\n3112 | \n3113 |         def connect(self, posA, posB):\n3114 |             x1, y1 = posA\n3115 |             x20, y20 = x2, y2 = posB\n3116 | \n3117 |             theta1 = math.atan2(y2 - y1, x2 - x1)\n3118 |             dx, dy = x2 - x1, y2 - y1\n3119 |             dd = (dx * dx + dy * dy) ** .5\n3120 |             ddx, ddy = dx / dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\nFound file `galleries/plot_types/basic/bar.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/plot_types/basic/bar.py` for the full content if needed.\n\n\n\n##Searching for term \"bar()\", \"bar() bar function\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2989 | def bar(self, left, height, zs=0, zdir='z', *args,\n2990 |             axlim_clip=False, **kwargs):\n2991 |         \"\"\"\n2992 |         Add 2D bar(s).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         left : 1D array-like\n2997 |             The x coordinates of the left sides of the bars.\n2998 |         height : 1D array-like\n2999 |             The height of the bars.\n3000 |         zs : float or 1D array-like, default: 0\n3001 |             Z coordinate of bars; if a single value is specified, it will be\n3002 |             used for all bars.\n3003 |         zdir : {'x', 'y', 'z'}, default: 'z'\n3004 |             When plotting 2D data, the direction to use as z ('x', 'y' or 'z').\n3005 |         axlim_clip : bool, default: False\n3006 |             Whether to hide bars with points outside the axes view limits.\n3007 | \n3008 |             .. versionadded:: 3.10\n3009 |         data : indexable object, optional\n3010 |             DATA_PARAMETER_PLACEHOLDER\n3011 |         **kwargs\n3012 |             Other keyword arguments are forwarded to\n3013 |             `matplotlib.axes.Axes.bar`.\n3014 | \n3015 |         Returns\n3016 |         -------\n3017 |         mpl_toolkits.mplot3d.art3d.Patch3DCollection\n3018 |         \"\"\"\n3019 |         had_data = self.has_data()\n3020 | \n3021 |         patches = super().bar(left, height, *args, **kwargs)\n3022 | \n3023 |         zs = np.broadcast_to(zs, len(left), subok=True)\n3024 | \n3025 |         verts = []\n3026 |         verts_zs = []\n3027 |         for p, z in zip(patches, zs):\n3028 |             vs = art3d._get_patch_verts(p)\n3029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |             # NOTE: Bugs could still occur if len(verts) > 0,\n3038 |             #       but the \"2nd dimension\" is empty.\n3039 |             xs, ys = zip(*verts)\n3040 |         else:\n3041 |             xs, ys = [], []\n3042 | \n3043 |         xs, ys, verts_zs = art3d.juggle_axes(xs, ys, verts_zs, zdir)\n3044 |         self.auto_scale_xyz(xs, ys, verts_zs, had_data)\n3045 | \n3046 |         return patches\n```\n\n\n\n##Searching for term \"bar()\"...\n### Search Result:\nFound function `lib/matplotlib/axes/_axes.py:Axes.bar`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2326 | def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n2327 |             **kwargs):\n2328 |         r\"\"\"\n2329 |         Make a bar plot.\n2330 | \n2331 |         The bars are positioned at *x* with the given *align*\\ment. Their\n2332 |         dimensions are given by *height* and *width*. The vertical baseline\n2333 |         is *bottom* (default 0).\n2334 | \n2335 |         Many parameters can take either a single value applying to all bars\n2336 |         or a sequence of values, one for each bar.\n2337 | \n2338 |         Parameters\n2339 |         ----------\n2340 |         x : float or array-like\n2341 |             The x coordinates of the bars. See also *align* for the\n2342 |             alignment of the bars to the coordinates.\n2343 | \n2344 |         height : float or array-like\n2345 |             The height(s) of the bars.\n2346 | \n2347 |             Note that if *bottom* has units (e.g. datetime), *height* should be in\n2348 |             units that are a difference from the value of *bottom* (e.g. timedelta).\n2349 | \n2350 |         width : float or array-like, default: 0.8\n2351 |             The width(s) of the bars.\n2352 | \n2353 |             Note that if *x* has units (e.g. datetime), then *width* should be in\n2354 |             units that are a difference (e.g. timedelta) around the *x* values.\n2355 | \n2356 |         bottom : float or array-like, default: 0\n2357 |             The y coordinate(s) of the bottom side(s) of the bars.\n2358 | \n2359 |             Note that if *bottom* has units, then the y-axis will get a Locator and\n2360 |             Formatter appropriate for the units (e.g. dates, or categorical).\n2361 | \n2362 |         align : {'center', 'edge'}, default: 'center'\n2363 |             Alignment of the bars to the *x* coordinates:\n2364 | \n2365 |             - 'center': Center the base on the *x* positions.\n2366 |             - 'edge': Align the left edges of the bars with the *x* positions.\n2367 | \n2368 |             To align the bars on the right edge pass a negative *width* and\n2369 |             ``align='edge'``.\n2370 | \n2371 |         Returns\n2372 |         -------\n2373 |         `.BarContainer`\n2374 |             Container with all the bars and optionally errorbars.\n2375 | \n2376 |         Other Parameters\n2377 |         ----------------\n2378 |         color : :mpltype:`color` or list of :mpltype:`color`, optional\n2379 |             The colors of the bar faces.\n2380 | \n2381 |         edgecolor : :mpltype:`color` or list of :mpltype:`color`, optional\n2382 |             The colors of the bar edges.\n2383 | \n2384 |         linewidth : float or array-like, optional\n2385 |             Width of the bar edge(s). If 0, don't draw edges.\n2386 | \n2387 |         tick_label : str or list of str, optional\n2388 |             The tick labels of the bars.\n2389 |             Default: None (Use default numeric labels.)\n2390 | \n2391 |         label : str or list of str, optional\n2392 |             A single label is attached to the resulting `.BarContainer` as a\n2393 |             label for the whole dataset.\n2394 |             If a list is provided, it must be the same length as *x* and\n2395 |             labels the individual bars. Repeated labels are not de-duplicated\n2396 |             and will cause repeated label entries, so this is best used when\n2397 |             bars also differ in style (e.g., by passing a list to *color*.)\n2398 | \n2399 |         xerr, yerr : float or array-like of shape(N,) or shape(2, N), optional\n2400 |             If not *None*, add horizontal / vertical errorbars to the bar tips.\n2401 |             The values are +/- sizes relative to the data:\n2402 | \n2403 |             - scalar: symmetric +/- values for all bars\n2404 |             - shape(N,): symmetric +/- values for each bar\n2405 |             - shape(2, N): Separate - and + values for each bar. First row\n2406 |               contains the lower errors, the second row contains the upper\n2407 |               errors.\n2408 |             - *None*: No errorbar. (Default)\n2409 | \n2410 |             See :doc:`/gallery/statistics/errorbar_features` for a