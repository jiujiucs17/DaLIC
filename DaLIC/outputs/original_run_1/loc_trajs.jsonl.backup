    return parr + self\n1173 | \n1174 |     def _add_offset(self, offset):\n1175 |         raise AbstractMethodError(self)\n1176 | \n1177 |     def _add_timedeltalike_scalar(self, other):\n1178 |         \"\"\"\n1179 |         Add a delta of a timedeltalike\n1180 | \n1181 |         Returns\n1182 |         -------\n1183 |         Same type as self\n1184 |         \"\"\"\n1185 |         if isna(other):\n1186 |             # i.e np.timedelta64(\"NaT\")\n1187 |             new_values = np.empty(self.shape, dtype=\"i8\").view(self._ndarray.dtype)\n1188 |             new_values.fill(iNaT)\n1189 |             return type(self)._simple_new(new_values, dtype=self.dtype)\n1190 | \n1191 |         # PeriodArray overrides, so we only get here with DTA/TDA\n1192 |         self = cast(\"DatetimeArray | TimedeltaArray\", self)\n1193 |         other = Timedelta(other)\n1194 |         self, other = self._ensure_matching_resos(other)\n1195 |         return self._add_timedeltalike(other)\n1196 | \n1197 |     def _add_timedelta_arraylike(self, other: TimedeltaArray) -> Self:\n1198 |         \"\"\"\n1199 |         Add a delta of a TimedeltaIndex\n1200 | \n1201 |         Returns\n1202 |         -------\n1203 |         Same type as self\n1204 |         \"\"\"\n1205 |         # overridden by PeriodArray\n1206 | \n1207 |         if len(self) != len(other):\n1208 |             raise ValueError(\"cannot add indices of unequal length\")\n1209 | \n1210 |         self, other = cast(\n1211 |             \"DatetimeArray | TimedeltaArray\", self\n1212 |         )._ensure_matching_resos(other)\n1213 |         return self._add_timedeltalike(other)\n1214 | \n1215 |     @final\n1216 |     def _add_timedeltalike(self, other: Timedelta | TimedeltaArray) -> Self:\n1217 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1218 |         new_values = add_overflowsafe(self.asi8, np.asarray(other_i8, dtype=\"i8\"))\n1219 |         res_values = new_values.view(self._ndarray.dtype)\n1220 | \n1221 |         new_freq = self._get_arithmetic_result_freq(other)\n1222 | \n1223 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of \"NDArrayBacked\"\n1224 |         return type(self)._simple_new(\n1225 |             res_values,\n1226 |             dtype=self.dtype,\n1227 |             freq=new_freq,  # type: ignore[call-arg]\n1228 |         )\n1229 | \n1230 |     @final\n1231 |     def _add_nat(self) -> Self:\n1232 |         \"\"\"\n1233 |         Add pd.NaT to self\n1234 |         \"\"\"\n1235 |         if isinstance(self.dtype, PeriodDtype):\n1236 |             raise TypeError(\n1237 |                 f\"Cannot add {type(self).__name__} and {type(NaT).__name__}\"\n1238 |             )\n1239 | \n1240 |         # GH#19124 pd.NaT is treated like a timedelta for both timedelta\n1241 |         # and datetime dtypes\n1242 |         result = np.empty(self.shape, dtype=np.int64)\n1243 |         result.fill(iNaT)\n1244 |         result = result.view(self._ndarray.dtype)  # preserve reso\n1245 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of \"NDArrayBacked\"\n1246 |         return type(self)._simple_new(\n1247 |             result,\n1248 |             dtype=self.dtype,\n1249 |             freq=None,  # type: ignore[call-arg]\n1250 |         )\n1251 | \n1252 |     @final\n1253 |     def _sub_nat(self) -> np.ndarray:\n1254 |         \"\"\"\n1255 |         Subtract pd.NaT from self\n1256 |         \"\"\"\n1257 |         # GH#19124 Timedelta - datetime is not in general well-defined.\n1258 |         # We make an exception for pd.NaT, which in this case quacks\n1259 |         # like a timedelta.\n1260 |         # For datetime64 dtypes by convention we treat NaT as a datetime, so\n1261 |         # this subtraction returns a timedelta64 dtype.\n1262 |         # For period dtype, timedelta64 is a close-enough return dtype.\n1263 |         result = np.empty(self.shape, dtype=np.int64)\n1264 |         result.fill(iNaT)\n1265 |         if self.dtype.kind in \"mM\":\n1266 |             # We can retain unit in dtype\n1267 |             self = cast(\"DatetimeArray| TimedeltaArray\", self)\n1268 |             return result.view(f\"timedelta64[{self.unit}]\")\n1269 |         else:\n1270 |             return result.view(\"timedelta64[ns]\")\n1271 | \n1272 |     @final\n1273 |     def _sub_periodlike(self, other: Period | PeriodArray) -> npt.NDArray[np.object_]:\n1274 |         # If the operation is well-defined, we return an object-dtype ndarray\n1275 |         # of DateOffsets.  Null entries are filled with pd.NaT\n1276 |         if not isinstance(self.dtype, PeriodDtype):\n1277 |             raise TypeError(\n1278 |                 f\"cannot subtract {type(other).__name__} from {type(self).__name__}\"\n1279 |             )\n1280 | \n1281 |         self = cast(\"PeriodArray\", self)\n1282 |         self._check_compatible_with(other)\n1283 | \n1284 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1285 |         new_i8_data = add_overflowsafe(self.asi8, np.asarray(-other_i8, dtype=\"i8\"))\n1286 |         new_data = np.array([self.freq.base * x for x in new_i8_data])\n1287 | \n1288 |         if o_mask is None:\n1289 |             # i.e. Period scalar\n1290 |             mask = self._isnan\n1291 |         else:\n1292 |             # i.e. PeriodArray\n1293 |             mask = self._isnan | o_mask\n1294 |         new_data[mask] = NaT\n1295 |         return new_data\n1296 | \n1297 |     @final\n1298 |     def _addsub_object_array(self, other: npt.NDArray[np.object_], op) -> np.ndarray:\n1299 |         \"\"\"\n1300 |         Add or subtract array-like of DateOffset objects\n1301 | \n1302 |         Parameters\n1303 |         ----------\n1304 |         other : np.ndarray[object]\n1305 |         op : {operator.add, operator.sub}\n1306 | \n1307 |         Returns\n1308 |         -------\n1309 |         np.ndarray[object]\n1310 |             Except in fastpath case with length 1 where we operate on the\n1311 |             contained scalar.\n1312 |         \"\"\"\n1313 |         assert op in [operator.add, operator.sub]\n1314 |         if len(other) == 1 and self.ndim == 1:\n1315 |             # Note: without this special case, we could annotate return type\n1316 |             #  as ndarray[object]\n1317 |             # If both 1D then broadcasting is unambiguous\n1318 |             return op(self, other[0])\n1319 | \n1320 |         if get_option(\"performance_warnings\"):\n1321 |             warnings.warn(\n1322 |                 \"Adding/subtracting object-dtype array to \"\n1323 |                 f\"{type(self).__name__} not vectorized.\",\n1324 |                 PerformanceWarning,\n1325 |                 stacklevel=find_stack_level(),\n1326 |             )\n1327 | \n1328 |         # Caller is responsible for broadcasting if necessary\n1329 |         assert self.shape == other.shape, (self.shape, other.shape)\n1330 | \n1331 |         res_values = op(self.astype(\"O\"), np.asarray(other))\n1332 |         return res_values\n1333 | \n1334 |     def _accumulate(self, name: str, *, skipna: bool = True, **kwargs) -> Self:\n1335 |         if name not in {\"cummin\", \"cummax\"}:\n1336 |             raise TypeError(f\"Accumulation {name} not supported for {type(self)}\")\n1337 | \n1338 |         op = getattr(datetimelike_accumulations, name)\n1339 |         result = op(self.copy(), skipna=skipna, **kwargs)\n1340 | \n1341 |         return type(self)._simple_new(result, dtype=self.dtype)\n1342 | \n1343 |     @unpack_zerodim_and_defer(\"__add__\")\n1344 |     def __add__(self, other):\n1345 |         other_dtype = getattr(other, \"dtype\", None)\n1346 |         other = ensure_wrapped_if_datetimelike(other)\n1347 | \n1348 |         # scalar others\n1349 |         if other is NaT:\n1350 |             result: np.ndarray | DatetimeLikeArrayMixin = self._add_nat()\n1351 |         elif isinstance(other, (Tick, timedelta, np.timedelta64)):\n1352 |             result = self._add_timedeltalike_scalar(other)\n1353 |         elif isinstance(other, BaseOffset):\n1354 |             # specifically _not_ a Tick\n1355 |             result = self._add_offset(other)\n1356 |         elif isinstance(other, (datetime, np.datetime64)):\n1357 |             result = self._add_datetimelike_scalar(other)\n1358 |         elif isinstance(other, Period) and lib.is_np_dtype(self.dtype, \"m\"):\n1359 |             result = self._add_period(other)\n1360 |         elif lib.is_integer(other):\n1361 |             # This check must come after the check for np.timedelta64\n1362 |             # as is_integer returns True for these\n1363 |             if not isinstance(self.dtype, PeriodDtype):\n1364 |                 raise integer_op_not_supported(self)\n1365 |             obj = cast(\"PeriodArray\", self)\n1366 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.add)\n1367 | \n1368 |         # array-like others\n1369 |         elif lib.is_np_dtype(other_dtype, \"m\"):\n1370 |             # TimedeltaIndex, ndarray[timedelta64]\n1371 |             result = self._add_timedelta_arraylike(other)\n1372 |         elif is_object_dtype(other_dtype):\n1373 |             # e.g. Array/Index of DateOffset objects\n1374 |             result = self._addsub_object_array(other, operator.add)\n1375 |         elif lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1376 |             other_dtype, DatetimeTZDtype\n1377 |         ):\n1378 |             # DatetimeIndex, ndarray[datetime64]\n1379 |             return self._add_datetime_arraylike(other)\n1380 |         elif is_integer_dtype(other_dtype):\n1381 |             if not isinstance(self.dtype, PeriodDtype):\n1382 |                 raise integer_op_not_supported(self)\n1383 |             obj = cast(\"PeriodArray\", self)\n1384 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.add)\n1385 |         else:\n1386 |             # Includes Categorical, other ExtensionArrays\n1387 |             # For PeriodDtype, if self is a TimedeltaArray and other is a\n1388 |             #  PeriodArray with  a timedelta-like (i.e. Tick) freq, this\n1389 |             #  operation is valid.  Defer to the PeriodArray implementation.\n1390 |             #  In remaining cases, this will end up raising TypeError.\n1391 |             return NotImplemented\n1392 | \n1393 |         if isinstance(result, np.ndarray) and lib.is_np_dtype(result.dtype, \"m\"):\n1394 |             from pandas.core.arrays import TimedeltaArray\n1395 | \n1396 |             return TimedeltaArray._from_sequence(result, dtype=result.dtype)\n1397 |         return result\n1398 | \n1399 |     def __radd__(self, other):\n1400 |         # alias for __add__\n1401 |         return self.__add__(other)\n1402 | \n1403 |     @unpack_zerodim_and_defer(\"__sub__\")\n1404 |     def __sub__(self, other):\n1405 |         other_dtype = getattr(other, \"dtype\", None)\n1406 |         other = ensure_wrapped_if_datetimelike(other)\n1407 | \n1408 |         # scalar others\n1409 |         if other is NaT:\n1410 |             result: np.ndarray | DatetimeLikeArrayMixin = self._sub_nat()\n1411 |         elif isinstance(other, (Tick, timedelta, np.timedelta64)):\n1412 |             result = self._add_timedeltalike_scalar(-other)\n1413 |         elif isinstance(other, BaseOffset):\n1414 |             # specifically _not_ a Tick\n1415 |             result = self._add_offset(-other)\n1416 |         elif isinstance(other, (datetime, np.datetime64)):\n1417 |             result = self._sub_datetimelike_scalar(other)\n1418 |         elif lib.is_integer(other):\n1419 |             # This check must come after the check for np.timedelta64\n1420 |             # as is_integer returns True for these\n1421 |             if not isinstance(self.dtype, PeriodDtype):\n1422 |                 raise integer_op_not_supported(self)\n1423 |             obj = cast(\"PeriodArray\", self)\n1424 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.sub)\n1425 | \n1426 |         elif isinstance(other, Period):\n1427 |             result = self._sub_periodlike(other)\n1428 | \n1429 |         # array-like others\n1430 |         elif lib.is_np_dtype(other_dtype, \"m\"):\n1431 |             # TimedeltaIndex, ndarray[timedelta64]\n1432 |             result = self._add_timedelta_arraylike(-other)\n1433 |         elif is_object_dtype(other_dtype):\n1434 |             # e.g. Array/Index of DateOffset objects\n1435 |             result = self._addsub_object_array(other, operator.sub)\n1436 |         elif lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1437 |             other_dtype, DatetimeTZDtype\n1438 |         ):\n1439 |             # DatetimeIndex, ndarray[datetime64]\n1440 |             result = self._sub_datetime_arraylike(other)\n1441 |         elif isinstance(other_dtype, PeriodDtype):\n1442 |             # PeriodIndex\n1443 |             result = self._sub_periodlike(other)\n1444 |         elif is_integer_dtype(other_dtype):\n1445 |             if not isinstance(self.dtype, PeriodDtype):\n1446 |                 raise integer_op_not_supported(self)\n1447 |             obj = cast(\"PeriodArray\", self)\n1448 |             result = obj._addsub_int_array_or_scalar(other * obj.dtype._n, operator.sub)\n1449 |         else:\n1450 |             # Includes ExtensionArrays, float_dtype\n1451 |             return NotImplemented\n1452 | \n1453 |         if isinstance(result, np.ndarray) and lib.is_np_dtype(result.dtype, \"m\"):\n1454 |             from pandas.core.arrays import TimedeltaArray\n1455 | \n1456 |             return TimedeltaArray._from_sequence(result, dtype=result.dtype)\n1457 |         return result\n1458 | \n1459 |     def __rsub__(self, other):\n1460 |         other_dtype = getattr(other, \"dtype\", None)\n1461 |         other_is_dt64 = lib.is_np_dtype(other_dtype, \"M\") or isinstance(\n1462 |             other_dtype, DatetimeTZDtype\n1463 |         )\n1464 | \n1465 |         if other_is_dt64 and lib.is_np_dtype(self.dtype, \"m\"):\n1466 |             # ndarray[datetime64] cannot be subtracted from self, so\n1467 |             # we need to wrap in DatetimeArray/Index and flip the operation\n1468 |             if lib.is_scalar(other):\n1469 |                 # i.e. np.datetime64 object\n1470 |                 return Timestamp(other) - self\n1471 |             if not isinstance(other, DatetimeLikeArrayMixin):\n1472 |                 # Avoid down-casting DatetimeIndex\n1473 |                 from pandas.core.arrays import DatetimeArray\n1474 | \n1475 |                 other = DatetimeArray._from_sequence(other, dtype=other.dtype)\n1476 |             return other - self\n1477 |         elif self.dtype.kind == \"M\" and hasattr(other, \"dtype\") and not other_is_dt64:\n1478 |             # GH#19959 datetime - datetime is well-defined as timedelta,\n1479 |             # but any other type - datetime is not well-defined.\n1480 |             raise TypeError(\n1481 |                 f\"cannot subtract {type(self).__name__} from {type(other).__name__}\"\n1482 |             )\n1483 |         elif isinstance(self.dtype, PeriodDtype) and lib.is_np_dtype(other_dtype, \"m\"):\n1484 |             # TODO: Can we simplify/generalize these cases at all?\n1485 |             raise TypeError(f\"cannot subtract {type(self).__name__} from {other.dtype}\")\n1486 |         elif lib.is_np_dtype(self.dtype, \"m\"):\n1487 |             self = cast(\"TimedeltaArray\", self)\n1488 |             return (-self) + other\n1489 | \n1490 |         # We get here with e.g. datetime objects\n1491 |         return -(self - other)\n1492 | \n1493 |     def __iadd__(self, other) -> Self:\n1494 |         result = self + other\n1495 |         self[:] = result[:]\n1496 | \n1497 |         if not isinstance(self.dtype, PeriodDtype):\n1498 |             # restore freq, which is invalidated by setitem\n1499 |             self._freq = result.freq\n1500 |         return self\n1501 | \n1502 |     def __isub__(self, other) -> Self:\n1503 |         result = self - other\n1504 |         self[:] = result[:]\n1505 | \n1506 |         if not isinstance(self.dtype, PeriodDtype):\n1507 |             # restore freq, which is invalidated by setitem\n1508 |             self._freq = result.freq\n1509 |         return self\n1510 | \n1511 |     # --------------------------------------------------------------\n1512 |     # Reductions\n1513 | \n1514 |     @_period_dispatch\n1515 |     def _quantile(\n1516 |         self,\n1517 |         qs: npt.NDArray[np.float64],\n1518 |         interpolation: str,\n1519 |     ) -> Self:\n1520 |         return super()._quantile(qs=qs, interpolation=interpolation)\n1521 | \n1522 |     @_period_dispatch\n1523 |     def min(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1524 |         \"\"\"\n1525 |         Return the minimum value of the Array or minimum along\n1526 |         an axis.\n1527 | \n1528 |         See Also\n1529 |         --------\n1530 |         numpy.ndarray.min\n1531 |         Index.min : Return the minimum value in an Index.\n1532 |         Series.min : Return the minimum value in a Series.\n1533 |         \"\"\"\n1534 |         nv.validate_min((), kwargs)\n1535 |         nv.validate_minmax_axis(axis, self.ndim)\n1536 | \n1537 |         result = nanops.nanmin(self._ndarray, axis=axis, skipna=skipna)\n1538 |         return self._wrap_reduction_result(axis, result)\n1539 | \n1540 |     @_period_dispatch\n1541 |     def max(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1542 |         \"\"\"\n1543 |         Return the maximum value of the Array or maximum along\n1544 |         an axis.\n1545 | \n1546 |         See Also\n1547 |         --------\n1548 |         numpy.ndarray.max\n1549 |         Index.max : Return the maximum value in an Index.\n1550 |         Series.max : Return the maximum value in a Series.\n1551 |         \"\"\"\n1552 |         nv.validate_max((), kwargs)\n1553 |         nv.validate_minmax_axis(axis, self.ndim)\n1554 | \n1555 |         result = nanops.nanmax(self._ndarray, axis=axis, skipna=skipna)\n1556 |         return self._wrap_reduction_result(axis, result)\n1557 | \n1558 |     def mean(self, *, skipna: bool = True, axis: AxisInt | None = 0):\n1559 |         \"\"\"\n1560 |         Return the mean value of the Array.\n1561 | \n1562 |         Parameters\n1563 |         ----------\n1564 |         skipna : bool, default True\n1565 |             Whether to ignore any NaT elements.\n1566 |         axis : int, optional, default 0\n1567 |             Axis for the function to be applied on.\n1568 | \n1569 |         Returns\n1570 |         -------\n1571 |         scalar\n1572 |             Timestamp or Timedelta.\n1573 | \n1574 |         See Also\n1575 |         --------\n1576 |         numpy.ndarray.mean : Returns the average of array elements along a given axis.\n1577 |         Series.mean : Return the mean value in a Series.\n1578 | \n1579 |         Notes\n1580 |         -----\n1581 |         mean is only defined for Datetime and Timedelta dtypes, not for Period.\n1582 | \n1583 |         Examples\n1584 |         --------\n1585 |         For :class:`pandas.DatetimeIndex`:\n1586 | \n1587 |         >>> idx = pd.date_range(\"2001-01-01 00:00\", periods=3)\n1588 |         >>> idx\n1589 |         DatetimeIndex(['2001-01-01', '2001-01-02', '2001-01-03'],\n1590 |                       dtype='datetime64[ns]', freq='D')\n1591 |         >>> idx.mean()\n1592 |         Timestamp('2001-01-02 00:00:00')\n1593 | \n1594 |         For :class:`pandas.TimedeltaIndex`:\n1595 | \n1596 |         >>> tdelta_idx = pd.to_timedelta([1, 2, 3], unit=\"D\")\n1597 |         >>> tdelta_idx\n1598 |         TimedeltaIndex(['1 days', '2 days', '3 days'],\n1599 |                         dtype='timedelta64[ns]', freq=None)\n1600 |         >>> tdelta_idx.mean()\n1601 |         Timedelta('2 days 00:00:00')\n1602 |         \"\"\"\n1603 |         if isinstance(self.dtype, PeriodDtype):\n1604 |             # See discussion in GH#24757\n1605 |             raise TypeError(\n1606 |                 f\"mean is not implemented for {type(self).__name__} since the \"\n1607 |                 \"meaning is ambiguous.  An alternative is \"\n1608 |                 \"obj.to_timestamp(how='start').mean()\"\n1609 |             )\n1610 | \n1611 |         result = nanops.nanmean(\n1612 |             self._ndarray, axis=axis, skipna=skipna, mask=self.isna()\n1613 |         )\n1614 |         return self._wrap_reduction_result(axis, result)\n1615 | \n1616 |     @_period_dispatch\n1617 |     def median(self, *, axis: AxisInt | None = None, skipna: bool = True, **kwargs):\n1618 |         nv.validate_median((), kwargs)\n1619 | \n1620 |         if axis is not None and abs(axis) >= self.ndim:\n1621 |             raise ValueError(\"abs(axis) must be less than ndim\")\n1622 | \n1623 |         result = nanops.nanmedian(self._ndarray, axis=axis, skipna=skipna)\n1624 |         return self._wrap_reduction_result(axis, result)\n1625 | \n1626 |     def _mode(self, dropna: bool = True):\n1627 |         mask = None\n1628 |         if dropna:\n1629 |             mask = self.isna()\n1630 | \n1631 |         i8modes = algorithms.mode(self.view(\"i8\"), mask=mask)\n1632 |         npmodes = i8modes.view(self._ndarray.dtype)\n1633 |         npmodes = cast(np.ndarray, npmodes)\n1634 |         return self._from_backing_data(npmodes)\n1635 | \n1636 |     # ------------------------------------------------------------------\n1637 |     # GroupBy Methods\n1638 | \n1639 |     def _groupby_op(\n1640 |         self,\n1641 |         *,\n1642 |         how: str,\n1643 |         has_dropped_na: bool,\n1644 |         min_count: int,\n1645 |         ngroups: int,\n1646 |         ids: npt.NDArray[np.intp],\n1647 |         **kwargs,\n1648 |     ):\n1649 |         dtype = self.dtype\n1650 |         if dtype.kind == \"M\":\n1651 |             # Adding/multiplying datetimes is not valid\n1652 |             if how in [\"sum\", \"prod\", \"cumsum\", \"cumprod\", \"var\", \"skew\"]:\n1653 |                 raise TypeError(f\"datetime64 type does not support operation '{how}'\")\n1654 |             if how in [\"any\", \"all\"]:\n1655 |                 # GH#34479\n1656 |                 raise TypeError(\n1657 |                     f\"'{how}' with datetime64 dtypes is no longer supported. \"\n1658 |                     f\"Use (obj != pd.Timestamp(0)).{how}() instead.\"\n1659 |                 )\n1660 | \n1661 |         elif isinstance(dtype, PeriodDtype):\n1662 |             # Adding/multiplying Periods is not valid\n1663 |             if how in [\"sum\", \"prod\", \"cumsum\", \"cumprod\", \"var\", \"skew\"]:\n1664 |                 raise TypeError(f\"Period type does not support {how} operations\")\n1665 |             if how in [\"any\", \"all\"]:\n1666 |                 # GH#34479\n1667 |                 raise TypeError(\n1668 |                     f\"'{how}' with PeriodDtype is no longer supported. \"\n1669 |                     f\"Use (obj != pd.Period(0, freq)).{how}() instead.\"\n1670 |                 )\n1671 |         else:\n1672 |             # timedeltas we can add but not multiply\n1673 |             if how in [\"prod\", \"cumprod\", \"skew\", \"var\"]:\n1674 |                 raise TypeError(f\"timedelta64 type does not support {how} operations\")\n1675 | \n1676 |         # All of the functions implemented here are ordinal, so we can\n1677 |         #  operate on the tz-naive equivalents\n1678 |         npvalues = self._ndarray.view(\"M8[ns]\")\n1679 | \n1680 |         from pandas.core.groupby.ops import WrappedCythonOp\n1681 | \n1682 |         kind = WrappedCythonOp.get_kind_from_how(how)\n1683 |         op = WrappedCythonOp(how=how, kind=kind, has_dropped_na=has_dropped_na)\n1684 | \n1685 |         res_values = op._cython_op_ndim_compat(\n1686 |             npvalues,\n1687 |             min_count=min_count,\n1688 |             ngroups=ngroups,\n1689 |             comp_ids=ids,\n1690 |             mask=None,\n1691 |             **kwargs,\n1692 |         )\n1693 | \n1694 |         if op.how in op.cast_blocklist:\n1695 |             # i.e. how in [\"rank\"], since other cast_blocklist methods don't go\n1696 |             #  through cython_operation\n1697 |             return res_values\n1698 | \n1699 |         # We did a view to M8[ns] above, now we go the other direction\n1700 |         assert res_values.dtype == \"M8[ns]\"\n1701 |         if how in [\"std\", \"sem\"]:\n1702 |             from pandas.core.arrays import TimedeltaArray\n1703 | \n1704 |             if isinstance(self.dtype, PeriodDtype):\n1705 |                 raise TypeError(\"'std' and 'sem' are not valid for PeriodDtype\")\n1706 |             self = cast(\"DatetimeArray | TimedeltaArray\", self)\n1707 |             new_dtype = f\"m8[{self.unit}]\"\n1708 |             res_values = res_values.view(new_dtype)\n1709 |             return TimedeltaArray._simple_new(res_values, dtype=res_values.dtype)\n1710 | \n1711 |         res_values = res_values.view(self._ndarray.dtype)\n1712 |         return self._from_backing_data(res_values)\n1713 | \n1714 | \n1715 | class DatelikeOps(DatetimeLikeArrayMixin):\n1716 |     \"\"\"\n1717 |     Common ops for DatetimeIndex/PeriodIndex, but not TimedeltaIndex.\n1718 |     \"\"\"\n1719 | \n1720 |     @Substitution(\n1721 |         URL=\"https://docs.python.org/3/library/datetime.html\"\n1722 |         \"#strftime-and-strptime-behavior\"\n1723 |     )\n1724 |     def strftime(self, date_format: str) -> npt.NDArray[np.object_]:\n1725 |         \"\"\"\n1726 |         Convert to Index using specified date_format.\n1727 | \n1728 |         Return an Index of formatted strings specified by date_format, which\n1729 |         supports the same string format as the python standard library. Details\n1730 |         of the string format can be found in `python string format\n1731 |         doc <%(URL)s>`__.\n1732 | \n1733 |         Formats supported by the C `strftime` API but not by the python string format\n1734 |         doc (such as `\"%%R\"`, `\"%%r\"`) are not officially supported and should be\n1735 |         preferably replaced with their supported equivalents (such as `\"%%H:%%M\"`,\n1736 |         `\"%%I:%%M:%%S %%p\"`).\n1737 | \n1738 |         Note that `PeriodIndex` support additional directives, detailed in\n1739 |         `Period.strftime`.\n1740 | \n1741 |         Parameters\n1742 |         ----------\n1743 |         date_format : str\n1744 |             Date format string (e.g. \"%%Y-%%m-%%d\").\n1745 | \n1746 |         Returns\n1747 |         -------\n1748 |         ndarray[object]\n1749 |             NumPy ndarray of formatted strings.\n1750 | \n1751 |         See Also\n1752 |         --------\n1753 |         to_datetime : Convert the given argument to datetime.\n1754 |         DatetimeIndex.normalize : Return DatetimeIndex with times to midnight.\n1755 |         DatetimeIndex.round : Round the DatetimeIndex to the specified freq.\n1756 |         DatetimeIndex.floor : Floor the DatetimeIndex to the specified freq.\n1757 |         Timestamp.strftime : Format a single Timestamp.\n1758 |         Period.strftime : Format a single Period.\n1759 | \n1760 |         Examples\n1761 |         --------\n1762 |         >>> rng = pd.date_range(pd.Timestamp(\"2018-03-10 09:00\"), periods=3, freq=\"s\")\n1763 |         >>> rng.strftime(\"%%B %%d, %%Y, %%r\")\n1764 |         Index(['March 10, 2018, 09:00:00 AM', 'March 10, 2018, 09:00:01 AM',\n1765 |                'March 10, 2018, 09:00:02 AM'],\n1766 |               dtype='object')\n1767 |         \"\"\"\n1768 |         result = self._format_native_types(date_format=date_format, na_rep=np.nan)\n1769 |         if using_string_dtype():\n1770 |             from pandas import StringDtype\n1771 | \n1772 |             return pd_array(result, dtype=StringDtype(na_value=np.nan))  # type: ignore[return-value]\n1773 |         return result.astype(object, copy=False)\n1774 | \n1775 | \n1776 | _round_doc = \"\"\"\n1777 |     Perform {op} operation on the data to the specified `freq`.\n1778 | \n1779 |     Parameters\n1780 |     ----------\n1781 |     freq : str or Offset\n1782 |         The frequency level to {op} the index to. Must be a fixed\n1783 |         frequency like 's' (second) not 'ME' (month end). See\n1784 |         :ref:`frequency aliases <timeseries.offset_aliases>` for\n1785 |         a list of possible `freq` values.\n1786 |     ambiguous : 'infer', bool-ndarray, 'NaT', default 'raise'\n1787 |         Only relevant for DatetimeIndex:\n1788 | \n1789 |         - 'infer' will attempt to infer fall dst-transition hours based on\n1790 |           order\n1791 |         - bool-ndarray where True signifies a DST time, False designates\n1792 |           a non-DST time (note that this flag is only applicable for\n1793 |           ambiguous times)\n1794 |         - 'NaT' will return NaT where there are ambiguous times\n1795 |         - 'raise' will raise a ValueError if there are ambiguous\n1796 |           times.\n1797 | \n1798 |     nonexistent : 'shift_forward', 'shift_backward', 'NaT', timedelta, default 'raise'\n1799 |         A nonexistent time does not exist in a particular timezone\n1800 |         where clocks moved forward due to DST.\n1801 | \n1802 |         - 'shift_forward' will shift the nonexistent time forward to the\n1803 |           closest existing time\n1804 |         - 'shift_backward' will shift the nonexistent time backward to the\n1805 |           closest existing time\n1806 |         - 'NaT' will return NaT where there are nonexistent times\n1807 |         - timedelta objects will shift nonexistent times by the timedelta\n1808 |         - 'raise' will raise a ValueError if there are\n1809 |           nonexistent times.\n1810 | \n1811 |     Returns\n1812 |     -------\n1813 |     DatetimeIndex, TimedeltaIndex, or Series\n1814 |         Index of the same type for a DatetimeIndex or TimedeltaIndex,\n1815 |         or a Series with the same index for a Series.\n1816 | \n1817 |     Raises\n1818 |     ------\n1819 |     ValueError if the `freq` cannot be converted.\n1820 | \n1821 |     See Also\n1822 |     --------\n1823 |     DatetimeIndex.floor : Perform floor operation on the data to the specified `freq`.\n1824 |     DatetimeIndex.snap : Snap time stamps to nearest occurring frequency.\n1825 | \n1826 |     Notes\n1827 |     -----\n1828 |     If the timestamps have a timezone, {op}ing will take place relative to the\n1829 |     local (\"wall\") time and re-localized to the same timezone. When {op}ing\n1830 |     near daylight savings time, use ``nonexistent`` and ``ambiguous`` to\n1831 |     control the re-localization behavior.\n1832 | \n1833 |     Examples\n1834 |     --------\n1835 |     **DatetimeIndex**\n1836 | \n1837 |     >>> rng = pd.date_range('1/1/2018 11:59:00', periods=3, freq='min')\n1838 |     >>> rng\n1839 |     DatetimeIndex(['2018-01-01 11:59:00', '2018-01-01 12:00:00',\n1840 |                    '2018-01-01 12:01:00'],\n1841 |                   dtype='datetime64[ns]', freq='min')\n1842 |     \"\"\"\n1843 | \n1844 | _round_example = \"\"\">>> rng.round('h')\n1845 |     DatetimeIndex(['2018-01-01 12:00:00', '2018-01-01 12:00:00',\n1846 |                    '2018-01-01 12:00:00'],\n1847 |                   dtype='datetime64[ns]', freq=None)\n1848 | \n1849 |     **Series**\n1850 | \n1851 |     >>> pd.Series(rng).dt.round(\"h\")\n1852 |     0   2018-01-01 12:00:00\n1853 |     1   2018-01-01 12:00:00\n1854 |     2   2018-01-01 12:00:00\n1855 |     dtype: datetime64[ns]\n1856 | \n1857 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1858 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1859 | \n1860 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 03:30:00\"], tz=\"Europe/Amsterdam\")\n1861 | \n1862 |     >>> rng_tz.floor(\"2h\", ambiguous=False)\n1863 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1864 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1865 | \n1866 |     >>> rng_tz.floor(\"2h\", ambiguous=True)\n1867 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1868 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1869 |     \"\"\"\n1870 | \n1871 | _floor_example = \"\"\">>> rng.floor('h')\n1872 |     DatetimeIndex(['2018-01-01 11:00:00', '2018-01-01 12:00:00',\n1873 |                    '2018-01-01 12:00:00'],\n1874 |                   dtype='datetime64[ns]', freq=None)\n1875 | \n1876 |     **Series**\n1877 | \n1878 |     >>> pd.Series(rng).dt.floor(\"h\")\n1879 |     0   2018-01-01 11:00:00\n1880 |     1   2018-01-01 12:00:00\n1881 |     2   2018-01-01 12:00:00\n1882 |     dtype: datetime64[ns]\n1883 | \n1884 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1885 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1886 | \n1887 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 03:30:00\"], tz=\"Europe/Amsterdam\")\n1888 | \n1889 |     >>> rng_tz.floor(\"2h\", ambiguous=False)\n1890 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1891 |                  dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1892 | \n1893 |     >>> rng_tz.floor(\"2h\", ambiguous=True)\n1894 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1895 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1896 |     \"\"\"\n1897 | \n1898 | _ceil_example = \"\"\">>> rng.ceil('h')\n1899 |     DatetimeIndex(['2018-01-01 12:00:00', '2018-01-01 12:00:00',\n1900 |                    '2018-01-01 13:00:00'],\n1901 |                   dtype='datetime64[ns]', freq=None)\n1902 | \n1903 |     **Series**\n1904 | \n1905 |     >>> pd.Series(rng).dt.ceil(\"h\")\n1906 |     0   2018-01-01 12:00:00\n1907 |     1   2018-01-01 12:00:00\n1908 |     2   2018-01-01 13:00:00\n1909 |     dtype: datetime64[ns]\n1910 | \n1911 |     When rounding near a daylight savings time transition, use ``ambiguous`` or\n1912 |     ``nonexistent`` to control how the timestamp should be re-localized.\n1913 | \n1914 |     >>> rng_tz = pd.DatetimeIndex([\"2021-10-31 01:30:00\"], tz=\"Europe/Amsterdam\")\n1915 | \n1916 |     >>> rng_tz.ceil(\"h\", ambiguous=False)\n1917 |     DatetimeIndex(['2021-10-31 02:00:00+01:00'],\n1918 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1919 | \n1920 |     >>> rng_tz.ceil(\"h\", ambiguous=True)\n1921 |     DatetimeIndex(['2021-10-31 02:00:00+02:00'],\n1922 |                   dtype='datetime64[s, Europe/Amsterdam]', freq=None)\n1923 |     \"\"\"\n1924 | \n1925 | \n1926 | class TimelikeOps(DatetimeLikeArrayMixin):\n1927 |     \"\"\"\n1928 |     Common ops for TimedeltaIndex/DatetimeIndex, but not PeriodIndex.\n1929 |     \"\"\"\n1930 | \n1931 |     @classmethod\n1932 |     def _validate_dtype(cls, values, dtype):\n1933 |         raise AbstractMethodError(cls)\n1934 | \n1935 |     @property\n1936 |     def freq(self):\n1937 |         \"\"\"\n1938 |         Return the frequency object if it is set, otherwise None.\n1939 | \n1940 |         To learn more about the frequency strings, please see\n1941 |         :ref:`this link<timeseries.offset_aliases>`.\n1942 | \n1943 |         See Also\n1944 |         --------\n1945 |         DatetimeIndex.freq : Return the frequency object if it is set, otherwise None.\n1946 |         PeriodIndex.freq : Return the frequency object if it is set, otherwise None.\n1947 | \n1948 |         Examples\n1949 |         --------\n1950 |         >>> datetimeindex = pd.date_range(\n1951 |         ...     \"2022-02-22 02:22:22\", periods=10, tz=\"America/Chicago\", freq=\"h\"\n1952 |         ... )\n1953 |         >>> datetimeindex\n1954 |         DatetimeIndex(['2022-02-22 02:22:22-06:00', '2022-02-22 03:22:22-06:00',\n1955 |                        '2022-02-22 04:22:22-06:00', '2022-02-22 05:22:22-06:00',\n1956 |                        '2022-02-22 06:22:22-06:00', '2022-02-22 07:22:22-06:00',\n1957 |                        '2022-02-22 08:22:22-06:00', '2022-02-22 09:22:22-06:00',\n1958 |                        '2022-02-22 10:22:22-06:00', '2022-02-22 11:22:22-06:00'],\n1959 |                       dtype='datetime64[ns, America/Chicago]', freq='h')\n1960 |         >>> datetimeindex.freq\n1961 |         <Hour>\n1962 |         \"\"\"\n1963 |         return self._freq\n1964 | \n1965 |     @freq.setter\n1966 |     def freq(self, value) -> None:\n1967 |         if value is not None:\n1968 |             value = to_offset(value)\n1969 |             self._validate_frequency(self, value)\n1970 |             if self.dtype.kind == \"m\" and not isinstance(value, Tick):\n1971 |                 raise TypeError(\"TimedeltaArray/Index freq must be a Tick\")\n1972 | \n1973 |             if self.ndim > 1:\n1974 |                 raise ValueError(\"Cannot set freq with ndim > 1\")\n1975 | \n1976 |         self._freq = value\n1977 | \n1978 |     @final\n1979 |     def _maybe_pin_freq(self, freq, validate_kwds: dict) -> None:\n1980 |         \"\"\"\n1981 |         Constructor helper to pin the appropriate `freq` attribute.  Assumes\n1982 |         that self._freq is currently set to any freq inferred in\n1983 |         _from_sequence_not_strict.\n1984 |         \"\"\"\n1985 |         if freq is None:\n1986 |             # user explicitly passed None -> override any inferred_freq\n1987 |             self._freq = None\n1988 |         elif freq == \"infer\":\n1989 |             # if self._freq is *not* None then we already inferred a freq\n1990 |             #  and there is nothing left to do\n1991 |             if self._freq is None:\n1992 |                 # Set _freq directly to bypass duplicative _validate_frequency\n1993 |                 # check.\n1994 |                 self._freq = to_offset(self.inferred_freq)\n1995 |         elif freq is lib.no_default:\n1996 |             # user did not specify anything, keep inferred freq if the original\n1997 |             #  data had one, otherwise do nothing\n1998 |             pass\n1999 |         elif self._freq is None:\n2000 |             # We cannot inherit a freq from the data, so we need to validate\n2001 |             #  the user-passed freq\n2002 |             freq = to_offset(freq)\n2003 |             type(self)._validate_frequency(self, freq, **validate_kwds)\n2004 |             self._freq = freq\n2005 |         else:\n2006 |             # Otherwise we just need to check that the user-passed freq\n2007 |             #  doesn't conflict with the one we already have.\n2008 |             freq = to_offset(freq)\n2009 |             _validate_inferred_freq(freq, self._freq)\n2010 | \n2011 |     @final\n2012 |     @classmethod\n2013 |     def _validate_frequency(cls, index, freq: BaseOffset, **kwargs) -> None:\n2014 |         \"\"\"\n2015 |         Validate that a frequency is compatible with the values of a given\n2016 |         Datetime Array/Index or Timedelta Array/Index\n2017 | \n2018 |         Parameters\n2019 |         ----------\n2020 |         index : DatetimeIndex or TimedeltaIndex\n2021 |             The index on which to determine if the given frequency is valid\n2022 |         freq : DateOffset\n2023 |             The frequency to validate\n2024 |         \"\"\"\n2025 |         inferred = index.inferred_freq\n2026 |         if index.size == 0 or inferred == freq.freqstr:\n2027 |             return None\n2028 | \n2029 |         try:\n2030 |             on_freq = cls._generate_range(\n2031 |                 start=index[0],\n2032 |                 end=None,\n2033 |                 periods=len(index),\n2034 |                 freq=freq,\n2035 |                 unit=index.unit,\n2036 |                 **kwargs,\n2037 |             )\n2038 |             if not np.array_equal(index.asi8, on_freq.asi8):\n2039 |                 raise ValueError\n2040 |         except ValueError as err:\n2041 |             if \"non-fixed\" in str(err):\n2042 |                 # non-fixed frequencies are not meaningful for timedelta64;\n2043 |                 #  we retain that error message\n2044 |                 raise err\n2045 |             # GH#11587 the main way this is reached is if the `np.array_equal`\n2046 |             #  check above is False.  This can also be reached if index[0]\n2047 |             #  is `NaT`, in which case the call to `cls._generate_range` will\n2048 |             #  raise a ValueError, which we re-raise with a more targeted\n2049 |             #  message.\n2050 |             raise ValueError(\n2051 |                 f\"Inferred frequency {inferred} from passed values \"\n2052 |                 f\"does not conform to passed frequency {freq.freqstr}\"\n2053 |             ) from err\n2054 | \n2055 |     @classmethod\n2056 |     def _generate_range(\n2057 |         cls, start, end, periods: int | None, freq, *args, **kwargs\n2058 |     ) -> Self:\n2059 |         raise AbstractMethodError(cls)\n2060 | \n2061 |     # --------------------------------------------------------------\n2062 | \n2063 |     @cache_readonly\n2064 |     def _creso(self) -> int:\n2065 |         return get_unit_from_dtype(self._ndarray.dtype)\n2066 | \n2067 |     @cache_readonly\n2068 |     def unit(self) -> str:\n2069 |         # e.g. \"ns\", \"us\", \"ms\"\n2070 |         # error: Argument 1 to \"dtype_to_unit\" has incompatible type\n2071 |         # \"ExtensionDtype\"; expected \"Union[DatetimeTZDtype, dtype[Any]]\"\n2072 |         return dtype_to_unit(self.dtype)  # type: ignore[arg-type]\n2073 | \n2074 |     def as_unit(self, unit: str, round_ok: bool = True) -> Self:\n2075 |         \"\"\"\n2076 |         Convert to a dtype with the given unit resolution.\n2077 | \n2078 |         The limits of timestamp representation depend on the chosen resolution.\n2079 |         Different resolutions can be converted to each other through as_unit.\n2080 | \n2081 |         Parameters\n2082 |         ----------\n2083 |         unit : {'s', 'ms', 'us', 'ns'}\n2084 |         round_ok : bool, default True\n2085 |             If False and the conversion requires rounding, raise ValueError.\n2086 | \n2087 |         Returns\n2088 |         -------\n2089 |         same type as self\n2090 |             Converted to the specified unit.\n2091 | \n2092 |         See Also\n2093 |         --------\n2094 |         Timestamp.as_unit : Convert to the given unit.\n2095 | \n2096 |         Examples\n2097 |         --------\n2098 |         For :class:`pandas.DatetimeIndex`:\n2099 | \n2100 |         >>> idx = pd.DatetimeIndex([\"2020-01-02 01:02:03.004005006\"])\n2101 |         >>> idx\n2102 |         DatetimeIndex(['2020-01-02 01:02:03.004005006'],\n2103 |                       dtype='datetime64[ns]', freq=None)\n2104 |         >>> idx.as_unit(\"s\")\n2105 |         DatetimeIndex(['2020-01-02 01:02:03'], dtype='datetime64[s]', freq=None)\n2106 | \n2107 |         For :class:`pandas.TimedeltaIndex`:\n2108 | \n2109 |         >>> tdelta_idx = pd.to_timedelta([\"1 day 3 min 2 us 42 ns\"])\n2110 |         >>> tdelta_idx\n2111 |         TimedeltaIndex(['1 days 00:03:00.000002042'],\n2112 |                         dtype='timedelta64[ns]', freq=None)\n2113 |         >>> tdelta_idx.as_unit(\"s\")\n2114 |         TimedeltaIndex(['1 days 00:03:00'], dtype='timedelta64[s]', freq=None)\n2115 |         \"\"\"\n2116 |         if unit not in [\"s\", \"ms\", \"us\", \"ns\"]:\n2117 |             raise ValueError(\"Supported units are 's', 'ms', 'us', 'ns'\")\n2118 | \n2119 |         dtype = np.dtype(f\"{self.dtype.kind}8[{unit}]\")\n2120 |         new_values = astype_overflowsafe(self._ndarray, dtype, round_ok=round_ok)\n2121 | \n2122 |         if isinstance(self.dtype, np.dtype):\n2123 |             new_dtype = new_values.dtype\n2124 |         else:\n2125 |             tz = cast(\"DatetimeArray\", self).tz\n2126 |             new_dtype = DatetimeTZDtype(tz=tz, unit=unit)\n2127 | \n2128 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of\n2129 |         # \"NDArrayBacked\"  [call-arg]\n2130 |         return type(self)._simple_new(\n2131 |             new_values,\n2132 |             dtype=new_dtype,\n2133 |             freq=self.freq,  # type: ignore[call-arg]\n2134 |         )\n2135 | \n2136 |     # TODO: annotate other as DatetimeArray | TimedeltaArray | Timestamp | Timedelta\n2137 |     #  with the return type matching input type.  TypeVar?\n2138 |     def _ensure_matching_resos(self, other):\n2139 |         if self._creso != other._creso:\n2140 |             # Just as with Timestamp/Timedelta, we cast to the higher resolution\n2141 |             if self._creso < other._creso:\n2142 |                 self = self.as_unit(other.unit)\n2143 |             else:\n2144 |                 other = other.as_unit(self.unit)\n2145 |         return self, other\n2146 | \n2147 |     # --------------------------------------------------------------\n2148 | \n2149 |     def __array_ufunc__(self, ufunc: np.ufunc, method: str, *inputs, **kwargs):\n2150 |         if (\n2151 |             ufunc in [np.isnan, np.isinf, np.isfinite]\n2152 |             and len(inputs) == 1\n2153 |             and inputs[0] is self\n2154 |         ):\n2155 |             # numpy 1.18 changed isinf and isnan to not raise on dt64/td64\n2156 |             return getattr(ufunc, method)(self._ndarray, **kwargs)\n2157 | \n2158 |         return super().__array_ufunc__(ufunc, method, *inputs, **kwargs)\n2159 | \n2160 |     def _round(self, freq, mode, ambiguous, nonexistent):\n2161 |         # round the local times\n2162 |         if isinstance(self.dtype, DatetimeTZDtype):\n2163 |             # operate on naive timestamps, then convert back to aware\n2164 |             self = cast(\"DatetimeArray\", self)\n2165 |             naive = self.tz_localize(None)\n2166 |             result = naive._round(freq, mode, ambiguous, nonexistent)\n2167 |             return result.tz_localize(\n2168 |                 self.tz, ambiguous=ambiguous, nonexistent=nonexistent\n2169 |             )\n2170 | \n2171 |         values = self.view(\"i8\")\n2172 |         values = cast(np.ndarray, values)\n2173 |         nanos = get_unit_for_round(freq, self._creso)\n2174 |         if nanos == 0:\n2175 |             # GH 52761\n2176 |             return self.copy()\n2177 |         result_i8 = round_nsint64(values, mode, nanos)\n2178 |         result = self._maybe_mask_results(result_i8, fill_value=iNaT)\n2179 |         result = result.view(self._ndarray.dtype)\n2180 |         return self._simple_new(result, dtype=self.dtype)\n2181 | \n2182 |     @Appender((_round_doc + _round_example).format(op=\"round\"))\n2183 |     def round(\n2184 |         self,\n2185 |         freq,\n2186 |         ambiguous: TimeAmbiguous = \"raise\",\n2187 |         nonexistent: TimeNonexistent = \"raise\",\n2188 |     ) -> Self:\n2189 |         return self._round(freq, RoundTo.NEAREST_HALF_EVEN, ambiguous, nonexistent)\n2190 | \n2191 |     @Appender((_round_doc + _floor_example).format(op=\"floor\"))\n2192 |     def floor(\n2193 |         self,\n2194 |         freq,\n2195 |         ambiguous: TimeAmbiguous = \"raise\",\n2196 |         nonexistent: TimeNonexistent = \"raise\",\n2197 |     ) -> Self:\n2198 |         return self._round(freq, RoundTo.MINUS_INFTY, ambiguous, nonexistent)\n2199 | \n2200 |     @Appender((_round_doc + _ceil_example).format(op=\"ceil\"))\n2201 |     def ceil(\n2202 |         self,\n2203 |         freq,\n2204 |         ambiguous: TimeAmbiguous = \"raise\",\n2205 |         nonexistent: TimeNonexistent = \"raise\",\n2206 |     ) -> Self:\n2207 |         return self._round(freq, RoundTo.PLUS_INFTY, ambiguous, nonexistent)\n2208 | \n2209 |     # --------------------------------------------------------------\n2210 |     # Reductions\n2211 | \n2212 |     def any(self, *, axis: AxisInt | None = None, skipna: bool = True) -> bool:\n2213 |         # GH#34479 the nanops call will raise a TypeError for non-td64 dtype\n2214 |         return nanops.nanany(self._ndarray, axis=axis, skipna=skipna, mask=self.isna())\n2215 | \n2216 |     def all(self, *, axis: AxisInt | None = None, skipna: bool = True) -> bool:\n2217 |         # GH#34479 the nanops call will raise a TypeError for non-td64 dtype\n2218 | \n2219 |         return nanops.nanall(self._ndarray, axis=axis, skipna=skipna, mask=self.isna())\n2220 | \n2221 |     # --------------------------------------------------------------\n2222 |     # Frequency Methods\n2223 | \n2224 |     def _maybe_clear_freq(self) -> None:\n2225 |         self._freq = None\n2226 | \n2227 |     def _with_freq(self, freq) -> Self:\n2228 |         \"\"\"\n2229 |         Helper to get a view on the same data, with a new freq.\n2230 | \n2231 |         Parameters\n2232 |         ----------\n2233 |         freq : DateOffset, None, or \"infer\"\n2234 | \n2235 |         Returns\n2236 |         -------\n2237 |         Same type as self\n2238 |         \"\"\"\n2239 |         # GH#29843\n2240 |         if freq is None:\n2241 |             # Always valid\n2242 |             pass\n2243 |         elif len(self) == 0 and isinstance(freq, BaseOffset):\n2244 |             # Always valid.  In the TimedeltaArray case, we require a Tick offset\n2245 |             if self.dtype.kind == \"m\" and not isinstance(freq, Tick):\n2246 |                 raise TypeError(\"TimedeltaArray/Index freq must be a Tick\")\n2247 |         else:\n2248 |             # As an internal method, we can ensure this assertion always holds\n2249 |             assert freq == \"infer\"\n2250 |             freq = to_offset(self.inferred_freq)\n2251 | \n2252 |         arr = self.view()\n2253 |         arr._freq = freq\n2254 |         return arr\n2255 | \n2256 |     # --------------------------------------------------------------\n2257 |     # ExtensionArray Interface\n2258 | \n2259 |     def _values_for_json(self) -> np.ndarray:\n2260 |         # Small performance bump vs the base class which calls np.asarray(self)\n2261 |         if isinstance(self.dtype, np.dtype):\n2262 |             return self._ndarray\n2263 |         return super()._values_for_json()\n2264 | \n2265 |     def factorize(\n2266 |         self,\n2267 |         use_na_sentinel: bool = True,\n2268 |         sort: bool = False,\n2269 |     ):\n2270 |         if self.freq is not None:\n2271 |             # We must be unique, so can short-circuit (and retain freq)\n2272 |             if sort and self.freq.n < 0:\n2273 |                 codes = np.arange(len(self) - 1, -1, -1, dtype=np.intp)\n2274 |                 uniques = self[::-1]\n2275 |             else:\n2276 |                 codes = np.arange(len(self), dtype=np.intp)\n2277 |                 uniques = self.copy()  # TODO: copy or view?\n2278 |             return codes, uniques\n2279 | \n2280 |         if sort:\n2281 |             # algorithms.factorize only passes sort=True here when freq is\n2282 |             #  not None, so this should not be reached.\n2283 |             raise NotImplementedError(\n2284 |                 f\"The 'sort' keyword in {type(self).__name__}.factorize is \"\n2285 |                 \"ignored unless arr.freq is not None. To factorize with sort, \"\n2286 |                 \"call pd.factorize(obj, sort=True) instead.\"\n2287 |             )\n2288 |         return super().factorize(use_na_sentinel=use_na_sentinel)\n2289 | \n2290 |     @classmethod\n2291 |     def _concat_same_type(\n2292 |         cls,\n2293 |         to_concat: Sequence[Self],\n2294 |         axis: AxisInt = 0,\n2295 |     ) -> Self:\n2296 |         new_obj = super()._concat_same_type(to_concat, axis)\n2297 | \n2298 |         obj = to_concat[0]\n2299 | \n2300 |         if axis == 0:\n2301 |             # GH 3232: If the concat result is evenly spaced, we can retain the\n2302 |             # original frequency\n2303 |             to_concat = [x for x in to_concat if len(x)]\n2304 | \n2305 |             if obj.freq is not None and all(x.freq == obj.freq for x in to_concat):\n2306 |                 pairs = zip(to_concat[:-1], to_concat[1:])\n2307 |                 if all(pair[0][-1] + obj.freq == pair[1][0] for pair in pairs):\n2308 |                     new_freq = obj.freq\n2309 |                     new_obj._freq = new_freq\n2310 |         return new_obj\n2311 | \n2312 |     def copy(self, order: str = \"C\") -> Self:\n2313 |         new_obj = super().copy(order=order)\n2314 |         new_obj._freq = self.freq\n2315 |         return new_obj\n2316 | \n2317 |     def interpolate(\n2318 |         self,\n2319 |         *,\n2320 |         method: InterpolateOptions,\n2321 |         axis: int,\n2322 |         index: Index,\n2323 |         limit,\n2324 |         limit_direction,\n2325 |         limit_area,\n2326 |         copy: bool,\n2327 |         **kwargs,\n2328 |     ) -> Self:\n2329 |         \"\"\"\n2330 |         See NDFrame.interpolate.__doc__.\n2331 |         \"\"\"\n2332 |         # NB: we return type(self) even if copy=False\n2333 |         if method != \"linear\":\n2334 |             raise NotImplementedError\n2335 | \n2336 |         if not copy:\n2337 |             out_data = self._ndarray\n2338 |         else:\n2339 |             out_data = self._ndarray.copy()\n2340 | \n2341 |         missing.interpolate_2d_inplace(\n2342 |             out_data,\n2343 |             method=method,\n2344 |             axis=axis,\n2345 |             index=index,\n2346 |             limit=limit,\n2347 |             limit_direction=limit_direction,\n2348 |             limit_area=limit_area,\n2349 |             **kwargs,\n2350 |         )\n2351 |         if not copy:\n2352 |             return self\n2353 |         return type(self)._simple_new(out_data, dtype=self.dtype)\n2354 | \n2355 |     def take(\n2356 |         self,\n2357 |         indices: TakeIndexer,\n2358 |         *,\n2359 |         allow_fill: bool = False,\n2360 |         fill_value: Any = None,\n2361 |         axis: AxisInt = 0,\n2362 |     ) -> Self:\n2363 |         result = super().take(\n2364 |             indices=indices, allow_fill=allow_fill, fill_value=fill_value, axis=axis\n2365 |         )\n2366 | \n2367 |         indices = np.asarray(indices, dtype=np.intp)\n2368 |         maybe_slice = lib.maybe_indices_to_slice(indices, len(self))\n2369 | \n2370 |         if isinstance(maybe_slice, slice):\n2371 |             freq = self._get_getitem_freq(maybe_slice)\n2372 |             result._freq = freq\n2373 | \n2374 |         return result\n2375 | \n2376 |     # --------------------------------------------------------------\n2377 |     # Unsorted\n2378 | \n2379 |     @property\n2380 |     def _is_dates_only(self) -> bool:\n2381 |         \"\"\"\n2382 |         Check if we are round times at midnight (and no timezone), which will\n2383 |         be given a more compact __repr__ than other cases. For TimedeltaArray\n2384 |         we are checking for multiples of 24H.\n2385 |         \"\"\"\n2386 |         if not lib.is_np_dtype(self.dtype):\n2387 |             # i.e. we have a timezone\n2388 |             return False\n2389 | \n2390 |         values_int = self.asi8\n2391 |         consider_values = values_int != iNaT\n2392 |         reso = get_unit_from_dtype(self.dtype)\n2393 |         ppd = periods_per_day(reso)\n2394 | \n2395 |         # TODO: can we reuse is_date_array_normalized?  would need a skipna kwd\n2396 |         #  (first attempt at this was less performant than this implementation)\n2397 |         even_days = np.logical_and(consider_values, values_int % ppd != 0).sum() == 0\n2398 |         return even_days\n2399 | \n2400 | \n2401 | # -------------------------------------------------------------------\n2402 | # Shared Constructor Helpers\n2403 | \n2404 | \n2405 | def ensure_arraylike_for_datetimelike(\n2406 |     data, copy: bool, cls_name: str\n2407 | ) -> tuple[ArrayLike, bool]:\n2408 |     if not hasattr(data, \"dtype\"):\n2409 |         # e.g. list, tuple\n2410 |         if not isinstance(data, (list, tuple)) and np.ndim(data) == 0:\n2411 |             # i.e. generator\n2412 |             data = list(data)\n2413 | \n2414 |         data = construct_1d_object_array_from_listlike(data)\n2415 |         copy = False\n2416 |     elif isinstance(data, ABCMultiIndex):\n2417 |         raise TypeError(f\"Cannot create a {cls_name} from a MultiIndex.\")\n2418 |     else:\n2419 |         data = extract_array(data, extract_numpy=True)\n2420 | \n2421 |     if isinstance(data, IntegerArray) or (\n2422 |         isinstance(data, ArrowExtensionArray) and data.dtype.kind in \"iu\"\n2423 |     ):\n2424 |         data = data.to_numpy(\"int64\", na_value=iNaT)\n2425 |         copy = False\n2426 |     elif isinstance(data, ArrowExtensionArray):\n2427 |         data = data._maybe_convert_datelike_array()\n2428 |         data = data.to_numpy()\n2429 |         copy = False\n2430 |     elif not isinstance(data, (np.ndarray, ExtensionArray)):\n2431 |         # GH#24539 e.g. xarray, dask object\n2432 |         data = np.asarray(data)\n2433 | \n2434 |     elif isinstance(data, ABCCategorical):\n2435 |         # GH#18664 preserve tz in going DTI->Categorical->DTI\n2436 |         # TODO: cases where we need to do another pass through maybe_convert_dtype,\n2437 |         #  e.g. the categories are timedelta64s\n2438 |         data = data.categories.take(data.codes, fill_value=NaT)._values\n2439 |         copy = False\n2440 | \n2441 |     return data, copy\n2442 | \n2443 | \n2444 | @overload\n2445 | def validate_periods(periods: None) -> None: ...\n2446 | \n2447 | \n2448 | @overload\n2449 | def validate_periods(periods: int) -> int: ...\n2450 | \n2451 | \n2452 | def validate_periods(periods: int | None) -> int | None:\n2453 |     \"\"\"\n2454 |     If a `periods` argument is passed to the Datetime/Timedelta Array/Index\n2455 |     constructor, cast it to an integer.\n2456 | \n2457 |     Parameters\n2458 |     ----------\n2459 |     periods : None, int\n2460 | \n2461 |     Returns\n2462 |     -------\n2463 |     periods : None or int\n2464 | \n2465 |     Raises\n2466 |     ------\n2467 |     TypeError\n2468 |         if periods is not None or int\n2469 |     \"\"\"\n2470 |     if periods is not None and not lib.is_integer(periods):\n2471 |         raise TypeError(f\"periods must be an integer, got {periods}\")\n2472 |     # error: Incompatible return value type (got \"int | integer[Any] | None\",\n2473 |     # expected \"int | None\")\n2474 |     return periods  # type: ignore[return-value]\n2475 | \n2476 | \n2477 | def _validate_inferred_freq(\n2478 |     freq: BaseOffset | None, inferred_freq: BaseOffset | None\n2479 | ) -> BaseOffset | None:\n2480 |     \"\"\"\n2481 |     If the user passes a freq and another freq is inferred from passed data,\n2482 |     require that they match.\n2483 | \n2484 |     Parameters\n2485 |     ----------\n2486 |     freq : DateOffset or None\n2487 |     inferred_freq : DateOffset or None\n2488 | \n2489 |     Returns\n2490 |     -------\n2491 |     freq : DateOffset or None\n2492 |     \"\"\"\n2493 |     if inferred_freq is not None:\n2494 |         if freq is not None and freq != inferred_freq:\n2495 |             raise ValueError(\n2496 |                 f\"Inferred frequency {inferred_freq} from passed \"\n2497 |                 \"values does not conform to passed frequency \"\n2498 |                 f\"{freq.freqstr}\"\n2499 |             )\n2500 |         if freq is None:\n2501 |             freq = inferred_freq\n2502 | \n2503 |     return freq\n2504 | \n2505 | \n2506 | def dtype_to_unit(dtype: DatetimeTZDtype | np.dtype | ArrowDtype) -> str:\n2507 |     \"\"\"\n2508 |     Return the unit str corresponding to the dtype's resolution.\n2509 | \n2510 |     Parameters\n2511 |     ----------\n2512 |     dtype : DatetimeTZDtype or np.dtype\n2513 |         If np.dtype, we assume it is a datetime64 dtype.\n2514 | \n2515 |     Returns\n2516 |     -------\n2517 |     str\n2518 |     \"\"\"\n2519 |     if isinstance(dtype, DatetimeTZDtype):\n2520 |         return dtype.unit\n2521 |     elif isinstance(dtype, ArrowDtype):\n2522 |         if dtype.kind not in \"mM\":\n2523 |             raise ValueError(f\"{dtype=} does not have a resolution.\")\n2524 |         return dtype.pyarrow_dtype.unit\n2525 |     return np.datetime_data(dtype)[0]\n2526 | \n```\n"}, {"content": "Based on my analysis of the codebase and the issue description, here are the relevant locations that need modification to improve the documentation:\n\n```\npandas/core/series.py\nline: 2481-2485\nfunction: Series.round\n\npandas/core/arrays/datetimelike.py\nline: 184-190\nclass: TimelikeOps\nfunction: _round\n\npandas/core/arrays/datetimelike.py\nline: 2183-2187\nclass: TimelikeOps\nfunction: round\n\npandas/core/arrays/datetimelike.py\nline: 2192-2198\nclass: TimelikeOps\nfunction: floor\n\npandas/core/arrays/datetimelike.py\nline: 2201-2207\nclass: TimelikeOps\nfunction: ceil\n```\n\nExplanation of why these locations are relevant:\n\n1. The main issue is in the `pandas/core/series.py:Series.round` implementation, where the docstring needs to be updated to include the relationship between `Series.round()` and `Series.dt.round()`.\n\n2. The other files in the `datetimelike.py` module are relevant because:\n   - They contain the core implementation of datetime-related operations\n   - The `TimelikeOps` class provides the base functionality for time-related operations\n   - The `round()`, `floor()`, and `ceil()` methods in `TimelikeOps` show the intended usage patterns for these operations\n\n3. The reason these specific locations are important:\n   - They form the complete set of datetime-related operations in pandas\n   - They show how these operations are organized and documented\n   - They demonstrate the hierarchy of classes and methods involved in the implementation\n   - They provide the context for understanding how `Series.round()` and `Series.dt.round()` interact\n\nThese locations cover both the main implementation and the supporting documentation that would need to be updated to better reflect the relationship between these two rounding operations.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 146483, "completion_tokens": 688}, "time": 338.1932029724121}]}}
