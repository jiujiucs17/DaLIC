158 |         print(\"downloading dataset (once and for all) into %s\" % data_path)\n159 |         data_path.mkdir(parents=True, exist_ok=True)\n160 | \n161 |         def progress(blocknum, bs, size):\n162 |             total_sz_mb = \"%.2f MB\" % (size / 1e6)\n163 |             current_sz_mb = \"%.2f MB\" % ((blocknum * bs) / 1e6)\n164 |             if _not_in_sphinx():\n165 |                 sys.stdout.write(\"\\rdownloaded %s / %s\" % (current_sz_mb, total_sz_mb))\n166 | \n167 |         archive_path = data_path / ARCHIVE_FILENAME\n168 | \n169 |         urlretrieve(DOWNLOAD_URL, filename=archive_path, reporthook=progress)\n170 |         if _not_in_sphinx():\n171 |             sys.stdout.write(\"\\r\")\n172 | \n173 |         # Check that the archive was not tampered:\n174 |         assert sha256(archive_path.read_bytes()).hexdigest() == ARCHIVE_SHA256\n175 | \n176 |         print(\"untarring Reuters dataset...\")\n177 |         with tarfile.open(archive_path, \"r:gz\") as fp:\n178 |             fp.extractall(data_path, filter=\"data\")\n179 |         print(\"done.\")\n180 | \n181 |     parser = ReutersParser()\n182 |     for filename in data_path.glob(\"*.sgm\"):\n183 |         for doc in parser.parse(open(filename, \"rb\")):\n184 |             yield doc\n```\n\n\n\n##Searching for term \"assert consistent docs\", \"docstring consistency assert consistent docs\"...\n### Search Result:\nFound function `sklearn/utils/estimator_checks.py:check_array_api_input`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 875 | def check_array_api_input(\n 876 |     name,\n 877 |     estimator_orig,\n 878 |     array_namespace,\n 879 |     device=None,\n 880 |     dtype_name=\"float64\",\n 881 |     check_values=False,\n 882 | ):\n 883 |     \"\"\"Check that the estimator can work consistently with the Array API\n 884 | \n 885 |     By default, this just checks that the types and shapes of the arrays are\n 886 |     consistent with calling the same estimator with numpy arrays.\n 887 | \n 888 |     When check_values is True, it also checks that calling the estimator on the\n 889 |     array_api Array gives the same results as ndarrays.\n 890 |     \"\"\"\n 891 |     xp = _array_api_for_tests(array_namespace, device)\n 892 | \n 893 |     X, y = make_classification(random_state=42)\n 894 |     X = X.astype(dtype_name, copy=False)\n 895 | \n 896 |     X = _enforce_estimator_tags_X(estimator_orig, X)\n 897 |     y = _enforce_estimator_tags_y(estimator_orig, y)\n 898 | \n 899 |     est = clone(estimator_orig)\n 900 | \n 901 |     X_xp = xp.asarray(X, device=device)\n 902 |     y_xp = xp.asarray(y, device=device)\n 903 | \n 904 |     est.fit(X, y)\n 905 | \n 906 |     array_attributes = {\n 907 |         key: value for key, value in vars(est).items() if isinstance(value, np.ndarray)\n 908 |     }\n 909 | \n 910 |     est_xp = clone(est)\n 911 |     with config_context(array_api_dispatch=True):\n 912 |         est_xp.fit(X_xp, y_xp)\n 913 |         input_ns = get_namespace(X_xp)[0].__name__\n 914 | \n 915 |     # Fitted attributes which are arrays must have the same\n 916 |     # namespace as the one of the training data.\n 917 |     for key, attribute in array_attributes.items():\n 918 |         est_xp_param = getattr(est_xp, key)\n 919 |         with config_context(array_api_dispatch=True):\n 920 |             attribute_ns = get_namespace(est_xp_param)[0].__name__\n 921 |         assert attribute_ns == input_ns, (\n 922 |             f\"'{key}' attribute is in wrong namespace, expected {input_ns} \"\n 923 |             f\"got {attribute_ns}\"\n 924 |         )\n 925 | \n 926 |         assert array_device(est_xp_param) == array_device(X_xp)\n 927 | \n 928 |         est_xp_param_np = _convert_to_numpy(est_xp_param, xp=xp)\n 929 |         if check_values:\n 930 |             assert_allclose(\n 931 |                 attribute,\n 932 |                 est_xp_param_np,\n 933 |                 err_msg=f\"{key} not the same\",\n 934 |                 atol=_atol_for_type(X.dtype),\n 935 |             )\n 936 |         else:\n 937 |             assert attribute.shape == est_xp_param_np.shape\n 938 |             assert attribute.dtype == est_xp_param_np.dtype\n 939 | \n 940 |     # Check estimator methods, if supported, give the same results\n 941 |     methods = (\n 942 |         \"score\",\n 943 |         \"score_samples\",\n 944 |         \"decision_function\",\n 945 |         \"predict\",\n 946 |         \"predict_log_proba\",\n 947 |         \"predict_proba\",\n 948 |         \"transform\",\n 949 |     )\n 950 | \n 951 |     for method_name in methods:\n 952 |         method = getattr(est, method_name, None)\n 953 |         if method is None:\n 954 |             continue\n 955 | \n 956 |         if method_name == \"score\":\n 957 |             result = method(X, y)\n 958 |             with config_context(array_api_dispatch=True):\n 959 |                 result_xp = getattr(est_xp, method_name)(X_xp, y_xp)\n 960 |             # score typically returns a Python float\n 961 |             assert isinstance(result, float)\n 962 |             assert isinstance(result_xp, float)\n 963 |             if check_values:\n 964 |                 assert abs(result - result_xp) < _atol_for_type(X.dtype)\n 965 |             continue\n 966 |         else:\n 967 |             result = method(X)\n 968 |             with config_context(array_api_dispatch=True):\n 969 |                 result_xp = getattr(est_xp, method_name)(X_xp)\n 970 | \n 971 |         with config_context(array_api_dispatch=True):\n 972 |             result_ns = get_namespace(result_xp)[0].__name__\n 973 |         assert result_ns == input_ns, (\n 974 |             f\"'{method}' output is in wrong namespace, expected {input_ns}, \"\n 975 |             f\"got {result_ns}.\"\n 976 |         )\n 977 | \n 978 |         assert array_device(result_xp) == array_device(X_xp)\n 979 |         result_xp_np = _convert_to_numpy(result_xp, xp=xp)\n 980 | \n 98