       v = v.tz_convert(\"UTC\")\n228 |             return TermValue(v, v._value, kind)\n229 |         elif kind in (\"timedelta64\", \"timedelta\"):\n230 |             if isinstance(v, str):\n231 |                 v = Timedelta(v)\n232 |             else:\n233 |                 v = Timedelta(v, unit=\"s\")\n234 |             v = v.as_unit(\"ns\")._value\n235 |             return TermValue(int(v), v, kind)\n236 |         elif meta == \"category\":\n237 |             metadata = extract_array(self.metadata, extract_numpy=True)\n238 |             result: npt.NDArray[np.intp] | np.intp | int\n239 |             if v not in metadata:\n240 |                 result = -1\n241 |             else:\n242 |                 result = metadata.searchsorted(v, side=\"left\")\n243 |             return TermValue(result, result, \"integer\")\n244 |         elif kind == \"integer\":\n245 |             try:\n246 |                 v_dec = Decimal(v)\n247 |             except InvalidOperation:\n248 |                 # GH 54186\n249 |                 # convert v to float to raise float's ValueError\n250 |                 float(v)\n251 |             else:\n252 |                 v = int(v_dec.to_integral_exact(rounding=\"ROUND_HALF_EVEN\"))\n253 |             return TermValue(v, v, kind)\n254 |         elif kind == \"float\":\n255 |             v = float(v)\n256 |             return TermValue(v, v, kind)\n257 |         elif kind == \"bool\":\n258 |             if isinstance(v, str):\n259 |                 v = v.strip().lower() not in [\n260 |                     \"false\",\n261 |                     \"f\",\n262 |                     \"no\",\n263 |                     \"n\",\n264 |                     \"none\",\n265 |                     \"0\",\n266 |                     \"[]\",\n267 |                     \"{}\",\n268 |                     \"\",\n269 |                 ]\n270 |             else:\n271 |                 v = bool(v)\n272 |             return TermValue(v, v, kind)\n273 |         elif isinstance(v, str):\n274 |             # string quoting\n275 |             return TermValue(v, stringify(v), \"string\")\n276 |         else:\n277 |             raise TypeError(f\"Cannot compare {v} of type {type(v)} to {kind} column\")\n278 | \n279 |     def convert_values(self) -> None:\n280 |         pass\n281 | \n282 | \n283 | class FilterBinOp(BinOp):\n284 |     filter: tuple[Any, Any, Index] | None = None\n285 | \n286 |     def __repr__(self) -> str:\n287 |         if self.filter is None:\n288 |             return \"Filter: Not Initialized\"\n289 |         return pprint_thing(f\"[Filter : [{self.filter[0]}] -> [{self.filter[1]}]\")\n290 | \n291 |     def invert(self) -> Self:\n292 |         \"\"\"invert the filter\"\"\"\n293 |         if self.filter is not None:\n294 |             self.filter = (\n295 |                 self.filter[0],\n296 |                 self.generate_filter_op(invert=True),\n297 |                 self.filter[2],\n298 |             )\n299 |         return self\n300 | \n301 |     def format(self):\n302 |         \"\"\"return the actual filter format\"\"\"\n303 |         return [self.filter]\n304 | \n305 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n306 |     def evaluate(self) -> Self | None:  # type: ignore[override]\n307 |         if not self.is_valid:\n308 |             raise ValueError(f\"query term is not valid [{self}]\")\n309 | \n310 |         rhs = self.conform(self.rhs)\n311 |         values = list(rhs)\n312 | \n313 |         if self.is_in_table:\n314 |             # if too many values to create the expression, use a filter instead\n315 |             if self.op in [\"==\", \"!=\"] and len(values) > self._max_selectors:\n316 |                 filter_op = self.generate_filter_op()\n317 |                 self.filter = (self.lhs, filter_op, Index(values))\n318 | \n319 |                 return self\n320 |             return None\n321 | \n322 |         # equality conditions\n323 |         if self.op in [\"==\", \"!=\"]:\n324 |             filter_op = self.generate_filter_op()\n325 |             self.filter = (self.lhs, filter_op, Index(values))\n326 | \n327 |         else:\n328 |             raise TypeError(\n329 |                 f\"passing a filterable condition to a non-table indexer [{self}]\"\n330 |             )\n331 | \n332 |         return self\n333 | \n334 |     def generate_filter_op(self, invert: bool = False):\n335 |         if (self.op == \"!=\" and not invert) or (self.op == \"==\" and invert):\n336 |             return lambda axis, vals: ~axis.isin(vals)\n337 |         else:\n338 |             return lambda axis, vals: axis.isin(vals)\n339 | \n340 | \n341 | class JointFilterBinOp(FilterBinOp):\n342 |     def format(self):\n343 |         raise NotImplementedError(\"unable to collapse Joint Filters\")\n344 | \n345 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n346 |     def evaluate(self) -> Self:  # type: ignore[override]\n347 |         return self\n348 | \n349 | \n350 | class ConditionBinOp(BinOp):\n351 |     def __repr__(self) -> str:\n352 |         return pprint_thing(f\"[Condition : [{self.condition}]]\")\n353 | \n354 |     def invert(self):\n355 |         \"\"\"invert the condition\"\"\"\n356 |         # if self.condition is not None:\n357 |         #    self.condition = \"~(%s)\" % self.condition\n358 |         # return self\n359 |         raise NotImplementedError(\n360 |             \"cannot use an invert condition when passing to numexpr\"\n361 |         )\n362 | \n363 |     def format(self):\n364 |         \"\"\"return the actual ne format\"\"\"\n365 |         return self.condition\n366 | \n367 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n368 |     def evaluate(self) -> Self | None:  # type: ignore[override]\n369 |         if not self.is_valid:\n370 |             raise ValueError(f\"query term is not valid [{self}]\")\n371 | \n372 |         # convert values if we are in the