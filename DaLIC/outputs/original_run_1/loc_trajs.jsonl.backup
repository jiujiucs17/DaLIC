f decimals.\n2466 | \n2467 |         Parameters\n2468 |         ----------\n2469 |         decimals : int, default 0\n2470 |             Number of decimal places to round to. If decimals is negative,\n2471 |             it specifies the number of positions to the left of the decimal point.\n2472 |         *args, **kwargs\n2473 |             Additional arguments and keywords have no effect but might be\n2474 |             accepted for compatibility with NumPy.\n2475 | \n2476 |         Returns\n2477 |         -------\n2478 |         Series\n2479 |             Rounded values of the Series.\n2480 | \n2481 |         See Also\n2482 |         --------\n2483 |         numpy.around : Round values of an np.array.\n2484 |         DataFrame.round : Round values of a DataFrame.\n2485 | \n2486 |         Notes\n2487 |         -----\n2488 |         For values exactly halfway between rounded decimal values, pandas rounds\n2489 |         to the nearest even value (e.g. -0.5 and 0.5 round to 0.0, 1.5 and 2.5\n2490 |         round to 2.0, etc.).\n2491 | \n2492 |         Examples\n2493 |         --------\n2494 |         >>> s = pd.Series([-0.5, 0.1, 2.5, 1.3, 2.7])\n2495 |         >>> s.round()\n2496 |         0   -0.0\n2497 |         1    0.0\n2498 |         2    2.0\n2499 |         3    1.0\n2500 |         4    3.0\n2501 |         dtype: float64\n2502 |         \"\"\"\n2503 |         nv.validate_round(args, kwargs)\n2504 |         new_mgr = self._mgr.round(decimals=decimals)\n2505 |         return self._constructor_from_mgr(new_mgr, axes=new_mgr.axes).__finalize__(\n2506 |             self, method=\"round\"\n2507 |         )\n```\n\n\n\n##Searching for term \"Series dt round\"...\n### Search Result:\nFound function `pandas/core/frame.py:DataFrame.corr`.\nSource: Retrieved code content using keyword search (bm25).\n```\n10956 | def corr(\n10957 |         self,\n10958 |         method: CorrelationMethod = \"pearson\",\n10959 |         min_periods: int = 1,\n10960 |         numeric_only: bool = False,\n10961 |     ) -> DataFrame:\n10962 |         \"\"\"\n10963 |         Compute pairwise correlation of columns, excluding NA/null values.\n10964 | \n10965 |         Parameters\n10966 |         ----------\n10967 |         method : {'pearson', 'kendall', 'spearman'} or callable\n10968 |             Method of correlation:\n10969 | \n10970 |             * pearson : standard correlation coefficient\n10971 |             * kendall : Kendall Tau correlation coefficient\n10972 |             * spearman : Spearman rank correlation\n10973 |             * callable: callable with input two 1d ndarrays\n10974 |                 and returning a float. Note that the returned matrix from corr\n10975 |                 will have 1 along the diagonals and will be symmetric\n10976 |                 regardless of the callable's behavior.\n10977 |         min_periods : int, optional\n10978 |             Minimum number of observations required per pair of columns\n10979 |             to have a valid result. Currently only available for Pearson\n10980 |             and Spearman correlation.\n10981 |         numeric_only : bool, default False\n10982 |             Include only `float`, `int` or `boolean` data.\n10983 | \n10984 |             .. versionadded:: 1.5.0\n10985 | \n10986 |             .. versionchanged:: 2.0.0\n10987 |                 The default value of ``numeric_only`` is now ``False``.\n10988 | \n10989 |         Returns\n10990 |         -------\n10991 |         DataFrame\n10992 |             Correlation matrix.\n10993 | \n10994 |         See Also\n10995 |         --------\n10996 |         DataFrame.corrwith : Compute pairwise correlation with another\n10997 |             DataFrame or Series.\n10998 |         Series.corr : Compute the correlation between two Series.\n10999 | \n11000 |         Notes\n11001 |         -----\n11002 |         Pearson, Kendall and Spearman correlation are currently computed using pairwise complete observations.\n11003 | \n11004 |         * `Pearson correlation coefficient <https://en.wikipedia.org/wiki/Pearson_correlation_coefficient>`_\n11005 |         * `Kendall rank correlation coefficient <https://en.wikipedia.org/wiki/Kendall_rank_correlation_coefficient>`_\n11006 |         * `Spearman's rank correlation coefficient <https://en.wikipedia.org/wiki/Spearman%27s_rank_correlation_coefficient>`_\n11007 | \n11008 |         Examples\n11009 |         --------\n11010 |         >>> def histogram_intersection(a, b):\n11011 |         ...     v = np.minimum(a, b).sum().round(decimals=1)\n11012 |         ...     return v\n11013 |         >>> df = pd.DataFrame(\n11014 |         ...     [(0.2, 0.3), (0.0, 0.6), (0.6, 0.0), (0.2, 0.1)],\n11015 |         ...     columns=[\"dogs\", \"cats\"],\n11016 |         ... )\n11017 |         >>> df.corr(method=histogram_intersection)\n11018 |               dogs  cats\n11019 |         dogs   1.0   0.3\n11020 |         cats   0.3   1.0\n11021 | \n11022 |         >>> df = pd.DataFrame(\n11023 |         ...     [(1, 1), (2, np.nan), (np.nan, 3), (4, 4)], columns=[\"dogs\", \"cats\"]\n11024 |         ... )\n11025 |         >>> df.corr(min_periods=3)\n11026 |               dogs  cats\n11027 |         dogs   1.0   NaN\n11028 |         cats   NaN   1.0\n11029 |         \"\"\"  # noqa: E501\n11030 |         data = self._get_numeric_data() if numeric_only else self\n11031 |         cols = data.columns\n11032 |         idx = cols.copy()\n11033 |         mat = data.to_numpy(dtype=float, na_value=np.nan, copy=False)\n11034 | \n11035 |         if method == \"pearson\":\n11036 |             correl = libalgos.nancorr(mat, minp=min_periods)\n11037 |         elif method == \"spearman\":\n11038 |             correl = libalgos.nancorr_spearman(mat, minp=min_periods)\n11039 |         elif method == \"kendall\" or callable(method):\n11040 |             if min_periods is None:\n11041 |                 min_periods = 1\n11042 |             mat = mat.T\n11043 |             corrf = nanops.get_corr_func(method)\n11044 |             K = len(cols)\n11045 |             correl = np.empty((K, K), dtype=float)\n11046 |             mask = np.isfinite(mat)\n11047 |             for i, ac in enumerate(mat):\n11048 |                 for j, bc in enumerate(mat):\n11049 |                     if i > j:\n11050 |                         continue\n11051 | \n11052 |                     valid = mask[i] & mask[j]\n11053 |                     if valid.sum() < min_periods:\n11054 |                         c = np.nan\n11055 |                     elif i == j:\n11056 |                         c = 1.0\n11057 |                     elif not valid.all():\n11058 |                         c = corrf(ac[valid], bc[valid])\n11059 |                     else:\n11060 |                         c = corrf(ac, bc)\n11061 |                     correl[i, j] = c\n11062 |                     correl[j, i] = c\n11063 |         else:\n11064 |             raise ValueError(\n11065 |                 \"method must be either 'pearson', \"\n11066 |                 \"'spearman', 'kendall', or a callable, \"\n11067 |                 f\"'{method}' was supplied\"\n11068 |             )\n11069 | \n11070 |         result = self._constructor(correl, index=idx, columns=cols, copy=False)\n11071 |         return result.__finalize__(self, method=\"corr\")\n```\n\nFound class `asv_bench/benchmarks/frame_methods.py:Round`.\nSource: Retrieved entity using keyword search (bm25).\n```\n807 | class Round:\n808 |     def setup(self):\n809 |         self.df = DataFrame(np.random.randn(10000, 10))\n810 |         self.df_t = self.df.transpose(copy=True)\n811 | \n812 |     def time_round(self):\n813 |         self.df.round()\n814 | \n815 |     def time_round_transposed(self):\n816 |         self.df_t.round()\n817 | \n818 |     def peakmem_round(self):\n819 |         self.df.round()\n820 | \n821 |     def peakmem_round_transposed(self):\n822 |         self.df_t.round()\n```\n\nFound function `pandas/core/arrays/arrow/array.py:ArrowExtensi