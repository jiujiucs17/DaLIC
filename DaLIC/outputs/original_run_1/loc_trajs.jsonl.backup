uracy, times, solver, dtype in zip(\n306 |             group[\"accuracies\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n307 |         ):\n308 |             ax.plot(\n309 |                 times,\n310 |                 accuracy,\n311 |                 label=\"%s - %s\" % (solver, dtype),\n312 |                 alpha=alpha[dtype],\n313 |                 marker=\".\",\n314 |                 color=colors[solver],\n315 |                 linestyle=linestyles[dtype],\n316 |             )\n317 |             ax.axvline(\n318 |                 times[-1],\n319 |                 color=colors[solver],\n320 |                 alpha=alpha[dtype],\n321 |                 linestyle=linestyles[dtype],\n322 |             )\n323 | \n324 |         ax.set_xlabel(\"Time (s)\")\n325 |         ax.set_ylabel(\"Test accuracy\")\n326 |         ax.legend()\n327 |         name = \"single_target\" if single_target else \"multi_target\"\n328 |         name += \"_%s\" % penalty\n329 |         plt.suptitle(name)\n330 |         if outname is None:\n331 |             outname = name + \".png\"\n332 |         fig.tight_layout()\n333 |         fig.subplots_adjust(top=0.9)\n334 | \n335 |         ax = axes[3]\n336 |         for scores, times, solver, dtype in zip(\n337 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n338 |         ):\n339 |             ax.plot(\n340 |                 np.arange(len(scores)),\n341 |                 scores,\n342 |                 label=\"%s - %s\" % (solver, dtype),\n343 |                 marker=\".\",\n344 |                 alpha=alpha[dtype],\n345 |                 color=colors[solver],\n346 |                 linestyle=linestyles[dtype],\n347 |             )\n348 | \n349 |         ax.set_yscale(\"log\")\n350 |         ax.set_xlabel(\"# iterations\")\n351 |         ax.set_ylabel(\"Objective function\")\n352 |         ax.legend()\n353 | \n354 |         plt.savefig(outname)\n```\n\nFound function `benchmarks/bench_plot_parallel_pairwise.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n12 | def plot(func):\n13 |     random_state = check_random_state(0)\n14 |     one_core = []\n15 |     multi_core = []\n16 |     sample_sizes = range(1000, 6000, 1000)\n17 | \n18 |     for n_samples in sample_sizes:\n19 |         X = random_state.rand(n_samples, 300)\n20 | \n21 |         start = time.time()\n22 |         func(X, n_jobs=1)\n23 |         one_core.append(time.time() - start)\n24 | \n25 |         start = time.time()\n26 |         func(X, n_jobs=-1)\n27 |         multi_core.append(time.time() - start)\n28 | \n29 |     plt.figure(\"scikit-learn parallel %s benchmark results\" % func.__name__)\n30 |     plt.plot(sample_sizes, one_core, label=\"one core\")\n31 |     plt.plot(sample_sizes, multi_core, label=\"multi core\")\n32 |     plt.xlabel(\"n_samples\")\n33 |     plt.ylabel(\"Time (s)\")\n34 |     plt.title(\"Parallel %s\" % func.__name__)\n35 |     plt.legend()\n```\n\nFound function `sklearn/calibration.py:_fit_calibrator`.\nSource: Retrieved entity using keyword search (bm25).\n```\n569 | def _fit_calibrator(clf, predictions, y, classes, method, sample_weight=None):\n570 |     \"\"\"Fit calibrator(s) and return a `_CalibratedClassifier`\n571 |     instance.\n572 | \n573 |     `n_classes` (i.e. `len(clf.classes_)`) calibrators are fitted.\n574 |     However, if `n_classes` equals 2, one calibrator is fitted.\n575 | \n576 |     Parameters\n577 |     ----------\n578 |     clf : estimator instance\n579 |         Fitted classifier.\n580 | \n581 |     predictions : array-like, shape (n_samples, n_classes) or (n_samples, 1) \\\n582 |                     when binary.\n583 |         Raw predictions returned by the un-calibrated base classifier.\n584 | \n585 |     y : array-like, shape (n_samples,)\n586 |         The targets.\n587 | \n588 |     classes : ndarray, shape (n_classes,)\n589 |         All the prediction classes.\n590 | \n591 |     method : {'sigmoid', 'isotonic'}\n592 |         The method to use for calibration.\n593 | \n594 |     sample_weight : ndarray, shape (n_samples,), default=None\n595 |         Sample weights. If None, then samples are equally weighted.\n596 | \n597 |     Returns\n598 |     -------\n599 |     pipeline : _CalibratedClassifier instance\n600 |     \"\"\"\n601 |     Y = label_binarize(y, classes=classes)\n602 |     label_encoder = LabelEncoder().fit(classes)\n603 |     pos_class_indices = label_encoder.transform(clf.classes_)\n604 |     calibrators = []\n605 |     for class_idx, this_pred in zip(pos_class_indices, predictions.T):\n606 |         if method == \"isotonic\":\n607 |             calibrator = IsotonicRegression(out_of_bounds=\"clip\")\n608 |         elif method == \"sigmoid\":\n609 |             calibrator = _SigmoidCalibration()\n610 |         else:\n611 |             raise ValueError(\n612 |                 f\"'method' should be one of: 'sigmoid' or 'isotonic'. Got {method}.\"\n613 |             )\n614 |         calibrator.fit(this_pred, Y[:, class_idx], sample_weight)\n615 |         calibrators.append(calibrator)\n616 | \n617 |     pipeline = _CalibratedClassifier(clf, calibrators, method=method, classes=classes)\n618 |     return pipeline\n```\n\nFound class `sklearn/calibration.py:_CalibratedClassifier`.\nSource: Retrieved code content using keyword search (bm25).\n```\n621 | class _CalibratedClassifier:\n622 |     \"\"\"Pipeline-like chaining a fitted classifier and its fitted calibrators.\n623 | \n624 |     Parameters\n625 |     ----------\n626 |     base_estimator : estimator instance\n627 |         Fitted classifier.\n628 | \n629 |     calibrators : list of fitted estimator instances\n630 |         List of fitted calibrators (either 'IsotonicRegression' or\n631 |         '_SigmoidCalibration'). The number of calibrators equals the number of\n632 |         classes. However, if there are 2 classes, the list contains only one\n633 |         fitted calibrator.\n634 | \n635 |     classes : array-like of shape (n_classes,)\n636 |         All the prediction classes.\n637 | \n638 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n639 |         The method to use for calibration. Can be 'sigmoid' which\n640 |         corresponds to Platt's method or 'isotonic' which is a\n641 |         non-parametric approach based on isotonic regression.\n642 | \n643 |     Attributes\n644 |     ----------\n645 |     calibrators_ : list of fitted estimator instances\n646 |         Same as `calibrators`. Exposed for backward-compatibility. Use\n647 |         `calibrators` instead.\n648 | \n649 |         .. deprecated:: 0.24\n650 |            `calibrators_` is deprecated from 0.24 and will be removed in\n651 |            1.1 (renaming of 0.26). Use `calibrators` instead.\n652 |     \"\"\"\n653 | \n654 |     def __init__(self, base_estimator, calibrators, *, classes, method=\"sigmoid\"):\n655 |         self.base_estimator = base_estimator\n656 |         self.calibrators = calibrators\n657 |         self.classes = classes\n658 |         self.method = method\n659 | \n660 |     # TODO: Remove in 1.1\n661 |     # mypy error: Decorated property not supported\n662 |     @deprecated(  # type: ignore\n663 |         \"`calibrators_` is deprecated in 0.24 and will be removed in 1.1\"\n664 |         \"(renaming of 0.26). Use `calibrators` instead.\"\n665 |     )\n666 |     @property\n667 |     def calibrators_(self):\n668 |         return self.calibrators\n669 | \n670 |     def predict_proba(self, X):\n671 |         \"\"\"Calculate calibrated probabilities.\n672 | \n673 |         Calculates classification calibrated probabilities\n674 |         for each class, in a one-vs-all manner, for `X`.\n675 | \n676 |         Parameters\n677 |         ----------\n678 |         X : ndarray of shape (n_samples, n_features)\n679 |             The sample data.\n680 | \n681 |         Returns\n682 |         -------\n683 |         proba : array, shape (n_samples, n_classes)\n684 |             The predicted probabilities. Can be exact zeros.\n685 |         \"\"\"\n686 |         n_classes = len(self.classes)\n687 |         pred_method, method_name = _get_prediction_method(self.base_estimator)\n688 |         predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n689 | \n690 |         label_encoder = LabelEncoder().fit(self.classes)\n691 |         pos_class_indices = label_encoder.transform(self.base_estimator.classes_)\n692 | \n693 |         proba = np.zeros((_num_samples(X), n_classes))\n694 |         for class_idx, this_pred, calibrator in zip(\n695 |             pos_class_indices, predictions.T, self.calibrators\n696 |         ):\n697 |             if n_classes == 2:\n698 |                 # When binary, `predictions` consists only of predictions for\n699 |                 # clf.classes_[1] but `pos_class_indices` = 0\n700 |                 class_idx += 1\n701 |             proba[:, class_idx] = calibrator.predict(this_pred)\n702 | \n703 |         # Normalize the probabilities\n704 |         if n_classes == 2:\n705 |             proba[:, 0] = 1.0 - proba[:, 1]\n706 |         else:\n707 |             denominator = np.sum(proba, axis=1)[:, np.newaxis]\n708 |             # In the edge case where for each class calibrator returns a null\n709 |             # probability for a given sample, use the uniform distribution\n710 |             # instead.\n711 |             uniform_proba = np.full_like(proba, 1 / n_classes)\n712 |             proba = np.divide(\n713 |                 proba, denominator, out=uniform_proba, where=denominator != 0\n714 |             )\n715 | \n716 |         # Deal with cases where the predicted probability minimally exceeds 1.0\n717 |         proba[(1.0 < proba) & (proba <= 1.0 + 1e-5)] = 1.0\n718 | \n719 |         return proba\n```\n\nFound function `examples/calibration/plot_calibration_curve.py:plot_calibration_curve`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 72 | def plot_calibration_curve(est, name, fig_index):\n 73 |     \"\"\"Plot calibration curve for est w/o and with calibration. \"\"\"\n 74 |     # Calibrated with isotonic calibration\n 75 |     isotonic = CalibratedClassifierCV(est, cv=2, method='isotonic')\n 76 | \n 77 |     # Calibrated with sigmoid calibration\n 78 |     sigmoid = CalibratedClassifierCV(est, cv=2, method='sigmoid')\n 79 | \n 80 |     # Logistic regression with no calibration as baseline\n 81 |     lr = LogisticRegression(C=1.)\n 82 | \n 83 |     fig = plt.figure(fig_index, figsize=(10, 10))\n 84 |     ax1 = plt.subplot2grid((3, 1), (0, 0), rowspan=2, fig=fig)\n 85 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\nFound file `sklearn/calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/calibration.py` for the full content if needed.\n"}, {"content": "Let me also check the metrics module since it seems to contain visualization-related functionality:\n\n<function=search_code_snippets>\n<parameter=search_terms>['metrics', 'plot']</parameter>\n<parameter=file_path_or_pattern>sklearn/metrics/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"metrics\"...\n### Search Result:\nFound file `asv_benchmarks/benchmarks/metrics.py`.\nSource: Match found for entity name `metrics`.\n```\n 1 | from sklearn.metrics.pairwise import pairwise_distances\n 2 | \n 3 | from .common import Benchmark\n 4 | from .datasets import _random_dataset\n 5 | \n 6 | \n 7 | class PairwiseDistancesBenchmark(Benchmark):\n 8 |     \"\"\"\n 9 |     Benchmarks for pairwise distances.\n10 |     \"\"\"\n11 | \n12 |     param_names = [\"representation\", \"metric\", \"n_jobs\"]\n13 |     params = (\n14 |         [\"dense\", \"sparse\"],\n15 |         [\"cosine\", \"euclidean\", \"manhattan\", \"correlation\"],\n16 |         Benchmark.n_jobs_vals,\n17 |     )\n18 | \n19 |     def setup(self, *params):\n20 |         representation, metric, n_jobs = params\n21 | \n22 |         if representation == \"sparse\" and metric == \"correlation\":\n23 |             raise NotImplementedError\n24 | \n25 |         if Benchmark.data_size == \"large\":\n26 |             if metric in (\"manhattan\", \"correlation\"):\n27 |                 n_samples = 8000\n28 |             else:\n29 |                 n_samples = 24000\n30 |         else:\n31 |             if metric in (\"manhattan\", \"correlation\"):\n32 |                 n_samples = 4000\n33 |             else:\n34 |                 n_samples = 12000\n35 | \n36 |         data = _random_dataset(n_samples=n_samples, representation=representation)\n37 |         self.X, self.X_val, self.y, self.y_val = data\n38 | \n39 |         self.pdist_params = {\"metric\": metric, \"n_jobs\": n_jobs}\n40 | \n41 |     def time_pairwise_distances(self, *args):\n42 |         pairwise_distances(self.X, **self.pdist_params)\n43 | \n44 |     def peakmem_pairwise_distances(self, *args):\n45 |         pairwise_distances(self.X, **self.pdist_params)\n46 | \n```\n\n\n\n##Searching for term \"plot\"...\n### Search Result:\nFound function `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay.plot`.\nFound function `sklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay.plot`.\nFound function `sklearn/metrics/_plot/roc_curve.py:RocCurveDisplay.plot`.\nFound function `sklearn/metrics/_plot/confusion_matrix.py:ConfusionMatrixDisplay.plot`.\nSource: Match found for entity name `plot`.\nHint: Use more detailed query to get the full content of some if needed.\n"}, {"content": "Let me check the calibration module more specifically:\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/calibration.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `sklearn/calibration.py`...\n### Search Result:\nFound file `sklearn/calibration.py`.\nSource: Exact match found for entity name `sklearn/calibration.py`.\n```\n  1 | \"\"\"Calibration of predicted probabilities.\"\"\"\n  2 | \n  3 | # Author: Alexandre Gramfort <alexandre.gramfort@telecom-paristech.fr>\n  4 | #         Balazs Kegl <balazs.kegl@gmail.com>\n  5 | #         Jan Hendrik Metzen <jhm@informatik.uni-bremen.de>\n  6 | #         Mathieu Blondel <mathieu@mblondel.org>\n  7 | #\n  8 | # License: BSD 3 clause\n  9 | \n 10 | import warnings\n 11 | from inspect import signature\n 12 | from functools import partial\n 13 | \n 14 | from math import log\n 15 | import numpy as np\n 16 | from joblib import Parallel\n 17 | \n 18 | from scipy.special import expit\n 19 | from scipy.special import xlogy\n 20 | from scipy.optimize import fmin_bfgs\n 21 | \n 22 | from .base import (\n 23 |     BaseEstimator,\n 24 |     ClassifierMixin,\n 25 |     RegressorMixin,\n 26 |     clone,\n 27 |     MetaEstimatorMixin,\n 28 | )\n 29 | from .preprocessing import label_binarize, LabelEncoder\n 30 | from .utils import (\n 31 |     column_or_1d,\n 32 |     deprecated,\n 33 |     indexable,\n 34 | )\n 35 | \n 36 | from .utils.multiclass import check_classification_targets\n 37 | from .utils.fixes import delayed\n 38 | from .utils.validation import check_is_fitted, check_consistent_length\n 39 | from .utils.validation import _check_sample_weight, _num_samples\n 40 | from .utils import _safe_indexing\n 41 | from .isotonic import IsotonicRegression\n 42 | from .svm import LinearSVC\n 43 | from .model_selection import check_cv, cross_val_predict\n 44 | \n 45 | \n 46 | class CalibratedClassifierCV(ClassifierMixin, MetaEstimatorMixin, BaseEstimator):\n 47 |     \"\"\"Probability calibration with isotonic regression or logistic regression.\n 48 | \n 49 |     This class uses cross-validation to both estimate the parameters of a\n 50 |     classifier and subsequently calibrate a classifier. With default\n 51 |     `ensemble=True`, for each cv split it\n 52 |     fits a copy of the base estimator to the training subset, and calibrates it\n 53 |     using the testing subset. For prediction, predicted probabilities are\n 54 |     averaged across these individual calibrated classifiers. When\n 55 |     `ensemble=False`, cross-validation is used to obtain unbiased predictions,\n 56 |     via :func:`~sklearn.model_selection.cross_val_predict`, which are then\n 57 |     used for calibration. For prediction, the base estimator, trained using all\n 58 |     the data, is used. This is the method implemented when `probabilities=True`\n 59 |     for :mod:`sklearn.svm` estimators.\n 60 | \n 61 |     Already fitted classifiers can be calibrated via the parameter\n 62 |     `cv=\"prefit\"`. In this case, no cross-validation is used and all provided\n 63 |     data is used for calibration. The user has to take care manually that data\n 64 |     for model fitting and calibration are disjoint.\n 65 | \n 66 |     The calibration is based on the :term:`decision_function` method of the\n 67 |     `base_estimator` if it exists, else on :term:`predict_proba`.\n 68 | \n 69 |     Read more in the :ref:`User Guide <calibration>`.\n 70 | \n 71 |     Parameters\n 72 |     ----------\n 73 |     base_estimator : estimator instance, default=None\n 74 |         The classifier whose output need to be calibrated to provide more\n 75 |         accurate `predict_proba` outputs. The default classifier is\n 76 |         a :class:`~sklearn.svm.LinearSVC`.\n 77 | \n 78 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n 79 |         The method to use for calibration. Can be 'sigmoid' which\n 80 |         corresponds to Platt's method (i.e. a logistic regression model) or\n 81 |         'isotonic' which is a non-parametric approach. It is not advised to\n 82 |         use isotonic calibration with too few calibration samples\n 83 |         ``(<<1000)`` since it tends to overfit.\n 84 | \n 85 |     cv : int, cross-validation generator, iterable or \"prefit\", \\\n 86 |             default=None\n 87 |         Determines the cross-validation splitting strategy.\n 88 |         Possible inputs for cv are:\n 89 | \n 90 |         - None, to use the default 5-fold cross-validation,\n 91 |         - integer, to specify the number of folds.\n 92 |         - :term:`CV splitter`,\n 93 |         - An iterable yielding (train, test) splits as arrays of indices.\n 94 | \n 95 |         For integer/None inputs, if ``y`` is binary or multiclass,\n 96 |         :class:`~sklearn.model_selection.StratifiedKFold` is used. If ``y`` is\n 97 |         neither binary nor multiclass, :class:`~sklearn.model_selection.KFold`\n 98 |         is used.\n 99 | \n100 |         Refer to the :ref:`User Guide <cross_validation>` for the various\n101 |         cross-validation strategies that can be used here.\n102 | \n103 |         If \"prefit\" is passed, it is assumed that `base_estimator` has been\n104 |         fitted already and all data is used for calibration.\n105 | \n106 |         .. versionchanged:: 0.22\n107 |             ``cv`` default value if None changed from 3-fold to 5-fold.\n108 | \n109 |     n_jobs : int, default=None\n110 |         Number of jobs to run in parallel.\n111 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n112 |         ``-1`` means using all processors.\n113 | \n114 |         Base estimator clones are fitted in parallel across cross-validation\n115 |         iterations. Therefore parallelism happens only when `cv != \"prefit\"`.\n116 | \n117 |         See :term:`Glossary <n_jobs>` for more details.\n118 | \n119 |         .. versionadded:: 0.24\n120 | \n121 |     ensemble : bool, default=True\n122 |         Determines how the calibrator is fitted when `cv` is not `'prefit'`.\n123 |         Ignored if `cv='prefit'`.\n124 | \n125 |         If `True`, the `base_estimator` is fitted using training data and\n126 |         calibrated using testing data, for each `cv` fold. The final estimator\n127 |         is an ensemble of `n_cv` fitted classifer and calibrator pairs, where\n128 |         `n_cv` is the number of cross-validation folds. The output is the\n129 |         average predicted probabilities of all pairs.\n130 | \n131 |         If `False`, `cv` is used to compute unbiased predictions, via\n132 |         :func:`~sklearn.model_selection.cross_val_predict`, which are then\n133 |         used for calibration. At prediction time, the classifier used is the\n134 |         `base_estimator` trained on all the data.\n135 |         Note that this method is also internally implemented  in\n136 |         :mod:`sklearn.svm` estimators with the `probabilities=True` parameter.\n137 | \n138 |         .. versionadded:: 0.24\n139 | \n140 |     Attributes\n141 |     ----------\n142 |     classes_ : ndarray of shape (n_classes,)\n143 |         The class labels.\n144 | \n145 |     n_features_in_ : int\n146 |         Number of features seen during :term:`fit`. Only defined if the\n147 |         underlying base_estimator exposes such an attribute when fit.\n148 | \n149 |         .. versionadded:: 0.24\n150 | \n151 |     feature_names_in_ : ndarray of shape (`n_features_in_`,)\n152 |         Names of features seen during :term:`fit`. Only defined if the\n153 |         underlying base_estimator exposes such an attribute when fit.\n154 | \n155 |         .. versionadded:: 1.0\n156 | \n157 |     calibrated_classifiers_ : list (len() equal to cv or 1 if `cv=\"prefit\"` \\\n158 |             or `ensemble=False`)\n159 |         The list of classifier and calibrator pairs.\n160 | \n161 |         - When `cv=\"prefit\"`, the fitted `base_estimator` and fitted\n162 |           calibrator.\n163 |         - When `cv` is not \"prefit\" and `ensemble=True`, `n_cv` fitted\n164 |           `base_estimator` and calibrator pairs. `n_cv` is the number of\n165 |           cross-validation folds.\n166 |         - When `cv` is not \"prefit\" and `ensemble=False`, the `base_estimator`,\n167 |           fitted on all the data, and fitted calibrator.\n168 | \n169 |         .. versionchanged:: 0.24\n170 |             Single calibrated classifier case when `ensemble=False`.\n171 | \n172 |     Examples\n173 |     --------\n174 |     >>> from sklearn.datasets import make_classification\n175 |     >>> from sklearn.naive_bayes import GaussianNB\n176 |     >>> from sklearn.calibration import CalibratedClassifierCV\n177 |     >>> X, y = make_classification(n_samples=100, n_features=2,\n178 |     ...                            n_redundant=0, random_state=42)\n179 |     >>> base_clf = GaussianNB()\n180 |     >>> calibrated_clf = CalibratedClassifierCV(base_estimator=base_clf, cv=3)\n181 |     >>> calibrated_clf.fit(X, y)\n182 |     CalibratedClassifierCV(base_estimator=GaussianNB(), cv=3)\n183 |     >>> len(calibrated_clf.calibrated_classifiers_)\n184 |     3\n185 |     >>> calibrated_clf.predict_proba(X)[:5, :]\n186 |     array([[0.110..., 0.889...],\n187 |            [0.072..., 0.927...],\n188 |            [0.928..., 0.071...],\n189 |            [0.928..., 0.071...],\n190 |            [0.071..., 0.928...]])\n191 | \n192 |     >>> from sklearn.model_selection import train_test_split\n193 |     >>> X, y = make_classification(n_samples=100, n_features=2,\n194 |     ...                            n_redundant=0, random_state=42)\n195 |     >>> X_train, X_calib, y_train, y_calib = train_test_split(\n196 |     ...        X, y, random_state=42\n197 |     ... )\n198 |     >>> base_clf = GaussianNB()\n199 |     >>> base_clf.fit(X_train, y_train)\n200 |     GaussianNB()\n201 |     >>> calibrated_clf = CalibratedClassifierCV(\n202 |     ...     base_estimator=base_clf,\n203 |     ...     cv=\"prefit\"\n204 |     ... )\n205 |     >>> calibrated_clf.fit(X_calib, y_calib)\n206 |     CalibratedClassifierCV(base_estimator=GaussianNB(), cv='prefit')\n207 |     >>> len(calibrated_clf.calibrated_classifiers_)\n208 |     1\n209 |     >>> calibrated_clf.predict_proba([[-0.5, 0.5]])\n210 |     array([[0.936..., 0.063...]])\n211 | \n212 |     References\n213 |     ----------\n214 |     .. [1] Obtaining calibrated probability estimates from decision trees\n215 |            and naive Bayesian classifiers, B. Zadrozny & C. Elkan, ICML 2001\n216 | \n217 |     .. [2] Transforming Classifier Scores into Accurate Multiclass\n218 |            Probability Estimates, B. Zadrozny & C. Elkan, (KDD 2002)\n219 | \n220 |     .. [3] Probabilistic Outputs for Support Vector Machines and Comparisons to\n221 |            Regularized Likelihood Methods, J. Platt, (1999)\n222 | \n223 |     .. [4] Predicting Good Probabilities with Supervised Learning,\n224 |            A. Niculescu-Mizil & R. Caruana, ICML 2005\n225 |     \"\"\"\n226 | \n227 |     def __init__(\n228 |         self,\n229 |         base_estimator=None,\n230 |         *,\n231 |         method=\"sigmoid\",\n232 |         cv=None,\n233 |         n_jobs=None,\n234 |         ensemble=True,\n235 |     ):\n236 |         self.base_estimator = base_estimator\n237 |         self.method = method\n238 |         self.cv = cv\n239 |         self.n_jobs = n_jobs\n240 |         self.ensemble = ensemble\n241 | \n242 |     def fit(self, X, y, sample_weight=None):\n243 |         \"\"\"Fit the calibrated model.\n244 | \n245 |         Parameters\n246 |         ----------\n247 |         X : array-like of shape (n_samples, n_features)\n248 |             Training data.\n249 | \n250 |         y : array-like of shape (n_samples,)\n251 |             Target values.\n252 | \n253 |         sample_weight : array-like of shape (n_samples,), default=None\n254 |             Sample weights. If None, then samples are equally weighted.\n255 | \n256 |         Returns\n257 |         -------\n258 |         self : object\n259 |             Returns an instance of self.\n260 |         \"\"\"\n261 |         check_classification_targets(y)\n262 |         X, y = indexable(X, y)\n263 | \n264 |         if self.base_estimator is None:\n265 |             # we want all classifiers that don't expose a random_state\n266 |             # to be deterministic (and we don't want to expose this one).\n267 |             base_estimator = LinearSVC(random_state=0)\n268 |         else:\n269 |             base_estimator = self.base_estimator\n270 | \n271 |         self.calibrated_classifiers_ = []\n272 |         if self.cv == \"prefit\":\n273 |             # `classes_` should be consistent with that of base_estimator\n274 |             check_is_fitted(self.base_estimator, attributes=[\"classes_\"])\n275 |             self.classes_ = self.base_estimator.classes_\n276 | \n277 |             pred_method, method_name = _get_prediction_method(base_estimator)\n278 |             n_classes = len(self.classes_)\n279 |             predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n280 | \n281 |             calibrated_classifier = _fit_calibrator(\n282 |                 base_estimator,\n283 |                 predictions,\n284 |                 y,\n285 |                 self.classes_,\n286 |                 self.method,\n287 |                 sample_weight,\n288 |             )\n289 |             self.calibrated_classifiers_.append(calibrated_classifier)\n290 |         else:\n291 |             # Set `classes_` using all `y`\n292 |             label_encoder_ = LabelEncoder().fit(y)\n293 |             self.classes_ = label_encoder_.classes_\n294 |             n_classes = len(self.classes_)\n295 | \n296 |             # sample_weight checks\n297 |             fit_parameters = signature(base_estimator.fit).parameters\n298 |             supports_sw = \"sample_weight\" in fit_parameters\n299 |             if sample_weight is not None:\n300 |                 sample_weight = _check_sample_weight(sample_weight, X)\n301 |                 if not supports_sw:\n302 |                     estimator_name = type(base_estimator).__name__\n303 |                     warnings.warn(\n304 |                         f\"Since {estimator_name} does not support \"\n305 |                         \"sample_weights, sample weights will only be\"\n306 |                         \" used for the calibration itself.\"\n307 |                     )\n308 | \n309 |             # Check that each cross-validation fold can have at least one\n310 |             # example per class\n311 |             if isinstance(self.cv, int):\n312 |                 n_folds = self.cv\n313 |             elif hasattr(self.cv, \"n_splits\"):\n314 |                 n_folds = self.cv.n_splits\n315 |             else:\n316 |                 n_folds = None\n317 |             if n_folds and np.any(\n318 |                 [np.sum(y == class_) < n_folds for class_ in self.classes_]\n319 |             ):\n320 |                 raise ValueError(\n321 |                     f\"Requesting {n_folds}-fold \"\n322 |                     \"cross-validation but provided less than \"\n323 |                     f\"{n_folds} examples for at least one class.\"\n324 |                 )\n325 |             cv = check_cv(self.cv, y, classifier=True)\n326 | \n327 |             if self.ensemble:\n328 |                 parallel = Parallel(n_jobs=self.n_jobs)\n329 | \n330 |                 self.calibrated_classifiers_ = parallel(\n331 |                     delayed(_fit_classifier_calibrator_pair)(\n332 |                         clone(base_estimator),\n333 |                         X,\n334 |                         y,\n335 |                         train=train,\n336 |                         test=test,\n337 |                         method=self.method,\n338 |                         classes=self.classes_,\n339 |                         supports_sw=supports_sw,\n340 |                         sample_weight=sample_weight,\n341 |                     )\n342 |                     for train, test in cv.split(X, y)\n343 |                 )\n344 |             else:\n345 |                 this_estimator = clone(base_estimator)\n346 |                 _, method_name = _get_prediction_method(this_estimator)\n347 |                 pred_method = partial(\n348 |                     cross_val_predict,\n349 |                     estimator=this_estimator,\n350 |                     X=X,\n351 |                     y=y,\n352 |                     cv=cv,\n353 |                     method=method_name,\n354 |                     n_jobs=self.n_jobs,\n355 |                 )\n356 |                 predictions = _compute_predictions(\n357 |                     pred_method, method_name, X, n_classes\n358 |                 )\n359 | \n360 |                 if sample_weight is not None and supports_sw:\n361 |                     this_estimator.fit(X, y, sample_weight)\n362 |                 else:\n363 |                     this_estimator.fit(X, y)\n364 |                 calibrated_classifier = _fit_calibrator(\n365 |                     this_estimator,\n366 |                     predictions,\n367 |                     y,\n368 |                     self.classes_,\n369 |                     self.method,\n370 |                     sample_weight,\n371 |                 )\n372 |                 self.calibrated_classifiers_.append(calibrated_classifier)\n373 | \n374 |         first_clf = self.calibrated_classifiers_[0].base_estimator\n375 |         if hasattr(first_clf, \"n_features_in_\"):\n376 |             self.n_features_in_ = first_clf.n_features_in_\n377 |         if hasattr(first_clf, \"feature_names_in_\"):\n378 |             self.feature_names_in_ = first_clf.feature_names_in_\n379 |         return self\n380 | \n381 |     def predict_proba(self, X):\n382 |         \"\"\"Calibrated probabilities of classification.\n383 | \n384 |         This function returns calibrated probabilities of classification\n385 |         according to each class on an array of test vectors X.\n386 | \n387 |         Parameters\n388 |         ----------\n389 |         X : The samples, as accepted by base_estimator.predict_proba\n390 | \n391 |         Returns\n392 |         -------\n393 |         C : ndarray of shape (n_samples, n_classes)\n394 |             The predicted probas.\n395 |         \"\"\"\n396 |         check_is_fitted(self)\n397 |         # Compute the arithmetic mean of the predictions of the calibrated\n398 |         # classifiers\n399 |         mean_proba = np.zeros((_num_samples(X), len(self.classes_)))\n400 |         for calibrated_classifier in self.calibrated_classifiers_:\n401 |             proba = calibrated_classifier.predict_proba(X)\n402 |             mean_proba += proba\n403 | \n404 |         mean_proba /= len(self.calibrated_classifiers_)\n405 | \n406 |         return mean_proba\n407 | \n408 |     def predict(self, X):\n409 |         \"\"\"Predict the target of new samples. The predicted class is the\n410 |         class that has the highest probability, and can thus be different\n411 |         from the prediction of the uncalibrated classifier.\n412 | \n413 |         Parameters\n414 |         ----------\n415 |         X : The samples, as accepted by base_estimator.predict\n416 | \n417 |         Returns\n418 |         -------\n419 |         C : ndarray of shape (n_samples,)\n420 |             The predicted class.\n421 |         \"\"\"\n422 |         check_is_fitted(self)\n423 |         return self.classes_[np.argmax(self.predict_proba(X), axis=1)]\n424 | \n425 |     def _more_tags(self):\n426 |         return {\n427 |             \"_xfail_checks\": {\n428 |                 \"check_sample_weights_invariance\": (\n429 |                     \"zero sample_weight is not equivalent to removing samples\"\n430 |                 ),\n431 |             }\n432 |         }\n433 | \n434 | \n435 | def _fit_classifier_calibrator_pair(\n436 |     estimator, X, y, train, test, supports_sw, method, classes, sample_weight=None\n437 | ):\n438 |     \"\"\"Fit a classifier/calibration pair on a given train/test split.\n439 | \n440 |     Fit the classifier on the train set, compute its predictions on the test\n441 |     set and use the predictions as input to fit the calibrator along with the\n442 |     test labels.\n443 | \n444 |     Parameters\n445 |     ----------\n446 |     estimator : estimator instance\n447 |         Cloned base estimator.\n448 | \n449 |     X : array-like, shape (n_samples, n_features)\n450 |         Sample data.\n451 | \n452 |     y : array-like, shape (n_samples,)\n453 |         Targets.\n454 | \n455 |     train : ndarray, shape (n_train_indicies,)\n456 |         Indices of the training subset.\n457 | \n458 |     test : ndarray, shape (n_test_indicies,)\n459 |         Indices of the testing subset.\n460 | \n461 |     supports_sw : bool\n462 |         Whether or not the `estimator` supports sample weights.\n463 | \n464 |     method : {'sigmoid', 'isotonic'}\n465 |         Method to use for calibration.\n466 | \n467 |     classes : ndarray, shape (n_classes,)\n468 |         The target classes.\n469 | \n470 |     sample_weight : array-like, default=None\n471 |         Sample weights for `X`.\n472 | \n473 |     Returns\n474 |     -------\n475 |     calibrated_classifier : _CalibratedClassifier instance\n476 |     \"\"\"\n477 |     X_train, y_train = _safe_indexing(X, train), _safe_indexing(y, train)\n478 |     X_test, y_test = _safe_indexing(X, test), _safe_indexing(y, test)\n479 |     if supports_sw and sample_weight is not None:\n480 |         sw_train = _safe_indexing(sample_weight, train)\n481 |         sw_test = _safe_indexing(sample_weight, test)\n482 |     else:\n483 |         sw_train = None\n484 |         sw_test = None\n485 | \n486 |     if supports_sw:\n487 |         estimator.fit(X_train, y_train, sample_weight=sw_train)\n488 |     else:\n489 |         estimator.fit(X_train, y_train)\n490 | \n491 |     n_classes = len(classes)\n492 |     pred_method, method_name = _get_prediction_method(estimator)\n493 |     predictions = _compute_predictions(pred_method, method_name, X_test, n_classes)\n494 | \n495 |     calibrated_classifier = _fit_calibrator(\n496 |         estimator, predictions, y_test, classes, method, sample_weight=sw_test\n497 |     )\n498 |     return calibrated_classifier\n499 | \n500 | \n501 | def _get_prediction_method(clf):\n502 |     \"\"\"Return prediction method.\n503 | \n504 |     `decision_function` method of `clf` returned, if it\n505 |     exists, otherwise `predict_proba` method returned.\n506 | \n507 |     Parameters\n508 |     ----------\n509 |     clf : Estimator instance\n510 |         Fitted classifier to obtain the prediction method from.\n511 | \n512 |     Returns\n513 |     -------\n514 |     prediction_method : callable\n515 |         The prediction method.\n516 |     method_name : str\n517 |         The name of the prediction method.\n518 |     \"\"\"\n519 |     if hasattr(clf, \"decision_function\"):\n520 |         method = getattr(clf, \"decision_function\")\n521 |         return method, \"decision_function\"\n522 |     elif hasattr(clf, \"predict_proba\"):\n523 |         method = getattr(clf, \"predict_proba\")\n524 |         return method, \"predict_proba\"\n525 |     else:\n526 |         raise RuntimeError(\n527 |             \"'base_estimator' has no 'decision_function' or 'predict_proba' method.\"\n528 |         )\n529 | \n530 | \n531 | def _compute_predictions(pred_method, method_name, X, n_classes):\n532 |     \"\"\"Return predictions for `X` and reshape binary outputs to shape\n533 |     (n_samples, 1).\n534 | \n535 |     Parameters\n536 |     ----------\n537 |     pred_method : callable\n538 |         Prediction method.\n539 | \n540 |     method_name: str\n541 |         Name of the prediction method\n542 | \n543 |     X : array-like or None\n544 |         Data used to obtain predictions.\n545 | \n546 |     n_classes : int\n547 |         Number of classes present.\n548 | \n549 |     Returns\n550 |     -------\n551 |     predictions : array-like, shape (X.shape[0], len(clf.classes_))\n552 |         The predictions. Note if there are 2 classes, array is of shape\n553 |         (X.shape[0], 1).\n554 |     \"\"\"\n555 |     predictions = pred_method(X=X)\n556 | \n557 |     if method_name == \"decision_function\":\n558 |         if predictions.ndim == 1:\n559 |             predictions = predictions[:, np.newaxis]\n560 |     elif method_name == \"predict_proba\":\n561 |         if n_classes == 2:\n562 |             predictions = predictions[:, 1:]\n563 |     else:  # pragma: no cover\n564 |         # this branch should be unreachable.\n565 |         raise ValueError(f\"Invalid prediction method: {method_name}\")\n566 |     return predictions\n567 | \n568 | \n569 | def _fit_calibrator(clf, predictions, y, classes, method, sample_weight=None):\n570 |     \"\"\"Fit calibrator(s) and return a `_CalibratedClassifier`\n571 |     instance.\n572 | \n573 |     `n_classes` (i.e. `len(clf.classes_)`) calibrators are fitted.\n574 |     However, if `n_classes` equals 2, one calibrator is fitted.\n575 | \n576 |     Parameters\n577 |     ----------\n578 |     clf : estimator instance\n579 |         Fitted classifier.\n580 | \n581 |     predictions : array-like, shape (n_samples, n_classes) or (n_samples, 1) \\\n582 |                     when binary.\n583 |         Raw predictions returned by the un-calibrated base classifier.\n584 | \n585 |     y : array-like, shape (n_samples,)\n586 |         The targets.\n587 | \n588 |     classes : ndarray, shape (n_classes,)\n589 |         All the prediction classes.\n590 | \n591 |     method : {'sigmoid', 'isotonic'}\n592 |         The method to use for calibration.\n593 | \n594 |     sample_weight : ndarray, shape (n_samples,), default=None\n595 |         Sample weights. If None, then samples are equally weighted.\n596 | \n597 |     Returns\n598 |     -------\n599 |     pipeline : _CalibratedClassifier instance\n600 |     \"\"\"\n601 |     Y = label_binarize(y, classes=classes)\n602 |     label_encoder = LabelEncoder().fit(classes)\n603 |     pos_class_indices = label_encoder.transform(clf.classes_)\n604 |     calibrators = []\n605 |     for class_idx, this_pred in zip(pos_class_indices, predictions.T):\n606 |         if method == \"isotonic\":\n607 |             calibrator = IsotonicRegression(out_of_bounds=\"clip\")\n608 |         elif method == \"sigmoid\":\n609 |             calibrator = _SigmoidCalibration()\n610 |         else:\n611 |             raise ValueError(\n612 |                 f\"'method' should be one of: 'sigmoid' or 'isotonic'. Got {method}.\"\n613 |             )\n614 |         calibrator.fit(this_pred, Y[:, class_idx], sample_weight)\n615 |         calibrators.append(calibrator)\n616 | \n617 |     pipeline = _CalibratedClassifier(clf, calibrators, method=method, classes=classes)\n618 |     return pipeline\n619 | \n620 | \n621 | class _CalibratedClassifier:\n622 |     \"\"\"Pipeline-like chaining a fitted classifier and its fitted calibrators.\n623 | \n624 |     Parameters\n625 |     ----------\n626 |     base_estimator : estimator instance\n627 |         Fitted classifier.\n628 | \n629 |     calibrators : list of fitted estimator instances\n630 |         List of fitted calibrators (either 'IsotonicRegression' or\n631 |         '_SigmoidCalibration'). The number of calibrators equals the number of\n632 |         classes. However, if there are 2 classes, the list contains only one\n633 |         fitted calibrator.\n634 | \n635 |     classes : array-like of shape (n_classes,)\n636 |         All the prediction classes.\n637 | \n638 |     method : {'sigmoid', 'isotonic'}, default='sigmoid'\n639 |         The method to use for calibration. Can be 'sigmoid' which\n640 |         corresponds to Platt's method or 'isotonic' which is a\n641 |         non-parametric approach based on isotonic regression.\n642 | \n643 |     Attributes\n644 |     ----------\n645 |     calibrators_ : list of fitted estimator instances\n646 |         Same as `calibrators`. Exposed for backward-compatibility. Use\n647 |         `calibrators` instead.\n648 | \n649 |         .. deprecated:: 0.24\n650 |            `calibrators_` is deprecated from 0.24 and will be removed in\n651 |            1.1 (renaming of 0.26). Use `calibrators` instead.\n652 |     \"\"\"\n653 | \n654 |     def __init__(self, base_estimator, calibrators, *, classes, method=\"sigmoid\"):\n655 |         self.base_estimator = base_estimator\n656 |         self.calibrators = calibrators\n657 |         self.classes = classes\n658 |         self.method = method\n659 | \n660 |     # TODO: Remove in 1.1\n661 |     # mypy error: Decorated property not supported\n662 |     @deprecated(  # type: ignore\n663 |         \"`calibrators_` is deprecated in 0.24 and will be removed in 1.1\"\n664 |         \"(renaming of 0.26). Use `calibrators` instead.\"\n665 |     )\n666 |     @property\n667 |     def calibrators_(self):\n668 |         return self.calibrators\n669 | \n670 |     def predict_proba(self, X):\n671 |         \"\"\"Calculate calibrated probabilities.\n672 | \n673 |         Calculates classification calibrated probabilities\n674 |         for each class, in a one-vs-all manner, for `X`.\n675 | \n676 |         Parameters\n677 |         ----------\n678 |         X : ndarray of shape (n_samples, n_features)\n679 |             The sample data.\n680 | \n681 |         Returns\n682 |         -------\n683 |         proba : array, shape (n_samples, n_classes)\n684 |             The predicted probabilities. Can be exact zeros.\n685 |         \"\"\"\n686 |         n_classes = len(self.classes)\n687 |         pred_method, method_name = _get_prediction_method(self.base_estimator)\n688 |         predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n689 | \n690 |         label_encoder = LabelEncoder().fit(self.classes)\n691 |         pos_class_indices = label_encoder.transform(self.base_estimator.classes_)\n692 | \n693 |         proba = np.zeros((_num_samples(X), n_classes))\n694 |         for class_idx, this_pred, calibrator in zip(\n695 |             pos_class_indices, predictions.T, self.calibrators\n696 |         ):\n697 |             if n_classes == 2:\n698 |                 # When binary, `predictions` consists only of predictions for\n699 |                 # clf.classes_[1] but `pos_class_indices` = 0\n700 |                 class_idx += 1\n701 |             proba[:, class_idx] = calibrator.predict(this_pred)\n702 | \n703 |         # Normalize the probabilities\n704 |         if n_classes == 2:\n705 |             proba[:, 0] = 1.0 - proba[:, 1]\n706 |         else:\n707 |             denominator = np.sum(proba, axis=1)[:, np.newaxis]\n708 |             # In the edge case where for each class calibrator returns a null\n709 |             # probability for a given sample, use the uniform distribution\n710 |             # instead.\n711 |             uniform_proba = np.full_like(proba, 1 / n_classes)\n712 |             proba = np.divide(\n713 |                 proba, denominator, out=uniform_proba, where=denominator != 0\n714 |             )\n715 | \n716 |         # Deal with cases where the predicted probability minimally exceeds 1.0\n717 |         proba[(1.0 < proba) & (proba <= 1.0 + 1e-5)] = 1.0\n718 | \n719 |         return proba\n720 | \n721 | \n722 | def _sigmoid_calibration(predictions, y, sample_weight=None):\n723 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n724 | \n725 |     Parameters\n726 |     ----------\n727 |     predictions : ndarray of shape (n_samples,)\n728 |         The decision function or predict proba for the samples.\n729 | \n730 |     y : ndarray of shape (n_samples,)\n731 |         The targets.\n732 | \n733 |     sample_weight : array-like of shape (n_samples,), default=None\n734 |         Sample weights. If None, then samples are equally weighted.\n735 | \n736 |     Returns\n737 |     -------\n738 |     a : float\n739 |         The slope.\n740 | \n741 |     b : float\n742 |         The intercept.\n743 | \n744 |     References\n745 |     ----------\n746 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n747 |     \"\"\"\n748 |     predictions = column_or_1d(predictions)\n749 |     y = column_or_1d(y)\n750 | \n751 |     F = predictions  # F follows Platt's notations\n752 | \n753 |     # Bayesian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n783 | \n784 | \n785 | class _SigmoidCalibration(RegressorMixin, BaseEstimator):\n786 |     \"\"\"Sigmoid regression model.\n787 | \n788 |     Attributes\n789 |     ----------\n790 |     a_ : float\n791 |         The slope.\n792 | \n793 |     b_ : float\n794 |         The intercept.\n795 |     \"\"\"\n796 | \n797 |     def fit(self, X, y, sample_weight=None):\n798 |         \"\"\"Fit the model using X, y as training data.\n799 | \n800 |         Parameters\n801 |         ----------\n802 |         X : array-like of shape (n_samples,)\n803 |             Training data.\n804 | \n805 |         y : array-like of shape (n_samples,)\n806 |             Training target.\n807 | \n808 |         sample_weight : array-like of shape (n_samples,), default=None\n809 |             Sample weights. If None, then samples are equally weighted.\n810 | \n811 |         Returns\n812 |         -------\n813 |         self : object\n814 |             Returns an instance of self.\n815 |         \"\"\"\n816 |         X = column_or_1d(X)\n817 |         y = column_or_1d(y)\n818 |         X, y = indexable(X, y)\n819 | \n820 |         self.a_, self.b_ = _sigmoid_calibration(X, y, sample_weight)\n821 |         return self\n822 | \n823 |     def predict(self, T):\n824 |         \"\"\"Predict new data by linear interpolation.\n825 | \n826 |         Parameters\n827 |         ----------\n828 |         T : array-like of shape (n_samples,)\n829 |             Data to predict from.\n830 | \n831 |         Returns\n832 |         -------\n833 |         T_ : ndarray of shape (n_samples,)\n834 |             The predicted data.\n835 |         \"\"\"\n836 |         T = column_or_1d(T)\n837 |         return expit(-(self.a_ * T + self.b_))\n838 | \n839 | \n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n946 | \n```\n"}, {"content": "After analyzing the issue and the codebase, I can now provide the locations that need modification to implement the requested calibration curve plotting functionality. Here's the output in the required format:\n\n```\nsklearn/metrics/_plot/calibration_curve.py\nline: 1\nclass: None\nfunction: plot_calibration_curve\n\nsklearn/calibration.py\nline: 840\nfunction: calibration_curve\n\nsklearn/metrics/_plot/__init__.py\nline: 1\nfunction: None\n\nexamples/calibration/plot_calibration_curve.py\nline: 72\nline: 73\nfunction: plot_calibration_curve\n\nsklearn/metrics/__init__.py\nline: 1\nfunction: None\n```\n\nExplanation of the locations:\n\n1. `sklearn/metrics/_plot/calibration_curve.py`: This is the main file where the new plotting function needs to be implemented. The function should take `y_true`, `prob_y_pred`, and `n_bins` as parameters and plot the calibration curve.\n\n2. `sklearn/calibration.py`: This file contains the existing `calibration_curve` function that computes the necessary statistics for the calibration curve. The implementation is on line 840 and provides important context for the required functionality.\n\n3. `sklearn/metrics/_plot/__init__.py`: This file will need to expose the new plotting function so it's accessible through the metrics plotting module.\n\n4. `examples/calibration/plot_calibration_curve.py`: This example demonstrates the usage of calibration curve plotting and shows the correct order of parameters and axis labeling.\n\n5. `sklearn/metrics/__init__.py`: This file may need to be checked to ensure all plotting-related functionality is properly exposed at the package level.\n\nThese locations form the minimal set required to implement the requested feature while maintaining consistency with existing code patterns and ensuring proper exposure of the new functionality.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 90533, "completion_tokens": 644}, "time": 90.99546074867249}]}}
{"instance_id": "numpy__numpy-17394", "found_files": [["numpy/lib/stride_tricks.py", "numpy/lib/index_tricks.py", "numpy/core/arrayprint.py", "numpy/core/shape_base.py", "numpy/core/multiarray.py"]], "found_modules": [["numpy/polynomial/setup.py:configuration", "benchmarks/benchmarks/bench_array_coercion.py:ArrayCoercionSmall", "benchmarks/benchmarks/bench_reduce.py:AnyAll", "benchmarks/benchmarks/bench_linalg.py:Eindot", "benchmarks/benchmarks/bench_core.py:Core", "benchmarks/benchmarks/bench_io.py:CopyTo", "benchmarks/benchmarks/bench_lib.py:Pad", "benchmarks/benchmarks/bench_ufunc.py:Custom", "benchmarks/benchmarks/bench_reduce.py:ArgMax", "benchmarks/benchmarks/bench_avx.py:AVX_BFunc", "numpy/lib/type_check.py:_asfarray_dispatcher", "numpy/distutils/command/config_compiler.py:config_fc", "benchmarks/benchmarks/bench_function_base.py:Select", "benchmarks/benchmarks/bench_avx.py:AVX_ldexp", "numpy/lib/user_array.py:container", "benchmarks/benchmarks/bench_ufunc.py:CustomInplace", "benchmarks/benchmarks/bench_indexing.py:IndexingStructured0D", "benchmarks/benchmarks/bench_lib.py:Nan", "numpy/typing/_callable.py:_BoolSub", "numpy/typing/__init__.py:final", "numpy/polynomial/_polybase.py:ABCPolyBase", "benchmarks/benchmarks/bench_core.py:Temporaries", "numpy/lib/stride_tricks.py:as_strided", "numpy/core/arrayprint.py:array_repr"]], "found_entities": [["numpy/polynomial/setup.py:configuration", "benchmarks/benchmarks/bench_array_coercion.py:ArrayCoercionSmall.time_asarray", "benchmarks/benchmarks/bench_reduce.py:AnyAll.time_all_slow", "benchmarks/benchmarks/bench_linalg.py:Eindot.time_einsum_ij_jk_a_b", "benchmarks/benchmarks/bench_core.py:Core.time_array_l", "benchmarks/benchmarks/bench_reduce.py:AnyAll.time_any_slow", "benchmarks/benchmarks/bench_io.py:CopyTo.time_copyto", "benchmarks/benchmarks/bench_io.py:CopyTo.time_copyto_sparse", "benchmarks/benchmarks/bench_core.py:Core.time_hstack_l", "benchmarks/benchmarks/bench_lib.py:Pad.time_pad", "benchmarks/benchmarks/bench_core.py:Core.time_dstack_l", "benchmarks/benchmarks/bench_io.py:CopyTo.time_copyto_8_sparse", "benchmarks/benchmarks/bench_core.py:Core.time_arange_100", "benchmarks/benchmarks/bench_linalg.py:Eindot.time_matmul_trans_a_atc", "benchmarks/benchmarks/bench_ufunc.py:Custom.setup", "benchmarks/benchmarks/bench_core.py:Core.time_ones_100", "benchmarks/benchmarks/bench_linalg.py:Eindot.time_matmul_trans_at_a", "benchmarks/benchmarks/bench_reduce.py:ArgMax.setup", "benchmarks/benchmarks/bench_core.py:Core.time_empty_100", "benchmarks/benchmarks/bench_linalg.py:Eindot.time_matmul_trans_atc_a", "benchmarks/benchmarks/bench_reduce.py:ArgMax.time_argmax", "benchmarks/benchmarks/bench_linalg.py:Eindot.time_tensordot_a_b_axes_1_0_0_1", "benchmarks/benchmarks/bench_ufunc.py:Custom.time_and_bool", "benchmarks/benchmarks/bench_core.py:Core.time_identity_100", "benchmarks/benchmarks/bench_avx.py:AVX_BFunc.time_ufunc", "benchmarks/benchmarks/bench_core.py:Core.time_identity_3000", "numpy/lib/type_check.py:_asfarray_dispatcher", "numpy/distutils/command/config_compiler.py:config_fc.run", "benchmarks/benchmarks/bench_core.py:Core.time_diagflat_l100", "benchmarks/benchmarks/bench_function_base.py:Select.time_select", "benchmarks/benchmarks/bench_avx.py:AVX_ldexp.time_ufunc", "numpy/lib/user_array.py:container.__rdiv__", "benchmarks/benchmarks/bench_ufunc.py:CustomInplace.time_char_or_temp", "benchmarks/benchmarks/bench_indexing.py:IndexingStructured0D.time_array_slice", "benchmarks/benchmarks/bench_lib.py:Nan.time_nancumprod", "numpy/typing/_callable.py:_BoolSub.__call__", "benchmarks/benchmarks/bench_indexing.py:IndexingStructured0D.time_scalar_slice", "benchmarks/benchmarks/bench_indexing.py:IndexingStructured0D.time_scalar_all", "benchmarks/benchmarks/bench_lib.py:Nan.time_nanstd", "benchmarks/benchmarks/bench_ufunc.py:CustomInplace.time_float_add_temp", "numpy/typing/__init__.py:final", "numpy/polynomial/_polybase.py:ABCPolyBase.window", "benchmarks/benchmarks/bench_core.py:Temporaries.time_large", "numpy/lib/stride_tricks.py:as_strided", "numpy/core/arrayprint.py:array_repr"]], "raw_output_loc": ["Based on my analysis, here are the key files and locations that would be relevant for implementing and integrating a sliding window function:\n\n```\nnumpy/lib/stride_tricks.py\nline: 37-111\nfunction: as_strided\nclass: None\n\nnumpy/lib/index_tricks.py\nclass: IndexTricks\nfunction: sliding_window\n\nnumpy/core/arrayprint.py\nline: 1\nclass: None\nfunction: array_repr\n\nnumpy/core/shape_base.py\nclass: None\nfunction: array_shape\n\nnumpy/core/multiarray.py\nline: 1\nclass: None\nfunction: array\n```\n\nReasoning for these locations:\n\n1. `numpy/lib/stride_tricks.py`: This is the most relevant file as it contains the existing `as_strided` function which is the core functionality needed for implementing sliding windows. The implementation would need to integrate closely with this function.\n\n2. `numpy/lib/index_tricks.py`: This file contains the `IndexTricks` class which provides indexing utilities. The sliding window function would likely need to utilize its indexing capabilities to work correctly across multiple dimensions.\n\n3. `numpy/core/arrayprint.py`: This handles array display and would be important for ensuring the sliding window function maintains good visualization behavior.\n\n4. `numpy/core/shape_base.py`: Contains shape handling utilities which are crucial for maintaining proper array dimensions during window operations.\n\n5. `numpy/core/multiarray.py`: Contains fundamental array operations and would be needed for the basic array manipulations required by the sliding window functionality.\n\nThese files form the core array manipulation infrastructure that the proposed `sliding_window` function would need to integrate with. The function would need to:\n- Utilize `as_strided` for creating the actual sliding window views\n- Work with array shapes and dimensions through `shape_base.py`\n- Handle indexing operations through `index_tricks.py`\n- Manage array display through `arrayprint.py`\n\nThe proposed implementation would need to:\n1. Take input array and window parameters\n2. Calculate proper shape and strides using stride_tricks logic\n3. Apply the sliding window transformation\n4. Maintain proper array dimensions and metadata\n5. Provide intuitive interface for users familiar with numpy's indexing and slicing conventions"], "meta_data": {"repo": "numpy/numpy", "base_commit": "43683b3256a86659f230dcadbcde1f8020398bfa", "problem_statement": "Suggestion: Sliding Window Function\nUsing `np.lib.stride_tricks.as_stride` one can very efficiently create a sliding window that segments an array as a preprocessing step for vectorized applications. For example a moving average of a window length `3`, stepsize `1`:\n\n```\na = numpy.arange(10)\na_strided = numpy.lib.stride_tricks.as_strided(\n    a, shape=(8, 3), strides=(8, 8)\n)\nprint numpy.mean(a_strided, axis=1)\n```\n\nThis is very performant but very hard to do, as the `shape` and `strides` parameters are very hard to understand.\n\nI suggest the implementation of a \"simple `sliding_window` function\" that does the job of figuring out those two parameters for you.\n\n[The implementation I have been using for years](https://gist.github.com/nils-werner/9d321441006b112a4b116a8387c2280c) allows the above to be replaced by\n\n```\na = numpy.arange(10)\na_strided = sliding_window(a, size=3, stepsize=1)\nprint numpy.mean(a_strided, axis=1)\n```\n\n@teoliphant [also has an implementation](https://gist.github.com/teoliphant/96eb779a16bd038e374f2703da62f06d) that would change the above to\n\n```\na = numpy.arange(10)\na_strided = array_for_sliding_window(a, 3)\nprint numpy.mean(a_strided, axis=1)\n```\n\nboth making it much more readable.\n\nSeeing it is a common usecase in vectorized computing I suggest we put a similar function into NumPy itself.\n\nRegarding to which implementation to follow, they are both assume different things but allow you to do the same thing eventually:\n\n`sliding_window`\n- slides over one axis only\n- allows setting windowsize and stepsize\n- returns array with dimension n+1\n- sliding over several axes requires two calls (which come for free as there is no memory reordered)\n- has a superfluous `copy` parameter that can be removed and replaced by appending `.copy()` after the call\n\n`array_for_sliding_window`\n- slides over all axes simultaneously, window lengths are given as `tuple` parameter\n- Assumes a stepsize one in all directions\n- returns array with dimension n*2\n- stepsize not equal to one requires slicing of output data (unsure if this implies copying data)\n- Disabling sliding over `axis[n]` requires you set argument `wshape[n] = 1` or `wshape[n] = a.shape[n]`\n\nThis means for flexible `stepsize` the following are equivalent (with some minor bug in `sliding_window` there):\n\n```\na = numpy.arange(10)\nprint sliding_window(a, size=3, stepsize=2)\n\na = numpy.arange(10)\nprint array_for_sliding_window(a, 3)[::2, :] # Stepsize 2 by dropping every 2nd row\n```\n\nfor sliding over one `axis` the following are equivalent (with some transposing and squeezing):\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(a, size=3, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (1, 3))\n```\n\nand for sliding over two `axis` the following are equivalent:\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(sliding_window(a, size=3, axis=0), size=2, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (3, 2))\n```\n\nThis issue is about sparking discussion about\n- Do we need such a function?\n- Which features are required?\n- Which interface should we persue?\n\nAfter discussion I am willing to draft up a pull request with an implementation we agreed on.\n\n", "patch": "diff --git a/doc/release/upcoming_changes/17394.new_function.rst b/doc/release/upcoming_changes/17394.new_function.rst\nnew file mode 100644\nindex 000000000000..50c9d1db310d\n--- /dev/null\n+++ b/doc/release/upcoming_changes/17394.new_function.rst\n@@ -0,0 +1,5 @@\n+``sliding_window_view`` provides a sliding window view for numpy arrays\n+-----------------------------------------------------------------------\n+`numpy.sliding_window_view` constructs views on numpy arrays that offer a\n+sliding or moving window access to the array. This allows for the simple\n+implementation of certain algorithms, such as running means.\ndiff --git a/doc/source/reference/routines.indexing.rst b/doc/source/reference/routines.indexing.rst\nindex aeec1a1bba55..a1c82c620340 100644\n--- a/doc/source/reference/routines.indexing.rst\n+++ b/doc/source/reference/routines.indexing.rst\n@@ -42,6 +42,7 @@ Indexing-like operations\n    diag\n    diagonal\n    select\n+   sliding_window_view\n    lib.stride_tricks.as_strided\n \n Inserting data into arrays\ndiff --git a/numpy/lib/stride_tricks.py b/numpy/lib/stride_tricks.py\nindex d8a8b325e3a4..a6c0da751abc 100644\n--- a/numpy/lib/stride_tricks.py\n+++ b/numpy/lib/stride_tricks.py\n@@ -6,9 +6,11 @@\n \n \"\"\"\n import numpy as np\n+from numpy.core.numeric import normalize_axis_tuple\n from numpy.core.overrides import array_function_dispatch, set_module\n \n-__all__ = ['broadcast_to', 'broadcast_arrays', 'broadcast_shapes']\n+__all__ = ['broadcast_to', 'broadcast_arrays', 'broadcast_shapes',\n+           'sliding_window_view']\n \n \n class DummyArray:\n@@ -67,6 +69,8 @@ def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n     --------\n     broadcast_to: broadcast an array to a given shape.\n     reshape : reshape an array.\n+    sliding_window_view: userfriendly and safe function for the creation of\n+        sliding window views.\n \n     Notes\n     -----\n@@ -111,6 +115,228 @@ def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n     return view\n \n \n+def _sliding_window_view_dispatcher(x, window_shape, axis=None, *,\n+                                    subok=None, writeable=None):\n+    return (x,)\n+\n+\n+@array_function_dispatch(_sliding_window_view_dispatcher, module='numpy')\n+def sliding_window_view(x, window_shape, axis=None, *,\n+                        subok=False, writeable=False):\n+    \"\"\"\n+    Create a sliding window view into the array with the given window shape.\n+\n+    Also known as rolling or moving window, the window slides across all\n+    dimensions of the array and extracts subsets of the array at all window\n+    positions.\n+    \n+    .. versionadded:: 1.20.0\n+\n+    Parameters\n+    ----------\n+    x : array_like\n+        Array to create the sliding window view from.\n+    window_shape : int or tuple of int\n+        Size of window over each axis that takes part in the sliding window.\n+        If `axis` is not present, must have same length as the number of input\n+        array dimensions. Single integers `i` are treated as if they were the\n+        tuple `(i,)`.\n+    axis : int or tuple of int, optional\n+        Axis or axes along which the sliding window is applied.\n+        By default, the sliding window is applied to all axes and\n+        `window_shape[i]` will refer to axis `i` of `x`.\n+        If `axis` is given as a `tuple of int`, `window_shape[i]` will refer to\n+        the axis `axis[i]` of `x`.\n+        Single integers `i` are treated as if they were the tuple `(i,)`.\n+    subok : bool, optional\n+        If True, sub-classes will be passed-through, otherwise the returned\n+        array will be forced to be a base-class array (default).\n+    writeable : bool, optional\n+        When true, allow writing to the returned view. The default is false,\n+        as this should be used with caution: the returned view contains the\n+        same memory location multiple times, so writing to one location will\n+        cause others to change.\n+\n+    Returns\n+    -------\n+    view : ndarray\n+        Sliding window view of the array. The sliding window dimensions are\n+        inserted at the end, and the original dimensions are trimmed as\n+        required by the size of the sliding window.\n+        That is, ``view.shape = x_shape_trimmed + window_shape``, where\n+        ``x_shape_trimmed`` is ``x.shape`` with every entry reduced by one less\n+        than the corresponding window size.\n+\n+    See Also\n+    --------\n+    lib.stride_tricks.as_strided: A lower-level and less safe routine for\n+        creating arbitrary views from custom shape and strides.\n+    broadcast_to: broadcast an array to a given shape.\n+\n+    Notes\n+    -----\n+    For many applications using a sliding window view can be convenient, but\n+    potentially very slow. Often specialized solutions exist, for example:\n+\n+    - `scipy.signal.fftconvolve`\n+\n+    - filtering functions in `scipy.ndimage`\n+\n+    - moving window functions provided by\n+      `bottleneck <https://github.com/pydata/bottleneck>`_.\n+\n+    As a rough estimate, a sliding window approach with an input size of `N`\n+    and a window size of `W` will scale as `O(N*W)` where frequently a special\n+    algorithm can achieve `O(N)`. That means that the sliding window variant\n+    for a window size of 100 can be a 100 times slower than a more specialized\n+    version.\n+\n+    Nevertheless, for small window sizes, when no custom algorithm exists, or\n+    as a prototyping and developing tool, this function can be a good solution.\n+\n+    Examples\n+    --------\n+    >>> x = np.arange(6)\n+    >>> x.shape\n+    (6,)\n+    >>> v = np.sliding_window_view(x, 3)\n+    >>> v.shape\n+    (4, 3)\n+    >>> v\n+    array([[0, 1, 2],\n+           [1, 2, 3],\n+           [2, 3, 4],\n+           [3, 4, 5]])\n+\n+    This also works in more dimensions, e.g.\n+\n+    >>> i, j = np.ogrid[:3, :4]\n+    >>> x = 10*i + j\n+    >>> x.shape\n+    (3, 4)\n+    >>> x\n+    array([[ 0,  1,  2,  3],\n+           [10, 11, 12, 13],\n+           [20, 21, 22, 23]])\n+    >>> shape = (2,2)\n+    >>> v = np.sliding_window_view(x, shape)\n+    >>> v.shape\n+    (2, 3, 2, 2)\n+    >>> v\n+    array([[[[ 0,  1],\n+             [10, 11]],\n+            [[ 1,  2],\n+             [11, 12]],\n+            [[ 2,  3],\n+             [12, 13]]],\n+           [[[10, 11],\n+             [20, 21]],\n+            [[11, 12],\n+             [21, 22]],\n+            [[12, 13],\n+             [22, 23]]]])\n+\n+    The axis can be specified explicitly:\n+\n+    >>> v = np.sliding_window_view(x, 3, 0)\n+    >>> v.shape\n+    (1, 4, 3)\n+    >>> v\n+    array([[[ 0, 10, 20],\n+            [ 1, 11, 21],\n+            [ 2, 12, 22],\n+            [ 3, 13, 23]]])\n+\n+    The same axis can be used several times. In that case, every use reduces\n+    the corresponding original dimension:\n+\n+    >>> v = np.sliding_window_view(x, (2, 3), (1, 1))\n+    >>> v.shape\n+    (3, 1, 2, 3)\n+    >>> v\n+    array([[[[ 0,  1,  2],\n+             [ 1,  2,  3]]],\n+           [[[10, 11, 12],\n+             [11, 12, 13]]],\n+           [[[20, 21, 22],\n+             [21, 22, 23]]]])\n+\n+    Combining with stepped slicing (`::step`), this can be used to take sliding\n+    views which skip elements:\n+\n+    >>> x = np.arange(7)\n+    >>> np.sliding_window_view(x, 5)[:, ::2]\n+    array([[0, 2, 4],\n+           [1, 3, 5],\n+           [2, 4, 6]])\n+\n+    or views which move by multiple elements\n+\n+    >>> x = np.arange(7)\n+    >>> np.sliding_window_view(x, 3)[::2, :]\n+    array([[0, 1, 2],\n+           [2, 3, 4],\n+           [4, 5, 6]])\n+\n+    A common application of `sliding_window_view` is the calculation of running\n+    statistics. The simplest example is the\n+    `moving average <https://en.wikipedia.org/wiki/Moving_average>`_:\n+\n+    >>> x = np.arange(6)\n+    >>> x.shape\n+    (6,)\n+    >>> v = np.sliding_window_view(x, 3)\n+    >>> v.shape\n+    (4, 3)\n+    >>> v\n+    array([[0, 1, 2],\n+           [1, 2, 3],\n+           [2, 3, 4],\n+           [3, 4, 5]])\n+    >>> moving_average = v.mean(axis=-1)\n+    >>> moving_average\n+    array([1., 2., 3., 4.])\n+\n+    Note that a sliding window approach is often **not** optimal (see Notes).\n+    \"\"\"\n+    window_shape = (tuple(window_shape)\n+                    if np.iterable(window_shape)\n+                    else (window_shape,))\n+    # first convert input to array, possibly keeping subclass\n+    x = np.array(x, copy=False, subok=subok)\n+\n+    window_shape_array = np.array(window_shape)\n+    if np.any(window_shape_array < 0):\n+        raise ValueError('`window_shape` cannot contain negative values')\n+\n+    if axis is None:\n+        axis = tuple(range(x.ndim))\n+        if len(window_shape) != len(axis):\n+            raise ValueError(f'Since axis is `None`, must provide '\n+                             f'window_shape for all dimensions of `x`; '\n+                             f'got {len(window_shape)} window_shape elements '\n+                             f'and `x.ndim` is {x.ndim}.')\n+    else:\n+        axis = normalize_axis_tuple(axis, x.ndim, allow_duplicate=True)\n+        if len(window_shape) != len(axis):\n+            raise ValueError(f'Must provide matching length window_shape and '\n+                             f'axis; got {len(window_shape)} window_shape '\n+                             f'elements and {len(axis)} axes elements.')\n+\n+    out_strides = x.strides + tuple(x.strides[ax] for ax in axis)\n+\n+    # note: same axis can be windowed repeatedly\n+    x_shape_trimmed = list(x.shape)\n+    for ax, dim in zip(axis, window_shape):\n+        if x_shape_trimmed[ax] < dim:\n+            raise ValueError(\n+                'window shape cannot be larger than input array shape')\n+        x_shape_trimmed[ax] -= dim - 1\n+    out_shape = tuple(x_shape_trimmed) + window_shape\n+    return as_strided(x, strides=out_strides, shape=out_shape,\n+                      subok=subok, writeable=writeable)\n+\n+\n def _broadcast_to(array, shape, subok, readonly):\n     shape = tuple(shape) if np.iterable(shape) else (shape,)\n     array = np.array(array, copy=False, subok=subok)\n"}, "usage": {"cost($)": "0", "prompt_tokens": 110620, "completion_tokens": 842}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'numpy' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Suggestion: Sliding Window Function\n\nUsing `np.lib.stride_tricks.as_stride` one can very efficiently create a sliding window that segments an array as a preprocessing step for vectorized applications. For example a moving average of a window length `3`, stepsize `1`:\n\n```\na = numpy.arange(10)\na_strided = numpy.lib.stride_tricks.as_strided(\n    a, shape=(8, 3), strides=(8, 8)\n)\nprint numpy.mean(a_strided, axis=1)\n```\n\nThis is very performant but very hard to do, as the `shape` and `strides` parameters are very hard to understand.\n\nI suggest the implementation of a \"simple `sliding_window` function\" that does the job of figuring out those two parameters for you.\n\n[The implementation I have been using for years](https://gist.github.com/nils-werner/9d321441006b112a4b116a8387c2280c) allows the above to be replaced by\n\n```\na = numpy.arange(10)\na_strided = sliding_window(a, size=3, stepsize=1)\nprint numpy.mean(a_strided, axis=1)\n```\n\n@teoliphant [also has an implementation](https://gist.github.com/teoliphant/96eb779a16bd038e374f2703da62f06d) that would change the above to\n\n```\na = numpy.arange(10)\na_strided = array_for_sliding_window(a, 3)\nprint numpy.mean(a_strided, axis=1)\n```\n\nboth making it much more readable.\n\nSeeing it is a common usecase in vectorized computing I suggest we put a similar function into NumPy itself.\n\nRegarding to which implementation to follow, they are both assume different things but allow you to do the same thing eventually:\n\n`sliding_window`\n- slides over one axis only\n- allows setting windowsize and stepsize\n- returns array with dimension n+1\n- sliding over several axes requires two calls (which come for free as there is no memory reordered)\n- has a superfluous `copy` parameter that can be removed and replaced by appending `.copy()` after the call\n\n`array_for_sliding_window`\n- slides over all axes simultaneously, window lengths are given as `tuple` parameter\n- Assumes a stepsize one in all directions\n- returns array with dimension n*2\n- stepsize not equal to one requires slicing of output data (unsure if this implies copying data)\n- Disabling sliding over `axis[n]` requires you set argument `wshape[n] = 1` or `wshape[n] = a.shape[n]`\n\nThis means for flexible `stepsize` the following are equivalent (with some minor bug in `sliding_window` there):\n\n```\na = numpy.arange(10)\nprint sliding_window(a, size=3, stepsize=2)\n\na = numpy.arange(10)\nprint array_for_sliding_window(a, 3)[::2, :] # Stepsize 2 by dropping every 2nd row\n```\n\nfor sliding over one `axis` the following are equivalent (with some transposing and squeezing):\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(a, size=3, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (1, 3))\n```\n\nand for sliding over two `axis` the following are equivalent:\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(sliding_window(a, size=3, axis=0), size=2, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (3, 2))\n```\n\nThis issue is about sparking discussion about\n- Do we need such a function?\n- Which features are required?\n- Which interface should we persue?\n\nAfter discussion I am willing to draft up a pull request with an implementation we agreed on.\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n"}, {"content": "I'll help analyze this feature request systematically.\n\nLet me follow the steps:\n\n## Step 1: Let's first explore the repository structure to understand where relevant files might be located.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['/']</parameter>\n<parameter=traversal_depth>2</parameter>\n<parameter=dependency_type_filter>['contains']</parameter>\n<parameter=entity_type_filter>['file', 'directory']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"ro