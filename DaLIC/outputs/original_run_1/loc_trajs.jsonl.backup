3 = transformer.fit_transform(X, y=y_)\n1800 | \n1801 |         if _safe_tags(transformer_orig, key=\"non_deterministic\"):\n1802 |             msg = name + \" is non deterministic\"\n1803 |             raise SkipTest(msg)\n1804 |         if isinstance(X_pred, tuple) and isinstance(X_pred2, tuple):\n1805 |             for x_pred, x_pred2, x_pred3 in zip(X_pred, X_pred2, X_pred3):\n1806 |                 assert_allclose_dense_sparse(\n1807 |                     x_pred,\n1808 |                     x_pred2,\n1809 |                     atol=1e-2,\n1810 |                     err_msg=\"fit_transform and transform outcomes not consistent in %s\"\n1811 |                     % transformer,\n1812 |                 )\n1813 |                 assert_allclose_dense_sparse(\n1814 |                     x_pred,\n1815 |                     x_pred3,\n1816 |                     atol=1e-2,\n1817 |                     err_msg=\"consecutive fit_transform outcomes not consistent in %s\"\n1818 |                     % transformer,\n1819 |                 )\n1820 |         else:\n1821 |             assert_allclose_dense_sparse(\n1822 |                 X_pred,\n1823 |                 X_pred2,\n1824 |                 err_msg=\"fit_transform and transform outcomes not consistent in %s\"\n1825 |                 % transformer,\n1826 |                 atol=1e-2,\n1827 |             )\n1828 |             assert_allclose_dense_sparse(\n1829 |                 X_pred,\n1830 |                 X_pred3,\n1831 |                 atol=1e-2,\n1832 |                 err_msg=\"consecutive fit_transform outcomes not consistent in %s\"\n1833 |                 % transformer,\n1834 |             )\n1835 |             assert _num_samples(X_pred2) == n_samples\n1836 |             assert _num_samples(X_pred3) == n_samples\n1837 | \n1838 |         # raises error on malformed input for transform\n1839 |         if (\n1840 |             hasattr(X, \"shape\")\n1841 |             and not _safe_tags(transformer, key=\"state