 |     n_samples, n_features = X_orig.shape\n4088 | \n4089 |     names = np.array([f\"col_{i}\" for i in range(n_features)])\n4090 |     X = pd.DataFrame(X_orig, columns=names, copy=False)\n4091 | \n4092 |     if is_regressor(estimator):\n4093 |         y = rng.normal(size=n_samples)\n4094 |     else:\n4095 |         y = rng.randint(low=0, high=2, size=n_samples)\n4096 |     y = _enforce_estimator_tags_y(estimator, y)\n4097 | \n4098 |     # Check that calling `fit` does not raise any warnings about feature names.\n4099 |     with warnings.catch_warnings():\n4100 |         warnings.filterwarnings(\n4101 |             \"error\",\n4102 |             message=\"X does not have valid feature names\",\n4103 |             category=UserWarning,\n4104 |             module=\"sklearn\",\n4105 |         )\n4106 |         estimator.fit(X, y)\n4107 | \n4108 |     if not hasattr(estimator, \"feature_names_in_\"):\n4109 |         raise ValueError(\n4110 |             \"Estimator does not have a feature_names_in_ \"\n4111 |             \"attribute after fitting with a dataframe\"\n4112 |         )\n4113 |     assert isinstance(estimator.feature_names_in_, np.ndarray)\n4114 |     assert estimator.feature_names_in_.dtype == object\n4115 |     assert_array_equal(estimator.feature_names_in_, names)\n4116 | \n4117 |     # Only check sklearn estimators for feature_names_in_ in docstring\n4118 |     module_name = estimator_orig.__module__\n4119 |     if (\n4120 |         module_name.startswith(\"sklearn.\")\n4121 |         and not (\"test_\" in module_name or module_name.endswith(\"_testing\"))\n4122 |         and (\"feature_names_in_\" not in (estimator_orig.__doc__))\n4123 |     ):\n4124 |         raise ValueError(\n4125 |             f\"Estimator {name} does not document its feature_names_in_ attribute\"\n4126 |         )\n4127 | \n4128 |     check_methods = []\n4129 |     for method in (\n4130 |         \"predict\",\n4131 |         \"transform\",\n4132 |         \"decision_function\",\n4133 |         \"predict_proba\",\n4134 |         \"score\",\n4135 |         \"score_samples\",\n4136 |         \"predict_log_proba\",\n4137 |     ):\n4138 |         if not hasattr(estimator, method):\n4139 |             continue\n4140 | \n4141 |         callable_method = getattr(estimator, method)\n4142 |         if method == \"score\":\n4143 |             callable_method = partial(callable_method, y=y)\n4144 |         check_methods.append((method, callable_method))\n4145 | \n4146 |     for _, method in check_methods:\n4147 |         with warnings.catch_warnings():\n4148 |             warnings.filterwarnings(\n4149 |                 \"error\",\n4150 |                 message=\"X does not have valid feature names\",\n4151 |                 category=UserWarning,\n4152 |                 module=\"sklearn\",\n4153 |             )\n4154 |             method(X)  # works without UserWarning for valid features\n4155 | \n4156 |     invalid_names = [\n4157 |         (names[::-1], \"Feature names must be in the same order as they were in fit.\"),\n4158 |         (\n4159 |             [f\"another_prefix_{i}\" for i in range(n_features)],\n4160 |             (\n4161 |                 \"Feature names unseen at fit time:\\n- another_prefix_0\\n-\"\n4162 |                 \" another_prefix_1\\n\"\n4163 |             ),\n4164 |         ),\n4165 |         (\n4166 |             names[:3],\n4167 |             f\"Feature names seen at fit time, yet now missing:\\n- {min(names[3:])}\\n\",\n4168 |         ),\n4169 |     ]\n4170 |     params = {\n4171 |         key: value\n4172 |         for key, value in estimator.get_params().items()\n4173 |         if \"early_stopping\" in key\n4174 |     }\n4175 |     early_stopping_enabled = any(value is True for value in params.values())\n4176 | \n4177 |     for invalid_name, additional_message in invalid_names:\n4178 |         X_bad = pd.DataFrame(X, columns=invalid_name, copy=False)\n4179 | \n4180 |         expected_msg = re.escape(\n4181 |             \"The feature names should match those that were passed during fit.\\n\"\n4182 |             f\"{additional_message}\"\n4183 |         )\n4184 |         for name, method in check_methods:\n4185 |             with raises(\n4186 |                 ValueError, match=expected_msg, err_msg=f\"{name} did not raise\"\n4187 |             ):\n4188 |                 method(X_bad)\n4189 | \n4190 |         # partial_fit checks on second call\n4191 |         # Do not call partial fit if early_stopping is on\n4192 |         if not hasattr(estimator, \"partial_fit\") or early_stopping_enabled:\n4193 |             continue\n4194 | \n4195 |         estimator = clone(estimator_orig)\n4196 |         if is_classifier(estimator):\n4197 |             classes = np.unique(y)\n4198 |             estimator.partial_fit(X, y, classes=classes)\n4199 |         else:\n4200 |             estimator.partial_fit(X, y)\n4201 | \n4202 |         with raises(ValueError, match=expected_msg):\n4203 |             estimator.partial_fit(X_bad, y)\n```\n"}, {"content": "It appears that the function `assert_consistent_docs` is not directly found in the search results. However, the search did reveal a function called `check_dataframe_column_names_consistency` in `sklearn/utils/estimator_checks.py` which involves checks related to feature names and their consistency. Given the nature of the issue, this function might be part of the broader effort to ensure consistency in documentation.\n\nSince the function is not explicitly found, we will assume that `assert_consistent_docs` is likely located in a newly added or recently modified test file. Given the context of the issue, it's probable that the function is located in a file named `test_docstring.py` or similar under `sklearn/utils/tests/` or `sklearn/tests/`.\n\nLet's retrieve the full contents of `sklearn/utils/tests/test_docstring.py` to see if we can find `assert_consistent_docs` there.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/