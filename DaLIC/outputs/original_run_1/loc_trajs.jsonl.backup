t case\n246 |     if bits == 32:\n247 |         return paths\n248 | \n249 |     # Handle 64bit case\n250 |     out = []\n251 |     for p in paths:\n252 |         out.extend([p + '64', p])\n253 | \n254 |     return out\n```\n\nFound function `numpy/distutils/system_info.py:system_info.calc_libraries_info`.\nSource: Retrieved code content using keyword search (bm25).\n```\n744 | def calc_libraries_info(self):\n745 |         libs = self.get_libraries()\n746 |         dirs = self.get_lib_dirs()\n747 |         # The extensions use runtime_library_dirs\n748 |         r_dirs = self.get_runtime_lib_dirs()\n749 |         # Intrinsic distutils use rpath, we simply append both entries\n750 |         # as though they were one entry\n751 |         r_dirs.extend(self.get_runtime_lib_dirs(key='rpath'))\n752 |         info = {}\n753 |         for lib in libs:\n754 |             i = self.check_libs(dirs, [lib])\n755 |             if i is not None:\n756 |                 dict_append(info, **i)\n757 |             else:\n758 |                 log.info('Library %s was not found. Ignoring' % (lib))\n759 | \n760 |             if r_dirs:\n761 |                 i = self.check_libs(r_dirs, [lib])\n762 |                 if i is not None:\n763 |                     # Swap library keywords found to runtime_library_dirs\n764 |                     # the libraries are insisting on the user having defined\n765 |                     # them using the library_dirs, and not necessarily by\n766 |                     # runtime_library_dirs\n767 |                     del i['libraries']\n768 |                     i['runtime_library_dirs'] = i.pop('library_dirs')\n769 |                     dict_append(info, **i)\n770 |                 else:\n771 |                     log.info('Runtime library %s was not found. Ignoring' % (lib))\n772 | \n773 |         return info\n```\n\nFound function `numpy/distutils/system_info.py:system_info._find_lib`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1008 | def _find_lib(self, lib_dir, lib, exts):\n1009 |         assert is_string(lib_dir)\n1010 |         # under windows first try without 'lib' prefix\n1011 |         if sys.platform == 'win32':\n1012 |             lib_prefixes = ['', 'lib']\n1013 |         else:\n1014 |             lib_prefixes = ['lib']\n1015 |         # for each library name, see if we can find a file for it.\n1016 |         for ext in exts:\n1017 |             for prefix in lib_prefixes:\n1018 |                 p = self.combine_paths(lib_dir, prefix + lib + ext)\n1019 |                 if p:\n1020 |                     # p[0] is the full path to the binary library file.\n1021 |                     if is_symlink_to_accelerate(p[0]):\n1022 |                         raise RuntimeError(_accel_msg.format(filename=p[0]))\n1023 |                     break\n1024 |             if p:\n1025 |                 assert len(p) == 1\n1026 |                 # ??? splitext on p[0] would do this for cygwin\n1027 |                 # doesn't seem correct\n1028 |                 if ext == '.dll.a':\n1029 |                     lib += '.dll'\n1030 |                 if ext == '.lib':\n1031 |                     lib = prefix + lib\n1032 |                 return lib\n1033 | \n1034 |         return False\n```\n\nFound function `numpy/distutils/system_info.py:system_info._find_libs`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1036 | def _find_libs(self, lib_dirs, libs, exts):\n1037 |         # make sure we preserve the order of libs, as it can be important\n1038 |         found_dirs, found_libs = [], []\n1039 |         for lib in libs:\n1040 |             for lib_dir in lib_dirs:\n1041 |                 found_lib = self._find_lib(lib_dir, lib, exts)\n1042 |                 if found_lib:\n1043 |                     found_libs.append(found_lib)\n1044 |                     if lib_dir not in found_dirs:\n1045 |                         found_dirs.append(lib_dir)\n1046 |                     break\n1047 | 