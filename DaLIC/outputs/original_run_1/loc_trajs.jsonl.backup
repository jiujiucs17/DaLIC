ent(s, prop, ismath)\n151 |         elif ismath:\n152 |             parse = self._text2path.mathtext_parser.parse(s, 72, prop)\n153 |             return parse.width, parse.height, parse.depth\n154 |         elif mpl.rcParams[self._use_afm_rc_name]:\n155 |             font = self._get_font_afm(prop)\n156 |             l, b, w, h, d = font.get_str_bbox_and_descent(s)\n157 |             scale = prop.get_size_in_points() / 1000\n158 |             w *= scale\n159 |             h *= scale\n160 |             d *= scale\n161 |             return w, h, d\n162 |         else:\n163 |             font = self._get_font_ttf(prop)\n164 |             font.set_text(s, 0.0, flags=ft2font.LoadFlags.NO_HINTING)\n165 |             w, h = font.get_width_height()\n166 |             d = font.get_descent()\n167 |             scale = 1 / 64\n168 |             w *= scale\n169 |             h *= scale\n170 |             d *= scale\n171 |             return w, h, d\n172 | \n173 |     def _get_font_afm(self, prop):\n174 |         fname = font_manager.findfont(\n175 |             prop, fontext=\"afm\", directory=self._afm_font_dir)\n176 |         return _cached_get_afm_from_fname(fname)\n177 | \n178 |     def _get_font_ttf(self, prop):\n179 |         fnames = font_manager.fontManager._find_fonts_by_props(prop)\n180 |         try:\n181 |             font = font_manager.get_font(fnames)\n182 |             font.clear()\n183 |             font.set_size(prop.get_size_in_points(), 72)\n184 |             return font\n185 |         except RuntimeError:\n186 |             logging.getLogger(__name__).warning(\n187 |                 \"The PostScript/PDF backend does not currently \"\n188 |                 \"support the selected font (%s).\", fnames)\n189 |             raise\n```\n\nFound file `lib/matplotlib/_docstring.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `lib/matplotlib/_docstring.py` for the full content if needed.\n\n\n\n##Searching for term \"array-like\", \"docstrin