         y = bottom  # Matches barh call signature.\n2480 |         if orientation == 'vertical':\n2481 |             if y is None:\n2482 |                 y = 0\n2483 |         else:  # horizontal\n2484 |             if x is None:\n2485 |                 x = 0\n2486 | \n2487 |         if orientation == 'vertical':\n2488 |             # It is possible for y (bottom) to contain unit information.\n2489 |             # However, it is also possible for y=0 for the default and height\n2490 |             # to contain unit information.  This will prioritize the units of y.\n2491 |             self._process_unit_info(\n2492 |                 [(\"x\", x), (\"y\", y), (\"y\", height)], kwargs, convert=False)\n2493 |             if log:\n2494 |                 self.set_yscale('log', nonpositive='clip')\n2495 |         else:  # horizontal\n2496 |             # It is possible for x (left) to contain unit information.\n2497 |             # However, it is also possible for x=0 for the default and width\n2498 |             # to contain unit information.  This will prioritize the units of x.\n2499 |             self._process_unit_info(\n2500 |                 [(\"x\", x), (\"x\", width), (\"y\", y)], kwargs, convert=False)\n2501 |             if log:\n2502 |                 self.set_xscale('log', nonpositive='clip')\n2503 | \n2504 |         # lets do some conversions now since some types cannot be\n2505 |         # subtracted uniformly\n2506 |         if self.xaxis is not None:\n2507 |             x0 = x\n2508 |             x = np.asarray(self.convert_xunits(x))\n2509 |             width = self._convert_dx(width, x0, x, self.convert_xunits)\n2510 |             if xerr is not None:\n2511 |                 xerr = self._convert_dx(xerr, x0, x, self.convert_xunits)\n2512 |         if self.yaxis is not None:\n2513 |             y0 = y\n2514 |             y = np.asarray(self.convert_yunits(y))\n2515 |             height = self._convert_dx(height, y0, y, self.convert_yunits)\n2516 |             if yerr is not None:\n2517 |                 yerr = self._convert_dx(yerr, y0, y, self.convert_yunits)\n2518 | \n2519 |         x, height, width, y, linewidth, hatch = np.broadcast_arrays(\n2520 |             # Make args iterable too.\n2521 |             np.atleast_1d(x), height, width, y, linewidth, hatch)\n2522 | \n2523 |         # Now that units have been converted, set the tick locations.\n2524 |         if orientation == 'vertical':\n2525 |             tick_label_axis = self.xaxis\n2526 |             tick_label_position = x\n2527 |         else:  # horizontal\n2528 |             tick_label_axis = self.yaxis\n2529 |             tick_label_position = y\n2530 | \n2531 |         if not isinstance(label, str) and np.iterable(label):\n2532 |             bar_container_label = '_nolegend_'\n2533 |             patch_labels = label\n2534 |         else:\n2535 |             bar_container_label = label\n2536 |             patch_labels = ['_nolegend_'] * len(x)\n2537 |         if len(patch_labels) != len(x):\n2538 |             raise ValueError(f'number of labels ({len(patch_labels)}) '\n2539 |                              f'does not match number of bars ({len(x)}).')\n2540 | \n2541 |         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n2542 |         hatch = itertools.cycle(np.atleast_1d(hatch))\n2543 |         color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n2544 |                                 # Fallback if color == \"none\".\n2545 |                                 itertools.repeat('none'))\n2546 |         if edgecolor is None:\n2547 |             edgecolor = itertools.repeat(None)\n2548 |         else:\n2549 |             edgecolor = itertools.chain(\n2550 |                 itertools.cycle(mcolors.to_rgba_array(edgecolor)),\n2551 |                 # Fallback if edgecolor == \"none\".\n2552 |                 itertools.repeat('none'))\n2553 | \n2554 |         # We will now resolve the alignment and really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                                     f'and width ({width.dtype}) '\n2564 |                                     f'are incompatible') from e\n2565 |                 bottom = y\n2566 |             else:  # horizontal\n2567 |                 try:\n2568 |                     bottom = y - height / 2\n2569 |                 except TypeError as e:\n2570 |                     raise TypeError(f'the dtypes of parameters y ({y.dtype}) '\n2571 |                                     f'and height ({height.dtype}) '\n2572 |                                     f'are incompatible') from e\n2573 |                 left = x\n2574 |         else:  # edge\n2575 |             left = x\n2576 |             bottom = y\n2577 | \n2578 |         patches = []\n2579 |         args = zip(left, bottom, width, height, color, edgecolor, linewidth,\n2580 |                    hatch, patch_labels)\n2581 |         for l, b, w, h, c, e, lw, htch, lbl in args:\n2582 |             r = mpatches.Rectangle(\n2583 |                 xy=(l, b), width=w, height=h,\n2584 |                 facecolor=c,\n2585 |                 edgecolor=e,\n2586 |                 linewidth=lw,\n2587 |                 label=lbl,\n2588 |                 hatch=htch,\n2589 |                 )\n2590 |             r._internal_update(kwargs)\n2591 |             r.get_path()._interpolation_steps = 100\n2592 |             if orientation == 'vertical':\n2593 |                 r.sticky_edges.y.append(b)\n2594 |             else:  # horizontal\n2595 |                 r.sticky_edges.x.append(l)\n2596 |             self.add_patch(r)\n2597 |             patches.append(r)\n2598 | \n2599 |         if xerr is not None or yerr is not None:\n2600 |             if orientation == 'vertical':\n2601 |                 # using list comps rather than arrays to preserve unit info\n2602 |                 ex = [l + 0.5 * w for l, w in zip(left, width)]\n2603 |                 ey = [b + h for b, h in zip(bottom, height)]\n2604 | \n2605 |             else:  # horizontal\n2606 |                 # using list comps rather than arrays to preserve unit info\n2607 |                 ex = [l + w for l, w in zip(left, width)]\n2608 |                 ey = [b + 0.5 * h for b, h in zip(bottom, height)]\n2609 | \n2610 |             error_kw.setdefault(\"label\", '_nolegend_')\n2611 | \n2612 |             errorbar = self.errorbar(ex, ey, yerr=yerr, xerr=xerr, fmt='none',\n2613 |                                      **error_kw)\n2614 |         else:\n2615 |             errorbar = None\n2616 | \n2617 |         self._request_autoscale_view()\n2618 | \n2619 |         if orientation == 'vertical':\n2620 |             datavalues = height\n2621 |         else:  # horizontal\n2622 |             datavalues = width\n2623 | \n2624 |         bar_container = BarContainer(patches, errorbar, datavalues=datavalues,\n2625 |                                      orientation=orientation,\n2626 |                                      label=bar_container_label)\n2627 |         self.add_container(bar_container)\n2628 | \n2629 |         if tick_labels is not None:\n2630 |             tick_labels = np.broadcast_to(tick_labels, len(patches))\n2631 |             tick_label_axis.set_ticks(tick_label_position)\n2632 |             tick_label_axis.set_ticklabels(tick_labels)\n2633 | \n2634 |         return bar_container\n```\n\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar`.\nSource: Match found for entity name `bar`.\n```\n2989 | def bar(self, left, height, zs=0, zdir='z', *args,\n2990 |             axlim_clip=False, **kwargs):\n2991 |         \"\"\"\n2992 |         Add 2D bar(s).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         left : 1D array-like\n2997 |             The x coordinates of the left sides of the bars.\n2998 |         height : 1D array-like\n2999 |             The height of the bars.\n3000 |         zs : float or 1D array-like, default: 0\n3001 |             Z coordinate of bars; if a single value is specified, it will be\n3002 |             used for all bars.\n3003 |         zdir : {'x', 'y', 'z'}, default: 'z'\n3004 |             When plotting 2D data, the direction to use as z ('x', 'y' or 'z').\n3005 |         axlim_clip : bool, default: False\n3006 |             Whether to hide bars with points outside the axes view limits.\n3007 | \n3008 |             .. versionadded:: 3.10\n3009 |         data : indexable object, optional\n3010 |             DATA_PARAMETER_PLACEHOLDER\n3011 |         **kwargs\n3012 |             Other keyword arguments are forwarded to\n3013 |             `matplotlib.axes.Axes.bar`.\n3014 | \n3015 |         Returns\n3016 |         -------\n3017 |         mpl_toolkits.mplot3d.art3d.Patch3DCollection\n3018 |         \"\"\"\n3019 |         had_data = self.has_data()\n3020 | \n3021 |         patches = super().bar(left, height, *args, **kwargs)\n3022 | \n3023 |         zs = np.broadcast_to(zs, len(left), subok=True)\n3024 | \n3025 |         verts = []\n3026 |         verts_zs = []\n3027 |         for p, z in zip(patches, zs):\n3028 |             vs = art3d._get_patch_verts(p)\n3029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |             # NOTE: Bugs could still occur if len(verts) > 0,\n3038 |             #       but the \"2nd dimension\" 