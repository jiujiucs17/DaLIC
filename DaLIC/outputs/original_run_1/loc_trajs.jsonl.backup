d code content using keyword search (bm25).\n```\n292 | def format_dateaxis(subplot, freq, index):\n293 |     \"\"\"\n294 |     Pretty-formats the date axis (x-axis).\n295 | \n296 |     Major and minor ticks are automatically set for the frequency of the\n297 |     current underlying series.  As the dynamic mode is activated by\n298 |     default, changing the limits of the x axis will intelligently change\n299 |     the positions of the ticks.\n300 |     \"\"\"\n301 |     from matplotlib import pylab\n302 | \n303 |     # handle index specific formatting\n304 |     # Note: DatetimeIndex does not use this\n305 |     # interface. DatetimeIndex uses matplotlib.date directly\n306 |     if isinstance(index, ABCPeriodIndex):\n307 | \n308 |         majlocator = TimeSeries_DateLocator(\n309 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n310 |         )\n311 |         minlocator = TimeSeries_DateLocator(\n312 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n313 |         )\n314 |         subplot.xaxis.set_major_locator(majlocator)\n315 |         subplot.xaxis.set_minor_locator(minlocator)\n316 | \n317 |         majformatter = TimeSeries_DateFormatter(\n318 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n319 |         )\n320 |         minformatter = TimeSeries_DateFormatter(\n321 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n322 |         )\n323 |         subplot.xaxis.set_major_formatter(majformatter)\n324 |         subplot.xaxis.set_minor_formatter(minformatter)\n325 | \n326 |         # x and y coord info\n327 |         subplot.format_coord = functools.partial(_format_coord, freq)\n328 | \n329 |     elif isinstance(index, ABCTimedeltaIndex):\n330 |         subplot.xaxis.set_major_formatter(TimeSeries_TimedeltaFormatter())\n331 |     else:\n332 |         raise TypeError(\"index type not supported\")\n333 | \n334 |     pylab.draw_if_interactive()\n```\n\nFou