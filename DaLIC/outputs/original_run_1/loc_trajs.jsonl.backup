|         \"\"\"\n 280 |         raise AbstractMethodError(self)\n 281 | \n 282 |     def _check_compatible_with(self, other: DTScalarOrNaT) -> None:\n 283 |         \"\"\"\n 284 |         Verify that `self` and `other` are compatible.\n 285 | \n 286 |         * DatetimeArray verifies that the timezones (if any) match\n 287 |         * PeriodArray verifies that the freq matches\n 288 |         * Timedelta has no verification\n 289 | \n 290 |         In each case, NaT is considered compatible.\n 291 | \n 292 |         Parameters\n 293 |         ----------\n 294 |         other\n 295 | \n 296 |         Raises\n 297 |         ------\n 298 |         Exception\n 299 |         \"\"\"\n 300 |         raise AbstractMethodError(self)\n 301 | \n 302 |     # ------------------------------------------------------------------\n 303 | \n 304 |     def _box_func(self, x):\n 305 |         \"\"\"\n 306 |         box function to get object from internal representation\n 307 |         \"\"\"\n 308 |         raise AbstractMethodError(self)\n 309 | \n 310 |     def _box_values(self, values) -> np.ndarray:\n 311 |         \"\"\"\n 312 |         apply box func to passed values\n 313 |         \"\"\"\n 314 |         return lib.map_infer(values, self._box_func, convert=False)\n 315 | \n 316 |     def __iter__(self) -> Iterator:\n 317 |         if self.ndim > 1:\n 318 |             return (self[n] for n in range(len(self)))\n 319 |         else:\n 320 |             return (self._box_func(v) for v in self.asi8)\n 321 | \n 322 |     @property\n 323 |     def asi8(self) -> npt.NDArray[np.int64]:\n 324 |         \"\"\"\n 325 |         Integer representation of the values.\n 326 | \n 327 |         Returns\n 328 |         -------\n 329 |         ndarray\n 330 |             An ndarray with int64 dtype.\n 331 |         \"\"\"\n 332 |         # do not cache or you'll create a memory leak\n 333 |         return self._ndarray.view(\"i8\")\n 334 | \n 335 |     # -----------------------------------------