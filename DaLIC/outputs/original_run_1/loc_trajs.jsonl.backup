upby(\n527 |     grouped,\n528 |     subplots=True,\n529 |     column=None,\n530 |     fontsize=None,\n531 |     rot=0,\n532 |     grid=True,\n533 |     ax=None,\n534 |     figsize=None,\n535 |     layout=None,\n536 |     sharex=False,\n537 |     sharey=True,\n538 |     backend=None,\n539 |     **kwargs,\n540 | ):\n541 |     \"\"\"\n542 |     Make box plots from DataFrameGroupBy data.\n543 | \n544 |     Parameters\n545 |     ----------\n546 |     grouped : Grouped DataFrame\n547 |     subplots : bool\n548 |         * ``False`` - no subplots will be used\n549 |         * ``True`` - create a subplot for each group.\n550 | \n551 |     column : column name or list of names, or vector\n552 |         Can be any valid input to groupby.\n553 |     fontsize : int or str\n554 |     rot : label rotation angle\n555 |     grid : Setting this to True will show the grid\n556 |     ax : Matplotlib axis object, default None\n557 |     figsize : A tuple (width, height) in inches\n558 |     layout : tuple (optional)\n559 |         The layout of the plot: (rows, columns).\n560 |     sharex : bool, default False\n561 |         Whether x-axes will be shared among subplots.\n562 |     sharey : bool, default True\n563 |         Whether y-axes will be shared among subplots.\n564 |     backend : str, default None\n565 |         Backend to use instead of the backend specified in the option\n566 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n567 |         specify the ``plotting.backend`` for the whole session, set\n568 |         ``pd.options.plotting.backend``.\n569 | \n570 |         .. versionadded:: 1.0.0\n571 | \n572 |     **kwargs\n573 |         All other plotting keyword arguments to be passed to\n574 |         matplotlib's boxplot function.\n575 | \n576 |     Returns\n577 |     -------\n578 |     dict of key/value = group key/DataFrame.boxplot return value\n579 |     or DataFrame.boxplot return value in case subplots=figures=False\n580 | \n581 |     Examples\n582 |     --------\n583 |     You can create boxplots for grouped data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **kwargs,\n617 |     )\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.pie`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1531 | def pie(self, **kwargs):\n1532 |         \"\"\"\n1533 |         Generate a pie plot.\n1534 | \n1535 |         A pie plot is a proportional representation of the numerical data in a\n1536 |         column. This function wraps :meth:`matplotlib.pyplot.pie` for the\n1537 |         specified column. If no column reference is passed and\n1538 |         ``subplots=True`` a pie plot is drawn for each numerical column\n1539 |         independently.\n1540 | \n1541 |         Parameters\n1542 |         ----------\n1543 |         y : int or label, optional\n1544 |             Label or position of the column to plot.\n1545 |             If not provided, ``subplots=True`` argument must be passed.\n1546 |         **kwargs\n1547 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1548 | \n1549 |         Returns\n1550 |         -------\n1551 |         matplotlib.axes.Axes or np.ndarray of them\n1552 |             A NumPy array is returned when `subplots` is True.\n1553 | \n1554 |         See Also\n1555 |         --------\n1556 |         Series.plot.pie : Generate a pie plot for a Series.\n1557 |         DataFrame.plot : Make plots of a DataFrame.\n1558 | \n1559 |         Examples\n1560 |         --------\n1561 |         In the example below we have a DataFrame with the information about\n1562 |         planet's mass and radius. We pass the 'mass' column to the\n1563 |         pie function to get a pie plot.\n1564 | \n1565 |         .. plot::\n1566 |             :context: close-figs\n1567 | \n1568 |             >>> df = pd.DataFrame({'mass': [0.330, 4.87 , 5.97],\n1569 |             ...                    'radius': [2439.7, 6051.8, 6378.1]},\n1570 |             ...                   index=['Mercury', 'Venus', 'Earth'])\n1571 |             >>> plot = df.plot.pie(y='mass', figsize=(5, 5))\n1572 | \n1573 |         .. plot::\n1574 |             :context: close-figs\n1575 | \n1576 |             >>> plot = df.plot.pie(subplots=True, figsize=(11, 6))\n1577 |         \"\"\"\n1578 |         if (\n1579 |             isinstance(self._parent, ABCDataFrame)\n1580 |             and kwargs.get(\"y\", None) is None\n1581 |             and not kwargs.get(\"subplots\", False)\n1582 |         ):\n1583 |             raise ValueError(\"pie requires either y column or 'subplots=True'\")\n1584 |         return self(kind=\"pie\", **kwargs)\n```\n\n\n\n##Searching for term \"plot._setup_subplots\", \"subplots plot._setup_subplots\"...\n### Sea