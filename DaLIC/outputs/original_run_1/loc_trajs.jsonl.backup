 (n_classes,)\n23 |         List of classes for each column.\n24 | \n25 |     class_probability : list of size n_outputs of arrays of \\\n26 |         shape (n_classes,), default=None\n27 |         Class distribution of each column. If None, uniform distribution is\n28 |         assumed.\n29 | \n30 |     random_state : int, RandomState instance or None, default=None\n31 |         Controls the randomness of the sampled classes.\n32 |         See :term:`Glossary <random_state>`.\n33 | \n34 |     Returns\n35 |     -------\n36 |     random_matrix : sparse csc matrix of size (n_samples, n_outputs)\n37 | \n38 |     \"\"\"\n39 |     data = array.array(\"i\")\n40 |     indices = array.array(\"i\")\n41 |     indptr = array.array(\"i\", [0])\n42 | \n43 |     for j in range(len(classes)):\n44 |         classes[j] = np.asarray(classes[j])\n45 |         if classes[j].dtype.kind != \"i\":\n46 |             raise ValueError(\"class dtype %s is not supported\" % classes[j].dtype)\n47 |         classes[j] = classes[j].astype(np.int64, copy=False)\n48 | \n49 |         # use uniform distribution if no class_probability is given\n50 |         if class_probability is None:\n51 |             class_prob_j = np.empty(shape=classes[j].shape[0])\n52 |             class_prob_j.fill(1 / classes[j].shape[0])\n53 |         else:\n54 |             class_prob_j = np.asarray(class_probability[j])\n55 | \n56 |         if not np.isclose(np.sum(class_prob_j), 1.0):\n57 |             raise ValueError(\n58 |                 \"Probability array at index {0} does not sum to one\".format(j)\n59 |             )\n60 | \n61 |         if class_prob_j.shape[0] != classes[j].shape[0]:\n62 |             raise ValueError(\n63 |                 \"classes[{0}] (length {1}) and \"\n64 |                 \"class_probability[{0}] (length {2}) have \"\n65 |                 \"different length.\".format(\n66 |                     j, classes[j].shape[0], class_prob_j.shape[0]\n67 |                 )\n68 |             )\n69 | \n70 |         # If 0 is not present in the classes insert it with a probability 0.0\n71 |         if 0 not in classes[j]:\n72 |             classes[j] = np.insert(classes[j], 0, 0)\n73 |             class_prob_j = np.insert(class_prob_j, 0, 0.0)\n74 | \n75 |         # If there are nonzero classes choose randomly using class_probability\n76 |         rng = check_random_state(random_state)\n77 |         if classes[j].shape[0] > 1:\n78 |             p_nonzero = 1 - class_prob_j[classes[j] == 0]\n79 |             nnz = int(n_samples * p_nonzero)\n80 |             ind_sample = sample_without_replacement(\n81 |                 n_population=n_samples, n_samples=nnz, random_state=random_state\n82 |             )\n83 |             indices.extend(ind_sample)\n84 | \n85 |             # Normalize probabilities for the nonzero elements\n86 |             classes_j_nonzero = classes[j] != 0\n87 |             class_probability_nz = class_prob_j[classes_j_nonzero]\n88 |             class_probability_nz_norm = class_probability_nz / np.sum(\n89 |                 class_probability_nz\n90 |             )\n91 |             classes_ind = np.searchsorted(\n92 |                 class_probability_nz_norm.cumsum(), rng.uniform(size=nnz)\n93 |             )\n94 |             data.extend(classes[j][classes_j_nonzero][classes_ind])\n95 |         indptr.append(len(indices))\n96 | \n97 |     return sp.csc_matrix((data, indices, indptr), (n_samples, len(classes)), dtype=int)\n```\n\nFound function `sklearn/preprocessing/_label.py:MultiLabelBinarizer.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n741 | def fit(self, y):\n742 |         \"\"\"Fit the label sets binarizer, storing :term:`classes_`.\n743 | \n744 |         Parameters\n745 |         ----------\n746 |         y : iterable of iterables\n747 |             A set of labels (any orderable and hashable object) for each\n748 |             sample. If the `classes` parameter is set, `y` will not be\n749 |             iterated.\n750 | \n751 |         Returns\n752 |         -------\n753 |         self : object\n754 |             Fitted estimator.\n755 |         \"\"\"\n756 |         self._cached_dict = None\n757 |         if self.classes is None:\n758 |             classes = sorted(set(itertools.chain.from_iterable(y)))\n759 |         elif len(set(self.classes)) < len(self.classes):\n760 |             raise ValueError(\n761 |                 \"The classes argument contains duplicate \"\n762 |                 \"classes. Remove these duplicates before passing \"\n763 |                 \"them to MultiLabelBinarizer.\"\n764 |             )\n765 |         else:\n766 |             classes = self.classes\n767 |         dtype = int if all(isinstance(c, int) for c in classes) else object\n768 |         self.classes_ = np.empty(len(classes), dtype=dtype)\n769 |         self.classes_[:] = classes\n770 |         return self\n```\n\nFound class `sklearn/metrics/_scorer.py:_BaseScorer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n144 | class _BaseScorer:\n145 |     def __init__(self, score_func, sign, kwargs):\n146 |         self._kwargs = kwargs\n147 |         self._score_func = score_func\n148 |         self._sign = sign\n149 | \n150 |     @staticmethod\n151 |     def _check_pos_label(pos_label, classes):\n152 |         if pos_label not in list(classes):\n153 |             raise ValueError(f\"pos_label={pos_label} is not a valid label: {classes}\")\n154 | \n155 |     def _select_proba_binary(self, y_pred, classes):\n156 |         \"\"\"Select the column of the positive label in `y_pred` when\n157 |         probabilities are provided.\n158 | \n159 |         Parameters\n160 |         ----------\n161 |         y_pred : ndarray of shape (n_samples, n_classes)\n162 |             The prediction given by `predict_proba`.\n163 | \n164 |         classes : ndarray of shape (n_classes,)\n165 |             The class labels for the estimator.\n166 | \n167 |         Returns\n168 |    