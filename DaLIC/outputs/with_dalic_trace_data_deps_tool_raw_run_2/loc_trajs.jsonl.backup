mponents_\n 985 | \n 986 |     # TODO remove the whole old behavior in 1.3\n 987 |     # Fallback to old behavior\n 988 | \n 989 |     n_iter = _check_warn_deprecated(\n 990 |         n_iter, \"n_iter\", default=100, additional_message=\"Use 'max_iter' instead.\"\n 991 |     )\n 992 | \n 993 |     if batch_size == \"warn\":\n 994 |         warnings.warn(\n 995 |             \"The default value of batch_size will change from 3 to 256 in 1.3.\",\n 996 |             FutureWarning,\n 997 |         )\n 998 |         batch_size = 3\n 999 | \n1000 |     if n_components is None:\n1001 |         n_components = X.shape[1]\n1002 | \n1003 |     if method not in (\"lars\", \"cd\"):\n1004 |         raise ValueError(\"Coding method not supported as a fit algorithm.\")\n1005 | \n1006 |     _check_positive_coding(method, positive_code)\n1007 | \n1008 |     method = \"lasso_\" + method\n1009 | \n1010 |     t0 = time.time()\n1011 |     n_samples, n_features = X.shape\n1012 |     # Avoid integer division problems\n1013 |     alpha = float(alpha)\n1014 |     random_state = check_random_state(random_state)\n1015 | \n1016 |     # Init V with SVD of X\n1017 |     if dict_init is not None:\n1018 |         dictionary = dict_init\n1019 |     else:\n1020 |         _, S, dictionary = randomized_svd(X, n_components, random_state=random_state)\n1021 |         dictionary = S[:, np.newaxis] * dictionary\n1022 |     r = len(dictionary)\n1023 |     if n_components <= r:\n1024 |         dictionary = dictionary[:n_components, :]\n1025 |     else:\n1026 |         dictionary = np.r_[\n1027 |             dictionary,\n1028 |             np.zeros((n_components - r, dictionary.shape[1]), dtype=dictionary.dtype),\n1029 |         ]\n1030 | \n1031 |     if verbose == 1:\n1032 |         print(\"[dict_learning]\", end=\" \")\n1033 | \n1034 |     if shuffle:\n1035 |         X_train = X.copy()\n1036 |         random_state.shuffle(X_train)\n1037 |     else:\n1038 |         X_train = X\n1039 | \n1040 |     X_train = check_array(\n1041 |         X_train, order=\"C\", dtype=[np.float64, np.float32], copy=False\n1042 |     )\n1043 | \n1044 |     # Fortran-order dict better suited for the sparse coding which is the\n1045 |     # bottleneck of this algorithm.\n1046 |     dictionary = check_array(dictionary, order=\"F\", dtype=X_train.dtype, copy=False)\n1047 |     dictionary = np.require(dictionary, requirements=\"W\")\n1048 | \n1049 |     batches = gen_batches(n_samples, batch_size)\n1050 |     batches = itertools.cycle(batches)\n1051 | \n1052 |     # The covariance of the dictionary\n1053 |     if inner_stats is None:\n1054 |         A = np.zeros((n_components, n_components), dtype=X_train.dtype)\n1055 |         # The data approximation\n1056 |         B = np.zeros((n_features, n_components), dtype=X_train.dtype)\n1057 |     else:\n1058 |         A = inner_stats[0].copy()\n1059 |         B = inner_stats[1].copy()\n1060 | \n1061 |     # If n_iter is zero, we need to return zero.\n1062 |     ii = iter_offset - 1\n1063 | \n1064 |     for ii, batch in zip(range(iter_offset, iter_offset + n_iter), batches):\n1065 |         this_X = X_train[batch]\n1066 |         dt = time.time() - t0\n1067 |         if verbose == 1:\n1068 |             sys.stdout.write(\".\")\n1069 |             sys.stdout.flush()\n1070 |         elif verbose:\n1071 |             if verbose > 10 or ii % ceil(100.0 / verbose) == 0:\n1072 |                 print(\n1073 |                     \"Iteration % 3i (elapsed time: % 3is, % 4.1fmn)\" % (ii, dt, dt / 60)\n1074 |                 )\n1075 | \n1076 |         this_code = sparse_encode(\n1077 |             this_X,\n1078 |             dictionary,\n1079 |             algorithm=method,\n1080 |             alpha=alpha,\n1081 |             n_jobs=n_jobs,\n1082 |             check_input=False,\n1083 |             positive=positive_code,\n1084 |             max_iter=method_max_iter,\n1085 |             verbose=verbose,\n1086 |         )\n1087 | \n1088 |         # Update the aux