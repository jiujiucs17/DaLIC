9 |                     )\n7820 | \n7821 |         axis = self._get_axis_number(axis)\n7822 | \n7823 |         if self.empty:\n7824 |             if inplace:\n7825 |                 return None\n7826 |             return self.copy()\n7827 | \n7828 |         if not isinstance(method, str):\n7829 |             raise ValueError(\"'method' should be a string, not None.\")\n7830 | \n7831 |         obj, should_transpose = (self.T, True) if axis == 1 else (self, False)\n7832 | \n7833 |         if isinstance(obj.index, MultiIndex) and method != \"linear\":\n7834 |             raise ValueError(\n7835 |                 \"Only `method=linear` interpolation is supported on MultiIndexes.\"\n7836 |             )\n7837 | \n7838 |         limit_direction = missing.infer_limit_direction(limit_direction, method)\n7839 | \n7840 |         index = missing.get_interp_index(method, obj.index)\n7841 |         new_data = obj._mgr.interpolate(\n7842 |             method=method,\n7843 |             index=index,\n7844 |             limit=limit,\n7845 |             limit_direction=limit_direction,\n7846 |             limit_area=limit_area,\n7847 |             inplace=inplace,\n7848 |             **kwargs,\n7849 |         )\n7850 | \n7851 |         result = self._constructor_from_mgr(new_data, axes=new_data.axes)\n7852 |         if should_transpose:\n7853 |             result = result.T\n7854 |         if inplace:\n7855 |             return self._update_inplace(result)\n7856 |         else:\n7857 |             return result.__finalize__(self, method=\"interpolate\")\n```\n\nFound function `pandas/core/arrays/base.py:ExtensionArray.interpolate`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 989 | def interpolate(\n 990 |         self,\n 991 |         *,\n 992 |         method: InterpolateOptions,\n 993 |         axis: int,\n 994 |         index: Index,\n 995 |         limit,\n 996 |         limit_direction,\n 997 |         limit_area,\n 998 |         copy: bool,\n 999 |         **kwargs,\n1000 |     ) -> Self:\n1001 |         \"\"\"\n1002 |         Fill NaN values using an interpolation method.\n1003 | \n1004 |         Parameters\n1005 |         ----------\n1006 |         method : str, default 'linear'\n1007 |             Interpolation technique to use. One of:\n1008 |             * 'linear': Ignore the index and treat the values as equally spaced.\n1009 |             This is the only method supported on MultiIndexes.\n1010 |             * 'time': Works on daily and higher resolution data to interpolate\n1011 |             given length of interval.\n1012 |             * 'index', 'values': use the actual numerical values of the index.\n1013 |             * 'nearest', 'zero', 'slinear', 'quadratic', 'cubic', 'barycentric',\n1014 |             'polynomial': Passed to scipy.interpolate.interp1d, whereas 'spline'\n1015 |             is passed to scipy.interpolate.UnivariateSpline. These methods use\n1016 |             the numerical values of the index.\n1017 |             Both 'polynomial' and 'spline' require that you also specify an\n1018 |             order (int), e.g. arr.interpolate(method='polynomial', order=5).\n1019 |             * 'krogh', 'piecewise_polynomial', 'spline', 'pchip', 'akima',\n1020 |             'cubicspline': Wrappers around the SciPy interpolation methods\n1021 |             of similar names. See Notes.\n1022 |             * 'from_derivatives': Refers to scipy.interpolate.BPoly.from_derivatives.\n1023 |         axis : int\n1024 |             Axis to interpolate along. For 1-dimensional data, use 0.\n1025 |         index : Index\n1026 |             Index to use for interpolation.\n1027 |         limit : int or None\n1028 |             Maximum number of consecutive NaNs to fill. Must be greater than 0.\n1029 |         limit_direction : {'forward', 'backward', 'both'}\n1030 |             Consecutive NaNs will be filled in this direction.\n1031 |         limit_area : {'inside', 'outside'} or None\n1032 |             If