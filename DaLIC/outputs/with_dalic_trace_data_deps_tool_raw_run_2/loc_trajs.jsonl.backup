es,), default='no_validation'\n2857 |         The targets.\n2858 | \n2859 |         - If `None`, :func:`~sklearn.utils.check_array` is called on `X`. If\n2860 |           the estimator's `requires_y` tag is True, then an error will be raised.\n2861 |         - If `'no_validation'`, :func:`~sklearn.utils.check_array` is called\n2862 |           on `X` and the estimator's `requires_y` tag is ignored. This is a default\n2863 |           placeholder and is never meant to be explicitly set. In that case `X` must be\n2864 |           passed.\n2865 |         - Otherwise, only `y` with `_check_y` or both `X` and `y` are checked with\n2866 |           either :func:`~sklearn.utils.check_array` or\n2867 |           :func:`~sklearn.utils.check_X_y` depending on `validate_separately`.\n2868 | \n2869 |     reset : bool, default=True\n2870 |         Whether to reset the `n_features_in_` attribute.\n2871 |         If False, the input will be checked for consistency with data\n2872 |         provided when reset was last True.\n2873 | \n2874 |         .. note::\n2875 | \n2876 |            It is recommended to call `reset=True` in `fit` and in the first\n2877 |            call to `partial_fit`. All other methods that validate `X`\n2878 |            should set `reset=False`.\n2879 | \n2880 |     validate_separately : False or tuple of dicts, default=False\n2881 |         Only used if `y` is not `None`.\n2882 |         If `False`, call :func:`~sklearn.utils.check_X_y`. Else, it must be a tuple of\n2883 |         kwargs to be used for calling :func:`~sklearn.utils.check_array` on `X` and `y`\n2884 |         respectively.\n2885 | \n2886 |         `estimator=self` is automatically added to these dicts to generate\n2887 |         more informative error message in case of invalid input data.\n2888 | \n2889 |     skip_check_array : bool, default=False\n2890 |         If `True`, `X` and `y` are unchanged and only `feature_names_in_` and\n2891 |         `n_features_in_` are checked. Otherwise, :func:`~sklearn.utils.check_array`\n2892 |         is called on `X` and `y`.\n2893 | \n2894 |     **check_params : kwargs\n2895 |         Parameters passed to :func:`~sklearn.utils.check_array` or\n2896 |         :func:`~sklearn.utils.check_X_y`. Ignored if validate_separately\n2897 |         is not False.\n2898 | \n2899 |         `estimator=self` is automatically added to these params to generate\n2900 |         more informative error message in case of invalid input data.\n2901 | \n2902 |     Returns\n2903 |     -------\n2904 |     out : {ndarray, sparse matrix} or tuple of these\n2905 |         The validated input. A tuple is returned if both `X` and `y` are\n2906 |         validated.\n2907 |     \"\"\"\n2908 |     _check_feature_names(_estimator, X, reset=reset)\n2909 |     tags = get_tags(_estimator)\n2910 |     if y is None and tags.target_tags.required:\n2911 |         raise ValueError(\n2912 |             f\"This {_estimator.__class__.__name__} estimator \"\n2913 |             \"requires y to be passed, but the target y is None.\"\n2914 |         )\n2915 | \n2916 |     no_val_X = isinstance(X, str) and X == \"no_validation\"\n2917 |     no_val_y = y is None or isinstance(y, str) and y == \"no_validation\"\n2918 | \n2919 |     if no_val_X and no_val_y:\n2920 |         raise ValueError(\"Validation should be done on X, y or both.\")\n2921 | \n2922 |     default_check_params = {\"estimator\": _estimator}\n2923 |     check_params = {**default_check_params, **check_params}\n2924 | \n2925 |     if skip_check_array:\n2926 |         if not no_val_X and no_val_y:\n2927 |             out = X\n2928 |         elif no_val_X and not no_val_y:\n2929 |             out = y\n2930 |         else:\n2931 |             out = X, y\n2932 |     elif not no_val_X and no_val_y:\n2933 |         out = check_array(X, input_name=\"X\", **check_params)\n2934 |     elif no_val_X and not no_val_y:\n2935 |         out = _check_y(y, **check_params)\n2936 |     else:\n2937 |         if validate_separately:\n2938 |             # We need this because some estimators validate X and y\n2939 |             # separately, and in general, separately calling check_array()\n2940 |             # on X and y isn't equivalent to just calling check_X_y()\n2941 |             # :(\n2942 |             check_X_params, check_y_params = validate_separately\n2943 |             if \"estimator\" not in check_X_params:\n2944 |                 check_X_params = {**default_check_params, **check_X_params}\n2945 |             X = check_array(X, input_name=\"X\", **check_X_params)\n2946 |             if \"estimator\" not in check_y_params:\n2947 |                 check_y_params = {**default_check_params, **check_y_params}\n2948 |             y = check_array(y, input_name=\"y\", **check_y_params)\n2949 |         else:\n2950 |             X, y = check_X_y(X, y, **check_params)\n2951 |         out = X, y\n2952 | \n2953 |     if not no_val_X and check_params.get(\"ensure_2d\", True):\n2954 |         _check_n_features(_estimator, X, reset=reset)\n2955 | \n2956 |     return out\n```\n\nFound function `sklearn/datasets/__init__.py:__getattr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n109 | def __getattr__(name):\n110 |     if name == \"load_boston\":\n111 |         msg = textwrap.dedent(\n112 |             \"\"\"\n113 |             `load_boston` has been removed from scikit-learn since version 1.2.\n114 | \n115 |             The Boston housing prices dataset has an ethical problem: as\n116 |             investigated in [1], the authors of this dataset engineered a\n117 |             non-invertible variable \"B\" assuming that racial self-segregation had a\n118 |             positive impact on house prices [2]. Furthermore the goal of the\n119 |             research that led to the creation of this dataset was to study the\n120 |             impact of air quality but it did not give adequate demonstration of the\n121 |             validity of this assumption.\n122 | \n123 |             The scikit-learn maintainers therefore strongly discourage the use of\n124 |             this dataset unless the purpose of the code is to study and educate\n125 |             about ethical issues in data science and machine learning.\n126 | \n127 |             In this special case, you can fetch the dataset from the original\n128 |             source::\n129 | \n130 |                 import pandas as pd\n131 |                 import numpy as np\n132 | \n133 |                 data_url = \"http://lib.stat.cmu.edu/datasets/boston\"\n134 |                 raw_df = pd.read_csv(data_url, sep=\"\\\\s+\", skiprows=22, header=None)\n135 |                 data = np.hstack([raw_df.values[::2, :], raw_df.values[1::2, :2]])\n136 |                 target = raw_df.values[1::2, 2]\n137 | \n138 |             Alternative datasets include the California housing dataset and the\n139 |             Ames housing dataset. You can load the datasets as follows::\n140 | \n141 |                 from sklearn.datasets import fetch_california_housing\n142 |                 housing = fetch_california_housing()\n143 | \n144 |             for the California housing dataset and::\n145 | \n146 |                 from sklearn.datasets import fetch_openml\n147 |                 housing = fetch_openml(name=\"house_prices\", as_frame=True)\n148 | \n149 |             for the Ames housing dataset.\n150 | \n151 |             [1] M Carlisle.\n152 |             \"Racist data destruction?\"\n153 |             <https://medium.com/@docintangible/racist-data-destruction-113e3eff54a8>\n154 | \n155 |             [2] Harrison Jr, David, and Daniel L. Rubinfeld.\n156 |             \"Hedonic housing prices and the demand for clean air.\"\n157 |             Journal of environmental economics and management 5.1 (1978): 81-102.\n158 |             <https://www.researchgate.net/publication/4974606_Hedonic_housing_prices_and_the_demand_for_clean_air>\n159 |             \"\"\"\n160 |         )\n161 |         raise ImportError(msg)\n162 |     try:\n163 |         return globals()[name]\n164 |     except KeyError:\n165 |         # This is turned into the appropriate ImportError\n166 |         raise AttributeError\n```\n\n\n\n##Searching for term \"_more_tags\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/__init__.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Utilities to load popular datasets and artificial data generators.\"\"\"\n  2 | \n  3 | # Authors: The scikit-learn developers\n  4 | # SPDX-License-Identifier: BSD-3-Clause\n  5 | \n  6 | import textwrap\n  7 | \n  8 | from ._base import (\n  9 |     clear_data_home,\n 10 |     fetch_file,\n 11 |     get_data_home,\n 12 |     load_breast_cancer,\n 13 |     load_diabetes,\n 14 |     load_digits,\n 15 |     load_files,\n 16 |     load_iris,\n 17 |     load_linnerud,\n 18 |     load_sample_image,\n 19 |     load_sample_images,\n 20 |     load_wine,\n 21 | )\n 22 | from ._california_housing import fetch_california_housing\n 23 | from ._covtype import fetch_covtype\n 24 | from ._kddcup99 import fetch_kddcup99\n 25 | from ._lfw import fetch_lfw_pairs, fetch_lfw_people\n 26 | from ._olivetti_faces import fetch_olivetti_faces\n 27 | from ._openml import fetch_openml\n 28 | from ._rcv1 import fetch_rcv1\n 29 | from ._samples_generator import (\n 30 |     make_biclusters,\n 31 |     make_blobs,\n 32 |     make_checkerboard,\n 33 |     make_circles,\n 34 |     make_classification,\n 35 |     make_friedman1,\n 36 |     make_friedman2,\n 37 |     make_friedman3,\n 38 |     make_gaussian_quantiles,\n 39 |     make_hastie_10_2,\n 40 |     make_low_rank_matrix,\n 41 |     make_moons,\n 42 |     make_multilabel_classification,\n 43 |     make_regression,\n 44 |     make_s_curve,\n 45 |     make_sparse_coded_signal,\n 46 |     make_sparse_spd_matrix,\n 47 |     make_sparse_uncorrelated,\n 48 |     make_spd_matrix,\n 49 |     make_swiss_roll,\n 50 | )\n 51 | from ._species_d