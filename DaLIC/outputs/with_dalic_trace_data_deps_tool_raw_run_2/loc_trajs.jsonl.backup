               fit_method.__name__ == \"partial_fit\" and _is_fitted(estimator)\n1504 |             )\n1505 | \n1506 |             if not global_skip_validation and not partial_fit_and_fitted:\n1507 |                 estimator._validate_params()\n1508 | \n1509 |             with config_context(\n1510 |                 skip_parameter_validation=(\n1511 |                     prefer_skip_nested_validation or global_skip_validation\n1512 |                 )\n1513 |             ):\n1514 |                 return fit_method(estimator, *args, **kwargs)\n1515 | \n1516 |         return wrapper\n1517 | \n1518 |     return decorator\n```\n"}, {"content": "Let me check for any existing docstring-related utilities or validation code:\n\n<function=search_code_snippets>\n<parameter=search_terms>['docstring validation', 'check_docstring']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/_param_validation.py:validate_params\nsklearn/utils/validation.py:_to_object_array\nsklearn/cross_decomposition/_pls.py:_pinv2_old\nsklearn/cross_decomposition/_pls.py:_get_first_singular_vectors_power_method\nsklearn/cross_decomposition/_pls.py:_center_scale_xy\nsklearn/cross_decomposition/_pls.py:_get_first_singular_vectors_svd\nsklearn/cross_decomposition/_pls.py:_svd_flip_1d\nsklearn/cross_decomposition/_pls.py:_deprecate_Y_when_required\nsklearn/cross_decomposition/_pls.py:_deprecate_Y_when_optional\nsklearn/cross_decomposition/_pls.py:_PLS.__init__\nsklearn/cross_decomposition/_pls.py:_PLS\nsklearn/cross_decomposition/_pls.py:_PLS.fit\nsklearn/cross_decomposition/_pls.py:PLSRegression.__init__\nsklearn/cross_decomposition/_pls.py:PLSRegression\nsklearn/utils/_param_validation.py:validate_params\n##Searching for term \"docstring validation\"...\n### Search Result:\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ===================================================\n 3 | Recursive feature elimination with cross-validation\n 4 | ===================================================\n 5 | \n 6 | A Recursive Feature Elimination (RFE) example with automatic tuning of the\n 7 | number of features selected with cross-validation.\n 8 | \n 9 | \"\"\"\n10 | \n11 | # Authors: The scikit-learn developers\n12 | # SPDX-License-Identifier: BSD-3-Clause\n13 | \n14 | # %%\n15 | # Data generation\n16 | # ---------------\n17 | #\n18 | # We build a classification task using 3 informative features. The introduction\n19 | # of 2 additional redundant (i.e. correlated) features has the effect that the\n20 | # selected features vary depending on the cross-validation fold. The remaining\n21 | # features are non-informative as they are drawn at random.\n22 | \n23 | from sklearn.datasets import make_classification\n24 | \n25 | X, y = make_classification(\n26 |     n_samples=500,\n27 |     n_features=15,\n28 |     n_informative=3,\n29 |     n_redundant=2,\n30 |     n_repeated=0,\n31 |     n_classes=8,\n32 |     n_clusters_per_class=1,\n33 |     class_sep=0.8,\n34 |     random_state=0,\n35 | )\n36 | \n37 | # %%\n38 | # Model training and selection\n39 | # ----------------------------\n40 | #\n41 | # We create the RFE object and compute the cross-validated scores. The scoring\n42 | # strategy \"accuracy\" optimizes the proportion of correctly classified samples.\n43 | \n44 | from sklearn.feature_selection import RFECV\n45 | from sklearn.linear_model import LogisticRegression\n46 | from sklearn.model_selection import StratifiedKFold\n47 | \n48 | min_features_to_select = 1  # Minimum number of features to consider\n49 | clf = LogisticRegression()\n50 | cv = StratifiedKFold(5)\n51 | \n52 | rfecv = RFECV(\n53 |     estimator=clf,\n54 |     step=1,\n55 |     cv=cv,\n56 |     scoring=\"accuracy\",\n57 |     min_features_to_select=min_features_to_select,\n58 |     n_jobs=2,\n59 | )\n60 | rfecv.fit(X, y)\n61 | \n62 | print(f\"Optimal number of features: {rfecv.n_features_}\")\n63 | \n64 | # %%\n65 | # In the present case, the model with 3 features (which corresponds to the true\n66 | # generative model) is found to be the most optimal.\n67 | #\n68 | # Plot number of features VS. cross-validation scores\n69 | # ---------------------------------------------------\n70 | \n71 | import matplotlib.pyplot as plt\n72 | import pandas as pd\n73 | \n74 | cv_results = pd.DataFrame(rfecv.cv_results_)\n75 | plt.figure()\n76 | plt.xlabel(\"Number of features selected\")\n77 | plt.ylabel(\"Mean test accuracy\")\n78 | plt.errorbar(\n79 |     x=cv_results[\"n_features\"],\n80 |     y=cv_results[\"mean_test_score\"],\n81 |     yerr=cv_results[\"std_test_score\"],\n82 | )\n83 | plt.title(\"Recursive Feature Elimination \\nwith correlated features\")\n84 | plt.show()\n85 | \n86 | # %%\n87 | # From the plot above one can further notice a plateau of equivalent scores\n88 | # (similar mean value and overlapping errorbars) for 3 to 5 selected features.\n89 | # This is the result of introducing correlated features. Indeed, the optimal\n90 | # model selected by the RFE can lie within this range, depending on the\n91 | # cross-validation technique. The test accuracy decreases above 5 selected\n92 | # features, this is, keeping non-informative features leads to over-fitting and\n93 | # is therefore detrimental for the statistical performance of the models.\n94 | \n```\n\nFound code snippet in file `examples/model_selection/plot_validation_curve.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==========================\n 3 | Plotting Validation Curves\n 4 | ==========================\n 5 | \n 6 | In this plot you can see the training scores and validation scores of an SVM\n 7 | for different values of the kernel parameter gamma. For very low values of\n 8 | gamma, you can see that both the training score and the validation score are\n 9 | low. This is called underfitting. Medium values of gamma will result in high\n10 | values for both scores, i.e. the classifier is performing fairly well. If gamma\n11 | is too high, the classifier will overfit, which means that the training score\n12 | is good but the validation score is poor.\n13 | \n14 | \"\"\"\n15 | \n16 | # Authors: The scikit-learn developers\n17 | # SPDX-License-Identifier: BSD-3-Clause\n18 | \n19 | import matplotlib.pyplot as plt\n20 | import numpy as np\n21 | \n22 | from sklearn.datasets import load_digits\n23 | from sklearn.model_selection import ValidationCurveDisplay\n24 | from sklearn.svm import SVC\n25 | \n26 | X, y = load_digits(return_X_y=True)\n27 | subset_mask = np.isin(y, [1, 2])  # binary classification: 1 vs 2\n28 | X, y = X[subset_mask], y[subset_mask]\n29 | \n30 | disp = ValidationCurveDisplay.from_estimator(\n31 |     SVC(),\n32 |     X,\n33 |     y,\n34 |     param_name=\"gamma\",\n35 |     param_range=np.logspace(-6, -1, 5),\n36 |     score_type=\"both\",\n37 |     n_jobs=2,\n38 |     score_name=\"Accuracy\",\n39 | )\n40 | disp.ax_.set_title(\"Validation Curve for SVM with an RBF kernel\")\n41 | disp.ax_.set_xlabel(r\"gamma (inverse radius of the RBF kernel)\")\n42 | disp.ax_.set_ylim(0.0, 1.1)\n43 | plt.show()\n44 | \n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =============================================================\n  3 | Receiver Operating Characteristic (ROC) with cross validation\n  4 | =============================================================\n  5 | \n  6 | This example presents how to estimate and visualize the variance of the Receiver\n  7 | Operating Characteristic (ROC) metric using cross-validation.\n  8 | \n  9 | ROC curves typically feature true positive rate (TPR) on the Y axis, and false\n 10 | positive rate (FPR) on the X axis. This means that the top left corner of the\n 11 | plot is the \"ideal\" point - a FPR of zero, and a TPR of one. This is not very\n 12 | realistic, but it does mean that a larger Area Under the Curve (AUC) is usually\n 13 | better. The \"steepness\" of ROC curves is also important, since it is ideal to\n 14 | maximize the TPR while minimizing the FPR.\n 15 | \n 16 | This example shows the ROC response of different datasets, created from K-fold\n 17 | cross-validation. Taking all of these curves, it is possible to calculate the\n 18 | mean AUC, and see the variance of the curve when the\n 19 | training set is split into different subsets. This roughly shows how the\n 20 | classifier output is affected by changes in the training data, and how different\n 21 | the splits generated by K-fold cross-validation are from one another.\n 22 | \n 23 | .. note::\n 24 | \n 25 |     See :ref:`sphx_glr_auto_examples_model_selection_plot_roc.py` for a\n 26 |     complement of the present example explaining the averaging strategies to\n 27 |     generalize the metrics for multiclass classifiers.\n 28 | \"\"\"\n 29 | \n 30 | # Authors: The scikit-learn developers\n 31 | # SPDX-License-Identifier: BSD-3-Clause\n 32 | \n 33 | # %%\n 34 | # Load and prepare data\n 35 | # =====================\n 36 | #\n 37 | # We import the :ref:`iris_dataset` which contains 3 classes, each one\n 38 | # corresponding to a type of iris plant. One class is linearly separable from\n 39 | # the other 2; the latter are **not** linearly separable from each other.\n 40 | #\n 41 | # In the following we binarize the dataset by dropping the \"virginica\" class\n 42 | # (`class_id=2`). This means that the \"versicolor\" class (`class_id=1`) is\n 43 | # regarded as the positive class and \"setosa\" as the negative class\n 44 | # (`class_id=0`).\n 45 | \n 46 | import numpy as np\n 47 | \n 48 | from sklearn.datasets import load_iris\n 49 | \n 50 | iris = load_iris()\n 51 | target_names = iris.target_names\n 52 | X, y = iris.data, iris.target\n 53 | X, y = X[y != 2], y[y != 2]\n 54 | n_samples, n_features = X.shape\n 55 | \n 56 | # %%\n 57 | # We also add noisy features to make the problem harder.\n 58 | random_state = np.random.RandomState(0)\n 59 | X = np.concatenate([X, random_state.randn(n_samples, 200 * n_features)], axis=1)\n 60 | \n 61 | # %%\n 62 | # Classification and ROC analysis\n 63 | # -------------------------------\n 64 | #\n 65 | # Here we run a :class:`~sklearn.svm.SVC` classifier with cross-validation and\n 66 | # plot the ROC curves fold-wise. Notice that the baseline to define the chance\n 67 | # level (dashed ROC curve) is a classifier that would always predict the most\n 68 | # frequent class.\n 69 | \n 70 | import matplotlib.pyplot as plt\n 71 | \n 72 | from sklearn import svm\n 73 | from sklearn.metrics import RocCurveDisplay, auc\n 74 | from sklearn.model_selection import StratifiedKFold\n 75 | \n 76 | n_splits = 6\n```\n\nFound `sklearn/utils/_param_validation.py:InvalidParameterError`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | import functools\n  5 | import math\n  6 | import operator\n  7 | import re\n  8 | from abc import ABC, abstractmethod\n  9 | from collections.abc import Iterable\n 10 | from inspect import signature\n 11 | from numbers import Integral, Real\n 12 | \n 13 | import numpy as np\n 14 | from scipy.sparse import csr_matrix, issparse\n 15 | \n 16 | from .._config import config_context, get_config\n 17 | from .validation import _is_arraylike_not_scalar\n 18 | \n 19 | \n 20 | class InvalidParameterError(ValueError, TypeError):\n 21 |     \"\"\"Custom exception to be raised when the parameter of a class/method/function\n 22 |     does not have a valid type or value.\n 23 |     \"\"\"\n 24 | \n 25 |     # Inherits from ValueError and TypeError to keep backward compatibility.\n```\n\n\n\n##Searching for term \"docstring validation\", \"docstring validation check_docstring\"...\n### Search Result:\nFound function `sklearn/utils/validation.py:_use_interchange_protocol`.\nSource: Retrieved entity using keyword search (bm25).\n```\n316 | def _us