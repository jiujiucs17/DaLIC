verter=self.style_converter,\n843 |                             mergestart=mergestart,\n844 |                             mergeend=mergeend,\n845 |                         )\n846 |                     gcolidx += 1\n847 | \n848 |             else:\n849 |                 # Format hierarchical rows with non-merged values.\n850 |                 for indexcolvals in zip(*self.df.index):\n851 |                     for idx, indexcolval in enumerate(indexcolvals):\n852 |                         yield CssExcelCell(\n853 |                             row=self.rowcounter + idx,\n854 |                             col=gcolidx,\n855 |                             val=indexcolval,\n856 |                             style=None,\n857 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n858 |                             css_row=idx,\n859 |                             css_col=gcolidx,\n860 |                             css_converter=self.style_converter,\n861 |                         )\n862 |                     gcolidx += 1\n863 | \n864 |         yield from self._generate_body(gcolidx)\n```\n\n\n\n##Searching for term \"ExcelWriterMergeCells multi_index merge_cells\"...\n### Search Result:\nFound code snippet in file `pandas/io/formats/excel.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | Utilities for conversion to writer-agnostic Excel representation.\n  3 | \"\"\"\n  4 | \n  5 | from __future__ import annotations\n  6 | \n  7 | from collections.abc import (\n  8 |     Callable,\n  9 |     Hashable,\n 10 |     Iterable,\n 11 |     Mapping,\n 12 |     Sequence,\n 13 | )\n 14 | import functools\n 15 | import itertools\n 16 | import re\n 17 | from typing import (\n 18 |     TYPE_CHECKING,\n 19 |     Any,\n 20 |     cast,\n 21 | )\n 22 | import warnings\n 23 | \n 24 | import numpy as np\n 25 | \n 26 | from pandas._libs.lib import is_list_like\n 27 | from pandas.util._decorators import doc\n 28 | from pandas.uti