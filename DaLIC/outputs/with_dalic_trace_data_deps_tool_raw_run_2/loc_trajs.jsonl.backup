ed by different kernels and parameter settings.\n  9 | \n 10 | To create positive examples click the left mouse button; to create\n 11 | negative examples click the right button.\n 12 | \n 13 | If all examples are from the same class, it uses a one-class SVM.\n 14 | \n 15 | \"\"\"\n 16 | \n 17 | print(__doc__)\n 18 | \n 19 | # Author: Peter Prettenhoer <peter.prettenhofer@gmail.com>\n 20 | #\n 21 | # License: BSD 3 clause\n 22 | \n 23 | import matplotlib\n 24 | matplotlib.use('TkAgg')\n 25 | from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\n 26 | try:\n 27 |     from matplotlib.backends.backend_tkagg import NavigationToolbar2Tk\n 28 | except ImportError:\n 29 |     # NavigationToolbar2TkAgg was deprecated in matplotlib 2.2\n 30 |     from matplotlib.backends.backend_tkagg import (\n 31 |         NavigationToolbar2TkAgg as NavigationToolbar2Tk\n 32 |     )\n 33 | from matplotlib.figure import Figure\n 34 | from matplotlib.contour import ContourSet\n 35 | \n 36 | import sys\n 37 | import numpy as np\n 38 | import tkinter as Tk\n 39 | \n 40 | from sklearn import svm\n 41 | from sklearn.datasets import dump_svmlight_file\n 42 | \n 43 | y_min, y_max = -50, 50\n 44 | x_min, x_max = -50, 50\n```\n\nFound function `sklearn/utils/__init__.py:check_matplotlib_support`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1085 | def check_matplotlib_support(caller_name):\n1086 |     \"\"\"Raise ImportError with detailed error message if mpl is not installed.\n1087 | \n1088 |     Plot utilities like :func:`plot_partial_dependence` should lazily import\n1089 |     matplotlib and call this helper before any computation.\n1090 | \n1091 |     Parameters\n1092 |     ----------\n1093 |     caller_name : str\n1094 |         The name of the caller that requires matplotlib.\n1095 |     \"\"\"\n1096 |     try:\n1097 |         import matplotlib  # noqa\n1098 |     except ImportError as e:\n1099 |         raise ImportError(\n1100 |             \"{} requires matplotli