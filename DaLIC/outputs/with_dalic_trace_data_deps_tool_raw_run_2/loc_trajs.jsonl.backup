.coolwarm\n 24 | n_splits = 4\n 25 | \n 26 | # %%\n 27 | # Visualize our data\n 28 | # ------------------\n 29 | #\n 30 | # First, we must understand the structure of our data. It has 100 randomly\n 31 | # generated input datapoints, 3 classes split unevenly across datapoints,\n 32 | # and 10 \"groups\" split evenly across datapoints.\n 33 | #\n 34 | # As we'll see, some cross-validation objects do specific things with\n 35 | # labeled data, others behave differently with grouped data, and others\n 36 | # do not use this information.\n 37 | #\n 38 | # To begin, we'll visualize our data.\n 39 | \n 40 | # Generate the class/group data\n 41 | n_points = 100\n 42 | X = np.random.randn(100, 10)\n 43 | \n 44 | percentiles_classes = [.1, .3, .6]\n 45 | y = np.hstack([[ii] * int(100 * perc)\n 46 |                for ii, perc in enumerate(percentiles_classes)])\n 47 | \n 48 | # Evenly spaced groups repeated once\n 49 | groups = np.hstack([[ii] * 10 for ii in range(10)])\n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =======================================\n  3 | Visualizing the stock market structure\n  4 | =======================================\n  5 | \n  6 | This example employs several unsupervised learning techniques to extract\n  7 | the stock market structure from variations in historical quotes.\n  8 | \n  9 | The quantity that we use is the daily variation in quote price: quotes\n 10 | that are linked tend to cofluctuate during a day.\n 11 | \n 12 | .. _stock_market:\n 13 | \n 14 | Learning a graph structure\n 15 | --------------------------\n 16 | \n 17 | We use sparse inverse covariance estimation to find which quotes are\n 18 | correlated conditionally on the others. Specifically, sparse inverse\n 19 | covariance gives us a graph, that is a list of connection. For each\n 20 | symbol, the symbols that it is connected too are those useful to explain\n 21 | its fluctuations.\n 22 | \n 23 | Clustering\n 24 | ----------\n 25 | \n 26 | We use clustering to group together quotes that behave similarly. Here,\n 27 | amongst the :ref:`various clustering techniques <clustering>` available\n 28 | in the scikit-learn, we use :ref:`affinity_propagation` as it does\n 29 | not enforce equal-size clusters, and it can choose automatically the\n 30 | number of clusters from the data.\n 31 | \n 32 | Note that this gives us a different indication than the graph, as the\n 33 | graph reflects conditional relations between variables, while the\n 34 | clustering reflects marginal properties: variables clustered together can\n 35 | be considered as having a similar impact at the level of the full stock\n 36 | market.\n 37 | \n 38 | Embedding in 2D space\n 39 | ---------------------\n 40 | \n 41 | For visualization purposes, we need to lay out the different symbols on a\n 42 | 2D canvas. For this we use :ref:`manifold` techniques to retrieve 2D\n 43 | embedding.\n 44 | \n 45 | \n 46 | Visualization\n 47 | -------------\n 48 | \n 49 | The output of the 3 models are combined in a 2D graph where nodes\n 50 | represents the stocks and edges the:\n 51 | \n 52 | - cluster labels are used to define the color of the nodes\n 53 | - the sparse covariance model is used to display the strength of the edges\n 54 | - the 2D embedding is used to position the nodes in the plan\n 55 | \n 56 | This example has a fair amount of visualization-related code, as\n 57 | visualization is crucial here to display the graph. One of the challenge\n 58 | is to position the labels minimizing overlap. For this we use an\n 59 | heuristic based on the direction of the nearest neighbor along each\n 60 | axis.\n 61 | \"\"\"\n 62 | \n 63 | # Author: Gael Varoquaux gael.varoquaux@normalesup.org\n 64 | # License: BSD 3 clause\n 65 | \n 66 | import sys\n 67 | \n 68 | import numpy as np\n 69 | import matplotlib.pyplot as plt\n 70 | from matplotlib.collections import LineCollection\n 71 | \n 72 | import pandas as pd\n 73 | \n 74 | from sklearn import cluster, covariance, manifold\n 75 | \n 76 | print(__doc__)\n 77 | \n 78 | \n 79 | # #############################################################################\n 80 | # Retrieve the data from Internet\n 81 | \n 82 | # The data is from 2003 - 2008. This is reasonably calm: (not too long ago so\n 83 | # that we get high-tech firms, and before the 2008 crash). This kind of\n 84 | # historical data can be obtained for from APIs like the quandl.com and\n 85 | # alphavantage.co ones.\n```\n\nFound code snippet in file `examples/miscellaneous/plot_roc_curve_visualization_api.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ================================\n 3 | ROC Curve with Visualization API\n 4 | ================================\n 5 | Scikit-learn defines a simple API for creating visualizations for machine\n 6 | learning. The key features of this API is to allow for quick plotting and\n 7 | visual adjustments without recalculation. In this example, we will demonstrate\n 8 | how to use the visualization API by comparing ROC curves.\n 9 | \"\"\"\n10 | print(__doc__)\n11 | \n12 | # %%\n13 | # Load Data and Train a SVC\n14 | # -------------------------\n15 | # First, we load the wine dataset and convert it to a binary classification\n16 | # problem. Then, we train a support vector classifier on a training dataset.\n17 | import matplotlib.pyplot as plt\n18 | from sklearn.svm import SVC\n19 | from sklearn.ensemble import RandomForestClassifier\n20 | from sklearn.metrics import plot_roc_curve\n21 | from sklearn.datasets import load_wine\n22 | from sklearn.model_selection import train_test_split\n23 | \n24 | X, y = load_wine(return_X_y=True)\n25 | y = y == 2\n26 | \n27 | X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)\n28 | svc = SVC(random_state=42)\n29 | svc.fit(X_train, y_train)\n30 | \n31 | # %%\n32 | # Plotting the ROC Curve\n33 | # ----------------------\n34 | # Next, we plot the ROC curve with a single call to\n35 | # :func:`sklearn.metrics.plot_roc_curve`. The returned `svc_disp` object allows\n36 | # us to continue using the already computed ROC curve for the SVC in future\n37 | # plots.\n38 | svc_disp = plot_roc_curve(svc, X_test, y_test)\n39 | plt.show()\n40 | \n41 | # %%\n42 | # Training a Random Forest and Plotting the ROC Curve\n43 | # --------------------------------------------------------\n44 | # We train a random forest classifier and create a plot comparing it to the SVC\n45 | # ROC curve. Notice how `svc_disp` uses\n46 | # :func:`~sklearn.metrics.RocCurveDisplay.plot` to plot the SVC ROC curve\n47 | # without recomputing the values of the roc curve itself. Furthermore, we\n48 | # pass `alpha=0.8` to the plot functions to adjust the alpha values of the\n49 | # curves.\n50 | rfc = RandomForestClassifier(n_estimators=10, random_state=42)\n51 | rfc.fit(X_train, y_train)\n52 | ax = plt.gca()\n53 | rfc_disp = plot_roc_curve(rfc, X_test, y_test, ax=ax, alpha=0.8)\n54 | svc_disp.plot(ax=ax, alpha=0.8)\n55 | plt.show()\n56 | \n```\n\nFound function `examples/model_selection/plot_cv_indices.py:plot_cv_indices`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 75 | def plot_cv_indices(cv, X, y, group, ax, n_splits, lw=10):\n 76 |     \"\"\"Create a sample plot for indices of a cross-validation object.\"\"\"\n 77 | \n 78 |     # Generate the training/testing visualizations for each CV split\n 79 |     for ii, (tr, tt) in enumerate(cv.split(X=X, y=y, groups=group)):\n 80 |         # Fill in indices with the training/test groups\n 81 |         indices = np.array([np.nan] * len(X))\n 82 |         indices[tt] = 1\n 83 |         indices[tr] = 0\n 84 | \n 85 |         # Visualize the results\n 86 |         ax.scatter(range(len(indices)), [ii + .5] * len(indices),\n 87 |                    c=indices, marker='_', lw=lw, cmap=cmap_cv,\n 88 |                    vmin=-.2, vmax=1.2)\n 89 | \n 90 |     # Plot the data classes and groups at the end\n 91 |     ax.scatter(range(len(X)), [ii + 1.5] * len(X),\n 92 |                c=y, marker='_', lw=lw, cmap=cmap_data)\n 93 | \n 94 |     ax.scatter(range(len(X)), [ii + 2.5] * len(X),\n 95 |                c=group, marker='_', lw=lw, cmap=cmap_data)\n 96 | \n 97 |     # Formatting\n 98 |     yticklabels = list(range(n_splits)) + ['class', 'group']\n 99 |     ax.set(yticks=np.arange(n_splits+2) + .5, yticklabels=yticklabels,\n100 |            xlabel='Sample index', ylabel=\"CV iteration\",\n101 |            ylim=[n_splits+2.2, -.2], xlim=[0, 100])\n102 |     ax.set_title('{}'.format(type(cv).__name__), fontsize=15)\n103 |     return ax\n```\n\n\n\n##Searching for term \"visualization\", \"matplotlib visualization\"...\n### Search Result:\nFound file `examples/miscellaneous/plot_roc_curve_visualization_api.py`.\nFound file `examples/miscellaneous/plot_partial_dependence_visualization_api.py`.\nFound file `examples/miscellaneous/plot_display_object_visualization.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"matplotlib visualization\"...\n### Search Result:\nFound `sklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | from .base import _get_response\n  2 | \n  3 | from .. import average_precision_score\n  4 | from .. import precision_recall_curve\n  5 | \n  6 | from ...utils import check_matplotlib_support\n  7 | \n  8 | \n  9 | class PrecisionRecallDisplay:\n 10 |     \"\"\"Precision Recall visualization.\n 11 | \n 12 |     It is recommend to use :func:`~sklearn.metrics.plot_precision_recall_curve`\n 13 |     to create a visualizer. All parameters are stored as attributes.\n 14 | \n 15 |     Read more in the :ref:`User Guide <visualizations>`.\n 16 | \n 17 |     Parameters\n 18 |     -----------\n 19 |     precision : ndarray\n 20 |         Precision values.\n 21 | \n 22 |     recall : ndarray\n 23 |         Recall values.\n 24 | \n 25 |     average_precision : float, default=None\n 26 |         Average precision. If None, the average precision is not shown.\n 27 | \n 28 |     estimator_name : str, default=None\n 29 |         Name of estimator. If None, then the estimator name is not shown.\n 30 | \n 31 |     pos_label : str or int, default=None\n 32 |         The class considered as the positive class. If None, the class will not\n 33 |         be shown in the legend.\n 34 | \n 35 |         .. versionadded:: 0.24\n 36 | \n 37 |     Attributes\n 38 |     ----------\n 39 |     line_ : matplotlib Artist\n 40 |         Precision recall curve.\n 41 | \n 42 |     ax_ : matplotlib Axes\n 43 |         Axes with precision recall curve.\n 44 | \n 45 |     figure_ : matplotlib Figure\n 46 |         Figure containing the curve.\n 47 | \n 48 |     See Also\n 49 |     --------\n 50 |     precision_recall_curve : Compute precision-recall pairs for different\n 51 |         probability thresholds.\n 52 |     plot_precision_recall_curve : Plot Precision Recall Curve for binary\n 53 |         classifiers.\n 54 | \n 55 |     Examples\n 56 |     --------\n 57 |     >>> import matplotlib.pyplot as plt\n 58 |     >>> from sklearn.datasets import make_classification\n 59 |     >>> from sklearn.metrics import (precision_recall_curve,\n 60 |     ...                              PrecisionRecallDisplay)\n 61 |     >>> from sklearn.model_selection import train_test_split\n 62 |     >>> from sklearn.svm import SVC\n 63 |     >>> X, y = make_classification(random_state=0)\n 64 |     >>> X_train, X_test, y_train, y_test = train_test_split(X, y,\n 65 |     ...                                                     random_state=0)\n 66 |     >>> clf = SVC(random_state=0)\n 67 |     >>> clf.fit(X_train, y_train)\n 68 |     SVC(random_state=0)\n 69 |     >>> predictions = clf.predict(X_test)\n 70 |     >>> precision, recall, _ = precision_recall_curve(y_test, predictions)\n 71 |     >>> disp = PrecisionRecallDisplay(precision=precision, recall=recall)\n 72 |     >>> disp.plot()\n 73 |     <...>\n 74 |     >>> plt.show()\n 75 |     \"\"\"\n```\nHint: \nThe code for class `sklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay` is incomplete; search `sklearn/metrics/_plot/precision_recall_curve.py:PrecisionRecallDisplay` for the full content if needed.\n\nFound code snippet in file `examples/model_selection/plot_cv_indices.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | Visualizing cross-validation behavior in scikit-learn\n  3 | =====================================================\n  4 | \n  5 | Choosing the right cross-validation object is a crucial part of fitting a\n  6 | model properly. There are many ways to split data into training and test\n  7 | sets in order to avoid model overfitting, to standardize the number of\n  8 | groups in test sets, etc.\n  9 | \n 10 | This example visualizes the behavior of several common scikit-learn objects\n 11 | for comparison.\n 12 | \"\"\"\n 13 | \n 14 | from sklearn.model_selection import (TimeSeriesSplit, KFold, ShuffleSplit,\n 15 |                                      StratifiedKFold, GroupShuffleSplit,\n 16 |                                      GroupKFold, StratifiedShuffleSplit,\n 17 |                                      StratifiedGroupKFold)\n 18 | import numpy as np\n 19 | import matplotlib.pyplot as plt\n 20 | from matplotlib.patches import Patch\n 21 | np.random.seed(1338)\n 22 | cmap_data = plt.cm.Paired\n 23 | cmap_cv = plt.cm.coolwarm\n 24 | n_splits = 4\n 25 | \n 26 | # %%\n 27 | # Visualize our data\n 28 | # ------------------\n 29 | #\n 30 | # First, we must understand the structure of our data. It has 100 randomly\n 31 | # generated input datapoints, 3 classes split unevenly across datapoints,\n 32 | # and 10 \"groups\" split evenly across datapoints.\n 33 | #\n 34 | # As we'll see, some cross-validation objects do specific things with\n 35 | # labeled data, others behave differently with grouped data, and others\n 36 | # do not use this information.\n 37 | #\n 38 | # To begin, we'll visualize our data.\n 39 | \n 40 | # Generate the class/group data\n 41 | n_points = 100\n 42 | X = np.random.randn(100, 10)\n 43 | \n 44 | percentiles_classes = [.1, .3, .6]\n 45 | y = np.hstack([[ii] * int(100 * perc)\n 46 |                for ii, perc in enumerate(percentiles_classes)])\n 47 | \n 48 | # Evenly spaced groups repeated once\n 49 | groups = np.hstack([[ii] * 10 for ii in range(10)])\n```\n\nFound `sklearn/metrics/_plot/roc_curve.py:RocCurveDisplay`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | from .base import _get_response\n  2 | \n  3 | from .. import auc\n  4 | from .. import roc_curve\n  5 | \n  6 | from ...utils import check_matplotlib_support\n  7 | \n  8 | \n  9 | class RocCurveDisplay:\n 10 |     \"\"\"ROC Curve visualization.\n 11 | \n 12 |     It is recommend to use :func:`~sklearn.metrics.plot_roc_curve` to create a\n 13 |     visualizer. All parameters are stored as attributes.\n 14 | \n 15 |     Read more in the :ref:`User Guide <visualizations>`.\n 16 | \n 17 |     Parameters\n 18 |     ----------\n 19 |     fpr : ndarray\n 20 |         False positive rate.\n 21 | \n 22 |     tpr : ndarray\n 23 |         True positive rate.\n 24 | \n 25 |     roc_auc : float, default=None\n 26 |         Area under ROC curve. If None, the roc_auc score is not shown.\n 27 | \n 28 |     estimator_name : str, default=None\n 29 |         Name of estimator. If None, the estimator name is not shown.\n 30 | \n 31 |     pos_label : str or int, default=None\n 32 |         The class considered as the positive class when computing the roc auc\n 33 |         metrics. By default, `estimators.classes_[1]` is considered\n 34 |         as the positive class.\n 35 | \n 36 |         .. versionadded:: 0.24\n 37 | \n 38 |     Attributes\n 39 |     ----------\n 40 |     line_ : matplotlib Artist\n 41 |         ROC Curve.\n 42 | \n 43 |     ax_ : matplotlib Axes\n 44 |         Axes with ROC Curve.\n 45 | \n 46 |     figure_ : matplotlib Figure\n 47 |         Figure containing the curve.\n 48 | \n 49 |     See Also\n 50 |     --------\n 51 |     roc_curve : Compute Receiver operating characteristic (ROC) curve.\n 52 |     plot_roc_curve : Plot Receiver operating characteristic (ROC) curve.\n 53 |     roc_auc_score : Compute the area under the ROC curve.\n 54 | \n 55 |     Examples\n 56 |     --------\n 57 |     >>> import matplotlib.pyplot as plt\n 58 |     >>> import numpy as np\n 59 |     >>> from sklearn import metrics\n 60 |     >>> y = np.array([0, 0, 1, 1])\n 61 |     >>> pred = np.array([0.1, 0.4, 0.35, 0.8])\n 62 |     >>> fpr, tpr, thresholds = metrics.roc_curve(y, pred)\n 63 |     >>> roc_auc = metrics.auc(fpr, tpr)\n 64 |     >>> display = metrics.RocCurveDisplay(fpr=fpr, tpr=tpr, roc_auc=roc_auc,\\\n 65 |                                           estimator_name='example estimator')\n 66 |     >>> display.plot()\n 67 |     <...>\n 68 |     >>> plt.show()\n 69 |     \"\"\"\n 70 | \n 71 |     def __init__(self, *, fpr, tpr, roc_auc=None, estimator_name=None, pos_label=None):\n 72 |         self.estimator_name = estimator_name\n 73 |         self.fpr = fpr\n 74 |         self.tpr = tpr\n 75 |         self.roc_auc = roc_auc\n 76 |         self.pos_label = pos_label\n```\nHint: \nThe code for class `sklearn/metrics/_plot/roc_curve.py:RocCurveDisplay` is incomplete; search `sklearn/metrics/_plot/roc_curve.py:RocCurveDisplay` for the full content if needed.\n\nFound `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | import scipy as sp\n  2 | \n  3 | from .base import _get_response\n  4 | \n  5 | from .. import det_curve\n  6 | from .._base import _check_pos_label_consistency\n  7 | \n  8 | from ...utils import check_matplotlib_support\n  9 | from ...utils import deprecated\n 10 | \n 11 | \n 12 | class DetCurveDisplay:\n 13 |     \"\"\"DET curve visualization.\n 14 | \n 15 |     It is recommend to use :func:`~sklearn.metrics.DetCurveDisplay.from_estimator`\n 16 |     or :func:`~sklearn.metrics.DetCurveDisplay.from_predictions` to create a\n 17 |     visualizer. All parameters are stored as attributes.\n 18 | \n 19 |     Read more in the :ref:`User Guide <visualizations>`.\n 20 | \n 21 |     .. versionadded:: 0.24\n 22 | \n 23 |     Parameters\n 24 |     ----------\n 25 |     fpr : ndarray\n 26 |         False positive rate.\n 27 | \n 28 |     fnr : ndarray\n 29 |         False negative rate.\n 30 | \n 31 |     estimator_name : str, default=None\n 32 |         Name of estimator. If None, the estimator name is not shown.\n 33 | \n 34 |     pos_label : str or int, default=None\n 35 |         The label of the positive class.\n 36 | \n 37 |     Attributes\n 38 |     ----------\n 39 |     line_ : matplotlib Artist\n 40 |         DET Curve.\n 41 | \n 42 |     ax_ : matplotlib Axes\n 43 |         Axes with DET Curve.\n 44 | \n 45 |     figure_ : matplotlib Figure\n 46 |         Figure containing the curve.\n 47 | \n 48 |     See Also\n 49 |     --------\n 50 |     det_curve : Compute error rates for different probability thresholds.\n 51 |     DetCurveDisplay.from_estimator : Plot DET curve given an estimator and\n 52 |         some data.\n 53 |     DetCurveDisplay.from_predictions : Plot DET curve given the true and\n 54 |         predicted labels.\n 55 | \n 56 |     Examples\n 57 |     --------\n 58 |     >>> import matplotlib.pyplot as plt\n 59 |     >>> from sklearn.datasets import make_classification\n 60 |     >>> from sklearn.metrics import det_curve, DetCurveDisplay\n 61 |     >>> from sklearn.model_selection import train_test_split\n 62 |     >>> from sklearn.svm import SVC\n 63 |     >>> X, y = make_classification(n_samples=1000, random_state=0)\n 64 |     >>> X_train, X_test, y_train, y_test = train_test_split(\n 65 |     ...     X, y, test_size=0.4, random_state=0)\n 66 |     >>> clf = SVC(random_state=0).fit(X_train, y_train)\n 67 |     >>> y_pred = clf.decision_function(X_test)\n 68 |     >>> fpr, fnr, _ = det_curve(y_test, y_pred)\n 69 |     >>> display = DetCurveDisplay(\n 70 |     ...     fpr=fpr, fnr=fnr, estimator_name=\"SVC\"\n 71 |     ... )\n 72 |     >>> display.plot()\n 73 |     <...>\n 74 |     >>> plt.show()\n 75 |     \"\"\"\n 76 | \n 77 |     def __init__(self, *, fpr, fnr, estimator_name=None, pos_label=None):\n 78 |         self.fpr = fpr\n 79 |         self.fnr = fnr\n 80 |         self.estimator_name = estimator_name\n 81 |         self.pos_label = pos_label\n```\nHint: \nThe code for class `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay` is incomplete; search `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay` for the full content if needed.\n\nFound code snippet in file `examples/applications/svm_gui.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ==========\n  3 | Libsvm GUI\n  4 | ==========\n  5 | \n  6 | A simple graphical frontend for Libsvm mainly intended for didactic\n  7 | purposes. You can create data points by point and click and visualize\n  8 | the decision region induced by different kernels and parameter settings.\n  9 | \n 10 | To create positive examples click the left mouse button; to create\n 11 | negative examples click the right button.\n 12 | \n 13 | If all examples are from the same class, it uses a one-class SVM.\n 14 | \n 15 | \"\"\"\n 16 | \n 17 | print(__doc__)\n 18 | \n 19 | # Author: Peter Prettenhoer <peter.prettenhofer@gmail.com>\n 20 | #\n 21 | # License: BSD 3 clause\n 22 | \n 23 | import matplotlib\n 24 | matplotlib.use('TkAgg')\n 25 | from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\n 26 | try:\n 27 |     from matplotlib.backends.backend_tkagg import NavigationToolbar2Tk\n 28 | except ImportError:\n 29 |     # NavigationToolbar2TkAgg was d