98 | \n199 | def _has_bool_dtype(x):\n200 |     try:\n201 |         return x.dtype == bool\n202 |     except AttributeError:\n203 |         return isinstance(x, (bool, np.bool_))\n204 | \n205 | \n206 | _BOOL_OP_UNSUPPORTED = {\"+\": \"|\", \"*\": \"&\", \"-\": \"^\"}\n207 | \n208 | \n209 | def _bool_arith_fallback(op_str, a, b) -> bool:\n210 |     \"\"\"\n211 |     Check if we should fallback to the python `_evaluate_standard` in case\n212 |     of an unsupported operation by numexpr, which is the case for some\n213 |     boolean ops.\n214 |     \"\"\"\n215 |     if _has_bool_dtype(a) and _has_bool_dtype(b):\n216 |         if op_str in _BOOL_OP_UNSUPPORTED:\n217 |             warnings.warn(\n218 |                 f\"evaluating in Python space because the {op_str!r} \"\n219 |                 \"operator is not supported by numexpr for the bool dtype, \"\n220 |                 f\"use {_BOOL_OP_UNSUPPORTED[op_str]!r} instead.\",\n221 |                 stacklevel=find_stack_level(),\n222 |             )\n223 |             return True\n224 |     return False\n225 | \n226 | \n227 | def evaluate(op, a, b, use_numexpr: bool = True):\n228 |     \"\"\"\n229 |     Evaluate and return the expression of the op on a and b.\n230 | \n231 |     Parameters\n232 |     ----------\n233 |     op : the actual operand\n234 |     a : left operand\n235 |     b : right operand\n236 |     use_numexpr : bool, default True\n237 |         Whether to try to use numexpr.\n238 |     \"\"\"\n239 |     op_str = _op_str_mapping[op]\n240 |     if op_str is not None:\n241 |         if use_numexpr:\n242 |             # error: \"None\" not callable\n243 |             return _evaluate(op, op_str, a, b)  # type: ignore[misc]\n244 |     return _evaluate_standard(op, op_str, a, b)\n245 | \n246 | \n247 | def where(cond, a, b, use_numexpr: bool = True):\n248 |     \"\"\"\n249 |     Evaluate the where condition cond on a and b.\n250 | \n251 |     Parameters\n252 |     ----------\n253 |     cond : np.ndarray[bool]\