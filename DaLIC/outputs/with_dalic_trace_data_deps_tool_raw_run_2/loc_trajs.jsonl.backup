teBuffer[str] | None = None,\n2320 |         *,\n2321 |         orient: Literal[\"split\", \"records\", \"index\", \"table\", \"columns\", \"values\"]\n2322 |         | None = None,\n2323 |         date_format: str | None = None,\n2324 |         double_precision: int = 10,\n2325 |         force_ascii: bool = True,\n2326 |         date_unit: TimeUnit = \"ms\",\n2327 |         default_handler: Callable[[Any], JSONSerializable] | None = None,\n2328 |         lines: bool = False,\n2329 |         compression: CompressionOptions = \"infer\",\n2330 |         index: bool | None = None,\n2331 |         indent: int | None = None,\n2332 |         storage_options: StorageOptions | None = None,\n2333 |         mode: Literal[\"a\", \"w\"] = \"w\",\n2334 |     ) -> str | None:\n2335 |         \"\"\"\n2336 |         Convert the object to a JSON string.\n2337 | \n2338 |         Note NaN's and None will be converted to null and datetime objects\n2339 |         will be converted to UNIX timestamps.\n2340 | \n2341 |         Parameters\n2342 |         ----------\n2343 |         path_or_buf : str, path object, file-like object, or None, default None\n2344 |             String, path object (implementing os.PathLike[str]), or file-like\n2345 |             object implementing a write() function. If None, the result is\n2346 |             returned as a string.\n2347 |         orient : str\n2348 |             Indication of expected JSON string format.\n2349 | \n2350 |             * Series:\n2351 | \n2352 |                 - default is 'index'\n2353 |                 - allowed values are: {{'split', 'records', 'index', 'table'}}.\n2354 | \n2355 |             * DataFrame:\n2356 | \n2357 |                 - default is 'columns'\n2358 |                 - allowed values are: {{'split', 'records', 'index', 'columns',\n2359 |                   'values', 'table'}}.\n2360 | \n2361 |             * The format of the JSON string:\n2362 | \n2363 |                 - 'split' : dict like {{'index' -> [index]