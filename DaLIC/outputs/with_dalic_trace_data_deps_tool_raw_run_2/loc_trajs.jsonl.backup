span_val - 1\n833 |                             mergeend = gcolidx\n834 |                         yield CssExcelCell(\n835 |                             row=self.rowcounter + i,\n836 |                             col=gcolidx,\n837 |                             val=values[i],\n838 |                             style=None,\n839 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n840 |                             css_row=i,\n841 |                             css_col=gcolidx,\n842 |                             css_converter=self.style_converter,\n843 |                             mergestart=mergestart,\n844 |                             mergeend=mergeend,\n845 |                         )\n846 |                     gcolidx += 1\n847 | \n848 |             else:\n849 |                 # Format hierarchical rows with non-merged values.\n850 |                 for indexcolvals in zip(*self.df.index):\n851 |                     for idx, indexcolval in enumerate(indexcolvals):\n852 |                         yield CssExcelCell(\n853 |                             row=self.rowcounter + idx,\n854 |                             col=gcolidx,\n855 |                             val=indexcolval,\n856 |                             style=None,\n857 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n858 |                             css_row=idx,\n859 |                             css_col=gcolidx,\n860 |                             css_converter=self.style_converter,\n861 |                         )\n862 |                     gcolidx += 1\n863 | \n864 |         yield from self._generate_body(gcolidx)\n```\n\nFound file `asv_bench/benchmarks/join_merge.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `asv_bench/benchmarks/join_merge.py` for the full content if needed.\n"}, {"content": "Based on the analysis of the code and issue, I can now provide the locations that need documentation updates. The issu