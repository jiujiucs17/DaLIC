".join(lines)\n721 | \n722 |         templates = [\n723 |             \"\"\".. rubric:: Attributes\n724 | \n725 | .. autosummary::\n726 |    :toctree:\n727 | \n728 |    None\n729 | \"\"\",\n730 |             \"\"\".. rubric:: Methods\n731 | \n732 | .. autosummary::\n733 |    :toctree:\n734 | \n735 |    None\n736 | \"\"\",\n737 |         ]\n738 | \n739 |         for template in templates:\n740 |             if template in joined:\n741 |                 joined = joined.replace(template, \"\")\n742 |         lines[:] = joined.split(\"\\n\")\n```\n\nFound function `doc/source/conf.py:rstjinja`.\nSource: Retrieved entity using keyword search (bm25).\n```\n781 | def rstjinja(app, docname, source) -> None:\n782 |     \"\"\"\n783 |     Render our pages as a jinja template for fancy templating goodness.\n784 |     \"\"\"\n785 |     # https://www.ericholscher.com/blog/2016/jul/25/integrating-jinja-rst-sphinx/\n786 |     # Make sure we're outputting HTML\n787 |     if app.builder.format != \"html\":\n788 |         return\n789 |     src = source[0]\n790 |     rendered = app.builder.templates.render_string(src, app.config.html_context)\n791 |     source[0] = rendered\n```\n\nFound function `doc/source/conf.py:setup`.\nSource: Retrieved entity using keyword search (bm25).\n```\n794 | def setup(app) -> None:\n795 |     app.connect(\"source-read\", rstjinja)\n796 |     app.connect(\"autodoc-process-docstring\", remove_flags_docstring)\n797 |     app.connect(\"autodoc-process-docstring\", process_class_docstrings)\n798 |     app.connect(\"autodoc-process-docstring\", process_business_alias_docstrings)\n799 |     app.add_autodocumenter(AccessorDocumenter)\n800 |     app.add_autodocumenter(AccessorAttributeDocumenter)\n801 |     app.add_autodocumenter(AccessorMethodDocumenter)\n802 |     app.add_autodocumenter(AccessorCallableDocumenter)\n803 |     app.add_directive(\"autosummary\", PandasAutosummary)\n```\n\nFound function `doc/make.py:DocBuilder._process_single_doc`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 72 | def _process_single_doc(self, single_doc):\n 73 |         \"\"\"\n 74 |         Make sure the provided value for --single is a path to an existing\n 75 |         .rst/.ipynb file, or a pandas object that can be imported.\n 76 | \n 77 |         For example, categorial.rst or pandas.DataFrame.head. For the latter,\n 78 |         return the corresponding file path\n 79 |         (e.g. reference/api/pandas.DataFrame.head.rst).\n 80 |         \"\"\"\n 81 |         base_name, extension = os.path.splitext(single_doc)\n 82 |         if extension in (\".rst\", \".ipynb\"):\n 83 |             if os.path.exists(os.path.join(SOURCE_PATH, single_doc)):\n 84 |                 return single_doc\n 85 |             else:\n 86 |                 raise FileNotFoundError(f\"File {single_doc} not found\")\n 87 | \n 88 |         elif single_doc.startswith(\"pandas.\"):\n 89 |             try:\n 90 |                 obj = pandas  # noqa: F821\n 91 |                 for name in single_doc.split(\".\"):\n 92 |                     obj = getattr(obj, name)\n 93 |             except AttributeError as err:\n 94 |                 raise ImportError(f\"Could not import {single_doc}\") from err\n 95 |             else:\n 96 |                 return single_doc[len(\"pandas.\") :]\n 97 |         else:\n 98 |             raise ValueError(\n 99 |                 f\"--single={single_doc} not understood. \"\n100 |                 \"Value should be a valid path to a .rst or .ipynb file, \"\n101 |                 \"or a valid pandas object \"\n102 |                 \"(e.g. categorical.rst or pandas.DataFrame.head)\"\n103 |             )\n```\n\nFound file `doc/source/conf.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `doc/source/conf.py` for the full content if needed.\n"}, {"content": "Let me get the actual content of the interpolation documentation:\n\n<function=get_entity_contents>\n<parameter=entity_names>['doc/source/