his comment\n506 |         unnecessary_permutations = [mapping.pop(-1)]\n507 |         # permute types of objects\n508 |         types = defaultdict(list)\n509 |         for i in mapping:\n510 |             e, _ = i\n511 |             types[type(e)].append(i)\n512 |         mapping = [types[i] for i in types]\n513 |         def _iter_mappings():\n514 |             for i in permutations(mapping):\n515 |                 # make the expression of a given type be ordered\n516 |                 yield [j for i in i for j in ordered(i)]\n517 |         mappings = _iter_mappings()\n518 |     else:\n519 |         unnecessary_permutations = unnecessary_permutations or []\n520 | \n521 |     def _substitute(expr):\n522 |         return expr.subs(mapping)\n523 | \n524 |     for mapping in mappings:\n525 |         mapping = list(mapping)\n526 |         mapping = mapping + unnecessary_permutations\n527 |         diffs = [ _substitute(dcache.get_diff(g)) for g in terms ]\n528 |         denoms = [ g.as_numer_denom()[1] for g in diffs ]\n529 |         if all(h.is_polynomial(*V) for h in denoms) and _substitute(f).is_rational_function(*V):\n530 |             denom = reduce(lambda p, q: lcm(p, q, *V), denoms)\n531 |             break\n532 |     else:\n533 |         if not rewrite:\n534 |             result = heurisch(f, x, rewrite=True, hints=hints,\n535 |                 unnecessary_permutations=unnecessary_permutations)\n536 | \n537 |             if result is not None:\n538 |                 return indep*result\n539 |         return None\n540 | \n541 |     numers = [ cancel(denom*g) for g in diffs ]\n542 |     def _derivation(h):\n543 |         return Add(*[ d * h.diff(v) for d, v in zip(numers, V) ])\n544 | \n545 |     def _deflation(p):\n546 |         for y in V:\n547 |             if not p.has(y):\n548 |                 continue\n549 | \n550 |             if _derivation(p) is not S.Zero:\n551 |                 c, q = p.as_poly(y).primitive()\n552 |                 return _deflation(