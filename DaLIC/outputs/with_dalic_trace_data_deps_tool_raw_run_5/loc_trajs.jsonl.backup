      hints   -> a list of functions that may appear in anti-derivate\n334 | \n335 |           - hints = None          --> no suggestions at all\n336 |           - hints = [ ]           --> try to figure out\n337 |           - hints = [f1, ..., fn] --> we know better\n338 | \n339 |     Examples\n340 |     ========\n341 | \n342 |     >>> from sympy import tan\n343 |     >>> from sympy.integrals.heurisch import heurisch\n344 |     >>> from sympy.abc import x, y\n345 | \n346 |     >>> heurisch(y*tan(x), x)\n347 |     y*log(tan(x)**2 + 1)/2\n348 | \n349 |     See Manuel Bronstein's \"Poor Man's Integrator\":\n350 | \n351 |     References\n352 |     ==========\n353 | \n354 |     .. [1] https://www-sop.inria.fr/cafe/Manuel.Bronstein/pmint/index.html\n355 | \n356 |     For more information on the implemented algorithm refer to:\n357 | \n358 |     .. [2] K. Geddes, L. Stefanus, On the Risch-Norman Integration\n359 |        Method and its Implementation in Maple, Proceedings of\n360 |        ISSAC'89, ACM Press, 212-217.\n361 | \n362 |     .. [3] J. H. Davenport, On the Parallel Risch Algorithm (I),\n363 |        Proceedings of EUROCAM'82, LNCS 144, Springer, 144-157.\n364 | \n365 |     .. [4] J. H. Davenport, On the Parallel Risch Algorithm (III):\n366 |        Use of Tangents, SIGSAM Bulletin 16 (1982), 3-6.\n367 | \n368 |     .. [5] J. H. Davenport, B. M. Trager, On the Parallel Risch\n369 |        Algorithm (II), ACM Transactions on Mathematical\n370 |        Software 11 (1985), 356-362.\n371 | \n372 |     See Also\n373 |     ========\n374 | \n375 |     sympy.integrals.integrals.Integral.doit\n376 |     sympy.integrals.integrals.Integral\n377 |     sympy.integrals.heurisch.components\n378 |     \"\"\"\n379 |     f = sympify(f)\n380 | \n381 |     # There are some functions that Heurisch cannot currently handle,\n382 |     # so do not even try.\n383 |     # Set _try_heurisch=True to skip this check\n384 |     if _try_heurisch is not True:\n385 |         if f.has(Abs, re, im, sign, Heaviside, DiracDelta, floor, ceiling, arg):\n386 |             return\n387 | \n388 |     if not f.has_free(x):\n389 |         return f*x\n390 | \n391 |     if not f.is_Add:\n392 |         indep, f = f.as_independent(x)\n393 |     else:\n394 |         indep = S.One\n395 | \n396 |     rewritables = {\n397 |         (sin, cos, cot): tan,\n398 |         (sinh, cosh, coth): tanh,\n399 |     }\n400 | \n401 |     if rewrite:\n402 |         for candidates, rule in rewritables.items():\n403 |             f = f.rewrite(candidates, rule)\n404 |     else:\n405 |         for candidates in rewritables.keys():\n406 |             if f.has(*candidates):\n407 |                 break\n408 |         else:\n409 |             rewrite = True\n410 | \n411 |     terms = components(f, x)\n412 |     dcache = DiffCache(x)\n413 | \n414 |     if hints is not None:\n415 |         if not hints:\n416 |             a = Wild('a', exclude=[x])\n417 |             b = Wild('b', exclude=[x])\n418 |             c = Wild('c', exclude=[x])\n419 | \n420 |             for g in set(terms):  # using copy of terms\n421 |                 if g.is_Function:\n422 |                     if isinstance(g, li):\n423 |                         M = g.args[0].match(a*x**b)\n424 | \n425 |                         if M is not None:\n426 |                             terms.add( x*(li(M[a]*x**M[b]) - (M[a]*x**M[b])**(-1/M[b])*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n427 |                             #terms.add( x*(li(M[a]*x**M[b]) - (x**M[b])**(-1/M[b])*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n428 |                             #terms.add( x*(li(M[a]*x**M[b]) - x*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n429 |                             #terms.add( li(M[a]*x**M[b]) - Ei((M[b]+1)*log(M[a]*x**M[b])/M[b]) )\n430 | \n431 |                     elif isinstance(g, exp):\n432 |                         M = g.args[0].match(a*x**2)\n433 | \n434 |                         if M is not None:\n435 |                             if M[a].is_positive:\n436 |                                 terms.add(erfi(sqrt(M[a])*x))\n437 |                             else: # M[a].is_negative or unknown\n438 |                                 terms.add(erf(sqrt(-M[a])*x))\n439 | \n440 |                         M = g.args[0].match(a*x**2 + b*x + c)\n441 | \n442 |                         if M is not None:\n443 |                             if M[a].is_positive:\n444 |                                 terms.add(sqrt(pi/4*(-M[a]))*exp(M[c] - M[b]**2/(4*M[a]))*\n445 |                                           erfi(sqrt(M[a])*x + M[b]/(2*sqrt(M[a]))))\n446 |                             elif M[a].is_negative:\n447 |                                 terms.add(sqrt(pi/4*(-M[a]))*exp(M[c] - M[b]**2/(4*M[a]))*\n448 |                                           erf(sqrt(-M[a])*x - M[b]/(2*sqrt(-M[a]))))\n449 | \n450 |                         M = g.args[0].match(a*log(x)**2)\n451 | \n452 |                         if M is not None:\n453 |                             if M[a].is_positive:\n454 |                                 terms.add(erfi(sqrt(M[a])*log(x) + 1/(2*sqrt(M[a]))))\n455 |                             if M[a].is_negative:\n456 |                                 terms.add(erf(sqrt(-M[a])*log(x) - 1/(2*sqrt(-M[a]))))\n457 | \n458 |                 elif g.is_Pow:\n459 |                     if g.exp.is_Rational and g.exp.q == 2:\n460 |                         M = g.base.match(a*x**2 + b)\n461 | \n462 |                         if M is not None and M[b].is_positive:\n463 |                             if M[a].is_positive:\n464 |                                 terms.add(asinh(sqrt(M[a]/M[b])*x))\n465 |                             elif M[a].is_negative:\n466 |                                 terms.add(asin(sqrt(-M[a]/M[b])*x))\n467 | \n468 |                         M = g.base.match(a*x**2 - b)\n469 | \n470 |                         if M is not None and M[b].is_positive:\n471 |                             if M[a].is_positive:\n472 |     