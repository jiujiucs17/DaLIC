410 |         >>> F_1 = MIMOFeedback(sys1, sys2, 1)\n3411 |         >>> pprint(F_1, use_unicode=False)\n3412 |         /    [  s      1  ]    [5  0]   \\-1   [  s      1  ]\n3413 |         |    [-----    -  ]    [-  -]   |     [-----    -  ]\n3414 |         |    [1 - s    s  ]    [1  1]   |     [1 - s    s  ]\n3415 |         |I - [            ]   *[    ]   |   * [            ]\n3416 |         |    [  5    s - 1]    [0  0]   |     [  5    s - 1]\n3417 |         |    [  -    -----]    [-  -]   |     [  -    -----]\n3418 |         \\    [  1      s  ]{t} [1  1]{t}/     [  1      s  ]{t}\n3419 |         >>> pprint(F_1.doit(), use_unicode=False)\n3420 |         [  -s           s - 1       ]\n3421 |         [-------     -----------    ]\n3422 |         [6*s - 1     s*(6*s - 1)    ]\n3423 |         [                           ]\n3424 |         [5*s - 5  (s - 1)*(6*s + 24)]\n3425 |         [-------  ------------------]\n3426 |         [6*s - 1     s*(6*s - 1)    ]{t}\n3427 | \n3428 |         If the user wants the resultant ``TransferFunctionMatrix`` object without\n3429 |         canceling the common factors then the ``cancel`` kwarg should be passed ``False``.\n3430 | \n3431 |         >>> pprint(F_1.doit(cancel=False), use_unicode=False)\n3432 |         [             s*(s - 1)                              s - 1               ]\n3433 |         [         -----------------                       -----------            ]\n3434 |         [         (1 - s)*(6*s - 1)                       s*(6*s - 1)            ]\n3435 |         [                                                                        ]\n3436 |         [s*(25*s - 25) + 5*(1 - s)*(6*s - 1)  s*(s - 1)*(6*s - 1) + s*(25*s - 25)]\n3437 |         [-----------------------------------  -----------------------------------]\n3438 |         [         (1 - s)*(6*s - 1)                        2                     ]\n3439 |         [                                                 s *(6*s - 1)           ]{t}\n3440 | \n3441 |         If the user wants the expanded form of the resultant transfer function matrix,\n3442 |         the ``expand`` kwarg should be passed as ``True``.\n3443 | \n3444 |         >>> pprint(F_1.doit(expand=True), use_unicode=False)\n3445 |         [  -s          s - 1      ]\n3446 |         [-------      --------    ]\n3447 |         [6*s - 1         2        ]\n3448 |         [             6*s  - s    ]\n3449 |         [                         ]\n3450 |         [            2            ]\n3451 |         [5*s - 5  6*s  + 18*s - 24]\n3452 |         [-------  ----------------]\n3453 |         [6*s - 1         2        ]\n3454 |         [             6*s  - s    ]{t}\n3455 | \n3456 |         \"\"\"\n3457 |         if self.is_StateSpace_object:\n3458 |             sys1_ss = self.sys1.doit().rewrite(StateSpace)\n3459 |             sys2_ss = self.sys2.doit().rewrite(StateSpace)\n3460 |             A1, B1, C1, D1 = sys1_ss.A, sys1_ss.B, sys1_ss.C, sys1_ss.D\n3461 |             A2, B2, C2, D2 = sys2_ss.A, sys2_ss.B, sys2_ss.C, sys2_ss.D\n3462 | \n3463 |             # Create identity matrices\n3464 |             I_inputs = eye(self.num_inputs)\n3465 |             I_outputs = eye(self.num_outputs)\n3466 | \n3467 |             # Compute F and its inverse\n3468 |             F = I_inputs - self.sign * D2 * D1\n3469 |             E = F.inv()\n3470 | \n3471 |             # Compute intermediate matrices\n3472 |             E_D2 = E * D2\n3473 |             E_C2 = E * C2\n3474 |             T1 = I_outputs + self.sign * D1 * E_D2\n3475 |             T2 = I_inputs + self.sign * E_D2 * D1\n3476 |             A = Matrix.vstack(\n3477 |             Matrix.hstack(A1 + self.sign * B1 * E_D2 * C1, self.sign * B1 * E_C2),\n3478 |             Matrix.hstack(B2 * T1 * C1, A2 + self.sign * B2 * D1 * E_C2)\n3479 |             )\n3480 |             B = Matrix.vstack(B1 * T2, B2 * D1 * T2)\n3481 |             C = Matrix.hstack(T1 * C1, self.sign * D1 * E_C2)\n3482 |             D = D1 * T2\n3483 