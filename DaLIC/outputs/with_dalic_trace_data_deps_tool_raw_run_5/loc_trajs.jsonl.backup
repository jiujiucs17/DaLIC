None, strides=None, subok=False, writeable=True):\n...\n\ndef _broadcast_to(array, shape, subok, readonly):\n...\n\ndef _broadcast_to_dispatcher(array, shape, subok=None):\n...\n\n@array_function_dispatch(_broadcast_to_dispatcher, module='numpy')\ndef broadcast_to(array, shape, subok=False):\n...\n\ndef _broadcast_shape(*args):\n...\n\n@set_module('numpy')\ndef broadcast_shapes(*args):\n...\n\ndef _broadcast_arrays_dispatcher(*args, subok=None):\n...\n\n@array_function_dispatch(_broadcast_arrays_dispatcher, module='numpy')\ndef broadcast_arrays(*args, subok=False):\n...\n\n```\nHint: Search `numpy/lib/stride_tricks.py` to get the full content if needed.\n\n\n\n##Searching for term \"as_strided\"...\n### Search Result:\nFound function `numpy/lib/stride_tricks.py:as_strided`.\nSource: Match found for entity name `as_strided`.\n```\n 37 | def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n 38 |     \"\"\"\n 39 |     Create a view into the array with the given shape and strides.\n 40 | \n 41 |     .. warning:: This function has to be used with extreme care, see notes.\n 42 | \n 43 |     Parameters\n 44 |     ----------\n 45 |     x : ndarray\n 46 |         Array to create a new.\n 47 |     shape : sequence of int, optional\n 48 |         The shape of the new array. Defaults to ``x.shape``.\n 49 |     strides : sequence of int, optional\n 50 |         The strides of the new array. Defaults to ``x.strides``.\n 51 |     subok : bool, optional\n 52 |         .. versionadded:: 1.10\n 53 | \n 54 |         If True, subclasses are preserved.\n 55 |     writeable : bool, optional\n 56 |         .. versionadded:: 1.12\n 57 | \n 58 |         If set to False, the returned array will always be readonly.\n 59 |         Otherwise it will be writable if the original array was. It\n 60 |         is advisable to set this to False if possible (see Notes).\n 61 | \n 62 |     Returns\n 63 |     -------\n 64 |     view : ndarray\n 65 | \n 66 |     See also\n 67 |     --------\n 68 |     broadcast_to: broadcast an array to a given shape.\n 69 |     reshape : reshape an array.\n 70 | \n 71 |     Notes\n 72 |     -----\n 73 |     ``as_strided`` creates a view into the array given the exact strides\n 74 |     and shape. This means it manipulates the internal data structure of\n 75 |     ndarray and, if done incorrectly, the array elements can point to\n 76 |     invalid memory and can corrupt results or crash your program.\n 77 |     It is advisable to always use the original ``x.strides`` when\n 78 |     calculating new strides to avoid reliance on a contiguous memory\n 79 |     layout.\n 80 | \n 81 |     Furthermore, arrays created with this function often contain self\n 82 |     overlapping memory, so that two elements are identical.\n 83 |     Vectorized write operations on such arrays will typically be\n 84 |     unpredictable. They may even give different results for small, large,\n 85 |     or transposed arrays.\n 86 |     Since writing to these arrays has to be tested and done with great\n 87 |     care, you may want to use ``writeable=False`` to avoid accidental write\n 88 |     operations.\n 89 | \n 90 |     For these reasons it is advisable to avoid ``as_strided`` when\n 91 |     possible.\n 92 |     \"\"\"\n 93 |     # first convert input to array, possibly keeping subclass\n 94 |     x = np.array(x, copy=False, subok=subok)\n 95 |     interface = dict(x.__array_interface__)\n 96 |     if shape is not None:\n 97 |         interface['shape'] = tuple(shape)\n 98 |     if strides is not None:\n 99 |         interface['strides'] = tuple(strides)\n100 | \n101 |     array = np.asarray(DummyArray(interface, base=x))\n102 |     # The route via `__interface__` does not preserve structured\n103 |     # dtypes. Since dtype should remain unchanged, we set it explicitly.\n104 |     array.dtype = x.dtype\n105 | \n106 |     view = _maybe_view_as_subclass(x, array)\n107 | \n108 |     if view.flags.writeable and not writeable:\n109 |         view.flags.writeable = False\n110 | \n111 |     return view\n```\n"}, {"content": "Let me also check for array manipulation functions in the core directory:\n\n<function=search_code_snippets>\n<parameter=search_terms>['array_view', 'window', 'sliding']</parameter>\n<parameter=file_path_or_pattern>numpy/core/**/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"array_view\", \"array_view sliding\"...\n### Search Result:\nFound function `benchmarks/benchmarks/bench_core.py:Core.time_array_l_view`.\nSource: Retrieved entity using keyword search (bm25).\n```\n45 | def time_array_l_view(self):\n46 |         np.array(self.l_view)\n```\n\n\n\n##Searching for term \"array_view\"...\n### Search Result:\nFound function `numpy/ctypeslib.py:as_array`.\nSource: Retrieved entity using keyword search (bm25).\n```\n499 | def as_array(obj, shape=None):\n500 |         \"\"\"\n501 |         Create a numpy array from a ctypes array or POINTER.\n502 | \n503 |         The numpy array shares the memory with the ctypes object.\n504 | \n505 |         The shape parameter must be given if converting from a ctypes POINTER.\n506 |         The shape parameter is ignored if converting from a ctypes array\n507 |         \"\"\"\n508 |         if isinstance(obj, ctypes._Pointer):\n509 |             # convert pointers to an array of the desired shape\n510 |             if shape is None:\n511 |                 raise TypeError(\n512 |                     'as_array() requires a shape argument when called on a '\n513 |                     'pointer')\n514 |             p_arr_type = ctypes.POINTER(_ctype_ndarray(obj._type_, shape))\n515 |             obj = ctypes.cast(obj, p_arr_type).contents\n516 | \n517 |         return array(obj, copy=False)\n```\n\nFound function `numpy/core/_add_newdocs.py:refer_to_array_attribute`.\nSource: Retrieved entity using keyword search (bm25).\n```\n5984 | def refer_to_array_attribute(attr, method=True):\n5985 |     docstring = \"\"\"\n5986 |     Scalar {} identical to the corresponding array attribute.\n5987 | \n5988 |     Please see `ndarray.{}`.\n5989 |     \"\"\"\n5990 | \n5991 |     return attr, docstring.format(\"method\" if method else \"attribute\", attr)\n```\n\n\n\n##Searching for term \"window\"...\n### Search Result:\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.window`.\nSource: Match found for entity name `window`.\n```\n109 | def window(self):\n110 |         pass\n```\n\n\n\n##Searching for term \"sliding\"...\n### Search Result:\nFound function `numpy/ctypeslib.py:ndpointer`.\nSource: Retrieved entity using keyword search (bm25).\n```\n225 | def ndpointer(dtype=None, ndim=None, shape=None, flags=None):\n226 |     \"\"\"\n227 |     Array-checking restype/argtypes.\n228 | \n229 |     An ndpointer instance is used to describe an ndarray in restypes\n230 |     and argtypes specifications.  This approach is more flexible than\n231 |     using, for example, ``POINTER(c_double)``, since several restrictions\n232 |     can be specified, which are verified upon calling the ctypes function.\n233 |     These include data type, number of dimensions, shape and flags.  If a\n234 |     given array does not satisfy the specified restrictions,\n235 |     a ``TypeError`` is raised.\n236 | \n237 |     Parameters\n238 |     ----------\n239 |     dtype : data-type, optional\n240 |         Array data-type.\n241 |     ndim : int, optional\n242 |         Number of array dimensions.\n243 |     shape : tuple of ints, optional\n244 |         Array shape.\n245 |     flags : str or tuple of str\n246 |         Array flags; may be one or more of:\n247 | \n248 |           - C_CONTIGUOUS / C / CONTIGUOUS\n249 |           - F_CONTIGUOUS / F / FORTRAN\n250 |           - OWNDATA / O\n251 |           - WRITEABLE / W\n252 |           - ALIGNED / A\n253 |           - WRITEBACKIFCOPY / X\n254 |           - UPDATEIFCOPY / U\n255 | \n256 |     Returns\n257 |     -------\n258 |     klass : ndpointer type object\n259 |         A type object, which is an ``_ndtpr`` instance containing\n260 |         dtype, ndim, shape and flags information.\n261 | \n262 |     Raises\n263 |     ------\n264 |     TypeError\n265 |         If a given array does not satisfy the specified restrictions.\n266 | \n267 |     Examples\n268 |     --------\n269 |     >>> clib.somefunc.argtypes = [np.ctypeslib.ndpointer(dtype=np.float64,\n270 |     ...                                                  ndim=1,\n271 |     ...                                                  flags='C_CONTIGUOUS')]\n272 |     ... #doctest: +SKIP\n273 |     >>> clib.somefunc(np.array([1, 2, 3], dtype=np.float64))\n274 |     ... #doctest: +SKIP\n275 | \n276 |     \"\"\"\n277 | \n278 |     # normalize dtype to an Optional[dtype]\n279 |     if dtype is not None:\n280 |         dtype = _dtype(dtype)\n281 | \n282 |     # normalize flags to an Optional[int]\n283 |     num = None\n284 |     if flags is not None:\n285 |         if isinstance(flags, str):\n286 |             flags = flags.split(',')\n287 |         elif isinstance(flags, (int, integer)):\n288 |             num = flags\n289 |             flags = _flags_fromnum(num)\n290 |         elif isinstance(flags, flagsobj):\n291 |             num = flags.num\n292 |             flags = _flags_fromnum(num)\n293 |         if num is None:\n294 |             try:\n295 |                 flags = [x.strip().upper() for x in flags]\n296 |             except Exception as e:\n297 |                 raise TypeError(\"invalid flags specification\") from e\n298 |             num = _num_fromflags(flags)\n299 | \n300 |     # normalize shape to an Optional[tuple]\n301 |     if shape is not None:\n302 |         try:\n303 |             shape = tuple(shape)\n304 |         except TypeError:\n305 |             # single integer -> 1-tuple\n306 |             shape = (shape,)\n307 | \n308 |     cache_key = (dtype, ndim, shape, num)\n309 | \n310 |     try:\n311 |         return _pointer_type_cache[cache_key]\n312 |     except KeyError:\n313 |         pass\n314 | \n315 |     # produce a name for the new type\n316 |     if dtype is None:\n317 |         name = 'any'\n318 |     elif dtype.names is not None:\n319 |         name = str(id(dtype))\n320 |     else:\n321 |         name = dtype.str\n322 |     if ndim is not None:\n323 |         name += \"_%dd\" % ndim\n324 |     if shape is not None:\n325 |         name += \"_\"+\"x\".join(str(x) for x in shape)\n326 |     if flags is not None:\n327 |         name += \"_\"+\"_\".join(flags)\n328 | \n329 |     if dtype is not None and shape is not None:\n330 |         base = _concrete_ndptr\n331 |     else:\n332 |         base = _ndptr\n333 | \n334 |     klass = type(\"ndpointer_%s\"%name, (base,),\n335 |                  {\"_dtype_\": dtype,\n336 |                   \"_shape_\" : shape,\n337 |                   \"_ndim_\" : ndim,\n338 |                   \"_flags_\" : num})\n339 |     _pointer_type_cache[cache_key] = klass\n340 |     return klass\n```\n\nFound file `numpy/linalg/linalg.py`.\nFound file `benchmarks/benchmarks/bench_indexing.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"array_view sliding\"...\n### Search Result:\nFound function `numpy/lib/arraypad.py:_view_roi`.\nSource: Retrieved entity using keyword search (bm25).\n```\n58 | def _view_roi(array, original_area_slice, axis):\n59 |     \"\"\"\n60 |     Get a view of the current region of interest during iterative padding.\n61 | \n62 |     When padding multiple dimensions iteratively corner values are\n63 |     unnecessarily overwritten multiple times. This function reduces the\n64 |     working area for the first dimensions so that corners are excluded.\n65 | \n66 |     Parameters\n67 |     ----------\n68 |     array : ndarray\n69 |         The array with the region of interest.\n70 |     original_area_slice : tuple of slices\n71 |         Denotes the area with original values of the unpadded array.\n72 |     axis : int\n73 |         The currently padded dimension assuming that `axis` is padded before\n74 |         `axis` + 1.\n75 | \n76 |     Returns\n77 |     -------\n78 |     roi : ndarray\n79 |         The region of interest of the original `array`.\n80 |     \"\"\"\n81 |     axis += 1\n82 |     sl = (slice(None),) * axis + original_area_slice[axis:]\n83 |     return array[sl]\n```\n\nFound file `numpy/lib/user_array.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `numpy/lib/user_array.py` for the full content if needed.\n"}, {"content": "Let me also check for statistical and mathematical operations since the sliding window is often used for calculations:\n\n<function=search_code_snippets>\n<parameter=search_terms>['moving_average', 'mean', 'std']</parameter>\n<parameter=file_path_or_pattern>numpy/**/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nnumpy/distutils/command/autodist.py:check_gcc_function_attribute\nnumpy/distutils/command/autodist.py:check_gcc_version_at_least\nnumpy/distutils/command/autodist.py:check_restrict\nnumpy/distutils/command/autodist.py:check_compiler_gcc\nnumpy/distutils/ccompiler_opt.py:new_ccompiler_opt\nnumpy/distutils/command/autodist.py:check_gcc_function_attribute_with_intrinsics\nnumpy/distutils/command/autodist.py:check_gcc_variable_attribute\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt._generate_config\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt.cpu_dispatch_names\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt.cpu_baseline_names\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt.cpu_baseline_flags\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt.is_cached\nnumpy/distutils/ccompiler_opt.py:CCompilerOpt.__init__\n##Searching for term \"moving_average\"...\n### Search Result:\nFound `numpy/distutils/command/autodist.py:check_inline`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"This module implements additional tests ala autoconf which can be useful.\n  2 | \n  3 | \"\"\"\n  4 | import textwrap\n  5 | \n  6 | # We put them here since they could be easily reused outside numpy.distutils\n  7 | \n  8 | def check_inline(cmd):\n  9 |     \"\"\"Return the inline identifier (may be empty).\"\"\"\n 10 |     cmd._check_compiler()\n 11 |     body = textwrap.dedent(\"\"\"\n 12 |         #ifndef __cplusplus\n 13 |         static %(inline)s int static_func (void)\n 14 |         {\n 15 |             return 0;\n 16 |         }\n 17 |         %(inline)s int nostatic_func (void)\n 18 |         {\n 19 |             return 0;\n 20 |         }\n 21 |         #endif\"\"\")\n 22 | \n 23 |     for kw in ['inline', '__inline__', '__inline']:\n 24 |         st = cmd.try_compile(body % {'inline': kw}, None, None)\n 25 |         if st:\n 26 |             return kw\n 27 | \n 28 |     return ''\n```\n\nFound function `numpy/ma/extras.py:average`.\nSource: Retrieved entity using keyword search (bm25).\n```\n528 | def average(a, axis=None, weights=None, returned=False):\n529 |     \"\"\"\n530 |     Return the weighted average of array over the given axis.\n531 | \n532 |     Parameters\n533 |     ----------\n534 |     a : array_like\n535 |         Data to be averaged.\n536 |         Masked entries are not taken into account in the computation.\n537 |     axis : int, optional\n538 |         Axis along which to average `a`. If None, averaging is done over\n539 |         the flattened array.\n540 |     weights : array_like, optional\n541 |         The importance that each element has in the computation of the average.\n542 |         The weights array can either be 1-D (in which case its length must be\n543 |         the size of `a` along the given axis) or of the same shape as `a`.\n544 |         If ``weights=None``, then all data in `a` are assumed to have a\n545 |         weight equal to one.  The 1-D calculation is::\n546 | \n547 |             avg = sum(a * weights) / sum(weights)\n548 | \n549 |         The only constraint on `weights` is that `sum(weights)` must not be 0.\n550 |     returned : bool, optional\n551 |         Flag indicating whether a tuple ``(result, sum of weights)``\n552 |         should be returned as output (True), or just the result (False).\n553 |         Default is False.\n554 | \n555 |     Returns\n556 |     -------\n557 |     average, [sum_of_weights] : (tuple of) scalar or MaskedArray\n558 |         The average along the specified axis. When returned is `True`,\n559 |         return a tuple with the average as the first element and the sum\n560 |         of the weights as the second element. The return type is `np.float64`\n561 |         if `a` is of integer type and floats smaller than `float64`, or the\n562 |         input data-type, otherwise. If returned, `sum_of_weights` is always\n563 |         `float64`.\n564 | \n565 |     Examples\n566 |     --------\n567 |     >>> a = np.ma.array([1., 2., 3., 4.], mask=[False, False, True, True])\n568 |     >>> np.ma.average(a, weights=[3, 1, 0, 0])\n569 |     1.25\n570 | \n571 |     >>> x = np.ma.arange(6.).reshape(3, 2)\n572 |     >>> x\n573 |     masked_array(\n574 |       data=[[0., 1.],\n575 |             [2., 3.],\n576 |             [4., 5.]],\n577 |       mask=False,\n578 |       fill_value=1e+20)\n579 |     >>> avg, sumweights = np.ma.average(x, axis=0, weights=[1, 2, 3],\n580 |     ...                                 returned=True)\n581 |     >>> avg\n582 |     masked_array(data=[2.6666666666666665, 3.6666666666666665],\n583 |                  mask=[False, False],\n584 |            fill_value=1e+20)\n585 | \n586 |     \"\"\"\n587 |     a = asarray(a)\n588 |     m = getmask(a)\n589 | \n590 |     # inspired by 'average' in numpy/lib/function_base.py\n591 | \n592 |     if weights is None:\n593 |         avg = a.mean(axis)\n594 |         scl = avg.dtype.type(a.count(axis))\n595 |     else:\n596 |         wgt = np.asanyarray(weights)\n597 | \n598 |         if issubclass(a.dtype.type, (np.integer, np.bool_)):\n599 |             result_dtype = np.result_type(a.dtype, wgt.dtype, 'f8')\n600 |         else:\n601 |             result_dtype = np.result_type(a.dtype, wgt.dtype)\n602 | \n603 |         # Sanity checks\n604 |         if a.shape != wgt.shape:\n605 |             if axis is None:\n606 |                 raise TypeError(\n607 |                     \"Axis must be specified when shapes of a and weights \"\n608 |                     \"differ.\")\n609 |             if wgt.ndim != 1:\n610 |                 raise TypeError(\n611 |                     \"1D weights expected when shapes of a and weights differ.\")\n612 |             if wgt.shape[0] != a.shape[axis]:\n613 |                 raise ValueError(\n614 |                     \"Length of weights not compatible with specified axis.\")\n615 | \n616 |             # setup wgt to broadcast along axis\n617 |             wgt = np.broadcast_to(wgt, (a.ndim-1)*(1,) + wgt.shape)\n618 |             wgt = wgt.swapaxes(-1, axis)\n619 | \n620 |         if m is not nomask:\n621 |             wgt = wgt*(~a.mask)\n622 | \n623 |         scl = wgt.sum(axis=axis, dtype=result_dtype)\n624 |         avg = np.multiply(a, wgt, dtype=result_dtype).sum(axis)/scl\n625 | \n626 |     if returned:\n627 |         if scl.shape != avg.shape:\n628 |             scl = np.broadcast_to(scl, avg.shape).copy()\n629 |         return avg, scl\n630 |     else:\n631 |         return avg\n```\n\nFound function `numpy/lib/function_base.py:average`.\nSource: Retrieved entity using keyword search (bm25).\n```\n281 | def average(a, axis=None, weights=None, returned=False):\n282 |     \"\"\"\n283 |     Compute the weighted average along the specified axis.\n284 | \n285 |     Parameters\n286 |     ----------\n287 |     a : array_like\n288 |         Array containing data to be averaged. If `a` is not an array, a\n289 |         conversion is attempted.\n290 |     axis : None or int or tuple of ints, optional\n291 |         Axis or axes along which to average `a`.  The default,\n292 |         axis=None, will average over all of the elements of the input array.\n293 |         If axis is negative it counts from the last to the first axis.\n294 | \n295 |         .. versionadded:: 1.7.0\n296 | \n297 |         If axis is a tuple of ints, averaging is performed on all of the axes\n298 |         specified in the tuple instead of a single axis or all the axes as\n299 |         before.\n300 |     weights : array_like, optional\n301 |         An array of weights associated with the values in `a`. Each value in\n302 |         `a` contributes to the average according to its associated weight.\n303 |         The weights array can either be 1-D (in which case its length must be\n304 |         the size of `a` along the given axis) or of the same shape as `a`.\n305 |         If `weights=None`, then all data in `a` are assumed to have a\n306 |         weight equal to one.  The 1-D calculation is::\n307 | \n308 |             avg = sum(a * weights) / sum(weights)\n309 | \n310 |         The only constraint on `weights` is that `sum(weights)` must not be 0.\n311 |     returned : bool, optional\n312 |         Default is `False`. If `True`, the tuple (`average`, `sum_of_weights`)\n313 |         is returned, otherwise only the average is returned.\n314 |         If `weights=None`, `sum_of_weights` is equivalent to the number of\n315 |         elements over which the average is taken.\n316 | \n317 |     Returns\n318 |     -------\n319 |     retval, [sum_of_weights] : array_type or double\n320 |         Return the average along the specified axis. When `returned` is `True`,\n321 |         return a tuple with the average as the first element and the sum\n322 |         of the weights as the second element. `sum_of_weights` is of the\n323 |         same type as `retval`. The result dtype follows a genereal pattern.\n324 |         If `weights` is None, the result dtype will be that of `a` , or ``float64``\n325 |         if `a` is integral. Otherwise, if `weights` is not None and `a` is non-\n326 |         integral, the result type will be the type of lowest precision capable of\n327 |         representing values of both `a` and `weights`. If `a` happens to be\n328 |         integral, the previous rules still applies but the result dtype will\n329 |         at least be ``float64``.\n330 | \n331 |     Raises\n332 |     ------\n333 |     ZeroDivisionError\n334 |         When all weights along axis are zero. See `numpy.ma.average` for a\n335 |         version robust to this type of error.\n336 |     TypeError\n337 |         When the length of 1D `weights` is not the same as the shape of `a`\n338 |         along axis.\n339 | \n340 |     See Also\n341 |     --------\n342 |     mean\n343 | \n344 |     ma.average : average for masked arrays -- useful if your data contains\n345 |                  \"missing\" values\n346 |     numpy.result_type : Returns the type that results from applying the\n347 |                         numpy type promotion rules to the arguments.\n348 | \n349 |     Examples\n350 |     --------\n351 |     >>> data = np.arange(1, 5)\n352 |     >>> data\n353 |     array([1, 2, 3, 4])\n354 |     >>> np.average(data)\n355 |     2.5\n356 |     >>> np.average(np.arange(1, 11), weights=np.arange(10, 0, -1))\n357 |     4.0\n358 | \n359 |     >>> data = np.arange(6).reshape((3,2))\n360 |     >>> data\n361 |     array([[0, 1],\n362 |            [2, 3],\n363 |            [4, 5]])\n364 |     >>> np.average(data, axis=1, weights=[1./4, 3./4])\n365 |     array([0.75, 2.75, 4.75])\n366 |     >>> np.average(data, weights=[1./4, 3./4])\n367 |     Traceback (most recent call last):\n368 |         ...\n369 |     TypeError: Axis must be specified when shapes of a and weights differ.\n370 | \n371 |     >>> a = np.ones(5, dtype=np.float128)\n372 |     >>> w = np.ones(5, dtype=np.complex64)\n373 |     >>> avg = np.average(a, weights=w)\n374 |     >>> print(avg.dtype)\n375 |     complex256\n376 |     \"\"\"\n377 |     a = np.asanyarray(a)\n378 | \n379 |     if weights is None:\n380 |         avg = a.mean(axis)\n381 |         scl = avg.dtype.type(a.size/avg.size)\n382 |     else:\n383 |         wgt = np.asanyarray(weights)\n384 | \n385 |         if issubclass(a.dtype.type, (np.integer, np.bool_)):\n386 |             result_dtype = np.result_type(a.dtype, wgt.dtype, 'f8')\n387 |         else:\n388 |             result_dtype = np.result_type(a.dtype, wgt.dtype)\n389 | \n390 |         # Sanity checks\n391 |         if a.shape != wgt.shape:\n392 |             if axis is None:\n393 |                 raise TypeError(\n394 |                     \"Axis must be specified when shapes of a and weights \"\n395 |                     \"differ.\")\n396 |             if wgt.ndim != 1:\n397 |                 raise TypeError(\n398 |                     \"1D weights expected when shapes of a and weights differ.\")\n399 |             if wgt.shape[0] != a.shape[axis]:\n400 |                 raise ValueError(\n401 |                     \"Length of weights not compatible with specified axis.\")\n402 | \n403 |             # setup wgt to broadcast along axis\n404 |             wgt = np.broadcast_to(wgt, (a.ndim-1)*(1,) + wgt.shape)\n405 |             wgt = wgt.swapaxes(-1, axis)\n406 | \n407 |         scl = wgt.sum(axis=axis, dtype=result_dtype)\n408 |         if np.any(scl == 0.0):\n409 |             raise ZeroDivisionError(\n410 |                 \"Weights sum to zero, can't be normalized\")\n411 | \n412 |         avg = np.multiply(a, wgt, dtype=result_dtype).sum(axis)/scl\n413 | \n414 |     if returned:\n415 |         if scl.shape != avg.shape:\n416 |             scl = np.broadcast_to(scl, avg.shape).copy()\n417 |         return avg, scl\n418 |     else:\n419 |         return avg\n```\n\nFound function `numpy/lib/function_base.py:_average_dispatcher`.\nSource: Retrieved entity using keyword search (bm25).\n```\n276 | def _average_dispatcher(a, axis=None, weights=None, returned=None):\n277 |     return (a, weights)\n```\n\nFound function `numpy/distutils/command/autodist.py:check_restrict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n31 | def check_restrict(cmd):\n32 |     \"\"\"Return the restrict identifier (may be empty).\"\"\"\n33 |     cmd._check_compiler()\n34 |     body = textwrap.dedent(\"\"\"\n35 |         static int static_func (char * %(restrict)s a)\n36 |         {\n37 |             return 0;\n38 |         }\n39 |         \"\"\")\n40 | \n41 |     for kw in ['restrict', '__restrict__', '__restrict']:\n42 |         st = cmd.try_compile(body % {'restrict': kw}, None, None)\n43 |         if st:\n44 |             return kw\n45 | \n46 |     return ''\n```\n\nFound function `numpy/distutils/command/autodist.py:check_compiler_gcc`.\nSource: Retrieved code content using keyword search (bm25).\n```\n49 | def check_compiler_gcc(cmd):\n50 |     \"\"\"Check if the compiler is GCC.\"\"\"\n51 | \n52 |     cmd._check_compiler()\n53 |     body = textwrap.dedent(\"\"\"\n54 |         int\n55 |         main()\n56 |         {\n57 |         #if (! defined __GNUC__)\n58 |         #error gcc required\n59 |         #endif\n60 |             return 0;\n61 |         }\n62 |         \"\"\")\n63 |     return cmd.try_compile(body, None, None)\n```\n\nFound function `numpy/distutils/command/autodist.py:check_gcc_version_at_least`.\nSource: Retrieved code content using keyword search (bm25).\n```\n66 | def check_gcc_version_at_least(cmd, major, minor=0, patchlevel=0):\n67 |     \"\"\"\n68 |     Check that the gcc version is at least the specified version.\"\"\"\n69 | \n70 |     cmd._check_compiler()\n71 |     version = '.'.join([str(major), str(minor), str(pat