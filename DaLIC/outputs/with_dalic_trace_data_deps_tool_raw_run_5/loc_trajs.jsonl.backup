tion._em_step`.\nSource: Retrieved code content using keyword search (bm25).\n```\n475 | def _em_step(self, X, total_samples, batch_update, parallel=None):\n476 |         \"\"\"EM update for 1 iteration.\n477 | \n478 |         update `_component` by batch VB or online VB.\n479 | \n480 |         Parameters\n481 |         ----------\n482 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n483 |             Document word matrix.\n484 | \n485 |         total_samples : int\n486 |             Total number of documents. It is only used when\n487 |             batch_update is `False`.\n488 | \n489 |         batch_update : bool\n490 |             Parameter that controls updating method.\n491 |             `True` for batch learning, `False` for online learning.\n492 | \n493 |         parallel : joblib.Parallel, default=None\n494 |             Pre-initialized instance of joblib.Parallel\n495 | \n496 |         Returns\n497 |         -------\n498 |         doc_topic_distr : ndarray of shape (n_samples, n_components)\n499 |             Unnormalized document topic distribution.\n500 |         \"\"\"\n501 | \n502 |         # E-step\n503 |         _, suff_stats = self._e_step(\n504 |             X, cal_sstats=True, random_init=True, parallel=parallel\n505 |         )\n506 | \n507 |         # M-step\n508 |         if batch_update:\n509 |             self.components_ = self.topic_word_prior_ + suff_stats\n510 |         else:\n511 |             # online update\n512 |             # In the literature, the weight is `rho`\n513 |             weight = np.power(\n514 |                 self.learning_offset + self.n_batch_iter_, -self.learning_decay\n515 |             )\n516 |             doc_ratio = float(total_samples) / X.shape[0]\n517 |             self.components_ *= 1 - weight\n518 |             self.components_ += weight * (\n519 |                 self.topic_word_prior_ + doc_ratio * suff_stats\n520 |             )\n521 | \n522 |         # update `component_` related variables\n523 |         self.exp_dirichlet_component_ = np.exp(\n524 |             _dirichlet_expectation_2d(self.components_)\n525 |         )\n526 |         self.n_batch_iter_ += 1\n527 |         return\n```\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n593 | def fit(self, X, y=None):\n594 |         \"\"\"Learn model for the data X with variational Bayes method.\n595 | \n596 |         When `learning_method` is 'online', use mini-batch update.\n597 |         Otherwise, use batch update.\n598 | \n599 |         Parameters\n600 |         ----------\n601 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n602 |             Document word matrix.\n603 | \n604 |         y : Ignored\n605 |             Not used, present here for API consistency by convention.\n606 | \n607 |         Returns\n608 |         -------\n609 |         self\n610 |             Fitted estimator.\n611 |         \"\"\"\n612 |         self._check_params()\n613 |         X = self._check_non_neg_array(\n614 |             X, reset_n_features=True, whom=\"LatentDirichletAllocation.fit\"\n615 |         )\n616 |         n_samples, n_features = X.shape\n617 |         max_iter = self.max_iter\n618 |         evaluate_every = self.evaluate_every\n619 |         learning_method = self.learning_method\n620 | \n621 |         batch_size = self.batch_size\n622 | \n623 |         # initialize parameters\n624 |         self._init_latent_vars(n_features)\n625 |         # change to perplexity later\n626 |         last_bound = None\n627 |         n_jobs = effective_n_jobs(self.n_jobs)\n628 |         with Parallel(n_jobs=n_jobs, verbose=max(0, self.verbose - 1)) as parallel:\n629 |             for i in range(max_iter):\n630 |                 if learning_method == \"online\":\n631 |                     for idx_slice in gen_batches(n_samples, batch_size):\n632 |                         self._em_step(\n633 |                             X[idx_slice, :],\n634 |                             total_samples=n_samples,\n635 |                             batch_update=False,\n636 |                             parallel=parallel,\n637 |                         )\n638 |                 else:\n639 |                     # batch update\n640 |                     self._em_step(\n641 |                         X, total_samples=n_samples, batch_update=True, parallel=parallel\n642 |                     )\n643 | \n644 |                 # check perplexity\n645 |                 if evaluate_every > 0 and (i + 1) % evaluate_every == 0:\n646 |                     doc_topics_distr, _ = self._e_step(\n647 |                         X, cal_sstats=False, random_init=False, parallel=parallel\n648 |                     )\n649 |                     bound = self._perplexity_precomp_distr(\n650 |                         X, doc_topics_distr, sub_sampling=False\n651 |                     )\n652 |                     if self.verbose:\n653 |                         print(\n654 |                             \"iteration: %d of max_iter: %d, perplexity: %.4f\"\n655 |                             % (i + 1, max_iter, bound)\n656 |                         )\n657 | \n658 |                     if last_bound and abs(last_bound - bound) < self.perp_tol:\n659 |                         break\n660 |                     last_bound = bound\n661 | \n662 |                 elif self.verbose:\n663 |                     print(\"iteration: %d of max_iter: %d\" % (i + 1, max_iter))\n664 |                 self.n_iter_ += 1\n665 | \n666 |         # calculate final perplexity value on train set\n667 |         doc_topics_distr, _ = self._e_step(\n668 |             X, cal_sstats=False, random_init=False, parallel=parallel\n669 |         )\n670 |         self.bound_ = self._perplexity_precomp_distr(\n671 |             X, doc_topics_distr, sub_sampling=False\n672 |         )\n673 | \n674 |         return self\n```\n\n\n\n##Search