of the online KMeans object, MiniBatchKMeans.\n15 | \n16 | The verbose setting on the MiniBatchKMeans enables us to see that some\n17 | clusters are reassigned during the successive calls to\n18 | partial-fit. This is because the number of patches that they represent\n19 | has become too low, and it is better to choose a random new\n20 | cluster.\n21 | \n22 | \"\"\"\n23 | \n24 | # %%\n25 | # Load the data\n26 | # -------------\n27 | \n28 | from sklearn import datasets\n29 | \n30 | faces = datasets.fetch_olivetti_faces()\n31 | \n32 | # %%\n33 | # Learn the dictionary of images\n34 | # ------------------------------\n35 | \n36 | import time\n37 | \n38 | import numpy as np\n39 | \n40 | from sklearn.cluster import MiniBatchKMeans\n41 | from sklearn.feature_extraction.image import extract_patches_2d\n42 | \n43 | print(\"Learning the dictionary... \")\n44 | rng = np.random.RandomState(0)\n45 | kmeans = MiniBatchKMeans(n_clusters=81, random_state=rng, verbose=True)\n46 | patch_size = (20, 20)\n47 | \n48 | buffer = []\n49 | t0 = time.time()\n50 | \n51 | # The online learning part: cycle over the whole dataset 6 times\n52 | index = 0\n53 | for _ in range(6):\n54 |     for img in faces.images:\n55 |         data = extract_patches_2d(img, patch_size, max_patches=50, random_state=rng)\n56 |         data = np.reshape(data, (len(data), -1))\n57 |         buffer.append(data)\n58 |         index += 1\n59 |         if index % 10 == 0:\n60 |             data = np.concatenate(buffer, axis=0)\n61 |             data -= np.mean(data, axis=0)\n62 |             data /= np.std(data, axis=0)\n63 |             kmeans.partial_fit(data)\n64 |             buffer = []\n65 |         if index % 100 == 0:\n66 |             print(\"Partial fit of %4i out of %i\" % (index, 6 * len(faces.images)))\n67 | \n68 | dt = time.time() - t0\n69 | print(\"done in %.2fs.\" % dt)\n70 | \n71 | # %%\n72 | # Plot the results\n73 | # ----------------\n74 | \n75 | import matplotlib.pyplot as plt\n```\n\nFound function `benchmarks/bench_online_ocsvm.py:print_outlier_ratio`.\nSource: Retrieved entity using keyword search (bm25).\n```\n41 | def print_outlier_ratio(y):\n42 |     \"\"\"\n43 |     Helper function to show the distinct value count of element in the target.\n44 |     Useful indicator for the datasets used in bench_isolation_forest.py.\n45 |     \"\"\"\n46 |     uniq, cnt = np.unique(y, return_counts=True)\n47 |     print(\"----- Target count values: \")\n48 |     for u, c in zip(uniq, cnt):\n49 |         print(\"------ %s -> %d occurrences\" % (str(u), c))\n50 |     print(\"----- Outlier ratio: %.5f\" % (np.min(cnt) / len(y)))\n```\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation._em_step`.\nSource: Retrieved code content using keyword search (bm25).\n```\n475 | def _em_step(self, X, total_samples, batch_update, parallel=None):\n476 |         \"\"\"EM update for 1 iteration.\n477 | \n478 |         update `_component` by batch VB or online VB.\n479 | \n480 |         Parameters\n481 |         ----------\n482 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n483 |             Document word matrix.\n484 | \n485 |         total_samples : int\n486 |             Total number of documents. It is only used when\n487 |             batch_update is `False`.\n488 | \n489 |         batch_update : bool\n490 |             Parameter that controls updating method.\n491 |             `True` for batch learning, `False` for online learning.\n492 | \n493 |         parallel : joblib.Parallel, default=None\n494 |             Pre-initialized instance of joblib.Parallel\n495 | \n496 |         Returns\n497 |         -------\n498 |         doc_topic_distr : ndarray of shape (n_samples, n_components)\n499 |             Unnormalized document topic distribution.\n500 |         \"\"\"\n501 | \n502 |         # E-step\n503 |         _, suff_stats = self._e_step(\n504 |             X, cal_sstats=True, random_init=True, parallel=parallel\n505 |         )\n506 | \n507 |         # M-step\n508 |         if batch_update:\n509 |             self.components_ = self.topic_word_prior_ + suff_stats\n510 |         else:\n511 |             # online update\n512 |             # In the literature, the weight is `rho`\n513 |             weight = np.power(\n514 |                 self.learning_offset + self.n_batch_iter_, -self.learning_decay\n515 |             )\n516 |             doc_ratio = float(total_samples) / X.shape[0]\n517 |             self.components_ *= 1 - weight\n518 |             self.components_ += weight * (\n519 |                 self.topic_word_prior_ + doc_ratio * suff_stats\n520 |             )\n521 | \n522 |         # update `component_` related variables\n523 |         self.exp_dirichlet_component_ = np.exp(\n524 |             _dirichlet_expectation_2d(self.components_)\n525 |         )\n526 |         self.n_batch_iter_ += 1\n527 |         return\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:_update_dict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n415 | def _update_dict(\n416 |     dictionary,\n417 |     Y,\n418 |     code,\n419 |     A=None,\n420 |     B=None,\n421 |     verbose=False,\n422 |     random_state=None,\n423 |     positive=False,\n424 | ):\n425 |     \"\"\"Update the dense dictionary factor in place.\n426 | \n427 |     Parameters\n428 |     ----------\n429 |     dictionary : ndarray of shape (n_components, n_features)\n430 |         Value of the dictionary at the previous iteration.\n431 | \n432 |     Y : ndarray of shape (n_samples, n_features)\n433 |         Data matrix.\n434 | \n435 |     code : ndarray of shape (n_samples, n_components)\n436 |         Sparse coding of the data against which to optimize the dictionary.\n437 | \n438 |     A : ndarray of shape (n_components, n_components), default=None\n439 |         Together with `B`, sufficient stats of the online model to update the\n440 |         dictionary.\n441 | \n442 |     B : ndarray of shape (n_features, n_components), default=None\n443 |         Together with `A`, sufficient stats of the online model to update the\n444 |         dictionary.\n445 | \n446 |     verbose: bool, default=False\n447 |         Degree of output the procedure will print.\n448 | \n449 |     random_state : int, RandomState instance or None, default=None\n450 |         Used for randomly initializing the dictionary. Pass an int for\n451 |         reproducible results across multiple function calls.\n452 |         See :term:`Glossary <random_state>`.\n453 | \n454 |     positive : bool, default=False\n455 |         Whether to enforce positivity when finding the dictionary.\n456 | \n457 |         .. versionadded:: 0.20\n458 |     \"\"\"\n459 |     n_samples, n_components = code.shape\n460 |     random_state = check_random_state(random_state)\n461 | \n462 |     if A is None:\n463 |         A = code.T @ code\n464 |     if B is None:\n465 |         B = Y.T @ code\n466 | \n467 |     n_unused = 0\n468 | \n469 |     for k in range(n_components):\n470 |         if A[k, k] > 1e-6:\n471 |             # 1e-6 is arbitrary but consistent with the spams implementation\n472 |             dictionary[k] += (B[:, k] - A[k] @ dictionary) / A[k, k]\n473 |         else:\n474 |             # kth atom is almost never used -> sample a new one from the data\n475 |             newd = Y[random_state.choice(n_samples)]\n476 | \n477 |             # add small noise to avoid making the sparse coding ill conditioned\n478 |             noise_level = 0.01 * (newd.std() or 1)  # avoid 0 std\n479 |             noise = random_state.normal(0, noise_level, size=len(newd))\n480 | \n481 |             dictionary[k] = newd + noise\n482 |             code[:, k] = 0\n483 |             n_unused += 1\n484 | \n485 |         if positive:\n486 |             np.clip(dictionary[k], 0, None, out=dictionary[k])\n487 | \n488 |         # Projection on the constraint set ||V_k|| <= 1\n489 |         dictionary[k] /= max(linalg.norm(dictionary[k]), 1)\n490 | \n491 |     if verbose and n_unused > 0:\n492 |         print(f\"{n_unused} unused atoms resampled.\")\n```\n\nFound file `benchmarks/bench_online_ocsvm.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `benchmarks/bench_online_ocsvm.py` for the full content if needed.\n\n\n\n##Searching for term \"online\", \"online learning_method beta_loss\"...\n### Search Result:\nFound function `sklearn/decomposition/_dict_learning.py:dict_learning_online`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 738 | def dict_learning_online(\n 739 |     X,\n 740 |     n_components=2,\n 741 |     *,\n 742 |     alpha=1,\n 743 |     n_iter=\"deprecated\",\n 744 |     max_iter=None,\n 745 |     return_code=True,\n 746 |     dict_init=None,\n 747 |     callback=None,\n 748 |     batch_size=\"warn\",\n 749 |     verbose=False,\n 750 |     shuffle=True,\n 751 |     n_jobs=None,\n 752 |     method=\"lars\",\n 753 |     iter_offset=\"deprecated\",\n 754 |     random_state=None,\n 755 |     return_inner_stats=\"deprecated\",\n 756 |     inner_stats=\"deprecated\",\n 757 |     return_n_iter=\"deprecated\",\n 758 |     positive_dict=False,\n 759 |     positive_code=False,\n 760 |     method_max_iter=1000,\n 761 |     tol=1e-3,\n 762 |     max_no_improvement=10,\n 763 | ):\n 764 |     \"\"\"Solves a dictionary learning matrix factorization problem online.\n 765 | \n 766 |     Finds the best dictionary and the corresponding sparse code for\n 767 |     approximating the data matrix X by solving::\n 768 | \n 769 |         (U^*, V^*) = argmin 0.5 || X - U V ||_Fro^2 + alpha * || U ||_1,1\n 770 |                      (U,V)\n 771 |                      with || V_k ||_2 = 1 for all  0 <= k < n_components\n 772 | \n 773 |     where V is the dictionary and U is the sparse code. ||.||_Fro stands for\n 774 |     the Frobenius norm and ||.||_1,1 stands for the entry-wise matrix norm\n 775 |     which is the sum of the absolute values of all the entries in the matrix.\n 776 |     This is accomplished by repeatedly iterating over mini-batches by slicing\n 777 |     the input data.\n 778 | \n 779 |     Read more in the :ref:`User Guide <DictionaryLearning>`.\n 780 | \n 781 |     Parameters\n 782 |     ----------\n 783 |     X : ndarray of shape (n_samples, n_features)\n 784 |         Data matrix.\n 785 | \n 786 |     n_components : int or None, default=2\n 787 |         Number of dictionary atoms to extract. If None, then ``n_components``\n 788 |         is set to ``n_features``.\n 789 | \n 790 |     alpha : float, default=1\n 791 |         Sparsity controlling parameter.\n 792 | \n 793 |     n_iter : int, default=100\n 794 |         Number of mini-batch iterations to perform.\n 795 | \n 796 |         .. deprecated:: 1.1\n 797 |            `n_iter` is deprecated in 1.1 and will be removed in 1.3. Use\n 798 |            `max_iter` instead.\n 799 | \n 800 |     max_iter : int, default=None\n 801 |         Maximum number of iterations over the complete dataset before\n 802 |         stopping independently of any early stopping criterion heuristics.\n 803 |         If ``max_iter`` is not None, ``n_iter`` is ignored.\n 804 | \n 805 |         .. versionadded:: 1.1\n 806 | \n 807 |     return_code : bool, default=True\n 808 |         Whether to also return the code U or just the dictionary `V`.\n 809 | \n 810 |     dict_init : ndarray of shape (n_components, n_features), default=None\n 811 |         Initial value for the dictionary for warm restart scenarios.\n 812 | \n 813 |     callback : callable, default=None\n 814 |         A callable that gets invoked at the end of each iteration.\n 815 | \n 816 |     batch_size : int, default=3\n 817 |         The number of samples to take in each batch.\n 818 | \n 819 |     verbose : bool, default=False\n 820 |         To control the verbosity of the procedure.\n 821 | \n 822 |     shuffle : bool, default=True\n 823 |         Whether to shuffle the data before splitting it in batches.\n 824 | \n 825 |     n_jobs : int, default=None\n 826 |         Number of parallel jobs to run.\n 827 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 828 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 829 |         for more details.\n 830 | \n 831 |     method : {'lars', 'cd'}, default='lars'\n 832 |         * `'lars'`: uses the least angle regression method to solve the lasso\n 833 |           problem (`linear_model.lars_path`);\n 834 |         * `'cd'`: uses the coordinate descent method to compute the\n 835 |           Lasso solution (`linear_model.Lasso`). Lars will be faster if\n 836 |           the estimated components are sparse.\n 837 | \n 838 |     iter_offset : int, default=0\n 839 |         Number of previous iterations completed on the dictionary used for\n 840 |         initialization.\n 841 | \n 842 |         .. deprecated:: 1.1\n 843 |            `iter_offset` serves internal purpose only and will be removed in 1.3.\n 844 | \n 845 |     random_state : int, RandomState instance or None, default=None\n 846 |         Used for initializing the dictionary when ``dict_init`` is not\n 847 |         specified, randomly shuffling the data when ``shuffle`` is set to\n 848 |         ``True``, and updating the dictionary. Pass an int for reproducible\n 849 |         results across multiple function calls.\n 850 |         See :term:`Glossary <random_state>`.\n 851 | \n 852 |     return_inner_stats : bool, default=False\n 853 |         Return the inner statistics A (dictionary covariance) and B\n 854 |         (data approximation). Useful to restart the algorithm in an\n 855 |         online setting. If `return_inner_stats` is `True`, `return_code` is\n 856 |         ignored.\n 857 | \n 858 |         .. deprecated:: 1.1\n 859 |            `return_inner_stats` serves internal purpose only and will be removed in 1.3.\n 860 | \n 861 |     inner_stats : tuple of (A, B) ndarrays, default=None\n 862 |        