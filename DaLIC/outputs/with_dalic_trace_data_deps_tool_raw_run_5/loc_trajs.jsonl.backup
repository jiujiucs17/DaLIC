                parallel=parallel,\n637 |                         )\n638 |                 else:\n639 |                     # batch update\n640 |                     self._em_step(\n641 |                         X, total_samples=n_samples, batch_update=True, parallel=parallel\n642 |                     )\n643 | \n644 |                 # check perplexity\n645 |                 if evaluate_every > 0 and (i + 1) % evaluate_every == 0:\n646 |                     doc_topics_distr, _ = self._e_step(\n647 |                         X, cal_sstats=False, random_init=False, parallel=parallel\n648 |                     )\n649 |                     bound = self._perplexity_precomp_distr(\n650 |                         X, doc_topics_distr, sub_sampling=False\n651 |                     )\n652 |                     if self.verbose:\n653 |                         print(\n654 |                             \"iteration: %d of max_iter: %d, perplexity: %.4f\"\n655 |                             % (i + 1, max_iter, bound)\n656 |                         )\n657 | \n658 |                     if last_bound and abs(last_bound - bound) < self.perp_tol:\n659 |                         break\n660 |                     last_bound = bound\n661 | \n662 |                 elif self.verbose:\n663 |                     print(\"iteration: %d of max_iter: %d\" % (i + 1, max_iter))\n664 |                 self.n_iter_ += 1\n665 | \n666 |         # calculate final perplexity value on train set\n667 |         doc_topics_distr, _ = self._e_step(\n668 |             X, cal_sstats=False, random_init=False, parallel=parallel\n669 |         )\n670 |         self.bound_ = self._perplexity_precomp_distr(\n671 |             X, doc_topics_distr, sub_sampling=False\n672 |         )\n673 | \n674 |         return self\n```\n\n\n\n##Searching for term \"beta_loss\", \"online learning_method beta_loss\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\nSource: Retrieved code content using keyword search (bm25).\n```\n725 | def _fit_multiplicative_update(\n726 |     X,\n727 |     W,\n728 |     H,\n729 |     beta_loss=\"frobenius\",\n730 |     max_iter=200,\n731 |     tol=1e-4,\n732 |     l1_reg_W=0,\n733 |     l1_reg_H=0,\n734 |     l2_reg_W=0,\n735 |     l2_reg_H=0,\n736 |     update_H=True,\n737 |     verbose=0,\n738 | ):\n739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n740 | \n741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n742 |     alternating minimization of W and H. Each minimization is done with a\n743 |     Multiplicative Update.\n744 | \n745 |     Parameters\n746 |     ----------\n747 |     X : array-like of shape (n_samples, n_features)\n748 |         Constant input matrix.\n749 | \n750 |     W : array-like of shape (n_samples, n_components)\n751 |         Initial guess for the solution.\n752 | \n753 |     H : array-like of shape (n_components, n_features)\n754 |         Initial guess for the solution.\n755 | \n756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n757 |             'itakura-saito'}, default='frobenius'\n758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n759 |         Beta divergence to be minimized, measuring the distance between X\n760 |         and the dot product WH. Note that values different from 'frobenius'\n761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n763 |         matrix X cannot contain zeros.\n764 | \n765 |     max_iter : int, default=200\n766 |         Number of iterations.\n767 | \n768 |     tol : float, default=1e-4\n769 |         Tolerance of the stopping condition.\n770 | \n771 |     l1_reg_W : float, default=0.\n772 |         L1 regularization parameter for W.\n773 | \n774 |     l1_reg_H : float, default=0.\n775 |         L1 regularization parameter for H.\n776 | \n777 |     l2_reg_W : float, default=0.\n778 |         L2 regularization parameter for W.\n779 | \n780 |     l2_reg_H : float, default=0.\n781 |         L2 regularization parameter for H.\n782 | \n783 |     update_H : bool, default=True\n784 |         Set to True, both W and H will be estimated from initial guesses.\n785 |         Set to False, only W will be estimated.\n786 | \n787 |     verbose : int, default=0\n788 |         The verbosity level.\n789 | \n790 |     Returns\n791 |     -------\n792 |     W : ndarray of shape (n_samples, n_components)\n793 |         Solution to the non-negative least squares problem.\n794 | \n795 |     H : ndarray of shape (n_components, n_features)\n796 |         Solution to the non-negative least squares problem.\n797 | \n798 |     n_iter : int\n799 |         The number of iterations done by the algorithm.\n800 | \n801 |     References\n802 |     ----------\n803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n805 |     \"\"\"\n806 |     start_time = time.time()\n807 | \n808 |     beta_loss = _beta_loss_to_float(beta_loss)\n809 | \n810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n811 |     if beta_loss < 1:\n812 |         gamma = 1.0 / (2.0 - beta_loss)\n813 |     elif beta_loss > 2:\n814 |         gamma = 1.0 / (beta_loss - 1.0)\n815 |     else:\n816 |         gamma = 1.0\n817 | \n818 |     # used for the convergence criterion\n819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n820 |     previous_error = error_at_init\n821 | \n822 |     H_sum, HHt, XHt = None, None, None\n823 |     for n_iter in range(1, max_iter + 1):\n824 |         # update W\n825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n\nFound function `sklearn/decomposition/_nmf.py:_beta_loss_to_float`.\nSource: Retrieved entity using keyword search (bm25).\n```\n218 | def _beta_loss_to_float(beta_loss):\n219 |     \"\"\"Convert string beta_loss to float.\"\"\"\n220 |     allowed_beta_loss = {\"frobenius\": 2, \"kullback-leibler\": 1, \"itakura-saito\": 0}\n221 |     if isinstance(beta_loss, str) and beta_loss in allowed_beta_loss:\n222 |         beta_loss = allowed_beta_loss[beta_loss]\n223 | \n224 |     if not isinstance(beta_loss, numbers.Number):\n225 |         raise ValueError(\n226 |             \"Invalid beta_loss parameter: got %r instead of one of %r, or a float.\"\n227 |             % (beta_loss, allowed_beta_loss.keys())\n228 |         )\n229 |     return beta_loss\n```\n\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_h`.\nSource: Retrieved code content using keyword search (bm25).\n```\n643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n645 |     if beta_loss == 2:\n646 |         numerator = safe_sparse_dot(W.T, X)\n647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n648 | \n649 |     else:\n650 |         # Numerator\n651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n652 |         if sp.issparse(X):\n653 |             WH_safe_X_data = WH_safe_X.data\n654 |             X_data = X.data\n655 |         else:\n656 |             WH_safe_X_data = WH_safe_X\n657 |             X_data = X\n658 |             # copy used in the Denominator\n659 |             WH = WH_safe_X.copy()\n660 |             if beta_loss - 1.0 < 0:\n661 |                 WH[WH == 0] = EPSILON\n662 | \n663 |         # to avoid division by zero\n664 |         if beta_loss - 2.0 < 0:\n665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n666 | \n667 |         if beta_loss == 1:\n668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n669 |         elif beta_loss == 0:\n670 |             # speeds up computation time\n671 |             # refer to /numpy/numpy/issues/9363\n672 |             WH_safe_X_data **= -1\n673 |             WH_safe_X_data **= 2\n674 |             # element-wise multiplication\n675 |             WH_safe_X_data *= X_data\n676 |         else:\n677 |             WH_safe_X_data **= beta_loss - 2\n678 |             # element-wise multiplication\n679 |             WH_safe_X_data *= X_data\n680 | \n681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n683 | \n684 |         # Denominator\n685 |         if beta_loss == 1:\n686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n687 |             W_sum[W_sum == 0] = 1.0\n688 |             denominator = W_sum[:, np.newaxis]\n689 | \n690 |         # beta_loss not in (1, 2)\n691 |         else:\n692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n693 |             if sp.issparse(X):\n694 |                 # memory efficient computation\n695 |                 # (compute column by column, avoiding the dense matrix WH)\n696 |                 WtWH = np.empty(H.shape)\n697 |                 for i in range(X.shape[1]):\n698 |                     WHi = np.dot(W, H[:, i])\n699 |                     if beta_loss - 1 < 0:\n700 |                         WHi[WHi == 0] = EPSILON\n701 |                     WHi **= beta_loss - 1\n702 |                     WtWH[:, i] = np.dot(W.T, WHi)\n703 |             else:\n704 |                 WH **= beta_loss - 1\n705 |                 WtWH = np.dot(W.T, WH)\n706 |             denominator = WtWH\n707 | \n708 |     # Add L1 and L2 regularization\n709 |     if l1_reg_H > 0:\n710 |         denominator += l1_reg_H\n711 |     if l2_reg_H > 0:\n712 |         denominator = denominator + l2_reg_H * H\n713 |     denominator[denominator == 0] = EPSILON\n714 | \n715 |     numerator /= denominator\n716 |     delta_H = numerator\n717 | \n718 |     # gamma is in ]0, 1]\n719 |     if gamma != 1:\n720 |         delta_H **= gamma\n721 | \n722 |     return delta_H\n```\n\n\n\n##Searching for term \"beta_loss\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_w`.\nSource: Retrieved code content using keyword search (bm25).\n```\n537 | def _multiplicative_update_w(\n538 |     X,\n539 |     W,\n540 |     H,\n541 |     beta_loss,\n542 |     l1_reg_W,\n543 |     l2_reg_W,\n544 |     gamma,\n545 |     H_sum=None,\n546 |     HHt=None,\n547 |     XHt=None,\n548 |     update_H=True,\n549 | ):\n550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n551 |     if beta_loss == 2:\n552 |         # Numerator\n553 |         if XHt is None:\n554 |             XHt = safe_sparse_dot(X, H.T)\n555 |         if update_H:\n556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n557 |             numerator = XHt\n558 |         else:\n559 |             # preserve the XHt, which is not re-computed (update_H=False)\n560 |             numerator = XHt.copy()\n561 | \n562 |         # Denominator\n563 |         if HHt is None:\n564 |             HHt = np.dot(H, H.T)\n565 |         denominator = np.dot(W, HHt)\n566 | \n567 |     else:\n568 |         # Numerator\n569 |         # if X is sparse, compute WH only where X is non zero\n570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n571 |         if sp.issparse(X):\n572 |             WH_safe_X_data = WH_safe_X.data\n573 |             X_data = X.data\n574 |         else:\n575 |             WH_safe_X_data = WH_safe_X\n576 |             X_data = X\n577 |             # copy used in the Denominator\n578 |             WH = WH_safe_X.copy()\n579 |             if beta_loss - 1.0 < 0:\n580 |                 WH[WH == 0] = EPSILON\n581 | \n582 |         # to avoid taking a negative power of zero\n583 |         if beta_loss - 2.0 < 0:\n584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n585 | \n586 |         if beta_loss == 1:\n587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n588 |         elif beta_loss == 0:\n589 |             # speeds up computation time\n590 |             # refer to /numpy/numpy/issues/9363\n591 |             WH_safe_X_data **= -1\n592 |             WH_safe_X_data **= 2\n593 |             # element-wise multiplication\n594 |             WH_safe_X_data *= X_data\n595 |         else:\n596 |             WH_safe_X_data **= beta_loss - 2\n597 |             # element-wise multiplication\n598 |             WH_safe_X_data *= X_data\n599 | \n600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n602 | \n603 |         # Denominator\n604 |         if beta_loss == 1:\n605 |             if H_sum is None:\n606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n607 |             denominator = H_sum[np.newaxis, :]\n608 | \n609 |         else:\n610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n611 |             if sp.issparse(X):\n612 |                 # memory efficient computation\n613 |                 # (compute row by row, avoiding the dense matrix WH)\n614 |                 WHHt = np.empty(W.shape)\n615 |                 for i in range(X.shape[0]):\n616 |                     WHi = np.dot(W[i, :], H)\n617 |                     if beta_loss - 1 < 0:\n618 |                         WHi[WHi == 0] = EPSILON\n619 |                     WHi **= beta_loss - 1\n620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n621 |             else:\n622 |                 WH **= beta_loss - 1\n623 |                 WHHt = np.dot(WH, H.T)\n624 |             denominator = WHHt\n625 | \n626 |     # Add L1 and L2 regularization\n627 |     if l1_reg_W > 0:\n628 |         denominator += l1_reg_W\n629 |     if l2_reg_W > 0:\n630 |         denominator = denominator + l2_reg_W * W\n631 |     denominator[denominator == 0] = EPSILON\n632 | \n633 |     numerator /= denominator\n634 |     delta_W = numerator\n635 | \n636 |     # gamma is in ]0, 1]\n637 |     if gamma != 1:\n638 |         delta_W **= gamma\n639 | \n640 |     return delta_W, H_sum, HHt, XHt\n```\n\nFound function `sklearn/metrics/_classification.py:zero_one_loss`.\nSource: Retrieved entity using keyword search (bm25).\n```\n922 | def zero_one_loss(y_true, y_pred, *, normalize=True, sample_weight=None):\n923 |     \"\"\"Zero-one classification loss.\n924 | \n925 |     If normalize is ``True``, return the fraction of misclassifications\n926 |     (float), else it returns the number of misclassifications (int). The best\n927 |     performance is 0.\n928 | \n929 |     Read more in the :ref:`User Guide <zero_one_loss>`.\n930 | \n931 |     Parameters\n932 |     ----------\n933 |     y_true : 1d array-like, or label indicator array / sparse matrix\n934 |         Ground truth (correct) labels.\n935 | \n936 |     y_pred : 1d array-like, or label indicator array / sparse matrix\n937 |         Predicted labels, as returned by a classifier.\n938 | \n939 |     normalize : bool, default=True\n940 |         If ``False``, return the number of misclassifications.\n941 |         Otherwise, return the fraction of misclassifications.\n942 | \n943 |     sample_weight : array-like of shape (n_samples,), default=None\n944 |         Sample weights.\n945 | \n946 |     Returns\n947 |     -------\n948 |     loss : float or int,\n949 |         If ``normalize == True``, return the fraction of misclassifications\n950 |         (float), else it returns the number of misclassifications (int).\n951 | \n952 |     See Also\n953 |     --------\n954 |     accuracy_score : Compute the accuracy score. By default, the function will\n955 |         return the fraction of correct predictions divided by the total number\n956 |         of predictions.\n957 |     hamming_loss : Compute the average Hamming loss or Hamming distance between\n958 |         two sets of samples.\n959 |     jaccard_score : Compute the Jaccard similarity coefficient score.\n960 | \n961 |     Notes\n962 |     -----\n963 |     In multilabel classification, the zero_one_loss function corresponds to\n964 |     the subset zero-one loss: for each sample, the entire set of labels must be\n965 |     correctly predicted, otherwise the loss for that sample is equal to one.\n966 | \n967 |     Examples\n968 |     --------\n969 |     >>> from sklearn.metrics import zero_one_loss\n970 |     >>> y_pred = [1, 2, 3, 4]\n971 |     >>> y_true = [2, 2, 3, 4]\n972 |     >>> zero_one_loss(y_true, y_pred)\n973 |     0.25\n974 |     >>> zero_one_loss(y_true, y_pred, normalize=False)\n975 |     1\n976 | \n977 |     In the multilabel case with binary label indicators:\n978 | \n979 |     >>> import numpy as np\n980 |     >>> zero_one_loss(np.array([[0, 1], [1, 1]]), np.ones((2, 2)))\n981 |     0.5\n982 |     \"\"\"\n983 |     score = accuracy_score(\n984 |         y_true, y_pred, normalize=normalize, sample_weight=sample_weight\n985 |     )\n986 | \n987 |     if normalize:\n988 |         return 1 - score\n989 |     else:\n990 |         if sample_weight is not None:\n991 |             n_samples = np.sum(sample_weight)\n992 |         else:\n993 |             n_samples = _num_samples(y_true)\n994 |         return n_samples - score\n```\n\nFound function `sklearn/metrics/_classification.py:hamming_loss`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2230 | def hamming_loss(y_true, y_pred, *, sample_weight=None):\n2231 |     \"\"\"Compute the average Hamming loss.\n2232 | \n2233 |     The Hamming loss is the fraction of labels that are incorrectly predicted.\n2234 | \n2235 |     Read more in the :ref:`User Guide <hamming_loss>`.\n2236 | \n2237 |     Parameters\n2238 |     ----------\n2239 |     y_true : 1d array-like, or label indicator array / sparse matrix\n2240 |         Ground truth (correct) labels.\n2241 | \n2242 |     y_pred : 1d array-like, or label indicator array / sparse matrix\n2243 |         Predicted labels, as returned by a classifier.\n2244 | \n2245 |     sample_weight : array-like of shape (n_samples,), default=None\n2246 |         Sample weights.\n2247 | \n2248 |         .. versionadded:: 0.18\n2249 | \n2250 |     Returns\n2251 |     -------\n2252 |     loss : float or int\n2253 |         Return the average Hamming loss between element of ``y_true`` and\n2254 |         ``y_pred``.\n2255 | \n2256 |     See Also\n2257 |     --------\n2258 |     accuracy_score : Compute the accuracy score. By default, the function will\n2259 |         return the fraction of correct predictions divided by the total number\n2260 |         of predictions.\n2261 |     jaccard_score : Compute the Jaccard similarity coefficient score.\n2262 |     zero_one_loss : Compute the Zero-one classification loss. By default, the\n2263 |         function will return the percentage of imperfectly predicted subsets.\n2264 | \n2265 |     Notes\n2266 |     -----\n2267 |     In multiclass classification, the Hamming loss corresponds to the Hamming\n2268 |     distance between ``y_true`` and ``y_pred`` which is equivalent to the\n2269 |     subset ``zero_one_loss`` function, when `normalize` parameter is set to\n2270 |     True.\n2271 | \n2272 |     In multilabel classification, the Hamming loss is different from the\n2273 |     subset zero-one loss. The zero-one loss considers the entire set of labels\n2274 |     for a given sample incorrect if it does not entirely match the true set of\n2275 |     labels. Hamming loss is more forgiving in that it penalizes only the\n2276 |     individual labels.\n2277 | \n2278 |     The Hamming loss is upperbounded by the subset zero-one loss, when\n2279 |     `normalize` parameter is set to True. It is always between 0 and 1,\n2280 |     lower being better.\n2281 | \n2282 |     References\n2283 |     ----------\n2284 |     .. [1] Grigorios Tsoumakas, Ioannis Katakis. Multi-Label Classification:\n2285 |            An Overview. International Journal of Data Warehousing & Mining,\n2286 |            3(3), 1-13, July-September 2007.\n2287 | \n2288 |     .. [2] `Wikipedia entry on the Hamming distance\n2289 |            <https://en.wikipedia.org/wiki/Hamming_distance>`_.\n2290 | \n2291 |     Examples\n2292 |     --------\n2293 |     >>> from sklearn.metrics import hamming_loss\n2294 |     >>> y_pred = [1, 2, 3, 4]\n2295 |     >>> y_true = [2, 2, 3, 4]\n2296 |     >>> hamming_loss(y_true, y_pred)\n2297 |     0.25\n2298 | \n2299 |     In the multilabel case with binary label indicators:\n2300 | \n2301 |     >>> import numpy as np\n2302 |     >>> hamming_loss(np.array([[0, 1], [1, 1]]), np.zeros((2, 2)))\n2303 |     0.75\n2304 |     \"\"\"\n2305 | \n2306 |     y_type, y_true, y_pred = _check_targets(y_true, y_pred)\n2307 |     check_consistent_length(y_true, y_pred, sample_weight)\n2308 | \n2309 |     if sample_weight is None:\n2310 |         weight_average = 1.0\n2311 |     else:\n2312 |         weight_average = np.mean(sample_weight)\n2313 | \n2314 |     if y_type.startswith(\"multilabel\"):\n2315 |         n_differences = count_nonzero(y_true - y_pred, sample_weight=sample_weight)\n2316 |         return n_differences / (y_true.shape[0] * y_true.shape[1] * weight_average)\n2317 | \n2318 |     elif y_type in [\"binary\", \"multiclass\"]:\n2319 |         return _weighted_sum(y_true != y_pred, sample_weight, normalize=True)\n2320 |     else:\n2321 |         raise ValueError(\"{0} is not supported\".format(y_type))\n```\n\n\n\n##Searching for term \"online learning_method beta_loss\"...\n### Search Result:\nFound function `examples/model_selection/plot_learning_curve.py:plot_learning_curve`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 29 | def plot_learning_curve(\n 30 |     estimator,\n 31 |     title,\n 32 |     X,\n 33 |     y,\n 34 |     axes=None,\n 35 |     ylim=None,\n 36 |     cv=None,\n 37 |     n_jobs=None,\n 38 |     train_sizes=np.linspace(0.1, 1.0, 5),\n 39 | ):\n 40 |     \"\"\"\n 41 |     Generate 3 plots: the test and training learning curve, the training\n 42 |     samples vs fit times curve, the fit times vs score curve.\n 43 | \n 44 |     Parameters\n 45 |     ----------\n 46 |     estimator : estimator instance\n 47 |         An estimator instance implementing `fit` and `predict` methods which\n 48 |         will be cloned for each validation.\n 49 | \n 50 |     title : str\n 51 |         Title for the chart.\n 52 | \n 53 |     X : array-like of shape (n_samples, n_features)\n 54 |         Training vector, where ``n_samples`` is the number of samples and\n 55 |         ``n_features`` is the number of features.\n 56 | \n 57 |     y : array-like of shape (n_samples) or (n_samples, n_features)\n 58 |         Target relative to ``X`` for classification or regression;\n 59 |         None for unsupervised learning.\n 60 | \n 61 |     axes : array-like of shape (3,), default=None\n 62 |         Axes to use for plotting the curves.\n 63 | \n 64 |     ylim : tuple of shape (2,), default=None\n 65 |         Defines minimum and maximum y-values plotted, e.g. (ymin, ymax).\n 66 | \n 67 |     cv : int, cross-validation generator or an iterable, default=None\n 68 |         Determines the cross-validation splitting strategy.\n 69 |         Possible inputs for cv are:\n 70 | \n 71 |           - None, to use the default 5-fold cross-validation,\n 72 |           - integer, to specify the number of folds.\n 73 |           - :term:`CV splitter`,\n 74 |           - An iterable yielding (train, test) splits as arrays of indices.\n 75 | \n 76 |         For integer/None inputs, if ``y`` is binary or multiclass,\n 77 |         :class:`StratifiedKFold` used. If the estimator is not a classifier\n 78 |         or if ``y`` is neither binary nor multiclass, :class:`KFold` is used.\n 79 | \n 80 |         Refer :ref:`User Guide <cross_validation>` for the various\n 81 |         cross-validators that can be used here.\n 82 | \n 83 |     n_jobs : int or None, default=None\n 84 |         Number of jobs to run in parallel.\n 85 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 86 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 87 |         for more details.\n 88 | \n 89 |     train_sizes : array-like of shape (n_ticks,)\n 90 |         Relative or absolute numbers of training examples that will be used to\n 91 |         generate the learning curve. If the ``dtype`` is float, it is regarded\n 92 |         as a fraction of the maximum size of the training set (that is\n 93 |         determined by the selected validation method), i.e. it has to be within\n 94 |         (0, 1]. Otherwise it is interpreted as absolute sizes of the training\n 95 |         sets. Note that for classification the number of samples usually have\n 96 |         to be big enough to contain at least one sample from each class.\n 97 |         (default: np.linspace(0.1, 1.0, 5))\n 98 |     \"\"\"\n 99 |     if axes is None:\n100 |         _, axes = plt.subplots(1, 3, figsize=(20, 5))\n101 | \n102 |     axes[0].set_title(title)\n103 |     if ylim is not None:\n104 |         axes[0].set_ylim(*ylim)\n105 |     axes[0].set_xlabel(\"Training examples\")\n106 |     axes[0].set_ylabel(\"Score\")\n107 | \n108 |     train_sizes, train_scores, test_scores, fit_times, _ = learning_curve(\n109 |         estimator,\n110 |         X,\n111 |         y,\n112 |         cv=cv,\n113 |         n_jobs=n_jobs,\n114 |         train_sizes=train_sizes,\n115 |         return_times=True,\n116 |     )\n117 |     train_scores_mean = np.mean(train_scores, axis=1)\n118 |     train_scores_std = np.std(train_scores, axis=1)\n119 |     test_scores_mean = np.mean(test_scores, axis=1)\n120 |     test_scores_std = np.std(test_scores, axis=1)\n121 |     fit_times_mean = np.mean(fit_times, axis=1)\n122 |     fit_times_std = np.std(fit_times, axis=1)\n123 | \n124 |     # Plot learning curve\n125 |     axes[0].grid()\n126 |     axes[0].fill_between(\n127 |         train_sizes,\n128 |         train_scores_mean - train_scores_std,\n129 |         train_scores_mean + train_scores_std,\n130 |         alpha=0.1,\n131 |         color=\"r\",\n132 |     )\n133 |     axes[0].fill_between(\n134 |         train_sizes,\n135 |         test_scores_mean - test_scores_std,\n136 |         test_scores_mean + test_scores_std,\n137 |         alpha=0.1,\n138 |         color=\"g\",\n139 |     )\n140 |     axes[0].plot(\n141 |         train_sizes, train_scores_mean, \"o-\", color=\"r\", label=\"Training score\"\n142 |     )\n143 |     axes[0].plot(\n144 |         train_sizes, test_scores_mean, \"o-\", color=\"g\", label=\"Cross-validation score\"\n145 |     )\n146 |     axes[0].legend(loc=\"best\")\n147 | \n148 |     # Plot n_samples vs fit_times\n149 |     axes[1].grid()\n150 |     axes[1].plot(train_sizes, fit_times_mean, \"o-\")\n151 |     axes[1].fill_between(\n152 |         train_sizes,\n153 |         fit_times_mean - fit_times_std,\n154 |         fit_times_mean + fit_times_std,\n155 |         alpha=0.1,\n156 |     )\n157 |     axes[1].set_xlabel(\"Training examples\")\n158 |     axes[1].set_ylabel(\"fit_times\")\n159 |     axes[1].set_title(\"Scalability of the model\")\n160 | \n161 |     # Plot fit_time vs score\n162 |     fit_time_argsort = fit_times_mean.argsort()\n163 |     fit_time_sorted = fit_times_mean[fit_time_argsort]\n164 |     test_scores_mean_sorted = test_scores_mean[fit_time_argsort]\n165 |     test_scores_std_sorted = test_scores_std[fit_time_argsort]\n166 |     axes[2].grid()\n167 |     axes[2].plot(fit_time_sorted, test_scores_mean_sorted, \"o-\")\n168 |     axes[2].fill_between(\n169 |         fit_time_sorted,\n170 |         test_scores_mean_sorted - test_scores_std_sorted,\n171 |         test_scores_mean_sorted + test_scores_std_sorted,\n172 |         alpha=0.1,\n173 |     )\n174 |     axes[2].set_xlabel(\"fit_times\")\n175 |     axes[2].set_ylabel(\"Score\")\n176 |     axes[2].set_title(\"Performance of the model\")\n177 | \n178 |     return plt\n```\n\nFound file `examples/model_selection/plot_learning_curve.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/model_selection/plot_learning_curve.py` for the full content if needed.\n"}, {"content": "Let me also check for any existing online learning functionality:\n\n<function=search_code_snippets>\n<parameter=search_terms>['online learning', 'partial_fit', 'partial_fit']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/decomposition/_lda.py:LatentDirichletAllocation\nsklearn/decomposition/_lda.py:LatentDirichletAllocation._em_step\nsklearn/decomposition/_lda.py:LatentDirichletAllocation.fit\nexamples/decomposition/plot_faces_decomposition.py:impl:29\nsklearn/cluster/_birch.py:Birch._get_leaves\nsklearn/cluster/_birch.py:Birch.partial_fit\nexamples/linear_model/plot_sgdocsvm_vs_ocsvm.py:impl:103\nexamples/linear_model/plot_sgdocsvm_vs_ocsvm.py:impl:79\nexamples/linear_model/plot_sgdocsvm_vs_ocsvm.py:impl:30\nbenchmarks/bench_online_ocsvm.py:impl:190\nsklearn/naive_bayes.py:GaussianNB.partial_fit\n##Searching for term \"online learning\"...\n### Search Result:\nFound code snippet in file `examples/cluster/plot_dict_face_patches.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | Online learning of a dictionary of parts of faces\n 3 | =================================================\n 4 | \n 5 | This example uses a large dataset of faces to learn a set of 20 x 20\n 6 | images patches that constitute faces.\n 7 | \n 8 | From the programming standpoint, it is interesting because it shows how\n 9 | to use the online API of the scikit-learn to process a very large\n10 | dataset by chunks. The way we proceed is that we load an image at a time\n11 | and extract randomly 50 patches from this image. Once we have accumulated\n12 | 500 of these patches (using 10 images), we run the\n13 | :func:`~sklearn.cluster.MiniBatchKMeans.partial_fit` method\n14 | of the online KMeans object, MiniBatchKMeans.\n15 | \n16 | The verbose setting on the MiniBatchKMeans enables us to see that some\n17 | clusters are reassigned during the successive calls to\n18 | partial-fit. This is because the number of patches that they represent\n19 | has become too low, and it is better to choose a random new\n20 | cluster.\n21 | \n22 | \"\"\"\n23 | \n24 | # %%\n25 | # Load the data\n26 | # -------------\n27 | \n28 | from sklearn import datasets\n29 | \n30 | faces = datasets.fetch_olivetti_faces()\n31 | \n32 | # %%\n33 | # Learn the dictionary of images\n34 | # ------------------------------\n35 | \n36 | import time\n37 | \n38 | import numpy as np\n39 | \n40 | from sklearn.cluster import MiniBatchKMeans\n41 | from sklearn.feature_extraction.image import extract_patches_2d\n42 | \n43 | print(\"Learning the dictionary... \")\n44 | rng = np.random.RandomState(0)\n45 | kmeans = MiniBatchKMeans(n_clusters=81, random_state=rng, verbose=True)\n46 | patch_size = (20, 20)\n47 | \n48 | buffer = []\n49 | t0 = time.time()\n50 | \n51 | # The online learning part: cycle over the whole dataset 6 times\n52 | index = 0\n53 | for _ in range(6):\n54 |     for img in faces.images:\n55 |         data = extract_patches_2d(img, patch_size, max_patches=50, random_state=rng)\n56 |         data = np.reshape(data, (len(data), -1))\n57 |         buffer.append(data)\n58 |         index += 1\n59 |         if index % 10 == 0:\n60 |             data = np.concatenate(buffer, axis=0)\n61 |             data -= np.mean(data, axis=0)\n62 |             data /= np.std(data, axis=0)\n63 |             kmeans.partial_fit(data)\n64 |             buffer = []\n65 |         if index % 100 == 0:\n66 |             print(\"Partial fit of %4i out of %i\" % (index, 6 * len(faces.images)))\n67 | \n68 | dt = time.time() - t0\n69 | print(\"done in %.2fs.\" % dt)\n70 | \n71 | # %%\n72 | # Plot the results\n73 | # ----------------\n74 | \n75 | import matplotlib.pyplot as plt\n```\n\nFound `examples/applications/plot_out_of_core_classification.py:_not_in_sphinx`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ======================================================\n  3 | Out-of-core classification of text documents\n  4 | ======================================================\n  5 | \n  6 | This is an example showing how scikit-learn can be used for classification\n  7 | using an out-of-core approach: learning from data that doesn't fit into main\n  8 | memory. We make use of an online classifier, i.e., one that supports the\n  9 | partial_fit method, that will be fed with batches of examples. To guarantee\n 10 | that the features space remains the same over time we leverage a\n 11 | HashingVectorizer that will project each example into the same feature space.\n 12 | This is especially useful in the case of text classification where new\n 13 | features (words) may appear in each batch.\n 14 | \n 15 | \"\"\"\n 16 | \n 17 | # Authors: Eustache Diemert <eustache@diemert.fr>\n 18 | #          @FedericoV <https://github.com/FedericoV/>\n 19 | # License: BSD 3 clause\n 20 | \n 21 | from glob import glob\n 22 | import itertools\n 23 | import os.path\n 24 | import re\n 25 | import tarfile\n 26 | import time\n 27 | import sys\n 28 | \n 29 | import numpy as np\n 30 | import matplotlib.pyplot as plt\n 31 | from matplotlib import rcParams\n 32 | \n 33 | from html.parser import HTMLParser\n 34 | from urllib.request import urlretrieve\n 35 | from sklearn.datasets import get_data_home\n 36 | from sklearn.feature_extraction.text import HashingVectorizer\n 37 | from sklearn.linear_model import SGDClassifier\n 38 | from sklearn.linear_model import PassiveAggressiveClassifier\n 39 | from sklearn.linear_model import Perceptron\n 40 | from sklearn.naive_bayes import MultinomialNB\n 41 | \n 42 | \n 43 | def _not_in_sphinx():\n 44 |     # Hack to detect whether we are running by the sphinx builder\n 45 |     return \"__file__\" in globals()\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:dict_learning_online`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 738 | def dict_learning_online(\n 739 |     X,\n 740 |     n_components=2,\n 741 |     *,\n 742 |     alpha=1,\n 743 |     n_iter=\"deprecated\",\n 744 |     max_iter=None,\n 745 |     return_code=True,\n 746 |     dict_init=None,\n 747 |     callback=None,\n 748 |     batch_size=\"warn\",\n 749 |     verbose=False,\n 750 |     shuffle=True,\n 751 |     n_jobs=None,\n 752 |     method=\"lars\",\n 753 |     iter_offset=\"deprecated\",\n 754 |     random_state=None,\n 755 |     return_inner_stats=\"deprecated\",\n 756 |     inner_stats=\"deprecated\",\n 757 |     return_n_iter=\"deprecated\",\n 758 |     positive_dict=False,\n 759 |     positive_code=False,\n 760 |     method_max_iter=1000,\n 761 |     tol=1e-3,\n 762 |     max_no_improvement=10,\n 763 | ):\n 764 |     \"\"\"Solves a dictionary learning matrix factorization problem online.\n 765 | \n 766 |     Finds the best dictionary and the corresponding sparse code for\n 767 |     approximating the data matrix X by solving::\n 768 | \n 769 |         (U^*, V^*) = argmin 0.5 || X - U V ||_Fro^2 + alpha * || U ||_1,1\n 770 |                      (U,V)\n 771 |                      with || V_k ||_2 = 1 for all  0 <= k < n_components\n 772 | \n 773 |     where V is the dictionary and U is the sparse code. ||.||_Fro stands for\n 774 |     the Frobenius norm and ||.||_1,1 stands for the entry-wise matrix norm\n 775 |     which is the sum of the absolute values of all the entries in the matrix.\n 776 |     This is accomplished by repeatedly iterating over mini-batches by slicing\n 777 |     the input data.\n 778 | \n 779 |     Read more in the :ref:`User Guide <DictionaryLearning>`.\n 780 | \n 781 |     Parameters\n 782 |     ----------\n 783 |     X : ndarray of shape (n_samples, n_features)\n 784 |         Data matrix.\n 785 | \n 786 |     n_components : int or None, default=2\n 787 |         Number of dictionary atoms to extract. If None, then ``n_components``\n 788 |         is set to ``n_features``.\n 789 | \n 790 |     alpha : float, default=1\n 791 |         Sparsity controlling parameter.\n 792 | \n 793 |     n_iter : int, default=100\n 794 |         Number of mini-batch iterations to perform.\n 795 | \n 796 |         .. deprecated:: 1.1\n 797 |            `n_iter` is deprecated in 1.1 and will be removed in 1.3. Use\n 798 |            `max_iter` instead.\n 799 | \n 800 |     max_iter : int, default=None\n 801 |         Maximum number of iterations over the complete dataset before\n 802 |         stopping independently of any early stopping criterion heuristics.\n 803 |         If ``max_iter`` is not None, ``n_iter`` is ignored.\n 804 | \n 805 |         .. versionadded:: 1.1\n 806 | \n 807 |     return_code : bool, default=True\n 808 |         Whether to also return the code U or just the dictionary `V`.\n 809 | \n 810 |     dict_init : ndarray of shape (n_components, n_features), default=None\n 811 |         Initial value for the dictionary for warm restart scenarios.\n 812 | \n 813 |     callback : callable, default=None\n 814 |         A callable that gets invoked at the end of each iteration.\n 815 | \n 816 |     batch_size : int, default=3\n 817 |         The number of samples to take in each batch.\n 818 | \n 819 |     verbose : bool, default=False\n 820 |         To control the verbosity of the procedure.\n 821 | \n 822 |     shuffle : bool, default=True\n 823 |         Whether to shuffle the data before splitting it in batches.\n 824 | \n 825 |     n_jobs : int, default=None\n 826 |         Number of parallel jobs to run.\n 827 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 828 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 829 |         for more details.\n 830 | \n 831 |     method : {'lars', 'cd'}, default='lars'\n 832 |         * `'lars'`: uses the least angle regression method to solve the lasso\n 833 |           problem (`linear_model.lars_