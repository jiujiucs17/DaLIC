ts[:nx1 * ny1, 1] = np.tile(np.arange(ny1), nx1)\n5244 |         offsets[nx1 * ny1:, 0] = np.repeat(np.arange(nx2) + 0.5, ny2)\n5245 |         offsets[nx1 * ny1:, 1] = np.tile(np.arange(ny2), nx2) + 0.5\n5246 |         offsets[:, 0] *= sx\n5247 |         offsets[:, 1] *= sy\n5248 |         offsets[:, 0] += xmin\n5249 |         offsets[:, 1] += ymin\n5250 |         # remove accumulation bins with no data\n5251 |         offsets = offsets[good_idxs, :]\n5252 |         accum = accum[good_idxs]\n5253 | \n5254 |         polygon = [sx, sy / 3] * np.array(\n5255 |             [[.5, -.5], [.5, .5], [0., 1.], [-.5, .5], [-.5, -.5], [0., -1.]])\n5256 | \n5257 |         if linewidths is None:\n5258 |             linewidths = [mpl.rcParams['patch.linewidth']]\n5259 | \n5260 |         if xscale == 'log' or yscale == 'log':\n5261 |             polygons = np.expand_dims(polygon, 0)\n5262 |             if xscale == 'log':\n5263 |                 polygons[:, :, 0] = 10.0 ** polygons[:, :, 0]\n5264 |                 xmin = 10.0 ** xmin\n5265 |                 xmax = 10.0 ** xmax\n5266 |                 self.set_xscale(xscale)\n5267 |             if yscale == 'log':\n5268 |                 polygons[:, :, 1] = 10.0 ** polygons[:, :, 1]\n5269 |                 ymin = 10.0 ** ymin\n5270 |                 ymax = 10.0 ** ymax\n5271 |                 self.set_yscale(yscale)\n5272 |         else:\n5273 |             polygons = [polygon]\n5274 | \n5275 |         collection = mcoll.PolyCollection(\n5276 |             polygons,\n5277 |             edgecolors=edgecolors,\n5278 |             linewidths=linewidths,\n5279 |             offsets=offsets,\n5280 |             offset_transform=mtransforms.AffineDeltaTransform(self.transData)\n5281 |         )\n5282 | \n5283 |         # Set normalizer if bins is 'log'\n5284 |         if cbook._str_equal(bins, 'log'):\n5285 |             if norm is not None:\n5286 |                 _api.warn_external(\"Only one of 'bins' and 'norm' arguments \"\n5287 |                                    f\"can be supplied, ignoring {bins=}\")\n5288 |             else:\n5289 |                 norm = mcolors.LogNorm(vmin=vmin, vmax=vmax)\n5290 |                 vmin = vmax = None\n5291 |             bins = None\n5292 | \n5293 |         if bins is not None:\n5294 |             if not np.iterable(bins):\n5295 |                 minimum, maximum = min(accum), max(accum)\n5296 |                 bins -= 1  # one less edge than bins\n5297 |                 bins = minimum + (maximum - minimum) * np.arange(bins) / bins\n5298 |             bins = np.sort(bins)\n5299 |             accum = bins.searchsorted(accum)\n5300 | \n5301 |         if colorizer:\n5302 |             collection._set_colorizer_check_keywords(colorizer, cmap=cmap,\n5303 |                                                      norm=norm, vmin=vmin,\n5304 |                                                      vmax=vmax)\n5305 |         else:\n5306 |             collection.set_cmap(cmap)\n5307 |             collection.set_norm(norm)\n5308 |         collection.set_array(accum)\n5309 |         collection.set_alpha(alpha)\n5310 |         collection._internal_update(kwargs)\n5311 |         collection._scale_norm(norm, vmin, vmax)\n5312 | \n5313 |         # autoscale the norm with current accum values if it hasn't been set\n5314 |         if norm is not None:\n5315 |             if collection.norm.vmin is None and collection.norm.vmax is None:\n5316 |                 collection.norm.autoscale()\n5317 | \n5318 |         corners = ((xmin, ymin), (xmax, ymax))\n5319 |         self.update_datalim(corners)\n5320 |         self._request_autoscale_view(tight=True)\n5321 | \n5322 |         # add the collection last\n5323 |         self.add_collection(collection, autolim=False)\n5324 |         if not marginals:\n5325 |             return collection\n5326 | \n5327 |         # Process marginals\n5328 |         bars = []\n5329 |         for zname, z, zmin, zmax, zscale, nbins in [\n5330 |                 (\"x\", x, xmin, xmax, xscale, nx),\n5331 |                 (\"y\", y, ymin, ymax, yscale, 2 * ny),\n5332 |         ]:\n5333 | \n5334 |             if zscale == \"log\":\n5335 |                 bin_edges = np.geomspace(zmin, zmax, nbins + 1)\n5336 |             else:\n5337 |                 bin_edges = np.linspace(zmin, zmax, nbins + 1)\n5338 | \n5339 |             verts = np.empty((nbins, 4, 2))\n5340 |             verts[:, 0, 0] = verts[:, 1, 0] = bin_edges[:-1]\n5341 |             verts[:, 2, 0] = verts[:, 3, 0] = bin_edges[1:]\n5342 |             verts[:, 0, 1] = verts[:, 3, 1] = .00\n5343 |             verts[:, 1, 1] = verts[:, 2, 1] = .05\n5344 |             if zname == \"y\":\n5345 |                 verts = verts[:, :, ::-1]  # Swap x and y.\n5346 | \n5347 |             # Sort z-values into bins defined by bin_edges.\n5348 |             bin_idxs = np.searchsorted(bin_edges, z) - 1\n5349 |             values = np.empty(nbins)\n5350 |             for i in range(nbins):\n5351 |                 # Get C-values for each bin, and compute bin value with\n5352 |                 # reduce_C_function.\n5353 |                 ci = C[bin_idxs == i]\n5354 |                 values[i] = reduce_C_function(ci) if len(ci) > 0 else np.nan\n5355 | \n5356 |             mask = ~np.isnan(values)\n5357 |             verts = verts[mask]\n5358 |             values = values[mask]\n5359 | \n5360 |             trans = getattr(self, f\"get_{zname}axis_transform\")(which=\"grid\")\n5361 |             bar = mcoll.PolyCollection(\n5362 |                 verts, transform=trans, edgecolors=\"face\")\n5363 |             bar.set_array(values)\n5364 |             bar.set_cmap(cmap)\n5365 |             bar.set_norm(norm)\n5366 |             bar.set_alpha(alpha)\n5367 |             bar._internal_update(kwargs)\n5368 |             bars.append(self.add_collection(bar, autolim=False))\n5369 | \n5370 |         collection.hbar, collection.vbar = bars\n5371 | \n5372 |         def on_changed(collecti