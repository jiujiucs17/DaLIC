lf.lhs) is not None\n187 | \n188 |     @property\n189 |     def kind(self):\n190 |         \"\"\"the kind of my field\"\"\"\n191 |         return getattr(self.queryables.get(self.lhs), \"kind\", None)\n192 | \n193 |     @property\n194 |     def meta(self):\n195 |         \"\"\"the meta of my field\"\"\"\n196 |         return getattr(self.queryables.get(self.lhs), \"meta\", None)\n197 | \n198 |     @property\n199 |     def metadata(self):\n200 |         \"\"\"the metadata of my field\"\"\"\n201 |         return getattr(self.queryables.get(self.lhs), \"metadata\", None)\n202 | \n203 |     def generate(self, v) -> str:\n204 |         \"\"\"create and return the op string for this TermValue\"\"\"\n205 |         val = v.tostring(self.encoding)\n206 |         return f\"({self.lhs} {self.op} {val})\"\n207 | \n208 |     def convert_value(self, v) -> TermValue:\n209 |         \"\"\"\n210 |         convert the expression that is in the term to something that is\n211 |         accepted by pytables\n212 |         \"\"\"\n213 | \n214 |         def stringify(value):\n215 |             if self.encoding is not None:\n216 |                 return pprint_thing_encoded(value, encoding=self.encoding)\n217 |             return pprint_thing(value)\n218 | \n219 |         kind = ensure_decoded(self.kind)\n220 |         meta = ensure_decoded(self.meta)\n221 |         if kind == \"datetime\" or (kind and kind.startswith(\"datetime64\")):\n222 |             if isinstance(v, (int, float)):\n223 |                 v = stringify(v)\n224 |             v = ensure_decoded(v)\n225 |             v = Timestamp(v).as_unit(\"ns\")\n226 |             if v.tz is not None:\n227 |                 v = v.tz_convert(\"UTC\")\n228 |             return TermValue(v, v._value, kind)\n229 |         elif kind in (\"timedelta64\", \"timedelta\"):\n230 |             if isinstance(v, str):\n231 |                 v = Timedelta(v)\n232 |             else:\n233 |                 v = Timedelta(v, unit=\"s\")\n234 |         