Whether or not to add a colorbar to the plot.\n280 | \n281 |         im_kw : dict, default=None\n282 |             Dict with keywords passed to `matplotlib.pyplot.imshow` call.\n283 | \n284 |         text_kw : dict, default=None\n285 |             Dict with keywords passed to `matplotlib.pyplot.text` call.\n286 | \n287 |             .. versionadded:: 1.2\n288 | \n289 |         Returns\n290 |         -------\n291 |         display : :class:`~sklearn.metrics.ConfusionMatrixDisplay`\n292 | \n293 |         See Also\n294 |         --------\n295 |         ConfusionMatrixDisplay.from_predictions : Plot the confusion matrix\n296 |             given the true and predicted labels.\n297 | \n298 |         Examples\n299 |         --------\n300 |         >>> import matplotlib.pyplot as plt\n301 |         >>> from sklearn.datasets import make_classification\n302 |         >>> from sklearn.metrics import ConfusionMatrixDisplay\n303 |         >>> from sklearn.model_selection import train_test_split\n304 |         >>> from sklearn.svm import SVC\n305 |         >>> X, y = make_classification(random_state=0)\n306 |         >>> X_train, X_test, y_train, y_test = train_test_split(\n307 |         ...         X, y, random_state=0)\n308 |         >>> clf = SVC(random_state=0)\n309 |         >>> clf.fit(X_train, y_train)\n310 |         SVC(random_state=0)\n311 |         >>> ConfusionMatrixDisplay.from_estimator(\n312 |         ...     clf, X_test, y_test)\n313 |         <...>\n314 |         >>> plt.show()\n315 |         \"\"\"\n316 |         method_name = f\"{cls.__name__}.from_estimator\"\n317 |         check_matplotlib_support(method_name)\n318 |         if not is_classifier(estimator):\n319 |             raise ValueError(f\"{method_name} only supports classifiers\")\n320 |         y_pred = estimator.predict(X)\n321 | \n322 |         return cls.from_predictions(\n323 |             y,\n324 |             y_pred,\n325 |             sample_weight=sample_weight,\n326 |             labels=labels