n843 |         Squeeze 1 dimensional axis objects into scalars.\n844 | \n845 |         Series or DataFrames with a single element are squeezed to a scalar.\n846 |         DataFrames with a single column or a single row are squeezed to a\n847 |         Series. Otherwise the object is unchanged.\n848 | \n849 |         This method is most useful when you don't know if your\n850 |         object is a Series or DataFrame, but you do know it has just a single\n851 |         column. In that case you can safely call `squeeze` to ensure you have a\n852 |         Series.\n853 | \n854 |         Parameters\n855 |         ----------\n856 |         axis : {0 or 'index', 1 or 'columns', None}, default None\n857 |             A specific axis to squeeze. By default, all length-1 axes are\n858 |             squeezed. For `Series` this parameter is unused and defaults to `None`.\n859 | \n860 |         Returns\n861 |         -------\n862 |         DataFrame, Series, or scalar\n863 |             The projection after squeezing `axis` or all the axes.\n864 | \n865 |         See Also\n866 |         --------\n867 |         Series.iloc : Integer-location based indexing for selecting scalars.\n868 |         DataFrame.iloc : Integer-location based indexing for selecting Series.\n869 |         Series.to_frame : Inverse of DataFrame.squeeze for a\n870 |             single-column DataFrame.\n871 | \n872 |         Examples\n873 |         --------\n874 |         >>> primes = pd.Series([2, 3, 5, 7])\n875 | \n876 |         Slicing might produce a Series with a single value:\n877 | \n878 |         >>> even_primes = primes[primes % 2 == 0]\n879 |         >>> even_primes\n880 |         0    2\n881 |         dtype: int64\n882 | \n883 |         >>> even_primes.squeeze()\n884 |         2\n885 | \n886 |         Squeezing objects with more than one value in every axis does nothing:\n887 | \n888 |         >>> odd_primes = primes[primes % 2 == 1]\n889 |         >>> odd_primes\n890 |         1    3\n891 |         2    5\n892 |         3    7\n893 |         dtype: int64\n894 | \n895 |         >>> odd_primes.squeeze()\n896 |         1    3\n897 |         2    5\n898 |         3    7\n899 |         dtype: int64\n900 | \n901 |         Squeezing is even more effective when used with DataFrames.\n902 | \n903 |         >>> df = pd.DataFrame([[1, 2], [3, 4]], columns=[\"a\", \"b\"])\n904 |         >>> df\n905 |            a  b\n906 |         0  1  2\n907 |         1  3  4\n908 | \n909 |         Slicing a single column will produce a DataFrame with the columns\n910 |         having only one value:\n911 | \n912 |         >>> df_a = df[[\"a\"]]\n913 |         >>> df_a\n914 |            a\n915 |         0  1\n916 |         1  3\n917 | \n918 |         So the columns can be squeezed down, resulting in a Series:\n919 | \n920 |         >>> df_a.squeeze(\"columns\")\n921 |         0    1\n922 |         1    3\n923 |         Name: a, dtype: int64\n924 | \n925 |         Slicing a single row from a single column will produce a single\n926 |         scalar DataFrame:\n927 | \n928 |         >>> df_0a = df.loc[df.index < 1, [\"a\"]]\n929 |         >>> df_0a\n930 |            a\n931 |         0  1\n932 | \n933 |         Squeezing the rows produces a single scalar Series:\n934 | \n935 |         >>> df_0a.squeeze(\"rows\")\n936 |         a    1\n937 |         Name: 0, dtype: int64\n938 | \n939 |         Squeezing all axes will project directly into a scalar:\n940 | \n941 |         >>> df_0a.squeeze()\n942 |         1\n943 |         \"\"\"\n944 |         axes = range(self._AXIS_LEN) if axis is None else (self._get_axis_number(axis),)\n945 |         result = self.iloc[\n946 |             tuple(\n947 |                 0 if i in axes and len(a) == 1 else slice(None)\n948 |                 for i, a in enumerate(self.axes)\n949 |             )\n950 |         ]\n951 |         if isinstance(result, NDFrame):\n952 |             result = result.__finalize__(self, method=\"squeeze\")\n953 |         return result\n```\n\n\n\n##Searching for term \"squeeze(\"...\n### Search Result:\nFound function `pandas/core/generic.py:NDFrame.rename_axis`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1103 | def rename_axis(\n1104 |         self,\n1105 |         mapper: IndexLabel | lib.NoDefault = lib.no_default,\n1106 |         *,\n1107 |         index=lib.no_default,\n1108 |         columns=lib.no_default,\n1109 |         axis: Axis = 0,\n1110 |         copy: bool | lib.NoDefault = lib.no_default,\n1111 |         inplace: bool = False,\n1112 |     ) -> Self | None:\n1113 |         \"\"\"\n1114 |         Set the name of the axis for the index or columns.\n1115 | \n1116 |         Parameters\n1117 |         ----------\n1118 |         mapper : scalar, list-like, optional\n1119 |             Value to set the axis name attribute.\n1120 | \n1121 |             Use either ``mapper`` and ``axis`` to\n1122 |             specify the axis to target with ``mapper``, or ``index``\n1123 |             and/or ``columns``.\n1124 |         index : scalar, list-like, dict-like or function, optional\n1125 |             A scalar, list-like, dict-like or functions transformations to\n1126 |             apply to that axis' values.\n1127 |         columns : scalar, list-like, dict-like or function, optional\n1128 |             A scalar, list-like, dict-like or functions transformations to\n1129 |             apply to that axis' values.\n1130 |         axis : {0 or 'index', 1 or 'columns'}, default 0\n1131 |             The axis to rename.\n1132 |         copy : bool, default False\n1133 |             Also copy underlying data.\n1134 | \n1135 |             .. note::\n1136 |                 The `copy` keyword will change behavior in pandas 3.0.\n1137 |                 `Copy-on-Write\n1138 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n1139 |                 will be enabled by default, which means that all methods with a\n1140 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n1141 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n1142 |                 future version of pandas.\n1143 | \n1144 |                 You can already get the future behavior and improvements through\n1145 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n1146 | \n1147 |             .. deprecated:: 3.0.0\n1148 |         inplace : bool, default False\n1149 |             Modifies the object directly, instead of creating a new Series\n1150 |             or DataFrame.\n1151 | \n1152 |         Returns\n1153 |         -------\n1154 |         DataFrame, or None\n1155 |             The same type as the caller or None if ``inplace=True``.\n1156 | \n1157 |         See Also\n1158 |         --------\n1159 |         Series.rename : Alter Series index labels or name.\n1160 |         DataFrame.rename : Alter DataFrame index labels or name.\n1161 |         Index.rename : Set new names on index.\n1162 | \n1163 |         Notes\n1164 |         -----\n1165 |         ``DataFrame.rename_axis`` supports two calling conventions\n1166 | \n1167 |         * ``(index=index_mapper, columns=columns_mapper, ...)``\n1168 |         * ``(mapper, axis={'index', 'columns'}, ...)``\n1169 | \n1170 |         The first calling convention will only modify the names of\n1171 |         the index and/or the names of the Index object that is the columns.\n1172 |         In this case, the parameter ``copy`` is ignored.\n1173 | \n1174 |         The second calling convention will modify the names of the\n1175 |         corresponding index if mapper is a list or a scalar.\n1176 |         However, if mapper is dict-like or a function, it will use the\n1177 |         deprecated behavior of modifying the axis *labels*.\n1178 | \n1179 |         We *highly* recommend using keyword arguments to clarify your\n1180 |         intent.\n1181 | \n1182 |         Examples\n1183 |         --------\n1184 |         **DataFrame**\n1185 | \n1186 |         >>> df = pd.DataFrame(\n1187 |         ...     {\"num_legs\": [4, 4, 2], \"num_arms\": [0, 0, 2]}, [\"dog\", \"cat\", \"monkey\"]\n1188 |         ... )\n1189 |         >>> df\n1190 |                 num_legs  num_arms\n1191 |         dog            4         0\n1192 |         cat            4         0\n1193 |         monkey         2         2\n1194 |         >>> df = df.rename_axis(\"animal\")\n1195 |         >>> df\n1196 |                 num_legs  num_arms\n1197 |         animal\n1198 |         dog            4         0\n1199 |         cat            4         0\n1200 |         monkey         2         2\n1201 |         >>> df = df.rename_axis(\"limbs\", axis=\"columns\")\n1202 |         >>> df\n1203 |         limbs   num_legs  num_arms\n1204 |         animal\n1205 |         dog            4         0\n1206 |         cat            4         0\n1207 |         monkey         2         2\n1208 | \n1209 |         **MultiIndex**\n1210 | \n1211 |         >>> df.index = pd.MultiIndex.from_product(\n1212 |         ...     [[\"mammal\"], [\"dog\", \"cat\", \"monkey\"]], names=[\"type\", \"name\"]\n1213 |         ... )\n1214 |         >>> df\n1215 |         limbs          num_legs  num_arms\n1216 |         type   name\n1217 |         mammal dog            4         0\n1218 |                cat            4         0\n1219 |                monkey         2         2\n1220 | \n1221 |         >>> df.rename_axis(index={\"type\": \"class\"})\n1222 |         limbs          num_legs  num_arms\n1223 |         class  name\n1224 |         mammal dog            4         0\n1225 |                cat            4         0\n1226 |                monkey         2         2\n1227 | \n1228 |         >>> df.rename_axis(columns=str.upper)\n1229 |         LIMBS          num_legs  num_arms\n1230 |         type   name\n1231 |         mammal dog            4         0\n1232 |                cat            4         0\n1233 |                monkey         2         2\n1234 |         \"\"\"\n1235 |         self._check_copy_deprecation(copy)\n1236 |         axes = {\"index\": index, \"columns\": columns}\n1237 | \n1238 |         if axis is not None:\n1239 |             axis = self._get_axis_number(axis)\n1240 | \n1241 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n1242 | \n1243 |         if mapper is not lib.no_default:\n1244 |             # Use v0.23 behavior if a scalar or list\n1245 |             non_mapper = is_scalar(mapper) or (\n1246 |                 is_list_like(mapper) and not is_dict_like(mapper)\n1247 |             )\n1248 |             if non_mapper:\n1249 |                 return self._set_axis_name(mapper, axis=axis, inplace=inplace)\n1250 |             else:\n1251 |                 raise ValueError(\"Use `.rename` to alter labels with a mapper.\")\n1252 |         else:\n1253 |             # Use new behavior.  Means that index and/or columns\n1254 |             # is specified\n1255 |             result = self if inplace else self.copy(deep=False)\n1256 | \n1257 |             for axis in range(self._AXIS_LEN):\n1258 |                 v = axes.get(self._get_axis_name(axis))\n1259 |                 if v is lib.no_default:\n1260 |                     continue\n1261 |                 non_mapper = is_scalar(v) or (is_list_like(v) and not is_dict_like(v))\n1262 |                 if non_mapper:\n1263 |                     newnames = v\n1264 |                 else:\n1265 |                     f = common.get_rename_function(v)\n1266 |                     curnames = self._get_axis(axis).names\n1267 |                     newnames = [f(name) for name in curnames]\n1268 |                 result._set_axis_name(newnames, axis=axis, inplace=True)\n1269 |             if not inplace:\n1270 |                 return result\n1271 |             return None\n```\n\nFound function `pandas/core/generic.py:NDFrame._rename`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 998 | def _rename(\n 999 |         self,\n1000 |         mapper: Renamer | None = None,\n1001 |         *,\n1002 |         index: Renamer | None = None,\n1003 |         columns: Renamer | None = None,\n1004 |         axis: Axis | None = None,\n1005 |         inplace: bool = False,\n1006 |         level: Level | None = None,\n1007 |         errors: str = \"ignore\",\n1008 |     ) -> Self | None:\n1009 |         # called by Series.rename and DataFrame.rename\n1010 | \n1011 |         if mapper is None and index is None and columns is None:\n1012 |             raise TypeError(\"must pass an index to rename\")\n1013 | \n1014 |         if index is not None or columns is not None:\n1015 |             if axis is not None:\n1016 |                 raise TypeError(\n1017 |                     \"Cannot specify both 'axis' and any of 'index' or 'columns'\"\n1018 |                 )\n1019 |             if mapper is not None:\n1020 |                 raise TypeError(\n1021 |                     \"Cannot specify both 'mapper' and any of 'index' or 'columns'\"\n1022 |                 )\n1023 |         else:\n1024 |             # use the mapper argument\n1025 |             if axis and self._get_axis_number(axis) == 1:\n1026 |                 columns = mapper\n1027 |             else:\n1028 |                 index = mapper\n1029 | \n1030 |         self._check_inplace_and_allows_duplicate_labels(inplace)\n1031 |         result = self if inplace else self.copy(deep=False)\n1032 | \n1033 |         for axis_no, replacements in enumerate((index, columns)):\n1034 |             if replacements is None:\n1035 |                 continue\n1036 | \n1037 |             ax = self._get_axis(axis_no)\n1038 |             f = common.get_rename_function(replacements)\n1039 | \n1040 |             if level is not None:\n1041 |                 level = ax._get_level_number(level)\n1042 | \n1043 |             # GH 13473\n1044 |             if not callable(replacements):\n1045 |                 if ax._is_multi and level is not None:\n1046 |                     indexer = ax.get_level_values(level).get_indexer_for(replacements)\n1047 |                 else:\n1048 |                     indexer = ax.get_indexer_for(replacements)\n1049 | \n1050 |                 if errors == \"raise\" and len(indexer[indexer == -1]):\n1051 |                     missing_labels = [\n1052 |                         label\n1053 |                         for index, label in enumerate(replacements)\n1054 |                         if indexer[index] == -1\n1055 |                     ]\n1056 |                     raise KeyError(f\"{missing_labels} not found in axis\")\n1057 | \n1058 |             new_index = ax._transform_index(f, level=level)\n1059 |             result._set_axis_nocheck(new_index, axis=axis_no, inplace=True)\n1060 | \n1061 |         if inplace:\n1062 |             self._update_inplace(result)\n1063 |             return None\n1064 |         else:\n1065 |             return result.__finalize__(self, method=\"rename\")\n```\n\nFound function `pandas/core/groupby/generic.py:DataFrameGroupBy.filter`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2259 | def filter(self, func, dropna: bool = True, *args, **kwargs) -> DataFrame:\n2260 |         \"\"\"\n2261 |         Filter elements from groups that don't satisfy a criterion.\n2262 | \n2263 |         Elements from groups are filtered if they do not satisfy the\n2264 |         boolean criterion specified by func.\n2265 | \n2266 |         Parameters\n2267 |         ----------\n2268 |         func : function\n2269 |             Criterion to apply to each group. Should return True or False.\n2270 |         dropna : bool\n2271 |             Drop groups that do not pass the filter. True by default; if False,\n2272 |             groups that evaluate False are filled with NaNs.\n2273 |         *args : tuple\n2274 |             Additional positional arguments to pass to `func`.\n2275 |         **kwargs : dict\n2276 |             Additional keyword arguments to pass to `func`.\n2277 | \n2278 |         Returns\n2279 |         -------\n2280 |         DataFrame\n2281 |             The filtered subset of the original DataFrame.\n2282 | \n2283 |         See Also\n2284 |         --------\n2285 |         DataFrame.filter: Filter elements of ungrouped DataFrame.\n2286 |         SeriesGroupBy.filter : Filter elements from groups base on criterion.\n2287 | \n2288 |         Notes\n2289 |         -----\n2290 |         Each subframe is endowed the attribute 'name' in case you need to know\n2291 |         which group you are working on.\n2292 | \n2293 |         Functions that mutate the passed object can produce unexpected\n2294 |         behavior or errors and are not supported. See :ref:`gotchas.udf-mutation`\n2295 |         for more details.\n2296 | \n2297 |         Examples\n2298 |         --------\n2299 |         >>> df = pd.DataFrame(\n2300 |         ...     {\n2301 |         ...         \"A\": [\"foo\", \"bar\", \"foo\", \"bar\", \"foo\", \"bar\"],\n2302 |         ...         \"B\": [1, 2, 3, 4, 5, 6],\n2303 |         ...         \"C\": [2.0, 5.0, 8.0, 1.0, 2.0, 9.0],\n2304 |         ...     }\n2305 |         ... )\n2306 |         >>> grouped = df.groupby(\"A\")\n2307 |         >>> grouped.filter(lambda x: x[\"B\"].mean() > 3.0)\n2308 |              A  B    C\n2309 |         1  bar  2  5.0\n2310 |         3  bar  4  1.0\n2311 |         5  bar  6  9.0\n2312 |         \"\"\"\n2313 |         indices = []\n2314 | \n2315 |         obj = self._selected_obj\n2316 |         gen = self._grouper.get_iterator(obj)\n2317 | \n2318 |         for name, group in gen:\n2319 |             # 2023-02-27 no tests are broken this pinning, but it is documented in the\n2320 |             #  docstring above.\n2321 |             object.__setattr__(group, \"name\", name)\n2322 | \n2323 |             res = func(group, *args, **kwargs)\n2324 | \n2325 |             try:\n2326 |                 res = res.squeeze()\n2327 |         