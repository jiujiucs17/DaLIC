ent using keyword search (bm25).\n```\n2183 | def _check_pos_label_consistency(pos_label, y_true):\n2184 |     \"\"\"Check if `pos_label` need to be specified or not.\n2185 | \n2186 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2187 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2188 |     `pos_label` parameters.\n2189 | \n2190 |     Parameters\n2191 |     ----------\n2192 |     pos_label : int, float, bool, str or None\n2193 |         The positive label.\n2194 |     y_true : ndarray of shape (n_samples,)\n2195 |         The target vector.\n2196 | \n2197 |     Returns\n2198 |     -------\n2199 |     pos_label : int, float, bool or str\n2200 |         If `pos_label` can be inferred, it will be returned.\n2201 | \n2202 |     Raises\n2203 |     ------\n2204 |     ValueError\n2205 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2206 |         it will raise a `ValueError`.\n2207 |     \"\"\"\n2208 |     # ensure binary classification if pos_label is not specified\n2209 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2210 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2211 |     # when elements in the two arrays are not comparable.\n2212 |     classes = np.unique(y_true)\n2213 |     if pos_label is None and (\n2214 |         classes.dtype.kind in \"OUS\"\n2215 |         or not (\n2216 |             np.array_equal(classes, [0, 1])\n2217 |             or np.array_equal(classes, [-1, 1])\n2218 |             or np.array_equal(classes, [0])\n2219 |             or np.array_equal(classes, [-1])\n2220 |             or np.array_equal(classes, [1])\n2221 |         )\n2222 |     ):\n2223 |         classes_repr = \", \".join(repr(c) for c in classes)\n2224 |         raise ValueError(\n2225 |             f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2226 |             \"specified: either make y_true take value in {0, 1} or \"