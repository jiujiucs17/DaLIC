 x0, x, self.convert_xunits)\n2510 |             if xerr is not None:\n2511 |                 xerr = self._convert_dx(xerr, x0, x, self.convert_xunits)\n2512 |         if self.yaxis is not None:\n2513 |             y0 = y\n2514 |             y = np.asarray(self.convert_yunits(y))\n2515 |             height = self._convert_dx(height, y0, y, self.convert_yunits)\n2516 |             if yerr is not None:\n2517 |                 yerr = self._convert_dx(yerr, y0, y, self.convert_yunits)\n2518 | \n2519 |         x, height, width, y, linewidth, hatch = np.broadcast_arrays(\n2520 |             # Make args iterable too.\n2521 |             np.atleast_1d(x), height, width, y, linewidth, hatch)\n2522 | \n2523 |         # Now that units have been converted, set the tick locations.\n2524 |         if orientation == 'vertical':\n2525 |             tick_label_axis = self.xaxis\n2526 |             tick_label_position = x\n2527 |         else:  # horizontal\n2528 |             tick_label_axis = self.yaxis\n2529 |             tick_label_position = y\n2530 | \n2531 |         if not isinstance(label, str) and np.iterable(label):\n2532 |             bar_container_label = '_nolegend_'\n2533 |             patch_labels = label\n2534 |         else:\n2535 |             bar_container_label = label\n2536 |             patch_labels = ['_nolegend_'] * len(x)\n2537 |         if len(patch_labels) != len(x):\n2538 |             raise ValueError(f'number of labels ({len(patch_labels)}) '\n2539 |                              f'does not match number of bars ({len(x)}).')\n2540 | \n2541 |         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n2542 |         hatch = itertools.cycle(np.atleast_1d(hatch))\n2543 |         color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n2544 |                                 # Fallback if color == \"none\".\n2545 |                                 itertools.repeat('none'))\n2546 |         if edgecolor is None:\n2547 |             edgecolor = itertools.repeat(None)\n2548 |         else:\n2549 |             edgecolor = itertools.chain(\n2550 |                 itertools.cycle(mcolors.to_rgba_array(edgecolor)),\n2551 |                 # Fallback if edgecolor == \"none\".\n2552 |                 itertools.repeat('none'))\n2553 | \n2554 |         # We will now resolve the alignment and really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                                     f'and width ({width.dtype}) '\n2564 |                                     f'are incompatible') from e\n2565 |                 bottom = y\n2566 |             else:  # horizontal\n2567 |                 try:\n2568 |                     bottom = y - height / 2\n2569 |                 except TypeError as e:\n2570 |                     raise TypeError(f'the dtypes of parameters y ({y.dtype}) '\n2571 |                                     f'and height ({height.dtype}) '\n2572 |                                     f'are incompatible') from e\n2573 |                 left = x\n2574 |         else:  # edge\n2575 |             left = x\n2576 |             bottom = y\n2577 | \n2578 |         patches = []\n2579 |         args = zip(left, bottom, width, height, color, edgecolor, linewidth,\n2580 |                    hatch, patch_labels)\n2581 |         for l, b, w, h, c, e, lw, htch, lbl in args:\n2582 |             r = mpatches.Rectangle(\n2583 |                 xy=(l, b), width=w, height=h,\n2584 |                 facecolor=c,\n2585 |                 edgecolor=e,\n2586 |                 linewidth=lw,\n2587 |                 label=lbl,\n2588 |                 hatch=htch,\n2