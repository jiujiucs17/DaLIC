turns\n2063 |         -------\n2064 |         same type as self\n2065 |         \"\"\"\n2066 |         pa_dtype = self._pa_array.type\n2067 | \n2068 |         data = self._pa_array\n2069 |         if pa.types.is_temporal(pa_dtype):\n2070 |             # https://github.com/apache/arrow/issues/33769 in these cases\n2071 |             #  we can cast to ints and back\n2072 |             nbits = pa_dtype.bit_width\n2073 |             if nbits == 32:\n2074 |                 data = data.cast(pa.int32())\n2075 |             else:\n2076 |                 data = data.cast(pa.int64())\n2077 | \n2078 |         result = pc.quantile(data, q=qs, interpolation=interpolation)\n2079 | \n2080 |         if pa.types.is_temporal(pa_dtype):\n2081 |             if pa.types.is_floating(result.type):\n2082 |                 result = pc.floor(result)\n2083 |             nbits = pa_dtype.bit_width\n2084 |             if nbits == 32:\n2085 |                 result = result.cast(pa.int32())\n2086 |             else:\n2087 |                 result = result.cast(pa.int64())\n2088 |             result = result.cast(pa_dtype)\n2089 | \n2090 |         return type(self)(result)\n```\n\nFound function `pandas/core/arrays/base.py:ExtensionArray._quantile`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2475 | def _quantile(self, qs: npt.NDArray[np.float64], interpolation: str) -> Self:\n2476 |         \"\"\"\n2477 |         Compute the quantiles of self for each quantile in `qs`.\n2478 | \n2479 |         Parameters\n2480 |         ----------\n2481 |         qs : np.ndarray[float64]\n2482 |         interpolation: str\n2483 | \n2484 |         Returns\n2485 |         -------\n2486 |         same type as self\n2487 |         \"\"\"\n2488 |         mask = np.asarray(self.isna())\n2489 |         arr = np.asarray(self)\n2490 |         fill_value = np.nan\n2491 | \n2492 |         res_values = quantile_with_mask(arr, mask, fill_value, qs, interpolation)\n2493 |         return type(self)._from