    # Compute classes only if pos_label is not specified:\n2560 |         classes = np.unique(y_true)\n2561 |         if classes.dtype.kind in \"OUS\" or not (\n2562 |             np.array_equal(classes, [0, 1])\n2563 |             or np.array_equal(classes, [-1, 1])\n2564 |             or np.array_equal(classes, [0])\n2565 |             or np.array_equal(classes, [-1])\n2566 |             or np.array_equal(classes, [1])\n2567 |         ):\n2568 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2569 |             raise ValueError(\n2570 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2571 |                 \"specified: either make y_true take value in {0, 1} or \"\n2572 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2573 |             )\n2574 |         pos_label = 1\n2575 | \n2576 |     return pos_label\n```\n"}, {"content": "Let me search for more documentation-related code:\n\n<function=search_code_snippets>\n<parameter=search_terms>['docstring', 'parameters', 'returns']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\ndoc/sphinxext/autoshortsummary.py:ShortSummaryDocumenter.add_content\ndoc/sphinxext/autoshortsummary.py:setup\ndoc/api_reference.py:_get_submodule\nexamples/miscellaneous/plot_anomaly_comparison.py:docstring:9\nexamples/miscellaneous/plot_anomaly_comparison.py:docstring:2\nsklearn/gaussian_process/kernels.py:Kernel.get_params\nsklearn/utils/validation.py:has_fit_parameter\nsklearn/pipeline.py:Pipeline.set_params\nsklearn/pipeline.py:FeatureUnion.set_params\nsklearn/ensemble/_base.py:_BaseHeterogeneousEnsemble.get_params\nsklearn/base.py:BaseEstimator._get_param_names\nsklearn/model_selection/_search.py:ParameterGrid\nsklearn/compose/_column_transformer.py:ColumnTransformer.set_params\nsklearn/utils/validation.py:check_scalar\nsklearn/en