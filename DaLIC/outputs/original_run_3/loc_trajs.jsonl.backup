   def _args_adjust(self):\n1616 |         self.grid = False\n1617 |         self.logy = False\n1618 |         self.logx = False\n1619 |         self.loglog = False\n1620 | \n1621 |     def _validate_color_args(self):\n1622 |         pass\n1623 | \n1624 |     def _make_plot(self):\n1625 |         colors = self._get_colors(num_colors=len(self.data), color_kwds=\"colors\")\n1626 |         self.kwds.setdefault(\"colors\", colors)\n1627 | \n1628 |         for i, (label, y) in enumerate(self._iter_data()):\n1629 |             ax = self._get_ax(i)\n1630 |             if label is not None:\n1631 |                 label = pprint_thing(label)\n1632 |                 ax.set_ylabel(label)\n1633 | \n1634 |             kwds = self.kwds.copy()\n1635 | \n1636 |             def blank_labeler(label, value):\n1637 |                 if value == 0:\n1638 |                     return \"\"\n1639 |                 else:\n1640 |                     return label\n1641 | \n1642 |             idx = [pprint_thing(v) for v in self.data.index]\n1643 |             labels = kwds.pop(\"labels\", idx)\n1644 |             # labels is used for each wedge's labels\n1645 |             # Blank out labels for values of 0 so they don't overlap\n1646 |             # with nonzero wedges\n1647 |             if labels is not None:\n1648 |                 blabels = [blank_labeler(left, value) for left, value in zip(labels, y)]\n1649 |             else:\n1650 |                 blabels = None\n1651 |             results = ax.pie(y, labels=blabels, **kwds)\n1652 | \n1653 |             if kwds.get(\"autopct\", None) is not None:\n1654 |                 patches, texts, autotexts = results\n1655 |             else:\n1656 |                 patches, texts = results\n1657 |                 autotexts = []\n1658 | \n1659 |             if self.fontsize is not None:\n1660 |                 for t in texts + autotexts:\n1661 |                     t.set_fontsize(self.fontsize)\n1662 | \n1663 |             # leglabels is used for legend labels\n1664 |             leglabels = labels if labels is not None else idx\n1665 |             for p, l in zip(patches, leglabels):\n1666 |                 self._append_legend_handles_labels(p, l)\n```\n\nFound file `asv_bench/benchmarks/__init__.py`.\nFound file `asv_bench/benchmarks/io/__init__.py`.\nFound file `asv_bench/benchmarks/algos/__init__.py`.\nFound file `asv_bench/benchmarks/tslibs/__init__.py`.\nFound file `scripts/__init__.py`.\nFound file `pandas/__init__.py`.\nFound file `pandas/compat/__init__.py`.\nFound file `pandas/compat/numpy/__init__.py`.\nFound file `pandas/core/__init__.py`.\nFound file `pandas/core/indexers/__init__.py`.\nFound file `pandas/core/reshape/__init__.py`.\nFound file `pandas/core/exchange/__init__.py`.\nFound file `pandas/core/strings/__init__.py`.\nFound file `pandas/core/tools/__init__.py`.\nFound file `pandas/core/util/__init__.py`.\nFound file `pandas/core/array_algos/__init__.py`.\nFound file `pandas/core/dtypes/__init__.py`.\nFound file `pandas/core/groupby/__init__.py`.\nFound file `pandas/core/internals/__init__.py`.\nFound file `pandas/core/computation/__init__.py`.\nFound file `pandas/core/_numba/__init__.py`.\nFound file `pandas/core/_numba/kernels/__init__.py`.\nFound file `pandas/core/window/__init__.py`.\nFound file `pandas/core/arrays/__init__.py`.\nFound file `pandas/core/arrays/arrow/__init__.py`.\nFound file `pandas/core/arrays/sparse/__init__.py`.\nFound file `pandas/core/ops/__init__.py`.\nFound file `pandas/core/sparse/__init__.py`.\nFound file `pandas/core/indexes/__init__.py`.\nFound file `pandas/util/__init__.py`.\nFound file `pandas/util/version/__init__.py`.\nFound file `pandas/io/__init__.py`.\nFound file `pandas/io/parsers/__init__.py`.\nFound file `pandas/io/formats/__init__.py`.\nFound file `pandas/io/excel/__init__.py`.\nFound file `pandas/io/json/__init__.py`.\nFound file `pandas/io/sas/__init__.py`.\nFound file `pandas/io/clipboard/__init__.py`.\nFound file `pandas/tseries/__init__.p