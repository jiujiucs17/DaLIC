red_error\", 0.1, 100, 31, None,\n 38 | #             20, 0.0, 255, None, None, False, \"auto\", \"loss\", 0.1, 10, 1e-7,\n 39 | #             0, None)\n 40 | #\n 41 | # Understanding the above code requires the reader to go to the API\n 42 | # documentation and to check each and every parameter for its position and\n 43 | # its meaning. To improve the readability of code written based on scikit-learn,\n 44 | # now users have to provide most parameters with their names, as keyword\n 45 | # arguments, instead of positional arguments. For example, the above code would\n 46 | # be::\n 47 | #\n 48 | #     HistGradientBoostingRegressor(\n 49 | #         loss=\"squared_error\",\n 50 | #         learning_rate=0.1,\n 51 | #         max_iter=100,\n 52 | #         max_leaf_nodes=31,\n 53 | #         max_depth=None,\n 54 | #         min_samples_leaf=20,\n 55 | #         l2_regularization=0.0,\n 56 | #         max_bins=255,\n 57 | #         categorical_features=None,\n 58 | #         monotonic_cst=None,\n 59 | #         warm_start=False,\n 60 | #         early_stopping=\"auto\",\n 61 | #         scoring=\"loss\",\n 62 | #         validation_fraction=0.1,\n 63 | #         n_iter_no_change=10,\n 64 | #         tol=1e-7,\n 65 | #         verbose=0,\n 66 | #         random_state=None,\n 67 | #     )\n 68 | #\n 69 | # which is much more readable. Positional arguments have been deprecated since\n 70 | # version 0.23 and will now raise a ``TypeError``. A limited number of\n 71 | # positional arguments are still allowed in some cases, for example in\n 72 | # :class:`~decomposition.PCA`, where ``PCA(10)`` is still allowed, but ``PCA(10,\n 73 | # False)`` is not allowed.\n 74 | \n 75 | ##############################################################################\n 76 | # Spline Transformers\n 77 | # ---------------------------------------------------------\n 78 | # One way to add nonlinear terms to a dataset's feature set is to generate\n 79 | # spline basis functions for continuous/numerical features with the new\n 80 | # :class:`~preprocessing.SplineTransformer`. Splines are piecewise polynomials,\n 81 | # parametrized by their polynomial degree and the positions of the knots. The\n 82 | # :class:`~preprocessing.SplineTransformer` implements a B-spline basis.\n 83 | #\n 84 | # .. figure:: ../linear_model/images/sphx_glr_plot_polynomial_interpolation_001.png\n 85 | #   :target: ../linear_model/plot_polynomial_interpolation.html\n 86 | #   :align: center\n 87 | #\n 88 | # The following code shows splines in action, for more information, please\n 89 | # refer to the :ref:`User Guide <spline_transformer>`.\n 90 | \n 91 | import numpy as np\n```\n\nFound function `sklearn/preprocessing/_polynomial.py:PolynomialFeatures.transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n399 | def transform(self, X):\n400 |         \"\"\"Transform data to polynomial features.\n401 | \n402 |         Parameters\n403 |         ----------\n404 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n405 |             The data to transform, row by row.\n406 | \n407 |             Prefer CSR over CSC for sparse input (for speed), but CSC is\n408 |             required if the degree is 4 or higher. If the degree is less than\n409 |             4 and the input format is CSC, it will be converted to CSR, have\n410 |             its polynomial features generated, then converted back to CSC.\n411 | \n412 |             If the degree is 2 or 3, the method described in \"Leveraging\n413 |             Sparsity to Speed Up Polynomial Feature Expansions of CSR Matrices\n414 |             Using K-Simplex Numbers\" by Andrew Nystrom and John Hughes is\n415 |             used, which is much faster than the method used on CSC input. For\n416 |             this reason, a CSC input will be converted to CSR, and the output\n417 |             will be converted back to CSC prior to being returned, hence the\n418 |             preference of CSR.\n419 | \n420 |         Returns\n421 |         -------\n422 |         XP : {ndarray, sparse matrix} of shape (n_samples, NP)\n423 |             The matrix of features, where `NP` is the number of polynomial\n424 |             features generated from the combination of inputs. If a sparse\n425 |             matrix is provided, it will be converted into a sparse\n426 |             `csr_matrix`.\n427 |         \"\"\"\n428 |         check_is_fitted(self)\n429 | \n430 |         X = self._validate_data(\n431 |             X, order=\"F\", dtype=FLOAT_DTYPES, reset=False, accept_sparse=(\"csr\", \"csc\")\n432 |         )\n433 | \n434 |         n_samples, n_features = X.shape\n435 |         max_int32 = np.iinfo(np.int32).max\n436 |         if sparse.isspmatrix_csr(X):\n437 |             if self._max_degree > 3:\n438 |                 return self.transform(X.tocsc()).tocsr()\n439 |             to_stack = []\n440 |             if self.include_bias:\n441 |                 to_stack.append(\n442 |                     sparse.csr_matrix(np.ones(shape=(n_samples, 1), dtype=X.dtype))\n443 |                 )\n444 |             if self._min_degree <= 1 and self._max_degree > 0:\n445 |                 to_stack.append(X)\n446 | \n447 |             cumulative_size = sum(mat.shape[1] for mat in to_stack)\n448 |             for deg in range(max(2, self._min_degree), self._max_degree + 1):\n449 |                 expanded = _create_expansion(\n450 |                     X=X,\n451 |                     interaction_only=self.interaction_only,\n452 |                     deg=deg,\n453 |                     n_features=n_features,\n454 |                     cumulative_size=cumulative_size,\n455 |                 )\n456 |                 if expanded is not None:\n457 |                     to_stack.append(expanded)\n458 |                     cumulative_size += expanded.shape[1]\n459 |             if len(to_stack) == 0:\n460 |                 # edge case: deal with empty matrix\n461 |                 XP = sparse.csr_matrix((n_samples, 0), dtype=X.dtype)\n462 |             else:\n463 |                 # `scipy.sparse.hstack` breaks in scipy<1.9.2\n464 |                 # when `n_output_features_ > max_int32`\n465 |                 all_int32 = all(mat.indices.dtype == np.int32 for mat in to_stack)\n466 |                 if (\n467 |                     sp_version < parse_version(\"1.9.2\")\n468 |                     and self.n_output_features_ > max_int32\n469 |                     and all_int32\n470 |                 ):\n471 |                     raise ValueError(  # pragma: no cover\n472 |                         \"In scipy versions `<1.9.2`, the function `scipy.sparse.hstack`\"\n473 |                         \" produces negative columns when:\\n1. The output shape contains\"\n474 |                         \" `n_cols` too large to be represented by a 32bit signed\"\n475 |                         \" integer.\\n2. All sub-matrices to be stacked have indices of\"\n476 |                         \" dtype `np.int32`.\\nTo avoid this error, either use a version\"\n477 |                         \" of scipy `>=1.9.2` or alter the `PolynomialFeatures`\"\n478 |                         \" transformer to produce fewer than 2^31 output features\"\n479 |                     )\n480 |                 XP = sparse.hstack(to_stack, dtype=X.dtype, format=\"csr\")\n481 |         elif sparse.isspmatrix_csc(X) and self._max_degree < 4:\n482 |             return self.transform(X.tocsr()).tocsc()\n483 |         elif sparse.isspmatrix(X):\n484 |             combinations = self._combinations(\n485 |                 n_features=n_features,\n486 |                 min_degree=self._min_degree,\n487 |                 max_degree=self._max_degree,\n488 |                 interaction_only=self.interaction_only,\n489 |                 include_bias=self.include_bias,\n490 |             )\n491 |             columns = []\n492 |             for combi in combinations:\n493 |                 if combi:\n494 |                     out_col = 1\n495 |                     for col_idx in combi:\n496 |                         out_col = X[:, col_idx].multiply(out_col)\n497 |                     columns.append(out_col)\n498 |                 else:\n499 |                     bias = sparse.csc_matrix(np.ones((X.shape[0], 1)))\n500 |                     columns.append(bias)\n501 |             XP = sparse.hstack(columns, dtype=X.dtype).tocsc()\n502 |         else:\n503 |             # Do as if _min_degree = 0 and cut down array after the\n504 |             # computation, i.e. use _n_out_full instead of n_output_features_.\n505 |             XP = np.empty(\n506 |                 shape=(n_samples, self._n_out_full), dtype=X.dtype, order=self.order\n507 |             )\n508 | \n509 |             # What follows is a faster implementation of:\n510 |             # for i, comb in enumerate(combinations):\n511 |             #     XP[:, i] = X[:, comb].prod(1)\n512 |             # This implementation uses two optimisations.\n513 |             # First one is broadcasting,\n514 |             # multiply ([X1, ..., Xn], X1) -> [X1 X1, ..., Xn X1]\n515 |             # multiply ([X2, ..., Xn], X2) -> [X2 X2, ..., Xn X2]\n516 |             # ...\n517 |             # multiply ([X[:, start:end], X[:, start]) -> ...\n518 |             # Second optimisation happens for degrees >= 3.\n519 |             # Xi^3 is computed reusing previous computation:\n520 |             # Xi^3 = Xi^2 * Xi.\n521 | \n522 |             # degree 0 term\n523 |             if self.include_bias:\n524 |                 XP[:, 0] = 1\n525 |                 current_col = 1\n526 |             else:\n527 |                 current_col = 0\n528 | \n529 |             if self._max_degree == 0:\n530 |                 return XP\n531 | \n532 |             # degree 1 term\n533 |             XP[:, current_col : current_col + n_features] = X\n534 |             index = list(range(current_col, current_col + n_features))\n535 |             current_col += n_features\n536 |             index.append(current_col)\n537 | \n538 |             # loop over degree >= 2 terms\n539 |             for _ in range(2, self._max_degree + 1):\n540 |                 new_index = []\n541 |                 end = index[-1]\n542 |                 for feature_idx in range(n_features):\n543 |                     start = index[feature_idx]\n544 |                     new_index.append(current_col)\n545 |                     if self.interaction_only:\n546 |                         start += index[feature_idx + 1] - index[feature_idx]\n547 |                     next_col = current_col + end - start\n548 |                     if next_col <= current_col:\n549 |                         break\n550 |                     # XP[:, start:end] are terms of degree d - 1\n551 |                     # that exclude feature #feature_idx.\n552 |                     np.multiply(\n553 |                         XP[:, start:end],\n554 |                         X[:, feature_idx : feature_idx + 1],\n555 |                         out=XP[:, current_col:next_col],\n556 |                         casting=\"no\",\n557 |                     )\n558 |                     current_col = next_col\n559 | \n560 |                 new_index.append(current_col)\n561 |                 index = new_index\n562 | \n563 |             if self._min_degree > 1:\n564 |                 n_XP, n_Xout = self._n_out_full, self.n_output_features_\n565 |                 if self.include_bias:\n566 |                     Xout = np.empty(\n567 |                         shape=(n_samples, n_Xout), dtype=XP.dtype, order=self.order\n568 |                     )\n569 |                     Xout[:, 0] = 1\n570 |                     Xout[:, 1:] = XP[:, n_XP - n_Xout + 1 :]\n571 |                 else:\n572 |                     Xout = XP[:, n_XP - n_Xout :].copy()\n573 |                 XP = Xout\n574 |         return XP\n```\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSSVD`.\nSource: Retrieved code con