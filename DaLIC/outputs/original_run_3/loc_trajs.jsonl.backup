earch (bm25).\nHint: Search `doc/postprocess.py` for the full content if needed.\n\n\n\n##Searching for term \"preprocessing\", \"array manipulation preprocessing\"...\n### Search Result:\nFound function `numpy/core/setup_common.py:check_for_right_shift_internal_compiler_error`.\nSource: Retrieved code content using keyword search (bm25).\n```\n413 | def check_for_right_shift_internal_compiler_error(cmd):\n414 |     \"\"\"\n415 |     On our arm CI, this fails with an internal compilation error\n416 | \n417 |     The failure looks like the following, and can be reproduced on ARM64 GCC 5.4:\n418 | \n419 |         <source>: In function 'right_shift':\n420 |         <source>:4:20: internal compiler error: in expand_shift_1, at expmed.c:2349\n421 |                ip1[i] = ip1[i] >> in2;\n422 |                       ^\n423 |         Please submit a full bug report,\n424 |         with preprocessed source if appropriate.\n425 |         See <http://gcc.gnu.org/bugs.html> for instructions.\n426 |         Compiler returned: 1\n427 | \n428 |     This function returns True if this compiler bug is present, and we need to\n429 |     turn off optimization for the function\n430 |     \"\"\"\n431 |     cmd._check_compiler()\n432 |     has_optimize = cmd.try_compile(textwrap.dedent(\"\"\"\\\n433 |         __attribute__((optimize(\"O3\"))) void right_shift() {}\n434 |         \"\"\"), None, None)\n435 |     if not has_optimize:\n436 |         return False\n437 | \n438 |     no_err = cmd.try_compile(textwrap.dedent(\"\"\"\\\n439 |         typedef long the_type;  /* fails also for unsigned and long long */\n440 |         __attribute__((optimize(\"O3\"))) void right_shift(the_type in2, the_type *ip1, int n) {\n441 |             for (int i = 0; i < n; i++) {\n442 |                 if (in2 < (the_type)sizeof(the_type) * 8) {\n443 |                     ip1[i] = ip1[i] >> in2;\n444 |                 }\n445 |             }\n446 |         }\n447 |         \"\"\"), None, None)\n448 |     return