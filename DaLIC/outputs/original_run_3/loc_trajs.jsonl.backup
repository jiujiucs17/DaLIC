s will be passed to matplotlib's ``plot``.\n 82 | \n 83 |         Parameters\n 84 |         ----------\n 85 |         ax : matplotlib axes, default=None\n 86 |             Axes object to plot on. If `None`, a new figure and axes is\n 87 |             created.\n 88 | \n 89 |         name : str, default=None\n 90 |             Name of ROC Curve for labeling. If `None`, use the name of the\n 91 |             estimator.\n 92 | \n 93 |         Returns\n 94 |         -------\n 95 |         display : :class:`~sklearn.metrics.plot.RocCurveDisplay`\n 96 |             Object that stores computed values.\n 97 |         \"\"\"\n 98 |         check_matplotlib_support(\"RocCurveDisplay.plot\")\n 99 | \n100 |         name = self.estimator_name if name is None else name\n101 | \n102 |         line_kwargs = {}\n103 |         if self.roc_auc is not None and name is not None:\n104 |             line_kwargs[\"label\"] = f\"{name} (AUC = {self.roc_auc:0.2f})\"\n105 |         elif self.roc_auc is not None:\n106 |             line_kwargs[\"label\"] = f\"AUC = {self.roc_auc:0.2f}\"\n107 |         elif name is not None:\n108 |             line_kwargs[\"label\"] = name\n109 | \n110 |         line_kwargs.update(**kwargs)\n111 | \n112 |         import matplotlib.pyplot as plt\n113 | \n114 |         if ax is None:\n115 |             fig, ax = plt.subplots()\n116 | \n117 |         (self.line_,) = ax.plot(self.fpr, self.tpr, **line_kwargs)\n118 |         info_pos_label = (\n119 |             f\" (Positive label: {self.pos_label})\" if self.pos_label is not None else \"\"\n120 |         )\n121 | \n122 |         xlabel = \"False Positive Rate\" + info_pos_label\n123 |         ylabel = \"True Positive Rate\" + info_pos_label\n124 |         ax.set(xlabel=xlabel, ylabel=ylabel)\n125 | \n126 |         if \"label\" in line_kwargs:\n127 |             ax.legend(loc=\"lower right\")\n128 | \n129 |         self.ax_ = ax\n130 |         self.figure_ = ax.figure\n131 |         return self\n132 | \n133 | \n134 | def plot_roc_curve(\n135 |     estimator,\n136 |     X,\n137 |     y,\n138 |     *,\n139 |     sample_weight=None,\n140 |     drop_intermediate=True,\n141 |     response_method=\"auto\",\n142 |     name=None,\n143 |     ax=None,\n144 |     pos_label=None,\n145 |     **kwargs,\n146 | ):\n147 |     \"\"\"Plot Receiver operating characteristic (ROC) curve.\n148 | \n149 |     Extra keyword arguments will be passed to matplotlib's `plot`.\n150 | \n151 |     Read more in the :ref:`User Guide <visualizations>`.\n152 | \n153 |     Parameters\n154 |     ----------\n155 |     estimator : estimator instance\n156 |         Fitted classifier or a fitted :class:`~sklearn.pipeline.Pipeline`\n157 |         in which the last estimator is a classifier.\n158 | \n159 |     X : {array-like, sparse matrix} of shape (n_samples, n_features)\n160 |         Input values.\n161 | \n162 |     y : array-like of shape (n_samples,)\n163 |         Target values.\n164 | \n165 |     sample_weight : array-like of shape (n_samples,), default=None\n166 |         Sample weights.\n167 | \n168 |     drop_intermediate : boolean, default=True\n169 |         Whether to drop some suboptimal thresholds which would not appear\n170 |         on a plotted ROC curve. This is useful in order to create lighter\n171 |         ROC curves.\n172 | \n173 |     response_method : {'predict_proba', 'decision_function', 'auto'} \\\n174 |     default='auto'\n175 |         Specifies whether to use :term:`predict_proba` or\n176 |         :term:`decision_function` as the target response. If set to 'auto',\n177 |         :term:`predict_proba` is tried first and if it does not exist\n178 |         :term:`decision_function` is tried next.\n179 | \n180 |     name : str, default=None\n181 |         Name of ROC Curve for labeling. If `None`, use the name of the\n182 |         estimator.\n183 | \n184 |     ax : matplotlib axes, default=None\n185 |         Axes object to plot on. If `None`, a new figure and axes is created.\n186 | \n187 |     pos_label : str or int, default=None\n188 |         The class considered as the positive class when computing the roc auc\n189 |         metrics. By default, `estimators.classes_[1]` is considered\n190 |         as the positive class.\n191 | \n192 |         .. versionadded:: 0.24\n193 | \n194 |     Returns\n195 |     -------\n196 |     display : :class:`~sklearn.metrics.RocCurveDisplay`\n197 |         Object that stores computed values.\n198 | \n199 |     See Also\n200 |     --------\n201 |     roc_curve : Compute Receiver operating characteristic (ROC) curve.\n202 |     RocCurveDisplay : ROC Curve visualization.\n203 |     roc_auc_score : Compute the area under the ROC curve.\n204 | \n205 |     Examples\n206 |     --------\n207 |     >>> import matplotlib.pyplot as plt\n208 |     >>> from sklearn import datasets, metrics, model_selection, svm\n209 |     >>> X, y = datasets.make_classification(random_state=0)\n210 |     >>> X_train, X_test, y_train, y_test = model_selection.train_test_split(\n211 |     ...     X, y, random_state=0)\n212 |     >>> clf = svm.SVC(random_state=0)\n213 |     >>> clf.fit(X_train, y_train)\n214 |     SVC(random_state=0)\n215 |     >>> metrics.plot_roc_curve(clf, X_test, y_test)\n216 |     <...>\n217 |     >>> plt.show()\n218 |     \"\"\"\n219 |     check_matplotlib_support(\"plot_roc_curve\")\n220 | \n221 |     y_pred, pos_label = _get_response(\n222 |         X, estimator, response_method, pos_label=pos_label\n223 |     )\n224 | \n225 |     fpr, tpr, _ = roc_curve(\n226 |         y,\n227 |         y_pred,\n228 |         pos_label=pos_label,\n229 |         sample_weight=sample_weight,\n230 |         drop_intermediate=drop_intermediate,\n231 |     )\n232 |     roc_auc = auc(fpr, tpr)\n233 | \n234 |     name = estimator.__class__.__name__ if name is None else name\n235 | \n236 |     viz = RocCurveDisplay(\n237 |         fpr=fpr, tpr=tpr, roc_auc=roc_auc, estimator_name=name, pos_label=pos_label\n238 |     )\n239 | \n240 |     return 