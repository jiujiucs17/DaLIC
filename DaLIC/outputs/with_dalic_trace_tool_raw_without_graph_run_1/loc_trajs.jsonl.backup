LOWED_DTYPES = {\n 38 |     \"evaluate\": {\"int64\", \"int32\", \"float64\", \"float32\", \"bool\"},\n 39 |     \"where\": {\"int64\", \"float64\", \"bool\"},\n 40 | }\n 41 | \n 42 | # the minimum prod shape that we will use numexpr\n 43 | _MIN_ELEMENTS = 1_000_000\n 44 | \n 45 | \n 46 | def set_use_numexpr(v: bool = True) -> None:\n 47 |     # set/unset to use numexpr\n 48 |     global USE_NUMEXPR\n 49 |     if NUMEXPR_INSTALLED:\n 50 |         USE_NUMEXPR = v\n 51 | \n 52 |     # choose what we are going to do\n 53 |     global _evaluate, _where\n 54 | \n 55 |     _evaluate = _evaluate_numexpr if USE_NUMEXPR else _evaluate_standard\n 56 |     _where = _where_numexpr if USE_NUMEXPR else _where_standard\n 57 | \n 58 | \n 59 | def set_numexpr_threads(n=None) -> None:\n 60 |     # if we are using numexpr, set the threads to n\n 61 |     # otherwise reset\n 62 |     if NUMEXPR_INSTALLED and USE_NUMEXPR:\n 63 |         if n is None:\n 64 |             n = ne.detect_number_of_cores()\n 65 |         ne.set_num_threads(n)\n 66 | \n 67 | \n 68 | def _evaluate_standard(op, op_str, a, b):\n 69 |     \"\"\"\n 70 |     Standard evaluation.\n 71 |     \"\"\"\n 72 |     if _TEST_MODE:\n 73 |         _store_test_result(False)\n 74 |     return op(a, b)\n 75 | \n 76 | \n 77 | def _can_use_numexpr(op, op_str, a, b, dtype_check) -> bool:\n 78 |     \"\"\"return a boolean if we WILL be using numexpr\"\"\"\n 79 |     if op_str is not None:\n 80 |         # required min elements (otherwise we are adding overhead)\n 81 |         if a.size > _MIN_ELEMENTS:\n 82 |             # check for dtype compatibility\n 83 |             dtypes: set[str] = set()\n 84 |             for o in [a, b]:\n 85 |                 # ndarray and Series Case\n 86 |                 if hasattr(o, \"dtype\"):\n 87 |                     dtypes |= {o.dtype.name}\n 88 | \n 89 |             # allowed are a superset\n 90 |             if not len(dtypes) or _ALLOWED_DTYPES[dtype_check] >= dtypes:\n 91 |                 return True\n 92 | \n 93 |     return False\n 94 | \n 95 | \n 96 | def _evaluate_numexpr(op, op_str, a, b):\n 97 |     result = None\n 98 | \n 99 |     if _can_use_numexpr(op, op_str, a, b, \"evaluate\"):\n100 |         is_reversed = op.__name__.strip(\"_\").startswith(\"r\")\n101 |         if is_reversed:\n102 |             # we were originally called by a reversed op method\n103 |             a, b = b, a\n104 | \n105 |         a_value = a\n106 |         b_value = b\n107 | \n108 |         try:\n109 |             result = ne.evaluate(\n110 |                 f\"a_value {op_str} b_value\",\n111 |                 local_dict={\"a_value\": a_value, \"b_value\": b_value},\n112 |                 casting=\"safe\",\n113 |             )\n114 |         except TypeError:\n115 |             # numexpr raises eg for array ** array with integers\n116 |             # (https://github.com/pydata/numexpr/issues/379)\n117 |             pass\n118 |         except NotImplementedError:\n119 |             if _bool_arith_fallback(op_str, a, b):\n120 |                 pass\n121 |             else:\n122 |                 raise\n123 | \n124 |         if is_reversed:\n125 |             # reverse order to original for fallback\n126 |             a, b = b, a\n127 | \n128 |     if _TEST_MODE:\n129 |         _store_test_result(result is not None)\n130 | \n131 |     if result is None:\n132 |         result = _evaluate_standard(op, op_str, a, b)\n133 | \n134 |     return result\n135 | \n136 | \n137 | _op_str_mapping = {\n138 |     operator.add: \"+\",\n139 |     roperator.radd: \"+\",\n140 |     operator.mul: \"*\",\n141 |     roperator.rmul: \"*\",\n142 |     operator.sub: \"-\",\n143 |     roperator.rsub: \"-\",\n144 |     operator.truediv: \"/\",\n145 |     roperator.rtruediv: \"/\",\n146 |     # floordiv not supported by numexpr 2.x\n147 |     operator.floordiv: None,\n148 |     roperator.rfloordiv: None,\n149 |     # we require Python semantics for mod of negative for backwards compatibility\n150 |     # see https://github.com/pydata/numexpr/issues/365\n151 |     # so sticking with unaccelerated for now GH#36552\n152 |     operator.mod: None,\n153 |     roperator.rmod: None,\n154 |     operator.pow: \"**\",\n155 |     roperator.rpow: \"**\",\n156 |     operator.eq: \"==\",\n157 |     operator.ne: \"!=\",\n158 |     operator.le: \"<=\",\n159 |     operator.lt: \"<\",\n160 |     operator.ge: \">=\",\n161 |     operator.gt: \">\",\n162 |     operator.and_: \"&\",\n163 |     roperator.rand_: \"&\",\n164 |     operator.or_: \"|\",\n165 |     roperator.ror_: \"|\",\n166 |     operator.xor: \"^\",\n167 |     roperator.rxor: \"^\",\n168 |     divmod: None,\n169 |     roperator.rdivmod: None,\n170 | }\n171 | \n172 | \n173 | def _where_standard(cond, a, b):\n174 |     # Caller is responsible for extracting ndarray if necessary\n175 |     return np.where(cond, a, b)\n176 | \n177 | \n178 | def _where_numexpr(cond, a, b):\n179 |     # Caller is responsible for extracting ndarray if necessary\n180 |     result = None\n181 | \n182 |     if _can_use_numexpr(None, \"where\", a, b, \"where\"):\n183 |         result = ne.evaluate(\n184 |             \"where(cond_value, a_value, b_value)\",\n185 |             local_dict={\"cond_value\": cond, \"a_value\": a, \"b_value\": b},\n186 |             casting=\"safe\",\n187 |         )\n188 | \n189 |     if result is None:\n190 |         result = _where_standard(cond, a, b)\n191 | \n192 |     return result\n193 | \n194 | \n195 | # turn myself on\n196 | set_use_numexpr(get_option(\"compute.use_numexpr\"))\n197 | \n198 | \n199 | def _has_bool_dtype(x):\n200 |     try:\n201 |         return x.dtype == bool\n202 |     except AttributeError:\n203 |         return isinstance(x, (bool, np.bool_))\n204 | \n205 | \n206 | _BOOL_OP_UNSUPPORTED = {\"+\": \"|\", \"*\": \"&\", \"-\": \"^\"}\n207 | \n208 | \n209 | def _bool_arith_fallback(op_str, a, b) -> bool:\n210 |     \"\"\"\n211 |     Check if we should fallback to the python `_evaluate_standard`