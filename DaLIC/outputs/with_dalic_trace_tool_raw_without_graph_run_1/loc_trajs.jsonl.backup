ol", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nbenchmarks/bench_hist_gradient_boosting.py:impl:44\nbenchmarks/bench_hist_gradient_boosting.py:impl:84\nsklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay.plot\nexamples/cluster/plot_optics.py:impl:29\nexamples/cluster/plot_optics.py:impl:70\nbenchmarks/bench_hist_gradient_boosting_threading.py:impl:73\nexamples/calibration/plot_calibration_multiclass.py:impl:29\nexamples/calibration/plot_calibration_multiclass.py:docstring:26\nsklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay._plot_ice_lines\nexamples/ensemble/plot_bias_variance.py:impl:16\nexamples/ensemble/plot_bias_variance.py:impl:67\nbenchmarks/bench_multilabel_metrics.py:impl:5\nsklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay._plot_average_dependence\n##Searching for term \"plotting\"...\n### Search Result:\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 66 | mlp_disp = plot_partial_dependence(mlp, X, [\"age\", \"bmi\"], ax=ax,\n 67 |                                    line_kw={\"color\": \"red\"})\n 68 | \n 69 | # %%\n 70 | # Plotting partial dependence of the two models together\n 71 | # ======================================================\n 72 | #\n 73 | # The `tree_disp` and `mlp_disp`\n 74 | # :class:`~sklearn.inspection.PartialDependenceDisplay` objects contain all the\n 75 | # computed information needed to recreate the partial dependence curves. This\n 76 | # means we can easily create additional plots without needing to recompute the\n 77 | # curves.\n 78 | #\n 79 | # One way to plot the curves is to place them in the same figure, with the\n 80 | # curves of each model on each row. First, we create a figure with two axes\n 81 | # within two rows and one column. The two axes are passed to the\n 82 | # :func:`~sklearn.inspection.PartialDependenceDisplay.plot` functions of\n 83 | # `tree_disp` and `mlp_disp`. The given axes will be used by the plotting\n 84 | # function to draw the partial dependence. The resulting plot places the\n 85 | # decision tree partial dependence curves in the first row of the\n 86 | # multi-layer perceptron in the second row.\n 87 | \n 88 | fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 10))\n 89 | tree_disp.plot(ax=ax1)\n 90 | ax1.set_title(\"Decision Tree\")\n 91 | mlp_disp.plot(ax=ax2, line_kw={\"color\": \"red\"})\n 92 | ax2.set_title(\"Multi-layer Perceptron\")\n 93 | \n 94 | # %%\n 95 | # Another way to compare the curves is to plot them on top of each other. Here,\n 96 | # we create a figure with one row and two columns. The axes are passed into the\n 97 | # :func:`~sklearn.inspection.PartialDependenceDisplay.plot` function as a list,\n 98 | # which will plot the partial dependence curves of each model on the same axes.\n 99 | # The length of the axes list must be equal to the number of plots drawn.\n100 | \n101 | # sphinx_gallery_thumbnail_number = 4\n102 | fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 6))\n103 | tree_disp.plot(ax=[ax1, ax2], line_kw={\"label\": \"Decision Tree\"})\n104 | mlp_disp.plot(ax=[ax1, ax2], line_kw={\"label\": \"Multi-layer Perceptron\",\n105 |                                       \"color\": \"red\"})\n106 | ax1.legend()\n107 | ax2.legend()\n108 | \n109 | # %%\n110 | # `tree_disp.axes_` is a numpy array container the axes used to draw the\n111 | # partial dependence plots. This can be passed to `mlp_disp` to have the same\n112 | # affect of drawing the plots on top of each other. Furthermore, the\n113 | # `mlp_disp.figure_` stores the figure, which allows for resizing the figure\n114 | # after calling `plot`. In this case `tree_disp.axes_` has two dimensions, thus\n115 | # `plot` will only show the y label and y ticks on the left most plot.\n116 | \n117 | tree_disp.plot(line_kw={\"label\": \"Decision Tree\"})\n```\n\nFound function `benchmarks/bench_saga.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n238 | def plot(outname=None):\n239 |     import pandas as pd\n240 | \n241 |     with open(\"bench_saga.json\", \"r\") as f:\n242 |         f = json.load(f)\n243 |     res = pd.DataFrame(f)\n244 |     res.set_index([\"single_target\"], inplace=True)\n245 | \n246 |     grouped = res.groupby(level=[\"single_target\"])\n247 | \n248 |     colors = {\"saga\": \"C0\", \"liblinear\": \"C1\", \"lightning\": \"C2\"}\n249 |     linestyles = {\"float32\": \"--\", \"float64\": \"-\"}\n250 |     alpha = {\"float64\": 0.5, \"float32\": 1}\n251 | \n252 |     for idx, group in grouped:\n253 |         single_target = idx\n254 |         fig, axes = plt.subplots(figsize=(12, 4), ncols=4)\n255 |         ax = axes[0]\n256 | \n257 |         for scores, times, solver, dtype in zip(\n258 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n259 |         ):\n260 |             ax.plot(\n261 |                 times,\n262 |                 scores,\n263 |                 label=\"%s - %s\" % (solver, dtype),\n264 |                 color=colors[solver],\n265 |                 alpha=alpha[dtype],\n266 |                 marker=\".\",\n267 |                 linestyle=linestyles[dtype],\n268 |             )\n269 |             ax.axvline(\n270 |                 times[-1],\n271 |                 color=colors[solver],\n272 |                 alpha=alpha[dtype],\n273 |                 linestyle=linestyles[dtype],\n274 |             )\n275 |         ax.set_xlabel(\"Time (s)\")\n276 |         ax.set_ylabel(\"Training objective (relative to min)\")\n277 |         ax.set_yscale(\"log\")\n278 | \n279 |         ax = axes[1]\n280 | \n281 |         for scores, times, solver, dtype in zip(\n282 |             group[\"test_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n283 |         ):\n284 |             ax.plot(\n285 |                 times,\n286 |                 scores,\n287 |                 label=solver,\n288 |                 color=colors[solver],\n289 |                 linestyle=linestyles[dtype],\n290 |                 marker=\".\",\n291 |                 alpha=alpha[dtype],\n292 |             )\n293 |             ax.axvline(\n294 |                 times[-1],\n295 |                 color=colors[solver],\n296 |                 alpha=alpha[dtype],\n297 |                 linestyle=linestyles[dtype],\n298 |             )\n299 | \n300 |         ax.set_xlabel(\"Time (s)\")\n301 |         ax.set_ylabel(\"Test objective (relative to min)\")\n302 |         ax.set_yscale(\"log\")\n303 | \n304 |         ax = axes[2]\n305 |         for accuracy, times, solver, dtype in zip(\n306 |             group[\"accuracies\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n307 |         ):\n308 |             ax.plot(\n309 |                 times,\n310 |                 accuracy,\n311 |                 label=\"%s - %s\" % (solver, dtype),\n312 |                 alpha=alpha[dtype],\n313 |                 marker=\".\",\n314 |                 color=colors[solver],\n315 |                 linestyle=linestyles[dtype],\n316 |             )\n317 |             ax.axvline(\n318 |                 times[-1],\n319 |                 color=colors[solver],\n320 |                 alpha=alpha[dtype],\n321 |                 linestyle=linestyles[dtype],\n322 |             )\n323 | \n324 |         ax.set_xlabel(\"Time (s)\")\n325 |         ax.set_ylabel(\"Test accuracy\")\n326 |         ax.legend()\n327 |         name = \"single_target\" if single_target else \"multi_target\"\n328 |         name += \"_%s\" % penalty\n329 |         plt.suptitle(name)\n330 |         if outname is None:\n331 |             outname = name + \".png\"\n332 |         fig.tight_layout()\n333 |         fig.subplots_adjust(top=0.9)\n334 | \n335 |         ax = axes[3]\n336 |         for scores, times, solver, dtype in zip(\n337 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n338 |         ):\n339 |             ax.plo