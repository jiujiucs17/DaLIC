ator)\n1875 |     pipeline = make_pipeline(estimator)\n1876 |     estimator.fit(X, y)\n1877 |     pipeline.fit(X, y)\n1878 | \n1879 |     funcs = [\"score\", \"fit_transform\"]\n1880 | \n1881 |     for func_name in funcs:\n1882 |         func = getattr(estimator, func_name, None)\n1883 |         if func is not None:\n1884 |             func_pipeline = getattr(pipeline, func_name)\n1885 |             result = func(X, y)\n1886 |             result_pipe = func_pipeline(X, y)\n1887 |             assert_allclose_dense_sparse(result, result_pipe)\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_decision_proba_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3733 | def check_decision_proba_consistency(name, estimator_orig):\n3734 |     # Check whether an estimator having both decision_function and\n3735 |     # predict_proba methods has outputs with perfect rank correlation.\n3736 | \n3737 |     centers = [(2, 2), (4, 4)]\n3738 |     X, y = make_blobs(\n3739 |         n_samples=100,\n3740 |         random_state=0,\n3741 |         n_features=4,\n3742 |         centers=centers,\n3743 |         cluster_std=1.0,\n3744 |         shuffle=True,\n3745 |     )\n3746 |     X_train, X_test, y_train, y_test = train_test_split(\n3747 |         X, y, test_size=0.2, random_state=0\n3748 |     )\n3749 |     estimator = clone(estimator_orig)\n3750 | \n3751 |     if hasattr(estimator, \"decision_function\") and hasattr(estimator, \"predict_proba\"):\n3752 |         estimator.fit(X_train, y_train)\n3753 |         # Since the link function from decision_function() to predict_proba()\n3754 |         # is sometimes not precise enough (typically expit), we round to the\n3755 |         # 10th decimal to avoid numerical issues: we compare the rank\n3756 |         # with deterministic ties rather than get platform specific rank\n3757 |         # inversions in case of machine level differences.\n3758 |         a = estimator.predict_proba(X_test)[:, 1].round(decimals=10)\n3759 |         b = estimator.decision_function(X_test).round(decimals=10)\n3760 | \n3761 |         rank_proba, rank_score = rankdata(a), rankdata(b)\n3762 |         try:\n3763 |             assert_array_almost_equal(rank_proba, rank_score)\n3764 |         except AssertionError:\n3765 |             # Sometimes, the rounding applied on the probabilities will have\n3766 |             # ties that are not present in the scores because it is\n3767 |             # numerically more precise. In this case, we relax the test by\n3768 |             # grouping the decision function scores based on the probability\n3769 |             # rank and check that the score is monotonically increasing.\n3770 |             grouped_y_score = np.array(\n3771 |                 [b[rank_proba == group].mean() for group in np.unique(rank_proba)]\n3772 |             )\n3773 |             sorted_idx = np.argsort(grouped_y_score)\n3774 |             assert_array_equal(sorted_idx, np.arange(len(sorted_idx)))\n```\n\nFound function `doc/api_reference.py:_get_submodule`.\nSource: Retrieved code content using keyword search (bm25).\n```\n21 | def _get_submodule(module_name, submodule_name):\n22 |     \"\"\"Get the submodule docstring and automatically add the hook.\n23 | \n24 |     `module_name` is e.g. `sklearn.feature_extraction`, and `submodule_name` is e.g.\n25 |     `image`, so we get the docstring and hook for `sklearn.feature_extraction.image`\n26 |     submodule. `module_name` is used to reset the current module because autosummary\n27 |     automatically changes the current module.\n28 |     \"\"\"\n29 |     lines = [\n30 |         f\".. automodule:: {module_name}.{submodule_name}\",\n31 |         f\".. currentmodule:: {module_name}\",\n32 |     ]\n33 |     return \"\\n\\n\".join(lines)\n```\n\n\n\n##Searching for term \"docstring consistency\", \"assert_consistent_docs Parameters Attributes Returns docstring consistency\"...\n### Search Result:\nFound function `sklearn/feature_ex