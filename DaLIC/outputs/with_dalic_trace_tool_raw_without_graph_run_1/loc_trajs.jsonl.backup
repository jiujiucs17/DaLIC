sphx_glr_auto_examples_inspection_plot_permutation_importance.py`\n 21 | \n 22 | \"\"\"\n 23 | \n 24 | # Authors: The scikit-learn developers\n 25 | # SPDX-License-Identifier: BSD-3-Clause\n 26 | \n 27 | # %%\n 28 | # Random Forest Feature Importance on Breast Cancer Data\n 29 | # ------------------------------------------------------\n 30 | #\n 31 | # First, we define a function to ease the plotting:\n 32 | import matplotlib\n 33 | \n 34 | from sklearn.inspection import permutation_importance\n 35 | from sklearn.utils.fixes import parse_version\n```\n\nFound code snippet in file `examples/decomposition/plot_faces_decomposition.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 25 | import logging\n 26 | \n 27 | import matplotlib.pyplot as plt\n 28 | from numpy.random import RandomState\n 29 | \n 30 | from sklearn import cluster, decomposition\n 31 | from sklearn.datasets import fetch_olivetti_faces\n 32 | \n 33 | rng = RandomState(0)\n 34 | \n 35 | # Display progress logs on stdout\n 36 | logging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(message)s\")\n 37 | \n 38 | faces, _ = fetch_olivetti_faces(return_X_y=True, shuffle=True, random_state=rng)\n 39 | n_samples, n_features = faces.shape\n 40 | \n 41 | # Global centering (focus on one feature, centering all samples)\n 42 | faces_centered = faces - faces.mean(axis=0)\n 43 | \n 44 | # Local centering (focus on one sample, centering all features)\n 45 | faces_centered -= faces_centered.mean(axis=1).reshape(n_samples, -1)\n 46 | \n 47 | print(\"Dataset consists of %d faces\" % n_samples)\n 48 | \n 49 | # %%\n 50 | # Define a base function to plot the gallery of faces.\n 51 | \n 52 | n_row, n_col = 2, 3\n 53 | n_components = n_row * n_col\n 54 | image_shape = (64, 64)\n```\n\nFound `sklearn/utils/_indexing.py:_array_indexing`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | import numbers\n  5 | import sys\n  6 | import warnings\n  7 | from collect