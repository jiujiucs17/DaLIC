\n 398 |             _dtype: DtypeObj | str | None = dtype\n 399 |             vdtype = getattr(result, \"dtype\", None)\n 400 |             if self._is_string:\n 401 |                 if is_bool_dtype(vdtype):\n 402 |                     _dtype = result.dtype\n 403 |                 elif returns_string:\n 404 |                     _dtype = self._orig.dtype\n 405 |                 else:\n 406 |                     _dtype = vdtype\n 407 |             elif vdtype is not None:\n 408 |                 _dtype = vdtype\n 409 | \n 410 |             if expand:\n 411 |                 cons = self._orig._constructor_expanddim\n 412 |                 result = cons(result, columns=name, index=index, dtype=_dtype)\n 413 |             else:\n 414 |                 # Must be a Series\n 415 |                 cons = self._orig._constructor\n 416 |                 result = cons(result, name=name, index=index, dtype=_dtype)\n 417 |             result = result.__finalize__(self._orig, method=\"str\")\n 418 |             if name is not None and result.ndim == 1:\n 419 |                 # __finalize__ might copy over the original name, but we may\n 420 |                 # want the new name (e.g. str.extract).\n 421 |                 result.name = name\n 422 |             return result\n 423 | \n 424 |     def _get_series_list(self, others):\n 425 |         \"\"\"\n 426 |         Auxiliary function for :meth:`str.cat`. Turn potentially mixed input\n 427 |         into a list of Series (elements without an index must match the length\n 428 |         of the calling Series/Index).\n 429 | \n 430 |         Parameters\n 431 |         ----------\n 432 |         others : Series, DataFrame, np.ndarray, list-like or list-like of\n 433 |             Objects that are either Series, Index or np.ndarray (1-dim).\n 434 | \n 435 |         Returns\n 436 |         -------\n 437 |         list of Series\n 438 |             Others transformed into list of Series.\n 439 |         \"\"\"\n 440 |         from pandas import (\n 441 |             DataFrame,\n 442 |             Series,\n 443 |         )\n 444 | \n 445 |         # self._orig is either Series or Index\n 446 |         idx = self._orig if isinstance(self._orig, ABCIndex) else self._orig.index\n 447 | \n 448 |         # Generally speaking, all objects without an index inherit the index\n 449 |         # `idx` of the calling Series/Index - i.e. must have matching length.\n 450 |         # Objects with an index (i.e. Series/Index/DataFrame) keep their own.\n 451 |         if isinstance(others, ABCSeries):\n 452 |             return [others]\n 453 |         elif isinstance(others, ABCIndex):\n 454 |             return [Series(others, index=idx, dtype=others.dtype)]\n 455 |         elif isinstance(others, ABCDataFrame):\n 456 |             return [others[x] for x in others]\n 457 |         elif isinstance(others, np.ndarray) and others.ndim == 2:\n 458 |             others = DataFrame(others, index=idx)\n 459 |             return [others[x] for x in others]\n 460 |         elif is_list_like(others, allow_sets=False):\n 461 |             try:\n 462 |                 others = list(others)  # ensure iterators do not get read twice etc\n 463 |             except TypeError:\n 464 |                 # e.g. ser.str, raise below\n 465 |                 pass\n 466 |             else:\n 467 |                 # in case of list-like `others`, all elements must be\n 468 |                 # either Series/Index/np.ndarray (1-dim)...\n 469 |                 if all(\n 470 |                     isinstance(x, (ABCSeries, ABCIndex, ExtensionArray))\n 471 |                     or (isinstance(x, np.ndarray) and x.ndim == 1)\n 472 |                     for x in others\n 473 |                 ):\n 474 |                     los: list[Series] = []\n 475 |                     while others:  # iterate through list and append each element\n 476 |                         los = los + self._get_series_list(others.pop(0))\n 477 |                     return los\n 478 |                 # ... or just strings\n 479 |                 elif all(not is_list_like(x) for x in others):\n 480 |                     return [Series(others, index=idx)]\n 481 |         raise TypeError(\n 482 |             \"others must be Series, Index, DataFrame, np.ndarray \"\n 483 |             \"or list-like (either containing only strings or \"\n 484 |             \"containing only objects of type Series/Index/\"\n 485 |             \"np.ndarray[1-dim])\"\n 486 |         )\n 487 | \n 488 |     @forbid_nonstring_types([\"bytes\", \"mixed\", \"mixed-integer\"])\n 489 |     def cat(\n 490 |         self,\n 491 |         others=None,\n 492 |         sep: str | None = None,\n 493 |         na_rep=None,\n 494 |         join: AlignJoin = \"left\",\n 495 |     ) -> str | Series | Index:\n 496 |         \"\"\"\n 497 |         Concatenate strings in the Series/Index with given separator.\n 498 | \n 499 |         If `others` is specified, this function concatenates the Series/Index\n 500 |         and elements of `others` element-wise.\n 501 |         If `others` is not passed, then all values in the Series/Index are\n 502 |         concatenated into a single string with a given `sep`.\n 503 | \n 504 |         Parameters\n 505 |         ----------\n 506 |         others : Series, Index, DataFrame, np.ndarray or list-like\n 507 |             Series, Index, DataFrame, np.ndarray (one- or two-dimensional) and\n 508 |             other list-likes of strings must have the same length as the\n 509 |             calling Series/Index, with the exception of indexed objects (i.e.\n 510 |             Series/Index/DataFrame) if `join` is not None.\n 511 | \n 512 |             If others is a list-like that contains a combination of Series,\n 513 |             Index or np.ndarray (1-dim), then all elements will be unpacked and\n 514 |             must satisfy the above criteria individually.\n 515 | \n 516 |             If others is None, the method returns the concatenation of all\n 517 |             strings in the calling Series/Index.\n 518 |         sep : str, default ''\n 519 |             The separator between the different elements/columns. By default\n 520 |             the empty string `''` is used.\n 521 |         na_rep : str or None, default None\n 522 |             Representation that is inserted for all missing values:\n 523 | \n 524 |             - If `na_rep` is None, and `others` is None, missing values in the\n 525 |               Series/Index are omitted from the result.\n 526 |             - If `na_rep` is None, and `others` is not None, a row containing a\n 527 |               missing value in any of the columns (before concatenation) will\n 528 |               have a missing value in the result.\n 529 |         join : {'left', 'right', 'outer', 'inner'}, default 'left'\n 530 |             Determines the join-style between the calling Series/Index and any\n 531 |             Series/Index/DataFrame in `others` (objects without an index need\n 532 |             to match the length of the calling Series/Index). To disable\n 533 |             alignment, use `.values` on any Series/Index/DataFrame in `others`.\n 534 | \n 535 |         Returns\n 536 |         -------\n 537 |         str, Series or Index\n 538 |             If `others` is None, `str` is returned, otherwise a `Series/Index`\n 539 |             (same type as caller) of objects is returned.\n 540 | \n 541 |         See Also\n 542 |         --------\n 543 |         split : Split each string in the Series/Index.\n 544 |         join : Join lists contained as elements in the Series/Index.\n 545 | \n 546 |         Examples\n 547 |         --------\n 548 |         When not passing `others`, all values are concatenated into a single\n 549 |         string:\n 550 | \n 551 |         >>> s = pd.Series([\"a\", \"b\", np.nan, \"d\"])\n 552 |         >>> s.str.cat(sep=\" \")\n 553 |         'a b d'\n 554 | \n 555 |         By default, NA values in the Series are ignored. Using `na_rep`, they\n 556 |         can be given a representation:\n 557 | \n 558 |         >>> s.str.cat(sep=\" \", na_rep=\"?\")\n 559 |         'a b ? d'\n 560 | \n 561 |         If `others` is specified, corresponding values are concatenated with\n 562 |         the separator. Result will be a Series of strings.\n 563 | \n 564 |         >>> s.str.cat([\"A\", \"B\", \"C\", \"D\"], sep=\",\")\n 565 |         0    a,A\n 566 |         1    b,B\n 567 |         2    NaN\n 568 |         3    d,D\n 569 |         dtype: object\n 570 | \n 571 |         Missing values will remain missing in the result, but can again be\n 572 |         represented using `na_rep`\n 573 | \n 574 |         >>> s.str.cat([\"A\", \"B\", \"C\", \"D\"], sep=\",\", na_rep=\"-\")\n 575 |         0    a,A\n 576 |         1    b,B\n 577 |         2    -,C\n 578 |         3    d,D\n 579 |         dtype: object\n 580 | \n 581 |         If `sep` is not specified, the values are concatenated without\n 582 |         separation.\n 583 | \n 584 |         >>> s.str.cat([\"A\", \"B\", \"C\", \"D\"], na_rep=\"-\")\n 585 |         0    aA\n 586 |         1    bB\n 587 |         2    -C\n 588 |         3    dD\n 589 |         dtype: object\n 590 | \n 591 |         Series with different indexes can be aligned before concatenation. The\n 592 |         `join`-keyword works as in other methods.\n 593 | \n 594 |         >>> t = pd.Series([\"d\", \"a\", \"e\", \"c\"], index=[3, 0, 4, 2])\n 595 |         >>> s.str.cat(t, join=\"left\", na_rep=\"-\")\n 596 |         0    aa\n 597 |         1    b-\n 598 |         2    -c\n 599 |         3    dd\n 600 |         dtype: object\n 601 |         >>>\n 602 |         >>> s.str.cat(t, join=\"outer\", na_rep=\"-\")\n 603 |         0    aa\n 604 |         1    b-\n 605 |         2    -c\n 606 |         3    dd\n 607 |         4    -e\n 608 |         dtype: object\n 609 |         >>>\n 610 |         >>> s.str.cat(t, join=\"inner\", na_rep=\"-\")\n 611 |         0    aa\n 612 |         2    -c\n 613 |         3    dd\n 614 |         dtype: object\n 615 |         >>>\n 616 |         >>> s.str.cat(t, join=\"right\", na_rep=\"-\")\n 617 |         3    dd\n 618 |         0    aa\n 619 |         4    -e\n 620 |         2    -c\n 621 |         dtype: object\n 622 | \n 623 |         For more examples, see :ref:`here <text.concatenate>`.\n 624 |         \"\"\"\n 625 |         # TODO: dispatch\n 626 |         from pandas import (\n 627 |             Index,\n 628 |             Series,\n 629 |             concat,\n 630 |         )\n 631 | \n 632 |         if isinstance(others, str):\n 633 |             raise ValueError(\"Did you mean to supply a `sep` keyword?\")\n 634 |         if sep is None:\n 635 |             sep = \"\"\n 636 | \n 637 |         if isinstance(self._orig, ABCIndex):\n 638 |             data = Series(self._orig, index=self._orig, dtype=self._orig.dtype)\n 639 |         else:  # Series\n 640 |             data = self._orig\n 641 | \n 642 |         # concatenate Series/Index with itself if no \"others\"\n 643 |         if others is None:\n 644 |             # error: Incompatible types in assignment (expression has type\n 645 |             # \"ndarray\", variable has type \"Series\")\n 646 |             data = ensure_object(data)  # type: ignore[assignment]\n 647 |             na_mask = isna(data)\n 648 |             if na_rep is None and na_mask.any():\n 649 |                 return sep.join(data[~na_mask])\n 650 |             elif na_rep is not None and na_mask.any():\n 651 |                 return sep.join(np.where(na_mask, na_rep, data))\n 652 |             else:\n 653 |                 return sep.join(data)\n 654 | \n 655 |         try:\n 656 |             # turn anything in \"others\" into lists of Series\n 657 |             others = self._get_series_list(others)\n 658 |         except ValueError as err:  # do not catch TypeError raised by _get_series_list\n 659 |             raise ValueError(\n 660 |                 \"If `others` contains arrays or lists (or other \"\n 661 |                 \"list-likes without an index), these must all be \"\n 662 |                 \"of the same length as the calling Series/Index.\"\n 663 |             ) from err\n 664 | \n 665 |         # align if required\n 666 |         if any(not data.index.equals(x.index) for x in others):\n 667 |             # Need to add keys for uniqueness in case of duplicate columns\n 668 |             others = concat(\n 669 |                 others,\n 670 |                 axis=1,\n 671 |                 join=(join if join == \"inner\" else \"outer\"),\n 672 |                 keys=range(len(others)),\n 673 |                 sort=False,\n 674 |             )\n 675 |             data, others = data.align(others, join=join)\n 676 |             others = [others[x] for x in others]  # again list of Series\n 677 | \n 678 |         all_cols = [ensure_object(x) for x in [data] + others]\n 679 |         na_masks = np.array([isna(x) for x in all_cols])\n 680 |         union_mask = np.logical_or.reduce(na_masks, axis=0)\n 681 | \n 682 |         if na_rep is None and union_mask.any():\n 683 |             # no na_rep means NaNs for all rows where any column has a NaN\n 684 |             # only necessary if there are actually any NaNs\n 685 |             result = np.empty(len(data), dtype=object)\n 686 |             np.putmask(result, union_mask, np.nan)\n 687 | \n 688 |             not_masked = ~union_mask\n 689 |             result[not_masked] = cat_safe([x[not_masked] for x in all_cols], sep)\n 690 |         elif na_rep is not None and union_mask.any():\n 691 |             # fill NaNs with na_rep in case there are actually any NaNs\n 692 |             all_cols = [\n 693 |                 np.where(nm, na_rep, col) for nm, col in zip(na_masks, all_cols)\n 694 |             ]\n 695 |             result = cat_safe(all_cols, sep)\n 696 |         else:\n 697 |             # no NaNs - can just concatenate\n 698 |             result = cat_safe(all_cols, sep)\n 699 | \n 700 |         out: Index | Series\n 701 |         if isinstance(self._orig.dtype, CategoricalDtype):\n 702 |             # We need to infer the new categories.\n 703 |             dtype = self._orig.dtype.categories.dtype\n 704 |         else:\n 705 |             dtype = self._orig.dtype\n 706 |         if isinstance(self._orig, ABCIndex):\n 707 |             # add dtype for case that result is all-NA\n 708 |             if isna(result).all():\n 709 |                 dtype = object  # type: ignore[assignment]\n 710 | \n 711 |             out = Index(result, dtype=dtype, name=self._orig.name)\n 712 |         else:  # Series\n 713 |             res_ser = Series(\n 714 |                 result, dtype=dtype, index=data.index, name=self._orig.name, copy=False\n 715 |             )\n 716 |             out = res_ser.__finalize__(self._orig, method=\"str_cat\")\n 717 |         return out\n 718 | \n 719 |     _shared_docs[\"str_split\"] = r\"\"\"\n 720 |     Split strings around given separator/delimiter.\n 721 | \n 722 |     Splits the string in the Series/Index from the %(side)s,\n 723 |     at the specified delimiter string.\n 724 | \n 725 |     Parameters\n 726 |     ----------\n 727 |     pat : str%(pat_regex)s, optional\n 728 |         %(pat_description)s.\n 729 |         If not specified, split on whitespace.\n 730 |     n : int, default -1 (all)\n 731 |         Limit number of splits in output.\n 732 |         ``None``, 0 and -1 will be interpreted as return all splits.\n 733 |     expand : bool, default False\n 734 |         Expand the split strings into separate columns.\n 735 | \n 736 |         - If ``True``, return DataFrame/MultiIndex expanding dimensionality.\n 737 |         - If ``False``, return Series/Index, containing lists of strings.\n 738 |     %(regex_argument)s\n 739 |     Returns\n 740 |     -------\n 741 |     Series, Index, DataFrame or MultiIndex\n 742 |         Type matches caller unless ``expand=True`` (see Notes).\n 743 |     %(raises_split)s\n 744 |     See Also\n 745 |     --------\n 746 |     Series.str.split : Split strings around given separator/delimiter.\n 747 |     Series.str.rsplit : Splits string around given separator/delimiter,\n 748 |         starting from the right.\n 749 |     Series.str.join : Join lists contained as elements in the Series/Index\n 750 |         with passed delimiter.\n 751 |     str.split : Standard library version for split.\n 752 |     str.rsplit : Standard library version for rsplit.\n 753 | \n 754 |     Notes\n 755 |     -----\n 756 |     The handling of the `n` keyword depends on the number of found splits:\n 757 | \n 758 |     - If found splits > `n`,  make first `n` splits only\n 759 |     - If found splits <= `n`, make all splits\n 760 |     - If for a certain row the number of found splits < `n`,\n 761 |       append `None` for padding up to `n` if ``expand=True``\n 762 | \n 763 |     If using ``expand=True``, Series and Index callers return DataFrame and\n 764 |     MultiIndex objects, respectively.\n 765 |     %(regex_pat_note)s\n 766 |     Examples\n 767 |     --------\n 768 |     >>> s = pd.Series(\n 769 |     ...     [\n 770 |     ...         \"this is a regular sentence\",\n 771 |     ...         \"https://docs.python.org/3/tutorial/index.html\",\n 772 |     ...         np.nan\n 773 |     ...     ]\n 774 |     ... )\n 775 |     >>> s\n 776 |     0                       this is a regular sentence\n 777 |     1    https://docs.python.org/3/tutorial/index.html\n 778 |     2                                              NaN\n 779 |     dtype: object\n 780 | \n 781 |     In the default setting, the string is split by whitespace.\n 782 | \n 783 |     >>> s.str.split()\n 784 |     0                   [this, is, a, regular, sentence]\n 785 |     1    [https://docs.python.org/3/tutorial/index.html]\n 786 |     2                                                NaN\n 787 |     dtype: object\n 788 | \n 789 |     Without the `n` parameter, the outputs of `rsplit` and `split`\n 790 |     are identical.\n 791 | \n 792 |     >>> s.str.rsplit()\n 793 |     0                   [this, is, a, regular, sentence]\n 794 |     1    [https://docs.python.org/3/tutorial/index.html]\n 795 |     2                                                NaN\n 796 |     dtype: object\n 797 | \n 798 |     The `n` parameter can be used to limit the number of splits on the\n 799 |     delimiter. The outputs of `split` and `rsplit` are different.\n 800 | \n 801 |     >>> s.str.split(n=2)\n 802 |     0                     [this, is, a regular sentence]\n 803 |     1    [https://docs.python.org/3/tutorial/index.html]\n 804 |     2                                                NaN\n 805 |     dtype: object\n 806 | \n 807 |     >>> s.str.rsplit(n=2)\n 808 |     0                     [this is a, regular, sentence]\n 809 |     1    [https://docs.python.org/3/tutorial/index.html]\n 810 |     2                                                NaN\n 811 |     dtype: object\n 812 | \n 813 |     The `pat` parameter can be used to split by other characters.\n 814 | \n 815 |     >>> s.str.split(pat=\"/\")\n 816 |     0                         [this is a regular sentence]\n 817 |     1    [https:, , docs.python.org, 3, tutorial, index...\n 818 |     2                                                  NaN\n 819 |     dtype: object\n 820 | \n 821 |     When using ``expand=True``, the split elements will expand out into\n 822 |     separate columns. If NaN is present, it is propagated throughout\n 823 |     the columns during the split.\n 824 | \n 825 |     >>> s.str.split(expand=True)\n 826 |                                                    0     1     2        3         4\n 827 |     0                                           this    is     a  regular  sentence\n 828 |     1  https://docs.python.org/3/tutorial/index.html  None  None     None      None\n 829 |     2                                            NaN   NaN   NaN      NaN       NaN\n 830 | \n 831 |     For slightly more complex use cases like splitting the html document name\n 832 |     from a url, a combination of parameter settings can be used.\n 833 | \n 834 |     >>> s.str.rsplit(\"/\", n=1, expand=True)\n 835 |                                         0           1\n 836 |     0          this is a regular sentence        None\n 837 |     1  https://docs.python.org/3/tutorial  index.html\n 838 |     2                                 NaN         NaN\n 839 |     %(regex_examples)s\"\"\"\n 840 | \n 841 |     @Appender(\n 842 |         _shared_docs[\"str_split\"]\n 843 |         % {\n 844 |             \"side\": \"beginning\",\n 845 |             \"pat_regex\": \" or compiled regex\",\n 846 |             \"pat_description\": \"String or regular expression to split on\",\n 847 |             \"regex_argument\": \"\"\"\n 848 |     regex : bool, default None\n 849 |         Determines if the passed-in pattern is a regular expression:\n 850 | \n 851 |         - If ``True``, assumes the passed-in pattern is a regular expression\n 852 |         - If ``False``, treats the pattern as a literal string.\n 853 |         - If ``None`` and `pat` length is 1, treats `pat` as a literal string.\n 854 |         - If ``None`` and `pat` length is not 1, treats `pat` as a regular expression.\n 855 |         - Cannot be set to False if `pat` is a compiled regex\n 856 | \n 857 |         .. versionadded:: 1.4.0\n 858 |          \"\"\",\n 859 |             \"raises_split\": \"\"\"\n 860 |                       Raises\n 861 |                       ------\n 862 |                       ValueError\n 863 |                           * if `regex` is False and `pat` is a compiled regex\n 864 |                       \"\"\",\n 865 |             \"regex_pat_note\": \"\"\"\n 866 |     Use of `regex =False` with a `pat` as a compiled regex will raise an error.\n 867 |             \"\"\",\n 868 |             \"method\": \"split\",\n 869 |             \"regex_examples\": r\"\"\"\n 870 |     Remember to escape special characters when explicitly using regular expressions.\n 871 | \n 872 |     >>> s = pd.Series([\"foo and bar plus baz\"])\n 873 |     >>> s.str.split(r\"and|plus\", expand=True)\n 874 |         0   1   2\n 875 |     0 foo bar baz\n 876 | \n 877 |     Regular expressions can be used to handle urls or file names.\n 878 |     When `pat` is a string and ``regex=None`` (the default), the given `pat` is compiled\n 879 |     as a regex only if ``len(pat) != 1``.\n 880 | \n 881 |     >>> s = pd.Series(['foojpgbar.jpg'])\n 882 |     >>> s.str.split(r\".\", expand=True)\n 883 |                0    1\n 884 |     0  foojpgbar  jpg\n 885 | \n 886 |     >>> s.str.split(r\"\\.jpg\", expand=True)\n 887 |                0 1\n 888 |     0  foojpgbar\n 889 | \n 890 |     When ``regex=True``, `pat` is interpreted as a regex\n 891 | \n 892 |     >>> s.str.split(r\"\\.jpg\", regex=True, expand=True)\n 893 |                0 1\n 894 |     0  foojpgbar\n 895 | \n 896 |     A compiled regex can be passed as `pat`\n 897 | \n 898 |     >>> import re\n 899 |     >>> s.str.split(re.compile(r\"\\.jpg\"), expand=True)\n 900 |                0 1\n 901 |     0  foojpgbar\n 902 | \n 903 |     When ``regex=False``, `pat` is interpreted as the string itself\n 904 | \n 905 |     >>> s.str.split(r\"\\.jpg\", regex=False, expand=True)\n 906 |                    0\n 907 |     0  foojpgbar.jpg\n 908 |     \"\"\",\n 909 |         }\n 910 |     )\n 911 |     @forbid_nonstring_types([\"bytes\"])\n 912 |     def split(\n 913 |         self,\n 914 |         pat: str | re.Pattern | None = None,\n 915 |         *,\n 916 |         n=-1,\n 917 |         expand: bool = False,\n 918 |         regex: bool | None = None,\n 919 |     ):\n 920 |         if regex is False and is_re(pat):\n 921 |             raise ValueError(\n 922 |                 \"Cannot use a compiled regex as replacement pattern with regex=False\"\n 923 |             )\n 924 |         if is_re(pat):\n 925 |             regex = True\n 926 |         result = self._data.array._str_split(pat, n, expand, regex)\n 927 |         if self._data.dtype == \"category\":\n 928 |             dtype = self._data.dtype.categories.dtype\n 929 |         else:\n 930 |             dtype = object if self._data.dtype == object else None\n 931 |         return self._wrap_result(\n 932 |             result, expand=expand, returns_string=expand, dtype=dtype\n 933 |         )\n 934 | \n 935 |     @Appender(\n 936 |         _shared_docs[\"str_split\"]\n 937 |         % {\n 938 |             \"side\": \"end\",\n 939 |             \"pat_regex\": \"\",\n 940 |             \"pat_description\": \"String to split on\",\n 941 |             \"regex_argument\": \"\",\n 942 |             \"raises_split\": \"\",\n 943 |             \"regex_pat_note\": \"\",\n 944 |             \"method\": \"rsplit\",\n 945 |             \"regex_examples\": \"\",\n 946 |         }\n 947 |     )\n 948 |     @forbid_nonstring_types([\"bytes\"])\n 949 |     def rsplit(self, pat=None, *, n=-1, expand: bool = False):\n 950 |         result = self._data.array._str_rsplit(pat, n=n)\n 951 |         dtype = object if self._data.dtype == object else None\n 952 |         return self._wrap_result(\n 953 |             result, expand=expand, returns_string=expand, dtype=dtype\n 954 |         )\n 955 | \n 956 |     _shared_docs[\"str_partition\"] = \"\"\"\n 957 |     Split the string at the %(side)s occurrence of `sep`.\n 958 | \n 959 |     This method splits the string at the %(side)s occurrence of `sep`,\n 960 |     and returns 3 elements containing the part before the separator,\n 961 |     the separator itself, and the part after the separator.\n 962 |     If the separator is not found, return %(return)s.\n 963 | \n 964 |     Parameters\n 965 |     ----------\n 966 |     sep : str, default whitespace\n 967 |         String to split on.\n 968 |     expand : bool, default True\n 969 |         If True, return DataFrame/MultiIndex expanding dimensionality.\n 970 |         If False, return Series/Index.\n 971 | \n 972 |     Returns\n 973 |     -------\n 974 |     DataFrame/MultiIndex or Series/Index of objects\n 975 |         Returns appropriate type based on `expand` parameter with strings\n 976 |         split based on the `sep` parameter.\n 977 | \n 978 |     See Also\n 979 |     --------\n 980 |     %(also)s\n 981 |     Series.str.split : Split strings around given separators.\n 982 |     str.partition : Standard library version.\n 983 | \n 984 |     Examples\n 985 |     --------\n 986 | \n 987 |     >>> s = pd.Series(['Linda van der Berg', 'George Pitt-Rivers'])\n 988 |     >>> s\n 989 |     0    Linda van der Berg\n 990 |     1    George Pitt-Rivers\n 991 |     dtype: object\n 992 | \n 993 |     >>> s.str.partition()\n 994 |             0  1             2\n 995 |     0   Linda     van der Berg\n 996 |     1  George      Pitt-Rivers\n 997 | \n 998 |     To partition by the last space instead of the first one:\n 999 | \n1000 |     >>> s.str.rpartition()\n1001 |                    0  1            2\n1002 |     0  Linda van der            Berg\n1003 |     1         George     Pitt-Rivers\n1004 | \n1005 |     To partition by something different than a space:\n1006 | \n1007 |     >>> s.str.partition('-')\n1008 |                         0  1       2\n1009 |     0  Linda van der Berg\n1010 |     1         George Pitt  -  Rivers\n1011 | \n1012 |     To return a Series containing tuples instead of a DataFrame:\n1013 | \n1014 |     >>> s.str.partition('-', expand=False)\n1015 |     0    (Linda van der Berg, , )\n1016 |     1    (George Pitt, -, Rivers)\n1017 |     dtype: object\n1018 | \n1019 |     Also available on indices:\n1020 | \n1021 |     >>> idx = pd.Index(['X 123', 'Y 999'])\n1022 |     >>> idx\n1023 |     Index(['X 123', 'Y 999'], dtype='object')\n1024 | \n1025 |     Which will create a MultiIndex:\n1026 | \n1027 |     >>> idx.str.partition()\n1028 |     MultiIndex([('X', ' ', '123'),\n1029 |                 ('Y', ' ', '999')],\n1030 |                )\n1031 | \n1032 |     Or an index with tuples with ``expand=False``:\n1033 | \n1034 |     >>> idx.str.partition(expand=False)\n1035 |     Index([('X', ' ', '123'), ('Y', ' ', '999')], dtype='object')\n1036 |     \"\"\"\n1037 | \n1038 |     @Appender(\n1039 |         _shared_docs[\"str_partition\"]\n1040 |         % {\n1041 |             \"side\": \"first\",\n1042 |             \"return\": \"3 elements containing the string itself, followed by two \"\n1043 |             \"empty strings\",\n1044 |             \"also\": \"rpartition : Split the string at the last occurrence of `sep`.\",\n1045 |         }\n1046 |     )\n1047 |     @forbid_nonstring_types([\"bytes\"])\n1048 |     def partition(self, sep: str = \" \", expand: bool = True):\n1049 |         result = self._data.array._str_partition(sep, expand)\n1050 |         if self._data.dtype == \"category\":\n1051 |             dtype = self._data.dtype.categories.dtype\n1052 |         else:\n1053 |             dtype = object if self._data.dtype == object else None\n1054 |         return self._wrap_result(\n1055 |             result, expand=expand, returns_string=expand, dtype=dtype\n1056 |         )\n1057 | \n1058 |     @Appender(\n1059 |         _shared_docs[\"str_partition\"]\n1060 |         % {\n1061 |             \"side\": \"last\",\n1062 |             \"return\": \"3 elements containing two empty strings, followed by the \"\n1063 |             \"string itself\",\n1064 |             \"also\": \"partition : Split the string at the first occurrence of `sep`.\",\n1065 |         }\n1066 |     )\n1067 |     @forbid_nonstring_types([\"bytes\"])\n1068 |     def rpartition(self, sep: str = \" \", expand: bool = True):\n1069 |         result = self._data.array._str_rpartition(sep, expand)\n1070 |         if self._data.dtype == \"category\":\n1071 |             dtype = self._data.dtype.categories.dtype\n1072 |         else:\n1073 |             dtype = object if self._data.dtype == object else None\n1074 |         return self._wrap_result(\n1075 |             result, expand=expand, returns_string=expand, dtype=dtype\n1076 |         )\n1077 | \n1078 |     def get(self, i):\n1079 |         \"\"\"\n1080 |         Extract element from each component at specified position or with specified key.\n1081 | \n1082 |         Extract element from lists, tuples, dict, or strings in each element in the\n1083 |         Series/Index.\n1084 | \n1085 |         Parameters\n1086 |         ----------\n1087 |         i : int or hashable dict label\n1088 |             Position or key of element to extract.\n1089 | \n1090 |         Returns\n1091 |         -------\n1092 |         Series or Index\n1093 |             Series or Index where each value is the extracted element from\n1094 |             the corresponding input component.\n1095 | \n1096 |         See Also\n1097 |         --------\n1098 |         Series.str.extract : Extract capture groups in the regex as columns\n1099 |             in a DataFrame.\n1100 | \n1101 |         Examples\n1102 |         --------\n1103 |         >>> s = pd.Series(\n1104 |         ...     [\n1105 |         ...         \"String\",\n1106 |         ...         (1, 2, 3),\n1107 |         ...         [\"a\", \"b\", \"c\"],\n1108 |         ...         123,\n1109 |         ...         -456,\n1110 |         ...         {1: \"Hello\", \"2\": \"World\"},\n1111 |         ...     ]\n1112 |         ... )\n1113 |         >>> s\n1114 |         0                        String\n1115 |         1                     (1, 2, 3)\n1116 |         2                     [a, b, c]\n1117 |         3                           123\n1118 |         4                          -456\n1119 |         5    {1: 'Hello', '2': 'World'}\n1120 |         dtype: object\n1121 | \n1122 |         >>> s.str.get(1)\n1123 |         0        t\n1124 |         1        2\n1125 |         2        b\n1126 |         3      NaN\n1127 |         4      NaN\n1128 |         5    Hello\n1129 |         dtype: object\n1130 | \n1131 |         >>> s.str.get(-1)\n1132 |         0      g\n1133 |         1      3\n1134 |         2      c\n1135 |         3    NaN\n1136 |         4    NaN\n1137 |         5    None\n1138 |         dtype: object\n1139 | \n1140 |         Return element with given key\n1141 | \n1142 |         >>> s = pd.Series(\n1143 |         ...     [\n1144 |         ...         {\"name\": \"Hello\", \"value\": \"World\"},\n1145 |         ...         {\"name\": \"Goodbye\", \"value\": \"Planet\"},\n1146 |         ...     ]\n1147 |         ... )\n1148 |         >>> s.str.get(\"name\")\n1149 |         0      Hello\n1150 |         1    Goodbye\n1151 |         dtype: object\n1152 |         \"\"\"\n1153 |         result = self._data.array._str_get(i)\n1154 |         return self._wrap_result(result)\n1155 | \n1156 |     @forbid_nonstring_types([\"bytes\"])\n1157 |     def join(self, sep: str):\n1158 |         \"\"\"\n1159 |         Join lists contained as elements in the Series/Index with passed delimiter.\n1160 | \n1161 |         If the elements of a Series are lists themselves, join the content of these\n1162 |         lists using the delimiter passed to the function.\n1163 |         This function is an equivalent to :meth:`str.join`.\n1164 | \n1165 |         Parameters\n1166 |         ----------\n1167 |         sep : str\n1168 |             Delimiter to use between list entries.\n1169 | \n1170 |         Returns\n1171 |         -------\n1172 |         Series/Index: object\n1173 |             The list entries concatenated by intervening occurrences of the\n1174 |             delimiter.\n1175 | \n1176 |         Raises\n1177 |         ------\n1178 |         AttributeError\n1179 |             If the supplied Series contains neither strings nor lists.\n1180 | \n1181 |         See Also\n1182 |         --------\n1183 |         str.join : Standard library version of this method.\n1184 |         Series.str.split : Split strings around given separator/delimiter.\n1185 | \n1186 |         Notes\n1187 |         -----\n1188 |         If any of the list items is not a string object, the result of the join\n1189 |         will be `NaN`.\n1190 | \n1191 |         Examples\n1192 |         --------\n1193 |         Example with a list that contains non-string elements.\n1194 | \n1195 |         >>> s = pd.Series(\n1196 |         ...     [\n1197 |         ...         [\"lion\", \"elephant\", \"zebra\"],\n1198 |         ...         [1.1, 2.2, 3.3],\n1199 |         ...         [\"cat\", np.nan, \"dog\"],\n1200 |         ...         [\"cow\", 4.5, \"goat\"],\n1201 |         ...         [\"duck\", [\"swan\", \"fish\"], \"guppy\"],\n1202 |         ...     ]\n1203 |         ... )\n1204 |         >>> s\n1205 |         0        [lion, elephant, zebra]\n1206 |         1                [1.1, 2.2, 3.3]\n1207 |         2                [cat, nan, dog]\n1208 |         3               [cow, 4.5, goat]\n1209 |         4    [duck, [swan, fish], guppy]\n1210 |         dtype: object\n1211 | \n1212 |         Join all lists using a '-'. The lists containing object(s) of types other\n1213 |         than str will produce a NaN.\n1214 | \n1215 |         >>> s.str.join(\"-\")\n1216 |         0    lion-elephant-zebra\n1217 |         1                    NaN\n1218 |         2                    NaN\n1219 |         3                    NaN\n1220 |         4                    NaN\n1221 |         dtype: object\n1222 |         \"\"\"\n1223 |         result = self._data.array._str_join(sep)\n1224 |         return self._wrap_result(result)\n1225 | \n1226 |     @forbid_nonstring_types([\"bytes\"])\n1227 |     def contains(\n1228 |         self,\n1229 |         pat,\n1230 |         case: bool = True,\n1231 |         flags: int = 0,\n1232 |         na=lib.no_default,\n1233 |         regex: bool = True,\n1234 |     ):\n1235 |         r\"\"\"\n1236 |         Test if pattern or regex is contained within a string of a Series or Index.\n1237 | \n1238 |         Return boolean Series or Index based on whether a given pattern or regex is\n1239 |         contained within a string of a Series or Index.\n1240 | \n1241 |         Parameters\n1242 |         ----------\n1243 |         pat : str\n1244 |             Character sequence or regular expression.\n1245 |         case : bool, default True\n1246 |             If True, case sensitive.\n1247 |         flags : int, default 0 (no flags)\n1248 |             Flags to pass through to the re module, e.g. re.IGNORECASE.\n1249 |         na : scalar, optional\n1250 |             Fill value for missing values. The default depends on dtype of the\n1251 |             array. For object-dtype, ``numpy.nan`` is used. For the nullable\n1252 |             ``StringDtype``, ``pandas.NA`` is used. For the ``\"str\"`` dtype,\n1253 |             ``False`` is used.\n1254 |         regex : bool, default True\n1255 |             If True, assumes the pat is a regular expression.\n1256 | \n1257 |             If False, treats the pat as a literal string.\n1258 | \n1259 |         Returns\n1260 |         -------\n1261 |         Series or Index of boolean values\n1262 |             A Series or Index of boolean values indicating whether the\n1263 |             given pattern is contained within the string of each element\n1264 |             of the Series or Index.\n1265 | \n1266 |         See Also\n1267 |         --------\n1268 |         match : Analogous, but stricter, relying on re.match instead of re.search.\n1269 |         Series.str.startswith : Test if the start of each string element matches a\n1270 |             pattern.\n1271 |         Series.str.endswith : Same as startswith, but tests the end of string.\n1272 | \n1273 |         Examples\n1274 |         --------\n1275 |         Returning a Series of booleans using only a literal pattern.\n1276 | \n1277 |         >>> s1 = pd.Series([\"Mouse\", \"dog\", \"house and parrot\", \"23\", np.nan])\n1278 |         >>> s1.str.contains(\"og\", regex=False)\n1279 |         0    False\n1280 |         1     True\n1281 |         2    False\n1282 |         3    False\n1283 |         4      NaN\n1284 |         dtype: object\n1285 | \n1286 |         Returning an Index of booleans using only a literal pattern.\n1287 | \n1288 |         >>> ind = pd.Index([\"Mouse\", \"dog\", \"house and parrot\", \"23.0\", np.nan])\n1289 |         >>> ind.str.contains(\"23\", regex=False)\n1290 |         Index([False, False, False, True, nan], dtype='object')\n1291 | \n1292 |         Specifying case sensitivity using `case`.\n1293 | \n1294 |         >>> s1.str.contains(\"oG\", case=True, regex=True)\n1295 |         0    False\n1296 |         1    False\n1297 |         2    False\n1298 |         3    False\n1299 |         4      NaN\n1300 |         dtype: object\n1301 | \n1302 |         Specifying `na` to be `False` instead of `NaN` replaces NaN values\n1303 |         with `False`. If Series or Index does not contain NaN values\n1304 |         the resultant dtype will be `bool`, otherwise, an `object` dtype.\n1305 | \n1306 |         >>> s1.str.contains(\"og\", na=False, regex=True)\n1307 |         0    False\n1308 |         1     True\n1309 |         2    False\n1310 |         3    False\n1311 |         4    False\n1312 |         dtype: bool\n1313 | \n1314 |         Returning 'house' or 'dog' when either expression occurs in a string.\n1315 | \n1316 |         >>> s1.str.contains(\"house|dog\", regex=True)\n1317 |         0    False\n1318 |         1     True\n1319 |         2     True\n1320 |         3    False\n1321 |         4      NaN\n1322 |         dtype: object\n1323 | \n1324 |         Ignoring case sensitivity using `flags` with regex.\n1325 | \n1326 |         >>> import re\n1327 |         >>> s1.str.contains(\"PARROT\", flags=re.IGNORECASE, regex=True)\n1328 |         0    False\n1329 |         1    False\n1330 |         2     True\n1331 |         3    False\n1332 |         4      NaN\n1333 |         dtype: object\n1334 | \n1335 |         Returning any digit using regular expression.\n1336 | \n1337 |         >>> s1.str.contains(\"\\\\d\", regex=True)\n1338 |         0    False\n1339 |         1    False\n1340 |         2    False\n1341 |         3     True\n1342 |         4      NaN\n1343 |         dtype: object\n1344 | \n1345 |         Ensure `pat` is a not a literal pattern when `regex` is set to True.\n1346 |         Note in the following example one might expect only `s2[1]` and `s2[3]` to\n1347 |         return `True`. However, '.0' as a regex matches any character\n1348 |         followed by a 0.\n1349 | \n1350 |         >>> s2 = pd.Series([\"40\", \"40.0\", \"41\", \"41.0\", \"35\"])\n1351 |         >>> s2.str.contains(\".0\", regex=True)\n1352 |         0     True\n1353 |         1     True\n1354 |         2    False\n1355 |         3     True\n1356 |         4    False\n1357 |         dtype: bool\n1358 |         \"\"\"\n1359 |         if regex and re.compile(pat).groups:\n1360 |             warnings.warn(\n1361 |                 \"This pattern is interpreted as a regular expression, and has \"\n1362 |                 \"match groups. To actually get the groups, use str.extract.\",\n1363 |                 UserWarning,\n1364 |                 stacklevel=find_stack_level(),\n1365 |             )\n1366 | \n1367 |         result = self._data.array._str_contains(pat, case, flags, na, regex)\n1368 |         return self._wrap_result(result, fill_value=na, returns_string=False)\n1369 | \n1370 |     @forbid_nonstring_types([\"bytes\"])\n1371 |     def match(self, pat: str, case: bool = True, flags: int = 0, na=lib.no_default):\n1372 |         \"\"\"\n1373 |         Determine if each string starts with a match of a regular expression.\n1374 | \n1375 |         Parameters\n1376 |         ----------\n1377 |         pat : str\n1378 |             Character sequence.\n1379 |         case : bool, default True\n1380 |             If True, case sensitive.\n1381 |         flags : int, default 0 (no flags)\n1382 |             Regex module flags, e.g. re.IGNORECASE.\n1383 |         na : scalar, optional\n1384 |             Fill value for missing values. The default depends on dtype of the\n1385 |             array. For object-dtype, ``numpy.nan`` is used. For the nullable\n1386 |             ``StringDtype``, ``pandas.NA`` is used. For the ``\"str\"`` dtype,\n1387 |             ``False`` is used.\n1388 | \n1389 |         Returns\n1390 |         -------\n1391 |         Series/Index/array of boolean values\n1392 |             A Series, Index, or array of boolean values indicating whether the start\n1393 |             of each string matches the pattern. The result will be of the same type\n1394 |             as the input.\n1395 | \n1396 |         See Also\n1397 |         --------\n1398 |         fullmatch : Stricter matching that requires the entire string to match.\n1399 |         contains : Analogous, but less strict, relying on re.search instead of\n1400 |             re.match.\n1401 |         extract : Extract matched groups.\n1402 | \n1403 |         Examples\n1404 |         --------\n1405 |         >>> ser = pd.Series([\"horse\", \"eagle\", \"donkey\"])\n1406 |         >>> ser.str.match(\"e\")\n1407 |         0   False\n1408 |         1   True\n1409 |         2   False\n1410 |         dtype: bool\n1411 |         \"\"\"\n1412 |         result = self._data.array._str_match(pat, case=case, flags=flags, na=na)\n1413 |         return self._wrap_result(result, fill_value=na, returns_string=False)\n1414 | \n1415 |     @forbid_nonstring_types([\"bytes\"])\n1416 |     def fullmatch(self, pat, case: bool = True, flags: int = 0, na=lib.no_default):\n1417 |         \"\"\"\n1418 |         Determine if each string entirely matches a regular expression.\n1419 | \n1420 |         Parameters\n1421 |         ----------\n1422 |         pat : str\n1423 |             Character sequence or regular expression.\n1424 |         case : bool, default True\n1425 |             If True, case sensitive.\n1426 |         flags : int, default 0 (no flags)\n1427 |             Regex module flags, e.g. re.IGNORECASE.\n1428 |         na : scalar, optional\n1429 |             Fill value for missing values. The default depends on dtype of the\n1430 |             array. For object-dtype, ``numpy.nan`` is used. For the nullable\n1431 |             ``StringDtype``, ``pandas.NA`` is used. For the ``\"str\"`` dtype,\n1432 |             ``False`` is used.\n1433 | \n1434 |         Returns\n1435 |         -------\n1436 |         Series/Index/array of boolean values\n1437 |             The function returns a Series, Index, or array of boolean values,\n1438 |             where True indicates that the entire string matches the regular\n1439 |             expression pattern and False indicates that it does not.\n1440 | \n1441 |         See Also\n1442 |         --------\n1443 |         match : Similar, but also returns `True` when only a *prefix* of the string\n1444 |             matches the regular expression.\n1445 |         extract : Extract matched groups.\n1446 | \n1447 |         Examples\n1448 |         --------\n1449 |         >>> ser = pd.Series([\"cat\", \"duck\", \"dove\"])\n1450 |         >>> ser.str.fullmatch(r\"d.+\")\n1451 |         0   False\n1452 |         1    True\n1453 |         2    True\n1454 |         dtype: bool\n1455 |         \"\"\"\n1456 |         result = self._data.array._str_fullmatch(pat, case=case, flags=flags, na=na)\n1457 |         return self._wrap_result(result, fill_value=na, returns_string=False)\n1458 | \n1459 |     @forbid_nonstring_types([\"bytes\"])\n1460 |     def replace(\n1461 |         self,\n1462 |         pat: str | re.Pattern | dict,\n1463 |         repl: str | Callable | None = None,\n1464 |         n: int = -1,\n1465 |         case: bool | None = None,\n1466 |         flags: int = 0,\n1467 |         regex: bool = False,\n1468 |     ):\n1469 |         r\"\"\"\n1470 |         Replace each occurrence of pattern/regex in the Series/Index.\n1471 | \n1472 |         Equivalent to :meth:`str.replace` or :func:`re.sub`, depending on\n1473 |         the regex value.\n1474 | \n1475 |         Parameters\n1476 |         ----------\n1477 |         pat : str, compiled regex, or a dict\n1478 |             String can be a character sequence or regular expression.\n1479 |             Dictionary contains <key : value> pairs of strings to be replaced\n1480 |             along with the updated value.\n1481 |         repl : str or callable\n1482 |             Replacement string or a callable. The callable is passed the regex\n1483 |             match object and must return a replacement string to be used.\n1484 |             Must have a value of None if `pat` is a dict\n1485 |             See :func:`re.sub`.\n1486 |         n : int, default -1 (all)\n1487 |             Number of replacements to make from start.\n1488 |         case : bool, default None\n1489 |             Determines if replace is case sensitive:\n1490 | \n1491 |             - If True, case sensitive (the default if `pat` is a string)\n1492 |             - Set to False for case insensitive\n1493 |             - Cannot be set if `pat` is a compiled regex.\n1494 | \n1495 |         flags : int, default 0 (no flags)\n1496 |             Regex module flags, e.g. re.IGNORECASE. Cannot be set if `pat` is a compiled\n1497 |             regex.\n1498 |         regex : bool, default False\n1499 |             Determines if the passed-in pattern is a regular expression:\n1500 | \n1501 |             - If True, assumes the passed-in pattern is a regular expression.\n1502 |             - If False, treats the pattern as a literal string\n1503 |             - Cannot be set to False if `pat` is a compiled regex or `repl` is\n1504 |               a callable.\n1505 | \n1506 |         Returns\n1507 |         -------\n1508 |         Series or Index of object\n1509 |             A copy of the object with all matching occurrences of `pat` replaced by\n1510 |             `repl`.\n1511 | \n1512 |         Raises\n1513 |         ------\n1514 |         ValueError\n1515 |             * if `regex` is False and `repl` is a callable or `pat` is a compiled\n1516 |               regex\n1517 |             * if `pat` is a compiled regex and `case` or `flags` is set\n1518 |             * if `pat` is a dictionary and `repl` is not None.\n1519 | \n1520 |         See Also\n1521 |         --------\n1522 |         Series.str.replace : Method to replace occurrences of a substring with another\n1523 |             substring.\n1524 |         Series.str.extract : Extract substrings using a regular expression.\n1525 |         Series.str.findall : Find all occurrences of a pattern or regex in each string.\n1526 |         Series.str.split : Split each string by a specified delimiter or pattern.\n1527 | \n1528 |         Notes\n1529 |         -----\n1530 |         When `pat` is a compiled regex, all flags should be included in the\n1531 |         compiled regex. Use of `case`, `flags`, or `regex=False` with a compiled\n1532 |         regex will raise an error.\n1533 | \n1534 |         Examples\n1535 |         --------\n1536 |         When `pat` is a dictionary, every key in `pat` is replaced\n1537 |         with its corresponding value:\n1538 | \n1539 |         >>> pd.Series([\"A\", \"B\", np.nan]).str.replace(pat={\"A\": \"a\", \"B\": \"b\"})\n1540 |         0    a\n1541 |         1    b\n1542 |         2    NaN\n1543 |         dtype: object\n1544 | \n1545 |         When `pat` is a string and `regex` is True, the given `pat`\n1546 |         is compiled as a regex. When `repl` is a string, it replaces matching\n1547 |         regex patterns as with :meth:`re.sub`. NaN value(s) in the Series are\n1548 |         left as is:\n1549 | \n1550 |         >>> pd.Series([\"foo\", \"fuz\", np.nan]).str.replace(\"f.\", \"ba\", regex=True)\n1551 |         0    bao\n1552 |         1    baz\n1553 |         2    NaN\n1554 |         dtype: object\n1555 | \n1556 |         When `pat` is a string and `regex` is False, every `pat` is replaced with\n1557 |         `repl` as with :meth:`str.replace`:\n1558 | \n1559 |         >>> pd.Series([\"f.o\", \"fuz\", np.nan]).str.replace(\"f.\", \"ba\", regex=False)\n1560 |         0    bao\n1561 |         1    fuz\n1562 |         2    NaN\n1563 |         dtype: object\n1564 | \n1565 |         When `repl` is a callable, it is called on every `pat` using\n1566 |         :func:`re.sub`. The callable should expect one positional argument\n1567 |         (a regex object) and return a string.\n1568 | \n1569 |         To get the idea:\n1570 | \n1571 |         >>> pd.Series([\"foo\", \"fuz\", np.nan]).str.replace(\"f\", repr, regex=True)\n1572 |         0    <re.Match object; span=(0, 1), match='f'>oo\n1573 |         1    <re.Match object; span=(0, 1), match='f'>uz\n1574 |         2                                            NaN\n1575 |         dtype: object\n1576 | \n1577 |         Reverse every lowercase alphabetic word:\n1578 | \n1579 |         >>> repl = lambda m: m.group(0)[::-1]\n1580 |         >>> ser = pd.Series([\"foo 123\", \"bar baz\", np.nan])\n1581 |         >>> ser.str.replace(r\"[a-z]+\", repl, regex=True)\n1582 |         0    oof 123\n1583 |         1    rab zab\n1584 |         2        NaN\n1585 |         dtype: object\n1586 | \n1587 |         Using regex groups (extract second group and swap case):\n1588 | \n1589 |         >>> pat = r\"(?P<one>\\w+) (?P<two>\\w+) (?P<three>\\w+)\"\n1590 |         >>> repl = lambda m: m.group(\"two\").swapcase()\n1591 |         >>> ser = pd.Series([\"One Two Three\", \"Foo Bar Baz\"])\n1592 |         >>> ser.str.replace(pat, repl, regex=True)\n1593 |         0    tWO\n1594 |         1    bAR\n1595 |         dtype: object\n1596 | \n1597 |         Using a compiled regex with flags\n1598 | \n1599 |         >>> import re\n1600 |         >>> regex_pat = re.compile(r\"FUZ\", flags=re.IGNORECASE)\n1601 |         >>> pd.Series([\"foo\", \"fuz\", np.nan]).str.replace(regex_pat, \"bar\", regex=True)\n1602 |         0    foo\n1603 |         1    bar\n1604 |         2    NaN\n1605 |         dtype: object\n1606 |         \"\"\"\n1607 |         if isinstance(pat, dict) and repl is not None:\n1608 |             raise ValueError(\"repl cannot be used when pat is a dictionary\")\n1609 | \n1610 |         # Check whether repl is valid (GH 13438, GH 15055)\n1611 |         if not isinstance(pat, dict) and not (isinstance(repl, str) or callable(repl)):\n1612 |             raise TypeError(\"repl must be a string or callable\")\n1613 | \n1614 |         is_compiled_re = is_re(pat)\n1615 |         if regex or regex is None:\n1616 |             if is_compiled_re and (case is not None or flags != 0):\n1617 |                 raise ValueError(\n1618 |                     \"case and flags cannot be set when pat is a compiled regex\"\n1619 |                 )\n1620 | \n1621 |         elif is_compiled_re:\n1622 |             raise ValueError(\n1623 |                 \"Cannot use a compiled regex as replacement pattern with regex=False\"\n1624 |             )\n1625 |         elif callable(repl):\n1626 |             raise ValueError(\"Cannot use a callable replacement when regex=False\")\n1627 | \n1628 |         if case is None:\n1629 |             case = True\n1630 | \n1631 |         res_output = self._data\n1632 |         if not isinstance(pat, dict):\n1633 |             pat = {pat: repl}\n1634 | \n1635 |         for key, value in pat.items():\n1636 |             result = res_output.array._str_replace(\n1637 |                 key, value, n=n, case=case, flags=flags, regex=regex\n1638 |             )\n1639 |             res_output = self._wrap_result(result)\n1640 | \n1641 |         return res_output\n1642 | \n1643 |     @forbid_nonstring_types([\"bytes\"])\n1644 |     def repeat(self, repeats):\n1645 |         \"\"\"\n1646 |         Duplicate each string in the Series or Index.\n1647 | \n1648 |         Parameters\n1649 |         ----------\n1650 |         repeats : int or sequence of int\n1651 |             Same value for all (int) or different value per (sequence).\n1652 | \n1653 |         Returns\n1654 |         -------\n1655 |         Series or pandas.Index\n1656 |             Series or Index of repeated string objects specified by\n1657 |             input parameter repeats.\n1658 | \n1659 |         See Also\n1660 |         --------\n1661 |         Series.str.lower : Convert all characters in each string to lowercase.\n1662 |         Series.str.upper : Convert all characters in each string to uppercase.\n1663 |         Series.str.title : Convert each string to title case (capitalizing the first\n1664 |             letter of each word).\n1665 |         Series.str.strip : Remove leading and trailing whitespace from each string.\n1666 |         Series.str.replace : Replace occurrences of a substring with another substring\n1667 |             in each string.\n1668 |         Series.str.ljust : Left-justify each string in the Series/Index by padding with\n1669 |             a specified character.\n1670 |         Series.str.rjust : Right-justify each string in the Series/Index by padding with\n1671 |             a specified character.\n1672 | \n1673 |         Examples\n1674 |         --------\n1675 |         >>> s = pd.Series([\"a\", \"b\", \"c\"])\n1676 |         >>> s\n1677 |         0    a\n1678 |         1    b\n1679 |         2    c\n1680 |         dtype: object\n1681 | \n1682 |         Single int repeats string in Series\n1683 | \n1684 |         >>> s.str.repeat(repeats=2)\n1685 |         0    aa\n1686 |         1    bb\n1687 |         2    cc\n1688 |         dtype: object\n1689 | \n1690 |         Sequence of int repeats corresponding string in Series\n1691 | \n1692 |         >>> s.str.repeat(repeats=[1, 2, 3])\n1693 |         0      a\n1694 |         1     bb\n1695 |         2    ccc\n1696 |         dtype: object\n1697 |         \"\"\"\n1698 |         result = self._data.array._str_repeat(repeats)\n1699 |         return self._wrap_result(result)\n1700 | \n1701 |     @forbid_nonstring_types([\"bytes\"])\n1702 |     def pad(\n1703 |         self,\n1704 |         width: int,\n1705 |         side: Literal[\"left\", \"right\", \"both\"] = \"left\",\n1706 |         fillchar: str = \" \",\n1707 |     ):\n1708 |         \"\"\"\n1709 |         Pad strings in the Series/Index up to width.\n1710 | \n1711 |         Parameters\n1712 |         ----------\n1713 |         width : int\n1714 |             Minimum width of resulting string; additional characters will be filled\n1715 |             with character defined in `fillchar`.\n1716 |         side : {'left', 'right', 'both'}, default 'left'\n1717 |             Side from which to fill resulting string.\n1718 |         fillchar : str, default ' '\n1719 |             Additional character for filling, default is whitespace.\n1720 | \n1721 |         Returns\n1722 |         -------\n1723 |         Series or Index of object\n1724 |             Returns Series or Index with minimum number of char in object.\n1725 | \n1726 |         See Also\n1727 |         --------\n1728 |         Series.str.rjust : Fills the left side of strings with an arbitrary\n1729 |             character. Equivalent to ``Series.str.pad(side='left')``.\n1730 |         Series.str.ljust : Fills the right side of strings with an arbitrary\n1731 |             character. Equivalent to ``Series.str.pad(side='right')``.\n1732 |         Series.str.center : Fills both sides of strings with an arbitrary\n1733 |             character. Equivalent to ``Series.str.pad(side='both')``.\n1734 |         Series.str.zfill : Pad strings in the Series/Index by prepending '0'\n1735 |             character. Equivalent to ``Series.str.pad(side='left', fillchar='0')``.\n1736 | \n1737 |         Examples\n1738 |         --------\n1739 |         >>> s = pd.Series([\"caribou\", \"tiger\"])\n1740 |         >>> s\n1741 |         0    caribou\n1742 |         1      tiger\n1743 |         dtype: object\n1744 | \n1745 |         >>> s.str.pad(width=10)\n1746 |         0       caribou\n1747 |         1         tiger\n1748 |         dtype: object\n1749 | \n1750 |         >>> s.str.pad(width=10, side=\"right\", fillchar=\"-\")\n1751 |         0    caribou---\n1752 |         1    tiger-----\n1753 |         dtype: object\n1754 | \n1755 |         >>> s.str.pad(width=10, side=\"both\", fillchar=\"-\")\n1756 |         0    -caribou--\n1757 |         1    --tiger---\n1758 |         dtype: object\n1759 |         \"\"\"\n1760 |         if not isinstance(fillchar, str):\n1761 |             msg = f\"fillchar must be a character, not {type(fillchar).__name__}\"\n1762 |             raise TypeError(msg)\n1763 | \n1764 |         if len(fillchar) != 1:\n1765 |             raise TypeError(\"fillchar must be a character, not str\")\n1766 | \n1767 |         if not is_integer(width):\n1768 |             msg = f\"width must be of integer type, not {type(width).__name__}\"\n1769 |             raise TypeError(msg)\n1770 | \n1771 |         result = self._data.array._str_pad(width, side=side, fillchar=fillchar)\n1772 |         return self._wrap_result(result)\n1773 | \n1774 |     _shared_docs[\"str_pad\"] = \"\"\"\n1775 |     Pad %(side)s side of strings in the Series/Index.\n1776 | \n1777 |     Equivalent to :meth:`str.%(method)s`.\n1778 | \n1779 |     Parameters\n1780 |     ----------\n1781 |     width : int\n1782 |         Minimum width of resulting string; additional characters will be filled\n1783 |         with ``fillchar``.\n1784 |     fillchar : str\n1785 |         Additional character for filling, default is whitespace.\n1786 | \n1787 |     Returns\n1788 |     -------\n1789 |     Series/Index of objects.\n1790 |         A Series or Index where the strings are modified by :meth:`str.%(method)s`.\n1791 | \n1792 |     See Also\n1793 |     --------\n1794 |     Series.str.rjust : Fills the left side of strings with an arbitrary\n1795 |         character.\n1796 |     Series.str.ljust : Fills the right side of strings with an arbitrary\n1797 |         character.\n1798 |     Series.str.center : Fills both sides of strings with an arbitrary\n1799 |         character.\n1800 |     Series.str.zfill : Pad strings in the Series/Index by prepending '0'\n1801 |         character.\n1802 | \n1803 |     Examples\n1804 |     --------\n1805 |     For Series.str.center:\n1806 | \n1807 |     >>> ser = pd.Series(['dog', 'bird', 'mouse'])\n1808 |     >>> ser.str.center(8, fillchar='.')\n1809 |     0   ..dog...\n1810 |     1   ..bird..\n1811 |     2   .mouse..\n1812 |     dtype: object\n1813 | \n1814 |     For Series.str.ljust:\n1815 | \n1816 |     >>> ser = pd.Series(['dog', 'bird', 'mouse'])\n1817 |     >>> ser.str.ljust(8, fillchar='.')\n1818 |     0   dog.....\n1819 |     1   bird....\n1820 |     2   mouse...\n1821 |     dtype: object\n1822 | \n1823 |     For Series.str.rjust:\n1824 | \n1825 |     >>> ser = pd.Series(['dog', 'bird', 'mouse'])\n1826 |     >>> ser.str.rjust(8, fillchar='.')\n1827 |     0   .....dog\n1828 |     1   ....bird\n1829 |     2   ...mouse\n1830 |     dtype: object\n1831 |     \"\"\"\n1832 | \n1833 |     @Appender(_shared_docs[\"str_pad\"] % {\"side\": \"left and right\", \"method\": \"center\"})\n1834 |     @forbid_nonstring_types([\"bytes\"])\n1835 |     def center(self, width: int, fillchar: str = \" \"):\n1836 |         return self.pad(width, side=\"both\", fillchar=fillchar)\n1837 | \n1838 |     @Appender(_shared_docs[\"str_pad\"] % {\"side\": \"right\", \"method\": \"ljust\"})\n1839 |     @forbid_nonstring_types([\"bytes\"])\n1840 |     def ljust(self, width: int, fillchar: str = \" \"):\n1841 |         return self.pad(width, side=\"right\", fillchar=fillchar)\n1842 | \n1843 |     @Appender(_shared_docs[\"str_pad\"] % {\"side\": \"left\", \"method\": \"rjust\"})\n1844 |     @forbid_nonstring_types([\"bytes\"])\n1845 |     def rjust(self, width: int, fillchar: str = \" \"):\n1846 |         return self.pad(width, side=\"left\", fillchar=fillchar)\n1847 | \n1848 |     @forbid_nonstring_types([\"bytes\"])\n1849 |     def zfill(self, width: int):\n1850 |         \"\"\"\n1851 |         Pad strings in the Series/Index by prepending '0' characters.\n1852 | \n1853 |         Strings in the Series/Index are padded with '0' characters on the\n1854 |         left of the string to reach a total string length  `width`. Strings\n1855 |         in the Series/Index with length greater or equal to `width` are\n1856 |         unchanged.\n1857 | \n1858 |         Parameters\n1859 |         ----------\n1860 |         width : int\n1861 |             Minimum length of resulting string; strings with length less\n1862 |             than `width` be prepended with '0' characters.\n1863 | \n1864 |         Returns\n1865 |         -------\n1866 |         Series/Index of objects.\n1867 |             A Series or Index where the strings are prepended with '0' characters.\n1868 | \n1869 |         See Also\n1870 |         --------\n1871 |         Series.str.rjust : Fills the left side of strings with an arbitrary\n1872 |             character.\n1873 |         Series.str.ljust : Fills the right side of strings with an arbitrary\n1874 |             character.\n1875 |         Series.str.pad : Fills the specified sides of strings with an arbitrary\n1876 |             character.\n1877 |         Series.str.center : Fills both sides of strings with an arbitrary\n1878 |             character.\n1879 | \n1880 |         Notes\n1881 |         -----\n1882 |         Differs from :meth:`str.zfill` which has special handling\n1883 |         for '+'/'-' in the string.\n1884 | \n1885 |         Examples\n1886 |         --------\n1887 |         >>> s = pd.Series([\"-1\", \"1\", \"1000\", 10, np.nan])\n1888 |         >>> s\n1889 |         0      -1\n1890 |         1       1\n1891 |         2    1000\n1892 |         3      10\n1893 |         4     NaN\n1894 |         dtype: object\n1895 | \n1896 |         Note that ``10`` and ``NaN`` are not strings, therefore they are\n1897 |         converted to ``NaN``. The minus sign in ``'-1'`` is treated as a\n1898 |         special character and the zero is added to the right of it\n1899 |         (:meth:`str.zfill` would have moved it to the left). ``1000``\n1900 |         remains unchanged as it is longer than `width`.\n1901 | \n1902 |         >>> s.str.zfill(3)\n1903 |         0     -01\n1904 |         1     001\n1905 |         2    1000\n1906 |         3     NaN\n1907 |         4     NaN\n1908 |         dtype: object\n1909 |         \"\"\"\n1910 |         if not is_integer(width):\n1911 |             msg = f\"width must be of integer type, not {type(width).__name__}\"\n1912 |             raise TypeError(msg)\n1913 |         f = lambda x: x.zfill(width)\n1914 |         result = self._data.array._str_map(f)\n1915 |         return self._wrap_result(result)\n1916 | \n1917 |     def slice(self, start=None, stop=None, step=None):\n1918 |         \"\"\"\n1919 |         Slice substrings from each element in the Series or Index.\n1920 | \n1921 |         Parameters\n1922 |         ----------\n1923 |         start : int, optional\n1924 |             Start position for slice operation.\n1925 |         stop : int, optional\n1926 |             Stop position for slice operation.\n1927 |         step : int, optional\n1928 |             Step size for slice operation.\n1929 | \n1930 |         Returns\n1931 |         -------\n1932 |         Series or Index of object\n1933 |             Series or Index from sliced substring from original string object.\n1934 | \n1935 |         See Also\n1936 |         --------\n1937 |         Series.str.slice_replace : Replace a slice with a string.\n1938 |         Series.str.get : Return element at position.\n1939 |             Equivalent to `Series.str.slice(start=i, stop=i+1)` with `i`\n1940 |             being the position.\n1941 | \n1942 |         Examples\n1943 |         --------\n1944 |         >>> s = pd.Series([\"koala\", \"dog\", \"chameleon\"])\n1945 |         >>> s\n1946 |         0        koala\n1947 |         1          dog\n1948 |         2    chameleon\n1949 |         dtype: object\n1950 | \n1951 |         >>> s.str.slice(start=1)\n1952 |         0        oala\n1953 |         1          og\n1954 |         2    hameleon\n1955 |         dtype: object\n1956 | \n1957 |         >>> s.str.slice(start=-1)\n1958 |         0           a\n1959 |         1           g\n1960 |         2           n\n1961 |         dtype: object\n1962 | \n1963 |         >>> s.str.slice(stop=2)\n1964 |         0    ko\n1965 |         1    do\n1966 |         2    ch\n1967 |         dtype: object\n1968 | \n1969 |         >>> s.str.slice(step=2)\n1970 |         0      kaa\n1971 |         1       dg\n1972 |         2    caeen\n1973 |         dtype: object\n1974 | \n1975 |         >>> s.str.slice(start=0, stop=5, step=3)\n1976 |         0    kl\n1977 |         1     d\n1978 |         2    cm\n1979 |         dtype: object\n1980 | \n1981 |         Equivalent behaviour to:\n1982 | \n1983 |         >>> s.str[0:5:3]\n1984 |         0    kl\n1985 |         1     d\n1986 |         2    cm\n1987 |         dtype: object\n1988 |         \"\"\"\n1989 |         result = self._data.array._str_slice(start, stop, step)\n1990 |         return self._wrap_result(result)\n1991 | \n1992 |     @forbid_nonstring_types([\"bytes\"])\n1993 |     def slice_replace(self, start=None, stop=None, repl=None):\n1994 |         \"\"\"\n1995 |         Replace a positional slice of a string with another value.\n1996 | \n1997 |         Parameters\n1998 |         ----------\n1999 |         start : int, optional\n2000 |             Left index position to use for the slice. If not specified (None),\n2001 |             the slice is unbounded on the left, i.e. slice from the start\n2002 |             of the string.\n2003 |         stop : int, optional\n2004 |             Right index position to use for the slice. If not specified (None),\n2005 |             the slice is unbounded on the right, i.e. slice until the\n2006 |             end of the string.\n2007 |         repl : str, optional\n2008 |             String for replacement. If not specified (None), the sliced region\n2009 |             is replaced with an empty string.\n2010 | \n2011 |         Returns\n2012 |         -------\n2013 |         Series or Index\n2014 |             Same type as the original object.\n2015 | \n2016 |         See Also\n2017 |         --------\n2018 |         Series.str.slice : Just slicing without replacement.\n2019 | \n2020 |         Examples\n2021 |         --------\n2022 |         >>> s = pd.Series([\"a\", \"ab\", \"abc\", \"abdc\", \"abcde\"])\n2023 |         >>> s\n2024 |         0        a\n2025 |         1       ab\n2026 |         2      abc\n2027 |         3     abdc\n2028 |         4    abcde\n2029 |         dtype: object\n2030 | \n2031 |         Specify just `start`, meaning replace `start` until the end of the\n2032 |         string with `repl`.\n2033 | \n2034 |         >>> s.str.slice_replace(1, repl=\"X\")\n2035 |         0    aX\n2036 |         1    aX\n2037 |         2    aX\n2038 |         3    aX\n2039 |         4    aX\n2040 |         dtype: object\n2041 | \n2042 |         Specify just `stop`, meaning the start of the string to `stop` is replaced\n2043 |         with `repl`, and the rest of the string is included.\n2044 | \n2045 |         >>> s.str.slice_replace(stop=2, repl=\"X\")\n2046 |         0       X\n2047 |         1       X\n2048 |         2      Xc\n2049 |         3     Xdc\n2050 |         4    Xcde\n2051 |         dtype: object\n2052 | \n2053 |         Specify `start` and `stop`, meaning the slice from `start` to `stop` is\n2054 |         replaced with `repl`. Everything before or after `start` and `stop` is\n2055 |         included as is.\n2056 | \n2057 |         >>> s.str.slice_replace(start=1, stop=3, repl=\"X\")\n2058 |         0      aX\n2059 |         1      aX\n2060 |         2      aX\n2061 |         3     aXc\n2062 |         4    aXde\n2063 |         dtype: object\n2064 |         \"\"\"\n2065 |         result = self._data.array._str_slice_replace(start, stop, repl)\n2066 |         return self._wrap_result(result)\n2067 | \n2068 |     def decode(self, encoding, errors: str = \"strict\"):\n2069 |         \"\"\"\n2070 |         Decode character string in the Series/Index using indicated encoding.\n2071 | \n2072 |         Equivalent to :meth:`str.decode` in python2 and :meth:`bytes.decode` in\n2073 |         python3.\n2074 | \n2075 |         Parameters\n2076 |         ----------\n2077 |         encoding : str\n2078 |             Specifies the encoding to be used.\n2079 |         errors : str, optional\n2080 |             Specifies the error handling scheme.\n2081 |             Possible values are those supported by :meth:`bytes.decode`.\n2082 | \n2083 |         Returns\n2084 |         -------\n2085 |         Series or Index\n2086 |             A Series or Index with decoded strings.\n2087 | \n2088 |         See Also\n2089 |         --------\n2090 |         Series.str.encode : Encodes strings into bytes in a Series/Index.\n2091 | \n2092 |         Examples\n2093 |         --------\n2094 |         For Series:\n2095 | \n2096 |         >>> ser = pd.Series([b\"cow\", b\"123\", b\"()\"])\n2097 |         >>> ser.str.decode(\"ascii\")\n2098 |         0   cow\n2099 |         1   123\n2100 |         2   ()\n2101 |         dtype: object\n2102 |         \"\"\"\n2103 |         # TODO: Add a similar _bytes interface.\n2104 |         if encoding in _cpython_optimized_decoders:\n2105 |             # CPython optimized implementation\n2106 |             f = lambda x: x.decode(encoding, errors)\n2107 |         else:\n2108 |             decoder = codecs.getdecoder(encoding)\n2109 |             f = lambda x: decoder(x, errors)[0]\n2110 |         arr = self._data.array\n2111 |         # assert isinstance(arr, (StringArray,))\n2112 |         result = arr._str_map(f)\n2113 |         return self._wrap_result(result)\n2114 | \n2115 |     @forbid_nonstring_types([\"bytes\"])\n2116 |     def encode(self, encoding, errors: str = \"strict\"):\n2117 |         \"\"\"\n2118 |         Encode character string in the Series/Index using indicated encoding.\n2119 | \n2120 |         Equivalent to :meth:`str.encode`.\n2121 | \n2122 |         Parameters\n2123 |         ----------\n2124 |         encoding : str\n2125 |             Specifies the encoding to be used.\n2126 |         errors : str, optional\n2127 |             Specifies the error handling scheme.\n2128 |             Possible values are those supported by :meth:`str.encode`.\n2129 | \n2130 |         Returns\n2131 |         -------\n2132 |         Series/Index of objects\n2133 |             A Series or Index with strings encoded into bytes.\n2134 | \n2135 |         See Also\n2136 |         --------\n2137 |         Series.str.decode : Decodes bytes into strings in a Series/Index.\n2138 | \n2139 |         Examples\n2140 |         --------\n2141 |         >>> ser = pd.Series([\"cow\", \"123\", \"()\"])\n2142 |         >>> ser.str.encode(encoding=\"ascii\")\n2143 |         0     b'cow'\n2144 |         1     b'123'\n2145 |         2      b'()'\n2146 |         dtype: object\n2147 |         \"\"\"\n2148 |         result = self._data.array._str_encode(encoding, errors)\n2149 |         return self._wrap_result(result, returns_string=False)\n2150 | \n2151 |     _shared_docs[\"str_strip\"] = r\"\"\"\n2152 |     Remove %(position)s characters.\n2153 | \n2154 |     Strip whitespaces (including newlines) or a set of specified characters\n2155 |     from each string in the Series/Index from %(side)s.\n2156 |     Replaces any non-strings in Series with NaNs.\n2157 |     Equivalent to :meth:`str.%(method)s`.\n2158 | \n2159 |     Parameters\n2160 |     ----------\n2161 |     to_strip : str or None, default None\n2162 |         Specifying the set of characters to be removed.\n2163 |         All combinations of this set of characters will be stripped.\n2164 |         If None then whitespaces are removed.\n2165 | \n2166 |     Returns\n2167 |     -------\n2168 |     Series or Index of object\n2169 |         Series or Index with the strings being stripped from the %(side)s.\n2170 | \n2171 |     See Also\n2172 |     --------\n2173 |     Series.str.strip : Remove leading and trailing characters in Series/Index.\n2174 |     Series.str.lstrip : Remove leading characters in Series/Index.\n2175 |     Series.str.rstrip : Remove trailing characters in Series/Index.\n2176 | \n2177 |     Examples\n2178 |     --------\n2179 |     >>> s = pd.Series(['1. Ant.  ', '2. Bee!\\n', '3. Cat?\\t', np.nan, 10, True])\n2180 |     >>> s\n2181 |     0    1. Ant.\n2182 |     1    2. Bee!\\n\n2183 |     2    3. Cat?\\t\n2184 |     3          NaN\n2185 |     4           10\n2186 |     5         True\n2187 |     dtype: object\n2188 | \n2189 |     >>> s.str.strip()\n2190 |     0    1. Ant.\n2191 |     1    2. Bee!\n2192 |     2    3. Cat?\n2193 |     3        NaN\n2194 |     4        NaN\n2195 |     5        NaN\n2196 |     dtype: object\n2197 | \n2198 |     >>> s.str.lstrip('123.')\n2199 |     0    Ant.\n2200 |     1    Bee!\\n\n2201 |     2    Cat?\\t\n2202 |     3       NaN\n2203 |     4       NaN\n2204 |     5       NaN\n2205 |     dtype: object\n2206 | \n2207 |     >>> s.str.rstrip('.!? \\n\\t')\n2208 |     0    1. Ant\n2209 |     1    2. Bee\n2210 |     2    3. Cat\n2211 |     3       NaN\n2212 |     4       NaN\n2213 |     5       NaN\n2214 |     dtype: object\n2215 | \n2216 |     >>> s.str.strip('123.!? \\n\\t')\n2217 |     0    Ant\n2218 |     1    Bee\n2219 |     2    Cat\n2220 |     3    NaN\n2221 |     4    NaN\n2222 |     5    NaN\n2223 |     dtype: object\n2224 |     \"\"\"\n2225 | \n2226 |     @Appender(\n2227 |         _shared_docs[\"str_strip\"]\n2228 |         % {\n2229 |             \"side\": \"left and right sides\",\n2230 |             \"method\": \"strip\",\n2231 |             \"position\": \"leading and trailing\",\n2232 |         }\n2233 |     )\n2234 |     @forbid_nonstring_types([\"bytes\"])\n2235 |     def strip(self, to_strip=None):\n2236 |         result = self._data.array._str_strip(to_strip)\n2237 |         return self._wrap_result(result)\n2238 | \n2239 |     @Appender(\n2240 |         _shared_docs[\"str_strip\"]\n2241 |         % {\"side\": \"left side\", \"method\": \"lstrip\", \"position\": \"leading\"}\n2242 |     )\n2243 |     @forbid_nonstring_types([\"bytes\"])\n2244 |     def lstrip(self, to_strip=None):\n2245 |         result = self._data.array._str_lstrip(to_strip)\n2246 |         return self._wrap_result(result)\n2247 | \n2248 |     @Appender(\n2249 |         _shared_docs[\"str_strip\"]\n2250 |         % {\"side\": \"right side\", \"method\": \"rstrip\", \"position\": \"trailing\"}\n2251 |     )\n2252 |     @forbid_nonstring_types([\"bytes\"])\n2253 |     def rstrip(self, to_strip=None):\n2254 |         result = self._data.array._str_rstrip(to_strip)\n2255 |         return self._wrap_result(result)\n2256 | \n2257 |     _shared_docs[\"str_removefix\"] = r\"\"\"\n2258 |     Remove a %(side)s from an object series.\n2259 | \n2260 |     If the %(side)s is not present, the original string will be returned.\n2261 | \n2262 |     Parameters\n2263 |     ----------\n2264 |     %(side)s : str\n2265 |         Remove the %(side)s of the string.\n2266 | \n2267 |     Returns\n2268 |     -------\n2269 |     Series/Index: object\n2270 |         The Series or Index with given %(side)s removed.\n2271 | \n2272 |     See Also\n2273 |     --------\n2274 |     Series.str.remove%(other_side)s : Remove a %(other_side)s from an object series.\n2275 | \n2276 |     Examples\n2277 |     --------\n2278 |     >>> s = pd.Series([\"str_foo\", \"str_bar\", \"no_prefix\"])\n2279 |     >>> s\n2280 |     0    str_foo\n2281 |     1    str_bar\n2282 |     2    no_prefix\n2283 |     dtype: object\n2284 |     >>> s.str.removeprefix(\"str_\")\n2285 |     0    foo\n2286 |     1    bar\n2287 |     2    no_prefix\n2288 |     dtype: object\n2289 | \n2290 |     >>> s = pd.Series([\"foo_str\", \"bar_str\", \"no_suffix\"])\n2291 |     >>> s\n2292 |     0    foo_str\n2293 |     1    bar_str\n2294 |     2    no_suffix\n2295 |     dtype: object\n2296 |     >>> s.str.removesuffix(\"_str\")\n2297 |     0    foo\n2298 |     1    bar\n2299 |     2    no_suffix\n2300 |     dtype: object\n2301 |     \"\"\"\n2302 | \n2303 |     @Appender(\n2304 |         _shared_docs[\"str_removefix\"] % {\"side\": \"prefix\", \"other_side\": \"suffix\"}\n2305 |     )\n2306 |     @forbid_nonstring_types([\"bytes\"])\n2307 |     def removeprefix(self, prefix: str):\n2308 |         result = self._data.array._str_removeprefix(prefix)\n2309 |         return self._wrap_result(result)\n2310 | \n2311 |     @Appender(\n2312 |         _shared_docs[\"str_removefix\"] % {\"side\": \"suffix\", \"other_side\": \"prefix\"}\n2313 |     )\n2314 |     @forbid_nonstring_types([\"bytes\"])\n2315 |     def removesuffix(self, suffix: str):\n2316 |         result = self._data.array._str_removesuffix(suffix)\n2317 |         return self._wrap_result(result)\n2318 | \n2319 |     @forbid_nonstring_types([\"bytes\"])\n2320 |     def wrap(\n2321 |         self,\n2322 |         width: int,\n2323 |         expand_tabs: bool = True,\n2324 |         tabsize: int = 8,\n2325 |         replace_whitespace: bool = True,\n2326 |         drop_whitespace: bool = True,\n2327 |         initial_indent: str = \"\",\n2328 |         subsequent_indent: str = \"\",\n2329 |         fix_sentence_endings: bool = False,\n2330 |         break_long_words: bool = True,\n2331 |         break_on_hyphens: bool = True,\n2332 |         max_lines: int | None = None,\n2333 |         placeholder: str = \" [...]\",\n2334 |     ):\n2335 |         r\"\"\"\n2336 |         Wrap strings in Series/Index at specified line width.\n2337 | \n2338 |         This method has the same keyword parameters and defaults as\n2339 |             :class:`textwrap.TextWrapper`.\n2340 | \n2341 |         Parameters\n2342 |         ----------\n2343 |         width : int, optional\n2344 |             Maximum line width.\n2345 |         expand_tabs : bool, optional\n2346 |             If True, tab characters will be expanded to spaces (default: True).\n2347 |         tabsize : int, optional\n2348 |             If expand_tabs is true, then all tab characters in text will be\n2349 |             expanded to zero or more spaces, depending on the current column\n2350 |             and the given tab size (default: 8).\n2351 |         replace_whitespace : bool, optional\n2352 |             If True, each whitespace character (as defined by string.whitespace)\n2353 |             remaining after tab expansion will be replaced by a single space\n2354 |             (default: True).\n2355 |         drop_whitespace : bool, optional\n2356 |             If True, whitespace that, after wrapping, happens to end up at the\n2357 |             beginning or end of a line is dropped (default: True).\n2358 |         initial_indent : str, optional\n2359 |             String that will be prepended to the first line of wrapped output.\n2360 |             Counts towards the length of the first line. The empty string is\n2361 |             not indented (default: '').\n2362 |         subsequent_indent : str, optional\n2363 |             String that will be prepended to all lines of wrapped output except\n2364 |             the first. Counts towards the length of each line except the first\n2365 |             (default: '').\n2366 |         fix_sentence_endings : bool, optional\n2367 |             If true, TextWrapper attempts to detect sentence endings and ensure\n2368 |             that sentences are always separated by exactly two spaces. This is\n2369 |             generally desired for text in a monospaced font. However, the sentence\n2370 |             detection algorithm is imperfect: it assumes that a sentence ending\n2371 |             consists of a lowercase letter followed by one of '.', '!', or '?',\n2372 |             possibly followed by one of '\"' or \"'\", followed by a space. One\n2373 |             problem with this algorithm is that it is unable to detect the\n2374 |             difference between \u201cDr.\u201d in `[...] Dr. Frankenstein's monster [...]`\n2375 |             and \u201cSpot.\u201d in `[...] See Spot. See Spot run [...]`\n2376 |             Since the sentence detection algorithm relies on string.lowercase\n2377 |             for the definition of \u201clowercase letter\u201d, and a convention of using\n2378 |             two spaces after a period to separate sentences on the same line,\n2379 |             it is specific to English-language texts (default: False).\n2380 |         break_long_words : bool, optional\n2381 |             If True, then words longer than width will be broken in order to ensure\n2382 |             that no lines are longer than width. If it is false, long words will\n2383 |             not be broken, and some lines may be longer than width (default: True).\n2384 |         break_on_hyphens : bool, optional\n2385 |             If True, wrapping will occur preferably on whitespace and right after\n2386 |             hyphens in compound words, as it is customary in English. If false,\n2387 |             only whitespaces will be considered as potentially good places for line\n2388 |             breaks, but you need to set break_long_words to false if you want truly\n2389 |             insecable words (default: True).\n2390 |         max_lines : int, optional\n2391 |             If not None, then the output will contain at most max_lines lines, with\n2392 |             placeholder appearing at the end of the output (default: None).\n2393 |         placeholder : str, optional\n2394 |             String that will appear at the end of the output text if it has been\n2395 |             truncated (default: ' [...]').\n2396 | \n2397 |         Returns\n2398 |         -------\n2399 |         Series or Index\n2400 |             A Series or Index where the strings are wrapped at the specified line width.\n2401 | \n2402 |         See Also\n2403 |         --------\n2404 |         Series.str.strip : Remove leading and trailing characters in Series/Index.\n2405 |         Series.str.lstrip : Remove leading characters in Series/Index.\n2406 |         Series.str.rstrip : Remove trailing characters in Series/Index.\n2407 | \n2408 |         Notes\n2409 |         -----\n2410 |         Internally, this method uses a :class:`textwrap.TextWrapper` instance with\n2411 |         default settings. To achieve behavior matching R's stringr library str_wrap\n2412 |         function, use the arguments:\n2413 | \n2414 |         - expand_tabs = False\n2415 |         - replace_whitespace = True\n2416 |         - drop_whitespace = True\n2417 |         - break_long_words = False\n2418 |         - break_on_hyphens = False\n2419 | \n2420 |         Examples\n2421 |         --------\n2422 |         >>> s = pd.Series([\"line to be wrapped\", \"another line to be wrapped\"])\n2423 |         >>> s.str.wrap(12)\n2424 |         0             line to be\\nwrapped\n2425 |         1    another line\\nto be\\nwrapped\n2426 |         dtype: object\n2427 |         \"\"\"\n2428 |         result = self._data.array._str_wrap(\n2429 |             width=width,\n2430 |             expand_tabs=expand_tabs,\n2431 |             tabsize=tabsize,\n2432 |             replace_whitespace=replace_whitespace,\n2433 |             drop_whitespace=drop_whitespace,\n2434 |             initial_indent=initial_indent,\n2435 |             subsequent_indent=subsequent_indent,\n2436 |             fix_sentence_endings=fix_sentence_endings,\n2437 |             break_long_words=break_long_words,\n2438 |             break_on_hyphens=break_on_hyphens,\n2439 |             max_lines=max_lines,\n2440 |             placeholder=placeholder,\n2441 |         )\n2442 |         return self._wrap_result(result)\n2443 | \n2444 |     @forbid_nonstring_types([\"bytes\"])\n2445 |     def get_dummies(\n2446 |         self,\n2447 |         sep: str = \"|\",\n2448 |         dtype: NpDtype | None = None,\n2449 |     ):\n2450 |         \"\"\"\n2451 |         Return DataFrame of dummy/indicator variables for Series.\n2452 | \n2453 |         Each string in Series is split by sep and returned as a DataFrame\n2454 |         of dummy/indicator variables.\n2455 | \n2456 |         Parameters\n2457 |         ----------\n2458 |         sep : str, default \"|\"\n2459 |             String to split on.\n2460 |         dtype : dtype, default np.int64\n2461 |             Data type for new columns. Only a single dtype is allowed.\n2462 | \n2463 |         Returns\n2464 |         -------\n2465 |         DataFrame\n2466 |             Dummy variables corresponding to values of the Series.\n2467 | \n2468 |         See Also\n2469 |         --------\n2470 |         get_dummies : Convert categorical variable into dummy/indicator\n2471 |             variables.\n2472 | \n2473 |         Examples\n2474 |         --------\n2475 |         >>> pd.Series([\"a|b\", \"a\", \"a|c\"]).str.get_dummies()\n2476 |            a  b  c\n2477 |         0  1  1  0\n2478 |         1  1  0  0\n2479 |         2  1  0  1\n2480 | \n2481 |         >>> pd.Series([\"a|b\", np.nan, \"a|c\"]).str.get_dummies()\n2482 |            a  b  c\n2483 |         0  1  1  0\n2484 |         1  0  0  0\n2485 |         2  1  0  1\n2486 | \n2487 |         >>> pd.Series([\"a|b\", np.nan, \"a|c\"]).str.get_dummies(dtype=bool)\n2488 |                 a      b      c\n2489 |         0   True   True    False\n2490 |         1   False  False   False\n2491 |         2   True   False   True\n2492 |         \"\"\"\n2493 |         from pandas.core.frame import DataFrame\n2494 | \n2495 |         # we need to cast to Series of strings as only that has all\n2496 |         # methods available for making the dummies...\n2497 |         result, name = self._data.array._str_get_dummies(sep, dtype)\n2498 |         if is_extension_array_dtype(dtype) or isinstance(dtype, ArrowDtype):\n2499 |             return self._wrap_result(\n2500 |                 DataFrame(result, columns=name, dtype=dtype),\n2501 |                 name=name,\n2502 |                 returns_string=False,\n2503 |             )\n2504 |         return self._wrap_result(\n2505 |             result,\n2506 |             name=name,\n2507 |             expand=True,\n2508 |             returns_string=False,\n2509 |         )\n2510 | \n2511 |     @forbid_nonstring_types([\"bytes\"])\n2512 |     def translate(self, table):\n2513 |         \"\"\"\n2514 |         Map all characters in the string through the given mapping table.\n2515 | \n2516 |         This method is equivalent to the standard :meth:`str.translate`\n2517 |         method for strings. It maps each character in the string to a new\n2518 |         character according to the translation table provided. Unmapped\n2519 |         characters are left unchanged, while characters mapped to None\n2520 |         are removed.\n2521 | \n2522 |         Parameters\n2523 |         ----------\n2524 |         table : dict\n2525 |             Table is a mapping of Unicode ordinals to Unicode ordinals, strings, or\n2526 |             None. Unmapped characters are left untouched.\n2527 |             Characters mapped to None are deleted. :meth:`str.maketrans` is a\n2528 |             helper function for making translation tables.\n2529 | \n2530 |         Returns\n2531 |         -------\n2532 |         Series or Index\n2533 |             A new Series or Index with translated strings.\n2534 | \n2535 |         See Also\n2536 |         --------\n2537 |         Series.str.replace : Replace occurrences of pattern/regex in the\n2538 |             Series with some other string.\n2539 |         Index.str.replace : Replace occurrences of pattern/regex in the\n2540 |             Index with some other string.\n2541 | \n2542 |         Examples\n2543 |         --------\n2544 |         >>> ser = pd.Series([\"El ni\u00f1o\", \"Fran\u00e7oise\"])\n2545 |         >>> mytable = str.maketrans({\"\u00f1\": \"n\", \"\u00e7\": \"c\"})\n2546 |         >>> ser.str.translate(mytable)\n2547 |         0   El nino\n2548 |         1   Francoise\n2549 |         dtype: object\n2550 |         \"\"\"\n2551 |         result = self._data.array._str_translate(table)\n2552 |         dtype = object if self._data.dtype == \"object\" else None\n2553 |         return self._wrap_result(result, dtype=dtype)\n2554 | \n2555 |     @forbid_nonstring_types([\"bytes\"])\n2556 |     def count(self, pat, flags: int = 0):\n2557 |         r\"\"\"\n2558 |         Count occurrences of pattern in each string of the Series/Index.\n2559 | \n2560 |         This function is used to count the number of times a particular regex\n2561 |         pattern is repeated in each of the string elements of the\n2562 |         :class:`~pandas.Series`.\n2563 | \n2564 |         Parameters\n2565 |         ----------\n2566 |         pat : str\n2567 |             Valid regular expression.\n2568 |         flags : int, default 0, meaning no flags\n2569 |             Flags for the `re` module. For a complete list, `see here\n2570 |             <https://docs.python.org/3/howto/regex.html#compilation-flags>`_.\n2571 | \n2572 |         Returns\n2573 |         -------\n2574 |         Series or Index\n2575 |             Same type as the calling object containing the integer counts.\n2576 | \n2577 |         See Also\n2578 |         --------\n2579 |         re : Standard library module for regular expressions.\n2580 |         str.count : Standard library version, without regular expression support.\n2581 | \n2582 |         Notes\n2583 |         -----\n2584 |         Some characters need to be escaped when passing in `pat`.\n2585 |         eg. ``'$'`` has a special meaning in regex and must be escaped when\n2586 |         finding this literal character.\n2587 | \n2588 |         Examples\n2589 |         --------\n2590 |         >>> s = pd.Series([\"A\", \"B\", \"Aaba\", \"Baca\", np.nan, \"CABA\", \"cat\"])\n2591 |         >>> s.str.count(\"a\")\n2592 |         0    0.0\n2593 |         1    0.0\n2594 |         2    2.0\n2595 |         3    2.0\n2596 |         4    NaN\n2597 |         5    0.0\n2598 |         6    1.0\n2599 |         dtype: float64\n2600 | \n2601 |         Escape ``'$'`` to find the literal dollar sign.\n2602 | \n2603 |         >>> s = pd.Series([\"$\", \"B\", \"Aab$\", \"$$ca\", \"C$B$\", \"cat\"])\n2604 |         >>> s.str.count(\"\\\\$\")\n2605 |         0    1\n2606 |         1    0\n2607 |         2    1\n2608 |         3    2\n2609 |         4    2\n2610 |         5    0\n2611 |         dtype: int64\n2612 | \n2613 |         This is also available on Index\n2614 | \n2615 |         >>> pd.Index([\"A\", \"A\", \"Aaba\", \"cat\"]).str.count(\"a\")\n2616 |         Index([0, 0, 2, 1], dtype='int64')\n2617 |         \"\"\"\n2618 |         result = self._data.array._str_count(pat, flags)\n2619 |         return self._wrap_result(result, returns_string=False)\n2620 | \n2621 |     @forbid_nonstring_types([\"bytes\"])\n2622 |     def startswith(\n2623 |         self, pat: str | tuple[str, ...], na: Scalar | lib.NoDefault = lib.no_default\n2624 |     ) -> Series | Index:\n2625 |         \"\"\"\n2626 |         Test if the start of each string element matches a pattern.\n2627 | \n2628 |         Equivalent to :meth:`str.startswith`.\n2629 | \n2630 |         Parameters\n2631 |         ----------\n2632 |         pat : str or tuple[str, ...]\n2633 |             Character sequence or tuple of strings. Regular expressions are not\n2634 |             accepted.\n2635 |         na : scalar, optional\n2636 |             Object shown if element tested is not a string. The default depends\n2637 |             on dtype of the array. For object-dtype, ``numpy.nan`` is used.\n2638 |             For the nullable ``StringDtype``, ``pandas.NA`` is used.\n2639 |             For the ``\"str\"`` dtype, ``False`` is used.\n2640 | \n2641 |         Returns\n2642 |         -------\n2643 |         Series or Index of bool\n2644 |             A Series of booleans indicating whether the given pattern matches\n2645 |             the start of each string element.\n2646 | \n2647 |         See Also\n2648 |         --------\n2649 |         str.startswith : Python standard library string method.\n2650 |         Series.str.endswith : Same as startswith, but tests the end of string.\n2651 |         Series.str.contains : Tests if string element contains a pattern.\n2652 | \n2653 |         Examples\n2654 |         --------\n2655 |         >>> s = pd.Series([\"bat\", \"Bear\", \"cat\", np.nan])\n2656 |         >>> s\n2657 |         0     bat\n2658 |         1    Bear\n2659 |         2     cat\n2660 |         3     NaN\n2661 |         dtype: object\n2662 | \n2663 |         >>> s.str.startswith(\"b\")\n2664 |         0     True\n2665 |         1    False\n2666 |         2    False\n2667 |         3      NaN\n2668 |         dtype: object\n2669 | \n2670 |         >>> s.str.startswith((\"b\", \"B\"))\n2671 |         0     True\n2672 |         1     True\n2673 |         2    False\n2674 |         3      NaN\n2675 |         dtype: object\n2676 | \n2677 |         Specifying `na` to be `False` instead of `NaN`.\n2678 | \n2679 |         >>> s.str.startswith(\"b\", na=False)\n2680 |         0     True\n2681 |         1    False\n2682 |         2    False\n2683 |         3    False\n2684 |         dtype: bool\n2685 |         \"\"\"\n2686 |         if not isinstance(pat, (str, tuple)):\n2687 |             msg = f\"expected a string or tuple, not {type(pat).__name__}\"\n2688 |             raise TypeError(msg)\n2689 |         result = self._data.array._str_startswith(pat, na=na)\n2690 |         return self._wrap_result(result, returns_string=False)\n2691 | \n2692 |     @forbid_nonstring_types([\"bytes\"])\n2693 |     def endswith(\n2694 |         self, pat: str | tuple[str, ...], na: Scalar | lib.NoDefault = lib.no_default\n2695 |     ) -> Series | Index:\n2696 |         \"\"\"\n2697 |         Test if the end of each string element matches a pattern.\n2698 | \n2699 |         Equivalent to :meth:`str.endswith`.\n2700 | \n2701 |         Parameters\n2702 |         ----------\n2703 |         pat : str or tuple[str, ...]\n2704 |             Character sequence or tuple of strings. Regular expressions are not\n2705 |             accepted.\n2706 |         na : scalar, optional\n2707 |             Object shown if element tested is not a string. The default depends\n2708 |             on dtype of the array. For object-dtype, ``numpy.nan`` is used.\n2709 |             For the nullable ``StringDtype``, ``pandas.NA`` is used.\n2710 |             For the ``\"str\"`` dtype, ``False`` is used.\n2711 | \n2712 |         Returns\n2713 |         -------\n2714 |         Series or Index of bool\n2715 |             A Series of booleans indicating whether the given pattern matches\n2716 |             the end of each string element.\n2717 | \n2718 |         See Also\n2719 |         --------\n2720 |         str.endswith : Python standard library string method.\n2721 |         Series.str.startswith : Same as endswith, but tests the start of string.\n2722 |         Series.str.contains : Tests if string element contains a pattern.\n2723 | \n2724 |         Examples\n2725 |         --------\n2726 |         >>> s = pd.Series([\"bat\", \"bear\", \"caT\", np.nan])\n2727 |         >>> s\n2728 |         0     bat\n2729 |         1    bear\n2730 |         2     caT\n2731 |         3     NaN\n2732 |         dtype: object\n2733 | \n2734 |         >>> s.str.endswith(\"t\")\n2735 |         0     True\n2736 |         1    False\n2737 |         2    False\n2738 |         3      NaN\n2739 |         dtype: object\n2740 | \n2741 |         >>> s.str.endswith((\"t\", \"T\"))\n2742 |         0     True\n2743 |         1    False\n2744 |         2     True\n2745 |         3      NaN\n2746 |         dtype: object\n2747 | \n2748 |         Specifying `na` to be `False` instead of `NaN`.\n2749 | \n2750 |         >>> s.str.endswith(\"t\", na=False)\n2751 |         0     True\n2752 |         1    False\n2753 |         2    False\n2754 |         3    False\n2755 |         dtype: bool\n2756 |         \"\"\"\n2757 |         if not isinstance(pat, (str, tuple)):\n2758 |             msg = f\"expected a string or tuple, not {type(pat).__name__}\"\n2759 |             raise TypeError(msg)\n2760 |         result = self._data.array._str_endswith(pat, na=na)\n2761 |         return self._wrap_result(result, returns_string=False)\n2762 | \n2763 |     @forbid_nonstring_types([\"bytes\"])\n2764 |     def findall(self, pat, flags: int = 0):\n2765 |         \"\"\"\n2766 |         Find all occurrences of pattern or regular expression in the Series/Index.\n2767 | \n2768 |         Equivalent to applying :func:`re.findall` to all the elements in the\n2769 |         Series/Index.\n2770 | \n2771 |         Parameters\n2772 |         ----------\n2773 |         pat : str\n2774 |             Pattern or regular expression.\n2775 |         flags : int, default 0\n2776 |             Flags from ``re`` module, e.g. `re.IGNORECASE` (default is 0, which\n2777 |             means no flags).\n2778 | \n2779 |         Returns\n2780 |         -------\n2781 |         Series/Index of lists of strings\n2782 |             All non-overlapping matches of pattern or regular expression in each\n2783 |             string of this Series/Index.\n2784 | \n2785 |         See Also\n2786 |         --------\n2787 |         count : Count occurrences of pattern or regular expression in each string\n2788 |             of the Series/Index.\n2789 |         extractall : For each string in the Series, extract groups from all matches\n2790 |             of regular expression and return a DataFrame with one row for each\n2791 |             match and one column for each group.\n2792 |         re.findall : The equivalent ``re`` function to all non-overlapping matches\n2793 |             of pattern or regular expression in string, as a list of strings.\n2794 | \n2795 |         Examples\n2796 |         --------\n2797 |         >>> s = pd.Series([\"Lion\", \"Monkey\", \"Rabbit\"])\n2798 | \n2799 |         The search for the pattern 'Monkey' returns one match:\n2800 | \n2801 |         >>> s.str.findall(\"Monkey\")\n2802 |         0          []\n2803 |         1    [Monkey]\n2804 |         2          []\n2805 |         dtype: object\n2806 | \n2807 |         On the other hand, the search for the pattern 'MONKEY' doesn't return any\n2808 |         match:\n2809 | \n2810 |         >>> s.str.findall(\"MONKEY\")\n2811 |         0    []\n2812 |         1    []\n2813 |         2    []\n2814 |         dtype: object\n2815 | \n2816 |         Flags can be added to the pattern or regular expression. For instance,\n2817 |         to find the pattern 'MONKEY' ignoring the case:\n2818 | \n2819 |         >>> import re\n2820 |         >>> s.str.findall(\"MONKEY\", flags=re.IGNORECASE)\n2821 |         0          []\n2822 |         1    [Monkey]\n2823 |         2          []\n2824 |         dtype: object\n2825 | \n2826 |         When the pattern matches more than one string in the Series, all matches\n2827 |         are returned:\n2828 | \n2829 |         >>> s.str.findall(\"on\")\n2830 |         0    [on]\n2831 |         1    [on]\n2832 |         2      []\n2833 |         dtype: object\n2834 | \n2835 |         Regular expressions are supported too. For instance, the search for all the\n2836 |         strings ending with the word 'on' is shown next:\n2837 | \n2838 |         >>> s.str.findall(\"on$\")\n2839 |         0    [on]\n2840 |         1      []\n2841 |         2      []\n2842 |         dtype: object\n2843 | \n2844 |         If the pattern is found more than once in the same string, then a list of\n2845 |         multiple strings is returned:\n2846 | \n2847 |         >>> s.str.findall(\"b\")\n2848 |         0        []\n2849 |         1        []\n2850 |         2    [b, b]\n2851 |         dtype: object\n2852 |         \"\"\"\n2853 |         result = self._data.array._str_findall(pat, flags)\n2854 |         return self._wrap_result(result, returns_string=False)\n2855 | \n2856 |     @forbid_nonstring_types([\"bytes\"])\n2857 |     def extract(\n2858 |         self, pat: str, flags: int = 0, expand: bool = True\n2859 |     ) -> DataFrame | Series | Index:\n2860 |         r\"\"\"\n2861 |         Extract capture groups in the regex `pat` as columns in a DataFrame.\n2862 | \n2863 |         For each subject string in the Series, extract groups from the\n2864 |         first match of regular expression `pat`.\n2865 | \n2866 |         Parameters\n2867 |         ----------\n2868 |         pat : str\n2869 |             Regular expression pattern with capturing groups.\n2870 |         flags : int, default 0 (no flags)\n2871 |             Flags from the ``re`` module, e.g. ``re.IGNORECASE``, that\n2872 |             modify regular expression matching for things like case,\n2873 |             spaces, etc. For more details, see :mod:`re`.\n2874 |         expand : bool, default True\n2875 |             If True, return DataFrame with one column per capture group.\n2876 |             If False, return a Series/Index if there is one capture group\n2877 |             or DataFrame if there are multiple capture groups.\n2878 | \n2879 |         Returns\n2880 |         -------\n2881 |         DataFrame or Series or Index\n2882 |             A DataFrame with one row for each subject string, and one\n2883 |             column for each group. Any capture group names in regular\n2884 |             expression pat will be used for column names; otherwise\n2885 |             capture group numbers will be used. The dtype of each result\n2886 |             column is always object, even when no match is found. If\n2887 |             ``expand=False`` and pat has only one capture group, then\n2888 |             return a Series (if subject is a Series) or Index (if subject\n2889 |             is an Index).\n2890 | \n2891 |         See Also\n2892 |         --------\n2893 |         extractall : Returns all matches (not just the first match).\n2894 | \n2895 |         Examples\n2896 |         --------\n2897 |         A pattern with two groups will return a DataFrame with two columns.\n2898 |         Non-matches will be NaN.\n2899 | \n2900 |         >>> s = pd.Series([\"a1\", \"b2\", \"c3\"])\n2901 |         >>> s.str.extract(r\"([ab])(\\d)\")\n2902 |             0    1\n2903 |         0    a    1\n2904 |         1    b    2\n2905 |         2  NaN  NaN\n2906 | \n2907 |         A pattern may contain optional groups.\n2908 | \n2909 |         >>> s.str.extract(r\"([ab])?(\\d)\")\n2910 |             0  1\n2911 |         0    a  1\n2912 |         1    b  2\n2913 |         2  NaN  3\n2914 | \n2915 |         Named groups will become column names in the result.\n2916 | \n2917 |         >>> s.str.extract(r\"(?P<letter>[ab])(?P<digit>\\d)\")\n2918 |         letter digit\n2919 |         0      a     1\n2920 |         1      b     2\n2921 |         2    NaN   NaN\n2922 | \n2923 |         A pattern with one group will return a DataFrame with one column\n2924 |         if expand=True.\n2925 | \n2926 |         >>> s.str.extract(r\"[ab](\\d)\", expand=True)\n2927 |             0\n2928 |         0    1\n2929 |         1    2\n2930 |         2  NaN\n2931 | \n2932 |         A pattern with one group will return a Series if expand=False.\n2933 | \n2934 |         >>> s.str.extract(r\"[ab](\\d)\", expand=False)\n2935 |         0      1\n2936 |         1      2\n2937 |         2    NaN\n2938 |         dtype: object\n2939 |         \"\"\"\n2940 |         from pandas import DataFrame\n2941 | \n2942 |         if not isinstance(expand, bool):\n2943 |             raise ValueError(\"expand must be True or False\")\n2944 | \n2945 |         regex = re.compile(pat, flags=flags)\n2946 |         if regex.groups == 0:\n2947 |             raise ValueError(\"pattern contains no capture groups\")\n2948 | \n2949 |         if not expand and regex.groups > 1 and isinstance(self._data, ABCIndex):\n2950 |             raise ValueError(\"only one regex group is supported with Index\")\n2951 | \n2952 |         obj = self._data\n2953 |         result_dtype = _result_dtype(obj)\n2954 | \n2955 |         returns_df = regex.groups > 1 or expand\n2956 | \n2957 |         if returns_df:\n2958 |             name = None\n2959 |             columns = _get_group_names(regex)\n2960 | \n2961 |             if obj.array.size == 0:\n2962 |                 result = DataFrame(columns=columns, dtype=result_dtype)\n2963 | \n2964 |             else:\n2965 |                 result_list = self._data.array._str_extract(\n2966 |                     pat, flags=flags, expand=returns_df\n2967 |                 )\n2968 | \n2969 |                 result_index: Index | None\n2970 |                 if isinstance(obj, ABCSeries):\n2971 |                     result_index = obj.index\n2972 |                 else:\n2973 |                     result_index = None\n2974 | \n2975 |                 result = DataFrame(\n2976 |                     result_list, columns=columns, index=result_index, dtype=result_dtype\n2977 |                 )\n2978 | \n2979 |         else:\n2980 |             name = _get_single_group_name(regex)\n2981 |             result = self._data.array._str_extract(pat, flags=flags, expand=returns_df)\n2982 |         return self._wrap_result(result, name=name, dtype=result_dtype)\n2983 | \n2984 |     @forbid_nonstring_types([\"bytes\"])\n2985 |     def extractall(self, pat, flags: int = 0) -> DataFrame:\n2986 |         r\"\"\"\n2987 |         Extract capture groups in the regex `pat` as columns in DataFrame.\n2988 | \n2989 |         For each subject string in the Series, extract groups from all\n2990 |         matches of regular expression pat. When each subject string in the\n2991 |         Series has exactly one match, extractall(pat).xs(0, level='match')\n2992 |         is the same as extract(pat).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         pat : str\n2997 |             Regular expression pattern with capturing groups.\n2998 |         flags : int, default 0 (no flags)\n2999 |             A ``re`` module flag, for example ``re.IGNORECASE``. These allow\n3000 |             to modify regular expression matching for things like case, spaces,\n3001 |             etc. Multiple flags can be combined with the bitwise OR operator,\n3002 |             for example ``re.IGNORECASE | re.MULTILINE``.\n3003 | \n3004 |         Returns\n3005 |         -------\n3006 |         DataFrame\n3007 |             A ``DataFrame`` with one row for each match, and one column for each\n3008 |             group. Its rows have a ``MultiIndex`` with first levels that come from\n3009 |             the subject ``Series``. The last level is named 'match' and indexes the\n3010 |             matches in each item of the ``Series``. Any capture group names in\n3011 |             regular expression pat will be used for column names; otherwise capture\n3012 |             group numbers will be used.\n3013 | \n3014 |         See Also\n3015 |         --------\n3016 |         extract : Returns first match only (not all matches).\n3017 | \n3018 |         Examples\n3019 |         --------\n3020 |         A pattern with one group will return a DataFrame with one column.\n3021 |         Indices with no matches will not appear in the result.\n3022 | \n3023 |         >>> s = pd.Series([\"a1a2\", \"b1\", \"c1\"], index=[\"A\", \"B\", \"C\"])\n3024 |         >>> s.str.extractall(r\"[ab](\\d)\")\n3025 |                 0\n3026 |         match\n3027 |         A 0      1\n3028 |           1      2\n3029 |         B 0      1\n3030 | \n3031 |         Capture group names are used for column names of the result.\n3032 | \n3033 |         >>> s.str.extractall(r\"[ab](?P<digit>\\d)\")\n3034 |                 digit\n3035 |         match\n3036 |         A 0         1\n3037 |           1         2\n3038 |         B 0         1\n3039 | \n3040 |         A pattern with two groups will return a DataFrame with two columns.\n3041 | \n3042 |         >>> s.str.extractall(r\"(?P<letter>[ab])(?P<digit>\\d)\")\n3043 |                 letter digit\n3044 |         match\n3045 |         A 0          a     1\n3046 |           1          a     2\n3047 |         B 0          b     1\n3048 | \n3049 |         Optional groups that do not match are NaN in the result.\n3050 | \n3051 |         >>> s.str.extractall(r\"(?P<letter>[ab])?(?P<digit>\\d)\")\n3052 |                 letter digit\n3053 |         match\n3054 |         A 0          a     1\n3055 |           1          a     2\n3056 |         B 0          b     1\n3057 |         C 0        NaN     1\n3058 |         \"\"\"\n3059 |         # TODO: dispatch\n3060 |         return str_extractall(self._orig, pat, flags)\n3061 | \n3062 |     _shared_docs[\"find\"] = \"\"\"\n3063 |     Return %(side)s indexes in each strings in the Series/Index.\n3064 | \n3065 |     Each of returned indexes corresponds to the position where the\n3066 |     substring is fully contained between [start:end]. Return -1 on\n3067 |     failure. Equivalent to standard :meth:`str.%(method)s`.\n3068 | \n3069 |     Parameters\n3070 |     ----------\n3071 |     sub : str\n3072 |         Substring being searched.\n3073 |     start : int\n3074 |         Left edge index.\n3075 |     end : int\n3076 |         Right edge index.\n3077 | \n3078 |     Returns\n3079 |     -------\n3080 |     Series or Index of int.\n3081 |         A Series (if the input is a Series) or an Index (if the input is an\n3082 |         Index) of the %(side)s indexes corresponding to the positions where the\n3083 |         substring is found in each string of the input.\n3084 | \n3085 |     See Also\n3086 |     --------\n3087 |     %(also)s\n3088 | \n3089 |     Examples\n3090 |     --------\n3091 |     For Series.str.find:\n3092 | \n3093 |     >>> ser = pd.Series([\"_cow_\", \"duck_\", \"do_v_e\"])\n3094 |     >>> ser.str.find(\"_\")\n3095 |     0   0\n3096 |     1   4\n3097 |     2   2\n3098 |     dtype: int64\n3099 | \n3100 |     For Series.str.rfind:\n3101 | \n3102 |     >>> ser = pd.Series([\"_cow_\", \"duck_\", \"do_v_e\"])\n3103 |     >>> ser.str.rfind(\"_\")\n3104 |     0   4\n3105 |     1   4\n3106 |     2   4\n3107 |     dtype: int64\n3108 |     \"\"\"\n3109 | \n3110 |     @Appender(\n3111 |         _shared_docs[\"find\"]\n3112 |         % {\n3113 |             \"side\": \"lowest\",\n3114 |             \"method\": \"find\",\n3115 |             \"also\": \"rfind : Return highest indexes in each strings.\",\n3116 |         }\n3117 |     )\n3118 |     @forbid_nonstring_types([\"bytes\"])\n3119 |     def find(self, sub, start: int = 0, end=None):\n3120 |         if not isinstance(sub, str):\n3121 |             msg = f\"expected a string object, not {type(sub).__name__}\"\n3122 |             raise TypeError(msg)\n3123 | \n3124 |         result = self._data.array._str_find(sub, start, end)\n3125 |         return self._wrap_result(result, returns_string=False)\n3126 | \n3127 |     @Appender(\n3128 |         _shared_docs[\"find\"]\n3129 |         % {\n3130 |             \"side\": \"highest\",\n3131 |             \"method\": \"rfind\",\n3132 |             \"also\": \"find : Return lowest indexes in each strings.\",\n3133 |         }\n3134 |     )\n3135 |     @forbid_nonstring_types([\"bytes\"])\n3136 |     def rfind(self, sub, start: int = 0, end=None):\n3137 |         if not isinstance(sub, str):\n3138 |             msg = f\"expected a string object, not {type(sub).__name__}\"\n3139 |             raise TypeError(msg)\n3140 | \n3141 |         result = self._data.array._str_rfind(sub, start=start, end=end)\n3142 |         return self._wrap_result(result, returns_string=False)\n3143 | \n3144 |     @forbid_nonstring_types([\"bytes\"])\n3145 |     def normalize(self, form):\n3146 |         \"\"\"\n3147 |         Return the Unicode normal form for the strings in the Series/Index.\n3148 | \n3149 |         For more information on the forms, see the\n3150 |         :func:`unicodedata.normalize`.\n3151 | \n3152 |         Parameters\n3153 |         ----------\n3154 |         form : {'NFC', 'NFKC', 'NFD', 'NFKD'}\n3155 |             Unicode form.\n3156 | \n3157 |         Returns\n3158 |         -------\n3159 |         Series/Index of objects\n3160 |             A Series or Index of strings in the same Unicode form specified by `form`.\n3161 |             The returned object retains the same type as the input (Series or Index),\n3162 |             and contains the normalized strings.\n3163 | \n3164 |         See Also\n3165 |         --------\n3166 |         Series.str.upper : Convert all characters in each string to uppercase.\n3167 |         Series.str.lower : Convert all characters in each string to lowercase.\n3168 |         Series.str.title : Convert each string to title case (capitalizing the\n3169 |             first letter of each word).\n3170 |         Series.str.strip : Remove leading and trailing whitespace from each string.\n3171 |         Series.str.replace : Replace occurrences of a substring with another substring\n3172 |             in each string.\n3173 | \n3174 |         Examples\n3175 |         --------\n3176 |         >>> ser = pd.Series([\"\u00f1\"])\n3177 |         >>> ser.str.normalize(\"NFC\") == ser.str.normalize(\"NFD\")\n3178 |         0   False\n3179 |         dtype: bool\n3180 |         \"\"\"\n3181 |         result = self._data.array._str_normalize(form)\n3182 |         return self._wrap_result(result)\n3183 | \n3184 |     _shared_docs[\"index\"] = \"\"\"\n3185 |     Return %(side)s indexes in each string in Series/Index.\n3186 | \n3187 |     Each of the returned indexes corresponds to the position where the\n3188 |     substring is fully contained between [start:end]. This is the same\n3189 |     as ``str.%(similar)s`` except instead of returning -1, it raises a\n3190 |     ValueError when the substring is not found. Equivalent to standard\n3191 |     ``str.%(method)s``.\n3192 | \n3193 |     Parameters\n3194 |     ----------\n3195 |     sub : str\n3196 |         Substring being searched.\n3197 |     start : int\n3198 |         Left edge index.\n3199 |     end : int\n3200 |         Right edge index.\n3201 | \n3202 |     Returns\n3203 |     -------\n3204 |     Series or Index of object\n3205 |         Returns a Series or an Index of the %(side)s indexes\n3206 |         in each string of the input.\n3207 | \n3208 |     See Also\n3209 |     --------\n3210 |     %(also)s\n3211 | \n3212 |     Examples\n3213 |     --------\n3214 |     For Series.str.index:\n3215 | \n3216 |     >>> ser = pd.Series([\"horse\", \"eagle\", \"donkey\"])\n3217 |     >>> ser.str.index(\"e\")\n3218 |     0   4\n3219 |     1   0\n3220 |     2   4\n3221 |     dtype: int64\n3222 | \n3223 |     For Series.str.rindex:\n3224 | \n3225 |     >>> ser = pd.Series([\"Deer\", \"eagle\", \"Sheep\"])\n3226 |     >>> ser.str.rindex(\"e\")\n3227 |     0   2\n3228 |     1   4\n3229 |     2   3\n3230 |     dtype: int64\n3231 |     \"\"\"\n3232 | \n3233 |     @Appender(\n3234 |         _shared_docs[\"index\"]\n3235 |         % {\n3236 |             \"side\": \"lowest\",\n3237 |             \"similar\": \"find\",\n3238 |             \"method\": \"index\",\n3239 |             \"also\": \"rindex : Return highest indexes in each strings.\",\n3240 |         }\n3241 |     )\n3242 |     @forbid_nonstring_types([\"bytes\"])\n3243 |     def index(self, sub, start: int = 0, end=None):\n3244 |         if not isinstance(sub, str):\n3245 |             msg = f\"expected a string object, not {type(sub).__name__}\"\n3246 |             raise TypeError(msg)\n3247 | \n3248 |         result = self._data.array._str_index(sub, start=start, end=end)\n3249 |         return self._wrap_result(result, returns_string=False)\n3250 | \n3251 |     @Appender(\n3252 |         _shared_docs[\"index\"]\n3253 |         % {\n3254 |             \"side\": \"highest\",\n3255 |             \"similar\": \"rfind\",\n3256 |             \"method\": \"rindex\",\n3257 |             \"also\": \"index : Return lowest indexes in each strings.\",\n3258 |         }\n3259 |     )\n3260 |     @forbid_nonstring_types([\"bytes\"])\n3261 |     def rindex(self, sub, start: int = 0, end=None):\n3262 |         if not isinstance(sub, str):\n3263 |             msg = f\"expected a string object, not {type(sub).__name__}\"\n3264 |             raise TypeError(msg)\n3265 | \n3266 |         result = self._data.array._str_rindex(sub, start=start, end=end)\n3267 |         return self._wrap_result(result, returns_string=False)\n3268 | \n3269 |     def len(self):\n3270 |         \"\"\"\n3271 |         Compute the length of each element in the Series/Index.\n3272 | \n3273 |         The element may be a sequence (such as a string, tuple or list) or a collection\n3274 |         (such as a dictionary).\n3275 | \n3276 |         Returns\n3277 |         -------\n3278 |         Series or Index of int\n3279 |             A Series or Index of integer values indicating the length of each\n3280 |             element in the Series or Index.\n3281 | \n3282 |         See Also\n3283 |         --------\n3284 |         str.len : Python built-in function returning the length of an object.\n3285 |         Series.size : Returns the length of the Series.\n3286 | \n3287 |         Examples\n3288 |         --------\n3289 |         Returns the length (number of characters) in a string. Returns the\n3290 |         number of entries for dictionaries, lists or tuples.\n3291 | \n3292 |         >>> s = pd.Series(\n3293 |         ...     [\"dog\", \"\", 5, {\"foo\": \"bar\"}, [2, 3, 5, 7], (\"one\", \"two\", \"three\")]\n3294 |         ... )\n3295 |         >>> s\n3296 |         0                  dog\n3297 |         1\n3298 |         2                    5\n3299 |         3       {'foo': 'bar'}\n3300 |         4         [2, 3, 5, 7]\n3301 |         5    (one, two, three)\n3302 |         dtype: object\n3303 |         >>> s.str.len()\n3304 |         0    3.0\n3305 |         1    0.0\n3306 |         2    NaN\n3307 |         3    1.0\n3308 |         4    4.0\n3309 |         5    3.0\n3310 |         dtype: float64\n3311 |         \"\"\"\n3312 |         result = self._data.array._str_len()\n3313 |         return self._wrap_result(result, returns_string=False)\n3314 | \n3315 |     _shared_docs[\"casemethods\"] = \"\"\"\n3316 |     Convert strings in the Series/Index to %(type)s.\n3317 |     %(version)s\n3318 |     Equivalent to :meth:`str.%(method)s`.\n3319 | \n3320 |     Returns\n3321 |     -------\n3322 |     Series or Index of objects\n3323 |         A Series or Index where the strings are modified by :meth:`str.%(method)s`.\n3324 | \n3325 |     See Also\n3326 |     --------\n3327 |     Series.str.lower : Converts all characters to lowercase.\n3328 |     Series.str.upper : Converts all characters to uppercase.\n3329 |     Series.str.title : Converts first character of each word to uppercase and\n3330 |         remaining to lowercase.\n3331 |     Series.str.capitalize : Converts first character to uppercase and\n3332 |         remaining to lowercase.\n3333 |     Series.str.swapcase : Converts uppercase to lowercase and lowercase to\n3334 |         uppercase.\n3335 |     Series.str.casefold: Removes all case distinctions in the string.\n3336 | \n3337 |     Examples\n3338 |     --------\n3339 |     >>> s = pd.Series(['lower', 'CAPITALS', 'this is a sentence', 'SwApCaSe'])\n3340 |     >>> s\n3341 |     0                 lower\n3342 |     1              CAPITALS\n3343 |     2    this is a sentence\n3344 |     3              SwApCaSe\n3345 |     dtype: object\n3346 | \n3347 |     >>> s.str.lower()\n3348 |     0                 lower\n3349 |     1              capitals\n3350 |     2    this is a sentence\n3351 |     3              swapcase\n3352 |     dtype: object\n3353 | \n3354 |     >>> s.str.upper()\n3355 |     0                 LOWER\n3356 |     1              CAPITALS\n3357 |     2    THIS IS A SENTENCE\n3358 |     3              SWAPCASE\n3359 |     dtype: object\n3360 | \n3361 |     >>> s.str.title()\n3362 |     0                 Lower\n3363 |     1              Capitals\n3364 |     2    This Is A Sentence\n3365 |     3              Swapcase\n3366 |     dtype: object\n3367 | \n3368 |     >>> s.str.capitalize()\n3369 |     0                 Lower\n3370 |     1              Capitals\n3371 |     2    This is a sentence\n3372 |     3              Swapcase\n3373 |     dtype: object\n3374 | \n3375 |     >>> s.str.swapcase()\n3376 |     0                 LOWER\n3377 |     1              capitals\n3378 |     2    THIS IS A SENTENCE\n3379 |     3              sWaPcAsE\n3380 |     dtype: object\n3381 |     \"\"\"\n3382 |     # Types:\n3383 |     #   cases:\n3384 |     #       upper, lower, title, capitalize, swapcase, casefold\n3385 |     #   boolean:\n3386 |     #     isalpha, isnumeric isalnum isdigit isdecimal isspace islower isupper istitle\n3387 |     # _doc_args holds dict of strings to use in substituting casemethod docs\n3388 |     _doc_args: dict[str, dict[str, str]] = {}\n3389 |     _doc_args[\"lower\"] = {\"type\": \"lowercase\", \"method\": \"lower\", \"version\": \"\"}\n3390 |     _doc_args[\"upper\"] = {\"type\": \"uppercase\", \"method\": \"upper\", \"version\": \"\"}\n3391 |     _doc_args[\"title\"] = {\"type\": \"titlecase\", \"method\": \"title\", \"version\": \"\"}\n3392 |     _doc_args[\"capitalize\"] = {\n3393 |         \"type\": \"be capitalized\",\n3394 |         \"method\": \"capitalize\",\n3395 |         \"version\": \"\",\n3396 |     }\n3397 |     _doc_args[\"swapcase\"] = {\n3398 |         \"type\": \"be swapcased\",\n3399 |         \"method\": \"swapcase\",\n3400 |         \"version\": \"\",\n3401 |     }\n3402 |     _doc_args[\"casefold\"] = {\n3403 |         \"type\": \"be casefolded\",\n3404 |         \"method\": \"casefold\",\n3405 |         \"version\": \"\",\n3406 |     }\n3407 | \n3408 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"lower\"])\n3409 |     @forbid_nonstring_types([\"bytes\"])\n3410 |     def lower(self):\n3411 |         result = self._data.array._str_lower()\n3412 |         return self._wrap_result(result)\n3413 | \n3414 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"upper\"])\n3415 |     @forbid_nonstring_types([\"bytes\"])\n3416 |     def upper(self):\n3417 |         result = self._data.array._str_upper()\n3418 |         return self._wrap_result(result)\n3419 | \n3420 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"title\"])\n3421 |     @forbid_nonstring_types([\"bytes\"])\n3422 |     def title(self):\n3423 |         result = self._data.array._str_title()\n3424 |         return self._wrap_result(result)\n3425 | \n3426 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"capitalize\"])\n3427 |     @forbid_nonstring_types([\"bytes\"])\n3428 |     def capitalize(self):\n3429 |         result = self._data.array._str_capitalize()\n3430 |         return self._wrap_result(result)\n3431 | \n3432 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"swapcase\"])\n3433 |     @forbid_nonstring_types([\"bytes\"])\n3434 |     def swapcase(self):\n3435 |         result = self._data.array._str_swapcase()\n3436 |         return self._wrap_result(result)\n3437 | \n3438 |     @Appender(_shared_docs[\"casemethods\"] % _doc_args[\"casefold\"])\n3439 |     @forbid_nonstring_types([\"bytes\"])\n3440 |     def casefold(self):\n3441 |         result = self._data.array._str_casefold()\n3442 |         return self._wrap_result(result)\n3443 | \n3444 |     _shared_docs[\"ismethods\"] = \"\"\"\n3445 |     Check whether all characters in each string are %(type)s.\n3446 | \n3447 |     This is equivalent to running the Python string method\n3448 |     :meth:`str.%(method)s` for each element of the Series/Index. If a string\n3449 |     has zero characters, ``False`` is returned for that check.\n3450 | \n3451 |     Returns\n3452 |     -------\n3453 |     Series or Index of bool\n3454 |         Series or Index of boolean values with the same length as the original\n3455 |         Series/Index.\n3456 |     \"\"\"\n3457 |     _shared_docs[\"isalpha\"] = \"\"\"\n3458 |     See Also\n3459 |     --------\n3460 |     Series.str.isnumeric : Check whether all characters are numeric.\n3461 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3462 |     Series.str.isdigit : Check whether all characters are digits.\n3463 |     Series.str.isdecimal : Check whether all characters are decimal.\n3464 |     Series.str.isspace : Check whether all characters are whitespace.\n3465 |     Series.str.islower : Check whether all characters are lowercase.\n3466 |     Series.str.isupper : Check whether all characters are uppercase.\n3467 |     Series.str.istitle : Check whether all characters are titlecase.\n3468 | \n3469 |     Examples\n3470 |     --------\n3471 | \n3472 |     >>> s1 = pd.Series(['one', 'one1', '1', ''])\n3473 |     >>> s1.str.isalpha()\n3474 |     0     True\n3475 |     1    False\n3476 |     2    False\n3477 |     3    False\n3478 |     dtype: bool\n3479 |     \"\"\"\n3480 |     _shared_docs[\"isnumeric\"] = \"\"\"\n3481 |     See Also\n3482 |     --------\n3483 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3484 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3485 |     Series.str.isdigit : Check whether all characters are digits.\n3486 |     Series.str.isdecimal : Check whether all characters are decimal.\n3487 |     Series.str.isspace : Check whether all characters are whitespace.\n3488 |     Series.str.islower : Check whether all characters are lowercase.\n3489 |     Series.str.isupper : Check whether all characters are uppercase.\n3490 |     Series.str.istitle : Check whether all characters are titlecase.\n3491 | \n3492 |     Examples\n3493 |     --------\n3494 |     The ``s.str.isnumeric`` method is the same as ``s3.str.isdigit`` but\n3495 |     also includes other characters that can represent quantities such as\n3496 |     unicode fractions.\n3497 | \n3498 |     >>> s1 = pd.Series(['one', 'one1', '1', ''])\n3499 |     >>> s1.str.isnumeric()\n3500 |     0    False\n3501 |     1    False\n3502 |     2     True\n3503 |     3    False\n3504 |     dtype: bool\n3505 |     \"\"\"\n3506 |     _shared_docs[\"isalnum\"] = \"\"\"\n3507 |     See Also\n3508 |     --------\n3509 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3510 |     Series.str.isnumeric : Check whether all characters are numeric.\n3511 |     Series.str.isdigit : Check whether all characters are digits.\n3512 |     Series.str.isdecimal : Check whether all characters are decimal.\n3513 |     Series.str.isspace : Check whether all characters are whitespace.\n3514 |     Series.str.islower : Check whether all characters are lowercase.\n3515 |     Series.str.isupper : Check whether all characters are uppercase.\n3516 |     Series.str.istitle : Check whether all characters are titlecase.\n3517 | \n3518 |     Examples\n3519 |     --------\n3520 |     >>> s1 = pd.Series(['one', 'one1', '1', ''])\n3521 |     >>> s1.str.isalnum()\n3522 |     0     True\n3523 |     1     True\n3524 |     2     True\n3525 |     3    False\n3526 |     dtype: bool\n3527 | \n3528 |     Note that checks against characters mixed with any additional punctuation\n3529 |     or whitespace will evaluate to false for an alphanumeric check.\n3530 | \n3531 |     >>> s2 = pd.Series(['A B', '1.5', '3,000'])\n3532 |     >>> s2.str.isalnum()\n3533 |     0    False\n3534 |     1    False\n3535 |     2    False\n3536 |     dtype: bool\n3537 |     \"\"\"\n3538 |     _shared_docs[\"isdecimal\"] = \"\"\"\n3539 |     See Also\n3540 |     --------\n3541 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3542 |     Series.str.isnumeric : Check whether all characters are numeric.\n3543 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3544 |     Series.str.isdigit : Check whether all characters are digits.\n3545 |     Series.str.isspace : Check whether all characters are whitespace.\n3546 |     Series.str.islower : Check whether all characters are lowercase.\n3547 |     Series.str.isupper : Check whether all characters are uppercase.\n3548 |     Series.str.istitle : Check whether all characters are titlecase.\n3549 | \n3550 |     Examples\n3551 |     --------\n3552 |     The ``s3.str.isdecimal`` method checks for characters used to form\n3553 |     numbers in base 10.\n3554 | \n3555 |     >>> s3 = pd.Series(['23', '\u00b3', '\u2155', ''])\n3556 |     >>> s3.str.isdecimal()\n3557 |     0     True\n3558 |     1    False\n3559 |     2    False\n3560 |     3    False\n3561 |     dtype: bool\n3562 |     \"\"\"\n3563 |     _shared_docs[\"isdigit\"] = \"\"\"\n3564 |     See Also\n3565 |     --------\n3566 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3567 |     Series.str.isnumeric : Check whether all characters are numeric.\n3568 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3569 |     Series.str.isdecimal : Check whether all characters are decimal.\n3570 |     Series.str.isspace : Check whether all characters are whitespace.\n3571 |     Series.str.islower : Check whether all characters are lowercase.\n3572 |     Series.str.isupper : Check whether all characters are uppercase.\n3573 |     Series.str.istitle : Check whether all characters are titlecase.\n3574 | \n3575 |     Examples\n3576 |     --------\n3577 |     Similar to ``str.isdecimal`` but also includes special digits, like\n3578 |     superscripted and subscripted digits in unicode.\n3579 | \n3580 |     >>> s3 = pd.Series(['23', '\u00b3', '\u2155', ''])\n3581 |     >>> s3.str.isdigit()\n3582 |     0     True\n3583 |     1     True\n3584 |     2    False\n3585 |     3    False\n3586 |     dtype: bool\n3587 |     \"\"\"\n3588 | \n3589 |     _shared_docs[\"isspace\"] = \"\"\"\n3590 |     See Also\n3591 |     --------\n3592 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3593 |     Series.str.isnumeric : Check whether all characters are numeric.\n3594 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3595 |     Series.str.isdigit : Check whether all characters are digits.\n3596 |     Series.str.isdecimal : Check whether all characters are decimal.\n3597 |     Series.str.islower : Check whether all characters are lowercase.\n3598 |     Series.str.isupper : Check whether all characters are uppercase.\n3599 |     Series.str.istitle : Check whether all characters are titlecase.\n3600 | \n3601 |     Examples\n3602 |     --------\n3603 | \n3604 |     >>> s4 = pd.Series([' ', '\\\\t\\\\r\\\\n ', ''])\n3605 |     >>> s4.str.isspace()\n3606 |     0     True\n3607 |     1     True\n3608 |     2    False\n3609 |     dtype: bool\n3610 |     \"\"\"\n3611 |     _shared_docs[\"islower\"] = \"\"\"\n3612 |     See Also\n3613 |     --------\n3614 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3615 |     Series.str.isnumeric : Check whether all characters are numeric.\n3616 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3617 |     Series.str.isdigit : Check whether all characters are digits.\n3618 |     Series.str.isdecimal : Check whether all characters are decimal.\n3619 |     Series.str.isspace : Check whether all characters are whitespace.\n3620 |     Series.str.isupper : Check whether all characters are uppercase.\n3621 |     Series.str.istitle : Check whether all characters are titlecase.\n3622 | \n3623 |     Examples\n3624 |     --------\n3625 | \n3626 |     >>> s5 = pd.Series(['leopard', 'Golden Eagle', 'SNAKE', ''])\n3627 |     >>> s5.str.islower()\n3628 |     0     True\n3629 |     1    False\n3630 |     2    False\n3631 |     3    False\n3632 |     dtype: bool\n3633 |     \"\"\"\n3634 | \n3635 |     _shared_docs[\"isupper\"] = \"\"\"\n3636 |     See Also\n3637 |     --------\n3638 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3639 |     Series.str.isnumeric : Check whether all characters are numeric.\n3640 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3641 |     Series.str.isdigit : Check whether all characters are digits.\n3642 |     Series.str.isdecimal : Check whether all characters are decimal.\n3643 |     Series.str.isspace : Check whether all characters are whitespace.\n3644 |     Series.str.islower : Check whether all characters are lowercase.\n3645 |     Series.str.istitle : Check whether all characters are titlecase.\n3646 | \n3647 |     Examples\n3648 |     --------\n3649 | \n3650 |     >>> s5 = pd.Series(['leopard', 'Golden Eagle', 'SNAKE', ''])\n3651 |     >>> s5.str.isupper()\n3652 |     0    False\n3653 |     1    False\n3654 |     2     True\n3655 |     3    False\n3656 |     dtype: bool\n3657 |     \"\"\"\n3658 |     _shared_docs[\"istitle\"] = \"\"\"\n3659 |     See Also\n3660 |     --------\n3661 |     Series.str.isalpha : Check whether all characters are alphabetic.\n3662 |     Series.str.isnumeric : Check whether all characters are numeric.\n3663 |     Series.str.isalnum : Check whether all characters are alphanumeric.\n3664 |     Series.str.isdigit : Check whether all characters are digits.\n3665 |     Series.str.isdecimal : Check whether all characters are decimal.\n3666 |     Series.str.isspace : Check whether all characters are whitespace.\n3667 |     Series.str.islower : Check whether all characters are lowercase.\n3668 |     Series.str.isupper : Check whether all characters are uppercase.\n3669 | \n3670 |     Examples\n3671 |     ------------\n3672 |     The ``s5.str.istitle`` method checks for whether all words are in title\n3673 |     case (whether only the first letter of each word is capitalized). Words are\n3674 |     assumed to be as any sequence of non-numeric characters separated by\n3675 |     whitespace characters.\n3676 | \n3677 |     >>> s5 = pd.Series(['leopard', 'Golden Eagle', 'SNAKE', ''])\n3678 |     >>> s5.str.istitle()\n3679 |     0    False\n3680 |     1     True\n3681 |     2    False\n3682 |     3    False\n3683 |     dtype: bool\n3684 |     \"\"\"\n3685 |     _doc_args[\"isalnum\"] = {\"type\": \"alphanumeric\", \"method\": \"isalnum\"}\n3686 |     _doc_args[\"isalpha\"] = {\"type\": \"alphabetic\", \"method\": \"isalpha\"}\n3687 |     _doc_args[\"isdigit\"] = {\"type\": \"digits\", \"method\": \"isdigit\"}\n3688 |     _doc_args[\"isspace\"] = {\"type\": \"whitespace\", \"method\": \"isspace\"}\n3689 |     _doc_args[\"islower\"] = {\"type\": \"lowercase\", \"method\": \"islower\"}\n3690 |     _doc_args[\"isupper\"] = {\"type\": \"uppercase\", \"method\": \"isupper\"}\n3691 |     _doc_args[\"istitle\"] = {\"type\": \"titlecase\", \"method\": \"istitle\"}\n3692 |     _doc_args[\"isnumeric\"] = {\"type\": \"numeric\", \"method\": \"isnumeric\"}\n3693 |     _doc_args[\"isdecimal\"] = {\"type\": \"decimal\", \"method\": \"isdecimal\"}\n3694 |     # force _noarg_wrapper return type with dtype=np.dtype(bool) (GH 29624)\n3695 | \n3696 |     isalnum = _map_and_wrap(\n3697 |         \"isalnum\",\n3698 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isalnum\"]\n3699 |         + _shared_docs[\"isalnum\"],\n3700 |     )\n3701 |     isalpha = _map_and_wrap(\n3702 |         \"isalpha\",\n3703 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isalpha\"]\n3704 |         + _shared_docs[\"isalpha\"],\n3705 |     )\n3706 |     isdigit = _map_and_wrap(\n3707 |         \"isdigit\",\n3708 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isdigit\"]\n3709 |         + _shared_docs[\"isdigit\"],\n3710 |     )\n3711 |     isspace = _map_and_wrap(\n3712 |         \"isspace\",\n3713 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isspace\"]\n3714 |         + _shared_docs[\"isspace\"],\n3715 |     )\n3716 |     islower = _map_and_wrap(\n3717 |         \"islower\",\n3718 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"islower\"]\n3719 |         + _shared_docs[\"islower\"],\n3720 |     )\n3721 |     isupper = _map_and_wrap(\n3722 |         \"isupper\",\n3723 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isupper\"]\n3724 |         + _shared_docs[\"isupper\"],\n3725 |     )\n3726 |     istitle = _map_and_wrap(\n3727 |         \"istitle\",\n3728 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"istitle\"]\n3729 |         + _shared_docs[\"istitle\"],\n3730 |     )\n3731 |     isnumeric = _map_and_wrap(\n3732 |         \"isnumeric\",\n3733 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isnumeric\"]\n3734 |         + _shared_docs[\"isnumeric\"],\n3735 |     )\n3736 |     isdecimal = _map_and_wrap(\n3737 |         \"isdecimal\",\n3738 |         docstring=_shared_docs[\"ismethods\"] % _doc_args[\"isdecimal\"]\n3739 |         + _shared_docs[\"isdecimal\"],\n3740 |     )\n```\n"}, {"content": "The `_validate` method in the `StringMethods` class contains the error message we are looking for. Specifically, the line:\n\n```python\nraise AttributeError(\"Can only use .str accessor with string values!\")\n```\n\nThis method is responsible for inferring and checking the dtype of the data. It raises the error when the inferred dtype is not one of the allowed string types.\n\nLet's locate this method and provide the file path, class name, function name, and line number for the modification.\n\n```\npandas/core/strings/accessor.py\nclass: StringMethods\nfunction: _validate\nline: 258\n```\n\n<finish></finish>", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "get_trace_artifacts", "description": "\nRead a compact raw slice of DaLIC execution-trace artifacts for the current instance.\nThis tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\nIt does not rank or recommend results. It only applies exact filters and pagination.\n\nNote:\n'<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n- executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n- tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n- then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n\nArgs:\n- `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`. \n    If not specified, it defaults to `all` and does not filter by artifact type.\n- `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`. \n    If not specified, it defaults to `None` and does not filter by file path.\n- `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`. \n    If not specified, it defaults to `None` and does not filter by qualified name.\n- `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n- `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n\nReturns:\nA JSON string encoding an object with the following top-level fields:\n- `instance_id`: The current DaLIC instance id.\n- `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n- `applied_filters`: The effective filter and pagination values used for this call.\n- `artifacts`: A JSON array of matched artifacts.\n- `has_more`: Whether more matched artifacts are available after this slice.\n- `next_start`: The pagination offset to use for the next slice.\n\nEach artifact in `artifacts` is a JSON object with the following fields:\n- `qualified_name`: The qualified name of the artifact.\n- `path`: The compact file path where the artifact is defined.\n- `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n- `defined_line`: The line number where the artifact is defined.\n- `end_line`: The ending line number of the artifact, if available.\n- `event_count`: The number of matching execution events in trace A.\n- `call_count`: The number of calls observed in trace A.\n- `max_call_depth`: The maximum observed call depth for this artifact.\n\nUsage suggestions:\n- Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n- Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n", "parameters": {"type": "object", "properties": {"artifact_type": {"type": "string", "enum": ["all", "function", "method", "class"], "default": "all", "description": "Optional exact filter for artifact definition type."}, "path_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the compact file path.", "default": null}, "name_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the qualified name.", "default": null}, "start": {"type": "integer", "default": 0, "description": "Zero-based pagination offset."}, "limit": {"type": "integer", "default": 8, "description": "Maximum number of artifacts to return in this slice."}}, "required": []}}}], "usage": {"prompt_tokens": 108132, "completion_tokens": 398}, "time": 59.571033239364624}]}}
{"instance_id": "scikit-learn__scikit-learn-30128", "found_files": [["sklearn/metrics/_regression.py", "sklearn/utils/_array_api.py"]], "found_modules": [["doc/sphinxext/dropdown_anchors.py:setup", "sklearn/metrics/_regression.py:_check_reg_targets", "sklearn/metrics/_regression.py:mean_pinball_loss", "sklearn/metrics/_regression.py:mean_squared_log_error", "sklearn/metrics/_regression.py:median_absolute_error", "sklearn/utils/_array_api.py:get_namespace", "sklearn/metrics/pairwise.py:_argmin_reduce", "sklearn/utils/_array_api.py:_find_matching_floating_dtype"]], "found_entities": [["doc/sphinxext/dropdown_anchors.py:setup", "sklearn/metrics/_regression.py:_check_reg_targets", "sklearn/metrics/_regression.py:mean_pinball_loss", "sklearn/metrics/_regression.py:mean_squared_log_error", "sklearn/metrics/_regression.py:median_absolute_error", "sklearn/utils/_array_api.py:get_namespace", "sklearn/metrics/pairwise.py:_argmin_reduce", "sklearn/utils/_array_api.py:_find_matching_floating_dtype"]], "raw_output_loc": ["```\nsklearn/metrics/_regression.py\nline: 58\nfunction: _check_reg_targets\n\nsklearn/metrics/_regression.py\nline: 245\nfunction: mean_pinball_loss\n\nsklearn/metrics/_regression.py\nline: 616\nfunction: mean_squared_log_error\n\nsklearn/metrics/_regression.py\nline: 780\nfunction: median_absolute_error\n\nsklearn/utils/_array_api.py\nline: 490\nfunction: get_namespace\n\nsklearn/utils/_array_api.py\nline: 673\nfunction: _find_matching_floating_dtype\n\nsklearn/metrics/tests/test_regression.py\nline: 52\nfunction: test_mean_squared_error\n\nsklearn/metrics/tests/test_regression.py\nline: 107\nfunction: test_mean_squared_log_error\n```"], "meta_data": {"repo": "scikit-learn/scikit-learn", "base_commit": "6bf2061f76ba0977c1f7ffb9ddc48db794e5c7ec", "problem_statement": "Reduce redundancy in floating type checks for Array API support\n### Describe the workflow you want to enable\n\nWhile working on #29978, we noticed that the following procedure is repeated across most regression metrics in `_regression.py` for the Array API:\r\n\r\n```python\r\n    xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\r\n    dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\r\n\r\n    _, y_true, y_pred, multioutput = _check_reg_targets(\r\n        y_true, y_pred, multioutput, dtype=dtype, xp=xp\r\n    )\r\n```\r\n\r\nTo reduce redundancy, it would make sense to incorporate the `_find_matching_floating_dtype` logic directly into the `_check_reg_targets` function. This would result in the following cleaner implementation:\r\n\r\n```python\r\n    xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\r\n    _, y_true, y_pred, multioutput, dtype = _check_reg_targets(\r\n        y_true, y_pred, multioutput, xp=xp\r\n    )\r\n```\n\n### Describe your proposed solution\n\nWe could introduce a new function, `_check_reg_targets_and_dtype`, defined in the obvious way. This approach would enable us to utilise the existing tests in `test_regression.py` with minimal changes.\n\n### Describe alternatives you've considered, if relevant\n\nWe could modify the original `_check_reg_targets` function, but this would require carefully reviewing and updating the relevant tests in `test_regression.py` to ensure everything remains consistent.\n\n### Additional context\n\nThis is part of the Array API project #26024.\r\n\r\nping: @ogrisel\r\ncc: @glemaitre, @betatim, @adrinjalali.\n", "patch": "diff --git a/sklearn/metrics/_regression.py b/sklearn/metrics/_regression.py\nindex 62251f9b96188..c5ebe67e34a2e 100644\n--- a/sklearn/metrics/_regression.py\n+++ b/sklearn/metrics/_regression.py\n@@ -58,11 +58,16 @@\n def _check_reg_targets(y_true, y_pred, multioutput, dtype=\"numeric\", xp=None):\n     \"\"\"Check that y_true and y_pred belong to the same regression task.\n \n+    To reduce redundancy when calling `_find_matching_floating_dtype`,\n+    please use `_check_reg_targets_with_floating_dtype` instead.\n+\n     Parameters\n     ----------\n-    y_true : array-like\n+    y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n+        Ground truth (correct) target values.\n \n-    y_pred : array-like\n+    y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n+        Estimated target values.\n \n     multioutput : array-like or string in ['raw_values', uniform_average',\n         'variance_weighted'] or None\n@@ -137,6 +142,71 @@ def _check_reg_targets(y_true, y_pred, multioutput, dtype=\"numeric\", xp=None):\n     return y_type, y_true, y_pred, multioutput\n \n \n+def _check_reg_targets_with_floating_dtype(\n+    y_true, y_pred, sample_weight, multioutput, xp=None\n+):\n+    \"\"\"Ensures that y_true, y_pred, and sample_weight correspond to the same\n+    regression task.\n+\n+    Extends `_check_reg_targets` by automatically selecting a suitable floating-point\n+    data type for inputs using `_find_matching_floating_dtype`.\n+\n+    Use this private method only when converting inputs to array API-compatibles.\n+\n+    Parameters\n+    ----------\n+    y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n+        Ground truth (correct) target values.\n+\n+    y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n+        Estimated target values.\n+\n+    sample_weight : array-like of shape (n_samples,)\n+\n+    multioutput : array-like or string in ['raw_values', 'uniform_average', \\\n+        'variance_weighted'] or None\n+        None is accepted due to backward compatibility of r2_score().\n+\n+    xp : module, default=None\n+        Precomputed array namespace module. When passed, typically from a caller\n+        that has already performed inspection of its own inputs, skips array\n+        namespace inspection.\n+\n+    Returns\n+    -------\n+    type_true : one of {'continuous', 'continuous-multioutput'}\n+        The type of the true target data, as output by\n+        'utils.multiclass.type_of_target'.\n+\n+    y_true : array-like of shape (n_samples, n_outputs)\n+        Ground truth (correct) target values.\n+\n+    y_pred : array-like of shape (n_samples, n_outputs)\n+        Estimated target values.\n+\n+    sample_weight : array-like of shape (n_samples,), default=None\n+        Sample weights.\n+\n+    multioutput : array-like of shape (n_outputs) or string in ['raw_values', \\\n+        'uniform_average', 'variance_weighted'] or None\n+        Custom output weights if ``multioutput`` is array-like or\n+        just the corresponding argument if ``multioutput`` is a\n+        correct keyword.\n+    \"\"\"\n+    dtype_name = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n+\n+    y_type, y_true, y_pred, multioutput = _check_reg_targets(\n+        y_true, y_pred, multioutput, dtype=dtype_name, xp=xp\n+    )\n+\n+    # _check_reg_targets does not accept sample_weight as input.\n+    # Convert sample_weight's data type separately to match dtype_name.\n+    if sample_weight is not None:\n+        sample_weight = xp.asarray(sample_weight, dtype=dtype_name)\n+\n+    return y_type, y_true, y_pred, sample_weight, multioutput\n+\n+\n @validate_params(\n     {\n         \"y_true\": [\"array-like\"],\n@@ -201,14 +271,14 @@ def mean_absolute_error(\n     >>> mean_absolute_error(y_true, y_pred, multioutput=[0.3, 0.7])\n     0.85...\n     \"\"\"\n-    input_arrays = [y_true, y_pred, sample_weight, multioutput]\n-    xp, _ = get_namespace(*input_arrays)\n-\n-    dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n+    xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\n \n-    _, y_true, y_pred, multioutput = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    _, y_true, y_pred, sample_weight, multioutput = (\n+        _check_reg_targets_with_floating_dtype(\n+            y_true, y_pred, sample_weight, multioutput, xp=xp\n+        )\n     )\n+\n     check_consistent_length(y_true, y_pred, sample_weight)\n \n     output_errors = _average(\n@@ -398,19 +468,16 @@ def mean_absolute_percentage_error(\n     >>> mean_absolute_percentage_error(y_true, y_pred)\n     112589990684262.48\n     \"\"\"\n-    input_arrays = [y_true, y_pred, sample_weight, multioutput]\n-    xp, _ = get_namespace(*input_arrays)\n-    dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n-\n-    y_type, y_true, y_pred, multioutput = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\n+    _, y_true, y_pred, sample_weight, multioutput = (\n+        _check_reg_targets_with_floating_dtype(\n+            y_true, y_pred, sample_weight, multioutput, xp=xp\n+        )\n     )\n     check_consistent_length(y_true, y_pred, sample_weight)\n-    epsilon = xp.asarray(xp.finfo(xp.float64).eps, dtype=dtype)\n-    y_true_abs = xp.asarray(xp.abs(y_true), dtype=dtype)\n-    mape = xp.asarray(xp.abs(y_pred - y_true), dtype=dtype) / xp.maximum(\n-        y_true_abs, epsilon\n-    )\n+    epsilon = xp.asarray(xp.finfo(xp.float64).eps, dtype=y_true.dtype)\n+    y_true_abs = xp.abs(y_true)\n+    mape = xp.abs(y_pred - y_true) / xp.maximum(y_true_abs, epsilon)\n     output_errors = _average(mape, weights=sample_weight, axis=0)\n     if isinstance(multioutput, str):\n         if multioutput == \"raw_values\":\n@@ -494,10 +561,10 @@ def mean_squared_error(\n     0.825...\n     \"\"\"\n     xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\n-    dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n-\n-    _, y_true, y_pred, multioutput = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    _, y_true, y_pred, sample_weight, multioutput = (\n+        _check_reg_targets_with_floating_dtype(\n+            y_true, y_pred, sample_weight, multioutput, xp=xp\n+        )\n     )\n     check_consistent_length(y_true, y_pred, sample_weight)\n     output_errors = _average((y_true - y_pred) ** 2, axis=0, weights=sample_weight)\n@@ -670,10 +737,9 @@ def mean_squared_log_error(\n     0.060...\n     \"\"\"\n     xp, _ = get_namespace(y_true, y_pred)\n-    dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n \n-    _, y_true, y_pred, _ = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    _, y_true, y_pred, _, _ = _check_reg_targets_with_floating_dtype(\n+        y_true, y_pred, sample_weight, multioutput, xp=xp\n     )\n \n     if xp.any(y_true <= -1) or xp.any(y_pred <= -1):\n@@ -747,10 +813,9 @@ def root_mean_squared_log_error(\n     0.199...\n     \"\"\"\n     xp, _ = get_namespace(y_true, y_pred)\n-    dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n \n-    _, y_true, y_pred, multioutput = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    _, y_true, y_pred, _, _ = _check_reg_targets_with_floating_dtype(\n+        y_true, y_pred, sample_weight, multioutput, xp=xp\n     )\n \n     if xp.any(y_true <= -1) or xp.any(y_pred <= -1):\n@@ -1188,11 +1253,12 @@ def r2_score(\n         y_true, y_pred, sample_weight, multioutput\n     )\n \n-    dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n-\n-    _, y_true, y_pred, multioutput = _check_reg_targets(\n-        y_true, y_pred, multioutput, dtype=dtype, xp=xp\n+    _, y_true, y_pred, sample_weight, multioutput = (\n+        _check_reg_targets_with_floating_dtype(\n+            y_true, y_pred, sample_weight, multioutput, xp=xp\n+        )\n     )\n+\n     check_consistent_length(y_true, y_pred, sample_weight)\n \n     if _num_samples(y_pred) < 2:\n@@ -1201,7 +1267,7 @@ def r2_score(\n         return float(\"nan\")\n \n     if sample_weight is not None:\n-        sample_weight = column_or_1d(sample_weight, dtype=dtype)\n+        sample_weight = column_or_1d(sample_weight)\n         weight = sample_weight[:, None]\n     else:\n         weight = 1.0\n@@ -1356,8 +1422,8 @@ def mean_tweedie_deviance(y_true, y_pred, *, sample_weight=None, power=0):\n     1.4260...\n     \"\"\"\n     xp, _ = get_namespace(y_true, y_pred)\n-    y_type, y_true, y_pred, _ = _check_reg_targets(\n-        y_true, y_pred, None, dtype=[xp.float64, xp.float32], xp=xp\n+    y_type, y_true, y_pred, sample_weight, _ = _check_reg_targets_with_floating_dtype(\n+        y_true, y_pred, sample_weight, multioutput=None, xp=xp\n     )\n     if y_type == \"continuous-multioutput\":\n         raise ValueError(\"Multioutput not supported in mean_tweedie_deviance\")\n@@ -1570,8 +1636,8 @@ def d2_tweedie_score(y_true, y_pred, *, sample_weight=None, power=0):\n     \"\"\"\n     xp, _ = get_namespace(y_true, y_pred)\n \n-    y_type, y_true, y_pred, _ = _check_reg_targets(\n-        y_true, y_pred, None, dtype=[xp.float64, xp.float32], xp=xp\n+    y_type, y_true, y_pred, sample_weight, _ = _check_reg_targets_with_floating_dtype(\n+        y_true, y_pred, sample_weight, multioutput=None, xp=xp\n     )\n     if y_type == \"continuous-multioutput\":\n         raise ValueError(\"Multioutput not supported in d2_tweedie_score\")\n"}, "usage": {"cost($)": "0", "prompt_tokens": 364982, "completion_tokens": 1308}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nget_trace_artifacts(artifact_type: str = 'all', path_contains: str | None = None, name_contains: str | None = None, start: int = 0, limit: int = 8):\n    Read a compact raw slice of DaLIC execution-trace artifacts for the current instance.\n    This tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\n    It does not rank or recommend results. It only applies filters and pagination.\n    Note:\n    '<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n    - executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n    - tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n    - then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n    Args:\n    - `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`.\n    If not specified, it defaults to `all` and does not filter by artifact type.\n    - `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`.\n    If not specified, it defaults to `None` and does not filter by file path.\n    - `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`.\n    If not specified, it defaults to `None` and does not filter by qualified name.\n    - `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n    - `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n    Returns:\n    A JSON string encoding an object with the following top-level fields:\n    - `instance_id`: The current DaLIC instance id.\n    - `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n    - `applied_filters`: The effective filter and pagination values used for this call.\n    - `artifacts`: A JSON array of matched artifacts.\n    - `has_more`: Whether more matched artifacts are available after this slice.\n    - `next_start`: The pagination offset to use for the next slice.\n    Each artifact in `artifacts` is a JSON object with the following fields:\n    - `qualified_name`: The qualified name of the artifact.\n    - `path`: The compact file path where the artifact is defined.\n    - `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n    - `defined_line`: The line number where the artifact is defined.\n    - `end_line`: The ending line number of the artifact, if available.\n    - `event_count`: The number of matching execution events in trace A.\n    - `call_count`: The number of calls observed in trace A.\n    - `max_call_depth`: The maximum observed call depth for this artifact.\n    Usage suggestions:\n    - Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n    - Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n\nget_trace_data_dependencies(symbol_contains: str | None = None, scope_contains: str | None = None, path_contains: str | None = None, edge_type: str | None = None, start: int = 0, limit: int = 12, path_limit: int = 4):\n    Read a compact raw slice of DaLIC data-dependency evidence for the current instance.\n    This tool reads '<instance_id>/unique_dep_tree.json' and returns a short JSON summary.\n    It does not rank or recommend results. It only applies filters and pagination.\n    Note:\n    - '<instance_id>/unique_dep_tree.json' is generated by analyzing the data dependencies of the unique artifacts in '<instance_id>/unique_artifacts.json'.\n    - It contains the dataflows associated with the unique artifacts, which can help you understand how the unique artifacts are related to each other and how they are related to other parts of the codebase.\n    Args:\n    - `symbol_contains`: Optional case-insensitive substring filter applied to symbol names.\n    For example, if you are interested in dependencies related to symbols with `DataLoader` in their names, you can set `symbol_contains` to `DataLoader`.\n    Together with `scope_contains` and `path_contains`, this first selects a set of matching symbols; an edge is retained when either endpoint belongs to that set.\n    If not specified, it defaults to `None`\n    - `scope_contains`: Optional case-insensitive substring filter applied to symbol scopes.\n    The scope is represented as a dot-separated string of nested scopes, such as `src.utils.data_loader.DataLoader.__init__`.\n    You can set `scope_contains` to a substring of the scope to filter dependencies related to that scope.\n    For example, setting it to `DataLoader` would match the above scope and include its dependencies.\n    Together with `symbol_contains` and `path_contains`, this contributes to the symbol-matching step described above.\n    If not specified, it defaults to `None`\n    - `path_contains`: Optional case-insensitive substring filter applied to compact file paths.\n    For example, if you are interested in dependencies related to files under `src/utils`, you can set `path_contains` to `src/utils`.\n    Together with `symbol_contains` and `scope_contains`, this contributes to the symbol-matching step described above.\n    If not specified, it defaults to `None`\n    - `edge_type`: Optional exact filter for dependency edge type such as `data` or `ret`. If not specified, it defaults to `None` and does not filter by edge type.\n    - `start`: Zero-based pagination offset for matched edges. It defaults to 0, meaning that the first page starts from the first matched edge.\n    - `limit`: Maximum number of matched edges to return in this slice. It defaults to 12, which is a reasonable number for you to inspect at a time.\n    You can adjust it based on your preference and the typical number of matched edges.\n    - `path_limit`: Maximum number of compact dependency paths to include. A dependency path is a sequence of dependency edges connecting two symbols.\n    If there are more matched paths than this limit, only the first few unique compressed paths are returned.\n    Important behavior:\n    - If at least one symbol matches the combined `symbol_contains` / `scope_contains` / `path_contains` filters, only edges whose source or destination is in that matched symbol set are retained.\n    - If no symbol matches those filters, edge filtering falls back to `edge_type` plus pagination only; it does not return an empty edge list.\n    Returns:\n    A JSON string encoding an object with the following top-level fields:\n    - `instance_id`: The current DaLIC instance id.\n    - `dep_summary`: Summary counts, including retained file / symbol / edge counts and the returned / filtered edge counts.\n    - `applied_filters`: The effective filter and pagination values used for this call.\n    - `matched_symbols`: A compact JSON array of symbols related to the current page of results.\n    - `edges`: A JSON array of matched dependency edges.\n    - `paths`: A JSON array of compressed dependency-path strings related to the current page.\n    - `has_more`: Whether more matched edges are available after this slice.\n    - `next_start`: The pagination offset to use for the next slice.\n    Each symbol in `matched_symbols` has these fields:\n    - `kind`: The raw symbol kind from DaLIC, such as `func`, `class`, or similar labels.\n    - `symbol`: The symbol name.\n    - `scope`: The raw scope string associated with the symbol.\n    - `path`: The compact file path where the symbol is defined.\n    - `line`: The line number where the symbol is defined.\n    Each edge in `edges` is a JSON object with the following fields:\n    - `src`: A compact source-symbol object with fields `kind`, `symbol`, `scope`, `path`, and `line`.\n    - `dst`: A compact target-symbol object with fields `kind`, `symbol`, `scope`, `path`, and `line`.\n    - `edge_type`: The raw dependency edge type, such as `arg`, `data`, or `ret`.\n    Usage suggestions:\n    - Use it whenever you need a focused dependency slice around a traced symbol, scope, or file path.\n    - During analysis, you may call it again with narrower `symbol_contains`, `scope_contains`, `path_contains`, or `edge_type` filters.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: get_trace_artifacts ----\nDescription: \nRead a compact raw slice of DaLIC execution-trace artifacts for the current instance.\nThis tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\nIt does not rank or recommend results. It only applies exact filters and pagination.\n\nNote:\n'<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n- executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n- tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n- then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n\nArgs:\n- `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`. \n    If not specified, it defaults to `all` and does not filter by artifact type.\n- `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`. \n    If not spe