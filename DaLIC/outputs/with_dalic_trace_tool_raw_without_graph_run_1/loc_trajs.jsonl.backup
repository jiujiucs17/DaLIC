izes:\n19 |         X = random_state.rand(n_samples, 300)\n20 | \n21 |         start = time.time()\n22 |         func(X, n_jobs=1)\n23 |         one_core.append(time.time() - start)\n24 | \n25 |         start = time.time()\n26 |         func(X, n_jobs=-1)\n27 |         multi_core.append(time.time() - start)\n28 | \n29 |     plt.figure(\"scikit-learn parallel %s benchmark results\" % func.__name__)\n30 |     plt.plot(sample_sizes, one_core, label=\"one core\")\n31 |     plt.plot(sample_sizes, multi_core, label=\"multi core\")\n32 |     plt.xlabel(\"n_samples\")\n33 |     plt.ylabel(\"Time (s)\")\n34 |     plt.title(\"Parallel %s\" % func.__name__)\n35 |     plt.legend()\n```\n\nFound function `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay.plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n287 | def plot(self, ax=None, *, name=None, **kwargs):\n288 |         \"\"\"Plot visualization.\n289 | \n290 |         Parameters\n291 |         ----------\n292 |         ax : matplotlib axes, default=None\n293 |             Axes object to plot on. If `None`, a new figure and axes is\n294 |             created.\n295 | \n296 |         name : str, default=None\n297 |             Name of DET curve for labeling. If `None`, use the name of the\n298 |             estimator.\n299 | \n300 |         **kwargs : dict\n301 |             Additional keywords arguments passed to matplotlib `plot` function.\n302 | \n303 |         Returns\n304 |         -------\n305 |         display : :class:`~sklearn.metrics.plot.DetCurveDisplay`\n306 |             Object that stores computed values.\n307 |         \"\"\"\n308 |         check_matplotlib_support(\"DetCurveDisplay.plot\")\n309 | \n310 |         name = self.estimator_name if name is None else name\n311 |         line_kwargs = {} if name is None else {\"label\": name}\n312 |         line_kwargs.update(**kwargs)\n313 | \n314 |         import matplotlib.pyplot as plt\n315 | \n316 |         if ax is None:\n317 |             _, ax = 