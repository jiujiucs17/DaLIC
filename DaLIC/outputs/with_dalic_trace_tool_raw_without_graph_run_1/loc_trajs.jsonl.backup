 norm.\n 82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n 83 |         If beta == 0, this is the Itakura-Saito divergence.\n 84 |         Else, this is the general beta-divergence.\n 85 | \n 86 |     square_root : bool, default=False\n 87 |         If True, return np.sqrt(2 * res)\n 88 |         For beta == 2, it corresponds to the Frobenius norm.\n 89 | \n 90 |     Returns\n 91 |     -------\n 92 |         res : float\n 93 |             Beta divergence of X and np.dot(X, H).\n 94 |     \"\"\"\n 95 |     beta = _beta_loss_to_float(beta)\n 96 | \n 97 |     # The method can be called with scalars\n 98 |     if not sp.issparse(X):\n 99 |         X = np.atleast_2d(X)\n100 |     W = np.atleast_2d(W)\n101 |     H = np.atleast_2d(H)\n102 | \n103 |     # Frobenius norm\n104 |     if beta == 2:\n105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n106 |         if sp.issparse(X):\n107 |             norm_X = np.dot(X.data, X.data)\n108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n109 |             cross_prod = trace_dot((X * H.T), W)\n110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n111 |         else:\n112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n\nFound function `sklearn/manifold/_t_sne.py:_kl_divergence`.\nSource: Retrieved entity using keyword search (bm25).\n```\n126 | def _kl_divergence(\n127 |     params,\n128 |     P,\n129 |     degrees_of_freedom,\n130 |     n_samples,\n131 |     n_components,\n132 |     skip_num_points=0,\n133 |     compute_error=True,\n134 | ):\n135 |     \"\"\"t-SNE objective function: gradient of the KL divergence\n136 |     of p_ijs and q_ijs and the absolute error.\n137 | \n138 |     Parameters\n139 |     ----------\n140 |     params : ndarray of shape (n_params,)\n141 |         Unraveled embedding.\n142 | \n143 |     P : ndarray of shape (n_samples * (n_samples-1) / 2,)\n144 |         Condensed joint probability matrix.\n145 | \n146 |     degrees_of_freedom : int\n147 |         Degrees of freedom of the Student's-t distribution.\n148 | \n149 |     n_samples : int\n150 |         Number of samples.\n151 | \n152 |     n_components : int\n153 |         Dimension of the embedded space.\n154 | \n155 |     skip_num_points : int, default=0\n156 |         This does not compute the gradient for points with indices below\n157 |         `skip_num_points`. This is useful when computing transforms of new\n158 |         data where you'd like to keep the old data fixed.\n159 | \n160 |     compute_error: bool, default=True\n161 |         If False, the kl_divergence is not computed and returns NaN.\n162 | \n163 |     Returns\n164 |     -------\n165 |     kl_divergence : float\n166 |         Kullback-Leibler divergence of p_ij and q_ij.\n167 | \n168 |     grad : ndarray of shape (n_params,)\n169 |         Unraveled gradient of the Kullback-Leibler divergence with respect to\n170 |         the embedding.\n171 |     \"\"\"\n172 |     X_embedded = params.reshape(n_samples, n_components)\n173 | \n174 |     # Q is a heavy-tailed distribution: Student's t-distribution\n175 |     dist = pdist(X_embedded, \"sqeuclidean\")\n176 |     dist /= degrees_of_freedom\n177 |     dist += 1.0\n178 |     dist **= (degrees_of_freedom + 1.0) / -2.0\n179 |     Q = np.maximum(dist / (2.0 * np.sum(dist)), MACHINE_EPSILON)\n180 | \n181 |     # Optimization trick below: np.dot(x, y) is faster than\n182 |     # np.sum(x * y) because it calls BLAS\n183 | \n184 |     # Objective: C (Kullback-Leibler divergence of P and Q)\n185 |     if compute_error:\n186 |         kl_divergence = 2.0 * np.dot(P, np.log(np.maximum(P, MACHINE_EPSILON) / Q))\n187 |     else:\n188 |         kl_divergence = np.nan\n189 | \n190 |     # Gradient: dC/dY\n191 |     # pdist always returns double precision distances. Thus we need to take\n192 |     grad = np.ndarray((n_samples, n_components), dtype=params.dtype)\n193 |     PQd = squareform((P - Q) * dist)\n194 |     for i in range(skip_num_points, n_samples):\n195 |         grad[i] = np.dot(np.ravel(PQd[i], order=\"K\"), X_embedded[i] - X_embedded)\n196 |     grad = grad.ravel()\n197 |     c = 2.0 * (degrees_of_freedom + 1.0) / degrees_of_freedom\n198 |     grad *= c\n199 | \n200 |     return kl_divergence, grad\n```\n\nFound file `examples/decomposition/plot_beta_divergence.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/decomposition/plot_beta_divergence.py` for the full content if needed.\n\n\n\n##Searching for term \"multiplicative_update\", \"OnlineNMF beta_divergence multiplicative_update\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_w`.\nSource: Retrieved entity using keyword search (bm25).\n```\n537 | def _multiplicative_update_w(\n538 |     X,\n539 |     W,\n540 |     H,\n541 |     beta_loss,\n542 |     l1_reg_W,\n543 |     l2_reg_W,\n544 |     gamma,\n545 |     H_sum=None,\n546 |     HHt=None,\n547 |     XHt=None,\n548 |     update_H=True,\n549 | ):\n550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n551 |     if beta_loss == 2:\n552 |         # Numerator\n553 |         if XHt is None:\n554 |             XHt = safe_sparse_dot(X, H.T)\n555 |         if update_H:\n556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n557 |             numerator = XHt\n558 |         else:\n559 |             # preserve the XHt, which is not re-computed (update_H=False)\n560 |             numerator = XHt.copy()\n561 | \n562 |         # Denominator\n563 |         if HHt is None:\n564 |             HHt = np.dot(H, H.T)\n565 |         denominator = np.dot(W, HHt)\n566 | \n567 |     else:\n568 |         # Numerator\n569 |         # if X is sparse, compute WH only where X is non zero\n570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n571 |         if sp.issparse(X):\n572 |             WH_safe_X_data = WH_safe_X.data\n573 |             X_data = X.data\n574 |         else:\n575 |             WH_safe_X_data = WH_safe_X\n576 |             X_data = X\n577 |             # copy used in the Denominator\n578 |             WH = WH_safe_X.copy()\n579 |             if beta_loss - 1.0 < 0:\n580 |                 WH[WH == 0] = EPSILON\n581 | \n582 |         # to avoid taking a negative power of zero\n583 |         if beta_loss - 2.0 < 0:\n584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n585 | \n586 |         if beta_loss == 1:\n587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n588 |         elif beta_loss == 0:\n589 |             # speeds up computation time\n590 |             # refer to /numpy/numpy/issues/9363\n591 |             WH_safe_X_data **= -1\n592 |             WH_safe_X_data **= 2\n593 |             # element-wise multiplication\n594 |             WH_safe_X_data *= X_data\n595 |         else:\n596 |             WH_safe_X_data **= beta_loss - 2\n597 |             # element-wise multiplication\n598 |             WH_safe_X_data *= X_data\n599 | \n600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n602 | \n603 |         # Denominator\n604 |         if beta_loss == 1:\n605 |             if H_sum is None:\n606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n607 |             denominator = H_sum[np.newaxis, :]\n608 | \n609 |         else:\n610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n611 |             if sp.issparse(X):\n612 |                 # memory efficient computation\n613 |                 # (compute row by row, avoiding the dense matrix WH)\n614 |                 WHHt = np.empty(W.shape)\n615 |                 for i in range(X.shape[0]):\n616 |                     WHi = np.dot(W[i, :], H)\n617 |                     if beta_loss - 1 < 0:\n618 |                         WHi[WHi == 0] = EPSILON\n619 |                     WHi **= beta_loss - 1\n620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n621 |             else:\n622 |                 WH **= beta_loss - 1\n623 |                 WHHt = np.dot(WH, H.T)\n624 |             denominator = WHHt\n625 | \n626 |     # Add L1 and L2 regularization\n627 |     if l1_reg_W > 0:\n628 |         denominator += l1_reg_W\n629 |     if l2_reg_W > 0:\n630 |         denominator = denominator + l2_reg_W * W\n631 |     denominator[denominator == 0] = EPSILON\n632 | \n633 |     numerator /= denominator\n634 |     delta_W = numerator\n635 | \n636 |     # gamma is in ]0, 1]\n637 |     if gamma != 1:\n638 |         delta_W **= gamma\n639 | \n640 |     return delta_W, H_sum, HHt, XHt\n```\n\nFound function `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\nSource: Retrieved entity using keyword search (bm25).\n```\n725 | def _fit_multiplicative_update(\n726 |     X,\n727 |     W,\n728 |     H,\n729 |     beta_loss=\"frobenius\",\n730 |     max_iter=200,\n731 |     tol=1e-4,\n732 |     l1_reg_W=0,\n733 |     l1_reg_H=0,\n734 |     l2_reg_W=0,\n735 |     l2_reg_H=0,\n736 |     update_H=True,\n737 |     verbose=0,\n738 | ):\n739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n740 | \n741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n742 |     alternating minimization of W and H. Each minimization is done with a\n743 |     Multiplicative Update.\n744 | \n745 |     Parameters\n746 |     ----------\n747 |     X : array-like of shape (n_samples, n_features)\n748 |         Constant input matrix.\n749 | \n750 |     W : array-like of shape (n_samples, n_components)\n751 |         Initial guess for the solution.\n752 | \n753 |     H : array-like of shape (n_components, n_features)\n754 |         Initial guess for the solution.\n755 | \n756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n757 |             'itakura-saito'}, default='frobenius'\n758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n759 |         Beta divergence to be minimized, measuring the distance between X\n760 |         and the dot product WH. Note that values different from 'frobenius'\n761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n763 |         matrix X cannot contain zeros.\n764 | \n765 |     max_iter : int, default=200\n766 |         Number of iterations.\n767 | \n768 |     tol : float, default=1e-4\n769 |         Tolerance of the stopping condition.\n770 | \n771 |     l1_reg_W : float, default=0.\n772 |         L1 regularization parameter for W.\n773 | \n774 |     l1_reg_H : float, default=0.\n775 |         L1 regularization parameter for H.\n776 | \n777 |     l2_reg_W : float, default=0.\n778 |         L2 regularization parameter for W.\n779 | \n780 |     l2_reg_H : float, default=0.\n781 |         L2 regularization parameter for H.\n782 | \n783 |     update_H : bool, default=True\n784 |         Set to True, both W and H will be estimated from initial guesses.\n785 |         Set to False, only W will be estimated.\n786 | \n787 |     verbose : int, default=0\n788 |         The verbosity level.\n789 | \n790 |     Returns\n791 |     -------\n792 |     W : ndarray of shape (n_samples, n_components)\n793 |         Solution to the non-negative least squares problem.\n794 | \n795 |     H : ndarray of shape (n_components, n_features)\n796 |         Solution to the non-negative least squares problem.\n797 | \n798 |     n_iter : int\n799 |         The number of iterations done by the algorithm.\n800 | \n801 |     References\n802 |     ----------\n803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n805 |     \"\"\"\n806 |     start_time = time.time()\n807 | \n808 |     beta_loss = _beta_loss_to_float(beta_loss)\n809 | \n810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n811 |     if beta_loss < 1:\n812 |         gamma = 1.0 / (2.0 - beta_loss)\n813 |     elif beta_loss > 2:\n814 |         gamma = 1.0 / (beta_loss - 1.0)\n815 |     else:\n816 |         gamma = 1.0\n817 | \n818 |     # used for the convergence criterion\n819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n820 |     previous_error = error_at_init\n821 | \n822 |     H_sum, HHt, XHt = None, None, None\n823 |     for n_iter in range(1, max_iter + 1):\n824 |         # update W\n825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_h`.\nSource: Retrieved entity using keyword search (bm25).\n```\n643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n645 |     if beta_loss == 2:\n646 |         numerator = safe_sparse_dot(W.T, X)\n647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n648 | \n649 |     else:\n650 |         # Numerator\n651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n652 |         if sp.issparse(X):\n653 |             WH_safe_X_data = WH_safe_X.data\n654 |             X_data = X.data\n655 |         else:\n656 |             WH_safe_X_data = WH_safe_X\n657 |             X_data = X\n658 |             # copy used in the Denominator\n659 |             WH = WH_safe_X.copy()\n660 |             if beta_loss - 1.0 < 0:\n661 |                 WH[WH == 0] = EPSILON\n662 | \n663 |         # to avoid division by zero\n664 |         if beta_loss - 2.0 < 0:\n665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n666 | \n667 |         if beta_loss == 1:\n668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n669 |         elif beta_loss == 0:\n670 |             # speeds up computation time\n671 |             # refer to /numpy/numpy/issues/9363\n672 |             WH_safe_X_data **= -1\n673 |             WH_safe_X_data **= 2\n674 |             # element-wise multiplication\n675 |             WH_safe_X_data *= X_data\n676 |         else:\n677 |             WH_safe_X_data **= beta_loss - 2\n678 |             # element-wise multiplication\n679 |             WH_safe_X_data *= X_data\n680 | \n681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n683 | \n684 |         # Denominator\n685 |         if beta_loss == 1:\n686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n687 |             W_sum[W_sum == 0] = 1.0\n688 |             denominator = W_sum[:, np.newaxis]\n689 | \n690 |         # beta_loss not in (1, 2)\n691 |         else:\n692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n693 |             if sp.issparse(X):\n694 |                 # memory efficient computation\n695 |                 # (compute column by column, avoiding the dense matrix WH)\n696 |                 WtWH = np.empty(H.shape)\n697 |                 for i in range(X.shape[1]):\n698 |                     WHi = np.dot(W, H[:, i])\n699 |                     if beta_loss - 1 < 0:\n700 |                         WHi[WHi == 0] = EPSILON\n701 |                     WHi **= beta_loss - 1\n702 |                     WtWH[:, i] = np.dot(W.T, WHi)\n703 |             else:\n704 |                 WH **= beta_loss - 1\n705 |                 WtWH = np.dot(W.T, WH)\n706 |             denominator = WtWH\n707 | \n708 |     # Add L1 and L2 regularization\n709 |     if l1_reg_H > 0:\n710 |         denominator += l1_reg_H\n711 |     if l2_reg_H > 0:\n712 |         denominator = denominator + l2_reg_H * H\n713 |     denominator[denominator == 0] = EPSILON\n714 | \n715 |     numerator /= denominator\n716 |     delta_H = numerator\n717 