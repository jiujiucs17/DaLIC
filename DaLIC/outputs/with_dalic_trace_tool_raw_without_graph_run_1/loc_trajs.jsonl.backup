    y_type = \"continuous\" if n_outputs == 1 else \"continuous-multioutput\"\n136 | \n137 |     return y_type, y_true, y_pred, multioutput\n```\n\nFound function `sklearn/metrics/_regression.py:mean_pinball_loss`.\nSource: Retrieved code content using keyword search (bm25).\n```\n244 | def mean_pinball_loss(\n245 |     y_true, y_pred, *, sample_weight=None, alpha=0.5, multioutput=\"uniform_average\"\n246 | ):\n247 |     \"\"\"Pinball loss for quantile regression.\n248 | \n249 |     Read more in the :ref:`User Guide <pinball_loss>`.\n250 | \n251 |     Parameters\n252 |     ----------\n253 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n254 |         Ground truth (correct) target values.\n255 | \n256 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n257 |         Estimated target values.\n258 | \n259 |     sample_weight : array-like of shape (n_samples,), default=None\n260 |         Sample weights.\n261 | \n262 |     alpha : float, slope of the pinball loss, default=0.5,\n263 |         This loss is equivalent to :ref:`mean_absolute_error` when `alpha=0.5`,\n264 |         `alpha=0.95` is minimized by estimators of the 95th percentile.\n265 | \n266 |     multioutput : {'raw_values', 'uniform_average'}  or array-like of shape \\\n267 |             (n_outputs,), default='uniform_average'\n268 |         Defines aggregating of multiple output values.\n269 |         Array-like value defines weights used to average errors.\n270 | \n271 |         'raw_values' :\n272 |             Returns a full set of errors in case of multioutput input.\n273 | \n274 |         'uniform_average' :\n275 |             Errors of all outputs are averaged with uniform weight.\n276 | \n277 |     Returns\n278 |     -------\n279 |     loss : float or ndarray of floats\n280 |         If multioutput is 'raw_values', then mean absolute error is returned\n281 |         for each output separately.\n282 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n283 |         weighted average of all output errors is returned.\n284 | \n285 |         The pinball loss output is a non-negative floating point. The best\n286 |         value is 0.0.\n287 | \n288 |     Examples\n289 |     --------\n290 |     >>> from sklearn.metrics import mean_pinball_loss\n291 |     >>> y_true = [1, 2, 3]\n292 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.1)\n293 |     np.float64(0.03...)\n294 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.1)\n295 |     np.float64(0.3...)\n296 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.9)\n297 |     np.float64(0.3...)\n298 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.9)\n299 |     np.float64(0.03...)\n300 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.1)\n301 |     np.float64(0.0)\n302 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.9)\n303 |     np.float64(0.0)\n304 |     \"\"\"\n305 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n306 |         y_true, y_pred, multioutput\n307 |     )\n308 |     check_consistent_length(y_true, y_pred, sample_weight)\n309 |     diff = y_true - y_pred\n310 |     sign = (diff >= 0).astype(diff.dtype)\n311 |     loss = alpha * sign * diff - (1 - alpha) * (1 - sign) * diff\n312 |     output_errors = np.average(loss, weights=sample_weight, axis=0)\n313 | \n314 |     if isinstance(multioutput, str) and multioutput == \"raw_values\":\n315 |         return output_errors\n316 | \n317 |     if isinstance(multioutput, str) and multioutput == \"uniform_average\":\n318 |         # pass None as weights to np.average: uniform mean\n319 |         multioutput = None\n320 | \n321 |     return np.average(output_errors, weights=multioutput)\n```\n\nFound function `sklearn/metrics/_regression.py:mean_squared_log_error`.\nSource: Retrieved code content using keyword search (bm25).\n```\n615 | def mean_squared_log_error(\n616 |     y_true,\n617 |     y_pred,\n618 |     *,\n619 |     sample_weight=None,\n620 |     multioutput=\"uniform_average\",\n621 | ):\n622 |     \"\"\"Mean squared logarithmic error regression loss.\n623 | \n624 |     Read more in the :ref:`User Guide <mean_squared_log_error>`.\n625 | \n626 |     Parameters\n627 |     ----------\n628 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n629 |         Ground truth (correct) target values.\n630 | \n631 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n632 |         Estimated target values.\n633 | \n634 |     sample_weight : array-like of shape (n_samples,), default=None\n635 |         Sample weights.\n636 | \n637 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n638 |             (n_outputs,), default='uniform_average'\n639 | \n640 |         Defines aggregating of multiple output values.\n641 |         Array-like value defines weights used to average errors.\n642 | \n643 |         'raw_values' :\n644 |             Returns a full set of errors when the input is of multioutput\n645 |             format.\n646 | \n647 |         'uniform_average' :\n648 |             Errors of all outputs are averaged with uniform weight.\n649 | \n650 |     Returns\n651 |     -------\n652 |     loss : float or ndarray of floats\n653 |         A non-negative floating point value (the best value is 0.0), or an\n654 |         array of floating point values, one for each individual target.\n655 | \n656 |     Examples\n657 |     --------\n658 |     >>> from sklearn.metrics import mean_squared_log_error\n659 |     >>> y_true = [3, 5, 2.5, 7]\n660 |     >>> y_pred = [2.5, 5, 4, 8]\n661 |     >>> mean_squared_log_error(y_true, y_pred)\n662 |     0.039...\n663 |     >>> y_true = [[0.5, 1], [1, 2], [7, 6]]\n664 |     >>> y_pred = [[0.5, 2], [1, 2.5], [8, 8]]\n665 |     >>> mean_squared_log_error(y_true, y_pred)\n666 |     0.044...\n667 |     >>> mean_squared_log_error(y_true, y_pred, multioutput='raw_values')\n668 |     array([0.00462428, 0.08377444])\n669 |     >>> mean_squared_log_error(y_true, y_pred, multioutput=[0.3, 0.7])\n670 |     0.060...\n671 |     \"\"\"\n672 |     xp, _ = get_namespace(y_true, y_pred)\n673 |     dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n674 | \n675 |     _, y_true, y_pred, _ = _check_reg_targets(\n676 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n677 |     )\n678 | \n679 |     if xp.any(y_true <= -1) or xp.any(y_pred <= -1):\n680 |         raise ValueError(\n681 |             \"Mean Squared Logarithmic Error cannot be used when \"\n682 |             \"targets contain values less than or equal to -1.\"\n683 |         )\n684 | \n685 |     return mean_squared_error(\n686 |         xp.log1p(y_true),\n687 |         xp.log1p(y_pred),\n688 |         sample_weight=sample_weight,\n689 |         multioutput=multioutput,\n690 |     )\n```\n\nFound function `sklearn/metrics/_regression.py:median_absolute_error`.\nSource: Retrieved code content using keyword search (bm25).\n```\n779 | def median_absolute_error(\n780 |     y_true, y_pred, *, multioutput=\"uniform_average\", sample_weight=None\n781 | ):\n782 |     \"\"\"Median absolute error regression loss.\n783 | \n784 |     Median absolute error output is non-negative floating point. The best value\n785 |     is 0.0. Read more in the :ref:`User Guide <median_absolute_error>`.\n786 | \n787 |     Parameters\n788 |     ----------\n789 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n790 |         Ground truth (correct) target values.\n791 | \n792 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n793 |         Estimated target values.\n794 | \n795 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n796 |             (n_outputs,), default='uniform_average'\n797 |         Defines aggregating of multiple output values. Array-like value defines\n798 |         weights used to average errors.\n799 | \n800 |         'raw_values' :\n801 |             Returns a full set of errors in case of multioutput input.\n802 | \n803 |         'uniform_average' :\n804 |             Errors of all outputs are averaged with uniform weight.\n805 | \n806 |     sample_weight : array-like of shape (n_samples,), default=None\n807 |         Sample weights.\n808 | \n809 |         .. versionadded:: 0.24\n810 | \n811 |     Returns\n812 |     -------\n813 |     loss : float or ndarray of floats\n814 |         If multioutput is 'raw_values', then mean absolute error is returned\n815 |         for each output separately.\n816 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n817 |         weighted average of all output errors is returned.\n818 | \n819 |     Examples\n820 |     --------\n821 |     >>> from sklearn.metrics import median_absolute_error\n822 |     >>> y_true = [3, -0.5, 2, 7]\n823 |     >>> y_pred = [2.5, 0.0, 2, 8]\n824 |     >>> median_absolute_error(y_true, y_pred)\n825 |     np.float64(0.5)\n826 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n827 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n828 |     >>> median_absolute_error(y_true, y_pred)\n829 |     np.float64(0.75)\n830 |     >>> median_absolute_error(y_true, y_pred, multioutput='raw_values')\n831 |     array([0.5, 1. ])\n832 |     >>> median_absolute_error(y_true, y_pred, multioutput=[0.3, 0.7])\n833 |     np.float64(0.85)\n834 |     \"\"\"\n835 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n836 |         y_true, y_pred, multioutput\n837 |     )\n838 |     if sample_weight is None:\n839 |         output_errors = np.median(np.abs(y_pred - y_true), axis=0)\n840 |     else:\n841 |         sample_weight = _check_sample_weight(sample_weight, y_pred)\n842 |         output_errors = _weighted_percentile(\n843 |             np.abs(y_pred - y_true), sample_weight=sample_weight\n844 |         )\n845 |     if isinstance(multioutput, str):\n846 |         if multioutput == \"raw_values\":\n847 |             return output_errors\n848 |         elif multioutput == \"uniform_average\":\n849 |             # pass None as weights to np.average: uniform mean\n850 |             multioutput = None\n851 | \n852 |     return np.average(output_errors, weights=multioutput)\n```\n"}, {"content": "Let's focus on the actual calls to `_check_reg_targets` in `test_regression.py` to identify the relevant test cases.\n\n<function=search_code_snippets>\n<parameter=file_path_or_pattern>sklearn/metrics/tests/test_regression.py</parameter>\n<parameter=search_terms>[\"_check_reg_targets(\"]</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/metrics/_regression.py:_check_reg_targets\nsklearn/metrics/_regression.py:_check_reg_targets\nsklearn/metrics/_regression.py:mean_squared_log_error\nsklearn/metrics/_regression.py:median_absolute_error\nsklearn/metrics/_regression.py:mean_pinball_loss\nsklearn/metrics/_regression.py:max_error\nsklearn/metrics/_regression.py:explained_variance_score\nsklearn/metrics/_regression.py:d2_tweedie_score\nsklearn/metrics/_regression.py:mean_squared_error\nsklearn/metrics/_regression.py:mean_absolute_error\nNo files found for file pattern 'sklearn/metrics/tests/test_regression.py'. Will search all files.\n...\n##Searching for term \"_check_reg_targets(\"...\n### Search Result:\nFound function `sklearn/metrics/_regression.py:_check_reg_targets`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 58 | def _check_reg_targets(y_true, y_pred, multioutput, dtype=\"numeric\", xp=None):\n 59 |     \"\"\"Check that y_true and y_pred belong to the same regression task.\n 60 | \n 61 |     Parameters\n 62 |     ----------\n 63 |     y_true : array-like\n 64 | \n 65 |     y_pred : array-like\n 66 | \n 67 |     multioutput : array-like or string in ['raw_values', uniform_average',\n 68 |         'variance_weighted'] or None\n 69 |         None is accepted