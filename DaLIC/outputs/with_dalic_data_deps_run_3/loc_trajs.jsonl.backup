ose=self.verbose,\n2148 |             random_state=random_state,\n2149 |             positive=self.positive_dict,\n2150 |         )\n2151 | \n2152 |         return batch_cost\n```\n\n\n\n##Searching for term \"minibatch_nmf\"...\n### Search Result:\nFound function `examples/applications/plot_out_of_core_classification.py:get_minibatch`.\nSource: Retrieved entity using keyword search (bm25).\n```\n212 | def get_minibatch(doc_iter, size, pos_class=positive_class):\n213 |     \"\"\"Extract a minibatch of examples, return a tuple X_text, y.\n214 | \n215 |     Note: size is before excluding invalid docs with no topics assigned.\n216 | \n217 |     \"\"\"\n218 |     data = [\n219 |         (\"{title}\\n\\n{body}\".format(**doc), pos_class in doc[\"topics\"])\n220 |         for doc in itertools.islice(doc_iter, size)\n221 |         if doc[\"topics\"]\n222 |     ]\n223 |     if not len(data):\n224 |         return np.asarray([], dtype=int), np.asarray([], dtype=int)\n225 |     X_text, y = zip(*data)\n226 |     return X_text, np.asarray(y, dtype=int)\n```\n\nFound file `sklearn/svm/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/svm/__init__.py` for the full content if needed.\n\n\n\n##Searching for term \"minibatch_nmf\", \"OnlineNMF\", \"_online_nmf\", \"minibatch_nmf OnlineNMF _online_nmf\"...\n### Search Result:\nFound class `sklearn/cross_decomposition/_pls.py:PLSRegression`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSRegression(_PLS):\n\n    # This implementation provides the same results that 3 PLS packages\n    # provided in the R language (R-project):\n    #     - \"mixOmics\" with function pls(X, Y, mode = \"regression\")\n    #     - \"plspm \" with function plsreg2(X, Y)\n    #     - \"pls\" with function oscorespls.fit(X, Y)\n\n    def __init__(\n        self, n_components=2, *, scale=True, max_iter=500, tol=1e-06