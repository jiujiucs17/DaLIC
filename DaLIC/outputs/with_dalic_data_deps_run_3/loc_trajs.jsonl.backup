eader_mi\npandas/core/generic.py:NDFrame.to_excel\npandas/core/generic.py:NDFrame.to_json\npandas/io/formats/excel.py:ExcelFormatter\npandas/io/excel/_openpyxl.py:OpenpyxlWriter._write_cells\npandas/core/computation/pytables.py:TermValue\npandas/core/computation/pytables.py:TermValue.__init__\npandas/core/computation/pytables.py:TermValue.tostring\npandas/core/computation/pytables.py:maybe_expression\npandas/core/computation/pytables.py:_validate_where\npandas/core/computation/scope.py:Scope._get_vars\n##Searching for term \"to_excel\", \"merge_cells\"...\n### Search Result:\nFound function `pandas/core/generic.py:NDFrame.to_excel`.\nSource: Match found for entity name `to_excel`.\n```\n2150 | def to_excel(\n2151 |         self,\n2152 |         excel_writer: FilePath | WriteExcelBuffer | ExcelWriter,\n2153 |         *,\n2154 |         sheet_name: str = \"Sheet1\",\n2155 |         na_rep: str = \"\",\n2156 |         float_format: str | None = None,\n2157 |         columns: Sequence[Hashable] | None = None,\n2158 |         header: Sequence[Hashable] | bool = True,\n2159 |         index: bool = True,\n2160 |         index_label: IndexLabel | None = None,\n2161 |         startrow: int = 0,\n2162 |         startcol: int = 0,\n2163 |         engine: Literal[\"openpyxl\", \"xlsxwriter\"] | None = None,\n2164 |         merge_cells: bool = True,\n2165 |         inf_rep: str = \"inf\",\n2166 |         freeze_panes: tuple[int, int] | None = None,\n2167 |         storage_options: StorageOptions | None = None,\n2168 |         engine_kwargs: dict[str, Any] | None = None,\n2169 |     ) -> None:\n2170 |         \"\"\"\n2171 |         Write {klass} to an Excel sheet.\n2172 | \n2173 |         To write a single {klass} to an Excel .xlsx file it is only necessary to\n2174 |         specify a target file name. To write to multiple sheets it is necessary to\n2175 |         create an `ExcelWriter` object with a target file name, and specify a sheet\n2176 |         in the file to write to.\n2177 | \n2178 |         Multiple sheets may be written to by specifying unique `sheet_name`.\n2179 |         With all data written to the file it is necessary to save the changes.\n2180 |         Note that creating an `ExcelWriter` object with a file name that already\n2181 |         exists will result in the contents of the existing file being erased.\n2182 | \n2183 |         Parameters\n2184 |         ----------\n2185 |         excel_writer : path-like, file-like, or ExcelWriter object\n2186 |             File path or existing ExcelWriter.\n2187 |         sheet_name : str, default 'Sheet1'\n2188 |             Name of sheet which will contain DataFrame.\n2189 |         na_rep : str, default ''\n2190 |             Missing data representation.\n2191 |         float_format : str, optional\n2192 |             Format string for floating point numbers. For example\n2193 |             ``float_format=\"%.2f\"`` will format 0.1234 to 0.12.\n2194 |         columns : sequence or list of str, optional\n2195 |             Columns to write.\n2196 |         header : bool or list of str, default True\n2197 |             Write out the column names. If a list of string is given it is\n2198 |             assumed to be aliases for the column names.\n2199 |         index : bool, default True\n2200 |             Write row names (index).\n2201 |         index_label : str or sequence, optional\n2202 |             Column label for index column(s) if desired. If not specified, and\n2203 |             `header` and `index` are True, then the index names are used. A\n2204 |             sequence should be given if the DataFrame uses MultiIndex.\n2205 |         startrow : int, default 0\n2206 |             Upper left cell row to dump data frame.\n2207 |         startcol : int, default 0\n2208 |             Upper left cell column to dump data frame.\n2209 |         engine : str, optional\n2210 |             Write engine to use, 'openpyxl' or 'xlsxwriter'. You can also set this\n2211 |             via the options ``io.excel.xlsx.writer`` or\n2212 |             ``io.excel.xlsm.writer``.\n2213 | \n2214 |         merge_cells : bool, default True\n2215 |             Write MultiIndex and Hierarchical Rows as merged cells.\n2216 |         {encoding_parameter}\n2217 |         inf_rep : str, default 'inf'\n2218 |             Representation for infinity (there is no native representation for\n2219 |             infinity in Excel).\n2220 |         {verbose_parameter}\n2221 |         freeze_panes : tuple of int (length 2), optional\n2222 |             Specifies the one-based bottommost row and rightmost column that\n2223 |             is to be frozen.\n2224 |         {storage_options}\n2225 | \n2226 |             .. versionadded:: {storage_options_versionadded}\n2227 |         {extra_parameters}\n2228 |         See Also\n2229 |         --------\n2230 |         to_csv : Write DataFrame to a comma-separated values (csv) file.\n2231 |         ExcelWriter : Class for writing DataFrame objects into excel sheets.\n2232 |         read_excel : Read an Excel file into a pandas DataFrame.\n2233 |         read_csv : Read a comma-separated values (csv) file into DataFrame.\n2234 |         io.formats.style.Styler.to_excel : Add styles to Excel sheet.\n2235 | \n2236 |         Notes\n2237 |         -----\n2238 |         For compatibility with :meth:`~DataFrame.to_csv`,\n2239 |         to_excel serializes lists and dicts to strings before writing.\n2240 | \n2241 |         Once a workbook has been saved it is not possible to write further\n2242 |         data without rewriting the whole workbook.\n2243 | \n2244 |         pandas will check the number of rows, columns,\n2245 |         and cell character count does not exceed Excel's limitations.\n2246 |         All other limitations must be checked by the user.\n2247 | \n2248 |         Examples\n2249 |         --------\n2250 | \n2251 |         Create, write to and save a workbook:\n2252 | \n2253 |         >>> df1 = pd.DataFrame(\n2254 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2255 |         ...     index=[\"row 1\", \"row 2\"],\n2256 |         ...     columns=[\"col 1\", \"col 2\"],\n2257 |         ... )\n2258 |         >>> df1.to_excel(\"output.xlsx\")  # doctest: +SKIP\n2259 | \n2260 |         To specify the sheet name:\n2261 | \n2262 |         >>> df1.to_excel(\"output.xlsx\", sheet_name=\"Sheet_name_1\")  # doctest: +SKIP\n2263 | \n2264 |         If you wish to write to more than one sheet in the workbook, it is\n2265 |         necessary to specify an ExcelWriter object:\n2266 | \n2267 |         >>> df2 = df1.copy()\n2268 |         >>> with pd.ExcelWriter(\"output.xlsx\") as writer:  # doctest: +SKIP\n2269 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_1\")\n2270 |         ...     df2.to_excel(writer, sheet_name=\"Sheet_name_2\")\n2271 | \n2272 |         ExcelWriter can also be used to append to an existing Excel file:\n2273 | \n2274 |         >>> with pd.ExcelWriter(\"output.xlsx\", mode=\"a\") as writer:  # doctest: +SKIP\n2275 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_3\")\n2276 | \n2277 |         To set the library that is used to write the Excel file,\n2278 |         you can pass the `engine` keyword (the default engine is\n2279 |         automatically chosen depending on the file extension):\n2280 | \n2281 |         >>> df1.to_excel(\"output1.xlsx\", engine=\"xlsxwriter\")  # doctest: +SKIP\n2282 |         \"\"\"\n2283 |         if engine_kwargs is None:\n2284 |             engine_kwargs = {}\n2285 | \n2286 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n2287 | \n2288 |         from pandas.io.formats.excel import ExcelFormatter\n2289 | \n2290 |         formatter = ExcelFormatter(\n2291 |             df,\n2292 |             na_rep=na_rep,\n2293 |             cols=columns,\n2294 |             header=header,\n2295 |             float_format=float_format,\n2296 |             index=index,\n2297 |             index_label=index_label,\n2298 |             merge_cells=merge_cells,\n2299 |             inf_rep=inf_rep,\n2300 |         )\n2301 |         formatter.write(\n2302 |             excel_writer,\n2303 |             sheet_name=sheet_name,\n2304 |             startrow=startrow,\n2305 |             startcol=startcol,\n2306 |             freeze_panes=freeze_panes,\n2307 |             engine=engine,\n2308 |             storage_options=storage_options,\n2309 |             engine_kwargs=engine_kwargs,\n2310 |         )\n```\n\nFound function `pandas/io/formats/style.py:Styler.to_excel`.\nSource: Match found for entity name `to_excel`.\n```\n571 | def to_excel(\n572 |         self,\n573 |         excel_writer: FilePath | WriteExcelBuffer | ExcelWriter,\n574 |         sheet_name: str = \"Sheet1\",\n575 |         na_rep: str = \"\",\n576 |         float_format: str | None = None,\n577 |         columns: Sequence[Hashable] | None = None,\n578 |         header: Sequence[Hashable] | bool = True,\n579 |         index: bool = True,\n580 |         index_label: IndexLabel | None = None,\n581 |         startrow: int = 0,\n582 |         startcol: int = 0,\n583 |         engine: str | None = None,\n584 |         merge_cells: ExcelWriterMergeCells = True,\n585 |         encoding: str | None = None,\n586 |         inf_rep: str = \"inf\",\n587 |         verbose: bool = True,\n588 |         freeze_panes: tuple[int, int] | None = None,\n589 |         storage_options: StorageOptions | None = None,\n590 |     ) -> None:\n591 |         from pandas.io.formats.excel import ExcelFormatter\n592 | \n593 |         formatter = ExcelFormatter(\n594 |             self,\n595 |             na_rep=na_rep,\n596 |             cols=columns,\n597 |             header=header,\n598 |             float_format=float_format,\n599 |             index=index,\n600 |             index_label=index_label,\n601 |             merge_cells=merge_cells,\n602 |             inf_rep=inf_rep,\n603 |         )\n604 |         formatter.write