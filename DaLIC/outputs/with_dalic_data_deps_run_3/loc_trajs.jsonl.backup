tacker(ax, stacking_id, len(y))\n1237 |         y_values = cls._get_stacked_values(ax, stacking_id, y, kwds[\"label\"])\n1238 |         lines = MPLPlot._plot(ax, x, y_values, style=style, **kwds)\n1239 |         cls._update_stacker(ax, stacking_id, y)\n1240 |         return lines\n1241 | \n1242 |     @classmethod\n1243 |     def _ts_plot(cls, ax: Axes, x, data, style=None, **kwds):\n1244 |         # accept x to be consistent with normal plot func,\n1245 |         # x is not passed to tsplot as it uses data.index as x coordinate\n1246 |         # column_num must be in kwds for stacking purpose\n1247 |         freq, data = maybe_resample(data, ax, kwds)\n1248 | \n1249 |         # Set ax with freq info\n1250 |         decorate_axes(ax, freq, kwds)\n1251 |         # digging deeper\n1252 |         if hasattr(ax, \"left_ax\"):\n1253 |             decorate_axes(ax.left_ax, freq, kwds)\n1254 |         if hasattr(ax, \"right_ax\"):\n1255 |             decorate_axes(ax.right_ax, freq, kwds)\n1256 |         ax._plot_data.append((data, cls._kind, kwds))\n1257 | \n1258 |         lines = cls._plot(ax, data.index, data.values, style=style, **kwds)\n1259 |         # set date formatter, locators and rescale limits\n1260 |         format_dateaxis(ax, ax.freq, data.index)\n1261 |         return lines\n1262 | \n1263 |     def _get_stacking_id(self):\n1264 |         if self.stacked:\n1265 |             return id(self.data)\n1266 |         else:\n1267 |             return None\n1268 | \n1269 |     @classmethod\n1270 |     def _initialize_stacker(cls, ax: Axes, stacking_id, n: int):\n1271 |         if stacking_id is None:\n1272 |             return\n1273 |         if not hasattr(ax, \"_stacker_pos_prior\"):\n1274 |             ax._stacker_pos_prior = {}\n1275 |         if not hasattr(ax, \"_stacker_neg_prior\"):\n1276 |             ax._stacker_neg_prior = {}\n1277 |         ax._stacker_pos_prior[stacking_id] = np.zeros(n)\n1278 |         ax._stacker_neg_prior[stacking_id] = np.zeros(n)\n1