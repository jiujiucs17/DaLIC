5 |         # stroke (and the amount of alpha for each) is the same for\n2036 |         # all of them\n2037 |         can_do_optimization = True\n2038 |         facecolors = np.asarray(facecolors)\n2039 |         edgecolors = np.asarray(edgecolors)\n2040 | \n2041 |         if not len(facecolors):\n2042 |             filled = False\n2043 |             can_do_optimization = not gc.get_hatch()\n2044 |         else:\n2045 |             if np.all(facecolors[:, 3] == facecolors[0, 3]):\n2046 |                 filled = facecolors[0, 3] != 0.0\n2047 |             else:\n2048 |                 can_do_optimization = False\n2049 | \n2050 |         if not len(edgecolors):\n2051 |             stroked = False\n2052 |         else:\n2053 |             if np.all(np.asarray(linewidths) == 0.0):\n2054 |                 stroked = False\n2055 |             elif np.all(edgecolors[:, 3] == edgecolors[0, 3]):\n2056 |                 stroked = edgecolors[0, 3] != 0.0\n2057 |             else:\n2058 |                 can_do_optimization = False\n2059 | \n2060 |         # Is the optimization worth it? Rough calculation:\n2061 |         # cost of emitting a path in-line is len_path * uses_per_path\n2062 |         # cost of XObject is len_path + 5 for the definition,\n2063 |         #    uses_per_path for the uses\n2064 |         len_path = len(paths[0].vertices) if len(paths) > 0 else 0\n2065 |         uses_per_path = self._iter_collection_uses_per_path(\n2066 |             paths, all_transforms, offsets, facecolors, edgecolors)\n2067 |         should_do_optimization = \\\n2068 |             len_path + uses_per_path + 5 < len_path * uses_per_path\n2069 | \n2070 |         if (not can_do_optimization) or (not should_do_optimization):\n2071 |             return RendererBase.draw_path_collection(\n2072 |                 self, gc, master_transform, paths, all_transforms,\n2073 |                 offsets, offset_trans, facecolors, edgecolors,\n2074 |                 linewidths, linestyles, antialias