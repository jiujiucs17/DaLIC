ines.linewidth`\n1624 |             The width of each line in points.\n1625 |         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n1626 |             A sequence of RGBA tuples (e.g., arbitrary color strings, etc, not\n1627 |             allowed).\n1628 |         antialiaseds : bool or list of bool, default: :rc:`lines.antialiased`\n1629 |             Whether to use antialiasing for each line.\n1630 |         zorder : float, default: 2\n1631 |             zorder of the lines once drawn.\n1632 | \n1633 |         facecolors : :mpltype:`color` or list of :mpltype:`color`, default: 'none'\n1634 |             When setting *facecolors*, each line is interpreted as a boundary\n1635 |             for an area, implicitly closing the path from the last point to the\n1636 |             first point. The enclosed area is filled with *facecolor*.\n1637 |             In order to manually specify what should count as the \"interior\" of\n1638 |             each line, please use `.PathCollection` instead, where the\n1639 |             \"interior\" can be specified by appropriate usage of\n1640 |             `~.path.Path.CLOSEPOLY`.\n1641 | \n1642 |         **kwargs\n1643 |             Forwarded to `.Collection`.\n1644 |         \"\"\"\n1645 |         # Unfortunately, mplot3d needs this explicit setting of 'facecolors'.\n1646 |         kwargs.setdefault('facecolors', 'none')\n1647 |         super().__init__(\n1648 |             zorder=zorder,\n1649 |             **kwargs)\n1650 |         self.set_segments(segments)\n1651 | \n1652 |     def set_segments(self, segments):\n1653 |         if segments is None:\n1654 |             return\n1655 | \n1656 |         self._paths = [mpath.Path(seg) if isinstance(seg, np.ma.MaskedArray)\n1657 |                        else mpath.Path(np.asarray(seg, float))\n1658 |                        for seg in segments]\n1659 |         self.stale = True\n1660 | \n1661 |     set_verts = set_segments  # for compatibility with PolyCollection\n1662 |     set_paths = set_segments\n1663 | \n1664 |     def get_segments(self):\n1665 |         \"\"\"\n1666 |         Returns\n1667 |         -------\n1668 |         list\n1669 |             List of segments in the LineCollection. Each list item contains an\n1670 |             array of vertices.\n1671 |         \"\"\"\n1672 |         segments = []\n1673 | \n1674 |         for path in self._paths:\n1675 |             vertices = [\n1676 |                 vertex\n1677 |                 for vertex, _\n1678 |                 # Never simplify here, we want to get the data-space values\n1679 |                 # back and there in no way to know the \"right\" simplification\n1680 |                 # threshold so never try.\n1681 |                 in path.iter_segments(simplify=False)\n1682 |             ]\n1683 |             vertices = np.asarray(vertices)\n1684 |             segments.append(vertices)\n1685 | \n1686 |         return segments\n1687 | \n1688 |     def _get_default_linewidth(self):\n1689 |         return mpl.rcParams['lines.linewidth']\n1690 | \n1691 |     def _get_default_antialiased(self):\n1692 |         return mpl.rcParams['lines.antialiased']\n1693 | \n1694 |     def _get_default_edgecolor(self):\n1695 |         return mpl.rcParams['lines.color']\n1696 | \n1697 |     def _get_default_facecolor(self):\n1698 |         return 'none'\n1699 | \n1700 |     def set_alpha(self, alpha):\n1701 |         # docstring inherited\n1702 |         super().set_alpha(alpha)\n1703 |         if self._gapcolor is not None:\n1704 |             self.set_gapcolor(self._original_gapcolor)\n1705 | \n1706 |     def set_color(self, c):\n1707 |         \"\"\"\n1708 |         Set the edgecolor(s) of the LineCollection.\n1709 | \n1710 |         Parameters\n1711 |         ----------\n1712 |         c : :mpltype:`color` or list of :mpltype:`color`\n1713 |             Single color (all lines have same color), or a\n1714 |             sequence of RGBA tuples; if it is a sequence the