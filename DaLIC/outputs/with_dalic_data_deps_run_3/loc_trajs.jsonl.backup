ndex\n2624 |         data : ndarraylike to become a column\n2625 |         \"\"\"\n2626 |         assert isinstance(values, np.ndarray), type(values)\n2627 | \n2628 |         # values is a recarray\n2629 |         if values.dtype.fields is not None:\n2630 |             values = values[self.cname]\n2631 | \n2632 |         assert self.typ is not None\n2633 |         if self.dtype is None:\n2634 |             # Note: in tests we never have timedelta64 or datetime64,\n2635 |             #  so the _get_data_and_dtype_name may be unnecessary\n2636 |             converted, dtype_name = _get_data_and_dtype_name(values)\n2637 |             kind = _dtype_to_kind(dtype_name)\n2638 |         else:\n2639 |             converted = values\n2640 |             dtype_name = self.dtype\n2641 |             kind = self.kind\n2642 | \n2643 |         assert isinstance(converted, np.ndarray)  # for mypy\n2644 | \n2645 |         # use the meta if needed\n2646 |         meta = self.meta\n2647 |         metadata = self.metadata\n2648 |         ordered = self.ordered\n2649 |         tz = self.tz\n2650 | \n2651 |         assert dtype_name is not None\n2652 |         # convert to the correct dtype\n2653 |         dtype = dtype_name\n2654 | \n2655 |         # reverse converts\n2656 |         if dtype.startswith(\"datetime64\"):\n2657 |             # recreate with tz if indicated\n2658 |             converted = _set_tz(converted, tz, dtype)\n2659 | \n2660 |         elif dtype == \"timedelta64\":\n2661 |             converted = np.asarray(converted, dtype=\"m8[ns]\")\n2662 |         elif dtype == \"date\":\n2663 |             try:\n2664 |                 converted = np.asarray(\n2665 |                     [date.fromordinal(v) for v in converted], dtype=object\n2666 |                 )\n2667 |             except ValueError:\n2668 |                 converted = np.asarray(\n2669 |                     [date.fromtimestamp(v) for v in converted], dtype=object\n2670 |                 )\n2671 | \n2672 |         elif meta == \"category\":\n2673 |             # we have a categorical\n2674 |             categories = metadata\n2675 |             codes = converted.ravel()\n2676 | \n2677 |             # if we have stored a NaN in the categories\n2678 |             # then strip it; in theory we could have BOTH\n2679 |             # -1s in the codes and nulls :<\n2680 |             if categories is None:\n2681 |                 # Handle case of NaN-only categorical columns in which case\n2682 |                 # the categories are an empty array; when this is stored,\n2683 |                 # pytables cannot write a zero-len array, so on readback\n2684 |                 # the categories would be None and `read_hdf()` would fail.\n2685 |                 categories = Index([], dtype=np.float64)\n2686 |             else:\n2687 |                 mask = isna(categories)\n2688 |                 if mask.any():\n2689 |                     categories = categories[~mask]\n2690 |                     codes[codes != -1] -= mask.astype(int).cumsum()._values\n2691 | \n2692 |             converted = Categorical.from_codes(\n2693 |                 codes, categories=categories, ordered=ordered, validate=False\n2694 |             )\n2695 | \n2696 |         else:\n2697 |             try:\n2698 |                 converted = converted.astype(dtype, copy=False)\n2699 |             except TypeError:\n2700 |                 converted = converted.astype(\"O\", copy=False)\n2701 | \n2702 |         # convert nans / decode\n2703 |         if kind == \"string\":\n2704 |             converted = _unconvert_string_array(\n2705 |                 converted, nan_rep=nan_rep, encoding=encoding, errors=errors\n2706 |             )\n2707 | \n2708 |         return self.values, converted\n```\n\nFound function `pandas/io/pytables.py:DataCol.set_attr`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2710 | def set_attr(self) -> None:\n2711 |         \"\"\"set the data for this column\"\"\"\n2712 |