2529 |         [\n2530 |             [\n2531 |                 \"a\",\n2532 |                 \"b\"\n2533 |             ],\n2534 |             [\n2535 |                 \"c\",\n2536 |                 \"d\"\n2537 |             ]\n2538 |         ]\n2539 | \n2540 |         Encoding with Table Schema:\n2541 | \n2542 |         >>> result = df.to_json(orient=\"table\")\n2543 |         >>> parsed = loads(result)\n2544 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2545 |         {{\n2546 |             \"schema\": {{\n2547 |                 \"fields\": [\n2548 |                     {{\n2549 |                         \"name\": \"index\",\n2550 |                         \"type\": \"string\"\n2551 |                     }},\n2552 |                     {{\n2553 |                         \"name\": \"col 1\",\n2554 |                         \"type\": \"string\"\n2555 |                     }},\n2556 |                     {{\n2557 |                         \"name\": \"col 2\",\n2558 |                         \"type\": \"string\"\n2559 |                     }}\n2560 |                 ],\n2561 |                 \"primaryKey\": [\n2562 |                     \"index\"\n2563 |                 ],\n2564 |                 \"pandas_version\": \"1.4.0\"\n2565 |             }},\n2566 |             \"data\": [\n2567 |                 {{\n2568 |                     \"index\": \"row 1\",\n2569 |                     \"col 1\": \"a\",\n2570 |                     \"col 2\": \"b\"\n2571 |                 }},\n2572 |                 {{\n2573 |                     \"index\": \"row 2\",\n2574 |                     \"col 1\": \"c\",\n2575 |                     \"col 2\": \"d\"\n2576 |                 }}\n2577 |             ]\n2578 |         }}\n2579 |         \"\"\"\n2580 |         from pandas.io import json\n2581 | \n2582 |         if date_format is None and orient == \"table\":\n2583 |             date_format = \"iso\"\n2584 |         elif date_format is None:\n2585 |             date_format = \"epoch\"\n2586 |             dtypes = self.dtypes if self.ndim == 2 else [self.dtype]\n2587 |             if any(lib.is_np_dtype(dtype, \"mM\") for dtype in dtypes):\n2588 |                 warnings.warn(\n2589 |                     \"The default 'epoch' date format is deprecated and will be removed \"\n2590 |                     \"in a future version, please use 'iso' date format instead.\",\n2591 |                     FutureWarning,\n2592 |                     stacklevel=find_stack_level(),\n2593 |                 )\n2594 |         elif date_format == \"epoch\":\n2595 |             # GH#57063\n2596 |             warnings.warn(\n2597 |                 \"'epoch' date format is deprecated and will be removed in a future \"\n2598 |                 \"version, please use 'iso' date format instead.\",\n2599 |                 FutureWarning,\n2600 |                 stacklevel=find_stack_level(),\n2601 |             )\n2602 | \n2603 |         config.is_nonnegative_int(indent)\n2604 |         indent = indent or 0\n2605 | \n2606 |         return json.to_json(\n2607 |             path_or_buf=path_or_buf,\n2608 |             obj=self,\n2609 |             orient=orient,\n2610 |             date_format=date_format,\n2611 |             double_precision=double_precision,\n2612 |             force_ascii=force_ascii,\n2613 |             date_unit=date_unit,\n2614 |             default_handler=default_handler,\n2615 |             lines=lines,\n2616 |             compression=compression,\n2617 |             index=index,\n2618 |             indent=indent,\n2619 |             storage_options=storage_options,\n2620 |             mode=mode,\n2621 |         )\n```\n\nFound class `asv_bench/benchmarks/join_merge.py:Concat`.\nSource: Retrieved entity using keyword search (bm25).\n```\n23 | class Concat:\n24 |     params = [0, 1]\n25 |     param_names = [\"axis\"]\n26 | \n27 |     def setup(self, axis):\n28 |         N = 1000\n29 |         s = Series(N, index=Index([f\"i-{i}\" for i in range(N)], dtype=object))\n30 |         self.series = [s[i:-i] for i in range(1, 10)] * 50\n31 |         self.small_frames = [DataFrame(np.random.randn(5, 4))] * 1000\n32 |         df = DataFrame(\n33 |             {\"A\": range(N)}, index=date_range(\"20130101\", periods=N, freq=\"s\")\n34 |         )\n35 |         self.empty_left = [DataFrame(), df]\n36 |         self.empty_right = [df, DataFrame()]\n37 |         self.mixed_ndims = [df, df.head(N // 2)]\n38 | \n39 |     def time_concat_series(self, axis):\n40 |         concat(self.series, axis=axis, sort=False)\n41 | \n42 |     def time_concat_small_frames(self, axis):\n43 |         concat(self.small_frames, axis=axis)\n44 | \n45 |     def time_concat_empty_right(self, axis):\n46 |         concat(self.empty_right, axis=axis)\n47 | \n48 |     def time_concat_empty_left(self, axis):\n49 |         concat(self.empty_left, axis=axis)\n50 | \n51 |     def time_concat_mixed_ndims(self, axis):\n52 |         concat(self.mixed_ndims, axis=axis)\n```\n\nFound function `pandas/io/formats/excel.py:ExcelFormatter._format_header_mi`.\nSource: Retrieved code content using keyword search (bm25).\n```\n611 | def _format_header_mi(self) -> Iterable[ExcelCell]:\n612 |         if self.columns.nlevels > 1:\n613 |             if not self.index:\n614 |                 raise NotImplementedError(\n615 |                     \"Writing to Excel with MultiIndex columns and no \"\n616 |                     \"index ('index'=False) is not yet implemented.\"\n617 |                 )\n618 | \n619 |         if not (self._has_aliases or self.header):\n620 |             return\n621 | \n622 |         columns = self.columns\n623 |         level_strs = columns._format_multi(\n624 |             sparsify=self.merge_cells in {True, \"columns\"}, include_names=False\n625 |         )\n626 |         level_lengths = get_level_lengths(level_strs)\n627 |         coloffset = 0\n628 |         lnum = 0\n629 | \n630 |         if self.index and isinstance(self.df.index, MultiIndex):\n631 |             coloffset = self.df.index.nlevels - 1\n632 | \n633 |         if self.merge_cells in {True, \"columns\"}:\n634 |             # Format multi-index as a merged cells.\n635 |             for lnum, name in enumerate(columns.names):\n636 |                 yield ExcelCell(\n637 |                     row=lnum,\n638 |                     col=coloffset,\n639 |                     val=name,\n640 |                     style=None,\n641 |                 )\n642 | \n643 |             for lnum, (spans, levels, level_codes) in enumerate(\n644 |                 zip(level_lengths, columns.levels, columns.codes)\n645 |             ):\n646 |                 values = levels.take(level_codes)\n647 |                 for i, span_val in spans.items():\n648 |                     mergestart, mergeend = None, None\n649 |                     if span_val > 1:\n650 |                         mergestart, mergeend = lnum, coloffset + i + span_val\n651 |                     yield CssExcelCell(\n652 |                         row=lnum,\n653 |                         col=coloffset + i + 1,\n654 |                         val=values[i],\n655 |                         style=None,\n656 |                         css_styles=getattr(self.styler, \"ctx_columns\", None),\n657 |                         css_row=lnum,\n658 |                         css_col=i,\n659 |                         css_converter=self.style_converter,\n660 |                         mergestart=mergestart,\n661 |                         mergeend=mergeend,\n662 |                     )\n663 |         else:\n664 |             # Format in legacy format with dots to indicate levels.\n665 |             for i, values in enumerate(zip(*level_strs)):\n666 |                 v = \".\".join(map(pprint_thing, values))\n667 |                 yield CssExcelCell(\n668 |                     row=lnum,\n669 |                     col=coloffset + i + 1,\n670 |                     val=v,\n671 |                     style=None,\n672 |                     css_styles=getattr(self.styler, \"ctx_columns\", None),\n673 |                     css_row=lnum,\n674 |                     css_col=i,\n675 |                     css_converter=self.style_converter,\n676 |                 )\n677 | \n678 |         self.rowcounter = lnum\n```\n\nFound function `pandas/io/formats/excel.py:ExcelFormatter._format_hierarchical_rows`.\nSource: Retrieved code content using keyword search (bm25).\n```\n785 | def _format_hierarchical_rows(self) -> Iterable[ExcelCell]:\n786 |         if self._has_aliases or self.header:\n787 |             self.rowcounter += 1\n788 | \n789 |         gcolidx = 0\n790 | \n791 |         if self.index:\n792 |             index_labels = self.df.index.names\n793 |             # check for aliases\n794 |             if self.index_label and isinstance(\n795 |                 self.index_label, (list, tuple, np.ndarray, Index)\n796 |             ):\n797 |                 index_labels = self.index_label\n798 | \n799 |             # MultiIndex columns require an extra row\n800 |             # with index names (blank if None) for\n801 |             # unambiguous round-trip, unless not merging,\n802 |             # in which case the names all go on one row Issue #11328\n803 |             if isinstance(self.columns, MultiIndex) and (\n804 |                 self.merge_cells in {True, \"columns\"}\n805 |             ):\n806 |                 self.rowcounter += 1\n807 | \n808 |             # if index labels are not empty go ahead and dump\n809 |             if com.any_not_none(*index_labels) and self.header is not False:\n810 |                 for cidx, name in enumerate(index_labels):\n811 |                     yield ExcelCell(self.rowcounter - 1, cidx, name, None)\n812 | \n813 |             if self.merge_cells and self.merge_cells != \"columns\":\n814 |                 # Format hierarchical rows as merged cells.\n815 |                 level_strs = self.df.index._format_multi(\n816 |                     sparsify