|     estimator_name = _check_estimator_name(estimator)\n 987 |     context = \" by %s\" % estimator_name if estimator is not None else \"\"\n 988 | \n 989 |     # When all dataframe columns are sparse, convert to a sparse array\n 990 |     if hasattr(array, \"sparse\") and array.ndim > 1:\n 991 |         with suppress(ImportError):\n 992 |             from pandas import SparseDtype  # noqa: F811\n 993 | \n 994 |             def is_sparse(dtype):\n 995 |                 return isinstance(dtype, SparseDtype)\n 996 | \n 997 |             if array.dtypes.apply(is_sparse).all():\n 998 |                 # DataFrame.sparse only supports `to_coo`\n 999 |                 array = array.sparse.to_coo()\n1000 |                 if array.dtype == np.dtype(\"object\"):\n1001 |                     unique_dtypes = set([dt.subtype.name for dt in array_orig.dtypes])\n1002 |                     if len(unique_dtypes) > 1:\n1003 |                         raise ValueError(\n1004 |                             \"Pandas DataFrame with mixed sparse extension arrays \"\n1005 |                             \"generated a sparse matrix with object dtype which \"\n1006 |                             \"can not be converted to a scipy sparse matrix.\"\n1007 |                             \"Sparse extension arrays should all have the same \"\n1008 |                             \"numeric type.\"\n1009 |                         )\n1010 | \n1011 |     if sp.issparse(array):\n1012 |         _ensure_no_complex_data(array)\n1013 |         array = _ensure_sparse_format(\n1014 |             array,\n1015 |             accept_sparse=accept_sparse,\n1016 |             dtype=dtype,\n1017 |             copy=copy,\n1018 |             ensure_all_finite=ensure_all_finite,\n1019 |             accept_large_sparse=accept_large_sparse,\n1020 |             estimator_name=estimator_name,\n1021 |             input_name=input_name,\n1022 |         )\n1023 |         if ensure_2d and array.ndim < 2:\n1024 |             raise Va