     # prefixes of others.\n 28 |     STYLE_MAPPING: dict[str, list[tuple[tuple[str, ...], str]]] = {\n 29 |         \"font\": [\n 30 |             ((\"name\",), \"font_name\"),\n 31 |             ((\"sz\",), \"font_size\"),\n 32 |             ((\"size\",), \"font_size\"),\n 33 |             ((\"color\", \"rgb\"), \"font_color\"),\n 34 |             ((\"color\",), \"font_color\"),\n 35 |             ((\"b\",), \"bold\"),\n 36 |             ((\"bold\",), \"bold\"),\n 37 |             ((\"i\",), \"italic\"),\n 38 |             ((\"italic\",), \"italic\"),\n 39 |             ((\"u\",), \"underline\"),\n 40 |             ((\"underline\",), \"underline\"),\n 41 |             ((\"strike\",), \"font_strikeout\"),\n 42 |             ((\"vertAlign\",), \"font_script\"),\n 43 |             ((\"vertalign\",), \"font_script\"),\n 44 |         ],\n 45 |         \"number_format\": [((\"format_code\",), \"num_format\"), ((), \"num_format\")],\n 46 |         \"protection\": [((\"locked\",), \"locked\"), ((\"hidden\",), \"hidden\")],\n 47 |         \"alignment\": [\n 48 |             ((\"horizontal\",), \"align\"),\n 49 |             ((\"vertical\",), \"valign\"),\n 50 |             ((\"text_rotation\",), \"rotation\"),\n 51 |             ((\"wrap_text\",), \"text_wrap\"),\n 52 |             ((\"indent\",), \"indent\"),\n 53 |             ((\"shrink_to_fit\",), \"shrink\"),\n 54 |         ],\n 55 |         \"fill\": [\n 56 |             ((\"patternType\",), \"pattern\"),\n 57 |             ((\"patterntype\",), \"pattern\"),\n 58 |             ((\"fill_type\",), \"pattern\"),\n 59 |             ((\"start_color\", \"rgb\"), \"fg_color\"),\n 60 |             ((\"fgColor\", \"rgb\"), \"fg_color\"),\n 61 |             ((\"fgcolor\", \"rgb\"), \"fg_color\"),\n 62 |             ((\"start_color\",), \"fg_color\"),\n 63 |             ((\"fgColor\",), \"fg_color\"),\n 64 |             ((\"fgcolor\",), \"fg_color\"),\n 65 |             ((\"end_color\", \"rgb\"), \"bg_color\"),\n 66 |             ((\"bgColor\", \"rgb\"), \"bg_color\"),\n 67 |             ((\"bgcolor\", \"rgb\"), \"bg_color\"),\n 68 |             ((\"end_color\",), \"bg_color\"),\n 69 |             ((\"bgColor\",), \"bg_color\"),\n 70 |             ((\"bgcolor\",), \"bg_color\"),\n 71 |         ],\n 72 |         \"border\": [\n 73 |             ((\"color\", \"rgb\"), \"border_color\"),\n 74 |             ((\"color\",), \"border_color\"),\n 75 |             ((\"style\",), \"border\"),\n 76 |             ((\"top\", \"color\", \"rgb\"), \"top_color\"),\n 77 |             ((\"top\", \"color\"), \"top_color\"),\n 78 |             ((\"top\", \"style\"), \"top\"),\n 79 |             ((\"top\",), \"top\"),\n 80 |             ((\"right\", \"color\", \"rgb\"), \"right_color\"),\n 81 |             ((\"right\", \"color\"), \"right_color\"),\n 82 |             ((\"right\", \"style\"), \"right\"),\n 83 |             ((\"right\",), \"right\"),\n 84 |             ((\"bottom\", \"color\", \"rgb\"), \"bottom_color\"),\n 85 |             ((\"bottom\", \"color\"), \"bottom_color\"),\n 86 |             ((\"bottom\", \"style\"), \"bottom\"),\n 87 |             ((\"bottom\",), \"bottom\"),\n 88 |             ((\"left\", \"color\", \"rgb\"), \"left_color\"),\n 89 |             ((\"left\", \"color\"), \"left_color\"),\n 90 |             ((\"left\", \"style\"), \"left\"),\n 91 |             ((\"left\",), \"left\"),\n 92 |         ],\n 93 |     }\n 94 | \n 95 |     @classmethod\n 96 |     def convert(cls, style_dict, num_format_str=None) -> dict[str, Any]:\n 97 |         \"\"\"\n 98 |         converts a style_dict to an xlsxwriter format dict\n 99 | \n100 |         Parameters\n101 |         ----------\n102 |         style_dict : style dictionary to convert\n103 |         num_format_str : optional number format string\n104 |         \"\"\"\n105 |         # Create a XlsxWriter format object.\n106 |         props = {}\n107 | \n108 |         if num_format_str is not None:\n109 |             props[\"num_format\"] = num_format_str\n110 | \n111 |         if style_dict is None:\n112 |             return props\n113 | \n114 |         if \"borders\" in style_dict:\n115 |             style_dict = style_dict.copy()\n116 |             style_dict[\"border\"] = style_dict.pop(\"borders\")\n117 | \n118 |         for style_group_key, style_group in style_dict.items():\n119 |             for src, dst in cls.STYLE_MAPPING.get(style_group_key, []):\n120 |                 # src is a sequence of keys into a nested dict\n121 |                 # dst is a flat key\n122 |                 if dst in props:\n123 |                     continue\n124 |                 v = style_group\n125 |                 for k in src:\n126 |                     try:\n127 |                         v = v[k]\n128 |                     except (KeyError, TypeError):\n129 |                         break\n130 |                 else:\n131 |                     props[dst] = v\n132 | \n133 |         if isinstance(props.get(\"pattern\"), str):\n134 |             # TODO: support other fill patterns\n135 |             props[\"pattern\"] = 0 if props[\"pattern\"] == \"none\" else 1\n136 | \n137 |         for k in [\"border\", \"top\", \"right\", \"bottom\", \"left\"]:\n138 |             if isinstance(props.get(k), str):\n139 |                 try:\n140 |                     props[k] = [\n141 |                         \"none\",\n142 |                         \"thin\",\n143 |                         \"medium\",\n144 |                         \"dashed\",\n145 |                         \"dotted\",\n146 |                         \"thick\",\n147 |                         \"double\",\n148 |                         \"hair\",\n149 |                         \"mediumDashed\",\n150 |                         \"dashDot\",\n151 |                         \"mediumDashDot\",\n152 |                         \"dashDotDot\",\n153 |                         \"mediumDashDotDot\",\n154 |                         \"slantDashDot\",\n155 |                     ].index(props[k])\n156 |                 except ValueError:\n157 |                     props[k] = 2\n158 | \n159 |         if isinstance(props.get(\"font_script\"), str):\n160 |             props[\"font_script\"] = [\"baseline\", \"superscript\", \"subscript\"].index(\n161 |                 props[\"font_script\"]\n162 |             )\n163 | \n164 |         if isinstance(props.get(\"underline\"), str):\n165 |             props[\"underline\"] = {\n166 |                 \"none\": 0,\n167 |                 \"single\": 1,\n168 |                 \"double\": 2,\n169 |                 \"singleAccounting\": 33,\n170 |                 \"doubleAccounting\": 34,\n171 |             }[props[\"underline\"]]\n172 | \n173 |         # GH 30107 - xlsxwriter uses different name\n174 |         if props.get(\"valign\") == \"center\":\n175 |             props[\"valign\"] = \"vcenter\"\n176 | \n177 |         return props\n178 | \n179 | \n180 | class XlsxWriter(ExcelWriter):\n181 |     _engine = \"xlsxwriter\"\n182 |     _supported_extensions = (\".xlsx\",)\n183 | \n184 |     def __init__(  # pyright: ignore[reportInconsistentConstructor]\n185 |         self,\n186 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n187 |         engine: str | None = None,\n188 |         date_format: str | None = None,\n189 |         datetime_format: str | None = None,\n190 |         mode: str = \"w\",\n191 |         storage_options: StorageOptions | None = None,\n192 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n193 |         engine_kwargs: dict[str, Any] | None = None,\n194 |         **kwargs,\n195 |     ) -> None:\n196 |         # Use the xlsxwriter module as the Excel writer.\n197 |         from xlsxwriter import Workbook\n198 | \n199 |         engine_kwargs = combine_kwargs(engine_kwargs, kwargs)\n200 | \n201 |         if mode == \"a\":\n202 |             raise ValueError(\"Append mode is not supported with xlsxwriter!\")\n203 | \n204 |         super().__init__(\n205 |             path,\n206 |             engine=engine,\n207 |             date_format=date_format,\n208 |             datetime_format=datetime_format,\n209 |             mode=mode,\n210 |             storage_options=storage_options,\n211 |             if_sheet_exists=if_sheet_exists,\n212 |             engine_kwargs=engine_kwargs,\n213 |         )\n214 | \n215 |         try:\n216 |             self._book = Workbook(self._handles.handle, **engine_kwargs)\n217 |         except TypeError:\n218 |             self._handles.handle.close()\n219 |             raise\n220 | \n221 |     @property\n222 |     def book(self):\n223 |         \"\"\"\n224 |         Book instance of class xlsxwriter.Workbook.\n225 | \n226 |         This attribute can be used to access engine-specific features.\n227 |         \"\"\"\n228 |         return self._book\n229 | \n230 |     @property\n231 |     def sheets(self) -> dict[str, Any]:\n232 |         result = self.book.sheetnames\n233 |         return result\n234 | \n235 |     def _save(self) -> None:\n236 |         \"\"\"\n237 |         Save workbook to disk.\n238 |         \"\"\"\n239 |         self.book.close()\n240 | \n241 |     def _write_cells(\n242 |         self,\n243 |         cells,\n244 |         sheet_name: str | None = None,\n245 |         startrow: int = 0,\n246 |         startcol: int = 0,\n247 |         freeze_panes: tuple[int, int] | None = None,\n248 |     ) -> None:\n249 |         # Write the frame cells using xlsxwriter.\n250 |         sheet_name = self._get_sheet_name(sheet_name)\n251 | \n252 |         wks = self.book.get_worksheet_by_name(sheet_name)\n253 |         if wks is None:\n254 |             wks = self.book.add_worksheet(sheet_name)\n255 | \n256 |         style_dict = {\"null\": None}\n257 | \n258 |         if validate_freeze_panes(freeze_panes):\n259 |             wks.freeze_panes(*(freeze_panes))\n260 | \n261 |         for cell in cells:\n262 |             val, fmt = self._value_with_fmt(cell.val)\n263 | \n264 |             stylekey = json.dumps(cell.style)\n265 |             if fmt:\n266 |                 stylekey += fmt\n267 | \n268 |             if stylekey in style_dict:\n269 |                 style = style_dict[stylekey]\n270 |             else:\n271 |                 style = self.book.add_format(_XlsxStyler.convert(cell.style, fmt))\n272 |                 style_dict[stylekey] = style\n273 | \n274 |             if cell.mergestart is not None and cell.mergeend is not None:\n275 |                 wks.merge_range(\n276 |                     startrow + cell.row,\n277 |                     startcol + cell.col,\n278 |                     startrow + cell.mergestart,\n279 |                     startcol + cell.mergeend,\n280 |                     val,\n281 |                     style,\n282 |                 )\n283 |             else:\n284 |                 wks.write(startrow + cell.row, startcol + cell.col, val, style)\n285 | \n```\n"}, {"content": "Let me also look at the base Excel writer implementation:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/io/excel/_base.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"pandas/io/excel/_base.py\"...\n### Search Result:\nFound file `pandas/io/excel/_base.py`.\nSource: Exact match found for entity name `pandas/io/excel/_base.py`.\n```\n   1 | from __future__ import annotations\n   2 | \n   3 | from collections.abc import (\n   4 |     Callable,\n   5 |     Hashable,\n   6 |     Iterable,\n   7 |     Mapping,\n   8 |     Sequence,\n   9 | )\n  10 | import datetime\n  11 | from decimal import Decimal\n  12 | from functools import partial\n  13 | import os\n  14 | from textwrap import fill\n  15 | from typing import (\n  16 |     IO,\n  17 |     TYPE_CHECKING,\n  18 |     Any,\n  19 |     Generic,\n  20 |     Literal,\n  21 |     TypeVar,\n  22 |     Union,\n  23 |     cast,\n  24 |     overload,\n  25 | )\n  26 | import warnings\n  27 | import zipfile\n  28 | \n  29 | from pandas._config import config\n  30 | \n  31 | from pandas._libs import lib\n  32 | from pandas._libs.parsers import STR_NA_VALUES\n  33 | from pandas.compat._optional import (\n  34 |     get_version,\n  35 |     import_optional_dependency,\n  36 | )\n  37 | from pandas.errors import EmptyDataError\n  38 | from pandas.util._decorators import (\n  39 |     Appender,\n  40 |     doc,\n  41 | )\n  42 | from pandas.util._exceptions import find_stack_level\n  43 | from pandas.util._validators import check_dtype_backend\n  44 | \n  45 | from pandas.core.dtypes.common import (\n  46 |     is_bool,\n  47 |     is_decimal,\n  48 |     is_file_like,\n  49 |     is_float,\n  50 |     is_integer,\n  51 |     is_list_like,\n  52 | )\n  53 | \n  54 | from pandas.core.frame import DataFrame\n  55 | from pandas.core.shared_docs import _shared_docs\n  56 | from pandas.util.version import Version\n  57 | \n  58 | from pandas.io.common import (\n  59 |     IOHandles,\n  60 |     get_handle,\n  61 |     stringify_path,\n  62 |     validate_header_arg,\n  63 | )\n  64 | from pandas.io.excel._util import (\n  65 |     fill_mi_header,\n  66 |     get_default_engine,\n  67 |     get_writer,\n  68 |     maybe_convert_usecols,\n  69 |     pop_header_name,\n  70 | )\n  71 | from pandas.io.parsers import TextParser\n  72 | from pandas.io.parsers.readers import validate_integer\n  73 | \n  74 | if TYPE_CHECKING:\n  75 |     from types import TracebackType\n  76 | \n  77 |     from pandas._typing import (\n  78 |         DtypeArg,\n  79 |         DtypeBackend,\n  80 |         ExcelWriterIfSheetExists,\n  81 |         FilePath,\n  82 |         HashableT,\n  83 |         IntStrT,\n  84 |         ReadBuffer,\n  85 |         Self,\n  86 |         SequenceNotStr,\n  87 |         StorageOptions,\n  88 |         WriteExcelBuffer,\n  89 |     )\n  90 | _read_excel_doc = (\n  91 |     \"\"\"\n  92 | Read an Excel file into a ``pandas`` ``DataFrame``.\n  93 | \n  94 | Supports `xls`, `xlsx`, `xlsm`, `xlsb`, `odf`, `ods` and `odt` file extensions\n  95 | read from a local filesystem or URL. Supports an option to read\n  96 | a single sheet or a list of sheets.\n  97 | \n  98 | Parameters\n  99 | ----------\n 100 | io : str, ExcelFile, xlrd.Book, path object, or file-like object\n 101 |     Any valid string path is acceptable. The string could be a URL. Valid\n 102 |     URL schemes include http, ftp, s3, and file. For file URLs, a host is\n 103 |     expected. A local file could be: ``file://localhost/path/to/table.xlsx``.\n 104 | \n 105 |     If you want to pass in a path object, pandas accepts any ``os.PathLike``.\n 106 | \n 107 |     By file-like object, we refer to objects with a ``read()`` method,\n 108 |     such as a file handle (e.g. via builtin ``open`` function)\n 109 |     or ``StringIO``.\n 110 | \n 111 |     .. deprecated:: 2.1.0\n 112 |         Passing byte strings is deprecated. To read from a\n 113 |         byte string, wrap it in a ``BytesIO`` object.\n 114 | sheet_name : str, int, list, or None, default 0\n 115 |     Strings are used for sheet names. Integers are used in zero-indexed\n 116 |     sheet positions (chart sheets do not count as a sheet position).\n 117 |     Lists of strings/integers are used to request multiple sheets.\n 118 |     Specify ``None`` to get all worksheets.\n 119 | \n 120 |     Available cases:\n 121 | \n 122 |     * Defaults to ``0``: 1st sheet as a `DataFrame`\n 123 |     * ``1``: 2nd sheet as a `DataFrame`\n 124 |     * ``\"Sheet1\"``: Load sheet with name \"Sheet1\"\n 125 |     * ``[0, 1, \"Sheet5\"]``: Load first, second and sheet named \"Sheet5\"\n 126 |       as a dict of `DataFrame`\n 127 |     * ``None``: All worksheets.\n 128 | \n 129 | header : int, list of int, default 0\n 130 |     Row (0-indexed) to use for the column labels of the parsed\n 131 |     DataFrame. If a list of integers is passed those row positions will\n 132 |     be combined into a ``MultiIndex``. Use None if there is no header.\n 133 | names : array-like, default None\n 134 |     List of column names to use. If file contains no header row,\n 135 |     then you should explicitly pass header=None.\n 136 | index_col : int, str, list of int, default None\n 137 |     Column (0-indexed) to use as the row labels of the DataFrame.\n 138 |     Pass None if there is no such column.  If a list is passed,\n 139 |     those columns will be combined into a ``MultiIndex``.  If a\n 140 |     subset of data is selected with ``usecols``, index_col\n 141 |     is based on the subset.\n 142 | \n 143 |     Missing values will be forward filled to allow roundtripping with\n 144 |     ``to_excel`` for ``merged_cells=True``. To avoid forward filling the\n 145 |     missing values use ``set_index`` after reading the data instead of\n 146 |     ``index_col``.\n 147 | usecols : str, list-like, or callable, default None\n 148 |     * If None, then parse all columns.\n 149 |     * If str, then indicates comma separated list of Excel column letters\n 150 |       and column ranges (e.g. \"A:E\" or \"A,C,E:F\"). Ranges are inclusive of\n 151 |       both sides.\n 152 |     * If list of int, then indicates list of column numbers to be parsed\n 153 |       (0-indexed).\n 154 |     * If list of string, then indicates list of column names to be parsed.\n 155 |     * If callable, then evaluate each column name against it and parse the\n 156 |       column if the callable returns ``True``.\n 157 | \n 158 |     Returns a subset of the columns according to behavior above.\n 159 | dtype : Type name or dict of column -> type, default None\n 160 |     Data type for data or columns. E.g. {{'a': np.float64, 'b': np.int32}}\n 161 |     Use ``object`` to preserve data as stored in Excel and not interpret dtype,\n 162 |     which will necessarily result in ``object`` dtype.\n 163 |     If converters are specified, they will be applied INSTEAD\n 164 |     of dtype conversion.\n 165 |     If you use ``None``, it will infer the dtype of each column based on the data.\n 166 | engine : {{'openpyxl', 'calamine', 'odf', 'pyxlsb', 'xlrd'}}, default None\n 167 |     If io is not a buffer or path, this must be set to identify io.\n 168 |     Engine compatibility :\n 169 | \n 170 |     - ``openpyxl`` supports newer Excel file formats.\n 171 |     - ``calamine`` supports Excel (.xls, .xlsx, .xlsm, .xlsb)\n 172 |       and OpenDocument (.ods) file formats.\n 173 |     - ``odf`` supports OpenDocument file formats (.odf, .ods, .odt).\n 174 |     - ``pyxlsb`` supports Binary Excel files.\n 175 |     - ``xlrd`` supports old-style Excel files (.xls).\n 176 | \n 177 |     When ``engine=None``, the following logic will be used to determine the engine:\n 178 | \n 179 |     - If ``path_or_buffer`` is an OpenDocument format (.odf, .ods, .odt),\n 180 |       then `odf <https://pypi.org/project/odfpy/>`_ will be used.\n 181 |     - Otherwise if ``path_or_buffer`` is an xls format, ``xlrd`` will be used.\n 182 |     - Otherwise if ``path_or_buffer`` is in xlsb format, ``pyxlsb`` will be used.\n 183 |     - Otherwise ``openpyxl`` will be used.\n 184 | converters : dict, default None\n 185 |     Dict of functions for converting values in certain columns. Keys can\n 186 |     either be integers or column labels, values are functions that take one\n 187 |     input argument, the Excel cell content, and return the transformed\n 188 |     content.\n 189 | true_values : list, default None\n 190 |     Values to consider as True.\n 191 | false_values : list, default None\n 192 |     Values to consider as False.\n 193 | skiprows : list-like, int, or callable, optional\n 194 |     Line numbers to skip (0-indexed) or number of lines to skip (int) at the\n 195 |     start of the file. If callable, the callable function will be evaluated\n 196 |     against the row indices, returning True if the row should be skipped and\n 197 |     False otherwise. An example of a valid callable argument would be ``lambda\n 198 |     x: x in [0, 2]``.\n 199 | nrows : int, default None\n 200 |     Number of rows to parse.\n 201 | na_values : scalar, str, list-like, or dict, default None\n 202 |     Additional strings to recognize as NA/NaN. If dict passed, specific\n 203 |     per-column NA values. By default the following values are interpreted\n 204 |     as NaN: '\"\"\"\n 205 |     + fill(\"', '\".join(sorted(STR_NA_VALUES)), 70, subsequent_indent=\"    \")\n 206 |     + \"\"\"'.\n 207 | keep_default_na : bool, default True\n 208 |     Whether or not to include the default NaN values when parsing the data.\n 209 |     Depending on whether ``na_values`` is passed in, the behavior is as follows:\n 210 | \n 211 |     * If ``keep_default_na`` is True, and ``na_values`` are specified,\n 212 |       ``na_values`` is appended to the default NaN values used for parsing.\n 213 |     * If ``keep_default_na`` is True, and ``na_values`` are not specified, only\n 214 |       the default NaN values are used for parsing.\n 215 |     * If ``keep_default_na`` is False, and ``na_values`` are specified, only\n 216 |       the NaN values specified ``na_values`` are used for parsing.\n 217 |     * If ``keep_default_na`` is False, and ``na_values`` are not specified, no\n 218 |       strings will be parsed as NaN.\n 219 | \n 220 |     Note that if `na_filter` is passed in as False, the ``keep_default_na`` and\n 221 |     ``na_values`` parameters will be ignored.\n 222 | na_filter : bool, default True\n 223 |     Detect missing value markers (empty strings and the value of na_values). In\n 224 |     data without any NAs, passing ``na_filter=False`` can improve the\n 225 |     performance of reading a large file.\n 226 | verbose : bool, default False\n 227 |     Indicate number of NA values placed in non-numeric columns.\n 228 | parse_dates : bool, list-like, or dict, default False\n 229 |     The behavior is as follows:\n 230 | \n 231 |     * ``bool``. If True -> try parsing the index.\n 232 |     * ``list`` of int or names. e.g. If [1, 2, 3] -> try parsing columns 1, 2, 3\n 233 |       each as a separate date column.\n 234 |     * ``list`` of lists. e.g.  If [[1, 3]] -> combine columns 1 and 3 and parse as\n 235 |       a single date column.\n 236 |     * ``dict``, e.g. {{'foo' : [1, 3]}} -> parse columns 1, 3 as date and call\n 237 |       result 'foo'\n 238 | \n 239 |     If a column or index contains an unparsable date, the entire column or\n 240 |     index will be returned unaltered as an object data type. If you don`t want to\n 241 |     parse some cells as date just change their type in Excel to \"Text\".\n 242 |     For non-standard datetime parsing, use ``pd.to_datetime`` after ``pd.read_excel``.\n 243 | \n 244 |     Note: A fast-path exists for iso8601-formatted dates.\n 245 | date_format : str or dict of column -> format, default ``None``\n 246 |    If used in conjunction with ``parse_dates``, will parse dates according to this\n 247 |    format. For anything more complex,\n 248 |    please read in as ``object`` and then apply :func:`to_datetime` as-needed.\n 249 | \n 250 |    .. versionadded:: 2.0.0\n 251 | thousands : str, default None\n 252 |     Thousands separator for parsing string columns to numeric.  Note that\n 253 |     this parameter is only necessary for columns stored as TEXT in Excel,\n 254 |     any numeric columns will automatically be parsed, regardless of display\n 255 |     format.\n 256 | decimal : str, default '.'\n 257 |     Character to recognize as decimal point for parsing string columns to numeric.\n 258 |     Note that this parameter is only necessary for columns stored as TEXT in Excel,\n 259 |     any numeric columns will automatically be parsed, regardless of display\n 260 |     format.(e.g. use ',' for European data).\n 261 | \n 262 |     .. versionadded:: 1.4.0\n 263 | \n 264 | comment : str, default None\n 265 |     Comments out remainder of line. Pass a character or characters to this\n 266 |     argument to indicate comments in the input file. Any data between the\n 267 |     comment string and the end of the current line is ignored.\n 268 | skipfooter : int, default 0\n 269 |     Rows at the end to skip (0-indexed).\n 270 | {storage_options}\n 271 | \n 272 | dtype_backend : {{'numpy_nullable', 'pyarrow'}}\n 273 |     Back-end data type applied to the resultant :class:`DataFrame`\n 274 |     (still experimental). If not specified, the default behavior\n 275 |     is to not use nullable data types. If specified, the behavior\n 276 |     is as follows:\n 277 | \n 278 |     * ``\"numpy_nullable\"``: returns nullable-dtype-backed :class:`DataFrame`\n 279 |     * ``\"pyarrow\"``: returns pyarrow-backed nullable\n 280 |       :class:`ArrowDtype` :class:`DataFrame`\n 281 | \n 282 |     .. versionadded:: 2.0\n 283 | \n 284 | engine_kwargs : dict, optional\n 285 |     Arbitrary keyword arguments passed to excel engine.\n 286 | \n 287 | Returns\n 288 | -------\n 289 | DataFrame or dict of DataFrames\n 290 |     DataFrame from the passed in Excel file. See notes in sheet_name\n 291 |     argument for more information on when a dict of DataFrames is returned.\n 292 | \n 293 | See Also\n 294 | --------\n 295 | DataFrame.to_excel : Write DataFrame to an Excel file.\n 296 | DataFrame.to_csv : Write DataFrame to a comma-separated values (csv) file.\n 297 | read_csv : Read a comma-separated values (csv) file into DataFrame.\n 298 | read_fwf : Read a table of fixed-width formatted lines into DataFrame.\n 299 | \n 300 | Notes\n 301 | -----\n 302 | For specific information on the methods used for each Excel engine, refer to the pandas\n 303 | :ref:`user guide <io.excel_reader>`\n 304 | \n 305 | Examples\n 306 | --------\n 307 | The file can be read using the file name as string or an open file object:\n 308 | \n 309 | >>> pd.read_excel('tmp.xlsx', index_col=0)  # doctest: +SKIP\n 310 |        Name  Value\n 311 | 0   string1      1\n 312 | 1   string2      2\n 313 | 2  #Comment      3\n 314 | \n 315 | >>> pd.read_excel(open('tmp.xlsx', 'rb'),\n 316 | ...               sheet_name='Sheet3')  # doctest: +SKIP\n 317 |    Unnamed: 0      Name  Value\n 318 | 0           0   string1      1\n 319 | 1           1   string2      2\n 320 | 2           2  #Comment      3\n 321 | \n 322 | Index and header can be specified via the `index_col` and `header` arguments\n 323 | \n 324 | >>> pd.read_excel('tmp.xlsx', index_col=None, header=None)  # doctest: +SKIP\n 325 |      0         1      2\n 326 | 0  NaN      Name  Value\n 327 | 1  0.0   string1      1\n 328 | 2  1.0   string2      2\n 329 | 3  2.0  #Comment      3\n 330 | \n 331 | Column types are inferred but can be explicitly specified\n 332 | \n 333 | >>> pd.read_excel('tmp.xlsx', index_col=0,\n 334 | ...               dtype={{'Name': str, 'Value': float}})  # doctest: +SKIP\n 335 |        Name  Value\n 336 | 0   string1    1.0\n 337 | 1   string2    2.0\n 338 | 2  #Comment    3.0\n 339 | \n 340 | True, False, and NA values, and thousands separators have defaults,\n 341 | but can be explicitly specified, too. Supply the values you would like\n 342 | as strings or lists of strings!\n 343 | \n 344 | >>> pd.read_excel('tmp.xlsx', index_col=0,\n 345 | ...               na_values=['string1', 'string2'])  # doctest: +SKIP\n 346 |        Name  Value\n 347 | 0       NaN      1\n 348 | 1       NaN      2\n 349 | 2  #Comment      3\n 350 | \n 351 | Comment lines in the excel input file can be skipped using the\n 352 | ``comment`` kwarg.\n 353 | \n 354 | >>> pd.read_excel('tmp.xlsx', index_col=0, comment='#')  # doctest: +SKIP\n 355 |       Name  Value\n 356 | 0  string1    1.0\n 357 | 1  string2    2.0\n 358 | 2     None    NaN\n 359 | \"\"\"\n 360 | )\n 361 | \n 362 | \n 363 | @overload\n 364 | def read_excel(\n 365 |     io,\n 366 |     # sheet name is str or int -> DataFrame\n 367 |     sheet_name: str | int = ...,\n 368 |     *,\n 369 |     header: int | Sequence[int] | None = ...,\n 370 |     names: SequenceNotStr[Hashable] | range | None = ...,\n 371 |     index_col: int | str | Sequence[int] | None = ...,\n 372 |     usecols: int\n 373 |     | str\n 374 |     | Sequence[int]\n 375 |     | Sequence[str]\n 376 |     | Callable[[HashableT], bool]\n 377 |     | None = ...,\n 378 |     dtype: DtypeArg | None = ...,\n 379 |     engine: Literal[\"xlrd\", \"openpyxl\", \"odf\", \"pyxlsb\", \"calamine\"] | None = ...,\n 380 |     converters: dict[str, Callable] | dict[int, Callable] | None = ...,\n 381 |     true_values: Iterable[Hashable] | None = ...,\n 382 |     false_values: Iterable[Hashable] | None = ...,\n 383 |     skiprows: Sequence[int] | int | Callable[[int], object] | None = ...,\n 384 |     nrows: int | None = ...,\n 385 |     na_values=...,\n 386 |     keep_default_na: bool = ...,\n 387 |     na_filter: bool = ...,\n 388 |     verbose: bool = ...,\n 389 |     parse_dates: list | dict | bool = ...,\n 390 |     date_format: dict[Hashable, str] | str | None = ...,\n 391 |     thousands: str | None = ...,\n 392 |     decimal: str = ...,\n 393 |     comment: str | None = ...,\n 394 |     skipfooter: int = ...,\n 395 |     storage_options: StorageOptions = ...,\n 396 |     dtype_backend: DtypeBackend | lib.NoDefault = ...,\n 397 | ) -> DataFrame: ...\n 398 | \n 399 | \n 400 | @overload\n 401 | def read_excel(\n 402 |     io,\n 403 |     # sheet name is list or None -> dict[IntStrT, DataFrame]\n 404 |     sheet_name: list[IntStrT] | None,\n 405 |     *,\n 406 |     header: int | Sequence[int] | None = ...,\n 407 |     names: SequenceNotStr[Hashable] | range | None = ...,\n 408 |     index_col: int | str | Sequence[int] | None = ...,\n 409 |     usecols: int\n 410 |     | str\n 411 |     | Sequence[int]\n 412 |     | Sequence[str]\n 413 |     | Callable[[HashableT], bool]\n 414 |     | None = ...,\n 415 |     dtype: DtypeArg | None = ...,\n 416 |     engine: Literal[\"xlrd\", \"openpyxl\", \"odf\", \"pyxlsb\", \"calamine\"] | None = ...,\n 417 |     converters: dict[str, Callable] | dict[int, Callable] | None = ...,\n 418 |     true_values: Iterable[Hashable] | None = ...,\n 419 |     false_values: Iterable[Hashable] | None = ...,\n 420 |     skiprows: Sequence[int] | int | Callable[[int], object] | None = ...,\n 421 |     nrows: int | None = ...,\n 422 |     na_values=...,\n 423 |     keep_default_na: bool = ...,\n 424 |     na_filter: bool = ...,\n 425 |     verbose: bool = ...,\n 426 |     parse_dates: list | dict | bool = ...,\n 427 |     date_format: dict[Hashable, str] | str | None = ...,\n 428 |     thousands: str | None = ...,\n 429 |     decimal: str = ...,\n 430 |     comment: str | None = ...,\n 431 |     skipfooter: int = ...,\n 432 |     storage_options: StorageOptions = ...,\n 433 |     dtype_backend: DtypeBackend | lib.NoDefault = ...,\n 434 | ) -> dict[IntStrT, DataFrame]: ...\n 435 | \n 436 | \n 437 | @doc(storage_options=_shared_docs[\"storage_options\"])\n 438 | @Appender(_read_excel_doc)\n 439 | def read_excel(\n 440 |     io,\n 441 |     sheet_name: str | int | list[IntStrT] | None = 0,\n 442 |     *,\n 443 |     header: int | Sequence[int] | None = 0,\n 444 |     names: SequenceNotStr[Hashable] | range | None = None,\n 445 |     index_col: int | str | Sequence[int] | None = None,\n 446 |     usecols: int\n 447 |     | str\n 448 |     | Sequence[int]\n 449 |     | Sequence[str]\n 450 |     | Callable[[HashableT], bool]\n 451 |     | None = None,\n 452 |     dtype: DtypeArg | None = None,\n 453 |     engine: Literal[\"xlrd\", \"openpyxl\", \"odf\", \"pyxlsb\", \"calamine\"] | None = None,\n 454 |     converters: dict[str, Callable] | dict[int, Callable] | None = None,\n 455 |     true_values: Iterable[Hashable] | None = None,\n 456 |     false_values: Iterable[Hashable] | None = None,\n 457 |     skiprows: Sequence[int] | int | Callable[[int], object] | None = None,\n 458 |     nrows: int | None = None,\n 459 |     na_values=None,\n 460 |     keep_default_na: bool = True,\n 461 |     na_filter: bool = True,\n 462 |     verbose: bool = False,\n 463 |     parse_dates: list | dict | bool = False,\n 464 |     date_format: dict[Hashable, str] | str | None = None,\n 465 |     thousands: str | None = None,\n 466 |     decimal: str = \".\",\n 467 |     comment: str | None = None,\n 468 |     skipfooter: int = 0,\n 469 |     storage_options: StorageOptions | None = None,\n 470 |     dtype_backend: DtypeBackend | lib.NoDefault = lib.no_default,\n 471 |     engine_kwargs: dict | None = None,\n 472 | ) -> DataFrame | dict[IntStrT, DataFrame]:\n 473 |     check_dtype_backend(dtype_backend)\n 474 |     should_close = False\n 475 |     if engine_kwargs is None:\n 476 |         engine_kwargs = {}\n 477 | \n 478 |     if not isinstance(io, ExcelFile):\n 479 |         should_close = True\n 480 |         io = ExcelFile(\n 481 |             io,\n 482 |             storage_options=storage_options,\n 483 |             engine=engine,\n 484 |             engine_kwargs=engine_kwargs,\n 485 |         )\n 486 |     elif engine and engine != io.engine:\n 487 |         raise ValueError(\n 488 |             \"Engine should not be specified when passing \"\n 489 |             \"an ExcelFile - ExcelFile already has the engine set\"\n 490 |         )\n 491 | \n 492 |     try:\n 493 |         data = io.parse(\n 494 |             sheet_name=sheet_name,\n 495 |             header=header,\n 496 |             names=names,\n 497 |             index_col=index_col,\n 498 |             usecols=usecols,\n 499 |             dtype=dtype,\n 500 |             converters=converters,\n 501 |             true_values=true_values,\n 502 |             false_values=false_values,\n 503 |             skiprows=skiprows,\n 504 |             nrows=nrows,\n 505 |             na_values=na_values,\n 506 |             keep_default_na=keep_default_na,\n 507 |             na_filter=na_filter,\n 508 |             verbose=verbose,\n 509 |             parse_dates=parse_dates,\n 510 |             date_format=date_format,\n 511 |             thousands=thousands,\n 512 |             decimal=decimal,\n 513 |             comment=comment,\n 514 |             skipfooter=skipfooter,\n 515 |             dtype_backend=dtype_backend,\n 516 |         )\n 517 |     finally:\n 518 |         # make sure to close opened file handles\n 519 |         if should_close:\n 520 |             io.close()\n 521 |     return data\n 522 | \n 523 | \n 524 | _WorkbookT = TypeVar(\"_WorkbookT\")\n 525 | \n 526 | \n 527 | class BaseExcelReader(Generic[_WorkbookT]):\n 528 |     book: _WorkbookT\n 529 | \n 530 |     def __init__(\n 531 |         self,\n 532 |         filepath_or_buffer,\n 533 |         storage_options: StorageOptions | None = None,\n 534 |         engine_kwargs: dict | None = None,\n 535 |     ) -> None:\n 536 |         if engine_kwargs is None:\n 537 |             engine_kwargs = {}\n 538 | \n 539 |         self.handles = IOHandles(\n 540 |             handle=filepath_or_buffer, compression={\"method\": None}\n 541 |         )\n 542 |         if not isinstance(filepath_or_buffer, (ExcelFile, self._workbook_class)):\n 543 |             self.handles = get_handle(\n 544 |                 filepath_or_buffer, \"rb\", storage_options=storage_options, is_text=False\n 545 |             )\n 546 | \n 547 |         if isinstance(self.handles.handle, self._workbook_class):\n 548 |             self.book = self.handles.handle\n 549 |         elif hasattr(self.handles.handle, \"read\"):\n 550 |             # N.B. xlrd.Book has a read attribute too\n 551 |             self.handles.handle.seek(0)\n 552 |             try:\n 553 |                 self.book = self.load_workbook(self.handles.handle, engine_kwargs)\n 554 |             except Exception:\n 555 |                 self.close()\n 556 |                 raise\n 557 |         else:\n 558 |             raise ValueError(\n 559 |                 \"Must explicitly set engine if not passing in buffer or path for io.\"\n 560 |             )\n 561 | \n 562 |     @property\n 563 |     def _workbook_class(self) -> type[_WorkbookT]:\n 564 |         raise NotImplementedError\n 565 | \n 566 |     def load_workbook(self, filepath_or_buffer, engine_kwargs) -> _WorkbookT:\n 567 |         raise NotImplementedError\n 568 | \n 569 |     def close(self) -> None:\n 570 |         if hasattr(self, \"book\"):\n 571 |             if hasattr(self.book, \"close\"):\n 572 |                 # pyxlsb: opens a TemporaryFile\n 573 |                 # openpyxl: https://stackoverflow.com/questions/31416842/\n 574 |                 #     openpyxl-does-not-close-excel-workbook-in-read-only-mode\n 575 |                 self.book.close()\n 576 |             elif hasattr(self.book, \"release_resources\"):\n 577 |                 # xlrd\n 578 |                 # https://github.com/python-excel/xlrd/blob/2.0.1/xlrd/book.py#L548\n 579 |                 self.book.release_resources()\n 580 |         self.handles.close()\n 581 | \n 582 |     @property\n 583 |     def sheet_names(self) -> list[str]:\n 584 |         raise NotImplementedError\n 585 | \n 586 |     def get_sheet_by_name(self, name: str):\n 587 |         raise NotImplementedError\n 588 | \n 589 |     def get_sheet_by_index(self, index: int):\n 590 |         raise NotImplementedError\n 591 | \n 592 |     def get_sheet_data(self, sheet, rows: int | None = None):\n 593 |         raise NotImplementedError\n 594 | \n 595 |     def raise_if_bad_sheet_by_index(self, index: int) -> None:\n 596 |         n_sheets = len(self.sheet_names)\n 597 |         if index >= n_sheets:\n 598 |             raise ValueError(\n 599 |                 f\"Worksheet index {index} is invalid, {n_sheets} worksheets found\"\n 600 |             )\n 601 | \n 602 |     def raise_if_bad_sheet_by_name(self, name: str) -> None:\n 603 |         if name not in self.sheet_names:\n 604 |             raise ValueError(f\"Worksheet named '{name}' not found\")\n 605 | \n 606 |     def _check_skiprows_func(\n 607 |         self,\n 608 |         skiprows: Callable,\n 609 |         rows_to_use: int,\n 610 |     ) -> int:\n 611 |         \"\"\"\n 612 |         Determine how many file rows are required to obtain `nrows` data\n 613 |         rows when `skiprows` is a function.\n 614 | \n 615 |         Parameters\n 616 |         ----------\n 617 |         skiprows : function\n 618 |             The function passed to read_excel by the user.\n 619 |         rows_to_use : int\n 620 |             The number of rows that will be needed for the header and\n 621 |             the data.\n 622 | \n 623 |         Returns\n 624 |         -------\n 625 |         int\n 626 |         \"\"\"\n 627 |         i = 0\n 628 |         rows_used_so_far = 0\n 629 |         while rows_used_so_far < rows_to_use:\n 630 |             if not skiprows(i):\n 631 |                 rows_used_so_far += 1\n 632 |             i += 1\n 633 |         return i\n 634 | \n 635 |     def _calc_rows(\n 636 |         self,\n 637 |         header: int | Sequence[int] | None,\n 638 |         index_col: int | Sequence[int] | None,\n 639 |         skiprows: Sequence[int] | int | Callable[[int], object] | None,\n 640 |         nrows: int | None,\n 641 |     ) -> int | None:\n 642 |         \"\"\"\n 643 |         If nrows specified, find the number of rows needed from the\n 644 |         file, otherwise return None.\n 645 | \n 646 | \n 647 |         Parameters\n 648 |         ----------\n 649 |         header : int, list of int, or None\n 650 |             See read_excel docstring.\n 651 |         index_col : int, str, list of int, or None\n 652 |             See read_excel docstring.\n 653 |         skiprows : list-like, int, callable, or None\n 654 |             See read_excel docstring.\n 655 |         nrows : int or None\n 656 |             See read_excel docstring.\n 657 | \n 658 |         Returns\n 659 |         -------\n 660 |         int or None\n 661 |         \"\"\"\n 662 |         if nrows is None:\n 663 |             return None\n 664 |         if header is None:\n 665 |             header_rows = 1\n 666 |         elif is_integer(header):\n 667 |             header = cast(int, header)\n 668 |             header_rows = 1 + header\n 669 |         else:\n 670 |             header = cast(Sequence, header)\n 671 |             header_rows = 1 + header[-1]\n 672 |         # If there is a MultiIndex header and an index then there is also\n 673 |         # a row containing just the index name(s)\n 674 |         if is_list_like(header) and index_col is not None:\n 675 |             header = cast(Sequence, header)\n 676 |             if len(header) > 1:\n 677 |                 header_rows += 1\n 678 |         if skiprows is None:\n 679 |             return header_rows + nrows\n 680 |         if is_integer(skiprows):\n 681 |             skiprows = cast(int, skiprows)\n 682 |             return header_rows + nrows + skiprows\n 683 |         if is_list_like(skiprows):\n 684 | \n 685 |             def f(skiprows: Sequence, x: int) -> bool:\n 686 |                 return x in skiprows\n 687 | \n 688 |             skiprows = cast(Sequence, skiprows)\n 689 |             return self._check_skiprows_func(partial(f, skiprows), header_rows + nrows)\n 690 |         if callable(skiprows):\n 691 |             return self._check_skiprows_func(\n 692 |                 skiprows,\n 693 |                 header_rows + nrows,\n 694 |             )\n 695 |         # else unexpected skiprows type: read_excel will not optimize\n 696 |         # the number of rows read from file\n 697 |         return None\n 698 | \n 699 |     def parse(\n 700 |         self,\n 701 |         sheet_name: str | int | list[int] | list[str] | None = 0,\n 702 |         header: int | Sequence[int] | None = 0,\n 703 |         names: SequenceNotStr[Hashable] | range | None = None,\n 704 |         index_col: int | Sequence[int] | None = None,\n 705 |         usecols=None,\n 706 |         dtype: DtypeArg | None = None,\n 707 |         true_values: Iterable[Hashable] | None = None,\n 708 |         false_values: Iterable[Hashable] | None = None,\n 709 |         skiprows: Sequence[int] | int | Callable[[int], object] | None = None,\n 710 |         nrows: int | None = None,\n 711 |         na_values=None,\n 712 |         verbose: bool = False,\n 713 |         parse_dates: list | dict | bool = False,\n 714 |         date_format: dict[Hashable, str] | str | None = None,\n 715 |         thousands: str | None = None,\n 716 |         decimal: str = \".\",\n 717 |         comment: str | None = None,\n 718 |         skipfooter: int = 0,\n 719 |         dtype_backend: DtypeBackend | lib.NoDefault = lib.no_default,\n 720 |         **kwds,\n 721 |     ):\n 722 |         validate_header_arg(header)\n 723 |         validate_integer(\"nrows\", nrows)\n 724 | \n 725 |         ret_dict = False\n 726 | \n 727 |         # Keep sheetname to maintain backwards compatibility.\n 728 |         sheets: list[int] | list[str]\n 729 |         if isinstance(sheet_name, list):\n 730 |             sheets = sheet_name\n 731 |             ret_dict = True\n 732 |         elif sheet_name is None:\n 733 |             sheets = self.sheet_names\n 734 |             ret_dict = True\n 735 |         elif isinstance(sheet_name, str):\n 736 |             sheets = [sheet_name]\n 737 |         else:\n 738 |             sheets = [sheet_name]\n 739 | \n 740 |         # handle same-type duplicates.\n 741 |         sheets = cast(Union[list[int], list[str]], list(dict.fromkeys(sheets).keys()))\n 742 | \n 743 |         output = {}\n 744 | \n 745 |         last_sheetname = None\n 746 |         for asheetname in sheets:\n 747 |             last_sheetname = asheetname\n 748 |             if verbose:\n 749 |                 print(f\"Reading sheet {asheetname}\")\n 750 | \n 751 |             if isinstance(asheetname, str):\n 752 |                 sheet = self.get_sheet_by_name(asheetname)\n 753 |             else:  # assume an integer if not a string\n 754 |                 sheet = self.get_sheet_by_index(asheetname)\n 755 | \n 756 |             file_rows_needed = self._calc_rows(header, index_col, skiprows, nrows)\n 757 |             data = self.get_sheet_data(sheet, file_rows_needed)\n 758 |             if hasattr(sheet, \"close\"):\n 759 |                 # pyxlsb opens two TemporaryFiles\n 760 |                 sheet.close()\n 761 |             usecols = maybe_convert_usecols(usecols)\n 762 | \n 763 |             if not data:\n 764 |                 output[asheetname] = DataFrame()\n 765 |                 continue\n 766 | \n 767 |             output = self._parse_sheet(\n 768 |                 data=data,\n 769 |                 output=output,\n 770 |                 asheetname=asheetname,\n 771 |                 header=header,\n 772 |                 names=names,\n 773 |                 index_col=index_col,\n 774 |                 usecols=usecols,\n 775 |                 dtype=dtype,\n 776 |                 skiprows=skiprows,\n 777 |                 nrows=nrows,\n 778 |                 true_values=true_values,\n 779 |                 false_values=false_values,\n 780 |                 na_values=na_values,\n 781 |                 parse_dates=parse_dates,\n 782 |                 date_format=date_format,\n 783 |                 thousands=thousands,\n 784 |                 decimal=decimal,\n 785 |                 comment=comment,\n 786 |                 skipfooter=skipfooter,\n 787 |                 dtype_backend=dtype_backend,\n 788 |                 **kwds,\n 789 |             )\n 790 | \n 791 |         if last_sheetname is None:\n 792 |             raise ValueError(\"Sheet name is an empty list\")\n 793 | \n 794 |         if ret_dict:\n 795 |             return output\n 796 |         else:\n 797 |             return output[last_sheetname]\n 798 | \n 799 |     def _parse_sheet(\n 800 |         self,\n 801 |         data: list,\n 802 |         output: dict,\n 803 |         asheetname: str | int | None = None,\n 804 |         header: int | Sequence[int] | None = 0,\n 805 |         names: SequenceNotStr[Hashable] | range | None = None,\n 806 |         index_col: int | Sequence[int] | None = None,\n 807 |         usecols=None,\n 808 |         dtype: DtypeArg | None = None,\n 809 |         skiprows: Sequence[int] | int | Callable[[int], object] | None = None,\n 810 |         nrows: int | None = None,\n 811 |         true_values: Iterable[Hashable] | None = None,\n 812 |         false_values: Iterable[Hashable] | None = None,\n 813 |         na_values=None,\n 814 |         parse_dates: list | dict | bool = False,\n 815 |         date_format: dict[Hashable, str] | str | None = None,\n 816 |         thousands: str | None = None,\n 817 |         decimal: str = \".\",\n 818 |         comment: str | None = None,\n 819 |         skipfooter: int = 0,\n 820 |         dtype_backend: DtypeBackend | lib.NoDefault = lib.no_default,\n 821 |         **kwds,\n 822 |     ):\n 823 |         is_list_header = False\n 824 |         is_len_one_list_header = False\n 825 |         if is_list_like(header):\n 826 |             assert isinstance(header, Sequence)\n 827 |             is_list_header = True\n 828 |             if len(header) == 1:\n 829 |                 is_len_one_list_header = True\n 830 | \n 831 |         if is_len_one_list_header:\n 832 |             header = cast(Sequence[int], header)[0]\n 833 | \n 834 |         # forward fill and pull out names for MultiIndex column\n 835 |         header_names = None\n 836 |         if header is not None and is_list_like(header):\n 837 |             assert isinstance(header, Sequence)\n 838 | \n 839 |             header_names = []\n 840 |             control_row = [True] * len(data[0])\n 841 | \n 842 |             for row in header:\n 843 |                 if is_integer(skiprows):\n 844 |                     assert isinstance(skiprows, int)\n 845 |                     row += skiprows\n 846 | \n 847 |                 if row > len(data) - 1:\n 848 |                     raise ValueError(\n 849 |                         f\"header index {row} exceeds maximum index \"\n 850 |                         f\"{len(data) - 1} of data.\",\n 851 |                     )\n 852 | \n 853 |                 data[row], control_row = fill_mi_header(data[row], control_row)\n 854 | \n 855 |                 if index_col is not None:\n 856 |                     header_name, _ = pop_header_name(data[row], index_col)\n 857 |                     header_names.append(header_name)\n 858 | \n 859 |         # If there is a MultiIndex header and an index then there is also\n 860 |         # a row containing just the index name(s)\n 861 |         has_index_names = False\n 862 |         if is_list_header and not is_len_one_list_header and index_col is not None:\n 863 |             index_col_set: set[int]\n 864 |             if isinstance(index_col, int):\n 865 |                 index_col_set = {index_col}\n 866 |             else:\n 867 |                 assert isinstance(index_col, Sequence)\n 868 |                 index_col_set = set(index_col)\n 869 | \n 870 |             # We have to handle mi without names. If any of the entries in the data\n 871 |             # columns are not empty, this is a regular row\n 872 |             assert isinstance(header, Sequence)\n 873 |             if len(header) < len(data):\n 874 |                 potential_index_names = data[len(header)]\n 875 |                 has_index_names = all(\n 876 |                     x == \"\" or x is None\n 877 |                     for i, x in enumerate(potential_index_names)\n 878 |                     if not control_row[i] and i not in index_col_set\n 879 |                 )\n 880 | \n 881 |         if is_list_like(index_col):\n 882 |             # Forward fill values for MultiIndex index.\n 883 |             if header is None:\n 884 |                 offset = 0\n 885 |             elif isinstance(header, int):\n 886 |                 offset = 1 + header\n 887 |             else:\n 888 |                 offset = 1 + max(header)\n 889 | \n 890 |             # GH34673: if MultiIndex names present and not defined in the header,\n 891 |             # offset needs to be incremented so that forward filling starts\n 892 |             # from the first MI value instead of the name\n 893 |             if has_index_names:\n 894 |                 offset += 1\n 895 | \n 896 |             # Check if we have an empty dataset\n 897 |             # before trying to collect data.\n 898 |             if offset < len(data):\n 899 |                 assert isinstance(index_col, Sequence)\n 900 | \n 901 |                 for col in index_col:\n 902 |                     last = data[offset][col]\n 903 | \n 904 |                     for row in range(offset + 1, len(data)):\n 905 |                         if data[row][col] == \"\" or data[row][col] is None:\n 906 |                             data[row][col] = last\n 907 |                         else:\n 908 |                             last = data[row][col]\n 909 | \n 910 |         # GH 12292 : error when read one empty column from excel file\n 911 |         try:\n 912 |             parser = TextParser(\n 913 |                 data,\n 914 |                 names=names,\n 915 |                 header=header,\n 916 |                 index_col=index_col,\n 917 |                 has_index_names=has_index_names,\n 918 |                 dtype=dtype,\n 919 |                 true_values=true_values,\n 920 |                 false_values=false_values,\n 921 |                 skiprows=skiprows,\n 922 |                 nrows=nrows,\n 923 |                 na_values=na_values,\n 924 |                 skip_blank_lines=False,  # GH 39808\n 925 |                 parse_dates=parse_dates,\n 926 |                 date_format=date_format,\n 927 |                 thousands=thousands,\n 928 |                 decimal=decimal,\n 929 |                 comment=comment,\n 930 |                 skipfooter=skipfooter,\n 931 |                 usecols=usecols,\n 932 |                 dtype_backend=dtype_backend,\n 933 |                 **kwds,\n 934 |             )\n 935 | \n 936 |             output[asheetname] = parser.read(nrows=nrows)\n 937 | \n 938 |             if header_names:\n 939 |                 output[asheetname].columns = output[asheetname].columns.set_names(\n 940 |                     header_names\n 941 |                 )\n 942 | \n 943 |         except EmptyDataError:\n 944 |             # No Data, return an empty DataFrame\n 945 |             output[asheetname] = DataFrame()\n 946 | \n 947 |         except Exception as err:\n 948 |             err.args = (f\"{err.args[0]} (sheet: {asheetname})\", *err.args[1:])\n 949 |             raise err\n 950 | \n 951 |         return output\n 952 | \n 953 | \n 954 | @doc(storage_options=_shared_docs[\"storage_options\"])\n 955 | class ExcelWriter(Generic[_WorkbookT]):\n 956 |     \"\"\"\n 957 |     Class for writing DataFrame objects into excel sheets.\n 958 | \n 959 |     Default is to use:\n 960 | \n 961 |     * `xlsxwriter <https://pypi.org/project/XlsxWriter/>`__ for xlsx files if xlsxwriter\n 962 |       is installed otherwise `openpyxl <https://pypi.org/project/openpyxl/>`__\n 963 |     * `odf <https://pypi.org/project/odfpy/>`__ for ods files\n 964 | \n 965 |     See :meth:`DataFrame.to_excel` for typical usage.\n 966 | \n 967 |     The writer should be used as a context manager. Otherwise, call `close()` to save\n 968 |     and close any opened file handles.\n 969 | \n 970 |     Parameters\n 971 |     ----------\n 972 |     path : str or typing.BinaryIO\n 973 |         Path to xls or xlsx or ods file.\n 974 |     engine : str (optional)\n 975 |         Engine to use for writing. If None, defaults to\n 976 |         ``io.excel.<extension>.writer``.  NOTE: can only be passed as a keyword\n 977 |         argument.\n 978 |     date_format : str, default None\n 979 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n 980 |     datetime_format : str, default None\n 981 |         Format string for datetime objects written into Excel files.\n 982 |         (e.g. 'YYYY-MM-DD HH:MM:SS').\n 983 |     mode : {{'w', 'a'}}, default 'w'\n 984 |         File mode to use (write or append). Append does not work with fsspec URLs.\n 985 |     {storage_options}\n 986 | \n 987 |     if_sheet_exists : {{'error', 'new', 'replace', 'overlay'}}, default 'error'\n 988 |         How to behave when trying to write to a sheet that already\n 989 |         exists (append mode only).\n 990 | \n 991 |         * error: raise a ValueError.\n 992 |         * new: Create a new sheet, with a name determined by the engine.\n 993 |         * replace: Delete the contents of the sheet before writing to it.\n 994 |         * overlay: Write contents to the existing sheet without first removing,\n 995 |           but possibly over top of, the existing contents.\n 996 | \n 997 |         .. versionadded:: 1.3.0\n 998 | \n 999 |         .. versionchanged:: 1.4.0\n1000 | \n1001 |            Added ``overlay`` option\n1002 | \n1003 |     engine_kwargs : dict, optional\n1004 |         Keyword arguments to be passed into the engine. These will be passed to\n1005 |         the following functions of the respective engines:\n1006 | \n1007 |         * xlsxwriter: ``xlsxwriter.Workbook(file, **engine_kwargs)``\n1008 |         * openpyxl (write mode): ``openpyxl.Workbook(**engine_kwargs)``\n1009 |         * openpyxl (append mode): ``openpyxl.load_workbook(file, **engine_kwargs)``\n1010 |         * odf: ``odf.opendocument.OpenDocumentSpreadsheet(**engine_kwargs)``\n1011 | \n1012 |         .. versionadded:: 1.3.0\n1013 | \n1014 |     See Also\n1015 |     --------\n1016 |     read_excel : Read an Excel sheet values (xlsx) file into DataFrame.\n1017 |     read_csv : Read a comma-separated values (csv) file into DataFrame.\n1018 |     read_fwf : Read a table of fixed-width formatted lines into DataFrame.\n1019 | \n1020 |     Notes\n1021 |     -----\n1022 |     For compatibility with CSV writers, ExcelWriter serializes lists\n1023 |     and dicts to strings before writing.\n1024 | \n1025 |     Examples\n1026 |     --------\n1027 |     Default usage:\n1028 | \n1029 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1030 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\") as writer:\n1031 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1032 | \n1033 |     To write to separate sheets in a single file:\n1034 | \n1035 |     >>> df1 = pd.DataFrame([[\"AAA\", \"BBB\"]], columns=[\"Spam\", \"Egg\"])  # doctest: +SKIP\n1036 |     >>> df2 = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1037 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\") as writer:\n1038 |     ...     df1.to_excel(writer, sheet_name=\"Sheet1\")  # doctest: +SKIP\n1039 |     ...     df2.to_excel(writer, sheet_name=\"Sheet2\")  # doctest: +SKIP\n1040 | \n1041 |     You can set the date format or datetime format:\n1042 | \n1043 |     >>> from datetime import date, datetime  # doctest: +SKIP\n1044 |     >>> df = pd.DataFrame(\n1045 |     ...     [\n1046 |     ...         [date(2014, 1, 31), date(1999, 9, 24)],\n1047 |     ...         [datetime(1998, 5, 26, 23, 33, 4), datetime(2014, 2, 28, 13, 5, 13)],\n1048 |     ...     ],\n1049 |     ...     index=[\"Date\", \"Datetime\"],\n1050 |     ...     columns=[\"X\", \"Y\"],\n1051 |     ... )  # doctest: +SKIP\n1052 |     >>> with pd.ExcelWriter(\n1053 |     ...     \"path_to_file.xlsx\",\n1054 |     ...     date_format=\"YYYY-MM-DD\",\n1055 |     ...     datetime_format=\"YYYY-MM-DD HH:MM:SS\",\n1056 |     ... ) as writer:\n1057 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1058 | \n1059 |     You can also append to an existing Excel file:\n1060 | \n1061 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\", mode=\"a\", engine=\"openpyxl\") as writer:\n1062 |     ...     df.to_excel(writer, sheet_name=\"Sheet3\")  # doctest: +SKIP\n1063 | \n1064 |     Here, the `if_sheet_exists` parameter can be set to replace a sheet if it\n1065 |     already exists:\n1066 | \n1067 |     >>> with pd.ExcelWriter(\n1068 |     ...     \"path_to_file.xlsx\",\n1069 |     ...     mode=\"a\",\n1070 |     ...     engine=\"openpyxl\",\n1071 |     ...     if_sheet_exists=\"replace\",\n1072 |     ... ) as writer:\n1073 |     ...     df.to_excel(writer, sheet_name=\"Sheet1\")  # doctest: +SKIP\n1074 | \n1075 |     You can also write multiple DataFrames to a single sheet. Note that the\n1076 |     ``if_sheet_exists`` parameter needs to be set to ``overlay``:\n1077 | \n1078 |     >>> with pd.ExcelWriter(\n1079 |     ...     \"path_to_file.xlsx\",\n1080 |     ...     mode=\"a\",\n1081 |     ...     engine=\"openpyxl\",\n1082 |     ...     if_sheet_exists=\"overlay\",\n1083 |     ... ) as writer:\n1084 |     ...     df1.to_excel(writer, sheet_name=\"Sheet1\")\n1085 |     ...     df2.to_excel(writer, sheet_name=\"Sheet1\", startcol=3)  # doctest: +SKIP\n1086 | \n1087 |     You can store Excel file in RAM:\n1088 | \n1089 |     >>> import io\n1090 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])\n1091 |     >>> buffer = io.BytesIO()\n1092 |     >>> with pd.ExcelWriter(buffer) as writer:\n1093 |     ...     df.to_excel(writer)\n1094 | \n1095 |     You can pack Excel file into zip archive:\n1096 | \n1097 |     >>> import zipfile  # doctest: +SKIP\n1098 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1099 |     >>> with zipfile.ZipFile(\"path_to_file.zip\", \"w\") as zf:\n1100 |     ...     with zf.open(\"filename.xlsx\", \"w\") as buffer:\n1101 |     ...         with pd.ExcelWriter(buffer) as writer:\n1102 |     ...             df.to_excel(writer)  # doctest: +SKIP\n1103 | \n1104 |     You can specify additional arguments to the underlying engine:\n1105 | \n1106 |     >>> with pd.ExcelWriter(\n1107 |     ...     \"path_to_file.xlsx\",\n1108 |     ...     engine=\"xlsxwriter\",\n1109 |     ...     engine_kwargs={{\"options\": {{\"nan_inf_to_errors\": True}}}},\n1110 |     ... ) as writer:\n1111 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1112 | \n1113 |     In append mode, ``engine_kwargs`` are passed through to\n1114 |     openpyxl's ``load_workbook``:\n1115 | \n1116 |     >>> with pd.ExcelWriter(\n1117 |     ...     \"path_to_file.xlsx\",\n1118 |     ...     engine=\"openpyxl\",\n1119 |     ...     mode=\"a\",\n1120 |     ...     engine_kwargs={{\"keep_vba\": True}},\n1121 |     ... ) as writer:\n1122 |     ...     df.to_excel(writer, sheet_name=\"Sheet2\")  # doctest: +SKIP\n1123 |     \"\"\"\n1124 | \n1125 |     # Defining an ExcelWriter implementation (see abstract methods for more...)\n1126 | \n1127 |     # - Mandatory\n1128 |     #   - ``write_cells(self, cells, sheet_name=None, startrow=0, startcol=0)``\n1129 |     #     --> called to write additional DataFrames to disk\n1130 |     #   - ``_supported_extensions`` (tuple of supported extensions), used to\n1131 |     #      check that engine supports the given extension.\n1132 |     #   - ``_engine`` - string that gives the engine name. Necessary to\n1133 |     #     instantiate class directly and bypass ``ExcelWriterMeta`` engine\n1134 |     #     lookup.\n1135 |     #   - ``save(self)`` --> called to save file to disk\n1136 |     # - Mostly mandatory (i.e. should at least exist)\n1137 |     #   - book, cur_sheet, path\n1138 | \n1139 |     # - Optional:\n1140 |     #   - ``__init__(self, path, engine=None, **kwargs)`` --> always called\n1141 |     #     with path as first argument.\n1142 | \n1143 |     # You also need to register the class with ``register_writer()``.\n1144 |     # Technically, ExcelWriter implementations don't need to subclass\n1145 |     # ExcelWriter.\n1146 | \n1147 |     _engine: str\n1148 |     _supported_extensions: tuple[str, ...]\n1149 | \n1150 |     def __new__(\n1151 |         cls,\n1152 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n1153 |         engine: str | None = None,\n1154 |         date_format: str | None = None,\n1155 |         datetime_format: str | None = None,\n1156 |         mode: str = \"w\",\n1157 |         storage_options: StorageOptions | None = None,\n1158 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n1159 |         engine_kwargs: dict | None = None,\n1160 |     ) -> Self:\n1161 |         # only switch class if generic(ExcelWriter)\n1162 |         if cls is ExcelWriter:\n1163 |             if engine is None or (isinstance(engine, str) and engine == \"auto\"):\n1164 |                 if isinstance(path, str):\n1165 |                     ext = os.path.splitext(path)[-1][1:]\n1166 |                 else:\n1167 |                     ext = \"xlsx\"\n1168 | \n1169 |                 try:\n1170 |                     engine = config.get_option(f\"io.excel.{ext}.writer\")\n1171 |                     if engine == \"auto\":\n1172 |                         engine = get_default_engine(ext, mode=\"writer\")\n1173 |                 except KeyError as err:\n1174 |                     raise ValueError(f\"No engine for filetype: '{ext}'\") from err\n1175 | \n1176 |             # for mypy\n1177 |             assert engine is not None\n1178 |             #  error: Incompatible types in assignment (expression has type\n1179 |             #  \"type[ExcelWriter[Any]]\", variable has type \"type[Self]\")\n1180 |             cls = get_writer(engine)  # type: ignore[assignment]\n1181 | \n1182 |         return object.__new__(cls)\n1183 | \n1184 |     # declare external properties you can count on\n1185 |     _path = None\n1186 | \n1187 |     @property\n1188 |     def supported_extensions(self) -> tuple[str, ...]:\n1189 |         \"\"\"Extensions that writer engine supports.\"\"\"\n1190 |         return self._supported_extensions\n1191 | \n1192 |     @property\n1193 |     def engine(self) -> str:\n1194 |         \"\"\"Name of engine.\"\"\"\n1195 |         return self._engine\n1196 | \n1197 |     @property\n1198 |     def sheets(self) -> dict[str, Any]:\n1199 |         \"\"\"Mapping of sheet names to sheet objects.\"\"\"\n1200 |         raise NotImplementedError\n1201 | \n1202 |     @property\n1203 |     def book(self) -> _WorkbookT:\n1204 |         \"\"\"\n1205 |         Book instance. Class type will depend on the engine used.\n1206 | \n1207 |         This attribute can be used to access engine-specific features.\n1208 |         \"\"\"\n1209 |         raise NotImplementedError\n1210 | \n1211 |     def _write_cells(\n1212 |         self,\n1213 |         cells,\n1214 |         sheet_name: str | None = None,\n1215 |         startrow: int = 0,\n1216 |         startcol: int = 0,\n1217 |         freeze_panes: tuple[int, int] | None = None,\n1218 |     ) -> None:\n1219 |         \"\"\"\n1220 |         Write given formatted cells into Excel an excel sheet\n1221 | \n1222 |         Parameters\n1223 |         ----------\n1224 |         cells : generator\n1225 |             cell of formatted data to save to Excel sheet\n1226 |         sheet_name : str, default None\n1227 |             Name of Excel sheet, if None, then use self.cur_sheet\n1228 |         startrow : upper left cell row to dump data frame\n1229 |         startcol : upper left cell column to dump data frame\n1230 |         freeze_panes: int tuple of length 2\n1231 |             contains the bottom-most row and right-most column to freeze\n1232 |         \"\"\"\n1233 |         raise NotImplementedError\n1234 | \n1235 |     def _save(self) -> None:\n1236 |         \"\"\"\n1237 |         Save workbook to disk.\n1238 |         \"\"\"\n1239 |         raise NotImplementedError\n1240 | \n1241 |     def __init__(\n1242 |         self,\n1243 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n1244 |         engine: str | None = None,\n1245 |         date_format: str | None = None,\n1246 |         datetime_format: str | None = None,\n1247 |         mode: str = \"w\",\n1248 |         storage_options: StorageOptions | None = None,\n1249 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n1250 |         engine_kwargs: dict[str, Any] | None = None,\n1251 |     ) -> None:\n1252 |         # validate that this engine can handle the extension\n1253 |         if isinstance(path, str):\n1254 |             ext = os.path.splitext(path)[-1]\n1255 |             self.check_extension(ext)\n1256 | \n1257 |         # use mode to open the file\n1258 |         if \"b\" not in mode:\n1259 |             mode += \"b\"\n1260 |         # use \"a\" for the user to append data to excel but internally use \"r+\" to let\n1261 |         # the excel backend first read the existing file and then write any data to it\n1262 |         mode = mode.replace(\"a\", \"r+\")\n1263 | \n1264 |         if if_sheet_exists not in (None, \"error\", \"new\", \"replace\", \"overlay\"):\n1265 |             raise ValueError(\n1266 |                 f\"'{if_sheet_exists}' is not valid for if_sheet_exists. \"\n1267 |                 \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n1268 |             )\n1269 |         if if_sheet_exists and \"r+\" not in mode:\n1270 |             raise ValueError(\"if_sheet_exists is only valid in append mode (mode='a')\")\n1271 |         if if_sheet_exists is None:\n1272 |             if_sheet_exists = \"error\"\n1273 |         self._if_sheet_exists = if_sheet_exists\n1274 | \n1275 |         # cast ExcelWriter to avoid adding 'if self._handles is not None'\n1276 |         self._handles = IOHandles(\n1277 |             cast(IO[bytes], path), compression={\"compression\": None}\n1278 |         )\n1279 |         if not isinstance(path, ExcelWriter):\n1280 |             self._handles = get_handle(\n1281 |                 path, mode, storage_options=storage_options, is_text=False\n1282 |             )\n1283 |         self._cur_sheet = None\n1284 | \n1285 |         if date_format is None:\n1286 |             self._date_format = \"YYYY-MM-DD\"\n1287 |         else:\n1288 |             self._date_format = date_format\n1289 |         if datetime_format is None:\n1290 |             self._datetime_format = \"YYYY-MM-DD HH:MM:SS\"\n1291 |         else:\n1292 |             self._datetime_format = datetime_format\n1293 | \n1294 |         self._mode = mode\n1295 | \n1296 |     @property\n1297 |     def date_format(self) -> str:\n1298 |         \"\"\"\n1299 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n1300 |         \"\"\"\n1301 |         return self._date_format\n1302 | \n1303 |     @property\n1304 |     def datetime_format(self) -> str:\n1305 |         \"\"\"\n1306 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n1307 |         \"\"\"\n1308 |         return self._datetime_format\n1309 | \n1310 |     @property\n1311 |     def if_sheet_exists(self) -> str:\n1312 |         \"\"\"\n1313 |         How to behave when writing to a sheet that already exists in append mode.\n1314 |         \"\"\"\n1315 |         return self._if_sheet_exists\n1316 | \n1317 |     def __fspath__(self) -> str:\n1318 |         return getattr(self._handles.handle, \"name\", \"\")\n1319 | \n1320 |     def _get_sheet_name(self, sheet_name: str | None) -> str:\n1321 |         if sheet_name is None:\n1322 |             sheet_name = self._cur_sheet\n1323 |         if sheet_name is None:  # pragma: no cover\n1324 |             raise ValueError(\"Must pass explicit sheet_name or set _cur_sheet property\")\n1325 |         return sheet_name\n1326 | \n1327 |     def _value_with_fmt(\n1328 |         self, val\n1329 |     ) -> tuple[\n1330 |         int | float | bool | str | datetime.datetime | datetime.date, str | None\n1331 |     ]:\n1332 |         \"\"\"\n1333 |         Convert numpy types to Python types for the Excel writers.\n1334 | \n1335 |         Parameters\n1336 |         ----------\n1337 |         val : object\n1338 |             Value to be written into cells\n1339 | \n1340 |         Returns\n1341 |         -------\n1342 |         Tuple with the first element being the converted value and the second\n1343 |             being an optional format\n1344 |         \"\"\"\n1345 |         fmt = None\n1346 | \n1347 |         if is_integer(val):\n1348 |             val = int(val)\n1349 |         elif is_float(val):\n1350 |             val = float(val)\n1351 |         elif is_bool(val):\n1352 |             val = bool(val)\n1353 |         elif is_decimal(val):\n1354 |             val = Decimal(val)\n1355 |         elif isinstance(val, datetime.datetime):\n1356 |             fmt = self._datetime_format\n1357 |         elif isinstance(val, datetime.date):\n1358 |             fmt = self._date_format\n1359 |         elif isinstance(val, datetime.timedelta):\n1360 |             val = val.total_seconds() / 86400\n1361 |             fmt = \"0\"\n1362 |         else:\n1363 |             val = str(val)\n1364 |             # GH#56954\n1365 |             # Excel's limitation on cell contents is 32767 characters\n1366 |             # xref https://support.microsoft.com/en-au/office/excel-specifications-and-limits-1672b34d-7043-467e-8e27-269d656771c3\n1367 |             if len(val) > 32767:\n1368 |                 warnings.warn(\n1369 |                     f\"Cell contents too long ({len(val)}), \"\n1370 |                     \"truncated to 32767 characters\",\n1371 |                     UserWarning,\n1372 |                     stacklevel=find_stack_level(),\n1373 |                 )\n1374 |         return val, fmt\n1375 | \n1376 |     @classmethod\n1377 |     def check_extension(cls, ext: str) -> Literal[True]:\n1378 |         \"\"\"\n1379 |         checks that path's extension against the Writer's supported\n1380 |         extensions.  If it isn't supported, raises UnsupportedFiletypeError.\n1381 |         \"\"\"\n1382 |         if ext.startswith(\".\"):\n1383 |             ext = ext[1:]\n1384 |         if not any(ext in extension for extension in cls._supported_extensions):\n1385 |             raise ValueError(f\"Invalid extension for engine '{cls.engine}': '{ext}'\")\n1386 |         return True\n1387 | \n1388 |     # Allow use as a contextmanager\n1389 |     def __enter__(self) -> Self:\n1390 |         return self\n1391 | \n1392 |     def __exit__(\n1393 |         self,\n1394 |         exc_type: type[BaseException] | None,\n1395 |         exc_value: BaseException | None,\n1396 |         traceback: TracebackType | None,\n1397 |     ) -> None:\n1398 |         self.close()\n1399 | \n1400 |     def close(self) -> None:\n1401 |         \"\"\"synonym for save, to make it more file-like\"\"\"\n1402 |         self._save()\n1403 |         self._handles.close()\n1404 | \n1405 | \n1406 | XLS_SIGNATURES = (\n1407 |     b\"\\x09\\x00\\x04\\x00\\x07\\x00\\x10\\x00\",  # BIFF2\n1408 |     b\"\\x09\\x02\\x06\\x00\\x00\\x00\\x10\\x00\",  # BIFF3\n1409 |     b\"\\x09\\x04\\x06\\x00\\x00\\x00\\x10\\x00\",  # BIFF4\n1410 |     b\"\\xd0\\xcf\\x11\\xe0\\xa1\\xb1\\x1a\\xe1\",  # Compound File Binary\n1411 | )\n1412 | ZIP_SIGNATURE = b\"PK\\x03\\x04\"\n1413 | PEEK_SIZE = max(map(len, XLS_SIGNATURES + (ZIP_SIGNATURE,)))\n1414 | \n1415 | \n1416 | @doc(storage_options=_shared_docs[\"storage_options\"])\n1417 | def inspect_excel_format(\n1418 |     content_or_path: FilePath | ReadBuffer[bytes],\n1419 |     storage_options: StorageOptions | None = None,\n1420 | ) -> str | None:\n1421 |     \"\"\"\n1422 |     Inspect the path or content of an excel file and get its format.\n1423 | \n1424 |     Adopted from xlrd: https://github.com/python-excel/xlrd.\n1425 | \n1426 |     Parameters\n1427 |     ----------\n1428 |     content_or_path : str or file-like object\n1429 |         Path to file or content of file to inspect. May be a URL.\n1430 |     {storage_options}\n1431 | \n1432 |     Returns\n1433 |     -------\n1434 |     str or None\n1435 |         Format of file if it can be determined.\n1436 | \n1437 |     Raises\n1438 |     ------\n1439 |     ValueError\n1440 |         If resulting stream is empty.\n1441 |     BadZipFile\n1442 |         If resulting stream does not have an XLS signature and is not a valid zipfile.\n1443 |     \"\"\"\n1444 |     with get_handle(\n1445 |         content_or_path, \"rb\", storage_options=storage_options, is_text=False\n1446 |     ) as handle:\n1447 |         stream = handle.handle\n1448 |         stream.seek(0)\n1449 |         buf = stream.read(PEEK_SIZE)\n1450 |         if buf is None:\n1451 |             raise ValueError(\"stream is empty\")\n1452 |         assert isinstance(buf, bytes)\n1453 |         peek = buf\n1454 |         stream.seek(0)\n1455 | \n1456 |         if any(peek.startswith(sig) for sig in XLS_SIGNATURES):\n1457 |             return \"xls\"\n1458 |         elif not peek.startswith(ZIP_SIGNATURE):\n1459 |             return None\n1460 | \n1461 |         with zipfile.ZipFile(stream) as zf:\n1462 |             # Workaround for some third party files that use forward slashes and\n1463 |             # lower case names.\n1464 |             component_names = {\n1465 |                 name.replace(\"\\\\\", \"/\").lower() for name in zf.namelist()\n1466 |             }\n1467 | \n1468 |         if \"xl/workbook.xml\" in component_names:\n1469 |             return \"xlsx\"\n1470 |         if \"xl/workbook.bin\" in component_names:\n1471 |             return \"xlsb\"\n1472 |         if \"content.xml\" in component_names:\n1473 |             return \"ods\"\n1474 |         return \"zip\"\n1475 | \n1476 | \n1477 | @doc(storage_options=_shared_docs[\"storage_options\"])\n1478 | class ExcelFile:\n1479 |     \"\"\"\n1480 |     Class for parsing tabular Excel sheets into DataFrame objects.\n1481 | \n1482 |     See read_excel for more documentation.\n1483 | \n1484 |     Parameters\n1485 |     ----------\n1486 |     path_or_buffer : str, bytes, pathlib.Path,\n1487 |         A file-like object, xlrd workbook or openpyxl workbook.\n1488 |         If a string or path object, expected to be a path to a\n1489 |         .xls, .xlsx, .xlsb, .xlsm, .odf, .ods, or .odt file.\n1490 |     engine : str, default None\n1491 |         If io is not a buffer or path, this must be set to identify io.\n1492 |         Supported engines: ``xlrd``, ``openpyxl``, ``odf``, ``pyxlsb``, ``calamine``\n1493 |         Engine compatibility :\n1494 | \n1495 |         - ``xlrd`` supports old-style Excel files (.xls).\n1496 |         - ``openpyxl`` supports newer Excel file formats.\n1497 |         - ``odf`` supports OpenDocument file formats (.odf, .ods, .odt).\n1498 |         - ``pyxlsb`` supports Binary Excel files.\n1499 |         - ``calamine`` supports Excel (.xls, .xlsx, .xlsm, .xlsb)\n1500 |           and OpenDocument (.ods) file formats.\n1501 | \n1502 |         .. versionchanged:: 1.2.0\n1503 | \n1504 |            The engine `xlrd <https://xlrd.readthedocs.io/en/latest/>`_\n1505 |            now only supports old-style ``.xls`` files.\n1506 |            When ``engine=None``, the following logic will be\n1507 |            used to determine the engine:\n1508 | \n1509 |            - If ``path_or_buffer`` is an OpenDocument format (.odf, .ods, .odt),\n1510 |              then `odf <https://pypi.org/project/odfpy/>`_ will be used.\n1511 |            - Otherwise if ``path_or_buffer`` is an xls format,\n1512 |              ``xlrd`` will be used.\n1513 |            - Otherwise if ``path_or_buffer`` is in xlsb format,\n1514 |              `pyxlsb <https://pypi.org/project/pyxlsb/>`_ will be used.\n1515 | \n1516 |         .. versionadded:: 1.3.0\n1517 | \n1518 |            - Otherwise if `openpyxl <https://pypi.org/project/openpyxl/>`_ is installed,\n1519 |              then ``openpyxl`` will be used.\n1520 |            - Otherwise if ``xlrd >= 2.0`` is installed, a ``ValueError`` will be raised.\n1521 | \n1522 |         .. warning::\n1523 | \n1524 |            Please do not report issues when using ``xlrd`` to read ``.xlsx`` files.\n1525 |            This is not supported, switch to using ``openpyxl`` instead.\n1526 |     {storage_options}\n1527 |     engine_kwargs : dict, optional\n1528 |         Arbitrary keyword arguments passed to excel engine.\n1529 | \n1530 |     See Also\n1531 |     --------\n1532 |     DataFrame.to_excel : Write DataFrame to an Excel file.\n1533 |     DataFrame.to_csv : Write DataFrame to a comma-separated values (csv) file.\n1534 |     read_csv : Read a comma-separated values (csv) file into DataFrame.\n1535 |     read_fwf : Read a table of fixed-width formatted lines into DataFrame.\n1536 | \n1537 |     Examples\n1538 |     --------\n1539 |     >>> file = pd.ExcelFile(\"myfile.xlsx\")  # doctest: +SKIP\n1540 |     >>> with pd.ExcelFile(\"myfile.xls\") as xls:  # doctest: +SKIP\n1541 |     ...     df1 = pd.read_excel(xls, \"Sheet1\")  # doctest: +SKIP\n1542 |     \"\"\"\n1543 | \n1544 |     from pandas.io.excel._calamine import CalamineReader\n1545 |     from pandas.io.excel._odfreader import ODFReader\n1546 |     from pandas.io.excel._openpyxl import OpenpyxlReader\n1547 |     from pandas.io.excel._pyxlsb import PyxlsbReader\n1548 |     from pandas.io.excel._xlrd import XlrdReader\n1549 | \n1550 |     _engines: Mapping[str, Any] = {\n1551 |         \"xlrd\": XlrdReader,\n1552 |         \"openpyxl\": OpenpyxlReader,\n1553 |         \"odf\": ODFReader,\n1554 |         \"pyxlsb\": PyxlsbReader,\n1555 |         \"calamine\": CalamineReader,\n1556 |     }\n1557 | \n1558 |     def __init__(\n1559 |         self,\n1560 |         path_or_buffer,\n1561 |         engine: str | None = None,\n1562 |         storage_options: StorageOptions | None = None,\n1563 |         engine_kwargs: dict | None = None,\n1564 |     ) -> None:\n1565 |         if engine_kwargs is None:\n1566 |             engine_kwargs = {}\n1567 | \n1568 |         if engine is not None and engine not in self._engines:\n1569 |             raise ValueError(f\"Unknown engine: {engine}\")\n1570 | \n1571 |         # Always a string\n1572 |         self._io = stringify_path(path_or_buffer)\n1573 | \n1574 |         if engine is None:\n1575 |             # Only determine ext if it is needed\n1576 |             ext: str | None = None\n1577 | \n1578 |             if not isinstance(\n1579 |                 path_or_buffer, (str, os.PathLike, ExcelFile)\n1580 |             ) and not is_file_like(path_or_buffer):\n1581 |                 # GH#56692 - avoid importing xlrd if possible\n1582 |                 if import_optional_dependency(\"xlrd\", errors=\"ignore\") is None:\n1583 |                     xlrd_version = None\n1584 |                 else:\n1585 |                     import xlrd\n1586 | \n1587 |                     xlrd_version = Version(get_version(xlrd))\n1588 | \n1589 |                 if xlrd_version is not None and isinstance(path_or_buffer, xlrd.Book):\n1590 |                     ext = \"xls\"\n1591 | \n1592 |             if ext is None:\n1593 |                 ext = inspect_excel_format(\n1594 |                     content_or_path=path_or_buffer, storage_options=storage_options\n1595 |                 )\n1596 |                 if ext is None:\n1597 |                     raise ValueError(\n1598 |                         \"Excel file format cannot be determined, you must specify \"\n1599 |                         \"an engine manually.\"\n1600 |                     )\n1601 | \n1602 |             engine = config.get_option(f\"io.excel.{ext}.reader\")\n1603 |             if engine == \"auto\":\n1604 |                 engine = get_default_engine(ext, mode=\"reader\")\n1605 | \n1606 |         assert engine is not None\n1607 |         self.engine = engine\n1608 |         self.storage_options = storage_options\n1609 | \n1610 |         self._reader = self._engines[engine](\n1611 |             self._io,\n1612 |             storage_options=storage_options,\n1613 |             engine_kwargs=engine_kwargs,\n1614 |         )\n1615 | \n1616 |     def __fspath__(self):\n1617 |         return self._io\n1618 | \n1619 |     def parse(\n1620 |         self,\n1621 |         sheet_name: str | int | list[int] | list[str] | None = 0,\n1622 |         header: int | Sequence[int] | None = 0,\n1623 |         names: SequenceNotStr[Hashable] | range | None = None,\n1624 |         index_col: int | Sequence[int] | None = None,\n1625 |         usecols=None,\n1626 |         converters=None,\n1627 |         true_values: Iterable[Hashable] | None = None,\n1628 |         false_values: Iterable[Hashable] | None = None,\n1629 |         skiprows: Sequence[int] | int | Callable[[int], object] | None = None,\n1630 |         nrows: int | None = None,\n1631 |         na_values=None,\n1632 |         parse_dates: list | dict | bool = False,\n1633 |         date_format: str | dict[Hashable, str] | None = None,\n1634 |         thousands: str | None = None,\n1635 |         comment: str | None = None,\n1636 |         skipfooter: int = 0,\n1637 |         dtype_backend: DtypeBackend | lib.NoDefault = lib.no_default,\n1638 |         **kwds,\n1639 |     ) -> DataFrame | dict[str, DataFrame] | dict[int, DataFrame]:\n1640 |         \"\"\"\n1641 |         Parse specified sheet(s) into a DataFrame.\n1642 | \n1643 |         Equivalent to read_excel(ExcelFile, ...)  See the read_excel\n1644 |         docstring for more info on accepted parameters.\n1645 | \n1646 |         Parameters\n1647 |         ----------\n1648 |         sheet_name : str, int, list, or None, default 0\n1649 |             Strings are used for sheet names. Integers are used in zero-indexed\n1650 |             sheet positions (chart sheets do not count as a sheet position).\n1651 |             Lists of strings/integers are used to request multiple sheets.\n1652 |             Specify ``None`` to get all worksheets.\n1653 |         header : int, list of int, default 0\n1654 |             Row (0-indexed) to use for the column labels of the parsed\n1655 |             DataFrame. If a list of integers is passed those row positions will\n1656 |             be combined into a ``MultiIndex``. Use None if there is no header.\n1657 |         names : array-like, default None\n1658 |             List of column names to use. If file contains no header row,\n1659 |             then you should explicitly pass header=None.\n1660 |         index_col : int, str, list of int, default None\n1661 |             Column (0-indexed) to use as the row labels of the DataFrame.\n1662 |             Pass None if there is no such column.  If a list is passed,\n1663 |             those columns will be combined into a ``MultiIndex``.  If a\n1664 |             subset of data is selected with ``usecols``, index_col\n1665 |             is based on the subset.\n1666 | \n1667 |             Missing values will be forward filled to allow roundtripping with\n1668 |             ``to_excel`` for ``merged_cells=True``. To avoid forward filling the\n1669 |             missing values use ``set_index`` after reading the data instead of\n1670 |             ``index_col``.\n1671 |         usecols : str, list-like, or callable, default None\n1672 |             * If None, then parse all columns.\n1673 |             * If str, then indicates comma separated list of Excel column letters\n1674 |               and column ranges (e.g. \"A:E\" or \"A,C,E:F\"). Ranges are inclusive of\n1675 |               both sides.\n1676 |             * If list of int, then indicates list of column numbers to be parsed\n1677 |               (0-indexed).\n1678 |             * If list of string, then indicates list of column names to be parsed.\n1679 |             * If callable, then evaluate each column name against it and parse the\n1680 |               column if the callable returns ``True``.\n1681 | \n1682 |             Returns a subset of the columns according to behavior above.\n1683 |         converters : dict, default None\n1684 |             Dict of functions for converting values in certain columns. Keys can\n1685 |             either be integers or column labels, values are functions that take one\n1686 |             input argument, the Excel cell content, and return the transformed\n1687 |             content.\n1688 |         true_values : list, default None\n1689 |             Values to consider as True.\n1690 |         false_values : list, default None\n1691 |             Values to consider as False.\n1692 |         skiprows : list-like, int, or callable, optional\n1693 |             Line numbers to skip (0-indexed) or number of lines to skip (int) at the\n1694 |             start of the file. If callable, the callable function will be evaluated\n1695 |             against the row indices, returning True if the row should be skipped and\n1696 |             False otherwise. An example of a valid callable argument would be ``lambda\n1697 |             x: x in [0, 2]``.\n1698 |         nrows : int, default None\n1699 |             Number of rows to parse.\n1700 |         na_values : scalar, str, list-like, or dict, default None\n1701 |             Additional strings to recognize as NA/NaN. If dict passed, specific\n1702 |             per-column NA values.\n1703 |         parse_dates : bool, list-like, or dict, default False\n1704 |             The behavior is as follows:\n1705 | \n1706 |             * ``bool``. If True -> try parsing the index.\n1707 |             * ``list`` of int or names. e.g. If [1, 2, 3] -> try parsing columns 1, 2, 3\n1708 |               each as a separate date column.\n1709 |             * ``list`` of lists. e.g.  If [[1, 3]] -> combine columns 1 and 3 and\n1710 |               parse as a single date column.\n1711 |             * ``dict``, e.g. {{'foo' : [1, 3]}} -> parse columns 1, 3 as date and call\n1712 |               result 'foo'\n1713 | \n1714 |             If a column or index contains an unparsable date, the entire column or\n1715 |             index will be returned unaltered as an object data type. If you\n1716 |             don`t want to parse some cells as date just change their type\n1717 |             in Excel to \"Text\".For non-standard datetime parsing, use\n1718 |             ``pd.to_datetime`` after ``pd.read_excel``.\n1719 | \n1720 |             Note: A fast-path exists for iso8601-formatted dates.\n1721 |         date_format : str or dict of column -> format, default ``None``\n1722 |            If used in conjunction with ``parse_dates``, will parse dates\n1723 |            according to this format. For anything more complex,\n1724 |            please read in as ``object`` and then apply :func:`to_datetime` as-needed.\n1725 |         thousands : str, default None\n1726 |             Thousands separator for parsing string columns to numeric.  Note that\n1727 |             this parameter is only necessary for columns stored as TEXT in Excel,\n1728 |             any numeric columns will automatically be parsed, regardless of display\n1729 |             format.\n1730 |         comment : str, default None\n1731 |             Comments out remainder of line. Pass a character or characters to this\n1732 |             argument to indicate comments in the input file. Any data between the\n1733 |             comment string and the end of the current line is ignored.\n1734 |         skipfooter : int, default 0\n1735 |             Rows at the end to skip (0-indexed).\n1736 |         dtype_backend : {{'numpy_nullable', 'pyarrow'}}\n1737 |             Back-end data type applied to the resultant :class:`DataFrame`\n1738 |             (still experimental). If not specified, the default behavior\n1739 |             is to not use nullable data types. If specified, the behavior\n1740 |             is as follows:\n1741 | \n1742 |             * ``\"numpy_nullable\"``: returns nullable-dtype-backed :class:`DataFrame`\n1743 |             * ``\"pyarrow\"``: returns pyarrow-backed nullable\n1744 |               :class:`ArrowDtype` :class:`DataFrame`\n1745 | \n1746 |             .. versionadded:: 2.0\n1747 |         **kwds : dict, optional\n1748 |             Arbitrary keyword arguments passed to excel engine.\n1749 | \n1750 |         Returns\n1751 |         -------\n1752 |         DataFrame or dict of DataFrames\n1753 |             DataFrame from the passed in Excel file.\n1754 | \n1755 |         See Also\n1756 |         --------\n1757 |         read_excel : Read an Excel sheet values (xlsx) file into DataFrame.\n1758 |         read_csv : Read a comma-separated values (csv) file into DataFrame.\n1759 |         read_fwf : Read a table of fixed-width formatted lines into DataFrame.\n1760 | \n1761 |         Examples\n1762 |         --------\n1763 |         >>> df = pd.DataFrame([[1, 2, 3], [4, 5, 6]], columns=[\"A\", \"B\", \"C\"])\n1764 |         >>> df.to_excel(\"myfile.xlsx\")  # doctest: +SKIP\n1765 |         >>> file = pd.ExcelFile(\"myfile.xlsx\")  # doctest: +SKIP\n1766 |         >>> file.parse()  # doctest: +SKIP\n1767 |         \"\"\"\n1768 |         return self._reader.parse(\n1769 |             sheet_name=sheet_name,\n1770 |             header=header,\n1771 |             names=names,\n1772 |             index_col=index_col,\n1773 |             usecols=usecols,\n1774 |             converters=converters,\n1775 |             true_values=true_values,\n1776 |             false_values=false_values,\n1777 |             skiprows=skiprows,\n1778 |             nrows=nrows,\n1779 |             na_values=na_values,\n1780 |             parse_dates=parse_dates,\n1781 |             date_format=date_format,\n1782 |             thousands=thousands,\n1783 |             comment=comment,\n1784 |             skipfooter=skipfooter,\n1785 |             dtype_backend=dtype_backend,\n1786 |             **kwds,\n1787 |         )\n1788 | \n1789 |     @property\n1790 |     def book(self):\n1791 |         \"\"\"\n1792 |         Gets the Excel workbook.\n1793 | \n1794 |         Workbook is the top-level container for all document information.\n1795 | \n1796 |         Returns\n1797 |         -------\n1798 |         Excel Workbook\n1799 |             The workbook object of the type defined by the engine being used.\n1800 | \n1801 |         See Also\n1802 |         --------\n1803 |         read_excel : Read an Excel file into a pandas DataFrame.\n1804 | \n1805 |         Examples\n1806 |         --------\n1807 |         >>> file = pd.ExcelFile(\"myfile.xlsx\")  # doctest: +SKIP\n1808 |         >>> file.book  # doctest: +SKIP\n1809 |         <openpyxl.workbook.workbook.Workbook object at 0x11eb5ad70>\n1810 |         >>> file.book.path  # doctest: +SKIP\n1811 |         '/xl/workbook.xml'\n1812 |         >>> file.book.active  # doctest: +SKIP\n1813 |         <openpyxl.worksheet._read_only.ReadOnlyWorksheet object at 0x11eb5b370>\n1814 |         >>> file.book.sheetnames  # doctest: +SKIP\n1815 |         ['Sheet1', 'Sheet2']\n1816 |         \"\"\"\n1817 |         return self._reader.book\n1818 | \n1819 |     @property\n1820 |     def sheet_names(self):\n1821 |         \"\"\"\n1822 |         Names of the sheets in the document.\n1823 | \n1824 |         This is particularly useful for loading a specific sheet into a DataFrame when\n1825 |         you do not know the sheet names beforehand.\n1826 | \n1827 |         Returns\n1828 |         -------\n1829 |         list of str\n1830 |             List of sheet names in the document.\n1831 | \n1832 |         See Also\n1833 |         --------\n1834 |         ExcelFile.parse : Parse a sheet into a DataFrame.\n1835 |         read_excel : Read an Excel file into a pandas DataFrame. If you know the sheet\n1836 |             names, it may be easier to specify them directly to read_excel.\n1837 | \n1838 |         Examples\n1839 |         --------\n1840 |         >>> file = pd.ExcelFile(\"myfile.xlsx\")  # doctest: +SKIP\n1841 |         >>> file.sheet_names  # doctest: +SKIP\n1842 |         [\"Sheet1\", \"Sheet2\"]\n1843 |         \"\"\"\n1844 |         return self._reader.sheet_names\n1845 | \n1846 |     def close(self) -> None:\n1847 |         \"\"\"close io if necessary\"\"\"\n1848 |         self._reader.close()\n1849 | \n1850 |     def __enter__(self) -> Self:\n1851 |         return self\n1852 | \n1853 |     def __exit__(\n1854 |         self,\n1855 |         exc_type: type[BaseException] | None,\n1856 |         exc_value: BaseException | None,\n1857 |         traceback: TracebackType | None,\n1858 |     ) -> None:\n1859 |         self.close()\n1860 | \n```\n"}, {"content": "Based on my analysis, I can now provide the locations that need to be updated to add documentation for the `merge_cells=\"columns\"` feature. Here's the output in the requested format:\n\n```\npandas/core/generic.py\nline: 2214-2216\nclass: NDFrame\nfunction: to_excel\n\npandas/io/formats/excel.py\nline: 633-634\nclass: ExcelFormatter\nfunction: _format_header_mi\n\npandas/io/excel/_xlsxwriter.py\nline: 274-282\nclass: XlsxWriter\nfunction: _write_cells\n\npandas/io/excel/_base.py\nline: 1419-1420\nclass: ExcelWriter\nfunction: _write_cells\n\npandas/io/formats/excel.py\nline: 785-864\nclass: ExcelFormatter\nfunction: _format_hierarchical_rows\n```\n\nThese locations are ordered by importance, with the primary implementation being in the `to_excel` method, followed by the helper functions that implement the actual merging functionality.\n\nThe `merge_cells` parameter is already supported in the codebase as indicated by the existence of PR #353384, and these locations show where the documentation needs to be updated to reflect this existing functionality. The current implementation allows `merge_cells` to accept three values:\n1. `True` - merge all MultiIndex and hierarchical rows\n2. `False` - disable merging (default)\n3. `\"columns\"` - merge only columns when there are hierarchical columns\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 119181, "completion_tokens": 550}, "time": 253.41808819770813}]}}
{"instance_id": "matplotlib__matplotlib-29265", "found_files": [["lib/matplotlib/collections.py"]], "found_modules": [["lib/matplotlib/transforms.py:Transform", "lib/matplotlib/collections.py:LineCollection", "lib/matplotlib/widgets.py:RadioButtons", "lib/matplotlib/backends/backend_pdf.py:PdfFile", "lib/matplotlib/cbook.py:index_of", "lib/matplotlib/lines.py:VertexSelector"]], "found_entities": [["lib/matplotlib/transforms.py:Transform.transform_path_non_affine", "lib/matplotlib/collections.py:LineCollection.set_alpha", "lib/matplotlib/collections.py:LineCollection.get_color", "lib/matplotlib/widgets.py:RadioButtons._clear", "lib/matplotlib/backends/backend_pdf.py:PdfFile.imageObject", "lib/matplotlib/cbook.py:index_of", "lib/matplotlib/transforms.py:Transform.inverted", "lib/matplotlib/lines.py:VertexSelector.process_selected", "lib/matplotlib/collections.py:LineCollection.get_segments"]], "raw_output_loc": ["Based on my analysis, I can now provide the locations that need modification to implement the requested feature improvement for the LineCollection docstring. Here's the output in the requested format:\n\n```\nlib/matplotlib/collections.py\nline: 1614-1622\nline: 1615-1626\nclass: LineCollection\nfunction: __init__\n\nlib/matplotlib/collections.py\nline: 1664-1686\nclass: LineCollection\nfunction: get_segments\n\nlib/matplotlib/collections.py\nline: 1700-1704\nclass: LineCollection\nfunction: set_alpha\n\nlib/matplotlib/collections.py\nline: 1721-1722\nclass: LineCollection\nfunction: get_color\n\nlib/matplotlib/collections.py\nline: 1724\nclass: LineCollection\nfunction: set_colors\n```\n\nThese locations are ordered by importance, with the primary docstring section being the most critical since it directly addresses the feature request. The other locations are included because they provide context about how the LineCollection class works and how its docstring should be updated consistently across related methods."], "meta_data": {"repo": "matplotlib/matplotlib", "base_commit": "0406a56b051a371ccf81d2946126580651a645f2", "problem_statement": "Improve LineCollection docstring further\n              (M, 2)\r\n\r\nI would perhaps completely drop the \"list of points\" and just write\r\n```\r\nA sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\r\narray-like of points::\r\n\r\n    line0 = [(x0, y0), (x1, y1), ...]\r\n\r\nEach line can...\r\n```\r\n\r\n_Originally posted by @anntzer in https://github.com/matplotlib/matplotlib/pull/26676#discussion_r1313026557_\r\n\r\n\r\n            \n", "patch": "diff --git a/lib/matplotlib/collections.py b/lib/matplotlib/collections.py\nindex a78f1838357e..f18d5a4c3a8c 100644\n--- a/lib/matplotlib/collections.py\n+++ b/lib/matplotlib/collections.py\n@@ -1612,14 +1612,13 @@ def __init__(self, segments,  # Can be None.\n         \"\"\"\n         Parameters\n         ----------\n-        segments : list of array-like\n-            A sequence (*line0*, *line1*, *line2*) of lines, where each line is a list\n-            of points::\n+        segments : list of (N, 2) array-like\n+            A sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\n+            array-like containing points::\n \n-                lineN = [(x0, y0), (x1, y1), ... (xm, ym)]\n+                line0 = [(x0, y0), (x1, y1), ...]\n \n-            or the equivalent Mx2 numpy array with two columns. Each line\n-            can have a different number of segments.\n+            Each line can contain a different number of points.\n         linewidths : float or list of float, default: :rc:`lines.linewidth`\n             The width of each line in points.\n         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n"}, "usage": {"cost($)": "0", "prompt_tokens": 109463, "completion_tokens": 548}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'matplotlib' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Improve LineCollection docstring further\n\n(M, 2)\r\n\r\nI would perhaps completely drop the \"list of points\" and just write\r\n```\r\nA sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\r\narray-like of points::\r\n\r\n    line0 = [(x0, y0), (x1, y1), ...]\r\n\r\nEach line can...\r\n```\r\n\r\n_Originally posted by @anntzer in https://github.com/matplotlib/matplotlib/pull/26676#discussion_r1313026557_\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n\n\nSupplemental context information:\n\nYou will receive supplemental context for the current task. Use it to better understand the issue and to localize the relevant code more accurately.\n\nTreat this context as additional evidence, not as the final answer.\n- It may contain noise.\n- It may be incomplete.\n- You should carefully analyze it and decide how to use it when searching for relevant code locations.\n\nDepending on the settings, the supplemental context may include:\n1. Unique artifacts\n2. Unique dependency tree\n\n## How to use this supplemental context\n- Use it to identify candidate files, classes, functions, and execution paths that may be relevant to the issue.\n- Cross-check it against the issue description and the repository evidence you collect.\n- Do not assume every artifact is important.\n- Do not assume the provided context is sufficient by itself.\n\n## What the provided information means\nAssume the issue sent to you is a feature request requesting feature F.\n\n1. Unique artifacts\n- The unique artifacts are obtained through a Software Reconnaissance-style analysis.\n- For the requested feature described in the issue text, two Python scripts, A.py and B.py, describing the same process are executed and traced.\n- The only difference is that A.py is executed with feature F enabled, while B.py is executed with the feature disabled.\n- By comparing the two tracing results, the overlapping part between the trace for A.py and B.py is subtracted.\n- The remaining artifacts are the unique artifacts that appear only in A.py.\n- These unique artifacts are likely to be related to the feature and thus to the issue.\n\n2. Unique dependency tree\n- The unique dependency tree is obtained by further analyzing the data dependencies of the unique artifacts.\n- It contains the dataflows associated with the unique artifacts.\n- It can help you understand how the unique artifacts are related to each other and how they are related to other parts of the codebase.\n\n\nHere is the information about the current task:\n1. Unique artifacts (obtained through Software Reconnaissance-style analysis):\n# Unique Artifacts\n\nUse these unique artifacts as supplemental hints, not as final answers.\n\n## Summary\n- Trace A role: `feature_positive`\n- Trace B role: `feature_negative`\n- Comparison: `trace_a_minus_trace_b`\n- Unique functions in JSON: `73`\n- Unique functions shown here: `64`\n- Target package filter: `matplotlib`\n\n## Related Files\n- `matplotlib/collections.py`: `17` unique function(s)\n- `matplotlib/cbook.py`: `10` unique function(s)\n- `matplotlib/colorizer.py`: `10` unique function(s)\n- `matplotlib/artist.py`: `7` unique function(s)\n- `matplotlib/colors.py`: `7` unique function(s)\n- `matplotlib/_api/__init__.py`: `4` unique function(s)\n- `matplotlib/__init__.py`: `2` unique function(s)\n- `matplotlib/cm.py`: `2` unique function(s)\n- `matplotlib/lines.py`: `2` unique function(s)\n- `matplotlib/path.py`: `2` unique function(s)\n- `matplotlib/hatch.py`: `1` unique function(s)\n\n## Artifact Candidates\n- artifact: `matplotlib/__init__.py:RcParams.__getitem__`\n  - module: `matplotlib`\n  - definition: `lines 778-799`\n  - first observed in trace A: `line 779`\n  - observed lines: `779, 785, 793, 799`\n  - trace activity: 114 events, 19 calls, 76 line events, 19 returns, 0 exceptions, max depth 8\n  - sample executed lines:\n    - `line 779`: `if key in _deprecated_map:`\n    - `line 785`: `elif key in _deprecated_ignore_map:`\n    - `line 793`: `elif key == \"backend\" and self is globals().get(\"rcParams\"):`\n- artifact: `matplotlib/__init__.py:RcParams._get`\n  - module: `matplotlib`\n  - definition: `lines 698-717`\n  - first observed in trace A: `line 717`\n  - observed lines: `717`\n  - trace activity: 57 events, 19 calls, 19 line events, 19 return