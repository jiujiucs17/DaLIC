.isdir(file):\n46 |         print(file, \"Directory!\")\n47 |         return\n48 | \n49 |     with open(file, \"rb\") as fp:\n50 |         data = fp.read()\n51 |     if '\\0' in data:\n52 |         print(file, \"Binary!\")\n53 |         return\n54 |     newdata = re.sub(\"\\r\\n\", \"\\n\", data)\n55 |     newdata = re.sub(\"\\n\", \"\\r\\n\", newdata)\n56 |     if newdata != data:\n57 |         print('unix2dos:', file)\n58 |         with open(file, \"wb\") as f:\n59 |             f.write(newdata)\n60 |         return file\n61 |     else:\n62 |         print(file, 'ok')\n```\n\nFound file `numpy/distutils/line_endings.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `numpy/distutils/line_endings.py` for the full content if needed.\n\n\n\n##Searching for term \"sliding_window_view\", \"rolling_window\"...\n### Search Result:\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.window`.\nSource: Retrieved entity using keyword search (bm25).\n```\n109 | def window(self):\n110 |         pass\n```\n\n\n\n##Searching for term \"sliding_window_view\", \"rolling_window\", \"sliding_window_view rolling_window\"...\n### Search Result:\nFound function `numpy/distutils/command/autodist.py:check_restrict`.\nSource: Retrieved code content using keyword search (bm25).\n```\n31 | def check_restrict(cmd):\n32 |     \"\"\"Return the restrict identifier (may be empty).\"\"\"\n33 |     cmd._check_compiler()\n34 |     body = textwrap.dedent(\"\"\"\n35 |         static int static_func (char * %(restrict)s a)\n36 |         {\n37 |             return 0;\n38 |         }\n39 |         \"\"\")\n40 | \n41 |     for kw in ['restrict', '__restrict__', '__restrict']:\n42 |         st = cmd.try_compile(body % {'restrict': kw}, None, None)\n43 |         if st:\n44 |             return kw\n45 | \n46 |     return ''\n```\n\nFound function `numpy/distutils/command/autodist.py:check_compiler_gcc`.\nSource: Retrieved code content using keyword search (bm25).\n```\n49 | def