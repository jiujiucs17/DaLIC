t match found for entity name `pandas/io/formats/format.py:DataFrameFormatter`.\n```\n416 | class DataFrameFormatter:\n417 |     \"\"\"\n418 |     Class for processing dataframe formatting options and data.\n419 | \n420 |     Used by DataFrame.to_string, which backs DataFrame.__repr__.\n421 |     \"\"\"\n422 | \n423 |     __doc__ = __doc__ if __doc__ else \"\"\n424 |     __doc__ += common_docstring + return_docstring\n425 | \n426 |     def __init__(\n427 |         self,\n428 |         frame: DataFrame,\n429 |         columns: Axes | None = None,\n430 |         col_space: ColspaceArgType | None = None,\n431 |         header: bool | SequenceNotStr[str] = True,\n432 |         index: bool = True,\n433 |         na_rep: str = \"NaN\",\n434 |         formatters: FormattersType | None = None,\n435 |         justify: str | None = None,\n436 |         float_format: FloatFormatType | None = None,\n437 |         sparsify: bool | None = None,\n438 |         index_names: bool = True,\n439 |         max_rows: int | None = None,\n440 |         min_rows: int | None = None,\n441 |         max_cols: int | None = None,\n442 |         show_dimensions: bool | str = False,\n443 |         decimal: str = \".\",\n444 |         bold_rows: bool = False,\n445 |         escape: bool = True,\n446 |     ) -> None:\n447 |         self.frame = frame\n448 |         self.columns = self._initialize_columns(columns)\n449 |         self.col_space = self._initialize_colspace(col_space)\n450 |         self.header = header\n451 |         self.index = index\n452 |         self.na_rep = na_rep\n453 |         self.formatters = self._initialize_formatters(formatters)\n454 |         self.justify = self._initialize_justify(justify)\n455 |         self.float_format = float_format\n456 |         self.sparsify = self._initialize_sparsify(sparsify)\n457 |         self.show_index_names = index_names\n458 |         self.decimal = decimal\n459 |         self.bold_rows = bold_rows\n460 |         self.escape = escape\n461 |         self.max_rows = max_rows\n462 |         self.min_rows = min_rows\n463 |         self.max_cols = max_cols\n464 |         self.show_dimensions = show_dimensions\n465 | \n466 |         self.max_cols_fitted = self._calc_max_cols_fitted()\n467 |         self.max_rows_fitted = self._calc_max_rows_fitted()\n468 | \n469 |         self.tr_frame = self.frame\n470 |         self.truncate()\n471 |         self.adj = printing.get_adjustment()\n472 | \n473 |     def get_strcols(self) -> list[list[str]]:\n474 |         \"\"\"\n475 |         Render a DataFrame to a list of columns (as lists of strings).\n476 |         \"\"\"\n477 |         strcols = self._get_strcols_without_index()\n478 | \n479 |         if self.index:\n480 |             str_index = self._get_formatted_index(self.tr_frame)\n481 |             strcols.insert(0, str_index)\n482 | \n483 |         return strcols\n484 | \n485 |     @property\n486 |     def should_show_dimensions(self) -> bool:\n487 |         return self.show_dimensions is True or (\n488 |             self.show_dimensions == \"truncate\" and self.is_truncated\n489 |         )\n490 | \n491 |     @property\n492 |     def is_truncated(self) -> bool:\n493 |         return bool(self.is_truncated_horizontally or self.is_truncated_vertically)\n494 | \n495 |     @property\n496 |     def is_truncated_horizontally(self) -> bool:\n497 |         return bool(self.max_cols_fitted and (len(self.columns) > self.max_cols_fitted))\n498 | \n499 |     @property\n500 |     def is_truncated_vertically(self) -> bool:\n501 |         return bool(self.max_rows_fitted and (len(self.frame) > self.max_rows_fitted))\n502 | \n503 |     @property\n504 |     def dimensions_info(self) -> str:\n505 |         return f\"\\n\\n[{len(self.frame)} rows x {len(self.frame.columns)} columns]\"\n506 | \n507 |     @property\n508 |     def has_index_names(self) -> bool:\n509 |         return _has_names(self.frame.index)\n510 | \n511 |     @property\n512 |     def has_column_names(self) -> bool:\n513 |         return _has_names(self.frame.columns)\n514 | \n515 |     @property\n516 |     def show_row_idx_names(self) -> bool:\n517 |         return all((self.has_index_names, self.index, self.show_index_names))\n518 | \n519 |     @property\n520 |     def show_col_idx_names(self) -> bool:\n521 |         return all((self.has_column_names, self.show_index_names, self.header))\n522 | \n523 |     @property\n524 |     def max_rows_displayed(self) -> int:\n525 |         return min(self.max_rows or len(self.frame), len(self.frame))\n526 | \n527 |     def _initialize_sparsify(self, sparsify: bool | None) -> bool:\n528 |         if sparsify is None:\n529 |             return get_option(\"display.multi_sparse\")\n530 |         return sparsify\n531 | \n532 |     def _initialize_formatters(\n533 |         self, formatters: FormattersType | None\n534 |     ) -> FormattersType:\n535 |         if formatters is None:\n536 |             return {}\n537 |         elif len(self.frame.columns) == len(formatters) or isinstance(formatters, dict):\n538 |             return formatters\n539 |         else:\n540 |             raise ValueError(\n541 |                 f\"Formatters length({len(formatters)}) should match \"\n542 |                 f\"DataFrame number of columns({len(self.frame.columns)})\"\n543 |             )\n544 | \n545 |     def _initialize_justify(self, justify: str | None) -> str:\n546 |         if justify is None:\n547 |             return get_option(\"display.colheader_justify\")\n548 |         else:\n549 |             return justify\n550 | \n551 |     def _initialize_columns(self, columns: Axes | None) -> Index:\n552 |         if columns is not None:\n553 |             cols = ensure_index(columns)\n554 |             self.frame = self.frame[cols]\n555 |             return cols\n556 |         else:\n557 |             return self.frame.columns\n558 | \n559 |     def _initialize_colspace(self, col_space: ColspaceArgType | None) -> ColspaceType:\n560 |         result: ColspaceType\n561 | \n562 |         if col_space is None:\n563 |             result = {}\n564 |         elif isinstance(col_space, (int, str)):\n565 |             result = {\"\": col_space}\n566 |             result.update({column: col_space for column in self.frame.columns})\n567 |         elif isinstance(col_space, Mapping):\n568 |             for column in col_space.keys():\n569 |                 if column not in self.frame.columns and column != \"\":\n570 |                     raise ValueError(\n571 |                         f\"Col_space is defined for an unknown column: {column}\"\n572 |                     )\n573 |             result = col_space\n574 |         else:\n575 |             if len(self.frame.columns) != len(col_space):\n576 |                 raise ValueError(\n577 |                     f\"Col_space length({len(col_space)}) should match \"\n578 |                     f\"DataFrame number of columns({len(self.frame.columns)})\"\n579 |                 )\n580 |             result = dict(zip(self.frame.columns, col_space))\n581 |         return result\n582 | \n583 |     def _calc_max_cols_fitted(self) -> int | None:\n584 |         \"\"\"Number of columns fitting the screen.\"\"\"\n585 |         if not self._is_in_terminal():\n586 |             return self.max_cols\n587 | \n588 |         width, _ = get_terminal_size()\n589 |         if self._is_screen_narrow(width):\n590 |             return width\n591 |         else:\n592 |             return self.max_cols\n593 | \n594 |     def _calc_max_rows_fitted(self) -> int | None:\n595 |         \"\"\"Number of rows with data fitting the screen.\"\"\"\n596 |         max_rows: int | None\n597 | \n598 |         if self._is_in_terminal():\n599 |             _, height = get_terminal_size()\n600 |             if self.max_rows == 0:\n601 |                 # rows available to fill with actual data\n602 |                 return height - self._get_number_of_auxiliary_rows()\n603 | \n604 |             if self._is_screen_short(height):\n605 |                 max_rows = height\n606 |             else:\n607 |                 max_rows = self.max_rows\n608 |         else:\n609 |             max_rows = self.max_rows\n610 | \n611 |         return self._adjust_max_rows(max_rows)\n612 | \n613 |     def _adjust_max_rows(self, max_rows: int | None) -> int | None:\n614 |         \"\"\"Adjust max_rows using display logic.\n615 | \n616 |         See description here:\n617 |         https://pandas.pydata.org/docs/dev/user_guide/options.html#frequently-used-options\n618 | \n619 |         GH #37359\n620 |         \"\"\"\n621 |         if max_rows:\n622 |             if (len(self.frame) > max_rows) and self.min_rows:\n623 |                 # if truncated, set max_rows showed to min_rows\n624 |                 max_rows = min(self.min_rows, max_rows)\n625 |         return max_rows\n626 | \n627 |     def _is_in_terminal(self) -> bool:\n628 |         \"\"\"Check if the output is to be shown in terminal.\"\"\"\n629 |         return bool(self.max_cols == 0 or self.max_rows == 0)\n630 | \n631 |     def _is_screen_narrow(self, max_width) -> bool:\n632 |         return bool(self.max_cols == 0 and len(self.frame.columns) > max_width)\n633 | \n634 |     def _is_screen_short(self, max_height) -> bool:\n635 |         return bool(self.max_rows == 0 and len(self.frame) > max_height)\n636 | \n637 |     def _get_number_of_auxiliary_rows(self) -> int:\n638 |         \"\"\"Get number of rows occupied by prompt, dots and dimension info.\"\"\"\n639 |         dot_row = 1\n640 |         prompt_row = 1\n641 |         num_rows = dot_row + prompt_row\n642 | \n643 |         if self.show_dimensions:\n644 |             num_rows += len(self.dimensions_info.splitlines())\n645 | \n646 |         if self.header:\n647 |             num_rows += 1\n648 | \n649 |         return num_rows\n650 | \n651 |     def truncate(self) -> None:\n652 |         \"\"\"\n653 |         Check whether the frame should be truncated. If so, slice the frame up.\n654 |         \"\"\"\n655 |         if self.is_truncated_horizontally:\n656 |             self._truncate_horizontally()\n657 | \n658 |         if self.is_truncated_vertically:\n659 |             self._truncate_vertically()\n660 | \n661 |     def _truncate_horizontally(self) -> None:\n662 |         \"\"\"Remove columns, which are not to be displayed and adjust formatters.\n663 | \n664 |         Attributes affected:\n665 |             - tr_frame\n666 |             - formatters\n667 |             - tr_col_num\n668 |         \"\"\"\n669 |         assert self.max_cols_fitted is not None\n670 |         col_num = self.max_cols_fitted // 2\n671 |         if col_num >= 1:\n672 |             left = self.tr_frame.iloc[:, :col_num]\n673 |             right = self.tr_frame.iloc[:, -col_num:]\n674 |             self.tr_frame = concat((left, right), axis=1)\n675 | \n676 |             # truncate formatter\n677 |             if isinstance(self.formatters, (list, tuple)):\n678 |                 self.formatters = [\n679 |                     *self.formatters[:col_num],\n680 |                     *self.formatters[-col_num:],\n681 |                 ]\n682 |         else:\n683 |             col_num = cast(int, self.max_cols)\n684 |             self.tr_frame = self.tr_frame.iloc[:, :col_num]\n685 |         self.tr_col_num = col_num\n686 | \n687 |     def _truncate_vertically(self) -> None:\n688 |         \"\"\"Remove rows, which are not to be displayed.\n689 | \n690 |         Attributes affected:\n691 |             - tr_frame\n692 |             - tr_row_num\n693 |         \"\"\"\n694 |         assert self.max_rows_fitted is not None\n695 |         row_num = self.max_rows_fitted // 2\n696 |         if row_num >= 1:\n697 |             _len = len(self.tr_frame)\n698 |             _slice = np.hstack([np.arange(row_num), np.arange(_len - row_num, _len)])\n699 |             self.tr_frame = self.tr_frame.iloc[_slice]\n700 |         else:\n701 |             row_num = cast(int, self.max_rows)\n702 |             self.tr_frame = self.tr_frame.iloc[:row_num, :]\n703 |         self.tr_row_num = row_num\n704 | \n705 |     def _get_strcols_without_index(self) -> list[list[str]]:\n706 |         strcols: list[list[str]] = []\n707 | \n708 |         if not is_list_like(self.header) and not self.header:\n709 |             for i, c in enumerate(self.tr_frame):\n710 |                 fmt_values = self.format_col(i)\n711 |                 fmt_values = _make_fixed_width(\n712 |                     strings=fmt_values,\n713 |                     justify=self.justify,\n714 |                     minimum=int(self.col_space.get(c, 0)),\n715 |                     adj=self.adj,\n716 |                 )\n717 |                 strcols.append(fmt_values)\n718 |             return strcols\n719 | \n720 |         if is_list_like(self.header):\n721 |             # cast here since can't be bool if is_list_like\n722 |             self.header = cast(list[str], self.header)\n723 |             if len(self.header) != len(self.columns):\n724 |                 raise ValueError(\n725 |                     f\"Writing {len(self.columns)} cols \"\n726 |                     f\"but got {len(self.header)} aliases\"\n727 |                 )\n728 |             str_columns = [[label] for label in self.header]\n729 |         else:\n730 |             str_columns = self._get_formatted_column_labels(self.tr_frame)\n731 | \n732 |         if self.show_row_idx_names:\n733 |             for x in str_columns:\n734 |                 x.append(\"\")\n735 | \n736 |         for i, c in enumerate(self.tr_frame):\n737 |             cheader = str_columns[i]\n738 |             header_colwidth = max(\n739 |                 int(self.col_space.get(c, 0)), *(self.adj.len(x) for x in cheader)\n740 |             )\n741 |             fmt_values = self.format_col(i)\n742 |             fmt_values = _make_fixed_width(\n743 |                 fmt_values, self.justify, minimum=header_colwidth, adj=self.adj\n744 |             )\n745 | \n746 |             max_len = max(*(self.adj.len(x) for x in fmt_values), header_colwidth)\n747 |             cheader = self.adj.justify(cheader, max_len, mode=self.justify)\n748 |             strcols.append(cheader + fmt_values)\n749 | \n750 |         return strcols\n751 | \n752 |     def format_col(self, i: int) -> list[str]:\n753 |         frame = self.tr_frame\n754 |         formatter = self._get_formatter(i)\n755 |         return format_array(\n756 |             frame.iloc[:, i]._values,\n757 |             formatter,\n758 |             float_format=self.float_format,\n759 |             na_rep=self.na_rep,\n760 |             space=self.col_space.get(frame.columns[i]),\n761 |             decimal=self.decimal,\n762 |             leading_space=self.index,\n763 |         )\n764 | \n765 |     def _get_formatter(self, i: str | int) -> Callable | None:\n766 |         if isinstance(self.formatters, (list, tuple)):\n767 |             if is_integer(i):\n768 |                 i = cast(int, i)\n769 |                 return self.formatters[i]\n770 |             else:\n771 |                 return None\n772 |         else:\n773 |             if is_integer(i) and i not in self.columns:\n774 |                 i = self.columns[i]\n775 |             return self.formatters.get(i, None)\n776 | \n777 |     def _get_formatted_column_labels(self, frame: DataFrame) -> list[list[str]]:\n778 |         from pandas.core.indexes.multi import sparsify_labels\n779 | \n780 |         columns = frame.columns\n781 | \n782 |         if isinstance(columns, MultiIndex):\n783 |             fmt_columns = columns._format_multi(sparsify=False, include_names=False)\n784 |             if self.sparsify and len(fmt_columns):\n785 |                 fmt_columns = sparsify_labels(fmt_columns)\n786 | \n787 |             str_columns = [list(x) for x in zip(*fmt_columns)]\n788 |         else:\n789 |             fmt_columns = columns._format_flat(include_name=False)\n790 |             str_columns = [\n791 |                 [\n792 |                     \" \" + x\n793 |                     if not self._get_formatter(i) and is_numeric_dtype(dtype)\n794 |                     else x\n795 |                 ]\n796 |                 for i, (x, dtype) in enumerate(zip(fmt_columns, self.frame.dtypes))\n797 |             ]\n798 |         return str_columns\n799 | \n800 |     def _get_formatted_index(self, frame: DataFrame) -> list[str]:\n801 |         # Note: this is only used by to_string() and to_latex(), not by\n802 |         # to_html(). so safe to cast col_space here.\n803 |         col_space = {k: cast(int, v) for k, v in self.col_space.items()}\n804 |         index = frame.index\n805 |         columns = frame.columns\n806 |         fmt = self._get_formatter(\"__index__\")\n807 | \n808 |         if isinstance(index, MultiIndex):\n809 |             fmt_index = index._format_multi(\n810 |                 sparsify=self.sparsify,\n811 |                 include_names=self.show_row_idx_names,\n812 |                 formatter=fmt,\n813 |             )\n814 |         else:\n815 |             fmt_index = [\n816 |                 index._format_flat(include_name=self.show_row_idx_names, formatter=fmt)\n817 |             ]\n818 | \n819 |         fmt_index = [\n820 |             tuple(\n821 |                 _make_fixed_width(\n822 |                     list(x), justify=\"left\", minimum=col_space.get(\"\", 0), adj=self.adj\n823 |                 )\n824 |             )\n825 |             for x in fmt_index\n826 |         ]\n827 | \n828 |         adjoined = self.adj.adjoin(1, *fmt_index).split(\"\\n\")\n829 | \n830 |         # empty space for columns\n831 |         if self.show_col_idx_names:\n832 |             col_header = [str(x) for x in self._get_column_name_list()]\n833 |         else:\n834 |             col_header = [\"\"] * columns.nlevels\n835 | \n836 |         if self.header:\n837 |             return col_header + adjoined\n838 |         else:\n839 |             return adjoined\n840 | \n841 |     def _get_column_name_list(self) -> list[Hashable]:\n842 |         names: list[Hashable] = []\n843 |         columns = self.frame.columns\n844 |         if isinstance(columns, MultiIndex):\n845 |             names.extend(\"\" if name is None else name for name in columns.names)\n846 |         else:\n847 |             names.append(\"\" if columns.name is None else columns.name)\n848 |         return names\n```\n"}, {"content": "Based on my analysis of the code and the issue description, I can now provide the locations that need modification to add examples for the `float_format` parameter in the `to_csv` documentation.\n\n```\npandas/core/generic.py\nline: 3767-3769\nclass: NDFrame\nfunction: to_csv\n\npandas/io/formats/format.py\nline: 436\nclass: DataFrameFormatter\nfunction: __init__\n\npandas/io/formats/csvs.py\nline: 106\nfunction: CSVFormatter.float_format\n\ndoc/source/reference/api/pandas.DataFrame.to_csv.rst\nline: N/A\nsection: Parameters section\n```\n\nThese locations are ordered by importance:\n\n1. `pandas/core/generic.py`: This is the main file containing the `to_csv` method implementation. The float_format parameter documentation needs to be enhanced here to include the suggested examples.\n\n2. `pandas/io/formats/format.py`: This file contains the DataFrameFormatter class that processes the float_format parameter. The float_format initialization occurs at line 436 in its __init__ method.\n\n3. `pandas/io/formats/csvs.py`: Contains the CSVFormatter class that handles CSV formatting, including the float_format functionality.\n\n4. `doc/source/reference/api/pandas.DataFrame.to_csv.rst`: This is where the documentation needs to be updated to include the new examples.\n\nThe issue requests adding examples for:\n1. Formatting floats to two decimal places\n2. Using scientific notation format\n\nThese examples should be added to the `to_csv` method's documentation, specifically in the Parameters section, right after the float_format parameter description.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 224613, "completion_tokens": 644}, "time": 178.64214611053467}]}}
