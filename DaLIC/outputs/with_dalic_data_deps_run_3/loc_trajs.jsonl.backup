ing:\n1056 |                 raise ValueError(\n1057 |                     \"Complex data not supported\\n{}\\n\".format(array)\n1058 |                 ) from complex_warning\n1059 | \n1060 |         # It is possible that the np.array(..) gave no warning. This happens\n1061 |         # when no dtype conversion happened, for example dtype = None. The\n1062 |         # result is that np.array(..) produces an array of complex dtype\n1063 |         # and we need to catch and raise exception for such cases.\n1064 |         _ensure_no_complex_data(array)\n1065 | \n1066 |         if ensure_2d:\n1067 |             # If input is scalar raise error\n1068 |             if array.ndim == 0:\n1069 |                 raise ValueError(\n1070 |                     \"Expected 2D array, got scalar array instead:\\narray={}.\\n\"\n1071 |                     \"Reshape your data either using array.reshape(-1, 1) if \"\n1072 |                     \"your data has a single feature or array.reshape(1, -1) \"\n1073 |                     \"if it contains a single sample.\".format(array)\n1074 |                 )\n1075 |             # If input is 1D raise error\n1076 |             if array.ndim == 1:\n1077 |                 # If input is a Series-like object (eg. pandas Series or polars Series)\n1078 |                 if type_if_series is not None:\n1079 |                     msg = (\n1080 |                         f\"Expected a 2-dimensional container but got {type_if_series} \"\n1081 |                         \"instead. Pass a DataFrame containing a single row (i.e. \"\n1082 |                         \"single sample) or a single column (i.e. single feature) \"\n1083 |                         \"instead.\"\n1084 |                     )\n1085 |                 else:\n1086 |                     msg = (\n1087 |                         f\"Expected 2D array, got 1D array instead:\\narray={array}.\\n\"\n1088 |                         \"Reshape your data either using array.reshape(-1, 1) if \"\n1089 |                         \"your data has a single feature or array.reshape(1, -1) \"\n1090 |                         \"if it contains a single sample.\"\n1091 |                     )\n1092 |                 raise ValueError(msg)\n1093 | \n1094 |         if dtype_numeric and hasattr(array.dtype, \"kind\") and array.dtype.kind in \"USV\":\n1095 |             raise ValueError(\n1096 |                 \"dtype='numeric' is not compatible with arrays of bytes/strings.\"\n1097 |                 \"Convert your data to numeric values explicitly instead.\"\n1098 |             )\n1099 |         if not allow_nd and array.ndim >= 3:\n1100 |             raise ValueError(\n1101 |                 \"Found array with dim %d. %s expected <= 2.\"\n1102 |                 % (array.ndim, estimator_name)\n1103 |             )\n1104 | \n1105 |         if ensure_all_finite:\n1106 |             _assert_all_finite(\n1107 |                 array,\n1108 |                 input_name=input_name,\n1109 |                 estimator_name=estimator_name,\n1110 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n1111 |             )\n1112 | \n1113 |         if copy:\n1114 |             if _is_numpy_namespace(xp):\n1115 |                 # only make a copy if `array` and `array_orig` may share memory`\n1116 |                 if np.may_share_memory(array, array_orig):\n1117 |                     array = _asarray_with_order(\n1118 |                         array, dtype=dtype, order=order, copy=True, xp=xp\n1119 |                     )\n1120 |             else:\n1121 |                 # always make a copy for non-numpy arrays\n1122 |                 array = _asarray_with_order(\n1123 |                     array, dtype=dtype, order=order, copy=True, xp=xp\n1124 |                 )\n1125 | \n1126 |     if ensure_min_samples > 0:\n1127 |         n_samples = _num_samples(array)\n1128 |         if n_samples < ensure_min_samples:\n1129 |             raise ValueError(\n1130 |                 \"Found array with %d sample(s) (shape=%s) while a\"\n1131 |                 \" minimum of %d is required%s.\"\n1132 |                 % (n_samples, array.shape, ensure_min_samples, context)\n1133 |             )\n1134 | \n1135 |     if ensure_min_features > 0 and array.ndim == 2:\n1136 |         n_features = array.shape[1]\n1137 |         if n_features < ensure_min_features:\n1138 |             raise ValueError(\n1139 |                 \"Found array with %d feature(s) (shape=%s) while\"\n1140 |                 \" a minimum of %d is required%s.\"\n1141 |                 % (n_features, array.shape, ensure_min_features, context)\n1142 |             )\n1143 | \n1144 |     if ensure_non_negative:\n1145 |         whom = input_name\n1146 |         if estimator_name:\n1147 |             whom += f\" in {estimator_name}\"\n1148 |         check_non_negative(array, whom)\n1149 | \n1150 |     if force_writeable:\n1151 |         # By default, array.copy() creates a C-ordered copy. We set order=K to\n1152 |         # preserve the order of the array.\n1153 |         copy_params = {\"order\": \"K\"} if not sp.issparse(array) else {}\n1154 | \n1155 |         array_data = array.data if sp.issparse(array) else array\n1156 |         flags = getattr(array_data, \"flags\", None)\n1157 |         if not getattr(flags, \"writeable\", True):\n1158 |             # This situation can only happen when copy=False, the array is read-only and\n1159 |             # a writeable output is requested. This is an ambiguous setting so we chose\n1160 |             # to always (except for one specific setting, see below) make a copy to\n1161 |             # ensure that the output is writeable, even if avoidable, to not overwrite\n1162 |             # the user's data by surprise.\n1163 | \n1164 |             if _is_pandas_df_or_series(array_orig):\n1165 |                 try:\n1166 |                     # In pandas >= 3, np.asarray(df), called earlier in check_array,\n1167 |                     # returns a read-only 