62 | \n163 |         # We allow last estimator to be None as an identity transformation\n164 |         if (estimator is not None and estimator != 'passthrough'\n165 |                 and not hasattr(estimator, \"fit\")):\n166 |             raise TypeError(\n167 |                 \"Last step of Pipeline should implement fit \"\n168 |                 \"or be the string 'passthrough'. \"\n169 |                 \"'%s' (type %s) doesn't\" % (estimator, type(estimator)))\n```\n\nFound function `sklearn/pipeline.py:FeatureUnion._validate_transformers`.\nSource: Retrieved entity using keyword search (bm25).\n```\n855 | def _validate_transformers(self):\n856 |         names, transformers = zip(*self.transformer_list)\n857 | \n858 |         # validate names\n859 |         self._validate_names(names)\n860 | \n861 |         # validate estimators\n862 |         for t in transformers:\n863 |             if t == 'drop':\n864 |                 continue\n865 |             if (not (hasattr(t, \"fit\") or hasattr(t, \"fit_transform\")) or not\n866 |                     hasattr(t, \"transform\")):\n867 |                 raise TypeError(\"All estimators should implement fit and \"\n868 |                                 \"transform. '%s' (type %s) doesn't\" %\n869 |                                 (t, type(t)))\n```\n\nFound function `sklearn/base.py:BaseEstimator._validate_data`.\nSource: Retrieved entity using keyword search (bm25).\n```\n379 | def _validate_data(self, X, y=None, reset=True,\n380 |                        validate_separately=False, **check_params):\n381 |         \"\"\"Validate input data and set or check the `n_features_in_` attribute.\n382 | \n383 |         Parameters\n384 |         ----------\n385 |         X : {array-like, sparse matrix, dataframe} of shape \\\n386 |                 (n_samples, n_features)\n387 |             The input samples.\n388 |         y : array-like of shape (n_samples,), default=None\n389 |             The targets. If None, `check_array` is called on `X` and\n390 |             `check_X_y` is called otherwise.\n391 |         reset : bool, default=True\n392 |             Whether to reset the `n_features_in_` attribute.\n393 |             If False, the input will be checked for consistency with data\n394 |             provided when reset was last True.\n395 |         validate_separately : False or tuple of dicts, default=False\n396 |             Only used if y is not None.\n397 |             If False, call validate_X_y(). Else, it must be a tuple of kwargs\n398 |             to be used for calling check_array() on X and y respectively.\n399 |         **check_params : kwargs\n400 |             Parameters passed to :func:`sklearn.utils.check_array` or\n401 |             :func:`sklearn.utils.check_X_y`. Ignored if validate_separately\n402 |             is not False.\n403 | \n404 |         Returns\n405 |         -------\n406 |         out : {ndarray, sparse matrix} or tuple of these\n407 |             The validated input. A tuple is returned if `y` is not None.\n408 |         \"\"\"\n409 | \n410 |         if y is None:\n411 |             if self._get_tags()['requires_y']:\n412 |                 raise ValueError(\n413 |                     f\"This {self.__class__.__name__} estimator \"\n414 |                     f\"requires y to be passed, but the target y is None.\"\n415 |                 )\n416 |             X = check_array(X, **check_params)\n417 |             out = X\n418 |         else:\n419 |             if validate_separately:\n420 |                 # We need this because some estimators validate X and y\n421 |                 # separately, and in general, separately calling check_array()\n422 |                 # on X and y isn't equivalent to just calling check_X_y()\n423 |                 # :(\n424 |                 check_X_params, check_y_params = validate_separately\n425 |                 X = check_array(X, **check_X_params)\n426 |                 y = check_array(y, **check_y_params)\n427 |             else:\n428 |                 X, y = check_X_y(X, y, **check_params)\n429 |             out = X, y\n430 | \n431 |         if check_params.get('ensure_2d', True):\n432 |             self._check_n_features(X, reset=reset)\n433 | \n434 |         return out\n```\n\nFound function `sklearn/utils/validation.py:_check_fit_params`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1344 | def _check_fit_params(X, fit_params, indices=None):\n1345 |     \"\"\"Check and validate the parameters passed during `fit`.\n1346 | \n1347 |     Parameters\n1348 |     ----------\n1349 |     X : array-like of shape (n_samples, n_features)\n1350 |         Data array.\n1351 | \n1352 |     fit_params : dict\n1353 |         Dictionary containing the parameters passed at fit.\n1354 | \n1355 |     indices : array-like of shape (n_samples,), default=None\n1356 |         Indices to be selected if the parameter has the same size as `X`.\n1357 | \n1358 |     Returns\n1359 |     -------\n1360 |     fit_params_validated : dict\n1361 |         Validated parameters. We ensure that the values support indexing.\n1362 |     \"\"\"\n1363 |     from . import _safe_indexing\n1364 |     fit_params_validated = {}\n1365 |     for param_key, param_value in fit_params.items():\n1366 |         if (not _is_arraylike(param_value) or\n1367 |                 _num_samples(param_value) != _num_samples(X)):\n1368 |             # Non-indexable pass-through (for now for backward-compatibility).\n1369 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n1370 |             fit_params_validated[param_key] = param_value\n1371 |         else:\n1372 |             # Any other fit_params should support indexing\n1373 |             # (e.g. for cross-validation).\n1374 |             fit_params_validated[param_key] = _make_indexable(param_value)\n1375 |             fit_params_validated[param_key] = _safe_indexing(\n1376 |                 fit_params_validated[param_key], indices\n1377 |             )\n1378 | \n1379 |     return fit_params_validated\n```\n\n\n\n##Searching for term \"validate_checksum\", \"hashlib.md5\", \"validate_checksum hashlib.md5\"...\n### Search Result:\nFound function `sklearn/datasets/_rcv1.py:fetch_rcv1`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 80 | def fetch_rcv1(*, data_home=None, subset='all', download_if_missing=True,\n 81 |                random_state=None, shuffle=False, return_X_y=False):\n 82 |     \"\"\"Load the RCV1 multilabel dataset (classification).\n 83 | \n 84 |     Download it if necessary.\n 85 | \n 86 |     Version: RCV1-v2, vectors, full sets, topics multilabels.\n 87 | \n 88 |     =================   =====================\n 89 |     Classes                               103\n 90 |     Samples total                      804414\n 91 |     Dimensionality                      47236\n 92 |     Features            real, between 0 and 1\n 93 |     =================   =====================\n 94 | \n 95 |     Read more in the :ref:`User Guide <rcv1_dataset>`.\n 96 | \n 97 |     .. versionadded:: 0.17\n 98 | \n 99 |     Parameters\n100 |     ----------\n101 |     data_home : str, default=None\n102 |         Specify another download and cache folder for the datasets. By default\n103 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n104 | \n105 |     subset : {'train', 'test', 'all'}, default='all'\n106 |         Select the dataset to load: 'train' for the training set\n107 |         (23149 samples), 'test' for the test set (781265 samples),\n108 |         'all' for both, with the training samples first if shuffle is False.\n109 |         This follows the official LYRL2004 chronological split.\n110 | \n111 |     download_if_missing : bool, default=True\n112 |         If False, raise a IOError if the data is not locally available\n113 |         instead of trying to download the data from the source site.\n114 | \n115 |     random_state : int or RandomState instance, default=None\n116 |         Determines random number generation for dataset shuffling. Pass an int\n117 |         for reproducible output across multiple function calls.\n118 |         See :term:`Glossary <random_state>`.\n119 | \n120 |     shuffle : bool, default=False\n121 |         Whether to shuffle dataset.\n122 | \n123 |     return_X_y : bool, default=False\n124 |         If True, returns ``(dataset.data, dataset.target)`` instead of a Bunch\n125 |         object. See below for more information about the `dataset.data` and\n126 |         `dataset.target` object.\n127 | \n128 |         .. versionadded:: 0.20\n129 | \n130 |     Returns\n131 |     -------\n132 |     dataset : :class:`~sklearn.utils.Bunch`\n133 |         Dictionary-like object, with the following attributes.\n134 | \n135 |         data : scipy csr array, dtype np.float64, shape (804414, 47236)\n136 |             The array has 0.16% of non zero values.\n137 |         target : scipy csr array, dtype np.uint8, shape (804414, 103)\n138 |             Each sample has a value of 1 in its categories, and 0 in others.\n139 |             The array has 3.15% of non zero values.\n140 |         sample_id : numpy array, dtype np.uint32, shape (804414,)\n141 |             Identification number of each sample, as ordered in dataset.data.\n142 |         target_names : numpy array, dtype object, length (103)\n143 |             Names of each target (RCV1 topics), as ordered in dataset.target.\n144 |         DESCR : string\n145 |             Description of the RCV1 dataset.\n146 | \n147 |     (data, target) : tuple if ``return_X_y`` is True\n148 | \n149 |         .. versionadded:: 0.20\n150 |     \"\"\"\n151 |     N_SAMPLES = 804414\n152 |     N_FEATURES = 47236\n153 |     N_CATEGORIES = 103\n154 |     N_TRAIN = 23149\n155 | \n156 |     data_home = get_data_home(data_home=data_home)\n157 |     rcv1_dir = join(data_home, \"RCV1\")\n158 |     if download_if_missing:\n159 |         if not exists(rcv1_dir):\n160 |             makedirs(rcv1_dir)\n161 | \n162 |     samples_path = _pkl_filepath(rcv1_dir, \"samples.pkl\")\n163 |     sample_id_path = _pkl_filepath(rcv1_dir, \"sample_id.pkl\")\n164 |     sample_topics_path = _pkl_filepath(rcv1_dir, \"sample_topics.pkl\")\n165 |     topics_path = _pkl_filepath(rcv1_dir, \"topics_names.pkl\")\n166 | \n167 |     # load data (X) and sample_id\n168 |     if download_if_missing and (not exists(samples_path) or\n169 |                                 not exists(sample_id_path)):\n170 |         files = []\n171 |         for each in XY_METADATA:\n172 |             logger.info(\"Downloading %s\" % each.url)\n173 |             file_path = _fetch_remote(each, dirname=rcv1_dir)\n174 |             files.append(GzipFile(filename=file_path))\n175 | \n176 |         Xy = load_svmlight_files(files, n_features=N_FEATURES)\n177 | \n178 |         # Training data is before testing data\n179 |         X = sp.vstack([Xy[8], Xy[0], Xy[2], Xy[4], Xy[6]]).tocsr()\n180 |         sample_id = np.hstack((Xy[9], Xy[1], Xy[3], Xy[5], Xy[7]))\n181 |         sample_id = sample_id.astype(np.uint32, copy=False)\n182 | \n183 |         joblib.dump(X, samples_path, compress=9)\n184 |         joblib.dump(sample_id, sample_id_path, compress=9)\n185 | \n186 |         # delete archives\n187 |         for f in files:\n188 |             f.close()\n189 |             remove(f.name)\n190 |     else:\n191 |         X = joblib.load(samples_path)\n192 |         sample_id = joblib.load(sample_id_path)\n193 | \n194 |     # load target (y), categories, and sample_id_bis\n195 |     if download_if_missing and (not exists(sample_topics_path) or\n196 |                                 not exists(topics_path)):\n197 |         logger.info(\"Downloading %s\" % TOPICS_METADATA.url)\n198 |         topics_archive_path = _fetch_remote(TOPICS_METADATA,\n199 |                                             dirname=rcv1_dir)\n200 | \n201 |         # parse the target file\n202 |         n_cat = -1\n203 |         n_doc = -1\n204 |         doc_previous = -1\n205 |         y = np.zeros((N_SAMPLES, N_CATEGORIES), dtype=np.uint8)\n206 |         sample_id_bis = np.zeros(N_SAMPLES, dtype=np.int32)\n207 |         category_names = {}\n208 |         with GzipFile(filename=topics_archive_path, mode='rb') as f:\n209 |             for line in f:\n210 |                 line_components = line.decode(\"ascii\").split(\" \")\n211 |                 if len(line_components) == 3:\n212 |                     cat, doc, _ = line_components\n213 |                     if cat not in category_names:\n214 |                         n_cat += 1\n215 |                         category_names[cat] = n_cat\n216 | \n217 |                     doc = int(doc)\n218 |                     if doc != doc_previous:\n219 |                         doc_previous = doc\n220 |                         n_doc += 1\n221 |                         sample_id_bis[n_doc] = doc\n222 |                     y[n_doc, category_names[cat]] = 1\n223 | \n224 |         # delete archive\n225 |         remove(topics_archive_path)\n226 | \n227 |         # Samples in X are ordered with sample_id,\n228 |         # whereas in y, they are ordered with sample_id_bis.\n229 |         permutation = _find_permutation(sample_id_bis, sample_id)\n230 |         y = y[permutation, :]\n231 | \n232 |         # save category names in a list, with same order than y\n233 |         categories = np.empty(N_CATEGORIES, dtype=object)\n234 |         for k in category_names.keys():\n235 |             categories[category_names[k]] = k\n236 | \n237 |         # reorder categories in lexicographic order\n238 |         order = np.argsort(categories)\n239 |         categories = categories[order]\n240 |         y = sp.csr_matrix(y[:, order])\n241 | \n242 |         joblib.dump(y, sample_topics_path, compress=9)\n243 |         joblib.dump(categories, topics_path, compress=9)\n244 |     else:\n245 |         y = joblib.load(sample_topics_path)\n246 |         categories = joblib.load(topics_path)\n247 | \n248 |     if subset == 'all':\n249 |         pass\n250 |     elif subset == 'train':\n251 |         X = X[:N_TRAIN, :]\n252 |         y = y[:N_TRAIN, :]\n253 |         sample_id = sample_id[:N_TRAIN]\n254 |     elif subset == 'test':\n255 |         X = X[N_TRAIN:, :]\n256 |         y = y[N_TRAIN:, :]\n257 |         sample_id = sample_id[N_TRAIN:]\n258 |     else:\n259 |         raise ValueError(\"Unknown subset parameter. Got '%s' instead of one\"\n260 |                          \" of ('all', 'train', test')\" % subset)\n261 | \n262 |     if shuffle:\n263 |         X, y, sample_id = shuffle_(X, y, sample_id, random_state=random_state)\n264 | \n265 |     module_path = dirname(__file__)\n266 |     with open(join(module_path, 'descr', 'rcv1.rst')) as rst_file:\n267 |         fdescr = rst_file.read()\n268 | \n269 |     if return_X_y:\n270 |         return X, y\n271 | \n272 |     return Bunch(data=X, target=y, sample_id=sample_id,\n273 |                  target_names=categories, DESCR=fdescr)\n```\n\n\n\n##Searching for term \"hashlib.md5\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/_base.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n   1 | \"\"\"\n   2 | Base IO code for all datasets\n   3 | \"\"\"\n   4 | \n   5 | # Copyright (c) 2007 David Cournapeau <cournape@gmail.com>\n   6 | #               2010 Fabian Pedregosa <fabian.pedregosa@inria.fr>\n   7 | #               2010 Olivier Grisel <olivier.grisel@ensta.org>\n   8 | # License: BSD 3 clause\n   9 | import os\n  10 | import csv\n  11 | import shutil\n  12 | from collections import namedtuple\n  13 | from os import environ, listdir, makedirs\n  14 | from os.path import dirname, exists, expanduser, isdir, join, splitext\n  15 | import hashlib\n  16 | \n  17 | from ..utils import Bunch\n  18 | from ..utils import check_random_state\n  19 | from ..utils import check_pandas_support\n  20 | from ..utils.validation import _deprecate_positional_a