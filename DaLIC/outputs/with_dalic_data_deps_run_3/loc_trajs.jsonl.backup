sult_t, copy=False)\n1664 |         return wrap(u), s, wrap(vh)\n1665 |     else:\n1666 |         if m < n:\n1667 |             gufunc = _umath_linalg.svd_m\n1668 |         else:\n1669 |             gufunc = _umath_linalg.svd_n\n1670 | \n1671 |         signature = 'D->d' if isComplexType(t) else 'd->d'\n1672 |         s = gufunc(a, signature=signature, extobj=extobj)\n1673 |         s = s.astype(_realType(result_t), copy=False)\n1674 |         return s\n```\n\n\n\n##Searching for term \"sliding_window_view rolling_window\"...\n### Search Result:\nFound `numpy/distutils/command/autodist.py:check_inline`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"This module implements additional tests ala autoconf which can be useful.\n  2 | \n  3 | \"\"\"\n  4 | import textwrap\n  5 | \n  6 | # We put them here since they could be easily reused outside numpy.distutils\n  7 | \n  8 | def check_inline(cmd):\n  9 |     \"\"\"Return the inline identifier (may be empty).\"\"\"\n 10 |     cmd._check_compiler()\n 11 |     body = textwrap.dedent(\"\"\"\n 12 |         #ifndef __cplusplus\n 13 |         static %(inline)s int static_func (void)\n 14 |         {\n 15 |             return 0;\n 16 |         }\n 17 |         %(inline)s int nostatic_func (void)\n 18 |         {\n 19 |             return 0;\n 20 |         }\n 21 |         #endif\"\"\")\n 22 | \n 23 |     for kw in ['inline', '__inline__', '__inline']:\n 24 |         st = cmd.try_compile(body % {'inline': kw}, None, None)\n 25 |         if st:\n 26 |             return kw\n 27 | \n 28 |     return ''\n```\n\nFound function `numpy/linalg/linalg.py:_raise_linalgerror_singular`.\nSource: Retrieved entity using keyword search (bm25).\n```\n87 | def _raise_linalgerror_singular(err, flag):\n88 |     raise LinAlgError(\"Singular matrix\")\n```\n\nFound function `numpy/distutils/line_endings.py:unix2dos_dir`.\nSource: Retrieved entity using keyword search (bm25).\n```\n71 | def unix2dos_dir(dir_name):\n72