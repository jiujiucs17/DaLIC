.rcParams['axes.prop_cycle'].by_key()['color']\n\nfig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2)\n\n\ncol = collections.LineCollection(\n    [spiral], offsets=xyo, offset_transform=ax1.transData)\ntrans = fig.dpi_scale_trans + transforms.Affine2D().scale(1.0/72.0)\n\n\n# The same data as above, but fill the curves.\ncol = collections.PolyCollection(\n    [spiral], offsets=xyo, offset_transform=ax2.transData)\ntrans = transforms.Affine2D().scale(fig.dpi/72.0)\n\n# 7-sided regular polygons\n\ncol = collections.RegularPolyCollection(\n    7, sizes=np.abs(xx) * 10.0, offsets=xyo, offset_transform=ax3.transData)\ntrans = transforms.Affine2D().scale(fig.dpi / 72.0)\n\n\n# Simulate a series of ocean current profiles, successively\n# offset by 0.1 m/s so that they form what is sometimes called\n# a \"waterfall\" plot or a \"stagger\" plot.\n\nnverts = 60\nncurves = 20\noffs = (0.1, 0.0)\n\nyy = np.linspace(0, 2*np.pi, nverts)\nym = np.max(yy)\nxx = (0.2 + (ym - yy) / ym) ** 2 * np.cos(yy - 0.4) * 0.5\nsegs = []\n\ncol = collections.LineCollection(segs, offsets=offs)\n\n# %%\n#\n# .. admonition:: References\n#\n#    The use of the following functions, methods, classes and modules is shown\n#    in this example:\n#\n#    - `matplotlib.figure.Figure`\n#    - `matplotlib.collections`\n#    - `matplotlib.collections.LineCollection`\n#    - `matplotlib.collections.RegularPolyCollection`\n#    - `matplotlib.axes.Axes.add_collection`\n#    - `matplotlib.axes.Axes.autoscale_view`\n#    - `matplotlib.transforms.Affine2D`\n#    - `matplotlib.transforms.Affine2D.scale`\n\n```\nHint: Search `galleries/examples/shapes_and_collections/collections.py` to get the full content if needed.\n"}, {"content": "Let me get the specific implementation of LineCollection:\n\n<function=get_entity_contents>\n<parameter=entity_names>['lib/matplotlib/collections.py:LineCollection']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_