e\",\n 46 |     \"Styler.template_html_table\",\n 47 |     \"Styler.template_latex\",\n 48 |     \"Styler.template_string\",\n 49 |     \"Styler.loader\",\n 50 |     \"errors.InvalidComparison\",\n 51 |     \"errors.LossySetitemError\",\n 52 |     \"errors.NoBufferPresent\",\n 53 |     \"errors.IncompatibilityWarning\",\n 54 |     \"errors.PyperclipException\",\n 55 |     \"errors.PyperclipWindowsException\",\n 56 | }\n 57 | PRIVATE_CLASSES = [\"NDFrame\", \"IndexOpsMixin\"]\n 58 | ERROR_MSGS = {\n 59 |     \"GL04\": \"Private classes ({mentioned_private_classes}) should not be \"\n 60 |     \"mentioned in public docstrings\",\n 61 |     \"PD01\": \"Use 'array-like' rather than 'array_like' in docstrings.\",\n 62 |     \"SA05\": \"{reference_name} in `See Also` section does not need `pandas` \"\n 63 |     \"prefix, use {right_reference} instead.\",\n 64 |     \"EX03\": \"flake8 error: line {line_number}, col {col_number}: {error_code} \"\n 65 |     \"{error_message}\",\n 66 |     \"EX04\": \"Do not import {imported_library}, as it is imported \"\n 67 |     \"automatically for the examples (numpy as np, pandas as pd)\",\n 68 | }\n```\n\nFound function `pandas/util/_decorators.py:doc`.\nSource: Retrieved code content using keyword search (bm25).\n```\n342 | def doc(*docstrings: None | str | Callable, **params: object) -> Callable[[F], F]:\n343 |     \"\"\"\n344 |     A decorator to take docstring templates, concatenate them and perform string\n345 |     substitution on them.\n346 | \n347 |     This decorator will add a variable \"_docstring_components\" to the wrapped\n348 |     callable to keep track the original docstring template for potential usage.\n349 |     If it should be consider as a template, it will be saved as a string.\n350 |     Otherwise, it will be saved as callable, and later user __doc__ and dedent\n351 |     to get docstring.\n352 | \n353 |     Parameters\n354 |     ----------\n355 |     *docstrings : None, str, or callable\n356 |         The string / docstring / docstring template to be appended in order\n357 |         after default docstring under callable.\n358 |     **params\n359 |         The string which would be used to format docstring template.\n360 |     \"\"\"\n361 | \n362 |     def decorator(decorated: F) -> F:\n363 |         # collecting docstring and docstring templates\n364 |         docstring_components: list[str | Callable] = []\n365 |         if decorated.__doc__:\n366 |             docstring_components.append(dedent(decorated.__doc__))\n367 | \n368 |         for docstring in docstrings:\n369 |             if docstring is None:\n370 |                 continue\n371 |             if hasattr(docstring, \"_docstring_components\"):\n372 |                 docstring_components.extend(\n373 |                     docstring._docstring_components  # pyright: ignore[reportAttributeAccessIssue]\n374 |                 )\n375 |             elif isinstance(docstring, str) or docstring.__doc__:\n376 |                 docstring_components.append(docstring)\n377 | \n378 |         params_applied = [\n379 |             component.format(**params)\n380 |             if isinstance(component, str) and len(params) > 0\n381 |             else component\n382 |             for component in docstring_components\n383 |         ]\n384 | \n385 |         decorated.__doc__ = \"\".join(\n386 |             [\n387 |                 component\n388 |                 if isinstance(component, str)\n389 |                 else dedent(component.__doc__ or \"\")\n390 |                 for component in params_applied\n391 |             ]\n392 |         )\n393 | \n394 |         # error: \"F\" has no attribute \"_docstring_components\"\n395 |         decorated._docstring_components = (  # type: ignore[attr-defined]\n396 |             docstring_components\n397 |         )\n398 |         return decorated\n399 | \n400 |     return decorator\n```\n\nFound function `doc/source/conf.py:process_class_docstrings`.\nSource: Retrieved code content using keyword search (bm25).\n```\n706 | def process_class_docstrings(app, what, name, obj, options, lines) -> None:\n707 |     \"\"\"\n708 |     For those classes for which we use ::\n709 | \n710 |     :template: autosummary/class_without_autosummary.rst\n711 | \n712 |     the documented attributes/methods have to be listed in the class\n713 |     docstring. However, if one of those lists is empty, we use 'None',\n714 |     which then generates warnings in sphinx / ugly html output.\n715 |     This \"autodoc-process-docstring\" event connector removes that part\n716 |     from the processed docstring.\n717 | \n718 |     \"\"\"\n719 |     if what == \"class\":\n720 |         joined = \"\\n\".join(lines)\n721 | \n722 |         templates = [\n723 |             \"\"\".. rubric:: Attributes\n724 | \n725 | .. autosummary::\n726 |    :toctree:\n727 | \n728 |    None\n729 | \"\"\",\n730 |             \"\"\".. rubric:: Methods\n731 | \n732 | .. autosummary::\n733 |    :toctree:\n734 | \n735 |    None\n736 | \"\"\",\n737 |         ]\n738 | \n739 |         for template in templates:\n740 |             if template in joined:\n741 |                 joined = joined.replace(template, \"\")\n742 |         lines[:] = joined.split(\"\\n\")\n```\n\nFound function `doc/source/conf.py:setup`.\nSource: Retrieved code content using keyword search (bm25).\n```\n794 | def setup(app) -> None:\n795 |     app.connect(\"source-read\", rstjinja)\n796 |     app.connect(\"autodoc-process-docstring\", remove_flags_docstring)\n797 |     app.connect(\"autodoc-process-docstring\", process_class_docstrings)\n798 |     app.connect(\"autodoc-process-docstring\", process_business_alias_docstrings)\n799 |     app.add_autodocumenter(AccessorDocumenter)\n800 |     app.add_autodocumenter(AccessorAttributeDocumenter)\n801 |     app.add_autodocumenter(AccessorMethodDocumenter)\n802 |     app.add_autodocumenter(AccessorCallableDocumenter)\n803 |     app.add_directive(\"autosummary\", PandasAutosummary)\n```\n\n\n\n##Searching for term \"docstring\", \"merge_cells docstring\"...\n### Search Result:\nFound function `pandas/core/ops/docstrings.py:make_flex_doc`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 8 | def make_flex_doc(op_name: str, typ: str) -> str:\n 9 |     \"\"\"\n10 |     Make the appropriate substitutions for the given operation and class-typ\n11 |     into either _flex_doc_SERIES or _flex_doc_FRAME to return the docstring\n12 |     to attach to a generated method.\n13 | \n14 |     Parameters\n15 |     ----------\n16 |     op_name : str {'__add__', '__sub__', ... '__eq__', '__ne__', ...}\n17 |     typ : str {series, 'dataframe']}\n18 | \n19 |     Returns\n20 |     -------\n21 |     doc : str\n22 |     \"\"\"\n23 |     op_name = op_name.replace(\"__\", \"\")\n24 |     op_desc = _op_descriptions[op_name]\n25 | \n26 |     op_desc_op = op_desc[\"op\"]\n27 |     assert op_desc_op is not None  # for mypy\n28 |     if op_name.startswith(\"r\"):\n29 |         equiv = f\"other {op_desc_op} {typ}\"\n30 |     elif op_name == \"divmod\":\n31 |         equiv = f\"{op_name}({typ}, other)\"\n32 |     else:\n33 |         equiv = f\"{typ} {op_desc_op} other\"\n34 | \n35 |     if typ == \"series\":\n36 |         base_doc = _flex_doc_SERIES\n37 |         if op_desc[\"reverse\"]:\n38 |             base_doc += _see_also_reverse_SERIES.format(\n39 |                 reverse=op_desc[\"reverse\"], see_also_desc=op_desc[\"see_also_desc\"]\n40 |             )\n41 |         doc_no_examples = base_doc.format(\n42 |             desc=op_desc[\"desc\"],\n43 |             op_name=op_name,\n44 |             equiv=equiv,\n45 |             series_returns=op_desc[\"series_returns\"],\n46 |         )\n47 |         ser_example = op_desc[\"series_examples\"]\n48 |         if ser_example:\n49 |             doc = doc_no_examples + ser_example\n50 |         else:\n51 |             doc = doc_no_examples\n52 |     elif typ == \"dataframe\":\n53 |         if op_name in [\"eq\", \"ne\", \"l