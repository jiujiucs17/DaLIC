96 |     # rotate a bit for better orientation\n 97 |     tr_rotate = Affine2D().translate(-95, 0)\n 98 | \n 99 |     # scale degree to radians\n100 |     tr_scale = Affine2D().scale(np.pi/180., 1.)\n101 | \n102 |     tr = tr_rotate + tr_scale + PolarAxes.PolarTransform(\n103 |         apply_theta_transforms=False)\n104 | \n105 |     grid_locator1 = angle_helper.LocatorHMS(4)\n106 |     tick_formatter1 = angle_helper.FormatterHMS()\n107 | \n108 |     grid_locator2 = MaxNLocator(3)\n109 | \n110 |     # Specify theta limits in degrees\n111 |     ra0, ra1 = 8.*15, 14.*15\n112 |     # Specify radial limits\n113 |     cz0, cz1 = 0, 14000\n114 |     grid_helper = floating_axes.GridHelperCurveLinear(\n115 |         tr, extremes=(ra0, ra1, cz0, cz1),\n116 |         grid_locator1=grid_locator1,\n117 |         grid_locator2=grid_locator2,\n118 |         tick_formatter1=tick_formatter1,\n119 |         tick_formatter2=None)\n120 | \n121 |     ax1 = fig.add_subplot(\n122 |         rect, axes_class=floating_axes.FloatingAxes, grid_helper=grid_helper)\n123 | \n124 |     # adjust axis\n125 |     ax1.axis[\"left\"].set_axis_direction(\"bottom\")\n126 |     ax1.axis[\"right\"].set_axis_direction(\"top\")\n127 | \n128 |     ax1.axis[\"bottom\"].set_visible(False)\n129 |     ax1.axis[\"top\"].set_axis_direction(\"bottom\")\n130 |     ax1.axis[\"top\"].toggle(ticklabels=True, label=True)\n131 |     ax1.axis[\"top\"].major_ticklabels.set_axis_direction(\"top\")\n132 |     ax1.axis[\"top\"].label.set_axis_direction(\"top\")\n133 | \n134 |     ax1.axis[\"left\"].label.set_text(r\"cz [km$^{-1}$]\")\n135 |     ax1.axis[\"top\"].label.set_text(r\"$\\alpha_{1950}$\")\n136 |     ax1.grid()\n137 | \n138 |     # create a parasite Axes whose transData in RA, cz\n139 |     aux_ax = ax1.get_aux_axes(tr)\n140 | \n141 |     aux_ax.patch = ax1.patch  # for aux_ax to have a clip path as in ax\n142 |     ax1.patch.zorder = 0.9  # but this has a side effect that the patch is\n143 |     # drawn twice, and 