        if method == \"single\":\n13222 |                 res = res_df.iloc[0]\n13223 |             else:\n13224 |                 # cannot directly iloc over sparse arrays\n13225 |                 res = res_df.T.iloc[:, 0]\n13226 |             if axis == 1 and len(self) == 0:\n13227 |                 # GH#41544 try to get an appropriate dtype\n13228 |                 dtype = find_common_type(list(self.dtypes))\n13229 |                 if needs_i8_conversion(dtype):\n13230 |                     return res.astype(dtype)\n13231 |             return res\n13232 | \n13233 |         q = Index(q, dtype=np.float64)\n13234 |         data = self._get_numeric_data() if numeric_only else self\n13235 | \n13236 |         if axis == 1:\n13237 |             data = data.T\n13238 | \n13239 |         if len(data.columns) == 0:\n13240 |             # GH#23925 _get_numeric_data may have dropped all columns\n13241 |             cols = self.columns[:0]\n13242 | \n13243 |             dtype = np.float64\n13244 |             if axis == 1:\n13245 |                 # GH#41544 try to get an appropriate dtype\n13246 |                 cdtype = find_common_type(list(self.dtypes))\n13247 |                 if needs_i8_conversion(cdtype):\n13248 |                     dtype = cdtype\n13249 | \n13250 |             res = self._constructor([], index=q, columns=cols, dtype=dtype)\n13251 |             return res.__finalize__(self, method=\"quantile\")\n13252 | \n13253 |         valid_method = {\"single\", \"table\"}\n13254 |         if method not in valid_method:\n13255 |             raise ValueError(\n13256 |                 f\"Invalid method: {method}. Method must be in {valid_method}.\"\n13257 |             )\n13258 |         if method == \"single\":\n13259 |             res = data._mgr.quantile(qs=q, interpolation=interpolation)\n13260 |         elif method == \"table\":\n13261 |             valid_interpolation = {\"nearest\", \"lower\", \"higher\"}\n13262 |             if interpolation not in valid_interpolation:\n13263 |                 raise ValueError(\n13264 |                     f\"Invalid interpolation: {interpolation}. \"\n13265 |                     f\"Interpolation must be in {valid_interpolation}\"\n13266 |                 )\n13267 |             # handle degenerate case\n13268 |             if len(data) == 0:\n13269 |                 if data.ndim == 2:\n13270 |                     dtype = find_common_type(list(self.dtypes))\n13271 |                 else:\n13272 |                     dtype = self.dtype\n13273 |                 return self._constructor([], index=q, columns=data.columns, dtype=dtype)\n13274 | \n13275 |             q_idx = np.quantile(np.arange(len(data)), q, method=interpolation)\n13276 | \n13277 |             by = data.columns\n13278 |             if len(by) > 1:\n13279 |                 keys = [data._get_label_or_level_values(x) for x in by]\n13280 |                 indexer = lexsort_indexer(keys)\n13281 |             else:\n13282 |                 k = data._get_label_or_level_values(by[0])\n13283 |                 indexer = nargsort(k)\n13284 | \n13285 |             res = data._mgr.take(indexer[q_idx], verify=False)\n13286 |             res.axes[1] = q\n13287 | \n13288 |         result = self._constructor_from_mgr(res, axes=res.axes)\n13289 |         return result.__finalize__(self, method=\"quantile\")\n```\n"}, {"content": "Let me search for the actual interpolation implementation in NDFrame:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/core/generic.py:NDFrame.interpolate']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"pandas/core/generic.py:NDFrame.interpolate\"...\n### Search Result:\nFound function `pandas/core/generic.py:NDFrame.interpolate`.\nSource: Exact match found for entity name `pandas/core/generic.py:NDFrame.interpolate`.\n```\n7646 | def interpolate(\n7647 |         self,\n7648 |         method: InterpolateOptions = \"linear\",\n7649 |         *,\n7650 |         axis: Axis = 0,\n7651 |         limit: int | None = None,\n7652 |         inplace: bool = False,\n7653 |         limit_direction: Literal[\"forward\", \"backward\", \"both\"] | None = None,\n7654 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n7655 |         **kwargs,\n7656 |     ) -> Self | None:\n7657 |         \"\"\"\n7658 |         Fill NaN values using an interpolation method.\n7659 | \n7660 |         Please note that only ``method='linear'`` is supported for\n7661 |         DataFrame/Series with a MultiIndex.\n7662 | \n7663 |         Parameters\n7664 |         ----------\n7665 |         method : str, default 'linear'\n7666 |             Interpolation technique to use. One of:\n7667 | \n7668 |             * 'linear': Ignore the index and treat the values as equally\n7669 |               spaced. This is the only method supported on MultiIndexes.\n7670 |             * 'time': Works on daily and higher resolution data to interpolate\n7671 |               given length of interval.\n7672 |             * 'index', 'values': use the actual numerical values of the index.\n7673 |             * 'nearest', 'zero', 'slinear', 'quadratic', 'cubic',\n7674 |               'barycentric', 'polynomial': Passed to\n7675 |               `scipy.interpolate.interp1d`, whereas 'spline' is passed to\n7676 |               `scipy.interpolate.UnivariateSpline`. These methods use the numerical\n7677 |               values of the index.  Both 'polynomial' and 'spline' require that\n7678 |               you also specify an `order` (int), e.g.\n7679 |               ``df.interpolate(method='polynomial', order=5)``. Note that,\n7680 |               `slinear` method in Pandas refers to the Scipy first order `spline`\n7681 |               instead of Pandas first order `spline`.\n7682 |             * 'krogh', 'piecewise_polynomial', 'spline', 'pchip', 'akima',\n7683 |               'cubicspline': Wrappers around the SciPy interpolation methods of\n7684 |               similar names. See `Notes`.\n7685 |             * 'from_derivatives': Refers to\n7686 |               `scipy.interpolate.BPoly.from_derivatives`.\n7687 | \n7688 |         axis : {{0 or 'index', 1 or 'columns', None}}, default None\n7689 |             Axis to interpolate along. For `Series` this parameter is unused\n7690 |             and defaults to 0.\n7691 |         limit : int, optional\n7692 |             Maximum number of consecutive NaNs to fill. Must be greater than\n7693 |             0.\n7694 |         inplace : bool, default False\n7695 |             Update the data in place if possible.\n7696 |         limit_direction : {{'forward', 'backward', 'both'}}, optional, default 'forward'\n7697 |             Consecutive NaNs will be filled in this direction.\n7698 | \n7699 |         limit_area : {{`None`, 'inside', 'outside'}}, default None\n7700 |             If limit is specified, consecutive NaNs will be filled with this\n7701 |             restriction.\n7702 | \n7703 |             * ``None``: No fill restriction.\n7704 |             * 'inside': Only fill NaNs surrounded by valid values\n7705 |               (interpolate).\n7706 |             * 'outside': Only fill NaNs outside valid values (extrapolate).\n7707 | \n7708 |         **kwargs : optional\n7709 |             Keyword arguments to pass on to the interpolating function.\n7710 | \n7711 |         Returns\n7712 |         -------\n7713 |         Series or DataFrame or None\n7714 |             Returns the same object type as the caller, interpolated at\n7715 |             some or all ``NaN`` values or None if ``inplace=True``.\n7716 | \n7717 |         See Also\n7718 |         --------\n7719 |         fillna : Fill missing values using different methods.\n7720 |         scipy.interpolate.Akima1DInterpolator : Piecewise cubic polynomials\n7721 |             (Akima interpolator).\n7722 |         scipy.interpolate.BPoly.from_derivatives : Piecewise polynomial in the\n7723 |             Bernstein basis.\n7724 |         scipy.interpolate.interp1d : Interpolate a 1-D function.\n7725 |         scipy.interpolate.KroghInterpolator : Interpolate polynomial (Krogh\n7726 |             interpolator).\n7727 |         scipy.interpolate.PchipInterpolator : PCHIP 1-d monotonic cubic\n7728 |             interpolation.\n7729 |         scipy.interpolate.CubicSpline : Cubic spline data interpolator.\n7730 | \n7731 |         Notes\n7732 |         -----\n7733 |         The 'krogh', 'piecewise_polynomial', 'spline', 'pchip' and 'akima'\n7734 |         methods are wrappers around the respective SciPy implementations of\n7735 |         similar names. These use the actual numerical values of the index.\n7736 |         For more information on their behavior, see the\n7737 |         `SciPy documentation\n7738 |         <https://docs.scipy.org/doc/scipy/reference/interpolate.html#univariate-interpolation>`__.\n7739 | \n7740 |         Examples\n7741 |         --------\n7742 |         Filling in ``NaN`` in a :class:`~pandas.Series` via linear\n7743 |         interpolation.\n7744 | \n7745 |         >>> s = pd.Series([0, 1, np.nan, 3])\n7746 |         >>> s\n7747 |         0    0.0\n7748 |         1    1.0\n7749 |         2    NaN\n7750 |         3    3.0\n7751 |         dtype: float64\n7752 |         >>> s.interpolate()\n7753 |         0    0.0\n7754 |         1    1.0\n7755 |         2    2.0\n7756 |         3    3.0\n7757 |         dtype: float64\n7758 | \n7759 |         Filling in ``NaN`` in a Series via polynomial interpolation or splines:\n7760 |         Both 'polynomial' and 'spline' methods require that you also specify\n7761 |         an ``order`` (int).\n7762 | \n7763 |         >>> s = pd.Series([0, 2, np.nan, 8])\n7764 |         >>> s.interpolate(method=\"polynomial\", order=2)\n7765 |         0    0.000000\n7766 |         1    2.000000\n7767 |         2    4.666667\n7768 |         3    8.000000\n7769 |         dtype: float64\n7770 | \n7771 |         Fill the DataFrame forward (that is, going down) along each column\n7772 |         using linear interpolation.\n7773 | \n7774 |         Note how the last entry in column 'a' is interpolated differently,\n7775 |         because there is no entry after it to use for interpolation.\n7776 |         Note how the first entry in column 'b' remains ``NaN``, because there\n7777 |         is no entry before it to use for interpolation.\n7778 | \n7779 |         >>> df = pd.DataFrame(\n7780 |         ...     [\n7781 |         ...         (0.0, np.nan, -1.0, 1.0),\n7782 |         ...         (np.nan, 2.0, np.nan, np.nan),\n7783 |         ...         (2.0, 3.0, np.nan, 9.0),\n7784 |         ...         (np.nan, 4.0, -4.0, 16.0),\n7785 |         ...     ],\n7786 |         ...     columns=list(\"abcd\"),\n7787 |         ... )\n7788 |         >>> df\n7789 |              a    b    c     d\n7790 |         0  0.0  NaN -1.0   1.0\n7791 |         1  NaN  2.0  NaN   NaN\n7792 |         2  2.0  3.0  NaN   9.0\n7793 |         3  NaN  4.0 -4.0  16.0\n7794 |         >>> df.interpolate(method=\"linear\", limit_direction=\"forward\", axis=0)\n7795 |              a    b    c     d\n7796 |         0  0.0  NaN -1.0   1.0\n7797 |         1  1.0  2.0 -2.0   5.0\n7798 |         2  2.0  3.0 -3.0   9.0\n7799 |         3  2.0  4.0 -4.0  16.0\n7800 | \n7801 |         Using polynomial interpolation.\n7802 | \n7803 |         >>> df[\"d\"].interpolate(method=\"polynomial\", order=2)\n7804 |         0     1.0\n7805 |         1     4.0\n7806 |         2     9.0\n7807 |         3    16.0\n7808 |         Name: d, dtype: float64\n7809 |         \"\"\"\n7810 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n7811 | \n7812 |         if inplace:\n7813 |             if not PYPY:\n7814 |                 if sys.getrefcount(self) <= REF_COUNT:\n7815 |                     warnings.warn(\n7816 |                         _chained_as