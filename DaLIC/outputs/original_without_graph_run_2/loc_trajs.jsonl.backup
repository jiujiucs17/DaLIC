|                 n_features=n_features,\n486 |                 min_degree=self._min_degree,\n487 |                 max_degree=self._max_degree,\n488 |                 interaction_only=self.interaction_only,\n489 |                 include_bias=self.include_bias,\n490 |             )\n491 |             columns = []\n492 |             for combi in combinations:\n493 |                 if combi:\n494 |                     out_col = 1\n495 |                     for col_idx in combi:\n496 |                         out_col = X[:, col_idx].multiply(out_col)\n497 |                     columns.append(out_col)\n498 |                 else:\n499 |                     bias = sparse.csc_matrix(np.ones((X.shape[0], 1)))\n500 |                     columns.append(bias)\n501 |             XP = sparse.hstack(columns, dtype=X.dtype).tocsc()\n502 |         else:\n503 |             # Do as if _min_degree = 0 and cut down array after the\n504 |             # computation, i.e. use _n_out_full instead of n_output_features_.\n505 |             XP = np.empty(\n506 |                 shape=(n_samples, self._n_out_full), dtype=X.dtype, order=self.order\n507 |             )\n508 | \n509 |             # What follows is a faster implementation of:\n510 |             # for i, comb in enumerate(combinations):\n511 |             #     XP[:, i] = X[:, comb].prod(1)\n512 |             # This implementation uses two optimisations.\n513 |             # First one is broadcasting,\n514 |             # multiply ([X1, ..., Xn], X1) -> [X1 X1, ..., Xn X1]\n515 |             # multiply ([X2, ..., Xn], X2) -> [X2 X2, ..., Xn X2]\n516 |             # ...\n517 |             # multiply ([X[:, start:end], X[:, start]) -> ...\n518 |             # Second optimisation happens for degrees >= 3.\n519 |             # Xi^3 is computed reusing previous computation:\n520 |             # Xi^3 = Xi^2 * Xi.\n521 | \n522 |             # degree 0 term\n523 |             if self.include_bias:\n524 |                 XP[:, 0] = 1\n52