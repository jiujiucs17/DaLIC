 ice_lines_kw : dict, default=None\n 907 |             Dictionary with keywords passed to the `matplotlib.pyplot.plot` call.\n 908 |             For ICE lines in the one-way partial dependence plots.\n 909 |             The key value pairs defined in `ice_lines_kw` takes priority over\n 910 |             `line_kw`.\n 911 | \n 912 |             .. versionadded:: 1.0\n 913 | \n 914 |         pd_line_kw : dict, default=None\n 915 |             Dictionary with keywords passed to the `matplotlib.pyplot.plot` call.\n 916 |             For partial dependence in one-way partial dependence plots.\n 917 |             The key value pairs defined in `pd_line_kw` takes priority over\n 918 |             `line_kw`.\n 919 | \n 920 |             .. versionadded:: 1.0\n 921 | \n 922 |         contour_kw : dict, default=None\n 923 |             Dict with keywords passed to the `matplotlib.pyplot.contourf`\n 924 |             call for two-way partial dependence plots.\n 925 | \n 926 |         Returns\n 927 |         -------\n 928 |         display : :class:`~sklearn.inspection.PartialDependenceDisplay`\n 929 |         \"\"\"\n 930 | \n 931 |         check_matplotlib_support(\"plot_partial_dependence\")\n 932 |         import matplotlib.pyplot as plt  # noqa\n 933 |         from matplotlib.gridspec import GridSpecFromSubplotSpec  # noqa\n 934 | \n 935 |         if line_kw is None:\n 936 |             line_kw = {}\n 937 |         if ice_lines_kw is None:\n 938 |             ice_lines_kw = {}\n 939 |         if pd_line_kw is None:\n 940 |             pd_line_kw = {}\n 941 |         if contour_kw is None:\n 942 |             contour_kw = {}\n 943 | \n 944 |         if ax is None:\n 945 |             _, ax = plt.subplots()\n 946 | \n 947 |         default_contour_kws = {\"alpha\": 0.75}\n 948 |         contour_kw = {**default_contour_kws, **contour_kw}\n 949 | \n 950 |         default_line_kws = {\n 951 |             \"color\": \"C0\",\n 952 |             \"label\": \"average\" if self.kind == \"both\" else None,\n 953 |         }\n 954 |         if self.kind in (\"individual\", \"both\"):\n 955 |             default_ice_lines_kws = {\"alpha\": 0.3, \"linewidth\": 0.5}\n 956 |         else:\n 957 |             default_ice_lines_kws = {}\n 958 | \n 959 |         ice_lines_kw = {\n 960 |             **default_line_kws,\n 961 |             **line_kw,\n 962 |             **default_ice_lines_kws,\n 963 |             **ice_lines_kw,\n 964 |         }\n 965 |         del ice_lines_kw[\"label\"]\n 966 | \n 967 |         pd_line_kw = {**default_line_kws, **line_kw, **pd_line_kw}\n 968 | \n 969 |         n_features = len(self.features)\n 970 |         if self.kind in (\"individual\", \"both\"):\n 971 |             n_ice_lines = self._get_sample_count(len(self.pd_results[0].individual[0]))\n 972 |             if self.kind == \"individual\":\n 973 |                 n_lines = n_ice_lines\n 974 |             else:\n 975 |                 n_lines = n_ice_lines + 1\n 976 |         else:\n 977 |             n_ice_lines = 0\n 978 |             n_lines = 1\n 979 | \n 980 |         if isinstance(ax, plt.Axes):\n 981 |             # If ax was set off, it has most likely been set to off\n 982 |             # by a previous call to plot.\n 983 |             if not ax.axison:\n 984 |                 raise ValueError(\n 985 |                     \"The ax was already used in another plot \"\n 986 |                     \"function, please set ax=display.axes_ \"\n 987 |                     \"instead\"\n 988 |                 )\n 989 | \n 990 |             ax.set_axis_off()\n 991 |             self.bounding_ax_ = ax\n 992 |             self.figure_ = ax.figure\n 993 | \n 994 |             n_cols = min(n_cols, n_features)\n 995 |             n_rows = int(np.ceil(n_features / float(n_cols)))\n 996 | \n 997 |             self.axes_ = np.empty((n_rows, n_cols), dtype=object)\n 998 |             if self.kind == \"average\":\n 999 |                 self.lines_ = np.empty((n_rows, n_cols), dtype=object)\n1000 |             else:\n1001 |                 self.lines_ = np.empty((n_rows, n_cols, n_lines), dtype=object)\n1002 |             self.contours_ = np.empty((n_rows, n_cols), dtype=object)\n1003 | \n1004 |             axes_ravel = self.axes_.ravel()\n1005 | \n1006 |             gs = GridSpecFromSubplotSpec(\n1007 |                 n_rows, n_cols, subplot_spec=ax.get_subplotspec()\n1008 |             )\n1009 |             for i, spec in zip(range(n_features), gs):\n1010 |                 axes_ravel[i] = self.figure_.add_subplot(spec)\n1011 | \n1012 |         else:  # array-like\n1013 |             ax = np.asarray(ax, dtype=object)\n1014 |             if ax.size != n_features:\n1015 |                 raise ValueError(\n1016 |                     \"Expected ax to have {} axes, got {}\".format(n_features, ax.size)\n1017 |                 )\n1018 | \n1019 |             if ax.ndim == 2:\n1020 |                 n_cols = ax.shape[1]\n1021 |             else:\n1022 |                 n_cols = None\n1023 | \n1024 |             self.bounding_ax_ = None\n1025 |             self.figure_ = ax.ravel()[0].figure\n1026 |             self.axes_ = ax\n1027 |             if self.kind == \"average\":\n1028 |                 self.lines_ = np.empty_like(ax, dtype=object)\n1029 |             else:\n1030 |                 self.lines_ = np.empty(ax.shape + (n_lines,), dtype=object)\n1031 |             self.contours_ = np.empty_like(ax, dtype=object)\n1032 | \n1033 |         # create contour levels for two-way plots\n1034 |         if 2 in self.pdp_lim:\n1035 |             Z_level = np.linspace(*self.pdp_lim[2], num=8)\n1036 | \n1037 |         self.deciles_vlines_ = np.empty_like(self.axes_, dtype=object)\n1038 |         self.deciles_hlines_ = np.empty_like(self.axes_, dtype=object)\n1039 | \n1040 |         for pd_plot_idx, (axi, feature_idx, pd_result) in enumerate(\n1041 |             zip(self.axes_.ravel(), self.features, self.pd_results)\n1042 |         ):\n1043 |      