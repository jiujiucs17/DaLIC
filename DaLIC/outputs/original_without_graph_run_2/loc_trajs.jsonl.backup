|             The size of the x and y arrays passed to `.Axes.scatter`.\n4571 |         get_next_color_func : callable\n4572 |             A callable that returns a color. This color is used as facecolor\n4573 |             if no other color is provided.\n4574 | \n4575 |             Note, that this is a function rather than a fixed color value to\n4576 |             support conditional evaluation of the next color.  As of the\n4577 |             current implementation obtaining the next color from the\n4578 |             property cycle advances the cycle. This must only happen if we\n4579 |             actually use the color, which will only be decided within this\n4580 |             method.\n4581 | \n4582 |         Returns\n4583 |         -------\n4584 |         c\n4585 |             The input *c* if it was not *None*, else a color derived from the\n4586 |             other inputs or defaults.\n4587 |         colors : array(N, 4) or None\n4588 |             The facecolors as RGBA values, or *None* if a colormap is used.\n4589 |         edgecolors\n4590 |             The edgecolor.\n4591 | \n4592 |         \"\"\"\n4593 |         facecolors = kwargs.pop('facecolors', None)\n4594 |         facecolors = kwargs.pop('facecolor', facecolors)\n4595 |         edgecolors = kwargs.pop('edgecolor', edgecolors)\n4596 | \n4597 |         kwcolor = kwargs.pop('color', None)\n4598 | \n4599 |         if kwcolor is not None and c is not None:\n4600 |             raise ValueError(\"Supply a 'c' argument or a 'color'\"\n4601 |                              \" kwarg but not both; they differ but\"\n4602 |                              \" their functionalities overlap.\")\n4603 | \n4604 |         if kwcolor is not None:\n4605 |             try:\n4606 |                 mcolors.to_rgba_array(kwcolor)\n4607 |             except ValueError as err:\n4608 |                 raise ValueError(\n4609 |                     \"'color' kwarg must be a color or sequence of color \"\n4610 |               