\n241 |     scipy.sparse.csr_matrix) based on the 'data part' (i.e., in the\n242 |     liac-arff dict, the object from the 'data' key)\n243 | \n244 |     Parameters\n245 |     ----------\n246 |     arff : dict\n247 |         As obtained from liac-arff object.\n248 | \n249 |     col_slice_x : list\n250 |         The column indices that are sliced from the original array to return\n251 |         as X data\n252 | \n253 |     col_slice_y : list\n254 |         The column indices that are sliced from the original array to return\n255 |         as y data\n256 | \n257 |     Returns\n258 |     -------\n259 |     X : np.array or scipy.sparse.csr_matrix\n260 |     y : np.array\n261 |     \"\"\"\n262 |     arff_data = arff['data']\n263 |     if isinstance(arff_data, Generator):\n264 |         if shape is None:\n265 |             raise ValueError(\n266 |                 \"shape must be provided when arr['data'] is a Generator\"\n267 |             )\n268 |         if shape[0] == -1:\n269 |             count = -1\n270 |         else:\n271 |             count = shape[0] * shape[1]\n272 |         data = np.fromiter(itertools.chain.from_iterable(arff_data),\n273 |                            dtype='float64', count=count)\n274 |         data = data.reshape(*shape)\n275 |         X = data[:, col_slice_x]\n276 |         y = data[:, col_slice_y]\n277 |         return X, y\n278 |     elif isinstance(arff_data, tuple):\n279 |         arff_data_X = _split_sparse_columns(arff_data, col_slice_x)\n280 |         num_obs = max(arff_data[1]) + 1\n281 |         X_shape = (num_obs, len(col_slice_x))\n282 |         X = scipy.sparse.coo_matrix(\n283 |             (arff_data_X[0], (arff_data_X[1], arff_data_X[2])),\n284 |             shape=X_shape, dtype=np.float64)\n285 |         X = X.tocsr()\n286 |         y = _sparse_data_to_array(arff_data, col_slice_y)\n287 |         return X, y\n288 |     else:\n289 |         # This should never happen\n290 |         raise ValueError('Unexpected Data Type obtained from arff.')\n```\n\nFound function `sklearn/datasets/_openml.py:_convert_arff_data_dataframe`.\nSource: Retrieved entity using keyword search (bm25).\n```\n310 | def _convert_arff_data_dataframe(\n311 |     arff: ArffContainerType, columns: List, features_dict: Dict[str, Any]\n312 | ) -> Tuple:\n313 |     \"\"\"Convert the ARFF object into a pandas DataFrame.\n314 | \n315 |     Parameters\n316 |     ----------\n317 |     arff : dict\n318 |         As obtained from liac-arff object.\n319 | \n320 |     columns : list\n321 |         Columns from dataframe to return.\n322 | \n323 |     features_dict : dict\n324 |         Maps feature name to feature info from openml.\n325 | \n326 |     Returns\n327 |     -------\n328 |     result : tuple\n329 |         tuple with the resulting dataframe\n330 |     \"\"\"\n331 |     pd = check_pandas_support('fetch_openml with as_frame=True')\n332 | \n333 |     attributes = OrderedDict(arff['attributes'])\n334 |     arff_columns = list(attributes)\n335 | \n336 |     if not isinstance(arff['data'], Generator):\n337 |         raise ValueError(\n338 |             \"arff['data'] must be a generator when converting to pd.DataFrame.\"\n339 |         )\n340 | \n341 |     # calculate chunksize\n342 |     first_row = next(arff['data'])\n343 |     first_df = pd.DataFrame([first_row], columns=arff_columns)\n344 | \n345 |     row_bytes = first_df.memory_usage(deep=True).sum()\n346 |     chunksize = get_chunk_n_rows(row_bytes)\n347 | \n348 |     # read arff data with chunks\n349 |     columns_to_keep = [col for col in arff_columns if col in columns]\n350 |     dfs = []\n351 |     dfs.append(first_df[columns_to_keep])\n352 |     for data in _chunk_generator(arff['data'], chunksize):\n353 |         dfs.append(pd.DataFrame(data, columns=arff_columns)[columns_to_keep])\n354 |     df = pd.concat(dfs, ignore_index=True)\n355 | \n356 |     for column in columns_to_keep:\n357 |         dtype = _feature_to_dtype(features_dict[column])\n358 |         if dtype == 'category':\n359 |             dtype = pd.api.types.CategoricalDtype(attributes[column])\n360 |         df[column] = df[column].astype(dtype, copy=False)\n361 |     return (df, )\n```\n\nFound function `sklearn/datasets/_openml.py:_load_arff_response`.\nSource: Retrieved entity using keyword search (bm25).\n```\n491 | def _load_arff_response(\n492 |     url: str,\n493 |     data_home: Optional[str],\n494 |     return_type, encode_nominal: bool,\n495 |     parse_arff: Callable[[ArffContainerType], Tuple]\n496 | ) -> Tuple:\n497 |     \"\"\"Load arff data with url and parses arff response with parse_arff\"\"\"\n498 |     response = _open_openml_url(url, data_home)\n499 | \n500 |     with closing(response):\n501 |         # Note that if the data is dense, no reading is done until the data\n502 |         # generator is iterated.\n503 |         arff = _arff.load((line.decode('utf-8') for line in response),\n504 |                           return_type=return_type,\n505 |                           encode_nominal=encode_nominal)\n506 |         return parse_arff(arff)\n```\n\nFound function `sklearn/externals/_arff.py:ArffDecoder.decode`.\nSource: Retrieved code content using keyword search (bm25).\n```\n895 | def decode(self, s, encode_nominal=False, return_type=DENSE):\n896 |         '''Returns the Python representation of a given ARFF file.\n897 | \n898 |         When a file object is passed as an argument, this method reads lines\n899 |         iteratively, avoiding to load unnecessary information to the memory.\n900 | \n901 |         :param s: a string or file object with the ARFF file.\n902 |         :param encode_nominal: boolean, if True perform a label encoding\n903 |             while reading the .arff file.\n904 |         :param return_type: determines the data structure used to store the\n905 |             dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n906 |             `arff.DENSE_GEN` or `arff.LOD_GEN`.\n907 |             Consult the sections on `working with sparse data`_ and `loading\n908 |             progressively`_.\n909 |         '''\n910 |         try:\n911 |             return self._decode(s, encode_nominal=encode_nominal,\n912 |                                 matrix_type=return_type)\n913 |         except ArffException as e:\n914 |             e.line = self._current_line\n915 |             raise e\n```\n\nFound function `sklearn/externals/_arff.py:ArffEncoder.iter_encode`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 998 | def iter_encode(self, obj):\n 999 |         '''The iterative version of `arff.ArffEncoder.encode`.\n1000 | \n1001 |         This encodes iteratively a given object and return, one-by-one, the\n1002 |         lines of the ARFF file.\n1003 | \n1004 |         :param obj: the object containing the ARFF information.\n1005 |         :return: (yields) the ARFF file as unicode strings.\n1006 |         '''\n1007 |         # DESCRIPTION\n1008 |         if obj.get('description', None):\n1009 |             for row in obj['description'].split('\\n'):\n1010 |                 yield self._encode_comment(row)\n1011 | \n1012 |         # RELATION\n1013 |         if not obj.get('relation'):\n1014 |             raise BadObject('Relation name not found or with invalid value.')\n1015 | \n1016 |         yield self._encode_relation(obj['relation'])\n1017 |         yield u''\n1018 | \n1019 |         # ATTRIBUTES\n1020 |         if not obj.get('attributes'):\n1021 |             raise BadObject('Attributes not found.')\n1022 | \n1023 |         attribute_names = set()\n1024 |         for attr in obj['attributes']:\n1025 |             # Verify for bad object format\n1026 |             if not isinstance(attr, (tuple, list)) or \\\n1027 |                len(attr) != 2 or \\\n1028 |                not isinstance(attr[0], basestring):\n1029 |                 raise BadObject('Invalid attribute declaration \"%s\"'%str(attr))\n1030 | \n1031 |             if isinstance(attr[1], basestring):\n1032 |                 # Verify for invalid types\n1033 |                 if attr[1] not in _SIMPLE_TYPES:\n1034 |                     raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1035 | \n1036 |             # Verify for bad object format\n1037 |             elif not isinstance(attr[1], (tuple, list)):\n1038 |                 raise BadObject('Invalid attribute type \"%s\"'%str(attr))\n1039 | \n1040 |             # Verify attribute name is not used twice\n1041 |             if attr[0] in attribute_names:\n1042 |                 raise BadObject('Trying to use attribute name \"%s\" for the '\n1043 |                                 'second time.' % str(attr[0]))\n1044 |             else:\n1045 |                 attribute_names.add(attr[0])\n1046 | \n1047 |             yield self._encode_attribute(attr[0], attr[1])\n1048 |         yield u''\n1049 |         attributes = obj['attributes']\n1050 | \n1051 |         # DATA\n1052 |         yield _TK_DATA\n1053 |         if 'data' in obj:\n1054 |             data = _get_data_object_for_encoding(obj.get('data'))\n1055 |             for line in data.encode_data(obj.get('data'), attributes):\n1056 |                 yield line\n1057 | \n1058 |         yield u''\n```\n\nFound function `sklearn/externals/_arff.py:load`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1063 | def load(fp, encode_nominal=False, return_type=DENSE):\n1064 |     '''Load a file-like object containing the ARFF document and convert it into\n1065 |     a Python object.\n1066 | \n1067 |     :param fp: a file-like object.\n1068 |     :param encode_nominal: boolean, if True perform a label encoding\n1069 |         while reading the .arff file.\n1070 |     :param return_type: determines the data structure used to store the\n1071 |         dataset. Can be one of `arff.DENSE`, `arff.COO`, `arff.LOD`,\n1072 |         `arff.DENSE_GEN` or `arff.LOD_GEN`.\n1073 |         Consult the sections on `working with sparse data`_ and `loa