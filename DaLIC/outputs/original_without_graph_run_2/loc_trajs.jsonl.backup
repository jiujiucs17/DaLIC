r,\n307 |         )\n308 | \n309 |     @classmethod\n310 |     def from_predictions(\n311 |         cls,\n312 |         y_true,\n313 |         y_pred,\n314 |         *,\n315 |         labels=None,\n316 |         sample_weight=None,\n317 |         normalize=None,\n318 |         display_labels=None,\n319 |         include_values=True,\n320 |         xticks_rotation=\"horizontal\",\n321 |         values_format=None,\n322 |         cmap=\"viridis\",\n323 |         ax=None,\n324 |         colorbar=True,\n325 |     ):\n326 |         \"\"\"Plot Confusion Matrix given true and predicted labels.\n327 | \n328 |         Read more in the :ref:`User Guide <confusion_matrix>`.\n329 | \n330 |         .. versionadded:: 0.24\n331 | \n332 |         Parameters\n333 |         ----------\n334 |         y_true : array-like of shape (n_samples,)\n335 |             True labels.\n336 | \n337 |         y_pred : array-like of shape (n_samples,)\n338 |             The predicted labels given by the method `predict` of an\n339 |             classifier.\n340 | \n341 |         labels : array-like of shape (n_classes,), default=None\n342 |             List of labels to index the confusion matrix. This may be used to\n343 |             reorder or select a subset of labels. If `None` is given, those\n344 |             that appear at least once in `y_true` or `y_pred` are used in\n345 |             sorted order.\n346 | \n347 |         sample_weight : array-like of shape (n_samples,), default=None\n348 |             Sample weights.\n349 | \n350 |         normalize : {'true', 'pred', 'all'}, default=None\n351 |             Either to normalize the counts display in the matrix:\n352 | \n353 |             - if `'true'`, the confusion matrix is normalized over the true\n354 |               conditions (e.g. rows);\n355 |             - if `'pred'`, the confusion matrix is normalized over the\n356 |               predicted conditions (e.g. columns);\n357 |             - if `'all'`, the confusion matrix is normalized by the total\n358 |               number of samples;\n359 |             - if `None` (default), the confusion matrix will not be normalized.\n360 | \n361 |         display_labels : array-like of shape (n_classes,), default=None\n362 |             Target names used for plotting. By default, `labels` will be used\n363 |             if it is defined, otherwise the unique labels of `y_true` and\n364 |             `y_pred` will be used.\n365 | \n366 |         include_values : bool, default=True\n367 |             Includes values in confusion matrix.\n368 | \n369 |         xticks_rotation : {'vertical', 'horizontal'} or float, \\\n370 |                 default='horizontal'\n371 |             Rotation of xtick labels.\n372 | \n373 |         values_format : str, default=None\n374 |             Format specification for values in confusion matrix. If `None`, the\n375 |             format specification is 'd' or '.2g' whichever is shorter.\n376 | \n377 |         cmap : str or matplotlib Colormap, default='viridis'\n378 |             Colormap recognized by matplotlib.\n379 | \n380 |         ax : matplotlib Axes, default=None\n381 |             Axes object to plot on. If `None`, a new figure and axes is\n382 |             created.\n383 | \n384 |         colorbar : bool, default=True\n385 |             Whether or not to add a colorbar to the plot.\n386 | \n387 |         Returns\n388 |         -------\n389 |         display : :class:`~sklearn.metrics.ConfusionMatrixDisplay`\n390 | \n391 |         See Also\n392 |         --------\n393 |         ConfusionMatrixDisplay.from_estimator : Plot the confusion matrix\n394 |             given an estimator, the data, and the label.\n395 | \n396 |         Examples\n397 |         --------\n398 |         >>> import matplotlib.pyplot as plt\n399 |         >>> from sklearn.datasets import make_classification\n400 |         >>> from sklearn.metrics import ConfusionMatrixDisplay\n401 |         >>> from sklearn.model_selection import train_test_split\n402 |         >>> from sklearn.svm import SVC\n403 |         >>> X, y = make_classification(random_state=0)\n404 |         >>> X_train, X_test, y_train, y_test = train_test_split(\n405 |         ...         X, y, random_state=0)\n406 |         >>> clf = SVC(random_state=0)\n407 |         >>> clf.fit(X_train, y_train)\n408 |         SVC(random_state=0)\n409 |         >>> y_pred = clf.predict(X_test)\n410 |         >>> ConfusionMatrixDisplay.from_predictions(\n411 |         ...    y_test, y_pred)\n412 |         <...>\n413 |         >>> plt.show()\n414 |         \"\"\"\n415 |         check_matplotlib_support(f\"{cls.__name__}.from_predictions\")\n416 | \n417 |         if display_labels is None:\n418 |             if labels is None:\n419 |                 display_labels = unique_labels(y_true, y_pred)\n420 |             else:\n421 |                 display_labels = labels\n422 | \n423 |         cm = confusion_matrix(\n424 |             y_true,\n425 |             y_pred,\n426 |             sample_weight=sample_weight,\n427 |             labels=labels,\n428 |             normalize=normalize,\n429 |         )\n430 | \n431 |         disp = cls(confusion_matrix=cm, display_labels=display_labels)\n432 | \n433 |         return disp.plot(\n434 |             include_values=include_values,\n435 |             cmap=cmap,\n436 |             ax=ax,\n437 |             xticks_rotation=xticks_rotation,\n438 |             values_format=values_format,\n439 |             colorbar=colorbar,\n440 |         )\n```\n"}, {"content": "Based on the retrieved classes, it seems that they all inherit from a common base class for plotting. Let's specifically search for the `BaseDisplay` class to understand its structure and methods.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/metrics/_base.py:BaseDisplay']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "conte