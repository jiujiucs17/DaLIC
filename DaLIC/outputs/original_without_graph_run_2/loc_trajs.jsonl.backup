      validation_indices = random_state.randint(0, n_samples, self._init_size)\n1964 |         X_valid = X[validation_indices]\n1965 |         sample_weight_valid = sample_weight[validation_indices]\n1966 |         x_squared_norms_valid = x_squared_norms[validation_indices]\n1967 | \n1968 |         # perform several inits with random subsets\n1969 |         best_inertia = None\n1970 |         for init_idx in range(self._n_init):\n1971 |             if self.verbose:\n1972 |                 print(f\"Init {init_idx + 1}/{self._n_init} with method {init}\")\n1973 | \n1974 |             # Initialize the centers using only a fraction of the data as we\n1975 |             # expect n_samples to be very large when using MiniBatchKMeans.\n1976 |             cluster_centers = self._init_centroids(\n1977 |                 X,\n1978 |                 x_squared_norms=x_squared_norms,\n1979 |                 init=init,\n1980 |                 random_state=random_state,\n1981 |                 init_size=self._init_size,\n1982 |             )\n1983 | \n1984 |             # Compute inertia on a validation set.\n1985 |             _, inertia = _labels_inertia_threadpool_limit(\n1986 |                 X_valid,\n1987 |                 sample_weight_valid,\n1988 |                 x_squared_norms_valid,\n1989 |                 cluster_centers,\n1990 |                 n_threads=self._n_threads,\n1991 |             )\n1992 | \n1993 |             if self.verbose:\n1994 |                 print(f\"Inertia for init {init_idx + 1}/{self._n_init}: {inertia}\")\n1995 |             if best_inertia is None or inertia < best_inertia:\n1996 |                 init_centers = cluster_centers\n1997 |                 best_inertia = inertia\n1998 | \n1999 |         centers = init_centers\n2000 |         centers_new = np.empty_like(centers)\n2001 | \n2002 |         # Initialize counts\n2003 |         self._counts = np.zeros(self.n_clusters, dtype=X.dtype)\n2004 | \n2005 |         # Attributes to monitor the c