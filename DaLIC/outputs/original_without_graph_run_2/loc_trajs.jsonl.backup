other._range\n729 | \n730 |         # check whether intervals intersect\n731 |         # deals with in- and decreasing ranges\n732 |         int_low = max(first.start, second.start)\n733 |         int_high = min(first.stop, second.stop)\n734 |         if int_high <= int_low:\n735 |             return self._simple_new(_empty_range)\n736 | \n737 |         # Method hint: linear Diophantine equation\n738 |         # solve intersection problem\n739 |         # performance hint: for identical step sizes, could use\n740 |         # cheaper alternative\n741 |         gcd, s, _ = self._extended_gcd(first.step, second.step)\n742 | \n743 |         # check whether element sets intersect\n744 |         if (first.start - second.start) % gcd:\n745 |             return self._simple_new(_empty_range)\n746 | \n747 |         # calculate parameters for the RangeIndex describing the\n748 |         # intersection disregarding the lower bounds\n749 |         tmp_start = first.start + (second.start - first.start) * first.step // gcd * s\n750 |         new_step = first.step * second.step // gcd\n751 | \n752 |         # adjust index to limiting interval\n753 |         new_start = min_fitting_element(tmp_start, new_step, int_low)\n754 |         new_range = range(new_start, int_high, new_step)\n755 | \n756 |         if (self.step < 0 and other.step < 0) is not (new_range.step < 0):\n757 |             new_range = new_range[::-1]\n758 | \n759 |         return self._simple_new(new_range)\n```\n\n\n\n##Searching for term \"type hint\", \"squeeze method type hint\"...\n### Search Result:\nFound function `pandas/core/dtypes/dtypes.py:SparseDtype.type`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1898 | def type(self):\n1899 |         return self.subtype.type\n```\n\nFound function `pandas/core/common.py:pipe`.\nSource: Retrieved code content using keyword search (bm25).\n```\n491 | def pipe(\n492 |     obj: _T,\n493 |     func: Callable[Concatenate[_T, P], T] | tuple[Callable[..., T], str],\n494 |     *args: Any,\n495 |     **kwargs: Any,\n496 | ) -> T:\n497 |     \"\"\"\n498 |     Apply a function ``func`` to object ``obj`` either by passing obj as the\n499 |     first argument to the function or, in the case that the func is a tuple,\n500 |     interpret the first element of the tuple as a function and pass the obj to\n501 |     that function as a keyword argument whose key is the value of the second\n502 |     element of the tuple.\n503 | \n504 |     Parameters\n505 |     ----------\n506 |     func : callable or tuple of (callable, str)\n507 |         Function to apply to this object or, alternatively, a\n508 |         ``(callable, data_keyword)`` tuple where ``data_keyword`` is a\n509 |         string indicating the keyword of ``callable`` that expects the\n510 |         object.\n511 |     *args : iterable, optional\n512 |         Positional arguments passed into ``func``.\n513 |     **kwargs : dict, optional\n514 |         A dictionary of keyword arguments passed into ``func``.\n515 | \n516 |     Returns\n517 |     -------\n518 |     object : the return type of ``func``.\n519 |     \"\"\"\n520 |     if isinstance(func, tuple):\n521 |         # Assigning to func_ so pyright understands that it's a callable\n522 |         func_, target = func\n523 |         if target in kwargs:\n524 |             msg = f\"{target} is both the pipe target and a keyword argument\"\n525 |             raise ValueError(msg)\n526 |         kwargs[target] = obj\n527 |         return func_(*args, **kwargs)\n528 |     else:\n529 |         return func(obj, *args, **kwargs)\n```\n\nFound file `pandas/api/typing/__init__.py`.\nFound file `pandas/api/types/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"squeeze method type hint\"...\n### Search Result:\nFound function `pandas/core/arrays/string_.py:StringDtype.type`.\nSource: Retrieved entity usin