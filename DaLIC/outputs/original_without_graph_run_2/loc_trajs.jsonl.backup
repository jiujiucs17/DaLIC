index=False)\n5183 |         24\n5184 | \n5185 |         The memory footprint of `object` values is ignored by default:\n5186 | \n5187 |         >>> s = pd.Series([\"a\", \"b\"])\n5188 |         >>> s.values\n5189 |         array(['a', 'b'], dtype=object)\n5190 |         >>> s.memory_usage()\n5191 |         144\n5192 |         >>> s.memory_usage(deep=True)\n5193 |         244\n5194 |         \"\"\"\n5195 |         v = self._memory_usage(deep=deep)\n5196 |         if index:\n5197 |             v += self.index.memory_usage(deep=deep)\n5198 |         return v\n```\n\nFound function `doc/make.py:main`.\nSource: Retrieved code content using keyword search (bm25).\n```\n302 | def main():\n303 |     cmds = [method for method in dir(DocBuilder) if not method.startswith(\"_\")]\n304 | \n305 |     joined = \",\".join(cmds)\n306 |     argparser = argparse.ArgumentParser(\n307 |         description=\"pandas documentation builder\", epilog=f\"Commands: {joined}\"\n308 |     )\n309 | \n310 |     joined = \", \".join(cmds)\n311 |     argparser.add_argument(\n312 |         \"command\", nargs=\"?\", default=\"html\", help=f\"command to run: {joined}\"\n313 |     )\n314 |     argparser.add_argument(\n315 |         \"--num-jobs\", default=\"auto\", help=\"number of jobs used by sphinx-build\"\n316 |     )\n317 |     argparser.add_argument(\n318 |         \"--no-api\", default=False, help=\"omit api and autosummary\", action=\"store_true\"\n319 |     )\n320 |     argparser.add_argument(\n321 |         \"--whatsnew\",\n322 |         default=False,\n323 |         help=\"only build whatsnew (and api for links)\",\n324 |         action=\"store_true\",\n325 |     )\n326 |     argparser.add_argument(\n327 |         \"--single\",\n328 |         metavar=\"FILENAME\",\n329 |         type=str,\n330 |         default=None,\n331 |         help=(\n332 |             \"filename (relative to the 'source' folder) of section or method name to \"\n333 |             \"compile, e.g. 'development/contributing.rst', \"\n334 |             \"'pandas.DataFrame.join'\"\n335 |         ),\n336 |     )\n337 |     argparser.add_argument(\n338 |         \"--python-path\", type=str, default=os.path.dirname(DOC_PATH), help=\"path\"\n339 |     )\n340 |     argparser.add_argument(\n341 |         \"-v\",\n342 |         action=\"count\",\n343 |         dest=\"verbosity\",\n344 |         default=0,\n345 |         help=(\n346 |             \"increase verbosity (can be repeated), \"\n347 |             \"passed to the sphinx build command\"\n348 |         ),\n349 |     )\n350 |     argparser.add_argument(\n351 |         \"--warnings-are-errors\",\n352 |         \"-W\",\n353 |         action=\"store_true\",\n354 |         help=\"fail if warnings are raised\",\n355 |     )\n356 |     argparser.add_argument(\n357 |         \"--no-browser\",\n358 |         help=\"Don't open browser\",\n359 |         default=False,\n360 |         action=\"store_true\",\n361 |     )\n362 |     args = argparser.parse_args()\n363 | \n364 |     if args.command not in cmds:\n365 |         joined = \", \".join(cmds)\n366 |         raise ValueError(f\"Unknown command {args.command}. Available options: {joined}\")\n367 | \n368 |     # Below we update both os.environ and sys.path. The former is used by\n369 |     # external libraries (namely Sphinx) to compile this module and resolve\n370 |     # the import of `python_path` correctly. The latter is used to resolve\n371 |     # the import within the module, injecting it into the global namespace\n372 |     os.environ[\"PYTHONPATH\"] = args.python_path\n373 |     sys.path.insert(0, args.python_path)\n374 |     globals()[\"pandas\"] = importlib.import_module(\"pandas\")\n375 | \n376 |     # Set the matplotlib backend to the non-interactive Agg backend for all\n377 |     # child processes.\n378 |     os.environ[\"MPLBACKEND\"] = \"module://matplotlib.backends.backend_agg\"\n379 | \n380 |     builder = DocBuilder(\n381 |         args.num_jobs,\n382 |         not args.no_ap