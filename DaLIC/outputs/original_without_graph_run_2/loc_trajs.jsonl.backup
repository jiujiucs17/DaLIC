tion == 'vertical':\n2525 |             tick_label_axis = self.xaxis\n2526 |             tick_label_position = x\n2527 |         else:  # horizontal\n2528 |             tick_label_axis = self.yaxis\n2529 |             tick_label_position = y\n2530 | \n2531 |         if not isinstance(label, str) and np.iterable(label):\n2532 |             bar_container_label = '_nolegend_'\n2533 |             patch_labels = label\n2534 |         else:\n2535 |             bar_container_label = label\n2536 |             patch_labels = ['_nolegend_'] * len(x)\n2537 |         if len(patch_labels) != len(x):\n2538 |             raise ValueError(f'number of labels ({len(patch_labels)}) '\n2539 |                              f'does not match number of bars ({len(x)}).')\n2540 | \n2541 |         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n2542 |         hatch = itertools.cycle(np.atleast_1d(hatch))\n2543 |         color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n2544 |                                 # Fallback if color == \"none\".\n2545 |                                 itertools.repeat('none'))\n2546 |         if edgecolor is None:\n2547 |             edgecolor = itertools.repeat(None)\n2548 |         else:\n2549 |             edgecolor = itertools.chain(\n2550 |                 itertools.cycle(mcolors.to_rgba_array(edgecolor)),\n2551 |                 # Fallback if edgecolor == \"none\".\n2552 |                 itertools.repeat('none'))\n2553 | \n2554 |         # We will now resolve the alignment and really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                    