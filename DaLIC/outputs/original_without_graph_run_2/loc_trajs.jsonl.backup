return inferred_dtype\n```\n\nFound function `pandas/core/arrays/boolean.py:coerce_to_array`.\nSource: Retrieved code content using keyword search (bm25).\n```\n160 | def coerce_to_array(\n161 |     values, mask=None, copy: bool = False\n162 | ) -> tuple[np.ndarray, np.ndarray]:\n163 |     \"\"\"\n164 |     Coerce the input values array to numpy arrays with a mask.\n165 | \n166 |     Parameters\n167 |     ----------\n168 |     values : 1D list-like\n169 |     mask : bool 1D array, optional\n170 |     copy : bool, default False\n171 |         if True, copy the input\n172 | \n173 |     Returns\n174 |     -------\n175 |     tuple of (values, mask)\n176 |     \"\"\"\n177 |     if isinstance(values, BooleanArray):\n178 |         if mask is not None:\n179 |             raise ValueError(\"cannot pass mask for BooleanArray input\")\n180 |         values, mask = values._data, values._mask\n181 |         if copy:\n182 |             values = values.copy()\n183 |             mask = mask.copy()\n184 |         return values, mask\n185 | \n186 |     mask_values = None\n187 |     if isinstance(values, np.ndarray) and values.dtype == np.bool_:\n188 |         if copy:\n189 |             values = values.copy()\n190 |     elif isinstance(values, np.ndarray) and values.dtype.kind in \"iufcb\":\n191 |         mask_values = isna(values)\n192 | \n193 |         values_bool = np.zeros(len(values), dtype=bool)\n194 |         values_bool[~mask_values] = values[~mask_values].astype(bool)\n195 | \n196 |         if not np.all(\n197 |             values_bool[~mask_values].astype(values.dtype) == values[~mask_values]\n198 |         ):\n199 |             raise TypeError(\"Need to pass bool-like values\")\n200 | \n201 |         values = values_bool\n202 |     else:\n203 |         values_object = np.asarray(values, dtype=object)\n204 | \n205 |         inferred_dtype = lib.infer_dtype(values_object, skipna=True)\n206 |         integer_like = (\"floating\", \"integer\", \"mixed-integer-float\")\n207 |         if inferred_dtype not in (\"boolean\", \"empty\") + integer_like:\n208 |             raise TypeError(\"Need to pass bool-like values\")\n209 | \n210 |         # mypy does not narrow the type of mask_values to npt.NDArray[np.bool_]\n211 |         # within this branch, it assumes it can also be None\n212 |         mask_values = cast(\"npt.NDArray[np.bool_]\", isna(values_object))\n213 |         values = np.zeros(len(values), dtype=bool)\n214 |         values[~mask_values] = values_object[~mask_values].astype(bool)\n215 | \n216 |         # if the values were integer-like, validate it were actually 0/1's\n217 |         if (inferred_dtype in integer_like) and not (\n218 |             np.all(\n219 |                 values[~mask_values].astype(float)\n220 |                 == values_object[~mask_values].astype(float)\n221 |             )\n222 |         ):\n223 |             raise TypeError(\"Need to pass bool-like values\")\n224 | \n225 |     if mask is None and mask_values is None:\n226 |         mask = np.zeros(values.shape, dtype=bool)\n227 |     elif mask is None:\n228 |         mask = mask_values\n229 |     else:\n230 |         if isinstance(mask, np.ndarray) and mask.dtype == np.bool_:\n231 |             if mask_values is not None:\n232 |                 mask = mask | mask_values\n233 |             else:\n234 |                 if copy:\n235 |                     mask = mask.copy()\n236 |         else:\n237 |             mask = np.array(mask, dtype=bool)\n238 |             if mask_values is not None:\n239 |                 mask = mask | mask_values\n240 | \n241 |     if values.shape != mask.shape:\n242 |         raise ValueError(\"values.shape and mask.shape must match\")\n243 | \n244 |     return values, mask\n```\n\n\n\n##Searching for term \"inferred_dtype\"...\n### Search Result:\nFound function `asv_bench/benchmarks/index_cached_properties.py:IndexCache.time_inferred_type`.\nSource: Retrieved entity using keyword search (bm25).\n```\n71 | def time_inferred