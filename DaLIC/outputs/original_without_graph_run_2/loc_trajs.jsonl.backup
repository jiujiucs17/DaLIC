versed:\n125 |             # reverse order to original for fallback\n126 |             a, b = b, a\n127 | \n128 |     if _TEST_MODE:\n129 |         _store_test_result(result is not None)\n130 | \n131 |     if result is None:\n132 |         result = _evaluate_standard(op, op_str, a, b)\n133 | \n134 |     return result\n```\n\nFound function `pandas/core/computation/expressions.py:_has_bool_dtype`.\nSource: Retrieved code content using keyword search (bm25).\n```\n199 | def _has_bool_dtype(x):\n200 |     try:\n201 |         return x.dtype == bool\n202 |     except AttributeError:\n203 |         return isinstance(x, (bool, np.bool_))\n```\n\nFound function `pandas/core/computation/expressions.py:evaluate`.\nSource: Retrieved code content using keyword search (bm25).\n```\n227 | def evaluate(op, a, b, use_numexpr: bool = True):\n228 |     \"\"\"\n229 |     Evaluate and return the expression of the op on a and b.\n230 | \n231 |     Parameters\n232 |     ----------\n233 |     op : the actual operand\n234 |     a : left operand\n235 |     b : right operand\n236 |     use_numexpr : bool, default True\n237 |         Whether to try to use numexpr.\n238 |     \"\"\"\n239 |     op_str = _op_str_mapping[op]\n240 |     if op_str is not None:\n241 |         if use_numexpr:\n242 |             # error: \"None\" not callable\n243 |             return _evaluate(op, op_str, a, b)  # type: ignore[misc]\n244 |     return _evaluate_standard(op, op_str, a, b)\n```\n\nFound function `pandas/core/computation/expressions.py:where`.\nSource: Retrieved code content using keyword search (bm25).\n```\n247 | def where(cond, a, b, use_numexpr: bool = True):\n248 |     \"\"\"\n249 |     Evaluate the where condition cond on a and b.\n250 | \n251 |     Parameters\n252 |     ----------\n253 |     cond : np.ndarray[bool]\n254 |     a : return if cond is True\n255 |     b : return if cond is False\n256 |     use_numexpr : bool, default True\n257 |         Whether to try to use numexpr.\n258 |     \"\"\"\n259 |     assert _where is not None\n260 |     return _where(cond, a, b) if use_numexpr else _where_standard(cond, a, b)\n```\n\n\n\n##Searching for term \"left_op\"...\n### Search Result:\nFound function `asv_bench/benchmarks/join_merge.py:Concat.time_concat_empty_left`.\nSource: Retrieved entity using keyword search (bm25).\n```\n48 | def time_concat_empty_left(self, axis):\n49 |         concat(self.empty_left, axis=axis)\n```\n\nFound function `asv_bench/benchmarks/join_merge.py:JoinIndex.time_left_outer_join_index`.\nSource: Retrieved entity using keyword search (bm25).\n```\n180 | def time_left_outer_join_index(self):\n181 |         self.left.join(self.right, on=\"jim\")\n```\n\nFound function `asv_bench/benchmarks/join_merge.py:JoinEmpty.time_inner_join_left_empty`.\nSource: Retrieved entity using keyword search (bm25).\n```\n202 | def time_inner_join_left_empty(self):\n203 |         self.df_empty.join(self.df, how=\"inner\")\n```\n\nFound function `pandas/core/computation/expressions.py:_can_use_numexpr`.\nSource: Retrieved code content using keyword search (bm25).\n```\n77 | def _can_use_numexpr(op, op_str, a, b, dtype_check) -> bool:\n78 |     \"\"\"return a boolean if we WILL be using numexpr\"\"\"\n79 |     if op_str is not None:\n80 |         # required min elements (otherwise we are adding overhead)\n81 |         if a.size > _MIN_ELEMENTS:\n82 |             # check for dtype compatibility\n83 |             dtypes: set[str] = set()\n84 |             for o in [a, b]:\n85 |                 # ndarray and Series Case\n86 |                 if hasattr(o, \"dtype\"):\n87 |                     dtypes |= {o.dtype.name}\n88 | \n89 |             # allowed are a superset\n90 |             if not len(dtypes) or _ALLOWED_DTYPES[dtype_check] >= dtypes:\n91 |                 return True\n92 | \n93 |     return False\n```\n\n\n\n##Searching for term \"right_op left_op\"...\n### Search Result:\nFound function `pandas/core/reshape/merge.py:_MergeOperation._validate_left_right_on`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1772 | def _validate_left_right_on(self, left_on, right_on):\n1773 |         left_on = com.maybe_make_list(left_on)\n1774 |         right_on = com.maybe_make_list(right_on)\n1775 | \n1776 |         # Hm, any way to make this logic less complicated??\n1777 |         if self.on is None and left_on is None and right_on is None:\n1778 |             if self.left_index and self.right_index:\n1779 |                 left_on, right_on = (), ()\n1780 |             elif self.left_index:\n1781 |                 raise MergeError(\"Must pass right_on or right_index=True\")\n1782 |             elif self.right_index:\n1783 |                 raise MergeError(\"Must pass left_on or left_index=True\")\n1784 |             else:\n1785 |                 # use the common columns\n1786 |                 left_cols = self.left.columns\n1787 |                 right_cols = self.right.columns\n1788 |                 common_cols = left_cols.intersection(right_cols)\n1789 |                 if len(common_cols) == 0:\n1790 |                     raise MergeError(\n1791 |                         \"No common columns to perform merge on. \"\n1792 |                         f\"Merge options: left_on={left_on}, \"\n1793 |                         f\"right_on={right_on}, \"\n1794 |                         f\"left_index={self.left_index}, \"\n1795 |                         f\"right_index={self.right_index}\"\n1796 |                     )\n1797 |                 if (\n1798 |                     not left_cols.join(common_cols, how=\"inner\").is_unique\n1799 |                     or not right_cols.join(common_cols, how=\"inner\").is_unique\n1800 |                 ):\n1801 |                     raise MergeError(f\"Data columns not unique: {common_cols!r}\")\n1802 |                 left_on = right_on = common_cols\n1803 |         elif self.on is not None:\n1804 |             if left_on is not None or right_on is not None:\n1805 |                 raise MergeError(\n1806 |                     'Can only pass argument \"on\" OR \"left_on\" '\n1807 |                     'and \"right_on\", not a combination of both.'\n1808 |                 )\n1809 |             if self.left_index or self.right_index:\n1810 |                 raise MergeError(\n1811 |                     'Can only pass argument \"on\" OR \"left_index\" '\n1812 |                     'and \"right_index\", not a combination of both.'\n1813 |                 )\n1814 |             left_on = right_on = self.on\n1815 |         elif left_on is not None:\n1816 |             if self.left_index:\n1817 |                 raise MergeError(\n1818 |                     'Can only pass argument \"left_on\" OR \"left_index\" not both.'\n1819 |                 )\n1820 |             if not self.right_index and right_on is None:\n1821 |                 raise MergeError('Must pass \"right_on\" OR \"right_index\".')\n1822 |             n = len(left_on)\n1823 |             if self.right_index:\n1824 |                 if len(left_on) != self.right.index.nlevels:\n1825 |                     raise ValueError(\n1826 |                         \"len(left_on) must equal the number \"\n1827 |                         'of levels in the index of \"right\"'\n1828 |                     )\n1829 |                 right_on = [None] * n\n1830 |         elif right_on is not None:\n1831 |             if self.right_index:\n1832 |                 raise MergeError(\n1833 |                     'Can only pass argument \"right_on\" OR \"right_index\" not both.'\n1834 |                 )\n1835 |             if not self.left_index and left_on is None:\n1836 |                 raise MergeError('Must pass \"left_on\" OR \"left_index\".')\n1837 |             n = len(right_on)\n1838 |             if self.left_index:\n1839 |                 if len(right_on) != self.left.index.nlevels:\n1840 |                     raise ValueError(\n1841 |                         \"len(right_on) must equal the number \"\n1842 |                         'of levels in the index of \"left\"'\n1843 |                     )\n1844 |                 left_on = [None] * n\n1845 |         if len(right_on) != len(left_on):\n1846 |             raise ValueError(\"len(right_on) must equal len(left_on)\")\n1847 | \n1848 |         return left_on, right_on\n```\n\nFound function `pandas/core/reshape/merge.py:_AsOfMerge._validate_left_right_on`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2234 | def _validate_left_right_on(self, left_on, right_on):\n2235 |         left_on, right_on = super()._validate_left_right_on(left_on, right_on)\n2236 | \n2237 |         # we only allow on to be a single item for on\n2238 |         if len(left_on) != 1 and not self.left_index:\n2239 |             raise MergeError(\"can only asof on a key for left\")\n2240 | \n2241 |         if len(right_on) != 1 and not self.right_index:\n2242 |             raise MergeError(\"can only asof on a key for right\")\n2243 | \n2244 |         if self.left_index and isinstance(self.left.index, MultiIndex):\n2245 |             raise MergeError(\"left can only have one index\")\n2246 | \n2247 |         if self.right_index and isinstance(self.right.index, MultiIndex):\n2248 |             raise MergeError(\"right can only have one index\")\n2249 | \n2250 |         # set 'by' columns\n2251 |         if self.by is not None:\n2252 |             if self.left_by is not None or self.right_by is not None:\n2253 |                 raise MergeError(\"Can only pass by OR left_by and right_by\")\n2254 |             self.left_by = self.right_by = self.by\n2255 |         if self.left_by is None and self.right_by is not None:\n2256 |             raise MergeError(\"missing left_by\")\n2257 |         if self.left_by is not None and self.right_by is None:\n2258 |             raise MergeError(\"missing right_by\")\n2259 | \n2260 |         # GH#29130 Check that merge keys do not have dtype object\n2261 |         if not self.left_index:\n2262 |             left_on_0 = left_on[0]\n2263 |             if isinstance(left_on_0, _known):\n2264 |                 lo_dtype = left_on_0.dtype\n2265 |             else:\n2266 |                 lo_dtype = (\n2267 |                     self.left._get_label_or_level_values(left_on_0).dtype\n2268 |                     if left_on_0 in self.left.columns\n2269 |                     else self.left.index.get_level_values(left_on_0)\n2270 |                 )\n2271 |         else:\n2272 |             lo_dtype = self.left.index.dtype\n2273 | \n2274 |         if not self.right_index:\n2275 |             right_on_0 = right_on[0]\n2276 |             if isinstance(right_on_0, _known):\n2277 |                 ro_dtype = right_on_0.dtype\n2278 |             else:\n2279 |                 ro_dtype = (\n2280 |                     self.right._get_label_or_level_values(right_on_0).dtype\n2281 |                     if right_on_0 in self.right.columns\n2282 |                     else self.right.index.get_level_values(right_on_0)\n2283 |                 )\n2284 |         else:\n2285 |             ro_dtype = self.right.index.dtype\n2286 | \n2287 |         if (\n2288 |             is_object_dtype(lo_dtype)\n2289 |             or is_object_dtype(ro_dtype)\n2290 |             or is_string_dtype(lo_dtype)\n2291 |             or is_string_dtype(ro_dtype)\n2292 |         ):\n2293 |             raise MergeError(\n2294 |                 f\"Incompatible merge dtype, {lo_dtype!r} and \"\n2295 |                 f\"{ro_dtype!r}, both sides must have numeric dtype\"\n2296 |             )\n2297 | \n2298 |         # add 'by' to our key-list so we can have it in the\n2299 |         # output as a key\n2300 |         if self.left_by is not None:\n2301 |             if not is_list_like(self.left_by):\n2302 |                 self.left_by = [self.left_by]\n2303 |             if not is_list_like(self.right_by):\n2304 |                 self.right_by = [self.right_by]\n2305 | \n2306 |             if len(self.left_by) != len(self.right_by):\n2307 |                 raise MergeError(\"left_by and right_by must be the same length\")\n2308 | \n2309 |             left_on = self.left_by + list(left_on)\n2310 |             right_on = self.right_by + list(right_on)\n2311 | \n2312 |         return left_on, right_on\n```\n"}, {"content": "```\npandas/core/computation/expressions.py\nline: 234\nline: 235\nfunction: evaluate\n\npandas/core/computation/expressions.py\nline: 178\nline: 184\nline: 190\nfunction: _where_numexpr\n\npandas/core/computation/expressions.py\nline: 96\nline: 100\nline: 110\nline: 126\nline: 132\nfunction: _evaluate_numexpr\n\npandas/core/computation/expressions.py\nline: 77\nline: 84\nline: 90\nline: 91\nline: 93\nfunction: _can_use_numexpr\n\npandas/core/reshape/merge.py\nline: 1772\nline: 1797\nline: 1824\nline: 1825\nline: 1826\nline: 1831\nline: 1832\nline: 1835\nline: 1836\nline: 1840\nline: 1841\nline: 1845\nline: 1846\nline: 2234\nline: 2252\nline: 2253\nline: 2256\nline: 2257\nline: 2259\nline: 2261\nline: 2274\nline: 2275\nline: 2279\nline: 2280\nline: 2285\nline: 2286\nline: 2288\nline: 2289\nline: 2290\nline: 2291\nline: 2293\nline: 2294\nline: 2295\nline: 2296\nline: 2301\nline: 2302\nline: 2304\nline: 2305\nline: 2307\nline: 2308\nline: 2309\nline: 2310\nline: 2311\n```\n<finish></finish>", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}], "usage": {"prompt_tokens": 41685, "completion_tokens": 571}, "time": 348.04052209854126}]}}
{"instance_id": "pandas-dev__pandas-60457", "found_files": [["pandas/core/generic.py", "pandas/io/formats/format.py", "pandas/core/frame.py", "pandas/io/formats/csvs.py"]], "found_modules": [["pandas/core/generic.py:NDFrame", "pandas/io/formats/style.py:Styler", "pandas/io/formats/format.py:DataFrameRenderer", "pandas/core/frame.py:DataFrame"]], "found_entities": [["pandas/core/generic.py:NDFrame.to_csv", "pandas/io/formats/style.py:Styler.pipe", "pandas/io/formats/format.py:DataFrameRenderer.to_csv", "pandas/core/frame.py:DataFrame._ixs"]], "raw_output_loc": ["Based on the search results, it seems that the documentation for the `to_csv` method is generated using the `autofunction` directive from the docstring of the `NDFrame.to_csv` method in `pandas/core/generic.py`. The `float_format` parameter is mentioned in the docstring of this method.\n\nHere are the relevant files and lines where the `to_csv` method and `float_format` parameter are documented or implemented:\n\n```\ndoc/source/reference/api/pandas.DataFrame.to_csv.rst\nline: 3\n\npandas/core/generic.py\nfunction: NDFrame.to_csv\nline: 3727\nline: 3733\n\npandas/io/formats/format.py\nfunction: DataFrameRenderer.to_csv\nline: 948\n\npandas/core/frame.py\nfunction: DataFrame.to_csv\nline: 3873\n\npandas/io/formats/csvs.py\nclass: CSVFormatter\nline: 106\n```"], "meta_data": {"repo": "pandas-dev/pandas", "base_commit": "844b3191bd45b95cbaae341048bf7f367f086f2f", "problem_statement": "DOC: Add examples for float_format in to_csv documentation\n### Pandas version checks\r\n\r\n- [X] I have checked that the issue still exists on the latest versions of the docs on `main` [here](https://pandas.pydata.org/docs/dev/)\r\n\r\n\r\n### Location of the documentation\r\n\r\nhttps://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.DataFrame.to_csv.html\r\n\r\n### Documentation problem\r\n\r\nThe float_format parameter in to_csv is explained but lacks examples. Users might struggle to understand how to apply this parameter effectively without concrete examples in the documentation.\r\n\r\n### Suggested fix for documentation\r\n\r\nI suggest adding examples for float_format to make the documentation more beginner-friendly. Examples could include:\r\n\r\n```\r\n# Format floats to two decimal places\r\ndf.to_csv(\"example1.csv\", float_format=\"%.2f\")\r\n\r\n# Use scientific notation\r\ndf.to_csv(\"example2.csv\", float_format=\"{:.2e}\".format)\r\n```\n", "patch": "diff --git a/pandas/core/generic.py b/pandas/core/generic.py\nindex a6be17a654aa7..3a48cc8a66076 100644\n--- a/pandas/core/generic.py\n+++ b/pandas/core/generic.py\n@@ -3878,6 +3878,14 @@ def to_csv(\n         >>> import os  # doctest: +SKIP\n         >>> os.makedirs(\"folder/subfolder\", exist_ok=True)  # doctest: +SKIP\n         >>> df.to_csv(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n+\n+        Format floats to two decimal places:\n+\n+        >>> df.to_csv(\"out1.csv\", float_format=\"%.2f\")  # doctest: +SKIP\n+\n+        Format floats using scientific notation:\n+\n+        >>> df.to_csv(\"out2.csv\", float_format=\"{{:.2e}}\".format)  # doctest: +SKIP\n         \"\"\"\n         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n \n"}, "usage": {"cost($)": "0", "prompt_tokens": 373930, "completion_tokens": 1088}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'pandas-dev' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n#