            default_handler=default_handler,\n345 |             indent=indent,\n346 |         )\n347 | \n348 |         if date_format != \"iso\":\n349 |             msg = (\n350 |                 \"Trying to write with `orient='table'` and \"\n351 |                 f\"`date_format='{date_format}'`. Table Schema requires dates \"\n352 |                 \"to be formatted with `date_format='iso'`\"\n353 |             )\n354 |             raise ValueError(msg)\n355 | \n356 |         self.schema = build_table_schema(obj, index=self.index)\n357 |         if self.index:\n358 |             obj = set_default_names(obj)\n359 | \n360 |         # NotImplemented on a column MultiIndex\n361 |         if obj.ndim == 2 and isinstance(obj.columns, MultiIndex):\n362 |             raise NotImplementedError(\n363 |                 \"orient='table' is not supported for MultiIndex columns\"\n364 |             )\n365 | \n366 |         # TODO: Do this timedelta properly in objToJSON.c See GH #15137\n367 |         if (\n368 |             (obj.ndim == 1)\n369 |             and (obj.name in set(obj.index.names))\n370 |             or len(obj.columns.intersection(obj.index.names))\n371 |         ):\n372 |             msg = \"Overlapping names between the index and columns\"\n373 |             raise ValueError(msg)\n374 | \n375 |         timedeltas = obj.select_dtypes(include=[\"timedelta\"]).columns\n376 |         copied = False\n377 |         if len(timedeltas):\n378 |             obj = obj.copy()\n379 |             copied = True\n380 |             obj[timedeltas] = obj[timedeltas].map(lambda x: x.isoformat())\n381 | \n382 |         # exclude index from obj if index=False\n383 |         if not self.index:\n384 |             self.obj = obj.reset_index(drop=True)\n385 |         else:\n386 |             # Convert PeriodIndex to datetimes before serializing\n387 |             if isinstance(obj.index.dtype, PeriodDtype):\n388 |                 if not copied:\n389 |                     obj = obj.co