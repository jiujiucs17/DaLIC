self.line_,) = ax.plot(self.recall, self.precision, **line_kwargs)\n134 |         info_pos_label = (\n135 |             f\" (Positive label: {self.pos_label})\" if self.pos_label is not None else \"\"\n136 |         )\n137 | \n138 |         xlabel = \"Recall\" + info_pos_label\n139 |         ylabel = \"Precision\" + info_pos_label\n140 |         ax.set(xlabel=xlabel, ylabel=ylabel)\n141 | \n142 |         if \"label\" in line_kwargs:\n143 |             ax.legend(loc=\"lower left\")\n144 | \n145 |         self.ax_ = ax\n146 |         self.figure_ = ax.figure\n147 |         return self\n```\n\nFound function `sklearn/metrics/_plot/roc_curve.py:RocCurveDisplay.plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 78 | def plot(self, ax=None, *, name=None, **kwargs):\n 79 |         \"\"\"Plot visualization\n 80 | \n 81 |         Extra keyword arguments will be passed to matplotlib's ``plot``.\n 82 | \n 83 |         Parameters\n 84 |         ----------\n 85 |         ax : matplotlib axes, default=None\n 86 |             Axes object to plot on. If `None`, a new figure and axes is\n 87 |             created.\n 88 | \n 89 |         name : str, default=None\n 90 |             Name of ROC Curve for labeling. If `None`, use the name of the\n 91 |             estimator.\n 92 | \n 93 |         Returns\n 94 |         -------\n 95 |         display : :class:`~sklearn.metrics.plot.RocCurveDisplay`\n 96 |             Object that stores computed values.\n 97 |         \"\"\"\n 98 |         check_matplotlib_support(\"RocCurveDisplay.plot\")\n 99 | \n100 |         name = self.estimator_name if name is None else name\n101 | \n102 |         line_kwargs = {}\n103 |         if self.roc_auc is not None and name is not None:\n104 |             line_kwargs[\"label\"] = f\"{name} (AUC = {self.roc_auc:0.2f})\"\n105 |         elif self.roc_auc is not None:\n106 |             line_kwargs[\"label\"] = f\"AUC = {self.roc_auc:0.2f}\"\n107 |         elif name is not None:\n108 |             line_kwargs[\"label\"] = name\n109 | \n110 |         line_kwargs.update(**kwargs)\n111 | \n112 |         import matplotlib.pyplot as plt\n113 | \n114 |         if ax is None:\n115 |             fig, ax = plt.subplots()\n116 | \n117 |         (self.line_,) = ax.plot(self.fpr, self.tpr, **line_kwargs)\n118 |         info_pos_label = (\n119 |             f\" (Positive label: {self.pos_label})\" if self.pos_label is not None else \"\"\n120 |         )\n121 | \n122 |         xlabel = \"False Positive Rate\" + info_pos_label\n123 |         ylabel = \"True Positive Rate\" + info_pos_label\n124 |         ax.set(xlabel=xlabel, ylabel=ylabel)\n125 | \n126 |         if \"label\" in line_kwargs:\n127 |             ax.legend(loc=\"lower right\")\n128 | \n129 |         self.ax_ = ax\n130 |         self.figure_ = ax.figure\n131 |         return self\n```\n\n\n\n##Searching for term \"plot\"...\n### Search Result:\nFound function `sklearn/metrics/_plot/confusion_matrix.py:ConfusionMatrixDisplay.plot`.\nSource: Match found for entity name `plot`.\nHint: Search `sklearn/metrics/_plot/confusion_matrix.py:ConfusionMatrixDisplay.plot` for the full content if needed.\n\n\n\n##Searching for term \"plotting\"...\n### Search Result:\nFound function `sklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay._plot_ice_lines`.\nSource: Retrieved code content using keyword search (bm25).\n```\n615 | def _plot_ice_lines(\n616 |         self,\n617 |         preds,\n618 |         feature_values,\n619 |         n_ice_to_plot,\n620 |         ax,\n621 |         pd_plot_idx,\n622 |         n_total_lines_by_plot,\n623 |         individual_line_kw,\n624 |     ):\n625 |         \"\"\"Plot the ICE lines.\n626 | \n627 |         Parameters\n628 |         ----------\n629 |         preds : ndarray of shape \\\n630 |                 (n_instances, n_grid_points)\n631 |             The predictions computed for all points of `feature_values` for a\n632 |             given feature for all samples in `X`.\n633 |         feature_values : ndarray of shape (n_grid_points,)\n634 |             The feature values for which the predictions have been computed.\n635 |         n_ice_to_plot : int\n636 |             The number of ICE lines to plot.\n637 |         ax : Matplotlib axes\n638 |             The axis on which to plot the ICE lines.\n639 |         pd_plot_idx : int\n640 |             The sequential index of the plot. It will be unraveled to find the\n641 |             matching 2D position in the grid layout.\n642 |         n_total_lines_by_plot : int\n643 |             The total number of lines expected to be plot on the axis.\n644 |         individual_line_kw : dict\n645 |             Dict with keywords passed when plotting the ICE lines.\n646 |         \"\"\"\n647 |         rng = check_random_state(self.random_state)\n648 |         # subsample ice\n649 |         ice_lines_idx = rng.choice(\n650 |             preds.shape[0],\n651 |             n_ice_to_plot,\n652 |             replace=False,\n653 |         )\n654 |         ice_lines_subsampled = preds[ice_lines_idx, :]\n655 |         # plot the subsampled ice\n656 |         for ice_idx, ice in enumerate(ice_lines_subsampled):\n657 |             line_idx = np.unravel_index(\n658 |                 pd_plot_idx * n_total_lines_by_plot + ice_idx, self.lines_.shape\n659 |             )\n660 |             self.lines_[line_idx] = ax.plot(\n661 |                 feature_values, ice.ravel(), **individual_line_kw\n662 |             )[0]\n```\n\nFound function `sklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay._plot_average_dependence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n664 | def _plot_average_dependence(\n665 |         self,\n666 |         avg_preds,\n667 |         feature_values,\n668 |         ax,\n669 |         pd_line_idx,\n670 |         line_kw,\n671 |     ):\n672 |         \"\"\"Plot the average partial dependence.\n673 | \n674 |         Parameters\n675 |         ----------\n676 |         avg_preds : ndarray of shape (n_grid_points,)\n677 |             The average predictions for all points of `feature_values` for a\n678 |             given feature for all samples in `X`.\n679 |         feature_values : ndarray of shape (n_grid_points,)\n680 |             The feature values for which the predictions have been computed.\n681 |         ax : Matplotlib axes\n682 |             The axis on which to plot the ICE lines.\n683 |         pd_line_idx : int\n684 |             The sequential index of the plot. It will be unraveled to find the\n685 |             matching 2D position in the grid layout.\n686 |         line_kw : dict\n687 |             Dict with keywords passed when plotting the PD plot.\n688 |         \"\"\"\n689 |         line_idx = np.unravel_index(pd_line_idx, self.lines_.shape)\n690 |         self.lines_[line_idx] = ax.plot(\n691 |             feature_values,\n692 |             avg_preds,\n693 |             **line_kw,\n694 |         )[0]\n```\n"}, {"content": "Based on the search results, the plotting functionality seems to be centralized in the `metrics/_plot` and `inspection/_plot` directories. We'll focus on the `metrics/_plot` directory since the calibration curve is a metric related to model performance. Specifically, we'll search for a base class or module that handles plotting in a similar manner to the existing plotting classes.\n\nLet's search for `BaseDisplay` in the `metrics/_plot` directory to see if there's a common base class for these plots.\n\n<function=search_code_snippets>\n<parameter=search_terms>['BaseDisplay']</parameter>\n<parameter=file_path_or_pattern>sklearn/metrics/_plot/**/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/utils/validation.py:_get_feature_names\nsklearn/datasets/_base.py:load_digits\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_diabetes\nsklearn/datasets/_base.py:load_linnerud\nsklearn/datasets/_base.py:load_digits\nsklearn/datasets/_base.py:load_boston\nsklearn/datasets/_california_housing.py:fetch_california_housing\nsklearn/datasets/_base.py:load_sample_image\nsklearn/datasets/_base.py:load_linnerud\nNo files found for file pattern 'sklearn/metrics/_plot/**/*.py'. Will search all files.\n...\n##Searching for term \"BaseDisplay\"...\n### Search Result:\nFound class `sklearn/base.py:BaseEstimator`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass BaseEstimator:\n\n    @classmethod\n    def _get_param_names(cls):\n...\n    def get_params(self, deep=True):\n...\n    def set_params(self, **params):\n...\n    def __repr__(self, N_CHAR_MAX=700):\n...\n    def __getstate__(self):\n...\n    def __setstate__(self, state):\n...\n    def _more_tags(self):\n...\n    def _get_tags(self):\n...\n    def _check_n_features(self, X, reset):\n...\n    def _check_feature_names(self, X, *, reset):\n...\n    def _validate_data(\n        self,\n        X=\"no_validation\",\n        y=\"no_validation\",\n        reset=True,\n        validate_separately=False,\n        **check_params,\n    ):\n...\n    @property\n    def _repr_html_(self):\n...\n    def _repr_html_inner(self):\n...\n    def _repr_mimebundle_(self, **kwargs):\n\n```\nHint: Search `sklearn/base.py:BaseEstimator` to get the full content if needed.\n\nFound function `sklearn/datasets/_base.py:load_digits`.\nSource: Retrieved code content using keyword search (bm25).\n```\n783 | def load_digits(*, n_class=10, return_X_y=False, as_frame=False):\n784 |     \"\"\"Load and return the digits dataset (classification).\n785 | \n786 |     Each datapoint is a 8x8 image of a digit.\n787 | \n788 |     =================   ==============\n789 |     Classes                         10\n790 |     Samples per class             ~180\n791 |     Samples total                 1797\n792 |     Dimensionality                  64\n793 |     Features             integers 0-16\n794 |     =================   ==============\n795 | \n796 |     Read more in the :ref:`User Guide <digits_dataset>`.\n797 | \n798 |     Parameters\n799 |     ----------\n800 |     n_class : int, default=10\n801 |         The number of classes to return. Between 0 and 10.\n802 | \n803 |     return_X_y : bool, default=False\n804 |         If True, returns ``(data, target)`` instead of a Bunch object.\n805 |         See below for more information about the `data` and `target` object.\n806 | \n807 |         .. versionadded:: 0.18\n808 | \n809 |     as_frame : bool, default=False\n810 |         If True, the data is a pandas DataFrame including columns with\n811 |         appropriate dtypes (numeric). The target is\n812 |         a pandas DataFrame or Series depending on the number of target columns.\n813 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n814 |         DataFrames or Series as described below.\n815 | \n816 |         .. versionadded:: 0.23\n817 | \n818 |     Returns\n819 |     -------\n820 |     data : :class:`~sklearn.utils.Bunch`\n821 |         Dictionary-like object, with the following attributes.\n822 | \n823 |         data : {ndarray, dataframe} of shape (1797, 64)\n824 |             The flattened data matrix. If `as_frame=True`, `data` will be\n825 |             a pandas DataFrame.\n826 |         target: {ndarray, Series} of shape (1797,)\n827 |             The classification target. If `as_frame=True`, `target` will be\n828 |             a pandas Series.\n829 |         feature_names: list\n830 |             The names of the dataset columns.\n831 |         target_names: list\n832 |             The names of target classes.\n833 | \n834 |             .. versionadded:: 0.20\n835 | \n836 |         frame: DataFrame of shape (1797, 65)\n837 |             Only present when `as_frame=True`. DataFrame with `data` and\n838 |             `target`.\n839 | \n840 |             .. versionadded:: 0.23\n841 |         images: {ndarray} of shape (1797, 8, 8)\n842 |             The raw image data.\n843 |         DESCR: str\n844 |             The full description of the dataset.\n845 | \n846 |     (data, target) : tuple if ``return_X_y`` is True\n847 | \n848 |         .. versionadded:: 0.18\n849 | \n850 |     This is a copy of the test set of the UCI ML hand-written digits datasets\n851 |     https://archive.ics.uci.edu/ml/datasets/Optical+Recognition+of+Handwritten+Digits\n852 | \n853 |     Examples\n854 |     --------\n855 |     To load the data and visualize the images::\n856 | \n857 |         >>> from sklearn.datasets import load_digits\n858 |         >>> digits = load_digits()\n859 |         >>> print(digits.data.shape)\n860 |         (1797, 64)\n861 |         >>> import matplotlib.pyplot as plt\n862 |         >>> plt.gray()\n863 |         >>> plt.matshow(digits.images[0])\n864 |         <...>\n865 |         >>> plt.show()\n866 |     \"\"\"\n867 | \n868 |     data, fdescr = load_gzip_compressed_csv_data(\n869 |         data_file_name=\"digits.csv.gz\", descr_file_name=\"digits.rst\", delimiter=\",\"\n870 |     )\n871 | \n872 |     target = data[:, -1].astype(int, copy=False)\n873 |     flat_data = data[:, :-1]\n874 |     images = flat_data.view()\n875 |     images.shape = (-1, 8, 8)\n876 | \n877 |     if n_class < 10:\n878 |         idx = target < n_class\n879 |         flat_data, target = flat_data[idx], target[idx]\n880 |         images = images[idx]\n881 | \n882 |     feature_names = [\n883 |         \"pixel_{}_{}\".format(row_idx, col_idx)\n884 |         for row_idx in range(8)\n885 |         for col_idx in range(8)\n886 |     ]\n887 | \n888 |     frame = None\n889 |     target_columns = [\n890 |         \"target\",\n891 |     ]\n892 |     if as_frame:\n893 |         frame, flat_data, target = _convert_data_dataframe(\n894 |             \"load_digits\", flat_data, target, feature_names, target_columns\n895 |         )\n896 | \n897 |     if return_X_y:\n898 |         return flat_data, target\n899 | \n900 |     return Bunch(\n901 |         data=flat_data,\n902 |         target=target,\n903 |         frame=frame,\n904 |         feature_names=feature_names,\n905 |         target_names=np.arange(10),\n906 |         images=images,\n907 |         DESCR=fdescr,\n908 |     )\n```\n\nFound function `sklearn/datasets/_base.py:load_linnerud`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1008 | def load_linnerud(*, return_X_y=False, as_frame=False):\n1009 |     \"\"\"Load and return the physical excercise linnerud dataset.\n1010 | \n1011 |     This dataset is suitable for multi-ouput regression tasks.\n1012 | \n1013 |     ==============   ============================\n1014 |     Samples total    20\n1015 |     Dimensionality   3 (for both data and target)\n1016 |     Features         integer\n1017 |     Targets          integer\n1018 |     ==============   ============================\n1019 | \n1020 |     Read more in the :ref:`User Guide <linnerrud_dataset>`.\n1021 | \n1022 |     Parameters\n1023 |     ----------\n1024 |     return_X_y : bool, default=False\n1025 |         If True, returns ``(data, target)`` instead of a Bunch object.\n1026 |         See below for more information about the `data` and `target` object.\n1027 | \n1028 |         .. versionadded:: 0.18\n1029 | \n1030 |     as_frame : bool, default=False\n1031 |         If True, the data is a pandas DataFrame including columns with\n1032 |         appropriate dtypes (numeric, string or categorical). The target is\n1033 |         a pandas DataFrame or Series depending on the number of target columns.\n1034 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n1035 |         DataFrames or Series as described below.\n1036 | \n1037 |         .. versionadded:: 0.23\n1038 | \n1039 |     Returns\n1040 |     -------\n1041 |     data : :class:`~sklearn.utils.Bunch`\n1042 |         Dictionary-like object, with the following attributes.\n1043 | \n1044 |         data : {ndarray, dataframe} of shape (20, 3)\n1045 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n1046 |             DataFrame.\n1047 |         target: {ndarray, dataframe} of shape (20, 3)\n1048 |             The regression targets. If `as_frame=True`, `target` will be\n1049 |             a pandas DataFrame.\n1050 |         feature_names: list\n1051 |             The names of the dataset columns.\n1052 |         target_names: list\n1053 |             The names of the target columns.\n1054 |         frame: DataFrame of shape (20, 6)\n1055 |             Only present when `as_frame=True`. DataFrame with `data` and\n1056 |             `target`.\n1057 | \n1058 |             .. versionadded:: 0.23\n1059 |         DESCR: str\n1060 |             The full description of the dataset.\n1061 |         data_filename: str\n1062 |             The path to the location of the data.\n1063 |         target_filename: str\n1064 |             The path to the location of the target.\n1065 | \n1066 |             .. versionadded:: 0.20\n1067 | \n1068 |     (data, target) : tuple if ``return_X_y`` is True\n1069 | \n1070 |         .. versionadded:: 0.18\n1071 |     \"\"\"\n1072 |     data_filename = \"linnerud_exercise.csv\"\n1073 |     target_filename = \"linnerud_physiological.csv\"\n1074 | \n1075 |     # Read header and data\n1076 |     with resources.open_text(DATA_MODULE, data_filename) as f:\n1077 |         header_exercise = f.readline().split()\n1078 |         f.seek(0)  # reset file obj\n1079 |         data_exercise = np.loadtxt(f, skiprows=1)\n1080 | \n1081 |     with resources.open_text(DATA_MODULE, target_filename) as f:\n1082 |         header_physiological = f.readline().split()\n1083 |         f.seek(0)  # reset file obj\n1084 |         data_physiological = np.loadtxt(f, skiprows=1)\n1085 | \n1086 |     fdescr = load_descr(\"linnerud.rst\")\n1087 | \n1088 |     frame = None\n1089 |     if as_frame:\n1090 |         (frame, data_exercise, data_physiological) = _convert_data_dataframe(\n1091 |             \"load_linnerud\",\n1092 |             data_exercise,\n1093 |             data_physiological,\n1094 |             header_exercise,\n1095 |             header_physiological,\n1096 |         )\n1097 |     if return_X_y:\n1098 |         return data_exercise, data_physiological\n1099 | \n1100 |     return Bunch(\n1101 |         data=data_exercise,\n1102 |         feature_names=header_exercise,\n1103 |         target=data_physiological,\n1104 |         target_names=header_physiological,\n1105 |         frame=frame,\n1106 |         DESCR=fdescr,\n1107 |         data_filename=data_filename,\n1108 |         target_filename=target_filename,\n1109 |         data_module=DATA_MODULE,\n1110 |     )\n```\n\nFound function `sklearn/utils/validation.py:_get_feature_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1595 | def _get_feature_names(X):\n1596 |     \"\"\"Get feature names from X.\n1597 | \n1598 |     Support for other array containers should place its implementation here.\n1599 | \n1600 |     Parameters\n1601 |     ----------\n1602 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n1603 |         Array container to extract feature names.\n1604 | \n1605 |         - pandas dataframe : The columns will be considered to be feature\n1606 |           names. If the dataframe contains non-string feature names, `None` is\n1607 |           returned.\n1608 |         - All other array containers will return `None`.\n1609 | \n1610 |     Returns\n1611 |     -------\n1612 |     names: ndarray or None\n1613 |         Feature names of `X`. Unrecognized array containers will return `None`.\n1614 |     \"\"\"\n1615 |     feature_names = None\n1616 | \n1617 |     # extract feature names for support array containers\n1618 |     if hasattr(X, \"columns\"):\n1619 |         feature_names = np.asarray(X.columns)\n1620 | \n1621 |     if feature_names is None or len(feature_names) == 0:\n1622 |         return\n1623 | \n1624 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n1625 | \n1626 |     # Warn when types are mixed.\n1627 |     # ints and strings do not warn\n1628 |     if len(types) > 1 or not (types[0].startswith(\"int\") or types[0] == \"str\"):\n1629 |         # TODO: Convert to an error in 1.2\n1630 |         warnings.warn(\n1631 |             \"Feature names only support names that are all strings. \"\n1632 |             f\"Got feature names with dtypes: {types}. An error will be raised \"\n1633 |             \"in 1.2.\",\n1634 |             FutureWarning,\n1635 |         )\n1636 |         return\n1637 | \n1638 |     # Only feature names of all strings are supported\n1639 |     if types[0] == \"str\":\n1640 |         return feature_names\n```\n\nFound function `sklearn/datasets/_base.py:load_diabetes`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 911 | def load_diabetes(*, return_X_y=False, as_frame=False):\n 912 |     \"\"\"Load and return the diabetes dataset (regression).\n 913 | \n 914 |     ==============   ==================\n 915 |     Samples total    442\n 916 |     Dimensionality   10\n 917 |     Features         real, -.2 < x < .2\n 918 |     Targets          integer 25 - 346\n 919 |     ==============   ==================\n 920 | \n 921 |     .. note::\n 922 |        The meaning of each feature (i.e. `feature_names`) might be unclear\n 923 |        (especially for `ltg`) as the documentation of the original dataset is\n 924 |        not explicit. We provide information that seems correct in regard with\n 925 |        the scientific literature in this field of research.\n 926 | \n 927 |     Read more in the :ref:`User Guide <diabetes_dataset>`.\n 928 | \n 929 |     Parameters\n 930 |     ----------\n 931 |     return_X_y : bool, default=False.\n 932 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 933 |         See below for more information about the `data` and `target` object.\n 934 | \n 935 |         .. versionadded:: 0.18\n 936 | \n 937 |     as_frame : bool, default=False\n 938 |         If True, the data is a pandas DataFrame including columns with\n 939 |         appropriate dtypes (numeric). The target is\n 940 |         a pandas DataFrame or Series depending on the number of target columns.\n 941 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 942 |         DataFrames or Series as described below.\n 943 | \n 944 |         .. versionadded:: 0.23\n 945 | \n 946 |     Returns\n 947 |     -------\n 948 |     data : :class:`~sklearn.utils.Bunch`\n 949 |         Dictionary-like object, with the following attributes.\n 950 | \n 951 |         data : {ndarray, dataframe} of shape (442, 10)\n 952 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 953 |             DataFrame.\n 954 |         target: {ndarray, Series} of shape (442,)\n 955 |             The regression target. If `as_frame=True`, `target` will be\n 956 |             a pandas Series.\n 957 |         feature_names: list\n 958 |             The names of the dataset columns.\n 959 |         frame: DataFrame of shape (442, 11)\n 960 |             Only present when `as_frame=True`. DataFrame with `data` and\n 961 |             `target`.\n 962 | \n 963 |             .. versionadded:: 0.23\n 964 |         DESCR: str\n 965 |             The full description of the dataset.\n 966 |         data_filename: str\n 967 |             The path to the location of the data.\n 968 |         target_filename: str\n 969 |             The path to the location of the target.\n 970 | \n 971 |     (data, target) : tuple if ``return_X_y`` is True\n 972 | \n 973 |         .. versionadded:: 0.18\n 974 |     \"\"\"\n 975 |     data_filename = \"diabetes_data.csv.gz\"\n 976 |     target_filename = \"diabetes_target.csv.gz\"\n 977 |     data = load_gzip_compressed_csv_data(data_filename)\n 978 |     target = load_gzip_compressed_csv_data(target_filename)\n 979 | \n 980 |     fdescr = load_descr(\"diabetes.rst\")\n 981 | \n 982 |     feature_names = [\"age\", \"sex\", \"bmi\", \"bp\", \"s1\", \"s2\", \"s3\", \"s4\", \"s5\", \"s6\"]\n 983 | \n 984 |     frame = None\n 985 |     target_columns = [\n 986 |         \"target\",\n 987 |     ]\n 988 |     if as_frame:\n 989 |         frame, data, target = _convert_data_dataframe(\n 990 |             \"load_diabetes\", data, target, feature_names, target_columns\n 991 |         )\n 992 | \n 993 |     if return_X_y:\n 994 |         return data, target\n 995 | \n 996 |     return Bunch(\n 997 |         data=data,\n 998 |         target=target,\n 999 |         frame=frame,\n1000 |         DESCR=fdescr,\n1001 |         feature_names=feature_names,\n1002 |         data_filename=data_filename,\n1003 |         target_filename=target_filename,\n1004 |         data_module=DATA_MODULE,\n1005 |     )\n```\n\nFound file `sklearn/metrics/_base.py`.\nFound file `sklearn/base.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n"}, {"content": "It appears there was an error in the search pattern. Let's retry the search specifically for `BaseDisplay` in the `metrics/_plot` directory.\n\n<function=search_code_snippets>\n<parameter=search_terms>['BaseDisplay']</parameter>\n<parameter=file_path_or_pattern>sklearn/metrics/_plot/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"BaseDisplay\"...\n### Search Result:\nFound class `sklearn/base.py:BaseEstimator`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass BaseEstimator:\n\n    @classmethod\n    d