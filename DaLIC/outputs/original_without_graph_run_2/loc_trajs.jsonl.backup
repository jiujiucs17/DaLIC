              random_state=0)\n 66 |     >>> clf = SVC(random_state=0)\n 67 |     >>> clf.fit(X_train, y_train)\n 68 |     SVC(random_state=0)\n 69 |     >>> predictions = clf.predict(X_test)\n 70 |     >>> cm = confusion_matrix(y_test, predictions, labels=clf.classes_)\n 71 |     >>> disp = ConfusionMatrixDisplay(confusion_matrix=cm,\n 72 |     ...                               display_labels=clf.classes_)\n 73 |     >>> disp.plot()\n 74 |     <...>\n 75 |     >>> plt.show()\n 76 |     \"\"\"\n 77 | \n 78 |     def __init__(self, confusion_matrix, *, display_labels=None):\n 79 |         self.confusion_matrix = confusion_matrix\n 80 |         self.display_labels = display_labels\n 81 | \n 82 |     def plot(\n 83 |         self,\n 84 |         *,\n 85 |         include_values=True,\n 86 |         cmap=\"viridis\",\n 87 |         xticks_rotation=\"horizontal\",\n 88 |         values_format=None,\n 89 |         ax=None,\n 90 |         colorbar=True,\n 91 |     ):\n 92 |         \"\"\"Plot visualization.\n 93 | \n 94 |         Parameters\n 95 |         ----------\n 96 |         include_values : bool, default=True\n 97 |             Includes values in confusion matrix.\n 98 | \n 99 |         cmap : str or matplotlib Colormap, default='viridis'\n100 |             Colormap recognized by matplotlib.\n101 | \n102 |         xticks_rotation : {'vertical', 'horizontal'} or float, \\\n103 |                          default='horizontal'\n104 |             Rotation of xtick labels.\n105 | \n106 |         values_format : str, default=None\n107 |             Format specification for values in confusion matrix. If `None`,\n108 |             the format specification is 'd' or '.2g' whichever is shorter.\n109 | \n110 |         ax : matplotlib axes, default=None\n111 |             Axes object to plot on. If `None`, a new figure and axes is\n112 |             created.\n113 | \n114 |         colorbar : bool, default=True\n115 |             Whether or not to add a colorbar to the plot.\n11