37 |         return False\n138 | \n139 |     def setup_cache(self):\n140 |         \"\"\"Pickle a fitted estimator for all combinations of parameters\"\"\"\n141 |         # This is run once per benchmark class.\n142 | \n143 |         clear_tmp()\n144 | \n145 |         param_grid = list(itertools.product(*self.params))\n146 | \n147 |         for params in param_grid:\n148 |             if self.skip(params):\n149 |                 continue\n150 | \n151 |             estimator = self.make_estimator(params)\n152 |             X, _, y, _ = self.make_data(params)\n153 | \n154 |             estimator.fit(X, y)\n155 | \n156 |             est_path = get_estimator_path(\n157 |                 self, Benchmark.save_dir, params, Benchmark.save_estimators\n158 |             )\n159 |             with est_path.open(mode=\"wb\") as f:\n160 |                 pickle.dump(estimator, f)\n161 | \n162 |     def setup(self, *params):\n163 |         \"\"\"Generate dataset and load the fitted estimator\"\"\"\n164 |         # This is run once per combination of parameters and per repeat so we\n165 |         # need to avoid doing expensive operations there.\n166 | \n167 |         if self.skip(params):\n168 |             raise NotImplementedError\n169 | \n170 |         self.X, self.X_val, self.y, self.y_val = self.make_data(params)\n171 | \n172 |         est_path = get_estimator_path(\n173 |             self, Benchmark.save_dir, params, Benchmark.save_estimators\n174 |         )\n175 |         with est_path.open(mode=\"rb\") as f:\n176 |             self.estimator = pickle.load(f)\n177 | \n178 |         self.make_scorers()\n179 | \n180 |     def time_fit(self, *args):\n181 |         self.estimator.fit(self.X, self.y)\n182 | \n183 |     def peakmem_fit(self, *args):\n184 |         self.estimator.fit(self.X, self.y)\n185 | \n186 |     def track_train_score(self, *args):\n187 |         if hasattr(self.estimator, \"predict\"):\n188 |             y_pred = self.estimator.predict(self.X)\n189 |         else:\n190 |             y_pred = None\n191 |         return float(self.train_scorer(self.y, y_pred))\n192 | \n193 |     def track_test_score(self, *args):\n194 |         if hasattr(self.estimator, \"predict\"):\n195 |             y_val_pred = self.estimator.predict(self.X_val)\n196 |         else:\n197 |             y_val_pred = None\n198 |         return float(self.test_scorer(self.y_val, y_val_pred))\n```\n\n\n\n##Searching for term \"_get_tags\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/__init__.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Utilities to load popular datasets and artificial data generators.\"\"\"\n  2 | \n  3 | # Authors: The scikit-learn developers\n  4 | # SPDX-License-Identifier: BSD-3-Clause\n  5 | \n  6 | import textwrap\n  7 | \n  8 | from ._base import (\n  9 |     clear_data_home,\n 10 |     fetch_file,\n 11 |     get_data_home,\n 12 |     load_breast_cancer,\n 13 |     load_diabetes,\n 14 |     load_digits,\n 15 |     load_files,\n 16 |     load_iris,\n 17 |     load_linnerud,\n 18 |     load_sample_image,\n 19 |     load_sample_images,\n 20 |     load_wine,\n 21 | )\n 22 | from ._california_housing import fetch_california_housing\n 23 | from ._covtype import fetch_covtype\n 24 | from ._kddcup99 import fetch_kddcup99\n 25 | from ._lfw import fetch_lfw_pairs, fetch_lfw_people\n 26 | from ._olivetti_faces import fetch_olivetti_faces\n 27 | from ._openml import fetch_openml\n 28 | from ._rcv1 import fetch_rcv1\n 29 | from ._samples_generator import (\n 30 |     make_biclusters,\n 31 |     make_blobs,\n 32 |     make_checkerboard,\n 33 |     make_circles,\n 34 |     make_classification,\n 35 |     make_friedman1,\n 36 |     make_friedman2,\n 37 |     make_friedman3,\n 38 |     make_gaussian_quantiles,\n 39 |     make_hastie_10_2,\n 40 |     make_low_rank_matrix,\n 41 |     make_moons,\n 42 |     make_multilabel_classification,\n 43 |     make_regression,\n 44 |     make_s_cur