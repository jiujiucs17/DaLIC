25).\n```\n541 | class PeriodProperties(Properties):\n542 |     \"\"\"\n543 |     Accessor object for datetimelike properties of the Series values.\n544 | \n545 |     Returns a Series indexed like the original Series.\n546 |     Raises TypeError if the Series does not contain datetimelike values.\n547 | \n548 |     Examples\n549 |     --------\n550 |     >>> seconds_series = pd.Series(\n551 |     ...     pd.period_range(\n552 |     ...         start=\"2000-01-01 00:00:00\", end=\"2000-01-01 00:00:03\", freq=\"s\"\n553 |     ...     )\n554 |     ... )\n555 |     >>> seconds_series\n556 |     0    2000-01-01 00:00:00\n557 |     1    2000-01-01 00:00:01\n558 |     2    2000-01-01 00:00:02\n559 |     3    2000-01-01 00:00:03\n560 |     dtype: period[s]\n561 |     >>> seconds_series.dt.second\n562 |     0    0\n563 |     1    1\n564 |     2    2\n565 |     3    3\n566 |     dtype: int64\n567 | \n568 |     >>> hours_series = pd.Series(\n569 |     ...     pd.period_range(start=\"2000-01-01 00:00\", end=\"2000-01-01 03:00\", freq=\"h\")\n570 |     ... )\n571 |     >>> hours_series\n572 |     0    2000-01-01 00:00\n573 |     1    2000-01-01 01:00\n574 |     2    2000-01-01 02:00\n575 |     3    2000-01-01 03:00\n576 |     dtype: period[h]\n577 |     >>> hours_series.dt.hour\n578 |     0    0\n579 |     1    1\n580 |     2    2\n581 |     3    3\n582 |     dtype: int64\n583 | \n584 |     >>> quarters_series = pd.Series(\n585 |     ...     pd.period_range(start=\"2000-01-01\", end=\"2000-12-31\", freq=\"Q-DEC\")\n586 |     ... )\n587 |     >>> quarters_series\n588 |     0    2000Q1\n589 |     1    2000Q2\n590 |     2    2000Q3\n591 |     3    2000Q4\n592 |     dtype: period[Q-DEC]\n593 |     >>> quarters_series.dt.quarter\n594 |     0    1\n595 |     1    2\n596 |     2    3\n597 |     3    4\n598 |     dtype: int64\n599 |     \"\"\"\n```\n\nFound class `pandas/core/indexes/accessors.py:CombinedDatetimelikeProperties`.\nSource: Retrieved code content using keyword search (bm25).\n```\n602 | class CombinedDatetimelikeProperties(\n603 |     DatetimeProperties, TimedeltaProperties, PeriodProperties\n604 | ):\n605 |     \"\"\"\n606 |     Accessor object for Series values' datetime-like, timedelta and period properties.\n607 | \n608 |     See Also\n609 |     --------\n610 |     DatetimeIndex : Index of datetime64 data.\n611 | \n612 |     Examples\n613 |     --------\n614 |     >>> dates = pd.Series(\n615 |     ...     [\"2024-01-01\", \"2024-01-15\", \"2024-02-5\"], dtype=\"datetime64[ns]\"\n616 |     ... )\n617 |     >>> dates.dt.day\n618 |     0     1\n619 |     1    15\n620 |     2     5\n621 |     dtype: int32\n622 |     >>> dates.dt.month\n623 |     0    1\n624 |     1    1\n625 |     2    2\n626 |     dtype: int32\n627 | \n628 |     >>> dates = pd.Series(\n629 |     ...     [\"2024-01-01\", \"2024-01-15\", \"2024-02-5\"], dtype=\"datetime64[ns, UTC]\"\n630 |     ... )\n631 |     >>> dates.dt.day\n632 |     0     1\n633 |     1    15\n634 |     2     5\n635 |     dtype: int32\n636 |     >>> dates.dt.month\n637 |     0    1\n638 |     1    1\n639 |     2    2\n640 |     dtype: int32\n641 |     \"\"\"\n642 | \n643 |     def __new__(cls, data: Series):  # pyright: ignore[reportInconsistentConstructor]\n644 |         # CombinedDatetimelikeProperties isn't really instantiated. Instead\n645 |         # we need to choose which parent (datetime or timedelta) is\n646 |         # appropriate. Since we're checking the dtypes anyway, we'll just\n647 |         # do all the validation here.\n648 | \n649 |         if not isinstance(data, ABCSeries):\n650 |             raise TypeError(\n651 |                 f\"cannot convert an object of type {type(data)} to a datetimelike index\"\n652 |             )\n653 | \n654 |         orig = data if isinstance(data.dtype, CategoricalDtype) else None\n655 |         if orig is not None:\n656 |             data = data._constructor(\n657 |                 orig.array,\n658 |                 name=orig.name,\n659 |                 copy=False,\n660 |                 dtype=orig._values.categories.dtype,\n661 |                 index=orig.index,\n662 |             )\n663 | \n664 |         if isinstance(data.dtype, ArrowDtype) and data.dtype.kind in \"Mm\":\n665 |             return ArrowTemporalProperties(data, orig)\n666 |         if lib.is_np_dtype(data.dtype, \"M\"):\n667 |             return DatetimeProperties(data, orig)\n668 |         elif isinstance(data.dtype, DatetimeTZDtype):\n669 |             return DatetimeProperties(data, orig)\n670 |         elif lib.is_np_dtype(data.dtype, \"m\"):\n671 |             return TimedeltaProperties(data, orig)\n672 |         elif isinstance(data.dtype, PeriodDtype):\n673 |             return PeriodProperties(data, orig)\n674 | \n675 |         raise AttributeError(\"Can only use .dt accessor with datetimelike values\")\n```\n\nFound function `pandas/core/series.py:Series.to_period`.\nSource: Retrieved code content using keyword search (bm25).\n```\n5719 | def to_period(\n5720 |         self,\n5721 |         freq: str | None = None,\n5722 |         copy: bool | lib.NoDefault = lib.no_default,\n5723 |     ) -> Series:\n5724 |         \"\"\"\n5725 |         Convert Series from DatetimeIndex to PeriodIndex.\n5726 | \n5727 |         Parameters\n5728 |         ----------\n5729 |         freq : str, default None\n5730 |             Frequency associated with the PeriodIndex.\n5731 |         copy : bool, default False\n5732 |             Whether or not to return a copy.\n5733 | \n5734 |             .. note::\n5735 |                 The `copy` keyword will change behavior in pandas 3.0.\n5736 |                 `Copy-on-Write\n5737 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n5738 |                 will be enabled by default, which means that all methods with a\n5739 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n5740 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n5741 |                 future version of pandas.\n5742 | \n5743 |                 You can already get the future behavior and improvements through\n5744 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n5745 | \n5746 |             .. deprecated:: 3.0.0\n5747 | \n5748 |         Returns\n5749 |         -------\n5750 |         Series\n5751 |             Series with index converted to PeriodIndex.\n5752 | \n5753 |         See Also\n5754 |         --------\n5755 |         DataFrame.to_period: Equivalent method for DataFrame.\n5756 |         Series.dt.to_period: Convert DateTime column values.\n5757 | \n5758 |         Examples\n5759 |         --------\n5760 |         >>> idx = pd.DatetimeIndex([\"2023\", \"2024\", \"2025\"])\n5761 |         >>> s = pd.Series([1, 2, 3], index=idx)\n5762 |         >>> s = s.to_period()\n5763 |         >>> s\n5764 |         2023    1\n5765 |         2024    2\n5766 |         2025    3\n5767 |         Freq: Y-DEC, dtype: int64\n5768 | \n5769 |         Viewing the index\n5770 | \n5771 |         >>> s.index\n5772 |         PeriodIndex(['2023', '2024', '2025'], dtype='period[Y-DEC]')\n5773 |         \"\"\"\n5774 |         self._check_copy_deprecation(copy)\n5775 |         if not isinstance(self.index, DatetimeIndex):\n5776 |             raise TypeError(f\"unsupported Type {type(self.index).__name__}\")\n5777 | \n5778 |         new_obj = self.copy(deep=False)\n5779 |         new_index = self.index.to_period(freq=freq)\n5780 |         setattr(new_obj, \"index\", new_index)\n5781 |         return new_obj\n```\n"}, {"content": "After thorough analysis, I can confirm that the previously found locations are sufficient to address the documentation issue. Let me provide the final location block in the required format:\n\n```\npandas/core/series.py\nline: 2481-2485\nfunction: Series.round\n\npandas/core/arrays/datetimelike.py\nline: 6\nclass: CombinedDatetimelikeProperties\nfunction: round