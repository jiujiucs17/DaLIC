eturns\n118 |         -------\n119 |         display : :class:`~sklearn.metrics.ConfusionMatrixDisplay`\n120 |         \"\"\"\n121 |         check_matplotlib_support(\"ConfusionMatrixDisplay.plot\")\n122 |         import matplotlib.pyplot as plt\n123 | \n124 |         if ax is None:\n125 |             fig, ax = plt.subplots()\n126 |         else:\n127 |             fig = ax.figure\n128 | \n129 |         cm = self.confusion_matrix\n130 |         n_classes = cm.shape[0]\n131 |         self.im_ = ax.imshow(cm, interpolation=\"nearest\", cmap=cmap)\n132 |         self.text_ = None\n133 |         cmap_min, cmap_max = self.im_.cmap(0), self.im_.cmap(1.0)\n134 | \n135 |         if include_values:\n136 |             self.text_ = np.empty_like(cm, dtype=object)\n137 | \n138 |             # print text with appropriate color depending on background\n139 |             thresh = (cm.max() + cm.min()) / 2.0\n140 | \n141 |             for i, j in product(range(n_classes), range(n_classes)):\n142 |                 color = cmap_max if cm[i, j] < thresh else cmap_min\n143 | \n144 |                 if values_format is None:\n145 |                     text_cm = format(cm[i, j], \".2g\")\n146 |                     if cm.dtype.kind != \"f\":\n147 |                         text_d = format(cm[i, j], \"d\")\n148 |                         if len(text_d) < len(text_cm):\n149 |                             text_cm = text_d\n150 |                 else:\n151 |                     text_cm = format(cm[i, j], values_format)\n152 | \n153 |                 self.text_[i, j] = ax.text(\n154 |                     j, i, text_cm, ha=\"center\", va=\"center\", color=color\n155 |                 )\n156 | \n157 |         if self.display_labels is None:\n158 |             display_labels = np.arange(n_classes)\n159 |         else:\n160 |             display_labels = self.display_labels\n161 |         if colorbar:\n162 |             fig.colorbar(self.im_, ax=ax)\n163 |         ax.set(\n164 |             xticks=np