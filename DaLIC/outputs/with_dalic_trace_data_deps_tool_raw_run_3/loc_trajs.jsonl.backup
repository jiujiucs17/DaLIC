n3424 |         [5*s - 5  (s - 1)*(6*s + 24)]\n3425 |         [-------  ------------------]\n3426 |         [6*s - 1     s*(6*s - 1)    ]{t}\n3427 | \n3428 |         If the user wants the resultant ``TransferFunctionMatrix`` object without\n3429 |         canceling the common factors then the ``cancel`` kwarg should be passed ``False``.\n3430 | \n3431 |         >>> pprint(F_1.doit(cancel=False), use_unicode=False)\n3432 |         [             s*(s - 1)                              s - 1               ]\n3433 |         [         -----------------                       -----------            ]\n3434 |         [         (1 - s)*(6*s - 1)                       s*(6*s - 1)            ]\n3435 |         [                                                                        ]\n3436 |         [s*(25*s - 25) + 5*(1 - s)*(6*s - 1)  s*(s - 1)*(6*s - 1) + s*(25*s - 25)]\n3437 |         [-----------------------------------  -----------------------------------]\n3438 |         [         (1 - s)*(6*s - 1)                        2                     ]\n3439 |         [                                                 s *(6*s - 1)           ]{t}\n3440 | \n3441 |         If the user wants the expanded form of the resultant transfer function matrix,\n3442 |         the ``expand`` kwarg should be passed as ``True``.\n3443 | \n3444 |         >>> pprint(F_1.doit(expand=True), use_unicode=False)\n3445 |         [  -s          s - 1      ]\n3446 |         [-------      --------    ]\n3447 |         [6*s - 1         2        ]\n3448 |         [             6*s  - s    ]\n3449 |         [                         ]\n3450 |         [            2            ]\n3451 |         [5*s - 5  6*s  + 18*s - 24]\n3452 |         [-------  ----------------]\n3453 |         [6*s - 1         2        ]\n3454 |         [             6*s  - s    ]{t}\n3455 | \n3456 |         \"\"\"\n3457 |         if self.is_StateSpace_object:\n3458 |             sys1_ss = self.sys1.doit().rewrite(StateSpace)\n3459 |             sys2_ss = self.sys2.doit().rewrite(StateSpace)\n3460 |             A1, B1, C1, D1 = sys1_ss.A, sys1_ss.B, sys1_ss.C, sys1_ss.D\n3461 |             A2, B2, C2, D2 = sys2_ss.A, sys2_ss.B, sys2_ss.C, sys2_ss.D\n3462 | \n3463 |             # Create identity matrices\n3464 |             I_inputs = eye(self.num_inputs)\n3465 |             I_outputs = eye(self.num_outputs)\n3466 | \n3467 |             # Compute F and its inverse\n3468 |             F = I_inputs - self.sign * D2 * D1\n3469 |             E = F.inv()\n3470 | \n3471 |             # Compute intermediate matrices\n3472 |             E_D2 = E * D2\n3473 |             E_C2 = E * C2\n3474 |             T1 = I_outputs + self.sign * D1 * E_D2\n3475 |             T2 = I_inputs + self.sign * E_D2 * D1\n3476 |             A = Matrix.vstack(\n3477 |             Matrix.hstack(A1 + self.sign * B1 * E_D2 * C1, self.sign * B1 * E_C2),\n3478 |             Matrix.hstack(B2 * T1 * C1, A2 + self.sign * B2 * D1 * E_C2)\n3479 |             )\n3480 |             B = Matrix.vstack(B1 * T2, B2 * D1 * T2)\n3481 |             C = Matrix.hstack(T1 * C1, self.sign * D1 * E_C2)\n3482 |             D = D1 * T2\n3483 |             return StateSpace(A, B, C, D)\n3484 | \n3485 |         _mat = self.sensitivity * self.sys1.doit()._expr_mat\n3486 | \n3487 |         _resultant_tfm = _to_TFM(_mat, self.var)\n3488 | \n3489 |         if cancel:\n3490 |             _resultant_tfm = _resultant_tfm.simplify()\n3491 | \n3492 |         if expand:\n3493 |             _resultant_tfm = _resultant_tfm.expand()\n3494 | \n3495 |         return _resultant_tfm\n```\n\nFound function `sympy/series/gruntz.py:sign`.\nSource: Retrieved entity using keyword search (bm25).\n```\n368 | def sign(e, x):\n369 |     \"\"\"\n370 |     Returns a sign of an expression e(x) for x->oo.\n371 | \n372 |     ::\n373 | \n374 |         e >  0 for x sufficiently large ...  1\n375 |         e == 0 for x sufficiently large ...  0\n376 |         e <  0 for x sufficiently large ... -1\n377 | \n378 |     The result of this function is currently undefined if e changes sign\n379 |     arbitrarily often for arbitrarily large x (e.g. sin(x)).\n380 | \n381 |     Note that this returns zero only if e is *constantly* zero\n382 |     for x sufficiently large. [If e is constant, of course, this is just\n383 |     the same thing as the sign of e.]\n384 |     \"\"\"\n385 |     if not isinstance(e, Basic):\n386 |         raise TypeError(\"e should be an instance of Basic\")\n387 | \n388 |     if e.is_positive:\n389 |         return 1\n390 |     elif e.is_negative:\n391 |         return -1\n392 |     elif e.is_zero:\n393 |         return 0\n394 | \n395 |     elif not e.has(x):\n396 |         from sympy.simplify import logcombine\n397 |         e = logcombine(e)\n398 |         return _sign(e)\n399 |     elif e == x:\n400 |         return 1\n401 |     elif e.is_Mul:\n402 |         a, b = e.as_two_terms()\n403 |         sa = sign(a, x)\n404 |         if not sa:\n405 |             return 0\n406 |         return sa * sign(b, x)\n407 |     elif isinstance(e, exp):\n408 |         return 1\n409 |     elif e.is_Pow:\n410 |         if e.base == S.Exp1:\n411 |             return 1\n412 |         s = sign(e.base, x)\n413 |         if s == 1:\n414 |             return 1\n415 |         if e.exp.is_Integer:\n416 |             return s**e.exp\n417 |     elif isinstance(e, log) and e.args[0].is_positive:\n418 |         return sign(e.args[0] - 1, x)\n419 | \n420 |     # if all else fails, do it the hard way\n421 |     c0, e0 = mrv_leadterm(e, x)\n422 |     return sign(c0, x)\n```\n\nFound function `sympy/polys/groebnertools.py:Sign`.\nSource: Retrieved entity using keyword search (bm25).\n```\n282 | def Sign(f):\n283 |     return f[0]\n```\n\nFound function `sympy/polys/groebnertools.py:is_rewritable_or_comparable`.\nSource: Retrieved code content using keyword search (bm25).\n```\n493 | def is_rewritable_or_comparable(sign, num, B):\n494 |     \"\"\"\n495 |     Check if a labeled polynomial is redundant by checking if its\n496 |     signature and number imply rewritability or comparability.\n497 | \n498 |     (sign, num) is comparable if there exists a labeled polynomial\n499 |     h in B, such that sign[1] (the index) is less than Sign(h)[1]\n500 |     and sign[0] is divisible by the leading monomial of h.\n501 | \n502 |     (sign, num) is rewritable if there exists a labeled polynomial\n503 |     h in B, such thatsign[1] is equal to Sign(h)[1], num < Num(h)\n504 |     and sign[0] is divisible by Sign(h)[0].\n505 |     \"\"\"\n506 |     for h in B:\n507 |         # comparable\n508 |         if sign[1] < Sign(h)[1]:\n509 |             if monomial_divides(Polyn(h).LM, sign[0]):\n510 |                 return True\n511 | \n512 |         # rewritable\n513 |         if sign[1] == Sign(h)[1]:\n514 |             if num < Num(h):\n515 |                 if monomial_divides(Sign(h)[0], sign[0]):\n516 |                     return True\n517 |     return False\n```\n\nFound function `sympy/codegen/rewriting.py:optimize`.\nSource: Retrieved entity using keyword search (bm25).\n```\n113 | def optimize(expr, optimizations):\n114 |     \"\"\" Apply optimizations to an expression.\n115 | \n116 |     Parameters\n117 |     ==========\n118 | \n119 |     expr : expression\n120 |     optimizations : iterable of ``Optimization`` instances\n121 |         The optimizations will be sorted with respect to ``priority`` (highest first).\n122 | \n123 |     Examples\n124 |     ========\n125 | \n126 |     >>> from sympy import log, Symbol\n127 |     >>> from sympy.codegen.rewriting import optims_c99, optimize\n128 |     >>> x = Symbol('x')\n129 |     >>> optimize(log(x+3)/log(2) + log(x**2 + 1), optims_c99)\n130 |     log1p(x**2) + log2(x + 3)\n131 | \n132 |     \"\"\"\n133 | \n134 |     for optim in sorted(optimizations, key=lambda opt: opt.priority, reverse=True):\n135 |         new_expr = optim(expr)\n136 |         if optim.cost_function is None:\n137 |          