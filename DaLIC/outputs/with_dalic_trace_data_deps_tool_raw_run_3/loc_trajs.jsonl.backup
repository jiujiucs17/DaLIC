0 |         of the weights as the second element. The return type is `np.float64`\n561 |         if `a` is of integer type and floats smaller than `float64`, or the\n562 |         input data-type, otherwise. If returned, `sum_of_weights` is always\n563 |         `float64`.\n564 | \n565 |     Examples\n566 |     --------\n567 |     >>> a = np.ma.array([1., 2., 3., 4.], mask=[False, False, True, True])\n568 |     >>> np.ma.average(a, weights=[3, 1, 0, 0])\n569 |     1.25\n570 | \n571 |     >>> x = np.ma.arange(6.).reshape(3, 2)\n572 |     >>> x\n573 |     masked_array(\n574 |       data=[[0., 1.],\n575 |             [2., 3.],\n576 |             [4., 5.]],\n577 |       mask=False,\n578 |       fill_value=1e+20)\n579 |     >>> avg, sumweights = np.ma.average(x, axis=0, weights=[1, 2, 3],\n580 |     ...                                 returned=True)\n581 |     >>> avg\n582 |     masked_array(data=[2.6666666666666665, 3.6666666666666665],\n583 |                  mask=[False, False],\n584 |            fill_value=1e+20)\n585 | \n586 |     \"\"\"\n587 |     a = asarray(a)\n588 |     m = getmask(a)\n589 | \n590 |     # inspired by 'average' in numpy/lib/function_base.py\n591 | \n592 |     if weights is None:\n593 |         avg = a.mean(axis)\n594 |         scl = avg.dtype.type(a.count(axis))\n595 |     else:\n596 |         wgt = np.asanyarray(weights)\n597 | \n598 |         if issubclass(a.dtype.type, (np.integer, np.bool_)):\n599 |             result_dtype = np.result_type(a.dtype, wgt.dtype, 'f8')\n600 |         else:\n601 |             result_dtype = np.result_type(a.dtype, wgt.dtype)\n602 | \n603 |         # Sanity checks\n604 |         if a.shape != wgt.shape:\n605 |             if axis is None:\n606 |                 raise TypeError(\n607 |                     \"Axis must be specified when shapes of a and weights \"\n608 |                     \"differ.\")\n609 |             if wgt.ndim != 1:\n610 |                 raise TypeError(\n611 |                     \"1D weights