have accumulated\n12 | 500 of these patches (using 10 images), we run the\n13 | :func:`~sklearn.cluster.MiniBatchKMeans.partial_fit` method\n14 | of the online KMeans object, MiniBatchKMeans.\n15 | \n16 | The verbose setting on the MiniBatchKMeans enables us to see that some\n17 | clusters are reassigned during the successive calls to\n18 | partial-fit. This is because the number of patches that they represent\n19 | has become too low, and it is better to choose a random new\n20 | cluster.\n21 | \n22 | \"\"\"\n23 | \n24 | # %%\n25 | # Load the data\n26 | # -------------\n27 | \n28 | from sklearn import datasets\n29 | \n30 | faces = datasets.fetch_olivetti_faces()\n31 | \n32 | # %%\n33 | # Learn the dictionary of images\n34 | # ------------------------------\n35 | \n36 | import time\n37 | \n38 | import numpy as np\n39 | \n40 | from sklearn.cluster import MiniBatchKMeans\n41 | from sklearn.feature_extraction.image import extract_patches_2d\n42 | \n43 | print(\"Learning the dictionary... \")\n44 | rng = np.random.RandomState(0)\n45 | kmeans = MiniBatchKMeans(n_clusters=81, random_state=rng, verbose=True)\n46 | patch_size = (20, 20)\n47 | \n48 | buffer = []\n49 | t0 = time.time()\n50 | \n51 | # The online learning part: cycle over the whole dataset 6 times\n52 | index = 0\n53 | for _ in range(6):\n54 |     for img in faces.images:\n55 |         data = extract_patches_2d(img, patch_size, max_patches=50, random_state=rng)\n56 |         data = np.reshape(data, (len(data), -1))\n57 |         buffer.append(data)\n58 |         index += 1\n59 |         if index % 10 == 0:\n60 |             data = np.concatenate(buffer, axis=0)\n61 |             data -= np.mean(data, axis=0)\n62 |             data /= np.std(data, axis=0)\n63 |             kmeans.partial_fit(data)\n64 |             buffer = []\n65 |         if index % 100 == 0:\n66 |             print(\"Partial fit of %4i out of %i\" % (index, 6 * len(faces.images)))\n67 | \n68 | dt = time.time() - t0\n69 | print(\"done in %.2fs.\" % dt)\n70 | \n71 | # %%\n72 | # Plot the results\n73 | # ----------------\n74 | \n75 | import matplotlib.pyplot as plt\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:dict_learning_online`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 738 | def dict_learning_online(\n 739 |     X,\n 740 |     n_components=2,\n 741 |     *,\n 742 |     alpha=1,\n 743 |     n_iter=\"deprecated\",\n 744 |     max_iter=None,\n 745 |     return_code=True,\n 746 |     dict_init=None,\n 747 |     callback=None,\n 748 |     batch_size=\"warn\",\n 749 |     verbose=False,\n 750 |     shuffle=True,\n 751 |     n_jobs=None,\n 752 |     method=\"lars\",\n 753 |     iter_offset=\"deprecated\",\n 754 |     random_state=None,\n 755 |     return_inner_stats=\"deprecated\",\n 756 |     inner_stats=\"deprecated\",\n 757 |     return_n_iter=\"deprecated\",\n 758 |     positive_dict=False,\n 759 |     positive_code=False,\n 760 |     method_max_iter=1000,\n 761 |     tol=1e-3,\n 762 |     max_no_improvement=10,\n 763 | ):\n 764 |     \"\"\"Solves a dictionary learning matrix factorization problem online.\n 765 | \n 766 |     Finds the best dictionary and the corresponding sparse code for\n 767 |     approximating the data matrix X by solving::\n 768 | \n 769 |         (U^*, V^*) = argmin 0.5 || X - U V ||_Fro^2 + alpha * || U ||_1,1\n 770 |                      (U,V)\n 771 |                      with || V_k ||_2 = 1 for all  0 <= k < n_components\n 772 | \n 773 |     where V is the dictionary and U is the sparse code. ||.||_Fro stands for\n 774 |     the Frobenius norm and ||.||_1,1 stands for the entry-wise matrix norm\n 775 |     which is the sum of the absolute values of all the entries in the matrix.\n 776 |     This is accomplished by repeatedly iterating over mini-batches by slicing\n 777 |     the input data.\n 778 | \n 779 |     Read more in the :ref:`User Guide <DictionaryLearning>`.\n 780 | \n 781 |     Parameters\n 782 |     ----------\n 783 |     X : ndarray of shape (n_samples, n_features)\n 784 |         Data matrix.\n 785 | \n 786 |     n_components : int or None, default=2\n 787 |         Number of dictionary atoms to extract. If None, then ``n_components``\n 788 |         is set to ``n_features``.\n 789 | \n 790 |     alpha : float, default=1\n 791 |         Sparsity controlling parameter.\n 792 | \n 793 |     n_iter : int, default=100\n 794 |         Number of mini-batch iterations to perform.\n 795 | \n 796 |         .. deprecated:: 1.1\n 797 |            `n_iter` is deprecated in 1.1 and will be removed in 1.3. Use\n 798 |            `max_iter` instead.\n 799 | \n 800 |     max_iter : int, default=None\n 801 |         Maximum number of iterations over the complete dataset before\n 802 |         stopping independently of any early stopping criterion heuristics.\n 803 |         If ``max_iter`` is not None, ``n_iter`` is ignored.\n 804 | \n 805 |         .. versionadded:: 1.1\n 806 | \n 807 |     return_code : bool, default=True\n 808 |         Whether to also return the code U or just the dictionary `V`.\n 809 | \n 810 |     dict_init : ndarray of shape (n_components, n_features), default=None\n 811 |         Initial value for the dictionary for warm restart scenarios.\n 812 | \n 813 |     callback : callable, default=None\n 814 |         A callable that gets invoked at the end of each iteration.\n 815 | \n 816 |     batch_size : int, default=3\n 817 |         The number of samples to take in each batch.\n 818 | \n 819 |     verbose : bool, default=False\n 820 |         To control the verbosity of the procedure.\n 821 | \n 822 |     shuffle : bool, default=True\n 823 |         Whether to shuffle the data before splitting it in batches.\n 824 | \n 825 |     n_jobs : int, default=None\n 826 |         Number of parallel jobs to run.\n 827 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 828 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 829 |         for more details.\n 830 | \n 831 |     method : {'lars', 'cd'}, default='lars'\n 832 |         * `'lars'`: uses the least angle regression method to solve the lasso\n 833 |           problem (`linear_model.lars_path`);\n 834 |         * `'cd'`: uses the coordinate descent method to compute the\n 835 |           Lasso solution (`linear_model.Lasso`). Lars will be faster if\n 836 |           the estimated components are sparse.\n 837 | \n 838 |     iter_offset : int, default=0\n 839 |         Number of previous iterations completed on the dictionary used for\n 840 |         initialization.\n 841 | \n 842 |         .. deprecated:: 1.1\n 843 |            `iter_offset` serves internal purpose only and will be removed in 1.3.\n 844 | \n 845 |     random_state : int, RandomState instance or None, default=None\n 846 |         Used for initializing the dictionary when ``dict_init`` is not\n 847 |         specified, randomly shuffling the data when ``shuffle`` is set to\n 848 |         ``True``, and updating the dictionary. Pass an int for reproducible\n 849 |         results across multiple function calls.\n 850 |         See :term:`Glossary <random_state>`.\n 851 | \n 852 |     return_inner_stats : bool, default=False\n 853 |         Return the inner statistics A (dictionary covariance) and B\n 854 |         (data approximation). Useful to restart the algorithm in an\n 855 |         online setting. If `return_inner_stats` is `True`, `return_code` is\n 856 |         ignored.\n 857 | \n 858 |         .. deprecated:: 1.1\n 859 |            `return_inner_stats` serves internal purpose only and will be removed in 1.3.\n 860 | \n 861 |     inner_stats : tuple of (A, B) ndarrays, default=None\n 862 |         Inner sufficient statistics that are kept by the algorithm.\n 863 |         Passing them at initialization is useful in online settings, to\n 864 |         avoid losing the history of the evolution.\n 865 |         `A` `(n_components, n_components)` is the dictionary covariance matrix.\n 866 |         `B` `(n_features, n_components)` is the data approximation matrix.\n 867 | \n 868 |         .. deprecated:: 1.1\n 869 |            `inner_stats` serves internal purpose only and will be removed in 1.3.\n 870 | \n 871 |     return_n_iter : bool, default=False\n 872 |         Whether or not to return the number of iterations.\n 873 | \n 874 |         .. deprecated:: 1.1\n 875 |            `return_n_iter` will be removed in 1.3 and n_iter will always be returned.\n 876 | \n 877 |     positive_dict : bool, default=False\n 878 |         Whether to enforce positivity when finding the dictionary.\n 879 | \n 880 |         .. versionadded:: 0.20\n 881 | \n 882 |     positive_code : bool, default=False\n 883 |         Whether to enforce positivity when finding the code.\n 884 | \n 885 |         .. versionadded:: 0.20\n 886 | \n 887 |     method_max_iter : int, default=1000\n 888 |         Maximum number of iterations to perform when solving the lasso problem.\n 889 | \n 890 |         .. versionadded:: 0.22\n 891 | \n 892 |     tol : float, default=1e-3\n 893 |         Control early stopping based on the norm of the differences in the\n 894 |         dictionary between 2 steps. Used only if `max_iter` is not None.\n 895 | \n 896 |         To disable early stopping based on changes in the dictionary, set\n 897 |         `tol` to 0.0.\n 898 | \n 899 |         .. versionadded:: 1.1\n 900 | \n 901 |     max_no_improvement : int, default=10\n 902 |         Control early stopping based on the consecutive number of mini batches\n 903 |         that does not yield an improvement on the smoothed cost function. Used only if\n 904 |         `max_iter` is not None.\n 905 | \n 906 |         To disable convergence detection based on cost function, set\n 907 |         `max_no_improvement` to None.\n 908 | \n 909 |         .. versionadded:: 1.1\n 910 | \n 911 |     Returns\n 912 |     -------\n 913 |     code : ndarray of shape (n_samples, n_components),\n 914 |         The sparse code (only returned if `return_code=True`).\n 915 | \n 916 |     dictionary : ndarray of shape (n_components, n_features),\n 917 |         The solutions to the dictionary learning problem.\n 918 | \n 919 |     n_iter : int\n 920 |         Number of iterations run. Returned only if `return_n_iter` is\n 921 |         set to `True`.\n 922 | \n 923 |     See Also\n 924 |     --------\n 925 |     dict_learning\n 926 |     DictionaryLearning\n 927 |     MiniBatchDictionaryLearning\n 928 |     SparsePCA\n 929 |     MiniBatchSparsePCA\n 930 |     \"\"\"\n 931 |     deps = (return_n_iter, return_inner_stats, iter_offset, inner_stats)\n 932 |     if max_iter is not None and not all(arg == \"deprecated\" for arg in deps):\n 933 |         raise ValueError(\n 934 |             \"The following arguments are incompatible with 'max_iter': \"\n 935 |             \"return_n_iter, return_inner_stats, iter_offset, inner_stats\"\n 936 |         )\n 937 | \n 938 |     iter_offset = _check_warn_deprecated(iter_offset, \"iter_offset\", default=0)\n 939 |     return_inner_stats = _check_warn_deprecated(\n 940 |         return_inner_stats,\n 941 |         \"return_inner_stats\",\n 942 |         default=False,\n 943 |         additional_message=\"From 1.3 inner_stats will never be returned.\",\n 944 |     )\n 945 |     inner_stats = _check_warn_deprecated(inner_stats, \"inner_stats\", default=None)\n 946 |     return_n_iter = _check_warn_deprecated(\n 947 |         return_n_iter,\n 948 |         \"return_n_iter\",\n 949 |         default=False,\n 950 |         additional_message=(\n 951 |             \"From 1.3 'n_iter' will never be returned. Refer to the 'n_iter_' and \"\n 952 |             \"'n_steps_' attributes of the MiniBatchDictionaryLearning object instead.\"\n 953 |         ),\n 954 |     )\n 955 | \n 956 |     if max_iter is not None:\n 957 |         transform_algorithm = \"lasso_\" + method\n 958 | \n 959 |         est = MiniBatchDictionaryLearning(\n 960 |             n_components=n_components,\n 961 |             alpha=alpha,\n 962 |             n_iter=n_iter,\n 963 |             n_jobs=n_jobs,\n 964 |             fit_algorithm=method,\n 965 |             batch_size=batch_size,\n 966 |             shuffle=shuffle,\n 967 |             dict_init=dict_init,\n 968 |             random_state=random_state,\n 969 |             transform_algorithm=transform_algorithm,\n 970 |             transform_alpha=alpha,\n 971 |             positive_code=positive_code,\n 972 |             positive_dict=positive_dict,\n 973 |             transform_max_iter=method_max_iter,\n 974 |             verbose=verbose,\n 975 |             callback=callback,\n 976 |             tol=tol,\n 977 |             max_no_improvement=max_no_improvement,\n 978 |         ).fit(X)\n 979 | \n 980 |         if not return_code:\n 981 |             return est.components_\n 982 |         else:\n 983 |             code = est.transform(X)\n 984 |             return code, est.components_\n 985 | \n 986 |     # TODO remove the whole old behavior in 1.3\n 987 |     # Fallback to old behavior\n 988 | \n 989 |     n_iter = _check_warn_deprecated(\n 990 |         n_iter, \"n_iter\", default=100, additional_message=\"Use 'max_iter' instead.\"\n 991 |     )\n 992 | \n 993 |     if batch_size == \"warn\":\n 994 |         warnings.warn(\n 995 |             \"The default value of batch_size will change from 3 to 256 in 1.3.\",\n 996 |             FutureWarning,\n 997 |         )\n 998 |         batch_size = 3\n 999 | \n1000 |     if n_components is None:\n1001 |         n_components = X.shape[1]\n1002 | \n1003 |     if method not in (\"lars\", \"cd\"):\n1004 |         raise ValueError(\"Coding method not supported as a fit algorithm.\")\n1005 | \n1006 |     _check_positive_coding(method, positive_code)\n1007 | \n1008 |     method = \"lasso_\" + method\n1009 | \n1010 |     t0 = time.time()\n1011 |     n_samples, n_features = X.shape\n1012 |     # Avoid integer division problems\n1013 |     alpha = float(alpha)\n1014 |     random_state = check_random_state(random_state)\n1015 | \n1016 |     # Init V with SVD of X\n1017 |     if dict_init is not None:\n1018 |         dictionary = dict_init\n1019 |     else:\n1020 |         _, S, dictionary = randomized_svd(X, n_components, random_state=random_state)\n1021 |         dictionary = S[:, np.newaxis] * dictionary\n1022 |     r = len(dictionary)\n1023 |     if n_components <= r:\n1024 |         dictionary = dictionary[:n_components, :]\n1025 |     else:\n1026 |         dictionary = np.r_[\n1027 |             dictionary,\n1028 |             np.zeros((n_components - r, dictionary.shape[1]), dtype=dictionary.dtype),\n1029 |         ]\n1030 | \n1031 |     if verbose == 1:\n1032 |         print(\"[dict_learning]\", end=\" \")\n1033 | \n1034 |     if shuffle:\n1035 |         X_train = X.copy()\n1036 |         random_state.shuffle(X_train)\n1037 |     else:\n1038 |         X_train = X\n1039 | \n1040 |     X_train = check_array(\n1041 |         X_train, order=\"C\", dtype=[np.float64, np.float32], copy=False\n1042 |     )\n1043 | \n1044 |     # Fortran-order dict better suited for the sparse coding which is the\n1045 |     # bottleneck of this algorithm.\n1046 |     dictionary = check_array(dictionary, order=\"F\", dtype=X_train.dtype, copy=False)\n1047 |     dictionary = np.require(dictionary, requirements=\"W\")\n1048 | \n1049 |     batches = gen_batches(n_samples, batch_size)\n1050 |     batches = itertools.cycle(batches)\n1051 | \n1052 |     # The covariance of the dictionary\n1053 |     if inner_stats is None:\n1054 |         A = np.zeros((n_components, n_components), dtype=X_train.dtype)\n1055 |         # The data approximation\n1056 |         B = np.zeros((n_features, n_components), dtype=X_train.dtype)\n1057 |     else:\n1058 |         A = inner_stats[0].copy()\n1059 |         B = inner_stats[1].copy()\n1060 | \n1061 |     # If n_iter is zero, we need to return zero.\n1062 |     ii = iter_offset - 1\n1063 | \n1064 |     for ii, batch in zip(range(iter_offset, iter_offset + n_iter), batches):\n1065 |         this_X = X_train[batch]\n1066 |         dt = time.time() - t0\n1067 |         if verbose == 1:\n1068 |             sys.stdout.write(\".\")\n1069 |             sys.stdout.flush()\n1070 |         elif verbose:\n1071 |             if verbose > 10 or ii % ceil(100.0 / verbose) == 0:\n1072 |                 print(\n1073 |                     \"Iteration % 3i (elapsed time: % 3is, % 4.1fmn)\" % (ii, dt, dt / 60)\n1074 |                 )\n1075 | \n1076 |         this_code = sparse_encode(\n1077 |             this_X,\n1078 |             dictionary,\n1079 |             algorithm=method,\n1080 |             alpha=alpha,\n1081 |             n_jobs=n_jobs,\n1082 |             check_input=False,\n1083 |             positive=positive_code,\n1084 |             max_iter=method_max_iter,\n1085 |             verbose=verbose,\n1086 |         )\n1087 | \n1088 |         # Update the auxiliary variables\n1089 |         if ii < batch_size - 1:\n1090 |             theta = float((ii + 1) * batch_size)\n1091 |         else:\n1092 |             theta = float(batch_size**2 + ii + 1 - batch_size)\n1093 |         beta = (theta + 1 - batch_size) / (theta + 1)\n1094 | \n1095 |         A *= beta\n1096 |         A += np.dot(this_code.T, this_code)\n1097 |         B *= beta\n1098 |         B += np.dot(this_X.T, this_code)\n1099 | \n1100 |         # Update dictionary in place\n1101 |         _update_dict(\n1102 |             dictionary,\n1103 |             this_X,\n1104 |             this_code,\n1105 |             A,\n1106 |             B,\n1107 |             verbose=verbose,\n1108 |             random_state=random_state,\n1109 |             positive=positive_dict,\n1110 |         )\n1111 | \n1112 |         # Maybe we need a stopping criteria based on the amount of\n1113 |         # modification in the dictionary\n1114 |         if callback is not None:\n1115 |             callback(locals())\n1116