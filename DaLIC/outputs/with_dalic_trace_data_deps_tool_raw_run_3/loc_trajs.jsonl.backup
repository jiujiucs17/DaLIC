\n 48 |     df = frame._get_numeric_data()\n 49 |     n = df.columns.size\n 50 |     naxes = n * n\n 51 |     fig, axes = create_subplots(naxes=naxes, figsize=figsize, ax=ax, squeeze=False)\n 52 | \n 53 |     # no gaps between subplots\n 54 |     maybe_adjust_figure(fig, wspace=0, hspace=0)\n 55 | \n 56 |     mask = notna(df)\n 57 | \n 58 |     marker = _get_marker_compat(marker)\n 59 | \n 60 |     hist_kwds = hist_kwds or {}\n 61 |     density_kwds = density_kwds or {}\n 62 | \n 63 |     # GH 14855\n 64 |     kwds.setdefault(\"edgecolors\", \"none\")\n 65 | \n 66 |     boundaries_list = []\n 67 |     for a in df.columns:\n 68 |         values = df[a].values[mask[a].values]\n 69 |         rmin_, rmax_ = np.min(values), np.max(values)\n 70 |         rdelta_ext = (rmax_ - rmin_) * range_padding / 2\n 71 |         boundaries_list.append((rmin_ - rdelta_ext, rmax_ + rdelta_ext))\n 72 | \n 73 |     for i, a in enumerate(df.columns):\n 74 |         for j, b in enumerate(df.columns):\n 75 |             ax = axes[i, j]\n 76 | \n 77 |             if i == j:\n 78 |                 values = df[a].values[mask[a].values]\n 79 | \n 80 |                 # Deal with the diagonal by drawing a histogram there.\n 81 |                 if diagonal == \"hist\":\n 82 |                     ax.hist(values, **hist_kwds)\n 83 | \n 84 |                 elif diagonal in (\"kde\", \"density\"):\n 85 |                     from scipy.stats import gaussian_kde\n 86 | \n 87 |                     y = values\n 88 |                     gkde = gaussian_kde(y)\n 89 |                     ind = np.linspace(y.min(), y.max(), 1000)\n 90 |                     ax.plot(ind, gkde.evaluate(ind), **density_kwds)\n 91 | \n 92 |                 ax.set_xlim(boundaries_list[i])\n 93 | \n 94 |             else:\n 95 |                 common = (mask[a] & mask[b]).values\n 96 | \n 97 |                 ax.scatter(\n 98 |                     df[b][common], df[a][common], marker=marker, alpha=alpha, **kwds\n 99 |           