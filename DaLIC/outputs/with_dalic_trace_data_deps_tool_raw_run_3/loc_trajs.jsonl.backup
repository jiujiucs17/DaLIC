ion import extract_array\n 37 | from pandas.core.indexes.base import Index\n 38 | \n 39 | from pandas.io.formats.printing import (\n 40 |     pprint_thing,\n 41 |     pprint_thing_encoded,\n 42 | )\n 43 | \n 44 | if TYPE_CHECKING:\n 45 |     from pandas._typing import (\n 46 |         Self,\n 47 |         npt,\n 48 |     )\n 49 | \n 50 | \n 51 | class PyTablesScope(_scope.Scope):\n 52 |     __slots__ = (\"queryables\",)\n 53 | \n 54 |     queryables: dict[str, Any]\n 55 | \n 56 |     def __init__(\n 57 |         self,\n 58 |         level: int,\n 59 |         global_dict=None,\n 60 |         local_dict=None,\n 61 |         queryables: dict[str, Any] | None = None,\n 62 |     ) -> None:\n 63 |         super().__init__(level + 1, global_dict=global_dict, local_dict=local_dict)\n 64 |         self.queryables = queryables or {}\n 65 | \n 66 | \n 67 | class Term(ops.Term):\n 68 |     env: PyTablesScope\n 69 | \n 70 |     def __new__(cls, name, env, side=None, encoding=None):\n 71 |         if isinstance(name, str):\n 72 |             klass = cls\n 73 |         else:\n 74 |             klass = Constant\n 75 |         return object.__new__(klass)\n 76 | \n 77 |     def __init__(self, name, env: PyTablesScope, side=None, encoding=None) -> None:\n 78 |         super().__init__(name, env, side=side, encoding=encoding)\n 79 | \n 80 |     def _resolve_name(self):\n 81 |         # must be a queryables\n 82 |         if self.side == \"left\":\n 83 |             # Note: The behavior of __new__ ensures that self.name is a str here\n 84 |             if self.name not in self.env.queryables:\n 85 |                 raise NameError(f\"name {self.name!r} is not defined\")\n 86 |             return self.name\n 87 | \n 88 |         # resolve the rhs (and allow it to be None)\n 89 |         try:\n 90 |             return self.env.resolve(self.name, is_local=False)\n 91 |         except UndefinedVariableError:\n 92 |             return self.name\n 93 | \n 94 |     # read-only property overwriting read/write property\n 95 |     @property  # type: ignore[misc]\n 96 |     def value(self):\n 97 |         return self._value\n 98 | \n 99 | \n100 | class Constant(Term):\n101 |     def __init__(self, name, env: PyTablesScope, side=None, encoding=None) -> None:\n102 |         assert isinstance(env, PyTablesScope), type(env)\n103 |         super().__init__(name, env, side=side, encoding=encoding)\n104 | \n105 |     def _resolve_name(self):\n106 |         return self._name\n107 | \n108 | \n109 | class BinOp(ops.BinOp):\n110 |     _max_selectors = 31\n111 | \n112 |     op: str\n113 |     queryables: dict[str, Any]\n114 |     condition: str | None\n115 | \n116 |     def __init__(self, op: str, lhs, rhs, queryables: dict[str, Any], encoding) -> None:\n117 |         super().__init__(op, lhs, rhs)\n118 |         self.queryables = queryables\n119 |         self.encoding = encoding\n120 |         self.condition = None\n121 | \n122 |     def _disallow_scalar_only_bool_ops(self) -> None:\n123 |         pass\n124 | \n125 |     def prune(self, klass):\n126 |         def pr(left, right):\n127 |             \"\"\"create and return a new specialized BinOp from myself\"\"\"\n128 |             if left is None:\n129 |                 return right\n130 |             elif right is None:\n131 |                 return left\n132 | \n133 |             k = klass\n134 |             if isinstance(left, ConditionBinOp):\n135 |                 if isinstance(right, ConditionBinOp):\n136 |                     k = JointConditionBinOp\n137 |                 elif isinstance(left, k):\n138 |                     return left\n139 |                 elif isinstance(right, k):\n140 |                     return right\n141 | \n142 |             elif isinstance(left, FilterBinOp):\n143 |                 if isinstance(right, FilterBinOp):\n144 |                     k = JointFilterBinOp\n145 |                 elif isinstance(left, k):\n146 |                     return left\n147 |                 elif isin