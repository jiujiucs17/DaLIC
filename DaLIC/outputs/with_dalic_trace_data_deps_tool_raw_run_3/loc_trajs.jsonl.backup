|     \"\"\"\n2908 |     _check_feature_names(_estimator, X, reset=reset)\n2909 |     tags = get_tags(_estimator)\n2910 |     if y is None and tags.target_tags.required:\n2911 |         raise ValueError(\n2912 |             f\"This {_estimator.__class__.__name__} estimator \"\n2913 |             \"requires y to be passed, but the target y is None.\"\n2914 |         )\n2915 | \n2916 |     no_val_X = isinstance(X, str) and X == \"no_validation\"\n2917 |     no_val_y = y is None or isinstance(y, str) and y == \"no_validation\"\n2918 | \n2919 |     if no_val_X and no_val_y:\n2920 |         raise ValueError(\"Validation should be done on X, y or both.\")\n2921 | \n2922 |     default_check_params = {\"estimator\": _estimator}\n2923 |     check_params = {**default_check_params, **check_params}\n2924 | \n2925 |     if skip_check_array:\n2926 |         if not no_val_X and no_val_y:\n2927 |             out = X\n2928 |         elif no_val_X and not no_val_y:\n2929 |             out = y\n2930 |         else:\n2931 |             out = X, y\n2932 |     elif not no_val_X and no_val_y:\n2933 |         out = check_array(X, input_name=\"X\", **check_params)\n2934 |     elif no_val_X and not no_val_y:\n2935 |         out = _check_y(y, **check_params)\n2936 |     else:\n2937 |         if validate_separately:\n2938 |             # We need this because some estimators validate X and y\n2939 |             # separately, and in general, separately calling check_array()\n2940 |             # on X and y isn't equivalent to just calling check_X_y()\n2941 |             # :(\n2942 |             check_X_params, check_y_params = validate_separately\n2943 |             if \"estimator\" not in check_X_params:\n2944 |                 check_X_params = {**default_check_params, **check_X_params}\n2945 |             X = check_array(X, input_name=\"X\", **check_X_params)\n2946 |             if \"estimator\" not in check_y_params:\n2947 |                 check_y_params = {**default_check_params, **check_y_