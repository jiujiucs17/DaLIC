aise_on_missing=raise_on_missing,\n194 |         )\n195 |         return cls\n196 | \n197 |     return add_delegate_accessors\n```\n\nFound function `pandas/core/accessor.py:_register_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n237 | def _register_accessor(\n238 |     name: str, cls: type[NDFrame | Index]\n239 | ) -> Callable[[TypeT], TypeT]:\n240 |     \"\"\"\n241 |     Register a custom accessor on {klass} objects.\n242 | \n243 |     Parameters\n244 |     ----------\n245 |     name : str\n246 |         Name under which the accessor should be registered. A warning is issued\n247 |         if this name conflicts with a preexisting attribute.\n248 | \n249 |     Returns\n250 |     -------\n251 |     callable\n252 |         A class decorator.\n253 | \n254 |     See Also\n255 |     --------\n256 |     register_dataframe_accessor : Register a custom accessor on DataFrame objects.\n257 |     register_series_accessor : Register a custom accessor on Series objects.\n258 |     register_index_accessor : Register a custom accessor on Index objects.\n259 | \n260 |     Notes\n261 |     -----\n262 |     This function allows you to register a custom-defined accessor class for {klass}.\n263 |     The requirements for the accessor class are as follows:\n264 | \n265 |     * Must contain an init method that:\n266 | \n267 |       * accepts a single {klass} object\n268 | \n269 |       * raises an AttributeError if the {klass} object does not have correctly\n270 |         matching inputs for the accessor\n271 | \n272 |     * Must contain a method for each access pattern.\n273 | \n274 |       * The methods should be able to take any argument signature.\n275 | \n276 |       * Accessible using the @property decorator if no additional arguments are\n277 |         needed.\n278 | \n279 |     Examples\n280 |     --------\n281 |     {examples}\n282 |     \"\"\"\n283 | \n284 |     def decorator(accessor: TypeT) -> TypeT:\n285 |         if hasattr(cls, name):\n286 |             warnings.warn(\n287 |                 f\"registration of accessor {accessor!r} under name \"\n288 |                 f\"{name!r} for type {cls!r} is overriding a preexisting \"\n289 |                 f\"attribute with the same name.\",\n290 |                 UserWarning,\n291 |                 stacklevel=find_stack_level(),\n292 |             )\n293 |         setattr(cls, name, Accessor(name, accessor))\n294 |         cls._accessors.add(name)\n295 |         return accessor\n296 | \n297 |     return decorator\n```\n\n\n\n##Searching for term \"AttributeError\"...\n### Search Result:\nFound class `pandas/errors/__init__.py:AttributeConflictWarning`.\nSource: Retrieved entity using keyword search (bm25).\n```\n648 | class AttributeConflictWarning(Warning):\n649 |     \"\"\"\n650 |     Warning raised when index attributes conflict when using HDFStore.\n651 | \n652 |     Occurs when attempting to append an index with a different\n653 |     name than the existing index on an HDFStore or attempting to append an index with a\n654 |     different frequency than the existing index on an HDFStore.\n655 | \n656 |     Examples\n657 |     --------\n658 |     >>> idx1 = pd.Index([\"a\", \"b\"], name=\"name1\")\n659 |     >>> df1 = pd.DataFrame([[1, 2], [3, 4]], index=idx1)\n660 |     >>> df1.to_hdf(\"file\", \"data\", \"w\", append=True)  # doctest: +SKIP\n661 |     >>> idx2 = pd.Index([\"c\", \"d\"], name=\"name2\")\n662 |     >>> df2 = pd.DataFrame([[5, 6], [7, 8]], index=idx2)\n663 |     >>> df2.to_hdf(\"file\", \"data\", \"a\", append=True)  # doctest: +SKIP\n664 |     AttributeConflictWarning: the [index_name] attribute of the existing index is\n665 |     [name1] which conflicts with the new [name2]...\n666 |     \"\"\"\n```\n\nFound class `pandas/core/base.py:NoNewAttributesMixin`.\nSource: Retrieved entity using keyword search (bm25).\n```\n137 | class NoNewAttributesMixin:\n138 |     \"\"\"\n139 |     Mixin which prevents adding new attributes.\n140 | \n141 |     Prevents additional attributes via xxx.attribute = \"something\" after a\n142 |     call to `self.__freeze()`. Mainly used to prevent the user from using\n143 |     wrong attributes on an accessor (`Series.cat/.str/.dt`).\n144 | \n145 |     If you really want to add a new attribute at a later time, you need to use\n146 |     `object.__setattr__(self, key, value)`.\n147 |     \"\"\"\n148 | \n149 |     def _freeze(self) -> None:\n150 |         \"\"\"\n151 |         Prevents setting additional attributes.\n152 |         \"\"\"\n153 |         object.__setattr__(self, \"__frozen\", True)\n154 | \n155 |     # prevent adding any attribute via s.xxx.new_attribute = ...\n156 |     def __setattr__(self, key: str, value) -> None:\n157 |         # _cache is used by a decorator\n158 |         # We need to check both 1.) cls.__dict__ and 2.) getattr(self, key)\n159 |         # because\n160 |         # 1.) getattr is false for attributes that raise errors\n161 |         # 2.) cls.__dict__ doesn't traverse into base classes\n162 |         if getattr(self, \"__frozen\", False) and not (\n163 |             key == \"_cache\"\n164 |             or key in type(self).__dict__\n165 |             or getattr(self, key, None) is not None\n166 |         ):\n167 |             raise AttributeError(f\"You cannot add any new attribute '{key}'\")\n168 |         object.__setattr__(self, key, value)\n```\n\nFound class `asv_bench/benchmarks/groupby.py:DateAttributes`.\nSource: Retrieved entity using keyword search (bm25).\n```\n241 | class DateAttributes:\n242 |     def setup(self):\n243 |         rng = date_range(\"1/1/2000\", \"12/31/2005\", freq=\"h\")\n244 |         self.year, self.month, self.day = rng.year, rng.month, rng.day\n245 |         self.ts = Series(np.random.randn(len(rng)), index=rng)\n246 | \n247 |     def time_len_groupby_object(self):\n248 |         len(self.ts.groupby([self.year, self.month, self.day]))\n```\n\nFound class `pandas/core/arrays/arrow/accessors.py:ArrowAccessor