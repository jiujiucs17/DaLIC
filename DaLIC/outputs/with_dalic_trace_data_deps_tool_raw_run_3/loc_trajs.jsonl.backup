rty-like object.\n203 | \n204 |     A descriptor for accessors.\n205 | \n206 |     Parameters\n207 |     ----------\n208 |     name : str\n209 |         Namespace that will be accessed under, e.g. ``df.foo``.\n210 |     accessor : cls\n211 |         Class with the extension methods.\n212 | \n213 |     Notes\n214 |     -----\n215 |     For accessor, The class's __init__ method assumes that one of\n216 |     ``Series``, ``DataFrame`` or ``Index`` as the\n217 |     single argument ``data``.\n218 |     \"\"\"\n219 | \n220 |     def __init__(self, name: str, accessor) -> None:\n221 |         self._name = name\n222 |         self._accessor = accessor\n223 | \n224 |     def __get__(self, obj, cls):\n225 |         if obj is None:\n226 |             # we're accessing the attribute of the class, i.e., Dataset.geo\n227 |             return self._accessor\n228 |         return self._accessor(obj)\n```\n\nFound file `pandas/core/accessor.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `pandas/core/accessor.py` for the full content if needed.\n\n\n\n##Searching for term \"str accessor\"...\n### Search Result:\nFound function `pandas/core/accessor.py:PandasDelegate._add_delegate_accessors`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 74 | def _add_delegate_accessors(\n 75 |         cls,\n 76 |         delegate,\n 77 |         accessors: list[str],\n 78 |         typ: str,\n 79 |         overwrite: bool = False,\n 80 |         accessor_mapping: Callable[[str], str] = lambda x: x,\n 81 |         raise_on_missing: bool = True,\n 82 |     ) -> None:\n 83 |         \"\"\"\n 84 |         Add accessors to cls from the delegate class.\n 85 | \n 86 |         Parameters\n 87 |         ----------\n 88 |         cls\n 89 |             Class to add the methods/properties to.\n 90 |         delegate\n 91 |             Class to get methods/properties and doc-strings.\n 92 |         accessors : list of str\n 93 |             List of accessors to add.\n 94 |         typ : {'property', 'method'}\n 95 |         overwrite : bool, default False\n 96 |             Overwrite the method/property in the target class if it exists.\n 97 |         accessor_mapping: Callable, default lambda x: x\n 98 |             Callable to map the delegate's function to the cls' function.\n 99 |         raise_on_missing: bool, default True\n100 |             Raise if an accessor does not exist on delegate.\n101 |             False skips the missing accessor.\n102 |         \"\"\"\n103 | \n104 |         def _create_delegator_property(name: str):\n105 |             def _getter(self):\n106 |                 return self._delegate_property_get(name)\n107 | \n108 |             def _setter(self, new_values):\n109 |                 return self._delegate_property_set(name, new_values)\n110 | \n111 |             _getter.__name__ = name\n112 |             _setter.__name__ = name\n113 | \n114 |             return property(\n115 |                 fget=_getter,\n116 |                 fset=_setter,\n117 |                 doc=getattr(delegate, accessor_mapping(name)).__doc__,\n118 |             )\n119 | \n120 |         def _create_delegator_method(name: str):\n121 |             method = getattr(delegate, accessor_mapping(name))\n122 | \n123 |             @functools.wraps(method)\n124 |             def f(self, *args, **kwargs):\n125 |                 return self._delegate_method(name, *args, **kwargs)\n126 | \n127 |             return f\n128 | \n129 |         for name in accessors:\n130 |             if (\n131 |                 not raise_on_missing\n132 |                 and getattr(delegate, accessor_mapping(name), None) is None\n133 |             ):\n134 |                 continue\n135 | \n136 |             if typ == \"property\":\n137 |                 f = _create_delegator_property(name)\n138 |             else:\n139 |                 f = _create_delegator_method(name)\n140 | \n141 |             # don't overwrite existing methods/properties\n142 |