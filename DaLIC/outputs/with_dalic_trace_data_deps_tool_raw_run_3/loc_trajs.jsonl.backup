/ dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\nFound file `galleries/plot_types/basic/bar.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/plot_types/basic/bar.py` for the full content if needed.\n\n\n\n##Searching for term \"def bar(\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar3d`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3049 | def bar3d(self, x, y, z, dx, dy, dz, color=None,\n3050 |               zsort='average', shade=True, lightsource=None, *args,\n3051 |               axlim_clip=False, **kwargs):\n3052 |         \"\"\"\n3053 |         Generate a 3D barplot.\n3054 | \n3055 |         This method creates three-dimensional barplot where the width,\n3056 |         depth, height, and color of the bars can all be uniquely set.\n3057 | \n3058 |         Parameters\n3059 |         ----------\n3060 |         x, y, z : array-like\n3061 |             The coordinates of the anchor point of the bars.\n3062 | \n3063 |         dx, dy, dz : float or array-like\n3064 |             The width, depth, and height of the bars, respectively.\n3065 | \n3066 |         color : sequence of colors, optional\n3067 |             The color of the bars can be specified globally or\n3068 |             individually. This parameter can be:\n3069 | \n3070 |             - A single color, to color all bars the same color.\n3071 |             - An array of colors of length N bars, to color each bar\n3072 |               independently.\n3073 |             - An array of colors of length 6, to color the faces of the\n3074 |               bars similarly.\n3075 |             - An array of colors of length 6 * N bars, to color each face\n3076 |               independently.\n3077 | \n3078 |             When coloring the faces of the boxes specifically, this is\n3079 |             the order of the coloring:\n3080 | \n3081 |             1. -Z (bottom of box)\n3082 |             2. +Z (top of box)\n3083 |             3. -Y\n3084 |             4. +Y\n3085 |             5. -X\n3086 |             6. +X\n3087 | \n3088 |         zsort : {'average', 'min', 'max'}, default: 'average'\n3089 |             The z-axis sorting scheme passed onto `~.art3d.Poly3DCollection`\n3090 | \n3091 |         shade : bool, default: True\n3092 |             When true, this shades the dark sides of the bars (relative\n3093 |             to the plot's source of light).\n3094 | \n3095 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3096 |             The lightsource to use when *shade* is True.\n3097 | \n3098 |         axlim_clip : bool, default: False\n3099 |             Whether to hide the bars with points outside the axes view limits.\n3100 | \n3101 |             .. versionadded:: 3.10\n3102 | \n3103 |         data : indexable object, optional\n3104 |             DATA_PARAMETER_PLACEHOLDER\n3105 | \n3106 |         **kwargs\n3107 |             Any additional keyword arguments are passed onto\n3108 |             `~.art3d.Poly3DCollection`.\n3109 | \n3110 |         Returns\n3111 |         -------\n3112 |         collection : `~.art3d.Poly3DCollection`\n3113 |             A collection of three-dimensional polygons representing the bars.\n3114 |         \"\"\"\n3115 | \n3116 |         had_data = self.has_data()\n3117 | \n3118 |         x, y, z, dx, dy, dz = np.broadcast_arrays(\n3119 |             np.atleast_1d(x), y, z, dx, dy, dz)\n3120 |         minx = np.min(x)\n3121 |         maxx = np.max(x + dx)\n3122 |         miny = np.min(y)\n3123 |         maxy = np.max(y + dy)\n3124 |         minz = np.min(z)\n3125 |         maxz = np.max(z + dz)\n3126 | \n3127 |         # shape (6, 4, 3)\n3128 |         # All faces are oriented facing outwards - when viewed from the\n3129 |         # outside, their vertices are in a counterclockwise ordering.\n3130 |         cuboid = np.array([\n3131 |             # -z\n3132 |             (\n3133 |                 (0, 0, 0),\n3134 |                 (0, 1, 0),\n3135 |                 (1, 1, 0),\n3136 |                 (1, 0, 0),\n3137 |             ),\n3138 |             # +z\n3139 |             (\n3140 |                 (0, 0, 1),\n3141 |                 (1, 0, 1),\n3142 |                 (1, 1, 1),\n3143 |                 (0, 1, 1),\n3144 |             ),\n3145 |             # -y\n3146 |             (\n3147 |                 (0, 0, 0),\n3148 |                 (1, 0, 0),\n3149 |                 (1, 0, 1),\n3150 |                 (0, 0, 1),\n3151 |             ),\n3152 |             # +y\n3153 |             (\n3154 |                 (0, 1, 0),\n3155 |                 (0, 1, 1),\n3156 |                 (1, 1, 1),\n3157 |                 (1, 1, 0),\n3158 |             ),\