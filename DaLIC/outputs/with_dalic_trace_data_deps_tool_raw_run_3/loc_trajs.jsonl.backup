             raise ValueError(\"Value should be exp\")\n642 |     rewrites = Omega.rewrites\n643 |     Omega = list(Omega.items())\n644 | \n645 |     nodes = build_expression_tree(Omega, rewrites)\n646 |     Omega.sort(key=lambda x: nodes[x[1]].ht(), reverse=True)\n647 | \n648 |     # make sure we know the sign of each exp() term; after the loop,\n649 |     # g is going to be the \"w\" - the simplest one in the mrv set\n650 |     for g, _ in Omega:\n651 |         sig = sign(g.exp, x)\n652 |         if sig != 1 and sig != -1 and not sig.has(AccumBounds):\n653 |             raise NotImplementedError('Result depends on the sign of %s' % sig)\n654 |     if sig == 1:\n655 |         wsym = 1/wsym  # if g goes to oo, substitute 1/w\n656 |     # O2 is a list, which results by rewriting each item in Omega using \"w\"\n657 |     O2 = []\n658 |     denominators = []\n659 |     for f, var in Omega:\n660 |         c = limitinf(f.exp/g.exp, x)\n661 |         if c.is_Rational:\n662 |             denominators.append(c.q)\n663 |         arg = f.exp\n664 |         if var in rewrites:\n665 |             if not isinstance(rewrites[var], exp):\n666 |                 raise ValueError(\"Value should be exp\")\n667 |             arg = rewrites[var].args[0]\n668 |         O2.append((var, exp((arg - c*g.exp))*wsym**c))\n669 | \n670 |     # Remember that Omega contains subexpressions of \"e\". So now we find\n671 |     # them in \"e\" and substitute them for our rewriting, stored in O2\n672 | \n673 |     # the following powsimp is necessary to automatically combine exponentials,\n674 |     # so that the .xreplace() below succeeds:\n675 |     # TODO this should not be necessary\n676 |     from sympy.simplify.powsimp import powsimp\n677 |     f = powsimp(e, deep=True, combine='exp')\n678 |     for a, b in O2:\n679 |         f = f.xreplace({a: b})\n680 | \n681 |     for _, var in Omega:\n682 |         assert not f.has(var)\n683 | \n684 |     # finally compute the logarithm of w (logw).\n685 |     logw = g.exp\n686 |     if sig == 1:\n687 |         logw = -logw  # log(w)->log(1/w)=-log(w)\n688 | \n689 |     # Some parts of SymPy have difficulty computing series expansions with\n690 |     # non-integral exponents. The following heuristic improves the situation:\n691 |     exponent = reduce(ilcm, denominators, 1)\n692 |     f = f.subs({wsym: wsym**exponent})\n693 |     logw /= exponent\n694 | \n695 |     # bottom_up function is required for a specific case - when f is\n696 |     # -exp(p/(p + 1)) + exp(-p**2/(p + 1) + p). No current simplification\n697 |     # methods reduce this to 0 while not expanding polynomials.\n698 |     f = bottom_up(f, lambda w: getattr(w, 'normal', lambda: w)())\n699 | \n700 |     return f, logw\n```\n\nFound function `sympy/combinatorics/fp_groups.py:rewrite`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1214 | def rewrite(C, alpha, w):\n1215 |     \"\"\"\n1216 |     Parameters\n1217 |     ==========\n1218 | \n1219 |     C: CosetTable\n1220 |     alpha: A live coset\n1221 |     w: A word in `A*`\n1222 | \n1223 |     Returns\n1224 |     =======\n1225 | \n1226 |     rho(tau(alpha), w)\n1227 | \n1228 |     Examples\n1229 |     ========\n1230 | \n1231 |     >>> from sympy.combinatorics.fp_groups import FpGroup, CosetTable, define_schreier_generators, rewrite\n1232 |     >>> from sympy.combinatorics import free_group\n1233 |     >>> F, x, y = free_group(\"x, y\")\n1234 |     >>> f = FpGroup(F, [x**2, y**3, (x*y)**6])\n1235 |     >>> C = CosetTable(f, [])\n1236 |     >>> C.table = [[1, 1, 2, 3], [0, 0, 4, 5], [4, 4, 3, 0], [5, 5, 0, 2], [2, 2, 5, 1], [3, 3, 1, 4]]\n1237 |     >>> C.p = [0, 1, 2, 3, 4, 5]\n1238 |     >>> define_schreier_generators(C)\n1239 |     >>> rewrite(C, 0, (x*y)**6)\n1240 |     x_4*y_2*x_3*x_1*x_2*y_4*x_5\n1241 | \n1242 |     \"\"\"\n1243 |     v = C._schreier_free_group.identity\n1244 |     for i in range(len(w)):\n1245 |         x_i = w[i]\n1246 |         v = v*C.P[alpha][C.A_dict[x_i]]\n1247 |   