nction.\n 99 |         raise_on_missing: bool, default True\n100 |             Raise if an accessor does not exist on delegate.\n101 |             False skips the missing accessor.\n102 |         \"\"\"\n103 | \n104 |         def _create_delegator_property(name: str):\n105 |             def _getter(self):\n106 |                 return self._delegate_property_get(name)\n107 | \n108 |             def _setter(self, new_values):\n109 |                 return self._delegate_property_set(name, new_values)\n110 | \n111 |             _getter.__name__ = name\n112 |             _setter.__name__ = name\n113 | \n114 |             return property(\n115 |                 fget=_getter,\n116 |                 fset=_setter,\n117 |                 doc=getattr(delegate, accessor_mapping(name)).__doc__,\n118 |             )\n119 | \n120 |         def _create_delegator_method(name: str):\n121 |             method = getattr(delegate, accessor_mapping(name))\n122 | \n123 |             @functools.wraps(method)\n124 |             def f(self, *args, **kwargs):\n125 |                 return self._delegate_method(name, *args, **kwargs)\n126 | \n127 |             return f\n128 | \n129 |         for name in accessors:\n130 |             if (\n131 |                 not raise_on_missing\n132 |                 and getattr(delegate, accessor_mapping(name), None) is None\n133 |             ):\n134 |                 continue\n135 | \n136 |             if typ == \"property\":\n137 |                 f = _create_delegator_property(name)\n138 |             else:\n139 |                 f = _create_delegator_method(name)\n140 | \n141 |             # don't overwrite existing methods/properties\n142 |             if overwrite or not hasattr(cls, name):\n143 |                 setattr(cls, name, f)\n```\n\nFound function `pandas/core/accessor.py:delegate_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n146 | def delegate_names(\n147 |     delegate,\n148 |     accessors: list[str],\n149 |     typ: str,\n150 |     overwrite: bool = False,\n151 |     accessor_mapping: Callable[[str], str] = lambda x: x,\n152 |     raise_on_missing: bool = True,\n153 | ):\n154 |     \"\"\"\n155 |     Add delegated names to a class using a class decorator.  This provides\n156 |     an alternative usage to directly calling `_add_delegate_accessors`\n157 |     below a class definition.\n158 | \n159 |     Parameters\n160 |     ----------\n161 |     delegate : object\n162 |         The class to get methods/properties & doc-strings.\n163 |     accessors : Sequence[str]\n164 |         List of accessor to add.\n165 |     typ : {'property', 'method'}\n166 |     overwrite : bool, default False\n167 |        Overwrite the method/property in the target class if it exists.\n168 |     accessor_mapping: Callable, default lambda x: x\n169 |         Callable to map the delegate's function to the cls' function.\n170 |     raise_on_missing: bool, default True\n171 |         Raise if an accessor does not exist on delegate.\n172 |         False skips the missing accessor.\n173 | \n174 |     Returns\n175 |     -------\n176 |     callable\n177 |         A class decorator.\n178 | \n179 |     Examples\n180 |     --------\n181 |     @delegate_names(Categorical, [\"categories\", \"ordered\"], \"property\")\n182 |     class CategoricalAccessor(PandasDelegate):\n183 |         [...]\n184 |     \"\"\"\n185 | \n186 |     def add_delegate_accessors(cls):\n187 |         cls._add_delegate_accessors(\n188 |             delegate,\n189 |             accessors,\n190 |             typ,\n191 |             overwrite=overwrite,\n192 |             accessor_mapping=accessor_mapping,\n193 |             raise_on_missing=raise_on_missing,\n194 |         )\n195 |         return cls\n196 | \n197 |     return add_delegate_accessors\n```\n\nFound function `pandas/core/accessor.py:_register_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n237 | def _register_accessor(\n238 |     name: str, cls: type[NDFrame | Index]\n239 | ) -> Callable[[TypeT], TypeT]:\n240 |     \"\"\"\n241 |     Register a custom accessor on {klass} objects.\n242 | \n243 |     Parameters\n244 |     ----------\n245 |     name : str\n246 |         Name under which the accessor should be registered. A warning is issued\n247 |         if this name conflicts with a preexisting attribute.\n248 | \n249 |     Returns\n250 |     -------\n251 |     callable\n252 |         A class decorator.\n253 | \n254 |     See Also\n255 |     --------\n256 |     register_dataframe_accessor : Register a custom accessor on DataFrame objects.\n257 |     register_series_accessor : Register a custom accessor on Series objects.\n258 |     register_index_accessor : Register a custom accessor on Index objects.\n259 | \n260 |     Notes\n261 |     -----\n262 |     This function allows you to register a custom-defined accessor class for {klass}.\n263 |     The requirements for the accessor class are as follows:\n264 | \n265 |     * Must contain an init method that:\n266 | \n267 |       * accepts a single {klass} object\n268 | \n269 |       * raises an AttributeError if the {klass} object does not have correctly\n270 |         matching inputs for the accessor\n271 | \n272 |     * Must contain a method for each access pattern.\n273 | \n274 |       * The methods should be able to take any argument signature.\n275 | \n276 |       * Accessible using the @property decorator if no additional arguments are\n277 |         needed.\n278 | \n279 |     Examples\n280 |     --------\n281 |     {examples}\n282 |     \"\"\"\n283 | \n284 |     def decorator(accessor: TypeT) -> TypeT:\n285 |         if hasattr(cls, name):\n286 |             warnings.warn(\n287 |                 f\"registration of accessor {accessor!r} under name \"\n288 |                 f\"{name!r} for type {cls!r} is overriding a preexisting \"\n289 |                 f\"attribute with the same name.\",\n290 |                 UserWarning,\n291 |                 stack