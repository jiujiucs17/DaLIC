n 2 | ==================\n 3 | Animated histogram\n 4 | ==================\n 5 | \n 6 | Use histogram's `.BarContainer` to draw a bunch of rectangles for an animated\n 7 | histogram.\n 8 | \"\"\"\n 9 | \n10 | import functools\n11 | \n12 | import matplotlib.pyplot as plt\n13 | import numpy as np\n14 | \n15 | import matplotlib.animation as animation\n16 | \n17 | # Setting up a random number generator with a fixed state for reproducibility.\n18 | rng = np.random.default_rng(seed=19680801)\n19 | # Fixing bin edges.\n20 | HIST_BINS = np.linspace(-4, 4, 100)\n21 | \n22 | # Histogram our data with numpy.\n23 | data = rng.standard_normal(1000)\n24 | n, _ = np.histogram(data, HIST_BINS)\n25 | \n26 | # %%\n27 | # To animate the histogram, we need an ``animate`` function, which generates\n28 | # a random set of numbers and updates the heights of rectangles. The ``animate``\n29 | # function updates the `.Rectangle` patches on an instance of `.BarContainer`.\n30 | \n31 | \n32 | def animate(frame_number, bar_container):\n33 |     # Simulate new data coming in.\n34 |     data = rng.standard_normal(1000)\n35 |     n, _ = np.histogram(data, HIST_BINS)\n36 |     for count, rect in zip(n, bar_container.patches):\n37 |         rect.set_height(count)\n38 | \n39 |     return bar_container.patches\n40 | \n41 | # %%\n42 | # Using :func:`~matplotlib.pyplot.hist` allows us to get an instance of\n43 | # `.BarContainer`, which is a collection of `.Rectangle` instances.  Since\n44 | # `.FuncAnimation` will only pass the frame number parameter to the animation\n45 | # function, we use `functools.partial` to fix the ``bar_container`` parameter.\n46 | \n47 | # Output generated via `matplotlib.animation.Animation.to_jshtml`.\n48 | \n49 | fig, ax = plt.subplots()\n50 | _, _, bar_container = ax.hist(data, HIST_BINS, lw=1,\n51 |                               ec=\"yellow\", fc=\"green\", alpha=0.5)\n52 | ax.set_ylim(top=55)  # set safe limit to ensure that all data is visible.\n53 | \n54 | anim = functools.partial(animate, bar_container=bar_container)\n55 | ani = animation.FuncAnimation(fig, anim, 50, repeat=False, blit=True)\n56 | plt.show()\n57 | \n58 | # %%\n59 | # .. tags:: plot-type: histogram, animation\n60 | \n```\n\nFound function `lib/matplotlib/__init__.py:get_cachedir`.\nSource: Retrieved entity using keyword search (bm25).\n```\n580 | def get_cachedir():\n581 |     \"\"\"\n582 |     Return the string path of the cache directory.\n583 | \n584 |     The procedure used to find the directory is the same as for\n585 |     `get_configdir`, except using ``$XDG_CACHE_HOME``/``$HOME/.cache`` instead.\n586 |     \"\"\"\n587 |     return _get_config_or_cache_dir(_get_xdg_cache_dir)\n```\n\nFound function `lib/matplotlib/__init__.py:get_data_path`.\nSource: Retrieved entity using keyword search (bm25).\n```\n591 | def get_data_path():\n592 |     \"\"\"Return the path to Matplotlib data.\"\"\"\n593 |     return str(Path(__file__).with_name(\"mpl-data\"))\n```\n\nFound function `lib/matplotlib/pyplot.py:bar_label`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3021 | def bar_label(\n3022 |     container: BarContainer,\n3023 |     labels: ArrayLike | None = None,\n3024 |     *,\n3025 |     fmt: str | Callable[[float], str] = \"%g\",\n3026 |     label_type: Literal[\"center\", \"edge\"] = \"edge\",\n3027 |     padding: float = 0,\n3028 |     **kwargs,\n3029 | ) -> list[Annotation]:\n3030 |     return gca().bar_label(\n3031 |         container,\n3032 |         labels=labels,\n3033 |         fmt=fmt,\n3034 |         label_type=label_type,\n3035 |         padding=padding,\n3036 |         **kwargs,\n3037 |     )\n```\n\nFound function `lib/matplotlib/pyplot.py:hexbin`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3390 | def hexbin(\n3391 |     x: ArrayLike,\n3392 |     y: ArrayLike,\n3393 |     C: ArrayLike | None = None,\n3394 |     gridsize: int | tuple[int, int] = 100,\n3395 |     bins: Literal[\"log\"] | int | Sequence[float