s equal to the after_sequence, read contains\n375 |             # the long double\n376 |             if read[-8:] == _AFTER_SEQ:\n377 |                 saw = copy.copy(read)\n378 |                 # if the content was 12 bytes, we only have 32 - 8 - 12 = 12\n379 |                 # \"before\" bytes. In other words the first 4 \"before\" bytes went\n380 |                 # past the sliding window.\n381 |                 if read[:12] == _BEFORE_SEQ[4:]:\n382 |                     if read[12:-8] == _INTEL_EXTENDED_12B:\n383 |                         return 'INTEL_EXTENDED_12_BYTES_LE'\n384 |                     if read[12:-8] == _MOTOROLA_EXTENDED_12B:\n385 |                         return 'MOTOROLA_EXTENDED_12_BYTES_BE'\n386 |                 # if the content was 16 bytes, we are left with 32-8-16 = 16\n387 |                 # \"before\" bytes, so 8 went past the sliding window.\n388 |                 elif read[:8] == _BEFORE_SEQ[8:]:\n389 |                     if read[8:-8] == _INTEL_EXTENDED_16B:\n390 |                         return 'INTEL_EXTENDED_16_BYTES_LE'\n391 |                     elif read[8:-8] == _IEEE_QUAD_PREC_BE:\n392 |                         return 'IEEE_QUAD_BE'\n393 |                     elif read[8:-8] == _IEEE_QUAD_PREC_LE:\n394 |                         return 'IEEE_QUAD_LE'\n395 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_LE:\n396 |                         return 'IBM_DOUBLE_DOUBLE_LE'\n397 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_BE:\n398 |                         return 'IBM_DOUBLE_DOUBLE_BE'\n399 |                 # if the content was 8 bytes, left with 32-8-8 = 16 bytes\n400 |                 elif read[:16] == _BEFORE_SEQ:\n401 |                     if read[16:-8] == _IEEE_DOUBLE_LE:\n402 |                         return 'IEEE_DOUBLE_LE'\n403 |                     elif read[16:-8] == _IEEE_DOUBLE_BE:\n404 |                         return 'IEEE_DOUBLE_BE'\n405 | \n406 |     if saw is not None:\n407 |         raise ValueError(\"Unrecognized format (%s)\" % saw)\n408 |     else:\n409 |         # We never detected the after_sequence\n410 |         raise ValueError(\"Could not lock sequences (%s)\" % saw)\n```\n\n\n\n##Searching for term \"sliding window\"...\n### Search Result:\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.__repr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n306 | def __repr__(self):\n307 |         coef = repr(self.coef)[6:-1]\n308 |         domain = repr(self.domain)[6:-1]\n309 |         window = repr(self.window)[6:-1]\n310 |         name = self.__class__.__name__\n311 |         return f\"{name}({coef}, domain={domain}, window={window})\"\n```\n\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.convert`.\nSource: Retrieved code content using keyword search (bm25).\n```\n732 | def convert(self, domain=None, kind=None, window=None):\n733 |         \"\"\"Convert series to a different kind and/or domain and/or window.\n734 | \n735 |         Parameters\n736 |         ----------\n737 |         domain : array_like, optional\n738 |             The domain of the converted series. If the value is None,\n739 |             the default domain of `kind` is used.\n740 |         kind : class, optional\n741 |             The polynomial series type class to which the current instance\n742 |             should be converted. If kind is None, then the class of the\n743 |             current instance is used.\n744 |         window : array_like, optional\n745 |             The window of the converted series. If the value is None,\n746 |             the default window of `kind` is used.\n747 | \n748 |         Returns\n749 |         -------\n750 |         new_series : series\n751 |             The returned class can be of different type than the current\n752 |             instance and/or have a different domain and/or different\n753 |             window.\n754 | \n755 |         Notes\n756 |         -----\n757 |         Conversion between domains and class types can result in\n758 |         numerically ill defined series.\n759 | \n760 |         Examples\n761 |         --------\n762 | \n763 |         \"\"\"\n764 |         if kind is None:\n765 |             kind = self.__class__\n766 |         if domain is None:\n767 |             domain = kind.domain\n768 |         if window is None:\n769 |             window = kind.window\n770 |         return self(kind.identity(domain, window=window))\n```\n\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n904 | def fit(cls, x, y, deg, domain=None, rcond=None, full=False, w=None,\n905 |         window=None):\n906 |         \"\"\"Least squares fit to data.\n907 | \n908 |         Return a series instance that is the least squares fit to the data\n909 |         `y` sampled at `x`. The domain of the returned instance can be\n910 |         specified and this will often result in a superior fit with less\n911 |         chance of ill conditioning.\n912 | \n913 |         Parameters\n914 |         ----------\n915 |         x : array_like, shape (M,)\n916 |             x-coordinates of the M sample points ``(x[i], y[i])``.\n917 |         y : array_like, shape (M,)\n918 |             y-coordinates of the M sample points ``(x[i], y[i])``.\n919 |         deg : int or 1-D array_like\n920 |             Degree(s) of the fitting polynomials. If `deg` is a single integer\n921 |             all terms up to and including the `deg`'th term are included in the\n922 |             fit. For NumPy versions >= 1.11.0 a list of integers specifying the\n923 |             degrees of the terms to include may be used instead.\n924 |         domain : {None, [beg, end], []}, optional\n925 |             Domain to use for the returned series. If ``None``,\n926 |             then a minimal domain that covers the points `x` is chosen.  If\n927 |             ``[]`` the class domain is used. The default value was the\n928 |             class domain in NumPy 1.4 and ``None`` in later versions.\n929 |             The ``[]`` option was added in numpy 1.5.0.\n930 |         rcond : float, optional\n931 |             Relative condition number of the fit. Singular values smaller\n932 |             than this relative to the largest singular value will be\n933 |             ignored. The default value is len(x)*eps, where eps is the\n934 |             relative precision of the float type, about 2e-16 in most\n935 |             cases.\n936 |         full : bool, optional\n937 |             Switch determining nature of return value. When it is False\n938 |             (the default) just the coefficients are returned, when True\n939 |             diagnostic information from the singular value decomposition is\n940 |             also returned.\n941 |         w : array_like, shape (M,), optional\n942 |             Weights. If not None the contribution of each point\n943 |             ``(x[i],y[i])`` to the fit is weighted by `w[i]`. Ideally the\n944 |             weights are chosen so that the errors of the products\n945 |             ``w[i]*y[i]`` all have the same variance.  The default value is\n946 |             None.\n947 | \n948 |             .. versionadded:: 1.5.0\n949 |         window : {[beg, end]}, optional\n950 |             Window to use for the returned series. The default\n951 |             value is the default class domain\n952 | \n953 |             .. versionadded:: 1.6.0\n954 | \n955 |         Returns\n956 |         -------\n957 |         new_series : series\n958 |             A series that represents the least squares fit to the data and\n959 |             has the domain and window specified in the call. If the\n960 |             coefficients for the unscaled and unshifted basis polynomials are\n961 |             of interest, do ``new_series.convert().coef``.\n962 | \n963 |         [resid, rank, sv, rcond] : list\n964 |             These values are only returned if `full` = True\n965 | \n966 |             resid -- sum of squared residuals of the least squares fit\n967 |             rank -- the numerical rank of the scaled Vandermonde matrix\n968 |             sv -- singular values of the scaled Vandermonde matrix\n969 |             rcond -- value of `rcond`.\n970 | \n971 |             For more details, see `linalg.lstsq`.\n972 | \n973 |         \"\"\"\n974 |         if domain is None:\n975 |             domain = pu.getdomain(x)\n976 |         elif type(domain) is list and len(domain) == 0:\n977 |             domain = cls.domain\n978 | \n979 |         if window is None:\n980 |             window = cls.window\n981 | \n982 |         xnew = pu.mapdomain(x, domain, window)\n983 |         res = cls._fit(xnew, y, deg, w=w, rcond=rcond, full=full)\n984 |         if full:\n985 |             [coef, status] = res\n986 |             return cls(coef, domain=domain, window=window), status\n987 |         else:\n988 |             coef = res\n989 |             return cls(coef, domain=domain, window=window)\n```\n\n\n\n##Searching for term \"vectorized computing\"...\n### Search Result:\nFound class `numpy/lib/function_base.py:vectorize`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass vectorize:\n    def __init__(self, pyfunc, otypes=None, doc=None, excluded=None,\n                 cache=False, signature=None):\n...\n    def __call__(self, *args, **kwargs):\n...\n    def _get_ufunc_and_otypes(self, func, args):\n...\n    def _vectorize_call(self, func, args):\n...\n    def _vectorize_call_with_signature(self, func, args):\n\n```\nHint: Search `numpy/lib/function_base.py:vectorize` to get the full content if needed.\n\nFound function `numpy/linalg/linalg.py:eig`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1188 | def eig(a):\n1189 |     \"\"\"\n1190 |     Compute the eigenvalues and right eigenvectors of a square array.\n1191 | \n1192 |     Parameters\n1193 |     ----------\n1194 |     a : (..., M, M) array\n1195 |         Matrices for which the eigenvalues and right eigenvectors will\n1196 |         be computed\n1197 | \n1198 |     Returns\n1199 |     -------\n1200 |     w : (..., M) array\n1201 |         The eigenvalues, each repeated according to its multiplicity.\n1202 |         The eigenvalues are not necessarily ordered. The resulting\n1203 |         array will be of complex type, unless the imaginary part is\n1204 |         zero in which case it will be cast to a real type. When `a`\n1205 |         is real the resulting eigenvalues will be real (0 imaginary\n1206 |         part) or occur in conjugate pairs\n1207 | \n1208 |     v : (..., M, M) array\n1209 |         The normalized (unit \"length\") eigenvectors, such that the\n1210 |         column ``v[:,i]`` is the eigenvector corresponding to the\n1211 |         eigenvalue ``w[i]``.\n1212 | \n1213 |     Raises\n1214 |     ------\n1215 |     LinAlgError\n1216 |         If the eigenvalue computation does not converge.\n1217 | \n1218 |     See Also\n1219 |     --------\n1220 |     eigvals : eigenvalues of a non-symmetric array.\n1221 |     eigh : eigenvalues and eigenvectors of a real symmetric or complex\n1222 |            Hermitian (conjugate symmetric) array.\n1223 |     eigvalsh : eigenvalues of a real symmetric or complex Hermitian\n1224 |                (conjugate symmetric) array.\n1225 |     scipy.linalg.eig : Similar function in SciPy that also solves the\n1226 |                        generalized eigenvalue problem.\n1227 |     scipy.linalg.schur : Best choice for unitary and other non-Hermitian\n1228 |                          normal matrices.\n1229 | \n1230 |     Notes\n1231 |     -----\n1232 | \n1233 |     .. versionadded:: 1.8.0\n1234 | \n1235 |     Broadcasting rules apply, see the `numpy.linalg` documentation for\n1236 |     details.\n1237 | \n1238 |     This is implemented using the ``_geev`` LAPACK routines which compute\n1239 |     the eigenvalues and eigenvectors of general square arrays.\n1240 | \n1241 |     The number `w` is an eigenvalue of `a` if there exists a vector\n1242 |     `v` such that ``a @ v = w * v``. Thus, the arrays `a`, `w`, and\n1243 |     `v` satisfy the equations ``a @ v[:,i] = w[i] * v[:,i]``\n1244 |     for :math:`i \\\\in \\\\{0,...,M-1\\\\}`.\n1245 | \n1246 |     The array `v` of eigenvectors may not be of maximum rank, that is, some\n1247 |     of the columns may be linearly dependent, although round-off error may\n1248 |     obscure that fact. If the eigenvalues are all different, then theoretically\n1249 |     the eigenvectors are linearly independent and `a` can be diagonalized by\n1250 |     a similarity transformation using `v`, i.e, ``inv(v) @ a @ v`` is diagonal.\n1251 | \n1252 |     For non-Hermitian normal matrices the SciPy function `scipy.linalg.schur`\n1253 |     is preferred because the matrix `v` is guaranteed to be unitary, which is\n1254 |     not the case when using `eig`. The Schur factorization produces an\n1255 |     upper triangular matrix rather than a diagonal matrix, but for normal\n1256 |     matrices only the diagonal of the upper triangular matrix is needed, the\n1257 |     rest is roundoff error.\n1258 | \n1259 |     Finally, it is emphasized that `v` consists of the *right* (as in\n1260 |     right-hand side) eigenvectors of `a`.  A vector `y` satisfying\n1261 |     ``y.T @ a = z * y.T`` for some number `z` is called a *left*\n1262 |     eigenvector of `a`, and, in general, the left and right eigenvectors\n1263 |     of a matrix are not necessarily the (perhaps conjugate) transposes\n1264 |     of each other.\n1265 | \n1266 |     References\n1267 |     ----------\n1268 |     G. Strang, *Linear Algebra and Its Applications*, 2nd Ed., Orlando, FL,\n1269 |     Academic Press, Inc., 1980, Various pp.\n1270 | \n1271 |     Examples\n1272 |     --------\n1273 |     >>> from numpy import linalg as LA\n1274 | \n1275 |     (Almost) trivial example with real e-values and e-vectors.\n1276 | \n1277 |     >>> w, v = LA.eig(np.diag((1, 2, 3)))\n1278 |     >>> w; v\n1279 |     array([1., 2., 3.])\n1280 |     array([[1., 0., 0.],\n1281 |            [0., 1., 0.],\n1282 |            [0., 0., 1.]])\n1283 | \n1284 |     Real matrix possessing complex e-values and e-vectors; note that the\n1285 |     e-values are complex conjugates of each other.\n1286 | \n1287 |     >>> w, v = LA.eig(np.array([[1, -1], [1, 1]]))\n1288 |     >>> w; v\n1289 |     array([1.+1.j, 1.-1.j])\n1290 |     array([[0.70710678+0.j        , 0.70710678-0.j        ],\n1291 |            [0.        -0.70710678j, 0.        +0.70710678j]])\n1292 | \n1293 |     Complex-valued matrix with real e-values (but complex-valued e-vectors);\n1294 |     note that ``a.conj().T == a``, i.e., `a` is Hermitian.\n1295 | \n1296 |     >>> a = np.array([[1, 1j], [-1j, 1]])\n1297 |     >>> w, v = LA.eig(a)\n1298 |     >>> w; v\n1299 |     array([2.+0.j, 0.+0.j])\n1300 |     array([[ 0.        +0.70710678j,  0.70710678+0.j        ], # may vary\n1301 |            [ 0.70710678+0.j        , -0.        +0.70710678j]])\n1302 | \n1303 |     Be careful about round-off error!\n1304 | \n1305 |     >>> a = np.array([[1 + 1e-9, 0], [0, 1 - 1e-9]])\n1306 |     >>> # Theor. e-values are 1 +/- 1e-9\n1307 |     >>> w, v = LA.eig(a)\n1308 |     >>> w; v\n1309 |     array([1., 1.])\n1310 |     array([[1., 0.],\n1311 |            [0., 1.]])\n1312 | \n1313 |     \"\"\"\n1314 |     a, wrap = _makearray(a)\n1315 |     _assert_stacked_2d(a)\n1316 |     _assert_stacked_square(a)\n1317 |     _assert_finite(a)\n1318 |     t, result_t = _commonType(a)\n1319 | \n1320 |     extobj = get_linalg_error_extobj(\n1321 |         _raise_linalgerror_eigenvalues_nonconvergence)\n1322 |     signature = 'D->DD' if isComplexType(t) else 'd->DD'\n1323 |     w, vt = _umath_linalg.eig(a, signature=signature, extobj=extobj)\n1324 | \n1325 |     if not isComplexType(t) and all(w.imag == 0.0):\n1326 |         w 