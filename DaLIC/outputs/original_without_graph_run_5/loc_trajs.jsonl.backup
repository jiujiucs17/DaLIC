, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n\n\n\n##Searching for term \"beta divergence\"...\n### Search Result:\nFound code snippet in file `examples/decomposition/plot_beta_divergence.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==============================\n 3 | Beta-divergence loss functions\n 4 | ==============================\n 5 | \n 6 | A plot that compares the various Beta-divergence loss functions supported by\n 7 | the Multiplicative-Update ('mu') solver in :class:`~sklearn.decomposition.NMF`.\n 8 | \n 9 | \"\"\"\n10 | \n11 | import numpy as np\n12 | import matplotlib.pyplot as plt\n13 | from sklearn.decomposition._nmf import _beta_divergence\n14 | \n15 | x = np.linspace(0.001, 4, 1000)\n16 | y = np.zeros(x.shape)\n17 | \n18 | colors = \"mbgyr\"\n19 | for j, beta in enumerate((0.0, 0.5, 1.0, 1.5, 2.0)):\n20 |     for i, xi in enumerate(x):\n21 |         y[i] = _beta_divergence(1, xi, 1, beta)\n22 |     name = \"beta = %1.1f\" % beta\n23 |     plt.plot(x, y, label=name, color=colors[j])\n24 | \n25 | plt.xlabel(\"x\")\n26 | plt.title(\"beta-divergence(1, x)\")\n27 | plt.legend(loc=0)\n28 | plt.axis([0, 4, 0, 3])\n29 | plt.show()\n30 | \n```\n\nFound function `sklearn/decomposition/_nmf.py:_beta_divergence`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 68 | def _beta_divergence(X, W, H, beta, square_root=False):\n 69 |     \"\"\"Compute the beta-divergence of X and dot(W, H).\n 70 | \n 71 |     Parameters\n 72 |     ----------\n 73 |     X : float or array-like of shape (n_samples, n_features)\n 74 | \n 75 |     W : float or array-like of shape (n_samples, n_components)\n 76 | \n 77 |     H : float or array-like of shape (n_components, n_features)\n 78 | \n 79 |     beta : float or {'frobenius', 'kullback-leibler', 'itakura-saito'}\n 80 |         Parameter of the beta-divergence.\n 81 |         If beta == 2, this is half the Frobenius *squared* norm.\n 82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n 83 |         If beta == 0, this is the Itakura-Saito divergence.\n 84 |         Else, this is the general beta-divergence.\n 85 | \n 86 |     square_root : bool, default=False\n 87 |         If True, return np.sqrt(2 * res)\n 88 |         For beta == 2, it corresponds to the Frobenius norm.\n 89 | \n 90 |     Returns\n 91 |     -------\n 92 |         res : float\n 93 |             Beta divergence of X and np.dot(X, H).\n 94 |     \"\"\"\n 95 |     beta = _beta_loss_to_float(beta)\n 96 | \n 97 |     # The method can be called with scalars\n 98 |     if not sp.issparse(X):\n 99 |         X = np.atleast_2d(X)\n100 |     W = np.atleast_2d(W)\n101 |     H = np.atleast_2d(H)\n102 | \n103 |     # Frobenius norm\n104 |     if beta == 2:\n105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n106 |         if sp.issparse(X):\n107 |             norm_X = np.dot(X.data, X.data)\n108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n109 |             cross_prod = trace_dot((X * H.T), W)\n110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n111 |         else:\n112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n\nFound function `sklearn/manifold/_t_sne.py:_kl_divergence`.\nSource: Retrieved entity using keyword search (bm25).\n```\n126 | def _kl_divergence(\n127 |     params,\n128 |     P,\n129 |     degrees_of_freedom,\n130 |     n_samples,\n131 |     n_components,\n132 |     skip_num_points=0,\n133 |     compute_error=True,\n134 | ):\n135 |     \"\"\"t-SNE objective function: gradient of the KL divergence\n136 |     of p_ijs and q_ijs and the absolute error.\n137 | \n138 |     Parameters\n139 |     ----------\n140 |     params : ndarray of shape (n_params,)\n141 |         Unraveled embedding.\n142 | \n143 |     P : ndarray of shape (n_samples * (n_samples-1) / 2,)\n144 |         Condensed joint probability matrix.\n145 | \n146 |     degrees_of_freedom : int\n147 |         Degrees of freedom of the Student's-t distribution.\n148 | \n149 |     n_samples : int\n150 |         Number of samples.\n151 | \n152 |     n_components : int\n153 |         Dimension of the embedded space.\n154 | \n155 |     skip_num_points : int, default=0\n156 |         This does not compute the gradient for points with indices below\n157 |         `skip_num_points`. This is useful when computing transforms of new\n158 |         data where you'd like to keep the old data fixed.\n159 | \n160 |     compute_error: bool, default=True\n161 |         If False, the kl_divergence is not computed and returns NaN.\n162 | \n163 |     Returns\n164 |     -------\n165 |     kl_divergence : float\n166 |         Kullback-Leibler divergence of p_ij and q_ij.\n167 | \n168 |     grad : ndarray of shape (n_params,)\n169 |         Unraveled gradient of the Kullback-Leibler divergence with respect to\n170 |         the embedding.\n171 |     \"\"\"\n172 |     X_embedded = params.reshape(n_samples, n_components)\n173 | \n174 |     # Q is a heavy-tailed distribution: Student's t-distribution\n175 |     dist = pdist(X_embedded, \"sqeuclidean\")\n176 |     dist /= degrees_of_freedom\n177 |     dist += 1.0\n178 |     dist **= (degrees_of_freedom + 1.0) / -2.0\n179 |     Q = np.maximum(dist / (2.0 * np.sum(dist)), MACHINE_EPSILON)\n180 | \n181 |     # Optimization trick below: np.dot(x, y) is faster than\n182 |     # np.sum(x * y) because it calls BLAS\n183 | \n184 |     # Objective: C (Kullback-Leibler divergence of P and Q)\n185 |     if compute_error:\n186 |         kl_divergence = 2.0 * np.dot(P, np.log(np.maximum(P, MACHINE_EPSILON) / Q))\n187 |     else:\n188 |         kl_divergence = np.nan\n189 | \n190 |     # Gradient: dC/dY\n191 |     # pdist always returns double precision distances. Thus we need to take\n192 |     grad = np.ndarray((n_samples, n_components), dtype=params.dtype)\n193 |     PQd = squareform((P - Q) * dist)\n194 |     for i in range(skip_num_points, n_samples):\n195 |         grad[i] = np.dot(np.ravel(PQd[i], order=\"K\"), X_embedded[i] - X_embedded)\n196 |     grad = grad.ravel()\n197 |     c = 2.0 * (degrees_of_freedom + 1.0) / degrees_of_freedom\n198 |     grad *= c\n199 | \n200 |     return kl_divergence, grad\n```\n\nFound file `examples/decomposition/plot_beta_divergence.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/decomposition/plot_beta_divergence.py` for the full content if needed.\n\n\n\n##Searching for term \"beta divergence\", \"MiniBatchNMF Non-negative Matrix Factorization beta divergence multiplicative updates\"...\n### Search Result:\nFound class `sklearn/decomposition/_nmf.py:NMF`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n\n    def __init__(\n        self,\n        n_components=None,\n        *,\n        init=None,\n        solver=\"cd\",\n        beta_loss=\"frobenius\",\n        tol=1e-4,\n        max_iter=200,\n        random_state=None,\n        alpha=\"deprecated\",\n        alpha_W=0.0,\n        alpha_H=\"same\",\n        l1_ratio=0.0,\n        verbose=0,\n        shuffle=False,\n        regularization=\"deprecated\",\n    ):\n...\n    def _more_tags(self):\n...\n    def _check_params(self, X):\n...\n    def _check_w_h(self, X, W, H, update_H):\n...\n    def _scale_regularization(self, X):\n...\n    def fit_transform(self, X, y=None, W=None, H=None):\n...\n    def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n...\n    def fit(self, X, y=None, **params):\n...\n    def transform(self, X):\n...\n    def inverse_transform(self, W):\n...\n    @property\n    def _n_features_out(self):\n\n```\nHint: Search `sklearn/decomposition/_nmf.py:NMF` to get the full content if needed.\n\n\n\n##Searching for term \"multiplicative updates\", \"MiniBatchNMF Non-negative Matrix Factorization beta divergence multip