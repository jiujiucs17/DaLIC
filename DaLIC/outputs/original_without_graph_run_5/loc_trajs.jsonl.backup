|     \"load_linnerud\",\n 81 |     \"load_sample_image\",\n 82 |     \"load_sample_images\",\n 83 |     \"load_svmlight_file\",\n 84 |     \"load_svmlight_files\",\n 85 |     \"load_wine\",\n 86 |     \"make_biclusters\",\n 87 |     \"make_blobs\",\n 88 |     \"make_circles\",\n 89 |     \"make_classification\",\n 90 |     \"make_checkerboard\",\n 91 |     \"make_friedman1\",\n 92 |     \"make_friedman2\",\n 93 |     \"make_friedman3\",\n 94 |     \"make_gaussian_quantiles\",\n 95 |     \"make_hastie_10_2\",\n 96 |     \"make_low_rank_matrix\",\n 97 |     \"make_moons\",\n 98 |     \"make_multilabel_classification\",\n 99 |     \"make_regression\",\n100 |     \"make_s_curve\",\n101 |     \"make_sparse_coded_signal\",\n102 |     \"make_sparse_spd_matrix\",\n103 |     \"make_sparse_uncorrelated\",\n104 |     \"make_spd_matrix\",\n105 |     \"make_swiss_roll\",\n106 | ]\n```\n\nFound function `sklearn/utils/_tags.py:get_tags`.\nSource: Retrieved entity using keyword search (bm25).\n```\n293 | def get_tags(estimator) -> Tags:\n294 |     \"\"\"Get estimator tags.\n295 | \n296 |     :class:`~sklearn.BaseEstimator` provides the estimator tags machinery.\n297 |     However, if an estimator does not inherit from this base class, we should\n298 |     fall-back to the default tags.\n299 | \n300 |     For scikit-learn built-in estimators, we should still rely on\n301 |     `self.__sklearn_tags__()`. `get_tags(est)` should be used when we\n302 |     are not sure where `est` comes from: typically\n303 |     `get_tags(self.estimator)` where `self` is a meta-estimator, or in\n304 |     the common checks.\n305 | \n306 |     .. versionadded:: 1.6\n307 | \n308 |     Parameters\n309 |     ----------\n310 |     estimator : estimator object\n311 |         The estimator from which to get the tag.\n312 | \n313 |     Returns\n314 |     -------\n315 |     tags : :class:`~.sklearn.utils.Tags`\n316 |         The estimator tags.\n317 |     \"\"\"\n318 | \n319 |     if hasattr(estimator, \"__sklearn_tags__\"):\n320 |         tags = estimator.__sklearn_tags__()\n321 |     else:\n322 |         warnings.warn(\n323 |             f\"Estimator {estimator} has no __sklearn_tags__ attribute, which is \"\n324 |             \"defined in `sklearn.base.BaseEstimator`. This will raise an error in \"\n325 |             \"scikit-learn 1.8. Please define the __sklearn_tags__ method, or inherit \"\n326 |             \"from `sklearn.base.BaseEstimator` and other appropriate mixins such as \"\n327 |             \"`sklearn.base.TransformerMixin`, `sklearn.base.ClassifierMixin`, \"\n328 |             \"`sklearn.base.RegressorMixin`, and `sklearn.base.ClusterMixin`, and \"\n329 |             \"`sklearn.base.OutlierMixin`.\",\n330 |             category=FutureWarning,\n331 |         )\n332 |         tags = default_tags(estimator)\n333 | \n334 |     return tags\n```\n\n\n\n##Searching for term \"_get_tags\", \"_more_tags\", \"_safe_tags\", \"__sklearn_tags__\"...\n### Search Result:\nFound function `sklearn/multiclass.py:OneVsRestClassifier.__sklearn_tags__`.\nSource: Retrieved entity using keyword search (bm25).\n```\n600 | def __sklearn_tags__(self):\n601 |         \"\"\"Indicate if wrapped estimator is using a precomputed Gram matrix\"\"\"\n602 |         tags = super().__sklearn_tags__()\n603 |         tags.input_tags.pairwise = get_tags(self.estimator).input_tags.pairwise\n604 |         return tags\n```\n\nFound function `sklearn/multiclass.py:OneVsOneClassifier.__sklearn_tags__`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1003 | def __sklearn_tags__(self):\n1004 |         \"\"\"Indicate if wrapped estimator is using a precomputed Gram matrix\"\"\"\n1005 |         tags = super().__sklearn_tags__()\n1006 |         tags.input_tags.pairwise = get_tags(self.estimator).input_tags.pairwise\n1007 |         return tags\n```\n\n\n\n##Searching for term \"_get_tags\", \"_more_tags\", \"_get_tags _more_tags _safe_tags deprecation warning tags conversion\"...\n### Search Result:\nFound function `sklearn/utils/estimator_checks.py:check_estimator_tags_renamed`.\nSource: Retrieved code content using keyword search (bm25).\n```\n4447 | def check_estimator_tags_renamed(name, estimator_orig):\n4448 |     help = \"\"\"{tags_func}() was removed in 1.6. Please use __sklearn_tags__ instead.\n4449 | You can implement both __sklearn_tags__() and {tags_func}() to support multiple\n4450 | scikit-learn versions.\n4451 | \"\"\"\n4452 | \n4453 |     for klass in type(estimator_orig).mro():\n4454 |         if (\n4455 |             # Here we check vars(...) because we want to check if the method is\n4456 |             # explicitly defined in the class instead of inherited from a parent class.\n4457 |             (\"_more_tags\" in vars(klass) or \"_get_tags\" in vars(klass))\n4458 |             and \"__sklearn_tags__\" not in vars(klass)\n4459 |         ):\n4460 |             raise TypeError(\n4461 |                 f\"Estimator {name} has defined either `_more_tags` or `_get_tags`,\"\n4462 |                 \" but not `__sklearn_tags__`. If you're customizing tags, and need to\"\n4463 |                 \" support multiple scikit-learn versions, you can implement both\"\n4464 |                 \" `__sklearn_tags__` and `_more_tags` or `_get_tags`. This change was\"\n4465 |                 \" introduced in scikit-learn=1.6\"\n4466 |             )\n```\n\n\n\n##Searching for term \"_get_tags\", \"_more_tags\", \"_safe_tags\"...\n### Search Result:\nFound function `sklearn/utils/validation.py:validate_data`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2824 | def validate_data(\n2825 |     _estimator,\n2826 |     /,\n2827 |     X=\"no_validation\",\n2828 |     y=\"no_validation\",\n2829 |     reset=True,\n2830 |     validate_separately=False,\n2831 |     skip_check_array=False,\n2832 |     **check_params,\n2833 | ):\n2834 |     \"\"\"Validate input data and set or check feature names and counts of the input.\n2835 | \n2836 |     This helper function should be used in an estimator that requires input\n2837 |     validation. This mutates the estimator and sets the `n_features_in_` and\n2838 |     `feature_names_in_` attributes if `reset=True`.\n2839 | \n2840 |     .. versionadded:: 1.6\n2841 | \n2842 |     Parameters\n2843 |     ----------\n2844 |     _estimator : estimator instance\n2845 |         The estimator to validate the input for.\n2846 | \n2847 |     X : {array-like, sparse matrix, dataframe} of shape \\\n2848 |             (n_samples, n_features), default='no validation'\n2849 |         The input samples.\n2850 |         If `'no_validation'`, no validation is performed on `X`. This is\n2851 |         useful for meta-estimator which can delegate input validation to\n2852 |         their underlying estimator(s). In that case `y` must be passed and\n2853 |         the only accepted `check_params` are `multi_output` and\n2854 |         `y_numeric`.\n2855 | \n2856 |     y : array-like of shape (n_samples,), default='no_validation'\n2857 |         The targets.\n2858 | \n2859 |         - If `None`, :func:`~sklearn.utils.check_array` is called on `X`. If\n2860 |           the estimator's `requires_y` tag is True, then an error will be raised.\n2861 |         - If `'no_validation'`, :func:`~sklearn.utils.check_array` is called\n2862 |           on `X` and the estimator's `requires_y` tag is ignored. This is a default\n2863 |           placeholder and is never meant to be explicitly set. In that case `X` must be\n2864 |           passed.\n2865 |         - Otherwise, only `y` with `_check_y` or both `X` and `y` are checked with\n2866 |           either :func:`~sklearn.utils.check_array` or\n2867 |           :func:`~sklearn.utils.check_X_y` depending on `validate_separately`.\n2868 | \n2869 |     reset : bool, default=True\n2870 |         Whether to reset the `n_features_in_` attribute.\n2871 |         If False, the input will be checked for consistency with data\n2872 |         provided when r