on_coefficient>`_\n11005 |         * `Kendall rank correlation coefficient <https://en.wikipedia.org/wiki/Kendall_rank_correlation_coefficient>`_\n11006 |         * `Spearman's rank correlation coefficient <https://en.wikipedia.org/wiki/Spearman%27s_rank_correlation_coefficient>`_\n11007 | \n11008 |         Examples\n11009 |         --------\n11010 |         >>> def histogram_intersection(a, b):\n11011 |         ...     v = np.minimum(a, b).sum().round(decimals=1)\n11012 |         ...     return v\n11013 |         >>> df = pd.DataFrame(\n11014 |         ...     [(0.2, 0.3), (0.0, 0.6), (0.6, 0.0), (0.2, 0.1)],\n11015 |         ...     columns=[\"dogs\", \"cats\"],\n11016 |         ... )\n11017 |         >>> df.corr(method=histogram_intersection)\n11018 |               dogs  cats\n11019 |         dogs   1.0   0.3\n11020 |         cats   0.3   1.0\n11021 | \n11022 |         >>> df = pd.DataFrame(\n11023 |         ...     [(1, 1), (2, np.nan), (np.nan, 3), (4, 4)], columns=[\"dogs\", \"cats\"]\n11024 |         ... )\n11025 |         >>> df.corr(min_periods=3)\n11026 |               dogs  cats\n11027 |         dogs   1.0   NaN\n11028 |         cats   NaN   1.0\n11029 |         \"\"\"  # noqa: E501\n11030 |         data = self._get_numeric_data() if numeric_only else self\n11031 |         cols = data.columns\n11032 |         idx = cols.copy()\n11033 |         mat = data.to_numpy(dtype=float, na_value=np.nan, copy=False)\n11034 | \n11035 |         if method == \"pearson\":\n11036 |             correl = libalgos.nancorr(mat, minp=min_periods)\n11037 |         elif method == \"spearman\":\n11038 |             correl = libalgos.nancorr_spearman(mat, minp=min_periods)\n11039 |         elif method == \"kendall\" or callable(method):\n11040 |             if min_periods is None:\n11041 |                 min_periods = 1\n11042 |             mat = mat.T\n11043 |             corrf = nanops.get_corr_func(method)\n11044 |             K = len(cols)\n11045 |             correl = np.emp