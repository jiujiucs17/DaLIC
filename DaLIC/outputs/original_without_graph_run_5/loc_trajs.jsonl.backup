n rounded decimal values, pandas rounds\n10860 |         to the nearest even value (e.g. -0.5 and 0.5 round to 0.0, 1.5 and 2.5\n10861 |         round to 2.0, etc.).\n10862 | \n10863 |         Examples\n10864 |         --------\n10865 |         >>> df = pd.DataFrame(\n10866 |         ...     [(0.21, 0.32), (0.01, 0.67), (0.66, 0.03), (0.21, 0.18)],\n10867 |         ...     columns=[\"dogs\", \"cats\"],\n10868 |         ... )\n10869 |         >>> df\n10870 |             dogs  cats\n10871 |         0  0.21  0.32\n10872 |         1  0.01  0.67\n10873 |         2  0.66  0.03\n10874 |         3  0.21  0.18\n10875 | \n10876 |         By providing an integer each column is rounded to the same number\n10877 |         of decimal places\n10878 | \n10879 |         >>> df.round(1)\n10880 |             dogs  cats\n10881 |         0   0.2   0.3\n10882 |         1   0.0   0.7\n10883 |         2   0.7   0.0\n10884 |         3   0.2   0.2\n10885 | \n10886 |         With a dict, the number of places for specific columns can be\n10887 |         specified with the column names as key and the number of decimal\n10888 |         places as value\n10889 | \n10890 |         >>> df.round({\"dogs\": 1, \"cats\": 0})\n10891 |             dogs  cats\n10892 |         0   0.2   0.0\n10893 |         1   0.0   1.0\n10894 |         2   0.7   0.0\n10895 |         3   0.2   0.0\n10896 | \n10897 |         Using a Series, the number of places for specific columns can be\n10898 |         specified with the column names as index and the number of\n10899 |         decimal places as value\n10900 | \n10901 |         >>> decimals = pd.Series([0, 1], index=[\"cats\", \"dogs\"])\n10902 |         >>> df.round(decimals)\n10903 |             dogs  cats\n10904 |         0   0.2   0.0\n10905 |         1   0.0   1.0\n10906 |         2   0.7   0.0\n10907 |         3   0.2   0.0\n10908 |         \"\"\"\n10909 |         from pandas.core.reshape.concat import concat\n10910 | \n10911 |         def _dict_round(df: DataFrame, decimals) -> Iterator[Series]:\n10912 |             for col, vals in df.items():\n10913 |                 try:\n10914 |                     yield _series_round(vals, decimals[col])\n10915 |                 except KeyError:\n10916 |                     yield vals\n10917 | \n10918 |         def _series_round(ser: Series, decimals: int) -> Series:\n10919 |             if is_integer_dtype(ser.dtype) or is_float_dtype(ser.dtype):\n10920 |                 return ser.round(decimals)\n10921 |             return ser\n10922 | \n10923 |         nv.validate_round(args, kwargs)\n10924 | \n10925 |         if isinstance(decimals, (dict, Series)):\n10926 |             if isinstance(decimals, Series) and not decimals.index.is_unique:\n10927 |                 raise ValueError(\"Index of decimals must be unique\")\n10928 |             if is_dict_like(decimals) and not all(\n10929 |                 is_integer(value) for _, value in decimals.items()\n10930 |             ):\n10931 |                 raise TypeError(\"Values in decimals must be integers\")\n10932 |             new_cols = list(_dict_round(self, decimals))\n10933 |         elif is_integer(decimals):\n10934 |             # Dispatch to Block.round\n10935 |             # Argument \"decimals\" to \"round\" of \"BaseBlockManager\" has incompatible\n10936 |             # type \"Union[int, integer[Any]]\"; expected \"int\"\n10937 |             new_mgr = self._mgr.round(\n10938 |                 decimals=decimals,  # type: ignore[arg-type]\n10939 |             )\n10940 |             return self._constructor_from_mgr(new_mgr, axes=new_mgr.axes).__finalize__(\n10941 |                 self, method=\"round\"\n10942 |             )\n10943 |         else:\n10944 |             raise TypeError(\"decimals must be an integer, a dict-like or a Series\")\n10945 | \n10946 |         if new_cols is not None and len(new_cols) > 0:\n10947 |             return self._constructor(\n10948 |                 concat(new_cols, axis=1), index=self.index, c