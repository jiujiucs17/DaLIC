"|\")[1])\n15 |     else:\n16 |         return -1\n17 | \n18 | \n19 | # discard headings and other non-entry lines\n20 | text = \"\".join(l for l in sys.stdin if l.startswith(\"- \") or l.startswith(\" \"))\n21 | \n22 | bucketed = defaultdict(list)\n23 | \n24 | for entry in re.split(\"\\n(?=- )\", text.strip()):\n25 |     modules = re.findall(\n26 |         r\":(?:func|meth|mod|class):\" r\"`(?:[^<`]*<|~)?(?:sklearn.)?([a-z]\\w+)\", entry\n27 |     )\n28 |     modules = set(modules)\n29 |     if len(modules) > 1:\n30 |         key = \"Multiple modules\"\n31 |     elif modules:\n32 |         key = \":mod:`sklearn.%s`\" % next(iter(modules))\n33 |     else:\n34 |         key = \"Miscellaneous\"\n35 |     bucketed[key].append(entry)\n36 |     entry = entry.strip() + \"\\n\"\n37 | \n38 | everything = []\n39 | for key, bucket in sorted(bucketed.items()):\n40 |     everything.append(key + \"\\n\" + \".\" * len(key))\n41 |     bucket.sort(key=entry_sort_key)\n42 |     everything.extend(bucket)\n43 | print(\"\\n\\n\".join(everything))\n44 | \n```\n\nFound `examples/neural_networks/plot_mlp_training_curves.py:plot_on_dataset`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 47 | plot_args = [{'c': 'red', 'linestyle': '-'},\n 48 |              {'c': 'green', 'linestyle': '-'},\n 49 |              {'c': 'blue', 'linestyle': '-'},\n 50 |              {'c': 'red', 'linestyle': '--'},\n 51 |              {'c': 'green', 'linestyle': '--'},\n 52 |              {'c': 'blue', 'linestyle': '--'},\n 53 |              {'c': 'black', 'linestyle': '-'}]\n 54 | \n 55 | \n 56 | def plot_on_dataset(X, y, ax, name):\n 57 |     # for each dataset, plot learning for each learning strategy\n 58 |     print(\"\\nlearning on dataset %s\" % name)\n 59 |     ax.set_title(name)\n 60 | \n 61 |     X = MinMaxScaler().fit_transform(X)\n 62 |     mlps = []\n 63 |     if name == \"digits\":\n 64 |         # digits is larger but converges fairly quickly\n 65 |         max_iter = 15\n 66 |     else:\n 67 |         max_iter = 400\n 68 | \n 69 |     for label, param in zip(labels, params):\n 70 |         print(\"training: %s\" % label)\n 71 |         mlp = MLPClassifier(random_state=0,\n 72 |                             max_iter=max_iter, **param)\n 73 | \n 74 |         # some parameter combinations will not converge as can be seen on the\n 75 |         # plots so they are ignored here\n 76 |         with warnings.catch_warnings():\n 77 |             warnings.filterwarnings(\"ignore\", category=ConvergenceWarning,\n 78 |                                     module=\"sklearn\")\n 79 |             mlp.fit(X, y)\n 80 | \n 81 |         mlps.append(mlp)\n 82 |         print(\"Training set score: %f\" % mlp.score(X, y))\n 83 |         print(\"Training set loss: %f\" % mlp.loss_)\n 84 |     for mlp, label, args in zip(mlps, labels, plot_args):\n 85 |         ax.plot(mlp.loss_curve_, label=label, **args)\n```\n\nFound `sklearn/externals/_pep562.py:Pep562`, `sklearn/externals/_pep562.py:Pep562.__dir__`, `sklearn/externals/_pep562.py:Pep562.__getattr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n23 | from __future__ import unicode_literals\n24 | import sys\n25 | \n26 | __all__ = ('Pep562',)\n27 | \n28 | \n29 | class Pep562(object):\n30 |     \"\"\"\n31 |     Backport of PEP 562 <https://pypi.org/search/?q=pep562>.\n32 | \n33 |     Wraps the module in a class that exposes the mechanics to override `__dir__` and `__getattr__`.\n34 |     The given module will be searched for overrides of `__dir__` and `__getattr__` and use them when needed.\n35 |     \"\"\"\n36 | \n37 |     def __init__(self, name):\n38 |         \"\"\"Acquire `__getattr__` and `__dir__`, but only replace module for versions less than Python 3.7.\"\"\"\n39 | \n40 |         self._module = sys.modules[name]\n41 |         self._get_attr = getattr(self._module, '__getattr__', None)\n42 |         self._get_dir = getattr(self._module, '__dir__', None)\n43 |         sys.modules[n