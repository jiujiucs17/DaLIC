      plane_data[:n0 // 2, n1 // 2:],\n40 |         plane_data[n0 // 2:, :n1 // 2],\n41 |         plane_data[n0 // 2:, n1 // 2:]\n42 |     ]\n43 | \n44 |     min_val = array.min()\n45 |     max_val = array.max()\n46 | \n47 |     cmap = plt.get_cmap(cmap)\n48 | \n49 |     for i, quadrant in enumerate(quadrants):\n50 |         facecolors = cmap((quadrant - min_val) / (max_val - min_val))\n51 |         if fixed_coord == 'x':\n52 |             Y, Z = np.mgrid[0:ny // 2, 0:nz // 2]\n53 |             X = nx // 2 * np.ones_like(Y)\n54 |             Y_offset = (i // 2) * ny // 2\n55 |             Z_offset = (i % 2) * nz // 2\n56 |             ax.plot_surface(X, Y + Y_offset, Z + Z_offset, rstride=1, cstride=1,\n57 |                             facecolors=facecolors, shade=False)\n58 |         elif fixed_coord == 'y':\n59 |             X, Z = np.mgrid[0:nx // 2, 0:nz // 2]\n60 |             Y = ny // 2 * np.ones_like(X)\n61 |             X_offset = (i // 2) * nx // 2\n62 |             Z_offset = (i % 2) * nz // 2\n63 |             ax.plot_surface(X + X_offset, Y, Z + Z_offset, rstride=1, cstride=1,\n64 |                             facecolors=facecolors, shade=False)\n65 |         elif fixed_coord == 'z':\n66 |             X, Y = np.mgrid[0:nx // 2, 0:ny // 2]\n67 |             Z = nz // 2 * np.ones_like(X)\n68 |             X_offset = (i // 2) * nx // 2\n69 |             Y_offset = (i % 2) * ny // 2\n70 |             ax.plot_surface(X + X_offset, Y + Y_offset, Z, rstride=1, cstride=1,\n71 |                             facecolors=facecolors, shade=False)\n```\n\nFound class `lib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow`.\nSource: Retrieved code content using keyword search (bm25).\n```\n161 | class FilledArrow(SimpleArrow):\n162 |         \"\"\"\n163 |         An arrow with a filled head.\n164 |         \"\"\"\n165 | \n166 |         ArrowAxisClass = _FancyAxislineStyle.FilledArrow\n167 | \n168 |         def __init__(self, size=1, facecolor=None):\n169 |             \"\"\"\n170 |             Parameters\n171 |             ----------\n172 |             size : float\n173 |                 Size of the arrow as a fraction of the ticklabel size.\n174 |             facecolor : :mpltype:`color`, default: :rc:`axes.edgecolor`\n175 |                 Fill color.\n176 | \n177 |                 .. versionadded:: 3.7\n178 |             \"\"\"\n179 | \n180 |             if facecolor is None:\n181 |                 facecolor = mpl.rcParams['axes.edgecolor']\n182 |             self.size = size\n183 |             self._facecolor = facecolor\n184 |             super().__init__(size=size)\n185 | \n186 |         def new_line(self, axis_artist, transform):\n187 |             linepath = Path([(0, 0), (0, 1)])\n188 |             axisline = self.ArrowAxisClass(axis_artist, linepath, transform,\n189 |                                            line_mutation_scale=self.size,\n190 |                                            facecolor=self._facecolor)\n191 |             return axisline\n```\n\n\n\n##Searching for term \"bar() color edgecolor facecolor\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/set_alpha.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =================================\n 3 | Ways to set a color's alpha value\n 4 | =================================\n 5 | \n 6 | Compare setting alpha by the *alpha* keyword argument and by one of the Matplotlib color\n 7 | formats. Often, the *alpha* keyword is the only tool needed to add transparency to a\n 8 | color. In some cases, the *(matplotlib_color, alpha)* color format provides an easy way\n 9 | to fine-tune the appearance of a Figure.\n10 | \n11 | \"\"\"\n12 | \n13 | import matplotlib.pyplot as plt\n14 | import numpy as np\n15 | \n16 | # Fixing random state for reproducibility.\n17 | np.random.seed(19680801)\n18 | \n19 | fig, (ax1, ax2) = plt.subplots(ncols=2, figsize=(8, 4))\n20 | \n21 | x_values = [n for n in range(20)]\n22 | y_values = np.random.randn(20)\n23 | \n24 | facecolors = ['green' if y > 0 else 'red' for y in y_values]\n25 | edgecolors = facecolors\n26 | \n27 | ax1.bar(x_values, y_values, color=facecolors, edgecolor=edgecolors, alpha=0.5)\n28 | ax1.set_title(\"Explicit 'alpha' keyword value\\nshared by all bars and edges\")\n29 | \n30 | \n31 | # Normalize y values to get distinct face alpha values.\n32 | abs_y = [abs(y) for y in y_values]\n33 | face_alphas = [n / max(abs_y) for n in abs_y]\n34 | edge_alphas = [1 - alpha for alpha in face_alphas]\n35 | \n36 | colors_with_alphas = list(zip(facecolors, face_alphas))\n37 | edgecolors_with_alphas = list(zip(edgecolors, edge_alphas))\n38 | \n39 | ax2.bar(x_values, y_values, color=colors_with_alphas,\n40 |         edgecolor=edgecolors_with_alphas)\n41 | ax2.set_title('Normalized alphas for\\neach bar and each edge')\n42 | \n43 | plt.show()\n44 | \n45 | # %%\n46 | #\n47 | # .. admonition:: References\n48 | #\n49 | #    The use of the following functions, methods, classes and modules is shown\n50 | #    in this example:\n51 | #\n52 | #    - `matplotlib.axes.Axes.bar`\n53 | #    - `matplotlib.pyplot.subplots`\n54 | #\n55 | # .. tags::\n56 | #\n57 | #    styling: color\n58 | #    plot-type: bar\n59 | #    level: beginner\n60 | \n```\n\nFound code snippet in file `galleries/examples/statistics/histogram_multihist.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =====================================================\n  3 | The histogram (hist) function with multiple data sets\n  4 | =====================================================\n  5 | \n  6 | Plot histogram with multiple sample sets and demonstrate:\n  7 | \n  8 | * Use of legend with multiple sample sets\n  9 | * Stacked bars\n 10 | * Step curve with no fill\n 11 | * Data sets of different sample sizes\n 12 | \n 13 | Selecting different bin counts and sizes can significantly affect the\n 14 | shape of a histogram. The Astropy docs have a great section on how to\n 15 | select these parameters:\n 16 | http://docs.astropy.org/en/stable/visualization/histogram.html\n 17 | \n 18 | .. redirect-from:: /gallery/lines_bars_and_markers/filled_step\n 19 | \n 20 | \"\"\"\n 21 | # %%\n 22 | import matplotlib.pyplot as plt\n 23 | import numpy as np\n 24 | \n 25 | np.random.seed(19680801)\n 26 | \n 27 | n_bins = 10\n 28 | x = np.random.randn(1000, 3)\n 29 | \n 30 | fig, ((ax0, ax1), (ax2, ax3)) = plt.subplots(nrows=2, ncols=2)\n 31 | \n 32 | colors = ['red', 'tan', 'lime']\n 33 | ax0.hist(x, n_bins, density=True, histtype='bar', color=colors, label=colors)\n 34 | ax0.legend(prop={'size': 10})\n 35 | ax0.set_title('bars with legend')\n 36 | \n 37 | ax1.hist(x, n_bins, density=True, histtype='bar', stacked=True)\n 38 | ax1.set_title('stacked bar')\n 39 | \n 40 | ax2.hist(x, n_bins, histtype='step', stacked=True, fill=False)\n 41 | ax2.set_title('stack step (unfilled)')\n 42 | \n 43 | # Make a multiple-histogram of data-sets with different length.\n 44 | x_multi = [np.random.randn(n) for n in [10000, 5000, 2000]]\n 45 | ax3.hist(x_multi, n_bins, histtype='bar')\n 46 | ax3.set_title('different sample sizes')\n 47 | \n 48 | fig.tight_layout()\n 49 | plt.show()\n 50 | \n 51 | # %%\n 52 | # -----------------------------------\n 53 | # Setting properties for each dataset\n 54 | # -----------------------------------\n 55 | #\n 56 | # You can style the histograms individually by passing a list of values to the\n 57 | # following parameters:\n 58 | #\n 59 | # * edgecolor\n 60 | # * facecolor\n 61 | # * hatch\n 62 | # * linewidth\n 63 | # * linestyle\n 64 | #\n 65 | #\n 66 | # edgecolor\n 67 | # .........\n 68 | \n 69 | fig, ax = plt.subplots()\n 70 | \n 71 | edgecolors = ['green', 'red', 'blue']\n 72 | \n 73 | ax.hist(x, n_bins, fill=False, histtype=\"step\", stacked=True,\n 74 |         edgecolor=edgecolors, label=edgecolors)\n 75 | ax.legend()\n 76 | ax.set_title('Stacked Steps with Edgecolors')\n 77 | \n 78 | plt.show()\n 79 | \n 80 | # %%\n 81 | # facecolor\n 82 | # .........\n```\n\nFound function `lib/matplotlib/axes/_axes.py:Axes.hist`.\nSource: Retrieved code content using keyword search (bm25).\n```\n6728 | def hist(self, x, bins=None, range=None, density=False, weights=None,\n6729 |              cumulative=False, bottom=None, histtype='bar', align='mid',\n6730 |              orientation='vertical', rwidth=None, log=False,\n6731 |              color=None, label=None, stacked=False, **kwargs):\n6732 |         \"\"\"\n6733 |         Compute and plot a histogram.\n6734 | \n6735 |         This method uses `numpy.histogram` to bin the data in *x* and count the\n6736 |         number of values in each bin, then draws the distribution either as a\n6737 |         `.BarContainer` or `.Polygon`. The *bins*, *range*, *density*, and\n6738 |         *weights* parameters are forwarded to `numpy.histogram`.\n6739 | \n6740 |         If the data has already been binned and counted, use `~.bar` or\n6741 |         `~.stairs` to plot the distribution::\n6742 | \n6743 |             counts, bins = np.histogram(x)\n6744 |             plt.stairs(counts, bins)\n6745 | \n6746 |         Alternatively, plot pre-computed bins and counts using ``hist()`` by\n6747 |         treating each bin as a single point with a weight equal to its count::\n6748 | \n6749 |             plt.hist(bins[:-1], bins, weights=counts)\n6750 | \n6751 |         The data input *x* can be a singular array, a list of datasets of\n6752 |         potentially different lengths ([*x0*, *x1*, ...]), or a 2D ndarray in\n6753 |         which each column is a dataset. Note that the ndarray form is\n6754 |         transposed relative to the list form. If the input is an array, then\n6755 |         the return value is a tuple (*n*, *bins*, *patches*); if the input is a\n6756 |         sequence of arrays, then the return value is a tuple\n6757 |         ([*n0*, *n1*, ...], *bins*, [*patches0*, *patches1*, ...]).\n6758 | \n6759 |         Masked arrays are not supported.\n6760 | \n6761 |         Parameters\n6762 |         ----------\n6763 |         x : (n,) array or sequence of (n,) arrays\n6764 |             Input values, this takes either a single array or a sequence of\n6765 |             arrays which are not required to be of the same length.\n6766 | \n6767 |         bins : int or sequence or str, default: :rc:`hist.bins`\n6768 |             If *bins* is an integer, it defines the number of equal-width bins\n6769 |             in the range.\n6770 | \n6771 |             If *bins* is a sequence, it defines the bin edges, including the\n6772 |             left edge of the first bin and the right edge of the last bin;\n6773 |             in this case, bins may be unequally spaced.  All but the last\n6774 |             (righthand-most) bin is half-open.  In other words, if *bins* is::\n6775 | \n6776 |                 [1, 2, 3, 4]\n6777 | \n6778 |             then the first bin is ``[1, 2)`` (including 1, but excluding 2) and\n6779 |             the second ``[2, 3)``.  The last bin, however, is ``[3, 4]``, which\n6780 |             *includes* 4.\n6781 | \n6782 |             If *bins* is a string, it is one of the binning strategies\n6783 |             supported by `numpy.histogram_bin_edges`: 'auto', 'fd', 'doane',\n6784 |             'scott', 'stone', 'rice', 'sturges', or 'sqrt'.\n6785 | \n6786 |         range : tuple or None, default: None\n6787 |             The lower and upper range of the bins. Lower and upper outliers\n6788 |             are ignored. If not provided, *range* is ``(x.min(), x.max())``.\n6789 |             Range has no effect if *bins* is a sequence.\n6790 | \n6791 |             If *bins* is a sequence or *range* is specified, autoscaling\n6792 |             is based on the specified bin range instead of the\n6793 |             range of x.\n6794 | \n6795 |         density : bool, default: False\n6796 |             If ``True``, draw and return a probability density: each bin\n6797 |             will display the bin's raw count divided by the total number of\n6798 |             counts *and the bin width*\n6799 |             (``density = counts / (sum(counts) * np.diff(bins))``),\n6800 |             so that the area under the histogram integrates to 1\n6801 |             (``np.sum(density * np.diff(bins)) == 1``).\n6802 | \n6803 |             If *stacked* is also ``True``, the sum of the histograms is\n6804 |             normalized to 1.\n6805 | \n6806 |         weights : (n,) array-like or None, default: None\n6807 |             An array of weights, of the same shape as *x*.  Each value in\n6808 |             *x* only contributes its associated weight towards the bin count\n6809 |             (instead of 1).  If *density* is ``True``, the weights are\n6810 |             normalized, so that the integral of the density over the range\n6811 |             remains 1.\n6812 | \n6813 |         cumulative : bool or -1, default: False\n6814 |             If ``True``, then a histogram is computed where each bin gives the\n6815 |             counts in that bin plus all bins for smaller values. The last bin\n6816 |             gives the total number of datapoints.\n6817 | \n6818 |             If *density* is also ``True`` then the histogram is normalized such\n6819 |             that the last bin equals 1.\n6820 | \n6821 |             If *cumulative* is a number less than 0 (e.g., -1), the direction\n6822 |             of accumulation is reversed.  In this case, if *density* is also\n6823 |             ``True``, then the histogram is normalized such that the first bin\n6824 |             equals 1.\n6825 | \n6826 |         bottom : array-like, scalar, or None, default: None\n6827 |             Location of the bottom of each bin, i.e. bins are drawn from\n6828 |             ``bottom`` to ``bottom + hist(x, bins)`` If a scalar, the bottom\n6829 |             of each bin is shifted by the same amount. If an array, each bin\n6830 |             is