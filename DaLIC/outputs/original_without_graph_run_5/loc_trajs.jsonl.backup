"binary\", \"multiclass\", \"multilabel-indicator\"]:\n104 |         raise ValueError(\"{0} is not supported\".format(y_type))\n105 | \n106 |     if y_type in [\"binary\", \"multiclass\"]:\n107 |         y_true = column_or_1d(y_true)\n108 |         y_pred = column_or_1d(y_pred)\n109 |         if y_type == \"binary\":\n110 |             try:\n111 |                 unique_values = np.union1d(y_true, y_pred)\n112 |             except TypeError as e:\n113 |                 # We expect y_true and y_pred to be of the same data type.\n114 |                 # If `y_true` was provided to the classifier as strings,\n115 |                 # `y_pred` given by the classifier will also be encoded with\n116 |                 # strings. So we raise a meaningful error\n117 |                 raise TypeError(\n118 |                     \"Labels in y_true and y_pred should be of the same type. \"\n119 |                     f\"Got y_true={np.unique(y_true)} and \"\n120 |                     f\"y_pred={np.unique(y_pred)}. Make sure that the \"\n121 |                     \"predictions provided by the classifier coincides with \"\n122 |                     \"the true labels.\"\n123 |                 ) from e\n124 |             if len(unique_values) > 2:\n125 |                 y_type = \"multiclass\"\n126 | \n127 |     if y_type.startswith(\"multilabel\"):\n128 |         y_true = csr_matrix(y_true)\n129 |         y_pred = csr_matrix(y_pred)\n130 |         y_type = \"multilabel-indicator\"\n131 | \n132 |     return y_type, y_true, y_pred\n```\n\nFound function `sklearn/metrics/_classification.py:_weighted_sum`.\nSource: Retrieved code content using keyword search (bm25).\n```\n135 | def _weighted_sum(sample_score, sample_weight, normalize=False):\n136 |     if normalize:\n137 |         return np.average(sample_score, weights=sample_weight)\n138 |     elif sample_weight is not None:\n139 |         return np.dot(sample_score, sample_weight)\n140 |     else:\n141 |         return sample_score.sum()\n```\n\nFound function `sklearn/metrics/_classification.py:hamming_loss`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2181 | def hamming_loss(y_true, y_pred, *, sample_weight=None):\n2182 |     \"\"\"Compute the average Hamming loss.\n2183 | \n2184 |     The Hamming loss is the fraction of labels that are incorrectly predicted.\n2185 | \n2186 |     Read more in the :ref:`User Guide <hamming_loss>`.\n2187 | \n2188 |     Parameters\n2189 |     ----------\n2190 |     y_true : 1d array-like, or label indicator array / sparse matrix\n2191 |         Ground truth (correct) labels.\n2192 | \n2193 |     y_pred : 1d array-like, or label indicator array / sparse matrix\n2194 |         Predicted labels, as returned by a classifier.\n2195 | \n2196 |     sample_weight : array-like of shape (n_samples,), default=None\n2197 |         Sample weights.\n2198 | \n2199 |         .. versionadded:: 0.18\n2200 | \n2201 |     Returns\n2202 |     -------\n2203 |     loss : float or int\n2204 |         Return the average Hamming loss between element of ``y_true`` and\n2205 |         ``y_pred``.\n2206 | \n2207 |     See Also\n2208 |     --------\n2209 |     accuracy_score, jaccard_score, zero_one_loss\n2210 | \n2211 |     Notes\n2212 |     -----\n2213 |     In multiclass classification, the Hamming loss corresponds to the Hamming\n2214 |     distance between ``y_true`` and ``y_pred`` which is equivalent to the\n2215 |     subset ``zero_one_loss`` function, when `normalize` parameter is set to\n2216 |     True.\n2217 | \n2218 |     In multilabel classification, the Hamming loss is different from the\n2219 |     subset zero-one loss. The zero-one loss considers the entire set of labels\n2220 |     for a given sample incorrect if it does not entirely match the true set of\n2221 |     labels. Hamming loss is more forgiving in that it penalizes only the\n2222 |     individual labels.\n2223 | \n2224 |     The Hamming loss is upperbounded by the subset zero-one loss, when\n2225 |     `normalize` parameter is set to True. It is always between 0 and 1,\n2226 |     lower being better.\n2227 | \n2228 |     References\n2229 |     ----------\n2230 |     .. [1] Grigorios Tsoumakas, Ioannis Katakis. Multi-Label Classification:\n2231 |            An Overview. International Journal of Data Warehousing & Mining,\n2232 |            3(3), 1-13, July-September 2007.\n2233 | \n2234 |     .. [2] `Wikipedia entry on the Hamming distance\n2235 |            <https://en.wikipedia.org/wiki/Hamming_distance>`_.\n2236 | \n2237 |     Examples\n2238 |     --------\n2239 |     >>> from sklearn.metrics import hamming_loss\n2240 |     >>> y_pred = [1, 2, 3, 4]\n2241 |     >>> y_true = [2, 2, 3, 4]\n2242 |     >>> hamming_loss(y_true, y_pred)\n2243 |     0.25\n2244 | \n2245 |     In the multilabel case with binary label indicators:\n2246 | \n2247 |     >>> import numpy as np\n2248 |     >>> hamming_loss(np.array([[0, 1], [1, 1]]), np.zeros((2, 2)))\n2249 |     0.75\n2250 |     \"\"\"\n2251 | \n2252 |     y_type, y_true, y_pred = _check_targets(y_true, y_pred)\n2253 |     check_consistent_length(y_true, y_pred, sample_weight)\n2254 | \n2255 |     if sample_weight is None:\n2256 |         weight_average = 1.0\n2257 |     else:\n2258 |         weight_average = np.mean(sample_weight)\n2259 | \n2260 |     if y_type.startswith(\"multilabel\"):\n2261 |         n_differences = count_nonzero(y_true - y_pred, sample_weight=sample_weight)\n2262 |         return n_differences / (y_true.shape[0] * y_true.shape[1] * weight_average)\n2263 | \n2264 |     elif y_type in [\"binary\", \"multiclass\"]:\n2265 |         return _weighted_sum(y_true != y_pred, sample_weight, normalize=True)\n2266 |     else:\n2267 |         raise ValueError(\"{0} is not supported\".format(y_type))\n```\n\nFound function `sklearn/metrics/_classification.py:brier_score_loss`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2552 | def brier_score_loss(y_true, y_prob, *, sample_weight=None, pos_label=None):\n2553 |     \"\"\"Compute the Brier score loss.\n2554 | \n2555 |     The smaller the Brier score loss, the better, hence the naming with \"loss\".\n2556 |     The Brier score measures the mean squared difference between the predicted\n2557 |     probability and the actual outcome. The Brier score always\n2558 |     takes on a value between zero and one, since this is the largest\n2559 |     possible difference between a predicted probability (which must be\n2560 |     between zero and one) and the actual outcome (which can take on values\n2561 |     of only 0 and 1). It can be decomposed is the sum of refinement loss and\n2562 |     calibration loss.\n2563 | \n2564 |     The Brier score is appropriate for binary and categorical outcomes that\n2565 |     can be structured as true or false, but is inappropriate for ordinal\n2566 |     variables which can take on three or more values (this is because the\n2567 |     Brier score assumes that all possible outcomes are equivalently\n2568 |     \"distant\" from one another). Which label is considered to be the positive\n2569 |     label is controlled via the parameter `pos_label`, which defaults to\n2570 |     the greater label unless `y_true` is all 0 or all -1, in which case\n2571 |     `pos_label` defaults to 1.\n2572 | \n2573 |     Read more in the :ref:`User Guide <brier_score_loss>`.\n2574 | \n2575 |     Parameters\n2576 |     ----------\n2577 |     y_true : array of shape (n_samples,)\n2578 |         True targets.\n2579 | \n2580 |     y_prob : array of shape (n_samples,)\n2581 |         Probabilities of the positive class.\n2582 | \n2583 |     sample_weight : array-like of shape (n_samples,), default=None\n2584 |         Sample weights.\n2585 | \n2586 |     pos_label : int or str, default=None\n2587 |         Label of the positive class. `pos_label` will be infered in the\n2588 |         following manner:\n2589 | \n2590 |         * if `y_true` in {-1, 1} or {0, 1}, `pos_label` defaults to 1;\n2591 |         * else if `y_true` contains string, an error will be raised and\n2592 |           `pos_label` should be explicitely specified;\n2593 |         * otherwise, `pos_label` defaults to the greater label,\n2594 |           i.e. `np.unique(y_true)[-1]`.\n2595 | \n2596 |     Returns\n2597 |     -------\n2598 |     score : float\n2599 |         Brier score loss.\n2600 | \n2601 |     Examples\n2602 |     --------\n2603 |     >>> import numpy as np\n2604 |     >>> from sklearn.metrics import brier_score_loss\n2605 |     >>> y_true = np.array([0, 1, 1, 0])\n2606 |     >>> y_true_categorical = np.array([\"spam\", \"ham\", \"ham\", \"spam\"])\n2607 |     >>> y_prob = np.array([0.1, 0.9, 0.8, 0.3])\n2608 |     >>> brier_score_loss(y_true, y_prob)\n2609 |     0.037...\n2610 |     >>> brier_score_loss(y_true, 1-y_prob, pos_label=0)\n2611 |     0.037...\n2612 |     >>> brier_score_loss(y_true_categorical, y_prob, pos_label=\"ham\")\n2613 |     0.037...\n2614 |     >>> brier_score_loss(y_true, np.array(y_prob) > 0.5)\n2615 |     0.0\n2616 | \n2617 |     References\n2618 |     ----------\n2619 |     .. [1] `Wikipedia entry for the Brier score\n2620 |             <https://en.wikipedia.org/wiki/Brier_score>`_.\n2621 |     \"\"\"\n2622 |     y_true = column_or_1d(y_true)\n2623 |     y_prob = column_or_1d(y_prob)\n2624 |     assert_all_finite(y_true)\n2625 |     assert_all_finite(y_prob)\n2626 |     check_consistent_length(y_true, y_prob, sample_weight)\n2627 | \n2628 |     y_type = type_of_target(y_true)\n2629 |     if y_type != \"binary\":\n2630 |         raise ValueError(\n2631 |             \"Only binary classification is supported. The type of the target \"\n2632 |             f\"is {y_type}.\"\n2633 |         )\n2634 | \n2635 |     if y_prob.max() > 1:\n2636 |         raise ValueError(\"y_prob contains values greater than 1.\")\n2637 |     if y_prob.min() < 0:\n2638 |         raise ValueError(\"y_prob contains values less than 0.\")\n2639 | \n2640 |     try:\n2641 |         pos_label = _check_pos_label_consistency(pos_label, y_true)\n2642 |     except ValueError:\n2643 |         classes = np.unique(y_true)\n2644 |         if classes.dtype.kind not in (\"O\", \"U\", \"S\"):\n2645 |             # for backward compatibility, if classes are not string then\n2646 |             # `pos_label` will correspond to the greater label\n2647 |             pos_label = classes[-1]\n2648 |         else:\n2649 |             raise\n2650 |     y_true = np.array(y_true == pos_label, int)\n2651 |     return np.average((y_true - y_prob) ** 2, weights=sample_weight)\n```\n\nFound function `sklearn/metrics/_regression.py:_check_reg_targets`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 54 | def _check_reg_targets(y_true, y_pred, multioutput, dtype=\"numeric\"):\n 55 |     \"\"\"Check that y_true and y_pred belong to the same regression task.\n 56 | \n 57 |     Parameters\n 58 |     ----------\n 59 |     y_true : array-like\n 60 | \n 61 |     y_pred : array-like\n 62 | \n 63 |     multioutput : array-like or string in ['raw_values', uniform_average',\n 64 |         'variance_weighted'] or None\n 65 |         None is accepted due to backward compatibility of r2_score().\n 66 | \n 67 |     Returns\n 68 |     -------\n 69 |     type_true : one of {'continuous', continuous-multioutput'}\n 70 |         The type of the true target data, as output by\n 71 |         'utils.multiclass.type_of_target'.\n 72 | \n 73 |     y_true : array-like of shape (n_samples, n_outputs)\n 74 |         Ground truth (correct) target values.\n 75 | \n 76 |     y_pred : array-like of shape (n_samples, n_outputs)\n 77 |         Estimated target values.\n 78 | \n 79 |     multioutput : array-like of shape (n_outputs) or string in ['raw_values',\n 80 |         uniform_average', 'variance_weighted'] or None\n 81 |         Custom output weights if ``multioutput`` is array-like or\n 82 |         just the corresponding argument if ``multioutput`` is a\n 83 |         correct keyword.\n 84 | \n 85 |     dtype : str or list, default=\"numeric\"\n 86 |         the dtype argument passed to check_array.\n 87 |     \"\"\"\n 88 |     check_consistent_length(y_true, y_pred)\n 89 |     y_true = check_array(y_true, ensure_2d=False, dtype=dtype)\n 90 |     y_pred = check_array(y_pred, ensure_2d=False, dtype=dtype)\n 91 | \n 92 |     if y_true.ndim == 1:\n 93 |         y_true = y_true.reshape((-1, 1))\n 94 | \n 95 |     if y_pred.ndim == 1:\n 96 |         y_pred = y_pred.reshape((-1, 1))\n 97 | \n 98 |     if y_true.shape[1] != y_pred.shape[1]:\n 99 |         raise ValueError(\n100 |             \"y_true and y_pred have different number of output ({0}!={1})\".format(\n101 |                 y_true.shape[1], y_pred.shape[1]\n102 |             )\n103 |         )\n104 | \n105 |     n_outputs = y_true.shape[1]\n106 |     allowed_multioutput_str = (\"raw_values\", \"uniform_average\", \"variance_weighted\")\n107 |     if isinstance(multioutput, str):\n108 |         if multioutput not in allowed_multioutput_str:\n109 |             raise ValueError(\n110 |                 \"Allowed 'multioutput' string values are {}. \"\n111 |                 \"You provided multioutput={!r}\".format(\n112 |                     allowed_multioutput_str, multioutput\n113 |                 )\n114 |             )\n115 |     elif multioutput is not None:\n116 |         multioutput = check_array(multioutput, ensure_2d=False)\n117 |         if n_outputs == 1:\n118 |             raise ValueError(\"Custom weights are useful only in multi-output cases.\")\n119 |         elif n_outputs != len(multioutput):\n120 |             raise ValueError(\n121 |                 \"There must be equally many custom weights (%d) as outputs (%d).\"\n122 |                 % (len(multioutput), n_outputs)\n123 |             )\n124 |     y_type = \"continuous\" if n_outputs == 1 else \"continuous-multioutput\"\n125 | \n126 |     return y_type, y_true, y_pred, multioutput\n```\n\nFound file `conftest.