ce of arrays. Default = 1E-10.\n1561 | \n1562 |     raise_warning : bool, default=True\n1563 |         If True then raise a warning if conversion is required.\n1564 | \n1565 |     raise_exception : bool, default=False\n1566 |         If True then raise an exception if array is not symmetric.\n1567 | \n1568 |     Returns\n1569 |     -------\n1570 |     array_sym : {ndarray, sparse matrix}\n1571 |         Symmetrized version of the input array, i.e. the average of array\n1572 |         and array.transpose(). If sparse, then duplicate entries are first\n1573 |         summed and zeros are eliminated.\n1574 | \n1575 |     Examples\n1576 |     --------\n1577 |     >>> import numpy as np\n1578 |     >>> from sklearn.utils.validation import check_symmetric\n1579 |     >>> symmetric_array = np.array([[0, 1, 2], [1, 0, 1], [2, 1, 0]])\n1580 |     >>> check_symmetric(symmetric_array)\n1581 |     array([[0, 1, 2],\n1582 |            [1, 0, 1],\n1583 |            [2, 1, 0]])\n1584 |     >>> from scipy.sparse import csr_matrix\n1585 |     >>> sparse_symmetric_array = csr_matrix(symmetric_array)\n1586 |     >>> check_symmetric(sparse_symmetric_array)\n1587 |     <Compressed Sparse Row sparse matrix of dtype 'int64'\n1588 |         with 6 stored elements and shape (3, 3)>\n1589 |     \"\"\"\n1590 |     if (array.ndim != 2) or (array.shape[0] != array.shape[1]):\n1591 |         raise ValueError(\n1592 |             \"array must be 2-dimensional and square. shape = {0}\".format(array.shape)\n1593 |         )\n1594 | \n1595 |     if sp.issparse(array):\n1596 |         diff = array - array.T\n1597 |         # only csr, csc, and coo have `data` attribute\n1598 |         if diff.format not in [\"csr\", \"csc\", \"coo\"]:\n1599 |             diff = diff.tocsr()\n1600 |         symmetric = np.all(abs(diff.data) < tol)\n1601 |     else:\n1602 |         symmetric = np.allclose(array, array.T, atol=tol)\n1603 | \n1604 |     if not symmetric:\n1605 |         if raise_exception:\n1606 |       