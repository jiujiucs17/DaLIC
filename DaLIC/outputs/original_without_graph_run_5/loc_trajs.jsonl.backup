e.\n6866 | \n6867 |         label : str or list of str, optional\n6868 |             String, or sequence of strings to match multiple datasets.  Bar\n6869 |             charts yield multiple patches per dataset, but only the first gets\n6870 |             the label, so that `~.Axes.legend` will work as expected.\n6871 | \n6872 |         stacked : bool, default: False\n6873 |             If ``True``, multiple data are stacked on top of each other If\n6874 |             ``False`` multiple data are arranged side by side if histtype is\n6875 |             'bar' or on top of each other if histtype is 'step'\n6876 | \n6877 |         Returns\n6878 |         -------\n6879 |         n : array or list of arrays\n6880 |             The values of the histogram bins. See *density* and *weights* for a\n6881 |             description of the possible semantics.  If input *x* is an array,\n6882 |             then this is an array of length *nbins*. If input is a sequence of\n6883 |             arrays ``[data1, data2, ...]``, then this is a list of arrays with\n6884 |             the values of the histograms for each of the arrays in the same\n6885 |             order.  The dtype of the array *n* (or of its element arrays) will\n6886 |             always be float even if no weighting or normalization is used.\n6887 | \n6888 |         bins : array\n6889 |             The edges of the bins. Length nbins + 1 (nbins left edges and right\n6890 |             edge of last bin).  Always a single array even when multiple data\n6891 |             sets are passed in.\n6892 | \n6893 |         patches : `.BarContainer` or list of a single `.Polygon` or list of \\\n6894 | such objects\n6895 |             Container of individual artists used to create the histogram\n6896 |             or list of such containers if there are multiple input datasets.\n6897 | \n6898 |         Other Parameters\n6899 |         ----------------\n6900 |         data : indexable object, optional\n6901 |             DATA_PARAMETER_PLACEHOLDER\n6902 | \n6903 |         **kwargs\n6904 |             `~matplotlib.patches.Patch` properties. The following properties\n6905 |             additionally accept a sequence of values corresponding to the\n6906 |             datasets in *x*:\n6907 |             *edgecolor*, *facecolor*, *linewidth*, *linestyle*, *hatch*.\n6908 | \n6909 |             .. versionadded:: 3.10\n6910 |                Allowing sequences of values in above listed Patch properties.\n6911 | \n6912 |         See Also\n6913 |         --------\n6914 |         hist2d : 2D histogram with rectangular bins\n6915 |         hexbin : 2D histogram with hexagonal bins\n6916 |         stairs : Plot a pre-computed histogram\n6917 |         bar : Plot a pre-computed histogram\n6918 | \n6919 |         Notes\n6920 |         -----\n6921 |         For large numbers of bins (>1000), plotting can be significantly\n6922 |         accelerated by using `~.Axes.stairs` to plot a pre-computed histogram\n6923 |         (``plt.stairs(*np.histogram(data))``), or by setting *histtype* to\n6924 |         'step' or 'stepfilled' rather than 'bar' or 'barstacked'.\n6925 |         \"\"\"\n6926 |         # Avoid shadowing the builtin.\n6927 |         bin_range = range\n6928 |         from builtins import range\n6929 | \n6930 |         if np.isscalar(x):\n6931 |             x = [x]\n6932 | \n6933 |         if bins is None:\n6934 |             bins = mpl.rcParams['hist.bins']\n6935 | \n6936 |         # Validate string inputs here to avoid cluttering subsequent code.\n6937 |         _api.check_in_list(['bar', 'barstacked', 'step', 'stepfilled'],\n6938 |                            histtype=histtype)\n6939 |         _api.check_in_list(['left', 'mid', 'right'], align=align)\n6940 |         _api.check_in_list(['horizontal', 'vertical'], orientation=orientation)\n6941 | \n6942 |         if histtype == 'barstacked' and not stacked:\n6943 |             stacked = True\n6944 | \n6945 |         # Massage 'x' for processing.\n6946 |         x = cbook._reshape_2D(x, 'x')\n6947 |         nx = len(x)  # number of datasets\n6948 | \n6949 |         # Process unit information.  _process_unit_info sets the unit and\n6950 |         # converts the first dataset; then we convert each following dataset\n6951 |         # one at a time.\n6952 |         if orientation == \"vertical\":\n6953 |             convert_units = self.convert_xunits\n6954 |             x = [*self._process_unit_info([(\"x\", x[0])], kwargs),\n6955 |                  *map(convert_units, x[1:])]\n6956 |         else:  # horizontal\n6957 |             convert_units = self.convert_yunits\n6958 |             x = [*self._process_unit_info([(\"y\", x[0])], kwargs),\n6959 |                  *map(convert_units, x[1:])]\n6960 | \n6961 |         if bin_range is not None:\n6962 |             bin_range = convert_units(bin_range)\n6963 | \n6964 |         if not cbook.is_scalar_or_string(bins):\n6965 |             bins = convert_units(bins)\n6966 | \n6967 |         # We need to do to 'weights' what was done to 'x'\n6968 |         if weights is not None:\n6969 |             w = cbook._reshape_2D(weights, 'weights')\n6970 |         else:\n6971 |             w = [None] * nx\n6972 | \n6973 |         if len(w) != nx:\n6974 |             raise ValueError('weights should have the same shape as x')\n6975 | \n6976 |         input_empty = True\n6977 |         for xi, wi in zip(x, w):\n6978 |             len_xi = len(xi)\n6979 |             if wi is not None and len(wi) != len_xi:\n6980 |                 raise ValueError('weights should have the same shape as x')\n6981 |             if len_xi:\n6982 |                 input_empty = False\n6983 | \n6984 |         if color is None:\n6985 |             colors = [self._get_lines.get_next_color() for i in range(nx)]\n6986 |         else:\n6987 |             colors = mcolors.to_rgba_array(color)\n6988 |             if len(colors) != nx:\n6989 |                 raise ValueError(f\"The 'color' keyword argument must have one \"\n6990 |                                  f\"color per dataset, but {nx} datasets and \"\n6991 |                                  f\"{len(colors)} colors were provided\")\n6992 | \n6993 |         hist_kwargs = dict()\n6994 | \n6995 |         # if the bin_range is not given, compute without nan numpy\n6996 |         # does not do this for us when guessing the range (but will\n6997 |         # happily ignore nans when computing the histogram).\n6998 |         if bin_range is None:\n6999 |             xmin = np.inf\n7000 |             xmax = -np.inf\n7001 |             for xi in x:\n7002 |                 if len(xi):\n7003 |                     # python's min/max ignore nan,\n7004 |                     # np.minnan returns nan for all nan input\n7005 |                     xmin = min(xmin, np.nanmin(xi))\n7006 |                     xmax = max(xmax, np.nanmax(xi))\n7007 |             if xmin <= xmax:  # Only happens if we have seen a finite value.\n7008 |                 bin_range = (xmin, xmax)\n7009 | \n7010 |         # If bins are not specified either explicitly or via range,\n7011 |         # we need to figure out the range required for all datasets,\n7012 |         # and supply that to np.histogram.\n7013 |         if not input_empty and len(x) > 1:\n7014 |             if weights is not None:\n7015 |                 _w = np.concatenate(w)\n7016 |             else:\n7017 |                 _w = None\n7018 |             bins = np.histogram_bin_edges(\n7019 |                 np.concatenate(x), bins, bin_range, _w)\n7020 |         else:\n7021 |             hist_kwargs['range'] = bin_range\n7022 | \n7023 |         density = bool(density)\n7024 |         if density and not stacked:\n7025 |             hist_kwargs['density'] = density\n7026 | \n7027 |         # List to store all the top coordinates of the histograms\n7028 |         tops = []  # Will have shape (n_datasets, n_bins).\n7029 |         # Loop through datasets\n7030 |         for i in range(nx):\n70