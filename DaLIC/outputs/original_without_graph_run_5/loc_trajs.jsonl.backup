it(self, X, y=None, sample_weight=None):\n1912 |         \"\"\"Compute the centroids on X by chunking it into mini-batches.\n1913 | \n1914 |         Parameters\n1915 |         ----------\n1916 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1917 |             Training instances to cluster. It must be noted that the data\n1918 |             will be converted to C ordering, which will cause a memory copy\n1919 |             if the given data is not C-contiguous.\n1920 |             If a sparse matrix is passed, a copy will be made if it's not in\n1921 |             CSR format.\n1922 | \n1923 |         y : Ignored\n1924 |             Not used, present here for API consistency by convention.\n1925 | \n1926 |         sample_weight : array-like of shape (n_samples,), default=None\n1927 |             The weights for each observation in X. If None, all observations\n1928 |             are assigned equal weight.\n1929 | \n1930 |             .. versionadded:: 0.20\n1931 | \n1932 |         Returns\n1933 |         -------\n1934 |         self : object\n1935 |             Fitted estimator.\n1936 |         \"\"\"\n1937 |         X = self._validate_data(\n1938 |             X,\n1939 |             accept_sparse=\"csr\",\n1940 |             dtype=[np.float64, np.float32],\n1941 |             order=\"C\",\n1942 |             accept_large_sparse=False,\n1943 |         )\n1944 | \n1945 |         self._check_params(X)\n1946 |         random_state = check_random_state(self.random_state)\n1947 |         sample_weight = _check_sample_weight(sample_weight, X, dtype=X.dtype)\n1948 |         self._n_threads = _openmp_effective_n_threads()\n1949 |         n_samples, n_features = X.shape\n1950 | \n1951 |         # Validate init array\n1952 |         init = self.init\n1953 |         if _is_arraylike_not_scalar(init):\n1954 |             init = check_array(init, dtype=X.dtype, copy=True, order=\"C\")\n1955 |             self._validate_center_shape(X, init)\n1956 | \n1957 |         self._check_mkl_vcomp(X, self._batch_size)\n1958 | \n1959 |         # precompute squared norms of data points\n1960 |         x_squared_norms = row_norms(X, squared=True)\n1961 | \n1962 |         # Validation set for the init\n1963 |         validation_indices = random_state.randint(0, n_samples, self._init_size)\n1964 |         X_valid = X[validation_indices]\n1965 |         sample_weight_valid = sample_weight[validation_indices]\n1966 |         x_squared_norms_valid = x_squared_norms[validation_indices]\n1967 | \n1968 |         # perform several inits with random subsets\n1969 |         best_inertia = None\n1970 |         for init_idx in range(self._n_init):\n1971 |             if self.verbose:\n1972 |                 print(f\"Init {init_idx + 1}/{self._n_init} with method {init}\")\n1973 | \n1974 |             # Initialize the centers using only a fraction of the data as we\n1975 |             # expect n_samples to be very large when using MiniBatchKMeans.\n1976 |             cluster_centers = self._init_centroids(\n1977 |                 X,\n1978 |                 x_squared_norms=x_squared_norms,\n1979 |                 init=init,\n1980 |                 random_state=random_state,\n1981 |                 init_size=self._init_size,\n1982 |             )\n1983 | \n1984 |             # Compute inertia on a validation set.\n1985 |             _, inertia = _labels_inertia_threadpool_limit(\n1986 |                 X_valid,\n1987 |                 sample_weight_valid,\n1988 |                 x_squared_norms_valid,\n1989 |                 cluster_centers,\n1990 |                 n_threads=self._n_threads,\n1991 |             )\n1992 | \n1993 |             if self.verbose:\n1994 |                 print(f\"Inertia for init {init_idx + 1}/{self._n_init}: {inertia}\")\n1995 |             if best_inertia is None or inertia < best_inertia:\n1996 |                 init_centers = cluster_centers\n1997 |                 best_inertia = inertia\n1998 | \n1999 |       