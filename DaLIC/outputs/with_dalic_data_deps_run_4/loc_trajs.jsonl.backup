nk(start_i, end_i)\n314 | \n315 |     def _save_chunk(self, start_i: int, end_i: int) -> None:\n316 |         # create the data for a chunk\n317 |         slicer = slice(start_i, end_i)\n318 |         df = self.obj.iloc[slicer]\n319 | \n320 |         res = df._get_values_for_csv(**self._number_format)\n321 |         data = list(res._iter_column_arrays())\n322 | \n323 |         ix = (\n324 |             self.data_index[slicer]._get_values_for_csv(**self._number_format)\n325 |             if self.nlevels != 0\n326 |             else np.empty(end_i - start_i)\n327 |         )\n328 |         libwriters.write_csv_rows(\n329 |             data,\n330 |             ix,\n331 |             self.nlevels,\n332 |             self.cols,\n333 |             self.writer,\n334 |         )\n335 | \n```\n"}, {"content": "Let me check the DataFrameFormatter implementation since it's likely to contain the float_format property:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/io/formats/format.py:DataFrameFormatter']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"pandas/io/formats/format.py:DataFrameFormatter\"...\n### Search Result:\nFound class `pandas/io/formats/format.py:DataFrameFormatter`.\nSource: Exact match found for entity name `pandas/io/formats/format.py:DataFrameFormatter`.\n```\n416 | class DataFrameFormatter:\n417 |     \"\"\"\n418 |     Class for processing dataframe formatting options and data.\n419 | \n420 |     Used by DataFrame.to_string, which backs DataFrame.__repr__.\n421 |     \"\"\"\n422 | \n423 |     __doc__ = __doc__ if __doc__ else \"\"\n424 |     __doc__ += common_docstring + return_docstring\n425 | \n426 |     def __init__(\n427 |         self,\n428 |         frame: DataFrame,\n429 |         columns: Axes | None = None,\n430 |         col_space: ColspaceArgType | None = None,\n431 