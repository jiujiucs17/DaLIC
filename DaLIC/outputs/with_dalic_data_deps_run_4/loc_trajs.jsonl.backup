dex(columns)\n 554 |             self.frame = self.frame[cols]\n 555 |             return cols\n 556 |         else:\n 557 |             return self.frame.columns\n 558 | \n 559 |     def _initialize_colspace(self, col_space: ColspaceArgType | None) -> ColspaceType:\n 560 |         result: ColspaceType\n 561 | \n 562 |         if col_space is None:\n 563 |             result = {}\n 564 |         elif isinstance(col_space, (int, str)):\n 565 |             result = {\"\": col_space}\n 566 |             result.update({column: col_space for column in self.frame.columns})\n 567 |         elif isinstance(col_space, Mapping):\n 568 |             for column in col_space.keys():\n 569 |                 if column not in self.frame.columns and column != \"\":\n 570 |                     raise ValueError(\n 571 |                         f\"Col_space is defined for an unknown column: {column}\"\n 572 |                     )\n 573 |             result = col_space\n 574 |         else:\n 575 |             if len(self.frame.columns) != len(col_space):\n 576 |                 raise ValueError(\n 577 |                     f\"Col_space length({len(col_space)}) should match \"\n 578 |                     f\"DataFrame number of columns({len(self.frame.columns)})\"\n 579 |                 )\n 580 |             result = dict(zip(self.frame.columns, col_space))\n 581 |         return result\n 582 | \n 583 |     def _calc_max_cols_fitted(self) -> int | None:\n 584 |         \"\"\"Number of columns fitting the screen.\"\"\"\n 585 |         if not self._is_in_terminal():\n 586 |             return self.max_cols\n 587 | \n 588 |         width, _ = get_terminal_size()\n 589 |         if self._is_screen_narrow(width):\n 590 |             return width\n 591 |         else:\n 592 |             return self.max_cols\n 593 | \n 594 |     def _calc_max_rows_fitted(self) -> int | None:\n 595 |         \"\"\"Number of rows with data fitting the screen.\"\"\"\n 596 |         max_rows: int | None\n 597 | \n 598 |         if self._is_in_terminal():\n 599 |             _, height = get_terminal_size()\n 600 |             if self.max_rows == 0:\n 601 |                 # rows available to fill with actual data\n 602 |                 return height - self._get_number_of_auxiliary_rows()\n 603 | \n 604 |             if self._is_screen_short(height):\n 605 |                 max_rows = height\n 606 |             else:\n 607 |                 max_rows = self.max_rows\n 608 |         else:\n 609 |             max_rows = self.max_rows\n 610 | \n 611 |         return self._adjust_max_rows(max_rows)\n 612 | \n 613 |     def _adjust_max_rows(self, max_rows: int | None) -> int | None:\n 614 |         \"\"\"Adjust max_rows using display logic.\n 615 | \n 616 |         See description here:\n 617 |         https://pandas.pydata.org/docs/dev/user_guide/options.html#frequently-used-options\n 618 | \n 619 |         GH #37359\n 620 |         \"\"\"\n 621 |         if max_rows:\n 622 |             if (len(self.frame) > max_rows) and self.min_rows:\n 623 |                 # if truncated, set max_rows showed to min_rows\n 624 |                 max_rows = min(self.min_rows, max_rows)\n 625 |         return max_rows\n 626 | \n 627 |     def _is_in_terminal(self) -> bool:\n 628 |         \"\"\"Check if the output is to be shown in terminal.\"\"\"\n 629 |         return bool(self.max_cols == 0 or self.max_rows == 0)\n 630 | \n 631 |     def _is_screen_narrow(self, max_width) -> bool:\n 632 |         return bool(self.max_cols == 0 and len(self.frame.columns) > max_width)\n 633 | \n 634 |     def _is_screen_short(self, max_height) -> bool:\n 635 |         return bool(self.max_rows == 0 and len(self.frame) > max_height)\n 636 | \n 637 |     def _get_number_of_auxiliary_rows(self) -> int:\n 638 |         \"\"\"Get number of rows occupied by prompt, dots and dimension info.\"\"\"\n 639 |         dot_row = 1\n 640 |         prompt_row = 1\n 641 |         num_rows = dot_row + prompt_row\n 642 | \n 643 |         if self.show_dimensions:\n 644 |             num_rows += len(self.dimensions_info.splitlines())\n 645 | \n 646 |         if self.header:\n 647 |             num_rows += 1\n 648 | \n 649 |         return num_rows\n 650 | \n 651 |     def truncate(self) -> None:\n 652 |         \"\"\"\n 653 |         Check whether the frame should be truncated. If so, slice the frame up.\n 654 |         \"\"\"\n 655 |         if self.is_truncated_horizontally:\n 656 |             self._truncate_horizontally()\n 657 | \n 658 |         if self.is_truncated_vertically:\n 659 |             self._truncate_vertically()\n 660 | \n 661 |     def _truncate_horizontally(self) -> None:\n 662 |         \"\"\"Remove columns, which are not to be displayed and adjust formatters.\n 663 | \n 664 |         Attributes affected:\n 665 |             - tr_frame\n 666 |             - formatters\n 667 |             - tr_col_num\n 668 |         \"\"\"\n 669 |         assert self.max_cols_fitted is not None\n 670 |         col_num = self.max_cols_fitted // 2\n 671 |         if col_num >= 1:\n 672 |             left = self.tr_frame.iloc[:, :col_num]\n 673 |             right = self.tr_frame.iloc[:, -col_num:]\n 674 |             self.tr_frame = concat((left, right), axis=1)\n 675 | \n 676 |             # truncate formatter\n 677 |             if isinstance(self.formatters, (list, tuple)):\n 678 |                 self.formatters = [\n 679 |                     *self.formatters[:col_num],\n 680 |                     *self.formatters[-col_num:],\n 681 |                 ]\n 682 |         else:\n 683 |             col_num = cast(int, self.max_cols)\n 684 |             self.tr_frame = self.tr_frame.iloc[:, :col_num]\n 685 |         self.tr_col_num = col_num\n 686 | \n 687 |     def _truncate_vertically(self) -> None:\n 688 |         \"\"\"Remove rows, which are not to be displayed.\n 689 | \n 690 |         Attributes affected:\n 691 |             - tr_frame\n 692 |             - tr_row_num\n 693 |         \"\"\"\n 694 |         assert self.max_rows_fitted is not None\n 695 |         row_num = self.max_rows_fitted // 2\n 696 |         if row_num >= 1:\n 697 |             _len = len(self.tr_frame)\n 698 |             _slice = np.hstack([np.arange(row_num), np.arange(_len - row_num, _len)])\n 699 |             self.tr_frame = self.tr_frame.iloc[_slice]\n 700 |         else:\n 701 |             row_num = cast(int, self.max_rows)\n 702 |             self.tr_frame = self.tr_frame.iloc[:row_num, :]\n 703 |         self.tr_row_num = row_num\n 704 | \n 705 |     def _get_strcols_without_index(self) -> list[list[str]]:\n 706 |         strcols: list[list[str]] = []\n 707 | \n 708 |         if not is_list_like(self.header) and not self.header:\n 709 |             for i, c in enumerate(self.tr_frame):\n 710 |                 fmt_values = self.format_col(i)\n 711 |                 fmt_values = _make_fixed_width(\n 712 |                     strings=fmt_values,\n 713 |                     justify=self.justify,\n 714 |                     minimum=int(self.col_space.get(c, 0)),\n 715 |                     adj=self.adj,\n 716 |                 )\n 717 |                 strcols.append(fmt_values)\n 718 |             return strcols\n 719 | \n 720 |         if is_list_like(self.header):\n 721 |             # cast here since can't be bool if is_list_like\n 722 |             self.header = cast(list[str], self.header)\n 723 |             if len(self.header) != len(self.columns):\n 724 |                 raise ValueError(\n 725 |                     f\"Writing {len(self.columns)} cols \"\n 726 |                     f\"but got {len(self.header)} aliases\"\n 727 |                 )\n 728 |             str_columns = [[label] for label in self.header]\n 729 |         else:\n 730 |             str_columns = self._get_formatted_column_labels(self.tr_frame)\n 731 | \n 732 |         if self.show_row_idx_names:\n 733 |             for x in str_columns:\n 734 |                 x.append(\"\")\n 735 | \n 736 |         for i, c in enumerate(self.tr_frame):\n 737 |             cheader = str_columns[i]\n 738 |             header_colwidth = max(\n 739 |                 int(self.col_space.get(c, 0)), *(self.adj.len(x) for x in cheader)\n 740 |             )\n 741 |             fmt_values = self.format_col(i)\n 742 |             fmt_values = _make_fixed_width(\n 743 |                 fmt_values, self.justify, minimum=header_colwidth, adj=self.adj\n 744 |             )\n 745 | \n 746 |             max_len = max(*(self.adj.len(x) for x in fmt_values), header_colwidth)\n 747 |             cheader = self.adj.justify(cheader, max_len, mode=self.justify)\n 748 |             strcols.append(cheader + fmt_values)\n 749 | \n 750 |         return strcols\n 751 | \n 752 |     def format_col(self, i: int) -> list[str]:\n 753 |         frame = self.tr_frame\n 754 |         formatter = self._get_formatter(i)\n 755 |         return format_array(\n 756 |             frame.iloc[:, i]._values,\n 757 |             formatter,\n 758 |             float_format=self.float_format,\n 759 |             na_rep=self.na_rep,\n 760 |             space=self.col_space.get(frame.columns[i]),\n 761 |             decimal=self.decimal,\n 762 |             leading_space=self.index,\n 763 |         )\n 764 | \n 765 |     def _get_formatter(self, i: str | int) -> Callable | None:\n 766 |         if isinstance(self.formatters, (list, tuple)):\n 767 |             if is_integer(i):\n 768 |                 i = cast(int, i)\n 769 |                 return self.formatters[i]\n 770 |             else:\n 771 |                 return None\n 772 |         else:\n 773 |             if is_integer(i) and i not in self.columns:\n 774 |                 i = self.columns[i]\n 775 |             return self.formatters.get(i, None)\n 776 | \n 777 |     def _get_formatted_column_labels(self, frame: DataFrame) -> list[list[str]]:\n 778 |         from pandas.core.indexes.multi import sparsify_labels\n 779 | \n 780 |         columns = frame.columns\n 781 | \n 782 |         if isinstance(columns, MultiIndex):\n 783 |             fmt_columns = columns._format_multi(sparsify=False, include_names=False)\n 784 |             if self.sparsify and len(fmt_columns):\n 785 |                 fmt_columns = sparsify_labels(fmt_columns)\n 786 | \n 787 |             str_columns = [list(x) for x in zip(*fmt_columns)]\n 788 |         else:\n 789 |             fmt_columns = columns._format_flat(include_name=False)\n 790 |             str_columns = [\n 791 |                 [\n 792 |                     \" \" + x\n 793 |                     if not self._get_formatter(i) and is_numeric_dtype(dtype)\n 794 |                     else x\n 795 |                 ]\n 796 |                 for i, (x, dtype) in enumerate(zip(fmt_columns, self.frame.dtypes))\n 797 |             ]\n 798 |         return str_columns\n 799 | \n 800 |     def _get_formatted_index(self, frame: DataFrame) -> list[str]:\n 801 |         # Note: this is only used by to_string() and to_latex(), not by\n 802 |         # to_html(). so safe to cast col_space here.\n 803 |         col_space = {k: cast(int, v) for k, v in self.col_space.items()}\n 804 |         index = frame.index\n 805 |         columns = frame.columns\n 806 |         fmt = self._get_formatter(\"__index__\")\n 807 | \n 808 |         if isinstance(index, MultiIndex):\n 809 |             fmt_index = index._format_multi(\n 810 |                 sparsify=self.sparsify,\n 811 |                 include_names=self.show_row_idx_names,\n 812 |                 formatter=fmt,\n 813 |             )\n 814 |         else:\n 815 |             fmt_index = [\n 816 |                 index._format_flat(include_name=self.show_row_idx_names, formatter=fmt)\n 817 |             ]\n 818 | \n 819 |         fmt_index = [\n 820 |             tuple(\n 821 |                 _make_fixed_width(\n 822 |                     list(x), justify=\"left\", minimum=col_space.get(\"\", 0), adj=self.adj\n 823 |                 )\n 824 |             )\n 825 |             for x in fmt_index\n 826 |         ]\n 827 | \n 828 |         adjoined = self.adj.adjoin(1, *fmt_index).split(\"\\n\")\n 829 | \n 830 |         # empty space for columns\n 831 |         if self.show_col_idx_names:\n 832 |             col_header = [str(x) for x in self._get_column_name_list()]\n 833 |         else:\n 834 |             col_header = [\"\"] * columns.nlevels\n 835 | \n 836 |         if self.header:\n 837 |             return col_header + adjoined\n 838 |         else:\n 839 |             return adjoined\n 840 | \n 841 |     def _get_column_name_list(self) -> list[Hashable]:\n 842 |         names: list[Hashable] = []\n 843 |         columns = self.frame.columns\n 844 |         if isinstance(columns, MultiIndex):\n 845 |             names.extend(\"\" if name is None else name for name in columns.names)\n 846 |         else:\n 847 |             names.append(\"\" if columns.name is None else columns.name)\n 848 |         return names\n 849 | \n 850 | \n 851 | class DataFrameRenderer:\n 852 |     \"\"\"Class for creating dataframe output in multiple formats.\n 853 | \n 854 |     Called in pandas.core.generic.NDFrame:\n 855 |         - to_csv\n 856 |         - to_latex\n 857 | \n 858 |     Called in pandas.DataFrame:\n 859 |         - to_html\n 860 |         - to_string\n 861 | \n 862 |     Parameters\n 863 |     ----------\n 864 |     fmt : DataFrameFormatter\n 865 |         Formatter with the formatting options.\n 866 |     \"\"\"\n 867 | \n 868 |     def __init__(self, fmt: DataFrameFormatter) -> None:\n 869 |         self.fmt = fmt\n 870 | \n 871 |     def to_html(\n 872 |         self,\n 873 |         buf: FilePath | WriteBuffer[str] | None = None,\n 874 |         encoding: str | None = None,\n 875 |         classes: str | list | tuple | None = None,\n 876 |         notebook: bool = False,\n 877 |         border: int | bool | None = None,\n 878 |         table_id: str | None = None,\n 879 |         render_links: bool = False,\n 880 |     ) -> str | None:\n 881 |         \"\"\"\n 882 |         Render a DataFrame to a html table.\n 883 | \n 884 |         Parameters\n 885 |         ----------\n 886 |         buf : str, path object, file-like object, or None, default None\n 887 |             String, path object (implementing ``os.PathLike[str]``), or file-like\n 888 |             object implementing a string ``write()`` function. If None, the result is\n 889 |             returned as a string.\n 890 |         encoding : str, default \u201cutf-8\u201d\n 891 |             Set character encoding.\n 892 |         classes : str or list-like\n 893 |             classes to include in the `class` attribute of the opening\n 894 |             ``<table>`` tag, in addition to the default \"dataframe\".\n 895 |         notebook : {True, False}, optional, default False\n 896 |             Whether the generated HTML is for IPython Notebook.\n 897 |         border : int\n 898 |             A ``border=border`` attribute is included in the opening\n 899 |             ``<table>`` tag. Default ``pd.options.display.html.border``.\n 900 |         table_id : str, optional\n 901 |             A css id is included in the opening `<table>` tag if specified.\n 902 |         render_links : bool, default False\n 903 |             Convert URLs to HTML links.\n 904 |         \"\"\"\n 905 |         from pandas.io.formats.html import (\n 906 |             HTMLFormatter,\n 907 |             NotebookFormatter,\n 908 |         )\n 909 | \n 910 |         Klass = NotebookFormatter if notebook else HTMLFormatter\n 911 | \n 912 |         html_formatter = Klass(\n 913 |             self.fmt,\n 914 |             classes=classes,\n 915 |             border=border,\n 916 |             table_id=table_id,\n 917 |             render_links=render_links,\n 918 |         )\n 919 |         string = html_formatter.to_string()\n 920 |         return save_to_buffer(string, buf=buf, encoding=encoding)\n 921 | \n 922 |     def to_string(\n 923 |         self,\n 924 |         buf: FilePath | WriteBuffer[str] | None = None,\n 925 |         encoding: str | None = None,\n 926 |         line_width: int | None = None,\n 927 |     ) -> str | None:\n 928 |         \"\"\"\n 929 |         Render a DataFrame to a console-friendly tabular output.\n 930 | \n 931 |         Parameters\n 932 |         ----------\n 933 |         buf : str, path object, file-like object, or None, default None\n 934 |             String, path object (implementing ``os.PathLike[str]``), or file-like\n 935 |             object implementing a string ``write()`` function. If None, the result is\n 936 |             returned as a string.\n 937 |         encoding: str, default \u201cutf-8\u201d\n 938 |             Set character encoding.\n 939 |         line_width : int, optional\n 940 |             Width to wrap a line in characters.\n 941 |         \"\"\"\n 942 |         from pandas.io.formats.string import StringFormatter\n 943 | \n 944 |         string_formatter = StringFormatter(self.fmt, line_width=line_width)\n 945 |         string = string_formatter.to_string()\n 946 |         return save_to_buffer(string, buf=buf, encoding=encoding)\n 947 | \n 948 |     def to_csv(\n 949 |         self,\n 950 |         path_or_buf: FilePath | WriteBuffer[bytes] | WriteBuffer[str] | None = None,\n 951 |         encoding: str | None = None,\n 952 |         sep: str = \",\",\n 953 |         columns: Sequence[Hashable] | None = None,\n 954 |         index_label: IndexLabel | None = None,\n 955 |         mode: str = \"w\",\n 956 |         compression: CompressionOptions = \"infer\",\n 957 |         quoting: int | None = None,\n 958 |         quotechar: str = '\"',\n 959 |         lineterminator: str | None = None,\n 960 |         chunksize: int | None = None,\n 961 |         date_format: str | None = None,\n 962 |         doublequote: bool = True,\n 963 |         escapechar: str | None = None,\n 964 |         errors: str = \"strict\",\n 965 |         storage_options: StorageOptions | None = None,\n 966 |     ) -> str | None:\n 967 |         \"\"\"\n 968 |         Render dataframe as comma-separated file.\n 969 |         \"\"\"\n 970 |         from pandas.io.formats.csvs import CSVFormatter\n 971 | \n 972 |         if path_or_buf is None:\n 973 |             created_buffer = True\n 974 |             path_or_buf = StringIO()\n 975 |         else:\n 976 |             created_buffer = False\n 977 | \n 978 |         csv_formatter = CSVFormatter(\n 979 |             path_or_buf=path_or_buf,\n 980 |             lineterminator=lineterminator,\n 981 |             sep=sep,\n 982 |             encoding=encoding,\n 983 |             errors=errors,\n 984 |             compression=compression,\n 985 |             quoting=quoting,\n 986 |             cols=columns,\n 987 |             index_label=index_label,\n 988 |             mode=mode,\n 989 |             chunksize=chunksize,\n 990 |             quotechar=quotechar,\n 991 |             date_format=date_format,\n 992 |             doublequote=doublequote,\n 993 |             escapechar=escapechar,\n 994 |             storage_options=storage_options,\n 995 |             formatter=self.fmt,\n 996 |         )\n 997 |         csv_formatter.save()\n 998 | \n 999 |         if created_buffer:\n1000 |             assert isinstance(path_or_buf, StringIO)\n1001 |             content = path_or_buf.getvalue()\n1002 |             path_or_buf.close()\n1003 |             return content\n1004 | \n1005 |         return None\n1006 | \n1007 | \n1008 | def save_to_buffer(\n1009 |     string: str,\n1010 |     buf: FilePath | WriteBuffer[str] | None = None,\n1011 |     encoding: str | None = None,\n1012 | ) -> str | None:\n1013 |     \"\"\"\n1014 |     Perform serialization. Write to buf or return as string if buf is None.\n1015 |     \"\"\"\n1016 |     with _get_buffer(buf, encoding=encoding) as fd:\n1017 |         fd.write(string)\n1018 |         if buf is None:\n1019 |             # error: \"WriteBuffer[str]\" has no attribute \"getvalue\"\n1020 |             return fd.getvalue()  # type: ignore[attr-defined]\n1021 |         return None\n1022 | \n1023 | \n1024 | @contextmanager\n1025 | def _get_buffer(\n1026 |     buf: FilePath | WriteBuffer[str] | None, encoding: str | None = None\n1027 | ) -> Generator[WriteBuffer[str]] | Generator[StringIO]:\n1028 |     \"\"\"\n1029 |     Context manager to open, yield and close buffer for filenames or Path-like\n1030 |     objects, otherwise yield buf unchanged.\n1031 |     \"\"\"\n1032 |     if buf is not None:\n1033 |         buf = stringify_path(buf)\n1034 |     else:\n1035 |         buf = StringIO()\n1036 | \n1037 |     if encoding is None:\n1038 |         encoding = \"utf-8\"\n1039 |     elif not isinstance(buf, str):\n1040 |         raise ValueError(\"buf is not a file name and encoding is specified.\")\n1041 | \n1042 |     if hasattr(buf, \"write\"):\n1043 |         # Incompatible types in \"yield\" (actual type \"Union[str, WriteBuffer[str],\n1044 |         # StringIO]\", expected type \"Union[WriteBuffer[str], StringIO]\")\n1045 |         yield buf  # type: ignore[misc]\n1046 |     elif isinstance(buf, str):\n1047 |         check_parent_directory(str(buf))\n1048 |         with open(buf, \"w\", encoding=encoding, newline=\"\") as f:\n1049 |             # GH#30034 open instead of codecs.open prevents a file leak\n1050 |             #  if we have an invalid encoding argument.\n1051 |             # newline=\"\" is needed to roundtrip correctly on\n1052 |             #  windows test_to_latex_filename\n1053 |             yield f\n1054 |     else:\n1055 |         raise TypeError(\"buf is not a file name and it has no write method\")\n1056 | \n1057 | \n1058 | # ----------------------------------------------------------------------\n1059 | # Array formatters\n1060 | \n1061 | \n1062 | def format_array(\n1063 |     values: ArrayLike,\n1064 |     formatter: Callable | None,\n1065 |     float_format: FloatFormatType | None = None,\n1066 |     na_rep: str = \"NaN\",\n1067 |     digits: int | None = None,\n1068 |     space: str | int | None = None,\n1069 |     justify: str = \"right\",\n1070 |     decimal: str = \".\",\n1071 |     leading_space: bool | None = True,\n1072 |     quoting: int | None = None,\n1073 |     fallback_formatter: Callable | None = None,\n1074 | ) -> list[str]:\n1075 |     \"\"\"\n1076 |     Format an array for printing.\n1077 | \n1078 |     Parameters\n1079 |     ----------\n1080 |     values : np.ndarray or ExtensionArray\n1081 |     formatter\n1082 |     float_format\n1083 |     na_rep\n1084 |     digits\n1085 |     space\n1086 |     justify\n1087 |     decimal\n1088 |     leading_space : bool, optional, default True\n1089 |         Whether the array should be formatted with a leading space.\n1090 |         When an array as a column of a Series or DataFrame, we do want\n1091 |         the leading space to pad between columns.\n1092 | \n1093 |         When formatting an Index subclass\n1094 |         (e.g. IntervalIndex._get_values_for_csv), we don't want the\n1095 |         leading space since it should be left-aligned.\n1096 |     fallback_formatter\n1097 | \n1098 |     Returns\n1099 |     -------\n1100 |     List[str]\n1101 |     \"\"\"\n1102 |     fmt_klass: type[_GenericArrayFormatter]\n1103 |     if lib.is_np_dtype(values.dtype, \"M\"):\n1104 |         fmt_klass = _Datetime64Formatter\n1105 |         values = cast(DatetimeArray, values)\n1106 |     elif isinstance(values.dtype, DatetimeTZDtype):\n1107 |         fmt_klass = _Datetime64TZFormatter\n1108 |         values = cast(DatetimeArray, values)\n1109 |     elif lib.is_np_dtype(values.dtype, \"m\"):\n1110 |         fmt_klass = _Timedelta64Formatter\n1111 |         values = cast(TimedeltaArray, values)\n1112 |     elif isinstance(values.dtype, ExtensionDtype):\n1113 |         fmt_klass = _ExtensionArrayFormatter\n1114 |     elif lib.is_np_dtype(values.dtype, \"fc\"):\n1115 |         fmt_klass = FloatArrayFormatter\n1116 |     elif lib.is_np_dtype(values.dtype, \"iu\"):\n1117 |         fmt_klass = _IntArrayFormatter\n1118 |     else:\n1119 |         fmt_klass = _GenericArrayFormatter\n1120 | \n1121 |     if space is None:\n1122 |         space = 12\n1123 | \n1124 |     if float_format is None:\n1125 |         float_format = get_option(\"display.float_format\")\n1126 | \n1127 |     if digits is None:\n1128 |         digits = get_option(\"display.precision\")\n1129 | \n1130 |     fmt_obj = fmt_klass(\n1131 |         values,\n1132 |         digits=digits,\n1133 |         na_rep=na_rep,\n1134 |         float_format=float_format,\n1135 |         formatter=formatter,\n1136 |         space=space,\n1137 |         justify=justify,\n1138 |         decimal=decimal,\n1139 |         leading_space=leading_space,\n1140 |         quoting=quoting,\n1141 |         fallback_formatter=fallback_formatter,\n1142 |     )\n1143 | \n1144 |     return fmt_obj.get_result()\n1145 | \n1146 | \n1147 | class _GenericArrayFormatter:\n1148 |     def __init__(\n1149 |         self,\n1150 |         values: ArrayLike,\n1151 |         digits: int = 7,\n1152 |         formatter: Callable | None = None,\n1153 |         na_rep: str = \"NaN\",\n1154 |         space: str | int = 12,\n1155 |         float_format: FloatFormatType | None = None,\n1156 |         justify: str = \"right\",\n1157 |         decimal: str = \".\",\n1158 |         quoting: int | None = None,\n1159 |         fixed_width: bool = True,\n1160 |         leading_space: bool | None = True,\n1161 |         fallback_formatter: Callable | None = None,\n1162 |     ) -> None:\n1163 |         self.values = values\n1164 |         self.digits = digits\n1165 |         self.na_rep = na_rep\n1166 |         self.space = space\n1167 |         self.formatter = formatter\n1168 |         self.float_format = float_format\n1169 |         self.justify = justify\n1170 |         self.decimal = decimal\n1171 |         self.quoting = quoting\n1172 |         self.fixed_width = fixed_width\n1173 |         self.leading_space = leading_space\n1174 |         self.fallback_formatter = fallback_formatter\n1175 | \n1176 |     def get_result(self) -> list[str]:\n1177 |         fmt_values = self._format_strings()\n1178 |         return _make_fixed_width(fmt_values, self.justify)\n1179 | \n1180 |     def _format_strings(self) -> list[str]:\n1181 |         if self.float_format is None:\n1182 |             float_format = get_option(\"display.float_format\")\n1183 |             if float_format is None:\n1184 |                 precision = get_option(\"display.precision\")\n1185 |                 float_format = lambda x: _trim_zeros_single_float(\n1186 |                     f\"{x: .{precision:d}f}\"\n1187 |                 )\n1188 |         else:\n1189 |             float_format = self.float_format\n1190 | \n1191 |         if self.formatter is not None:\n1192 |             formatter = self.formatter\n1193 |         elif self.fallback_formatter is not None:\n1194 |             formatter = self.fallback_formatter\n1195 |         else:\n1196 |             quote_strings = self.quoting is not None and self.quoting != QUOTE_NONE\n1197 |             formatter = partial(\n1198 |                 printing.pprint_thing,\n1199 |                 escape_chars=(\"\\t\", \"\\r\", \"\\n\"),\n1200 |                 quote_strings=quote_strings,\n1201 |             )\n1202 | \n1203 |         def _format(x):\n1204 |             if self.na_rep is not None and is_scalar(x) and isna(x):\n1205 |                 if x is None:\n1206 |                     return \"None\"\n1207 |                 elif x is NA:\n1208 |                     return str(NA)\n1209 |                 elif x is NaT or isinstance(x, (np.datetime64, np.timedelta64)):\n1210 |                     return \"NaT\"\n1211 |                 return self.na_rep\n1212 |             elif isinstance(x, PandasObject):\n1213 |                 return str(x)\n1214 |             elif isinstance(x, StringDtype):\n1215 |                 return repr(x)\n1216 |             else:\n1217 |                 # object dtype\n1218 |                 return str(formatter(x))\n1219 | \n1220 |         vals = self.values\n1221 |         if not isinstance(vals, np.ndarray):\n1222 |             raise TypeError(\n1223 |                 \"ExtensionArray formatting should use _ExtensionArrayFormatter\"\n1224 |             )\n1225 |         inferred = lib.map_infer(vals, is_float)\n1226 |         is_float_type = (\n1227 |             inferred\n1228 |             # vals may have 2 or more dimensions\n1229 |             & np.all(notna(vals), axis=tuple(range(1, len(vals.shape))))\n1230 |         )\n1231 |         leading_space = self.leading_space\n1232 |         if leading_space is None:\n1233 |             leading_space = is_float_type.any()\n1234 | \n1235 |         fmt_values = []\n1236 |         for i, v in enumerate(vals):\n1237 |             if (not is_float_type[i] or self.formatter is not None) and leading_space:\n1238 |                 fmt_values.append(f\" {_format(v)}\")\n1239 |             elif is_float_type[i]:\n1240 |                 fmt_values.append(float_format(v))\n1241 |             else:\n1242 |                 if leading_space is False:\n1243 |                     # False specifically, so that the default is\n1244 |                     # to include a space if we get here.\n1245 |                     tpl = \"{v}\"\n1246 |                 else:\n1247 |                     tpl = \" {v}\"\n1248 |                 fmt_values.append(tpl.format(v=_format(v)))\n1249 | \n1250 |         return fmt_values\n1251 | \n1252 | \n1253 | class FloatArrayFormatter(_GenericArrayFormatter):\n1254 |     def __init__(self, *args, **kwargs) -> None:\n1255 |         super().__init__(*args, **kwargs)\n1256 | \n1257 |         # float_format is expected to be a string\n1258 |         # formatter should be used to pass a function\n1259 |         if self.float_format is not None and self.formatter is None:\n1260 |             # GH21625, GH22270\n1261 |             self.fixed_width = False\n1262 |             if callable(self.float_format):\n1263 |                 self.formatter = self.float_format\n1264 |                 self.float_format = None\n1265 | \n1266 |     def _value_formatter(\n1267 |         self,\n1268 |         float_format: FloatFormatType | None = None,\n1269 |         threshold: float | None = None,\n1270 |     ) -> Callable:\n1271 |         \"\"\"Returns a function to be applied on each value to format it\"\"\"\n1272 |         # the float_format parameter supersedes self.float_format\n1273 |         if float_format is None:\n1274 |             float_format = self.float_format\n1275 | \n1276 |         # we are going to compose different functions, to first convert to\n1277 |         # a string, then replace the decimal symbol, and finally chop according\n1278 |         # to the threshold\n1279 | \n1280 |         # when there is no float_format, we use str instead of '%g'\n1281 |         # because str(0.0) = '0.0' while '%g' % 0.0 = '0'\n1282 |         if float_format:\n1283 | \n1284 |             def base_formatter(v):\n1285 |                 assert float_format is not None  # for mypy\n1286 |                 # error: \"str\" not callable\n1287 |                 # error: Unexpected keyword argument \"value\" for \"__call__\" of\n1288 |                 # \"EngFormatter\"\n1289 |                 return (\n1290 |                     float_format(value=v)  # type: ignore[operator,call-arg]\n1291 |                     if notna(v)\n1292 |                     else self.na_rep\n1293 |                 )\n1294 | \n1295 |         else:\n1296 | \n1297 |             def base_formatter(v):\n1298 |                 return str(v) if notna(v) else self.na_rep\n1299 | \n1300 |         if self.decimal != \".\":\n1301 | \n1302 |             def decimal_formatter(v):\n1303 |                 return base_formatter(v).replace(\".\", self.decimal, 1)\n1304 | \n1305 |         else:\n1306 |             decimal_formatter = base_formatter\n1307 | \n1308 |         if threshold is None:\n1309 |             return decimal_formatter\n1310 | \n1311 |         def formatter(value):\n1312 |             if notna(value):\n1313 |                 if abs(value) > threshold:\n1314 |                     return decimal_formatter(value)\n1315 |                 else:\n1316 |                     return decimal_formatter(0.0)\n1317 |             else:\n1318 |                 return self.na_rep\n1319 | \n1320 |         return formatter\n1321 | \n1322 |     def get_result_as_array(self) -> np.ndarray:\n1323 |         \"\"\"\n1324 |         Returns the float values converted into strings using\n1325 |         the parameters given at initialisation, as a numpy array\n1326 |         \"\"\"\n1327 | \n1328 |         def format_with_na_rep(\n1329 |             values: ArrayLike, formatter: Callable, na_rep: str\n1330 |         ) -> np.ndarray:\n1331 |             mask = isna(values)\n1332 |             formatted = np.array(\n1333 |                 [\n1334 |                     formatter(val) if not m else na_rep\n1335 |                     for val, m in zip(values.ravel(), mask.ravel())\n1336 |                 ]\n1337 |             ).reshape(values.shape)\n1338 |             return formatted\n1339 | \n1340 |         def format_complex_with_na_rep(\n1341 |             values: ArrayLike, formatter: Callable, na_rep: str\n1342 |         ) -> np.ndarray:\n1343 |             real_values = np.real(values).ravel()  # type: ignore[arg-type]\n1344 |             imag_values = np.imag(values).ravel()  # type: ignore[arg-type]\n1345 |             real_mask, imag_mask = isna(real_values), isna(imag_values)\n1346 |             formatted_lst = []\n1347 |             for val, real_val, imag_val, re_isna, im_isna in zip(\n1348 |                 values.ravel(),\n1349 |                 real_values,\n1350 |                 imag_values,\n1351 |                 real_mask,\n1352 |                 imag_mask,\n1353 |             ):\n1354 |                 if not re_isna and not im_isna:\n1355 |                     formatted_lst.append(formatter(val))\n1356 |                 elif not re_isna:  # xxx+nanj\n1357 |                     formatted_lst.append(f\"{formatter(real_val)}+{na_rep}j\")\n1358 |                 elif not im_isna:  # nan[+/-]xxxj\n1359 |                     # The imaginary part may either start with a \"-\" or a space\n1360 |                     imag_formatted = formatter(imag_val).strip()\n1361 |                     if imag_formatted.startswith(\"-\"):\n1362 |                         formatted_lst.append(f\"{na_rep}{imag_formatted}j\")\n1363 |                     else:\n1364 |                         formatted_lst.append(f\"{na_rep}+{imag_formatted}j\")\n1365 |                 else:  # nan+nanj\n1366 |                     formatted_lst.append(f\"{na_rep}+{na_rep}j\")\n1367 |             return np.array(formatted_lst).reshape(values.shape)\n1368 | \n1369 |         if self.formatter is not None:\n1370 |             return format_with_na_rep(self.values, self.formatter, self.na_rep)\n1371 | \n1372 |         if self.fixed_width:\n1373 |             threshold = get_option(\"display.chop_threshold\")\n1374 |         else:\n1375 |             threshold = None\n1376 | \n1377 |         # if we have a fixed_width, we'll need to try different float_format\n1378 |         def format_values_with(float_format):\n1379 |             formatter = self._value_formatter(float_format, threshold)\n1380 | \n1381 |             # default formatter leaves a space to the left when formatting\n1382 |             # floats, must be consistent for left-justifying NaNs (GH #25061)\n1383 |             na_rep = \" \" + self.na_rep if self.justify == \"left\" else self.na_rep\n1384 | \n1385 |             # different formatting strategies for complex and non-complex data\n1386 |             # need to distinguish complex and float NaNs (GH #53762)\n1387 |             values = self.values\n1388 |             is_complex = is_complex_dtype(values)\n1389 | \n1390 |             # separate the wheat from the chaff\n1391 |             if is_complex:\n1392 |                 values = format_complex_with_na_rep(values, formatter, na_rep)\n1393 |             else:\n1394 |                 values = format_with_na_rep(values, formatter, na_rep)\n1395 | \n1396 |             if self.fixed_width:\n1397 |                 if is_complex:\n1398 |                     result = _trim_zeros_complex(values, self.decimal)\n1399 |                 else:\n1400 |                     result = _trim_zeros_float(values, self.decimal)\n1401 |                 return np.asarray(result, dtype=\"object\")\n1402 | \n1403 |             return values\n1404 | \n1405 |         # There is a special default string when we are fixed-width\n1406 |         # The default is otherwise to use str instead of a formatting string\n1407 |         float_format: FloatFormatType | None\n1408 |         if self.float_format is None:\n1409 |             if self.fixed_width:\n1410 |                 if self.leading_space is True:\n1411 |                     fmt_str = \"{value: .{digits:d}f}\"\n1412 |                 else:\n1413 |                     fmt_str = \"{value:.{digits:d}f}\"\n1414 |                 float_format = partial(fmt_str.format, digits=self.digits)\n1415 |             else:\n1416 |                 float_format = self.float_format\n1417 |         else:\n1418 |             float_format = lambda value: self.float_format % value\n1419 | \n1420 |         formatted_values = format_values_with(float_format)\n1421 | \n1422 |         if not self.fixed_width:\n1423 |             return formatted_values\n1424 | \n1425 |         # we need do convert to engineering format if some values are too small\n1426 |         # and would appear as 0, or if some values are too big and take too\n1427 |         # much space\n1428 | \n1429 |         if len(formatted_values) > 0:\n1430 |             maxlen = max(len(x) for x in formatted_values)\n1431 |             too_long = maxlen > self.digits + 6\n1432 |         else:\n1433 |             too_long = False\n1434 | \n1435 |         abs_vals = np.abs(self.values)\n1436 |         # this is pretty arbitrary for now\n1437 |         # large values: more that 8 characters including decimal symbol\n1438 |         # and first digit, hence > 1e6\n1439 |         has_large_values = (abs_vals > 1e6).any()\n1440 |         has_small_values = ((abs_vals < 10 ** (-self.digits)) & (abs_vals > 0)).any()\n1441 | \n1442 |         if has_small_values or (too_long and has_large_values):\n1443 |             if self.leading_space is True:\n1444 |                 fmt_str = \"{value: .{digits:d}e}\"\n1445 |             else:\n1446 |                 fmt_str = \"{value:.{digits:d}e}\"\n1447 |             float_format = partial(fmt_str.format, digits=self.digits)\n1448 |             formatted_values = format_values_with(float_format)\n1449 | \n1450 |         return formatted_values\n1451 | \n1452 |     def _format_strings(self) -> list[str]:\n1453 |         return list(self.get_result_as_array())\n1454 | \n1455 | \n1456 | class _IntArrayFormatter(_GenericArrayFormatter):\n1457 |     def _format_strings(self) -> list[str]:\n1458 |         if self.leading_space is False:\n1459 |             formatter_str = lambda x: f\"{x:d}\".format(x=x)\n1460 |         else:\n1461 |             formatter_str = lambda x: f\"{x: d}\".format(x=x)\n1462 |         formatter = self.formatter or formatter_str\n1463 |         fmt_values = [formatter(x) for x in self.values]\n1464 |         return fmt_values\n1465 | \n1466 | \n1467 | class _Datetime64Formatter(_GenericArrayFormatter):\n1468 |     values: DatetimeArray\n1469 | \n1470 |     def __init__(\n1471 |         self,\n1472 |         values: DatetimeArray,\n1473 |         nat_rep: str = \"NaT\",\n1474 |         date_format: None = None,\n1475 |         **kwargs,\n1476 |     ) -> None:\n1477 |         super().__init__(values, **kwargs)\n1478 |         self.nat_rep = nat_rep\n1479 |         self.date_format = date_format\n1480 | \n1481 |     def _format_strings(self) -> list[str]:\n1482 |         \"\"\"we by definition have DO NOT have a TZ\"\"\"\n1483 |         values = self.values\n1484 | \n1485 |         if self.formatter is not None:\n1486 |             return [self.formatter(x) for x in values]\n1487 | \n1488 |         fmt_values = values._format_native_types(\n1489 |             na_rep=self.nat_rep, date_format=self.date_format\n1490 |         )\n1491 |         return fmt_values.tolist()\n1492 | \n1493 | \n1494 | class _ExtensionArrayFormatter(_GenericArrayFormatter):\n1495 |     values: ExtensionArray\n1496 | \n1497 |     def _format_strings(self) -> list[str]:\n1498 |         values = self.values\n1499 | \n1500 |         formatter = self.formatter\n1501 |         fallback_formatter = None\n1502 |         if formatter is None:\n1503 |             fallback_formatter = values._formatter(boxed=True)\n1504 | \n1505 |         if isinstance(values, Categorical):\n1506 |             # Categorical is special for now, so that we can preserve tzinfo\n1507 |             array = values._internal_get_values()\n1508 |         else:\n1509 |             array = np.asarray(values, dtype=object)\n1510 | \n1511 |         fmt_values = format_array(\n1512 |             array,\n1513 |             formatter,\n1514 |             float_format=self.float_format,\n1515 |             na_rep=self.na_rep,\n1516 |             digits=self.digits,\n1517 |             space=self.space,\n1518 |             justify=self.justify,\n1519 |             decimal=self.decimal,\n1520 |             leading_space=self.leading_space,\n1521 |             quoting=self.quoting,\n1522 |             fallback_formatter=fallback_formatter,\n1523 |         )\n1524 |         return fmt_values\n1525 | \n1526 | \n1527 | def format_percentiles(\n1528 |     percentiles: np.ndarray | Sequence[float],\n1529 | ) -> list[str]:\n1530 |     \"\"\"\n1531 |     Outputs rounded and formatted percentiles.\n1532 | \n1533 |     Parameters\n1534 |     ----------\n1535 |     percentiles : list-like, containing floats from interval [0,1]\n1536 | \n1537 |     Returns\n1538 |     -------\n1539 |     formatted : list of strings\n1540 | \n1541 |     Notes\n1542 |     -----\n1543 |     Rounding precision is chosen so that: (1) if any two elements of\n1544 |     ``percentiles`` differ, they remain different after rounding\n1545 |     (2) no entry is *rounded* to 0% or 100%.\n1546 |     Any non-integer is always rounded to at least 1 decimal place.\n1547 | \n1548 |     Examples\n1549 |     --------\n1550 |     Keeps all entries different after rounding:\n1551 | \n1552 |     >>> format_percentiles([0.01999, 0.02001, 0.5, 0.666666, 0.9999])\n1553 |     ['1.999%', '2.001%', '50%', '66.667%', '99.99%']\n1554 | \n1555 |     No element is rounded to 0% or 100% (unless already equal to it).\n1556 |     Duplicates are allowed:\n1557 | \n1558 |     >>> format_percentiles([0, 0.5, 0.02001, 0.5, 0.666666, 0.9999])\n1559 |     ['0%', '50%', '2.0%', '50%', '66.67%', '99.99%']\n1560 |     \"\"\"\n1561 |     percentiles = np.asarray(percentiles)\n1562 | \n1563 |     # It checks for np.nan as well\n1564 |     if (\n1565 |         not is_numeric_dtype(percentiles)\n1566 |         or not np.all(percentiles >= 0)\n1567 |         or not np.all(percentiles <= 1)\n1568 |     ):\n1569 |         raise ValueError(\"percentiles should all be in the interval [0,1]\")\n1570 | \n1571 |     percentiles = 100 * percentiles\n1572 |     prec = get_precision(percentiles)\n1573 |     percentiles_round_type = percentiles.round(prec).astype(int)\n1574 | \n1575 |     int_idx = np.isclose(percentiles_round_type, percentiles)\n1576 | \n1577 |     if np.all(int_idx):\n1578 |         out = percentiles_round_type.astype(str)\n1579 |         return [i + \"%\" for i in out]\n1580 | \n1581 |     unique_pcts = np.unique(percentiles)\n1582 |     prec = get_precision(unique_pcts)\n1583 |     out = np.empty_like(percentiles, dtype=object)\n1584 |     out[int_idx] = percentiles[int_idx].round().astype(int).astype(str)\n1585 | \n1586 |     out[~int_idx] = percentiles[~int_idx].round(prec).astype(str)\n1587 |     return [i + \"%\" for i in out]\n1588 | \n1589 | \n1590 | def get_precision(array: np.ndarray | Sequence[float]) -> int:\n1591 |     to_begin = array[0] if array[0] > 0 else None\n1592 |     to_end = 100 - array[-1] if array[-1] < 100 else None\n1593 |     diff = np.ediff1d(array, to_begin=to_begin, to_end=to_end)\n1594 |     diff = abs(diff)\n1595 |     prec = -np.floor(np.log10(np.min(diff))).astype(int)\n1596 |     prec = max(1, prec)\n1597 |     return prec\n1598 | \n1599 | \n1600 | def _format_datetime64(x: NaTType | Timestamp, nat_rep: str = \"NaT\") -> str:\n1601 |     if x is NaT:\n1602 |         return nat_rep\n1603 | \n1604 |     # Timestamp.__str__ falls back to datetime.datetime.__str__ = isoformat(sep=' ')\n1605 |     # so it already uses string formatting rather than strftime (faster).\n1606 |     return str(x)\n1607 | \n1608 | \n1609 | def _format_datetime64_dateonly(\n1610 |     x: NaTType | Timestamp,\n1611 |     nat_rep: str = \"NaT\",\n1612 |     date_format: str | None = None,\n1613 | ) -> str:\n1614 |     if isinstance(x, NaTType):\n1615 |         return nat_rep\n1616 | \n1617 |     if date_format:\n1618 |         return x.strftime(date_format)\n1619 |     else:\n1620 |         # Timestamp._date_repr relies on string formatting (faster than strftime)\n1621 |         return x._date_repr\n1622 | \n1623 | \n1624 | def get_format_datetime64(\n1625 |     is_dates_only: bool, nat_rep: str = \"NaT\", date_format: str | None = None\n1626 | ) -> Callable:\n1627 |     \"\"\"Return a formatter callable taking a datetime64 as input and providing\n1628 |     a string as output\"\"\"\n1629 | \n1630 |     if is_dates_only:\n1631 |         return lambda x: _format_datetime64_dateonly(\n1632 |             x, nat_rep=nat_rep, date_format=date_format\n1633 |         )\n1634 |     else:\n1635 |         return lambda x: _format_datetime64(x, nat_rep=nat_rep)\n1636 | \n1637 | \n1638 | class _Datetime64TZFormatter(_Datetime64Formatter):\n1639 |     values: DatetimeArray\n1640 | \n1641 |     def _format_strings(self) -> list[str]:\n1642 |         \"\"\"we by definition have a TZ\"\"\"\n1643 |         ido = self.values._is_dates_only\n1644 |         values = self.values.astype(object)\n1645 |         formatter = self.formatter or get_format_datetime64(\n1646 |             ido, date_format=self.date_format\n1647 |         )\n1648 |         fmt_values = [formatter(x) for x in values]\n1649 | \n1650 |         return fmt_values\n1651 | \n1652 | \n1653 | class _Timedelta64Formatter(_GenericArrayFormatter):\n1654 |     values: TimedeltaArray\n1655 | \n1656 |     def __init__(\n1657 |         self,\n1658 |         values: TimedeltaArray,\n1659 |         nat_rep: str = \"NaT\",\n1660 |         **kwargs,\n1661 |     ) -> None:\n1662 |         # TODO: nat_rep is never passed, na_rep is.\n1663 |         super().__init__(values, **kwargs)\n1664 |         self.nat_rep = nat_rep\n1665 | \n1666 |     def _format_strings(self) -> list[str]:\n1667 |         formatter = self.formatter or get_format_timedelta64(\n1668 |             self.values, nat_rep=self.nat_rep, box=False\n1669 |         )\n1670 |         return [formatter(x) for x in self.values]\n1671 | \n1672 | \n1673 | def get_format_timedelta64(\n1674 |     values: TimedeltaArray,\n1675 |     nat_rep: str | float = \"NaT\",\n1676 |     box: bool = False,\n1677 | ) -> Callable:\n1678 |     \"\"\"\n1679 |     Return a formatter function for a range of timedeltas.\n1680 |     These will all have the same format argument\n1681 | \n1682 |     If box, then show the return in quotes\n1683 |     \"\"\"\n1684 |     even_days = values._is_dates_only\n1685 | \n1686 |     if even_days:\n1687 |         format = None\n1688 |     else:\n1689 |         format = \"long\"\n1690 | \n1691 |     def _formatter(x):\n1692 |         if x is None or (is_scalar(x) and isna(x)):\n1693 |             return nat_rep\n1694 | \n1695 |         if not isinstance(x, Timedelta):\n1696 |             x = Timedelta(x)\n1697 | \n1698 |         # Timedelta._repr_base uses string formatting (faster than strftime)\n1699 |         result = x._repr_base(format=format)\n1700 |         if box:\n1701 |             result = f\"'{result}'\"\n1702 |         return result\n1703 | \n1704 |     return _formatter\n1705 | \n1706 | \n1707 | def _make_fixed_width(\n1708 |     strings: list[str],\n1709 |     justify: str = \"right\",\n1710 |     minimum: int | None = None,\n1711 |     adj: printing._TextAdjustment | None = None,\n1712 | ) -> list[str]:\n1713 |     if len(strings) == 0 or justify == \"all\":\n1714 |         return strings\n1715 | \n1716 |     if adj is None:\n1717 |         adjustment = printing.get_adjustment()\n1718 |     else:\n1719 |         adjustment = adj\n1720 | \n1721 |     max_len = max(adjustment.len(x) for x in strings)\n1722 | \n1723 |     if minimum is not None:\n1724 |         max_len = max(minimum, max_len)\n1725 | \n1726 |     conf_max = get_option(\"display.max_colwidth\")\n1727 |     if conf_max is not None and max_len > conf_max:\n1728 |         max_len = conf_max\n1729 | \n1730 |     def just(x: str) -> str:\n1731 |         if conf_max is not None:\n1732 |             if (conf_max > 3) & (adjustment.len(x) > max_len):\n1733 |                 x = x[: max_len - 3] + \"...\"\n1734 |         return x\n1735 | \n1736 |     strings = [just(x) for x in strings]\n1737 |     result = adjustment.justify(strings, max_len, mode=justify)\n1738 |     return result\n1739 | \n1740 | \n1741 | def _trim_zeros_complex(str_complexes: ArrayLike, decimal: str = \".\") -> list[str]:\n1742 |     \"\"\"\n1743 |     Separates the real and imaginary parts from the complex number, and\n1744 |     executes the _trim_zeros_float method on each of those.\n1745 |     \"\"\"\n1746 |     real_part, imag_part = [], []\n1747 |     for x in str_complexes:\n1748 |         # Complex numbers are represented as \"(-)xxx(+/-)xxxj\"\n1749 |         # The split will give [{\"\", \"-\"}, \"xxx\", \"+/-\", \"xxx\", \"j\", \"\"]\n1750 |         # Therefore, the imaginary part is the 4th and 3rd last elements,\n1751 |         # and the real part is everything before the imaginary part\n1752 |         trimmed = re.split(r\"(?<!e)([j+-])\", x)\n1753 |         real_part.append(\"\".join(trimmed[:-4]))\n1754 |         imag_part.append(\"\".join(trimmed[-4:-2]))\n1755 | \n1756 |     # We want to align the lengths of the real and imaginary parts of each complex\n1757 |     # number, as well as the lengths the real (resp. complex) parts of all numbers\n1758 |     # in the array\n1759 |     n = len(str_complexes)\n1760 |     padded_parts = _trim_zeros_float(real_part + imag_part, decimal)\n1761 |     if len(padded_parts) == 0:\n1762 |         return []\n1763 |     padded_length = max(len(part) for part in padded_parts) - 1\n1764 |     padded = [\n1765 |         real_pt  # real part, possibly NaN\n1766 |         + imag_pt[0]  # +/-\n1767 |         + f\"{imag_pt[1:]:>{padded_length}}\"  # complex part (no sign), possibly nan\n1768 |         + \"j\"\n1769 |         for real_pt, imag_pt in zip(padded_parts[:n], padded_parts[n:])\n1770 |     ]\n1771 |     return padded\n1772 | \n1773 | \n1774 | def _trim_zeros_single_float(str_float: str) -> str:\n1775 |     \"\"\"\n1776 |     Trims trailing zeros after a decimal point,\n1777 |     leaving just one if necessary.\n1778 |     \"\"\"\n1779 |     str_float = str_float.rstrip(\"0\")\n1780 |     if str_float.endswith(\".\"):\n1781 |         str_float += \"0\"\n1782 | \n1783 |     return str_float\n1784 | \n1785 | \n1786 | def _trim_zeros_float(\n1787 |     str_floats: ArrayLike | list[str], decimal: str = \".\"\n1788 | ) -> list[str]:\n1789 |     \"\"\"\n1790 |     Trims the maximum number of trailing zeros equally from\n1791 |     all numbers containing decimals, leaving just one if\n1792 |     necessary.\n1793 |     \"\"\"\n1794 |     trimmed = str_floats\n1795 |     number_regex = re.compile(rf\"^\\s*[\\+-]?[0-9]+\\{decimal}[0-9]*$\")\n1796 | \n1797 |     def is_number_with_decimal(x) -> bool:\n1798 |         return re.match(number_regex, x) is not None\n1799 | \n1800 |     def should_trim(values: ArrayLike | list[str]) -> bool:\n1801 |         \"\"\"\n1802 |         Determine if an array of strings should be trimmed.\n1803 | \n1804 |         Returns True if all numbers containing decimals (defined by the\n1805 |         above regular expression) within the array end in a zero, otherwise\n1806 |         returns False.\n1807 |         \"\"\"\n1808 |         numbers = [x for x in values if is_number_with_decimal(x)]\n1809 |         return len(numbers) > 0 and all(x.endswith(\"0\") for x in numbers)\n1810 | \n1811 |     while should_trim(trimmed):\n1812 |         trimmed = [x[:-1] if is_number_with_decimal(x) else x for x in trimmed]\n1813 | \n1814 |     # leave one 0 after the decimal points if need be.\n1815 |     result = [\n1816 |         x + \"0\" if is_number_with_decimal(x) and x.endswith(decimal) else x\n1817 |         for x in trimmed\n1818 |     ]\n1819 |     return result\n1820 | \n1821 | \n1822 | def _has_names(index: Index) -> bool:\n1823 |     if isinstance(index, MultiIndex):\n1824 |         return com.any_not_none(*index.names)\n1825 |     else:\n1826 |         return index.name is not None\n1827 | \n1828 | \n1829 | class EngFormatter:\n1830 |     \"\"\"\n1831 |     Formats float values according to engineering format.\n1832 | \n1833 |     Based on matplotlib.ticker.EngFormatter\n1834 |     \"\"\"\n1835 | \n1836 |     # The SI engineering prefixes\n1837 |     ENG_PREFIXES = {\n1838 |         -24: \"y\",\n1839 |         -21: \"z\",\n1840 |         -18: \"a\",\n1841 |         -15: \"f\",\n1842 |         -12: \"p\",\n1843 |         -9: \"n\",\n1844 |         -6: \"u\",\n1845 |         -3: \"m\",\n1846 |         0: \"\",\n1847 |         3: \"k\",\n1848 |         6: \"M\",\n1849 |         9: \"G\",\n1850 |         12: \"T\",\n1851 |         15: \"P\",\n1852 |         18: \"E\",\n1853 |         21: \"Z\",\n1854 |         24: \"Y\",\n1855 |     }\n1856 | \n1857 |     def __init__(\n1858 |         self, accuracy: int | None = None, use_eng_prefix: bool = False\n1859 |     ) -> None:\n1860 |         self.accuracy = accuracy\n1861 |         self.use_eng_prefix = use_eng_prefix\n1862 | \n1863 |     def __call__(self, num: float) -> str:\n1864 |         \"\"\"\n1865 |         Formats a number in engineering notation, appending a letter\n1866 |         representing the power of 1000 of the original number. Some examples:\n1867 |         >>> format_eng = EngFormatter(accuracy=0, use_eng_prefix=True)\n1868 |         >>> format_eng(0)\n1869 |         ' 0'\n1870 |         >>> format_eng = EngFormatter(accuracy=1, use_eng_prefix=True)\n1871 |         >>> format_eng(1_000_000)\n1872 |         ' 1.0M'\n1873 |         >>> format_eng = EngFormatter(accuracy=2, use_eng_prefix=False)\n1874 |         >>> format_eng(\"-1e-6\")\n1875 |         '-1.00E-06'\n1876 | \n1877 |         @param num: the value to represent\n1878 |         @type num: either a numeric value or a string that can be converted to\n1879 |                    a numeric value (as per decimal.Decimal constructor)\n1880 | \n1881 |         @return: engineering formatted string\n1882 |         \"\"\"\n1883 |         dnum = Decimal(str(num))\n1884 | \n1885 |         if Decimal.is_nan(dnum):\n1886 |             return \"NaN\"\n1887 | \n1888 |         if Decimal.is_infinite(dnum):\n1889 |             return \"inf\"\n1890 | \n1891 |         sign = 1\n1892 | \n1893 |         if dnum < 0:  # pragma: no cover\n1894 |             sign = -1\n1895 |             dnum = -dnum\n1896 | \n1897 |         if dnum != 0:\n1898 |             pow10 = Decimal(int(math.floor(dnum.log10() / 3) * 3))\n1899 |         else:\n1900 |             pow10 = Decimal(0)\n1901 | \n1902 |         pow10 = pow10.min(max(self.ENG_PREFIXES.keys()))\n1903 |         pow10 = pow10.max(min(self.ENG_PREFIXES.keys()))\n1904 |         int_pow10 = int(pow10)\n1905 | \n1906 |         if self.use_eng_prefix:\n1907 |             prefix = self.ENG_PREFIXES[int_pow10]\n1908 |         elif int_pow10 < 0:\n1909 |             prefix = f\"E-{-int_pow10:02d}\"\n1910 |         else:\n1911 |             prefix = f\"E+{int_pow10:02d}\"\n1912 | \n1913 |         mant = sign * dnum / (10**pow10)\n1914 | \n1915 |         if self.accuracy is None:  # pragma: no cover\n1916 |             format_str = \"{mant: g}{prefix}\"\n1917 |         else:\n1918 |             format_str = f\"{{mant: .{self.accuracy:d}f}}{{prefix}}\"\n1919 | \n1920 |         formatted = format_str.format(mant=mant, prefix=prefix)\n1921 | \n1922 |         return formatted\n1923 | \n1924 | \n1925 | def set_eng_float_format(accuracy: int = 3, use_eng_prefix: bool = False) -> None:\n1926 |     \"\"\"\n1927 |     Format float representation in DataFrame with SI notation.\n1928 | \n1929 |     Sets the floating-point display format for ``DataFrame`` objects using engineering\n1930 |     notation (SI units), allowing easier readability of values across wide ranges.\n1931 | \n1932 |     Parameters\n1933 |     ----------\n1934 |     accuracy : int, default 3\n1935 |         Number of decimal digits after the floating point.\n1936 |     use_eng_prefix : bool, default False\n1937 |         Whether to represent a value with SI prefixes.\n1938 | \n1939 |     Returns\n1940 |     -------\n1941 |     None\n1942 |         This method does not return a value. it updates the global display format\n1943 |         for floats in DataFrames.\n1944 | \n1945 |     See Also\n1946 |     --------\n1947 |     set_option : Set the value of the specified option or options.\n1948 |     reset_option : Reset one or more options to their default value.\n1949 | \n1950 |     Examples\n1951 |     --------\n1952 |     >>> df = pd.DataFrame([1e-9, 1e-3, 1, 1e3, 1e6])\n1953 |     >>> df\n1954 |                   0\n1955 |     0  1.000000e-09\n1956 |     1  1.000000e-03\n1957 |     2  1.000000e+00\n1958 |     3  1.000000e+03\n1959 |     4  1.000000e+06\n1960 | \n1961 |     >>> pd.set_eng_float_format(accuracy=1)\n1962 |     >>> df\n1963 |              0\n1964 |     0  1.0E-09\n1965 |     1  1.0E-03\n1966 |     2  1.0E+00\n1967 |     3  1.0E+03\n1968 |     4  1.0E+06\n1969 | \n1970 |     >>> pd.set_eng_float_format(use_eng_prefix=True)\n1971 |     >>> df\n1972 |             0\n1973 |     0  1.000n\n1974 |     1  1.000m\n1975 |     2   1.000\n1976 |     3  1.000k\n1977 |     4  1.000M\n1978 | \n1979 |     >>> pd.set_eng_float_format(accuracy=1, use_eng_prefix=True)\n1980 |     >>> df\n1981 |           0\n1982 |     0  1.0n\n1983 |     1  1.0m\n1984 |     2   1.0\n1985 |     3  1.0k\n1986 |     4  1.0M\n1987 | \n1988 |     >>> pd.set_option(\"display.float_format\", None)  # unset option\n1989 |     \"\"\"\n1990 |     set_option(\"display.float_format\", EngFormatter(accuracy, use_eng_prefix))\n1991 | \n1992 | \n1993 | def get_level_lengths(\n1994 |     levels: Any, sentinel: bool | object | str = \"\"\n1995 | ) -> list[dict[int, int]]:\n1996 |     \"\"\"\n1997 |     For each index in each level the function returns lengths of indexes.\n1998 | \n1999 |     Parameters\n2000 |     ----------\n2001 |     levels : list of lists\n2002 |         List of values on for level.\n2003 |     sentinel : string, optional\n2004 |         Value which states that no new index starts on there.\n2005 | \n2006 |     Returns\n2007 |     -------\n2008 |     Returns list of maps. For each level returns map of indexes (key is index\n2009 |     in row and value is length of index).\n2010 |     \"\"\"\n2011 |     if len(levels) == 0:\n2012 |         return []\n2013 | \n2014 |     control = [True] * len(levels[0])\n2015 | \n2016 |     result = []\n2017 |     for level in levels:\n2018 |         last_index = 0\n2019 | \n2020 |         lengths = {}\n2021 |         for i, key in enumerate(level):\n2022 |             if control[i] and key == sentinel:\n2023 |                 pass\n2024 |             else:\n2025 |                 control[i] = False\n2026 |                 lengths[last_index] = i - last_index\n2027 |                 last_index = i\n2028 | \n2029 |         lengths[last_index] = len(level) - last_index\n2030 | \n2031 |         result.append(lengths)\n2032 | \n2033 |     return result\n2034 | \n2035 | \n2036 | def buffer_put_lines(buf: WriteBuffer[str], lines: list[str]) -> None:\n2037 |     \"\"\"\n2038 |     Appends lines to a buffer.\n2039 | \n2040 |     Parameters\n2041 |     ----------\n2042 |     buf\n2043 |         The buffer to write to\n2044 |     lines\n2045 |         The lines to append.\n2046 |     \"\"\"\n2047 |     if any(isinstance(x, str) for x in lines):\n2048 |         lines = [str(x) for x in lines]\n2049 |     buf.write(\"\\n\".join(lines))\n2050 | \n```\n"}, {"content": "Based on the analysis of the issue and the codebase exploration, I've identified the relevant locations for implementing examples of the `float_format` parameter in the `to_csv` documentation. Here are the key locations:\n\n```\npandas/io/formats/csvs.py\nline: 106-107\nclass: CSVFormatter\nfunction: float_format\n\npandas/io/formats/format.py\nline: 111-112\nclass: DataFrameFormatter\nfunction: _number_format\n\npandas/io/formats/format.py\nline: 1111-1112\nclass: FloatArrayFormatter\nfunction: _value_formatter\n\npandas/io/formats/format.py\nline: 436\nclass: DataFrameFormatter\nfunction: __init__\n\npandas/io/formats/csvs.py\nline: 970-971\nfunction: to_csv\n```\n\nThese locations are important because:\n\n1. `pandas/io/formats/csvs.py`: Contains the CSVFormatter class that handles CSV formatting options, including float_format. This is where the float_format parameter is actually implemented.\n\n2. `pandas/io/formats/format.py`: Contains the core formatting functionality. The `_number_format` dictionary in `DataFrameFormatter` class shows where float_format is stored and propagated. The `_value_formatter` function in `FloatArrayFormatter` shows how the float_format is applied to numerical values.\n\n3. The documentation needs to be updated in these key files to provide clear examples of how the `float_format` parameter works. Specifically:\n   - In `DataFrameFormatter.__init__` where float_format is initially set\n   - In `FloatArrayFormatter._value_formatter` where the actual formatting occurs\n   - In `CSVFormatter.float_format` which provides access to the float_format setting\n\nThese locations form the complete chain of how the `float_format` parameter is processed and applied during CSV generation, making them ideal places to add the requested examples.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 150575, "completion_tokens": 699}, "time": 117.89927506446838}]}}
{"instance_id": "pandas-dev__pandas-60187", "found_files": [["pandas/core/series.py", "pandas/core/arrays/datetimelike.py", "pandas/core/arrays/_mixins.py", "pandas/core/dtypes/common.py"]], "found_modules": [["pandas/core/arrays/datetimelike.py:TimelikeOps", "pandas/core/series.py:Series", "pandas/plotting/_matplotlib/boxplot.py:BoxPlot", "pandas/core/dtypes/common.py:pandas_dtype"]], "found_entities": [["pandas/core/arrays/datetimelike.py:TimelikeOps.round", "pandas/core/series.py:Series.round", "pandas/plotting/_matplotlib/boxplot.py:BoxPlot._kind", "pandas/core/dtypes/common.py:pandas_dtype"]], "raw_output_loc": ["Based on my analysis, I can now provide the locations that need to be modified to implement the suggested documentation enhancement. The issue is about improving documentation visibility for the `Series.dt.round` functionality, which currently isn't clearly documented in relation to `Series.round`.\n\nHere are the relevant locations that need modification:\n\n```\npandas/core/series.py\nline: 2481-2485\nfunction: Series.round\ndescription: Need to update \"See Also\" section to include Series.dt.round\n\npandas/core/arrays/datetimelike.py\nline: 2183-2189\nclass: TimelikeOps\nfunction: round\ndescription: Source implementation showing dt-specific rounding functionality\n\ndoc/source/reference/api/pandas.Series.round.rst\ndescription: Documentation file that needs updating\n\npandas/core/arrays/_mixins.py\nline: 2160-2180\nclass: NDArrayBackedExtensionArray\nfunction: _round\ndescription: Core implementation for array rounding operations\n\npandas/core/dtypes/common.py\nline: 64-70\nfunction: pandas_dtype\ndescription: Helper function for type handling in rounding operations\n```\n\nThese locations are ordered by importance, with the main documentation file needing the most updates, followed by the core implementation files that provide the underlying functionality. The key modifications would involve:\n\n1. Updating the main `Series.round` documentation to include `Series.dt.round` in the \"See Also\" section\n2. Ensuring proper documentation of datetime-specific rounding behavior in the source code\n3. Maintaining consistency across related implementation files\n4. Providing clear type annotations and examples for datetime-specific rounding operations"], "meta_data": {"repo": "pandas-dev/pandas", "base_commit": "dbeeb1f05bca199b3c1aed979e6ae72074a82243", "problem_statement": "DOC: Distinguish between Series.round and Series.dt.round\n### Pandas version checks\n\n- [X] I have checked that the issue still exists on the latest versions of the docs on `main` [here](https://pandas.pydata.org/docs/dev/)\n\n\n### Location of the documentation\n\nhttps://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.Series.round.html#pandas.Series.round\n\n### Documentation problem\n\nWhen using Series.round, it does not work on date data.\n\n### Suggested fix for documentation\n\nAdding Series.dt.round in the \"See also\" section would make it more convenient for users to find the relevant documentation.\r\nhttps://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.Series.dt.round.html\n", "patch": "diff --git a/pandas/core/series.py b/pandas/core/series.py\nindex fe2bb0b5aa5c3..d83d9715878f8 100644\n--- a/pandas/core/series.py\n+++ b/pandas/core/series.py\n@@ -2482,6 +2482,7 @@ def round(self, decimals: int = 0, *args, **kwargs) -> Series:\n         --------\n         numpy.around : Round values of an np.array.\n         DataFrame.round : Round values of a DataFrame.\n+        Series.dt.round : Round values of data to the specified freq.\n \n         Notes\n         -----\n"}, "usage": {"cost($)": "0", "prompt_tokens": 80873, "completion_tokens": 537}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'pandas-dev' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described execution flow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described execution flow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Clarify the Purpose of the Issue\n    - If expanding capabilities: Identify where and how are the new behavior, fields, or modules incorporated.\n- Reconstruct the execution flow\n    - Identify main entry points triggering the feature described in the issue.\n    - Trace function calls, class interactions, and sequences of events.\n    - Identify potential relevant points in the code workflow of the codebase.\n    - Use the unique artifacts provided to you to complement your understanding of the execution flow, or use as a hint.\n    Important: Keep the reconstructed flow focused on the problem, avoiding irrelevant details.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: DOC: Distinguish between Series.round and Series.dt.round\n\n### Pandas version checks\n\n- [X] I have checked that the issue still exists on the latest versions of the docs on `main` [here](https://pandas.pydata.org/docs/dev/)\n\n\n### Location of the documentation\n\nhttps://pandas.pydata.org/pandas-docs/stable/reference/api/pandas.Series.round.html#pandas.Series.round\n\n### Documentation problem\n\nWhen using Series.round,