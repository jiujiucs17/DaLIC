0 | \n461 |     Bounds_error is currently hardcoded to False since non-scipy ones don't\n462 |     take it as an argument.\n463 | \n464 |     Notes\n465 |     -----\n466 |     Fills 'yvalues' in-place.\n467 |     \"\"\"\n468 |     if mask is not None:\n469 |         invalid = mask\n470 |     else:\n471 |         invalid = isna(yvalues)\n472 |     valid = ~invalid\n473 | \n474 |     if not valid.any():\n475 |         return\n476 | \n477 |     if valid.all():\n478 |         return\n479 | \n480 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n481 |     all_nans = np.flatnonzero(invalid)\n482 | \n483 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n484 |     if first_valid_index is None:  # no nan found in start\n485 |         first_valid_index = 0\n486 |     start_nans = np.arange(first_valid_index)\n487 | \n488 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n489 |     if last_valid_index is None:  # no nan found in end\n490 |         last_valid_index = len(yvalues)\n491 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n492 | \n493 |     # preserve_nans contains indices of invalid values,\n494 |     # but in this case, it is the final set of indices that need to be\n495 |     # preserved as NaN after the interpolation.\n496 | \n497 |     # For example if limit_direction='forward' then preserve_nans will\n498 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n499 |     # are more than 'limit' away from the prior non-NaN.\n500 | \n501 |     # set preserve_nans based on direction using _interp_limit\n502 |     if limit_direction == \"forward\":\n503 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n504 |     elif limit_direction == \"backward\":\n505 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n506 |     else:\n507 |         # both directions... just use _interp_limit\n508 |         preserve_