multiple axes, layout keyword is ignored.\",\n231 |                     UserWarning,\n232 |                 )\n233 |             if sharex or sharey:\n234 |                 warnings.warn(\n235 |                     \"When passing multiple axes, sharex and sharey \"\n236 |                     \"are ignored. These settings must be specified when creating axes.\",\n237 |                     UserWarning,\n238 |                     stacklevel=find_stack_level(),\n239 |                 )\n240 |             if ax.size == naxes:\n241 |                 fig = ax.flat[0].get_figure()\n242 |                 return fig, ax\n243 |             else:\n244 |                 raise ValueError(\n245 |                     f\"The number of passed axes must be {naxes}, the \"\n246 |                     \"same as the output plot\"\n247 |                 )\n248 | \n249 |         fig = ax.get_figure()\n250 |         # if ax is passed and a number of subplots is 1, return ax as it is\n251 |         if naxes == 1:\n252 |             if squeeze:\n253 |                 return fig, ax\n254 |             else:\n255 |                 return fig, flatten_axes(ax)\n256 |         else:\n257 |             warnings.warn(\n258 |                 \"To output multiple subplots, the figure containing \"\n259 |                 \"the passed axes is being cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sha