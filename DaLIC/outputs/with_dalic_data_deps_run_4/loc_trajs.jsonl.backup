 = _beta_loss_to_float(beta)\n 96 | \n 97 |     # The method can be called with scalars\n 98 |     if not sp.issparse(X):\n 99 |         X = np.atleast_2d(X)\n100 |     W = np.atleast_2d(W)\n101 |     H = np.atleast_2d(H)\n102 | \n103 |     # Frobenius norm\n104 |     if beta == 2:\n105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n106 |         if sp.issparse(X):\n107 |             norm_X = np.dot(X.data, X.data)\n108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n109 |             cross_prod = trace_dot((X * H.T), W)\n110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n111 |         else:\n112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n\n\n##Searching for entity `sklearn/decomposition/_nmf.py:_multiplicative_update_w`...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_w`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:_multiplicative_update_w`.\n```\n537 | def _multiplicative_update_w(\n538 |     X,\n539 |     W,\n540 |     H,\n541 |     beta_loss,\n542 |     l1_reg_W,\n543 |     l2_reg_W,\n544 |     gamma,\n545 |     H_sum=None,\n546 |     HHt=None,\n547 |     XHt=None,\n548 |     update_H=True,\n549 | ):\n550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n551 |     if beta_loss == 2:\n552 |         # Numerator\n553 |         if XHt is None:\n554 |             XHt = safe_sparse_dot(X, H.T)\n555 |         if update_H:\n556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n557 |             numerator = XHt\n558 |         else:\n559 |             # preserve the XHt, which is not re-computed (update_H=False)\n560 |             numerator = XHt.copy()\n561 | \n562 |         # Denominator\n563 |         if HHt is None:\n564 |             HHt = np.dot(H, H.T)\n565 |         denominator = np.dot(W, HHt)\n566 | \n567 |     else:\n568 |         # Numerator\n569 |         # if X is sparse, compute WH only where X is non zero\n570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n571 |         if sp.issparse(X):\n572 |             WH_safe_X_data = WH_safe_X.data\n573 |             X_data = X.data\n574 |         else:\n575 |             WH_safe_X_data = WH_safe_X\n576 |             X_data = X\n577 |             # copy used in the Denominator\n578 |             WH = WH_safe_X.copy()\n579 |             if beta_loss - 1.0 < 0:\n580 |                 WH[WH == 0] = EPSILON\n581 | \n582 |         # to avoid taking a negative power of zero\n583 |         if beta_loss - 2.0 < 0:\n584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n585 | \n586 |         if beta_loss == 1:\n587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n588 |         elif beta_loss == 0:\n589 |             # speeds up computation time\n590 |             # refer to /numpy/numpy/issues/9363\n591 |             WH_safe_X_data **= -1\n592 |             WH_safe_X_data **= 2\n593 |             # element-wise multiplication\n594 |             WH_safe_X_data *= X_data\n595 |         else:\n596 |             WH_safe_X_data **= beta_loss - 2\n597 |             # element-wise multiplication\n598 |             WH_safe_X_data *= X_data\n599 | \n600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n602 | \n603 |         # Denominator\n604 |         if beta_loss == 1:\n605 |             if H_sum is None:\n606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n607 |             denominator = H_sum[np.newaxis, :]\n608 | \n609 |         else:\n610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n611 |             if sp.issparse(X):\n612 |                 # memory efficient computation\n613 |                 # (compute row by row, avoiding the dense matrix WH)\n614 |                 WHHt = np.empty(W.shape)\n615 |                 for i in range(X.shape[0]):\n616 |                     WHi = np.dot(W[i, :], H)\n617 |                     if beta_loss - 1 < 0:\n618 |                         WHi[WHi == 0] = EPSILON\n619 |                     WHi **= beta_loss - 1\n620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n621 |             else:\n622 |                 WH **= beta_loss - 1\n623 |                 WHHt = np.dot(WH, H.T)\n624 |             denominator = WHHt\n625 | \n626 |     # Add L1 and L2 regularization\n627 |     if l1_reg_W > 0:\n628 |         denominator += l1_reg_W\n629 |     if l2_reg_W > 0:\n630 |         denominator = denominator + l2_reg_W * W\n631 |     denominator[denominator == 0] = EPSILON\n632 | \n633 |     numerator /= denominator\n634 |     delta_W = numerator\n635 | \n636 |     # gamma is in ]0, 1]\n637 |     if gamma != 1:\n638 |         delta_W **= gamma\n639 | \n640 |     return delta_W, H_sum, HHt, XHt\n```\n\n\n##Searching for entity `sklearn/decomposition/_nmf.py:_multiplicative_update_h`...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_multiplicative_update_h`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:_multiplicative_update_h`.\n```\n643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n645 |     if beta_loss == 2:\n646 |         numerator = safe_sparse_dot(W.T, X)\n647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n648 | \n649 |     else:\n650 |         # Numerator\n651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n652 |         if sp.issparse(X):\n653 |             WH_safe_X_data = WH_safe_X.data\n654 |             X_data = X.data\n655 |         else:\n656 |             WH_safe_X_data = WH_safe_X\n657 |             X_data = X\n658 |             # copy used in the Denominator\n659 |             WH = WH_safe_X.copy()\n660 |             if beta_loss - 1.0 < 0:\n661 |                 WH[WH == 0] = EPSILON\n662 | \n663 |         # to avoid division by zero\n664 |         if beta_loss - 2.0 < 0:\n665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n666 | \n667 |         if beta_loss == 1:\n668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n669 |         elif beta_loss == 0:\n670 |             # speeds up computation time\n671 |             # refer to /numpy/numpy/issues/9363\n672 |             WH_safe_X_data **= -1\n673 |             WH_safe_X_data **= 2\n674 |             # element-wise multiplication\n675 |             WH_safe_X_data *= X_data\n676 |         else:\n677 |             WH_safe_X_data **= beta_loss - 2\n678 |             # element-wise multiplication\n679 |             WH_safe_X_data *= X_data\n680 | \n681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n683 | \n684 |         # Denominator\n685 |         if beta_loss == 1:\n686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n687 |             W_sum[W_sum == 0] = 1.0\n688 |             denominator = W_sum[:, np.newaxis]\n689 | \n690 |         # beta_loss not in (1, 2)\n691 |         else:\n692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n693 |             if sp.issparse(X):\n694 |                 # memory efficient computation\n695 |                 # (compute column by column, avoiding the dense matrix WH)\n696 |                 WtWH = np.empty(H.shape)\n697 |                 for i in range(X.shape[1]):\n698 |                     WHi = np.dot(W, H[:, i])\n699 |                     if beta_loss - 1 < 0:\n700 |                         WHi[WHi == 0] = EPSILON\n701 |                     WHi **= beta_loss - 1\n702 |              