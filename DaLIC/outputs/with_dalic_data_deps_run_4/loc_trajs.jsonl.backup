7 |             if footer:\n 268 |                 footer += \", \"\n 269 | \n 270 |             series_name = printing.pprint_thing(name, escape_chars=(\"\\t\", \"\\r\", \"\\n\"))\n 271 |             footer += f\"Name: {series_name}\"\n 272 | \n 273 |         if self.length is True or (\n 274 |             self.length == \"truncate\" and self.is_truncated_vertically\n 275 |         ):\n 276 |             if footer:\n 277 |                 footer += \", \"\n 278 |             footer += f\"Length: {len(self.series)}\"\n 279 | \n 280 |         if self.dtype is not False and self.dtype is not None:\n 281 |             dtype_name = getattr(self.tr_series.dtype, \"name\", None)\n 282 |             if dtype_name:\n 283 |                 if footer:\n 284 |                     footer += \", \"\n 285 |                 footer += f\"dtype: {printing.pprint_thing(dtype_name)}\"\n 286 | \n 287 |         # level infos are added to the end and in a new line, like it is done\n 288 |         # for Categoricals\n 289 |         if isinstance(self.tr_series.dtype, CategoricalDtype):\n 290 |             level_info = self.tr_series._values._get_repr_footer()\n 291 |             if footer:\n 292 |                 footer += \"\\n\"\n 293 |             footer += level_info\n 294 | \n 295 |         return str(footer)\n 296 | \n 297 |     def _get_formatted_values(self) -> list[str]:\n 298 |         return format_array(\n 299 |             self.tr_series._values,\n 300 |             None,\n 301 |             float_format=self.float_format,\n 302 |             na_rep=self.na_rep,\n 303 |             leading_space=self.index,\n 304 |         )\n 305 | \n 306 |     def to_string(self) -> str:\n 307 |         series = self.tr_series\n 308 |         footer = self._get_footer()\n 309 | \n 310 |         if len(series) == 0:\n 311 |             return f\"{type(self.series).__name__}([], {footer})\"\n 312 | \n 313 |         index = series.index\n 314 |         have_header = _has_names(index)\n 315 |  