n 359 | \n 360 |     Example\n 361 |     -------\n 362 |     >>> import pandas as pd\n 363 |     >>>\n 364 |     >>> df = pd.DataFrame([[1, 2], [3, 4]])\n 365 |     >>> repr_params = pd.io.formats.format.get_dataframe_repr_params()\n 366 |     >>> repr(df) == df.to_string(**repr_params)\n 367 |     True\n 368 |     \"\"\"\n 369 |     from pandas.io.formats import console\n 370 | \n 371 |     if get_option(\"display.expand_frame_repr\"):\n 372 |         line_width, _ = console.get_console_size()\n 373 |     else:\n 374 |         line_width = None\n 375 |     return {\n 376 |         \"max_rows\": get_option(\"display.max_rows\"),\n 377 |         \"min_rows\": get_option(\"display.min_rows\"),\n 378 |         \"max_cols\": get_option(\"display.max_columns\"),\n 379 |         \"max_colwidth\": get_option(\"display.max_colwidth\"),\n 380 |         \"show_dimensions\": get_option(\"display.show_dimensions\"),\n 381 |         \"line_width\": line_width,\n 382 |     }\n 383 | \n 384 | \n 385 | def get_series_repr_params() -> dict[str, Any]:\n 386 |     \"\"\"Get the parameters used to repr(Series) calls using Series.to_string.\n 387 | \n 388 |     Supplying these parameters to Series.to_string is equivalent to calling\n 389 |     ``repr(series)``. This is useful if you want to adjust the series repr output.\n 390 | \n 391 |     .. versionadded:: 1.4.0\n 392 | \n 393 |     Example\n 394 |     -------\n 395 |     >>> import pandas as pd\n 396 |     >>>\n 397 |     >>> ser = pd.Series([1, 2, 3, 4])\n 398 |     >>> repr_params = pd.io.formats.format.get_series_repr_params()\n 399 |     >>> repr(ser) == ser.to_string(**repr_params)\n 400 |     True\n 401 |     \"\"\"\n 402 |     width, height = get_terminal_size()\n 403 |     max_rows_opt = get_option(\"display.max_rows\")\n 404 |     max_rows = height if max_rows_opt == 0 else max_rows_opt\n 405 |     min_rows = height if max_rows_opt == 0 else get_option(\"display.min_rows\")\n 406 | \n 407 |     return {\n 408 |         \"name\": True,\n 409 |         \"dtype\": True,\n 410 |         \"min_rows\": min_rows,\n 411 |         \"max_rows\": max_rows,\n 412 |         \"length\": get_option(\"display.show_dimensions\"),\n 413 |     }\n 414 | \n 415 | \n 416 | class DataFrameFormatter:\n 417 |     \"\"\"\n 418 |     Class for processing dataframe formatting options and data.\n 419 | \n 420 |     Used by DataFrame.to_string, which backs DataFrame.__repr__.\n 421 |     \"\"\"\n 422 | \n 423 |     __doc__ = __doc__ if __doc__ else \"\"\n 424 |     __doc__ += common_docstring + return_docstring\n 425 | \n 426 |     def __init__(\n 427 |         self,\n 428 |         frame: DataFrame,\n 429 |         columns: Axes | None = None,\n 430 |         col_space: ColspaceArgType | None = None,\n 431 |         header: bool | SequenceNotStr[str] = True,\n 432 |         index: bool = True,\n 433 |         na_rep: str = \"NaN\",\n 434 |         formatters: FormattersType | None = None,\n 435 |         justify: str | None = None,\n 436 |         float_format: FloatFormatType | None = None,\n 437 |         sparsify: bool | None = None,\n 438 |         index_names: bool = True,\n 439 |         max_rows: int | None = None,\n 440 |         min_rows: int | None = None,\n 441 |         max_cols: int | None = None,\n 442 |         show_dimensions: bool | str = False,\n 443 |         decimal: str = \".\",\n 444 |         bold_rows: bool = False,\n 445 |         escape: bool = True,\n 446 |     ) -> None:\n 447 |         self.frame = frame\n 448 |         self.columns = self._initialize_columns(columns)\n 449 |         self.col_space = self._initialize_colspace(col_space)\n 450 |         self.header = header\n 451 |         self.index = index\n 452 |         self.na_rep = na_rep\n 453 |         self.formatters = self._initialize_formatters(formatters)\n 454 |         self.justify = self._initialize_justify(justify)\n 455 |         self.float_format = float_format\n 456 |         self.sparsify = self._initialize_sparsify(sparsify)\n 457 |         self.show_index_names = index_names\n 458 |         self.decimal = decimal\n 459 |         self.bold_rows = bold_rows\n 460 |         self.escape = escape\n 461 |         self.max_rows = max_rows\n 462 |         self.min_rows = min_rows\n 463 |         self.max_cols = max_cols\n 464 |         self.show_dimensions = show_dimensions\n 465 | \n 466 |         self.max_cols_fitted = self._calc_max_cols_fitted()\n 467 |         self.max_rows_fitted = self._calc_max_rows_fitted()\n 468 | \n 469 |         self.tr_frame = self.frame\n 470 |         self.truncate()\n 471 |         self.adj = printing.get_adjustment()\n 472 | \n 473 |     def get_strcols(self) -> list[list[str]]:\n 474 |         \"\"\"\n 475 |         Render a DataFrame to a list of columns (as lists of strings).\n 476 |         \"\"\"\n 477 |         strcols = self._get_strcols_without_index()\n 478 | \n 479 |         if self.index:\n 480 |             str_index = self._get_formatted_index(self.tr_frame)\n 481 |             strcols.insert(0, str_index)\n 482 | \n 483 |         return strcols\n 484 | \n 485 |     @property\n 486 |     def should_show_dimensions(self) -> bool:\n 487 |         return self.show_dimensions is True or (\n 488 |             self.show_dimensions == \"truncate\" and self.is_truncated\n 489 |         )\n 490 | \n 491 |     @property\n 492 |     def is_truncated(self) -> bool:\n 493 |         return bool(self.is_truncated_horizontally or self.is_truncated_vertically)\n 494 | \n 495 |     @property\n 496 |     def is_truncated_horizontally(self) -> bool:\n 497 |         return bool(self.max_cols_fitted and (len(self.columns) > self.max_cols_fitted))\n 498 | \n 499 |     @property\n 500 |     def is_truncated_vertically(self) -> bool:\n 501 |         return bool(self.max_rows_fitted and (len(self.frame) > self.max_rows_fitted))\n 502 | \n 503 |     @property\n 504 |     def dimensions_info(self) -> str:\n 505 |         return f\"\\n\\n[{len(self.frame)} rows x 