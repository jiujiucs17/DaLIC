eturning RGBA colors from a `~matplotlib.colors.Colormap`.\n637 | \n638 |     \"\"\"\n639 |     def __init__(self, colorizer, **kwargs):\n640 |         \"\"\"\n641 |         Parameters\n642 |         ----------\n643 |         colorizer : `.colorizer.Colorizer`\n644 |         \"\"\"\n645 |         _api.check_isinstance(Colorizer, colorizer=colorizer)\n646 |         super().__init__(colorizer=colorizer, **kwargs)\n647 | \n648 |     @property\n649 |     def colorizer(self):\n650 |         return self._colorizer\n651 | \n652 |     @colorizer.setter\n653 |     def colorizer(self, cl):\n654 |         _api.check_isinstance(Colorizer, colorizer=cl)\n655 |         self._colorizer.callbacks.disconnect(self._id_colorizer)\n656 |         self._colorizer = cl\n657 |         self._id_colorizer = cl.callbacks.connect('changed', self.changed)\n658 | \n659 |     def _set_colorizer_check_keywords(self, colorizer, **kwargs):\n660 |         \"\"\"\n661 |         Raises a ValueError if any kwarg is not None while colorizer is not None.\n662 |         \"\"\"\n663 |         self._check_exclusionary_keywords(colorizer, **kwargs)\n664 |         self.colorizer = colorizer\n```\n\nFound function `galleries/users_explain/colors/colors.py:demo`.\nSource: Retrieved entity using keyword search (bm25).\n```\n155 | def demo(sty):\n156 |     mpl.style.use(sty)\n157 |     fig, ax = plt.subplots(figsize=(3, 3))\n158 | \n159 |     ax.set_title(f'style: {sty!r}', color='C0')\n160 | \n161 |     ax.plot(th, np.cos(th), 'C1', label='C1')\n162 |     ax.plot(th, np.sin(th), 'C2', label='C2')\n163 |     ax.legend()\n```\n\nFound function `lib/matplotlib/colors.py:LinearSegmentedColormap.from_list`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1081 | def from_list(name, colors, N=256, gamma=1.0):\n1082 |         \"\"\"\n1083 |         Create a `LinearSegmentedColormap` from a list of colors.\n1084 | \n1085 |         Parameters\n1086 |         ----------\n1087 |         name : str\n1088 |             The name of the colormap.\n1089 |         colors : list of :mpltype:`color` or list of (value, color)\n1090 |             If only colors are given, they are equidistantly mapped from the\n1091 |             range :math:`[0, 1]`; i.e. 0 maps to ``colors[0]`` and 1 maps to\n1092 |             ``colors[-1]``.\n1093 |             If (value, color) pairs are given, the mapping is from *value*\n1094 |             to *color*. This can be used to divide the range unevenly.\n1095 |         N : int\n1096 |             The number of RGB quantization levels.\n1097 |         gamma : float\n1098 |         \"\"\"\n1099 |         if not np.iterable(colors):\n1100 |             raise ValueError('colors must be iterable')\n1101 | \n1102 |         if (isinstance(colors[0], Sized) and len(colors[0]) == 2\n1103 |                 and not isinstance(colors[0], str)):\n1104 |             # List of value, color pairs\n1105 |             vals, colors = zip(*colors)\n1106 |         else:\n1107 |             vals = np.linspace(0, 1, len(colors))\n1108 | \n1109 |         r, g, b, a = to_rgba_array(colors).T\n1110 |         cdict = {\n1111 |             \"red\": np.column_stack([vals, r, r]),\n1112 |             \"green\": np.column_stack([vals, g, g]),\n1113 |             \"blue\": np.column_stack([vals, b, b]),\n1114 |             \"alpha\": np.column_stack([vals, a, a]),\n1115 |         }\n1116 | \n1117 |         return LinearSegmentedColormap(name, cdict, N, gamma)\n```\n\nFound file `galleries/users_explain/colors/colors.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/users_explain/colors/colors.py` for the full content if needed.\n\n\n\n##Searching for term \"facecolor\"...\n### Search Result:\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.voxels`.\nSource: Retrieved code content using keyword search (bm25).\n```\n3353 | def voxels(self, *args, facecolors=None, edgecolors=None, shade=True,\n3354 |                lightsource=None,