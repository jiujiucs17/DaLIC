rors is returned.\n 185 | \n 186 |         MAE output is non-negative floating point. The best value is 0.0.\n 187 | \n 188 |     Examples\n 189 |     --------\n 190 |     >>> from sklearn.metrics import mean_absolute_error\n 191 |     >>> y_true = [3, -0.5, 2, 7]\n 192 |     >>> y_pred = [2.5, 0.0, 2, 8]\n 193 |     >>> mean_absolute_error(y_true, y_pred)\n 194 |     0.5\n 195 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n 196 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n 197 |     >>> mean_absolute_error(y_true, y_pred)\n 198 |     0.75\n 199 |     >>> mean_absolute_error(y_true, y_pred, multioutput='raw_values')\n 200 |     array([0.5, 1. ])\n 201 |     >>> mean_absolute_error(y_true, y_pred, multioutput=[0.3, 0.7])\n 202 |     0.85...\n 203 |     \"\"\"\n 204 |     input_arrays = [y_true, y_pred, sample_weight, multioutput]\n 205 |     xp, _ = get_namespace(*input_arrays)\n 206 | \n 207 |     dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n 208 | \n 209 |     _, y_true, y_pred, multioutput = _check_reg_targets(\n 210 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n 211 |     )\n 212 |     check_consistent_length(y_true, y_pred, sample_weight)\n 213 | \n 214 |     output_errors = _average(\n 215 |         xp.abs(y_pred - y_true), weights=sample_weight, axis=0, xp=xp\n 216 |     )\n 217 |     if isinstance(multioutput, str):\n 218 |         if multioutput == \"raw_values\":\n 219 |             return output_errors\n 220 |         elif multioutput == \"uniform_average\":\n 221 |             # pass None as weights to np.average: uniform mean\n 222 |             multioutput = None\n 223 | \n 224 |     # Average across the outputs (if needed).\n 225 |     # The second call to `_average` should always return\n 226 |     # a scalar array that we convert to a Python float to\n 227 |     # consistently return the same eager evaluated value.\n 228 |     # Therefore, `axis=None`.\n 229 |     mean_absolute_error = _average(output_errors, weights=multioutput)\n 230 | \n 231 |     return float(mean_absolute_error)\n 232 | \n 233 | \n 234 | @validate_params(\n 235 |     {\n 236 |         \"y_true\": [\"array-like\"],\n 237 |         \"y_pred\": [\"array-like\"],\n 238 |         \"sample_weight\": [\"array-like\", None],\n 239 |         \"alpha\": [Interval(Real, 0, 1, closed=\"both\")],\n 240 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 241 |     },\n 242 |     prefer_skip_nested_validation=True,\n 243 | )\n 244 | def mean_pinball_loss(\n 245 |     y_true, y_pred, *, sample_weight=None, alpha=0.5, multioutput=\"uniform_average\"\n 246 | ):\n 247 |     \"\"\"Pinball loss for quantile regression.\n 248 | \n 249 |     Read more in the :ref:`User Guide <pinball_loss>`.\n 250 | \n 251 |     Parameters\n 252 |     ----------\n 253 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 254 |         Ground truth (correct) target values.\n 255 | \n 256 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 257 |         Estimated target values.\n 258 | \n 259 |     sample_weight : array-like of shape (n_samples,), default=None\n 260 |         Sample weights.\n 261 | \n 262 |     alpha : float, slope of the pinball loss, default=0.5,\n 263 |         This loss is equivalent to :ref:`mean_absolute_error` when `alpha=0.5`,\n 264 |         `alpha=0.95` is minimized by estimators of the 95th percentile.\n 265 | \n 266 |     multioutput : {'raw_values', 'uniform_average'}  or array-like of shape \\\n 267 |             (n_outputs,), default='uniform_average'\n 268 |         Defines aggregating of multiple output values.\n 269 |         Array-like value defines weights used to average errors.\n 270 | \n 271 |         'raw_values' :\n 272 |             Returns a full set of errors in case of multioutput input.\n 273 | \n 274 |         'uniform_average' :\n 275 |             Errors of all outputs are averaged with uniform weight.\n 276 | \n 277 |     Returns\n 278 |     -------\n 279 |     loss : float or ndarray of floats\n 280 |         If multioutput is 'raw_values', then mean absolute error is returned\n 281 |         for each output separately.\n 282 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n 283 |         weighted average of all output errors is returned.\n 284 | \n 285 |         The pinball loss output is a non-negative floating point. The best\n 286 |         value is 0.0.\n 287 | \n 288 |     Examples\n 289 |     --------\n 290 |     >>> from sklearn.metrics import mean_pinball_loss\n 291 |     >>> y_true = [1, 2, 3]\n 292 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.1)\n 293 |     np.float64(0.03...)\n 294 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.1)\n 295 |     np.float64(0.3...)\n 296 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.9)\n 297 |     np.float64(0.3...)\n 298 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.9)\n 299 |     np.float64(0.03...)\n 300 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.1)\n 301 |     np.float64(0.0)\n 302 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.9)\n 303 |     np.float64(0.0)\n 304 |     \"\"\"\n 305 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n 306 |         y_true, y_pred, multioutput\n 307 |     )\n 308 |     check_consistent_length(y_true, y_pred, sample_weight)\n 309 |     diff = y_true - y_pred\n 310 |     sign = (diff >= 0).astype(diff.dtype)\n 311 |     loss = alpha * sign * diff - (1 - alpha) * (1 - sign) * diff\n 312 |     output_errors = np.average(loss, weights=sample_weight, axis=0)\n 313 | \n 314 |     if isinstance(multioutput, str) and multioutput == \"raw_values\":\n 315 |         return output_errors\n 316 | \n 317 |     if isinstance(multioutput, str) and multioutput == \"uniform_average\":\n 318 |         # pass None as weights to np.average: uniform mean\n 319 |         multioutput = None\n 320 | \n 321 |     return np.average(output_errors, weights=multioutput)\n 322 | \n 323 | \n 324 | @validate_params(\n 325 |     {\n 326 |         \"y_true\": [\"array-like\"],\n 327 |         \"y_pred\": [\"array-like\"],\n 328 |         \"sample_weight\": [\"array-like\", None],\n 329 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 330 |     },\n 331 |     prefer_skip_nested_validation=True,\n 332 | )\n 333 | def mean_absolute_percentage_error(\n 334 |     y_true, y_pred, *, sample_weight=None, multioutput=\"uniform_average\"\n 335 | ):\n 336 |     \"\"\"Mean absolute percentage error (MAPE) regression loss.\n 337 | \n 338 |     Note that we are not using the common \"percentage\" definition: the percentage\n 339 |     in the range [0, 100] is converted to a relative value in the range [0, 1]\n 340 |     by dividing by 100. Thus, an error of 200% corresponds to a relative error of 2.\n 341 | \n 342 |     Read more in the :ref:`User Guide <mean_absolute_percentage_error>`.\n 343 | \n 344 |     .. versionadded:: 0.24\n 345 | \n 346 |     Parameters\n 347 |     ----------\n 348 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 349 |         Ground truth (correct) target values.\n 350 | \n 351 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 352 |         Estimated target values.\n 353 | \n 354 |     sample_weight : array-like of shape (n_samples,), default=None\n 355 |         Sample weights.\n 356 | \n 357 |     multioutput : {'raw_values', 'uniform_average'} or array-like\n 358 |         Defines aggregating of multiple output values.\n 359 |         Array-like value defines weights used to average errors.\n 360 |         If input is list then the shape must be (n_outputs,).\n 361 | \n 362 |         'raw_values' :\n 363 |             Returns a full set of errors in case of multioutput input.\n 364 | \n 365 |         'uniform_average' :\n 366 |             Errors of all outputs are averaged with uniform weight.\n 367 | \n 368 |     Returns\n 369 |     -------\n 370 |     loss : float or ndarray of floats\n 371 |         If multioutput is 'raw_values', then mean absolute percentage error\n 372 |         is returned for each output separately.\n 373 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n 374 |         weighted average of all output errors is returned.\n 375 | \n 376 |         MAPE output is non-negative floating point. The best value is 0.0.\n 377 |         But note that bad predictions can lead to arbitrarily large\n 378 |         MAPE values, especially if some `y_true` values are very close to zero.\n 379 |         Note that we return a large value instead of `inf` when `y_true` is zero.\n 380 | \n 381 |     Examples\n 382 |     --------\n 383 |     >>> from sklearn.metrics import mean_absolute_percentage_error\n 384 |     >>> y_true = [3, -0.5, 2, 7]\n 385 |     >>> y_pred = [2.5, 0.0, 2, 8]\n 386 |     >>> mean_absolute_percentage_error(y_true, y_pred)\n 387 |     0.3273...\n 388 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n 389 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n 390 |     >>> mean_absolute_percentage_error(y_true, y_pred)\n 391 |     0.5515...\n 392 |     >>> mean_absolute_percentage_error(y_true, y_pred, multioutput=[0.3, 0.7])\n 393 |     0.6198...\n 394 |     >>> # the value when some element of the y_true is zero is arbitrarily high because\n 395 |     >>> # of the division by epsilon\n 396 |     >>> y_true = [1., 0., 2.4, 7.]\n 397 |     >>> y_pred = [1.2, 0.1, 2.4, 8.]\n 398 |     >>> mean_absolute_percentage_error(y_true, y_pred)\n 399 |     112589990684262.48\n 400 |     \"\"\"\n 401 |     input_arrays = [y_true, y_pred, sample_weight, multioutput]\n 402 |     xp, _ = get_namespace(*input_arrays)\n 403 |     dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n 404 | \n 405 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n 406 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n 407 |     )\n 408 |     check_consistent_length(y_true, y_pred, sample_weight)\n 409 |     epsilon = xp.asarray(xp.finfo(xp.float64).eps, dtype=dtype)\n 410 |     y_true_abs = xp.asarray(xp.abs(y_true), dtype=dtype)\n 411 |     mape = xp.asarray(xp.abs(y_pred - y_true), dtype=dtype) / xp.maximum(\n 412 |         y_true_abs, epsilon\n 413 |     )\n 414 |     output_errors = _average(mape, weights=sample_weight, axis=0)\n 415 |     if isinstance(multioutput, str):\n 416 |         if multioutput == \"raw_values\":\n 417 |             return output_errors\n 418 |         elif multioutput == \"uniform_average\":\n 419 |             # pass None as weights to _average: uniform mean\n 420 |             multioutput = None\n 421 | \n 422 |     # Average across the outputs (if needed).\n 423 |     # The second call to `_average` should always return\n 424 |     # a scalar array that we convert to a Python float to\n 425 |     # consistently return the same eager evaluated value.\n 426 |     # Therefore, `axis=None`.\n 427 |     mean_absolute_percentage_error = _average(output_errors, weights=multioutput)\n 428 | \n 429 |     return float(mean_absolute_percentage_error)\n 430 | \n 431 | \n 432 | @validate_params(\n 433 |     {\n 434 |         \"y_true\": [\"array-like\"],\n 435 |         \"y_pred\": [\"array-like\"],\n 436 |         \"sample_weight\": [\"array-like\", None],\n 437 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 438 |     },\n 439 |     prefer_skip_nested_validation=True,\n 440 | )\n 441 | def mean_squared_error(\n 442 |     y_true,\n 443 |     y_pred,\n 444 |     *,\n 445 |     sample_weight=None,\n 446 |     multioutput=\"uniform_average\",\n 447 | ):\n 448 |     \"\"\"Mean squared error regression loss.\n 449 | \n 450 |     Read more in the :ref:`User Guide <mean_squared_error>`.\n 451 | \n 452 |     Parameters\n 453 |     ----------\n 454 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 455 |         Ground truth (correct) target values.\n 456 | \n 457 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 458 |         Estimated target values.\n 459 | \n 460 |     sample_weight : array-like of shape (n_samples,), default=None\n 461 |         Sample weights.\n 462 | \n 463 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n 464 |             (n_outputs,), default='uniform_average'\n 465 |         Defines aggregating of multiple output values.\n 466 |         Array-like value defines weights used to average errors.\n 467 | \n 468 |         'raw_values' :\n 469 |             Returns a full set of errors in case of multioutput input.\n 470 | \n 471 |         'uniform_average' :\n 472 |             Errors of all outputs are averaged with uniform weight.\n 473 | \n 474 |     Returns\n 475 |     -------\n 476 |     loss : float or array of floats\n 477 |         A non-negative floating point value (the best value is 0.0), or an\n 478 |         array of floating point values, one for each individual target.\n 479 | \n 480 |     Examples\n 481 |     --------\n 482 |     >>> from sklearn.metrics import mean_squared_error\n 483 |     >>> y_true = [3, -0.5, 2, 7]\n 484 |     >>> y_pred = [2.5, 0.0, 2, 8]\n 485 |     >>> mean_squared_error(y_true, y_pred)\n 486 |     0.375\n 487 |     >>> y_true = [[0.5, 1],[-1, 1],[7, -6]]\n 488 |     >>> y_pred = [[0, 2],[-1, 2],[8, -5]]\n 489 |     >>> mean_squared_error(y_true, y_pred)\n 490 |     0.708...\n 491 |     >>> mean_squared_error(y_true, y_pred, multioutput='raw_values')\n 492 |     array([0.41666667, 1.        ])\n 493 |     >>> mean_squared_error(y_true, y_pred, multioutput=[0.3, 0.7])\n 494 |     0.825...\n 495 |     \"\"\"\n 496 |     xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\n 497 |     dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n 498 | \n 499 |     _, y_true, y_pred, multioutput = _check_reg_targets(\n 500 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n 501 |     )\n 502 |     check_consistent_length(y_true, y_pred, sample_weight)\n 503 |     output_errors = _average((y_true - y_pred) ** 2, axis=0, weights=sample_weight)\n 504 | \n 505 |     if isinstance(multioutput, str):\n 506 |         if multioutput == \"raw_values\":\n 507 |             return output_errors\n 508 |         elif multioutput == \"uniform_average\":\n 509 |             # pass None as weights to _average: uniform mean\n 510 |             multioutput = None\n 511 | \n 512 |     # Average across the outputs (if needed).\n 513 |     # The second call to `_average` should always return\n 514 |     # a scalar array that we convert to a Python float to\n 515 |     # consistently return the same eager evaluated value.\n 516 |     # Therefore, `axis=None`.\n 517 |     mean_squared_error = _average(output_errors, weights=multioutput)\n 518 | \n 519 |     return float(mean_squared_error)\n 520 | \n 521 | \n 522 | @validate_params(\n 523 |     {\n 524 |         \"y_true\": [\"array-like\"],\n 525 |         \"y_pred\": [\"array-like\"],\n 526 |         \"sample_weight\": [\"array-like\", None],\n 527 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 528 |     },\n 529 |     prefer_skip_nested_validation=True,\n 530 | )\n 531 | def root_mean_squared_error(\n 532 |     y_true, y_pred, *, sample_weight=None, multioutput=\"uniform_average\"\n 533 | ):\n 534 |     \"\"\"Root mean squared error regression loss.\n 535 | \n 536 |     Read more in the :ref:`User Guide <mean_squared_error>`.\n 537 | \n 538 |     .. versionadded:: 1.4\n 539 | \n 540 |     Parameters\n 541 |     ----------\n 542 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 543 |         Ground truth (correct) target values.\n 544 | \n 545 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 546 |         Estimated target values.\n 547 | \n 548 |     sample_weight : array-like of shape (n_samples,), default=None\n 549 |         Sample weights.\n 550 | \n 551 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n 552 |             (n_outputs,), default='uniform_average'\n 553 |         Defines aggregating of multiple output values.\n 554 |         Array-like value defines weights used to average errors.\n 555 | \n 556 |         'raw_values' :\n 557 |             Returns a full set of errors in case of multioutput input.\n 558 | \n 559 |         'uniform_average' :\n 560 |             Errors of all outputs are averaged with uniform weight.\n 561 | \n 562 |     Returns\n 563 |     -------\n 564 |     loss : float or ndarray of floats\n 565 |         A non-negative floating point value (the best value is 0.0), or an\n 566 |         array of floating point values, one for each individual target.\n 567 | \n 568 |     Examples\n 569 |     --------\n 570 |     >>> from sklearn.metrics import root_mean_squared_error\n 571 |     >>> y_true = [3, -0.5, 2, 7]\n 572 |     >>> y_pred = [2.5, 0.0, 2, 8]\n 573 |     >>> root_mean_squared_error(y_true, y_pred)\n 574 |     0.612...\n 575 |     >>> y_true = [[0.5, 1],[-1, 1],[7, -6]]\n 576 |     >>> y_pred = [[0, 2],[-1, 2],[8, -5]]\n 577 |     >>> root_mean_squared_error(y_true, y_pred)\n 578 |     0.822...\n 579 |     \"\"\"\n 580 | \n 581 |     xp, _ = get_namespace(y_true, y_pred, sample_weight, multioutput)\n 582 | \n 583 |     output_errors = xp.sqrt(\n 584 |         mean_squared_error(\n 585 |             y_true, y_pred, sample_weight=sample_weight, multioutput=\"raw_values\"\n 586 |         )\n 587 |     )\n 588 | \n 589 |     if isinstance(multioutput, str):\n 590 |         if multioutput == \"raw_values\":\n 591 |             return output_errors\n 592 |         elif multioutput == \"uniform_average\":\n 593 |             # pass None as weights to _average: uniform mean\n 594 |             multioutput = None\n 595 | \n 596 |     # Average across the outputs (if needed).\n 597 |     # The second call to `_average` should always return\n 598 |     # a scalar array that we convert to a Python float to\n 599 |     # consistently return the same eager evaluated value.\n 600 |     # Therefore, `axis=None`.\n 601 |     root_mean_squared_error = _average(output_errors, weights=multioutput)\n 602 | \n 603 |     return float(root_mean_squared_error)\n 604 | \n 605 | \n 606 | @validate_params(\n 607 |     {\n 608 |         \"y_true\": [\"array-like\"],\n 609 |         \"y_pred\": [\"array-like\"],\n 610 |         \"sample_weight\": [\"array-like\", None],\n 611 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 612 |     },\n 613 |     prefer_skip_nested_validation=True,\n 614 | )\n 615 | def mean_squared_log_error(\n 616 |     y_true,\n 617 |     y_pred,\n 618 |     *,\n 619 |     sample_weight=None,\n 620 |     multioutput=\"uniform_average\",\n 621 | ):\n 622 |     \"\"\"Mean squared logarithmic error regression loss.\n 623 | \n 624 |     Read more in the :ref:`User Guide <mean_squared_log_error>`.\n 625 | \n 626 |     Parameters\n 627 |     ----------\n 628 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 629 |         Ground truth (correct) target values.\n 630 | \n 631 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 632 |         Estimated target values.\n 633 | \n 634 |     sample_weight : array-like of shape (n_samples,), default=None\n 635 |         Sample weights.\n 636 | \n 637 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n 638 |             (n_outputs,), default='uniform_average'\n 639 | \n 640 |         Defines aggregating of multiple output values.\n 641 |         Array-like value defines weights used to average errors.\n 642 | \n 643 |         'raw_values' :\n 644 |             Returns a full set of errors when the input is of multioutput\n 645 |             format.\n 646 | \n 647 |         'uniform_average' :\n 648 |             Errors of all outputs are averaged with uniform weight.\n 649 | \n 650 |     Returns\n 651 |     -------\n 652 |     loss : float or ndarray of floats\n 653 |         A non-negative floating point value (the best value is 0.0), or an\n 654 |         array of floating point values, one for each individual target.\n 655 | \n 656 |     Examples\n 657 |     --------\n 658 |     >>> from sklearn.metrics import mean_squared_log_error\n 659 |     >>> y_true = [3, 5, 2.5, 7]\n 660 |     >>> y_pred = [2.5, 5, 4, 8]\n 661 |     >>> mean_squared_log_error(y_true, y_pred)\n 662 |     0.039...\n 663 |     >>> y_true = [[0.5, 1], [1, 2], [7, 6]]\n 664 |     >>> y_pred = [[0.5, 2], [1, 2.5], [8, 8]]\n 665 |     >>> mean_squared_log_error(y_true, y_pred)\n 666 |     0.044...\n 667 |     >>> mean_squared_log_error(y_true, y_pred, multioutput='raw_values')\n 668 |     array([0.00462428, 0.08377444])\n 669 |     >>> mean_squared_log_error(y_true, y_pred, multioutput=[0.3, 0.7])\n 670 |     0.060...\n 671 |     \"\"\"\n 672 |     xp, _ = get_namespace(y_true, y_pred)\n 673 |     dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n 674 | \n 675 |     _, y_true, y_pred, _ = _check_reg_targets(\n 676 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n 677 |     )\n 678 | \n 679 |     if xp.any(y_true <= -1) or xp.any(y_pred <= -1):\n 680 |         raise ValueError(\n 681 |             \"Mean Squared Logarithmic Error cannot be used when \"\n 682 |             \"targets contain values less than or equal to -1.\"\n 683 |         )\n 684 | \n 685 |     return mean_squared_error(\n 686 |         xp.log1p(y_true),\n 687 |         xp.log1p(y_pred),\n 688 |         sample_weight=sample_weight,\n 689 |         multioutput=multioutput,\n 690 |     )\n 691 | \n 692 | \n 693 | @validate_params(\n 694 |     {\n 695 |         \"y_true\": [\"array-like\"],\n 696 |         \"y_pred\": [\"array-like\"],\n 697 |         \"sample_weight\": [\"array-like\", None],\n 698 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 699 |     },\n 700 |     prefer_skip_nested_validation=True,\n 701 | )\n 702 | def root_mean_squared_log_error(\n 703 |     y_true, y_pred, *, sample_weight=None, multioutput=\"uniform_average\"\n 704 | ):\n 705 |     \"\"\"Root mean squared logarithmic error regression loss.\n 706 | \n 707 |     Read more in the :ref:`User Guide <mean_squared_log_error>`.\n 708 | \n 709 |     .. versionadded:: 1.4\n 710 | \n 711 |     Parameters\n 712 |     ----------\n 713 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 714 |         Ground truth (correct) target values.\n 715 | \n 716 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 717 |         Estimated target values.\n 718 | \n 719 |     sample_weight : array-like of shape (n_samples,), default=None\n 720 |         Sample weights.\n 721 | \n 722 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n 723 |             (n_outputs,), default='uniform_average'\n 724 | \n 725 |         Defines aggregating of multiple output values.\n 726 |         Array-like value defines weights used to average errors.\n 727 | \n 728 |         'raw_values' :\n 729 |             Returns a full set of errors when the input is of multioutput\n 730 |             format.\n 731 | \n 732 |         'uniform_average' :\n 733 |             Errors of all outputs are averaged with uniform weight.\n 734 | \n 735 |     Returns\n 736 |     -------\n 737 |     loss : float or ndarray of floats\n 738 |         A non-negative floating point value (the best value is 0.0), or an\n 739 |         array of floating point values, one for each individual target.\n 740 | \n 741 |     Examples\n 742 |     --------\n 743 |     >>> from sklearn.metrics import root_mean_squared_log_error\n 744 |     >>> y_true = [3, 5, 2.5, 7]\n 745 |     >>> y_pred = [2.5, 5, 4, 8]\n 746 |     >>> root_mean_squared_log_error(y_true, y_pred)\n 747 |     0.199...\n 748 |     \"\"\"\n 749 |     xp, _ = get_namespace(y_true, y_pred)\n 750 |     dtype = _find_matching_floating_dtype(y_true, y_pred, xp=xp)\n 751 | \n 752 |     _, y_true, y_pred, multioutput = _check_reg_targets(\n 753 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n 754 |     )\n 755 | \n 756 |     if xp.any(y_true <= -1) or xp.any(y_pred <= -1):\n 757 |         raise ValueError(\n 758 |             \"Root Mean Squared Logarithmic Error cannot be used when \"\n 759 |             \"targets contain values less than or equal to -1.\"\n 760 |         )\n 761 | \n 762 |     return root_mean_squared_error(\n 763 |         xp.log1p(y_true),\n 764 |         xp.log1p(y_pred),\n 765 |         sample_weight=sample_weight,\n 766 |         multioutput=multioutput,\n 767 |     )\n 768 | \n 769 | \n 770 | @validate_params(\n 771 |     {\n 772 |         \"y_true\": [\"array-like\"],\n 773 |         \"y_pred\": [\"array-like\"],\n 774 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 775 |         \"sample_weight\": [\"array-like\", None],\n 776 |     },\n 777 |     prefer_skip_nested_validation=True,\n 778 | )\n 779 | def median_absolute_error(\n 780 |     y_true, y_pred, *, multioutput=\"uniform_average\", sample_weight=None\n 781 | ):\n 782 |     \"\"\"Median absolute error regression loss.\n 783 | \n 784 |     Median absolute error output is non-negative floating point. The best value\n 785 |     is 0.0. Read more in the :ref:`User Guide <median_absolute_error>`.\n 786 | \n 787 |     Parameters\n 788 |     ----------\n 789 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 790 |         Ground truth (correct) target values.\n 791 | \n 792 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 793 |         Estimated target values.\n 794 | \n 795 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n 796 |             (n_outputs,), default='uniform_average'\n 797 |         Defines aggregating of multiple output values. Array-like value defines\n 798 |         weights used to average errors.\n 799 | \n 800 |         'raw_values' :\n 801 |             Returns a full set of errors in case of multioutput input.\n 802 | \n 803 |         'uniform_average' :\n 804 |             Errors of all outputs are averaged with uniform weight.\n 805 | \n 806 |     sample_weight : array-like of shape (n_samples,), default=None\n 807 |         Sample weights.\n 808 | \n 809 |         .. versionadded:: 0.24\n 810 | \n 811 |     Returns\n 812 |     -------\n 813 |     loss : float or ndarray of floats\n 814 |         If multioutput is 'raw_values', then mean absolute error is returned\n 815 |         for each output separately.\n 816 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n 817 |         weighted average of all output errors is returned.\n 818 | \n 819 |     Examples\n 820 |     --------\n 821 |     >>> from sklearn.metrics import median_absolute_error\n 822 |     >>> y_true = [3, -0.5, 2, 7]\n 823 |     >>> y_pred = [2.5, 0.0, 2, 8]\n 824 |     >>> median_absolute_error(y_true, y_pred)\n 825 |     np.float64(0.5)\n 826 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n 827 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n 828 |     >>> median_absolute_error(y_true, y_pred)\n 829 |     np.float64(0.75)\n 830 |     >>> median_absolute_error(y_true, y_pred, multioutput='raw_values')\n 831 |     array([0.5, 1. ])\n 832 |     >>> median_absolute_error(y_true, y_pred, multioutput=[0.3, 0.7])\n 833 |     np.float64(0.85)\n 834 |     \"\"\"\n 835 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n 836 |         y_true, y_pred, multioutput\n 837 |     )\n 838 |     if sample_weight is None:\n 839 |         output_errors = np.median(np.abs(y_pred - y_true), axis=0)\n 840 |     else:\n 841 |         sample_weight = _check_sample_weight(sample_weight, y_pred)\n 842 |         output_errors = _weighted_percentile(\n 843 |             np.abs(y_pred - y_true), sample_weight=sample_weight\n 844 |         )\n 845 |     if isinstance(multioutput, str):\n 846 |         if multioutput == \"raw_values\":\n 847 |             return output_errors\n 848 |         elif multioutput == \"uniform_average\":\n 849 |             # pass None as weights to np.average: uniform mean\n 850 |             multioutput = None\n 851 | \n 852 |     return np.average(output_errors, weights=multioutput)\n 853 | \n 854 | \n 855 | def _assemble_r2_explained_variance(\n 856 |     numerator, denominator, n_outputs, multioutput, force_finite, xp, device\n 857 | ):\n 858 |     \"\"\"Common part used by explained variance score and :math:`R^2` score.\"\"\"\n 859 |     dtype = numerator.dtype\n 860 | \n 861 |     nonzero_denominator = denominator != 0\n 862 | \n 863 |     if not force_finite:\n 864 |         # Standard formula, that may lead to NaN or -Inf\n 865 |         output_scores = 1 - (numerator / denominator)\n 866 |     else:\n 867 |         nonzero_numerator = numerator != 0\n 868 |         # Default = Zero Numerator = perfect predictions. Set to 1.0\n 869 |         # (note: even if denominator is zero, thus avoiding NaN scores)\n 870 |         output_scores = xp.ones([n_outputs], device=device, dtype=dtype)\n 871 |         # Non-zero Numerator and Non-zero Denominator: use the formula\n 872 |         valid_score = nonzero_denominator & nonzero_numerator\n 873 | \n 874 |         output_scores[valid_score] = 1 - (\n 875 |             numerator[valid_score] / denominator[valid_score]\n 876 |         )\n 877 | \n 878 |         # Non-zero Numerator and Zero Denominator:\n 879 |         # arbitrary set to 0.0 to avoid -inf scores\n 880 |         output_scores[nonzero_numerator & ~nonzero_denominator] = 0.0\n 881 | \n 882 |     if isinstance(multioutput, str):\n 883 |         if multioutput == \"raw_values\":\n 884 |             # return scores individually\n 885 |             return output_scores\n 886 |         elif multioutput == \"uniform_average\":\n 887 |             # Passing None as weights to np.average results is uniform mean\n 888 |             avg_weights = None\n 889 |         elif multioutput == \"variance_weighted\":\n 890 |             avg_weights = denominator\n 891 |             if not xp.any(nonzero_denominator):\n 892 |                 # All weights are zero, np.average would raise a ZeroDiv error.\n 893 |                 # This only happens when all y are constant (or 1-element long)\n 894 |                 # Since weights are all equal, fall back to uniform weights.\n 895 |                 avg_weights = None\n 896 |     else:\n 897 |         avg_weights = multioutput\n 898 | \n 899 |     result = _average(output_scores, weights=avg_weights)\n 900 |     if size(result) == 1:\n 901 |         return float(result)\n 902 |     return result\n 903 | \n 904 | \n 905 | @validate_params(\n 906 |     {\n 907 |         \"y_true\": [\"array-like\"],\n 908 |         \"y_pred\": [\"array-like\"],\n 909 |         \"sample_weight\": [\"array-like\", None],\n 910 |         \"multioutput\": [\n 911 |             StrOptions({\"raw_values\", \"uniform_average\", \"variance_weighted\"}),\n 912 |             \"array-like\",\n 913 |         ],\n 914 |         \"force_finite\": [\"boolean\"],\n 915 |     },\n 916 |     prefer_skip_nested_validation=True,\n 917 | )\n 918 | def explained_variance_score(\n 919 |     y_true,\n 920 |     y_pred,\n 921 |     *,\n 922 |     sample_weight=None,\n 923 |     multioutput=\"uniform_average\",\n 924 |     force_finite=True,\n 925 | ):\n 926 |     \"\"\"Explained variance regression score function.\n 927 | \n 928 |     Best possible score is 1.0, lower values are worse.\n 929 | \n 930 |     In the particular case when ``y_true`` is constant, the explained variance\n 931 |     score is not finite: it is either ``NaN`` (perfect predictions) or\n 932 |     ``-Inf`` (imperfect predictions). To prevent such non-finite numbers to\n 933 |     pollute higher-level experiments such as a grid search cross-validation,\n 934 |     by default these cases are replaced with 1.0 (perfect predictions) or 0.0\n 935 |     (imperfect predictions) respectively. If ``force_finite``\n 936 |     is set to ``False``, this score falls back on the original :math:`R^2`\n 937 |     definition.\n 938 | \n 939 |     .. note::\n 940 |        The Explained Variance score is similar to the\n 941 |        :func:`R^2 score <r2_score>`, with the notable difference that it\n 942 |        does not account for systematic offsets in the prediction. Most often\n 943 |        the :func:`R^2 score <r2_score>` should be preferred.\n 944 | \n 945 |     Read more in the :ref:`User Guide <explained_variance_score>`.\n 946 | \n 947 |     Parameters\n 948 |     ----------\n 949 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 950 |         Ground truth (correct) target values.\n 951 | \n 952 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 953 |         Estimated target values.\n 954 | \n 955 |     sample_weight : array-like of shape (n_samples,), default=None\n 956 |         Sample weights.\n 957 | \n 958 |     multioutput : {'raw_values', 'uniform_average', 'variance_weighted'} or \\\n 959 |             array-like of shape (n_outputs,), default='uniform_average'\n 960 |         Defines aggregating of multiple output scores.\n 961 |         Array-like value defines weights used to average scores.\n 962 | \n 963 |         'raw_values' :\n 964 |             Returns a full set of scores in case of multioutput input.\n 965 | \n 966 |         'uniform_average' :\n 967 |             Scores of all outputs are averaged with uniform weight.\n 968 | \n 969 |         'variance_weighted' :\n 970 |             Scores of all outputs are averaged, weighted by the variances\n 971 |             of each individual output.\n 972 | \n 973 |     force_finite : bool, default=True\n 974 |         Flag indicating if ``NaN`` and ``-Inf`` scores resulting from constant\n 975 |         data should be replaced with real numbers (``1.0`` if prediction is\n 976 |         perfect, ``0.0`` otherwise). Default is ``True``, a convenient setting\n 977 |         for hyperparameters' search procedures (e.g. grid search\n 978 |         cross-validation).\n 979 | \n 980 |         .. versionadded:: 1.1\n 981 | \n 982 |     Returns\n 983 |     -------\n 984 |     score : float or ndarray of floats\n 985 |         The explained variance or ndarray if 'multioutput' is 'raw_values'.\n 986 | \n 987 |     See Also\n 988 |     --------\n 989 |     r2_score :\n 990 |         Similar metric, but accounting for systematic offsets in\n 991 |         prediction.\n 992 | \n 993 |     Notes\n 994 |     -----\n 995 |     This is not a symmetric function.\n 996 | \n 997 |     Examples\n 998 |     --------\n 999 |     >>> from sklearn.metrics import explained_variance_score\n1000 |     >>> y_true = [3, -0.5, 2, 7]\n1001 |     >>> y_pred = [2.5, 0.0, 2, 8]\n1002 |     >>> explained_variance_score(y_true, y_pred)\n1003 |     0.957...\n1004 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n1005 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n1006 |     >>> explained_variance_score(y_true, y_pred, multioutput='uniform_average')\n1007 |     0.983...\n1008 |     >>> y_true = [-2, -2, -2]\n1009 |     >>> y_pred = [-2, -2, -2]\n1010 |     >>> explained_variance_score(y_true, y_pred)\n1011 |     1.0\n1012 |     >>> explained_variance_score(y_true, y_pred, force_finite=False)\n1013 |     nan\n1014 |     >>> y_true = [-2, -2, -2]\n1015 |     >>> y_pred = [-2, -2, -2 + 1e-8]\n1016 |     >>> explained_variance_score(y_true, y_pred)\n1017 |     0.0\n1018 |     >>> explained_variance_score(y_true, y_pred, force_finite=False)\n1019 |     -inf\n1020 |     \"\"\"\n1021 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n1022 |         y_true, y_pred, multioutput\n1023 |     )\n1024 |     check_consistent_length(y_true, y_pred, sample_weight)\n1025 | \n1026 |     y_diff_avg = np.average(y_true - y_pred, weights=sample_weight, axis=0)\n1027 |     numerator = np.average(\n1028 |         (y_true - y_pred - y_diff_avg) ** 2, weights=sample_weight, axis=0\n1029 |     )\n1030 | \n1031 |     y_true_avg = np.average(y_true, weights=sample_weight, axis=0)\n1032 |     denominator = np.average((y_true - y_true_avg) ** 2, weights=sample_weight, axis=0)\n1033 | \n1034 |     return _assemble_r2_explained_variance(\n1035 |         numerator=numerator,\n1036 |         denominator=denominator,\n1037 |         n_outputs=y_true.shape[1],\n1038 |         multioutput=multioutput,\n1039 |         force_finite=force_finite,\n1040 |         xp=get_namespace(y_true)[0],\n1041 |         # TODO: update once Array API support is added to explained_variance_score.\n1042 |         device=None,\n1043 |     )\n1044 | \n1045 | \n1046 | @validate_params(\n1047 |     {\n1048 |         \"y_true\": [\"array-like\"],\n1049 |         \"y_pred\": [\"array-like\"],\n1050 |         \"sample_weight\": [\"array-like\", None],\n1051 |         \"multioutput\": [\n1052 |             StrOptions({\"raw_values\", \"uniform_average\", \"variance_weighted\"}),\n1053 |             \"array-like\",\n1054 |             None,\n1055 |         ],\n1056 |         \"force_finite\": [\"boolean\"],\n1057 |     },\n1058 |     prefer_skip_nested_validation=True,\n1059 | )\n1060 | def r2_score(\n1061 |     y_true,\n1062 |     y_pred,\n1063 |     *,\n1064 |     sample_weight=None,\n1065 |     multioutput=\"uniform_average\",\n1066 |     force_finite=True,\n1067 | ):\n1068 |     \"\"\":math:`R^2` (coefficient of determination) regression score function.\n1069 | \n1070 |     Best possible score is 1.0 and it can be negative (because the\n1071 |     model can be arbitrarily worse). In the general case when the true y is\n1072 |     non-constant, a constant model that always predicts the average y\n1073 |     disregarding the input features would get a :math:`R^2` score of 0.0.\n1074 | \n1075 |     In the particular case when ``y_true`` is constant, the :math:`R^2` score\n1076 |     is not finite: it is either ``NaN`` (perfect predictions) or ``-Inf``\n1077 |     (imperfect predictions). To prevent such non-finite numbers to pollute\n1078 |     higher-level experiments such as a grid search cross-validation, by default\n1079 |     these cases are replaced with 1.0 (perfect predictions) or 0.0 (imperfect\n1080 |     predictions) respectively. You can set ``force_finite`` to ``False`` to\n1081 |     prevent this fix from happening.\n1082 | \n1083 |     Note: when the prediction residuals have zero mean, the :math:`R^2` score\n1084 |     is identical to the\n1085 |     :func:`Explained Variance score <explained_variance_score>`.\n1086 | \n1087 |     Read more in the :ref:`User Guide <r2_score>`.\n1088 | \n1089 |     Parameters\n1090 |     ----------\n1091 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1092 |         Ground truth (correct) target values.\n1093 | \n1094 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1095 |         Estimated target values.\n1096 | \n1097 |     sample_weight : array-like of shape (n_samples,), default=None\n1098 |         Sample weights.\n1099 | \n1100 |     multioutput : {'raw_values', 'uniform_average', 'variance_weighted'}, \\\n1101 |             array-like of shape (n_outputs,) or None, default='uniform_average'\n1102 | \n1103 |         Defines aggregating of multiple output scores.\n1104 |         Array-like value defines weights used to average scores.\n1105 |         Default is \"uniform_average\".\n1106 | \n1107 |         'raw_values' :\n1108 |             Returns a full set of scores in case of multioutput input.\n1109 | \n1110 |         'uniform_average' :\n1111 |             Scores of all outputs are averaged with uniform weight.\n1112 | \n1113 |         'variance_weighted' :\n1114 |             Scores of all outputs are averaged, weighted by the variances\n1115 |             of each individual output.\n1116 | \n1117 |         .. versionchanged:: 0.19\n1118 |             Default value of multioutput is 'uniform_average'.\n1119 | \n1120 |     force_finite : bool, default=True\n1121 |         Flag indicating if ``NaN`` and ``-Inf`` scores resulting from constant\n1122 |         data should be replaced with real numbers (``1.0`` if prediction is\n1123 |         perfect, ``0.0`` otherwise). Default is ``True``, a convenient setting\n1124 |         for hyperparameters' search procedures (e.g. grid search\n1125 |         cross-validation).\n1126 | \n1127 |         .. versionadded:: 1.1\n1128 | \n1129 |     Returns\n1130 |     -------\n1131 |     z : float or ndarray of floats\n1132 |         The :math:`R^2` score or ndarray of scores if 'multioutput' is\n1133 |         'raw_values'.\n1134 | \n1135 |     Notes\n1136 |     -----\n1137 |     This is not a symmetric function.\n1138 | \n1139 |     Unlike most other scores, :math:`R^2` score may be negative (it need not\n1140 |     actually be the square of a quantity R).\n1141 | \n1142 |     This metric is not well-defined for single samples and will return a NaN\n1143 |     value if n_samples is less than two.\n1144 | \n1145 |     References\n1146 |     ----------\n1147 |     .. [1] `Wikipedia entry on the Coefficient of determination\n1148 |             <https://en.wikipedia.org/wiki/Coefficient_of_determination>`_\n1149 | \n1150 |     Examples\n1151 |     --------\n1152 |     >>> from sklearn.metrics import r2_score\n1153 |     >>> y_true = [3, -0.5, 2, 7]\n1154 |     >>> y_pred = [2.5, 0.0, 2, 8]\n1155 |     >>> r2_score(y_true, y_pred)\n1156 |     0.948...\n1157 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n1158 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n1159 |     >>> r2_score(y_true, y_pred,\n1160 |     ...          multioutput='variance_weighted')\n1161 |     0.938...\n1162 |     >>> y_true = [1, 2, 3]\n1163 |     >>> y_pred = [1, 2, 3]\n1164 |     >>> r2_score(y_true, y_pred)\n1165 |     1.0\n1166 |     >>> y_true = [1, 2, 3]\n1167 |     >>> y_pred = [2, 2, 2]\n1168 |     >>> r2_score(y_true, y_pred)\n1169 |     0.0\n1170 |     >>> y_true = [1, 2, 3]\n1171 |     >>> y_pred = [3, 2, 1]\n1172 |     >>> r2_score(y_true, y_pred)\n1173 |     -3.0\n1174 |     >>> y_true = [-2, -2, -2]\n1175 |     >>> y_pred = [-2, -2, -2]\n1176 |     >>> r2_score(y_true, y_pred)\n1177 |     1.0\n1178 |     >>> r2_score(y_true, y_pred, force_finite=False)\n1179 |     nan\n1180 |     >>> y_true = [-2, -2, -2]\n1181 |     >>> y_pred = [-2, -2, -2 + 1e-8]\n1182 |     >>> r2_score(y_true, y_pred)\n1183 |     0.0\n1184 |     >>> r2_score(y_true, y_pred, force_finite=False)\n1185 |     -inf\n1186 |     \"\"\"\n1187 |     xp, _, device_ = get_namespace_and_device(\n1188 |         y_true, y_pred, sample_weight, multioutput\n1189 |     )\n1190 | \n1191 |     dtype = _find_matching_floating_dtype(y_true, y_pred, sample_weight, xp=xp)\n1192 | \n1193 |     _, y_true, y_pred, multioutput = _check_reg_targets(\n1194 |         y_true, y_pred, multioutput, dtype=dtype, xp=xp\n1195 |     )\n1196 |     check_consistent_length(y_true, y_pred, sample_weight)\n1197 | \n1198 |     if _num_samples(y_pred) < 2:\n1199 |         msg = \"R^2 score is not well-defined with less than two samples.\"\n1200 |         warnings.warn(msg, UndefinedMetricWarning)\n1201 |         return float(\"nan\")\n1202 | \n1203 |     if sample_weight is not None:\n1204 |         sample_weight = column_or_1d(sample_weight, dtype=dtype)\n1205 |         weight = sample_weight[:, None]\n1206 |     else:\n1207 |         weight = 1.0\n1208 | \n1209 |     numerator = xp.sum(weight * (y_true - y_pred) ** 2, axis=0)\n1210 |     denominator = xp.sum(\n1211 |         weight * (y_true - _average(y_true, axis=0, weights=sample_weight, xp=xp)) ** 2,\n1212 |         axis=0,\n1213 |     )\n1214 | \n1215 |     return _assemble_r2_explained_variance(\n1216 |         numerator=numerator,\n1217 |         denominator=denominator,\n1218 |         n_outputs=y_true.shape[1],\n1219 |         multioutput=multioutput,\n1220 |         force_finite=force_finite,\n1221 |         xp=xp,\n1222 |         device=device_,\n1223 |     )\n1224 | \n1225 | \n1226 | @validate_params(\n1227 |     {\n1228 |         \"y_true\": [\"array-like\"],\n1229 |         \"y_pred\": [\"array-like\"],\n1230 |     },\n1231 |     prefer_skip_nested_validation=True,\n1232 | )\n1233 | def max_error(y_true, y_pred):\n1234 |     \"\"\"\n1235 |     The max_error metric calculates the maximum residual error.\n1236 | \n1237 |     Read more in the :ref:`User Guide <max_error>`.\n1238 | \n1239 |     Parameters\n1240 |     ----------\n1241 |     y_true : array-like of shape (n_samples,)\n1242 |         Ground truth (correct) target values.\n1243 | \n1244 |     y_pred : array-like of shape (n_samples,)\n1245 |         Estimated target values.\n1246 | \n1247 |     Returns\n1248 |     -------\n1249 |     max_error : float\n1250 |         A positive floating point value (the best value is 0.0).\n1251 | \n1252 |     Examples\n1253 |     --------\n1254 |     >>> from sklearn.metrics import max_error\n1255 |     >>> y_true = [3, 2, 7, 1]\n1256 |     >>> y_pred = [4, 2, 7, 1]\n1257 |     >>> max_error(y_true, y_pred)\n1258 |     np.int64(1)\n1259 |     \"\"\"\n1260 |     xp, _ = get_namespace(y_true, y_pred)\n1261 |     y_type, y_true, y_pred, _ = _check_reg_targets(y_true, y_pred, None, xp=xp)\n1262 |     if y_type == \"continuous-multioutput\":\n1263 |         raise ValueError(\"Multioutput not supported in max_error\")\n1264 |     return xp.max(xp.abs(y_true - y_pred))\n1265 | \n1266 | \n1267 | def _mean_tweedie_deviance(y_true, y_pred, sample_weight, power):\n1268 |     \"\"\"Mean Tweedie deviance regression loss.\"\"\"\n1269 |     xp, _ = get_namespace(y_true, y_pred)\n1270 |     p = power\n1271 |     zero = xp.asarray(0, dtype=y_true.dtype)\n1272 |     if p < 0:\n1273 |         # 'Extreme stable', y any real number, y_pred > 0\n1274 |         dev = 2 * (\n1275 |             xp.pow(xp.where(y_true > 0, y_true, zero), xp.asarray(2 - p))\n1276 |             / ((1 - p) * (2 - p))\n1277 |             - y_true * xp.pow(y_pred, xp.asarray(1 - p)) / (1 - p)\n1278 |             + xp.pow(y_pred, xp.asarray(2 - p)) / (2 - p)\n1279 |         )\n1280 |     elif p == 0:\n1281 |         # Normal distribution, y and y_pred any real number\n1282 |         dev = (y_true - y_pred) ** 2\n1283 |     elif p == 1:\n1284 |         # Poisson distribution\n1285 |         dev = 2 * (xlogy(y_true, y_true / y_pred) - y_true + y_pred)\n1286 |     elif p == 2:\n1287 |         # Gamma distribution\n1288 |         dev = 2 * (xp.log(y_pred / y_true) + y_true / y_pred - 1)\n1289 |     else:\n1290 |         dev = 2 * (\n1291 |             xp.pow(y_true, xp.asarray(2 - p)) / ((1 - p) * (2 - p))\n1292 |             - y_true * xp.pow(y_pred, xp.asarray(1 - p)) / (1 - p)\n1293 |             + xp.pow(y_pred, xp.asarray(2 - p)) / (2 - p)\n1294 |         )\n1295 |     return float(_average(dev, weights=sample_weight))\n1296 | \n1297 | \n1298 | @validate_params(\n1299 |     {\n1300 |         \"y_true\": [\"array-like\"],\n1301 |         \"y_pred\": [\"array-like\"],\n1302 |         \"sample_weight\": [\"array-like\", None],\n1303 |         \"power\": [\n1304 |             Interval(Real, None, 0, closed=\"right\"),\n1305 |             Interval(Real, 1, None, closed=\"left\"),\n1306 |         ],\n1307 |     },\n1308 |     prefer_skip_nested_validation=True,\n1309 | )\n1310 | def mean_tweedie_deviance(y_true, y_pred, *, sample_weight=None, power=0):\n1311 |     \"\"\"Mean Tweedie deviance regression loss.\n1312 | \n1313 |     Read more in the :ref:`User Guide <mean_tweedie_deviance>`.\n1314 | \n1315 |     Parameters\n1316 |     ----------\n1317 |     y_true : array-like of shape (n_samples,)\n1318 |         Ground truth (correct) target values.\n1319 | \n1320 |     y_pred : array-like of shape (n_samples,)\n1321 |         Estimated target values.\n1322 | \n1323 |     sample_weight : array-like of shape (n_samples,), default=None\n1324 |         Sample weights.\n1325 | \n1326 |     power : float, default=0\n1327 |         Tweedie power parameter. Either power <= 0 or power >= 1.\n1328 | \n1329 |         The higher `p` the less weight is given to extreme\n1330 |         deviations between true and predicted targets.\n1331 | \n1332 |         - power < 0: Extreme stable distribution. Requires: y_pred > 0.\n1333 |         - power = 0 : Normal distribution, output corresponds to\n1334 |           mean_squared_error. y_true and y_pred can be any real numbers.\n1335 |         - power = 1 : Poisson distribution. Requires: y_true >= 0 and\n1336 |           y_pred > 0.\n1337 |         - 1 < p < 2 : Compound Poisson distribution. Requires: y_true >= 0\n1338 |           and y_pred > 0.\n1339 |         - power = 2 : Gamma distribution. Requires: y_true > 0 and y_pred > 0.\n1340 |         - power = 3 : Inverse Gaussian distribution. Requires: y_true > 0\n1341 |           and y_pred > 0.\n1342 |         - otherwise : Positive stable distribution. Requires: y_true > 0\n1343 |           and y_pred > 0.\n1344 | \n1345 |     Returns\n1346 |     -------\n1347 |     loss : float\n1348 |         A non-negative floating point value (the best value is 0.0).\n1349 | \n1350 |     Examples\n1351 |     --------\n1352 |     >>> from sklearn.metrics import mean_tweedie_deviance\n1353 |     >>> y_true = [2, 0, 1, 4]\n1354 |     >>> y_pred = [0.5, 0.5, 2., 2.]\n1355 |     >>> mean_tweedie_deviance(y_true, y_pred, power=1)\n1356 |     1.4260...\n1357 |     \"\"\"\n1358 |     xp, _ = get_namespace(y_true, y_pred)\n1359 |     y_type, y_true, y_pred, _ = _check_reg_targets(\n1360 |         y_true, y_pred, None, dtype=[xp.float64, xp.float32], xp=xp\n1361 |     )\n1362 |     if y_type == \"continuous-multioutput\":\n1363 |         raise ValueError(\"Multioutput not supported in mean_tweedie_deviance\")\n1364 |     check_consistent_length(y_true, y_pred, sample_weight)\n1365 | \n1366 |     if sample_weight is not None:\n1367 |         sample_weight = column_or_1d(sample_weight)\n1368 |         sample_weight = sample_weight[:, np.newaxis]\n1369 | \n1370 |     message = f\"Mean Tweedie deviance error with power={power} can only be used on \"\n1371 |     if power < 0:\n1372 |         # 'Extreme stable', y any real number, y_pred > 0\n1373 |         if xp.any(y_pred <= 0):\n1374 |             raise ValueError(message + \"strictly positive y_pred.\")\n1375 |     elif power == 0:\n1376 |         # Normal, y and y_pred can be any real number\n1377 |         pass\n1378 |     elif 1 <= power < 2:\n1379 |         # Poisson and compound Poisson distribution, y >= 0, y_pred > 0\n1380 |         if xp.any(y_true < 0) or xp.any(y_pred <= 0):\n1381 |             raise ValueError(message + \"non-negative y and strictly positive y_pred.\")\n1382 |     elif power >= 2:\n1383 |         # Gamma and Extreme stable distribution, y and y_pred > 0\n1384 |         if xp.any(y_true <= 0) or xp.any(y_pred <= 0):\n1385 |             raise ValueError(message + \"strictly positive y and y_pred.\")\n1386 |     else:  # pragma: nocover\n1387 |         # Unreachable statement\n1388 |         raise ValueError\n1389 | \n1390 |     return _mean_tweedie_deviance(\n1391 |         y_true, y_pred, sample_weight=sample_weight, power=power\n1392 |     )\n1393 | \n1394 | \n1395 | @validate_params(\n1396 |     {\n1397 |         \"y_true\": [\"array-like\"],\n1398 |         \"y_pred\": [\"array-like\"],\n1399 |         \"sample_weight\": [\"array-like\", None],\n1400 |     },\n1401 |     prefer_skip_nested_validation=True,\n1402 | )\n1403 | def mean_poisson_deviance(y_true, y_pred, *, sample_weight=None):\n1404 |     \"\"\"Mean Poisson deviance regression loss.\n1405 | \n1406 |     Poisson deviance is equivalent to the Tweedie deviance with\n1407 |     the power parameter `power=1`.\n1408 | \n1409 |     Read more in the :ref:`User Guide <mean_tweedie_deviance>`.\n1410 | \n1411 |     Parameters\n1412 |     ----------\n1413 |     y_true : array-like of shape (n_samples,)\n1414 |         Ground truth (correct) target values. Requires y_true >= 0.\n1415 | \n1416 |     y_pred : array-like of shape (n_samples,)\n1417 |         Estimated target values. Requires y_pred > 0.\n1418 | \n1419 |     sample_weight : array-like of shape (n_samples,), default=None\n1420 |         Sample weights.\n1421 | \n1422 |     Returns\n1423 |     -------\n1424 |     loss : float\n1425 |         A non-negative floating point value (the best value is 0.0).\n1426 | \n1427 |     Examples\n1428 |     --------\n1429 |     >>> from sklearn.metrics import mean_poisson_deviance\n1430 |     >>> y_true = [2, 0, 1, 4]\n1431 |     >>> y_pred = [0.5, 0.5, 2., 2.]\n1432 |     >>> mean_poisson_deviance(y_true, y_pred)\n1433 |     1.4260...\n1434 |     \"\"\"\n1435 |     return mean_tweedie_deviance(y_true, y_pred, sample_weight=sample_weight, power=1)\n1436 | \n1437 | \n1438 | @validate_params(\n1439 |     {\n1440 |         \"y_true\": [\"array-like\"],\n1441 |         \"y_pred\": [\"array-like\"],\n1442 |         \"sample_weight\": [\"array-like\", None],\n1443 |     },\n1444 |     prefer_skip_nested_validation=True,\n1445 | )\n1446 | def mean_gamma_deviance(y_true, y_pred, *, sample_weight=None):\n1447 |     \"\"\"Mean Gamma deviance regression loss.\n1448 | \n1449 |     Gamma deviance is equivalent to the Tweedie deviance with\n1450 |     the power parameter `power=2`. It is invariant to scaling of\n1451 |     the target variable, and measures relative errors.\n1452 | \n1453 |     Read more in the :ref:`User Guide <mean_tweedie_deviance>`.\n1454 | \n1455 |     Parameters\n1456 |     ----------\n1457 |     y_true : array-like of shape (n_samples,)\n1458 |         Ground truth (correct) target values. Requires y_true > 0.\n1459 | \n1460 |     y_pred : array-like of shape (n_samples,)\n1461 |         Estimated target values. Requires y_pred > 0.\n1462 | \n1463 |     sample_weight : array-like of shape (n_samples,), default=None\n1464 |         Sample weights.\n1465 | \n1466 |     Returns\n1467 |     -------\n1468 |     loss : float\n1469 |         A non-negative floating point value (the best value is 0.0).\n1470 | \n1471 |     Examples\n1472 |     --------\n1473 |     >>> from sklearn.metrics import mean_gamma_deviance\n1474 |     >>> y_true = [2, 0.5, 1, 4]\n1475 |     >>> y_pred = [0.5, 0.5, 2., 2.]\n1476 |     >>> mean_gamma_deviance(y_true, y_pred)\n1477 |     1.0568...\n1478 |     \"\"\"\n1479 |     return mean_tweedie_deviance(y_true, y_pred, sample_weight=sample_weight, power=2)\n1480 | \n1481 | \n1482 | @validate_params(\n1483 |     {\n1484 |         \"y_true\": [\"array-like\"],\n1485 |         \"y_pred\": [\"array-like\"],\n1486 |         \"sample_weight\": [\"array-like\", None],\n1487 |         \"power\": [\n1488 |             Interval(Real, None, 0, closed=\"right\"),\n1489 |             Interval(Real, 1, None, closed=\"left\"),\n1490 |         ],\n1491 |     },\n1492 |     prefer_skip_nested_validation=True,\n1493 | )\n1494 | def d2_tweedie_score(y_true, y_pred, *, sample_weight=None, power=0):\n1495 |     \"\"\"\n1496 |     :math:`D^2` regression score function, fraction of Tweedie deviance explained.\n1497 | \n1498 |     Best possible score is 1.0 and it can be negative (because the model can be\n1499 |     arbitrarily worse). A model that always uses the empirical mean of `y_true` as\n1500 |     constant prediction, disregarding the input features, gets a D^2 score of 0.0.\n1501 | \n1502 |     Read more in the :ref:`User Guide <d2_score>`.\n1503 | \n1504 |     .. versionadded:: 1.0\n1505 | \n1506 |     Parameters\n1507 |     ----------\n1508 |     y_true : array-like of shape (n_samples,)\n1509 |         Ground truth (correct) target values.\n1510 | \n1511 |     y_pred : array-like of shape (n_samples,)\n1512 |         Estimated target values.\n1513 | \n1514 |     sample_weight : array-like of shape (n_samples,), default=None\n1515 |         Sample weights.\n1516 | \n1517 |     power : float, default=0\n1518 |         Tweedie power parameter. Either power <= 0 or power >= 1.\n1519 | \n1520 |         The higher `p` the less weight is given to extreme\n1521 |         deviations between true and predicted targets.\n1522 | \n1523 |         - power < 0: Extreme stable distribution. Requires: y_pred > 0.\n1524 |         - power = 0 : Normal distribution, output corresponds to r2_score.\n1525 |           y_true and y_pred can be any real numbers.\n1526 |         - power = 1 : Poisson distribution. Requires: y_true >= 0 and\n1527 |           y_pred > 0.\n1528 |         - 1 < p < 2 : Compound Poisson distribution. Requires: y_true >= 0\n1529 |           and y_pred > 0.\n1530 |         - power = 2 : Gamma distribution. Requires: y_true > 0 and y_pred > 0.\n1531 |         - power = 3 : Inverse Gaussian distribution. Requires: y_true > 0\n1532 |           and y_pred > 0.\n1533 |         - otherwise : Positive stable distribution. Requires: y_true > 0\n1534 |           and y_pred > 0.\n1535 | \n1536 |     Returns\n1537 |     -------\n1538 |     z : float or ndarray of floats\n1539 |         The D^2 score.\n1540 | \n1541 |     Notes\n1542 |     -----\n1543 |     This is not a symmetric function.\n1544 | \n1545 |     Like R^2, D^2 score may be negative (it need not actually be the square of\n1546 |     a quantity D).\n1547 | \n1548 |     This metric is not well-defined for single samples and will return a NaN\n1549 |     value if n_samples is less than two.\n1550 | \n1551 |     References\n1552 |     ----------\n1553 |     .. [1] Eq. (3.11) of Hastie, Trevor J., Robert Tibshirani and Martin J.\n1554 |            Wainwright. \"Statistical Learning with Sparsity: The Lasso and\n1555 |            Generalizations.\" (2015). https://hastie.su.domains/StatLearnSparsity/\n1556 | \n1557 |     Examples\n1558 |     --------\n1559 |     >>> from sklearn.metrics import d2_tweedie_score\n1560 |     >>> y_true = [0.5, 1, 2.5, 7]\n1561 |     >>> y_pred = [1, 1, 5, 3.5]\n1562 |     >>> d2_tweedie_score(y_true, y_pred)\n1563 |     0.285...\n1564 |     >>> d2_tweedie_score(y_true, y_pred, power=1)\n1565 |     0.487...\n1566 |     >>> d2_tweedie_score(y_true, y_pred, power=2)\n1567 |     0.630...\n1568 |     >>> d2_tweedie_score(y_true, y_true, power=2)\n1569 |     1.0\n1570 |     \"\"\"\n1571 |     xp, _ = get_namespace(y_true, y_pred)\n1572 | \n1573 |     y_type, y_true, y_pred, _ = _check_reg_targets(\n1574 |         y_true, y_pred, None, dtype=[xp.float64, xp.float32], xp=xp\n1575 |     )\n1576 |     if y_type == \"continuous-multioutput\":\n1577 |         raise ValueError(\"Multioutput not supported in d2_tweedie_score\")\n1578 | \n1579 |     if _num_samples(y_pred) < 2:\n1580 |         msg = \"D^2 score is not well-defined with less than two samples.\"\n1581 |         warnings.warn(msg, UndefinedMetricWarning)\n1582 |         return float(\"nan\")\n1583 | \n1584 |     y_true, y_pred = xp.squeeze(y_true, axis=1), xp.squeeze(y_pred, axis=1)\n1585 |     numerator = mean_tweedie_deviance(\n1586 |         y_true, y_pred, sample_weight=sample_weight, power=power\n1587 |     )\n1588 | \n1589 |     y_avg = _average(y_true, weights=sample_weight, xp=xp)\n1590 |     denominator = _mean_tweedie_deviance(\n1591 |         y_true, y_avg, sample_weight=sample_weight, power=power\n1592 |     )\n1593 | \n1594 |     return 1 - numerator / denominator\n1595 | \n1596 | \n1597 | @validate_params(\n1598 |     {\n1599 |         \"y_true\": [\"array-like\"],\n1600 |         \"y_pred\": [\"array-like\"],\n1601 |         \"sample_weight\": [\"array-like\", None],\n1602 |         \"alpha\": [Interval(Real, 0, 1, closed=\"both\")],\n1603 |         \"multioutput\": [\n1604 |             StrOptions({\"raw_values\", \"uniform_average\"}),\n1605 |             \"array-like\",\n1606 |         ],\n1607 |     },\n1608 |     prefer_skip_nested_validation=True,\n1609 | )\n1610 | def d2_pinball_score(\n1611 |     y_true, y_pred, *, sample_weight=None, alpha=0.5, multioutput=\"uniform_average\"\n1612 | ):\n1613 |     \"\"\"\n1614 |     :math:`D^2` regression score function, fraction of pinball loss explained.\n1615 | \n1616 |     Best possible score is 1.0 and it can be negative (because the model can be\n1617 |     arbitrarily worse). A model that always uses the empirical alpha-quantile of\n1618 |     `y_true` as constant prediction, disregarding the input features,\n1619 |     gets a :math:`D^2` score of 0.0.\n1620 | \n1621 |     Read more in the :ref:`User Guide <d2_score>`.\n1622 | \n1623 |     .. versionadded:: 1.1\n1624 | \n1625 |     Parameters\n1626 |     ----------\n1627 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1628 |         Ground truth (correct) target values.\n1629 | \n1630 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1631 |         Estimated target values.\n1632 | \n1633 |     sample_weight : array-like of shape (n_samples,), default=None\n1634 |         Sample weights.\n1635 | \n1636 |     alpha : float, default=0.5\n1637 |         Slope of the pinball deviance. It determines the quantile level alpha\n1638 |         for which the pinball deviance and also D2 are optimal.\n1639 |         The default `alpha=0.5` is equivalent to `d2_absolute_error_score`.\n1640 | \n1641 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n1642 |             (n_outputs,), default='uniform_average'\n1643 |         Defines aggregating of multiple output values.\n1644 |         Array-like value defines weights used to average scores.\n1645 | \n1646 |         'raw_values' :\n1647 |             Returns a full set of errors in case of multioutput input.\n1648 | \n1649 |         'uniform_average' :\n1650 |             Scores of all outputs are averaged with uniform weight.\n1651 | \n1652 |     Returns\n1653 |     -------\n1654 |     score : float or ndarray of floats\n1655 |         The :math:`D^2` score with a pinball deviance\n1656 |         or ndarray of scores if `multioutput='raw_values'`.\n1657 | \n1658 |     Notes\n1659 |     -----\n1660 |     Like :math:`R^2`, :math:`D^2` score may be negative\n1661 |     (it need not actually be the square of a quantity D).\n1662 | \n1663 |     This metric is not well-defined for a single point and will return a NaN\n1664 |     value if n_samples is less than two.\n1665 | \n1666 |      References\n1667 |     ----------\n1668 |     .. [1] Eq. (7) of `Koenker, Roger; Machado, Jos\u00e9 A. F. (1999).\n1669 |            \"Goodness of Fit and Related Inference Processes for Quantile Regression\"\n1670 |            <https://doi.org/10.1080/01621459.1999.10473882>`_\n1671 |     .. [2] Eq. (3.11) of Hastie, Trevor J., Robert Tibshirani and Martin J.\n1672 |            Wainwright. \"Statistical Learning with Sparsity: The Lasso and\n1673 |            Generalizations.\" (2015). https://hastie.su.domains/StatLearnSparsity/\n1674 | \n1675 |     Examples\n1676 |     --------\n1677 |     >>> from sklearn.metrics import d2_pinball_score\n1678 |     >>> y_true = [1, 2, 3]\n1679 |     >>> y_pred = [1, 3, 3]\n1680 |     >>> d2_pinball_score(y_true, y_pred)\n1681 |     np.float64(0.5)\n1682 |     >>> d2_pinball_score(y_true, y_pred, alpha=0.9)\n1683 |     np.float64(0.772...)\n1684 |     >>> d2_pinball_score(y_true, y_pred, alpha=0.1)\n1685 |     np.float64(-1.045...)\n1686 |     >>> d2_pinball_score(y_true, y_true, alpha=0.1)\n1687 |     np.float64(1.0)\n1688 |     \"\"\"\n1689 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n1690 |         y_true, y_pred, multioutput\n1691 |     )\n1692 |     check_consistent_length(y_true, y_pred, sample_weight)\n1693 | \n1694 |     if _num_samples(y_pred) < 2:\n1695 |         msg = \"D^2 score is not well-defined with less than two samples.\"\n1696 |         warnings.warn(msg, UndefinedMetricWarning)\n1697 |         return float(\"nan\")\n1698 | \n1699 |     numerator = mean_pinball_loss(\n1700 |         y_true,\n1701 |         y_pred,\n1702 |         sample_weight=sample_weight,\n1703 |         alpha=alpha,\n1704 |         multioutput=\"raw_values\",\n1705 |     )\n1706 | \n1707 |     if sample_weight is None:\n1708 |         y_quantile = np.tile(\n1709 |             np.percentile(y_true, q=alpha * 100, axis=0), (len(y_true), 1)\n1710 |         )\n1711 |     else:\n1712 |         sample_weight = _check_sample_weight(sample_weight, y_true)\n1713 |         y_quantile = np.tile(\n1714 |             _weighted_percentile(\n1715 |                 y_true, sample_weight=sample_weight, percentile=alpha * 100\n1716 |             ),\n1717 |             (len(y_true), 1),\n1718 |         )\n1719 | \n1720 |     denominator = mean_pinball_loss(\n1721 |         y_true,\n1722 |         y_quantile,\n1723 |         sample_weight=sample_weight,\n1724 |         alpha=alpha,\n1725 |         multioutput=\"raw_values\",\n1726 |     )\n1727 | \n1728 |     nonzero_numerator = numerator != 0\n1729 |     nonzero_denominator = denominator != 0\n1730 |     valid_score = nonzero_numerator & nonzero_denominator\n1731 |     output_scores = np.ones(y_true.shape[1])\n1732 | \n1733 |     output_scores[valid_score] = 1 - (numerator[valid_score] / denominator[valid_score])\n1734 |     output_scores[nonzero_numerator & ~nonzero_denominator] = 0.0\n1735 | \n1736 |     if isinstance(multioutput, str):\n1737 |         if multioutput == \"raw_values\":\n1738 |             # return scores individually\n1739 |             return output_scores\n1740 |         else:  # multioutput == \"uniform_average\"\n1741 |             # passing None as weights to np.average results in uniform mean\n1742 |             avg_weights = None\n1743 |     else:\n1744 |         avg_weights = multioutput\n1745 | \n1746 |     return np.average(output_scores, weights=avg_weights)\n1747 | \n1748 | \n1749 | @validate_params(\n1750 |     {\n1751 |         \"y_true\": [\"array-like\"],\n1752 |         \"y_pred\": [\"array-like\"],\n1753 |         \"sample_weight\": [\"array-like\", None],\n1754 |         \"multioutput\": [\n1755 |             StrOptions({\"raw_values\", \"uniform_average\"}),\n1756 |             \"array-like\",\n1757 |         ],\n1758 |     },\n1759 |     prefer_skip_nested_validation=True,\n1760 | )\n1761 | def d2_absolute_error_score(\n1762 |     y_true, y_pred, *, sample_weight=None, multioutput=\"uniform_average\"\n1763 | ):\n1764 |     \"\"\"\n1765 |     :math:`D^2` regression score function, fraction of absolute error explained.\n1766 | \n1767 |     Best possible score is 1.0 and it can be negative (because the model can be\n1768 |     arbitrarily worse). A model that always uses the empirical median of `y_true`\n1769 |     as constant prediction, disregarding the input features,\n1770 |     gets a :math:`D^2` score of 0.0.\n1771 | \n1772 |     Read more in the :ref:`User Guide <d2_score>`.\n1773 | \n1774 |     .. versionadded:: 1.1\n1775 | \n1776 |     Parameters\n1777 |     ----------\n1778 |     y_true : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1779 |         Ground truth (correct) target values.\n1780 | \n1781 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1782 |         Estimated target values.\n1783 | \n1784 |     sample_weight : array-like of shape (n_samples,), default=None\n1785 |         Sample weights.\n1786 | \n1787 |     multioutput : {'raw_values', 'uniform_average'} or array-like of shape \\\n1788 |             (n_outputs,), default='uniform_average'\n1789 |         Defines aggregating of multiple output values.\n1790 |         Array-like value defines weights used to average scores.\n1791 | \n1792 |         'raw_values' :\n1793 |             Returns a full set of errors in case of multioutput input.\n1794 | \n1795 |         'uniform_average' :\n1796 |             Scores of all outputs are averaged with uniform weight.\n1797 | \n1798 |     Returns\n1799 |     -------\n1800 |     score : float or ndarray of floats\n1801 |         The :math:`D^2` score with an absolute error deviance\n1802 |         or ndarray of scores if 'multioutput' is 'raw_values'.\n1803 | \n1804 |     Notes\n1805 |     -----\n1806 |     Like :math:`R^2`, :math:`D^2` score may be negative\n1807 |     (it need not actually be the square of a quantity D).\n1808 | \n1809 |     This metric is not well-defined for single samples and will return a NaN\n1810 |     value if n_samples is less than two.\n1811 | \n1812 |      References\n1813 |     ----------\n1814 |     .. [1] Eq. (3.11) of Hastie, Trevor J., Robert Tibshirani and Martin J.\n1815 |            Wainwright. \"Statistical Learning with Sparsity: The Lasso and\n1816 |            Generalizations.\" (2015). https://hastie.su.domains/StatLearnSparsity/\n1817 | \n1818 |     Examples\n1819 |     --------\n1820 |     >>> from sklearn.metrics import d2_absolute_error_score\n1821 |     >>> y_true = [3, -0.5, 2, 7]\n1822 |     >>> y_pred = [2.5, 0.0, 2, 8]\n1823 |     >>> d2_absolute_error_score(y_true, y_pred)\n1824 |     np.float64(0.764...)\n1825 |     >>> y_true = [[0.5, 1], [-1, 1], [7, -6]]\n1826 |     >>> y_pred = [[0, 2], [-1, 2], [8, -5]]\n1827 |     >>> d2_absolute_error_score(y_true, y_pred, multioutput='uniform_average')\n1828 |     np.float64(0.691...)\n1829 |     >>> d2_absolute_error_score(y_true, y_pred, multioutput='raw_values')\n1830 |     array([0.8125    , 0.57142857])\n1831 |     >>> y_true = [1, 2, 3]\n1832 |     >>> y_pred = [1, 2, 3]\n1833 |     >>> d2_absolute_error_score(y_true, y_pred)\n1834 |     np.float64(1.0)\n1835 |     >>> y_true = [1, 2, 3]\n1836 |     >>> y_pred = [2, 2, 2]\n1837 |     >>> d2_absolute_error_score(y_true, y_pred)\n1838 |     np.float64(0.0)\n1839 |     >>> y_true = [1, 2, 3]\n1840 |     >>> y_pred = [3, 2, 1]\n1841 |     >>> d2_absolute_error_score(y_true, y_pred)\n1842 |     np.float64(-1.0)\n1843 |     \"\"\"\n1844 |     return d2_pinball_score(\n1845 |         y_true, y_pred, sample_weight=sample_weight, alpha=0.5, multioutput=multioutput\n1846 |     )\n1847 | \n```\n"}, {"content": "Based on my analysis, I can now provide the locations that need modification to implement the suggested feature improvement. Here's the output in the requested format:\n\n```\nsklearn/utils/_array_api.py\nline: 673-695\nfunction: _find_matching_floating_dtype\n\nsklearn/metrics/_regression.py\nline: 58-137\nfunction: _check_reg_targets\n\nsklearn/utils/validation.py\nline: 735-1177\nfunction: check_array\n\nsklearn/utils/_array_api.py\nline: 490-579\nfunction: get_namespace\n\nsklearn/utils/validation.py\nline: 890-891\nfunction: _assert_all_finite\n```\n\nThese locations were identified based on:\n\n1. The main issue focuses on reducing redundancy in floating type checks for Array API support, particularly in regression metrics.\n\n2. The core components involved are:\n   - `_find_matching_floating_dtype` in utils/_array_api.py: This is the function that determines the appropriate floating-point dtype\n   - `_check_reg_targets` in metrics/_regression.py: This is the function that currently needs to be modified to integrate dtype handling\n   - `check_array` in utils/validation.py: This is used by `_check_reg_targets` for array validation\n   - `get_namespace` in utils/_array_api.py: Used to get the array API namespace\n   - `_assert_all_finite` in utils/validation.py: Used for finite value checks\n\n3. The current implementation splits the floating-point dtype handling between multiple functions, which leads to redundant code. The suggestion is to consolidate this functionality into a single function to improve code reuse.\n\n4. The locations are ordered by importance, with the `_find_matching_floating_dtype` being the primary focus since it needs to be integrated with `_check_reg_targets`.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 147380, "completion_tokens": 640}, "time": 410.4790389537811}]}}
{"instance_id": "matplotlib__matplotlib-29133", "found_files": [["lib/matplotlib/axes/_axes.py", "lib/matplotlib/colors.py", "lib/matplotlib/patches.py"]], "found_modules": [["lib/matplotlib/axes/_axes.py:Axes", "lib/matplotlib/transforms.py:CompositeGenericTransform", "lib/matplotlib/backend_bases.py:key_press_handler", "lib/matplotlib/figure.py:Figure", "lib/matplotlib/patches.py:BoxStyle.Circle", "lib/matplotlib/backends/backend_pdf.py:GraphicsContextPdf", "lib/matplotlib/axis.py:XAxis", "lib/matplotlib/transforms.py:CompositeAffine2D", "lib/matplotlib/axes/_base.py:_AxesBase", "lib/matplotlib/colors.py:CenteredNorm", "lib/matplotlib/backend_bases.py:button_press_handler", "lib/matplotlib/_api/deprecation.py:suppress_matplotlib_deprecation_warning", "lib/matplotlib/colors.py:to_rgba_array", "lib/matplotlib/backend_bases.py:NavigationToolbar2", "lib/matplotlib/patches.py:ConnectionPatch"]], "found_entities": [["lib/matplotlib/axes/_axes.py:Axes.scatter", "lib/matplotlib/transforms.py:CompositeGenericTransform.__eq__", "lib/matplotlib/backend_bases.py:key_press_handler._get_uniform_gridstate", "lib/matplotlib/figure.py:Figure.__str__", "lib/matplotlib/patches.py:BoxStyle.Circle.__call__", "lib/matplotlib/backends/backend_pdf.py:GraphicsContextPdf.__repr__", "lib/matplotlib/figure.py:Figure.__repr__", "lib/matplotlib/axis.py:XAxis._update_label_position", "lib/matplotlib/transforms.py:CompositeAffine2D.get_matrix", "lib/matplotlib/axes/_base.py:_AxesBase.add_table", "lib/matplotlib/backends/backend_pdf.py:GraphicsContextPdf.dash_cmd", "lib/matplotlib/colors.py:CenteredNorm.autoscale", "lib/matplotlib/axes/_base.py:_AxesBase.add_container", "lib/matplotlib/colors.py:CenteredNorm.autoscale_None", "lib/matplotlib/backend_bases.py:button_press_handler", "lib/matplotlib/axis.py:XAxis.tick_top", "lib/matplotlib/backends/backend_pdf.py:GraphicsContextPdf.push", "lib/matplotlib/axes/_axes.py:Axes.bar", "lib/matplotlib/_api/deprecation.py:suppress_matplotlib_deprecation_warning", "lib/matplotlib/colors.py:to_rgba_array", "lib/matplotlib/backend_bases.py:NavigationToolbar2.zoom", "lib/matplotlib/patches.py:ConnectionPatch._check_xy", "lib/matplotlib/patches.py:ConnectionPatch.draw"]], "raw_output_loc": ["Let me analyze the collected information and identify the key files and functions that need modification to implement the requested feature.\n\nBased on the issue description and code analysis, we need to make several modifications to support:\n1. Making `facecolor` accept sequences\n2. Improving parameter precedence rules between `color`, `edgecolor`, and `facecolor`\n3. Making the behavior consistent with `scatter()` function's color parameter handling\n\nThe key files and functions involved are:\n\n1. `lib/matplotlib/axes/_axes.py:Axes.bar` - Main implementation of the bar plotting function\n2. `lib/matplotlib/patches.py:Rectangle` - The underlying patch class used for bars\n3. `lib/matplotlib/colors.py:to_rgba` - Color conversion utility function\n4. `lib/matplotlib/colors.py:to_rgba_array` - Color array conversion utility function\n\nHere are the specific locations that need to be modified, ordered by importance:\n\n```\nlib/matplotlib/axes/_axes.py\nline: 2378-2383\nline: 2443-2544\nline: 2579-2582\nclass: Axes\nfunction: bar\n\nlib/matplotlib/colors.py\nline: 506\nfunction: to_rgba_array\n\nlib/matplotlib/colors.py\nline: 512\nfunction: rgba\n\nlib/matplotlib/patches.py\nline: 3083\nclass: Rectangle\nfunction: __init__\n\nlib/matplotlib/axes/_axes.py\nline: 4694-4976\nclass: Axes\nfunction: scatter\n```\n\nThe core changes needed are:\n\n1. In `Axes.bar()`, we need to ensure the color handling follows the same precedence rules as scatter():\n   - Prefer `color` parameter over `facecolor` when both are provided\n   - Support list-like inputs for `color` parameter\n   - Set up proper precedence between color, edgecolor, and facecolor parameters\n\n2. The `to_rgba_array` and `to_rgba` functions in matplotlib/colors.py will need modifications to properly handle sequence inputs for color parameters.\n\n3. The Rectangle class in patches.py will need adjustments to properly handle the facecolor and edgecolor properties.\n\n4. The scatter function shows the desired behavior for color parameter handling:\n   - Uses `c` as primary color parameter\n   - Supports `color` as alias for `c`\n   - Handles sequence inputs properly\n   - Uses facecolor precedence rules\n\nThese locations capture the essential changes needed to implement the requested feature consistently with scatter() behavior."], "meta_data": {"repo": "matplotlib/matplotlib", "base_commit": "9caa0a648d73ac402dce3d5177497260a5ad1019", "problem_statement": "[MNT]: More consistent color parameters for bar()\n### Summary\n\nFrom #29072. `bar()` supports\r\n\r\n- `color` : color or list of color\r\n- `edgecolor` : color or list of color\r\n- `facecolor`: color\r\n\r\ni.e.\r\n\r\n- `facecolor` cannot take a sequence\r\n- there are no plural aliase (e.g. `edgecolors`)\r\n- likely (t.b.c.) the aliases also do not support sequences, similar to #28884\n\n### Proposed fix\n\nMake `facecolor` accept sequences and check that the parameter precedence among `color`, `edgecolor` and `facecolor` is reasonable and comparable with `scatter`, which can take an explicit color via `c` (equivalent to `color` here).\r\n\r\nFor now, I'd refrain from introducing plural aliase. `bar()` is originally and primarily a style-all-bars-identical function. Per-bar styling was added later on, and I don't think there's a strong need to support this additional use case with an added plural alias.\r\n\r\n\n", "patch": "diff --git a/lib/matplotlib/axes/_axes.py b/lib/matplotlib/axes/_axes.py\nindex f6a4ebfdc7c6..2bc77f63b376 100644\n--- a/lib/matplotlib/axes/_axes.py\n+++ b/lib/matplotlib/axes/_axes.py\n@@ -2321,6 +2321,56 @@ def _convert_dx(dx, x0, xconv, convert):\n             dx = convert(dx)\n         return dx\n \n+    def _parse_bar_color_args(self, kwargs):\n+        \"\"\"\n+        Helper function to process color-related arguments of `.Axes.bar`.\n+\n+        Argument precedence for facecolors:\n+\n+        - kwargs['facecolor']\n+        - kwargs['color']\n+        - 'Result of ``self._get_patches_for_fill.get_next_color``\n+\n+        Argument precedence for edgecolors:\n+\n+        - kwargs['edgecolor']\n+        - None\n+\n+        Parameters\n+        ----------\n+        self : Axes\n+\n+        kwargs : dict\n+            Additional kwargs. If these keys exist, we pop and process them:\n+            'facecolor', 'edgecolor', 'color'\n+            Note: The dict is modified by this function.\n+\n+\n+        Returns\n+        -------\n+        facecolor\n+            The facecolor. One or more colors as (N, 4) rgba array.\n+        edgecolor\n+            The edgecolor. Not normalized; may be any valid color spec or None.\n+        \"\"\"\n+        color = kwargs.pop('color', None)\n+\n+        facecolor = kwargs.pop('facecolor', color)\n+        edgecolor = kwargs.pop('edgecolor', None)\n+\n+        facecolor = (facecolor if facecolor is not None\n+                     else self._get_patches_for_fill.get_next_color())\n+\n+        try:\n+            facecolor = mcolors.to_rgba_array(facecolor)\n+        except ValueError as err:\n+            raise ValueError(\n+                \"'facecolor' or 'color' argument must be a valid color or\"\n+                    \"sequence of colors.\"\n+            ) from err\n+\n+        return facecolor, edgecolor\n+\n     @_preprocess_data()\n     @_docstring.interpd\n     def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n@@ -2376,7 +2426,12 @@ def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n         Other Parameters\n         ----------------\n         color : :mpltype:`color` or list of :mpltype:`color`, optional\n+            The colors of the bar faces. This is an alias for *facecolor*.\n+            If both are given, *facecolor* takes precedence.\n+\n+        facecolor : :mpltype:`color` or list of :mpltype:`color`, optional\n             The colors of the bar faces.\n+            If both *color* and *facecolor are given, *facecolor* takes precedence.\n \n         edgecolor : :mpltype:`color` or list of :mpltype:`color`, optional\n             The colors of the bar edges.\n@@ -2441,10 +2496,8 @@ def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n         bar. See :doc:`/gallery/lines_bars_and_markers/bar_stacked`.\n         \"\"\"\n         kwargs = cbook.normalize_kwargs(kwargs, mpatches.Patch)\n-        color = kwargs.pop('color', None)\n-        if color is None:\n-            color = self._get_patches_for_fill.get_next_color()\n-        edgecolor = kwargs.pop('edgecolor', None)\n+        facecolor, edgecolor = self._parse_bar_color_args(kwargs)\n+\n         linewidth = kwargs.pop('linewidth', None)\n         hatch = kwargs.pop('hatch', None)\n \n@@ -2540,9 +2593,9 @@ def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n \n         linewidth = itertools.cycle(np.atleast_1d(linewidth))\n         hatch = itertools.cycle(np.atleast_1d(hatch))\n-        color = itertools.chain(itertools.cycle(mcolors.to_rgba_array(color)),\n-                                # Fallback if color == \"none\".\n-                                itertools.repeat('none'))\n+        facecolor = itertools.chain(itertools.cycle(facecolor),\n+                                    # Fallback if color == \"none\".\n+                                    itertools.repeat('none'))\n         if edgecolor is None:\n             edgecolor = itertools.repeat(None)\n         else:\n@@ -2576,7 +2629,7 @@ def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n             bottom = y\n \n         patches = []\n-        args = zip(left, bottom, width, height, color, edgecolor, linewidth,\n+        args = zip(left, bottom, width, height, facecolor, edgecolor, linewidth,\n                    hatch, patch_labels)\n         for l, b, w, h, c, e, lw, htch, lbl in args:\n             r = mpatches.Rectangle(\n"}, "usage": {"cost($)": "0", "prompt_tokens": 67040, "completion_tokens": 695}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\