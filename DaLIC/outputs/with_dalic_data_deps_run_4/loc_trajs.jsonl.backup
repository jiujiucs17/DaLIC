ult:\nFound file `pandas/core/strings/accessor.py`.\nSource: Exact match found for entity name `pandas/core/strings/accessor.py`.\n```\n   1 | from __future__ import annotations\n   2 | \n   3 | import codecs\n   4 | from functools import wraps\n   5 | import re\n   6 | from typing import (\n   7 |     TYPE_CHECKING,\n   8 |     Literal,\n   9 |     cast,\n  10 | )\n  11 | import warnings\n  12 | \n  13 | import numpy as np\n  14 | \n  15 | from pandas._libs import lib\n  16 | from pandas._typing import (\n  17 |     AlignJoin,\n  18 |     DtypeObj,\n  19 |     F,\n  20 |     Scalar,\n  21 |     npt,\n  22 | )\n  23 | from pandas.util._decorators import Appender\n  24 | from pandas.util._exceptions import find_stack_level\n  25 | \n  26 | from pandas.core.dtypes.common import (\n  27 |     ensure_object,\n  28 |     is_bool_dtype,\n  29 |     is_extension_array_dtype,\n  30 |     is_integer,\n  31 |     is_list_like,\n  32 |     is_object_dtype,\n  33 |     is_re,\n  34 | )\n  35 | from pandas.core.dtypes.dtypes import (\n  36 |     ArrowDtype,\n  37 |     CategoricalDtype,\n  38 | )\n  39 | from pandas.core.dtypes.generic import (\n  40 |     ABCDataFrame,\n  41 |     ABCIndex,\n  42 |     ABCMultiIndex,\n  43 |     ABCSeries,\n  44 | )\n  45 | from pandas.core.dtypes.missing import isna\n  46 | \n  47 | from pandas.core.arrays import ExtensionArray\n  48 | from pandas.core.base import NoNewAttributesMixin\n  49 | from pandas.core.construction import extract_array\n  50 | \n  51 | if TYPE_CHECKING:\n  52 |     from collections.abc import (\n  53 |         Callable,\n  54 |         Hashable,\n  55 |         Iterator,\n  56 |     )\n  57 | \n  58 |     from pandas._typing import NpDtype\n  59 | \n  60 |     from pandas import (\n  61 |         DataFrame,\n  62 |         Index,\n  63 |         Series,\n  64 |     )\n  65 | \n  66 | _shared_docs: dict[str, str] = {}\n  67 | _cpython_optimized_encoders = (\n  68 |     \"utf-8\",\n  69 |     \"utf8\",\n  70 |     \"latin