e=None, estimator_name=None, input_name=\"\"\n 90 | ):\n 91 |     \"\"\"Like assert_all_finite, but only for ndarray.\"\"\"\n 92 | \n 93 |     xp, is_array_api = get_namespace(X)\n 94 | \n 95 |     if _get_config()[\"assume_finite\"]:\n 96 |         return\n 97 | \n 98 |     X = xp.asarray(X)\n 99 | \n100 |     # for object dtype data, we only check for NaNs (GH-13254)\n101 |     if not is_array_api and X.dtype == np.dtype(\"object\") and not allow_nan:\n102 |         if _object_dtype_isnan(X).any():\n103 |             raise ValueError(\"Input contains NaN\")\n104 | \n105 |     # We need only consider float arrays, hence can early return for all else.\n106 |     if not xp.isdtype(X.dtype, (\"real floating\", \"complex floating\")):\n107 |         return\n108 | \n109 |     # First try an O(n) time, O(1) space solution for the common case that\n110 |     # everything is finite; fall back to O(n) space `np.isinf/isnan` or custom\n111 |     # Cython implementation to prevent false positives and provide a detailed\n112 |     # error message.\n113 |     with np.errstate(over=\"ignore\"):\n114 |         first_pass_isfinite = xp.isfinite(xp.sum(X))\n115 |     if first_pass_isfinite:\n116 |         return\n117 | \n118 |     _assert_all_finite_element_wise(\n119 |         X,\n120 |         xp=xp,\n121 |         allow_nan=allow_nan,\n122 |         msg_dtype=msg_dtype,\n123 |         estimator_name=estimator_name,\n124 |         input_name=input_name,\n125 |     )\n```\n\nFound function `sklearn/utils/validation.py:_assert_all_finite_element_wise`.\nSource: Retrieved entity using keyword search (bm25).\n```\n128 | def _assert_all_finite_element_wise(\n129 |     X, *, xp, allow_nan, msg_dtype=None, estimator_name=None, input_name=\"\"\n130 | ):\n131 |     # Cython implementation doesn't support FP16 or complex numbers\n132 |     use_cython = (\n133 |         xp is np and X.data.contiguous and X.dtype.type in {np.float32, np.float64}\n134 |     )\n135 |     if use_cython:\n136 | 