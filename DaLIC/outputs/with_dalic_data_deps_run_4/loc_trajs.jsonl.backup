  (x,)\n 170 | \n 171 |     >>> cot(x).args[0]\n 172 |     x\n 173 | \n 174 |     >>> (x*y).args\n 175 |     (x, y)\n 176 | \n 177 |     >>> (x*y).args[1]\n 178 |     y\n 179 | \n 180 | \n 181 |     2) Never use internal methods or variables (the ones prefixed with ``_``):\n 182 | \n 183 |     >>> cot(x)._args    # do not use this, use cot(x).args instead\n 184 |     (x,)\n 185 | \n 186 | \n 187 |     3)  By \"SymPy object\" we mean something that can be returned by\n 188 |         ``sympify``.  But not all objects one encounters using SymPy are\n 189 |         subclasses of Basic.  For example, mutable objects are not:\n 190 | \n 191 |         >>> from sympy import Basic, Matrix, sympify\n 192 |         >>> A = Matrix([[1, 2], [3, 4]]).as_mutable()\n 193 |         >>> isinstance(A, Basic)\n 194 |         False\n 195 | \n 196 |         >>> B = sympify(A)\n 197 |         >>> isinstance(B, Basic)\n 198 |         True\n 199 |     \"\"\"\n 200 |     __slots__ = ('_mhash',              # hash value\n 201 |                  '_args',               # arguments\n 202 |                  '_assumptions'\n 203 |                 )\n 204 | \n 205 |     _args: tuple[Basic, ...]\n 206 |     _mhash: int | None\n 207 | \n 208 |     @property\n 209 |     def __sympy__(self):\n 210 |         return True\n 211 | \n 212 |     def __init_subclass__(cls):\n 213 |         # Initialize the default_assumptions FactKB and also any assumptions\n 214 |         # property methods. This method will only be called for subclasses of\n 215 |         # Basic but not for Basic itself so we call\n 216 |         # _prepare_class_assumptions(Basic) below the class definition.\n 217 |         super().__init_subclass__()\n 218 |         _prepare_class_assumptions(cls)\n 219 | \n 220 |     # To be overridden with True in the appropriate subclasses\n 221 |     is_number = False\n 222 |     is_Atom = False\n 223 |     is_Symbol = False\n 224 |     is_symbol = False\n 225 |     is_Indexed = False\n 226 |     is_Dummy = False\n 227 |     is_Wild = False\n 228 |     is_Function = False\n 229 |     is_Add = False\n 230 |     is_Mul = False\n 231 |     is_Pow = False\n 232 |     is_Number = False\n 233 |     is_Float = False\n 234 |     is_Rational = False\n 235 |     is_Integer = False\n 236 |     is_NumberSymbol = False\n 237 |     is_Order = False\n 238 |     is_Derivative = False\n 239 |     is_Piecewise = False\n 240 |     is_Poly = False\n 241 |     is_AlgebraicNumber = False\n 242 |     is_Relational = False\n 243 |     is_Equality = False\n 244 |     is_Boolean = False\n 245 |     is_Not = False\n 246 |     is_Matrix = False\n 247 |     is_Vector = False\n 248 |     is_Point = False\n 249 |     is_MatAdd = False\n 250 |     is_MatMul = False\n 251 | \n 252 |     default_assumptions: ClassVar[StdFactKB]\n 253 | \n 254 |     is_composite: bool | None\n 255 |     is_noninteger: bool | None\n 256 |     is_extended_positive: bool | None\n 257 |     is_negative: bool | None\n 258 |     is_complex: bool | None\n 259 |     is_extended_nonpositive: bool | None\n 260 |     is_integer: bool | None\n 261 |     is_positive: bool | None\n 262 |     is_rational: bool | None\n 263 |     is_extended_nonnegative: bool | None\n 264 |     is_infinite: bool | None\n 265 |     is_antihermitian: bool | None\n 266 |     is_extended_negative: bool | None\n 267 |     is_extended_real: bool | None\n 268 |     is_finite: bool | None\n 269 |     is_polar: bool | None\n 270 |     is_imaginary: bool | None\n 271 |     is_transcendental: bool | None\n 272 |     is_extended_nonzero: bool | None\n 273 |     is_nonzero: bool | None\n 274 |     is_odd: bool | None\n 275 |     is_algebraic: bool | None\n 276 |     is_prime: bool | None\n 277 |     is_commutative: bool | None\n 278 |     is_nonnegative: bool | None\n 279 |     is_nonpositive: bool | None\n 280 |     is_hermitian: bool | None\n 281 |     is_irrational: bool | None\n 282 |     is_real: bool | None\n 283 |     is_zero: bool | None\n 284 |     is_even: bool | None\n 285 | \n 286 |     kind: Kind = UndefinedKind\n 287 | \n 288 |     def __new__(cls, *args):\n 289 |         obj = object.__new__(cls)\n 290 |         obj._assumptions = cls.default_assumptions\n 291 |         obj._mhash = None  # will be set by __hash__ method.\n 292 | \n 293 |         obj._args = args  # all items in args must be Basic objects\n 294 |         return obj\n 295 | \n 296 |     def copy(self):\n 297 |         return self.func(*self.args)\n 298 | \n 299 |     def __getnewargs__(self):\n 300 |         return self.args\n 301 | \n 302 |     def __getstate__(self):\n 303 |         return None\n 304 | \n 305 |     def __setstate__(self, state):\n 306 |         for name, value in state.items():\n 307 |             setattr(self, name, value)\n 308 | \n 309 |     def __reduce_ex__(self, protocol):\n 310 |         if protocol < 2:\n 311 |             msg = \"Only pickle protocol 2 or higher is supported by SymPy\"\n 312 |             raise NotImplementedError(msg)\n 313 |         return super().__reduce_ex__(protocol)\n 314 | \n 315 |     def __hash__(self) -> int:\n 316 |         # hash cannot be cached using cache_it because infinite recurrence\n 317 |         # occurs as hash is needed for setting cache dictionary keys\n 318 |         h = self._mhash\n 319 |         if h is None:\n 320 |             h = hash((type(self).__name__,) + self._hashable_content())\n 321 |             self._mhash = h\n 322 |         return h\n 323 | \n 324 |     def _hashable_content(self):\n 325 |         \"\"\"Return a tuple of information about self that can be used to\n 326 |         compute the hash. If a class defines additional attributes,\n 327 |         like ``name`` in Symbol, then this method should be updated\n 328 |         accordingly to return such relevant attributes.\n 329 | \n 330 |         Defining more than _hashable_content is necessary if __eq__ has\n 331 |         been defined by a class. See note about this in Basic.__eq__.\"\"\"\n 332 |         return self._args\n 333 | \n 334 |     @property\n 335 |     def assumptions0(self):\n 336 |         \"\"\"\n 337 |         Return object `type` assumptions.\n 338 | \n 339 |         For example:\n 340 | \n 341 |           Symbol('x', real=True)\n 342 |           Symbol('x', integer=True)\n 343 | \n 344 |         are different objects. In other words, besides Python type (Symbol in\n 345 |         this case), the initial assumptions are also forming their typeinfo.\n 346 | \n 347 |         Examples\n 348 |         ========\n 349 | \n 350 |         >>> from sympy import Symbol\n 351 |         >>> from sympy.abc import x\n 352 |         >>> x.assumptions0\n 353 |         {'commutative': True}\n 354 |         >>> x = Symbol(\"x\", positive=True)\n 355 |         >>> x.assumptions0\n 356 |         {'commutative': True, 'complex': True, 'extended_negative': False,\n 357 |          'extended_nonnegative': True, 'extended_nonpositive': False,\n 358 |          'extended_nonzero': True, 'extended_positive': True, 'extended_real':\n 359 |          True, 'finite': True, 'hermitian': True, 'imaginary': False,\n 360 |          'infinite': False, 'negative': False, 'nonnegative': True,\n 361 |          'nonpositive': False, 'nonzero': True, 'positive': True, 'real':\n 362 |          True, 'zero': False}\n 363 |         \"\"\"\n 364 |         return {}\n 365 | \n 366 |     def compare(self, other):\n 367 |         \"\"\"\n 368 |         Return -1, 0, 1 if the object is less than, equal,\n 369 |         or greater than other in a canonical sense.\n 370 |         Non-Basic are always greater than Basic.\n 371 |         If both names of the classes being compared appear\n 372 |         in the `ordering_of_classes` then the ordering will\n 373 |         depend on the appearance of the names there.\n 374 |         If either does not appear in that list, then the\n 375 |         comparison is based on the class name.\n 376 |         If the names are the same then a comparison is made\n 377 |         on the length of the hashable content.\n 378 |         Items of the equal-lengthed contents are then\n 379 |         successively compared using the same rules. If there\n 380 |         is never a difference then 0 is returned.\n 381 | \n 382 |         Examples\n 383 |         ========\n 384 | \n 385 |         >>> from sympy.abc import x, y\n 386 |         >>> x.compare(y)\n 387 |         -1\n 388 |         >>> x.compare(x)\n 389 |         0\n 390 |         >>> y.compare(x)\n 391 |         1\n 392 | \n 393 |         \"\"\"\n 394 |         # all redefinitions of __cmp__ method should start with the\n 395 |         # following lines:\n 396 |         if self is other:\n 397 |             return 0\n 398 |         n1 = self.__class__\n 399 |         n2 = other.__class__\n 400 |         c = _cmp_name(n1, n2)\n 401 |         if c:\n 402 |             return c\n 403 |         #\n 404 |         st = self._hashable_content()\n 405 |         ot = other._hashable_content()\n 406 |         len_st = len(st)\n 407 |         len_ot = len(ot)\n 408 |         c = (len_st > len_ot) - (len_st < len_ot)\n 409 |         if c:\n 410 |             return c\n 411 |         for l, r in zip(st, ot):\n 412 |             if isinstance(l, Basic):\n 413 |                 c = l.compare(r)\n 414 |             elif isinstance(l, frozenset):\n 415 |                 l = Basic(*l) if isinstance(l, frozenset) else l\n 416 |                 r = Basic(*r) if isinstance(r, frozenset) else r\n 417 |                 c = l.compare(r)\n 418 |             else:\n 419 |                 c = (l > r) - (l < r)\n 420 |             if c:\n 421 |                 return c\n 422 |         return 0\n 423 | \n 424 |     @classmethod\n 425 |     def fromiter(cls, args, **assumptions):\n 426 |         \"\"\"\n 427 |         Create a new object from an iterable.\n 428 | \n 429 |         This is a convenience function that allows one to create objects from\n 430 |         any iterable, without having to convert to a list or tuple first.\n 431 | \n 432 |         Examples\n 433 |         ========\n 434 | \n 435 |         >>> from sympy import Tuple\n 436 |         >>> Tuple.fromiter(i for i in range(5))\n 437 |         (0, 1, 2, 3, 4)\n 438 | \n 439 |         \"\"\"\n 440 |         return cls(*tuple(args), **assumptions)\n 441 | \n 442 |     @classmethod\n 443 |     def class_key(cls) -> tuple[int, int, str]:\n 444 |         \"\"\"Nice order of classes.\"\"\"\n 445 |         return 5, 0, cls.__name__\n 446 | \n 447 |     @cacheit\n 448 |     def sort_key(self, order=None):\n 449 |         \"\"\"\n 450 |         Return a sort key.\n 451 | \n 452 |         Examples\n 453 |         ========\n 454 | \n 455 |         >>> from sympy import S, I\n 456 | \n 457 |         >>> sorted([S(1)/2, I, -I], key=lambda x: x.sort_key())\n 458 |         [1/2, -I, I]\n 459 | \n 460 |         >>> S(\"[x, 1/x, 1/x**2, x**2, x**(1/2), x**(1/4), x**(3/2)]\")\n 461 |         [x, 1/x, x**(-2), x**2, sqrt(x), x**(1/4), x**(3/2)]\n 462 |         >>> sorted(_, key=lambda x: x.sort_key())\n 463 |         [x**(-2), 1/x, x**(1/4), sqrt(x), x, x**(3/2), x**2]\n 464 | \n 465 |         \"\"\"\n 466 | \n 467 |         # XXX: remove this when issue 5169 is fixed\n 468 |         def inner_key(arg):\n 469 |             if isinstance(arg, Basic):\n 470 |                 return arg.sort_key(order)\n 471 |             else:\n 472 |                 return arg\n 473 | \n 474 |         args = self._sorted_args\n 475 |         args = len(args), tuple([inner_key(arg) for arg in args])\n 476 |         return self.class_key(), args, S.One.sort_key(), S.One\n 477 | \n 478 |     def _do_eq_sympify(self, other):\n 479 |         \"\"\"Returns a boolean indicating whether a == b when either a\n 480 |         or b is not a Basic. This is only done for types that were either\n 481 |         added to `converter` by a 3rd party or when the object has `_sympy_`\n 482 |         defined. This essentially reuses the code in `_sympify` that is\n 483 |         specific for this use case. Non-user defined types that are meant\n 484 |         to work with SymPy should be handled directly in the __eq__ methods\n 485 |         of the `Basic` classes it could equate to and not be converted. Note\n 486 |         that after conversion, `==`  is used again since it is not\n 487 |         necessarily clear whether `self` or `other`'s __eq__ method needs\n 488 |         to be used.\"\"\"\n 489 |         for superclass in type(other).__mro__:\n 490 |             conv = _external_converter.get(superclass)\n 491 |             if conv is not None:\n 492 |                 return self == conv(other)\n 493 |         if hasattr(other, '_sympy_'):\n 494 |             return self == other._sympy_()\n 495 |         return NotImplemented\n 496 | \n 497 |     def __eq__(self, other):\n 498 |         \"\"\"Return a boolean indicating whether a == b on the basis of\n 499 |         their symbolic trees.\n 500 | \n 501 |         This is the same as a.compare(b) == 0 but faster.\n 502 | \n 503 |         Notes\n 504 |         =====\n 505 | \n 506 |         If a class that overrides __eq__() needs to retain the\n 507 |         implementation of __hash__() from a parent class, the\n 508 |         interpreter must be told this explicitly by setting\n 509 |         __hash__ : Callable[[object], int] = <ParentClass>.__hash__.\n 510 |         Otherwise the inheritance of __hash__() will be blocked,\n 511 |         just as if __hash__ had been explicitly set to None.\n 512 | \n 513 |         References\n 514 |         ==========\n 515 | \n 516 |         from https://docs.python.org/dev/reference/datamodel.html#object.__hash__\n 517 |         \"\"\"\n 518 |         if self is other:\n 519 |             return True\n 520 | \n 521 |         if not isinstance(other, Basic):\n 522 |             return self._do_eq_sympify(other)\n 523 | \n 524 |         # check for pure number expr\n 525 |         if  not (self.is_Number and other.is_Number) and (\n 526 |                 type(self) != type(other)):\n 527 |             return False\n 528 |         a, b = self._hashable_content(), other._hashable_content()\n 529 |         if a != b:\n 530 |             return False\n 531 |         # check number *in* an expression\n 532 |         for a, b in zip(a, b):\n 533 |             if not isinstance(a, Basic):\n 534 |                 continue\n 535 |             if a.is_Number and type(a) != type(b):\n 536 |                 return False\n 537 |         return True\n 538 | \n 539 |     def __ne__(self, other):\n 540 |         \"\"\"``a != b``  -> Compare two symbolic trees and see whether they are different\n 541 | \n 542 |         this is the same as:\n 543 | \n 544 |         ``a.compare(b) != 0``\n 545 | \n 546 |         but faster\n 547 |         \"\"\"\n 548 |         return not self == other\n 549 | \n 550 |     def dummy_eq(self, other, symbol=None):\n 551 |         \"\"\"\n 552 |         Compare two expressions and handle dummy symbols.\n 553 | \n 554 |         Examples\n 555 |         ========\n 556 | \n 557 |         >>> from sympy import Dummy\n 558 |         >>> from sympy.abc import x, y\n 559 | \n 560 |         >>> u = Dummy('u')\n 561 | \n 562 |         >>> (u**2 + 1).dummy_eq(x**2 + 1)\n 563 |         True\n 564 |         >>> (u**2 + 1) == (x**2 + 1)\n 565 |         False\n 566 | \n 567 |         >>> (u**2 + y).dummy_eq(x**2 + y, x)\n 568 |         True\n 569 |         >>> (u**2 + y).dummy_eq(x**2 + y, y)\n 570 |         False\n 571 | \n 572 |         \"\"\"\n 573 |         s = self.as_dummy()\n 574 |         o = _sympify(other)\n 575 |         o = o.as_dummy()\n 576 | \n 577 |         dummy_symbols = [i for i in s.free_symbols if i.is_Dummy]\n 578 | \n 579 |         if len(dummy_symbols) == 1:\n 580 |             dummy = dummy_symbols.pop()\n 581 |         else:\n 582 |             return s == o\n 583 | \n 584 |         if symbol is None:\n 585 |             symbols = o.free_symbols\n 586 | \n 587 |             if len(symbols) == 1:\n 588 |                 symbol = symbols.pop()\n 589 |             else:\n 590 |                 return s == o\n 591 | \n 592 |         tmp = dummy.__class__()\n 593 | \n 594 |         return s.xreplace({dummy: tmp}) == o.xreplace({symbol: tmp})\n 595 | \n 596 |     @overload\n 597 |     def atoms(self) -> set[Basic]: ...\n 598 |     @overload\n 599 |     def atoms(self, *types: Tbasic | type[Tbasic]) -> set[Tbasic]: ...\n 600 | \n 601 |     def atoms(self, *types: Tbasic | type[Tbasic]) -> set[Basic] | set[Tbasic]:\n 602 |         \"\"\"Returns the atoms that form the current object.\n 603 | \n 604 |         By default, only objects that are truly atomic and cannot\n 605 |         be divided into smaller pieces are returned: symbols, numbers,\n 606 |         and number symbols like I and pi. It is possible to request\n 607 |         atoms of any type, however, as demonstrated below.\n 608 | \n 609 |         Examples\n 610 |         ========\n 611 | \n 612 |         >>> from sympy import I, pi, sin\n 613 |         >>> from sympy.abc import x, y\n 614 |         >>> (1 + x + 2*sin(y + I*pi)).atoms()\n 615 |         {1, 2, I, pi, x, y}\n 616 | \n 617 |         If one or more types are given, the results will contain only\n 618 |         those types of atoms.\n 619 | \n 620 |         >>> from sympy import Number, NumberSymbol, Symbol\n 621 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Symbol)\n 622 |         {x, y}\n 623 | \n 624 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number)\n 625 |         {1, 2}\n 626 | \n 627 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number, NumberSymbol)\n 628 |         {1, 2, pi}\n 629 | \n 630 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Number, NumberSymbol, I)\n 631 |         {1, 2, I, pi}\n 632 | \n 633 |         Note that I (imaginary unit) and zoo (complex infinity) are special\n 634 |         types of number symbols and are not part of the NumberSymbol class.\n 635 | \n 636 |         The type can be given implicitly, too:\n 637 | \n 638 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(x) # x is a Symbol\n 639 |         {x, y}\n 640 | \n 641 |         Be careful to check your assumptions when using the implicit option\n 642 |         since ``S(1).is_Integer = True`` but ``type(S(1))`` is ``One``, a special type\n 643 |         of SymPy atom, while ``type(S(2))`` is type ``Integer`` and will find all\n 644 |         integers in an expression:\n 645 | \n 646 |         >>> from sympy import S\n 647 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(S(1))\n 648 |         {1}\n 649 | \n 650 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(S(2))\n 651 |         {1, 2}\n 652 | \n 653 |         Finally, arguments to atoms() can select more than atomic atoms: any\n 654 |         SymPy type (loaded in core/__init__.py) can be listed as an argument\n 655 |         and those types of \"atoms\" as found in scanning the arguments of the\n 656 |         expression recursively:\n 657 | \n 658 |         >>> from sympy import Function, Mul\n 659 |         >>> from sympy.core.function import AppliedUndef\n 660 |         >>> f = Function('f')\n 661 |         >>> (1 + f(x) + 2*sin(y + I*pi)).atoms(Function)\n 662 |         {f(x), sin(y + I*pi)}\n 663 |         >>> (1 + f(x) + 2*sin(y + I*pi)).atoms(AppliedUndef)\n 664 |         {f(x)}\n 665 | \n 666 |         >>> (1 + x + 2*sin(y + I*pi)).atoms(Mul)\n 667 |         {I*pi, 2*sin(y + I*pi)}\n 668 | \n 669 |         \"\"\"\n 670 |         nodes = _preorder_traversal(self)\n 671 |         if types:\n 672 |             types2 = tuple([t if isinstance(t, type) else type(t) for t in types])\n 673 |             return {node for node in nodes if isinstance(node, types2)}\n 674 |         else:\n 675 |             return {node for node in nodes if not node.args}\n 676 | \n 677 |     @property\n 678 |     def free_symbols(self) -> set[Basic]:\n 679 |         \"\"\"Return from the atoms of self those which are free symbols.\n 680 | \n 681 |         Not all free symbols are ``Symbol`` (see examples)\n 682 | \n 683 |         For most expressions, all symbols are free symbols. For some classes\n 684 |         this is not true. e.g. Integrals use Symbols for the dummy variables\n 685 |         which are bound variables, so Integral has a method to return all\n 686 |         symbols except those. Derivative keeps track of symbols with respect\n 687 |         to which it will perform a derivative; those are\n 688 |         bound variables, too, so it has its own free_symbols method.\n 689 | \n 690 |         Any other method that uses bound variables should implement a\n 691 |         free_symbols method.\n 692 | \n 693 |         Examples\n 694 |         ========\n 695 | \n 696 |         >>> from sympy import Derivative, Integral, IndexedBase\n 697 |         >>> from sympy.abc import x, y, n\n 698 |         >>> (x + 1).free_symbols\n 699 |         {x}\n 700 |         >>> Integral(x, y).free_symbols\n 701 |         {x, y}\n 702 | \n 703 |         Not all free symbols are actually symbols:\n 704 | \n 705 |         >>> IndexedBase('F')[0].free_symbols\n 706 |         {F, F[0]}\n 707 | \n 708 |         The symbols of differentiation are not included unless they\n 709 |         appear in the expression being differentiated.\n 710 | \n 711 |         >>> Derivative(x + y, y).free_symbols\n 712 |         {x, y}\n 713 |         >>> Derivative(x, y).free_symbols\n 714 |         {x}\n 715 |         >>> Derivative(x, (y, n)).free_symbols\n 716 |         {n, x}\n 717 | \n 718 |         If you want to know if a symbol is in the variables of the\n 719 |         Derivative you can do so as follows:\n 720 | \n 721 |         >>> Derivative(x, y).has_free(y)\n 722 |         True\n 723 |         \"\"\"\n 724 |         empty: set[Basic] = set()\n 725 |         return empty.union(*(a.free_symbols for a in self.args))\n 726 | \n 727 |     @property\n 728 |     def expr_free_symbols(self):\n 729 |         sympy_deprecation_warning(\"\"\"\n 730 |         The expr_free_symbols property is deprecated. Use free_symbols to get\n 731 |         the free symbols of an expression.\n 732 |         \"\"\",\n 733 |             deprecated_since_version=\"1.9\",\n 734 |             active_deprecations_target=\"deprecated-expr-free-symbols\")\n 735 |         return set()\n 736 | \n 737 |     def as_dummy(self) -> \"Self\":\n 738 |         \"\"\"Return the expression with any objects having structurally\n 739 |         bound symbols replaced with unique, canonical symbols within\n 740 |         the object in which they appear and having only the default\n 741 |         assumption for commutativity being True. When applied to a\n 742 |         symbol a new symbol having only the same commutativity will be\n 743 |         returned.\n 744 | \n 745 |         Examples\n 746 |         ========\n 747 | \n 748 |         >>> from sympy import Integral, Symbol\n 749 |         >>> from sympy.abc import x\n 750 |         >>> r = Symbol('r', real=True)\n 751 |         >>> Integral(r, (r, x)).as_dummy()\n 752 |         Integral(_0, (_0, x))\n 753 |         >>> _.variables[0].is_real is None\n 754 |         True\n 755 |         >>> r.as_dummy()\n 756 |         _r\n 757 | \n 758 |         Notes\n 759 |         =====\n 760 | \n 761 |         Any object that has structurally bound variables should have\n 762 |         a property, ``bound_symbols`` that returns those symbols\n 763 |         appearing in the object.\n 764 |         \"\"\"\n 765 |         from .symbol import Dummy, Symbol\n 766 |         def can(x):\n 767 |             # mask free that shadow bound\n 768 |             free = x.free_symbols\n 769 |             bound = set(x.bound_symbols)\n 770 |             d = {i: Dummy() for i in bound & free}\n 771 |             x = x.subs(d)\n 772 |             # replace bound with canonical names\n 773 |             x = x.xreplace(x.canonical_variables)\n 774 |             # return after undoing masking\n 775 |             return x.xreplace({v: k for k, v in d.items()})\n 776 |         if not self.has(Symbol):\n 777 |             return self\n 778 |         return self.replace(\n 779 |             lambda x: hasattr(x, 'bound_symbols'),\n 780 |             can,\n 781 |             simultaneous=False) # type:ignore\n 782 | \n 783 |     @property\n 784 |     def canonical_variables(self) -> dict[Basic, Symbol]:\n 785 |         \"\"\"Return a dictionary mapping any variable defined in\n 786 |         ``self.bound_symbols`` to Symbols that do not clash\n 787 |         with any free symbols in the expression.\n 788 | \n 789 |         Examples\n 790 |         ========\n 791 | \n 792 |         >>> from sympy import Lambda\n 793 |         >>> from sympy.abc import x\n 794 |         >>> Lambda(x, 2*x).canonical_variables\n 795 |         {x: _0}\n 796 |         \"\"\"\n 797 |         bound: list[Basic] | None = getattr(self, 'bound_symbols', None)\n 798 |         if bound is None:\n 799 |             return {}\n 800 |         dums = numbered_symbols('_')\n 801 |         reps = {}\n 802 |         # watch out for free symbol that are not in bound symbols;\n 803 |         # those that are in bound symbols are about to get changed\n 804 | \n 805 |         # XXX: free_symbols only returns particular kinds of expressions that\n 806 |         # generally have a .name attribute. There is not a proper class/type\n 807 |         # that represents this.\n 808 |         names = {i.name for i in self.free_symbols - set(bound)} # type: ignore\n 809 |         for b in bound:\n 810 |             d = next(dums)\n 811 |             if b.is_Symbol:\n 812 |                 while d.name in names:\n 813 |                     d = next(dums)\n 814 |             reps[b] = d\n 815 |         return reps\n 816 | \n 817 |     def rcall(self, *args):\n 818 |         \"\"\"Apply on the argument recursively through the expression tree.\n 819 | \n 820 |         This method is used to simulate a common abuse of notation for\n 821 |         operators. For instance, in SymPy the following will not work:\n 822 | \n 823 |         ``(x+Lambda(y, 2*y))(z) == x+2*z``,\n 824 | \n 825 |         however, you can use:\n 826 | \n 827 |         >>> from sympy import Lambda\n 828 |         >>> from sympy.abc import x, y, z\n 829 |         >>> (x + Lambda(y, 2*y)).rcall(z)\n 830 |         x + 2*z\n 831 |         \"\"\"\n 832 |         if callable(self):\n 833 |             return self(*args)\n 834 |         elif self.args:\n 835 |             newargs = [sub.rcall(*args) for sub in self.args]\n 836 |             return self.func(*newargs)\n 837 |         else:\n 838 |             return self\n 839 | \n 840 |     def is_hypergeometric(self, k):\n 841 |         from sympy.simplify.simplify import hypersimp\n 842 |         from sympy.functions.elementary.piecewise import Piecewise\n 843 |         if self.has(Piecewise):\n 844 |             return None\n 845 |         return hypersimp(self, k) is not None\n 846 | \n 847 |     @property\n 848 |     def is_comparable(self):\n 849 |         \"\"\"Return True if self can be computed to a real number\n 850 |         (or already is a real number) with precision, else False.\n 851 | \n 852 |         Examples\n 853 |         ========\n 854 | \n 855 |         >>> from sympy import exp_polar, pi, I\n 856 |         >>> (I*exp_polar(I*pi/2)).is_comparable\n 857 |         True\n 858 |         >>> (I*exp_polar(I*pi*2)).is_comparable\n 859 |         False\n 860 | \n 861 |         A False result does not mean that `self` cannot be rewritten\n 862 |         into a form that would be comparable. For example, the\n 863 |         difference computed below is zero but without simplification\n 864 |         it does not evaluate to a zero with precision:\n 865 | \n 866 |         >>> e = 2**pi*(1 + 2**pi)\n 867 |         >>> dif = e - e.expand()\n 868 |         >>> dif.is_comparable\n 869 |         False\n 870 |         >>> dif.n(2)._prec\n 871 |         1\n 872 | \n 873 |         \"\"\"\n 874 |         return self._eval_is_comparable()\n 875 | \n 876 |     def _eval_is_comparable(self) -> bool:\n 877 |         # Expr.is_comparable overrides this\n 878 |         return False\n 879 | \n 880 |     @property\n 881 |     def func(self):\n 882 |         \"\"\"\n 883 |         The top-level function in an expression.\n 884 | \n 885 |         The following should hold for all objects::\n 886 | \n 887 |             >> x == x.func(*x.args)\n 888 | \n 889 |         Examples\n 890 |         ========\n 891 | \n 892 |         >>> from sympy.abc import x\n 893 |         >>> a = 2*x\n 894 |         >>> a.func\n 895 |         <class 'sympy.core.mul.Mul'>\n 896 |         >>> a.args\n 897 |         (2, x)\n 898 |         >>> a.func(*a.args)\n 899 |         2*x\n 900 |         >>> a == a.func(*a.args)\n 901 |         True\n 902 | \n 903 |         \"\"\"\n 904 |         return self.__class__\n 905 | \n 906 |     @property\n 907 |     def args(self) -> tuple[Basic, ...]:\n 908 |         \"\"\"Returns a tuple of arguments of 'self'.\n 909 | \n 910 |         Examples\n 911 |         ========\n 912 | \n 913 |         >>> from sympy import cot\n 914 |         >>> from sympy.abc import x, y\n 915 | \n 916 |         >>> cot(x).args\n 917 |         (x,)\n 918 | \n 919 |         >>> cot(x).args[0]\n 920 |         x\n 921 | \n 922 |         >>> (x*y).args\n 923 |         (x, y)\n 924 | \n 925 |         >>> (x*y).args[1]\n 926 |         y\n 927 | \n 928 |         Notes\n 929 |         =====\n 930 | \n 931 |         Never use self._args, always use self.args.\n 932 |         Only use _args in __new__ when creating a new function.\n 933 |         Do not override .args() from Basic (so that it is easy to\n 934 |         change the interface in the future if needed).\n 935 |         \"\"\"\n 936 |         return self._args\n 937 | \n 938 |     @property\n 939 |     def _sorted_args(self):\n 940 |         \"\"\"\n 941 |         The same as ``args``.  Derived classes which do not fix an\n 942 |         order on their arguments should override this method to\n 943 |         produce the sorted representation.\n 944 |         \"\"\"\n 945 |         return self.args\n 946 | \n 947 |     def as_content_primitive(self, radical=False, clear=True):\n 948 |         \"\"\"A stub to allow Basic args (like Tuple) to be skipped when computing\n 949 |         the content and primitive components of an expression.\n 950 | \n 951 |         See Also\n 952 |         ========\n 953 | \n 954 |         sympy.core.expr.Expr.as_content_primitive\n 955 |         \"\"\"\n 956 |         return S.One, self\n 957 | \n 958 |     @overload\n 959 |     def subs(self: Expr, arg1: dict[Expr, Expr | int], arg2: None=None) -> Expr: ... # type: ignore\n 960 |     @overload\n 961 |     def subs(self: Expr, arg1: Expr, arg2: Expr | int) -> Expr: ... # type: ignore\n 962 |     @overload\n 963 |     def subs(self: Basic, arg1: dict[Basic, Basic], arg2: None=None) -> Basic: ...\n 964 |     @overload\n 965 |     def subs(self: Basic, arg1: Basic, arg2: Basic) -> Basic: ...\n 966 | \n 967 |     def subs(self, *args, **kwargs):\n 968 |         \"\"\"\n 969 |         Substitutes old for new in an expression after sympifying args.\n 970 | \n 971 |         `args` is either:\n 972 |           - two arguments, e.g. foo.subs(old, new)\n 973 |           - one iterable argument, e.g. foo.subs(iterable). The iterable may be\n 974 |              o an iterable container with (old, new) pairs. In this case the\n 975 |                replacements are processed in the order given with successive\n 976 |                patterns possibly affecting replacements already made.\n 977 |              o a dict or set whose key/value items correspond to old/new pairs.\n 978 |                In this case the old/new pairs will be sorted by op count and in\n 979 |                case of a tie, by number of args and the default_sort_key. The\n 980 |                resulting sorted list is then processed as an iterable container\n 981 |                (see previous).\n 982 | \n 983 |         If the keyword ``simultaneous`` is True, the subexpressions will not be\n 984 |         evaluated until all the substitutions have been made.\n 985 | \n 986 |         Examples\n 987 |         ========\n 988 | \n 989 |         >>> from sympy import pi, exp, limit, oo\n 990 |         >>> from sympy.abc import x, y\n 991 |         >>> (1 + x*y).subs(x, pi)\n 992 |         pi*y + 1\n 993 |         >>> (1 + x*y).subs({x:pi, y:2})\n 994 |         1 + 2*pi\n 995 |         >>> (1 + x*y).subs([(x, pi), (y, 2)])\n 996 |         1 + 2*pi\n 997 |         >>> reps = [(y, x**2), (x, 2)]\n 998 |         >>> (x + y).subs(reps)\n 999 |         6\n1000 |         >>> (x + y).subs(reversed(reps))\n1001 |         x**2 + 2\n1002 | \n1003 |         >>> (x**2 + x**4).subs(x**2, y)\n1004 |         y**2 + y\n1005 | \n1006 |         To replace only the x**2 but not the x**4, use xreplace:\n1007 | \n1008 |         >>> (x**2 + x**4).xreplace({x**2: y})\n1009 |         x**4 + y\n1010 | \n1011 |         To delay evaluation until all substitutions have been made,\n1012 |         set the keyword ``simultaneous`` to True:\n1013 | \n1014 |         >>> (x/y).subs([(x, 0), (y, 0)])\n1015 |         0\n1016 |         >>> (x/y).subs([(x, 0), (y, 0)], simultaneous=True)\n1017 |         nan\n1018 | \n1019 |         This has the added feature of not allowing subsequent substitutions\n1020 |         to affect those already made:\n1021 | \n1022 |         >>> ((x + y)/y).subs({x + y: y, y: x + y})\n1023 |         1\n1024 |         >>> ((x + y)/y).subs({x + y: y, y: x + y}, simultaneous=True)\n1025 |         y/(x + y)\n1026 | \n1027 |         In order to obtain a canonical result, unordered iterables are\n1028 |         sorted by count_op length, number of arguments and by the\n1029 |         default_sort_key to break any ties. All other iterables are left\n1030 |         unsorted.\n1031 | \n1032 |         >>> from sympy import sqrt, sin, cos\n1033 |         >>> from sympy.abc import a, b, c, d, e\n1034 | \n1035 |         >>> A = (sqrt(sin(2*x)), a)\n1036 |         >>> B = (sin(2*x), b)\n1037 |         >>> C = (cos(2*x), c)\n1038 |         >>> D = (x, d)\n1039 |         >>> E = (exp(x), e)\n1040 | \n1041 |         >>> expr = sqrt(sin(2*x))*sin(exp(x)*x)*cos(2*x) + sin(2*x)\n1042 | \n1043 |         >>> expr.subs(dict([A, B, C, D, E]))\n1044 |         a*c*sin(d*e) + b\n1045 | \n1046 |         The resulting expression represents a literal replacement of the\n1047 |         old arguments with the new arguments. This may not reflect the\n1048 |         limiting behavior of the expression:\n1049 | \n1050 |         >>> (x**3 - 3*x).subs({x: oo})\n1051 |         nan\n1052 | \n1053 |         >>> limit(x**3 - 3*x, x, oo)\n1054 |         oo\n1055 | \n1056 |         If the substitution will be followed by numerical\n1057 |         evaluation, it is better to pass the substitution to\n1058 |         evalf as\n1059 | \n1060 |         >>> (1/x).evalf(subs={x: 3.0}, n=21)\n1061 |         0.333333333333333333333\n1062 | \n1063 |         rather than\n1064 | \n1065 |         >>> (1/x).subs({x: 3.0}).evalf(21)\n1066 |         0.333333333333333314830\n1067 | \n1068 |         as the former will ensure that the desired level of precision is\n1069 |         obtained.\n1070 | \n1071 |         See Also\n1072 |         ========\n1073 |         replace: replacement capable of doing wildcard-like matching,\n1074 |                  parsing of match, and conditional replacements\n1075 |         xreplace: exact node replacement in expr tree; also capable of\n1076 |                   using matching rules\n1077 |         sympy.core.evalf.EvalfMixin.evalf: calculates the given formula to a desired level of precision\n1078 | \n1079 |         \"\"\"\n1080 |         from .containers import Dict\n1081 |         from .symbol import Dummy, Symbol\n1082 |         from .numbers import _illegal\n1083 | \n1084 |         unordered = False\n1085 |         if len(args) == 1:\n1086 | \n1087 |             sequence = args[0]\n1088 |             if isinstance(sequence, set):\n1089 |                 unordered = True\n1090 |             elif isinstance(sequence, (Dict, Mapping)):\n1091 |                 unordered = True\n1092 |                 sequence = sequence.items()\n1093 |             elif not iterable(sequence):\n1094 |                 raise ValueError(filldedent(\"\"\"\n1095 |                    When a single argument is passed to subs\n1096 |                    it should be a dictionary of old: new pairs or an iterable\n1097 |                    of (old, new) tuples.\"\"\"))\n1098 |         elif len(args) == 2:\n1099 |             sequence = [args]\n1100 |         else:\n1101 |             raise ValueError(\"subs accepts either 1 or 2 arguments\")\n1102 | \n1103 |         def sympify_old(old):\n1104 |             if isinstance(old, str):\n1105 |                 # Use Symbol rather than parse_expr for old\n1106 |                 return Symbol(old)\n1107 |             elif isinstance(old, type):\n1108 |                 # Allow a type e.g. Function('f') or sin\n1109 |                 return sympify(old, strict=False)\n1110 |             else:\n1111 |                 return sympify(old, strict=True)\n1112 | \n1113 |         def sympify_new(new):\n1114 |             if isinstance(new, (str, type)):\n1115 |                 # Allow a type or parse a string input\n1116 |                 return sympify(new, strict=False)\n1117 |             else:\n1118 |                 return sympify(new, strict=True)\n1119 | \n1120 |         sequence = [(sympify_old(s1), sympify_new(s2)) for s1, s2 in sequence]\n1121 | \n1122 |         # skip if there is no change\n1123 |         sequence = [(s1, s2) for s1, s2 in sequence if not _aresame(s1, s2)]\n1124 | \n1125 |         simultaneous = kwargs.pop('simultaneous', False)\n1126 | \n1127 |         if unordered:\n1128 |             from .sorting import _nodes, default_sort_key\n1129 |             sequence = dict(sequence)\n1130 |             # order so more complex items are first and items\n1131 |             # of identical complexity are ordered so\n1132 |             # f(x) < f(y) < x < y\n1133 |             # \\___ 2 __/    \\_1_/  <- number of nodes\n1134 |             #\n1135 |             # For more complex ordering use an unordered sequence.\n1136 |             k = list(ordered(sequence, default=False, keys=(\n1137 |                 lambda x: -_nodes(x),\n1138 |                 default_sort_key,\n1139 |                 )))\n1140 |             sequence = [(k, sequence[k]) for k in k]\n1141 |             # do infinities first\n1142 |             if not simultaneous:\n1143 |                 redo = [i for i, seq in enumerate(sequence) if seq[1] in _illegal]\n1144 |                 for i in reversed(redo):\n1145 |                     sequence.insert(0, sequence.pop(i))\n1146 | \n1147 |         if simultaneous:  # XXX should this be the default for dict subs?\n1148 |             reps = {}\n1149 |             rv = self\n1150 |             kwargs['hack2'] = True\n1151 |             m = Dummy('subs_m')\n1152 |             for old, new in sequence:\n1153 |                 com = new.is_commutative\n1154 |                 if com is None:\n1155 |                     com = True\n1156 |                 d = Dummy('subs_d', commutative=com)\n1157 |                 # using d*m so Subs will be used on dummy variables\n1158 |                 # in things like Derivative(f(x, y), x) in which x\n1159 |                 # is both free and bound\n1160 |                 rv = rv._subs(old, d*m, **kwargs)\n1161 |                 if not isinstance(rv, Basic):\n1162 |                     break\n1163 |                 reps[d] = new\n1164 |             reps[m] = S.One  # get rid of m\n1165 |             return rv.xreplace(reps)\n1166 |         else:\n1167 |             rv = self\n1168 |             for old, new in sequence:\n1169 |                 rv = rv._subs(old, new, **kwargs)\n1170 |                 if not isinstance(rv, Basic):\n1171 |                     break\n1172 |             return rv\n1173 | \n1174 |     @cacheit\n1175 |     def _subs(self, old, new, **hints):\n1176 |         \"\"\"Substitutes an expression old -> new.\n1177 | \n1178 |         If self is not equal to old then _eval_subs is called.\n1179 |         If _eval_subs does not want to make any special replacement\n1180 |         then a None is received which indicates that the fallback\n1181 |         should be applied wherein a search for replacements is made\n1182 |         amongst the arguments of self.\n1183 | \n1184 |         >>> from sympy import Add\n1185 |         >>> from sympy.abc import x, y, z\n1186 | \n1187 |         Examples\n1188 |         ========\n1189 | \n1190 |         Add's _eval_subs knows how to target x + y in the following\n1191 |         so it makes the change:\n1192 | \n1193 |         >>> (x + y + z).subs(x + y, 1)\n1194 |         z + 1\n1195 | \n1196 |         Add's _eval_subs does not need to know how to find x + y in\n1197 |         the following:\n1198 | \n1199 |         >>> Add._eval_subs(z*(x + y) + 3, x + y, 1) is None\n1200 |         True\n1201 | \n1202 |         The returned None will cause the fallback routine to traverse the args and\n1203 |         pass the z*(x + y) arg to Mul where the change will take place and the\n1204 |         substitution will succeed:\n1205 | \n1206 |         >>> (z*(x + y) + 3).subs(x + y, 1)\n1207 |         z + 3\n1208 | \n1209 |         ** Developers Notes **\n1210 | \n1211 |         An _eval_subs routine for a class should be written if:\n1212 | \n1213 |             1) any arguments are not instances of Basic (e.g. bool, tuple);\n1214 | \n1215 |             2) some arguments should not be targeted (as in integration\n1216 |                variables);\n1217 | \n1218 |             3) if there is something other than a literal replacement\n1219 |                that should be attempted (as in Piecewise where the condition\n1220 |                may be updated without doing a replacement).\n1221 | \n1222 |         If it is overridden, here are some special cases that might arise:\n1223 | \n1224 |             1) If it turns out that no special change was made and all\n1225 |                the original sub-arguments should be checked for\n1226 |                replacements then None should be returned.\n1227 | \n1228 |             2) If it is necessary to do substitutions on a portion of\n1229 |                the expression then _subs should be called. _subs will\n1230 |                handle the case of any sub-expression being equal to old\n1231 |                (which usually would not be the case) while its fallback\n1232 |                will handle the recursion into the sub-arguments. For\n1233 |                example, after Add's _eval_subs removes some matching terms\n1234 |                it must process the remaining terms so it calls _subs\n1235 |                on each of the un-matched terms and then adds them\n1236 |                onto the terms previously obtained.\n1237 | \n1238 |            3) If the initial expression should remain unchanged then\n1239 |               the original expression should be returned. (Whenever an\n1240 |               expression is returned, modified or not, no further\n1241 |               substitution of old -> new is attempted.) Sum's _eval_subs\n1242 |               routine uses this strategy when a substitution is attempted\n1243 |               on any of its summation variables.\n1244 |         \"\"\"\n1245 | \n1246 |         def fallback(self, old, new):\n1247 |             \"\"\"\n1248 |             Try to replace old with new in any of self's arguments.\n1249 |             \"\"\"\n1250 |             hit = False\n1251 |             args = list(self.args)\n1252 |             for i, arg in enumerate(args):\n1253 |                 if not hasattr(arg, '_eval_subs'):\n1254 |                     continue\n1255 |                 arg = arg._subs(old, new, **hints)\n1256 |                 if not _aresame(arg, args[i]):\n1257 |                     hit = True\n1258 |                     args[i] = arg\n1259 |             if hit:\n1260 |                 rv = self.func(*args)\n1261 |                 hack2 = hints.get('hack2', False)\n1262 |                 if hack2 and self.is_Mul and not rv.is_Mul:  # 2-arg hack\n1263 |                     coeff = S.One\n1264 |                     nonnumber = []\n1265 |                     for i in args:\n1266 |                         if i.is_Number:\n1267 |                             coeff *= i\n1268 |                         else:\n1269 |                             nonnumber.append(i)\n1270 |                     nonnumber = self.func(*nonnumber)\n1271 |                     if coeff is S.One:\n1272 |                         return nonnumber\n1273 |                     else:\n1274 |                         return self.func(coeff, nonnumber, evaluate=False)\n1275 |                 return rv\n1276 |             return self\n1277 | \n1278 |         if _aresame(self, old):\n1279 |             return new\n1280 | \n1281 |         rv = self._eval_subs(old, new)\n1282 |         if rv is None:\n1283 |             rv = fallback(self, old, new)\n1284 |         return rv\n1285 | \n1286 |     def _eval_subs(self, old, new) -> Basic | None:\n1287 |         \"\"\"Override this stub if you want to do anything more than\n1288 |         attempt a replacement of old with new in the arguments of self.\n1289 | \n1290 |         See also\n1291 |         ========\n1292 | \n1293 |         _subs\n1294 |         \"\"\"\n1295 |         return None\n1296 | \n1297 |     def xreplace(self, rule):\n1298 |         \"\"\"\n1299 |         Replace occurrences of objects within the expression.\n1300 | \n1301 |         Parameters\n1302 |         ==========\n1303 | \n1304 |         rule : dict-like\n1305 |             Expresses a replacement rule\n1306 | \n1307 |         Returns\n1308 |         =======\n1309 | \n1310 |         xreplace : the result of the replacement\n1311 | \n1312 |         Examples\n1313 |         ========\n1314 | \n1315 |         >>> from sympy import symbols, pi, exp\n1316 |         >>> x, y, z = symbols('x y z')\n1317 |         >>> (1 + x*y).xreplace({x: pi})\n1318 |         pi*y + 1\n1319 |         >>> (1 + x*y).xreplace({x: pi, y: 2})\n1320 |         1 + 2*pi\n1321 | \n1322 |         Replacements occur only if an entire node in the expression tree is\n1323 |         matched:\n1324 | \n1325 |         >>> (x*y + z).xreplace({x*y: pi})\n1326 |         z + pi\n1327 |         >>> (x*y*z).xreplace({x*y: pi})\n1328 |         x*y*z\n1329 |         >>> (2*x).xreplace({2*x: y, x: z})\n1330 |         y\n1331 |         >>> (2*2*x).xreplace({2*x: y, x: z})\n1332 |         4*z\n1333 |         >>> (x + y + 2).xreplace({x + y: 2})\n1334 |         x + y + 2\n1335 |         >>> (x + 2 + exp(x + 2)).xreplace({x + 2: y})\n1336 |         x + exp(y) + 2\n1337 | \n1338 |         xreplace does not differentiate between free and bound symbols. In the\n1339 |         following, subs(x, y) would not change x since it is a bound symbol,\n1340 |         but xreplace does:\n1341 | \n1342 |         >>> from sympy import Integral\n1343 |         >>> Integral(x, (x, 1, 2*x)).xreplace({x: y})\n1344 |         Integral(y, (y, 1, 2*y))\n1345 | \n1346 |         Trying to replace x with an expression raises an error:\n1347 | \n1348 |         >>> Integral(x, (x, 1, 2*x)).xreplace({x: 2*y}) # doctest: +SKIP\n1349 |         ValueError: Invalid limits given: ((2*y, 1, 4*y),)\n1350 | \n1351 |         See Also\n1352 |         ========\n1353 |         replace: replacement capable of doing wildcard-like matching,\n1354 |                  parsing of match, and conditional replacements\n1355 |         subs: substitution of subexpressions as defined by the objects\n1356 |               themselves.\n1357 | \n1358 |         \"\"\"\n1359 |         value, _ = self._xreplace(rule)\n1360 |         return value\n1361 | \n1362 |     def _xreplace(self, rule):\n1363 |         \"\"\"\n1364 |         Helper for xreplace. Tracks whether a replacement actually occurred.\n1365 |         \"\"\"\n1366 |         if self in rule:\n1367 |             return rule[self], True\n1368 |         elif rule:\n1369 |             args = []\n1370 |             changed = False\n1371 |             for a in self.args:\n1372 |                 _xreplace = getattr(a, '_xreplace', None)\n1373 |                 if _xreplace is not None:\n1374 |                     a_xr = _xreplace(rule)\n1375 |                     args.append(a_xr[0])\n1376 |                     changed |= a_xr[1]\n1377 |                 else:\n1378 |                     args.append(a)\n1379 |             args = tuple(args)\n1380 |             if changed:\n1381 |                 return self.func(*args), True\n1382 |         return self, False\n1383 | \n1384 |     @cacheit\n1385 |     def has(self, *patterns):\n1386 |         \"\"\"\n1387 |         Test whether any subexpression matches any of the patterns.\n1388 | \n1389 |         Examples\n1390 |         ========\n1391 | \n1392 |         >>> from sympy import sin\n1393 |         >>> from sympy.abc import x, y, z\n1394 |         >>> (x**2 + sin(x*y)).has(z)\n1395 |         False\n1396 |         >>> (x**2 + sin(x*y)).has(x, y, z)\n1397 |         True\n1398 |         >>> x.has(x)\n1399 |         True\n1400 | \n1401 |         Note ``has`` is a structural algorithm with no knowledge of\n1402 |         mathematics. Consider the following half-open interval:\n1403 | \n1404 |         >>> from sympy import Interval\n1405 |         >>> i = Interval.Lopen(0, 5); i\n1406 |         Interval.Lopen(0, 5)\n1407 |         >>> i.args\n1408 |         (0, 5, True, False)\n1409 |         >>> i.has(4)  # there is no \"4\" in the arguments\n1410 |         False\n1411 |         >>> i.has(0)  # there *is* a \"0\" in the arguments\n1412 |         True\n1413 | \n1414 |         Instead, use ``contains`` to determine whether a number is in the\n1415 |         interval or not:\n1416 | \n1417 |         >>> i.contains(4)\n1418 |         True\n1419 |         >>> i.contains(0)\n1420 |         False\n1421 | \n1422 | \n1423 |         Note that ``expr.has(*patterns)`` is exactly equivalent to\n1424 |         ``any(expr.has(p) for p in patterns)``. In particular, ``False`` is\n1425 |         returned when the list of patterns is empty.\n1426 | \n1427 |         >>> x.has()\n1428 |         False\n1429 | \n1430 |         \"\"\"\n1431 |         return self._has(iterargs, *patterns)\n1432 | \n1433 |     def has_xfree(self, s: set[Basic]):\n1434 |         \"\"\"Return True if self has any of the patterns in s as a\n1435 |         free argument, else False. This is like `Basic.has_free`\n1436 |         but this will only report exact argument matches.\n1437 | \n1438 |         Examples\n1439 |         ========\n1440 | \n1441 |         >>> from sympy import Function\n1442 |         >>> from sympy.abc import x, y\n1443 |         >>> f = Function('f')\n1444 |         >>> f(x).has_xfree({f})\n1445 |         False\n1446 |         >>> f(x).has_xfree({f(x)})\n1447 |         True\n1448 |         >>> f(x + 1).has_xfree({x})\n1449 |         True\n1450 |         >>> f(x + 1).has_xfree({x + 1})\n1451 |         True\n1452 |         >>> f(x + y + 1).has_xfree({x + 1})\n1453 |         False\n1454 |         \"\"\"\n1455 |         # protect O(1) containment check by requiring:\n1456 |         if type(s) is not set:\n1457 |             raise TypeError('expecting set argument')\n1458 |         return any(a in s for a in iterfreeargs(self))\n1459 | \n1460 |     @cacheit\n1461 |     def has_free(self, *patterns):\n1462 |         \"\"\"Return True if self has object(s) ``x`` as a free expression\n1463 |         else False.\n1464 | \n1465 |         Examples\n1466 |         ========\n1467 | \n1468 |         >>> from sympy import Integral, Function\n1469 |         >>> from sympy.abc import x, y\n1470 |         >>> f = Function('f')\n1471 |         >>> g = Function('g')\n1472 |         >>> expr = Integral(f(x), (f(x), 1, g(y)))\n1473 |         >>> expr.free_symbols\n1474 |         {y}\n1475 |         >>> expr.has_free(g(y))\n1476 |         True\n1477 |         >>> expr.has_free(*(x, f(x)))\n1478 |         False\n1479 | \n1480 |         This works for subexpressions and types, too:\n1481 | \n1482 |         >>> expr.has_free(g)\n1483 |         True\n1484 |         >>> (x + y + 1).has_free(y + 1)\n1485 |         True\n1486 |         \"\"\"\n1487 |         if not patterns:\n1488 |             return False\n1489 |         p0 = patterns[0]\n1490 |         if len(patterns) == 1 and iterable(p0) and not isinstance(p0, Basic):\n1491 |             # Basic can contain iterables (though not non-Basic, ideally)\n1492 |             # but don't encourage mixed passing patterns\n1493 |             raise TypeError(filldedent('''\n1494 |                 Expecting 1 or more Basic args, not a single\n1495 |                 non-Basic iterable. Don't forget to unpack\n1496 |                 iterables: `eq.has_free(*patterns)`'''))\n1497 |         # try quick test first\n1498 |         s = set(patterns)\n1499 |         rv = self.has_xfree(s)\n1500 |         if rv:\n1501 |             return rv\n1502 |         # now try matching through slower _has\n1503 |         return self._has(iterfreeargs, *patterns)\n1504 | \n1505 |     def _has(self, iterargs, *patterns):\n1506 |         # separate out types and unhashable objects\n1507 |         type_set = set()  # only types\n1508 |         p_set = set()  # hashable non-types\n1509 |         for p in patterns:\n1510 |             if isinstance(p, type) and issubclass(p, Basic):\n1511 |                 type_set.add(p)\n1512 |                 continue\n1513 |             if not isinstance(p, Basic):\n1514 |                 try:\n1515 |                     p = _sympify(p)\n1516 |                 except SympifyError:\n1517 |                     continue  # Basic won't have this in it\n1518 |             p_set.add(p)  # fails if object defines __eq__ but\n1519 |                           # doesn't define __hash__\n1520 |         types = tuple(type_set)   #\n1521 |         for i in iterargs(self):  #\n1522 |             if i in p_set:        # <--- here, too\n1523 |                 return True\n1524 |             if isinstance(i, types):\n1525 |                 return True\n1526 | \n1527 |         # use matcher if defined, e.g. operations defines\n1528 |         # matcher that checks for exact subset containment,\n1529 |         # (x + y + 1).has(x + 1) -> True\n1530 |         for i in p_set - type_set:  # types don't have matchers\n1531 |             if not hasattr(i, '_has_matcher'):\n1532 |                 continue\n1533 |             match = i._has_matcher()\n1534 |             if any(match(arg) for arg in iterargs(self)):\n1535 |                 return True\n1536 | \n1537 |         # no success\n1538 |         return False\n1539 | \n1540 |     def replace(self, query, value, map=False, simultaneous=True, exact=None) -> Basic:\n1541 |         \"\"\"\n1542 |         Replace matching subexpressions of ``self`` with ``value``.\n1543 | \n1544 |         If ``map = True`` then also return the mapping {old: new} where ``old``\n1545 |         was a sub-expression found with query and ``new`` is the replacement\n1546 |         value for it. If the expression itself does not match the query, then\n1547 |         the returned value will be ``self.xreplace(map)`` otherwise it should\n1548 |         be ``self.subs(ordered(map.items()))``.\n1549 | \n1550 |         Traverses an expression tree and performs replacement of matching\n1551 |         subexpressions from the bottom to the top of the tree. The default\n1552 |         approach is to do the replacement in a simultaneous fashion so\n1553 |         changes made are targeted only once. If this is not desired or causes\n1554 |         problems, ``simultaneous`` can be set to False.\n1555 | \n1556 |         In addition, if an expression containing more than one Wild symbol\n1557 |         is being used to match subexpressions and the ``exact`` flag is None\n1558 |         it will be set to True so the match will only succeed if all non-zero\n1559 |         values are received for each Wild that appears in the match pattern.\n1560 |         Setting this to False accepts a match of 0; while setting it True\n1561 |         accepts all matches that have a 0 in them. See example below for\n1562 |         cautions.\n1563 | \n1564 |         The list of possible combinations of queries and replacement values\n1565 |         is listed below:\n1566 | \n1567 |         Examples\n1568 |         ========\n1569 | \n1570 |         Initial setup\n1571 | \n1572 |         >>> from sympy import log, sin, cos, tan, Wild, Mul, Add\n1573 |         >>> from sympy.abc import x, y\n1574 |         >>> f = log(sin(x)) + tan(sin(x**2))\n1575 | \n1576 |         1.1. type -> type\n1577 |             obj.replace(type, newtype)\n1578 | \n1579 |             When object of type ``type`` is found, replace it with the\n1580 |             result of passing its argument(s) to ``newtype``.\n1581 | \n1582 |             >>> f.replace(sin, cos)\n1583 |             log(cos(x)) + tan(cos(x**2))\n1584 |             >>> sin(x).replace(sin, cos, map=True)\n1585 |             (cos(x), {sin(x): cos(x)})\n1586 |             >>> (x*y).replace(Mul, Add)\n1587 |             x + y\n1588 | \n1589 |         1.2. type -> func\n1590 |             obj.replace(type, func)\n1591 | \n1592 |             When object of type ``type`` is found, apply ``func`` to its\n1593 |             argument(s). ``func`` must be written to handle the number\n1594 |             of arguments of ``type``.\n1595 | \n1596 |             >>> f.replace(sin, lambda arg: sin(2*arg))\n1597 |             log(sin(2*x)) + tan(sin(2*x**2))\n1598 |             >>> (x*y).replace(Mul, lambda *args: sin(2*Mul(*args)))\n1599 |             sin(2*x*y)\n1600 | \n1601 |         2.1. pattern -> expr\n1602 |             obj.replace(pattern(wild), expr(wild))\n1603 | \n1604 |             Replace subexpressions matching ``pattern`` with the expression\n1605 |             written in terms of the Wild symbols in ``pattern``.\n1606 | \n1607 |             >>> a, b = map(Wild, 'ab')\n1608 |             >>> f.replace(sin(a), tan(a))\n1609 |             log(tan(x)) + tan(tan(x**2))\n1610 |             >>> f.replace(sin(a), tan(a/2))\n1611 |             log(tan(x/2)) + tan(tan(x**2/2))\n1612 |             >>> f.replace(sin(a), a)\n1613 |             log(x) + tan(x**2)\n1614 |             >>> (x*y).replace(a*x, a)\n1615 |             y\n1616 | \n1617 |             Matching is exact by default when more than one Wild symbol\n1618 |             is used: matching fails unless the match gives non-zero\n1619 |             values for all Wild symbols:\n1620 | \n1621 |             >>> (2*x + y).replace(a*x + b, b - a)\n1622 |             y - 2\n1623 |             >>> (2*x).replace(a*x + b, b - a)\n1624 |             2*x\n1625 | \n1626 |             When set to False, the results may be non-intuitive:\n1627 | \n1628 |             >>> (2*x).replace(a*x + b, b - a, exact=False)\n1629 |             2/x\n1630 | \n1631 |         2.2. pattern -> func\n1632 |             obj.replace(pattern(wild), lambda wild: expr(wild))\n1633 | \n1634 |             All behavior is the same as in 2.1 but now a function in terms of\n1635 |             pattern variables is used rather than an expression:\n1636 | \n1637 |             >>> f.replace(sin(a), lambda a: sin(2*a))\n1638 |             log(sin(2*x)) + tan(sin(2*x**2))\n1639 | \n1640 |         3.1. func -> func\n1641 |             obj.replace(filter, func)\n1642 | \n1643 |             Replace subexpression ``e`` with ``func(e)`` if ``filter(e)``\n1644 |             is True.\n1645 | \n1646 |             >>> g = 2*sin(x**3)\n1647 |             >>> g.replace(lambda expr: expr.is_Number, lambda expr: expr**2)\n1648 |             4*sin(x**9)\n1649 | \n1650 |         The expression itself is also targeted by the query but is done in\n1651 |         such a fashion that changes are not made twice.\n1652 | \n1653 |             >>> e = x*(x*y + 1)\n1654 |             >>> e.replace(lambda x: x.is_Mul, lambda x: 2*x)\n1655 |             2*x*(2*x*y + 1)\n1656 | \n1657 |         When matching a single symbol, `exact` will default to True, but\n1658 |         this may or may not be the behavior that is desired:\n1659 | \n1660 |         Here, we want `exact=False`:\n1661 | \n1662 |         >>> from sympy import Function\n1663 |         >>> f = Function('f')\n1664 |         >>> e = f(1) + f(0)\n1665 |         >>> q = f(a), lambda a: f(a + 1)\n1666 |         >>> e.replace(*q, exact=False)\n1667 |         f(1) + f(2)\n1668 |         >>> e.replace(*q, exact=True)\n1669 |         f(0) + f(2)\n1670 | \n1671 |         But here, the nature of matching makes selecting\n1672 |         the right setting tricky:\n1673 | \n1674 |         >>> e = x**(1 + y)\n1675 |         >>> (x**(1 + y)).replace(x**(1 + a), lambda a: x**-a, exact=False)\n1676 |         x\n1677 |         >>> (x**(1 + y)).replace(x**(1 + a), lambda a: x**-a, exact=True)\n1678 |         x**(-x - y + 1)\n1679 |         >>> (x**y).replace(x**(1 + a), lambda a: x**-a, exact=False)\n1680 |         x\n1681 |         >>> (x**y).replace(x**(1 + a), lambda a: x**-a, exact=True)\n1682 |         x**(1 - y)\n1683 | \n1684 |         It is probably better to use a different form of the query\n1685 |         that describes the target expression more precisely:\n1686 | \n1687 |         >>> (1 + x**(1 + y)).replace(\n1688 |         ... lambda x: x.is_Pow and x.exp.is_Add and x.exp.args[0] == 1,\n1689 |         ... lambda x: x.base**(1 - (x.exp - 1)))\n1690 |         ...\n1691 |         x**(1 - y) + 1\n1692 | \n1693 |         See Also\n1694 |         ========\n1695 | \n1696 |         subs: substitution of subexpressions as defined by the objects\n1697 |               themselves.\n1698 |         xreplace: exact node replacement in expr tree; also capable of\n1699 |                   using matching rules\n1700 | \n1701 |         \"\"\"\n1702 | \n1703 |         try:\n1704 |             query = _sympify(query)\n1705 |         except SympifyError:\n1706 |             pass\n1707 |         try:\n1708 |             value = _sympify(value)\n1709 |         except SympifyError:\n1710 |             pass\n1711 |         if isinstance(query, type):\n1712 |             _query = lambda expr: isinstance(expr, query)\n1713 | \n1714 |             if isinstance(value, type):\n1715 |                 _value = lambda expr, result: value(*expr.args)\n1716 |             elif callable(value):\n1717 |                 _value = lambda expr, result: value(*expr.args)\n1718 |             else:\n1719 |                 raise TypeError(\n1720 |                     \"given a type, replace() expects another \"\n1721 |                     \"type or a callable\")\n1722 |         elif isinstance(query, Basic):\n1723 |             _query = lambda expr: expr.match(query)\n1724 |             if exact is None:\n1725 |                 from .symbol import Wild\n1726 |                 exact = (len(query.atoms(Wild)) > 1)\n1727 | \n1728 |             if isinstance(value, Basic):\n1729 |                 if exact:\n1730 |                     _value = lambda expr, result: (value.subs(result)\n1731 |                         if all(result.values()) else expr)\n1732 |                 else:\n1733 |                     _value = lambda expr, result: value.subs(result)\n1734 |             elif callable(value):\n1735 |                 # match dictionary keys get the trailing underscore stripped\n1736 |                 # from them and are then passed as keywords to the callable;\n1737 |                 # if ``exact`` is True, only accept match if there are no null\n1738 |                 # values amongst those matched.\n1739 |                 if exact:\n1740 |                     _value = lambda expr, result: (value(**\n1741 |                         {str(k)[:-1]: v for k, v in result.items()})\n1742 |                         if all(val for val in result.values()) else expr)\n1743 |                 else:\n1744 |                     _value = lambda expr, result: value(**\n1745 |                         {str(k)[:-1]: v for k, v in result.items()})\n1746 |             else:\n1747 |                 raise TypeError(\n1748 |                     \"given an expression, replace() expects \"\n1749 |                     \"another expression or a callable\")\n1750 |         elif callable(query):\n1751 |             _query = query\n1752 | \n1753 |             if callable(value):\n1754 |                 _value = lambda expr, result: value(expr)\n1755 |             else:\n1756 |                 raise TypeError(\n1757 |                     \"given a callable, replace() expects \"\n1758 |                     \"another callable\")\n1759 |         else:\n1760 |             raise TypeError(\n1761 |                 \"first argument to replace() must be a \"\n1762 |                 \"type, an expression or a callable\")\n1763 | \n1764 |         def walk(rv, F):\n1765 |             \"\"\"Apply ``F`` to args and then to result.\n1766 |             \"\"\"\n1767 |             args = getattr(rv, 'args', None)\n1768 |             if args is not None:\n1769 |                 if args:\n1770 |                     newargs = tuple([walk(a, F) for a in args])\n1771 |                     if args != newargs:\n1772 |                         rv = rv.func(*newargs)\n1773 |                         if simultaneous:\n1774 |                             # if rv is something that was already\n1775 |                             # matched (that was changed) then skip\n1776 |                             # applying F again\n1777 |                             for i, e in enumerate(args):\n1778 |                                 if rv == e and e != newargs[i]:\n1779 |                                     return rv\n1780 |                 rv = F(rv)\n1781 |             return rv\n1782 | \n1783 |         mapping = {}  # changes that took place\n1784 | \n1785 |         def rec_replace(expr):\n1786 |             result = _query(expr)\n1787 |             if result or result == {}:\n1788 |                 v = _value(expr, result)\n1789 |                 if v is not None and v != expr:\n1790 |                     if map:\n1791 |                         mapping[expr] = v\n1792 |                     expr = v\n1793 |             return expr\n1794 | \n1795 |         rv = walk(self, rec_replace)\n1796 |         return (rv, mapping) if map else rv # type: ignore\n1797 | \n1798 |     def find(self, query, group=False):\n1799 |         \"\"\"Find all subexpressions matching a query.\"\"\"\n1800 |         query = _make_find_query(query)\n1801 |         results = list(filter(query, _preorder_traversal(self)))\n1802 | \n1803 |         if not group:\n1804 |             return set(results)\n1805 |         else:\n1806 |             groups = {}\n1807 | \n1808 |             for result in results:\n1809 |                 if result in groups:\n1810 |                     groups[result] += 1\n1811 |                 else:\n1812 |                     groups[result] = 1\n1813 | \n1814 |             return groups\n1815 | \n1816 |     def count(self, query):\n1817 |         \"\"\"Count the number of matching subexpressions.\"\"\"\n1818 |         query = _make_find_query(query)\n1819 |         return sum(bool(query(sub)) for sub in _preorder_traversal(self))\n1820 | \n1821 |     def matches(self, expr, repl_dict=None, old=False):\n1822 |         \"\"\"\n1823 |         Helper method for match() that looks for a match between Wild symbols\n1824 |         in self and expressions in expr.\n1825 | \n1826 |         Examples\n1827 |         ========\n1828 | \n1829 |         >>> from sympy import symbols, Wild, Basic\n1830 |         >>> a, b, c = symbols('a b c')\n1831 |         >>> x = Wild('x')\n1832 |         >>> Basic(a + x, x).matches(Basic(a + b, c)) is None\n1833 |         True\n1834 |         >>> Basic(a + x, x).matches(Basic(a + b + c, b + c))\n1835 |         {x_: b + c}\n1836 |         \"\"\"\n1837 |         expr = sympify(expr)\n1838 |         if not isinstance(expr, self.__class__):\n1839 |             return None\n1840 | \n1841 |         if repl_dict is None:\n1842 |             repl_dict = {}\n1843 |         else:\n1844 |             repl_dict = repl_dict.copy()\n1845 | \n1846 |         if self == expr:\n1847 |             return repl_dict\n1848 | \n1849 |         if len(self.args) != len(expr.args):\n1850 |             return None\n1851 | \n1852 |         d = repl_dict  # already a copy\n1853 |         for arg, other_arg in zip(self.args, expr.args):\n1854 |             if arg == other_arg:\n1855 |                 continue\n1856 |             if arg.is_Relational:\n1857 |                 try:\n1858 |                     d = arg.xreplace(d).matches(other_arg, d, old=old)\n1859 |                 except TypeError: # Should be InvalidComparisonError when introduced\n1860 |                     d = None\n1861 |             else:\n1862 |                     d = arg.xreplace(d).matches(other_arg, d, old=old)\n1863 |             if d is None:\n1864 |                 return None\n1865 |         return d\n1866 | \n1867 |     def match(self, pattern, old=False):\n1868 |         \"\"\"\n1869 |         Pattern matching.\n1870 | \n1871 |         Wild symbols match all.\n1872 | \n1873 |         Return ``None`` when expression (self) does not match with pattern.\n1874 |         Otherwise return a dictionary such that::\n1875 | \n1876 |           pattern.xreplace(self.match(pattern)) == self\n1877 | \n1878 |         Examples\n1879 |         ========\n1880 | \n1881 |         >>> from sympy import Wild, Sum\n1882 |         >>> from sympy.abc import x, y\n1883 |         >>> p = Wild(\"p\")\n1884 |         >>> q = Wild(\"q\")\n1885 |         >>> r = Wild(\"r\")\n1886 |         >>> e = (x+y)**(x+y)\n1887 |         >>> e.match(p**p)\n1888 |         {p_: x + y}\n1889 |         >>> e.match(p**q)\n1890 |         {p_: x + y, q_: x + y}\n1891 |         >>> e = (2*x)**2\n1892 |         >>> e.match(p*q**r)\n1893 |         {p_: 4, q_: x, r_: 2}\n1894 |         >>> (p*q**r).xreplace(e.match(p*q**r))\n1895 |         4*x**2\n1896 | \n1897 |         Since match is purely structural expressions that are equivalent up to\n1898 |         bound symbols will not match:\n1899 | \n1900 |         >>> print(Sum(x, (x, 1, 2)).match(Sum(y, (y, 1, p))))\n1901 |         None\n1902 | \n1903 |         An expression with bound symbols can be matched if the pattern uses\n1904 |         a distinct ``Wild`` for each bound symbol:\n1905 | \n1906 |         >>> Sum(x, (x, 1, 2)).match(Sum(q, (q, 1, p)))\n1907 |         {p_: 2, q_: x}\n1908 | \n1909 |         The ``old`` flag will give the old-style pattern matching where\n1910 |         expressions and patterns are essentially solved to give the match. Both\n1911 |         of the following give None unless ``old=True``:\n1912 | \n1913 |         >>> (x - 2).match(p - x, old=True)\n1914 |         {p_: 2*x - 2}\n1915 |         >>> (2/x).match(p*x, old=True)\n1916 |         {p_: 2/x**2}\n1917 | \n1918 |         See Also\n1919 |         ========\n1920 | \n1921 |         matches: pattern.matches(expr) is the same as expr.match(pattern)\n1922 |         xreplace: exact structural replacement\n1923 |         replace: structural replacement with pattern matching\n1924 |         Wild: symbolic placeholders for expressions in pattern matching\n1925 |         \"\"\"\n1926 |         pattern = sympify(pattern)\n1927 |         return pattern.matches(self, old=old)\n1928 | \n1929 |     def count_ops(self, visual=False):\n1930 |         \"\"\"Wrapper for count_ops that returns the operation count.\"\"\"\n1931 |         from .function import count_