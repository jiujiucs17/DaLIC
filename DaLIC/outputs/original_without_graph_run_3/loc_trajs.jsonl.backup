41 |             Whether to shade the scatter markers to give the appearance of\n2942 |             depth. Each call to ``scatter()`` will perform its depthshading\n2943 |             independently.\n2944 |         axlim_clip : bool, default: False\n2945 |             Whether to hide the scatter points outside the axes view limits.\n2946 | \n2947 |             .. versionadded:: 3.10\n2948 |         data : indexable object, optional\n2949 |             DATA_PARAMETER_PLACEHOLDER\n2950 |         **kwargs\n2951 |             All other keyword arguments are passed on to `~.axes.Axes.scatter`.\n2952 | \n2953 |         Returns\n2954 |         -------\n2955 |         paths : `~matplotlib.collections.PathCollection`\n2956 |         \"\"\"\n2957 | \n2958 |         had_data = self.has_data()\n2959 |         zs_orig = zs\n2960 | \n2961 |         xs, ys, zs = cbook._broadcast_with_masks(xs, ys, zs)\n2962 |         s = np.ma.ravel(s)  # This doesn't have to match x, y in size.\n2963 | \n2964 |         xs, ys, zs, s, c, color = cbook.delete_masked_points(\n2965 |             xs, ys, zs, s, c, kwargs.get('color', None)\n2966 |             )\n2967 |         if kwargs.get(\"color\") is not None:\n2968 |             kwargs['color'] = color\n2969 | \n2970 |         # For xs and ys, 2D scatter() will do the copying.\n2971 |         if np.may_share_memory(zs_orig, zs):  # Avoid unnecessary copies.\n2972 |             zs = zs.copy()\n2973 | \n2974 |         patches = super().scatter(xs, ys, s=s, c=c, *args, **kwargs)\n2975 |         art3d.patch_collection_2d_to_3d(patches, zs=zs, zdir=zdir,\n2976 |                                         depthshade=depthshade,\n2977 |                                         axlim_clip=axlim_clip)\n2978 | \n2979 |         if self._zmargin < 0.05 and xs.size > 0:\n2980 |             self.set_zmargin(0.05)\n2981 | \n2982 |         self.auto_scale_xyz(xs, ys, zs, had_data)\n2983 | \n2984 |         return patches\n```\n\n\n\n##Searching for term \"scatter()\"