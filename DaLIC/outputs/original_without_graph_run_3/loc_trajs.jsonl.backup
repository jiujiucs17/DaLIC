umber of columns fitting the screen.\"\"\"\n585 |         if not self._is_in_terminal():\n586 |             return self.max_cols\n587 | \n588 |         width, _ = get_terminal_size()\n589 |         if self._is_screen_narrow(width):\n590 |             return width\n591 |         else:\n592 |             return self.max_cols\n593 | \n594 |     def _calc_max_rows_fitted(self) -> int | None:\n595 |         \"\"\"Number of rows with data fitting the screen.\"\"\"\n596 |         max_rows: int | None\n597 | \n598 |         if self._is_in_terminal():\n599 |             _, height = get_terminal_size()\n600 |             if self.max_rows == 0:\n601 |                 # rows available to fill with actual data\n602 |                 return height - self._get_number_of_auxiliary_rows()\n603 | \n604 |             if self._is_screen_short(height):\n605 |                 max_rows = height\n606 |             else:\n607 |                 max_rows = self.max_rows\n608 |         else:\n609 |             max_rows = self.max_rows\n610 | \n611 |         return self._adjust_max_rows(max_rows)\n612 | \n613 |     def _adjust_max_rows(self, max_rows: int | None) -> int | None:\n614 |         \"\"\"Adjust max_rows using display logic.\n615 | \n616 |         See description here:\n617 |         https://pandas.pydata.org/docs/dev/user_guide/options.html#frequently-used-options\n618 | \n619 |         GH #37359\n620 |         \"\"\"\n621 |         if max_rows:\n622 |             if (len(self.frame) > max_rows) and self.min_rows:\n623 |                 # if truncated, set max_rows showed to min_rows\n624 |                 max_rows = min(self.min_rows, max_rows)\n625 |         return max_rows\n626 | \n627 |     def _is_in_terminal(self) -> bool:\n628 |         \"\"\"Check if the output is to be shown in terminal.\"\"\"\n629 |         return bool(self.max_cols == 0 or self.max_rows == 0)\n630 | \n631 |     def _is_screen_narrow(self, max_width) -> bool:\n632 |         return bool(self.max_cols == 0 an