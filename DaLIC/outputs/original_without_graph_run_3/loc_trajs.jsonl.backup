9 |         0.25    1.75\n2580 |         0.50    2.50\n2581 |         0.75    3.25\n2582 |         dtype: float64\n2583 |         \"\"\"\n2584 |         validate_percentile(q)\n2585 | \n2586 |         # We dispatch to DataFrame so that core.internals only has to worry\n2587 |         #  about 2D cases.\n2588 |         df = self.to_frame()\n2589 | \n2590 |         result = df.quantile(q=q, interpolation=interpolation, numeric_only=False)\n2591 |         if result.ndim == 2:\n2592 |             result = result.iloc[:, 0]\n2593 | \n2594 |         if is_list_like(q):\n2595 |             result.name = self.name\n2596 |             idx = Index(q, dtype=np.float64)\n2597 |             return self._constructor(result, index=idx, name=self.name)\n2598 |         else:\n2599 |             # scalar\n2600 |             return result.iloc[0]\n```\n\nFound function `pandas/core/_numba/kernels/mean_.py:add_mean`.\nSource: Retrieved code content using keyword search (bm25).\n```\n25 | def add_mean(\n26 |     val: float,\n27 |     nobs: int,\n28 |     sum_x: float,\n29 |     neg_ct: int,\n30 |     compensation: float,\n31 |     num_consecutive_same_value: int,\n32 |     prev_value: float,\n33 | ) -> tuple[int, float, int, float, int, float]:\n34 |     if not np.isnan(val):\n35 |         nobs += 1\n36 |         y = val - compensation\n37 |         t = sum_x + y\n38 |         compensation = t - sum_x - y\n39 |         sum_x = t\n40 |         if val < 0:\n41 |             neg_ct += 1\n42 | \n43 |         if val == prev_value:\n44 |             num_consecutive_same_value += 1\n45 |         else:\n46 |             num_consecutive_same_value = 1\n47 |         prev_value = val\n48 | \n49 |     return nobs, sum_x, neg_ct, compensation, num_consecutive_same_value, prev_value\n```\n\n\n\n##Searching for term \"float_format csv writer write_csv float\"...\n### Search Result:\nFound function `pandas/io/json/_json.py:Writer.obj_to_write`.\nSource: Retrieved entity using keyword search (bm25).\n``