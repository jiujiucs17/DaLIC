orted\n662 |     @deprecated(  # type: ignore\n663 |         \"`calibrators_` is deprecated in 0.24 and will be removed in 1.1\"\n664 |         \"(renaming of 0.26). Use `calibrators` instead.\"\n665 |     )\n666 |     @property\n667 |     def calibrators_(self):\n668 |         return self.calibrators\n669 | \n670 |     def predict_proba(self, X):\n671 |         \"\"\"Calculate calibrated probabilities.\n672 | \n673 |         Calculates classification calibrated probabilities\n674 |         for each class, in a one-vs-all manner, for `X`.\n675 | \n676 |         Parameters\n677 |         ----------\n678 |         X : ndarray of shape (n_samples, n_features)\n679 |             The sample data.\n680 | \n681 |         Returns\n682 |         -------\n683 |         proba : array, shape (n_samples, n_classes)\n684 |             The predicted probabilities. Can be exact zeros.\n685 |         \"\"\"\n686 |         n_classes = len(self.classes)\n687 |         pred_method, method_name = _get_prediction_method(self.base_estimator)\n688 |         predictions = _compute_predictions(pred_method, method_name, X, n_classes)\n689 | \n690 |         label_encoder = LabelEncoder().fit(self.classes)\n691 |         pos_class_indices = label_encoder.transform(self.base_estimator.classes_)\n692 | \n693 |         proba = np.zeros((_num_samples(X), n_classes))\n694 |         for class_idx, this_pred, calibrator in zip(\n695 |             pos_class_indices, predictions.T, self.calibrators\n696 |         ):\n697 |             if n_classes == 2:\n698 |                 # When binary, `predictions` consists only of predictions for\n699 |                 # clf.classes_[1] but `pos_class_indices` = 0\n700 |                 class_idx += 1\n701 |             proba[:, class_idx] = calibrator.predict(this_pred)\n702 | \n703 |         # Normalize the probabilities\n704 |         if n_classes == 2:\n705 |             proba[:, 0] = 1.0 - proba[:, 1]\n706 |         else:\n707 |             denominator = np.sum(proba, axis=1)[:, np.newaxis]\n708 |             # In the edge case where for each class calibrator returns a null\n709 |             # probability for a given sample, use the uniform distribution\n710 |             # instead.\n711 |             uniform_proba = np.full_like(proba, 1 / n_classes)\n712 |             proba = np.divide(\n713 |                 proba, denominator, out=uniform_proba, where=denominator != 0\n714 |             )\n715 | \n716 |         # Deal with cases where the predicted probability minimally exceeds 1.0\n717 |         proba[(1.0 < proba) & (proba <= 1.0 + 1e-5)] = 1.0\n718 | \n719 |         return proba\n```\n\nFound function `examples/calibration/plot_calibration_curve.py:plot_calibration_curve`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 72 | def plot_calibration_curve(est, name, fig_index):\n 73 |     \"\"\"Plot calibration curve for est w/o and with calibration. \"\"\"\n 74 |     # Calibrated with isotonic calibration\n 75 |     isotonic = CalibratedClassifierCV(est, cv=2, method='isotonic')\n 76 | \n 77 |     # Calibrated with sigmoid calibration\n 78 |     sigmoid = CalibratedClassifierCV(est, cv=2, method='sigmoid')\n 79 | \n 80 |     # Logistic regression with no calibration as baseline\n 81 |     lr = LogisticRegression(C=1.)\n 82 | \n 83 |     fig = plt.figure(fig_index, figsize=(10, 10))\n 84 |     ax1 = plt.subplot2grid((3, 1), (0, 0), rowspan=2, fig=fig)\n 85 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\nFound file `sklearn/calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/calibration.py` for the full content if needed.\n"}, {"content": "Let me also search for visualization-related code since we're dealing with plotting.\n\n<function=search_code_snippets>\n<parameter=search_terms>['plot', 'matplotlib', 'visualization']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION: