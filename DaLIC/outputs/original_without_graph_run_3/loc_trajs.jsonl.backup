|         raise ValueError('Cannot return dataframe with sparse data')\n838 | \n839 |     # download data features, meta-info about column types\n840 |     features_list = _get_data_features(data_id, data_home)\n841 | \n842 |     if not as_frame:\n843 |         for feature in features_list:\n844 |             if 'true' in (feature['is_ignore'], feature['is_row_identifier']):\n845 |                 continue\n846 |             if feature['data_type'] == 'string':\n847 |                 raise ValueError('STRING attributes are not supported for '\n848 |                                  'array representation. Try as_frame=True')\n849 | \n850 |     if target_column == \"default-target\":\n851 |         # determines the default target based on the data feature results\n852 |         # (which is currently more reliable than the data description;\n853 |         # see issue: https://github.com/openml/OpenML/issues/768)\n854 |         target_columns = [feature['name'] for feature in features_list\n855 |                           if feature['is_target'] == 'true']\n856 |     elif isinstance(target_column, str):\n857 |         # for code-simplicity, make target_column by default a list\n858 |         target_columns = [target_column]\n859 |     elif target_column is None:\n860 |         target_columns = []\n861 |     elif isinstance(target_column, list):\n862 |         target_columns = target_column\n863 |     else:\n864 |         raise TypeError(\"Did not recognize type of target_column\"\n865 |                         \"Should be str, list or None. Got: \"\n866 |                         \"{}\".format(type(target_column)))\n867 |     data_columns = _valid_data_column_names(features_list,\n868 |                                             target_columns)\n869 | \n870 |     shape: Optional[Tuple[int, int]]\n871 |     # determine arff encoding to return\n872 |     if not return_sparse:\n873 |         # The shape must include the ignored features to keep the right indexes\n874 |         # during the arff data conversion.\n875 |         data_qualities = _get_data_qualities(data_id, data_home)\n876 |         shape = _get_num_samples(data_qualities), len(features_list)\n877 |     else:\n878 |         shape = None\n879 | \n880 |     # obtain the data\n881 |     url = _DATA_FILE.format(data_description['file_id'])\n882 |     bunch = _download_data_to_bunch(url, return_sparse, data_home,\n883 |                                     as_frame=as_frame,\n884 |                                     features_list=features_list, shape=shape,\n885 |                                     target_columns=target_columns,\n886 |                                     data_columns=data_columns)\n887 | \n888 |     if return_X_y:\n889 |         return bunch.data, bunch.target\n890 | \n891 |     description = \"{}\\n\\nDownloaded from openml.org.\".format(\n892 |         data_description.pop('description'))\n893 | \n894 |     bunch.update(\n895 |         DESCR=description, details=data_description,\n896 |         url=\"https://www.openml.org/d/{}\".format(data_id))\n897 | \n898 |     return bunch\n```\n\n\n\n##Searching for term \"md5_checksum\"...\n### Search Result:\nFound code snippet in file `sklearn/datasets/_rcv1.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"RCV1 dataset.\n  2 | \n  3 | The dataset page is available at\n  4 | \n  5 |     http://jmlr.csail.mit.edu/papers/volume5/lewis04a/\n  6 | \"\"\"\n  7 | \n  8 | # Author: Tom Dupre la Tour\n  9 | # License: BSD 3 clause\n 10 | \n 11 | import logging\n 12 | \n 13 | from os import remove, makedirs\n 14 | from os.path import dirname, exists, join\n 15 | from gzip import GzipFile\n 16 | \n 17 | import numpy as np\n 18 | import scipy.sparse as sp\n 19 | import joblib\n 20 | \n 21 | from . import get_data_home\n 22 | from ._base import _pkl_filepath\n 23 | from ._base import _fetch_remote\n 24 | from ._base import RemoteFileMetadata\n 25 | from ._svmlight_format_io import load_svmli