   data = _blobs_dataset(n_clusters=20)\n 75 | \n 76 |         return data\n 77 | \n 78 |     def make_estimator(self, params):\n 79 |         representation, init = params\n 80 | \n 81 |         max_iter = 5 if representation == \"sparse\" else 2\n 82 | \n 83 |         estimator = MiniBatchKMeans(\n 84 |             n_clusters=20,\n 85 |             init=init,\n 86 |             n_init=1,\n 87 |             max_iter=max_iter,\n 88 |             batch_size=1000,\n 89 |             max_no_improvement=None,\n 90 |             compute_labels=False,\n 91 |             random_state=0,\n 92 |         )\n 93 | \n 94 |         return estimator\n 95 | \n 96 |     def make_scorers(self):\n 97 |         self.train_scorer = lambda _, __: neg_mean_inertia(\n 98 |             self.X, self.estimator.predict(self.X), self.estimator.cluster_centers_\n 99 |         )\n100 |         self.test_scorer = lambda _, __: neg_mean_inertia(\n101 |             self.X_val,\n102 |             self.estimator.predict(self.X_val),\n103 |             self.estimator.cluster_centers_,\n104 |         )\n```\n\nFound function `sklearn/utils/validation.py:_generate_get_feature_names_out`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1918 | def _generate_get_feature_names_out(estimator, n_features_out, input_features=None):\n1919 |     \"\"\"Generate feature names out for estimator using the estimator name as the prefix.\n1920 | \n1921 |     The input_feature names are validated but not used. This function is useful\n1922 |     for estimators that generate their own names based on `n_features_out`, i.e. PCA.\n1923 | \n1924 |     Parameters\n1925 |     ----------\n1926 |     estimator : estimator instance\n1927 |         Estimator producing output feature names.\n1928 | \n1929 |     n_feature_out : int\n1930 |         Number of feature names out.\n1931 | \n1932 |     input_features : array-like of str or None, default=None\n1933 |         Only used to validate feature names with `esti