n of parameters\"\"\"\n133 |         pass\n134 | \n135 |     def skip(self, params):\n136 |         \"\"\"Return True if the benchmark should be skipped for these params\"\"\"\n137 |         return False\n138 | \n139 |     def setup_cache(self):\n140 |         \"\"\"Pickle a fitted estimator for all combinations of parameters\"\"\"\n141 |         # This is run once per benchmark class.\n142 | \n143 |         clear_tmp()\n144 | \n145 |         param_grid = list(itertools.product(*self.params))\n146 | \n147 |         for params in param_grid:\n148 |             if self.skip(params):\n149 |                 continue\n150 | \n151 |             estimator = self.make_estimator(params)\n152 |             X, _, y, _ = self.make_data(params)\n153 | \n154 |             estimator.fit(X, y)\n155 | \n156 |             est_path = get_estimator_path(\n157 |                 self, Benchmark.save_dir, params, Benchmark.save_estimators\n158 |             )\n159 |             with est_path.open(mode=\"wb\") as f:\n160 |                 pickle.dump(estimator, f)\n161 | \n162 |     def setup(self, *params):\n163 |         \"\"\"Generate dataset and load the fitted estimator\"\"\"\n164 |         # This is run once per combination of parameters and per repeat so we\n165 |         # need to avoid doing expensive operations there.\n166 | \n167 |         if self.skip(params):\n168 |             raise NotImplementedError\n169 | \n170 |         self.X, self.X_val, self.y, self.y_val = self.make_data(params)\n171 | \n172 |         est_path = get_estimator_path(\n173 |             self, Benchmark.save_dir, params, Benchmark.save_estimators\n174 |         )\n175 |         with est_path.open(mode=\"rb\") as f:\n176 |             self.estimator = pickle.load(f)\n177 | \n178 |         self.make_scorers()\n179 | \n180 |     def time_fit(self, *args):\n181 |         self.estimator.fit(self.X, self.y)\n182 | \n183 |     def peakmem_fit(self, *args):\n184 |         self.estimator.fit(self.X, self.y)\n185 