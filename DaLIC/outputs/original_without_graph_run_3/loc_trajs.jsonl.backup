e of the docstring.\n32 | \n33 |         Modified based on the part of processing docstrings in the original\n34 |         implementation of this method.\n35 | \n36 |         https://github.com/sphinx-doc/sphinx/blob/faa33a53a389f6f8bc1f6ae97d6015fa92393c4a/sphinx/ext/autodoc/__init__.py#L609-L622\n37 |         \"\"\"\n38 |         sourcename = self.get_sourcename()\n39 |         docstrings = self.get_doc()\n40 | \n41 |         if docstrings is not None:\n42 |             if not docstrings:\n43 |                 docstrings.append([])\n44 |             # Get the first non-empty line of the processed docstring; this could lead\n45 |             # to unexpected results if the object does not have a short summary line.\n46 |             short_summary = next(\n47 |                 (s for s in self.process_doc(docstrings) if s), \"<no summary>\"\n48 |             )\n49 |             self.add_line(short_summary, sourcename, 0)\n```\n\nFound function `doc/sphinxext/autoshortsummary.py:setup`.\nSource: Retrieved code content using keyword search (bm25).\n```\n52 | def setup(app):\n53 |     app.add_autodocumenter(ShortSummaryDocumenter)\n```\n\nFound function `doc/api_reference.py:_get_submodule`.\nSource: Retrieved code content using keyword search (bm25).\n```\n21 | def _get_submodule(module_name, submodule_name):\n22 |     \"\"\"Get the submodule docstring and automatically add the hook.\n23 | \n24 |     `module_name` is e.g. `sklearn.feature_extraction`, and `submodule_name` is e.g.\n25 |     `image`, so we get the docstring and hook for `sklearn.feature_extraction.image`\n26 |     submodule. `module_name` is used to reset the current module because autosummary\n27 |     automatically changes the current module.\n28 |     \"\"\"\n29 |     lines = [\n30 |         f\".. automodule:: {module_name}.{submodule_name}\",\n31 |         f\".. currentmodule:: {module_name}\",\n32 |     ]\n33 |     return \"\\n\\n\".join(lines)\n```\n\n\n\n##Searching for term \"assert_consistent_do