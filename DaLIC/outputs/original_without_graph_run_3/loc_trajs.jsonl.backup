ct of parameter constraints is set as an attribute of the function\n181 |         # to make it possible to dynamically introspect the constraints for\n182 |         # automatic testing.\n183 |         setattr(func, \"_skl_parameter_constraints\", parameter_constraints)\n184 | \n185 |         @functools.wraps(func)\n186 |         def wrapper(*args, **kwargs):\n187 |             global_skip_validation = get_config()[\"skip_parameter_validation\"]\n188 |             if global_skip_validation:\n189 |                 return func(*args, **kwargs)\n190 | \n191 |             func_sig = signature(func)\n192 | \n193 |             # Map *args/**kwargs to the function signature\n194 |             params = func_sig.bind(*args, **kwargs)\n195 |             params.apply_defaults()\n196 | \n197 |             # ignore self/cls and positional/keyword markers\n198 |             to_ignore = [\n199 |                 p.name\n200 |                 for p in func_sig.parameters.values()\n201 |                 if p.kind in (p.VAR_POSITIONAL, p.VAR_KEYWORD)\n202 |             ]\n203 |             to_ignore += [\"self\", \"cls\"]\n204 |             params = {k: v for k, v in params.arguments.items() if k not in to_ignore}\n205 | \n206 |             validate_parameter_constraints(\n207 |                 parameter_constraints, params, caller_name=func.__qualname__\n208 |             )\n209 | \n210 |             try:\n211 |                 with config_context(\n212 |                     skip_parameter_validation=(\n213 |                         prefer_skip_nested_validation or global_skip_validation\n214 |                     )\n215 |                 ):\n216 |                     return func(*args, **kwargs)\n217 |             except InvalidParameterError as e:\n218 |                 # When the function is just a wrapper around an estimator, we allow\n219 |                 # the function to delegate validation to the estimator, but we replace\n220 |                 # the name of the estimator by the name of the function in the error\n221 |                 # message to avoid confusion.\n222 |                 msg = re.sub(\n223 |                     r\"parameter of \\w+ must be\",\n224 |                     f\"parameter of {func.__qualname__} must be\",\n225 |                     str(e),\n226 |                 )\n227 |                 raise InvalidParameterError(msg) from e\n228 | \n229 |         return wrapper\n230 | \n231 |     return decorator\n```\n\nFound file `sklearn/metrics/cluster/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/metrics/cluster/__init__.py` for the full content if needed.\n"}, {"content": "Let me look at the utilities directory to see if there's any validation-related code:\n\n<function=search_code_snippets>\n<parameter=search_terms>['docstring', 'parameters', 'returns']</parameter>\n<parameter=file_path_or_pattern>sklearn/utils/**/*.py</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\ndoc/sphinxext/autoshortsummary.py:ShortSummaryDocumenter.add_content\ndoc/sphinxext/autoshortsummary.py:setup\ndoc/api_reference.py:_get_submodule\nexamples/miscellaneous/plot_anomaly_comparison.py:docstring:9\nexamples/miscellaneous/plot_anomaly_comparison.py:docstring:2\nsklearn/gaussian_process/kernels.py:Kernel.get_params\nsklearn/utils/validation.py:has_fit_parameter\nsklearn/pipeline.py:Pipeline.set_params\nsklearn/pipeline.py:FeatureUnion.set_params\nsklearn/ensemble/_base.py:_BaseHeterogeneousEnsemble.get_params\nsklearn/base.py:BaseEstimator._get_param_names\nsklearn/model_selection/_search.py:ParameterGrid\nsklearn/compose/_column_transformer.py:ColumnTransformer.set_params\nsklearn/utils/validation.py:check_scalar\nsklearn/ensemble/_base.py:_BaseHeterogeneousEnsemble.set_params\nsklearn/utils/_param_validation.py:generate_valid_param\nsklearn/utils/validation.py:_is_p