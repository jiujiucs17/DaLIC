5).\n```\n 1 | \"\"\"\n 2 | ==================\n 3 | ggplot style sheet\n 4 | ==================\n 5 | \n 6 | This example demonstrates the \"ggplot\" style, which adjusts the style to\n 7 | emulate ggplot_ (a popular plotting package for R_).\n 8 | \n 9 | These settings were shamelessly stolen from [1]_ (with permission).\n10 | \n11 | .. [1] https://everyhue.me/posts/sane-color-scheme-for-matplotlib/\n12 | \n13 | .. _ggplot: https://ggplot2.tidyverse.org/\n14 | .. _R: https://www.r-project.org/\n15 | \n16 | \"\"\"\n17 | import matplotlib.pyplot as plt\n18 | import numpy as np\n19 | \n20 | plt.style.use('ggplot')\n21 | \n22 | # Fixing random state for reproducibility\n23 | np.random.seed(19680801)\n24 | \n25 | fig, axs = plt.subplots(ncols=2, nrows=2)\n26 | ax1, ax2, ax3, ax4 = axs.flat\n27 | \n28 | # scatter plot (Note: `plt.scatter` doesn't use default colors)\n29 | x, y = np.random.normal(size=(2, 200))\n30 | ax1.plot(x, y, 'o')\n31 | \n32 | # sinusoidal lines with colors from default color cycle\n33 | L = 2*np.pi\n34 | x = np.linspace(0, L)\n35 | ncolors = len(plt.rcParams['axes.prop_cycle'])\n36 | shift = np.linspace(0, L, ncolors, endpoint=False)\n37 | for s in shift:\n38 |     ax2.plot(x, np.sin(x + s), '-')\n39 | ax2.margins(0)\n40 | \n41 | # bar graphs\n42 | x = np.arange(5)\n43 | y1, y2 = np.random.randint(1, 25, size=(2, 5))\n44 | width = 0.25\n45 | ax3.bar(x, y1, width)\n46 | ax3.bar(x + width, y2, width,\n47 |         color=list(plt.rcParams['axes.prop_cycle'])[2]['color'])\n48 | ax3.set_xticks(x + width, labels=['a', 'b', 'c', 'd', 'e'])\n49 | \n50 | # circles with colors from default color cycle\n51 | for i, color in enumerate(plt.rcParams['axes.prop_cycle']):\n52 |     xy = np.random.normal(size=2)\n53 |     ax4.add_patch(plt.Circle(xy, radius=0.3, color=color['color']))\n54 | ax4.axis('equal')\n55 | ax4.margins(0)\n56 | \n57 | plt.show()\n58 | \n```\n\nFound code snippet in file `galleries/examples/axisartist/demo_floating_axes.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ==========================\n  3 | ``floating_axes`` features\n  4 | ==========================\n  5 | \n  6 | Demonstration of features of the :mod:`.floating_axes` module:\n  7 | \n  8 | * Using `~.axes.Axes.scatter` and `~.axes.Axes.bar` with changing the shape of\n  9 |   the plot.\n 10 | * Using `~.floating_axes.GridHelperCurveLinear` to rotate the plot and set the\n 11 |   plot boundary.\n 12 | * Using `~.Figure.add_subplot` to create a subplot using the return value from\n 13 |   `~.floating_axes.GridHelperCurveLinear`.\n 14 | * Making a sector plot by adding more features to\n 15 |   `~.floating_axes.GridHelperCurveLinear`.\n 16 | \"\"\"\n 17 | \n 18 | import matplotlib.pyplot as plt\n 19 | import numpy as np\n 20 | \n 21 | from matplotlib.projections import PolarAxes\n 22 | from matplotlib.transforms import Affine2D\n 23 | import mpl_toolkits.axisartist.angle_helper as angle_helper\n 24 | import mpl_toolkits.axisartist.floating_axes as floating_axes\n 25 | from mpl_toolkits.axisartist.grid_finder import (DictFormatter, FixedLocator,\n 26 |                                                  MaxNLocator)\n 27 | \n 28 | # Fixing random state for reproducibility\n 29 | np.random.seed(19680801)\n```\n\nFound code snippet in file `galleries/examples/style_sheets/style_sheets_reference.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ======================\n  3 | Style sheets reference\n  4 | ======================\n  5 | \n  6 | This script demonstrates the different available style sheets on a\n  7 | common set of example plots: scatter plot, image, bar graph, patches,\n  8 | line plot and histogram.\n  9 | \n 10 | Any of these style sheets can be imported (i.e. activated) by its name.\n 11 | For example for the ggplot style:\n 12 | \n 13 | >>> plt.style.use('ggplot')\n 14 | \n 15 | The names of the available style sheets can be found\n 16 | in the list `matplotlib.style.available`\n 17 | (they are also printed in the corner of each plot below).\n 18 | \n 19 | See more details in :ref:`Customizing Matplotlib\n 20 | using style sheets<customizing-with-style-sheets>`.\n 21 | \"\"\"\n 22 | \n 23 | import matplotlib.pyplot as plt\n 24 | import numpy as np\n 25 | \n 26 | import matplotlib.colors as mcolors\n 27 | from matplotlib.patches import Rectangle\n 28 | \n 29 | # Fixing random state for reproducibility\n 30 | np.random.seed(19680801)\n```\n\nFound function `galleries/examples/axisartist/demo_floating_axes.py:setup_axes3`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 91 | def setup_axes3(fig, rect):\n 92 |     \"\"\"\n 93 |     Sometimes, things like axis_direction need to be adjusted.\n 94 |     \"\"\"\n 95 | \n 96 |     # rotate a bit for better orientation\n 97 |     tr_rotate = Affine2D().translate(-95, 0)\n 98 | \n 99 |     # scale degree to radians\n100 |     tr_scale = Affine2D().scale(np.pi/180., 1.)\n101 | \n102 |     tr = tr_rotate + tr_scale + PolarAxes.PolarTransform(\n103 |         apply_theta_transforms=False)\n104 | \n105 |     grid_locator1 = angle_helper.LocatorHMS(4)\n106 |     tick_formatter1 = angle_helper.FormatterHMS()\n107 | \n108 |     grid_locator2 = MaxNLocator(3)\n109 | \n110 |     # Specify theta limits in degrees\n111 |     ra0, ra1 = 8.*15, 14.*15\n112 |     # Specify radial limits\n113 |     cz0, cz1 = 0, 14000\n114 |     grid_helper = floating_axes.GridHelperCurveLinear(\n115 |         tr, extremes=(ra0, ra1, cz0, cz1),\n116 |         grid_locator1=grid_locator1,\n117 |         grid_locator2=grid_locator2,\n118 |         tick_formatter1=tick_formatter1,\n119 |         tick_formatter2=None)\n120 | \n121 |     ax1 = fig.add_subplot(\n122 |         rect, axes_class=floating_axes.FloatingAxes, grid_helper=grid_helper)\n123 | \n124 |     # adjust axis\n125 |     ax1.axis[\"left\"].set_axis_direction(\"bottom\")\n126 |     ax1.axis[\"right\"].set_axis_direction(\"top\")\n127 | \n128 |     ax1.axis[\"bottom\"].set_visible(False)\n129 |     ax1.axis[\"top\"].set_axis_direction(\"bottom\")\n130 |     ax1.axis[\"top\"].toggle(ticklabels=True, label=True)\n131 |     ax1.axis[\"top\"].major_ticklabels.set_axis_direction(\"top\")\n132 |     ax1.axis[\"top\"].label.set_axis_direction(\"top\")\n133 | \n134 |     ax1.axis[\"left\"].label.set_text(r\"cz [km$^{-1}$]\")\n135 |     ax1.axis[\"top\"].label.set_text(r\"$\\alpha_{1950}$\")\n136 |     ax1.grid()\n137 | \n138 |     # create a parasite Axes whose transData in RA, cz\n139 |     aux_ax = ax1.get_aux_axes(tr)\n140 | \n141 |     aux_ax.patch = ax1.patch  # for aux_ax to have a clip path as in ax\n142 |     ax1.patch.zorder = 0.9  # but this has a side effect that the patch is\n143 |     # drawn twice, and possibly over some other\n144 |     # artists. So, we decrease the zorder a bit to\n145 |     # prevent this.\n146 | \n147 |     return ax1, aux_ax\n```\n\nFound function `galleries/users_explain/animations/animations.py:update`.\nSource: Retrieved code content using keyword search (bm25).\n```\n118 | def update(frame):\n119 |     # for each frame, update the data stored on each artist.\n120 |     x = t[:frame]\n121 |     y = z[:frame]\n122 |     # update the scatter plot:\n123 |     data = np.stack([x, y]).T\n124 |     scat.set_offsets(data)\n125 |     # update the line plot:\n126 |     line2.set_xdata(t[:frame])\n127 |     line2.set_ydata(z2[:frame])\n128 |     return (scat, line2)\n```\n"}, {"content": "Let me analyze the issue and locate the relevant code:\n\n1. The issue requests changes to the `bar()` function to:\n   - Make `facecolor` accept sequences\n   - Improve parameter precedence rules similar to `scatter()`\n   - Current issues:\n     - `facecolor` cannot take a sequence\n     - No plural alias (`edgecolors`) exists\n     - Parameter precedence needs adjustment\n\n2. Let me examine the key files and functions involved based on the search results:\n\n<function=get_ent