ould appear as 0, or if some values are too big and take too\n1427 |         # much space\n1428 | \n1429 |         if len(formatted_values) > 0:\n1430 |             maxlen = max(len(x) for x in formatted_values)\n1431 |             too_long = maxlen > self.digits + 6\n1432 |         else:\n1433 |             too_long = False\n1434 | \n1435 |         abs_vals = np.abs(self.values)\n1436 |         # this is pretty arbitrary for now\n1437 |         # large values: more that 8 characters including decimal symbol\n1438 |         # and first digit, hence > 1e6\n1439 |         has_large_values = (abs_vals > 1e6).any()\n1440 |         has_small_values = ((abs_vals < 10 ** (-self.digits)) & (abs_vals > 0)).any()\n1441 | \n1442 |         if has_small_values or (too_long and has_large_values):\n1443 |             if self.leading_space is True:\n1444 |                 fmt_str = \"{value: .{digits:d}e}\"\n1445 |             else:\n1446 |                 fmt_str = \"{value:.{digits:d}e}\"\n1447 |             float_format = partial(fmt_str.format, digits=self.digits)\n1448 |             formatted_values = format_values_with(float_format)\n1449 | \n1450 |         return formatted_values\n```\n\nFound function `pandas/io/formats/csvs.py:CSVFormatter.float_format`.\nSource: Retrieved entity using keyword search (bm25).\n```\n106 | def float_format(self) -> FloatFormatType | None:\n107 |         return self.fmt.float_format\n```\n\nFound function `pandas/io/formats/format.py:_GenericArrayFormatter._format_strings`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1180 | def _format_strings(self) -> list[str]:\n1181 |         if self.float_format is None:\n1182 |             float_format = get_option(\"display.float_format\")\n1183 |             if float_format is None:\n1184 |                 precision = get_option(\"display.precision\")\n1185 |                 float_format = lambda x: _trim_zeros_single_float(\n1186 |                     f\"{x: .{precision:d}f}\"\n1