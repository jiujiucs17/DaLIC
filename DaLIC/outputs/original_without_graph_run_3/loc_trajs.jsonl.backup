else other._range\n729 | \n730 |         # check whether intervals intersect\n731 |         # deals with in- and decreasing ranges\n732 |         int_low = max(first.start, second.start)\n733 |         int_high = min(first.stop, second.stop)\n734 |         if int_high <= int_low:\n735 |             return self._simple_new(_empty_range)\n736 | \n737 |         # Method hint: linear Diophantine equation\n738 |         # solve intersection problem\n739 |         # performance hint: for identical step sizes, could use\n740 |         # cheaper alternative\n741 |         gcd, s, _ = self._extended_gcd(first.step, second.step)\n742 | \n743 |         # check whether element sets intersect\n744 |         if (first.start - second.start) % gcd:\n745 |             return self._simple_new(_empty_range)\n746 | \n747 |         # calculate parameters for the RangeIndex describing the\n748 |         # intersection disregarding the lower bounds\n749 |         tmp_start = first.start + (second.start - first.start) * first.step // gcd * s\n750 |         new_step = first.step * second.step // gcd\n751 | \n752 |         # adjust index to limiting interval\n753 |         new_start = min_fitting_element(tmp_start, new_step, int_low)\n754 |         new_range = range(new_start, int_high, new_step)\n755 | \n756 |         if (self.step < 0 and other.step < 0) is not (new_range.step < 0):\n757 |             new_range = new_range[::-1]\n758 | \n759 |         return self._simple_new(new_range)\n```\n\n\n\n##Searching for term \"Type hints\", \"Type hints DataFrame.squeeze\"...\n### Search Result:\nFound function `pandas/core/common.py:pipe`.\nSource: Retrieved code content using keyword search (bm25).\n```\n491 | def pipe(\n492 |     obj: _T,\n493 |     func: Callable[Concatenate[_T, P], T] | tuple[Callable[..., T], str],\n494 |     *args: Any,\n495 |     **kwargs: Any,\n496 | ) -> T:\n497 |     \"\"\"\n498 |     Apply a function ``func`` to object ``obj`` either by passing obj as the\n499 |     first argument to the function or, in the case that the func is a tuple,\n500 |     interpret the first element of the tuple as a function and pass the obj to\n501 |     that function as a keyword argument whose key is the value of the second\n502 |     element of the tuple.\n503 | \n504 |     Parameters\n505 |     ----------\n506 |     func : callable or tuple of (callable, str)\n507 |         Function to apply to this object or, alternatively, a\n508 |         ``(callable, data_keyword)`` tuple where ``data_keyword`` is a\n509 |         string indicating the keyword of ``callable`` that expects the\n510 |         object.\n511 |     *args : iterable, optional\n512 |         Positional arguments passed into ``func``.\n513 |     **kwargs : dict, optional\n514 |         A dictionary of keyword arguments passed into ``func``.\n515 | \n516 |     Returns\n517 |     -------\n518 |     object : the return type of ``func``.\n519 |     \"\"\"\n520 |     if isinstance(func, tuple):\n521 |         # Assigning to func_ so pyright understands that it's a callable\n522 |         func_, target = func\n523 |         if target in kwargs:\n524 |             msg = f\"{target} is both the pipe target and a keyword argument\"\n525 |             raise ValueError(msg)\n526 |         kwargs[target] = obj\n527 |         return func_(*args, **kwargs)\n528 |     else:\n529 |         return func(obj, *args, **kwargs)\n```\n\nFound file `pandas/api/typing/__init__.py`.\nFound file `pandas/api/types/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"DataFrame.squeeze\", \"Type hints DataFrame.squeeze\"...\n### Search Result:\nFound function `pandas/core/generic.py:NDFrame.squeeze`.\nSource: Match found for entity name `squeeze`.\n```\n841 | def squeeze(self, axis: Axis | None = None):\n842 |         \"\"\"\n843 |         Squeeze 1 dimensional axis objects into scalars.\n844 | \n845 |         Series or DataFrames with a single element are squeezed to a scalar.\n846 |         DataFrames with a single column or a single row are squeezed to a\n847 |         Series. Otherwise the object is unchanged.\n848 | \n849 |         This method is most useful when you don't know if your\n850 |         object is a Series or DataFrame, but you do know it has just a single\n851 |         column. In that case you can safely call `squeeze` to ensure you have a\n852 |         Series.\n853 | \n854 |         Parameters\n855 |         ----------\n856 |         axis : {0 or 'index', 1 or 'columns', None}, default None\n857 |             A specific axis to squeeze. By default, all length-1 axes are\n858 |             squeezed. For `Series` this parameter is unused and defaults to `None`.\n859 | \n860 |         Returns\n861 |         -------\n862 |         DataFrame, Series, or scalar\n863 |             The projection after squeezing `axis` or all the axes.\n864 | \n865 |         See Also\n866 |         --------\n867 |         Series.iloc : Integer-location based indexing for selecting scalars.\n868 |         DataFrame.iloc : Integer-location based indexing for selecting Series.\n869 |         Series.to_frame : Inverse of DataFrame.squeeze for a\n870 |             single-column DataFrame.\n871 | \n872 |         Examples\n873 |         --------\n874 |         >>> primes = pd.Series([2, 3, 5, 7])\n875 | \n876 |         Slicing might produce a Series with a single value:\n877 | \n878 |         >>> even_primes = primes[primes % 2 == 0]\n879 |         >>> even_primes\n880 |         0    2\n881 |         dtype: int64\n882 | \n883 |         >>> even_primes.squeeze()\n884 |         2\n885 | \n886 |         Squeezing objects with more than one value in every axis does nothing:\n887 | \n888 |         >>> odd_primes = primes[primes % 2 == 1]\n889 |         >>> odd_primes\n890 |         1    3\n891 |         2    5\n892 |         3    7\n893 |         dtype: int64\n894 | \n895 |         >>> odd_primes.squeeze()\n896 |         1    3\n897 |         2    5\n898 |         3    7\n899 |         dtype: int64\n900 | \n901 |         Squeezing is even more effective when used with DataFrames.\n902 | \n903 |         >>> df = pd.DataFrame([[1, 2], [3, 4]], columns=[\"a\", \"b\"])\n904 |         >>> df\n905 |            a  b\n906 |         0  1  2\n907 |         1  3  4\n908 | \n909 |         Slicing a single column will produce a DataFrame with the columns\n910 |         having only one value:\n911 | \n912 |         >>> df_a = df[[\"a\"]]\n913 |         >>> df_a\n914 |            a\n915 |         0  1\n916 |         1  3\n917 | \n918 |         So the columns can be squeezed down, resulting in a Series:\n919 | \n920 |         >>> df_a.squeeze(\"columns\")\n921 |         0    1\n922 |         1    3\n923 |         Name: a, dtype: int64\n924 | \n925 |         Slicing a single row from a single column will produce a single\n926 |         scalar DataFrame:\n927 | \n928 |         >>> df_0a = df.loc[df.index < 1, [\"a\"]]\n929 |         >>> df_0a\n930 |            a\n931 |         0  1\n932 | \n933 |         Squeezing the rows produces a single scalar Series:\n934 | \n935 |         >>> df_0a.squeeze(\"rows\")\n936 |         a    1\n937 |         Name: 0, dtype: int64\n938 | \n939 |         Squeezing all axes will project directly into a scalar:\n940 | \n941 |         >>> df_0a.squeeze()\n942 |         1\n943 |         \"\"\"\n944 |         axes = range(self._AXIS_LEN) if axis is None else (self._get_axis_number(axis),)\n945 |         result = self.iloc[\n946 |             tuple(\n947 |                 0 if i in axes and len(a) == 1 else slice(None)\n948 |                 for i, a in enumerate(self.axes)\n949 |             )\n950 |         ]\n951 |         if isinstance(result, NDFrame):\n952 |             result = result.__finalize__(self, method=\"squeeze\")\n953 |         return result\n```\n\nFound function `pandas/core/generic.py:NDFrame.rename_axis