443 |         decimal: str = \".\",\n444 |         bold_rows: bool = False,\n445 |         escape: bool = True,\n446 |     ) -> None:\n447 |         self.frame = frame\n448 |         self.columns = self._initialize_columns(columns)\n449 |         self.col_space = self._initialize_colspace(col_space)\n450 |         self.header = header\n451 |         self.index = index\n452 |         self.na_rep = na_rep\n453 |         self.formatters = self._initialize_formatters(formatters)\n454 |         self.justify = self._initialize_justify(justify)\n455 |         self.float_format = float_format\n456 |         self.sparsify = self._initialize_sparsify(sparsify)\n457 |         self.show_index_names = index_names\n458 |         self.decimal = decimal\n459 |         self.bold_rows = bold_rows\n460 |         self.escape = escape\n461 |         self.max_rows = max_rows\n462 |         self.min_rows = min_rows\n463 |         self.max_cols = max_cols\n464 |         self.show_dimensions = show_dimensions\n465 | \n466 |         self.max_cols_fitted = self._calc_max_cols_fitted()\n467 |         self.max_rows_fitted = self._calc_max_rows_fitted()\n468 | \n469 |         self.tr_frame = self.frame\n470 |         self.truncate()\n471 |         self.adj = printing.get_adjustment()\n472 | \n473 |     def get_strcols(self) -> list[list[str]]:\n474 |         \"\"\"\n475 |         Render a DataFrame to a list of columns (as lists of strings).\n476 |         \"\"\"\n477 |         strcols = self._get_strcols_without_index()\n478 | \n479 |         if self.index:\n480 |             str_index = self._get_formatted_index(self.tr_frame)\n481 |             strcols.insert(0, str_index)\n482 | \n483 |         return strcols\n484 | \n485 |     @property\n486 |     def should_show_dimensions(self) -> bool:\n487 |         return self.show_dimensions is True or (\n488 |             self.show_dimensions == \"truncate\" and self.is_truncated\n489 |         )\n490 | \n491 |     @property\n492 |     def is_truncated(self) -> bool:\n493 |         return bool(self.is_truncated_horizontally or self.is_truncated_vertically)\n494 | \n495 |     @property\n496 |     def is_truncated_horizontally(self) -> bool:\n497 |         return bool(self.max_cols_fitted and (len(self.columns) > self.max_cols_fitted))\n498 | \n499 |     @property\n500 |     def is_truncated_vertically(self) -> bool:\n501 |         return bool(self.max_rows_fitted and (len(self.frame) > self.max_rows_fitted))\n502 | \n503 |     @property\n504 |     def dimensions_info(self) -> str:\n505 |         return f\"\\n\\n[{len(self.frame)} rows x {len(self.frame.columns)} columns]\"\n506 | \n507 |     @property\n508 |     def has_index_names(self) -> bool:\n509 |         return _has_names(self.frame.index)\n510 | \n511 |     @property\n512 |     def has_column_names(self) -> bool:\n513 |         return _has_names(self.frame.columns)\n514 | \n515 |     @property\n516 |     def show_row_idx_names(self) -> bool:\n517 |         return all((self.has_index_names, self.index, self.show_index_names))\n518 | \n519 |     @property\n520 |     def show_col_idx_names(self) -> bool:\n521 |         return all((self.has_column_names, self.show_index_names, self.header))\n522 | \n523 |     @property\n524 |     def max_rows_displayed(self) -> int:\n525 |         return min(self.max_rows or len(self.frame), len(self.frame))\n526 | \n527 |     def _initialize_sparsify(self, sparsify: bool | None) -> bool:\n528 |         if sparsify is None:\n529 |             return get_option(\"display.multi_sparse\")\n530 |         return sparsify\n531 | \n532 |     def _initialize_formatters(\n533 |         self, formatters: FormattersType | None\n534 |     ) -> FormattersType:\n535 |         if formatters is None:\n536 |             return {}\n537 |         elif len(self.frame.columns) == len(formatters) or isinstance(formatters, dict):\n538 |             return formatters\n539 |         else:\n540 |             raise ValueError(\n541 |                 f