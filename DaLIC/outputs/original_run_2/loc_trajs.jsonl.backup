BSD 3 clause\n 28 | \n 29 | from time import time\n 30 | import matplotlib.pyplot as plt\n 31 | \n 32 | from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\n 33 | from sklearn.decomposition import NMF, LatentDirichletAllocation\n 34 | from sklearn.datasets import fetch_20newsgroups\n 35 | \n 36 | n_samples = 2000\n 37 | n_features = 1000\n 38 | n_components = 10\n 39 | n_top_words = 20\n```\n\nFound function `sklearn/decomposition/_nmf.py:_fit_coordinate_descent`.\nSource: Retrieved code content using keyword search (bm25).\n```\n417 | def _fit_coordinate_descent(\n418 |     X,\n419 |     W,\n420 |     H,\n421 |     tol=1e-4,\n422 |     max_iter=200,\n423 |     l1_reg_W=0,\n424 |     l1_reg_H=0,\n425 |     l2_reg_W=0,\n426 |     l2_reg_H=0,\n427 |     update_H=True,\n428 |     verbose=0,\n429 |     shuffle=False,\n430 |     random_state=None,\n431 | ):\n432 |     \"\"\"Compute Non-negative Matrix Factorization (NMF) with Coordinate Descent\n433 | \n434 |     The objective function is minimized with an alternating minimization of W\n435 |     and H. Each minimization is done with a cyclic (up to a permutation of the\n436 |     features) Coordinate Descent.\n437 | \n438 |     Parameters\n439 |     ----------\n440 |     X : array-like of shape (n_samples, n_features)\n441 |         Constant matrix.\n442 | \n443 |     W : array-like of shape (n_samples, n_components)\n444 |         Initial guess for the solution.\n445 | \n446 |     H : array-like of shape (n_components, n_features)\n447 |         Initial guess for the solution.\n448 | \n449 |     tol : float, default=1e-4\n450 |         Tolerance of the stopping condition.\n451 | \n452 |     max_iter : int, default=200\n453 |         Maximum number of iterations before timing out.\n454 | \n455 |     l1_reg_W : float, default=0.\n456 |         L1 regularization parameter for W.\n457 | \n458 |     l1_reg_H : float, default=0.\n459 |         L1 regularization parameter for H.\n460 | \n461 |     l2_reg_W : float, default=0.\n462 |         L2 regularization parameter for W.\n463 | \n464 |     l2_reg_H : float, default=0.\n465 |         L2 regularization parameter for H.\n466 | \n467 |     update_H : bool, default=True\n468 |         Set to True, both W and H will be estimated from initial guesses.\n469 |         Set to False, only W will be estimated.\n470 | \n471 |     verbose : int, default=0\n472 |         The verbosity level.\n473 | \n474 |     shuffle : bool, default=False\n475 |         If true, randomize the order of coordinates in the CD solver.\n476 | \n477 |     random_state : int, RandomState instance or None, default=None\n478 |         Used to randomize the coordinates in the CD solver, when\n479 |         ``shuffle`` is set to ``True``. Pass an int for reproducible\n480 |         results across multiple function calls.\n481 |         See :term:`Glossary <random_state>`.\n482 | \n483 |     Returns\n484 |     -------\n485 |     W : ndarray of shape (n_samples, n_components)\n486 |         Solution to the non-negative least squares problem.\n487 | \n488 |     H : ndarray of shape (n_components, n_features)\n489 |         Solution to the non-negative least squares problem.\n490 | \n491 |     n_iter : int\n492 |         The number of iterations done by the algorithm.\n493 | \n494 |     References\n495 |     ----------\n496 |     Cichocki, Andrzej, and Phan, Anh-Huy. \"Fast local algorithms for\n497 |     large scale nonnegative matrix and tensor factorizations.\"\n498 |     IEICE transactions on fundamentals of electronics, communications and\n499 |     computer sciences 92.3: 708-721, 2009.\n500 |     \"\"\"\n501 |     # so W and Ht are both in C order in memory\n502 |     Ht = check_array(H.T, order=\"C\")\n503 |     X = check_array(X, accept_sparse=\"csr\")\n504 | \n505 |     rng = check_random_state(random_state)\n506 | \n507 |     for n_iter in range(1, max_iter + 1):\n508 |         violation = 0.0\n509 | \n510 |         # Update W\n511 |         violation += _update_coordinate_descent(\n512 |             X, W, Ht, l1_reg_W, l2_reg_W, shuffle, rng\n513 |         )\n514 |         # Update H\n515 |         if update_H:\n516 |             violation += _update_coordinate_descent(\n517 |                 X.T, Ht, W, l1_reg_H, l2_reg_H, shuffle, rng\n518 |             )\n519 | \n520 |         if n_iter == 1:\n521 |             violation_init = violation\n522 | \n523 |         if violation_init == 0:\n524 |             break\n525 | \n526 |         if verbose:\n527 |             print(\"violation:\", violation / violation_init)\n528 | \n529 |         if violation / violation_init <= tol:\n530 |             if verbose:\n531 |                 print(\"Converged at iteration\", n_iter + 1)\n532 |             break\n533 | \n534 |     return W, Ht.T, n_iter\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_fit_non_negative`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3517 | def check_fit_non_negative(name, estimator_orig):\n3518 |     # Check that proper warning is raised for non-negative X\n3519 |     # when tag requires_positive_X is present\n3520 |     X = np.array([[-1.0, 1], [-1.0, 1]])\n3521 |     y = np.array([1, 2])\n3522 |     estimator = clone(estimator_orig)\n3523 |     with raises(ValueError):\n3524 |         estimator.fit(X, y)\n```\n\n\n\n##Searching for term \"non-negative matrix factorization\", \"MiniBatchNMF non-negative matrix factorization online beta divergence\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:non_negative_factorization`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 874 | def non_negative_factorization(\n 875 |     X,\n 876 |     W=None,\n 877 |     H=None,\n 878 |     n_components=None,\n 879 |     *,\n 880 |     init=None,\n 881 |     update_H=True,\n 882 |     solver=\"cd\",\n 883 |     beta_loss=\"frobenius\",\n 884 |     tol=1e-4,\n 885 |     max_iter=200,\n 886 |     alpha=\"deprecated\",\n 887 |     alpha_W=0.0,\n 888 |     alpha_H=\"same\",\n 889 |     l1_ratio=0.0,\n 890 |     regularization=\"deprecated\",\n 891 |     random_state=None,\n 892 |     verbose=0,\n 893 |     shuffle=False,\n 894 | ):\n 895 |     \"\"\"Compute Non-negative Matrix Factorization (NMF).\n 896 | \n 897 |     Find two non-negative matrices (W, H) whose product approximates the non-\n 898 |     negative matrix X. This factorization can be used for example for\n 899 |     dimensionality reduction, source separation or topic extraction.\n 900 | \n 901 |     The objective function is:\n 902 | \n 903 |         .. math::\n 904 | \n 905 |             0.5 * ||X - WH||_{loss}^2\n 906 | \n 907 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n 908 | \n 909 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n 910 | \n 911 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n 912 | \n 913 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n 914 | \n 915 |     Where:\n 916 | \n 917 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n 918 | \n 919 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n 920 | \n 921 |     The generic norm :math:`||X - WH||_{loss}^2` may represent\n 922 |     the Frobenius norm or another supported beta-divergence loss.\n 923 |     The choice between options is controlled by the `beta_loss` parameter.\n 924 | \n 925 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n 926 |     `H` to keep their impact balanced with respect to one another and to the data fit\n 927 |     term as independent as possible of the size `n_samples` of the training set.\n 928 | \n 929 |     The objective function is minimized with an alternating minimization of W\n 930 |     and H. If H is given and update_H=False, it solves for W only.\n 931 | \n 932 |     Note that the transformed data is named W and the components matrix is named H. In\n 933 |     the NMF literature, the naming convention is usually the opposite since the data\n 934 |     matrix X is transposed.\n 935 | \n 936 |     Parameters\n 937 |     ----------\n 938 |     X : array-like of shape (n_samples, n_features)\n 939 |         Constant matrix.\n 940 | \n 941 |     W : array-like of shape (n_samples, n_components), default=None\n 942 |         If init='custom', it is used as initial guess for the solution.\n 943 | \n 944 |     H : array-like of shape (n_components, n_features), default=None\n 945 |         If init='custom', it is used as initial guess for the solution.\n 946 |         If update_H=False, it is used as a constant, to solve for W only.\n 947 | \n 948 |     n_components : int, default=None\n 949 |         Number of components, if n_components is not set all features\n 950 |         are kept.\n 951 | \n 952 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n 953 |         Method used to initialize the procedure.\n 954 | \n 955 |         Valid options:\n 956 | \n 957 |         - None: 'nndsvda' if n_components < n_features, otherwise 'random'.\n 958 | \n 959 |         - 'random': non-negative random matrices, scaled with:\n 960 |             sqrt(X.mean() / n_components)\n 961 | \n 962 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 963 |             initialization (better for sparseness)\n 964 | \n 965 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 966 |             (better when sparsity is not desired)\n 967 | \n 968 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 969 |             (generally faster, less accurate alternative to NNDSVDa\n 970 |             for when sparsity is not desired)\n 971 | \n 972 |         - 'custom': use custom matrices W and H if `update_H=True`. If\n 973 |           `update_H=False`, then only custom matrix H is used.\n 974 | \n 975 |         .. versionchanged:: 0.23\n 976 |             The default value of `init` changed from 'random' to None in 0.23.\n 977 | \n 978 |         .. versionchanged:: 1.1\n 979 |             When `init=None` and n_components is less than n_samples and n_features\n 980 |             defaults to `nndsvda` instead of `nndsvd`.\n 981 | \n 982 |     update_H : bool, default=True\n 983 |         Set to True, both W and H will be estimated from initial guesses.\n 984 |         Set to False, only W will be estimated.\n 985 | \n 986 |     solver : {'cd', 'mu'}, default='cd'\n 987 |         Numerical solver to use:\n 988 | \n 989 |         - 'cd' is a Coordinate Descent solver that uses Fast Hierarchical\n 990 |             Alternating Least Squares (Fast HALS).\n 991 | \n 992 |         - 'mu' is a Multiplicative Update solver.\n 993 | \n 994 |         .. versionadded:: 0.17\n 995 |            Coordinate Descent solver.\n 996 | \n 997 |         .. versionadded:: 0.19\n 998 |            Multiplicative Update solver.\n 999 | \n1000 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1001 |             'itakura-saito'}, default='frobenius'\n1002 |         Beta divergence to be minimized, measuring the distance between X\n1003 |         and the dot product WH. Note that values different from 'frobenius'\n1004 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1005 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1006 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1007 | \n1008 |         .. versionadded:: 0.19\n1009 | \n1010 |     tol : float, default=1e-4\n1011 |         Tolerance of the stopping condition.\n1012 | \n1013 |     max_iter : int, default=200\n1014 |         Maximum number of iterations before timing out.\n1015 | \n1016 |     alpha : float, default=0.0\n1017 |         Constant that multiplies the regularization terms. Set it to zero to have no\n1018 |         regularization. When using `alpha` instead of `alpha_W` and `alpha_H`, the\n1019 |         regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1020 |         factors for `W` (resp. `H`).\n1021 | \n1022 |         .. deprecated:: 1.0\n1023 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1024 |             Use `alpha_W` and `alpha_H` instead.\n1025 | \n1026 |     alpha_W : float, default=0.0\n1027 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1028 |         (default) to have no regularization on `W`.\n1029 | \n1030 |         .. versionadded:: 1.0\n1031 | \n1032 |     alpha_H : float or \"same\", default=\"same\"\n1033 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1034 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1035 |         `alpha_W`.\n1036 | \n1037 |         .. versionadded:: 1.0\n1038 | \n1039 |     l1_ratio : float, default=0.0\n1040 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1041 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1042 |         (aka Frobenius Norm).\n1043 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1044 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1045 | \n1046 |     regularization : {'both', 'components', 'transformation'}, default=None\n1047 |         Select whether the regularization affects the components (H), the\n1048 |         transformation (W), both or none of them.\n1049 | \n1050 |         .. deprecated:: 1.0\n1051 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1052 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1053 | \n1054 |     random_state : int, RandomState instance or None, default=None\n1055 |         Used for NMF initialisation (when ``init`` == 'nndsvdar' or\n1056 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1057 |         results across multiple function calls.\n1058 |         See :term:`Glossary <random_state>`.\n1059 | \n1060 |     verbose : int, default=0\n1061 |         The verbosity level.\n1062 | \n1063 |     shuffle : bool, default=False\n1064 |         If true, randomize the order of coordinates in the CD solver.\n1065 | \n1066 |     Returns\n1067 |     -------\n1068 |     W : ndarray of shape (n_samples, n_components)\n1069 |         Solution to the non-negative least squares problem.\n1070 | \n1071 |     H : ndarray of shape (n_components, n_features)\n1072 |         Solution to the non-negative least squares problem.\n1073 | \n1074 |     n_iter : int\n1075 |         Actual number of iterations.\n1076 | \n1077 |     Examples\n1078 |     --------\n1079 |     >>> import numpy as np\n1080 |     >>> X = np.array([[1,1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1081 |     >>> from sklearn.decomposition import non_negative_factorization\n1082 |     >>> W, H, n_iter = non_negative_factorization(X, n_components=2,\n1083 |     ... init='random', random_state=0)\n1084 | \n1085 |     References\n1086 |     ----------\n1087 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1088 |     large scale nonnegative matrix and tensor factorizations.\"\n1089 |     IEICE transactions on fundamentals of electronics, communications and\n1090 |     computer sciences 92.3: 708-721, 2009.\n1091 | \n1092 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1093 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1094 |     \"\"\"\n1095 |     X = check_array(X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32])\n1096 | \n1097 |     est = NMF(\n1098 |         n_components=n_components,\n1099 |         init=init,\n1100 |         solver=solver,\n1101 |         beta_loss=beta_loss,\n1102 |         tol=tol,\n1103 |         max_iter=max_iter,\n1104 |         random_state=random_state,\n1105 |         alpha=alpha,\n1106 |         alpha_W=alpha_W,\n1107 |         alpha_H=alpha_H,\n1108 |         l1_ratio=l1_ratio,\n1109 |         verbose=verbose,\n1110 |         shuffle=shuffle,\n1111 |         regularization=regularization,\n1112 |     )\n1113 | \n1114 |     with config_context(assume_finite=True):\n1115 |         W, H, n_iter = est._fit_transform(X, W=W, H=H, update_H=update_H)\n1116 | \n1117 |     return W, H, n_iter\n```\n\nFound function `sklearn/utils/validation.py:check_non_negative`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1336 | def check_non_negative(X, whom):\n1337 |     \"\"\"\n1338 |     Check if there is any negative value in an array.\n1339 | \n1340 |     Parameters\n1341 |     ----------\n1342 |     X : {array-like, sparse matrix}\n1343 |         Input data.\n1344 | \n1345 |     whom : str\n1346 |         Who passed X to this function.\n1347 |     \"\"\"\n1348 |     # avoid X.min() on sparse matrix since it also sorts the indices\n1349 |     if sp.issparse(X):\n1350 |         if X.format in [\"lil\", \"dok\"]:\n1351 |             X = X.tocsr()\n1352 |         if X.data.size == 0:\n1353 |             X_min = 0\n1354 |         else:\n1355 |             X_min = X.data.min()\n1356 |     else:\n1357 |         X_min = X.min()\n1358 | \n1359 |     if X_min < 0:\n1360 |         raise ValueError(\"Negative values in data passed to %s\" % whom)\n```\n\nFound function `benchmarks/bench_plot_nmf.py:_nls_subproblem`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 49 | def _nls_subproblem(\n 50 |     X, W, H, tol, max_iter, alpha=0.0, l1_ratio=0.0, sigma=0.01, beta=0.1\n 51 | ):\n 52 |     \"\"\"Non-negative least square solver\n 53 |     Solves a non-negative least squares subproblem using the projected\n 54 |     gradient descent algorithm.\n 55 |     Parameters\n 56 |     ----------\n 57 |     X : array-like, shape (n_samples, n_features)\n 58 |         Constant matrix.\n 59 |     W : array-like, shape (n_samples, n_components)\n 60 |         Constant matrix.\n 61 |     H : array-like, shape (n_components, n_features)\n 62 |         Initial guess for the solution.\n 63 |     tol : float\n 64 |         Tolerance of the stopping condition.\n 65 |     max_iter : int\n 66 |         Maximum number of iterations before timing out.\n 67 |     alpha : double, default: 0.\n 68 |         Constant that multiplies the regularization terms. Set it to zero to\n 69 |         have no regularization.\n 70 |     l1_ratio : double, default: 0.\n 71 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n 72 |         For l1_ratio = 0 the penalty is an L2 penalty.\n 73 |         For l1_ratio = 1 it is an L1 penalty.\n 74 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n 75 |     sigma : float\n 76 |         Constant used in the sufficient decrease condition checked by the line\n 77 |         search.  Smaller values lead to a looser sufficient decrease condition,\n 78 |         thus reducing the time taken by the line search, but potentially\n 79 |         increasing the number of iterations of the projected gradient\n 80 |         procedure. 0.01 is a commonly used value in the optimization\n 81 |         literature.\n 82 |     beta : float\n 83 |         Factor by which the step size is decreased (resp. increased) until\n 84 |         (resp. as long as) the sufficient decrease condition is satisfied.\n 85 |         Larger values allow to find a better step size but lead to longer line\n 86 |         search. 0.1 is a commonly used value in the optimization literature.\n 87 |     Returns\n 88 |     -------\n 89 |     H : array-like, shape (n_components, n_features)\n 90 |         Solution to the non-negative least squares problem.\n 91 |     grad : array-like, shape (n_components, n_features)\n 92 |         The gradient.\n 93 |     n_iter : int\n 94 |         The number of iterations done by the algorithm.\n 95 |     References\n 96 |     ----------\n 97 |     C.-J. Lin. Projected gradient methods for non-negative matrix\n 98 |     factorization. Neural Computation, 19(2007), 2756-2779.\n 99 |     https://www.csie.ntu.edu.tw/~cjlin/nmf/\n100 |     \"\"\"\n101 |     WtX = safe_sparse_dot(W.T, X)\n102 |     WtW = np.dot(W.T, W)\n103 | \n104 |     # values justified in the paper (alpha is renamed gamma)\n105 |     gamma = 1\n106 |     for n_iter in range(1, max_iter + 1):\n107 |         grad = np.dot(WtW, H) - WtX\n108 |         if alpha > 0 and l1_ratio == 1.0:\n109 |             grad += alpha\n110 |         elif alpha > 0:\n111 |             grad += alpha * (l1_ratio + (1 - l1_ratio) * H)\n112 | \n113 |         # The following multiplication with a boolean array is more than twice\n114 |         # as fast as indexing into grad.\n115 |         if _norm(grad * np.logical_or(grad < 0, H > 0)) < tol:\n116 |             break\n117 | \n118 |         Hp = H\n119 | \n120 |         for inner_iter in range(20):\n121 |             # Gradient step.\n122 |             Hn = H - gamma * grad\n123 |             # Projection step.\n124 |             Hn *= Hn > 0\n125 |             d = Hn - H\n126 |             gradd = np.dot(grad.ravel(), d.ravel())\n127 |             dQd = np.dot(np.dot(WtW, d).ravel(), d.ravel())\n128 |             suff_decr = (1 - sigma) * gradd + 0.5 * dQd < 0\n129 |             if inner_iter == 0:\n130 |                 decr_gamma = not suff_decr\n131 | \n132 |             if decr_gamma:\n133 |                 if suff_decr:\n134 |                     H = Hn\n135 |                     break\n136 |                 else:\n137 |                     gamma *= beta\n138 |             elif not suff_decr or (Hp == Hn).all():\n139 |                 H = Hp\n140 |                 break\n141 |             else:\n142 |                 gamma /= beta\n143 |                 Hp = Hn\n144 | \n145 |     if n_iter == max_iter:\n146 |         warnings.warn(\"Iteration limit reached in nls subproblem.\", ConvergenceWarning)\n147 | \n148 |     return H, grad, n_iter\n```\n\n\n\n##Searching for term \"non-negative matrix factorization\", \"beta divergence\", \"MiniBatchNMF non-negative matrix factorization online beta divergence\"...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\nSource: Retrieved code content using keyword search (bm25).\n```\n725 | def _fit_multiplicative_update(\n726 |     X,\n727 |     W,\n728 |     H,\n729 |     beta_loss=\"frobenius\",\n730 |     max_iter=200,\n731 |     tol=1e-4,\n732 |     l1_reg_W=0,\n733 |     l1_reg_H=0,\n734 |     l2_reg_W=0,\n735 |     l2_reg_H=0,\n736 |     update_H=True,\n737 |     verbose=0,\n738 | ):\n739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n740 | \n741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n742 |     alternating minimization of W and H. Each minimization is done with a\n743 |     Multiplicative Update.\n744 | \n745 |     Parameters\n746 |     ----------\n747 |     X : array-like of shape (n_samples, n_features)\n748 |         Constant input matrix.\n749 | \n750 |     W : array-like of shape (n_samples, n_components)\n751 |         Initial guess for the solution.\n752 | \n753 |     H : array-like of shape (n_components, n_features)\n754 |         Initial guess for the solution.\n755 | \n756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n757 |             'itakura-saito'}, default='frobenius'\n758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n759 |         Beta divergence to be minimized, measuring the distance between X\n760 |         and the dot product WH. Note that values different from 'frobenius'\n761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n763 |         matrix X cannot contain zeros.\n764 | \n765 |     max_iter : int, default=200\n766 |         Number of iterations.\n767 | \n768 |     tol : float, default=1e-4\n769 |         Tolerance of the stopping condition.\n770 | \n771 |     l1_reg_W : float, default=0.\n772 |         L1 regularization parameter for W.\n773 | \n774 |     l1_reg_H : float, default=0.\n775 |         L1 regularization parameter for H.\n776 | \n777 |     l2_reg_W : float, default=0.\n778 |         L2 regularization parameter for W.\n779 | \n780 |     l2_reg_H : float, default=0.\n781 |         L2 regularization parameter for H.\n782 | \n783 |     update_H : bool, default=True\n784 |         Set to True, both W and H will be estimated from initial guesses.\n785 |         Set to False, only W will be estimated.\n786 | \n787 |     verbose : int, default=0\n788 |         The verbosity level.\n789 | \n790 |     Returns\n791 |     -------\n792 |     W : ndarray of shape (n_samples, n_components)\n793 |         Solution to the non-negative least squares problem.\n794 | \n795 |     H : ndarray of shape (n_components, n_features)\n796 |         Solution to the non-negative least squares problem.\n797 | \n798 |     n_iter : int\n799 |         The number of iterations done by the algorithm.\n800 | \n801 |     References\n802 |     ----------\n803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n805 |     \"\"\"\n806 |     start_time = time.time()\n807 | \n808 |     beta_loss = _beta_loss_to_float(beta_loss)\n809 | \n810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n811 |     if beta_loss < 1:\n812 |         gamma = 1.0 / (2.0 - beta_loss)\n813 |     elif beta_loss > 2:\n814 |         gamma = 1.0 / (beta_loss - 1.0)\n815 |     else:\n816 |         gamma = 1.0\n817 | \n818 |     # used for the convergence criterion\n819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n820 |     previous_error = error_at_init\n821 | \n822 |     H_sum, HHt, XHt = None, None, None\n823 |     for n_iter in range(1, max_iter + 1):\n824 |         # update W\n825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n\n\n\n##Searching for term \"online\"...\n### Search Result:\nFound code snippet in file `examples/cluster/plot_dict_face_patches.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | Online learning of a dictionary of parts of faces\n 3 | =================================================\n 4 | \n 5 | This example uses a large dataset of faces to learn a set of 20 x 20\n 6 | images patches that constitute faces.\n 7 | \n 8 | From the programming standpoint, it is interesting because it shows how\n 9 | to use the online API of the scikit-learn to process a very large\n10 | dataset by chunks. The way we proceed is that we load an image at a time\n11 | and extract randomly 50 patches from this image. Once we have accumulated\n12 | 500 of these patches (using 10 images), we run the\n13 | :func:`~sklearn.cluster.MiniBatchKMeans.partial_fit` method\n14 | of the online KMeans object, MiniBatchKMeans.\n15 | \n16 | The verbose setting on the MiniBatchKMeans enables us to see that some\n17 | clusters are reassigned during the successive calls to\n18 | partial-fit. This is because the number of patches that they represent\n19 | has become too low, and it is better to choose a random new\n20 | cluster.\n21 | \n22 | \"\"\"\n23 | \n24 | # %%\n25 | # Load the data\n26 | # -------------\n27 | \n28 | from sklearn import datasets\n29 | \n30 | faces = datasets.fetch_olivetti_faces()\n31 | \n32 | # %%\n33 | # Learn the dictionary of images\n34 | # ------------------------------\n35 | \n36 | import time\n37 | \n38 | import numpy as np\n39 | \n40 | from sklearn.cluster import MiniBatchKMeans\n41 | from sklearn.feature_extraction.image import extract_patches_2d\n42 | \n43 | print(\"Learning the dictionary... \")\n44 | rng = np.random.RandomState(0)\n45 | kmeans = MiniBatchKMeans(n_clusters=81, random_state=rng, verbose=True)\n46 | patch_size = (20, 20)\n47 | \n48 | buffer = []\n49 | t0 = time.time()\n50 | \n51 | # The online learning part: cycle over the whole dataset 6 times\n52 | index = 0\n53 | for _ in range(6):\n54 |     for img in faces.images:\n55 |         data = extract_patches_2d(img, patch_size, max_patches=50, random_state=rng)\n56 |         data = np.reshape(data, (len(data), -1))\n57 |         buffer.append(data)\n58 |         index += 1\n59 |         if index % 10 == 0:\n60 |             data = np.concatenate(buffer, axis=0)\n61 |             data -= np.mean(data, axis=0)\n62 |             data /= np.std(data, axis=0)\n63 |             kmeans.partial_fit(data)\n64 |             buffer = []\n65 |         if index % 100 == 0:\n66 |             print(\"Partial fit of %4i out of %i\" % (index, 6 * len(faces.images)))\n67 | \n68 | dt = time.time() - t0\n69 | print(\"done in %.2fs.\" % dt)\n70 | \n71 | # %%\n72 | # Plot the results\n73 | # ----------------\n74 | \n75 | import matplotlib.pyplot as plt\n```\n\nFound function `sklearn/decomposition/_dict_learning.py:dict_learning_online`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 738 | def dict_learning_online(\n 739 |     X,\n 740 |     n_components=2,\n 741 |     *,\n 742 |     alpha=1,\n 743 |     n_iter=\"deprecated\",\n 744 |     max_iter=None,\n 745 |     return_code=True,\n 746 |     dict_init=None,\n 747 |     callback=None,\n 748 |     batch_size=\"warn\",\n 749 |     verbose=False,\n 750 |     shuffle=True,\n 751 |     n_jobs=None,\n 752 |     method=\"lars\",\n 753 |     iter_offset=\"deprecated\",\n 754 |     random_state=None,\n 755 |     return_inner_stats=\"deprecated\",\n 756 |     inner_stats=\"deprecated\",\n 757 |     return_n_iter=\"deprecated\",\n 758 |     positive_dict=False,\n 759 |     positive_code=False,\n 760 |     method_max_iter=1000,\n 761 |     tol=1e-3,\n 762 |     max_no_improvement=10,\n 763 | ):\n 764 |     \"\"\"Solves a dictionary learning matrix factorization problem online.\n 765 | \n 766 |     Finds the best dictionary and the corresponding sparse code for\n 767 |     approximating the data matrix X by solving::\n 768 | \n 769 |         (U^*, V^*) = argmin 0.5 || X - U V ||_Fro^2 + alpha * || U ||_1,1\n 770 |                      (U,V)\n 771 |                      with || V_k ||_2 = 1 for all  0 <= k < n_components\n 772 | \n 773 |     where V is the dictionary and U is the sparse code. ||.||_Fro stands for\n 774 |     the Frobenius norm and ||.||_1,1 stands for the entry-wise matrix norm\n 775 |     which is the sum of the absolute values of all the entries in the matrix.\n 776 |     This is accomplished by repeatedly iterating over mini-batches by slicing\n 777 |     the input data.\n 778 | \n 779 |     Read more in the :ref:`User Guide <DictionaryLearning>`.\n 780 | \n 781 |     Parameters\n 782 |     ----------\n 783 |     X : ndarray of shape (n_samples, n_features)\n 784 |         Data matrix.\n 785 | \n 786 |     n_components : int or None, default=2\n 787 |         Number of dictionary atoms to extract. If None, then ``n_components``\n 788 |         is set to ``n_features``.\n 789 | \n 790 |     alpha : float, default=1\n 791 |         Sparsity controlling parameter.\n 792 | \n 793 |     n_iter : int, default=100\n 794 |         Number of mini-batch iterations to perform.\n 795 | \n 796 |         .. deprecated:: 1.1\n 797 |            `n_iter` is deprecated in 1.1 and will be removed in 1.3. Use\n 798 |            `max_iter` instead.\n 799 | \n 800 |     max_iter : int, default=None\n 801 |         Maximum number of iterations over the complete dataset before\n 802 |         stopping independently of any early stopping criterion heuristics.\n 803 |         If ``max_iter`` is not None, ``n_iter`` is ignored.\n 804 | \n 805 |         .. versionadded:: 1.1\n 806 | \n 807 |     return_code : bool, default=True\n 808 |         Whether to also return the code U or just the dictionary `V`.\n 809 | \n 810 |     dict_init : ndarray of shape (n_components, n_features), default=None\n 811 |         Initial value for the dictionary for warm restart scenarios.\n 812 | \n 813 |     callback : callable, default=None\n 814 |         A callable that gets invoked at the end of each iteration.\n 815 | \n 816 |     batch_size : int, default=3\n 817 |         The number of samples to take in each batch.\n 818 | \n 819 |     verbose : bool, default=False\n 820 |         To control the verbosity of the procedure.\n 821 | \n 822 |     shuffle : bool, default=True\n 823 |         Whether to shuffle the data before splitting it in batches.\n 824 | \n 825 |     n_jobs : int, default=None\n 826 |         Number of parallel jobs to run.\n 827 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n 828 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n 829 |         for more details.\n 830 | \n 831 |     method : {'lars', 'cd'}, default='lars'\n 832 |         * `'lars'`: uses the least angle regression method to solve the lasso\n 833 |           problem (`linear_model.lars_path`);\n 834 |         * `'cd'`: uses the coordinate descent method to compute the\n 835 |           Lasso solution (`linear_model.Lasso`). Lars will be faster if\n 836 |           the estimated components are sparse.\n 837 | \n 838 |     iter_offset : int, default=0\n 839 |         Number of previous iterations completed on the dictionary used for\n 840 |         initialization.\n 841 | \n 842 |         .. deprecated:: 1.1\n 843 |            `iter_offset` serves internal purpose only and will be removed in 1.3.\n 844 | \n 845 |     random_state : int, RandomState instance or None, default=None\n 846 |         Used for initializing the dictionary when ``dict_init`` is not\n 847 |         specified, randomly shuffling the data when ``shuffle`` is set to\n 848 |         ``True``, and updating the dictionary. Pass an int for reproducible\n 849 |         results across multiple function calls.\n 850 |         See :term:`Glossary <random_st