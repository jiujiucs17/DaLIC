    ]\n2578 |         }}\n2579 |         \"\"\"\n2580 |         from pandas.io import json\n2581 | \n2582 |         if date_format is None and orient == \"table\":\n2583 |             date_format = \"iso\"\n2584 |         elif date_format is None:\n2585 |             date_format = \"epoch\"\n2586 |             dtypes = self.dtypes if self.ndim == 2 else [self.dtype]\n2587 |             if any(lib.is_np_dtype(dtype, \"mM\") for dtype in dtypes):\n2588 |                 warnings.warn(\n2589 |                     \"The default 'epoch' date format is deprecated and will be removed \"\n2590 |                     \"in a future version, please use 'iso' date format instead.\",\n2591 |                     FutureWarning,\n2592 |                     stacklevel=find_stack_level(),\n2593 |                 )\n2594 |         elif date_format == \"epoch\":\n2595 |             # GH#57063\n2596 |             warnings.warn(\n2597 |                 \"'epoch' date format is deprecated and will be removed in a future \"\n2598 |                 \"version, please use 'iso' date format instead.\",\n2599 |                 FutureWarning,\n2600 |                 stacklevel=find_stack_level(),\n2601 |             )\n2602 | \n2603 |         config.is_nonnegative_int(indent)\n2604 |         indent = indent or 0\n2605 | \n2606 |         return json.to_json(\n2607 |             path_or_buf=path_or_buf,\n2608 |             obj=self,\n2609 |             orient=orient,\n2610 |             date_format=date_format,\n2611 |             double_precision=double_precision,\n2612 |             force_ascii=force_ascii,\n2613 |             date_unit=date_unit,\n2614 |             default_handler=default_handler,\n2615 |             lines=lines,\n2616 |             compression=compression,\n2617 |             index=index,\n2618 |             indent=indent,\n2619 |             storage_options=storage_options,\n2620 |             mode=mode,\n2621 |         )\n```\n\nFound class `pandas/errors/__init__.py:CSSWarning`.\nSource: Retrieved code content using keyword search (bm25).\n```\n593 | class CSSWarning(UserWarning):\n594 |     \"\"\"\n595 |     Warning is raised when converting css styling fails.\n596 | \n597 |     This can be due to the styling not having an equivalent value or because the\n598 |     styling isn't properly formatted.\n599 | \n600 |     See Also\n601 |     --------\n602 |     DataFrame.style : Returns a Styler object for applying CSS-like styles.\n603 |     io.formats.style.Styler : Helps style a DataFrame or Series according to the\n604 |         data with HTML and CSS.\n605 |     io.formats.style.Styler.to_excel : Export styled DataFrame to Excel.\n606 |     io.formats.style.Styler.to_html : Export styled DataFrame to HTML.\n607 | \n608 |     Examples\n609 |     --------\n610 |     >>> df = pd.DataFrame({\"A\": [1, 1, 1]})\n611 |     >>> df.style.map(lambda x: \"background-color: blueGreenRed;\").to_excel(\n612 |     ...     \"styled.xlsx\"\n613 |     ... )  # doctest: +SKIP\n614 |     CSSWarning: Unhandled color format: 'blueGreenRed'\n615 |     >>> df.style.map(lambda x: \"border: 1px solid red red;\").to_excel(\n616 |     ...     \"styled.xlsx\"\n617 |     ... )  # doctest: +SKIP\n618 |     CSSWarning: Unhandled color format: 'blueGreenRed'\n619 |     \"\"\"\n```\n\nFound file `pandas/core/interchange/dataframe.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `pandas/core/interchange/dataframe.py` for the full content if needed.\n"}, {"content": "Let me explore the Excel-related modules to understand the implementation of `merge_cells` functionality.\n\n<function=search_code_snippets>\n<parameter=search_terms>['ExcelFormatter', 'merge_cells']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\npandas/io/formats/excel.py:ExcelFormatter.__init__\npandas/io/formats/style.py:Styler.to_excel\npandas