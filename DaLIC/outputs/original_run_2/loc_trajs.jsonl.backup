        if os.path.exists(local_path):\n123 |                 os.unlink(local_path)\n124 |             raise\n125 | \n126 |     # XXX: First time, decompression will not be necessary (by using fsrc), but\n127 |     # it will happen nonetheless\n128 |     return gzip.GzipFile(local_path, 'rb')\n129 | \n130 | \n131 | class OpenMLError(ValueError):\n132 |     \"\"\"HTTP 412 is a specific OpenML error code, indicating a generic error\"\"\"\n133 |     pass\n134 | \n135 | \n136 | def _get_json_content_from_openml_api(\n137 |     url: str,\n138 |     error_message: Optional[str],\n139 |     data_home: Optional[str]\n140 | ) -> Dict:\n141 |     \"\"\"\n142 |     Loads json data from the openml api\n143 | \n144 |     Parameters\n145 |     ----------\n146 |     url : str\n147 |         The URL to load from. Should be an official OpenML endpoint\n148 | \n149 |     error_message : str or None\n150 |         The error message to raise if an acceptable OpenML error is thrown\n151 |         (acceptable error is, e.g., data id not found. Other errors, like 404's\n152 |         will throw the native error message)\n153 | \n154 |     data_home : str or None\n155 |         Location to cache the response. None if no cache is required.\n156 | \n157 |     Returns\n158 |     -------\n159 |     json_data : json\n160 |         the json result from the OpenML server if the call was successful.\n161 |         An exception otherwise.\n162 |     \"\"\"\n163 | \n164 |     @_retry_with_clean_cache(url, data_home)\n165 |     def _load_json():\n166 |         with closing(_open_openml_url(url, data_home)) as response:\n167 |             return json.loads(response.read().decode(\"utf-8\"))\n168 | \n169 |     try:\n170 |         return _load_json()\n171 |     except HTTPError as error:\n172 |         # 412 is an OpenML specific error code, indicating a generic error\n173 |         # (e.g., data not found)\n174 |         if error.code != 412:\n175 |             raise error\n176 | \n177 |     # 412 error, not in except for nicer traceback\n178 |     raise OpenMLError(error_message)\n179 | \n180 | \n181 | def _split_sparse_columns(\n182 |     arff_data: ArffSparseDataType, include_columns: List\n183 | ) -> ArffSparseDataType:\n184 |     \"\"\"\n185 |     obtains several columns from sparse arff representation. Additionally, the\n186 |     column indices are re-labelled, given the columns that are not included.\n187 |     (e.g., when including [1, 2, 3], the columns will be relabelled to\n188 |     [0, 1, 2])\n189 | \n190 |     Parameters\n191 |     ----------\n192 |     arff_data : tuple\n193 |         A tuple of three lists of equal size; first list indicating the value,\n194 |         second the x coordinate and the third the y coordinate.\n195 | \n196 |     include_columns : list\n197 |         A list of columns to include.\n198 | \n199 |     Returns\n200 |     -------\n201 |     arff_data_new : tuple\n202 |         Subset of arff data with only the include columns indicated by the\n203 |         include_columns argument.\n204 |     \"\"\"\n205 |     arff_data_new: ArffSparseDataType = (list(), list(), list())\n206 |     reindexed_columns = {column_idx: array_idx for array_idx, column_idx\n207 |                          in enumerate(include_columns)}\n208 |     for val, row_idx, col_idx in zip(arff_data[0], arff_data[1], arff_data[2]):\n209 |         if col_idx in include_columns:\n210 |             arff_data_new[0].append(val)\n211 |             arff_data_new[1].append(row_idx)\n212 |             arff_data_new[2].append(reindexed_columns[col_idx])\n213 |     return arff_data_new\n214 | \n215 | \n216 | def _sparse_data_to_array(\n217 |     arff_data: ArffSparseDataType, include_columns: List\n218 | ) -> np.ndarray:\n219 |     # turns the sparse data back into an array (can't use toarray() function,\n220 |     # as this does only work on numeric data)\n221 |     num_obs = max(arff_data[1]) + 1\n222 |     y_shape = (num_obs, len(include_columns))\n223 |     reindexed_columns = {column_idx: array_idx for array_idx, column_idx\n224 |                          in enumerate(include_columns)}\n225 |     # TODO: improve for efficiency\n226 |     y = np.empty(y_shape, dtype=np.float64)\n227 |     for val, row_idx, col_idx in zip(arff_data[0], arff_data[1], arff_data[2]):\n228 |         if col_idx in include_columns:\n229 |             y[row_idx, reindexed_columns[col_idx]] = val\n230 |     return y\n231 | \n232 | \n233 | def _convert_arff_data(\n234 |     arff: ArffContainerType,\n235 |     col_slice_x: List[int],\n236 |     col_slice_y: List[int],\n237 |     shape: Optional[Tuple] = None\n238 | ) -> Tuple:\n239 |     \"\"\"\n240 |     converts the arff object into the appropriate matrix type (np.array or\n241 |     scipy.sparse.csr_matrix) based on the 'data part' (i.e., in the\n242 |     liac-arff dict, the object from the 'data' key)\n243 | \n244 |     Parameters\n245 |     ----------\n246 |     arff : dict\n247 |         As obtained from liac-arff object.\n248 | \n249 |     col_slice_x : list\n250 |         The column indices that are sliced from the original array to return\n251 |         as X data\n252 | \n253 |     col_slice_y : list\n254 |         The column indices that are sliced from the original array to return\n255 |         as y data\n256 | \n257 |     Returns\n258 |     -------\n259 |     X : np.array or scipy.sparse.csr_matrix\n260 |     y : np.array\n261 |     \"\"\"\n262 |     arff_data = arff['data']\n263 |     if isinstance(arff_data, Generator):\n264 |         if shape is None:\n265 |             raise ValueError(\n266 |                 \"shape must be provided when arr['data'] is a Generator\"\n267 |             )\n268 |         if shape[0] == -1:\n269 |             count = -1\n270 |         else:\n271 |             count = shape[0] * shape[1]\n272 |         data = np.fromiter(itertools.chain.from_iterable(arff_data),\n273 |                            dtype='float64', count=count)\n274 |         data = data.reshape(*shape)\n275 |         X = data[:, col_slice_x]\n276 |         y = data[:, col_slice_y]\n277 |         return X, y\n278 |     elif isinstance(arff_data, tuple):\n279 |         arff_data_X = _split_sparse_columns(arff_data, col_slice_x)\n280 |         num_obs = max(arff_data[1]) + 1\n281 |         X_shape = (num_obs, len(col_slice_x))\n282 |         X = scipy.sparse.coo_matrix(\n283 |             (arff_data_X[0], (arff_data_X[1], arff_data_X[2])),\n284 |             shape=X_shape, dtype=np.float64)\n285 |         X = X.tocsr()\n286 |         y = _sparse_data_to_array(arff_data, col_slice_y)\n287 |         return X, y\n288 |     else:\n289 |         # This should never happen\n290 |         raise ValueError('Unexpected Data Type obtained from arff.')\n291 | \n292 | \n293 | def _feature_to_dtype(feature: Dict[str, str]):\n294 |     \"\"\"Map feature to dtype for pandas DataFrame\n295 |     \"\"\"\n296 |     if feature['data_type'] == 'string':\n297 |         return object\n298 |     elif feature['data_type'] == 'nominal':\n299 |         return 'category'\n300 |     # only numeric, integer, real are left\n301 |     elif (feature['number_of_missing_values'] != '0' or\n302 |           feature['data_type'] in ['numeric', 'real']):\n303 |         # cast to floats when there are any missing values\n304 |         return np.float64\n305 |     elif feature['data_type'] == 'integer':\n306 |         return np.int64\n307 |     raise ValueError('Unsupported feature: {}'.format(feature))\n308 | \n309 | \n310 | def _convert_arff_data_dataframe(\n311 |     arff: ArffContainerType, columns: List, features_dict: Dict[str, Any]\n312 | ) -> Tuple:\n313 |     \"\"\"Convert the ARFF object into a pandas DataFrame.\n314 | \n315 |     Parameters\n316 |     ----------\n317 |     arff : dict\n318 |         As obtained from liac-arff object.\n319 | \n320 |     columns : list\n321 |         Columns from dataframe to return.\n322 | \n323 |     features_dict : dict\n324 |         Maps feature name to feature info from openml.\n325 | \n326 |     Returns\n327 |     -------\n328 |     result : tuple\n329 |         tuple with the resulting dataframe\n330 |     \"\"\"\n331 |     pd = check_pandas_support('fetch_openml with as_frame=True')\n332 | \n333 |     attributes = OrderedDict(arff['attributes'])\n334 |     arff_columns = list(attributes)\n335 | \n336 |     if not isinstance(arff['data'], Generator):\n337 |         raise ValueError(\n338 |             \"arff['data'] must be a generator when converting to pd.DataFrame.\"\n339 |         )\n340 | \n341 |     # calculate chunksize\n342 |     first_row = next(arff['data'])\n343 |     first_df = pd.DataFrame([first_row], columns=arff_columns)\n344 | \n345 |     row_bytes = first_df.memory_usage(deep=True).sum()\n346 |     chunksize = get_chunk_n_rows(row_bytes)\n347 | \n348 |     # read arff data with chunks\n349 |     columns_to_keep = [col for col in arff_columns if col in columns]\n350 |     dfs = []\n351 |     dfs.append(first_df[columns_to_keep])\n352 |     for data in _chunk_generator(arff['data'], chunksize):\n353 |         dfs.append(pd.DataFrame(data, columns=arff_columns)[columns_to_keep])\n354 |     df = pd.concat(dfs, ignore_index=True)\n355 | \n356 |     for column in columns_to_keep:\n357 |         dtype = _feature_to_dtype(features_dict[column])\n358 |         if dtype == 'category':\n359 |             dtype = pd.api.types.CategoricalDtype(attributes[column])\n360 |         df[column] = df[column].astype(dtype, copy=False)\n361 |     return (df, )\n362 | \n363 | \n364 | def _get_data_info_by_name(\n365 |     name: str, version: Union[int, str], data_home: Optional[str]\n366 | ):\n367 |     \"\"\"\n368 |     Utilizes the openml dataset listing api to find a dataset by\n369 |     name/version\n370 |     OpenML api function:\n371 |     https://www.openml.org/api_docs#!/data/get_data_list_data_name_data_name\n372 | \n373 |     Parameters\n374 |     ----------\n375 |     name : str\n376 |         name of the dataset\n377 | \n378 |     version : int or str\n379 |         If version is an integer, the exact name/version will be obtained from\n380 |         OpenML. If version is a string (value: \"active\") it will take the first\n381 |         version from OpenML that is annotated as active. Any other string\n382 |         values except \"active\" are treated as integer.\n383 | \n384 |     data_home : str or None\n385 |         Location to cache the response. None if no cache is required.\n386 | \n387 |     Returns\n388 |     -------\n389 |     first_dataset : json\n390 |         json representation of the first dataset object that adhired to the\n391 |         search criteria\n392 | \n393 |     \"\"\"\n394 |     if version == \"active\":\n395 |         # situation in which we return the oldest active version\n396 |         url = _SEARCH_NAME.format(name) + \"/status/active/\"\n397 |         error_msg = \"No active dataset {} found.\".format(name)\n398 |         json_data = _get_json_content_from_openml_api(\n399 |             url, error_msg, data_home=data_home\n400 |         )\n401 |         res = json_data['data']['dataset']\n402 |         if len(res) > 1:\n403 |             warn(\"Multiple active versions of the dataset matching the name\"\n404 |                  \" {name} exist. Versions may be fundamentally different, \"\n405 |                  \"returning version\"\n406 |                  \" {version}.\".format(name=name, version=res[0]['version']))\n407 |         return res[0]\n408 | \n409 |     # an integer version has been provided\n410 |     url = (_SEARCH_NAME + \"/data_version/{}\").format(name, version)\n411 |     try:\n412 |         json_data = _get_json_content_from_openml_api(\n413 |             url, error_message=None, data_home=data_home\n414 |         )\n415 |     except OpenMLError:\n416 |         # we can do this in 1 function call if OpenML does not require the\n417 |         # specification of the dataset status (i.e., return datasets with a\n418 |         # given name / version regardless of active, deactivated, etc. )\n419 |         # TODO: feature request OpenML.\n420 |         url += \"/status/deactivated\"\n421 |         error_msg = \"Dataset {} with version {} not found.\".format(name,\n422 |                                                                    version)\n423 |         json_data = _get_json_content_from_openml_api(\n424 |             url, error_msg, data_home=data_home\n425 |         )\n426 | \n427 |     return json_data['data']['dataset'][0]\n428 | \n429 | \n430 | def _get_data_description_by_id(\n431 |     data_id: int, data_home: Optional[str]\n432 | ) -> Dict[str, Any]:\n433 |     # OpenML API function: https://www.openml.org/api_docs#!/data/get_data_id\n434 |     url = _DATA_INFO.format(data_id)\n435 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n436 |     json_data = _get_json_content_from_openml_api(\n437 |         url, error_message, data_home=data_home\n438 |     )\n439 |     return json_data['data_set_description']\n440 | \n441 | \n442 | def _get_data_features(\n443 |     data_id: int, data_home: Optional[str]\n444 | ) -> OpenmlFeaturesType:\n445 |     # OpenML function:\n446 |     # https://www.openml.org/api_docs#!/data/get_data_features_id\n447 |     url = _DATA_FEATURES.format(data_id)\n448 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n449 |     json_data = _get_json_content_from_openml_api(\n450 |         url, error_message, data_home=data_home\n451 |     )\n452 |     return json_data['data_features']['feature']\n453 | \n454 | \n455 | def _get_data_qualities(\n456 |     data_id: int, data_home: Optional[str]\n457 | ) -> OpenmlQualitiesType:\n458 |     # OpenML API function:\n459 |     # https://www.openml.org/api_docs#!/data/get_data_qualities_id\n460 |     url = _DATA_QUALITIES.format(data_id)\n461 |     error_message = \"Dataset with data_id {} not found.\".format(data_id)\n462 |     json_data = _get_json_content_from_openml_api(\n463 |         url, error_message, data_home=data_home\n464 |     )\n465 |     # the qualities might not be available, but we still try to process\n466 |     # the data\n467 |     return json_data.get('data_qualities', {}).get('quality', [])\n468 | \n469 | \n470 | def _get_num_samples(data_qualities: OpenmlQualitiesType) -> int:\n471 |     \"\"\"Get the number of samples from data qualities.\n472 | \n473 |     Parameters\n474 |     ----------\n475 |     data_qualities : list of dict\n476 |         Used to retrieve the number of instances (samples) in the dataset.\n477 | \n478 |     Returns\n479 |     -------\n480 |     n_samples : int\n481 |         The number of samples in the dataset or -1 if data qualities are\n482 |         unavailable.\n483 |     \"\"\"\n484 |     # If the data qualities are unavailable, we return -1\n485 |     default_n_samples = -1\n486 | \n487 |     qualities = {d['name']: d['value'] for d in data_qualities}\n488 |     return int(float(qualities.get('NumberOfInstances', default_n_samples)))\n489 | \n490 | \n491 | def _load_arff_response(\n492 |     url: str,\n493 |     data_home: Optional[str],\n494 |     return_type, encode_nominal: bool,\n495 |     parse_arff: Callable[[ArffContainerType], Tuple]\n496 | ) -> Tuple:\n497 |     \"\"\"Load arff data with url and parses arff response with parse_arff\"\"\"\n498 |     response = _open_openml_url(url, data_home)\n499 | \n500 |     with closing(response):\n501 |         # Note that if the data is dense, no reading is done until the data\n502 |         # generator is iterated.\n503 |         arff = _arff.load((line.decode('utf-8') for line in response),\n504 |                           return_type=return_type,\n505 |                           encode_nominal=encode_nominal)\n506 |         return parse_arff(arff)\n507 | \n508 | \n509 | def _download_data_to_bunch(\n510 |     url: str,\n511 |     sparse: bool,\n512 |     data_home: Optional[str],\n513 |     *,\n514 |     as_frame: bool,\n515 |     features_list: List,\n516 |     data_columns: List[int],\n517 |     target_columns: List,\n518 |     shape: Optional[Tuple[int, int]]\n519 | ):\n520 |     \"\"\"Download OpenML ARFF and convert to Bunch of data\n521 |     \"\"\"\n522 |     # NB: this function is long in order to handle retry for any failure\n523 |     #     during the streaming parse of the ARFF.\n524 | \n525 |     # Prepare which columns and data types should be returned for the X and y\n526 |     features_dict = {feature['name']: feature for feature in features_list}\n527 | \n528 |     # XXX: col_slice_y should be all nominal or all numeric\n529 |     _verify_target_data_type(features_dict, target_columns)\n530 | \n531 |     col_slice_y = [int(features_dict[col_name]['index'])\n532 |                    for col_name in target_columns]\n533 | \n534 |     col_slice_x = [int(features_dict[col_name]['index'])\n535 |                    for col_name in data_columns]\n536 |     for col_idx in col_slice_y:\n537 |         feat = features_list[col_idx]\n538 |         nr_missing = int(feat['number_of_missing_values'])\n539 |         if nr_missing > 0:\n540 |             raise ValueError('Target column {} has {} missing values. '\n541 |                              'Missing values are not supported for target '\n542 |                              'columns. '.format(feat['name'], nr_missing))\n543 | \n544 |     # Access an ARFF file on the OpenML server. Documentation:\n545 |     # https://www.openml.org/api_data_docs#!/data/get_download_id\n546 | \n547 |     if sparse is True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n619 | \n620 | \n621 | def _verify_target_data_type(features_dict, target_columns):\n622 |     # verifies the data type of the y array in case there are multiple targets\n623 |     # (throws an error if these targets do not comply with sklearn support)\n624 |     if not isinstance(target_columns, list):\n625 |         raise ValueError('target_column should be list, '\n626 |                          'got: %s' % type(target_columns))\n627 |     found_types = set()\n628 |     for target_column in target_columns:\n629 |         if target_column not in features_dict:\n630 |             raise KeyError('Could not find target_column={}')\n631 |         if features_dict[target_column]['data_type'] == \"numeric\":\n632 |             found_types.add(np.float64)\n633 |         else:\n634 |             found_types.add(object)\n635 | \n636 |         # note: we compare to a string, not boolean\n637 |         if features_dict[target_column]['is_ignore'] == 'true':\n638 |             warn('target_column={} has flag is_ignore.'.format(\n639 |                 target_column))\n640 |         if features_dict[target_column]['is_row_identifier'] == 'true':\n641 |             warn('target_column={} has flag is_row_identifier.'.format(\n642 |                 target_column))\n643 |     if len(found_types) > 1:\n644 |         raise ValueError('Can only handle homogeneous multi-target datasets, '\n645 |                          'i.e., all targets are either numeric or '\n646 |                          'categorical.')\n647 | \n648 | \n649 | def _valid_data_column_names(features_list, target_columns):\n650 |     # logic for determining on which columns can be learned. Note that from the\n651 |     # OpenML guide follows that columns that have the `is_row_identifier` or\n652 |     # `is_ignore` flag, these can not be learned on. Also target columns are\n653 |     # excluded.\n654 |     valid_data_column_names = []\n655 |     for feature in features_list:\n656 |         if (feature['name'] not in target_columns\n657 |                 and feature['is_ignore'] != 'true'\n658 |                 and feature['is_row_identifier'] != 'true'):\n659 |             valid_data_column_names.append(feature['name'])\n660 |     return valid_data_column_names\n661 | \n662 | \n663 | @_deprecate_positional_args\n664 | def fetch_openml(\n665 |     name: Optional[str] = None,\n666 |     *,\n667 |     version: Union[str, int] = 'active',\n668 |     data_id: Optional[int] = None,\n669 |     data_home: Optional[str] = None,\n670 |     target_column: Optional[Union[str, List]] = 'default-target',\n671 |     cache: bool = True,\n672 |     return_X_y: bool = False,\n673 |     as_frame: bool = False\n674 | ):\n675 |     \"\"\"Fetch dataset from openml by name or dataset id.\n676 | \n677 |     Datasets are uniquely identified by either an integer ID or by a\n678 |     combination of name and version (i.e. there might be multiple\n679 |     versions of the 'iris' dataset). Please give either name or data_id\n680 |     (not both). In case a name is given, a version can also be\n681 |     provided.\n682 | \n683 |     Read more in the :ref:`User Guide <openml>`.\n684 | \n685 |     .. versionadded:: 0.20\n686 | \n687 |     .. note:: EXPERIMENTAL\n688 | \n689 |         The API is experimental (particularly the return value structure),\n690 |         and might have small backward-incompatible changes in future releases.\n691 | \n692 |     Parameters\n693 |     ----------\n694 |     name : str, default=None\n695 |         String identifier of the dataset. Note that OpenML can have multiple\n696 |         datasets with the same name.\n697 | \n698 |     version : int or 'active', default='active'\n699 |         Version of the dataset. Can only be provided if also ``name`` is given.\n700 |         If 'active' the oldest version that's still active is used. Since\n701 |         there may be more than one active version of a dataset, and those\n702 |         versions may fundamentally be different from one another, setting an\n703 |         exact version is highly recommended.\n704 | \n705 |     data_id : int, default=None\n706 |         OpenML ID of the dataset. The most specific way of retrieving a\n707 |         dataset. If data_id is not given, name (and potential version) are\n708 |         used to obtain a dataset.\n709 | \n710 |     data_home : str, default=None\n711 |         Specify another download and cache folder for the data sets. By default\n712 |         all scikit-learn data is stored in '~/scikit_learn_data' subfolders.\n713 | \n714 |     target_column : str, list or None, default='default-target'\n715 |         Specify the column name in the data to use as target. If\n716 |         'default-target', the standard target column a stored on the server\n717 |         is used. If ``None``, all columns are returned as data and the\n718 |         target is ``None``. If list (of strings), all columns with these names\n719 |         are ret