 which is relatively costly.\n312 | \n313 |         The method used here involves computing the path length along the contour in\n314 |         pixel coordinates and then looking (label width / 2) away from central point to\n315 |         determine rotation and then to break contour if desired.  The extra spacing is\n316 |         taken into account when breaking the path, but not when computing the angle.\n317 |         \"\"\"\n318 |         xys = path.vertices\n319 |         codes = path.codes\n320 | \n321 |         # Insert a vertex at idx/pos (converting back to data space), if there isn't yet\n322 |         # a vertex there.  With infinite precision one could also always insert the\n323 |         # extra vertex (it will get masked out by the label below anyways), but floating\n324 |         # point inaccuracies (the point can have undergone a data->screen->data\n325 |         # transform loop) can slightly shift the point and e.g. shift the angle computed\n326 |         # below from exactly zero to nonzero.\n327 |         pos = self.get_transform().inverted().transform(screen_pos)\n328 |         if not np.allclose(pos, xys[idx]):\n329 |             xys = np.insert(xys, idx, pos, axis=0)\n330 |             codes = np.insert(codes, idx, Path.LINETO)\n331 | \n332 |         # Find the connected component where the label will be inserted.  Note that a\n333 |         # path always starts with a MOVETO, and we consider there's an implicit\n334 |         # MOVETO (closing the last path) at the end.\n335 |         movetos = (codes == Path.MOVETO).nonzero()[0]\n336 |         start = movetos[movetos <= idx][-1]\n337 |         try:\n338 |             stop = movetos[movetos > idx][0]\n339 |         except IndexError:\n340 |             stop = len(codes)\n341 | \n342 |         # Restrict ourselves to the connected component.\n343 |         cc_xys = xys[start:stop]\n344 |         idx -= start\n345 | \n346 |         # If the path is closed, rotate it s.t. it starts at the label.\n347 |         is_closed_path = codes[stop - 1] == Path.CLOSEPOLY\n348 |         if is_closed_path:\n349 |             cc_xys = np.concatenate([cc_xys[idx:-1], cc_xys[:idx+1]])\n350 |             idx = 0\n351 | \n352 |         # Like np.interp, but additionally vectorized over fp.\n353 |         def interp_vec(x, xp, fp): return [np.interp(x, xp, col) for col in fp.T]\n354 | \n355 |         # Use cumulative path lengths (\"cpl\") as curvilinear coordinate along contour.\n356 |         screen_xys = self.get_transform().transform(cc_xys)\n357 |         path_cpls = np.insert(\n358 |             np.cumsum(np.hypot(*np.diff(screen_xys, axis=0).T)), 0, 0)\n359 |         path_cpls -= path_cpls[idx]\n360 | \n361 |         # Use linear interpolation to get end coordinates of label.\n362 |         target_cpls = np.array([-lw/2, lw/2])\n363 |         if is_closed_path:  # For closed paths, target from the other end.\n364 |             target_cpls[0] += (path_cpls[-1] - path_cpls[0])\n365 |         (sx0, sx1), (sy0, sy1) = interp_vec(target_cpls, path_cpls, screen_xys)\n366 |         angle = np.rad2deg(np.arctan2(sy1 - sy0, sx1 - sx0))  # Screen space.\n367 |         if self.rightside_up:  # Fix angle so text is never upside-down\n368 |             angle = (angle + 90) % 180 - 90\n369 | \n370 |         target_cpls += [-spacing, +spacing]  # Expand range by spacing.\n371 | \n372 |         # Get indices near points of interest; use -1 as out of bounds marker.\n373 |         i0, i1 = np.interp(target_cpls, path_cpls, range(len(path_cpls)),\n374 |                            left=-1, right=-1)\n375 |         i0 = math.floor(i0)\n376 |         i1 = math.ceil(i1)\n377 |         (x0, x1), (y0, y1) = interp_vec(target_cpls, path_cpls, cc_xys)\n378 | \n379 |         # Actually break contours (dropping zero-len parts).\n380 |         new_xy_blocks = []\n381 |         new_code_blocks = []\n382 |         if is_closed_path:\n383 |             if i0 != -1 and i1 != -1:\n384 |                 # This is probably wrong in the case that the entire contour would\n385 |                 # be discarded, but ensures that a valid path is returned and is\n386 |                 # consistent with behavior of mpl <3.8\n387 |                 points = cc_xys[i1:i0+1]\n388 |                 new_xy_blocks.extend([[(x1, y1)], points, [(x0, y0)]])\n389 |                 nlines = len(points) + 1\n390 |                 new_code_blocks.extend([[Path.MOVETO], [Path.LINETO] * nlines])\n391 |         else:\n392 |             if i0 != -1:\n393 |                 new_xy_blocks.extend([cc_xys[:i0 + 1], [(x0, y0)]])\n394 |                 new_code_blocks.extend([[Path.MOVETO], [Path.LINETO] * (i0 + 1)])\n395 |             if i1 != -1:\n396 |                 new_xy_blocks.extend([[(x1, y1)], cc_xys[i1:]])\n397 |                 new_code_blocks.extend([\n398 |                     [Path.MOVETO], [Path.LINETO] * (len(cc_xys) - i1)])\n399 | \n400 |         # Back to the full path.\n401 |         xys = np.concatenate([xys[:start], *new_xy_blocks, xys[stop:]])\n402 |         codes = np.concatenate([codes[:start], *new_code_blocks, codes[stop:]])\n403 | \n404 |         return angle, Path(xys, codes)\n```\n\nFound function `lib/mpl_toolkits/axes_grid1/axes_divider.py:Divider.append_size`.\nSource: Retrieved code content using keyword search (bm25).\n```\n249 | def append_size(self, position, size):\n250 |         _api.check_in_list([\"left\", \"right\", \"bottom\", \"top\"],\n251 |                            position=position)\n252 |         if position == \"left\":\n253 |             self._horizontal.insert(0, size)\n254 |             self._xrefindex += 1\n255 |         elif position == \"right\":\n256 |             self._horizontal.append(size)\n257 |         elif position == \"bottom\":\n258 |             self._vertical.insert(0, size)\n259 |             self._yrefindex += 1\n260 |         else:  # 'top'\n261 |             self._vertical.append(size)\n```\n\nFound class `lib/matplotlib/