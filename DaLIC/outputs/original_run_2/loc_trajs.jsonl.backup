nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 |             axes = axarr.reshape(nrows, ncols).squeeze()\n308 |     else:\n309 |         # returned axis array will be always 2-d, even if nrows=ncols=1\n310 |         axes = axarr.reshape(nrows, ncols)\n311 | \n312 |     return fig, axes\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |         return (1, nplots)\n112 |     elif layout_type == \"vertical\":\n113 |         return (np