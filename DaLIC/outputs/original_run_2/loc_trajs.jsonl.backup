 77 | def _can_use_numexpr(op, op_str, a, b, dtype_check) -> bool:\n 78 |     \"\"\"return a boolean if we WILL be using numexpr\"\"\"\n 79 |     if op_str is not None:\n 80 |         # required min elements (otherwise we are adding overhead)\n 81 |         if a.size > _MIN_ELEMENTS:\n 82 |             # check for dtype compatibility\n 83 |             dtypes: set[str] = set()\n 84 |             for o in [a, b]:\n 85 |                 # ndarray and Series Case\n 86 |                 if hasattr(o, \"dtype\"):\n 87 |                     dtypes |= {o.dtype.name}\n 88 | \n 89 |             # allowed are a superset\n 90 |             if not len(dtypes) or _ALLOWED_DTYPES[dtype_check] >= dtypes:\n 91 |                 return True\n 92 | \n 93 |     return False\n 94 | \n 95 | \n 96 | def _evaluate_numexpr(op, op_str, a, b):\n 97 |     result = None\n 98 | \n 99 |     if _can_use_numexpr(op, op_str, a, b, \"evaluate\"):\n100 |         is_reversed = op.__name__.strip(\"_\").startswith(\"r\")\n101 |         if is_reversed:\n102 |             # we were originally called by a reversed op method\n103 |             a, b = b, a\n104 | \n105 |         a_value = a\n106 |         b_value = b\n107 | \n108 |         try:\n109 |             result = ne.evaluate(\n110 |                 f\"a_value {op_str} b_value\",\n111 |                 local_dict={\"a_value\": a_value, \"b_value\": b_value},\n112 |                 casting=\"safe\",\n113 |             )\n114 |         except TypeError:\n115 |             # numexpr raises eg for array ** array with integers\n116 |             # (https://github.com/pydata/numexpr/issues/379)\n117 |             pass\n118 |         except NotImplementedError:\n119 |             if _bool_arith_fallback(op_str, a, b):\n120 |                 pass\n121 |             else:\n122 |                 raise\n123 | \n124 |         if is_reversed:\n125 |             # reverse order to original for fallback\n126 |             a, b = b, a\n127 | \n128 |     if _TEST_MOD