r and data.\n1374 | \n1375 |         Examples\n1376 |         --------\n1377 |         >>> import matplotlib.pyplot as plt\n1378 |         >>> from sklearn.datasets import make_classification\n1379 |         >>> from sklearn.model_selection import train_test_split\n1380 |         >>> from sklearn.linear_model import LogisticRegression\n1381 |         >>> from sklearn.calibration import CalibrationDisplay\n1382 |         >>> X, y = make_classification(random_state=0)\n1383 |         >>> X_train, X_test, y_train, y_test = train_test_split(\n1384 |         ...     X, y, random_state=0)\n1385 |         >>> clf = LogisticRegression(random_state=0)\n1386 |         >>> clf.fit(X_train, y_train)\n1387 |         LogisticRegression(random_state=0)\n1388 |         >>> y_prob = clf.predict_proba(X_test)[:, 1]\n1389 |         >>> disp = CalibrationDisplay.from_predictions(y_test, y_prob)\n1390 |         >>> plt.show()\n1391 |         \"\"\"\n1392 |         pos_label_validated, name = cls._validate_from_predictions_params(\n1393 |             y_true, y_prob, sample_weight=None, pos_label=pos_label, name=name\n1394 |         )\n1395 | \n1396 |         prob_true, prob_pred = calibration_curve(\n1397 |             y_true, y_prob, n_bins=n_bins, strategy=strategy, pos_label=pos_label\n1398 |         )\n1399 | \n1400 |         disp = cls(\n1401 |             prob_true=prob_true,\n1402 |             prob_pred=prob_pred,\n1403 |             y_prob=y_prob,\n1404 |             estimator_name=name,\n1405 |             pos_label=pos_label_validated,\n1406 |         )\n1407 |         return disp.plot(ax=ax, ref_line=ref_line, **kwargs)\n```\n\nFound function `asv_benchmarks/benchmarks/common.py:get_from_config`.\nSource: Retrieved entity using keyword search (bm25).\n```\n13 | def get_from_config():\n14 |     \"\"\"Get benchmarks configuration from the config.json file\"\"\"\n15 |     current_path = Path(__file__).resolve().parent\n16 | \n17 |     config_path = current_path / \"config.json\"