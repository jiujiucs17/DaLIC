 \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params)\n1684 |         return self\n1685 | \n1686 |     def transform(self, X):\n1687 |         \"\"\"Transform the data X according to the fitted NMF model.\n1688 | \n1689 |         Parameters\n1690 |         ----------\n1691 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1692 |             Training vector, where `n_samples` is the number of samples\n1693 |             and `n_features` is the number of features.\n1694 | \n1695 |         Returns\n1696 |         -------\n1697 |         W : ndarray of shape (n_samples, n_components)\n1698 |             Transformed data.\n1699 |         \"\"\"\n1700 |         check_is_fitted(self)\n1701 |         X = self._validate_data(\n1702 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n1703 |         )\n1704 | \n1705 |         with config_context(assume_finite=True):\n1706 |             W, *_ = self._fit_transform(X, H=self.components_, update_H=False)\n1707 | \n1708 |         return W\n1709 | \n1710 |     def inverse_transform(self, W):\n1711 |         \"\"\"Transform data back to its original space.\n1712 | \n1713 |         .. versionadded:: 0.18\n1714 | \n1715 |         Parameters\n1716 |         ----------\n1717 |         W : {ndarray, sparse matrix} of shape (n_samples, n_components)\n1718 |             Transformed data matrix.\n1719 | \n1720 |         Returns\n1721 |         -------\n1722 |         X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n1723 |             Returns a data matrix of the original shape.\n1724 |         \"\"\"\n1725 |         check_is_fitted(self)\n1726 |         return np.dot(W, self.components_)\n1727 | \n1728 |     @property\n1729 |     def _n_features_out(self):\n1730 |         \"\"\"Number of transformed output features.\"\"\"\n1731 |         return self.components_.shape[0]\n```\n\n\n##Searching for entity `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:_fit_multiplicative_update`.\n```\n725 | def _fit_multiplicative_update(\n726 |     X,\n727 |     W,\n728 |     H,\n729 |     beta_loss=\"frobenius\",\n730 |     max_iter=200,\n731 |     tol=1e-4,\n732 |     l1_reg_W=0,\n733 |     l1_reg_H=0,\n734 |     l2_reg_W=0,\n735 |     l2_reg_H=0,\n736 |     update_H=True,\n737 |     verbose=0,\n738 | ):\n739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n740 | \n741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n742 |     alternating minimization of W and H. Each minimization is done with a\n743 |     Multiplicative Update.\n744 | \n745 |     Parameters\n746 |     ----------\n747 |     X : array-like of shape (n_samples, n_features)\n748 |         Constant input matrix.\n749 | \n750 |     W : array-like of shape (n_samples, n_components)\n751 |         Initial guess for the solution.\n752 | \n753 |     H : array-like of shape (n_components, n_features)\n754 |         Initial guess for the solution.\n755 | \n756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n757 |             'itakura-saito'}, default='frobenius'\n758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n759 |         Beta divergence to be minimized, measuring the distance between X\n760 |         and the dot product WH. Note that values different from 'frobenius'\n761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n763 |         matrix X cannot contain zeros.\n764 | \n765 |     max_iter : int, default=200\n766 |         Number of iterations.\n767 | \n768 |     tol : float, default=1e-4\n769 |         Tolerance of the stopping condition.\n770 | \n771 |     l1_reg_W : float, default=0.\n772 |         L1 regularization parameter for W.\n773 | \n774 |     l1_reg_H : float, default=0.\n775 |         L1 regularization parameter for H.\n776 | \n777 |     l2_reg_W : float, default=0.\n778 |         L2 regularization parameter for W.\n779 | \n780 |     l2_reg_H : float, default=0.\n781 |         L2 regularization parameter for H.\n782 | \n783 |     update_H : bool, default=True\n784 |         Set to True, both W and H will be estimated from initial guesses.\n785 |         Set to False, only W will be estimated.\n786 | \n787 |     verbose : int, default=0\n788 |         The verbosity level.\n789 | \n790 |     Returns\n791 |     -------\n792 |     W : ndarray of shape (n_samples, n_components)\n793 |         Solution to the non-negative least squares problem.\n794 | \n795 |     H : ndarray of shape (n_components, n_features)\n796 |         Solution to the non-negative least squares problem.\n797 | \n798 |     n_iter : int\n799 |         The number of iterations done by the algorithm.\n800 | \n801 |     References\n802 |     ----------\n803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n805 |     \"\"\"\n806 |     start_time = time.time()\n807 | \n808 |     beta_loss = _beta_loss_to_float(beta_loss)\n809 | \n810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n811 |     if beta_loss < 1:\n812 |         gamma = 1.0 / (2.0 - beta_loss)\n813 |     elif beta_loss > 2:\n814 |         gamma = 1.0 / (beta_loss - 1.0)\n815 |     else:\n816 |         gamma = 1.0\n817 | \n818 |     # used for the convergence criterion\n819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n820 |     previous_error = error_at_init\n821 | \n822 |     H_sum, HHt, XHt = None, None, None\n823 |     for n_iter in range(1, max_iter + 1):\n824 |         # update W\n825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n828 |         )\n829 |         W *= delta_W\n830 | \n831 |         # necessary for stability with beta_loss < 1\n832 |         if beta_loss < 1:\n833 |             W[W < np.finfo(np.float64).eps] = 0.0\n834 | \n835 |         # update H\n836 |         if update_H:\n837 |             delta_H = _multiplicative_update_h(\n838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n839 |             )\n840 |             H *= delta_H\n841 | \n842 |             # These values will be recomputed since H changed\n843 |             H_sum, HHt, XHt = None, None, None\n844 | \n845 |             # necessary for stability with beta_loss < 1\n846 |             if beta_loss <= 1:\n847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n848 | \n849 |         # test convergence criterion every 10 iterations\n850 |         if tol > 0 and n_iter % 10 == 0:\n851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n852 | \n853 |             if verbose:\n854 |                 iter_time = time.time()\n855 |                 print(\n856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n857 |                     % (n_iter, iter_time - start_time, error)\n858 |                 )\n859 | \n860 |             if (previous_error - error) / error_at_init < tol:\n861 |                 break\n862 |             previous_error = error\n863 | \n864 |     # do not print if we have already printed in the convergence test\n865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n866 |         end_time = time.time()\n867 |         print(\n868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n869 |         )\n870 | \n871 |     return W, H, n_iter\n```\n\n\n##Searching for entity `sklearn/decomposition/_nmf.py:non_negative_factorization`...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:non_negative_factorization`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:non_negative_factorization`.\n```\n 874 | def non_negative_factorization(\n 875 |     X,\n 876 |     W=None,\n 877 |     H=None,\n 878 |     n_components=None,\n 879 |     *,\n 880 |     init=None,\n 881 |     update_H=True,\n 882 |     solver=\"cd\",\n 883 |     beta_loss=\"frobenius\",\n 884 |     tol=1e-4,\n 885 |     max_iter=200,\n 886 |     alpha=\"deprecated\",\n 887 |     alpha_W=0.0,\n 888 |     alpha_H=\"same\",\n 889 |     l1_ratio=0.0,\n 890 |     regularization=\"deprecated\",\n 891 |     random_state=None,\n 892 |     verbose=0,\n 893 |     shuffle=False,\n 894 | ):\n 895 |     \"\"\"Compute Non-negative Matrix Factorization (NMF).\n 896 | \n 897 |     Find two non-negative matrices (W, H) whose product approximates the non-\n 898 |     negative matrix X. This factorization can be used for example for\n 899 |     dimensionality reduction, source separation or topic extraction.\n 900 | \n 901 |     The objective function is:\n 902 | \n 903 |         .. math::\n 904 | \n 905 |             0.5 * ||X - WH||_{loss}^2\n 906 | \n 907 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n 908 | \n 909 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n 910 | \n 911 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n 912 | \n 913 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n 914 | \n 915 |     Where:\n 916 | \n 917 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n 918 | \n 919 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n 920 | \n 921 |     The generic norm :math:`||X - WH||_{loss}^2` may represent\n 922 |     the Frobenius norm or another supported beta-divergence loss.\n 923 |     The choice between options is controlled by the `beta_loss` parameter.\n 924 | \n 925 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n 926 |     `H` to keep their impact balanced with respect to one another and to the data fit\n 927 |     term as independent as possible of the size `n_samples` of the training set.\n 928 | \n 929 |     The objective function is minimized with an alternating minimization of W\n 930 |     and H. If H is given and update_H=False, it solves for W only.\n 931 | \n 932 |     Note that the transformed data is named W and the components matrix is named H. In\n 933 |     the NMF literature, the naming convention is usually the opposite since the data\n 934 |     matrix X is transposed.\n 935 | \n 936 |     Parameters\n 937 |     ----------\n 938 |     X : array-like of shape (n_samples, n_features)\n 939 |         Constant matrix.\n 940 | \n 941 |     W : array-like of shape (n_samples, n_components), default=None\n 942 |         If init='custom', it is used as initial guess for the solution.\n 943 | \n 944 |     H : array-like of shape (n_components, n_features), default=None\n 945 |         If init='custom', it is used as initial guess for the solution.\n 946 |         If update_H=False, it is used as a constant, to solve for W only.\n 947 | \n 948 |     n_components : int, default=None\n 949 |         Number of components, if n_components is not set all features\n 950 |         are kept.\n 951 | \n 952 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n 953 |         Method used to initialize the procedure.\n 954 | \n 955 |         Valid options:\n 956 | \n 957 |         - None: 'nndsvda' if n_components < n_features, otherwise 'random'.\n 958 | \n 959 |         - 'random': non-negative random matrices, scaled with:\n 960 |             sqrt(X.mean() / n_components)\n 961 | \n 962 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 963 |             initialization (better for sparseness)\n 964 | \n 965 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 966 |             (better when sparsity is not desired)\n 967 | \n 968 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 969 |             (generally faster, less accurate alternative to NNDSVDa\n 970 |             for when sparsity is not desired)\n 971 | \n 972 |         - 'custom': use custom matrices W and H if `update_H=True`. If\n 973 |           `update_H=False`, then only custom matrix H is used.\n 974 | \n 975 |         .. versionchanged:: 0.23\n 976 |             The default value of `init` changed from 'random' to None in 0.23.\n 977 | \n 978 |         .. versionchanged:: 1.1\n 979 |             When `init=None` and n_components is less than n_samples and n_features\n 980 |             defaults to `nndsvda` instead of `nndsvd`.\n 981 | \n 982 |     update_H : bool, default=True\n 983 |         Set to True, both W and H will be estimated from initial guesses.\n 984 |         Set to False, only W will be estimated.\n 985 | \n 986 |     solver : {'cd', 'mu'}, default='cd'\n 987 |         Numerical solver to use:\n 988 | \n 989 |         - 'cd' is a Coordinate Descent solver that uses Fast Hierarchical\n 990 |             Alternating Least Squares (Fast HALS).\n 991 | \n 992 |         - 'mu' is a Multiplicative Update solver.\n 993 | \n 994 |         .. versionadded:: 0.17\n 995 |            Coordinate Descent solver.\n 996 | \n 997 |         .. versionadded:: 0.19\n 998 |            Multiplicative Update solver.\n 999 | \n1000 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1001 |             'itakura-saito'}, default='frobenius'\n1002 |         Beta divergence to be minimized, measuring the distance between X\n1003 |         and the dot product WH. Note that values different from 'frobenius'\n1004 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1005 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1006 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1007 | \n1008 |         .. versionadded:: 0.19\n1009 | \n1010 |     tol : float, default=1e-4\n1011 |         Tolerance of the stopping condition.\n1012 | \n1013 |     max_iter : int, default=200\n1014 |         Maximum number of iterations before timing out.\n1015 | \n1016 |     alpha : float, default=0.0\n1017 |         Constant that multiplies the regularization terms. Set it to zero to have no\n1018 |         regularization. When using `alpha` instead of `alpha_W` and `alpha_H`, the\n1019 |         regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1020 |         factors for `W` (resp. `H`).\n1021 | \n1022 |         .. deprecated:: 1.0\n1023 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1024 |             Use `alpha_W` and `alpha_H` instead.\n1025 | \n1026 |     alpha_W : float, default=0.0\n1027 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1028 |         (default) to have no regularization on `W`.\n1029 | \n1030 |         .. versionadded:: 1.0\n1031 | \n1032 |     alpha_H : float or \"same\", default=\"same\"\n1033 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1034 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1035 |         `alpha_W`.\n1036 | \n1037 |         .. versionadded:: 1.0\n1038 | \n1039 |     l1_ratio : float, default=0.0\n1040 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1041 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1042 |         (aka Frobenius Norm).\n1043 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1044 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1045 | \n1046 |     regularization : {'both', 'components', 'transformation'}, default=None\n1047 |         Select whether the regularization affects the components (H), the\n1048 |         transformation (W), both or none of them.\n1049 | \n1050 |         .. deprecated:: 1.0\n1051 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1052 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1053 | \n1054 |     random_state : int, RandomState instance or None, default=None\n1055 |         Used for NMF initialisation (when ``init`` == 'nndsvdar' or\n1056 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1057 |         results across multiple function calls.\n1058 |         See :term:`Glossary <random_state>`.\n1059 | \n1060 |     verbose : int, default=0\n1061 |         The verbosity level.\n1062 | \n1063 |     shuffle : bool, default=False\n1064 |         If true, randomize the order of coordinates in the CD solver.\n1065 | \n1066 |     Returns\n1067 |     -------\n1068 |     W : ndarray of shape (n_samples, n_components)\n1069 |         Solution to the non-negative least squares problem.\n1070 | \n1071 |     H : ndarray of shape (n_components, n_features)\n1072 |         Solution to the non-negative least squares problem.\n1073 | \n1074 |     n_iter : int\n1075 |         Actual number of iterations.\n1076 | \n1077 |     Examples\n1078 |     --------\n1079 |     >>> import numpy as np\n1080 |     >>> X = np.array([[1,1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1081 |     >>> from sklearn.decomposition import non_negative_factorization\n1082 |     >>> W, H, n_iter = non_negative_factorization(X, n_components=2,\n1083 |     ... init='random', random_state=0)\n1084 | \n1085 |     References\n1086 |     ----------\n1087 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1088 |     large scale nonnegative matrix and tensor factorizations.\"\n1089 |     IEICE transactions on fundamentals of electronics, communications and\n1090 |     computer sciences 92.3: 708-721, 2009.\n1091 | \n1092 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1093 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1094 |     \"\"\"\n1095 |     X = check_array(X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32])\n1096 | \n1097 |     est = NMF(\n1098 |         n_components=n_components,\n1099 |         init=init,\n1100 |         solver=solver,\n1101 |         beta_loss=beta_loss,\n1102 |         tol=tol,\n1103 |         max_iter=max_iter,\n1104 |         random_state=random_state,\n1105 |         alpha=alpha,\n1106 |         alpha_W=alpha_W,\n1107 |         alpha_H=alpha_H,\n1108 |         l1_ratio=l1_ratio,\n1109 |         verbose=verbose,\n1110 |         shuffle=shuffle,\n1111 |         regularization=regularization,\n1112 |     )\n1113 | \n1114 |     with config_context(assume_finite=True):\n1115 |         W, H, n_iter = est._fit_transform(X, W=W, H=H, update_H=update_H)\n1116 | \n1117 |     return W, H, n_iter\n```\n\n\n##Searching for entity `sklearn/decomposition/_nmf.py:_beta_divergence`...\n### Search Result:\nFound function `sklearn/decomposition/_nmf.py:_beta_divergence`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py:_beta_divergence`.\n```\n 68 | def _beta_divergence(X, W, H, beta, square_root=False):\n 69 |     \"\"\"Compute the beta-divergence of X and dot(W, H).\n 70 | \n 71 |     Parameters\n 72 |     ----------\n 73 |     X : float or array-like of shape (n_samples, n_features)\n 74 | \n 75 |     W : float or array-like of shape (n_samples, n_components)\n 76 | \n 77 |     H : float or array-like of shape (n_components, n_features)\n 78 | \n 79 |     beta : float or {'frobenius', 'kullback-leibler', 'itakura-saito'}\n 80 |         Parameter of the beta-divergence.\n 81 |         If beta == 2, this is half the Frobenius *squared* norm.\n 82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n 83 |         If beta == 0, this is the Itakura-Saito divergence.\n 84 |         Else, this is the general beta-divergence.\n 85 | \n 86 |     square_root : bool, default=False\n 87 |         If True, return np.sqrt(2 * res)\n 88 |         For beta == 2, it corresponds to the Frobenius norm.\n 89 | \n 90 |     Returns\n 91 |     -------\n 92 |         res : float\n 93 |             Beta divergence of X and np.dot(X, H).\n 94 |     \"\"\"\n 95 |     beta = _beta_loss_to_float(beta)\n 96 | \n 97 |     # The method can be called with scalars\n 98 |     if not sp.issparse(X):\n 99 |         X = np.atleast_2d(X)\n100 |     W = np.atleast_2d(W)\n101 |     H = np.atleast_2d(H)\n102 | \n103 |     # Frobenius norm\n104 |     if beta == 2:\n105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n106 |         if sp.issparse(X):\n107 |             norm_X = np.dot(X.data, X.data)\n108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n109 |             cross_prod = trace_dot((X * H.T), W)\n110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n111 |         else:\n112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n113 | \n114 |         if square_root:\n115 |             return np.sqrt(res * 2)\n116 |         else:\n117 |             return res\n118 | \n119 |     if sp.issparse(X):\n120 |         # compute np.dot(W, H) only where X is nonzero\n121 |         WH_data = _special_sparse_dot(W, H, X).data\n122 |         X_data = X.data\n123 |     else:\n124 |         WH = np.dot(W, H)\n125 |         WH_data = WH.ravel()\n126 |         X_data = X.ravel()\n127 | \n128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n129 |     indices = X_data > EPSILON\n130 |     WH_data = WH_data[indices]\n131 |     X_data = X_data[indices]\n132 | \n133 |     # used to avoid division by zero\n134 |     WH_data[WH_data == 0] = EPSILON\n135 | \n136 |     # generalized Kullback-Leibler divergence\n137 |     if beta == 1:\n138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n141 |         div = X_data / WH_data\n142 |         res = np.dot(X_data, np.log(div))\n143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n144 |         res += sum_WH - X_data.sum()\n145 | \n146 |     # Itakura-Saito divergence\n147 |     elif beta == 0:\n148 |         div = X_data / WH_data\n149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n150 | \n151 |     # beta-divergence, beta not in (0, 1, 2)\n152 |     else:\n153 |         if sp.issparse(X):\n154 |             # slow loop, but memory efficient computation of :\n155 |             # np.sum(np.dot(W, H) ** beta)\n156 |             sum_WH_beta = 0\n157 |             for i in range(X.shape[1]):\n158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n159 | \n160 |         else:\n161 |             sum_WH_beta = np.sum(WH**beta)\n162 | \n163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n165 |         res += sum_WH_beta * (beta - 1)\n166 |         res /= beta * (beta - 1)\n167 | \n168 |     if square_root:\n169 |         return np.sqrt(2 * res)\n170 |     else:\n171 |         return res\n```\n\n\n##Searching for entity `sklearn/decomposition/_lda.py:LatentDirichletAllocation`...\n### Search Result:\nFound class `sklearn/decomposition/_lda.py:LatentDirichletAllocation`.\nSource: Exact match found for entity name `sklearn/decomposition/_lda.py:LatentDirichletAllocation`.\n```\n141 | class LatentDirichletAllocation(\n142 |     _ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator\n143 | ):\n144 |     \"\"\"Latent Dirichlet Allocation with online variational Bayes algorithm.\n145 | \n146 |     The implementation is based on [1]_ and [2]_.\n147 | \n148 |     .. versionadded:: 0.17\n149 | \n150 |     Read more in the :ref:`User Guide <LatentDirichletAllocation>`.\n151 | \n152 |     Parameters\n153 |     ----------\n154 |     n_components : int, default=10\n155 |         Number of topics.\n156 | \n157 |         .. versionchanged:: 0.19\n158 |             ``n_topics`` was renamed to ``n_components``\n159 | \n160 |     doc_topic_prior : float, default=None\n161 |         Prior of document topic distribution `theta`. If the value is None,\n162 |         defaults to `1 / n_components`.\n163 |         In [1]_, this is called `alpha`.\n164 | \n165 |     topic_word_prior : float, default=None\n166 |         Prior of topic word distribution `beta`. If the value is None, defaults\n167 |         to `1 / n_components`.\n168 |         In [1]_, this is called `eta`.\n169 | \n170 |     learning_method : {'batch', 'online'}, default='batch'\n171 |         Method used to update `_component`. Only used in :meth:`fit` method.\n172 |         In general, if the data size is large, the online update will be much\n173 |         faster than the batch update.\n174 | \n175 |         Valid options::\n176 | \n177 |             'batch': Batch variational Bayes method. Use all training data in\n178 |                 each EM update.\n179 |                 Old `components_` will be overwritten in each iteration.\n180 |             'online': Online variational Bayes method. In each EM update, use\n181 |                 mini-batch of training data to update the ``components_``\n182 |                 variable incrementally. The learning rate is controlled by the\n183 |                 ``learning_decay`` and the ``learning_offset`` parameters.\n184 | \n185 |         .. versionchanged:: 0.20\n186 |             The default learning method is now ``\"batch\"``.\n187 | \n188 |     learning_decay : float, default=0.7\n189 |         It is a parameter that control learning rate in the online learning\n190 |         method. The value should be set between (0.5, 1.0] to guarantee\n191 |         asymptotic convergence. When the value is 0.0 and batch_size is\n192 |         ``n_samples``, the update method is same as batch learning. In the\n193 |         literature, this is called kappa.\n194 | \n195 |     learning_offset : float, default=10.0\n196 |         A (positive) parameter that downweights early iterations in online\n197 |         learning.  It should be greater than 1.0. In the literature, this is\n198 |         called tau_0.\n199 | \n200 |     max_iter : int, default=10\n201 |         The maximum number of passes over the training data (aka epochs).\n202 |         It only impacts the behavior in the :meth:`fit` method, and not the\n203 |         :meth:`partial_fit` method.\n204 | \n205 |     batch_size : int, default=128\n206 |         Number of documents to