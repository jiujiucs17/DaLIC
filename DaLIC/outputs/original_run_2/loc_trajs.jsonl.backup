()\n2070 |     else:\n2071 |         cond = X > threshold\n2072 |         not_cond = np.logical_not(cond)\n2073 |         X[cond] = 1\n2074 |         X[not_cond] = 0\n2075 |     return X\n```\n\n\n\n##Searching for term \"scipy.sparse\"...\n### Search Result:\nFound code snippet in file `sklearn/manifold/_spectral_embedding.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"Spectral Embedding.\"\"\"\n  2 | \n  3 | # Author: Gael Varoquaux <gael.varoquaux@normalesup.org>\n  4 | #         Wei LI <kuantkid@gmail.com>\n  5 | # License: BSD 3 clause\n  6 | \n  7 | \n  8 | from numbers import Integral, Real\n  9 | import warnings\n 10 | \n 11 | import numpy as np\n 12 | from scipy import sparse\n 13 | from scipy.linalg import eigh\n 14 | from scipy.sparse.linalg import eigsh\n 15 | from scipy.sparse.csgraph import connected_components\n 16 | from scipy.sparse.csgraph import laplacian as csgraph_laplacian\n 17 | \n 18 | from ..base import BaseEstimator\n 19 | from ..utils import (\n 20 |     check_array,\n 21 |     check_random_state,\n 22 |     check_symmetric,\n 23 | )\n 24 | from ..utils._arpack import _init_arpack_v0\n 25 | from ..utils.extmath import _deterministic_vector_sign_flip\n 26 | from ..utils._param_validation import Interval, StrOptions\n 27 | from ..utils.fixes import lobpcg\n 28 | from ..metrics.pairwise import rbf_kernel\n 29 | from ..neighbors import kneighbors_graph, NearestNeighbors\n```\n\nFound code snippet in file `sklearn/linear_model/_base.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | Generalized Linear Models.\n  3 | \"\"\"\n  4 | \n  5 | # Author: Alexandre Gramfort <alexandre.gramfort@inria.fr>\n  6 | # Fabian Pedregosa <fabian.pedregosa@inria.fr>\n  7 | # Olivier Grisel <olivier.grisel@ensta.org>\n  8 | #         Vincent Michel <vincent.michel@inria.fr>\n  9 | #         Peter Prettenhofer <peter.prettenhofer@gmail.com>\n 10 | #         Mathieu Blondel <mathieu@mblon