 \n2424 |     Parameters\n2425 |     ----------\n2426 |     estimator : estimator instance\n2427 |         Estimator producing output feature names.\n2428 | \n2429 |     n_feature_out : int\n2430 |         Number of feature names out.\n2431 | \n2432 |     input_features : array-like of str or None, default=None\n2433 |         Only used to validate feature names with `estimator.feature_names_in_`.\n2434 | \n2435 |     Returns\n2436 |     -------\n2437 |     feature_names_in : ndarray of str or `None`\n2438 |         Feature names in.\n2439 |     \"\"\"\n2440 |     _check_feature_names_in(estimator, input_features, generate_names=False)\n2441 |     estimator_name = estimator.__class__.__name__.lower()\n2442 |     return np.asarray(\n2443 |         [f\"{estimator_name}{i}\" for i in range(n_features_out)], dtype=object\n2444 |     )\n2445 | \n2446 | \n2447 | def _check_monotonic_cst(estimator, monotonic_cst=None):\n2448 |     \"\"\"Check the monotonic constraints and return the corresponding array.\n2449 | \n2450 |     This helper function should be used in the `fit` method of an estimator\n2451 |     that supports monotonic constraints and called after the estimator has\n2452 |     introspected input data to set the `n_features_in_` and optionally the\n2453 |     `feature_names_in_` attributes.\n2454 | \n2455 |     .. versionadded:: 1.2\n2456 | \n2457 |     Parameters\n2458 |     ----------\n2459 |     estimator : estimator instance\n2460 | \n2461 |     monotonic_cst : array-like of int, dict of str or None, default=None\n2462 |         Monotonic constraints for the features.\n2463 | \n2464 |         - If array-like, then it should contain only -1, 0 or 1. Each value\n2465 |             will be checked to be in [-1, 0, 1]. If a value is -1, then the\n2466 |             corresponding feature is required to be monotonically decreasing.\n2467 |         - If dict, then it the keys should be the feature names occurring in\n2468 |             `estimator.feature_names_in_` and the values should be -1, 0 or 1.\n2469 |         - If None, then an array of 0s will be allocated.\n2470 | \n2471 |     Returns\n2472 |     -------\n2473 |     monotonic_cst : ndarray of int\n2474 |         Monotonic constraints for each feature.\n2475 |     \"\"\"\n2476 |     original_monotonic_cst = monotonic_cst\n2477 |     if monotonic_cst is None or isinstance(monotonic_cst, dict):\n2478 |         monotonic_cst = np.full(\n2479 |             shape=estimator.n_features_in_,\n2480 |             fill_value=0,\n2481 |             dtype=np.int8,\n2482 |         )\n2483 |         if isinstance(original_monotonic_cst, dict):\n2484 |             if not hasattr(estimator, \"feature_names_in_\"):\n2485 |                 raise ValueError(\n2486 |                     f\"{estimator.__class__.__name__} was not fitted on data \"\n2487 |                     \"with feature names. Pass monotonic_cst as an integer \"\n2488 |                     \"array instead.\"\n2489 |                 )\n2490 |             unexpected_feature_names = list(\n2491 |                 set(original_monotonic_cst) - set(estimator.feature_names_in_)\n2492 |             )\n2493 |             unexpected_feature_names.sort()  # deterministic error message\n2494 |             n_unexpeced = len(unexpected_feature_names)\n2495 |             if unexpected_feature_names:\n2496 |                 if len(unexpected_feature_names) > 5:\n2497 |                     unexpected_feature_names = unexpected_feature_names[:5]\n2498 |                     unexpected_feature_names.append(\"...\")\n2499 |                 raise ValueError(\n2500 |                     f\"monotonic_cst contains {n_unexpeced} unexpected feature \"\n2501 |                     f\"names: {unexpected_feature_names}.\"\n2502 |                 )\n2503 |             for feature_idx, feature_name in enumerate(estimator.feature_names_in_):\n2504 |                 if feature_name in original_monotonic_cst:\n2505 |                     cst = original_monotonic_cst[feature_name]\n2506 |                     if cst not in [-1, 0, 1]:\n2507 |                         raise ValueError(\n2508 |                             f\"monotonic_cst['{feature_name}'] must be either \"\n2509 |                             f\"-1, 0 or 1. Got {cst!r}.\"\n2510 |                         )\n2511 |                     monotonic_cst[feature_idx] = cst\n2512 |     else:\n2513 |         unexpected_cst = np.setdiff1d(monotonic_cst, [-1, 0, 1])\n2514 |         if unexpected_cst.shape[0]:\n2515 |             raise ValueError(\n2516 |                 \"monotonic_cst must be an array-like of -1, 0 or 1. Observed \"\n2517 |                 f\"values: {unexpected_cst.tolist()}.\"\n2518 |             )\n2519 | \n2520 |         monotonic_cst = np.asarray(monotonic_cst, dtype=np.int8)\n2521 |         if monotonic_cst.shape[0] != estimator.n_features_in_:\n2522 |             raise ValueError(\n2523 |                 f\"monotonic_cst has shape {monotonic_cst.shape} but the input data \"\n2524 |                 f\"X has {estimator.n_features_in_} features.\"\n2525 |             )\n2526 |     return monotonic_cst\n2527 | \n2528 | \n2529 | def _check_pos_label_consistency(pos_label, y_true):\n2530 |     \"\"\"Check if `pos_label` need to be specified or not.\n2531 | \n2532 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2533 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2534 |     `pos_label` parameters.\n2535 | \n2536 |     Parameters\n2537 |     ----------\n2538 |     pos_label : int, float, bool, str or None\n2539 |         The positive label.\n2540 |     y_true : ndarray of shape (n_samples,)\n2541 |         The target vector.\n2542 | \n2543 |     Returns\n2544 |     -------\n2545 |     pos_label : int, float, bool or str\n2546 |         If `pos_label` can be inferred, it will be returned.\n2547 | \n2548 |     Raises\n2549 |     ------\n2550 |     ValueError\n2551 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2552 |         it will raise a `ValueError`.\n2553 |     \"\"\"\n2554 |     # ensure binary classification if pos_label is not specified\n2555 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2556 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2557 |     # when elements in the two arrays are not comparable.\n2558 |     if pos_label is None:\n2559 |         # Compute classes only if pos_label is not specified:\n2560 |         classes = np.unique(y_true)\n2561 |         if classes.dtype.kind in \"OUS\" or not (\n2562 |             np.array_equal(classes, [0, 1])\n2563 |             or np.array_equal(classes, [-1, 1])\n2564 |             or np.array_equal(classes, [0])\n2565 |             or np.array_equal(classes, [-1])\n2566 |             or np.array_equal(classes, [1])\n2567 |         ):\n2568 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2569 |             raise ValueError(\n2570 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2571 |                 \"specified: either make y_true take value in {0, 1} or \"\n2572 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2573 |             )\n2574 |         pos_label = 1\n2575 | \n2576 |     return pos_label\n2577 | \n2578 | \n2579 | def _to_object_array(sequence):\n2580 |     \"\"\"Convert sequence to a 1-D NumPy array of object dtype.\n2581 | \n2582 |     numpy.array constructor has a similar use but it's output\n2583 |     is ambiguous. It can be 1-D NumPy array of object dtype if\n2584 |     the input is a ragged array, but if the input is a list of\n2585 |     equal length arrays, then the output is a 2D numpy.array.\n2586 |     _to_object_array solves this ambiguity by guarantying that\n2587 |     the output is a 1-D NumPy array of objects for any input.\n2588 | \n2589 |     Parameters\n2590 |     ----------\n2591 |     sequence : array-like of shape (n_elements,)\n2592 |         The sequence to be converted.\n2593 | \n2594 |     Returns\n2595 |     -------\n2596 |     out : ndarray of shape (n_elements,), dtype=object\n2597 |         The converted sequence into a 1-D NumPy array of object dtype.\n2598 | \n2599 |     Examples\n2600 |     --------\n2601 |     >>> import numpy as np\n2602 |     >>> from sklearn.utils.validation import _to_object_array\n2603 |     >>> _to_object_array([np.array([0]), np.array([1])])\n2604 |     array([array([0]), array([1])], dtype=object)\n2605 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2606 |     array([array([0]), array([1, 2])], dtype=object)\n2607 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2608 |     array([array([0]), array([1, 2])], dtype=object)\n2609 |     \"\"\"\n2610 |     out = np.empty(len(sequence), dtype=object)\n2611 |     out[:] = sequence\n2612 |     return out\n2613 | \n```\n"}, {"content": "Let me explore the dependency structure to understand where the feature should be implemented.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/utils/validation.py']</parameter>\n<parameter=direction>both</parameter>\n<parameter=dependency_type_filter>['imports', 'invokes']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\nsklearn/utils/validation.py\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/__init__.py\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:config_context\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:get_config\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_config.py:set_config\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/__check_build/__init__.py\n\u2502              \u251c\u2500\u2500 imports \u2500\u2500 sklearn/_distributor_init.py\n\u2502  