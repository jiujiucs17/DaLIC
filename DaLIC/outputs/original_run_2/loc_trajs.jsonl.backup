3834 |             of options.\n3835 | \n3836 |         {storage_options}\n3837 | \n3838 |         Returns\n3839 |         -------\n3840 |         None or str\n3841 |             If path_or_buf is None, returns the resulting csv format as a\n3842 |             string. Otherwise returns None.\n3843 | \n3844 |         See Also\n3845 |         --------\n3846 |         read_csv : Load a CSV file into a DataFrame.\n3847 |         to_excel : Write DataFrame to an Excel file.\n3848 | \n3849 |         Examples\n3850 |         --------\n3851 |         Create 'out.csv' containing 'df' without indices\n3852 | \n3853 |         >>> df = pd.DataFrame(\n3854 |         ...     [[\"Raphael\", \"red\", \"sai\"], [\"Donatello\", \"purple\", \"bo staff\"]],\n3855 |         ...     columns=[\"name\", \"mask\", \"weapon\"],\n3856 |         ... )\n3857 |         >>> df.to_csv(\"out.csv\", index=False)  # doctest: +SKIP\n3858 | \n3859 |         Create 'out.zip' containing 'out.csv'\n3860 | \n3861 |         >>> df.to_csv(index=False)\n3862 |         'name,mask,weapon\\nRaphael,red,sai\\nDonatello,purple,bo staff\\n'\n3863 |         >>> compression_opts = dict(\n3864 |         ...     method=\"zip\", archive_name=\"out.csv\"\n3865 |         ... )  # doctest: +SKIP\n3866 |         >>> df.to_csv(\n3867 |         ...     \"out.zip\", index=False, compression=compression_opts\n3868 |         ... )  # doctest: +SKIP\n3869 | \n3870 |         To write a csv file to a new folder or nested folder you will first\n3871 |         need to create it using either Pathlib or os:\n3872 | \n3873 |         >>> from pathlib import Path  # doctest: +SKIP\n3874 |         >>> filepath = Path(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3875 |         >>> filepath.parent.mkdir(parents=True, exist_ok=True)  # doctest: +SKIP\n3876 |         >>> df.to_csv(filepath)  # doctest: +SKIP\n3877 | \n3878 |         >>> import os  # doctest: +SKIP\n3879 |         >>> os.makedirs(\"folder/subfolder\", exist_ok=True)  # doctest: +SKIP\n3880 |         >>> df.to_csv(\"folder/subfolder/out.csv\")  # doctest: +SKIP\n3881 |         \"\"\"\n3882 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n3883 | \n3884 |         formatter = DataFrameFormatter(\n3885 |             frame=df,\n3886 |             header=header,\n3887 |             index=index,\n3888 |             na_rep=na_rep,\n3889 |             float_format=float_format,\n3890 |             decimal=decimal,\n3891 |         )\n3892 | \n3893 |         return DataFrameRenderer(formatter).to_csv(\n3894 |             path_or_buf,\n3895 |             lineterminator=lineterminator,\n3896 |             sep=sep,\n3897 |             encoding=encoding,\n3898 |             errors=errors,\n3899 |             compression=compression,\n3900 |             quoting=quoting,\n3901 |             columns=columns,\n3902 |             index_label=index_label,\n3903 |             mode=mode,\n3904 |             chunksize=chunksize,\n3905 |             quotechar=quotechar,\n3906 |             date_format=date_format,\n3907 |             doublequote=doublequote,\n3908 |             escapechar=escapechar,\n3909 |             storage_options=storage_options,\n3910 |         )\n```\n\nFound class `pandas/core/frame.py:DataFrame`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass DataFrame(NDFrame, OpsMixin):\n\n    _internal_names_set = {\"columns\", \"index\"} | NDFrame._internal_names_set\n    _typ = \"dataframe\"\n    _HANDLED_TYPES = (Series, Index, ExtensionArray, np.ndarray)\n    _accessors: set[str] = {\"sparse\"}\n    _hidden_attrs: frozenset[str] = NDFrame._hidden_attrs | frozenset([])\n    _mgr: BlockManager\n\n    # similar to __array_priority__, positions DataFrame before Series, Index,\n    #  and ExtensionArray.  Should NOT be overridden by subclasses.\n    __pandas_priority__ = 4000\n\n    @property\n    def _constructor(self) -> type[