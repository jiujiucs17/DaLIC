\n 177 |     \"\"\"Throw a ValueError if X contains NaN or infinity.\n 178 | \n 179 |     Parameters\n 180 |     ----------\n 181 |     X : {ndarray, sparse matrix}\n 182 |         The input data.\n 183 | \n 184 |     allow_nan : bool, default=False\n 185 |         If True, do not throw error when `X` contains NaN.\n 186 | \n 187 |     estimator_name : str, default=None\n 188 |         The estimator name, used to construct the error message.\n 189 | \n 190 |     input_name : str, default=\"\"\n 191 |         The data name used to construct the error message. In particular\n 192 |         if `input_name` is \"X\" and the data has NaN values and\n 193 |         allow_nan is False, the error message will link to the imputer\n 194 |         documentation.\n 195 | \n 196 |     Examples\n 197 |     --------\n 198 |     >>> from sklearn.utils import assert_all_finite\n 199 |     >>> import numpy as np\n 200 |     >>> array = np.array([1, np.inf, np.nan, 4])\n 201 |     >>> try:\n 202 |     ...     assert_all_finite(array)\n 203 |     ...     print(\"Test passed: Array contains only finite values.\")\n 204 |     ... except ValueError:\n 205 |     ...     print(\"Test failed: Array contains non-finite values.\")\n 206 |     Test failed: Array contains non-finite values.\n 207 |     \"\"\"\n 208 |     _assert_all_finite(\n 209 |         X.data if sp.issparse(X) else X,\n 210 |         allow_nan=allow_nan,\n 211 |         estimator_name=estimator_name,\n 212 |         input_name=input_name,\n 213 |     )\n 214 | \n 215 | \n 216 | def as_float_array(\n 217 |     X, *, copy=True, force_all_finite=\"deprecated\", ensure_all_finite=None\n 218 | ):\n 219 |     \"\"\"Convert an array-like to an array of floats.\n 220 | \n 221 |     The new dtype will be np.float32 or np.float64, depending on the original\n 222 |     type. The function can create a copy or modify the argument depending\n 223 |     on the argument copy.\n 224 | \n 225 |     Parameters\n 226 |     ----------\n 227 |     X : {array-like, sparse matrix}\n 228 |         The input data.\n 229 | \n 230 |     copy : bool, default=True\n 231 |         If True, a copy of X will be created. If False, a copy may still be\n 232 |         returned if X's dtype is not a floating point type.\n 233 | \n 234 |     force_all_finite : bool or 'allow-nan', default=True\n 235 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 236 |         possibilities are:\n 237 | \n 238 |         - True: Force all values of X to be finite.\n 239 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 240 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 241 |           be infinite.\n 242 | \n 243 |         .. versionadded:: 0.20\n 244 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n 245 | \n 246 |         .. versionchanged:: 0.23\n 247 |            Accepts `pd.NA` and converts it into `np.nan`\n 248 | \n 249 |         .. deprecated:: 1.6\n 250 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n 251 |            in 1.8.\n 252 | \n 253 |     ensure_all_finite : bool or 'allow-nan', default=True\n 254 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 255 |         possibilities are:\n 256 | \n 257 |         - True: Force all values of X to be finite.\n 258 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 259 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 260 |           be infinite.\n 261 | \n 262 |         .. versionadded:: 1.6\n 263 |            `force_all_finite` was renamed to `ensure_all_finite`.\n 264 | \n 265 |     Returns\n 266 |     -------\n 267 |     XT : {ndarray, sparse matrix}\n 268 |         An array of type float.\n 269 | \n 270 |     Examples\n 271 |     --------\n 272 |     >>> from sklearn.utils import as_float_array\n 273 |     >>> import numpy as np\n 274 |     >>> array = np.array([0, 0, 1, 2, 2], dtype=np.int64)\n 275 |     >>> as_float_array(array)\n 276 |     array([0., 0., 1., 2., 2.])\n 277 |     \"\"\"\n 278 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n 279 | \n 280 |     if isinstance(X, np.matrix) or (\n 281 |         not isinstance(X, np.ndarray) and not sp.issparse(X)\n 282 |     ):\n 283 |         return check_array(\n 284 |             X,\n 285 |             accept_sparse=[\"csr\", \"csc\", \"coo\"],\n 286 |             dtype=np.float64,\n 287 |             copy=copy,\n 288 |             ensure_all_finite=ensure_all_finite,\n 289 |             ensure_2d=False,\n 290 |         )\n 291 |     elif sp.issparse(X) and X.dtype in [np.float32, np.float64]:\n 292 |         return X.copy() if copy else X\n 293 |     elif X.dtype in [np.float32, np.float64]:  # is numpy array\n 294 |         return X.copy(\"F\" if X.flags[\"F_CONTIGUOUS\"] else \"C\") if copy else X\n 295 |     else:\n 296 |         if X.dtype.kind in \"uib\" and X.dtype.itemsize <= 4:\n 297 |             return_dtype = np.float32\n 298 |         else:\n 299 |             return_dtype = np.float64\n 300 |         return X.astype(return_dtype)\n 301 | \n 302 | \n 303 | def _is_arraylike(x):\n 304 |     \"\"\"Returns whether the input is array-like.\"\"\"\n 305 |     if sp.issparse(x):\n 306 |         return False\n 307 | \n 308 |     return hasattr(x, \"__len__\") or hasattr(x, \"shape\") or hasattr(x, \"__array__\")\n 309 | \n 310 | \n 311 | def _is_arraylike_not_scalar(array):\n 312 |     \"\"\"Return True if array is array-like and not a scalar\"\"\"\n 313 |     return _is_arraylike(array) and not np.isscalar(array)\n 314 | \n 315 | \n 316 | def _use_interchange_protocol(X):\n 317 |     \"\"\"Use interchange protocol for non-pandas dataframes that follow the protocol.\n 318 | \n 319 |     Note: at this point we chose not to use the interchange API on pandas dataframe\n 320 |     to ensure strict behavioral backward compatibility with older versions of\n 321 |     scikit-learn.\n 322 |     \"\"\"\n 323 |     return not _is_pandas_df(X) and hasattr(X, \"__dataframe__\")\n 324 | \n 325 | \n 326 | def _num_features(X):\n 327 |     \"\"\"Return the number of features in an array-like X.\n 328 | \n 329 |     This helper function tries hard to avoid to materialize an array version\n 330 |     of X unless necessary. For instance, if X is a list of lists,\n 331 |     this function will return the length of the first element, assuming\n 332 |     that subsequent elements are all lists of the same length without\n 333 |     checking.\n 334 |     Parameters\n 335 |     ----------\n 336 |     X : array-like\n 337 |         array-like to get the number of features.\n 338 | \n 339 |     Returns\n 340 |     -------\n 341 |     features : int\n 342 |         Number of features\n 343 |     \"\"\"\n 344 |     type_ = type(X)\n 345 |     if type_.__module__ == \"builtins\":\n 346 |         type_name = type_.__qualname__\n 347 |     else:\n 348 |         type_name = f\"{type_.__module__}.{type_.__qualname__}\"\n 349 |     message = f\"Unable to find the number of features from X of type {type_name}\"\n 350 |     if not hasattr(X, \"__len__\") and not hasattr(X, \"shape\"):\n 351 |         if not hasattr(X, \"__array__\"):\n 352 |             raise TypeError(message)\n 353 |         # Only convert X to a numpy array if there is no cheaper, heuristic\n 354 |         # option.\n 355 |         X = np.asarray(X)\n 356 | \n 357 |     if hasattr(X, \"shape\"):\n 358 |         if not hasattr(X.shape, \"__len__\") or len(X.shape) <= 1:\n 359 |             message += f\" with shape {X.shape}\"\n 360 |             raise TypeError(message)\n 361 |         return X.shape[1]\n 362 | \n 363 |     first_sample = X[0]\n 364 | \n 365 |     # Do not consider an array-like of strings or dicts to be a 2D array\n 366 |     if isinstance(first_sample, (str, bytes, dict)):\n 367 |         message += f\" where the samples are of type {type(first_sample).__qualname__}\"\n 368 |         raise TypeError(message)\n 369 | \n 370 |     try:\n 371 |         # If X is a list of lists, for instance, we assume that all nested\n 372 |         # lists have the same length without checking or converting to\n 373 |         # a numpy array to keep this function call as cheap as possible.\n 374 |         return len(first_sample)\n 375 |     except Exception as err:\n 376 |         raise TypeError(message) from err\n 377 | \n 378 | \n 379 | def _num_samples(x):\n 380 |     \"\"\"Return number of samples in array-like x.\"\"\"\n 381 |     message = \"Expected sequence or array-like, got %s\" % type(x)\n 382 |     if hasattr(x, \"fit\") and callable(x.fit):\n 383 |         # Don't get num_samples from an ensembles length!\n 384 |         raise TypeError(message)\n 385 | \n 386 |     if _use_interchange_protocol(x):\n 387 |         return x.__dataframe__().num_rows()\n 388 | \n 389 |     if not hasattr(x, \"__len__\") and not hasattr(x, \"shape\"):\n 390 |         if hasattr(x, \"__array__\"):\n 391 |             x = np.asarray(x)\n 392 |         else:\n 393 |             raise TypeError(message)\n 394 | \n 395 |     if hasattr(x, \"shape\") and x.shape is not None:\n 396 |         if len(x.shape) == 0:\n 397 |             raise TypeError(\n 398 |                 \"Singleton array %r cannot be considered a valid collection.\" % x\n 399 |             )\n 400 |         # Check that shape is returning an integer or default to len\n 401 |         # Dask dataframes may not return numeric shape[0] value\n 402 |         if isinstance(x.shape[0], numbers.Integral):\n 403 |             return x.shape[0]\n 404 | \n 405 |     try:\n 406 |         return len(x)\n 407 |     except TypeError as type_error:\n 408 |         raise TypeError(message) from type_error\n 409 | \n 410 | \n 411 | def check_memory(memory):\n 412 |     \"\"\"Check that ``memory`` is joblib.Memory-like.\n 413 | \n 414 |     joblib.Memory-like means that ``memory`` can be converted into a\n 415 |     joblib.Memory instance (typically a str denoting the ``location``)\n 416 |     or has the same interface (has a ``cache`` method).\n 417 | \n 418 |     Parameters\n 419 |     ----------\n 420 |     memory : None, str or object with the joblib.Memory interface\n 421 |         - If string, the location where to create the `joblib.Memory` interface.\n 422 |         - If None, no caching is done and the Memory object is completely transparent.\n 423 | \n 424 |     Returns\n 425 |     -------\n 426 |     memory : object with the joblib.Memory interface\n 427 |         A correct joblib.Memory object.\n 428 | \n 429 |     Raises\n 430 |     ------\n 431 |     ValueError\n 432 |         If ``memory`` is not joblib.Memory-like.\n 433 | \n 434 |     Examples\n 435 |     --------\n 436 |     >>> from sklearn.utils.validation import check_memory\n 437 |     >>> check_memory(\"caching_dir\")\n 438 |     Memory(location=caching_dir/joblib)\n 439 |     \"\"\"\n 440 |     if memory is None or isinstance(memory, str):\n 441 |         memory = joblib.Memory(location=memory, verbose=0)\n 442 |     elif not hasattr(memory, \"cache\"):\n 443 |         raise ValueError(\n 444 |             \"'memory' should be None, a string or have the same\"\n 445 |             \" interface as joblib.Memory.\"\n 446 |             \" Got memory='{}' instead.\".format(memory)\n 447 |         )\n 448 |     return memory\n 449 | \n 450 | \n 451 | def check_consistent_length(*arrays):\n 452 |     \"\"\"Check that all arrays have consistent first dimensions.\n 453 | \n 454 |     Checks whether all objects in arrays have the same shape or length.\n 455 | \n 456 |     Parameters\n 457 |     ----------\n 458 |     *arrays : list or tuple of input objects.\n 459 |         Objects that will be checked for consistent length.\n 460 | \n 461 |     Examples\n 462 |     --------\n 463 |     >>> from sklearn.utils.validation import check_consistent_length\n 464 |     >>> a = [1, 2, 3]\n 465 |     >>> b = [2, 3, 4]\n 466 |     >>> check_consistent_length(a, b)\n 467 |     \"\"\"\n 468 | \n 469 |     lengths = [_num_samples(X) for X in arrays if X is not None]\n 470 |     uniques = np.unique(lengths)\n 471 |     if len(uniques) > 1:\n 472 |         raise ValueError(\n 473 |             \"Found input variables with inconsistent numbers of samples: %r\"\n 474 |             % [int(l) for l in lengths]\n 475 |         )\n 476 | \n 477 | \n 478 | def _make_indexable(iterable):\n 479 |     \"\"\"Ensure iterable supports indexing or convert to an indexable variant.\n 480 | \n 481 |     Convert sparse matrices to csr and other non-indexable iterable to arrays.\n 482 |     Let `None` and indexable objects (e.g. pandas dataframes) pass unchanged.\n 483 | \n 484 |     Parameters\n 485 |     ----------\n 486 |     iterable : {list, dataframe, ndarray, sparse matrix} or None\n 487 |         Object to be converted to an indexable iterable.\n 488 |     \"\"\"\n 489 |     if sp.issparse(iterable):\n 490 |         return iterable.tocsr()\n 491 |     elif hasattr(iterable, \"__getitem__\") or hasattr(iterable, \"iloc\"):\n 492 |         return iterable\n 493 |     elif iterable is None:\n 494 |         return iterable\n 495 |     return np.array(iterable)\n 496 | \n 497 | \n 498 | def indexable(*iterables):\n 499 |     \"\"\"Make arrays indexable for cross-validation.\n 500 | \n 501 |     Checks consistent length, passes through None, and ensures that everything\n 502 |     can be indexed by converting sparse matrices to csr and converting\n 503 |     non-iterable objects to arrays.\n 504 | \n 505 |     Parameters\n 506 |     ----------\n 507 |     *iterables : {lists, dataframes, ndarrays, sparse matrices}\n 508 |         List of objects to ensure sliceability.\n 509 | \n 510 |     Returns\n 511 |     -------\n 512 |     result : list of {ndarray, sparse matrix, dataframe} or None\n 513 |         Returns a list containing indexable arrays (i.e. NumPy array,\n 514 |         sparse matrix, or dataframe) or `None`.\n 515 | \n 516 |     Examples\n 517 |     --------\n 518 |     >>> from sklearn.utils import indexable\n 519 |     >>> from scipy.sparse import csr_matrix\n 520 |     >>> import numpy as np\n 521 |     >>> iterables = [\n 522 |     ...     [1, 2, 3], np.array([2, 3, 4]), None, csr_matrix([[5], [6], [7]])\n 523 |     ... ]\n 524 |     >>> indexable(*iterables)\n 525 |     [[1, 2, 3], array([2, 3, 4]), None, <...Sparse...dtype 'int64'...shape (3, 1)>]\n 526 |     \"\"\"\n 527 | \n 528 |     result = [_make_indexable(X) for X in iterables]\n 529 |     check_consistent_length(*result)\n 530 |     return result\n 531 | \n 532 | \n 533 | def _ensure_sparse_format(\n 534 |     sparse_container,\n 535 |     accept_sparse,\n 536 |     dtype,\n 537 |     copy,\n 538 |     ensure_all_finite,\n 539 |     accept_large_sparse,\n 540 |     estimator_name=None,\n 541 |     input_name=\"\",\n 542 | ):\n 543 |     \"\"\"Convert a sparse container to a given format.\n 544 | \n 545 |     Checks the sparse format of `sparse_container` and converts if necessary.\n 546 | \n 547 |     Parameters\n 548 |     ----------\n 549 |     sparse_container : sparse matrix or array\n 550 |         Input to validate and convert.\n 551 | \n 552 |     accept_sparse : str, bool or list/tuple of str\n 553 |         String[s] representing allowed sparse matrix formats ('csc',\n 554 |         'csr', 'coo', 'dok', 'bsr', 'lil', 'dia'). If the input is sparse but\n 555 |         not in the allowed format, it will be converted to the first listed\n 556 |         format. True allows the input to be any format. False means\n 557 |         that a sparse matrix input will raise an error.\n 558 | \n 559 |     dtype : str, type or None\n 560 |         Data type of result. If None, the dtype of the input is preserved.\n 561 | \n 562 |     copy : bool\n 563 |         Whether a forced copy will be triggered. If copy=False, a copy might\n 564 |         be triggered by a conversion.\n 565 | \n 566 |     ensure_all_finite : bool or 'allow-nan'\n 567 |         Whether to raise an error on np.inf, np.nan, pd.NA in X. The\n 568 |         possibilities are:\n 569 | \n 570 |         - True: Force all values of X to be finite.\n 571 |         - False: accepts np.inf, np.nan, pd.NA in X.\n 572 |         - 'allow-nan': accepts only np.nan and pd.NA values in X. Values cannot\n 573 |           be infinite.\n 574 | \n 575 |         .. versionadded:: 0.20\n 576 |            ``ensure_all_finite`` accepts the string ``'allow-nan'``.\n 577 | \n 578 |         .. versionchanged:: 0.23\n 579 |            Accepts `pd.NA` and converts it into `np.nan`\n 580 | \n 581 | \n 582 |     estimator_name : str, default=None\n 583 |         The estimator name, used to construct the error message.\n 584 | \n 585 |     input_name : str, default=\"\"\n 586 |         The data name used to construct the error message. In particular\n 587 |         if `input_name` is \"X\" and the data has NaN values and\n 588 |         allow_nan is False, the error message will link to the imputer\n 589 |         documentation.\n 590 | \n 591 |     Returns\n 592 |     -------\n 593 |     sparse_container_converted : sparse matrix or array\n 594 |         Sparse container (matrix/array) that is ensured to have an allowed type.\n 595 |     \"\"\"\n 596 |     if dtype is None:\n 597 |         dtype = sparse_container.dtype\n 598 | \n 599 |     changed_format = False\n 600 |     sparse_container_type_name = type(sparse_container).__name__\n 601 | \n 602 |     if isinstance(accept_sparse, str):\n 603 |         accept_sparse = [accept_sparse]\n 604 | \n 605 |     # Indices dtype validation\n 606 |     _check_large_sparse(sparse_container, accept_large_sparse)\n 607 | \n 608 |     if accept_sparse is False:\n 609 |         padded_input = \" for \" + input_name if input_name else \"\"\n 610 |         raise TypeError(\n 611 |             f\"Sparse data was passed{padded_input}, but dense data is required. \"\n 612 |             \"Use '.toarray()' to convert to a dense numpy array.\"\n 613 |         )\n 614 |     elif isinstance(accept_sparse, (list, tuple)):\n 615 |         if len(accept_sparse) == 0:\n 616 |             raise ValueError(\n 617 |                 \"When providing 'accept_sparse' as a tuple or list, it must contain at \"\n 618 |                 \"least one string value.\"\n 619 |             )\n 620 |         # ensure correct sparse format\n 621 |         if sparse_container.format not in accept_sparse:\n 622 |             # create new with correct sparse\n 623 |             sparse_container = sparse_container.asformat(accept_sparse[0])\n 624 |             changed_format = True\n 625 |     elif accept_sparse is not True:\n 626 |         # any other type\n 627 |         raise ValueError(\n 628 |             \"Parameter 'accept_sparse' should be a string, boolean or list of strings.\"\n 629 |             f\" You provided 'accept_sparse={accept_sparse}'.\"\n 630 |         )\n 631 | \n 632 |     if dtype != sparse_container.dtype:\n 633 |         # convert dtype\n 634 |         sparse_container = sparse_container.astype(dtype)\n 635 |     elif copy and not changed_format:\n 636 |         # force copy\n 637 |         sparse_container = sparse_container.copy()\n 638 | \n 639 |     if ensure_all_finite:\n 640 |         if not hasattr(sparse_container, \"data\"):\n 641 |             warnings.warn(\n 642 |                 f\"Can't check {sparse_container.format} sparse matrix for nan or inf.\",\n 643 |                 stacklevel=2,\n 644 |             )\n 645 |         else:\n 646 |             _assert_all_finite(\n 647 |                 sparse_container.data,\n 648 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n 649 |                 estimator_name=estimator_name,\n 650 |                 input_name=input_name,\n 651 |             )\n 652 | \n 653 |     # TODO: Remove when the minimum version of SciPy supported is 1.12\n 654 |     # With SciPy sparse arrays, conversion from DIA format to COO, CSR, or BSR\n 655 |     # triggers the use of `np.int64` indices even if the data is such that it could\n 656 |     # be more efficiently represented with `np.int32` indices.\n 657 |     # https://github.com/scipy/scipy/issues/19245 Since not all scikit-learn\n 658 |     # algorithms support large indices, the following code downcasts to `np.int32`\n 659 |     # indices when it's safe to do so.\n 660 |     if changed_format:\n 661 |         # accept_sparse is specified to a specific format and a conversion occurred\n 662 |         requested_sparse_format = accept_sparse[0]\n 663 |         _preserve_dia_indices_dtype(\n 664 |             sparse_container, sparse_container_type_name, requested_sparse_format\n 665 |         )\n 666 | \n 667 |     return sparse_container\n 668 | \n 669 | \n 670 | def _ensure_no_complex_data(array):\n 671 |     if (\n 672 |         hasattr(array, \"dtype\")\n 673 |         and array.dtype is not None\n 674 |         and hasattr(array.dtype, \"kind\")\n 675 |         and array.dtype.kind == \"c\"\n 676 |     ):\n 677 |         raise ValueError(\"Complex data not supported\\n{}\\n\".format(array))\n 678 | \n 679 | \n 680 | def _check_estimator_name(estimator):\n 681 |     if estimator is not None:\n 682 |         if isinstance(estimator, str):\n 683 |             return estimator\n 684 |         else:\n 685 |             return estimator.__class__.__name__\n 686 |     return None\n 687 | \n 688 | \n 689 | def _pandas_dtype_needs_early_conversion(pd_dtype):\n 690 |     \"\"\"Return True if pandas extension pd_dtype need to be converted early.\"\"\"\n 691 |     # Check these early for pandas versions without extension dtypes\n 692 |     from pandas import SparseDtype\n 693 |     from pandas.api.types import (\n 694 |         is_bool_dtype,\n 695 |         is_float_dtype,\n 696 |         is_integer_dtype,\n 697 |     )\n 698 | \n 699 |     if is_bool_dtype(pd_dtype):\n 700 |         # bool and extension booleans need early conversion because __array__\n 701 |         # converts mixed dtype dataframes into object dtypes\n 702 |         return True\n 703 | \n 704 |     if isinstance(pd_dtype, SparseDtype):\n 705 |         # Sparse arrays will be converted later in `check_array`\n 706 |         return False\n 707 | \n 708 |     try:\n 709 |         from pandas.api.types import is_extension_array_dtype\n 710 |     except ImportError:\n 711 |         return False\n 712 | \n 713 |     if isinstance(pd_dtype, SparseDtype) or not is_extension_array_dtype(pd_dtype):\n 714 |         # Sparse arrays will be converted later in `check_array`\n 715 |         # Only handle extension arrays for integer and floats\n 716 |         return False\n 717 |     elif is_float_dtype(pd_dtype):\n 718 |         # Float ndarrays can normally support nans. They need to be converted\n 719 |         # first to map pd.NA to np.nan\n 720 |         return True\n 721 |     elif is_integer_dtype(pd_dtype):\n 722 |         # XXX: Warn when converting from a high integer to a float\n 723 |         return True\n 724 | \n 725 |     return False\n 726 | \n 727 | \n 728 | def _is_extension_array_dtype(array):\n 729 |     # Pandas extension arrays have a dtype with an na_value\n 730 |     return hasattr(array, \"dtype\") and hasattr(array.dtype, \"na_value\")\n 731 | \n 732 | \n 733 | def check_array(\n 734 |     array,\n 735 |     accept_sparse=False,\n 736 |     *,\n 737 |     accept_large_sparse=True,\n 738 |     dtype=\"numeric\",\n 739 |     order=None,\n 740 |     copy=False,\n 741 |     force_writeable=False,\n 742 |     force_all_finite=\"deprecated\",\n 743 |     ensure_all_finite=None,\n 744 |     ensure_non_negative=False,\n 745 |     ensure_2d=True,\n 746 |     allow_nd=False,\n 747 |     ensure_min_samples=1,\n 748 |     ensure_min_features=1,\n 749 |     estimator=None,\n 750 |     input_name=\"\",\n 751 | ):\n 752 |     \"\"\"Input validation on an array, list, sparse matrix or similar.\n 753 | \n 754 |     By default, the input is checked to be a non-empty 2D array containing\n 755 |     only finite values. If the dtype of the array is object, attempt\n 756 |     converting to float, raising on failure.\n 757 | \n 758 |     Parameters\n 759 |     ----------\n 760 |     array : object\n 761 |         Input object to check / convert.\n 762 | \n 763 |     accept_sparse : str, bool or list/tuple of str, default=False\n 764 |         String[s] representing allowed sparse matrix formats, such as 'csc',\n 765 |         'csr', etc. If the input is sparse but not in the allowed format,\n 766 |         it will be converted to the first listed format. True allows the input\n 767 |         to be any format. False means that a sparse matrix input will\n 768 |         raise an error.\n 769 | \n 770 |     accept_large_sparse : bool, default=True\n 771 |         If a CSR, CSC, COO or BSR sparse matrix is supplied and accepted by\n 772 |         accept_sparse, accept_large_sparse=False will cause it to be accepted\n 773 |         only if its indices are stored with a 32-bit dtype.\n 774 | \n 775 |         .. versionadded:: 0.20\n 776 | \n 777 |     dtype : 'numeric', type, list of type or None, default='numeric'\n 778 |         Data type of result. If None, the dtype of the input is preserved.\n 779 |         If \"numeric\", dtype is preserved unless array.dtype is object.\n 780 |         If dtype is a list of types, conversion on the first type is only\n 781 |         performed if the dtype of the input is not in the list.\n 782 | \n 783 |     order : {'F', 'C'} or None, default=None\n 784 |         Whether an array will be forced to be fortran or c-style.\n 785 |         When order is None (default), then if copy=False, nothing is ensured\n 786 |         about the memory layout of the output array; otherwise (copy=True)\n 787 |         the memory layout of the returned array is kept as close as possible\n 788 |         to the original array.\n 789 | \n 790 |     copy : bool, default=False\n 791 |         Whether a forced copy will be triggered. If copy=False, a copy might\n 792 |         be triggered by a conversion.\n 793 | \n 794 |     force_writeable : bool, default=False\n 795 |         Whether to force the output array to be writeable. If True, the returned array\n 796 |         is guaranteed to be writeable, which may require a copy. Otherwise the\n 797 |         writeability of the input array is preserved.\n 798 | \n 799 |         .. versionadded:: 1.6\n 800 | \n 801 |     force_all_finite : bool or 'allow-nan', default=True\n 802 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 803 |         possibilities are:\n 804 | \n 805 |         - True: Force all values of array to be finite.\n 806 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 807 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 808 |           cannot be infinite.\n 809 | \n 810 |         .. versionadded:: 0.20\n 811 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n 812 | \n 813 |         .. versionchanged:: 0.23\n 814 |            Accepts `pd.NA` and converts it into `np.nan`\n 815 | \n 816 |         .. deprecated:: 1.6\n 817 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n 818 |            in 1.8.\n 819 | \n 820 |     ensure_all_finite : bool or 'allow-nan', default=True\n 821 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 822 |         possibilities are:\n 823 | \n 824 |         - True: Force all values of array to be finite.\n 825 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 826 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 827 |           cannot be infinite.\n 828 | \n 829 |         .. versionadded:: 1.6\n 830 |            `force_all_finite` was renamed to `ensure_all_finite`.\n 831 | \n 832 |     ensure_non_negative : bool, default=False\n 833 |         Make sure the array has only non-negative values. If True, an array that\n 834 |         contains negative values will raise a ValueError.\n 835 | \n 836 |         .. versionadded:: 1.6\n 837 | \n 838 |     ensure_2d : bool, default=True\n 839 |         Whether to raise a value error if array is not 2D.\n 840 | \n 841 |     allow_nd : bool, default=False\n 842 |         Whether to allow array.ndim > 2.\n 843 | \n 844 |     ensure_min_samples : int, default=1\n 845 |         Make sure that the array has a minimum number of samples in its first\n 846 |         axis (rows for a 2D array). Setting to 0 disables this check.\n 847 | \n 848 |     ensure_min_features : int, default=1\n 849 |         Make sure that the 2D array has some minimum number of features\n 850 |         (columns). The default value of 1 rejects empty datasets.\n 851 |         This check is only enforced when the input data has effectively 2\n 852 |         dimensions or is originally 1D and ``ensure_2d`` is True. Setting to 0\n 853 |         disables this check.\n 854 | \n 855 |     estimator : str or estimator instance, default=None\n 856 |         If passed, include the name of the estimator in warning messages.\n 857 | \n 858 |     input_name : str, default=\"\"\n 859 |         The data name used to construct the error message. In particular\n 860 |         if `input_name` is \"X\" and the data has NaN values and\n 861 |         allow_nan is False, the error message will link to the imputer\n 862 |         documentation.\n 863 | \n 864 |         .. versionadded:: 1.1.0\n 865 | \n 866 |     Returns\n 867 |     -------\n 868 |     array_converted : object\n 869 |         The converted and validated array.\n 870 | \n 871 |     Examples\n 872 |     --------\n 873 |     >>> from sklearn.utils.validation import check_array\n 874 |     >>> X = [[1, 2, 3], [4, 5, 6]]\n 875 |     >>> X_checked = check_array(X)\n 876 |     >>> X_checked\n 877 |     array([[1, 2, 3], [4, 5, 6]])\n 878 |     \"\"\"\n 879 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n 880 | \n 881 |     if isinstance(array, np.matrix):\n 882 |         raise TypeError(\n 883 |             \"np.matrix is not supported. Please convert to a numpy array with \"\n 884 |             \"np.asarray. For more information see: \"\n 885 |             \"https://numpy.org/doc/stable/reference/generated/numpy.matrix.html\"\n 886 |         )\n 887 | \n 888 |     xp, is_array_api_compliant = get_namespace(array)\n 889 | \n 890 |     # store reference to original array to check if copy is needed when\n 891 |     # function returns\n 892 |     array_orig = array\n 893 | \n 894 |     # store whether originally we wanted numeric dtype\n 895 |     dtype_numeric = isinstance(dtype, str) and dtype == \"numeric\"\n 896 | \n 897 |     dtype_orig = getattr(array, \"dtype\", None)\n 898 |     if not is_array_api_compliant and not hasattr(dtype_orig, \"kind\"):\n 899 |         # not a data type (e.g. a column named dtype in a pandas DataFrame)\n 900 |         dtype_orig = None\n 901 | \n 902 |     # check if the object contains several dtypes (typically a pandas\n 903 |     # DataFrame), and store them. If not, store None.\n 904 |     dtypes_orig = None\n 905 |     pandas_requires_conversion = False\n 906 |     # track if we have a Series-like object to raise a better error message\n 907 |     type_if_series = None\n 908 |     if hasattr(array, \"dtypes\") and hasattr(array.dtypes, \"__array__\"):\n 909 |         # throw warning if columns are sparse. If all columns are sparse, then\n 910 |         # array.sparse exists and sparsity will be preserved (later).\n 911 |         with suppress(ImportError):\n 912 |             from pandas import SparseDtype\n 913 | \n 914 |             def is_sparse(dtype):\n 915 |                 return isinstance(dtype, SparseDtype)\n 916 | \n 917 |             if not hasattr(array, \"sparse\") and array.dtypes.apply(is_sparse).any():\n 918 |                 warnings.warn(\n 919 |                     \"pandas.DataFrame with sparse columns found.\"\n 920 |                     \"It will be converted to a dense numpy array.\"\n 921 |                 )\n 922 | \n 923 |         dtypes_orig = list(array.dtypes)\n 924 |         pandas_requires_conversion = any(\n 925 |             _pandas_dtype_needs_early_conversion(i) for i in dtypes_orig\n 926 |         )\n 927 |         if all(isinstance(dtype_iter, np.dtype) for dtype_iter in dtypes_orig):\n 928 |             dtype_orig = np.result_type(*dtypes_orig)\n 929 |         elif pandas_requires_conversion and any(d == object for d in dtypes_orig):\n 930 |             # Force object if any of the dtypes is an object\n 931 |             dtype_orig = object\n 932 | \n 933 |     elif (_is_extension_array_dtype(array) or hasattr(array, \"iloc\")) and hasattr(\n 934 |         array, \"dtype\"\n 935 |     ):\n 936 |         # array is a pandas series\n 937 |         type_if_series = type(array)\n 938 |         pandas_requires_conversion = _pandas_dtype_needs_early_conversion(array.dtype)\n 939 |         if isinstance(array.dtype, np.dtype):\n 940 |             dtype_orig = array.dtype\n 941 |         else:\n 942 |             # Set to None to let array.astype work out the best dtype\n 943 |             dtype_orig = None\n 944 | \n 945 |     if dtype_numeric:\n 946 |         if (\n 947 |             dtype_orig is not None\n 948 |             and hasattr(dtype_orig, \"kind\")\n 949 |             and dtype_orig.kind == \"O\"\n 950 |         ):\n 951 |             # if input is object, convert to float.\n 952 |             dtype = xp.float64\n 953 |         else:\n 954 |             dtype = None\n 955 | \n 956 |     if isinstance(dtype, (list, tuple)):\n 957 |         if dtype_orig is not None and dtype_orig in dtype:\n 958 |             # no dtype conversion required\n 959 |             dtype = None\n 960 |         else:\n 961 |             # dtype conversion required. Let's select the first element of the\n 962 |             # list of accepted types.\n 963 |             dtype = dtype[0]\n 964 | \n 965 |     if pandas_requires_conversion:\n 966 |         # pandas dataframe requires conversion earlier to handle extension dtypes with\n 967 |         # nans\n 968 |         # Use the original dtype for conversion if dtype is None\n 969 |         new_dtype = dtype_orig if dtype is None else dtype\n 970 |         array = array.astype(new_dtype)\n 971 |         # Since we converted here, we do not need to convert again later\n 972 |         dtype = None\n 973 | \n 974 |     if ensure_all_finite not in (True, False, \"allow-nan\"):\n 975 |         raise ValueError(\n 976 |             \"ensure_all_finite should be a bool or 'allow-nan'. Got \"\n 977 |             f\"{ensure_all_finite!r} instead.\"\n 978 |         )\n 979 | \n 980 |     if dtype is not None and _is_numpy_namespace(xp):\n 981 |         # convert to dtype object to conform to Array API to be use `xp.isdtype` later\n 982 |         dtype = np.dtype(dtype)\n 983 | \n 984 |     estimator_name = _check_estimator_name(estimator)\n 985 |     context = \" by %s\" % estimator_name if estimator is not None else \"\"\n 986 | \n 987 |     # When all dataframe columns are sparse, convert to a sparse array\n 988 |     if hasattr(array, \"sparse\") and array.ndim > 1:\n 989 |         with suppress(ImportError):\n 990 |             from pandas import SparseDtype  # noqa: F811\n 991 | \n 992 |             def is_sparse(dtype):\n 993 |                 return isinstance(dtype, SparseDtype)\n 994 | \n 995 |             if array.dtypes.apply(is_sparse).all():\n 996 |                 # DataFrame.sparse only supports `to_coo`\n 997 |                 array = array.sparse.to_coo()\n 998 |                 if array.dtype == np.dtype(\"object\"):\n 999 |                     unique_dtypes = set([dt.subtype.name for dt in array_orig.dtypes])\n1000 |                     if len(unique_dtypes) > 1:\n1001 |                         raise ValueError(\n1002 |                             \"Pandas DataFrame with mixed sparse extension arrays \"\n1003 |                             \"generated a sparse matrix with object dtype which \"\n1004 |                             \"can not be converted to a scipy sparse matrix.\"\n1005 |                             \"Sparse extension arrays should all have the same \"\n1006 |                             \"numeric type.\"\n1007 |                         )\n1008 | \n1009 |     if sp.issparse(array):\n1010 |         _ensure_no_complex_data(array)\n1011 |         array = _ensure_sparse_format(\n1012 |             array,\n1013 |             accept_sparse=accept_sparse,\n1014 |             dtype=dtype,\n1015 |             copy=copy,\n1016 |             ensure_all_finite=ensure_all_finite,\n1017 |             accept_large_sparse=accept_large_sparse,\n1018 |             estimator_name=estimator_name,\n1019 |             input_name=input_name,\n1020 |         )\n1021 |         if ensure_2d and array.ndim < 2:\n1022 |             raise ValueError(\n1023 |                 f\"Expected 2D input, got input with shape {array.shape}.\\n\"\n1024 |                 \"Reshape your data either using array.reshape(-1, 1) if \"\n1025 |                 \"your data has a single feature or array.reshape(1, -1) \"\n1026 |                 \"if it contains a single sample.\"\n1027 |             )\n1028 |     else:\n1029 |         # If np.array(..) gives ComplexWarning, then we convert the warning\n1030 |         # to an error. This is needed because specifying a non complex\n1031 |         # dtype to the function converts complex to real dtype,\n1032 |         # thereby passing the test made in the lines following the scope\n1033 |         # of warnings context manager.\n1034 |         with warnings.catch_warnings():\n1035 |             try:\n1036 |                 warnings.simplefilter(\"error\", ComplexWarning)\n1037 |                 if dtype is not None and xp.isdtype(dtype, \"integral\"):\n1038 |                     # Conversion float -> int should not contain NaN or\n1039 |                     # inf (numpy#14412). We cannot use casting='safe' because\n1040 |                     # then conversion float -> int would be disallowed.\n1041 |                     array = _asarray_with_order(array, order=order, xp=xp)\n1042 |                     if xp.isdtype(array.dtype, (\"real floating\", \"complex floating\")):\n1043 |                         _assert_all_finite(\n1044 |                             array,\n1045 |                             allow_nan=False,\n1046 |                             msg_dtype=dtype,\n1047 |                             estimator_name=estimator_name,\n1048 |                             input_name=input_name,\n1049 |                         )\n1050 |                     array = xp.astype(array, dtype, copy=False)\n1051 |                 else:\n1052 |                     array = _asarray_with_order(array, order=order, dtype=dtype, xp=xp)\n1053 |             except ComplexWarning as complex_warning:\n1054 |                 raise ValueError(\n1055 |                     \"Complex data not supported\\n{}\\n\".format(array)\n1056 |                 ) from complex_warning\n1057 | \n1058 |         # It is possible that the np.array(..) gave no warning. This happens\n1059 |         # when no dtype conversion happened, for example dtype = None. The\n1060 |         # result is that np.array(..) produces an array of complex dtype\n1061 |         # and we need to catch and raise exception for such cases.\n1062 |         _ensure_no_complex_data(array)\n1063 | \n1064 |         if ensure_2d:\n1065 |             # If input is scalar raise error\n1066 |             if array.ndim == 0:\n1067 |                 raise ValueError(\n1068 |                     \"Expected 2D array, got scalar array instead:\\narray={}.\\n\"\n1069 |                     \"Reshape your data either using array.reshape(-1, 1) if \"\n1070 |                     \"your data has a single feature or array.reshape(1, -1) \"\n1071 |                     \"if it contains a single sample.\".format(array)\n1072 |                 )\n1073 |             # If input is 1D raise error\n1074 |             if array.ndim == 1:\n1075 |                 # If input is a Series-like object (eg. pandas Series or polars Series)\n1076 |                 if type_if_series is not None:\n1077 |                     msg = (\n1078 |                         f\"Expected a 2-dimensional container but got {type_if_series} \"\n1079 |                         \"instead. Pass a DataFrame containing a single row (i.e. \"\n1080 |                         \"single sample) or a single column (i.e. single feature) \"\n1081 |                         \"instead.\"\n1082 |                     )\n1083 |                 else:\n1084 |                     msg = (\n1085 |                         f\"Expected 2D array, got 1D array instead:\\narray={array}.\\n\"\n1086 |                         \"Reshape your data either using array.reshape(-1, 1) if \"\n1087 |                         \"your data has a single feature or array.reshape(1, -1) \"\n1088 |                         \"if it contains a single sample.\"\n1089 |                     )\n1090 |                 raise ValueError(msg)\n1091 | \n1092 |         if dtype_numeric and hasattr(array.dtype, \"kind\") and array.dtype.kind in \"USV\":\n1093 |             raise ValueError(\n1094 |                 \"dtype='numeric' is not compatible with arrays of bytes/strings.\"\n1095 |                 \"Convert your data to numeric values explicitly instead.\"\n1096 |             )\n1097 |         if not allow_nd and array.ndim >= 3:\n1098 |             raise ValueError(\n1099 |                 \"Found array with dim %d. %s expected <= 2.\"\n1100 |                 % (array.ndim, estimator_name)\n1101 |             )\n1102 | \n1103 |         if ensure_all_finite:\n1104 |             _assert_all_finite(\n1105 |                 array,\n1106 |                 input_name=input_name,\n1107 |                 estimator_name=estimator_name,\n1108 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n1109 |             )\n1110 | \n1111 |         if copy:\n1112 |             if _is_numpy_namespace(xp):\n1113 |                 # only make a copy if `array` and `array_orig` may share memory`\n1114 |                 if np.may_share_memory(array, array_orig):\n1115 |                     array = _asarray_with_order(\n1116 |                         array, dtype=dtype, order=order, copy=True, xp=xp\n1117 |                     )\n1118 |             else:\n1119 |                 # always make a copy for non-numpy arrays\n1120 |                 array = _asarray_with_order(\n1121 |                     array, dtype=dtype, order=order, copy=True, xp=xp\n1122 |                 )\n1123 | \n1124 |     if ensure_min_samples > 0:\n1125 |         n_samples = _num_samples(array)\n1126 |         if n_samples < ensure_min_samples:\n1127 |             raise ValueError(\n1128 |                 \"Found array with %d sample(s) (shape=%s) while a\"\n1129 |                 \" minimum of %d is required%s.\"\n1130 |                 % (n_samples, array.shape, ensure_min_samples, context)\n1131 |             )\n1132 | \n1133 |     if ensure_min_features > 0 and array.ndim == 2:\n1134 |         n_features = array.shape[1]\n1135 |         if n_features < ensure_min_features:\n1136 |             raise ValueError(\n1137 |                 \"Found array with %d feature(s) (shape=%s) while\"\n1138 |                 \" a minimum of %d is required%s.\"\n1139 |                 % (n_features, array.shape, ensure_min_features, context)\n1140 |             )\n1141 | \n1142 |     if ensure_non_negative:\n1143 |         whom = input_name\n1144 |         if estimator_name:\n1145 |             whom += f\" in {estimator_name}\"\n1146 |         check_non_negative(array, whom)\n1147 | \n1148 |     if force_writeable:\n1149 |         # By default, array.copy() creates a C-ordered copy. We set order=K to\n1150 |         # preserve the order of the array.\n1151 |         copy_params = {\"order\": \"K\"} if not sp.issparse(array) else {}\n1152 | \n1153 |         array_data = array.data if sp.issparse(array) else array\n1154 |         flags = getattr(array_data, \"flags\", None)\n1155 |         if not getattr(flags, \"writeable\", True):\n1156 |             # This situation can only happen when copy=False, the array is read-only and\n1157 |             # a writeable output is requested. This is an ambiguous setting so we chose\n1158 |             # to always (except for one specific setting, see below) make a copy to\n1159 |             # ensure that the output is writeable, even if avoidable, to not overwrite\n1160 |             # the user's data by surprise.\n1161 | \n1162 |             if _is_pandas_df_or_series(array_orig):\n1163 |                 try:\n1164 |                     # In pandas >= 3, np.asarray(df), called earlier in check_array,\n1165 |                     # returns a read-only intermediate array. It can be made writeable\n1166 |                     # safely without copy because if the original DataFrame was backed\n1167 |                     # by a read-only array, trying to change the flag would raise an\n1168 |                     # error, in which case we make a copy.\n1169 |                     array_data.flags.writeable = True\n1170 |                 except ValueError:\n1171 |                     array = array.copy(**copy_params)\n1172 |             else:\n1173 |                 array = array.copy(**copy_params)\n1174 | \n1175 |     return array\n1176 | \n1177 | \n1178 | def _check_large_sparse(X, accept_large_sparse=False):\n1179 |     \"\"\"Raise a ValueError if X has 64bit indices and accept_large_sparse=False\"\"\"\n1180 |     if not accept_large_sparse:\n1181 |         supported_indices = [\"int32\"]\n1182 |         if X.format == \"coo\":\n1183 |             index_keys = [\"col\", \"row\"]\n1184 |         elif X.format in [\"csr\", \"csc\", \"bsr\"]:\n1185 |             index_keys = [\"indices\", \"indptr\"]\n1186 |         else:\n1187 |             return\n1188 |         for key in index_keys:\n1189 |             indices_datatype = getattr(X, key).dtype\n1190 |             if indices_datatype not in supported_indices:\n1191 |                 raise ValueError(\n1192 |                     \"Only sparse matrices with 32-bit integer indices are accepted.\"\n1193 |                     f\" Got {indices_datatype} indices. Please do report a minimal\"\n1194 |                     \" reproducer on scikit-learn issue tracker so that support for\"\n1195 |                     \" your use-case can be studied by maintainers. See:\"\n1196 |                     \" https://scikit-learn.org/dev/developers/minimal_reproducer.html\"\n1197 |                 )\n1198 | \n1199 | \n1200 | def check_X_y(\n1201 |     X,\n1202 |     y,\n1203 |     accept_sparse=False,\n1204 |     *,\n1205 |     accept_large_sparse=True,\n1206 |     dtype=\"numeric\",\n1207 |     order=None,\n1208 |     copy=False,\n1209 |     force_writeable=False,\n1210 |     force_all_finite=\"deprecated\",\n1211 |     ensure_all_finite=None,\n1212 |     ensure_2d=True,\n1213 |     allow_nd=False,\n1214 |     multi_output=False,\n1215 |     ensure_min_samples=1,\n1216 |     ensure_min_features=1,\n1217 |     y_numeric=False,\n1218 |     estimator=None,\n1219 | ):\n1220 |     \"\"\"Input validation for standard estimators.\n1221 | \n1222 |     Checks X and y for consistent length, enforces X to be 2D and y 1D. By\n1223 |     default, X is checked to be non-empty and containing only finite values.\n1224 |     Standard input checks are also applied to y, such as checking that y\n1225 |     does not have np.nan or np.inf targets. For multi-label y, set\n1226 |     multi_output=True to allow 2D and sparse y. If the dtype of X is\n1227 |     object, attempt converting to float, raising on failure.\n1228 | \n1229 |     Parameters\n1230 |     ----------\n1231 |     X : {ndarray, list, sparse matrix}\n1232 |         Input data.\n1233 | \n1234 |     y : {ndarray, list, sparse matrix}\n1235 |         Labels.\n1236 | \n1237 |     accept_sparse : str, bool or list of str, default=False\n1238 |         String[s] representing allowed sparse matrix formats, such as 'csc',\n1239 |         'csr', etc. If the input is sparse but not in the allowed format,\n1240 |         it will be converted to the first listed format. True allows the input\n1241 |         to be any format. False means that a sparse matrix input will\n1242 |         raise an error.\n1243 | \n1244 |     accept_large_sparse : bool, default=True\n1245 |         If a CSR, CSC, COO or BSR sparse matrix is supplied and accepted by\n1246 |         accept_sparse, accept_large_sparse will cause it to be accepted only\n1247 |         if its indices are stored with a 32-bit dtype.\n1248 | \n1249 |         .. versionadded:: 0.20\n1250 | \n1251 |     dtype : 'numeric', type, list of type or None, default='numeric'\n1252 |         Data type of result. If None, the dtype of the input is preserved.\n1253 |         If \"numeric\", dtype is preserved unless array.dtype is object.\n1254 |         If dtype is a list of types, conversion on the first type is only\n1255 |         performed if the dtype of the input is not in the list.\n1256 | \n1257 |     order : {'F', 'C'}, default=None\n1258 |         Whether an array will be forced to be fortran or c-style. If\n1259 |         `None`, then the input data's order is preserved when possible.\n1260 | \n1261 |     copy : bool, default=False\n1262 |         Whether a forced copy will be triggered. If copy=False, a copy might\n1263 |         be triggered by a conversion.\n1264 | \n1265 |     force_writeable : bool, default=False\n1266 |         Whether to force the output array to be writeable. If True, the returned array\n1267 |         is guaranteed to be writeable, which may require a copy. Otherwise the\n1268 |         writeability of the input array is preserved.\n1269 | \n1270 |         .. versionadded:: 1.6\n1271 | \n1272 |     force_all_finite : bool or 'allow-nan', default=True\n1273 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. This parameter\n1274 |         does not influence whether y can have np.inf, np.nan, pd.NA values.\n1275 |         The possibilities are:\n1276 | \n1277 |         - True: Force all values of X to be finite.\n1278 |         - False: accepts np.inf, np.nan, pd.NA in X.\n1279 |         - 'allow-nan': accepts only np.nan or pd.NA values in X. Values cannot\n1280 |           be infinite.\n1281 | \n1282 |         .. versionadded:: 0.20\n1283 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n1284 | \n1285 |         .. versionchanged:: 0.23\n1286 |            Accepts `pd.NA` and converts it into `np.nan`\n1287 | \n1288 |         .. deprecated:: 1.6\n1289 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n1290 |            in 1.8.\n1291 | \n1292 |     ensure_all_finite : bool or 'allow-nan', default=True\n1293 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. This parameter\n1294 |         does not influence whether y can have np.inf, np.nan, pd.NA values.\n1295 |         The possibilities are:\n1296 | \n1297 |         - True: Force all values of X to be finite.\n1298 |         - False: accepts np.inf, np.nan, pd.NA in X.\n1299 |         - 'allow-nan': accepts only np.nan or pd.NA values in X. Values cannot\n1300 |           be infinite.\n1301 | \n1302 |         .. versionadded:: 1.6\n1303 |            `force_all_finite` was renamed to `ensure_all_finite`.\n1304 | \n1305 |     ensure_2d : bool, default=True\n1306 |         Whether to raise a value error if X is not 2D.\n1307 | \n1308 |     allow_nd : bool, default=False\n1309 |         Whether to allow X.ndim > 2.\n1310 | \n1311 |     multi_output : bool, default=False\n1312 |         Whether to allow 2D y (array or sparse matrix). If false, y will be\n1313 |         validated as a vector. y cannot have np.nan or np.inf values if\n1314 |         multi_output=True.\n1315 | \n1316 |     ensure_min_samples : int, default=1\n1317 |         Make sure that X has a minimum number of samples in its first\n1318 |         axis (rows for a 2D array).\n1319 | \n1320 |     ensure_min_features : int, default=1\n1321 |         Make sure that the 2D array has some minimum number of features\n1322 |         (columns). The default value of 1 rejects empty datasets.\n1323 |         This check is only enforced when X has effectively 2 dimensions or\n1324 |         is originally 1D and ``ensure_2d`` is True. Setting to 0 disables\n1325 |         this check.\n1326 | \n1327 |     y_numeric : bool, default=False\n1328 |         Whether to ensure that y has a numeric type. If dtype of y is object,\n1329 |         it is converted to float64. Should only be used for regression\n1330 |         algorithms.\n1331 | \n1332 |     estimator : str or estimator instance, default=None\n1333 |         If passed, include the name of the estimator in warning messages.\n1334 | \n1335 |     Returns\n1336 |     -------\n1337 |     X_converted : object\n1338 |         The converted and validated X.\n1339 | \n1340 |     y_converted : object\n1341 |         The converted and validated y.\n1342 | \n1343 |     Examples\n1344 |     --------\n1345 |     >>> from sklearn.utils.validation import check_X_y\n1346 |     >>> X = [[1, 2], [3, 4], [5, 6]]\n1347 |     >>> y = [1, 2, 3]\n1348 |     >>> X, y = check_X_y(X, y)\n1349 |     >>> X\n1350 |     array([[1, 2],\n1351 |           [3, 4],\n1352 |           [5, 6]])\n1353 |     >>> y\n1354 |     array([1, 2, 3])\n1355 |     \"\"\"\n1356 |     if y is None:\n1357 |         if estimator is None:\n1358 |             estimator_name = \"estimator\"\n1359 |         else:\n1360 |             estimator_name = _check_estimator_name(estimator)\n1361 |         raise ValueError(\n1362 |             f\"{estimator_name} requires y to be passed, but the target y is None\"\n1363 |         )\n1364 | \n1365 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n1366 | \n1367 |     X = check_array(\n1368 |         X,\n1369 |         accept_sparse=accept_sparse,\n1370 |         accept_large_sparse=accept_large_sparse,\n1371 |         dtype=dtype,\n1372 |         order=order,\n1373 |         copy=copy,\n1374 |         force_writeable=force_writeable,\n1375 |         ensure_all_finite=ensure_all_finite,\n1376 |         ensure_2d=ensure_2d,\n1377 |         allow_nd=allow_nd,\n1378 |         ensure_min_samples=ensure_min_samples,\n1379 |         ensure_min_features=ensure_min_features,\n1380 |         estimator=estimator,\n1381 |         input_name=\"X\",\n1382 |     )\n1383 | \n1384 |     y = _check_y(y, multi_output=multi_output, y_numeric=y_numeric, estimator=estimator)\n1385 | \n1386 |     check_consistent_length(X, y)\n1387 | \n1388 |     return X, y\n1389 | \n1390 | \n1391 | def _check_y(y, multi_output=False, y_numeric=False, estimator=None):\n1392 |     \"\"\"Isolated part of check_X_y dedicated to y validation\"\"\"\n1393 |     if multi_output:\n1394 |         y = check_array(\n1395 |             y,\n1396 |             accept_sparse=\"csr\",\n1397 |             ensure_all_finite=True,\n1398 |             ensure_2d=False,\n1399 |             dtype=None,\n1400 |             input_name=\"y\",\n1401 |             estimator=estimator,\n1402 |         )\n1403 |     else:\n1404 |         estimator_name = _check_estimator_name(estimator)\n1405 |         y = column_or_1d(y, warn=True)\n1406 |         _assert_all_finite(y, input_name=\"y\", estimator_name=estimator_name)\n1407 |         _ensure_no_complex_data(y)\n1408 |     if y_numeric and hasattr(y.dtype, \"kind\") and y.dtype.kind == \"O\":\n1409 |         y = y.astype(np.float64)\n1410 | \n1411 |     return y\n1412 | \n1413 | \n1414 | def column_or_1d(y, *, dtype=None, warn=False):\n1415 |     \"\"\"Ravel column or 1d numpy array, else raises an error.\n1416 | \n1417 |     Parameters\n1418 |     ----------\n1419 |     y : array-like\n1420 |        Input data.\n1421 | \n1422 |     dtype : data-type, default=None\n1423 |         Data type for `y`.\n1424 | \n1425 |         .. versionadded:: 1.2\n1426 | \n1427 |     warn : bool, default=False\n1428 |        To control display of warnings.\n1429 | \n1430 |     Returns\n1431 |     -------\n1432 |     y : ndarray\n1433 |        Output data.\n1434 | \n1435 |     Raises\n1436 |     ------\n1437 |     ValueError\n1438 |         If `y` is not a 1D array or a 2D array with a single row or column.\n1439 | \n1440 |     Examples\n1441 |     --------\n1442 |     >>> from sklearn.utils.validation import column_or_1d\n1443 |     >>> column_or_1d([1, 1])\n1444 |     array([1, 1])\n1445 |     \"\"\"\n1446 |     xp, _ = get_namespace(y)\n1447 |     y = check_array(\n1448 |         y,\n1449 |         ensure_2d=False,\n1450 |         dtype=dtype,\n1451 |         input_name=\"y\",\n1452 |         ensure_all_finite=False,\n1453 |         ensure_min_samples=0,\n1454 |     )\n1455 | \n1456 |     shape = y.shape\n1457 |     if len(shape) == 1:\n1458 |         return _asarray_with_order(xp.reshape(y, (-1,)), order=\"C\", xp=xp)\n1459 |     if len(shape) == 2 and shape[1] == 1:\n1460 |         if warn:\n1461 |             warnings.warn(\n1462 |                 (\n1463 |                     \"A column-vector y was passed when a 1d array was\"\n1464 |                     \" expected. Please change the shape of y to \"\n1465 |                     \"(n_samples, ), for example using ravel().\"\n1466 |                 ),\n1467 |                 DataConversionWarning,\n1468 |                 stacklevel=2,\n1469 |             )\n1470 |         return _asarray_with_order(xp.reshape(y, (-1,)), order=\"C\", xp=xp)\n1471 | \n1472 |     raise ValueError(\n1473 |         \"y should be a 1d array, got an array of shape {} instead.\".format(shape)\n1474 |     )\n1475 | \n1476 | \n1477 | def check_random_state(seed):\n1478 |     \"\"\"Turn seed into a np.random.RandomState instance.\n1479 | \n1480 |     Parameters\n1481 |     ----------\n1482 |     seed : None, int or instance of RandomState\n1483 |         If seed is None, return the RandomState singleton used by np.random.\n1484 |         If seed is an int, return a new RandomState instance seeded with seed.\n1485 |         If seed is already a RandomState instance, return it.\n1486 |         Otherwise raise ValueError.\n1487 | \n1488 |     Returns\n1489 |     -------\n1490 |     :class:`numpy:numpy.random.RandomState`\n1491 |         The random state object based on `seed` parameter.\n1492 | \n1493 |     Examples\n1494 |     --------\n1495 |     >>> from sklearn.utils.validation import check_random_state\n1496 |     >>> check_random_state(42)\n1497 |     RandomState(MT19937) at 0x...\n1498 |     \"\"\"\n1499 |     if seed is None or seed is np.random:\n1500 |         return np.random.mtrand._rand\n1501 |     if isinstance(seed, numbers.Integral):\n1502 |         return np.random.RandomState(seed)\n1503 |     if isinstance(seed, np.random.RandomState):\n1504 |         return seed\n1505 |     raise ValueError(\n1506 |         \"%r cannot be used to seed a numpy.random.RandomState instance\" % seed\n1507 |     )\n1508 | \n1509 | \n1510 | def has_fit_parameter(estimator, parameter):\n1511 |     \"\"\"Check whether the estimator's fit method supports the given parameter.\n1512 | \n1513 |     Parameters\n1514 |     ----------\n1515 |     estimator : object\n1516 |         An estimator to inspect.\n1517 | \n1518 |     parameter : str\n1519 |         The searched parameter.\n1520 | \n1521 |     Returns\n1522 |     -------\n1523 |     is_parameter : bool\n1524 |         Whether the parameter was found to be a named parameter of the\n1525 |         estimator's fit method.\n1526 | \n1527 |     Examples\n1528 |     --------\n1529 |     >>> from sklearn.svm import SVC\n1530 |     >>> from sklearn.utils.validation import has_fit_parameter\n1531 |     >>> has_fit_parameter(SVC(), \"sample_weight\")\n1532 |     True\n1533 |     \"\"\"\n1534 |     return parameter in signature(estimator.fit).parameters\n1535 | \n1536 | \n1537 | def check_symmetric(array, *, tol=1e-10, raise_warning=True, raise_exception=False):\n1538 |     \"\"\"Make sure that array is 2D, square and symmetric.\n1539 | \n1540 |     If the array is not symmetric, then a symmetrized version is returned.\n1541 |     Optionally, a warning or exception is raised if the matrix is not\n1542 |     symmetric.\n1543 | \n1544 |     Parameters\n1545 |     ----------\n1546 |     array : {ndarray, sparse matrix}\n1547 |         Input object to check / convert. Must be two-dimensional and square,\n1548 |         otherwise a ValueError will be raised.\n1549 | \n1550 |     tol : float, default=1e-10\n1551 |         Absolute tolerance for equivalence of arrays. Default = 1E-10.\n1552 | \n1553 |     raise_warning : bool, default=True\n1554 |         If True then raise a warning if conversion is required.\n1555 | \n1556 |     raise_exception : bool, default=False\n1557 |         If True then raise an exception if array is not symmetric.\n1558 | \n1559 |     Returns\n1560 |     -------\n1561 |     array_sym : {ndarray, sparse matrix}\n1562 |         Symmetrized version of the input array, i.e. the average of array\n1563 |         and array.transpose(). If sparse, then duplicate entries are first\n1564 |         summed and zeros are eliminated.\n1565 | \n1566 |     Examples\n1567 |     --------\n1568 |     >>> import numpy as np\n1569 |     >>> from sklearn.utils.validation import check_symmetric\n1570 |     >>> symmetric_array = np.array([[0, 1, 2], [1, 0, 1], [2, 1, 0]])\n1571 |     >>> check_symmetric(symmetric_array)\n1572 |     array([[0, 1, 2],\n1573 |            [1, 0, 1],\n1574 |            [2, 1, 0]])\n1575 |     >>> from scipy.sparse import csr_matrix\n1576 |     >>> sparse_symmetric_array = csr_matrix(symmetric_array)\n1577 |     >>> check_symmetric(sparse_symmetric_array)\n1578 |     <Compressed Sparse Row sparse matrix of dtype 'int64'\n1579 |         with 6 stored elements and shape (3, 3)>\n1580 |     \"\"\"\n1581 |     if (array.ndim != 2) or (array.shape[0] != array.shape[1]):\n1582 |         raise ValueError(\n1583 |             \"array must be 2-dimensional and square. shape = {0}\".format(array.shape)\n1584 |         )\n1585 | \n1586 |     if sp.issparse(array):\n1587 |         diff = array - array.T\n1588 |         # only csr, csc, and coo have `data` attribute\n1589 |         if diff.format not in [\"csr\", \"csc\", \"coo\"]:\n1590 |             diff = diff.tocsr()\n1591 |         symmetric = np.all(abs(diff.data) < tol)\n1592 |     else:\n1593 |         symmetric = np.allclose(array, array.T, atol=tol)\n1594 | \n1595 |     if not symmetric:\n1596 |         if raise_exception:\n1597 |             raise ValueError(\"Array must be symmetric\")\n1598 |         if raise_warning:\n1599 |             warnings.warn(\n1600 |                 (\n1601 |                     \"Array is not symmetric, and will be converted \"\n1602 |                     \"to symmetric by average with its transpose.\"\n1603 |                 ),\n1604 |                 stacklevel=2,\n1605 |             )\n1606 |         if sp.issparse(array):\n1607 |             conversion = \"to\" + array.format\n1608 |             array = getattr(0.5 * (array + array.T), conversion)()\n1609 |         else:\n1610 |             array = 0.5 * (array + array.T)\n1611 | \n1612 |     return array\n1613 | \n1614 | \n1615 | def _is_fitted(estimator, attributes=None, all_or_any=all):\n1616 |     \"\"\"Determine if an estimator is fitted\n1617 | \n1618 |     Parameters\n1619 |     ----------\n1620 |     estimator : estimator instance\n1621 |         Estimator instance for which the check is performed.\n1622 | \n1623 |     attributes : str, list or tuple of str, default=None\n1624 |         Attribute name(s) given as string or a list/tuple of strings\n1625 |         Eg.: ``[\"coef_\", \"estimator_\", ...], \"coef_\"``\n1626 | \n1627 |         If `None`, `estimator` is considered fitted if there exist an\n1628 |         attribute that ends with a underscore and does not start with double\n1629 |         underscore.\n1630 | \n1631 |     all_or_any : callable, {all, any}, default=all\n1632 |         Specify whether all or any of the given attributes must exist.\n1633 | \n1634 |     Returns\n1635 |     -------\n1636 |     fitted : bool\n1637 |         Whether the estimator is fitted.\n1638 |     \"\"\"\n1639 |     if attributes is not None:\n1640 |         if not isinstance(attributes, (list, tuple)):\n1641 |             attributes = [attributes]\n1642 |         return all_or_any([hasattr(estimator, attr) for attr in attributes])\n1643 | \n1644 |     if hasattr(estimator, \"__sklearn_is_fitted__\"):\n1645 |         return estimator.__sklearn_is_fitted__()\n1646 | \n1647 |     fitted_attrs = [\n1648 |         v for v in vars(estimator) if v.endswith(\"_\") and not v.startswith(\"__\")\n1649 |     ]\n1650 |     return len(fitted_attrs) > 0\n1651 | \n1652 | \n1653 | def check_is_fitted(estimator, attributes=None, *, msg=None, all_or_any=all):\n1654 |     \"\"\"Perform is_fitted validation for estimator.\n1655 | \n1656 |     Checks if the estimator is fitted by verifying the presence of\n1657 |     fitted attributes (ending with a trailing underscore) and otherwise\n1658 |     raises a NotFittedError with the given message.\n1659 | \n1660 |     If an estimator does not set any attributes with a trailing underscore, it\n1661 |     can define a ``__sklearn_is_fitted__`` method returning a boolean to\n1662 |     specify if the estimator is fitted or not. See\n1663 |     :ref:`sphx_glr_auto_examples_developing_estimators_sklearn_is_fitted.py`\n1664 |     for an example on how to use the API.\n1665 | \n1666 |     Parameters\n1667 |     ----------\n1668 |     estimator : estimator instance\n1669 |         Estimator instance for which the check is performed.\n1670 | \n1671 |     attributes : str, list or tuple of str, default=None\n1672 |         Attribute name(s) given as string or a list/tuple of strings\n1673 |         Eg.: ``[\"coef_\", \"estimator_\", ...], \"coef_\"``\n1674 | \n1675 |         If `None`, `estimator` is considered fitted if there exist an\n1676 |         attribute that ends with a underscore and does not start with double\n1677 |         underscore.\n1678 | \n1679 |     msg : str, default=None\n1680 |         The default error message is, \"This %(name)s instance is not fitted\n1681 |         yet. Call 'fit' with appropriate arguments before using this\n1682 |         estimator.\"\n1683 | \n1684 |         For custom messages if \"%(name)s\" is present in the message string,\n1685 |         it is substituted for the estimator name.\n1686 | \n1687 |         Eg. : \"Estimator, %(name)s, must be fitted before sparsifying\".\n1688 | \n1689 |     all_or_any : callable, {all, any}, default=all\n1690 |         Specify whether all or any of the given attributes must exist.\n1691 | \n1692 |     Raises\n1693 |     ------\n1694 |     TypeError\n1695 |         If the estimator is a class or not an estimator instance\n1696 | \n1697 |     NotFittedError\n1698 |         If the attributes are not found.\n1699 | \n1700 |     Examples\n1701 |     --------\n1702 |     >>> from sklearn.linear_model import LogisticRegression\n1703 |     >>> from sklearn.utils.validation import check_is_fitted\n1704 |     >>> from sklearn.exceptions import NotFittedError\n1705 |     >>> lr = LogisticRegression()\n1706 |     >>> try:\n1707 |     ...     check_is_fitted(lr)\n1708 |     ... except NotFittedError as exc:\n1709 |     ...     print(f\"Model is not fitted yet.\")\n1710 |     Model is not fitted yet.\n1711 |     >>> lr.fit([[1, 2], [1, 3]], [1, 0])\n1712 |     LogisticRegression()\n1713 |     >>> check_is_fitted(lr)\n1714 |     \"\"\"\n1715 |     if isclass(estimator):\n1716 |         raise TypeError(\"{} is a class, not an instance.\".format(estimator))\n1717 |     if msg is None:\n1718 |         msg = (\n1719 |             \"This %(name)s instance is not fitted yet. Call 'fit' with \"\n1720 |             \"appropriate arguments before using this estimator.\"\n1721 |         )\n1722 | \n1723 |     if not hasattr(estimator, \"fit\"):\n1724 |         raise TypeError(\"%s is not an estimator instance.\" % (estimator))\n1725 | \n1726 |     if not _is_fitted(estimator, attributes, all_or_any):\n1727 |         raise NotFittedError(msg % {\"name\": type(estimator).__name__})\n1728 | \n1729 | \n1730 | def check_non_negative(X, whom):\n1731 |     \"\"\"\n1732 |     Check if there is any negative value in an array.\n1733 | \n1734 |     Parameters\n1735 |     ----------\n1736 |     X : {array-like, sparse matrix}\n1737 |         Input data.\n1738 | \n1739 |     whom : str\n1740 |         Who passed X to this function.\n1741 |     \"\"\"\n1742 |     xp, _ = get_namespace(X)\n1743 |     # avoid X.min() on sparse matrix since it also sorts the indices\n1744 |     if sp.issparse(X):\n1745 |         if X.format in [\"lil\", \"dok\"]:\n1746 |             X = X.tocsr()\n1747 |         if X.data.size == 0:\n1748 |             X_min = 0\n1749 |         else:\n1750 |             X_min = X.data.min()\n1751 |     else:\n1752 |         X_min = xp.min(X)\n1753 | \n1754 |     if X_min < 0:\n1755 |         raise ValueError(f\"Negative values in data passed to {whom}.\")\n1756 | \n1757 | \n1758 | def check_scalar(\n1759 |     x,\n1760 |     name,\n1761 |     target_type,\n1762 |     *,\n1763 |     min_val=None,\n1764 |     max_val=None,\n1765 |     include_boundaries=\"both\",\n1766 | ):\n1767 |     \"\"\"Validate scalar parameters type and value.\n1768 | \n1769 |     Parameters\n1770 |     ----------\n1771 |     x : object\n1772 |         The scalar parameter to validate.\n1773 | \n1774 |     name : str\n1775 |         The name of the parameter to be printed in error messages.\n1776 | \n1777 |     target_type : type or tuple\n1778 |         Acceptable data types for the parameter.\n1779 | \n1780 |     min_val : float or int, default=None\n1781 |         The minimum valid value the parameter can take. If None (default) it\n1782 |         is implied that the parameter does not have a lower bound.\n1783 | \n1784 |     max_val : float or int, default=None\n1785 |         The maximum valid value the parameter can take. If None (default) it\n1786 |         is implied that the parameter does not have an upper bound.\n1787 | \n1788 |     include_boundaries : {\"left\", \"right\", \"both\", \"neither\"}, default=\"both\"\n1789 |         Whether the interval defined by `min_val` and `max_val` should include\n1790 |         the boundaries. Possible choices are:\n1791 | \n1792 |         - `\"left\"`: only `min_val` is included in the valid interval.\n1793 |           It is equivalent to the interval `[ min_val, max_val )`.\n1794 |         - `\"right\"`: only `max_val` is included in the valid interval.\n1795 |           It is equivalent to the interval `( min_val, max_val ]`.\n1796 |         - `\"both\"`: `min_val` and `max_val` are included in the valid interval.\n1797 |           It is equivalent to the interval `[ min_val, max_val ]`.\n1798 |         - `\"neither\"`: neither `min_val` nor `max_val` are included in the\n1799 |           valid interval. It is equivalent to the interval `( min_val, max_val )`.\n1800 | \n1801 |     Returns\n1802 |     -------\n1803 |     x : numbers.Number\n1804 |         The validated number.\n1805 | \n1806 |     Raises\n1807 |     ------\n1808 |     TypeError\n1809 |         If the parameter's type does not match the desired type.\n1810 | \n1811 |     ValueError\n1812 |         If the parameter's value violates the given bounds.\n1813 |         If `min_val`, `max_val` and `include_boundaries` are inconsistent.\n1814 | \n1815 |     Examples\n1816 |     --------\n1817 |     >>> from sklearn.utils.validation import check_scalar\n1818 |     >>> check_scalar(10, \"x\", int, min_val=1, max_val=20)\n1819 |     10\n1820 |     \"\"\"\n1821 | \n1822 |     def type_name(t):\n1823 |         \"\"\"Convert type into humman readable string.\"\"\"\n1824 |         module = t.__module__\n1825 |         qualname = t.__qualname__\n1826 |         if module == \"builtins\":\n1827 |             return qualname\n1828 |         elif t == numbers.Real:\n1829 |             return \"float\"\n1830 |         elif t == numbers.Integral:\n1831 |             return \"int\"\n1832 |         return f\"{module}.{qualname}\"\n1833 | \n1834 |     if not isinstance(x, target_type):\n1835 |         if isinstance(target_type, tuple):\n1836 |             types_str = \", \".join(type_name(t) for t in target_type)\n1837 |             target_type_str = f\"{{{types_str}}}\"\n1838 |         else:\n1839 |             target_type_str = type_name(target_type)\n1840 | \n1841 |         raise TypeError(\n1842 |             f\"{name} must be an instance of {target_type_str}, not\"\n1843 |             f\" {type(x).__qualname__}.\"\n1844 |         )\n1845 | \n1846 |     expected_include_boundaries = (\"left\", \"right\", \"both\", \"neither\")\n1847 |     if include_boundaries not in expected_include_boundaries:\n1848 |         raise ValueError(\n1849 |             f\"Unknown value for `include_boundaries`: {repr(include_boundaries)}. \"\n1850 |             f\"Possible values are: {expected_include_boundaries}.\"\n1851 |         )\n1852 | \n1853 |     if max_val is None and include_boundaries == \"right\":\n1854 |         raise ValueError(\n1855 |             \"`include_boundaries`='right' without specifying explicitly `max_val` \"\n1856 |             \"is inconsistent.\"\n1857 |         )\n1858 | \n1859 |     if min_val is None and include_boundaries == \"left\":\n1860 |         raise ValueError(\n1861 |             \"`include_boundaries`='left' without specifying explicitly `min_val` \"\n1862 |             \"is inconsistent.\"\n1863 |         )\n1864 | \n1865 |     comparison_operator = (\n1866 |         operator.lt if include_boundaries in (\"left\", \"both\") else operator.le\n1867 |     )\n1868 |     if min_val is not None and comparison_operator(x, min_val):\n1869 |         raise ValueError(\n1870 |             f\"{name} == {x}, must be\"\n1871 |             f\" {'>=' if include_boundaries in ('left', 'both') else '>'} {min_val}.\"\n1872 |         )\n1873 | \n1874 |     comparison_operator = (\n1875 |         operator.gt if include_boundaries in (\"right\", \"both\") else operator.ge\n1876 |     )\n1877 |     if max_val is not None and comparison_operator(x, max_val):\n1878 |         raise ValueError(\n1879 |             f\"{name} == {x}, must be\"\n1880 |             f\" {'<=' if include_boundaries in ('right', 'both') else '<'} {max_val}.\"\n1881 |         )\n1882 | \n1883 |     return x\n1884 | \n1885 | \n1886 | def _check_psd_eigenvalues(lambdas, enable_warnings=False):\n1887 |     \"\"\"Check the eigenvalues of a positive semidefinite (PSD) matrix.\n1888 | \n1889 |     Checks the provided array of PSD matrix eigenvalues for numerical or\n1890 |     conditioning issues and returns a fixed validated version. This method\n1891 |     should typically be used if the PSD matrix is user-provided (e.g. a\n1892 |     Gram matrix) or computed using a user-provided dissimilarity metric\n1893 |     (e.g. kernel function), or if the decomposition process uses approximation\n1894 |     methods (randomized SVD, etc.).\n1895 | \n1896 |     It checks for three things:\n1897 | \n1898 |     - that there are no significant imaginary parts in eigenvalues (more than\n1899 |       1e-5 times the maximum real part). If this check fails, it raises a\n1900 |       ``ValueError``. Otherwise all non-significant imaginary parts that may\n1901 |       remain are set to zero. This operation is traced with a\n1902 |       ``PositiveSpectrumWarning`` when ``enable_warnings=True``.\n1903 | \n1904 |     - that eigenvalues are not all negative. If this check fails, it raises a\n1905 |       ``ValueError``\n1906 | \n1907 |     - that there are no significant negative eigenvalues with absolute value\n1908 |       more than 1e-10 (1e-6) and more than 1e-5 (5e-3) times the largest\n1909 |       positive eigenvalue in double (simple) precision. If this check fails,\n1910 |       it raises a ``ValueError``. Otherwise all negative eigenvalues that may\n1911 |       remain are set to zero. This operation is traced with a\n1912 |       ``PositiveSpectrumWarning`` when ``enable_warnings=True``.\n1913 | \n1914 |     Finally, all the positive eigenvalues that are too small (with a value\n1915 |     smaller than the maximum eigenvalue multiplied by 1e-12 (2e-7)) are set to\n1916 |     zero. This operation is traced with a ``PositiveSpectrumWarning`` when\n1917 |     ``enable_warnings=True``.\n1918 | \n1919 |     Parameters\n1920 |     ----------\n1921 |     lambdas : array-like of shape (n_eigenvalues,)\n1922 |         Array of eigenvalues to check / fix.\n1923 | \n1924 |     enable_warnings : bool, default=False\n1925 |         When this is set to ``True``, a ``PositiveSpectrumWarning`` will be\n1926 |         raised when there are imaginary parts, negative eigenvalues, or\n1927 |         extremely small non-zero eigenvalues. Otherwise no warning will be\n1928 |         raised. In both cases, imaginary parts, negative eigenvalues, and\n1929 |         extremely small non-zero eigenvalues will be set to zero.\n1930 | \n1931 |     Returns\n1932 |     -------\n1933 |     lambdas_fixed : ndarray of shape (n_eigenvalues,)\n1934 |         A fixed validated copy of the array of eigenvalues.\n1935 | \n1936 |     Examples\n1937 |     --------\n1938 |     >>> from sklearn.utils.validation import _check_psd_eigenvalues\n1939 |     >>> _check_psd_eigenvalues([1, 2])      # nominal case\n1940 |     array([1, 2])\n1941 |     >>> _check_psd_eigenvalues([5, 5j])     # significant imag part\n1942 |     Traceback (most recent call last):\n1943 |         ...\n1944 |     ValueError: There are significant imaginary parts in eigenvalues (1\n1945 |         of the maximum real part). Either the matrix is not PSD, or there was\n1946 |         an issue while computing the eigendecomposition of the matrix.\n1947 |     >>> _check_psd_eigenvalues([5, 5e-5j])  # insignificant imag part\n1948 |     array([5., 0.])\n1949 |     >>> _check_psd_eigenvalues([-5, -1])    # all negative\n1950 |     Traceback (most recent call last):\n1951 |         ...\n1952 |     ValueError: All eigenvalues are negative (maximum is -1). Either the\n1953 |         matrix is not PSD, or there was an issue while computing the\n1954 |         eigendecomposition of the matrix.\n1955 |     >>> _check_psd_eigenvalues([5, -1])     # significant negative\n1956 |     Traceback (most recent call last):\n1957 |         ...\n1958 |     ValueError: There are significant negative eigenvalues (0.2 of the\n1959 |         maximum positive). Either the matrix is not PSD, or there was an issue\n1960 |         while computing the eigendecomposition of the matrix.\n1961 |     >>> _check_psd_eigenvalues([5, -5e-5])  # insignificant negative\n1962 |     array([5., 0.])\n1963 |     >>> _check_psd_eigenvalues([5, 4e-12])  # bad conditioning (too small)\n1964 |     array([5., 0.])\n1965 | \n1966 |     \"\"\"\n1967 | \n1968 |     lambdas = np.array(lambdas)\n1969 |     is_double_precision = lambdas.dtype == np.float64\n1970 | \n1971 |     # note: the minimum value available is\n1972 |     #  - single-precision: np.finfo('float32').eps = 1.2e-07\n1973 |     #  - double-precision: np.finfo('float64').eps = 2.2e-16\n1974 | \n1975 |     # the various thresholds used for validation\n1976 |     # we may wish to change the value according to precision.\n1977 |     significant_imag_ratio = 1e-5\n1978 |     significant_neg_ratio = 1e-5 if is_double_precision else 5e-3\n1979 |     significant_neg_value = 1e-10 if is_double_precision else 1e-6\n1980 |     small_pos_ratio = 1e-12 if is_double_precision else 2e-7\n1981 | \n1982 |     # Check that there are no significant imaginary parts\n1983 |     if not np.isreal(lambdas).all():\n1984 |         max_imag_abs = np.abs(np.imag(lambdas)).max()\n1985 |         max_real_abs = np.abs(np.real(lambdas)).max()\n1986 |         if max_imag_abs > significant_imag_ratio * max_real_abs:\n1987 |             raise ValueError(\n1988 |                 \"There are significant imaginary parts in eigenvalues (%g \"\n1989 |                 \"of the maximum real part). Either the matrix is not PSD, or \"\n1990 |                 \"there was an issue while computing the eigendecomposition \"\n1991 |                 \"of the matrix.\" % (max_imag_abs / max_real_abs)\n1992 |             )\n1993 | \n1994 |         # warn about imaginary parts being removed\n1995 |         if enable_warnings:\n1996 |             warnings.warn(\n1997 |                 \"There are imaginary parts in eigenvalues (%g \"\n1998 |                 \"of the maximum real part). Either the matrix is not\"\n1999 |                 \" PSD, or there was an issue while computing the \"\n2000 |                 \"eigendecomposition of the matrix. Only the real \"\n2001 |                 \"parts will be kept.\" % (max_imag_abs / max_real_abs),\n2002 |                 PositiveSpectrumWarning,\n2003 |             )\n2004 | \n2005 |     # Remove all imaginary parts (even if zero)\n2006 |     lambdas = np.real(lambdas)\n2007 | \n2008 |     # Check that there are no significant negative eigenvalues\n2009 |     max_eig = lambdas.max()\n2010 |     if max_eig < 0:\n2011 |         raise ValueError(\n2012 |             \"All eigenvalues are negative (maximum is %g). \"\n2013 |             \"Either the matrix is not PSD, or there was an \"\n2014 |             \"issue while computing the eigendecomposition of \"\n2015 |             \"the matrix.\" % max_eig\n2016 |         )\n2017 | \n2018 |     else:\n2019 |         min_eig = lambdas.min()\n2020 |         if (\n2021 |             min_eig < -significant_neg_ratio * max_eig\n2022 |             and min_eig < -significant_neg_value\n2023 |         ):\n2024 |             raise ValueError(\n2025 |                 \"There are significant negative eigenvalues (%g\"\n2026 |                 \" of the maximum positive). Either the matrix is \"\n2027 |                 \"not PSD, or there was an issue while computing \"\n2028 |                 \"the eigendecomposition of the matrix.\" % (-min_eig / max_eig)\n2029 |             )\n2030 |         elif min_eig < 0:\n2031 |             # Remove all negative values and warn about it\n2032 |             if enable_warnings:\n2033 |                 warnings.warn(\n2034 |                     \"There are negative eigenvalues (%g of the \"\n2035 |                     \"maximum positive). Either the matrix is not \"\n2036 |                     \"PSD, or there was an issue while computing the\"\n2037 |                     \" eigendecomposition of the matrix. Negative \"\n2038 |                     \"eigenvalues will be replaced with 0.\" % (-min_eig / max_eig),\n2039 |                     PositiveSpectrumWarning,\n2040 |                 )\n2041 |             lambdas[lambdas < 0] = 0\n2042 | \n2043 |     # Check for conditioning (small positive non-zeros)\n2044 |     too_small_lambdas = (0 < lambdas) & (lambdas < small_pos_ratio * max_eig)\n2045 |     if too_small_lambdas.any():\n2046 |         if enable_warnings:\n2047 |             warnings.warn(\n2048 |                 \"Badly conditioned PSD matrix spectrum: the largest \"\n2049 |                 \"eigenvalue is more than %g times the smallest. \"\n2050 |                 \"Small eigenvalues will be replaced with 0.\"\n2051 |                 \"\" % (1 / small_pos_ratio),\n2052 |                 PositiveSpectrumWarning,\n2053 |             )\n2054 |         lambdas[too_small_lambdas] = 0\n2055 | \n2056 |     return lambdas\n2057 | \n2058 | \n2059 | def _check_sample_weight(\n2060 |     sample_weight, X, dtype=None, copy=False, ensure_non_negative=False\n2061 | ):\n2062 |     \"\"\"Validate sample weights.\n2063 | \n2064 |     Note that passing sample_weight=None will output an array of ones.\n2065 |     Therefore, in some cases, you may want to protect the call with:\n2066 |     if sample_weight is not None:\n2067 |         sample_weight = _check_sample_weight(...)\n2068 | \n2069 |     Parameters\n2070 |     ----------\n2071 |     sample_weight : {ndarray, Number or None}, shape (n_samples,)\n2072 |         Input sample weights.\n2073 | \n2074 |     X : {ndarray, list, sparse matrix}\n2075 |         Input data.\n2076 | \n2077 |     ensure_non_negative : bool, default=False,\n2078 |         Whether or not the weights are expected to be non-negative.\n2079 | \n2080 |         .. versionadded:: 1.0\n2081 | \n2082 |     dtype : dtype, default=None\n2083 |         dtype of the validated `sample_weight`.\n2084 |         If None, and the input `sample_weight` is an array, the dtype of the\n2085 |         input is preserved; otherwise an array with the default numpy dtype\n2086 |         is be allocated.  If `dtype` is not one of `float32`, `float64`,\n2087 |         `None`, the output will be of dtype `float64`.\n2088 | \n2089 |     copy : bool, default=False\n2090 |         If True, a copy of sample_weight will be created.\n2091 | \n2092 |     Returns\n2093 |     -------\n2094 |     sample_weight : ndarray of shape (n_samples,)\n2095 |         Validated sample weight. It is guaranteed to be \"C\" contiguous.\n2096 |     \"\"\"\n2097 |     n_samples = _num_samples(X)\n2098 | \n2099 |     if dtype is not None and dtype not in [np.float32, np.float64]:\n2100 |         dtype = np.float64\n2101 | \n2102 |     if sample_weight is None:\n2103 |         sample_weight = np.ones(n_samples, dtype=dtype)\n2104 |     elif isinstance(sample_weight, numbers.Number):\n2105 |         sample_weight = np.full(n_samples, sample_weight, dtype=dtype)\n2106 |     else:\n2107 |         if dtype is None:\n2108 |             dtype = [np.float64, np.float32]\n2109 |         sample_weight = check_array(\n2110 |             sample_weight,\n2111 |             accept_sparse=False,\n2112 |             ensure_2d=False,\n2113 |             dtype=dtype,\n2114 |             order=\"C\",\n2115 |             copy=copy,\n2116 |             input_name=\"sample_weight\",\n2117 |         )\n2118 |         if sample_weight.ndim != 1:\n2119 |             raise ValueError(\"Sample weights must be 1D array or scalar\")\n2120 | \n2121 |         if sample_weight.shape != (n_samples,):\n2122 |             raise ValueError(\n2123 |                 \"sample_weight.shape == {}, expected {}!\".format(\n2124 |                     sample_weight.shape, (n_samples,)\n2125 |                 )\n2126 |             )\n2127 | \n2128 |     if ensure_non_negative:\n2129 |         check_non_negative(sample_weight, \"`sample_weight`\")\n2130 | \n2131 |     return sample_weight\n2132 | \n2133 | \n2134 | def _allclose_dense_sparse(x, y, rtol=1e-7, atol=1e-9):\n2135 |     \"\"\"Check allclose for sparse and dense data.\n2136 | \n2137 |     Both x and y need to be either sparse or dense, they\n2138 |     can't be mixed.\n2139 | \n2140 |     Parameters\n2141 |     ----------\n2142 |     x : {array-like, sparse matrix}\n2143 |         First array to compare.\n2144 | \n2145 |     y : {array-like, sparse matrix}\n2146 |         Second array to compare.\n2147 | \n2148 |     rtol : float, default=1e-7\n2149 |         Relative tolerance; see numpy.allclose.\n2150 | \n2151 |     atol : float, default=1e-9\n2152 |         absolute tolerance; see numpy.allclose. Note that the default here is\n2153 |         more tolerant than the default for numpy.testing.assert_allclose, where\n2154 |         atol=0.\n2155 |     \"\"\"\n2156 |     if sp.issparse(x) and sp.issparse(y):\n2157 |         x = x.tocsr()\n2158 |         y = y.tocsr()\n2159 |         x.sum_duplicates()\n2160 |         y.sum_duplicates()\n2161 |         return (\n2162 |             np.array_equal(x.indices, y.indices)\n2163 |             and np.array_equal(x.indptr, y.indptr)\n2164 |             and np.allclose(x.data, y.data, rtol=rtol, atol=atol)\n2165 |         )\n2166 |     elif not sp.issparse(x) and not sp.issparse(y):\n2167 |         return np.allclose(x, y, rtol=rtol, atol=atol)\n2168 |     raise ValueError(\n2169 |         \"Can only compare two sparse matrices, not a sparse matrix and an array\"\n2170 |     )\n2171 | \n2172 | \n2173 | def _check_response_method(estimator, response_method):\n2174 |     \"\"\"Check if `response_method` is available in estimator and return it.\n2175 | \n2176 |     .. versionadded:: 1.3\n2177 | \n2178 |     Parameters\n2179 |     ----------\n2180 |     estimator : estimator instance\n2181 |         Classifier or regressor to check.\n2182 | \n2183 |     response_method : {\"predict_proba\", \"predict_log_proba\", \"decision_function\",\n2184 |             \"predict\"} or list of such str\n2185 |         Specifies the response method to use get prediction from an estimator\n2186 |         (i.e. :term:`predict_proba`, :term:`predict_log_proba`,\n2187 |         :term:`decision_function` or :term:`predict`). Possible choices are:\n2188 |         - if `str`, it corresponds to the name to the method to return;\n2189 |         - if a list of `str`, it provides the method names in order of\n2190 |           preference. The method returned corresponds to the first method in\n2191 |           the list and which is implemented by `estimator`.\n2192 | \n2193 |     Returns\n2194 |     -------\n2195 |     prediction_method : callable\n2196 |         Prediction method of estimator.\n2197 | \n2198 |     Raises\n2199 |     ------\n2200 |     AttributeError\n2201 |         If `response_method` is not available in `estimator`.\n2202 |     \"\"\"\n2203 |     if isinstance(response_method, str):\n2204 |         list_methods = [response_method]\n2205 |     else:\n2206 |         list_methods = response_method\n2207 | \n2208 |     prediction_method = [getattr(estimator, method, None) for method in list_methods]\n2209 |     prediction_method = reduce(lambda x, y: x or y, prediction_method)\n2210 |     if prediction_method is None:\n2211 |         raise AttributeError(\n2212 |             f\"{estimator.__class__.__name__} has none of the following attributes: \"\n2213 |             f\"{', '.join(list_methods)}.\"\n2214 |         )\n2215 | \n2216 |     return prediction_method\n2217 | \n2218 | \n2219 | def _check_method_params(X, params, indices=None):\n2220 |     \"\"\"Check and validate the parameters passed to a specific\n2221 |     method like `fit`.\n2222 | \n2223 |     Parameters\n2224 |     ----------\n2225 |     X : array-like of shape (n_samples, n_features)\n2226 |         Data array.\n2227 | \n2228 |     params : dict\n2229 |         Dictionary containing the parameters passed to the method.\n2230 | \n2231 |     indices : array-like of shape (n_samples,), default=None\n2232 |         Indices to be selected if the parameter has the same size as `X`.\n2233 | \n2234 |     Returns\n2235 |     -------\n2236 |     method_params_validated : dict\n2237 |         Validated parameters. We ensure that the values support indexing.\n2238 |     \"\"\"\n2239 |     from . import _safe_indexing\n2240 | \n2241 |     method_params_validated = {}\n2242 |     for param_key, param_value in params.items():\n2243 |         if (\n2244 |             not _is_arraylike(param_value)\n2245 |             and not sp.issparse(param_value)\n2246 |             or _num_samples(param_value) != _num_samples(X)\n2247 |         ):\n2248 |             # Non-indexable pass-through (for now for backward-compatibility).\n2249 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n2250 |             method_params_validated[param_key] = param_value\n2251 |         else:\n2252 |             # Any other method_params should support indexing\n2253 |             # (e.g. for cross-validation).\n2254 |             method_params_validated[param_key] = _make_indexable(param_value)\n2255 |             method_params_validated[param_key] = _safe_indexing(\n2256 |                 method_params_validated[param_key], indices\n2257 |             )\n2258 | \n2259 |     return method_params_validated\n2260 | \n2261 | \n2262 | def _is_pandas_df_or_series(X):\n2263 |     \"\"\"Return True if the X is a pandas dataframe or series.\"\"\"\n2264 |     try:\n2265 |         pd = sys.modules[\"pandas\"]\n2266 |     except KeyError:\n2267 |         return False\n2268 |     return isinstance(X, (pd.DataFrame, pd.Series))\n2269 | \n2270 | \n2271 | def _is_pandas_df(X):\n2272 |     \"\"\"Return True if the X is a pandas dataframe.\"\"\"\n2273 |     try:\n2274 |         pd = sys.modules[\"pandas\"]\n2275 |     except KeyError:\n2276 |         return False\n2277 |     return isinstance(X, pd.DataFrame)\n2278 | \n2279 | \n2280 | def _is_polars_df_or_series(X):\n2281 |     \"\"\"Return True if the X is a polars dataframe or series.\"\"\"\n2282 |     try:\n2283 |         pl = sys.modules[\"polars\"]\n2284 |     except KeyError:\n2285 |         return False\n2286 |     return isinstance(X, (pl.DataFrame, pl.Series))\n2287 | \n2288 | \n2289 | def _is_polars_df(X):\n2290 |     \"\"\"Return True if the X is a polars dataframe.\"\"\"\n2291 |     try:\n2292 |         pl = sys.modules[\"polars\"]\n2293 |     except KeyError:\n2294 |         return False\n2295 |     return isinstance(X, pl.DataFrame)\n2296 | \n2297 | \n2298 | def _get_feature_names(X):\n2299 |     \"\"\"Get feature names from X.\n2300 | \n2301 |     Support for other array containers should place its implementation here.\n2302 | \n2303 |     Parameters\n2304 |     ----------\n2305 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n2306 |         Array container to extract feature names.\n2307 | \n2308 |         - pandas dataframe : The columns will be considered to be feature\n2309 |           names. If the dataframe contains non-string feature names, `None` is\n2310 |           returned.\n2311 |         - All other array containers will return `None`.\n2312 | \n2313 |     Returns\n2314 |     -------\n2315 |     names: ndarray or None\n2316 |         Feature names of `X`. Unrecognized array containers will return `None`.\n2317 |     \"\"\"\n2318 |     feature_names = None\n2319 | \n2320 |     # extract feature names for support array containers\n2321 |     if _is_pandas_df(X):\n2322 |         # Make sure we can inspect columns names from pandas, even with\n2323 |         # versions too old to expose a working implementation of\n2324 |         # __dataframe__.column_names() and avoid introducing any\n2325 |         # additional copy.\n2326 |         # TODO: remove the pandas-specific branch once the minimum supported\n2327 |         # version of pandas has a working implementation of\n2328 |         # __dataframe__.column_names() that is guaranteed to not introduce any\n2329 |         # additional copy of the data without having to impose allow_copy=False\n2330 |         # that could fail with other libraries. Note: in the longer term, we\n2331 |         # could decide to instead rely on the __dataframe_namespace__ API once\n2332 |         # adopted by our minimally supported pandas version.\n2333 |         feature_names = np.asarray(X.columns, dtype=object)\n2334 |     elif hasattr(X, \"__dataframe__\"):\n2335 |         df_protocol = X.__dataframe__()\n2336 |         feature_names = np.asarray(list(df_protocol.column_names()), dtype=object)\n2337 | \n2338 |     if feature_names is None or len(feature_names) == 0:\n2339 |         return\n2340 | \n2341 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n2342 | \n2343 |     # mixed type of string and non-string is not supported\n2344 |     if len(types) > 1 and \"str\" in types:\n2345 |         raise TypeError(\n2346 |             \"Feature names are only supported if all input features have string names, \"\n2347 |             f\"but your input has {types} as feature name / column name types. \"\n2348 |             \"If you want feature names to be stored and validated, you must convert \"\n2349 |             \"them all to strings, by using X.columns = X.columns.astype(str) for \"\n2350 |             \"example. Otherwise you can remove feature / column names from your input \"\n2351 |             \"data, or convert them all to a non-string data type.\"\n2352 |         )\n2353 | \n2354 |     # Only feature names of all strings are supported\n2355 |     if len(types) == 1 and types[0] == \"str\":\n2356 |         return feature_names\n2357 | \n2358 | \n2359 | def _check_feature_names_in(estimator, input_features=None, *, generate_names=True):\n2360 |     \"\"\"Check `input_features` and generate names if needed.\n2361 | \n2362 |     Commonly used in :term:`get_feature_names_out`.\n2363 | \n2364 |     Parameters\n2365 |     ----------\n2366 |     input_features : array-like of str or None, default=None\n2367 |         Input features.\n2368 | \n2369 |         - If `input_features` is `None`, then `feature_names_in_` is\n2370 |           used as feature names in. If `feature_names_in_` is not defined,\n2371 |           then the following input feature names are generated:\n2372 |           `[\"x0\", \"x1\", ..., \"x(n_features_in_ - 1)\"]`.\n2373 |         - If `input_features` is an array-like, then `input_features` must\n2374 |           match `feature_names_in_` if `feature_names_in_` is defined.\n2375 | \n2376 |     generate_names : bool, default=True\n2377 |         Whether to generate names when `input_features` is `None` and\n2378 |         `estimator.feature_names_in_` is not defined. This is useful for transformers\n2379 |         that validates `input_features` but do not