5 |             # check aliases\n746 |             # if list only take first as this is not a MultiIndex\n747 |             if self.index_label and isinstance(\n748 |                 self.index_label, (list, tuple, np.ndarray, Index)\n749 |             ):\n750 |                 index_label = self.index_label[0]\n751 |             # if string good to go\n752 |             elif self.index_label and isinstance(self.index_label, str):\n753 |                 index_label = self.index_label\n754 |             else:\n755 |                 index_label = self.df.index.names[0]\n756 | \n757 |             if isinstance(self.columns, MultiIndex):\n758 |                 self.rowcounter += 1\n759 | \n760 |             if index_label and self.header is not False:\n761 |                 yield ExcelCell(self.rowcounter - 1, 0, index_label, None)\n762 | \n763 |             # write index_values\n764 |             index_values = self.df.index\n765 |             if isinstance(self.df.index, PeriodIndex):\n766 |                 index_values = self.df.index.to_timestamp()\n767 | \n768 |             for idx, idxval in enumerate(index_values):\n769 |                 yield CssExcelCell(\n770 |                     row=self.rowcounter + idx,\n771 |                     col=0,\n772 |                     val=idxval,\n773 |                     style=None,\n774 |                     css_styles=getattr(self.styler, \"ctx_index\", None),\n775 |                     css_row=idx,\n776 |                     css_col=0,\n777 |                     css_converter=self.style_converter,\n778 |                 )\n779 |             coloffset = 1\n780 |         else:\n781 |             coloffset = 0\n782 | \n783 |         yield from self._generate_body(coloffset)\n784 | \n785 |     def _format_hierarchical_rows(self) -> Iterable[ExcelCell]:\n786 |         if self._has_aliases or self.header:\n787 |             self.rowcounter += 1\n788 | \n789 |         gcolidx = 0\n790 | \n791 |         if self.index:\n792 |             index_labels = self.df.index.names\n793 |             # check for aliases\n794 |             if self.index_label and isinstance(\n795 |                 self.index_label, (list, tuple, np.ndarray, Index)\n796 |             ):\n797 |                 index_labels = self.index_label\n798 | \n799 |             # MultiIndex columns require an extra row\n800 |             # with index names (blank if None) for\n801 |             # unambiguous round-trip, unless not merging,\n802 |             # in which case the names all go on one row Issue #11328\n803 |             if isinstance(self.columns, MultiIndex) and (\n804 |                 self.merge_cells in {True, \"columns\"}\n805 |             ):\n806 |                 self.rowcounter += 1\n807 | \n808 |             # if index labels are not empty go ahead and dump\n809 |             if com.any_not_none(*index_labels) and self.header is not False:\n810 |                 for cidx, name in enumerate(index_labels):\n811 |                     yield ExcelCell(self.rowcounter - 1, cidx, name, None)\n812 | \n813 |             if self.merge_cells and self.merge_cells != \"columns\":\n814 |                 # Format hierarchical rows as merged cells.\n815 |                 level_strs = self.df.index._format_multi(\n816 |                     sparsify=True, include_names=False\n817 |                 )\n818 |                 level_lengths = get_level_lengths(level_strs)\n819 | \n820 |                 for spans, levels, level_codes in zip(\n821 |                     level_lengths, self.df.index.levels, self.df.index.codes\n822 |                 ):\n823 |                     values = levels.take(\n824 |                         level_codes,\n825 |                         allow_fill=levels._can_hold_na,\n826 |                         fill_value=levels._na_value,\n827 |                     )\n828 | \n829 |                     for i, span_val in spans.items():\n830 |                         mergestart, mergeend = None, None\n831 |                         if span_val > 1:\n832 |                             mergestart = self.rowcounter + i + span_val - 1\n833 |                             mergeend = gcolidx\n834 |                         yield CssExcelCell(\n835 |                             row=self.rowcounter + i,\n836 |                             col=gcolidx,\n837 |                             val=values[i],\n838 |                             style=None,\n839 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n840 |                             css_row=i,\n841 |                             css_col=gcolidx,\n842 |                             css_converter=self.style_converter,\n843 |                             mergestart=mergestart,\n844 |                             mergeend=mergeend,\n845 |                         )\n846 |                     gcolidx += 1\n847 | \n848 |             else:\n849 |                 # Format hierarchical rows with non-merged values.\n850 |                 for indexcolvals in zip(*self.df.index):\n851 |                     for idx, indexcolval in enumerate(indexcolvals):\n852 |                         yield CssExcelCell(\n853 |                             row=self.rowcounter + idx,\n854 |                             col=gcolidx,\n855 |                             val=indexcolval,\n856 |                             style=None,\n857 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n858 |                             css_row=idx,\n859 |                             css_col=gcolidx,\n860 |                             css_converter=self.style_converter,\n861 |                         )\n862 |                     gcolidx += 1\n863 | \n864 |         yield from self._generate_body(gcolidx)\n865 | \n866 |     @property\n867 |     def _has_aliases(self) -> bool:\n868 |         \"\"\"Whether the aliases for column names are present.\"\"\"\n869 |         return is_list_like(self.header)\n870 | \n871 |     def _generate_body(self, coloffset: int) -> Iterable[ExcelCell]:\n872 |         # Write the body of the frame data series by series.\n873 |         for colidx in range(len(self.columns)):\n874 |             series = self.df.iloc[:, colidx]\n875 |             for i, val in enumerate(series):\n876 |                 yield CssExcelCell(\n877 |                     row=self.rowcounter + i,\n878 |                     col=colidx + coloffset,\n879 |                     val=val,\n880 |                     style=None,\n881 |                     css_styles=getattr(self.styler, \"ctx\", None),\n882 |                     css_row=i,\n883 |                     css_col=colidx,\n884 |                     css_converter=self.style_converter,\n885 |                 )\n886 | \n887 |     def get_formatted_cells(self) -> Iterable[ExcelCell]:\n888 |         for cell in itertools.chain(self._format_header(), self._format_body()):\n889 |             cell.val = self._format_value(cell.val)\n890 |             yield cell\n891 | \n892 |     @doc(storage_options=_shared_docs[\"storage_options\"])\n893 |     def write(\n894 |         self,\n895 |         writer: FilePath | WriteExcelBuffer | ExcelWriter,\n896 |         sheet_name: str = \"Sheet1\",\n897 |         startrow: int = 0,\n898 |         startcol: int = 0,\n899 |         freeze_panes: tuple[int, int] | None = None,\n900 |         engine: str | None = None,\n901 |         storage_options: StorageOptions | None = None,\n902 |         engine_kwargs: dict | None = None,\n903 |     ) -> None:\n904 |         \"\"\"\n905 |         writer : path-like, file-like, or ExcelWriter object\n906 |             File path or existing ExcelWriter\n907 |         sheet_name : str, default 'Sheet1'\n908 |             Name of sheet which will contain DataFrame\n909 |         startrow :\n910 |             upper left cell row to dump data frame\n911 |         startcol :\n912 |             upper left cell column to dump data frame\n913 |         freeze_panes : tuple of integer (length 2), default None\n914 |             Specifies the one-based bottommost row and rightmost column that\n915 |             is to be frozen\n916 |         engine : string, default None\n917 |             write engine to use if writer is a path - you can also set this\n918 |             via the options ``io.excel.xlsx.writer``,\n919 |             or ``io.excel.xlsm.writer``.\n920 | \n921 |         {storage_options}\n922 | \n923 |         engine_kwargs: dict, optional\n924 |             Arbitrary keyword arguments passed to excel engine.\n925 |         \"\"\"\n926 |         from pandas.io.excel import ExcelWriter\n927 | \n928 |         num_rows, num_cols = self.df.shape\n929 |         if num_rows > self.max_rows or num_cols > self.max_cols:\n930 |             raise ValueError(\n931 |                 f\"This sheet is too large! Your sheet size is: {num_rows}, {num_cols} \"\n932 |                 f\"Max sheet size is: {self.max_rows}, {self.max_cols}\"\n933 |             )\n934 | \n935 |         if engine_kwargs is None:\n936 |             engine_kwargs = {}\n937 | \n938 |         formatted_cells = self.get_formatted_cells()\n939 |         if isinstance(writer, ExcelWriter):\n940 |             need_save = False\n941 |         else:\n942 |             writer = ExcelWriter(\n943 |                 writer,\n944 |                 engine=engine,\n945 |                 storage_options=storage_options,\n946 |                 engine_kwargs=engine_kwargs,\n947 |             )\n948 |             need_save = True\n949 | \n950 |         try:\n951 |             writer._write_cells(\n952 |                 formatted_cells,\n953 |                 sheet_name,\n954 |                 startrow=startrow,\n955 |                 startcol=startcol,\n956 |                 freeze_panes=freeze_panes,\n957 |             )\n958 |         finally:\n959 |             # make sure to close opened file handles\n960 |             if need_save:\n961 |                 writer.close()\n```\n"}, {"content": "Now that we have examined the `ExcelFormatter` class, we can see that the `merge_cells` argument is handled differently based on whether it is `True` or `\"columns\"`. The relevant sections of code are in the `_format_header_mi` and `_format_hierarchical_rows` methods.\n\nNext, let's explore the `ExcelWriter` class to see how the merging of cells is actually performed.\n\n<function=get_entity_contents>\n<parameter=entity_names>\n[\"pandas/io/excel/_base.py:ExcelWriter\"]\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/io/excel/_base.py:ExcelWriter`...\n### Search Result:\nFound class `pandas/io/excel/_base.py:ExcelWriter`.\nSource: Exact match found for entity name `pandas/io/excel/_base.py:ExcelWriter`.\n```\n 955 | class ExcelWriter(Generic[_WorkbookT]):\n 956 |     \"\"\"\n 957 |     Class for writing DataFrame objects into excel sheets.\n 958 | \n 959 |     Default is to use:\n 960 | \n 961 |     * `xlsxwriter <https://pypi.org/project/XlsxWriter/>`__ for xlsx files if xlsxwriter\n 962 |       is installed otherwise `openpyxl <https://pypi.org/project/openpyxl/>`__\n 963 |     * `odf <https://pypi.org/project/odfpy/>`__ for ods files\n 964 | \n 965 |     See :meth:`DataFrame.to_excel` for typical usage.\n 966 | \n 967 |     The writer should be used as a context manager. Otherwise, call `close()` to save\n 968 |     and close any opened file handles.\n 969 | \n 970 |     Parameters\n 971 |     ----------\n 972 |     path : str or typing.BinaryIO\n 973 |         Path to xls or xlsx or ods file.\n 974 |     engine : str (optional)\n 975 |         Engine to use for writing. If None, defaults to\n 976 |         ``io.excel.<extension>.writer``.  NOTE: can only be passed as a keyword\n 977 |         argument.\n 978 |     date_format : str, default None\n 979 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n 980 |     datetime_format : str, default None\n 981 |         Format string for datetime objects written into Excel files.\n 982 |         (e.g. 'YYYY-MM-DD HH:MM:SS').\n 983 |     mode : {{'w', 'a'}}, default 'w'\n 984 |         File mode to use (write or append). Append does not work with fsspec URLs.\n 985 |     {storage_options}\n 986 | \n 987 |     if_sheet_exists : {{'error', 'new', 'replace', 'overlay'}}, default 'error'\n 988 |         How to behave when trying to write to a sheet that already\n 989 |         exists (append mode only).\n 990 | \n 991 |         * error: raise a ValueError.\n 992 |         * new: Create a new sheet, with a name determined by the engine.\n 993 |         * replace: Delete the contents of the sheet before writing to it.\n 994 |         * overlay: Write contents to the existing sheet without first removing,\n 995 |           but possibly over top of, the existing contents.\n 996 | \n 997 |         .. versionadded:: 1.3.0\n 998 | \n 999 |         .. versionchanged:: 1.4.0\n1000 | \n1001 |            Added ``overlay`` option\n1002 | \n1003 |     engine_kwargs : dict, optional\n1004 |         Keyword arguments to be passed into the engine. These will be passed to\n1005 |         the following functions of the respective engines:\n1006 | \n1007 |         * xlsxwriter: ``xlsxwriter.Workbook(file, **engine_kwargs)``\n1008 |         * openpyxl (write mode): ``openpyxl.Workbook(**engine_kwargs)``\n1009 |         * openpyxl (append mode): ``openpyxl.load_workbook(file, **engine_kwargs)``\n1010 |         * odf: ``odf.opendocument.OpenDocumentSpreadsheet(**engine_kwargs)``\n1011 | \n1012 |         .. versionadded:: 1.3.0\n1013 | \n1014 |     See Also\n1015 |     --------\n1016 |     read_excel : Read an Excel sheet values (xlsx) file into DataFrame.\n1017 |     read_csv : Read a comma-separated values (csv) file into DataFrame.\n1018 |     read_fwf : Read a table of fixed-width formatted lines into DataFrame.\n1019 | \n1020 |     Notes\n1021 |     -----\n1022 |     For compatibility with CSV writers, ExcelWriter serializes lists\n1023 |     and dicts to strings before writing.\n1024 | \n1025 |     Examples\n1026 |     --------\n1027 |     Default usage:\n1028 | \n1029 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1030 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\") as writer:\n1031 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1032 | \n1033 |     To write to separate sheets in a single file:\n1034 | \n1035 |     >>> df1 = pd.DataFrame([[\"AAA\", \"BBB\"]], columns=[\"Spam\", \"Egg\"])  # doctest: +SKIP\n1036 |     >>> df2 = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1037 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\") as writer:\n1038 |     ...     df1.to_excel(writer, sheet_name=\"Sheet1\")  # doctest: +SKIP\n1039 |     ...     df2.to_excel(writer, sheet_name=\"Sheet2\")  # doctest: +SKIP\n1040 | \n1041 |     You can set the date format or datetime format:\n1042 | \n1043 |     >>> from datetime import date, datetime  # doctest: +SKIP\n1044 |     >>> df = pd.DataFrame(\n1045 |     ...     [\n1046 |     ...         [date(2014, 1, 31), date(1999, 9, 24)],\n1047 |     ...         [datetime(1998, 5, 26, 23, 33, 4), datetime(2014, 2, 28, 13, 5, 13)],\n1048 |     ...     ],\n1049 |     ...     index=[\"Date\", \"Datetime\"],\n1050 |     ...     columns=[\"X\", \"Y\"],\n1051 |     ... )  # doctest: +SKIP\n1052 |     >>> with pd.ExcelWriter(\n1053 |     ...     \"path_to_file.xlsx\",\n1054 |     ...     date_format=\"YYYY-MM-DD\",\n1055 |     ...     datetime_format=\"YYYY-MM-DD HH:MM:SS\",\n1056 |     ... ) as writer:\n1057 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1058 | \n1059 |     You can also append to an existing Excel file:\n1060 | \n1061 |     >>> with pd.ExcelWriter(\"path_to_file.xlsx\", mode=\"a\", engine=\"openpyxl\") as writer:\n1062 |     ...     df.to_excel(writer, sheet_name=\"Sheet3\")  # doctest: +SKIP\n1063 | \n1064 |     Here, the `if_sheet_exists` parameter can be set to replace a sheet if it\n1065 |     already exists:\n1066 | \n1067 |     >>> with pd.ExcelWriter(\n1068 |     ...     \"path_to_file.xlsx\",\n1069 |     ...     mode=\"a\",\n1070 |     ...     engine=\"openpyxl\",\n1071 |     ...     if_sheet_exists=\"replace\",\n1072 |     ... ) as writer:\n1073 |     ...     df.to_excel(writer, sheet_name=\"Sheet1\")  # doctest: +SKIP\n1074 | \n1075 |     You can also write multiple DataFrames to a single sheet. Note that the\n1076 |     ``if_sheet_exists`` parameter needs to be set to ``overlay``:\n1077 | \n1078 |     >>> with pd.ExcelWriter(\n1079 |     ...     \"path_to_file.xlsx\",\n1080 |     ...     mode=\"a\",\n1081 |     ...     engine=\"openpyxl\",\n1082 |     ...     if_sheet_exists=\"overlay\",\n1083 |     ... ) as writer:\n1084 |     ...     df1.to_excel(writer, sheet_name=\"Sheet1\")\n1085 |     ...     df2.to_excel(writer, sheet_name=\"Sheet1\", startcol=3)  # doctest: +SKIP\n1086 | \n1087 |     You can store Excel file in RAM:\n1088 | \n1089 |     >>> import io\n1090 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])\n1091 |     >>> buffer = io.BytesIO()\n1092 |     >>> with pd.ExcelWriter(buffer) as writer:\n1093 |     ...     df.to_excel(writer)\n1094 | \n1095 |     You can pack Excel file into zip archive:\n1096 | \n1097 |     >>> import zipfile  # doctest: +SKIP\n1098 |     >>> df = pd.DataFrame([[\"ABC\", \"XYZ\"]], columns=[\"Foo\", \"Bar\"])  # doctest: +SKIP\n1099 |     >>> with zipfile.ZipFile(\"path_to_file.zip\", \"w\") as zf:\n1100 |     ...     with zf.open(\"filename.xlsx\", \"w\") as buffer:\n1101 |     ...         with pd.ExcelWriter(buffer) as writer:\n1102 |     ...             df.to_excel(writer)  # doctest: +SKIP\n1103 | \n1104 |     You can specify additional arguments to the underlying engine:\n1105 | \n1106 |     >>> with pd.ExcelWriter(\n1107 |     ...     \"path_to_file.xlsx\",\n1108 |     ...     engine=\"xlsxwriter\",\n1109 |     ...     engine_kwargs={{\"options\": {{\"nan_inf_to_errors\": True}}}},\n1110 |     ... ) as writer:\n1111 |     ...     df.to_excel(writer)  # doctest: +SKIP\n1112 | \n1113 |     In append mode, ``engine_kwargs`` are passed through to\n1114 |     openpyxl's ``load_workbook``:\n1115 | \n1116 |     >>> with pd.ExcelWriter(\n1117 |     ...     \"path_to_file.xlsx\",\n1118 |     ...     engine=\"openpyxl\",\n1119 |     ...     mode=\"a\",\n1120 |     ...     engine_kwargs={{\"keep_vba\": True}},\n1121 |     ... ) as writer:\n1122 |     ...     df.to_excel(writer, sheet_name=\"Sheet2\")  # doctest: +SKIP\n1123 |     \"\"\"\n1124 | \n1125 |     # Defining an ExcelWriter implementation (see abstract methods for more...)\n1126 | \n1127 |     # - Mandatory\n1128 |     #   - ``write_cells(self, cells, sheet_name=None, startrow=0, startcol=0)``\n1129 |     #     --> called to write additional DataFrames to disk\n1130 |     #   - ``_supported_extensions`` (tuple of supported extensions), used to\n1131 |     #      check that engine supports the given extension.\n1132 |     #   - ``_engine`` - string that gives the engine name. Necessary to\n1133 |     #     instantiate class directly and bypass ``ExcelWriterMeta`` engine\n1134 |     #     lookup.\n1135 |     #   - ``save(self)`` --> called to save file to disk\n1136 |     # - Mostly mandatory (i.e. should at least exist)\n1137 |     #   - book, cur_sheet, path\n1138 | \n1139 |     # - Optional:\n1140 |     #   - ``__init__(self, path, engine=None, **kwargs)`` --> always called\n1141 |     #     with path as first argument.\n1142 | \n1143 |     # You also need to register the class with ``register_writer()``.\n1144 |     # Technically, ExcelWriter implementations don't need to subclass\n1145 |     # ExcelWriter.\n1146 | \n1147 |     _engine: str\n1148 |     _supported_extensions: tuple[str, ...]\n1149 | \n1150 |     def __new__(\n1151 |         cls,\n1152 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n1153 |         engine: str | None = None,\n1154 |         date_format: str | None = None,\n1155 |         datetime_format: str | None = None,\n1156 |         mode: str = \"w\",\n1157 |         storage_options: StorageOptions | None = None,\n1158 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n1159 |         engine_kwargs: dict | None = None,\n1160 |     ) -> Self:\n1161 |         # only switch class if generic(ExcelWriter)\n1162 |         if cls is ExcelWriter:\n1163 |             if engine is None or (isinstance(engine, str) and engine == \"auto\"):\n1164 |                 if isinstance(path, str):\n1165 |                     ext = os.path.splitext(path)[-1][1:]\n1166 |                 else:\n1167 |                     ext = \"xlsx\"\n1168 | \n1169 |                 try:\n1170 |                     engine = config.get_option(f\"io.excel.{ext}.writer\")\n1171 |                     if engine == \"auto\":\n1172 |                         engine = get_default_engine(ext, mode=\"writer\")\n1173 |                 except KeyError as err:\n1174 |                     raise ValueError(f\"No engine for filetype: '{ext}'\") from err\n1175 | \n1176 |             # for mypy\n1177 |             assert engine is not None\n1178 |             #  error: Incompatible types in assignment (expression has type\n1179 |             #  \"type[ExcelWriter[Any]]\", variable has type \"type[Self]\")\n1180 |             cls = get_writer(engine)  # type: ignore[assignment]\n1181 | \n1182 |         return object.__new__(cls)\n1183 | \n1184 |     # declare external properties you can count on\n1185 |     _path = None\n1186 | \n1187 |     @property\n1188 |     def supported_extensions(self) -> tuple[str, ...]:\n1189 |         \"\"\"Extensions that writer engine supports.\"\"\"\n1190 |         return self._supported_extensions\n1191 | \n1192 |     @property\n1193 |     def engine(self) -> str:\n1194 |         \"\"\"Name of engine.\"\"\"\n1195 |         return self._engine\n1196 | \n1197 |     @property\n1198 |     def sheets(self) -> dict[str, Any]:\n1199 |         \"\"\"Mapping of sheet names to sheet objects.\"\"\"\n1200 |         raise NotImplementedError\n1201 | \n1202 |     @property\n1203 |     def book(self) -> _WorkbookT:\n1204 |         \"\"\"\n1205 |         Book instance. Class type will depend on the engine used.\n1206 | \n1207 |         This attribute can be used to access engine-specific features.\n1208 |         \"\"\"\n1209 |         raise NotImplementedError\n1210 | \n1211 |     def _write_cells(\n1212 |         self,\n1213 |         cells,\n1214 |         sheet_name: str | None = None,\n1215 |         startrow: int = 0,\n1216 |         startcol: int = 0,\n1217 |         freeze_panes: tuple[int, int] | None = None,\n1218 |     ) -> None:\n1219 |         \"\"\"\n1220 |         Write given formatted cells into Excel an excel sheet\n1221 | \n1222 |         Parameters\n1223 |         ----------\n1224 |         cells : generator\n1225 |             cell of formatted data to save to Excel sheet\n1226 |         sheet_name : str, default None\n1227 |             Name of Excel sheet, if None, then use self.cur_sheet\n1228 |         startrow : upper left cell row to dump data frame\n1229 |         startcol : upper left cell column to dump data frame\n1230 |         freeze_panes: int tuple of length 2\n1231 |             contains the bottom-most row and right-most column to freeze\n1232 |         \"\"\"\n1233 |         raise NotImplementedError\n1234 | \n1235 |     def _save(self) -> None:\n1236 |         \"\"\"\n1237 |         Save workbook to disk.\n1238 |         \"\"\"\n1239 |         raise NotImplementedError\n1240 | \n1241 |     def __init__(\n1242 |         self,\n1243 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n1244 |         engine: str | None = None,\n1245 |         date_format: str | None = None,\n1246 |         datetime_format: str | None = None,\n1247 |         mode: str = \"w\",\n1248 |         storage_options: StorageOptions | None = None,\n1249 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n1250 |         engine_kwargs: dict[str, Any] | None = None,\n1251 |     ) -> None:\n1252 |         # validate that this engine can handle the extension\n1253 |         if isinstance(path, str):\n1254 |             ext = os.path.splitext(path)[-1]\n1255 |             self.check_extension(ext)\n1256 | \n1257 |         # use mode to open the file\n1258 |         if \"b\" not in mode:\n1259 |             mode += \"b\"\n1260 |         # use \"a\" for the user to append data to excel but internally use \"r+\" to let\n1261 |         # the excel backend first read the existing file and then write any data to it\n1262 |         mode = mode.replace(\"a\", \"r+\")\n1263 | \n1264 |         if if_sheet_exists not in (None, \"error\", \"new\", \"replace\", \"overlay\"):\n1265 |             raise ValueError(\n1266 |                 f\"'{if_sheet_exists}' is not valid for if_sheet_exists. \"\n1267 |                 \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n1268 |             )\n1269 |         if if_sheet_exists and \"r+\" not in mode:\n1270 |             raise ValueError(\"if_sheet_exists is only valid in append mode (mode='a')\")\n1271 |         if if_sheet_exists is None:\n1272 |             if_sheet_exists = \"error\"\n1273 |         self._if_sheet_exists = if_sheet_exists\n1274 | \n1275 |         # cast ExcelWriter to avoid adding 'if self._handles is not None'\n1276 |         self._handles = IOHandles(\n1277 |             cast(IO[bytes], path), compression={\"compression\": None}\n1278 |         )\n1279 |         if not isinstance(path, ExcelWriter):\n1280 |             self._handles = get_handle(\n1281 |                 path, mode, storage_options=storage_options, is_text=False\n1282 |             )\n1283 |         self._cur_sheet = None\n1284 | \n1285 |         if date_format is None:\n1286 |             self._date_format = \"YYYY-MM-DD\"\n1287 |         else:\n1288 |             self._date_format = date_format\n1289 |         if datetime_format is None:\n1290 |             self._datetime_format = \"YYYY-MM-DD HH:MM:SS\"\n1291 |         else:\n1292 |             self._datetime_format = datetime_format\n1293 | \n1294 |         self._mode = mode\n1295 | \n1296 |     @property\n1297 |     def date_format(self) -> str:\n1298 |         \"\"\"\n1299 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n1300 |         \"\"\"\n1301 |         return self._date_format\n1302 | \n1303 |     @property\n1304 |     def datetime_format(self) -> str:\n1305 |         \"\"\"\n1306 |         Format string for dates written into Excel files (e.g. 'YYYY-MM-DD').\n1307 |         \"\"\"\n1308 |         return self._datetime_format\n1309 | \n1310 |     @property\n1311 |     def if_sheet_exists(self) -> str:\n1312 |         \"\"\"\n1313 |         How to behave when writing to a sheet that already exists in append mode.\n1314 |         \"\"\"\n1315 |         return self._if_sheet_exists\n1316 | \n1317 |     def __fspath__(self) -> str:\n1318 |         return getattr(self._handles.handle, \"name\", \"\")\n1319 | \n1320 |     def _get_sheet_name(self, sheet_name: str | None) -> str:\n1321 |         if sheet_name is None:\n1322 |             sheet_name = self._cur_sheet\n1323 |         if sheet_name is None:  # pragma: no cover\n1324 |             raise ValueError(\"Must pass explicit sheet_name or set _cur_sheet property\")\n1325 |         return sheet_name\n1326 | \n1327 |     def _value_with_fmt(\n1328 |         self, val\n1329 |     ) -> tuple[\n1330 |         int | float | bool | str | datetime.datetime | datetime.date, str | None\n1331 |     ]:\n1332 |         \"\"\"\n1333 |         Convert numpy types to Python types for the Excel writers.\n1334 | \n1335 |         Parameters\n1336 |         ----------\n1337 |         val : object\n1338 |             Value to be written into cells\n1339 | \n1340 |         Returns\n1341 |         -------\n1342 |         Tuple with the first element being the converted value and the second\n1343 |             being an optional format\n1344 |         \"\"\"\n1345 |         fmt = None\n1346 | \n1347 |         if is_integer(val):\n1348 |             val = int(val)\n1349 |         elif is_float(val):\n1350 |             val = float(val)\n1351 |         elif is_bool(val):\n1352 |             val = bool(val)\n1353 |         elif is_decimal(val):\n1354 |             val = Decimal(val)\n1355 |         elif isinstance(val, datetime.datetime):\n1356 |             fmt = self._datetime_format\n1357 |         elif isinstance(val, datetime.date):\n1358 |             fmt = self._date_format\n1359 |         elif isinstance(val, datetime.timedelta):\n1360 |             val = val.total_seconds() / 86400\n1361 |             fmt = \"0\"\n1362 |         else:\n1363 |             val = str(val)\n1364 |             # GH#56954\n1365 |             # Excel's limitation on cell contents is 32767 characters\n1366 |             # xref https://support.microsoft.com/en-au/office/excel-specifications-and-limits-1672b34d-7043-467e-8e27-269d656771c3\n1367 |             if len(val) > 32767:\n1368 |                 warnings.warn(\n1369 |                     f\"Cell contents too long ({len(val)}), \"\n1370 |                     \"truncated to 32767 characters\",\n1371 |                     UserWarning,\n1372 |                     stacklevel=find_stack_level(),\n1373 |                 )\n1374 |         return val, fmt\n1375 | \n1376 |     @classmethod\n1377 |     def check_extension(cls, ext: str) -> Literal[True]:\n1378 |         \"\"\"\n1379 |         checks that path's extension against the Writer's supported\n1380 |         extensions.  If it isn't supported, raises UnsupportedFiletypeError.\n1381 |         \"\"\"\n1382 |         if ext.startswith(\".\"):\n1383 |             ext = ext[1:]\n1384 |         if not any(ext in extension for extension in cls._supported_extensions):\n1385 |             raise ValueError(f\"Invalid extension for engine '{cls.engine}': '{ext}'\")\n1386 |         return True\n1387 | \n1388 |     # Allow use as a contextmanager\n1389 |     def __enter__(self) -> Self:\n1390 |         return self\n1391 | \n1392 |     def __exit__(\n1393 |         self,\n1394 |         exc_type: type[BaseException] | None,\n1395 |         exc_value: BaseException | None,\n1396 |         traceback: TracebackType | None,\n1397 |     ) -> None:\n1398 |         self.close()\n1399 | \n1400 |     def close(self) -> None:\n1401 |         \"\"\"synonym for save, to make it more file-like\"\"\"\n1402 |         self._save()\n1403 |         self._handles.close()\n```\n"}, {"content": "The `ExcelWriter` class itself does not directly handle the merging of cells based on the `merge_cells` argument. Instead, it appears to be the responsibility of the specific engine implementations (e.g., `XlsxWriter`, `OpenpyxlWriter`) that inherit from `ExcelWriter`.\n\nSince the `merge_cells` argument is now capable of taking `\"columns\"`, we need to check the engine-specific implementations to understand how this new value is processed.\n\nLet's start with the `XlsxWriter` class, which is part of the `pandas/io/excel/_xlsxwriter.py` file.\n\n<function=get_entity_contents>\n<parameter=entity_names>\n[\"pandas/io/excel/_xlsxwriter.py:XlsxWriter\"]\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/io/excel/_xlsxwriter.py:XlsxWriter`...\n### Search Result:\nFound class `pandas/io/excel/_xlsxwriter.py:XlsxWriter`.\nSource: Exact match found for entity name `pandas/io/excel/_xlsxwriter.py:XlsxWriter`.\n```\n180 | class XlsxWriter(ExcelWriter):\n181 |     _engine = \"xlsxwriter\"\n182 |     _supported_extensions = (\".xlsx\",)\n183 | \n184 |     def __init__(  # pyright: ignore[reportInconsistentConstructor]\n185 |         self,\n186 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n187 |         engine: str | None = None,\n188 |         date_format: str | None = None,\n189 |         datetime_format: str | None = None,\n190 |         mode: str = \"w\",\n191 |         storage_options: StorageOptions | None = None,\n192 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n193 |         engine_kwargs: dict[str, Any] | None = None,\n194 |         **kwargs,\n195 |     ) -> None:\n196 |         # Use the xlsxwriter module as the Excel writer.\n197 |         from xlsxwriter import Workbook\n198 | \n199 |         engine_kwargs = combine_kwargs(engine_kwargs, kwargs)\n200 | \n201 |         if mode == \"a\":\n202 |             raise ValueError(\"Append mode is not supported with xlsxwriter!\")\n203 | \n204 |         super().__init__(\n205 |             path,\n206 |             engine=engine,\n207 |             date_format=date_format,\n208 |             datetime_format=datetime_format,\n209 |             mode=mode,\n210 |             storage_options=storage_options,\n211 |             if_sheet_exists=if_sheet_exists,\n212 |             engine_kwargs=engine_kwargs,\n213 |         )\n214 | \n215 |         try:\n216 |             self._book = Workbook(self._handles.handle, **engine_kwargs)\n217 |         except TypeError:\n218 |             self._handles.handle.close()\n219 |             raise\n220 | \n221 |     @property\n222 |     def book(self):\n223 |         \"\"\"\n224 |         Book instance of class xlsxwriter.Workbook.\n225 | \n226 |         This attribute can be used to access engine-specific features.\n227 |         \"\"\"\n228 |         return self._book\n229 | \n230 |     @property\n231 |     def sheets(self) -> dict[str, Any]:\n232 |         result = self.book.sheetnames\n233 |         return result\n234 | \n235 |     def _save(self) -> None:\n236 |         \"\"\"\n237 |         Save workbook to disk.\n238 |         \"\"\"\n239 |         self.book.close()\n240 | \n241 |     def _write_cells(\n242 |         self,\n243 |         cells,\n244 |         sheet_name: str | None = None,\n245 |         startrow: int = 0,\n246 |         startcol: int = 0,\n247 |         freeze_panes: tuple[int, int] | None = None,\n248 |     ) -> None:\n249 |         # Write the frame cells using xlsxwriter.\n250 |         sheet_name = self._get_sheet_name(sheet_name)\n251 | \n252 |         wks = self.book.get_worksheet_by_name(sheet_name)\n253 |         if wks is None:\n254 |             wks = self.book.add_worksheet(sheet_name)\n255 | \n256 |         style_dict = {\"null\": None}\n257 | \n258 |         if validate_freeze_panes(freeze_panes):\n259 |             wks.freeze_panes(*(freeze_panes))\n260 | \n261 |         for cell in cells:\n262 |             val, fmt = self._value_with_fmt(cell.val)\n263 | \n264 |             stylekey = json.dumps(cell.style)\n265 |             if fmt:\n266 |                 stylekey += fmt\n267 | \n268 |             if stylekey in style_dict:\n269 |                 style = style_dict[stylekey]\n270 |             else:\n271 |                 style = self.book.add_format(_XlsxStyler.convert(cell.style, fmt))\n272 |                 style_dict[stylekey] = style\n273 | \n274 |             if cell.mergestart is not None and cell.mergeend is not None:\n275 |                 wks.merge_range(\n276 |                     startrow + cell.row,\n277 |                     startcol + cell.col,\n278 |                     startrow + cell.mergestart,\n279 |                     startcol + cell.mergeend,\n280 |                     val,\n281 |                     style,\n282 |                 )\n283 |             else:\n284 |                 wks.write(startrow + cell.row, startcol + cell.col, val, style)\n```\n"}, {"content": "From the `XlsxWriter` class, we can see that the merging of cells is handled in the `_write_cells` method. Specifically, the `merge_cells` argument affects the generation of `CssExcelCell` objects, which contain `mergestart` and `mergeend` attributes. These attributes are used to merge ranges in the Excel worksheet.\n\nNow, let's look at the `OpenpyxlWriter` class, which is part of the `pandas/io/excel/_openpyxl.py` file, to see how it handles the merging of cells.\n\n<function=get_entity_contents>\n<parameter=entity_names>\n[\"pandas/io/excel/_openpyxl.py:OpenpyxlWriter\"]\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/io/excel/_openpyxl.py:OpenpyxlWriter`...\n### Search Result:\nFound class `pandas/io/excel/_openpyxl.py:OpenpyxlWriter`.\nSource: Exact match found for entity name `pandas/io/excel/_openpyxl.py:OpenpyxlWriter`.\n```\n 41 | class OpenpyxlWriter(ExcelWriter):\n 42 |     _engine = \"openpyxl\"\n 43 |     _supported_extensions = (\".xlsx\", \".xlsm\")\n 44 | \n 45 |     def __init__(  # pyright: ignore[reportInconsistentConstructor]\n 46 |         self,\n 47 |         path: FilePath | WriteExcelBuffer | ExcelWriter,\n 48 |         engine: str | None = None,\n 49 |         date_format: str | None = None,\n 50 |         datetime_format: str | None = None,\n 51 |         mode: str = \"w\",\n 52 |         storage_options: StorageOptions | None = None,\n 53 |         if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n 54 |         engine_kwargs: dict[str, Any] | None = None,\n 55 |         **kwargs,\n 56 |     ) -> None:\n 57 |         # Use the openpyxl module as the Excel writer.\n 58 |         from openpyxl.workbook import Workbook\n 59 | \n 60 |         engine_kwargs = combine_kwargs(engine_kwargs, kwargs)\n 61 | \n 62 |         super().__init__(\n 63 |             path,\n 64 |             mode=mode,\n 65 |             storage_options=storage_options,\n 66 |             if_sheet_exists=if_sheet_exists,\n 67 |             engine_kwargs=engine_kwargs,\n 68 |         )\n 69 | \n 70 |         # ExcelWriter replaced \"a\" by \"r+\" to allow us to first read the excel file from\n 71 |         # the file and later write to it\n 72 |         if \"r+\" in self._mode:  # Load from existing workbook\n 73 |             from openpyxl import load_workbook\n 74 | \n 75 |             try:\n 76 |                 self._book = load_workbook(self._handles.handle, **engine_kwargs)\n 77 |             except TypeError:\n 78 |                 self._handles.handle.close()\n 79 |                 raise\n 80 |             self._handles.handle.seek(0)\n 81 |         else:\n 82 |             # Create workbook object with default optimized_write=True.\n 83 |             try:\n 84 |                 self._book = Workbook(**engine_kwargs)\n 85 |             except TypeError:\n 86 |                 self._handles.handle.close()\n 87 |                 raise\n 88 | \n 89 |             if self.book.worksheets:\n 90 |                 self.book.remove(self.book.worksheets[0])\n 91 | \n 92 |     @property\n 93 |     def book(self) -> Workbook:\n 94 |         \"\"\"\n 95 |         Book instance of class openpyxl.workbook.Workbook.\n 96 | \n 97 |         This attribute can be used to access engine-specific features.\n 98 |         \"\"\"\n 99 |         return self._book\n100 | \n101 |     @property\n102 |     def sheets(self) -> dict[str, Any]:\n103 |         \"\"\"Mapping of sheet names to sheet objects.\"\"\"\n104 |         result = {name: self.book[name] for name in self.book.sheetnames}\n105 |         return result\n106 | \n107 |     def _save(self) -> None:\n108 |         \"\"\"\n109 |         Save workbook to disk.\n110 |         \"\"\"\n111 |         self.book.save(self._handles.handle)\n112 |         if \"r+\" in self._mode and not isinstance(self._handles.handle, mmap.mmap):\n113 |             # truncate file to the written content\n114 |             self._handles.handle.truncate()\n115 | \n116 |     @classmethod\n117 |     def _convert_to_style_kwargs(cls, style_dict: dict) -> dict[str, Serialisable]:\n118 |         \"\"\"\n119 |         Convert a style_dict to a set of kwargs suitable for initializing\n120 |         or updating-on-copy an openpyxl v2 style object.\n121 | \n122 |         Parameters\n123 |         ----------\n124 |         style_dict : dict\n125 |             A dict with zero or more of the following keys (or their synonyms).\n126 |                 'font'\n127 |                 'fill'\n128 |                 'border' ('borders')\n129 |                 'alignment'\n130 |                 'number_format'\n131 |                 'protection'\n132 | \n133 |         Returns\n134 |         -------\n135 |         style_kwargs : dict\n136 |             A dict with the same, normalized keys as ``style_dict`` but each\n137 |             value has been replaced with a native openpyxl style object of the\n138 |             appropriate class.\n139 |         \"\"\"\n140 |         _style_key_map = {\"borders\": \"border\"}\n141 | \n142 |         style_kwargs: dict[str, Serialisable] = {}\n143 |         for k, v in style_dict.items():\n144 |             k = _style_key_map.get(k, k)\n145 |             _conv_to_x = getattr(cls, f\"_convert_to_{k}\", lambda x: None)\n146 |             new_v = _conv_to_x(v)\n147 |             if new_v:\n148 |                 style_kwargs[k] = new_v\n149 | \n150 |         return style_kwargs\n151 | \n152 |     @classmethod\n153 |     def _convert_to_color(cls, color_spec):\n154 |         \"\"\"\n155 |         Convert ``color_spec`` to an openpyxl v2 Color object.\n156 | \n157 |         Parameters\n158 |         ----------\n159 |         color_spec : str, dict\n160 |             A 32-bit ARGB hex string, or a dict with zero or more of the\n161 |             following keys.\n162 |                 'rgb'\n163 |                 'indexed'\n164 |                 'auto'\n165 |                 'theme'\n166 |                 'tint'\n167 |                 'index'\n168 |                 'type'\n169 | \n170 |         Returns\n171 |         -------\n172 |         color : openpyxl.styles.Color\n173 |         \"\"\"\n174 |         from openpyxl.styles import Color\n175 | \n176 |         if isinstance(color_spec, str):\n177 |             return Color(color_spec)\n178 |         else:\n179 |             return Color(**color_spec)\n180 | \n181 |     @classmethod\n182 |     def _convert_to_font(cls, font_dict):\n183 |         \"\"\"\n184 |         Convert ``font_dict`` to an openpyxl v2 Font object.\n185 | \n186 |         Parameters\n187 |         ----------\n188 |         font_dict : dict\n189 |             A dict with zero or more of the following keys (or their synonyms).\n190 |                 'name'\n191 |                 'size' ('sz')\n192 |                 'bold' ('b')\n193 |                 'italic' ('i')\n194 |                 'underline' ('u')\n195 |                 'strikethrough' ('strike')\n196 |                 'color'\n197 |                 'vertAlign' ('vertalign')\n198 |                 'charset'\n199 |                 'scheme'\n200 |                 'family'\n201 |                 'outline'\n202 |                 'shadow'\n203 |                 'condense'\n204 | \n205 |         Returns\n206 |         -------\n207 |         font : openpyxl.styles.Font\n208 |         \"\"\"\n209 |         from openpyxl.styles import Font\n210 | \n211 |         _font_key_map = {\n212 |             \"sz\": \"size\",\n213 |             \"b\": \"bold\",\n214 |             \"i\": \"italic\",\n215 |             \"u\": \"underline\",\n216 |             \"strike\": \"strikethrough\",\n217 |             \"vertalign\": \"vertAlign\",\n218 |         }\n219 | \n220 |         font_kwargs = {}\n221 |         for k, v in font_dict.items():\n222 |             k = _font_key_map.get(k, k)\n223 |             if k == \"color\":\n224 |                 v = cls._convert_to_color(v)\n225 |             font_kwargs[k] = v\n226 | \n227 |         return Font(**font_kwargs)\n228 | \n229 |     @classmethod\n230 |     def _convert_to_stop(cls, stop_seq):\n231 |         \"\"\"\n232 |         Convert ``stop_seq`` to a list of openpyxl v2 Color objects,\n233 |         suitable for initializing the ``GradientFill`` ``stop`` parameter.\n234 | \n235 |         Parameters\n236 |         ----------\n237 |         stop_seq : iterable\n238 |             An iterable that yields objects suitable for consumption by\n239 |             ``_convert_to_color``.\n240 | \n241 |         Returns\n242 |         -------\n243 |         stop : list of openpyxl.styles.Color\n244 |         \"\"\"\n245 |         return map(cls._convert_to_color, stop_seq)\n246 | \n247 |     @classmethod\n248 |     def _convert_to_fill(cls, fill_dict: dict[str, Any]) -> Fill:\n249 |         \"\"\"\n250 |         Convert ``fill_dict`` to an openpyxl v2 Fill object.\n251 | \n252 |         Parameters\n253 |         ----------\n254 |         fill_dict : dict\n255 |             A dict with one or more of the following keys (or their synonyms),\n256 |                 'fill_type' ('patternType', 'patterntype')\n257 |                 'start_color' ('fgColor', 'fgcolor')\n258 |                 'end_color' ('bgColor', 'bgcolor')\n259 |             or one or more of the following keys (or their synonyms).\n260 |                 'type' ('fill_type')\n261 |                 'degree'\n262 |                 'left'\n263 |                 'right'\n264 |                 'top'\n265 |                 'bottom'\n266 |                 'stop'\n267 | \n268 |         Returns\n269 |         -------\n270 |         fill : openpyxl.styles.Fill\n271 |         \"\"\"\n272 |         from openpyxl.styles import (\n273 |             GradientFill,\n274 |             PatternFill,\n275 |         )\n276 | \n277 |         _pattern_fill_key_map = {\n278 |             \"patternType\": \"fill_type\",\n279 |             \"patterntype\": \"fill_type\",\n280 |             \"fgColor\": \"start_color\",\n281 |             \"fgcolor\": \"start_color\",\n282 |             \"bgColor\": \"end_color\",\n283 |             \"bgcolor\": \"end_color\",\n284 |         }\n285 | \n286 |         _gradient_fill_key_map = {\"fill_type\": \"type\"}\n287 | \n288 |         pfill_kwargs = {}\n289 |         gfill_kwargs = {}\n290 |         for k, v in fill_dict.items():\n291 |             pk = _pattern_fill_key_map.get(k)\n292 |             gk = _gradient_fill_key_map.get(k)\n293 |             if pk in [\"start_color\", \"end_color\"]:\n294 |                 v = cls._convert_to_color(v)\n295 |             if gk == \"stop\":\n296 |                 v = cls._convert_to_stop(v)\n297 |             if pk:\n298 |                 pfill_kwargs[pk] = v\n299 |             elif gk:\n300 |                 gfill_kwargs[gk] = v\n301 |             else:\n302 |                 pfill_kwargs[k] = v\n303 |                 gfill_kwargs[k] = v\n304 | \n305 |         try:\n306 |             return PatternFill(**pfill_kwargs)\n307 |         except TypeError:\n308 |             return GradientFill(**gfill_kwargs)\n309 | \n310 |     @classmethod\n311 |     def _convert_to_side(cls, side_spec):\n312 |         \"\"\"\n313 |         Convert ``side_spec`` to an openpyxl v2 Side object.\n314 | \n315 |         Parameters\n316 |         ----------\n317 |         side_spec : str, dict\n318 |             A string specifying the border style, or a dict with zero or more\n319 |             of the following keys (or their synonyms).\n320 |                 'style' ('border_style')\n321 |                 'color'\n322 | \n323 |         Returns\n324 |         -------\n325 |         side : openpyxl.styles.Side\n326 |         \"\"\"\n327 |         from openpyxl.styles import Side\n328 | \n329 |         _side_key_map = {\"border_style\": \"style\"}\n330 | \n331 |         if isinstance(side_spec, str):\n332 |             return Side(style=side_spec)\n333 | \n334 |         side_kwargs = {}\n335 |         for k, v in side_spec.items():\n336 |             k = _side_key_map.get(k, k)\n337 |             if k == \"color\":\n338 |                 v = cls._convert_to_color(v)\n339 |             side_kwargs[k] = v\n340 | \n341 |         return Side(**side_kwargs)\n342 | \n343 |     @classmethod\n344 |     def _convert_to_border(cls, border_dict):\n345 |         \"\"\"\n346 |         Convert ``border_dict`` to an openpyxl v2 Border object.\n347 | \n348 |         Parameters\n349 |         ----------\n350 |         border_dict : dict\n351 |             A dict with zero or more of the following keys (or their synonyms).\n352 |                 'left'\n353 |                 'right'\n354 |                 'top'\n355 |                 'bottom'\n356 |                 'diagonal'\n357 |                 'diagonal_direction'\n358 |                 'vertical'\n359 |                 'horizontal'\n360 |                 'diagonalUp' ('diagonalup')\n361 |                 'diagonalDown' ('diagonaldown')\n362 |                 'outline'\n363 | \n364 |         Returns\n365 |         -------\n366 |         border : openpyxl.styles.Border\n367 |         \"\"\"\n368 |         from openpyxl.styles import Border\n369 | \n370 |         _border_key_map = {\"diagonalup\": \"diagonalUp\", \"diagonaldown\": \"diagonalDown\"}\n371 | \n372 |         border_kwargs = {}\n373 |         for k, v in border_dict.items():\n374 |             k = _border_key_map.get(k, k)\n375 |             if k == \"color\":\n376 |                 v = cls._convert_to_color(v)\n377 |             if k in [\"left\", \"right\", \"top\", \"bottom\", \"diagonal\"]:\n378 |                 v = cls._convert_to_side(v)\n379 |             border_kwargs[k] = v\n380 | \n381 |         return Border(**border_kwargs)\n382 | \n383 |     @classmethod\n384 |     def _convert_to_alignment(cls, alignment_dict):\n385 |         \"\"\"\n386 |         Convert ``alignment_dict`` to an openpyxl v2 Alignment object.\n387 | \n388 |         Parameters\n389 |         ----------\n390 |         alignment_dict : dict\n391 |             A dict with zero or more of the following keys (or their synonyms).\n392 |                 'horizontal'\n393 |                 'vertical'\n394 |                 'text_rotation'\n395 |                 'wrap_text'\n396 |                 'shrink_to_fit'\n397 |                 'indent'\n398 |         Returns\n399 |         -------\n400 |         alignment : openpyxl.styles.Alignment\n401 |         \"\"\"\n402 |         from openpyxl.styles import Alignment\n403 | \n404 |         return Alignment(**alignment_dict)\n405 | \n406 |     @classmethod\n407 |     def _convert_to_number_format(cls, number_format_dict):\n408 |         \"\"\"\n409 |         Convert ``number_format_dict`` to an openpyxl v2.1.0 number format\n410 |         initializer.\n411 | \n412 |         Parameters\n413 |         ----------\n414 |         number_format_dict : dict\n415 |             A dict with zero or more of the following keys.\n416 |                 'format_code' : str\n417 | \n418 |         Returns\n419 |         -------\n420 |         number_format : str\n421 |         \"\"\"\n422 |         return number_format_dict[\"format_code\"]\n423 | \n424 |     @classmethod\n425 |     def _convert_to_protection(cls, protection_dict):\n426 |         \"\"\"\n427 |         Convert ``protection_dict`` to an openpyxl v2 Protection object.\n428 | \n429 |         Parameters\n430 |         ----------\n431 |         protection_dict : dict\n432 |             A dict with zero or more of the following keys.\n433 |                 'locked'\n434 |                 'hidden'\n435 | \n436 |         Returns\n437 |         -------\n438 |         \"\"\"\n439 |         from openpyxl.styles import Protection\n440 | \n441 |         return Protection(**protection_dict)\n442 | \n443 |     def _write_cells(\n444 |         self,\n445 |         cells,\n446 |         sheet_name: str | None = None,\n447 |         startrow: int = 0,\n448 |         startcol: int = 0,\n449 |         freeze_panes: tuple[int, int] | None = None,\n450 |     ) -> None:\n451 |         # Write the frame cells using openpyxl.\n452 |         sheet_name = self._get_sheet_name(sheet_name)\n453 | \n454 |         _style_cache: dict[str, dict[str, Serialisable]] = {}\n455 | \n456 |         if sheet_name in self.sheets and self._if_sheet_exists != \"new\":\n457 |             if \"r+\" in self._mode:\n458 |                 if self._if_sheet_exists == \"replace\":\n459 |                     old_wks = self.sheets[sheet_name]\n460 |                     target_index = self.book.index(old_wks)\n461 |                     del self.book[sheet_name]\n462 |                     wks = self.book.create_sheet(sheet_name, target_index)\n463 |                 elif self._if_sheet_exists == \"error\":\n464 |                     raise ValueError(\n465 |                         f\"Sheet '{sheet_name}' already exists and \"\n466 |                         f\"if_sheet_exists is set to 'error'.\"\n467 |                     )\n468 |                 elif self._if_sheet_exists == \"overlay\":\n469 |                     wks = self.sheets[sheet_name]\n470 |                 else:\n471 |                     raise ValueError(\n472 |                         f\"'{self._if_sheet_exists}' is not valid for if_sheet_exists. \"\n473 |                         \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n474 |                     )\n475 |             else:\n476 |                 wks = self.sheets[sheet_name]\n477 |         else:\n478 |             wks = self.book.create_sheet()\n479 |             wks.title = sheet_name\n480 | \n481 |         if validate_freeze_panes(freeze_panes):\n482 |             freeze_panes = cast(tuple[int, int], freeze_panes)\n483 |             wks.freeze_panes = wks.cell(\n484 |                 row=freeze_panes[0] + 1, column=freeze_panes[1] + 1\n485 |             )\n486 | \n487 |         for cell in cells:\n488 |             xcell = wks.cell(\n489 |                 row=startrow + cell.row + 1, column=startcol + cell.col + 1\n490 |             )\n491 |             xcell.value, fmt = self._value_with_fmt(cell.val)\n492 |             if fmt:\n493 |                 xcell.number_format = fmt\n494 | \n495 |             style_kwargs: dict[str, Serialisable] | None = {}\n496 |             if cell.style:\n497 |                 key = str(cell.style)\n498 |                 style_kwargs = _style_cache.get(key)\n499 |                 if style_kwargs is None:\n500 |                     style_kwargs = self._convert_to_style_kwargs(cell.style)\n501 |                     _style_cache[key] = style_kwargs\n502 | \n503 |             if style_kwargs:\n504 |                 for k, v in style_kwargs.items():\n505 |                     setattr(xcell, k, v)\n506 | \n507 |             if cell.mergestart is not None and cell.mergeend is not None:\n508 |                 wks.merge_cells(\n509 |                     start_row=startrow + cell.row + 1,\n510 |                     start_column=startcol + cell.col + 1,\n511 |                     end_column=startcol + cell.mergeend + 1,\n512 |                     end_row=startrow + cell.mergestart + 1,\n513 |                 )\n514 | \n515 |                 # When cells are merged only the top-left cell is preserved\n516 |                 # The behaviour of the other cells in a merged range is\n517 |                 # undefined\n518 |                 if style_kwargs:\n519 |                     first_row = startrow + cell.row + 1\n520 |                     last_row = startrow + cell.mergestart + 1\n521 |                     first_col = startcol + cell.col + 1\n522 |                     last_col = startcol + cell.mergeend + 1\n523 | \n524 |                     for row in range(first_row, last_row + 1):\n525 |                         for col in range(first_col, last_col + 1):\n526 |                             if row == first_row and col == first_col:\n527 |                                 # Ignore first cell. It is already handled.\n528 |                                 continue\n529 |                             xcell = wks.cell(column=col, row=row)\n530 |                             for k, v in style_kwargs.items():\n531 |                                 setattr(xcell, k, v)\n```\n"}, {"content": "From the `OpenpyxlWriter` class, we can see that it also handles cell merging in the `_write_cells` method, similar to the `XlsxWriter` class.\n\nNow, we need to document the `merge_cells=\"columns\"` feature in the docstring of the `to_excel` method in `pandas/core/generic.py`. We also need to check the `Styler.to_excel` method in `pandas/io/formats/style.py` to ensure it is documented correctly there as well.\n\nAdditionally, we should check the `ExcelFormatter` class in `pandas/io/formats/excel.py` for any documentation related to `merge_cells`.\n\nLet's gather the relevant parts of these files to ensure we document the new feature properly.\n\n<function=search_code_snippets>\n<parameter=search_terms>\n[\"merge_cells\", \"documentation\"]\n</parameter>\n<parameter=file_path_or_pattern>\npandas/core/generic.py\npandas/io/formats/style.py\npandas/io/formats/excel.py\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\npandas/io/formats/excel.py:ExcelFormatter.__init__\npandas/io/formats/style.py:Styler.to_excel\npandas/io/formats/excel.py:ExcelFormatter._format_hierarchical_rows\npandas/io/formats/excel.py:ExcelFormatter._format_header_mi\npandas/core/generic.py:NDFrame.to_excel\npandas/core/generic.py:NDFrame.to_json\npandas/io/formats/excel.py:ExcelFormatter\npandas/io/excel/_openpyxl.py:OpenpyxlWriter._write_cells\npandas/core/computation/pytables.py:TermValue\npandas/core/computation/pytables.py:TermValue.__init__\npandas/core/computation/pytables.py:TermValue.tostring\npandas/core/computation/pytables.py:maybe_expression\npandas/core/computation/pytables.py:_validate_where\npandas/core/computation/scope.py:Scope._get_vars\npandas/io/formats/xml.py:_BaseXMLFormatter\ndoc/make.py:DocBuilder.zip_html\ndoc/make.py:DocBuilder.latex_forced\ndoc/make.py:DocBuilder.clean\ndoc/make.py:DocBuilder.linkcheck\npandas/io/html.py:_HtmlFrameParser._parse_tables\npandas/io/xml.py:_LxmlFrameParser._transform_doc\npandas/io/xml.py:_LxmlFrameParser._parse_doc\ndoc/source/conf.py:impl:8\ndoc/source/conf.py:impl:51\ndoc/source/conf.py:impl:93\ndoc/source/conf.py:AccessorLevelDocumenter\npandas/io/xml.py:_EtreeFrameParser._parse_doc\ndoc/source/conf.py:impl:158\npandas/io/html.py:_BeautifulSoupHtml5LibFrameParser._parse_tables\npandas/io/html.py:_BeautifulSoupHtml5LibFrameParser\npandas/io/xml.py:_data_to_frame\npandas/io/formats/excel.py:ExcelFormatter.__init__\npandas/io/formats/style.py:Styler.to_excel\npandas/io/formats/excel.py:ExcelFormatter._format_hierarchical_rows\npandas/io/formats/excel.py:ExcelFormatter._format_header_mi\npandas/io/formats/xml.py:_BaseXMLFormatter\ndoc/make.py:DocBuilder.zip_html\ndoc/make.py:DocBuilder.latex_forced\ndoc/make.py:DocBuilder.clean\ndoc/make.py:DocBuilder.linkcheck\npandas/io/html.py:_HtmlFrameParser._parse_tables\npandas/io/xml.py:_LxmlFrameParser._transform_doc\npandas/io/xml.py:_LxmlFrameParser._parse_doc\ndoc/source/conf.py:impl:8\ndoc/source/conf.py:impl:51\ndoc/source/conf.py:impl:93\ndoc/source/conf.py:AccessorLevelDocumenter\nNo files found for file pattern 'pandas/core/generic.py\npandas/io/formats/style.py\npandas/io/formats/excel.py'. Will search all files.\n...\n##Searching for term \"merge_cells\"...\n### Search Result:\nFound function `pandas/core/generic.py:NDFrame.to_excel`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2150 | def to_excel(\n2151 |         self,\n2152 |         excel_writer: FilePath | WriteExcelBuffer | ExcelWriter,\n2153 |         *,\n2154 |         sheet_name: str = \"Sheet1\",\n2155 |         na_rep: str = \"\",\n2156 |         float_format: str | None = None,\n2157 |         columns: Sequence[Hashable] | None = None,\n2158 |         header: Sequence[Hashable] | bool = True,\n2159 |         index: bool = True,\n2160 |         index_label: IndexLabel | None = None,\n2161 |         startrow: int = 0,\n2162 |         startcol: int = 0,\n2163 |         engine: Literal[\"openpyxl\", \"xlsxwriter\"] | None = None,\n2164 |         merge_cells: bool = True,\n2165 |         inf_rep: str = \"inf\",\n2166 |         freeze_panes: tuple[int, int] | None = None,\n2167 |         storage_options: StorageOptions | None = None,\n2168 |         engine_kwargs: dict[str, Any] | None = None,\n2169 |     ) -> None:\n2170 |         \"\"\"\n2171 |         Write {klass} to an Excel sheet.\n2172 | \n2173 |         To write a single {klass} to an Excel .xlsx file it is only necessary to\n2174 |         specify a target file name. To write to multiple sheets it is necessary to\n2175 |         create an `ExcelWriter` object with a target file name, and specify a sheet\n2176 |         in the file to write to.\n2177 | \n2178 |         Multiple sheets may be written to by specifying unique `sheet_name`.\n2179 |         With all data written to the file it is necessary to save the changes.\n2180 |         Note that creating an `ExcelWriter` object with a file name that already\n2181 |         exists will result in the contents of the existing file being erased.\n2182 | \n2183 |         Parameters\n2184 |         ----------\n2185 |         excel_writer : path-like, file-like, or ExcelWriter object\n2186 |             File path or existing ExcelWriter.\n2187 |         sheet_name : str, default 'Sheet1'\n2188 |             Name of sheet which will contain DataFrame.\n2189 |         na_rep : str, default ''\n2190 |             Missing data representation.\n2191 |         float_format : str, optional\n2192 |             Format string for floating point numbers. For example\n2193 |             ``float_format=\"%.2f\"`` will format 0.1234 to 0.12.\n2194 |         columns : sequence or list of str, optional\n2195 |             Columns to write.\n2196 |         header : bool or list of str, default True\n2197 |             Write out the column names. If a list of string is given it is\n2198 |             assumed to be aliases for the column names.\n2199 |         index : bool, default True\n2200 |             Write row names (index).\n2201 |         index_label : str or sequence, optional\n2202 |             Column label for index column(s) if desired. If not specified, and\n2203 |             `header` and `index` are True, then the index names are used. A\n2204 |             sequence should be given if the DataFrame uses MultiIndex.\n2205 |         startrow : int, default 0\n2206 |             Upper left cell row to dump data frame.\n2207 |         startcol : int, default 0\n2208 |             Upper left cell column to dump data frame.\n2209 |         engine : str, optional\n2210 |             Write engine to use, 'openpyxl' or 'xlsxwriter'. You can also set this\n2211 |             via the options ``io.excel.xlsx.writer`` or\n2212 |             ``io.excel.xlsm.writer``.\n2213 | \n2214 |         merge_cells : bool, default True\n2215 |             Write MultiIndex and Hierarchical Rows as merged cells.\n2216 |         {encoding_parameter}\n2217 |         inf_rep : str, default 'inf'\n2218 |             Representation for infinity (there is no native representation for\n2219 |             infinity in Excel).\n2220 |         {verbose_parameter}\n2221 |         freeze_panes : tuple of int (length 2), optional\n2222 |             Specifies the one-based bottommost row and rightmost column that\n2223 |             is to be frozen.\n2224 |         {storage_options}\n2225 | \n2226 |             .. versionadded:: {storage_options_versionadded}\n2227 |         {extra_parameters}\n2228 |         See Also\n2229 |         --------\n2230 |         to_csv : Write DataFrame to a comma-separated values (csv) file.\n2231 |         ExcelWriter : Class for writing DataFrame objects into excel sheets.\n2232 |         read_excel : Read an Excel file into a pandas DataFrame.\n2233 |         read_csv : Read a comma-separated values (csv) file into DataFrame.\n2234 |         io.formats.style.Styler.to_excel : Add styles to Excel sheet.\n2235 | \n2236 |         Notes\n2237 |         -----\n2238 |         For compatibility with :meth:`~DataFrame.to_csv`,\n2239 |         to_excel serializes lists and dicts to strings before writing.\n2240 | \n2241 |         Once a workbook has been saved it is not possible to write further\n2242 |         data without rewriting the whole workbook.\n2243 | \n2244 |         pandas will check the number of rows, columns,\n2245 |         and cell character count does not exceed Excel's limitations.\n2246 |         All other limitations must be checked by the user.\n2247 | \n2248 |         Examples\n2249 |         --------\n2250 | \n2251 |         Create, write to and save a workbook:\n2252 | \n2253 |         >>> df1 = pd.DataFrame(\n2254 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2255 |         ...     index=[\"row 1\", \"row 2\"],\n2256 |         ...     columns=[\"col 1\", \"col 2\"],\n2257 |         ... )\n2258 |         >>> df1.to_excel(\"output.xlsx\")  # doctest: +SKIP\n2259 | \n2260 |         To specify the sheet name:\n2261 | \n2262 |         >>> df1.to_excel(\"output.xlsx\", sheet_name=\"Sheet_name_1\")  # doctest: +SKIP\n2263 | \n2264 |         If you wish to write to more than one sheet in the workbook, it is\n2265 |         necessary to specify an ExcelWriter object:\n2266 | \n2267 |         >>> df2 = df1.copy()\n2268 |         >>> with pd.ExcelWriter(\"output.xlsx\") as writer:  # doctest: +SKIP\n2269 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_1\")\n2270 |         ...     df2.to_excel(writer, sheet_name=\"Sheet_name_2\")\n2271 | \n2272 |         ExcelWriter can also be used to append to an existing Excel file:\n2273 | \n2274 |         >>> with pd.ExcelWriter(\"output.xlsx\", mode=\"a\") as writer:  # doctest: +SKIP\n2275 |         ...     df1.to_excel(writer, sheet_name=\"Sheet_name_3\")\n2276 | \n2277 |         To set the library that is used to write the Excel file,\n2278 |         you can pass the `engine` keyword (the default engine is\n2279 |         automatically chosen depending on the file extension):\n2280 | \n2281 |         >>> df1.to_excel(\"output1.xlsx\", engine=\"xlsxwriter\")  # doctest: +SKIP\n2282 |         \"\"\"\n2283 |         if engine_kwargs is None:\n2284 |             engine_kwargs = {}\n2285 | \n2286 |         df = self if isinstance(self, ABCDataFrame) else self.to_frame()\n2287 | \n2288 |         from pandas.io.formats.excel import ExcelFormatter\n2289 | \n2290 |         formatter = ExcelFormatter(\n2291 |             df,\n2292 |             na_rep=na_rep,\n2293 |             cols=columns,\n2294 |             header=header,\n2295 |             float_format=float_format,\n2296 |             index=index,\n2297 |             index_label=index_label,\n2298 |             merge_cells=merge_cells,\n2299 |             inf_rep=inf_rep,\n2300 |         )\n2301 |         formatter.write(\n2302 |             excel_writer,\n2303 |             sheet_name=sheet_name,\n2304 |             startrow=startrow,\n2305 |             startcol=startcol,\n2306 |             freeze_panes=freeze_panes,\n2307 |             engine=engine,\n2308 |             storage_options=storage_options,\n2309 |             engine_kwargs=engine_kwargs,\n2310 |         )\n```\n\nFound function `pandas/core/generic.py:NDFrame.to_json`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2317 | def to_json(\n2318 |         self,\n2319 |         path_or_buf: FilePath | WriteBuffer[bytes] | WriteBuffer[str] | None = None,\n2320 |         *,\n2321 |         orient: Literal[\"split\", \"records\", \"index\", \"table\", \"columns\", \"values\"]\n2322 |         | None = None,\n2323 |         date_format: str | None = None,\n2324 |         double_precision: int = 10,\n2325 |         force_ascii: bool = True,\n2326 |         date_unit: TimeUnit = \"ms\",\n2327 |         default_handler: Callable[[Any], JSONSerializable] | None = None,\n2328 |         lines: bool = False,\n2329 |         compression: CompressionOptions = \"infer\",\n2330 |         index: bool | None = None,\n2331 |         indent: int | None = None,\n2332 |         storage_options: StorageOptions | None = None,\n2333 |         mode: Literal[\"a\", \"w\"] = \"w\",\n2334 |     ) -> str | None:\n2335 |         \"\"\"\n2336 |         Convert the object to a JSON string.\n2337 | \n2338 |         Note NaN's and None will be converted to null and datetime objects\n2339 |         will be converted to UNIX timestamps.\n2340 | \n2341 |         Parameters\n2342 |         ----------\n2343 |         path_or_buf : str, path object, file-like object, or None, default None\n2344 |             String, path object (implementing os.PathLike[str]), or file-like\n2345 |             object implementing a write() function. If None, the result is\n2346 |             returned as a string.\n2347 |         orient : str\n2348 |             Indication of expected JSON string format.\n2349 | \n2350 |             * Series:\n2351 | \n2352 |                 - default is 'index'\n2353 |                 - allowed values are: {{'split', 'records', 'index', 'table'}}.\n2354 | \n2355 |             * DataFrame:\n2356 | \n2357 |                 - default is 'columns'\n2358 |                 - allowed values are: {{'split', 'records', 'index', 'columns',\n2359 |                   'values', 'table'}}.\n2360 | \n2361 |             * The format of the JSON string:\n2362 | \n2363 |                 - 'split' : dict like {{'index' -> [index], 'columns' -> [columns],\n2364 |                   'data' -> [values]}}\n2365 |                 - 'records' : list like [{{column -> value}}, ... , {{column -> value}}]\n2366 |                 - 'index' : dict like {{index -> {{column -> value}}}}\n2367 |                 - 'columns' : dict like {{column -> {{index -> value}}}}\n2368 |                 - 'values' : just the values array\n2369 |                 - 'table' : dict like {{'schema': {{schema}}, 'data': {{data}}}}\n2370 | \n2371 |                 Describing the data, where data component is like ``orient='records'``.\n2372 | \n2373 |         date_format : {{None, 'epoch', 'iso'}}\n2374 |             Type of date conversion. 'epoch' = epoch milliseconds,\n2375 |             'iso' = ISO8601. The default depends on the `orient`. For\n2376 |             ``orient='table'``, the default is 'iso'. For all other orients,\n2377 |             the default is 'epoch'.\n2378 | \n2379 |             .. deprecated:: 3.0.0\n2380 |                 'epoch' date format is deprecated and will be removed in a future\n2381 |                 version, please use 'iso' instead.\n2382 | \n2383 |         double_precision : int, default 10\n2384 |             The number of decimal places to use when encoding\n2385 |             floating point values. The possible maximal value is 15.\n2386 |             Passing double_precision greater than 15 will raise a ValueError.\n2387 |         force_ascii : bool, default True\n2388 |             Force encoded string to be ASCII.\n2389 |         date_unit : str, default 'ms' (milliseconds)\n2390 |             The time unit to encode to, governs timestamp and ISO8601\n2391 |             precision.  One of 's', 'ms', 'us', 'ns' for second, millisecond,\n2392 |             microsecond, and nanosecond respectively.\n2393 |         default_handler : callable, default None\n2394 |             Handler to call if object cannot otherwise be converted to a\n2395 |             suitable format for JSON. Should receive a single argument which is\n2396 |             the object to convert and return a serialisable object.\n2397 |         lines : bool, default False\n2398 |             If 'orient' is 'records' write out line-delimited json format. Will\n2399 |             throw ValueError if incorrect 'orient' since others are not\n2400 |             list-like.\n2401 |         {compression_options}\n2402 | \n2403 |             .. versionchanged:: 1.4.0 Zstandard support.\n2404 | \n2405 |         index : bool or None, default None\n2406 |             The index is only used when 'orient' is 'split', 'index', 'column',\n2407 |             or 'table'. Of these, 'index' and 'column' do not support\n2408 |             `index=False`. The string 'index' as a column name with empty :class:`Index`\n2409 |             or if it is 'index' will raise a ``ValueError``.\n2410 | \n2411 |         indent : int, optional\n2412 |            Length of whitespace used to indent each record.\n2413 | \n2414 |         {storage_options}\n2415 | \n2416 |         mode : str, default 'w' (writing)\n2417 |             Specify the IO mode for output when supplying a path_or_buf.\n2418 |             Accepted args are 'w' (writing) and 'a' (append) only.\n2419 |             mode='a' is only supported when lines is True and orient is 'records'.\n2420 | \n2421 |         Returns\n2422 |         -------\n2423 |         None or str\n2424 |             If path_or_buf is None, returns the resulting json format as a\n2425 |             string. Otherwise returns None.\n2426 | \n2427 |         See Also\n2428 |         --------\n2429 |         read_json : Convert a JSON string to pandas object.\n2430 | \n2431 |         Notes\n2432 |         -----\n2433 |         The behavior of ``indent=0`` varies from the stdlib, which does not\n2434 |         indent the output but does insert newlines. Currently, ``indent=0``\n2435 |         and the default ``indent=None`` are equivalent in pandas, though this\n2436 |         may change in a future release.\n2437 | \n2438 |         ``orient='table'`` contains a 'pandas_version' field under 'schema'.\n2439 |         This stores the version of `pandas` used in the latest revision of the\n2440 |         schema.\n2441 | \n2442 |         Examples\n2443 |         --------\n2444 |         >>> from json import loads, dumps\n2445 |         >>> df = pd.DataFrame(\n2446 |         ...     [[\"a\", \"b\"], [\"c\", \"d\"]],\n2447 |         ...     index=[\"row 1\", \"row 2\"],\n2448 |         ...     columns=[\"col 1\", \"col 2\"],\n2449 |         ... )\n2450 | \n2451 |         >>> result = df.to_json(orient=\"split\")\n2452 |         >>> parsed = loads(result)\n2453 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2454 |         {{\n2455 |             \"columns\": [\n2456 |                 \"col 1\",\n2457 |                 \"col 2\"\n2458 |             ],\n2459 |             \"index\": [\n2460 |                 \"row 1\",\n2461 |                 \"row 2\"\n2462 |             ],\n2463 |             \"data\": [\n2464 |                 [\n2465 |                     \"a\",\n2466 |                     \"b\"\n2467 |                 ],\n2468 |                 [\n2469 |                     \"c\",\n2470 |                     \"d\"\n2471 |                 ]\n2472 |             ]\n2473 |         }}\n2474 | \n2475 |         Encoding/decoding a Dataframe using ``'records'`` formatted JSON.\n2476 |         Note that index labels are not preserved with this encoding.\n2477 | \n2478 |         >>> result = df.to_json(orient=\"records\")\n2479 |         >>> parsed = loads(result)\n2480 |         >>> dumps(parsed, indent=4)  # doctest: +SKIP\n2481 |         [\n2482 |             {{\n2483 |                 \"col 1\": \"a\",\n2484 |                 \"col 2\": \"b\"\n2485 |             }},\n2486 |             {{\n2487 |                 \"col 1\": \"c\",\n2488 |                 \"col 2\": \"d\"\n2489 |             }}\n2490 |         ]\n2491 | \n2492 |         Encoding/decoding a Dataframe using ``'index'`` formatted JSON:\n2493 | \n2494 |         >>> result = df.to_json(orient=\"index\")\n2495 |         >>> parsed =