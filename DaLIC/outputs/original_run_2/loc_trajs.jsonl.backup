\n  43 |         The version when positional arguments will result in error.\n  44 |     \"\"\"\n  45 | \n  46 |     def _inner_deprecate_positional_args(f):\n  47 |         sig = signature(f)\n  48 |         kwonly_args = []\n  49 |         all_args = []\n  50 | \n  51 |         for name, param in sig.parameters.items():\n  52 |             if param.kind == Parameter.POSITIONAL_OR_KEYWORD:\n  53 |                 all_args.append(name)\n  54 |             elif param.kind == Parameter.KEYWORD_ONLY:\n  55 |                 kwonly_args.append(name)\n  56 | \n  57 |         @wraps(f)\n  58 |         def inner_f(*args, **kwargs):\n  59 |             extra_args = len(args) - len(all_args)\n  60 |             if extra_args <= 0:\n  61 |                 return f(*args, **kwargs)\n  62 | \n  63 |             # extra_args > 0\n  64 |             args_msg = [\n  65 |                 \"{}={}\".format(name, arg)\n  66 |                 for name, arg in zip(kwonly_args[:extra_args], args[-extra_args:])\n  67 |             ]\n  68 |             args_msg = \", \".join(args_msg)\n  69 |             warnings.warn(\n  70 |                 (\n  71 |                     f\"Pass {args_msg} as keyword args. From version \"\n  72 |                     f\"{version} passing these as positional arguments \"\n  73 |                     \"will result in an error\"\n  74 |                 ),\n  75 |                 FutureWarning,\n  76 |             )\n  77 |             kwargs.update(zip(sig.parameters, args))\n  78 |             return f(**kwargs)\n  79 | \n  80 |         return inner_f\n  81 | \n  82 |     if func is not None:\n  83 |         return _inner_deprecate_positional_args(func)\n  84 | \n  85 |     return _inner_deprecate_positional_args\n  86 | \n  87 | \n  88 | def _assert_all_finite(\n  89 |     X, allow_nan=False, msg_dtype=None, estimator_name=None, input_name=\"\"\n  90 | ):\n  91 |     \"\"\"Like assert_all_finite, but only for ndarray.\"\"\"\n  92 | \n  93 |     xp, is_array_api = get_namespace(X)\n  94 | \n  95 |     if _get_config()[\"assume_finite\"]:\n  96 |         return\n  97 | \n  98 |     X = xp.asarray(X)\n  99 | \n 100 |     # for object dtype data, we only check for NaNs (GH-13254)\n 101 |     if not is_array_api and X.dtype == np.dtype(\"object\") and not allow_nan:\n 102 |         if _object_dtype_isnan(X).any():\n 103 |             raise ValueError(\"Input contains NaN\")\n 104 | \n 105 |     # We need only consider float arrays, hence can early return for all else.\n 106 |     if not xp.isdtype(X.dtype, (\"real floating\", \"complex floating\")):\n 107 |         return\n 108 | \n 109 |     # First try an O(n) time, O(1) space solution for the common case that\n 110 |     # everything is finite; fall back to O(n) space `np.isinf/isnan` or custom\n 111 |     # Cython implementation to prevent false positives and provide a detailed\n 112 |     # error message.\n 113 |     with np.errstate(over=\"ignore\"):\n 114 |         first_pass_isfinite = xp.isfinite(xp.sum(X))\n 115 |     if first_pass_isfinite:\n 116 |         return\n 117 | \n 118 |     _assert_all_finite_element_wise(\n 119 |         X,\n 120 |         xp=xp,\n 121 |         allow_nan=allow_nan,\n 122 |         msg_dtype=msg_dtype,\n 123 |         estimator_name=estimator_name,\n 124 |         input_name=input_name,\n 125 |     )\n 126 | \n 127 | \n 128 | def _assert_all_finite_element_wise(\n 129 |     X, *, xp, allow_nan, msg_dtype=None, estimator_name=None, input_name=\"\"\n 130 | ):\n 131 |     # Cython implementation doesn't support FP16 or complex numbers\n 132 |     use_cython = (\n 133 |         xp is np and X.data.contiguous and X.dtype.type in {np.float32, np.float64}\n 134 |     )\n 135 |     if use_cython:\n 136 |         out = cy_isfinite(X.reshape(-1), allow_nan=allow_nan)\n 137 |         has_nan_error = False if allow_nan else out == FiniteStatus.has_nan\n 138 |         has_inf = out == FiniteStatus.has_infinite\n 139 |     else:\n 140 |         has