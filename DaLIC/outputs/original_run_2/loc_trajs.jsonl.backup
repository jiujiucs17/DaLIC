     Accessor object for datetimelike properties of the Series values.\n544 | \n545 |     Returns a Series indexed like the original Series.\n546 |     Raises TypeError if the Series does not contain datetimelike values.\n547 | \n548 |     Examples\n549 |     --------\n550 |     >>> seconds_series = pd.Series(\n551 |     ...     pd.period_range(\n552 |     ...         start=\"2000-01-01 00:00:00\", end=\"2000-01-01 00:00:03\", freq=\"s\"\n553 |     ...     )\n554 |     ... )\n555 |     >>> seconds_series\n556 |     0    2000-01-01 00:00:00\n557 |     1    2000-01-01 00:00:01\n558 |     2    2000-01-01 00:00:02\n559 |     3    2000-01-01 00:00:03\n560 |     dtype: period[s]\n561 |     >>> seconds_series.dt.second\n562 |     0    0\n563 |     1    1\n564 |     2    2\n565 |     3    3\n566 |     dtype: int64\n567 | \n568 |     >>> hours_series = pd.Series(\n569 |     ...     pd.period_range(start=\"2000-01-01 00:00\", end=\"2000-01-01 03:00\", freq=\"h\")\n570 |     ... )\n571 |     >>> hours_series\n572 |     0    2000-01-01 00:00\n573 |     1    2000-01-01 01:00\n574 |     2    2000-01-01 02:00\n575 |     3    2000-01-01 03:00\n576 |     dtype: period[h]\n577 |     >>> hours_series.dt.hour\n578 |     0    0\n579 |     1    1\n580 |     2    2\n581 |     3    3\n582 |     dtype: int64\n583 | \n584 |     >>> quarters_series = pd.Series(\n585 |     ...     pd.period_range(start=\"2000-01-01\", end=\"2000-12-31\", freq=\"Q-DEC\")\n586 |     ... )\n587 |     >>> quarters_series\n588 |     0    2000Q1\n589 |     1    2000Q2\n590 |     2    2000Q3\n591 |     3    2000Q4\n592 |     dtype: period[Q-DEC]\n593 |     >>> quarters_series.dt.quarter\n594 |     0    1\n595 |     1    2\n596 |     2    3\n597 |     3    4\n598 |     dtype: int64\n599 |     \"\"\"\n```\n\nFound class `pandas/core/indexes/accessors.py:CombinedDatetimelikeProperties`.\nSource: Retrieved code content using keyword search (bm25).\n```\n602 | class CombinedDatetimelikeProperties(\n603 |     DatetimeProperties, TimedeltaProperties, PeriodProperties\n604 | ):\n605 |     \"\"\"\n606 |     Accessor object for Series values' datetime-like, timedelta and period properties.\n607 | \n608 |     See Also\n609 |     --------\n610 |     DatetimeIndex : Index of datetime64 data.\n611 | \n612 |     Examples\n613 |     --------\n614 |     >>> dates = pd.Series(\n615 |     ...     [\"2024-01-01\", \"2024-01-15\", \"2024-02-5\"], dtype=\"datetime64[ns]\"\n616 |     ... )\n617 |     >>> dates.dt.day\n618 |     0     1\n619 |     1    15\n620 |     2     5\n621 |     dtype: int32\n622 |     >>> dates.dt.month\n623 |     0    1\n624 |     1    1\n625 |     2    2\n626 |     dtype: int32\n627 | \n628 |     >>> dates = pd.Series(\n629 |     ...     [\"2024-01-01\", \"2024-01-15\", \"2024-02-5\"], dtype=\"datetime64[ns, UTC]\"\n630 |     ... )\n631 |     >>> dates.dt.day\n632 |     0     1\n633 |     1    15\n634 |     2     5\n635 |     dtype: int32\n636 |     >>> dates.dt.month\n637 |     0    1\n638 |     1    1\n639 |     2    2\n640 |     dtype: int32\n641 |     \"\"\"\n642 | \n643 |     def __new__(cls, data: Series):  # pyright: ignore[reportInconsistentConstructor]\n644 |         # CombinedDatetimelikeProperties isn't really instantiated. Instead\n645 |         # we need to choose which parent (datetime or timedelta) is\n646 |         # appropriate. Since we're checking the dtypes anyway, we'll just\n647 |         # do all the validation here.\n648 | \n649 |         if not isinstance(data, ABCSeries):\n650 |             raise TypeError(\n651 |                 f\"cannot convert an object of type {type(data)} to a datetimelike index\"\n652 |             )\n653 | \n654 |         orig = data if isinstance(data.dtype, CategoricalDtype) else None\n655 |         if orig is not None:\n656 |             data = data._constructor(\n657 |                 orig.array,\n658 |                 name=orig.name,\n659 |                 copy=False,\n660 |                 dtype=orig._values.categories.