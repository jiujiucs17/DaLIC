4568 |             Note: The dict is modified by this function.\n4569 |         xsize : int\n4570 |             The size of the x and y arrays passed to `.Axes.scatter`.\n4571 |         get_next_color_func : callable\n4572 |             A callable that returns a color. This color is used as facecolor\n4573 |             if no other color is provided.\n4574 | \n4575 |             Note, that this is a function rather than a fixed color value to\n4576 |             support conditional evaluation of the next color.  As of the\n4577 |             current implementation obtaining the next color from the\n4578 |             property cycle advances the cycle. This must only happen if we\n4579 |             actually use the color, which will only be decided within this\n4580 |             method.\n4581 | \n4582 |         Returns\n4583 |         -------\n4584 |         c\n4585 |             The input *c* if it was not *None*, else a color derived from the\n4586 |             other inputs or defaults.\n4587 |         colors : array(N, 4) or None\n4588 |             The facecolors as RGBA values, or *None* if a colormap is used.\n4589 |         edgecolors\n4590 |             The edgecolor.\n4591 | \n4592 |         \"\"\"\n4593 |         facecolors = kwargs.pop('facecolors', None)\n4594 |         facecolors = kwargs.pop('facecolor', facecolors)\n4595 |         edgecolors = kwargs.pop('edgecolor', edgecolors)\n4596 | \n4597 |         kwcolor = kwargs.pop('color', None)\n4598 | \n4599 |         if kwcolor is not None and c is not None:\n4600 |             raise ValueError(\"Supply a 'c' argument or a 'color'\"\n4601 |                              \" kwarg but not both; they differ but\"\n4602 |                              \" their functionalities overlap.\")\n4603 | \n4604 |         if kwcolor is not None:\n4605 |             try:\n4606 |                 mcolors.to_rgba_array(kwcolor)\n4607 |             except ValueError as err:\n4608 |                 raise ValueError(\n4609 |                     \"'color' kwarg must be a color or sequence of color \"\n4610 |                     \"specs.  For a sequence of values to be color-mapped, use \"\n4611 |                     \"the 'c' argument instead.\") from err\n4612 |             if edgecolors is None:\n4613 |                 edgecolors = kwcolor\n4614 |             if facecolors is None:\n4615 |                 facecolors = kwcolor\n4616 | \n4617 |         if edgecolors is None and not mpl.rcParams['_internal.classic_mode']:\n4618 |             edgecolors = mpl.rcParams['scatter.edgecolors']\n4619 | \n4620 |         c_was_none = c is None\n4621 |         if c is None:\n4622 |             c = (facecolors if facecolors is not None\n4623 |                  else \"b\" if mpl.rcParams['_internal.classic_mode']\n4624 |                  else get_next_color_func())\n4625 |         c_is_string_or_strings = (\n4626 |             isinstance(c, str)\n4627 |             or (np.iterable(c) and len(c) > 0\n4628 |                 and isinstance(cbook._safe_first_finite(c), str)))\n4629 | \n4630 |         def invalid_shape_exception(csize, xsize):\n4631 |             return ValueError(\n4632 |                 f\"'c' argument has {csize} elements, which is inconsistent \"\n4633 |                 f\"with 'x' and 'y' with size {xsize}.\")\n4634 | \n4635 |         c_is_mapped = False  # Unless proven otherwise below.\n4636 |         valid_shape = True  # Unless proven otherwise below.\n4637 |         if not c_was_none and kwcolor is None and not c_is_string_or_strings:\n4638 |             try:  # First, does 'c' look suitable for value-mapping?\n4639 |                 c = np.asanyarray(c, dtype=float)\n4640 |             except ValueError:\n4641 |                 pass  # Failed to convert to float array; must be color specs.\n4642 |             else:\n4643 |                 # handle the documented special case of a 2D array with 1\n4644 |                 # row which as RGB(A) to broadcast.\n4645 |               