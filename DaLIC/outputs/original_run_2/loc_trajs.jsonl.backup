n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_randomized_svd.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting_higgsboson.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_isolation_forest.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting_threading.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_omp_lars.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_lasso.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_svd.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_polynomial_kernel_approximation.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_feature_expansions.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_sample_without_replacement.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_covertype.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_isotonic.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_parallel_pairwise.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_fastkmeans.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_nmf.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_ward.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_plot_lasso_path.py\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 benchmarks/bench_hist_gradient_boosting_categorical_only.py\n\u2502               \u251c\u2500\u2500 contains \