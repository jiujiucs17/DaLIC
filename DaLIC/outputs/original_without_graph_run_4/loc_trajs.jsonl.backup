                             facecolors=facecolors, shade=False)\n65 |         elif fixed_coord == 'z':\n66 |             X, Y = np.mgrid[0:nx // 2, 0:ny // 2]\n67 |             Z = nz // 2 * np.ones_like(X)\n68 |             X_offset = (i // 2) * nx // 2\n69 |             Y_offset = (i % 2) * ny // 2\n70 |             ax.plot_surface(X + X_offset, Y + Y_offset, Z, rstride=1, cstride=1,\n71 |                             facecolors=facecolors, shade=False)\n```\n\nFound function `lib/matplotlib/backends/backend_pdf.py:RendererPdf.draw_path_collection`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2030 | def draw_path_collection(self, gc, master_transform, paths, all_transforms,\n2031 |                              offsets, offset_trans, facecolors, edgecolors,\n2032 |                              linewidths, linestyles, antialiaseds, urls,\n2033 |                              offset_position):\n2034 |         # We can only reuse the objects if the presence of fill and\n2035 |         # stroke (and the amount of alpha for each) is the same for\n2036 |         # all of them\n2037 |         can_do_optimization = True\n2038 |         facecolors = np.asarray(facecolors)\n2039 |         edgecolors = np.asarray(edgecolors)\n2040 | \n2041 |         if not len(facecolors):\n2042 |             filled = False\n2043 |             can_do_optimization = not gc.get_hatch()\n2044 |         else:\n2045 |             if np.all(facecolors[:, 3] == facecolors[0, 3]):\n2046 |                 filled = facecolors[0, 3] != 0.0\n2047 |             else:\n2048 |                 can_do_optimization = False\n2049 | \n2050 |         if not len(edgecolors):\n2051 |             stroked = False\n2052 |         else:\n2053 |             if np.all(np.asarray(linewidths) == 0.0):\n2054 |                 stroked = False\n2055 |             elif np.all(edgecolors[:, 3] == edgecolors[0, 3]):\n2056 |                 stroked = edgecolors[0, 3] != 0.0\n2057 |             else:\n2058 |                 can_do_optimization = False\n2059 | \n2060 |         # Is the optimization worth it? Rough calculation:\n2061 |         # cost of emitting a path in-line is len_path * uses_per_path\n2062 |         # cost of XObject is len_path + 5 for the definition,\n2063 |         #    uses_per_path for the uses\n2064 |         len_path = len(paths[0].vertices) if len(paths) > 0 else 0\n2065 |         uses_per_path = self._iter_collection_uses_per_path(\n2066 |             paths, all_transforms, offsets, facecolors, edgecolors)\n2067 |         should_do_optimization = \\\n2068 |             len_path + uses_per_path + 5 < len_path * uses_per_path\n2069 | \n2070 |         if (not can_do_optimization) or (not should_do_optimization):\n2071 |             return RendererBase.draw_path_collection(\n2072 |                 self, gc, master_transform, paths, all_transforms,\n2073 |                 offsets, offset_trans, facecolors, edgecolors,\n2074 |                 linewidths, linestyles, antialiaseds, urls,\n2075 |                 offset_position)\n2076 | \n2077 |         padding = np.max(linewidths)\n2078 |         path_codes = []\n2079 |         for i, (path, transform) in enumerate(self._iter_collection_raw_paths(\n2080 |                 master_transform, paths, all_transforms)):\n2081 |             name = self.file.pathCollectionObject(\n2082 |                 gc, path, transform, padding, filled, stroked)\n2083 |             path_codes.append(name)\n2084 | \n2085 |         output = self.file.output\n2086 |         output(*self.gc.push())\n2087 |         lastx, lasty = 0, 0\n2088 |         for xo, yo, path_id, gc0, rgbFace in self._iter_collection(\n2089 |                 gc, path_codes, offsets, offset_trans,\n2090 |                 facecolors, edgecolors, linewidths, linestyles,\n2091 |                 antialiaseds, urls, offset_position):\n2092 | \n2093 |             self.check_gc(gc0, rgbFace)\n2094 |             dx, dy = xo - lastx, yo - lasty\n2095 |             output(1, 0, 0, 1, dx, dy, Op.concat_matrix, path_id,\n2096 |                    Op.use_xobject)\n2097 |             lastx, lasty = xo, yo\n2098 |         output(*self.gc.pop())\n```\n\nFound class `lib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow`.\nSource: Retrieved code content using keyword search (bm25).\n```\n161 | class FilledArrow(SimpleArrow):\n162 |         \"\"\"\n163 |         An arrow with a filled head.\n164 |         \"\"\"\n165 | \n166 |         ArrowAxisClass = _FancyAxislineStyle.FilledArrow\n167 | \n168 |         def __init__(self, size=1, facecolor=None):\n169 |             \"\"\"\n170 |             Parameters\n171 |             ----------\n172 |             size : float\n173 |                 Size of the arrow as a fraction of the ticklabel size.\n174 |             facecolor : :mpltype:`color`, default: :rc:`axes.edgecolor`\n175 |                 Fill color.\n176 | \n177 |                 .. versionadded:: 3.7\n178 |             \"\"\"\n179 | \n180 |             if facecolor is None:\n181 |                 facecolor = mpl.rcParams['axes.edgecolor']\n182 |             self.size = size\n183 |             self._facecolor = facecolor\n184 |             super().__init__(size=size)\n185 | \n186 |         def new_line(self, axis_artist, transform):\n187 |             linepath = Path([(0, 0), (0, 1)])\n188 |             axisline = self.ArrowAxisClass(axis_artist, linepath, transform,\n189 |                                            line_mutation_scale=self.size,\n190 |                                            facecolor=self._facecolor)\n191 |             return axisline\n```\n\n\n\n##Searching for term \"color precedence\"...\n### Search Result:\nFound code snippet in file `galleries/examples/lines_bars_and_markers/bar_colors.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ====================================\n 3 | Bar chart with individual bar colors\n 4 | ====================================\n 5 | \n 6 | This is an example showing how to control bar color and legend entries\n 7 | using the *color* and *label* parameters of `~matplotlib.pyplot.bar`.\n 8 | Note that labels with a preceding underscore won't show up in the legend.\n 9 | \"\"\"\n10 | \n11 | import matplotlib.pyplot as plt\n12 | \n13 | fig, ax = plt.subplots()\n14 | \n15 | fruits = ['apple', 'blueberry', 'cherry', 'orange']\n16 | counts = [40, 100, 30, 55]\n17 | bar_labels = ['red', 'blue', '_red', 'orange']\n18 | bar_colors = ['tab:red', 'tab:blue', 'tab:red', 'tab:orange']\n19 | \n20 | ax.bar(fruits, counts, label=bar_labels, color=bar_colors)\n21 | \n22 | ax.set_ylabel('fruit supply')\n23 | ax.set_title('Fruit supply by kind and color')\n24 | ax.legend(title='Fruit color')\n25 | \n26 | plt.show()\n27 | \n28 | # %%\n29 | # .. tags::\n30 | #\n31 | #    styling: color\n32 | #    plot-style: bar\n33 | #    level: beginner\n34 | \n```\n\nFound code snippet in file `galleries/examples/text_labels_and_annotations/rainbow_text.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==================================================\n 3 | Concatenate text objects with different properties\n 4 | ==================================================\n 5 | \n 6 | The example strings together several Text objects with different properties\n 7 | (e.g., color or font), positioning each one after the other.  The first Text\n 8 | is created directly using `~.Axes.text`; all subsequent ones are created with\n 9 | `~.Axes.annotate`, which allows positioning the Text's lower left corner at the\n10 | lower right corner (``xy=(1, 0)``) of the previous one (``xycoords=text``).\n11 | \"\"\"\n12 | \n13 | import matplotlib.pyplot as plt\n14 | \n15 | plt.rcParams[\"font.size\"] = 20\n16 | ax = plt.figure().add_subplot(xticks=[], yticks=[])\n17 | \n18 | # The first word, created with text().\n19 | text = ax.text(.1, .5, \"Matplotlib\", color=\"red\")\n20 | # Subsequent words, positioned with annotate(), relative to the preceding one.\n21 | text = ax.annotate(\n22 |     \" says,\", xycoords=text, xy=(1, 0), verticalalignment=\"bottom\",\n23 |     color=\"gold\", weight=\"bold\")  # custom properties\n24 | text = ax.annotate(\n25 |     \" hello\", xycoords=text, xy=(1, 0), verticalalignment=\"bottom\",\n26 |     color=\"green\", style=\"italic\")  # custom properties\n27 | text = ax.annotate(\n28 |     \" world!\", xycoords=text, xy=(1, 0), verticalalignment=\"bottom\",\n29 |     color=\"blue\", family=\"serif\")  # custom properties\n30 | \n31 | plt.show()\n32 | \n```\n\nFound class `lib/matplotlib/colorizer.py:Colorizer`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Colorizer:\n    def __init__(self, cmap=None, norm=None):\n...\n    def _scale_norm(self, norm, vmin, vmax, A):\n...\n    @property\n    def norm(self):\n...\n    @norm.setter\n    def norm(self, norm):\n...\n    def to_rgba(self, x, alpha=None, bytes=False, norm=True):\n...\n    @staticmethod\n    def _pass_image_data(x, alpha=None, bytes=False, norm=True):\n...\n    def autoscale(self, A):\n...\n    def autoscale_None(self, A):\n...\n    def _set_cmap(self, cmap):\n...\n    @property\n    def cmap(self):\n...\n    @cmap.setter\n    def cmap(self, cmap):\n...\n    def set_clim(self, vmin=None, vmax=None):\n...\n    def get_clim(self):\n...\n    def changed(self):\n...\n    @property\n    def vmin(self):\n...\n    @vmin.setter\n    def vmin(self, vmin):\n...\n    @property\n    def vmax(self):\n...\n    @vmax.setter\n    def vmax(self, vmax):\n...\n    @property\n    def clip(self):\n...\n    @clip.setter\n    def clip(self, clip):\n\n```\nHint: Search `lib/matplotlib/colorizer.py:Colorizer` to get the full content if needed.\n\nFound function `lib/matplotlib/colorizer.py:Colorizer._scale_norm`.\nSource: Retrieved code content using keyword search (bm25).\n```\n65 | def _scale_no