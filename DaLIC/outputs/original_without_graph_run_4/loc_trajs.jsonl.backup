nd really have\n2555 |         # left, bottom, width, height vectors\n2556 |         _api.check_in_list(['center', 'edge'], align=align)\n2557 |         if align == 'center':\n2558 |             if orientation == 'vertical':\n2559 |                 try:\n2560 |                     left = x - width / 2\n2561 |                 except TypeError as e:\n2562 |                     raise TypeError(f'the dtypes of parameters x ({x.dtype}) '\n2563 |                                     f'and width ({width.dtype}) '\n2564 |                                     f'are incompatible') from e\n2565 |                 bottom = y\n2566 |             else:  # horizontal\n2567 |                 try:\n2568 |                     bottom = y - height / 2\n2569 |                 except TypeError as e:\n2570 |                     raise TypeError(f'the dtypes of parameters y ({y.dtype}) '\n2571 |                                     f'and height ({height.dtype}) '\n2572 |                                     f'are incompatible') from e\n2573 |                 left = x\n2574 |         else:  # edge\n2575 |             left = x\n2576 |             bottom = y\n2577 | \n2578 |         patches = []\n2579 |         args = zip(left, bottom, width, height, color, edgecolor, linewidth,\n2580 |                    hatch, patch_labels)\n2581 |         for l, b, w, h, c, e, lw, htch, lbl in args:\n2582 |             r = mpatches.Rectangle(\n2583 |                 xy=(l, b), width=w, height=h,\n2584 |                 facecolor=c,\n2585 |                 edgecolor=e,\n2586 |                 linewidth=lw,\n2587 |                 label=lbl,\n2588 |                 hatch=htch,\n2589 |                 )\n2590 |             r._internal_update(kwargs)\n2591 |             r.get_path()._interpolation_steps = 100\n2592 |             if orientation == 'vertical':\n2593 |                 r.sticky_edges.y.append(b)\n2594 |             else:  # horizontal\n2595 |                 r.sticky_edges.x.append(l)\n2596 |           