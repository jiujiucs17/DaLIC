{"instance_id": "scikit-learn__scikit-learn-17443", "found_files": [["sklearn/calibration.py", "sklearn/metrics/_plot/det_curve.py", "examples/calibration/plot_calibration_multiclass.py", "sklearn/metrics/_plot/__init__.py"]], "found_modules": [["doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset", "sklearn/cluster/_birch.py:_CFSubcluster", "sklearn/metrics/_scorer.py:_ProbaScorer", "sklearn/externals/_packaging/version.py:Version", "sklearn/feature_selection/_from_model.py:SelectFromModel", "sklearn/utils/_mocking.py:NoSampleWeightWrapper", "sklearn/calibration.py:calibration_curve", "doc/tutorial/machine_learning_map/pyparsing.py:RecursiveGrammarException", "sklearn/neighbors/_classification.py:KNeighborsClassifier", "sklearn/utils/_mocking.py:CheckingClassifier", "sklearn/ensemble/_hist_gradient_boosting/loss.py:Poisson", "sklearn/mixture/_base.py:BaseMixture", "sklearn/metrics/_plot/det_curve.py:DetCurveDisplay", "benchmarks/bench_glmnet.py:rmse"]], "found_entities": [["doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.__getitem__", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.setOffset", "sklearn/cluster/_birch.py:_CFSubcluster.update", "sklearn/metrics/_scorer.py:_ProbaScorer._factory_args", "sklearn/externals/_packaging/version.py:Version.__repr__", "sklearn/feature_selection/_from_model.py:SelectFromModel._more_tags", "sklearn/utils/_mocking.py:NoSampleWeightWrapper.fit", "sklearn/utils/_mocking.py:NoSampleWeightWrapper.predict", "sklearn/utils/_mocking.py:NoSampleWeightWrapper.predict_proba", "sklearn/utils/_mocking.py:NoSampleWeightWrapper._more_tags", "sklearn/calibration.py:calibration_curve", "doc/tutorial/machine_learning_map/pyparsing.py:RecursiveGrammarException.__str__", "sklearn/neighbors/_classification.py:KNeighborsClassifier._more_tags", "doc/tutorial/machine_learning_map/pyparsing.py:_ParseResultsWithOffset.__repr__", "sklearn/utils/_mocking.py:CheckingClassifier._more_tags", "