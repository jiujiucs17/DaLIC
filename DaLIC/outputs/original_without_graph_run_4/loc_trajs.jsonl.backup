]\n235 |         + series.quantile(percentiles).tolist()\n236 |         + [series.max()]\n237 |     )\n238 |     # GH#48340 - always return float on non-complex numeric data\n239 |     dtype: DtypeObj | None\n240 |     if isinstance(series.dtype, ExtensionDtype):\n241 |         if isinstance(series.dtype, ArrowDtype):\n242 |             if series.dtype.kind == \"m\":\n243 |                 # GH53001: describe timedeltas with object dtype\n244 |                 dtype = None\n245 |             else:\n246 |                 import pyarrow as pa\n247 | \n248 |                 dtype = ArrowDtype(pa.float64())\n249 |         else:\n250 |             dtype = Float64Dtype()\n251 |     elif series.dtype.kind in \"iufb\":\n252 |         # i.e. numeric but exclude complex dtype\n253 |         dtype = np.dtype(\"float\")\n254 |     else:\n255 |         dtype = None\n256 |     return Series(d, index=stat_index, name=series.name, dtype=dtype)\n```\n\n\n\n##Searching for term \"Series.sqeeze\", \"DataFrame.sqeeze Series.sqeeze\"...\n### Search Result:\nFound class `pandas/core/series.py:Series`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Series(base.IndexOpsMixin, NDFrame):\n\n    _typ = \"series\"\n    _HANDLED_TYPES = (Index, ExtensionArray, np.ndarray)\n\n    _name: Hashable\n    _metadata: list[str] = [\"_name\"]\n    _internal_names_set = {\"index\", \"name\"} | NDFrame._internal_names_set\n    _accessors = {\"dt\", \"cat\", \"str\", \"sparse\"}\n    _hidden_attrs = (\n        base.IndexOpsMixin._hidden_attrs | NDFrame._hidden_attrs | frozenset([])\n    )\n\n    # similar to __array_priority__, positions Series after DataFrame\n    #  but before Index and ExtensionArray.  Should NOT be overridden by subclasses.\n    __pandas_priority__ = 3000\n\n    # Override cache_readonly bc Series is mutable\n    # error: Incompatible types in assignment (expression has type \"property\",\n  