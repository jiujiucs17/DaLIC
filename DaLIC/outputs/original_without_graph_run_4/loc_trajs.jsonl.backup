ert.\")\n1097 |         else:\n1098 |             tz = timezones.maybe_get_tz(tz)\n1099 |             # Convert to UTC\n1100 | \n1101 |             new_dates = tzconversion.tz_localize_to_utc(\n1102 |                 self.asi8,\n1103 |                 tz,\n1104 |                 ambiguous=ambiguous,\n1105 |                 nonexistent=nonexistent,\n1106 |                 creso=self._creso,\n1107 |             )\n1108 |         new_dates_dt64 = new_dates.view(f\"M8[{self.unit}]\")\n1109 |         dtype = tz_to_dtype(tz, unit=self.unit)\n1110 | \n1111 |         freq = None\n1112 |         if timezones.is_utc(tz) or (len(self) == 1 and not isna(new_dates_dt64[0])):\n1113 |             # we can preserve freq\n1114 |             # TODO: Also for fixed-offsets\n1115 |             freq = self.freq\n1116 |         elif tz is None and self.tz is None:\n1117 |             # no-op\n1118 |             freq = self.freq\n1119 |         return self._simple_new(new_dates_dt64, dtype=dtype, freq=freq)\n```\n\nFound function `pandas/core/tools/datetimes.py:_maybe_cache`.\nSource: Retrieved entity using keyword search (bm25).\n```\n212 | def _maybe_cache(\n213 |     arg: ArrayConvertible,\n214 |     format: str | None,\n215 |     cache: bool,\n216 |     convert_listlike: Callable,\n217 | ) -> Series:\n218 |     \"\"\"\n219 |     Create a cache of unique dates from an array of dates\n220 | \n221 |     Parameters\n222 |     ----------\n223 |     arg : listlike, tuple, 1-d array, Series\n224 |     format : string\n225 |         Strftime format to parse time\n226 |     cache : bool\n227 |         True attempts to create a cache of converted values\n228 |     convert_listlike : function\n229 |         Conversion function to apply on dates\n230 | \n231 |     Returns\n232 |     -------\n233 |     cache_array : Series\n234 |         Cache of converted, unique dates. Can be empty\n235 |     \"\"\"\n236 |     from pandas import Series\n237 | \n238 |     cache_array = Series(dtype=object)\n239 |