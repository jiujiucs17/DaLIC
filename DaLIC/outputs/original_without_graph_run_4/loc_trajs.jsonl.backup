data is not locally available\n113 |         instead of trying to download the data from the source site.\n114 | \n115 |     random_state : int or RandomState instance, default=None\n116 |         Determines random number generation for dataset shuffling. Pass an int\n117 |         for reproducible output across multiple function calls.\n118 |         See :term:`Glossary <random_state>`.\n119 | \n120 |     shuffle : bool, default=False\n121 |         Whether to shuffle dataset.\n122 | \n123 |     return_X_y : bool, default=False\n124 |         If True, returns ``(dataset.data, dataset.target)`` instead of a Bunch\n125 |         object. See below for more information about the `dataset.data` and\n126 |         `dataset.target` object.\n127 | \n128 |         .. versionadded:: 0.20\n129 | \n130 |     Returns\n131 |     -------\n132 |     dataset : :class:`~sklearn.utils.Bunch`\n133 |         Dictionary-like object, with the following attributes.\n134 | \n135 |         data : scipy csr array, dtype np.float64, shape (804414, 47236)\n136 |             The array has 0.16% of non zero values.\n137 |         target : scipy csr array, dtype np.uint8, shape (804414, 103)\n138 |             Each sample has a value of 1 in its categories, and 0 in others.\n139 |             The array has 3.15% of non zero values.\n140 |         sample_id : numpy array, dtype np.uint32, shape (804414,)\n141 |             Identification number of each sample, as ordered in dataset.data.\n142 |         target_names : numpy array, dtype object, length (103)\n143 |             Names of each target (RCV1 topics), as ordered in dataset.target.\n144 |         DESCR : string\n145 |             Description of the RCV1 dataset.\n146 | \n147 |     (data, target) : tuple if ``return_X_y`` is True\n148 | \n149 |         .. versionadded:: 0.20\n150 |     \"\"\"\n151 |     N_SAMPLES = 804414\n152 |     N_FEATURES = 47236\n153 |     N_CATEGORIES = 103\n154 |     N_TRAIN = 23149\n155 | \n156 |     data_home = get_data_home(data_home=data_home)\n157 |     rcv1_dir = join(data_home, \"RCV1\")\n158 |     if download_if_missing:\n159 |         if not exists(rcv1_dir):\n160 |             makedirs(rcv1_dir)\n161 | \n162 |     samples_path = _pkl_filepath(rcv1_dir, \"samples.pkl\")\n163 |     sample_id_path = _pkl_filepath(rcv1_dir, \"sample_id.pkl\")\n164 |     sample_topics_path = _pkl_filepath(rcv1_dir, \"sample_topics.pkl\")\n165 |     topics_path = _pkl_filepath(rcv1_dir, \"topics_names.pkl\")\n166 | \n167 |     # load data (X) and sample_id\n168 |     if download_if_missing and (not exists(samples_path) or\n169 |                                 not exists(sample_id_path)):\n170 |         files = []\n171 |         for each in XY_METADATA:\n172 |             logger.info(\"Downloading %s\" % each.url)\n173 |             file_path = _fetch_remote(each, dirname=rcv1_dir)\n174 |             files.append(GzipFile(filename=file_path))\n175 | \n176 |         Xy = load_svmlight_files(files, n_features=N_FEATURES)\n177 | \n178 |         # Training data is before testing data\n179 |         X = sp.vstack([Xy[8], Xy[0], Xy[2], Xy[4], Xy[6]]).tocsr()\n180 |         sample_id = np.hstack((Xy[9], Xy[1], Xy[3], Xy[5], Xy[7]))\n181 |         sample_id = sample_id.astype(np.uint32, copy=False)\n182 | \n183 |         joblib.dump(X, samples_path, compress=9)\n184 |         joblib.dump(sample_id, sample_id_path, compress=9)\n185 | \n186 |         # delete archives\n187 |         for f in files:\n188 |             f.close()\n189 |             remove(f.name)\n190 |     else:\n191 |         X = joblib.load(samples_path)\n192 |         sample_id = joblib.load(sample_id_path)\n193 | \n194 |     # load target (y), categories, and sample_id_bis\n195 |     if download_if_missing and (not exists(sample_topics_path) or\n196 |                                 not exists(topics_path)):\n197 |         logger.info(\"Downloading %s\" % TOPICS_METADATA.url)\n198 |         topics_archive_path = _fetch_remote(TOPICS_METADATA,\n199 |                                             dirname=rcv1_dir)\n200 | \n201 |         # parse the target file\n202 |         n_cat = -1\n203 |         n_doc = -1\n204 |         doc_previous = -1\n205 |         y = np.zeros((N_SAMPLES, N_CATEGORIES), dtype=np.uint8)\n206 |         sample_id_bis = np.zeros(N_SAMPLES, dtype=np.int32)\n207 |         category_names = {}\n208 |         with GzipFile(filename=topics_archive_path, mode='rb') as f:\n209 |             for line in f:\n210 |                 line_components = line.decode(\"ascii\").split(\" \")\n211 |                 if len(line_components) == 3:\n212 |                     cat, doc, _ = line_components\n213 |                     if cat not in category_names:\n214 |                         n_cat += 1\n215 |                         category_names[cat] = n_cat\n216 | \n217 |                     doc = int(doc)\n218 |                     if doc != doc_previous:\n219 |                         doc_previous = doc\n220 |                         n_doc += 1\n221 |                         sample_id_bis[n_doc] = doc\n222 |                     y[n_doc, category_names[cat]] = 1\n223 | \n224 |         # delete archive\n225 |         remove(topics_archive_path)\n226 | \n227 |         # Samples in X are ordered with sample_id,\n228 |         # whereas in y, they are ordered with sample_id_bis.\n229 |         permutation = _find_permutation(sample_id_bis, sample_id)\n230 |         y = y[permutation, :]\n231 | \n232 |         # save category names in a list, with same order than y\n233 |         categories = np.empty(N_CATEGORIES, dtype=object)\n234 |         for k in category_names.keys():\n235 |             categories[category_names[k]] = k\n236 | \n237 |         # reorder categories in lexicographic order\n238 |         order = np.argsort(categories)\n239 |         categories = categories[order]\n240 |         y = sp.csr_matrix(y[:, order])\n241 | \n242 |         joblib.dump(y, sample_topics_path, compress=9)\n243 |         joblib.dump(categories, topics_path, compress=9)\n244 |     else:\n245 |         y = joblib.load(sample_topics_path)\n246 |         categories = joblib.load(topics_path)\n247 | \n248 |     if subset == 'all':\n249 |         pass\n250 |     elif subset == 'train':\n251 |         X = X[:N_TRAIN, :]\n252 |         y = y[:N_TRAIN, :]\n253 |         sample_id = sample_id[:N_TRAIN]\n254 |     elif subset == 'test':\n255 |         X = X[N_TRAIN:, :]\n256 |         y = y[N_TRAIN:, :]\n257 |         sample_id = sample_id[N_TRAIN:]\n258 |     else:\n259 |         raise ValueError(\"Unknown subset parameter. Got '%s' instead of one\"\n260 |                          \" of ('all', 'train', test')\" % subset)\n261 | \n262 |     if shuffle:\n263 |         X, y, sample_id = shuffle_(X, y, sample_id, random_state=random_state)\n264 | \n265 |     module_path = dirname(__file__)\n266 |     with open(join(module_path, 'descr', 'rcv1.rst')) as rst_file:\n267 |         fdescr = rst_file.read()\n268 | \n269 |     if return_X_y:\n270 |         return X, y\n271 | \n272 |     return Bunch(data=X, target=y, sample_id=sample_id,\n273 |                  target_names=categories, DESCR=fdescr)\n```\n\nFound function `sklearn/utils/validation.py:_check_fit_params`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1344 | def _check_fit_params(X, fit_params, indices=None):\n1345 |     \"\"\"Check and validate the parameters passed during `fit`.\n1346 | \n1347 |     Parameters\n1348 |     ----------\n1349 |     X : array-like of shape (n_samples, n_features)\n1350 |         Data array.\n1351 | \n1352 |     fit_params : dict\n1353 |         Dictionary containing the parameters passed at fit.\n1354 | \n1355 |     indices : array-like of shape (n_samples,), default=None\n1356 |         Indices to be selected if the parameter has the same size as `X`.\n1357 | \n1358 |     Returns\n1359 |     -------\n1360 |     fit_params_validated : dict\n1361 |         Validated parameters. We ensure that the values support indexing.\n1362 |     \"\"\"\n1363 |     from . import _safe_indexing\n1364 |     fit_params_validated = {}\n1365 |     for param_key, param_value in fit_params.items():\n1366 |         if (not _is_arraylike(param_value) or\n1367 |                 _num_samples(param_value) != _num_samples(X)):\n1368 |             # Non-indexable pass-through (for now for backward-compatibility).\n1369 |             # https://github.com/scikit-learn/scikit-learn/issues/15805\n1370 |             fit_params_validated[param_key] = param_value\n1371 |         else:\n1372 |             # Any other fit_params should support indexing\n1373 |             # (e.g. for cross-validation).\n1374 |             fit_params_validated[param_key] = _make_indexable(param_value)\n1375 |             fit_params_validated[param_key] = _safe_indexing(\n1376 |                 fit_params_validated[param_key], indices\n1377 |             )\n1378 | \n1379 |     return fit_params_validated\n```\n\nFound file `benchmarks/bench_glm.py`.\nFound file `benchmarks/bench_mnist.py`.\nFound file `benchmarks/bench_glmnet.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n"}, {"content": "Let me search for more specific implementation details:\n\n<function=search_code_snippets>\n<parameter=search_terms>['_download_data_to_bunch', '_get_data_description_by_id', '_get_data_features', '_DATA_FILE']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nsklearn/datasets/_openml.py:fetch_openml\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/datasets/_openml.py:fetch_openml\nsklearn/datasets/_rcv1.py:_find_permutation\nsklearn/datasets/_rcv1.py:_inverse_permutation\nsklearn/datasets/_rcv1.py:fetch_rcv1\nsklearn/utils/validation.py:_check_fit_par