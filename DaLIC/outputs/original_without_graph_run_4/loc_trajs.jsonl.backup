Negative Rate\" + info_pos_label\n330 |         ax.set(xlabel=xlabel, ylabel=ylabel)\n331 | \n332 |         if \"label\" in line_kwargs:\n333 |             ax.legend(loc=\"lower right\")\n334 | \n335 |         ticks = [0.001, 0.01, 0.05, 0.20, 0.5, 0.80, 0.95, 0.99, 0.999]\n336 |         tick_locations = sp.stats.norm.ppf(ticks)\n337 |         tick_labels = [\n338 |             \"{:.0%}\".format(s) if (100 * s).is_integer() else \"{:.1%}\".format(s)\n339 |             for s in ticks\n340 |         ]\n341 |         ax.set_xticks(tick_locations)\n342 |         ax.set_xticklabels(tick_labels)\n343 |         ax.set_xlim(-3, 3)\n344 |         ax.set_yticks(tick_locations)\n345 |         ax.set_yticklabels(tick_labels)\n346 |         ax.set_ylim(-3, 3)\n347 | \n348 |         self.ax_ = ax\n349 |         self.figure_ = ax.figure\n350 |         return self\n```\n\nFound function `sklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay._plot_ice_lines`.\nSource: Retrieved code content using keyword search (bm25).\n```\n615 | def _plot_ice_lines(\n616 |         self,\n617 |         preds,\n618 |         feature_values,\n619 |         n_ice_to_plot,\n620 |         ax,\n621 |         pd_plot_idx,\n622 |         n_total_lines_by_plot,\n623 |         individual_line_kw,\n624 |     ):\n625 |         \"\"\"Plot the ICE lines.\n626 | \n627 |         Parameters\n628 |         ----------\n629 |         preds : ndarray of shape \\\n630 |                 (n_instances, n_grid_points)\n631 |             The predictions computed for all points of `feature_values` for a\n632 |             given feature for all samples in `X`.\n633 |         feature_values : ndarray of shape (n_grid_points,)\n634 |             The feature values for which the predictions have been computed.\n635 |         n_ice_to_plot : int\n636 |             The number of ICE lines to plot.\n637 |         ax : Matplotlib axes\n638 |             The axis on which to plot the ICE lines.\n639 |         pd_plot