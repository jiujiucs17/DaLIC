)\n  48 |         kwonly_args = []\n  49 |         all_args = []\n  50 | \n  51 |         for name, param in sig.parameters.items():\n  52 |             if param.kind == Parameter.POSITIONAL_OR_KEYWORD:\n  53 |                 all_args.append(name)\n  54 |             elif param.kind == Parameter.KEYWORD_ONLY:\n  55 |                 kwonly_args.append(name)\n  56 | \n  57 |         @wraps(f)\n  58 |         def inner_f(*args, **kwargs):\n  59 |             extra_args = len(args) - len(all_args)\n  60 |             if extra_args <= 0:\n  61 |                 return f(*args, **kwargs)\n  62 | \n  63 |             # extra_args > 0\n  64 |             args_msg = [\n  65 |                 \"{}={}\".format(name, arg)\n  66 |                 for name, arg in zip(kwonly_args[:extra_args], args[-extra_args:])\n  67 |             ]\n  68 |             args_msg = \", \".join(args_msg)\n  69 |             warnings.warn(\n  70 |                 (\n  71 |                     f\"Pass {args_msg} as keyword args. From version \"\n  72 |                     f\"{version} passing these as positional arguments \"\n  73 |                     \"will result in an error\"\n  74 |                 ),\n  75 |                 FutureWarning,\n  76 |             )\n  77 |             kwargs.update(zip(sig.parameters, args))\n  78 |             return f(**kwargs)\n  79 | \n  80 |         return inner_f\n  81 | \n  82 |     if func is not None:\n  83 |         return _inner_deprecate_positional_args(func)\n  84 | \n  85 |     return _inner_deprecate_positional_args\n```\n\nFound function `sklearn/mixture/_gaussian_mixture.py:_estimate_gaussian_parameters`.\nSource: Retrieved entity using keyword search (bm25).\n```\n258 | def _estimate_gaussian_parameters(X, resp, reg_covar, covariance_type):\n259 |     \"\"\"Estimate the Gaussian distribution parameters.\n260 | \n261 |     Parameters\n262 |     ----------\n263 |     X : array-like of shape (n_samples, n_features)\n264 |         The input data array.\n265 | \n266 |     resp : array-like of shape (n_samples, n_components)\n267 |         The responsibilities for each data sample in X.\n268 | \n269 |     reg_covar : float\n270 |         The regularization added to the diagonal of the covariance matrices.\n271 | \n272 |     covariance_type : {'full', 'tied', 'diag', 'spherical'}\n273 |         The type of precision matrices.\n274 | \n275 |     Returns\n276 |     -------\n277 |     nk : array-like of shape (n_components,)\n278 |         The numbers of data samples in the current components.\n279 | \n280 |     means : array-like of shape (n_components, n_features)\n281 |         The centers of the current components.\n282 | \n283 |     covariances : array-like\n284 |         The covariance matrix of the current components.\n285 |         The shape depends of the covariance_type.\n286 |     \"\"\"\n287 |     nk = resp.sum(axis=0) + 10 * np.finfo(resp.dtype).eps\n288 |     means = np.dot(resp.T, X) / nk[:, np.newaxis]\n289 |     covariances = {\n290 |         \"full\": _estimate_gaussian_covariances_full,\n291 |         \"tied\": _estimate_gaussian_covariances_tied,\n292 |         \"diag\": _estimate_gaussian_covariances_diag,\n293 |         \"spherical\": _estimate_gaussian_covariances_spherical,\n294 |     }[covariance_type](resp, X, nk, means, reg_covar)\n295 |     return nk, means, covariances\n```\n\nFound function `sklearn/cluster/_bicluster.py:SpectralCoclustering._check_parameters`.\nSource: Retrieved entity using keyword search (bm25).\n```\n341 | def _check_parameters(self, n_samples):\n342 |         if self.n_clusters > n_samples:\n343 |             raise ValueError(\n344 |                 f\"n_clusters should be <= n_samples={n_samples}. Got\"\n345 |                 f\" {self.n_clusters} instead.\"\n346 |             )\n```\n\nFound file `sklearn/metrics/cluster/__init__.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/metrics/cluster/__init__.py` for the full content if