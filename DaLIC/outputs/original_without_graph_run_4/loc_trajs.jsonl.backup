, left: float, right: float, align: str, color: str | list | tuple):\n4117 |         \"\"\"\n4118 |         Return the correct CSS for bar placement based on calculated values.\n4119 | \n4120 |         Parameters\n4121 |         ----------\n4122 |         x : float\n4123 |             Value which determines the bar placement.\n4124 |         left : float\n4125 |             Value marking the left side of calculation, usually minimum of data.\n4126 |         right : float\n4127 |             Value marking the right side of the calculation, usually maximum of data\n4128 |             (left < right).\n4129 |         align : {\"left\", \"right\", \"zero\", \"mid\"}\n4130 |             How the bars will be positioned.\n4131 |             \"left\", \"right\", \"zero\" can be used with any values for ``left``, ``right``.\n4132 |             \"mid\" can only be used where ``left <= 0`` and ``right >= 0``.\n4133 |             \"zero\" is used to specify a center when all values ``x``, ``left``,\n4134 |             ``right`` are translated, e.g. by say a mean or median.\n4135 | \n4136 |         Returns\n4137 |         -------\n4138 |         str : Resultant CSS with linear gradient.\n4139 | \n4140 |         Notes\n4141 |         -----\n4142 |         Uses ``colors``, ``width`` and ``height`` from outer scope.\n4143 |         \"\"\"\n4144 |         if pd.isna(x):\n4145 |             return base_css\n4146 | \n4147 |         if isinstance(color, (list, tuple)):\n4148 |             color = color[0] if x < 0 else color[1]\n4149 |         assert isinstance(color, str)  # mypy redefinition\n4150 | \n4151 |         x = left if x < left else x\n4152 |         x = right if x > right else x  # trim data if outside of the window\n4153 | \n4154 |         start: float = 0\n4155 |         end: float = 1\n4156 | \n4157 |         if align == \"left\":\n4158 |             # all proportions are measured from the left side between left and right\n4159 |             end = (x - left) / (right - left)\n4160 | \n4161 |         elif align == \"right\":\n4162 |             # all proportions are measured from the right side between left and right\n4163 |             start = (x - left) / (right - left)\n4164 | \n4165 |         else:\n4166 |             z_frac: float = 0.5  # location of zero based on the left-right range\n4167 |             if align == \"zero\":\n4168 |                 # all proportions are measured from the center at zero\n4169 |                 limit: float = max(abs(left), abs(right))\n4170 |                 left, right = -limit, limit\n4171 |             elif align == \"mid\":\n4172 |                 # bars drawn from zero either leftwards or rightwards with center at mid\n4173 |                 mid: float = (left + right) / 2\n4174 |                 z_frac = (\n4175 |                     -mid / (right - left) + 0.5 if mid < 0 else -left / (right - left)\n4176 |                 )\n4177 | \n4178 |             if x < 0:\n4179 |                 start, end = (x - left) / (right - left), z_frac\n4180 |             else:\n4181 |                 start, end = z_frac, (x - left) / (right - left)\n4182 | \n4183 |         ret = css_bar(start * width, end * width, color)\n4184 |         if height < 1 and \"background: linear-gradient(\" in ret:\n4185 |             return (\n4186 |                 ret + f\" no-repeat center; background-size: 100% {height * 100:.1f}%;\"\n4187 |             )\n4188 |         else:\n4189 |             return ret\n4190 | \n4191 |     values = data.to_numpy()\n4192 |     # A tricky way to address the issue where np.nanmin/np.nanmax fail to handle pd.NA.\n4193 |     left = np.nanmin(data.min(skipna=True)) if vmin is None else vmin\n4194 |     right = np.nanmax(data.max(skipna=True)) if vmax is None else vmax\n4195 |     z: float = 0  # adjustment to translate data\n4196 | \n4197 |     if align == \"mid\":\n4198 |         if left >= 0:  # \"mid\" is documented to act as \"left\" if all values positive\n4199 |             align, left = \"left\", 0 if vmin is None else vmin\n4200 |         elif right <= 0:  # \"mid\" is documented to act as \"right\" if all values negative\n4201 |             align, right = \"right\", 0 if vmax is None else vmax\n4202 |     elif align == \"mean\":\n4203 |         z, align = np.nanmean(values), \"zero\"\n4204 |     elif callable(align):\n4205 |         z, align = align(values), \"zero\"\n4206 |     elif isinstance(align, (float, int)):\n4207 |         z, align = float(align), \"zero\"\n4208 |     elif align not in (\"left\", \"right\", \"zero\"):\n4209 |         raise ValueError(\n4210 |             \"`align` should be in {'left', 'right', 'mid', 'mean', 'zero'} or be a \"\n4211 |             \"value defining the center line or a callable that returns a float\"\n4212 |         )\n4213 | \n4214 |     rgbas = None\n4215 |     if cmap is not None:\n4216 |         # use the matplotlib colormap input\n4217 |         _matplotlib = import_optional_dependency(\n4218 |             \"matplotlib\", extra=\"Styler.bar requires matplotlib.\"\n4219 |         )\n4220 |         cmap = (\n4221 |             _matplotlib.colormaps[cmap]\n4222 |             if isinstance(cmap, str)\n4223 |             else cmap  # assumed to be a Colormap instance as documented\n4224 |         )\n4225 |         norm = _matplotlib.colors.Normalize(left, right)\n4226 |         rgbas = cmap(norm(values))\n4227 |         if data.ndim == 1:\n4228 |             rgbas = [_matplotlib.colors.rgb2hex(rgba) for rgba in rgbas]\n4229 |         else:\n4230 |             rgbas = [\n4231 |                 [_matplotlib.colors.rgb2hex(rgba) for rgba in row] for row in rgbas\n4232 |             ]\n4233 | \n4234 |     assert isinstance(align, str)  # mypy: should now be in [left, right, mid, zero]\n4235 |     if data.ndim == 1:\n4236 |         return [\n4237 |             css_calc(\n4238 |                 x - z, left - z, right - z, align, colors if rgbas is None else rgbas[i]\n4239 |             )\n4240 |          