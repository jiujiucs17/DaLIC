faces, and generate a Poly3DCollection for each\n3539 |         # voxel\n3540 |         polygons = {}\n3541 |         for coord, faces_inds in voxel_faces.items():\n3542 |             # convert indices into 3D positions\n3543 |             if xyz is None:\n3544 |                 faces = faces_inds\n3545 |             else:\n3546 |                 faces = []\n3547 |                 for face_inds in faces_inds:\n3548 |                     ind = face_inds[:, 0], face_inds[:, 1], face_inds[:, 2]\n3549 |                     face = np.empty(face_inds.shape)\n3550 |                     face[:, 0] = x[ind]\n3551 |                     face[:, 1] = y[ind]\n3552 |                     face[:, 2] = z[ind]\n3553 |                     faces.append(face)\n3554 | \n3555 |             # shade the faces\n3556 |             facecolor = facecolors[coord]\n3557 |             edgecolor = edgecolors[coord]\n3558 | \n3559 |             poly = art3d.Poly3DCollection(\n3560 |                 faces, facecolors=facecolor, edgecolors=edgecolor,\n3561 |                 shade=shade, lightsource=lightsource, axlim_clip=axlim_clip,\n3562 |                 **kwargs)\n3563 |             self.add_collection3d(poly)\n3564 |             polygons[coord] = poly\n3565 | \n3566 |         return polygons\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Patch3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n728 | def get_facecolor(self):\n729 |         return self._maybe_depth_shade_and_sort_colors(super().get_facecolor())\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Path3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n914 | def get_facecolor(self):\n915 |         return self._maybe_depth_shade_and_sort_colors(super().get_facecolor())\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Poly3DCollection.set_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1197 | def set_facecolor(