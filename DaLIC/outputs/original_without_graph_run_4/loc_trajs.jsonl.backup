{"instance_id": "scikit-learn__scikit-learn-28678", "found_files": [["sklearn/utils/validation.py", "sklearn/utils/_pprint.py", "sklearn/utils/deprecation.py", "sklearn/utils/__init__.py", "doc/api_reference.py"]], "found_modules": [["benchmarks/bench_plot_incremental_pca.py:plot_results", "examples/linear_model/plot_sgd_loss_functions.py:modified_huber_loss", "benchmarks/bench_isotonic.py:generate_perturbed_logarithm_dataset", "sklearn/utils/_estimator_html_repr.py:_get_css_style", "asv_benchmarks/benchmarks/svm.py:SVCBenchmark", "benchmarks/bench_glmnet.py:rmse", "sklearn/feature_extraction/_dict_vectorizer.py:DictVectorizer", "sklearn/ensemble/_voting.py:VotingClassifier", "sklearn/preprocessing/_encoders.py:_BaseEncoder", "sklearn/feature_selection/_rfe.py:RFE", "sklearn/utils/validation.py:check_consistent_length", "sklearn/externals/_packaging/_structures.py:NegativeInfinityType", "examples/linear_model/plot_sgd_iris.py:plot_hyperplane", "examples/cluster/plot_adjusted_for_chance_measures.py:random_labels", "asv_benchmarks/benchmarks/utils.py:make_gen_classif_scorers", "asv_benchmarks/benchmarks/decomposition.py:PCABenchmark", "asv_benchmarks/benchmarks/model_selection.py:CrossValidationBenchmark", "doc/api_reference.py:_get_submodule"]], "found_entities": [["benchmarks/bench_plot_incremental_pca.py:plot_results", "examples/linear_model/plot_sgd_loss_functions.py:modified_huber_loss", "benchmarks/bench_isotonic.py:generate_perturbed_logarithm_dataset", "sklearn/utils/_estimator_html_repr.py:_get_css_style", "asv_benchmarks/benchmarks/svm.py:SVCBenchmark.make_scorers", "benchmarks/bench_glmnet.py:rmse", "sklearn/feature_extraction/_dict_vectorizer.py:DictVectorizer._more_tags", "sklearn/ensemble/_voting.py:VotingClassifier._collect_probas", "sklearn/preprocessing/_encoders.py:_BaseEncoder._more_tags", "sklearn/feature_selection/_rfe.py:RFE._get_support_mask", "sklearn/utils/validation.py:check_consistent_length", "sklearn/externals/_packaging/_structures.py:Neg