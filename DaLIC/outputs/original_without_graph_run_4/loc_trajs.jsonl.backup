/validation.py:_get_feature_names`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1595 | def _get_feature_names(X):\n1596 |     \"\"\"Get feature names from X.\n1597 | \n1598 |     Support for other array containers should place its implementation here.\n1599 | \n1600 |     Parameters\n1601 |     ----------\n1602 |     X : {ndarray, dataframe} of shape (n_samples, n_features)\n1603 |         Array container to extract feature names.\n1604 | \n1605 |         - pandas dataframe : The columns will be considered to be feature\n1606 |           names. If the dataframe contains non-string feature names, `None` is\n1607 |           returned.\n1608 |         - All other array containers will return `None`.\n1609 | \n1610 |     Returns\n1611 |     -------\n1612 |     names: ndarray or None\n1613 |         Feature names of `X`. Unrecognized array containers will return `None`.\n1614 |     \"\"\"\n1615 |     feature_names = None\n1616 | \n1617 |     # extract feature names for support array containers\n1618 |     if hasattr(X, \"columns\"):\n1619 |         feature_names = np.asarray(X.columns)\n1620 | \n1621 |     if feature_names is None or len(feature_names) == 0:\n1622 |         return\n1623 | \n1624 |     types = sorted(t.__qualname__ for t in set(type(v) for v in feature_names))\n1625 | \n1626 |     # Warn when types are mixed.\n1627 |     # ints and strings do not warn\n1628 |     if len(types) > 1 or not (types[0].startswith(\"int\") or types[0] == \"str\"):\n1629 |         # TODO: Convert to an error in 1.2\n1630 |         warnings.warn(\n1631 |             \"Feature names only support names that are all strings. \"\n1632 |             f\"Got feature names with dtypes: {types}. An error will be raised \"\n1633 |             \"in 1.2.\",\n1634 |             FutureWarning,\n1635 |         )\n1636 |         return\n1637 | \n1638 |     # Only feature names of all strings are supported\n1639 |     if types[0] == \"str\":\n1640 |         return feature_names\n```\n\nFound function `sklearn/datasets/_base.py:load_diabetes`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 911 | def load_diabetes(*, return_X_y=False, as_frame=False):\n 912 |     \"\"\"Load and return the diabetes dataset (regression).\n 913 | \n 914 |     ==============   ==================\n 915 |     Samples total    442\n 916 |     Dimensionality   10\n 917 |     Features         real, -.2 < x < .2\n 918 |     Targets          integer 25 - 346\n 919 |     ==============   ==================\n 920 | \n 921 |     .. note::\n 922 |        The meaning of each feature (i.e. `feature_names`) might be unclear\n 923 |        (especially for `ltg`) as the documentation of the original dataset is\n 924 |        not explicit. We provide information that seems correct in regard with\n 925 |        the scientific literature in this field of research.\n 926 | \n 927 |     Read more in the :ref:`User Guide <diabetes_dataset>`.\n 928 | \n 929 |     Parameters\n 930 |     ----------\n 931 |     return_X_y : bool, default=False.\n 932 |         If True, returns ``(data, target)`` instead of a Bunch object.\n 933 |         See below for more information about the `data` and `target` object.\n 934 | \n 935 |         .. versionadded:: 0.18\n 936 | \n 937 |     as_frame : bool, default=False\n 938 |         If True, the data is a pandas DataFrame including columns with\n 939 |         appropriate dtypes (numeric). The target is\n 940 |         a pandas DataFrame or Series depending on the number of target columns.\n 941 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n 942 |         DataFrames or Series as described below.\n 943 | \n 944 |         .. versionadded:: 0.23\n 945 | \n 946 |     Returns\n 947 |     -------\n 948 |     data : :class:`~sklearn.utils.Bunch`\n 949 |         Dictionary-like object, with the following attributes.\n 950 | \n 951 |         data : {ndarray, dataframe} of shape (442, 10)\n 952 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n 953 |             DataFrame.\n 954 |         target: {ndarray, Series} of shape (442,)\n 955 |             The regression target. If `as_frame=True`, `target` will be\n 956 |             a pandas Series.\n 957 |         feature_names: list\n 958 |             The names of the dataset columns.\n 959 |         frame: DataFrame of shape (442, 11)\n 960 |             Only present when `as_frame=True`. DataFrame with `data` and\n 961 |             `target`.\n 962 | \n 963 |             .. versionadded:: 0.23\n 964 |         DESCR: str\n 965 |             The full description of the dataset.\n 966 |         data_filename: str\n 967 |             The path to the location of the data.\n 968 |         target_filename: str\n 969 |             The path to the location of the target.\n 970 | \n 971 |     (data, target) : tuple if ``return_X_y`` is True\n 972 | \n 973 |         .. versionadded:: 0.18\n 974 |     \"\"\"\n 975 |     data_filename = \"diabetes_data.csv.gz\"\n 976 |     target_filename = \"diabetes_target.csv.gz\"\n 977 |     data = load_gzip_compressed_csv_data(data_filename)\n 978 |     target = load_gzip_compressed_csv_data(target_filename)\n 979 | \n 980 |     fdescr = load_descr(\"diabetes.rst\")\n 981 | \n 982 |     feature_names = [\"age\", \"sex\", \"bmi\", \"bp\", \"s1\", \"s2\", \"s3\", \"s4\", \"s5\", \"s6\"]\n 983 | \n 984 |     frame = None\n 985 |     target_columns = [\n 986 |         \"target\",\n 987 |     ]\n 988 |     if as_frame:\n 989 |         frame, data, target = _convert_data_dataframe(\n 990 |             \"load_diabetes\", data, target, feature_names, target_columns\n 991 |         )\n 992 | \n 993 |     if return_X_y:\n 994 |         return data, target\n 995 | \n 996 |     return Bunch(\n 997 |         data=data,\n 998 |         target=target,\n 999 |         frame=frame,\n1000 |         DESCR=fdescr,\n1001 |         feature_names=feature_names,\n1002 |         data_filename=data_filename,\n1003 |         target_filename=target_filename,\n1004 |         data_module=DATA_MODULE,\n1005 |     )\n```\n\nFound file `asv_benchmarks/benchmarks/utils.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `asv_benchmarks/benchmarks/utils.py` for the full content if needed.\n\n\n\n##Searching for term \"plotting\"...\n### Search Result:\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n 66 | mlp_disp = plot_partial_dependence(mlp, X, [\"age\", \"bmi\"], ax=ax,\n 67 |                                    line_kw={\"color\": \"red\"})\n 68 | \n 69 | # %%\n 70 | # Plotting partial dependence of the two models together\n 71 | # ======================================================\n 72 | #\n 73 | # The `tree_disp` and `mlp_disp`\n 74 | # :class:`~sklearn.inspection.PartialDependenceDisplay` objects contain all the\n 75 | # computed information needed to recreate the partial dependence curves. This\n 76 | # means we can easily create additional plots without needing to recompute the\n 77 | # curves.\n 78 | #\n 79 | # One way to plot the curves is to place them in the same figure, with the\n 80 | # curves of each model on each row. First, we create a figure with two axes\n 81 | # within two rows and one column. The two axes are passed to the\n 82 | # :func:`~sklearn.inspection.PartialDependenceDisplay.plot` functions of\n 83 | # `tree_disp` and `mlp_disp`. The given axes will be used by the plotting\n 84 | # function to draw the partial dependence. The resulting plot places the\n 85 | # decision tree partial dependence curves in the first row of the\n 86 | # multi-layer perceptron in the second row.\n 87 | \n 88 | fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 10))\n 89 | tree_disp.plot(ax=ax1)\n 90 | ax1.set_title(\"Decision Tree\")\n 91 | mlp_disp.plot(ax=ax2, line_kw={\"color\": \"red\"})\n 92 | ax2.set_title(\"Multi-layer Perceptron\")\n 93 | \n 94 | # %%\n 95 | # Another way to compare the curves is to plot them on top of each other. Here,\n 96 | # we create a figure with one row and two columns. The axes are passed into the\n 97 | # :func:`~sklearn.inspection.PartialDependenceDisplay.plot` function as a list,\n 98 | # which will plot the partial dependence curves of each model on the same axes.\n 99 | # The length of the axes list must be equal to the number of plots drawn.\n100 | \n101 | # sphinx_gallery_thumbnail_number = 4\n102 | fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 6))\n103 | tree_disp.plot(ax=[ax1, ax2], line_kw={\"label\": \"Decision Tree\"})\n104 | mlp_disp.plot(ax=[ax1, ax2], line_kw={\"label\": \"Multi-layer Perceptron\",\n105 |                                       \"color\": \"red\"})\n106 | ax1.legend()\n107 | ax2.legend()\n108 | \n109 | # %%\n110 | # `tree_disp.axes_` is a numpy array container the axes used to draw the\n111 | # partial dependence plots. This can be passed to `mlp_disp` to have the same\n112 | # affect of drawing the plots on top of each other. Furthermore, the\n113 | # `mlp_disp.figure_` stores the figure, which allows for resizing the figure\n114 | # after calling `plot`. In this case `tree_disp.axes_` has two dimensions, thus\n115 | # `plot` will only show the y label and y ticks on the left most plot.\n116 | \n117 | tree_disp.plot(line_kw={\"label\": \"Decision Tree\"})\n```\n\n\n\n##Searching for term \"plotting\", \"plot_utils plotting\"...\n### Search Result:\nFound function `benchmarks/bench_saga.py:plot`.\nSource: Retrieved entity using keyword search (bm25).\n```\n238 | def plot(outname=None):\n239 |     import pandas as pd\n240 | \n241 |     with open(\"bench_saga.json\", \"r\") as f:\n242 |         f = json.load(f)\n243 |     res = pd.DataFrame(f)\n244 |     res.set_index([\"single_target\"], inplace=True)\n245 | \n246 |     grouped = res.groupby(level=[\"single_target\"])\n247 | \n248 |     colors = {\"saga\": \"C0\", \"liblinear\": \"C1\", \"lightning\": \"C2\"}\n249 |     linestyles = {\"float32\": \"--\", \"float64\": \"-\"}\n250 |     alpha = {\"float64\": 0.5, \"float32\": 1}\n251 | \n252 |     for idx, group in grouped:\n253 |         single_target = idx\n254 |         fig, axes = plt.subplots(figsize=(12, 4), ncols=4)\n255 |         ax = axes[0]\n256 | \n257 |         for scores, times, solver, dtype in zip(\n258 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n259 |         ):\n260 |             ax.plot(\n261 |                 times,\n262 |                 scores,\n263 |                 label=\"%s - %s\" % (solver, dtype),\n264 |                 color=colors[solver],\n265 |                 alpha=alpha[dtype],\n266 |                 marker=\".\",\n267 |                 linestyle=linestyles[dtype],\n268 |             )\n269 |             ax.axvline(\n270 |                 times[-1],\n271 |                 color=colors[solver],\n272 |                 alpha=alpha[dtype],\n273 |                 linestyle=linestyles[dtype],\n274 |             )\n275 |         ax.set_xlabel(\"Time (s)\")\n276 |         ax.set_ylabel(\"Training objective (relative to min)\")\n277 |         ax.set_yscale(\"log\")\n278 | \n279 |         ax = axes[1]\n280 | \n281 |         for scores, times, solver, dtype in zip(\n282 |             group[\"test_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n283 |         ):\n284 |             ax.plot(\n285 |                 times,\n286 |                 scores,\n287 |                 label=solver,\n288 |                 color=colors[solver],\n289 |                 linestyle=linestyles[dtype],\n290 |                 marker=\".\",\n291 |                 alpha=alpha[dtype],\n292 |             )\n293 |             ax.axvline(\n294 |                 times[-1],\n295 |                 color=colors[solver],\n296 |                 alpha=alpha[dtype],\n297 |                 linestyle=linestyles[dtype],\n298 |             )\n299 | \n300 |         ax.set_xlabel(\"Time (s)\")\n301 |         ax.set_ylabel(\"Test objective (relative to min)\")\n302 |         ax.set_yscale(\"log\")\n303 | \n304 |         ax = axes[2]\n305 |         for accuracy, times, solver, dtype in zip(\n306 |             group[\"accuracies\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n307 |         ):\n308 |             ax.plot(\n309 |                 times,\n310 |                 accuracy,\n311 |                 label=\"%s - %s\" % (solver, dtype),\n312 |                 alpha=alpha[dtype],\n313 |                 marker=\".\",\n314 |                 color=colors[solver],\n315 |                 linestyle=linestyles[dtype],\n316 |             )\n317 |             ax.axvline(\n318 |                 times[-1],\n319 |                 color=colors[solver],\n320 |                 alpha=alpha[dtype],\n321 |                 linestyle=linestyles[dtype],\n322 |             )\n323 | \n324 |         ax.set_xlabel(\"Time (s)\")\n325 |         ax.set_ylabel(\"Test accuracy\")\n326 |         ax.legend()\n327 |         name = \"single_target\" if single_target else \"multi_target\"\n328 |         name += \"_%s\" % penalty\n329 |         plt.suptitle(name)\n330 |         if outname is None:\n331 |             outname = name + \".png\"\n332 |         fig.tight_layout()\n333 |         fig.subplots_adjust(top=0.9)\n334 | \n335 |         ax = axes[3]\n336 |         for scores, times, solver, dtype in zip(\n337 |             group[\"train_scores\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n338 |         ):\n339 |             ax.plot(\n340 |                 np.arange(len(scores)),\n341 |                 scores,\n342 |                 label=\"%s - %s\" % (solver, dtype),\n343 |                 marker=\".\",\n344 |                 alpha=alpha[dtype],\n345 |                 color=colors[solver],\n346 |                 linestyle=linestyles[dtype],\n347 |             )\n348 | \n349 |         ax.set_yscale(\"log\")\n350 |         ax.set_xlabel(\"# iterations\")\n351 |         ax.set_ylabel(\"Objective function\")\n352 |         ax.legend()\n353 | \n354 |         plt.savefig(outname)\n```\n\nFound function `sklearn/inspection/_plot/partial_dependence.py:PartialDependenceDisplay.plot`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 874 | def plot(\n 875 |         self,\n 876 |         *,\n 877 |         ax=None,\n 878 |         n_cols=3,\n 879 |         line_kw=None,\n 880 |         ice_lines_kw=None,\n 881 |         pd_line_kw=None,\n 882 |         contour_kw=None,\n 883 |     ):\n 884 |         \"\"\"Plot partial dependence plots.\n 885 | \n 886 |         Parameters\n 887 |         ----------\n 888 |         ax : Matplotlib axes or array-like of Matplotlib axes, default=None\n 889 |             - If a single axis is passed in, it is treated as a bounding axes\n 890 |                 and a grid of partial dependence plots will be drawn within\n 891 |                 these bounds. The `n_cols` parameter controls the number of\n 892 |                 columns in the grid.\n 893 |             - If an array-like of axes are passed in, the partial dependence\n 894 |                 plots will be drawn directly into these axes.\n 895 |             - If `None`, a figure and a bounding axes is created and treated\n 896 |                 as the single axes case.\n 897 | \n 898 |         n_cols : int, default=3\n 899 |             The maximum number of columns in the grid plot. Only active when\n 900 |             `ax` is a single axes or `None`.\n 901 | \n 902 |         line_kw : dict, default=None\n 903 |             Dict with keywords passed to the `matplotlib.pyplot.plot` call.\n 904 |             For one-way partial dependence plots.\n 905 | \n 906 |         ice_lines_kw : dict, default=None\n 907 |             Dictionary with keywords passed to the `matplotlib.pyplot.plot` call.\n 908 |             For ICE lines in the one-way partial dependence plots.\n 909 |             The key value pairs defined in `ice_lines_kw` takes priority over\n 910 |             `line_kw`.\n 911 | \n 912 |             .. versionadded:: 1.0\n 913 | \n 914 |         pd_line_kw : dict, default=None\n 915 |             Dictionary with keywords passed to the `matplotlib.pyplot.plot` call.\n 916 |             For partial dependence in one-way partial dependence plots.\n 917 |             The key value pairs defined in `pd_line_kw` takes priority over\n 918 |             `line_kw`.\n 919 | \n 920 |             .. versionadded:: 1.0\n 921 | \n 922 |         contour_kw : dict, default=None\n 923 |             Dict with keywords passed to the `matplotlib.pyplot.contourf`\n 924 |             call for two-way partial dependence plots.\n 925 | \n 926 |         Returns\n 927 |         -------\n 928 |         display : :class:`~sklearn.inspection.PartialDependenceDisplay`\n 929 |         \"\"\"\n 930 | \n 931 |         check_matplotlib_support(\"plot_partial_dependence\")\n 932 |         import matplotlib.pyplot as plt  # noqa\n 933 |         from matplotlib.gridspec import GridSpecFromSubplotSpec  # noqa\n 934 | \n 935 |         if line_kw is None:\n 936 |             line_kw = {}\n 937 |         if ice_lines_kw is None:\n 938 |             ice_lines_kw = {}\n 939 |         if pd_line_kw is None:\n 940 |             pd_line_kw = {}\n 941 |         if contour_kw is None:\n 942 |             contour_kw = {}\n 943 | \n 944 |         if ax is None:\n 945 |             _, ax = plt.subplots()\n 946 | \n 947 |         default_contour_kws = {\"alpha\": 0.75}\n 948 |         contour_kw = {**default_contour_kws, **contour_kw}\n 949 | \n 950 |         default_line_kws = {\n 951 |             \"color\": \"C0\",\n 952 |             \"label\": \"average\" if self.kind == \"both\" else None,\n 953 |         }\n 954 |         if self.kind in (\"individual\", \"both\"):\n 955 |             default_ice_lines_kws = {\"alpha\": 0.3, \"linewidth\": 0.5}\n 956 |         else:\n 957 |             default_ice_lines_kws = {}\n 958 | \n 959 |         ice_lines_kw 