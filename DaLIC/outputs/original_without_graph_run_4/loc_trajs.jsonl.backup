 True:\n548 |         return_type = _arff.COO\n549 |     else:\n550 |         return_type = _arff.DENSE_GEN\n551 | \n552 |     frame = nominal_attributes = None\n553 | \n554 |     parse_arff: Callable\n555 |     postprocess: Callable\n556 |     if as_frame:\n557 |         columns = data_columns + target_columns\n558 |         parse_arff = partial(_convert_arff_data_dataframe, columns=columns,\n559 |                              features_dict=features_dict)\n560 | \n561 |         def postprocess(frame):\n562 |             X = frame[data_columns]\n563 |             if len(target_columns) >= 2:\n564 |                 y = frame[target_columns]\n565 |             elif len(target_columns) == 1:\n566 |                 y = frame[target_columns[0]]\n567 |             else:\n568 |                 y = None\n569 |             return X, y, frame, nominal_attributes\n570 |     else:\n571 |         def parse_arff(arff):\n572 |             X, y = _convert_arff_data(arff, col_slice_x, col_slice_y, shape)\n573 |             # nominal attributes is a dict mapping from the attribute name to\n574 |             # the possible values. Includes also the target column (which will\n575 |             # be popped off below, before it will be packed in the Bunch\n576 |             # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunch(data=X, target=y, frame=frame,\n616 |                  categories=nominal_attributes,\n617 |                  feature_names=data_columns,\n618 |                  target_names=target_columns)\n```\n\n\n\n##Searching for term \"_get_data_description_by_id\"...\n### Search Result:\nFound function `sklearn/datasets/_openml.py:_get_data_description_by_id`.\nSource: Match found for entity name `_get_data_description_by_id`.\n```\n430 | def _get_data_description_by_id(\n431 |     data_id: int, data_home: Optional[str]\n432 | ) -> Dict[str, Any]:\n433 |     # OpenML API function: https://www.openml.org/api_docs#!/data/get_data_id\n434 |     url = _DATA_INFO.format(data_id)\n435 |     error_message = \"Dataset with data_id {} not found