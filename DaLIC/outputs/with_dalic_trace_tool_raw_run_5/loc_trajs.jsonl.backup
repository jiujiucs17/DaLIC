le_cache: dict[str, dict[str, Serialisable]] = {}\n455 | \n456 |         if sheet_name in self.sheets and self._if_sheet_exists != \"new\":\n457 |             if \"r+\" in self._mode:\n458 |                 if self._if_sheet_exists == \"replace\":\n459 |                     old_wks = self.sheets[sheet_name]\n460 |                     target_index = self.book.index(old_wks)\n461 |                     del self.book[sheet_name]\n462 |                     wks = self.book.create_sheet(sheet_name, target_index)\n463 |                 elif self._if_sheet_exists == \"error\":\n464 |                     raise ValueError(\n465 |                         f\"Sheet '{sheet_name}' already exists and \"\n466 |                         f\"if_sheet_exists is set to 'error'.\"\n467 |                     )\n468 |                 elif self._if_sheet_exists == \"overlay\":\n469 |                     wks = self.sheets[sheet_name]\n470 |                 else:\n471 |                     raise ValueError(\n472 |                         f\"'{self._if_sheet_exists}' is not valid for if_sheet_exists. \"\n473 |                         \"Valid options are 'error', 'new', 'replace' and 'overlay'.\"\n474 |                     )\n475 |             else:\n476 |                 wks = self.sheets[sheet_name]\n477 |         else:\n478 |             wks = self.book.create_sheet()\n479 |             wks.title = sheet_name\n480 | \n481 |         if validate_freeze_panes(freeze_panes):\n482 |             freeze_panes = cast(tuple[int, int], freeze_panes)\n483 |             wks.freeze_panes = wks.cell(\n484 |                 row=freeze_panes[0] + 1, column=freeze_panes[1] + 1\n485 |             )\n486 | \n487 |         for cell in cells:\n488 |             xcell = wks.cell(\n489 |                 row=startrow + cell.row + 1, column=startcol + cell.col + 1\n490 |             )\n491 |             xcell.value, fmt = self._value_with_fmt(cell.val)\n492 |             if fmt:\n493 |                 xcell.number_for