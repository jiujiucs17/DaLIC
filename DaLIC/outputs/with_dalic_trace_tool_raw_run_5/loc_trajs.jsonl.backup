, s)\n3405 |         >>> tf3 = TransferFunction(5, 1, s)\n3406 |         >>> tf4 = TransferFunction(s - 1, s, s)\n3407 |         >>> tf5 = TransferFunction(0, 1, s)\n3408 |         >>> sys1 = TransferFunctionMatrix([[tf1, tf2], [tf3, tf4]])\n3409 |         >>> sys2 = TransferFunctionMatrix([[tf3, tf5], [tf5, tf5]])\n3410 |         >>> F_1 = MIMOFeedback(sys1, sys2, 1)\n3411 |         >>> pprint(F_1, use_unicode=False)\n3412 |         /    [  s      1  ]    [5  0]   \\-1   [  s      1  ]\n3413 |         |    [-----    -  ]    [-  -]   |     [-----    -  ]\n3414 |         |    [1 - s    s  ]    [1  1]   |     [1 - s    s  ]\n3415 |         |I - [            ]   *[    ]   |   * [            ]\n3416 |         |    [  5    s - 1]    [0  0]   |     [  5    s - 1]\n3417 |         |    [  -    -----]    [-  -]   |     [  -    -----]\n3418 |         \\    [  1      s  ]{t} [1  1]{t}/     [  1      s  ]{t}\n3419 |         >>> pprint(F_1.doit(), use_unicode=False)\n3420 |         [  -s           s - 1       ]\n3421 |         [-------     -----------    ]\n3422 |         [6*s - 1     s*(6*s - 1)    ]\n3423 |         [                           ]\n3424 |         [5*s - 5  (s - 1)*(6*s + 24)]\n3425 |         [-------  ------------------]\n3426 |         [6*s - 1     s*(6*s - 1)    ]{t}\n3427 | \n3428 |         If the user wants the resultant ``TransferFunctionMatrix`` object without\n3429 |         canceling the common factors then the ``cancel`` kwarg should be passed ``False``.\n3430 | \n3431 |         >>> pprint(F_1.doit(cancel=False), use_unicode=False)\n3432 |         [             s*(s - 1)                              s - 1               ]\n3433 |         [         -----------------                       -----------            ]\n3434 |         [         (1 - s)*(6*s - 1)                       s*(6*s - 1)            ]\n3435 |         [                                                                        ]\n3436 |         [s*(25*s - 25) + 5*(1 - s)*(6*s - 1)  s*(s - 1)*(6