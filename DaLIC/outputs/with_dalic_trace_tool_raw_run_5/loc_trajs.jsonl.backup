 == \"==\" and invert):\n336 |             return lambda axis, vals: ~axis.isin(vals)\n337 |         else:\n338 |             return lambda axis, vals: axis.isin(vals)\n339 | \n340 | \n341 | class JointFilterBinOp(FilterBinOp):\n342 |     def format(self):\n343 |         raise NotImplementedError(\"unable to collapse Joint Filters\")\n344 | \n345 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n346 |     def evaluate(self) -> Self:  # type: ignore[override]\n347 |         return self\n348 | \n349 | \n350 | class ConditionBinOp(BinOp):\n351 |     def __repr__(self) -> str:\n352 |         return pprint_thing(f\"[Condition : [{self.condition}]]\")\n353 | \n354 |     def invert(self):\n355 |         \"\"\"invert the condition\"\"\"\n356 |         # if self.condition is not None:\n357 |         #    self.condition = \"~(%s)\" % self.condition\n358 |         # return self\n359 |         raise NotImplementedError(\n360 |             \"cannot use an invert condition when passing to numexpr\"\n361 |         )\n362 | \n363 |     def format(self):\n364 |         \"\"\"return the actual ne format\"\"\"\n365 |         return self.condition\n366 | \n367 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n368 |     def evaluate(self) -> Self | None:  # type: ignore[override]\n369 |         if not self.is_valid:\n370 |             raise ValueError(f\"query term is not valid [{self}]\")\n371 | \n372 |         # convert values if we are in the table\n373 |         if not self.is_in_table:\n374 |             return None\n375 | \n376 |         rhs = self.conform(self.rhs)\n377 |         values = [self.convert_value(v) for v in rhs]\n378 | \n379 |         # equality conditions\n380 |         if self.op in [\"==\", \"!=\"]:\n381 |             # too many values to create the expression?\n382 |             if len(values) <= self._max_selectors:\n383 |                 vs = [self.generate(v) for v in values]\n384 |                 se