e mrv set\n650 |     for g, _ in Omega:\n651 |         sig = sign(g.exp, x)\n652 |         if sig != 1 and sig != -1 and not sig.has(AccumBounds):\n653 |             raise NotImplementedError('Result depends on the sign of %s' % sig)\n654 |     if sig == 1:\n655 |         wsym = 1/wsym  # if g goes to oo, substitute 1/w\n656 |     # O2 is a list, which results by rewriting each item in Omega using \"w\"\n657 |     O2 = []\n658 |     denominators = []\n659 |     for f, var in Omega:\n660 |         c = limitinf(f.exp/g.exp, x)\n661 |         if c.is_Rational:\n662 |             denominators.append(c.q)\n663 |         arg = f.exp\n664 |         if var in rewrites:\n665 |             if not isinstance(rewrites[var], exp):\n666 |                 raise ValueError(\"Value should be exp\")\n667 |             arg = rewrites[var].args[0]\n668 |         O2.append((var, exp((arg - c*g.exp))*wsym**c))\n669 | \n670 |     # Remember that Omega contains subexpressions of \"e\". So now we find\n671 |     # them in \"e\" and substitute them for our rewriting, stored in O2\n672 | \n673 |     # the following powsimp is necessary to automatically combine exponentials,\n674 |     # so that the .xreplace() below succeeds:\n675 |     # TODO this should not be necessary\n676 |     from sympy.simplify.powsimp import powsimp\n677 |     f = powsimp(e, deep=True, combine='exp')\n678 |     for a, b in O2:\n679 |         f = f.xreplace({a: b})\n680 | \n681 |     for _, var in Omega:\n682 |         assert not f.has(var)\n683 | \n684 |     # finally compute the logarithm of w (logw).\n685 |     logw = g.exp\n686 |     if sig == 1:\n687 |         logw = -logw  # log(w)->log(1/w)=-log(w)\n688 | \n689 |     # Some parts of SymPy have difficulty computing series expansions with\n690 |     # non-integral exponents. The following heuristic improves the situation:\n691 |     exponent = reduce(ilcm, denominators, 1)\n692 |     f = f.subs({wsym: wsym**exponent})\n693 |     logw /= exponent\n694 | \n695 |   