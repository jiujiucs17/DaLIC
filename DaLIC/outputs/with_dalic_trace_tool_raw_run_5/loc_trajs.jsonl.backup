\n 951 |             \"color\": \"C0\",\n 952 |             \"label\": \"average\" if self.kind == \"both\" else None,\n 953 |         }\n 954 |         if self.kind in (\"individual\", \"both\"):\n 955 |             default_ice_lines_kws = {\"alpha\": 0.3, \"linewidth\": 0.5}\n 956 |         else:\n 957 |             default_ice_lines_kws = {}\n 958 | \n 959 |         ice_lines_kw = {\n 960 |             **default_line_kws,\n 961 |             **line_kw,\n 962 |             **default_ice_lines_kws,\n 963 |             **ice_lines_kw,\n 964 |         }\n 965 |         del ice_lines_kw[\"label\"]\n 966 | \n 967 |         pd_line_kw = {**default_line_kws, **line_kw, **pd_line_kw}\n 968 | \n 969 |         n_features = len(self.features)\n 970 |         if self.kind in (\"individual\", \"both\"):\n 971 |             n_ice_lines = self._get_sample_count(len(self.pd_results[0].individual[0]))\n 972 |             if self.kind == \"individual\":\n 973 |                 n_lines = n_ice_lines\n 974 |             else:\n 975 |                 n_lines = n_ice_lines + 1\n 976 |         else:\n 977 |             n_ice_lines = 0\n 978 |             n_lines = 1\n 979 | \n 980 |         if isinstance(ax, plt.Axes):\n 981 |             # If ax was set off, it has most likely been set to off\n 982 |             # by a previous call to plot.\n 983 |             if not ax.axison:\n 984 |                 raise ValueError(\n 985 |                     \"The ax was already used in another plot \"\n 986 |                     \"function, please set ax=display.axes_ \"\n 987 |                     \"instead\"\n 988 |                 )\n 989 | \n 990 |             ax.set_axis_off()\n 991 |             self.bounding_ax_ = ax\n 992 |             self.figure_ = ax.figure\n 993 | \n 994 |             n_cols = min(n_cols, n_features)\n 995 |             n_rows = int(np.ceil(n_features / float(n_cols)))\n 996 | \n 997 |             self.axes_ = np.empty((n_rows, n_cols), dtype=object)\n 998 |         