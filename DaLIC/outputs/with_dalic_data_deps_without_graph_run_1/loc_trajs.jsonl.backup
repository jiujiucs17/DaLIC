ndex_labels) and self.header is not False:\n810 |                 for cidx, name in enumerate(index_labels):\n811 |                     yield ExcelCell(self.rowcounter - 1, cidx, name, None)\n812 | \n813 |             if self.merge_cells and self.merge_cells != \"columns\":\n814 |                 # Format hierarchical rows as merged cells.\n815 |                 level_strs = self.df.index._format_multi(\n816 |                     sparsify=True, include_names=False\n817 |                 )\n818 |                 level_lengths = get_level_lengths(level_strs)\n819 | \n820 |                 for spans, levels, level_codes in zip(\n821 |                     level_lengths, self.df.index.levels, self.df.index.codes\n822 |                 ):\n823 |                     values = levels.take(\n824 |                         level_codes,\n825 |                         allow_fill=levels._can_hold_na,\n826 |                         fill_value=levels._na_value,\n827 |                     )\n828 | \n829 |                     for i, span_val in spans.items():\n830 |                         mergestart, mergeend = None, None\n831 |                         if span_val > 1:\n832 |                             mergestart = self.rowcounter + i + span_val - 1\n833 |                             mergeend = gcolidx\n834 |                         yield CssExcelCell(\n835 |                             row=self.rowcounter + i,\n836 |                             col=gcolidx,\n837 |                             val=values[i],\n838 |                             style=None,\n839 |                             css_styles=getattr(self.styler, \"ctx_index\", None),\n840 |                             css_row=i,\n841 |                             css_col=gcolidx,\n842 |                             css_converter=self.style_converter,\n843 |                             mergestart=mergestart,\n844 |                             mergeend=mergeend,\n845 |                         )\n846 |                     gcolidx