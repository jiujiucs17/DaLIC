n774 |         limit_direction: Literal[\"forward\", \"backward\", \"both\"] = \"forward\",\n775 |         limit_area=None,\n776 |         downcast=lib.no_default,\n777 |         **kwargs,\n778 |     ):\n779 |         \"\"\"\n780 |         Interpolate values between target timestamps according to different methods.\n781 | \n782 |         The original index is first reindexed to target timestamps\n783 |         (see :meth:`core.resample.Resampler.asfreq`),\n784 |         then the interpolation of ``NaN`` values via :meth:`DataFrame.interpolate`\n785 |         happens.\n786 | \n787 |         Parameters\n788 |         ----------\n789 |         method : str, default 'linear'\n790 |             Interpolation technique to use. One of:\n791 | \n792 |             * 'linear': Ignore the index and treat the values as equally\n793 |               spaced. This is the only method supported on MultiIndexes.\n794 |             * 'time': Works on daily and higher resolution data to interpolate\n795 |               given length of interval.\n796 |             * 'index', 'values': use the actual numerical values of the index.\n797 |             * 'pad': Fill in NaNs using existing values.\n798 |             * 'nearest', 'zero', 'slinear', 'quadratic', 'cubic',\n799 |               'barycentric', 'polynomial': Passed to\n800 |               `scipy.interpolate.interp1d`, whereas 'spline' is passed to\n801 |               `scipy.interpolate.UnivariateSpline`. These methods use the numerical\n802 |               values of the index.  Both 'polynomial' and 'spline' require that\n803 |               you also specify an `order` (int), e.g.\n804 |               ``df.interpolate(method='polynomial', order=5)``. Note that,\n805 |               `slinear` method in Pandas refers to the Scipy first order `spline`\n806 |               instead of Pandas first order `spline`.\n807 |             * 'krogh', 'piecewise_polynomial', 'spline', 'pchip', 'akima',\n808 |               'cubicspline': Wrappers around the SciPy interpolation methods of\n809 |               similar names. See `Notes`.\n810 |             * 'from_derivatives': Refers to\n811 |               `scipy.interpolate.BPoly.from_derivatives`.\n812 | \n813 |         axis : {{0 or 'index', 1 or 'columns', None}}, default None\n814 |             Axis to interpolate along. For `Series` this parameter is unused\n815 |             and defaults to 0.\n816 |         limit : int, optional\n817 |             Maximum number of consecutive NaNs to fill. Must be greater than\n818 |             0.\n819 |         inplace : bool, default False\n820 |             Update the data in place if possible.\n821 |         limit_direction : {{'forward', 'backward', 'both'}}, Optional\n822 |             Consecutive NaNs will be filled in this direction.\n823 | \n824 |         limit_area : {{`None`, 'inside', 'outside'}}, default None\n825 |             If limit is specified, consecutive NaNs will be filled with this\n826 |             restriction.\n827 | \n828 |             * ``None``: No fill restriction.\n829 |             * 'inside': Only fill NaNs surrounded by valid values\n830 |               (interpolate).\n831 |             * 'outside': Only fill NaNs outside valid values (extrapolate).\n832 | \n833 |         downcast : optional, 'infer' or None, defaults to None\n834 |             Downcast dtypes if possible.\n835 | \n836 |             .. deprecated:: 2.1.0\n837 | \n838 |         **kwargs : optional\n839 |             Keyword arguments to pass on to the interpolating function.\n840 | \n841 |         Returns\n842 |         -------\n843 |         DataFrame or Series\n844 |             Interpolated values at the specified freq.\n845 | \n846 |         See Also\n847 |         --------\n848 |         core.resample.Resampler.asfreq: Return the values at the new freq,\n849 |             essentially a reindex.\n850 |         DataFrame.interpolate: Fill NaN values using an interpolation method.\n851 |         DataFrame.bfill : Backward fill NaN values in the resampled data.\n852 |         DataFrame.ffill : Forward fill NaN values.\n853 | \n854 |         Notes\n855 |         -----\n856 |         For high-frequent or non-equidistant time-series with timestamps\n857 |         the reindexing followed by interpolation may lead to information loss\n858 |         as shown in the last example.\n859 | \n860 |         Examples\n861 |         --------\n862 | \n863 |         >>> start = \"2023-03-01T07:00:00\"\n864 |         >>> timesteps = pd.date_range(start, periods=5, freq=\"s\")\n865 |         >>> series = pd.Series(data=[1, -1, 2, 1, 3], index=timesteps)\n866 |         >>> series\n867 |         2023-03-01 07:00:00    1\n868 |         2023-03-01 07:00:01   -1\n869 |         2023-03-01 07:00:02    2\n870 |         2023-03-01 07:00:03    1\n871 |         2023-03-01 07:00:04    3\n872 |         Freq: s, dtype: int64\n873 | \n874 |         Downsample the dataframe to 0.5Hz by providing the period time of 2s.\n875 | \n876 |         >>> series.resample(\"2s\").interpolate(\"linear\")\n877 |         2023-03-01 07:00:00    1\n878 |         2023-03-01 07:00:02    2\n879 |         2023-03-01 07:00:04    3\n880 |         Freq: 2s, dtype: int64\n881 | \n882 |         Upsample the dataframe to 2Hz by providing the period time of 500ms.\n883 | \n884 |         >>> series.resample(\"500ms\").interpolate(\"linear\")\n885 |         2023-03-01 07:00:00.000    1.0\n886 |         2023-03-01 07:00:00.500    0.0\n887 |         2023-03-01 07:00:01.000   -1.0\n888 |         2023-03-01 07:00:01.500    0.5\n889 |         2023-03-01 07:00:02.000    2.0\n890 |         2023-03-01 07:00:02.500    1.5\n891 |         2023-03-01 07:00:03.000    1.0\n892 |         2023-03-01 07:00:03.500    2.0\n893 |         2023-03-01 07:00:04.000    3.0\n894 |         Freq: 500ms, dtype: float64\n895 | \n896 |         Internal reindexing with ``asfreq()`` prior to interpolation leads to\n897 |         an interpolated timeseries on the basis of the reindexed timestamps\n898 |         (anchors). It is assured that all available datapoints from original\n899 |         series become anchors, so it also works for resampling-cases that lead\n900 |         to non-aligned timestamps, as in the following example:\n901 | \n902 |         >>> series.resample(\"400ms\").interpolate(\"linear\")\n903 |         2023-03-01 07:00:00.000    1.0\n904 |         2023-03-01 07:00:00.400    0.2\n905 |         2023-03-01 07:00:00.800   -0.6\n906 |         2023-03-01 07:00:01.200   -0.4\n907 |         2023-03-01 07:00:01.600    0.8\n908 |         2023-03-01 07:00:02.000    2.0\n909 |         2023-03-01 07:00:02.400    1.6\n910 |         2023-03-01 07:00:02.800    1.2\n911 |         2023-03-01 07:00:03.200    1.4\n912 |         2023-03-01 07:00:03.600    2.2\n913 |         2023-03-01 07:00:04.000    3.0\n914 |         Freq: 400ms, dtype: float64\n915 | \n916 |         Note that the series correctly decreases between two anchors\n917 |         ``07:00:00`` and ``07:00:02``.\n918 |         \"\"\"\n919 |         assert downcast is lib.no_default  # just checking coverage\n920 |         result = self._upsample(\"asfreq\")\n921 | \n922 |         # If the original data has timestamps which are not aligned with the\n923 |         # target timestamps, we need to add those points back to the data frame\n924 |         # that is supposed to be interpolated. This does not work with\n925 |         # PeriodIndex, so we skip this case. GH#21351\n926 |         obj = self._selected_obj\n927 |         is_period_index = isinstance(obj.index, PeriodIndex)\n928 | \n929 |         # Skip this step for PeriodIndex\n930 |         if not is_period_index:\n931 |             final_index = result.index\n932 |             if isinstance(final_index, MultiIndex):\n933 |                 raise NotImplementedError(\n934 |                     \"Direct interpolation of MultiIndex data frames is not \"\n935 |                     \"supported. If you tried to resample and interpolate on a \"\n936 |                     \"grouped data frame, please use:\\n\"\n937 |                     \"`df.groupby(...).apply(lambda x: x.resample(...).\"\n938 |                     \"interpolate(...), include_groups=False)`\"\n939 |                     \"\\ninstead, as resampling and interpolation has to be \"\n940 |                     \"performed for each group independently.\"\n941 |                 )\n942 | \n943 |             missing_data_points_index = obj.index.difference(final_index)\n944 |             if len(missing_data_points_index) > 0:\n945 |                 result = concat(\n946 |                     [result, obj.loc[missing_data_points_index]]\n947 |                 ).sort_index()\n948 | \n949 |         result_interpolated = result.interpolate(\n950 |             method=method,\n951 |             axis=axis,\n952 |             limit=limit,\n953 |             inplace=inplace,\n954 |             limit_direction=limit_direction,\n955 |             limit_area=limit_area,\n956 |             downcast=downcast,\n957 |             **kwargs,\n958 |         )\n959 | \n960 |         # No further steps if the original data has a PeriodIndex\n961 |         if is_period_index:\n962 |             return result_interpolated\n963 | \n964 |         # Make sure that original data points which do not align with the\n965 |         # resampled index are removed\n966 |         result_interpolated = result_interpolated.loc[final_index]\n967 | \n968 |         # Make sure frequency indexes are preserved\n969 |         result_interpolated.index = final_index\n970 |         return result_interpolated\n```\n\nFound class `asv_bench/benchmarks/frame_methods.py:Interpolate`.\nSource: Retrieved entity using keyword search (bm25).\n```\n585 | class Interpolate:\n586 |     def setup(self):\n587 |         N = 10000\n588 |         # this is the worst case, where every column has NaNs.\n589 |         arr = np.random.randn(N, 100)\n590 |         arr[::2] = np.nan\n591 | \