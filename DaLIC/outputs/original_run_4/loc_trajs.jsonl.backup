|     )\n  57 | \n  58 |     from pandas._typing import NpDtype\n  59 | \n  60 |     from pandas import (\n  61 |         DataFrame,\n  62 |         Index,\n  63 |         Series,\n  64 |     )\n  65 | \n  66 | _shared_docs: dict[str, str] = {}\n  67 | _cpython_optimized_encoders = (\n  68 |     \"utf-8\",\n  69 |     \"utf8\",\n  70 |     \"latin-1\",\n  71 |     \"latin1\",\n  72 |     \"iso-8859-1\",\n  73 |     \"mbcs\",\n  74 |     \"ascii\",\n  75 | )\n  76 | _cpython_optimized_decoders = _cpython_optimized_encoders + (\"utf-16\", \"utf-32\")\n  77 | \n  78 | \n  79 | def forbid_nonstring_types(\n  80 |     forbidden: list[str] | None, name: str | None = None\n  81 | ) -> Callable[[F], F]:\n  82 |     \"\"\"\n  83 |     Decorator to forbid specific types for a method of StringMethods.\n  84 | \n  85 |     For calling `.str.{method}` on a Series or Index, it is necessary to first\n  86 |     initialize the :class:`StringMethods` object, and then call the method.\n  87 |     However, different methods allow different input types, and so this can not\n  88 |     be checked during :meth:`StringMethods.__init__`, but must be done on a\n  89 |     per-method basis. This decorator exists to facilitate this process, and\n  90 |     make it explicit which (inferred) types are disallowed by the method.\n  91 | \n  92 |     :meth:`StringMethods.__init__` allows the *union* of types its different\n  93 |     methods allow (after skipping NaNs; see :meth:`StringMethods._validate`),\n  94 |     namely: ['string', 'empty', 'bytes', 'mixed', 'mixed-integer'].\n  95 | \n  96 |     The default string types ['string', 'empty'] are allowed for all methods.\n  97 |     For the additional types ['bytes', 'mixed', 'mixed-integer'], each method\n  98 |     then needs to forbid the types it is not intended for.\n  99 | \n 100 |     Parameters\n 101 |     ----------\n 102 |     forbidden : list-of-str or None\n 103 |         List of forbidden non-string types, may be one or more of\n 104 |         `['bytes', 'mixed', 'mixed-integer']`.\n 105 |     name : str, default None\n 106 |         Name of the method to use in the error message. By default, this is\n 107 |         None, in which case the name from the method being wrapped will be\n 108 |         copied. However, for working with further wrappers (like _pat_wrapper\n 109 |         and _noarg_wrapper), it is necessary to specify the name.\n 110 | \n 111 |     Returns\n 112 |     -------\n 113 |     func : wrapper\n 114 |         The method to which the decorator is applied, with an added check that\n 115 |         enforces the inferred type to not be in the list of forbidden types.\n 116 | \n 117 |     Raises\n 118 |     ------\n 119 |     TypeError\n 120 |         If the inferred type of the underlying data is in `forbidden`.\n 121 |     \"\"\"\n 122 |     # deal with None\n 123 |     forbidden = [] if forbidden is None else forbidden\n 124 | \n 125 |     allowed_types = {\"string\", \"empty\", \"bytes\", \"mixed\", \"mixed-integer\"} - set(\n 126 |         forbidden\n 127 |     )\n 128 | \n 129 |     def _forbid_nonstring_types(func: F) -> F:\n 130 |         func_name = func.__name__ if name is None else name\n 131 | \n 132 |         @wraps(func)\n 133 |         def wrapper(self, *args, **kwargs):\n 134 |             if self._inferred_dtype not in allowed_types:\n 135 |                 msg = (\n 136 |                     f\"Cannot use .str.{func_name} with values of \"\n 137 |                     f\"inferred dtype '{self._inferred_dtype}'.\"\n 138 |                 )\n 139 |                 raise TypeError(msg)\n 140 |             return func(self, *args, **kwargs)\n 141 | \n 142 |         wrapper.__name__ = func_name\n 143 |         return cast(F, wrapper)\n 144 | \n 145 |     return _forbid_nonstring_types\n 146 | \n 147 | \n 148 | def _map_and_wrap(name: str | None, docstring: str | None):\n 149 |     @forbid_nonstring_types([\"bytes\"], name=name)\n 150 |     def wrapper(self):\n 151 |         result = getattr(self._data.array, f\"_str_{name}\")()\n 152 |         return self._wrap_result(\n 153 |             result, returns_string=name not in (\"isnumeric\", \"isdecimal\")\n 154 |         )\n 155 | \n 156 |     wrapper.__doc__ = docstring\n 157 |     return wrapper\n 158 | \n 159 | \n 160 | class StringMethods(NoNewAttributesMixin):\n 161 |     \"\"\"\n 162 |     Vectorized string functions for Series and Index.\n 163 | \n 164 |     NAs stay NA unless handled otherwise by a particular method.\n 165 |     Patterned after Python's string methods, with some inspiration from\n 166 |     R's stringr package.\n 167 | \n 168 |     Parameters\n 169 |     ----------\n 170 |     data : Series or Index\n 171 |         The content of the Series or Index.\n 172 | \n 173 |     See Also\n 174 |     --------\n 175 |     Series.str : Vectorized string functions for Series.\n 176 |     Index.str : Vectorized string functions for Index.\n 177 | \n 178 |     Examples\n 179 |     --------\n 180 |     >>> s = pd.Series([\"A_Str_Series\"])\n 181 |     >>> s\n 182 |     0    A_Str_Series\n 183 |     dtype: object\n 184 | \n 185 |     >>> s.str.split(\"_\")\n 186 |     0    [A, Str, Series]\n 187 |     dtype: object\n 188 | \n 189 |     >>> s.str.replace(\"_\", \"\")\n 190 |     0    AStrSeries\n 191 |     dtype: object\n 192 |     \"\"\"\n 193 | \n 194 |     # Note: see the docstring in pandas.core.strings.__init__\n 195 |     # for an explanation of the implementation.\n 196 |     # TODO: Dispatch all the methods\n 197 |     # Currently the following are not dispatched to the array\n 198 |     # * cat\n 199 |     # * extractall\n 200 | \n 201 |     def __init__(self, data) -> None:\n 202 |         from pandas.core.arrays.string_ import StringDtype\n 203 | \n 204 |         self._inferred_dtype = self._validate(data)\n 205 |         self._is_categorical = isinstance(data.dtype, CategoricalDtype)\n 206 |         self._is_string = isinstance(data.dtype, StringDtype)\n 207 |