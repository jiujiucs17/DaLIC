ode=True, minor_locator=True, plot_obj=subplot\n322 |         )\n323 |         subplot.xaxis.set_major_formatter(majformatter)\n324 |         subplot.xaxis.set_minor_formatter(minformatter)\n325 | \n326 |         # x and y coord info\n327 |         subplot.format_coord = functools.partial(_format_coord, freq)\n328 | \n329 |     elif isinstance(index, ABCTimedeltaIndex):\n330 |         subplot.xaxis.set_major_formatter(TimeSeries_TimedeltaFormatter())\n331 |     else:\n332 |         raise TypeError(\"index type not supported\")\n333 | \n334 |     pylab.draw_if_interactive()\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |         return (1, nplots)\n112 |     elif layout_type == \"vertical\":\n113 |         return (nplots, 1)\n114 | \n115 |     layouts = {1: (1, 1), 2: (1, 2), 3: (2, 2), 4: (2, 2)}\n116 |     try:\n117 |         return layouts[nplots]\n118 |     except KeyError:\n119 |         k = 1\n120 |         while k**2 < nplots:\n121 |             k += 1\n122 | \n123 |         if (k - 1) * k >= nplots:\n124 |             return k, (k - 1)\n125 |         else:\n126 |             return k, k\n```\n\n\n\n##Searching for term \"subplots\", \"DataFrame.plot subplots\"...\n### Search Result:\nFound function `pandas/plotting/_core.py:boxplot_frame_groupby`.\nSource: Retrieved code content using keyword search (bm25).\n```\n526 | def boxplot_frame_groupby(\n527 |     grouped,\n528 |     subplots=True,\n529 |     column=None,\n530 |     fontsize=None,\n531 |     rot=0,\n532 |     grid=True,\n533 |     ax=None,\n534 |     figsize=None,\n535 |     layout=None,\n536 |     sharex=False,\n537 |     sharey=True,\n538 |     backend=None,\n539 |     **kwargs,\n540 | ):\n541 |     \"\"\"\n542 |     Make box plots from DataFrameGroupBy data.\n543 | \n544 |     Parameters\n545 |     ----------\n546 |     grouped : Grouped DataFrame\n547 |     subplots : bool\n548 |         * ``False`` - no subplots will be used\n549 |         * ``True`` - create a subplot for each group.\n550 | \n551 |     column : column name or list of names, or vector\n552 |         Can be any valid input to groupby.\n553 |     fontsize : int or str\n554 |     rot : label rotation angle\n555 |     grid : Setting this to True will show the grid\n556 |     ax : Matplotlib axis object, default None\n557 |     figsize : A tuple (width, height) in inches\n558 |     layout : tuple (optional)\n559 |         The layout of the plot: (rows, columns).\n560 |     sharex : bool, default False\n561 |         Whether x-axes will be shared among subplots.\n562 |     sharey : bool, default True\n563 |         Whether y-axes will be shared among subplots.\n564 |     backend : str, default None\n565 |         Backend to use instead of the backend specified in the option\n566 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n567 |         specify the ``plotting.backend`` for the whole session, set\n568 |         ``pd.options.plotting.backend``.\n569 | \n570 |         .. versionadded:: 1.0.0\n571 | \n572 |     **kwargs\n573 |         All other plotting keyword arguments to be passed to\n574 |         matplotlib's boxplot function.\n575 | \n576 |     Returns\n577 |     -------\n578 |     dict of key/value = group key/DataFrame.boxplot return value\n579 |     or DataFrame.boxplot return value in case subplots=figures=False\n580 | \n581 |     Examples\n582 |     --------\n583 |     You can create boxplots for grouped data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **kwargs,\n617 |     )\n```\n\n\n\n##Searching for term \"DataFrame.plot subplots\"...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PlotAccessor(PandasObject):\n\n    _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n    _series_kinds = (\"pie\",)\n    _dataframe_kinds = (\"scatter\", \"hexbin\")\n    _kind_aliases = {\"density\": \"kde\"}\n    _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n\n    def __init__(self, data) -> None:\n...\n    @staticmethod\n    def _get_call_args(backend_name, data, args, kwargs):\n...\n    def __call__(self, *args, **kwargs):\n...\n    __call__.__doc__ = __doc__\n\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n\n        Examples\n        --------\n\n        .. plot::\n            :context: close-figs\n\n            >>> s = pd.Series([1, 3, 2])\n            >>> s.plot.line()\n            <AxesSubplot:ylabel='Density'>\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the populations for some animals\n            over the years.\n\n            >>> df = pd.DataFrame({\n            ...    'pig': [20, 18, 489, 675, 1776],\n            ...    'horse': [4, 25, 281, 600, 1900]\n            ...    }, index=[1990, 1997, 2003, 2009, 2014])\n            >>> lines = df.plot.line()\n\n        .. plot::\n           :context: close-figs\n\n           An example with subplots, so an array of axes is returned.\n\n           >>> axes = df.plot.line(subplots=True)\n           >>> type(axes)\n           <class 'numpy.ndarray'>\n\n        .. plot::\n           :context: close-figs\n\n           Let's repeat the same example, but specifying colors for\n           each column (in this case, for each animal).\n\n           >>> axes = df.plot.line(\n           ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n           ... )\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the relationship between both\n            populations.\n\n            >>> lines = df.plot.line(x='pig', y='horse')\n        \"\"\"\n    )\n    @Substitution(kind=\"line\")\n    @Appender(_bar_or_line_doc)\n    def line(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.barh : Horizontal bar plot.\n        DataFrame.plot : Make plots of a DataFrame.\n        matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n\n        Examples\n        --------\n        Basic plot.\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n            >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n\n        Plot a whole dataframe to a bar plot. Each column is assigned a\n        distinct color, and each row is nested in a group along the\n        horizontal axis.\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.bar(rot=0)\n\n        Plot stacked bar charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(stacked=True)\n\n        Instead of nesting, the figure can be split by column with\n        ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n        :class:`matplotlib.axes.Axes` are returned.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(rot=0, subplots=True)\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        If you don't like the default colours, you can specify how you'd\n        like each column to be colored.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(\n            ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n            ... )\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        Plot a single column.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(y='speed', rot=0)\n\n        Plot only selected categories for the DataFrame.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(x='lifespan', rot=0)\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def bar(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.bar: Vertical bar plot.\n        DataFrame.plot : Make plots of DataFrame using matplotlib.\n        matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n\n        Examples\n        --------\n        Basic example\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n            >>> ax = df.plot.barh(x='lab', y='val')\n\n        Plot a whole DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh()\n\n        Plot stacked barh charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(stacked=True)\n\n        We can specify colors for each column\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n\n        Plot a column of the DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh(y='speed')\n\n        Plot DataFrame versus the desired column\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh(x='lifespan')\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def barh(self, x=None, y=None, **kwargs):\n...\n    def box(self, by=None, **kwargs):\n...\n    def hist(self, by=None, bins=10, **kwargs):\n...\n    def kde(self, bw_method=None, ind=None, **kwargs):\n...\n    density = kde\n\n    def area(self, x=None, y=None, **kwargs):\n...\n    def pie(self, **kwargs):\n...\n    def scatter(self, x, y, s=None, c=None, **kwargs):\n...\n    def hexbin(self, x, y, C=None, reduce_C_function=None, gridsize=None, **kwargs):\n\n```\nHint: Search `pandas/plotting/_core.py:PlotAccessor` to get the full content if needed.\n\nFound function `pandas/plotting/_core.py:PlotAccessor.line`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1034 | def line(self, x=None, y=None, **kwargs):\n1035 |         \"\"\"\n1036 |         Plot Series or DataFrame as lines.\n1037 | \n1038 |         This function is useful to plot lines using DataFrame's values\n1039 |         as coordinates.\n1040 |         \"\"\"\n1041 |         return self(kind=\"line\", x=x, y=y, **kwargs)\n```\n"}, {"content": "Based on the search results, the key areas to look into for implementing the requested feature are:\n\n- The `PlotAccessor` class, specifically the `__call__` method and the `pie` method since they handle plotting and subplots.\n- The `_setup_subplots` method in `MPLPlot` class for setting up subplots.\n- The `create_subplots` function in `_matplotlib/tools.py` for creating subplots.\n- The `DataFrame.plot` method to understand the overall plot method invocation.\n\nLet's focus on getting the full content of the `PlotAccessor` class and `_setup_subplots` method first to understand how plotting and subplots are handled.\n\n<function=get_entity_contents>\n<parameter=entity_names>\n['pandas/plotting/_core.py:PlotAccessor', 'pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots']\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/plotting/_core.py:PlotAccessor`...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Exact match found for entity name `pandas/plotting/_core.py:PlotAccessor`.\n```\n 620 | class PlotAccessor(PandasObject):\n 621 |     \"\"\"\n 622 |     Make plots of Series or DataFrame.\n 623 | \n 624 |     Uses the backend specified by the\n 625 |     option ``plotting.backend``. By default, matplotlib is used.\n 626 | \n 627 |     Parameters\n 628 |     ----------\n 629 |     data : Series or DataFrame\n 630 |         The object for which the method is called.\n 631 |     x : label or position, default None\n 632 |         Only used if data is a DataFrame.\n 633 |     y : label, position or list of label, positions, default None\n 634 |         Allows plotting of one column versus another. Only used if data is a\n 635 |         DataFrame.\n 636 |     kind : str\n 637 |         The kind of plot to produce:\n 638 | \n 639 |         - 'line' : line plot (default)\n 640 |         - 'bar' : vertical bar plot\n 641 |         - 'barh' : horizontal bar plot\n 642 |         - 'hist' : histogram\n 643 |         - 'box' : boxplot\n 644 |         - 'kde' : Kernel Density Estimation plot\n 645 |         - 'density' : same as 'kde'\n 646 |         - 'area' : area plot\n 647 |         - 'pie' : pie plot\n 648 |         - 'scatter' : scatter plot (DataFrame only)\n 649 |         - 'hexbin' : hexbin plot (DataFrame only)\n 650 |     ax : matplotlib axes object, default None\n 651 |         An axes of the current figure.\n 652 |     subplots : bool, default False\n 653 |         Make separate subplots for each column.\n 654 |     sharex : bool, default True if ax is None else False\n 655 |         In case ``subplots=True``, share x axis and set some x axis labels\n 656 |         to invisible; defaults to True if ax is None otherwise False if\n 657 |         an ax is passed in; Be aware, that passing in both an ax and\n 658 |         ``sharex=True`` will alter all x axis labels for all axis in a figure.\n 659 |     sharey : bool, default False\n 660 |         In case ``subplots=True``, share y axis and set some y axis labels to invisible.\n 661 |     layout : tuple, optional\n 662 |         (rows, columns) for the layout of subplots.\n 663 |     figsize : a tuple (width, height) in inches\n 664 |         Size of a figure object.\n 665 |     use_index : bool, default True\n 666 |         Use index as ticks for x axis.\n 667 |     title : str or list\n 668 |         Title to use for the plot. If a string is passed, print the string\n 669 |         at the top of the figure. If a list is passed and `subplots` is\n 670 |         True, print each item in the list above the corresponding subplot.\n 671 |     grid : bool, default None (matlab style default)\n 672 |         Axis grid lines.\n 673 |     legend : bool or {'reverse'}\n 674 |         Place legend on axis subplots.\n 675 |     style : list or dict\n 676 |         The matplotlib line style per column.\n 677 |     logx : bool or 'sym', default False\n 678 |         Use log scaling or symlog scaling on x axis.\n 679 |         .. versionchanged:: 0.25.0\n 680 | \n 681 |     logy : bool or 'sym' default False\n 682 |         Use log scaling or symlog scaling on y axis.\n 683 |         .. versionchanged:: 0.25.0\n 684 | \n 685 |     loglog : bool or 'sym', default False\n 686 |         Use log scaling or symlog scaling on both x and y axes.\n 687 |         .. versionchanged:: 0.25.0\n 688 | \n 689 |     xticks : sequence\n 690 |         Values to use for the xticks.\n 691 |     yticks : sequence\n 692 |         Values to use for the yticks.\n 693 |     xlim : 2-tuple/list\n 694 |         Set the x limits of the current axes.\n 695 |     ylim : 2-tuple/list\n 696 |         Set the y limits of the current axes.\n 697 |     xlabel : label, optional\n 698 |         Name to use for the xlabel on x-axis. Default uses index name as xlabel, or the\n 699 |         x-column name for planar plots.\n 700 | \n 701 |         .. versionadded:: 1.1.0\n 702 | \n 703 |         .. versionchanged:: 1.2.0\n 704 | \n 705 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 706 | \n 707 |     ylabel : label, optional\n 708 |         Name to use for the ylabel on y-axis. Default will show no ylabel, or the\n 709 |         y-column name for planar plots.\n 710 | \n 711 |         .. versionadded:: 1.1.0\n 712 | \n 713 |         .. versionchanged:: 1.2.0\n 714 | \n 715 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 716 | \n 717 |     rot : int, default None\n 718 |         Rotation for ticks (xticks for vertical, yticks for horizontal\n 719 |         plots).\n 720 |     fontsize : int, default None\n 721 |         Font size for xticks and yticks.\n 722 |     colormap : str or matplotlib colormap object, default None\n 723 |         Colormap to select colors from. If string, load colormap with that\n 724 |         name from matplotlib.\n 725 |     colorbar : bool, optional\n 726 |         If True, plot colorbar (only relevant for 'scatter' and 'hexbin'\n 727 |         plots).\n 728 |     position : float\n 729 |         Specify relative alignments for bar plot layout.\n 730 |         From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 731 |         (center).\n 732 |     table : bool, Series or DataFrame, default False\n 733 |         If True, draw a table using the data in the DataFrame and the data\n 734 |         will be transposed to meet matplotlib's default layout.\n 735 |         If a Series or DataFrame is passed, use passed data to draw a\n 736 |         table.\n 737 |     yerr : DataFrame, Series, array-like, dict and str\n 738 |         See :ref:`Plotting with Error Bars <visualization.errorbars>` for\n 739 |         detail.\n 740 |     xerr : DataFrame, Series, array-like, dict and str\n 741 |         Equivalent to yerr.\n 742 |     stacked : bool, default False in line and bar plots, and True in area plot\n 743 |         If True, create stacked plot.\n 744 |     sort_columns : bool, default False\n 745 |         Sort column names to determine plot ordering.\n 746 |     secondary_y : bool or sequence, default False\n 747 |         Whether to plot on the secondary y-axis if a list/tuple, which\n 748 |         columns to plot on secondary y-axis.\n 749 |     mark_right : bool, default True\n 750 |         When using a secondary_y axis, automatically mark the column\n 751 |         labels with \"(right)\" in the legend.\n 752 |     include_bool : bool, default is False\n 753 |         If True, boolean values can be plotted.\n 754 |     backend : str, default None\n 755 |         Backend to use instead of the backend specified in the option\n 756 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n 757 |         specify the ``plotting.backend`` for the whole session, set\n 758 |         ``pd.options.plotting.backend``.\n 759 | \n 760 |         .. versionadded:: 1.0.0\n 761 | \n 762 |     **kwargs\n 763 |         Options to pass to matplotlib plotting method.\n 764 | \n 765 |     Returns\n 766 |     -------\n 767 |     :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n 768 |         If the backend is not the default matplotlib one, the return value\n 769 |         will be the object returned by the backend.\n 770 | \n 771 |     Notes\n 772 |     -----\n 773 |     - See matplotlib documentation online for more on this subject\n 774 |     - If `kind` = 'bar' or 'barh', you can specify relative alignments\n 775 |       for bar plot layout by `position` keyword.\n 776 |       From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 777 |       (center)\n 778 |     \"\"\"\n 779 | \n 780 |     _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n 781 |     _series_kinds = (\"pie\",)\n 782 |     _dataframe_kinds = (\"scatter\", \"hexbin\")\n 783 |     _kind_aliases = {\"density\": \"kde\"}\n 784 |     _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n 785 | \n 786 |     def __init__(self, data) -> None:\n 787 |         self._parent = data\n 788 | \n 789 |     @staticmethod\n 790 |     def _get_call_args(backend_name, data, args, kwargs):\n 791 |         \"\"\"\n 792 |         This function makes calls to this accessor `__call__` method compatible\n 793 |         with the previous `SeriesPlotMethods.__call__` and\n 794 |         `DataFramePlotMethods.__call__`. Those had slightly different\n 795 |         signatures, since `DataFramePlotMethods` accepted `x` and `y`\n 796 |         parameters.\n 797 |         \"\"\"\n 798 |         if isinstance(data, ABCSeries):\n 799 |             arg_def = [\n 800 |                 (\"kind\", \"line\"),\n 801 |                 (\"ax\", None),\n 802 |                 (\"figsize\", None),\n 803 |                 (\"use_index\", True),\n 804 |                 (\"title\", None),\n 805 |                 (\"grid\", None),\n 806 |                 (\"legend\", False),\n 807 |                 (\"style\", None),\n 808 |                 (\"logx\", False),\n 809 |                 (\"logy\", False),\n 810 |                 (\"loglog\", False),\n 811 |                 (\"xticks\", None),\n 812 |                 (\"yticks\", None),\n 813 |                 (\"xlim\", None),\n 814 |                 (\"ylim\", None),\n 815 |                 (\"rot\", None),\n 816 |                 (\"fontsize\", None),\n 817 |                 (\"colormap\", None),\n 818 |                 (\"table\", False),\n 819 |                 (\"yerr\", None),\n 820 |                 (\"xerr\", None),\n 821 |                 (\"label\", None),\n 822 |                 (\"secondary_y\", False),\n 823 |                 (\"xlabel\", None),\n 824 |                 (\"ylabel\", None),\n 825 |             ]\n 826 |         elif isinstance(data, ABCDataFrame):\n 827 |             arg_def = [\n 828 |                 (\"x\", None),\n 829 |                 (\"y\", None),\n 830 |                 (\"kind\", \"line\"),\n 831 |                 (\"ax\", None),\n 832 |                 (\"subplots\", False),\n 833 |                 (\"sharex\", None),\n 834 |                 (\"sharey\", False),\n 835 |                 (\"layout\", None),\n 836 |                 (\"figsize\", None),\n 837 |                 (\"use_index\", True),\n 838 |                 (\"title\", None),\n 839 |                 (\"grid\", None),\n 840 |                 (\"legend\", True),\n 841 |                 (\"style\", None),\n 842 |                 (\"logx\", False),\n 843 |                 (\"logy\", False),\n 844 |                 (\"loglog\", False),\n 845 |                 (\"xticks\", None),\n 846 |                 (\"yticks\", None),\n 847 |                 (\"xlim\", None),\n 848 |                 (\"ylim\", None),\n 849 |                 (\"rot\", None),\n 850 |                 (\"fontsize\", None),\n 851 |                 (\"colormap\", None),\n 852 |                 (\"table\", False),\n 853 |                 (\"yerr\", None),\n 854 |                 (\"xerr\", None),\n 855 |                 (\"secondary_y\", False),\n 856 |                 (\"sort_columns\", False),\n 857 |                 (\"xlabel\", None),\n 858 |                 (\"ylabel\", None),\n 859 |             ]\n 860 |         else:\n 861 |             raise TypeError(\n 862 |                 f\"Called plot accessor for type {type(data).__name__}, \"\n 863 |                 \"expected Series or DataFrame\"\n 864 |             )\n 865 | \n 866 |         if args and isinstance(data, ABCSeries):\n 867 |             positional_args = str(args)[1:-1]\n 868 |             keyword_args = \", \".join(\n 869 |                 [f\"{name}={repr(value)}\" for (name, _), value in zip(arg_def, args)]\n 870 |             )\n 871 |             msg = (\n 872 |                 \"`Series.plot()` should not be called with positional \"\n 873 |                 \"arguments, only keyword arguments. The order of \"\n 874 |                 \"positional arguments will change in the future. \"\n 875 |                 f\"Use `Series.plot({keyword_args})` instead of \"\n 876 |                 f\"`Series.plot({positional_args})`.\"\n 877 |             )\n 878 |             raise TypeError(msg)\n 879 | \n 880 |         pos_args = {name: value for (name, _), value in zip(arg_def, args)}\n 881 |         if backend_name == \"pandas.plotting._matplotlib\":\n 882 |             kwargs = dict(arg_def, **pos_args, **kwargs)\n 883 |         else:\n 884 |             kwargs = dict(pos_args, **kwargs)\n 885 | \n 886 |         x = kwargs.pop(\"x\", None)\n 887 |         y = kwargs.pop(\"y\", None)\n 888 |         kind = kwargs.pop(\"kind\", \"line\")\n 889 |         return x, y, kind, kwargs\n 890 | \n 891 |     def __call__(self, *args, **kwargs):\n 892 |         plot_backend = _get_plot_backend(kwargs.pop(\"backend\", None))\n 893 | \n 894 |         x, y, kind, kwargs = self._get_call_args(\n 895 |             plot_backend.__name__, self._parent, args, kwargs\n 896 |         )\n 897 | \n 898 |         kind = self._kind_aliases.get(kind, kind)\n 899 | \n 900 |         # when using another backend, get out of the way\n 901 |         if plot_backend.__name__ != \"pandas.plotting._matplotlib\":\n 902 |             return plot_backend.plot(self._parent, x=x, y=y, kind=kind, **kwargs)\n 903 | \n 904 |         if kind not in self._all_kinds:\n 905 |             raise ValueError(f\"{kind} is not a valid plot kind\")\n 906 | \n 907 |         # The original data structured can be transformed before passed to the\n 908 |         # backend. For example, for DataFrame is common to set the index as the\n 909 |         # `x` parameter, and return a Series with the parameter `y` as values.\n 910 |         data = self._parent.copy()\n 911 | \n 912 |         if isinstance(data, ABCSeries):\n 913 |             kwargs[\"reuse_plot\"] = True\n 914 | \n 915 |         if kind in self._dataframe_kinds:\n 916 |             if isinstance(data, ABCDataFrame):\n 917 |                 return plot_backend.plot(data, x=x, y=y, kind=kind, **kwargs)\n 918 |             else:\n 919 |                 raise ValueError(f\"plot kind {kind} can only be used for data frames\")\n 920 |         elif kind in self._series_kinds:\n 921 |             if isinstance(data, ABCDataFrame):\n 922 |                 if y is None and kwargs.get(\"subplots\") is False:\n 923 |                     raise ValueError(\n 924 |                         f\"{kind} requires either y column or 'subplots=True'\"\n 925 |                     )\n 926 |                 elif y is not None:\n 927 |                     if is_integer(y) and not data.columns.holds_integer():\n 928 |                         y = data.columns[y]\n 929 |                     # converted to series actually. copy to not modify\n 930 |                     data = data[y].copy()\n 931 |                     data.index.name = y\n 932 |         elif isinstance(data, ABCDataFrame):\n 933 |             data_cols = data.columns\n 934 |             if x is not None:\n 935 |                 if is_integer(x) and not data.columns.holds_integer():\n 936 |                     x = data_cols[x]\n 937 |                 elif not isinstance(data[x], ABCSeries):\n 938 |                     raise ValueError(\"x must be a label or position\")\n 939 |                 data = data.set_index(x)\n 940 |             if y is not None:\n 941 |                 # check if we have y as int or list of ints\n 942 |                 int_ylist = is_list_like(y) and all(is_integer(c) for c in y)\n 943 |                 int_y_arg = is_integer(y) or int_ylist\n 944 |                 if int_y_arg and not data.columns.holds_integer():\n 945 |                     y = data_cols[y]\n 946 | \n 947 |                 label_kw = kwargs[\"label\"] if \"label\" in kwargs else False\n 948 |                 for kw in [\"xerr\", \"yerr\"]:\n 949 |                     if kw in kwargs and (\n 950 |                         isinstance(kwargs[kw], str) or is_integer(kwargs[kw])\n 951 |                     ):\n 952 |                         try:\n 953 |                             kwargs[kw] = data[kwargs[kw]]\n 954 |                         except (IndexError, KeyError, TypeError):\n 955 |                             pass\n 956 | \n 957 |                 # don't overwrite\n 958 |                 data = data[y].copy()\n 959 | \n 960 |                 if isinstance(data, ABCSeries):\n 961 |                     label_name = label_kw or y\n 962 |                     data.name = label_name\n 963 |                 else:\n 964 |                     match = is_list_like(label_kw) and len(label_kw) == len(y)\n 965 |                     if label_kw and not match:\n 966 |                         raise ValueError(\n 967 |                             \"label should be list-like and same length as y\"\n 968 |                         )\n 969 |                     label_name = label_kw or data.columns\n 970 |                     data.columns = label_name\n 971 | \n 972 |         return plot_backend.plot(data, kind=kind, **kwargs)\n 973 | \n 974 |     __call__.__doc__ = __doc__\n 975 | \n 976 |     @Appender(\n 977 |         \"\"\"\n 978 |         See Also\n 979 |         --------\n 980 |         matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n 981 | \n 982 |         Examples\n 983 |         --------\n 984 | \n 985 |         .. plot::\n 986 |             :context: close-figs\n 987 | \n 988 |             >>> s = pd.Series([1, 3, 2])\n 989 |             >>> s.plot.line()\n 990 |             <AxesSubplot:ylabel='Density'>\n 991 | \n 992 |         .. plot::\n 993 |             :context: close-figs\n 994 | \n 995 |             The following example shows the populations for some animals\n 996 |             over the years.\n 997 | \n 998 |             >>> df = pd.DataFrame({\n 999 |             ...    'pig': [20, 18, 489, 675, 1776],\n1000 |             ...    'horse': [4, 25, 281, 600, 1900]\n1001 |             ...    }, index=[1990, 1997, 2003, 2009, 2014])\n1002 |             >>> lines = df.plot.line()\n1003 | \n1004 |         .. plot::\n1005 |            :context: close-figs\n1006 | \n1007 |            An example with subplots, so an array of axes is returned.\n1008 | \n1009 |            >>> axes = df.plot.line(subplots=True)\n1010 |            >>> type(axes)\n1011 |            <class 'numpy.ndarray'>\n1012 | \n1013 |         .. plot::\n1014 |            :context: close-figs\n1015 | \n1016 |            Let's repeat the same example, but specifying colors for\n1017 |            each column (in this case, for each animal).\n1018 | \n1019 |            >>> axes = df.plot.line(\n1020 |            ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n1021 |            ... )\n1022 | \n1023 |         .. plot::\n1024 |             :context: close-figs\n1025 | \n1026 |             The following example shows the relationship between both\n1027 |             populations.\n1028 | \n1029 |             >>> lines = df.plot.line(x='pig', y='horse')\n1030 |         \"\"\"\n1031 |     )\n1032 |     @Substitution(kind=\"line\")\n1033 |     @Appender(_bar_or_line_doc)\n1034 |     def line(self, x=None, y=None, **kwargs):\n1035 |         \"\"\"\n1036 |         Plot Series or DataFrame as lines.\n1037 | \n1038 |         This function is useful to plot lines using DataFrame's values\n1039 |         as coordinates.\n1040 |         \"\"\"\n1041 |         return self(kind=\"line\", x=x, y=y, **kwargs)\n1042 | \n1043 |     @Appender(\n1044 |         \"\"\"\n1045 |         See Also\n1046 |         --------\n1047 |         DataFrame.plot.barh : Horizontal bar plot.\n1048 |         DataFrame.plot : Make plots of a DataFrame.\n1049 |         matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n1050 | \n1051 |         Examples\n1052 |         --------\n1053 |         Basic plot.\n1054 | \n1055 |         .. plot::\n1056 |             :context: close-figs\n1057 | \n1058 |             >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n1059 |             >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n1060 | \n1061 |         Plot a whole dataframe to a bar plot. Each column is assigned a\n1062 |         distinct color, and each row is nested in a group along the\n1063 |         horizontal axis.\n1064 | \n1065 |         .. plot::\n1066 |             :context: close-figs\n1067 | \n1068 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1069 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1070 |             >>> index = ['snail', 'pig', 'elephant',\n1071 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1072 |             >>> df = pd.DataFrame({'speed': speed,\n1073 |             ...                    'lifespan': lifespan}, index=index)\n1074 |             >>> ax = df.plot.bar(rot=0)\n1075 | \n1076 |         Plot stacked bar charts for the DataFrame\n1077 | \n1078 |         .. plot::\n1079 |             :context: close-figs\n1080 | \n1081 |             >>> ax = df.plot.bar(stacked=True)\n1082 | \n1083 |         Instead of nesting, the figure can be split by column with\n1084 |         ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n1085 |         :class:`matplotlib.axes.Axes` are returned.\n1086 | \n1087 |         .. plot::\n1088 |             :context: close-figs\n1089 | \n1090 |             >>> axes = df.plot.bar(rot=0, subplots=True)\n1091 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1092 | \n1093 |         If you don't like the default colours, you can specify how you'd\n1094 |         like each column to be colored.\n1095 | \n1096 |         .. plot::\n1097 |             :context: close-figs\n1098 | \n1099 |             >>> axes = df.plot.bar(\n1100 |             ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n1101 |             ... )\n1102 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1103 | \n1104 |         Plot a single column.\n1105 | \n1106 |         .. plot::\n1107 |             :context: close-figs\n1108 | \n1109 |             >>> ax = df.plot.bar(y='speed', rot=0)\n1110 | \n1111 |         Plot only selected categories for the DataFrame.\n1112 | \n1113 |         .. plot::\n1114 |             :context: close-figs\n1115 | \n1116 |             >>> ax = df.plot.bar(x='lifespan', rot=0)\n1117 |     \"\"\"\n1118 |     )\n1119 |     @Substitution(kind=\"bar\")\n1120 |     @Appender(_bar_or_line_doc)\n1121 |     def bar(self, x=None, y=None, **kwargs):\n1122 |         \"\"\"\n1123 |         Vertical bar plot.\n1124 | \n1125 |         A bar plot is a plot that presents categorical data with\n1126 |         rectangular bars with lengths proportional to the values that they\n1127 |         represent. A bar plot shows comparisons among discrete categories. One\n1128 |         axis of the plot shows the specific categories being compared, and the\n1129 |         other axis represents a measured value.\n1130 |         \"\"\"\n1131 |         return self(kind=\"bar\", x=x, y=y, **kwargs)\n1132 | \n1133 |     @Appender(\n1134 |         \"\"\"\n1135 |         See Also\n1136 |         --------\n1137 |         DataFrame.plot.bar: Vertical bar plot.\n1138 |         DataFrame.plot : Make plots of DataFrame using matplotlib.\n1139 |         matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n1140 | \n1141 |         Examples\n1142 |         --------\n1143 |         Basic example\n1144 | \n1145 |         .. plot::\n1146 |             :context: close-figs\n1147 | \n1148 |             >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n1149 |             >>> ax = df.plot.barh(x='lab', y='val')\n1150 | \n1151 |         Plot a whole DataFrame to a horizontal bar plot\n1152 | \n1153 |         .. plot::\n1154 |             :context: close-figs\n1155 | \n1156 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1157 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1158 |             >>> index = ['snail', 'pig', 'elephant',\n1159 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1160 |             >>> df = pd.DataFrame({'speed': speed,\n1161 |             ...                    'lifespan': lifespan}, index=index)\n1162 |             >>> ax = df.plot.barh()\n1163 | \n1164 |         Plot stacked barh charts for the DataFrame\n1165 | \n1166 |         .. plot::\n1167 |             :context: close-figs\n1168 | \n1169 |             >>> ax = df.plot.barh(stacked=True)\n1170 | \n1171 |         We can specify colors for each column\n1172 | \n1173 |         .. plot::\n1174 |             :context: close-figs\n1175 | \n1176 |             >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n1177 | \n1178 |         Plot a column of the DataFrame to a horizontal bar plot\n1179 | \n1180 |         .. plot::\n1181 |             :context: close-figs\n1182 | \n1183 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1184 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1185 |             >>> index = ['snail', 'pig', 'elephant',\n1186 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1187 |             >>> df = pd.DataFrame({'speed': speed,\n1188 |             ...                    'lifespan': lifespan}, index=index)\n1189 |             >>> ax = df.plot.barh(y='speed')\n1190 | \n1191 |         Plot DataFrame versus the desired column\n1192 | \n1193 |         .. plot::\n1194 |             :context: close-figs\n1195 | \n1196 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1197 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1198 |             >>> index = ['snail', 'pig', 'elephant',\n1199 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1200 |             >>> df = pd.DataFrame({'speed': speed,\n1201 |             ...                    'lifespan': lifespan}, index=index)\n1202 |             >>> ax = df.plot.barh(x='lifespan')\n1203 |     \"\"\"\n1204 |     )\n1205 |     @Substitution(kind=\"bar\")\n1206 |     @Appender(_bar_or_line_doc)\n1207 |     def barh(self, x=None, y=None, **kwargs):\n1208 |         \"\"\"\n1209 |         Make a horizontal bar plot.\n1210 | \n1211 |         A horizontal bar plot is a plot that presents quantitative data with\n1212 |         rectangular bars with lengths proportional to the values that they\n1213 |         represent. A bar plot shows comparisons among discrete categories. One\n1214 |         axis of the plot shows the specific categories being compared, and the\n1215 |         other axis represents a measured value.\n1216 |         \"\"\"\n1217 |         return self(kind=\"barh\", x=x, y=y, **kwargs)\n1218 | \n1219 |     def box(self, by=None, **kwargs):\n1220 |         r\"\"\"\n1221 |         Make a box plot of the DataFrame columns.\n1222 | \n1223 |         A box plot is a method for graphically depicting groups of numerical\n1224 |         data through their quartiles.\n1225 |         The box extends from the Q1 to Q3 quartile values of the data,\n1226 |         with a line at the median (Q2). The whiskers extend from the edges\n1227 |         of box to show the range of the data. The position of the whiskers\n1228 |         is set by default to 1.5*IQR (IQR = Q3 - Q1) from the edges of the\n1229 |         box. Outlier points are those past the end of the whiskers.\n1230 | \n1231 |         For further details see Wikipedia's\n1232 |         entry for `boxplot <https://en.wikipedia.org/wiki/Box_plot>`__.\n1233 | \n1234 |         A consideration when using this chart is that the box and the whiskers\n1235 |         can overlap, which is very common when plotting small sets of data.\n1236 | \n1237 |         Parameters\n1238 |         ----------\n1239 |         by : str or sequence\n1240 |             Column in the DataFrame to group by.\n1241 | \n1242 |             .. versionchanged:: 1.4.0\n1243 | \n1244 |                Previously, `by` is silently ignore and makes no groupings\n1245 | \n1246 |         **kwargs\n1247 |             Additional keywords are documented in\n1248 |             :meth:`DataFrame.plot`.\n1249 | \n1250 |         Returns\n1251 |         -------\n1252 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1253 | \n1254 |         See Also\n1255 |         --------\n1256 |         DataFrame.boxplot: Another method to draw a box plot.\n1257 |         Series.plot.box: Draw a box plot from a Series object.\n1258 |         matplotlib.pyplot.boxplot: Draw a box plot in matplotlib.\n1259 | \n1260 |         Examples\n1261 |         --------\n1262 |         Draw a box plot from a DataFrame with four columns of randomly\n1263 |         generated data.\n1264 | \n1265 |         .. plot::\n1266 |             :context: close-figs\n1267 | \n1268 |             >>> data = np.random.randn(25, 4)\n1269 |             >>> df = pd.DataFrame(data, columns=list('ABCD'))\n1270 |             >>> ax = df.plot.box()\n1271 | \n1272 |         You can also generate groupings if you specify the `by` parameter (which\n1273 |         can take a column name, or a list or tuple of column names):\n1274 | \n1275 |         .. versionchanged:: 1.4.0\n1276 | \n1277 |         .. plot::\n1278 |             :context: close-figs\n1279 | \n1280 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1281 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1282 |             >>> ax = df.plot.box(column=\"age\", by=\"gender\", figsize=(10, 8))\n1283 |         \"\"\"\n1284 |         return self(kind=\"box\", by=by, **kwargs)\n1285 | \n1286 |     def hist(self, by=None, bins=10, **kwargs):\n1287 |         \"\"\"\n1288 |         Draw one histogram of the DataFrame's columns.\n1289 | \n1290 |         A histogram is a representation of the distribution of data.\n1291 |         This function groups the values of all given Series in the DataFrame\n1292 |         into bins and draws all bins in one :class:`matplotlib.axes.Axes`.\n1293 |         This is useful when the DataFrame's Series are in a similar scale.\n1294 | \n1295 |         Parameters\n1296 |         ----------\n1297 |         by : str or sequence, optional\n1298 |             Column in the DataFrame to group by.\n1299 | \n1300 |             .. versionchanged:: 1.4.0\n1301 | \n1302 |                Previously, `by` is silently ignore and makes no groupings\n1303 | \n1304 |         bins : int, default 10\n1305 |             Number of histogram bins to be used.\n1306 |         **kwargs\n1307 |             Additional keyword arguments are documented in\n1308 |             :meth:`DataFrame.plot`.\n1309 | \n1310 |         Returns\n1311 |         -------\n1312 |         class:`matplotlib.AxesSubplot`\n1313 |             Return a histogram plot.\n1314 | \n1315 |         See Also\n1316 |         --------\n1317 |         DataFrame.hist : Draw histograms per DataFrame's Series.\n1318 |         Series.hist : Draw a histogram with Series' data.\n1319 | \n1320 |         Examples\n1321 |         --------\n1322 |         When we roll a die 6000 times, we expect to get each value around 1000\n1323 |         times. But when we roll two dice and sum the result, the distribution\n1324 |         is going to be quite different. A histogram illustrates those\n1325 |         distributions.\n1326 | \n1327 |         .. plot::\n1328 |             :context: close-figs\n1329 | \n1330 |             >>> df = pd.DataFrame(\n1331 |             ...     np.random.randint(1, 7, 6000),\n1332 |             ...     columns = ['one'])\n1333 |             >>> df['two'] = df['one'] + np.random.randint(1, 7, 6000)\n1334 |             >>> ax = df.plot.hist(bins=12, alpha=0.5)\n1335 | \n1336 |         A grouped histogram can be generated by providing the parameter `by` (which\n1337 |         can be a column name, or a list of column names):\n1338 | \n1339 |         .. plot::\n1340 |             :context: close-figs\n1341 | \n1342 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1343 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1344 |             >>> ax = df.plot.hist(column=[\"age\"], by=\"gender\", figsize=(10, 8))\n1345 |         \"\"\"\n1346 |         return self(kind=\"hist\", by=by, bins=bins, **kwargs)\n1347 | \n1348 |     def kde(self, bw_method=None, ind=None, **kwargs):\n1349 |         \"\"\"\n1350 |         Generate Kernel Density Estimate plot using Gaussian kernels.\n1351 | \n1352 |         In statistics, `kernel density estimation`_ (KDE) is a non-parametric\n1353 |         way to estimate the probability density function (PDF) of a random\n1354 |         variable. This function uses Gaussian kernels and includes automatic\n1355 |         bandwidth determination.\n1356 | \n1357 |         .. _kernel density estimation:\n1358 |             https://en.wikipedia.org/wiki/Kernel_density_estimation\n1359 | \n1360 |         Parameters\n1361 |         ----------\n1362 |         bw_method : str, scalar or callable, optional\n1363 |             The method used to calculate the estimator bandwidth. This can be\n1364 |             'scott', 'silverman', a scalar constant or a callable.\n1365 |             If None (default), 'scott' is used.\n1366 |             See :class:`scipy.stats.gaussian_kde` for more information.\n1367 |         ind : NumPy array or int, optional\n1368 |             Evaluation points for the estimated PDF. If None (default),\n1369 |             1000 equally spaced points are used. If `ind` is a NumPy array, the\n1370 |             KDE is evaluated at the points passed. If `ind` is an integer,\n1371 |             `ind` number of equally spaced points are used.\n1372 |         **kwargs\n1373 |             Additional keyword arguments are documented in\n1374 |             :meth:`DataFrame.plot`.\n1375 | \n1376 |         Returns\n1377 |         -------\n1378 |         matplotlib.axes.Axes or numpy.ndarray of them\n1379 | \n1380 |         See Also\n1381 |         --------\n1382 |         scipy.stats.gaussian_kde : Representation of a kernel-density\n1383 |             estimate using Gaussian kernels. This is the function used\n1384 |             internally to estimate the PDF.\n1385 | \n1386 |         Examples\n1387 |         --------\n1388 |         Given a Series of points randomly sampled from an unknown\n1389 |         distribution, estimate its PDF using KDE with automatic\n1390 |         bandwidth determination and plot the results, evaluating them at\n1391 |         1000 equally spaced points (default):\n1392 | \n1393 |         .. plot::\n1394 |             :context: close-figs\n1395 | \n1396 |             >>> s = pd.Series([1, 2, 2.5, 3, 3.5, 4, 5])\n1397 |             >>> ax = s.plot.kde()\n1398 | \n1399 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1400 |         lead to over-fitting, while using a large bandwidth value may result\n1401 |         in under-fitting:\n1402 | \n1403 |         .. plot::\n1404 |             :context: close-figs\n1405 | \n1406 |             >>> ax = s.plot.kde(bw_method=0.3)\n1407 | \n1408 |         .. plot::\n1409 |             :context: close-figs\n1410 | \n1411 |             >>> ax = s.plot.kde(bw_method=3)\n1412 | \n1413 |         Finally, the `ind` parameter determines the evaluation points for the\n1414 |         plot of the estimated PDF:\n1415 | \n1416 |         .. plot::\n1417 |             :context: close-figs\n1418 | \n1419 |             >>> ax = s.plot.kde(ind=[1, 2, 3, 4, 5])\n1420 | \n1421 |         For DataFrame, it works in the same way:\n1422 | \n1423 |         .. plot::\n1424 |             :context: close-figs\n1425 | \n1426 |             >>> df = pd.DataFrame({\n1427 |             ...     'x': [1, 2, 2.5, 3, 3.5, 4, 5],\n1428 |             ...     'y': [4, 4, 4.5, 5, 5.5, 6, 6],\n1429 |             ... })\n1430 |             >>> ax = df.plot.kde()\n1431 | \n1432 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1433 |         lead to over-fitting, while using a large bandwidth value may result\n1434 |         in under-fitting:\n1435 | \n1436 |         .. plot::\n1437 |             :context: close-figs\n1438 | \n1439 |             >>> ax = df.plot.kde(bw_method=0.3)\n1440 | \n1441 |         .. plot::\n1442 |             :context: close-figs\n1443 | \n1444 |             >>> ax = df.plot.kde(bw_method=3)\n1445 | \n1446 |         Finally, the `ind` parameter determines the evaluation points for the\n1447 |         plot of the estimated PDF:\n1448 | \n1449 |         .. plot::\n1450 |             :context: close-figs\n1451 | \n1452 |             >>> ax = df.plot.kde(ind=[1, 2, 3, 4, 5, 6])\n1453 |         \"\"\"\n1454 |         return self(kind=\"kde\", bw_method=bw_method, ind=ind, **kwargs)\n1455 | \n1456 |     density = kde\n1457 | \n1458 |     def area(self, x=None, y=None, **kwargs):\n1459 |         \"\"\"\n1460 |         Draw a stacked area plot.\n1461 | \n1462 |         An area plot displays quantitative data visually.\n1463 |         This function wraps the matplotlib area function.\n1464 | \n1465 |         Parameters\n1466 |         ----------\n1467 |         x : label or position, optional\n1468 |             Coordinates for the X axis. By default uses the index.\n1469 |         y : label or position, optional\n1470 |             Column to plot. By default uses all columns.\n1471 |         stacked : bool, default True\n1472 |             Area plots are stacked by default. Set to False to create a\n1473 |             unstacked plot.\n1474 |         **kwargs\n1475 |             Additional keyword arguments are documented in\n1476 |             :meth:`DataFrame.plot`.\n1477 | \n1478 |         Returns\n1479 |         -------\n1480 |         matplotlib.axes.Axes or numpy.ndarray\n1481 |             Area plot, or array of area plots if subplots is True.\n1482 | \n1483 |         See Also\n1484 |         --------\n1485 |         DataFrame.plot : Make plots of DataFrame using matplotlib / pylab.\n1486 | \n1487 |         Examples\n1488 |         --------\n1489 |         Draw an area plot based on basic business metrics:\n1490 | \n1491 |         .. plot::\n1492 |             :context: close-figs\n1493 | \n1494 |             >>> df = pd.DataFrame({\n1495 |             ...     'sales': [3, 2, 3, 9, 10, 6],\n1496 |             ...     'signups': [5, 5, 6, 12, 14, 13],\n1497 |             ...     'visits': [20, 42, 28, 62, 81, 50],\n1498 |             ... }, index=pd.date_range(start='2018/01/01', end='2018/07/01',\n1499 |             ...                        freq='M'))\n1500 |             >>> ax = df.plot.area()\n1501 | \n1502 |         Area plots are stacked by default. To produce an unstacked plot,\n1503 |         pass ``stacked=False``:\n1504 | \n1505 |         .. plot::\n1506 |             :context: close-figs\n1507 | \n1508 |             >>> ax = df.plot.area(stacked=False)\n1509 | \n1510 |         Draw an area plot for a single column:\n1511 | \n1512 |         .. plot::\n1513 |             :context: close-figs\n1514 | \n1515 |             >>> ax = df.plot.area(y='sales')\n1516 | \n1517 |         Draw with a different `x`:\n1518 | \n1519 |         .. plot::\n1520 |             :context: close-figs\n1521 | \n1522 |             >>> df = pd.DataFrame({\n1523 |             ...     'sales': [3, 2, 3],\n1524 |             ...     'visits': [20, 42, 28],\n1525 |             ...     'day': [1, 2, 3],\n1526 |             ... })\n1527 |             >>> ax = df.plot.area(x='day')\n1528 |         \"\"\"\n1529 |         return self(kind=\"area\", x=x, y=y, **kwargs)\n1530 | \n1531 |     def pie(self, **kwargs):\n1532 |         \"\"\"\n1533 |         Generate a pie plot.\n1534 | \n1535 |         A pie plot is a proportional representation of the numerical data in a\n1536 |         column. This function wraps :meth:`matplotlib.pyplot.pie` for the\n1537 |         specified column. If no column reference is passed and\n1538 |         ``subplots=True`` a pie plot is drawn for each numerical column\n1539 |         independently.\n1540 | \n1541 |         Parameters\n1542 |         ----------\n1543 |         y : int or label, optional\n1544 |             Label or position of the column to plot.\n1545 |             If not provided, ``subplots=True`` argument must be passed.\n1546 |         **kwargs\n1547 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1548 | \n1549 |         Returns\n1550 |         -------\n1551 |         matplotlib.axes.Axes or np.ndarray of them\n1552 |             A NumPy array is returned when `subplots` is True.\n1553 | \n1554 |         See Also\n1555 |         --------\n1556 |         Series.plot.pie : Generate a pie plot for a Series.\n1557 |         DataFrame.plot : Make plots of a DataFrame.\n1558 | \n1559 |         Examples\n1560 |         --------\n1561 |         In the example below we have a DataFrame with the information about\n1562 |         planet's mass and radius. We pass the 'mass' column to the\n1563 |         pie function to get a pie plot.\n1564 | \n1565 |         .. plot::\n1566 |             :context: close-figs\n1567 | \n1568 |             >>> df = pd.DataFrame({'mass': [0.330, 4.87 , 5.97],\n1569 |             ...                    'radius': [2439.7, 6051.8, 6378.1]},\n1570 |             ...                   index=['Mercury', 'Venus', 'Earth'])\n1571 |             >>> plot = df.plot.pie(y='mass', figsize=(5, 5))\n1572 | \n1573 |         .. plot::\n1574 |             :context: close-figs\n1575 | \n1576 |             >>> plot = df.plot.pie(subplots=True, figsize=(11, 6))\n1577 |         \"\"\"\n1578 |         if (\n1579 |             isinstance(self._parent, ABCDataFrame)\n1580 |             and kwargs.get(\"y\", None) is None\n1581 |             and not kwargs.get(\"subplots\", False)\n1582 |         ):\n1583 |             raise ValueError(\"pie requires either y column or 'subplots=True'\")\n1584 |         return self(kind=\"pie\", **kwargs)\n1585 | \n1586 |     def scatter(self, x, y, s=None, c=None, **kwargs):\n1587 |         \"\"\"\n1588 |         Create a scatter plot with varying marker point size and color.\n1589 | \n1590 |         The coordinates of each point are defined by two dataframe columns and\n1591 |         filled circles are used to represent each point. This kind of plot is\n1592 |         useful to see complex correlations between two variables. Points could\n1593 |         be for instance natural 2D coordinates like longitude and latitude in\n1594 |         a map or, in general, any pair of metrics that can be plotted against\n1595 |         each other.\n1596 | \n1597 |         Parameters\n1598 |         ----------\n1599 |         x : int or str\n1600 |             The column name or column position to be used as horizontal\n1601 |             coordinates for each point.\n1602 |         y : int or str\n1603 |             The column name or column position to be used as vertical\n1604 |             coordinates for each point.\n1605 |         s : str, scalar or array-like, optional\n1606 |             The size of each point. Possible values are:\n1607 | \n1608 |             - A string with the name of the column to be used for marker's size.\n1609 | \n1610 |             - A single scalar so all points have the same size.\n1611 | \n1612 |             - A sequence of scalars, which will be used for each point's size\n1613 |               recursively. For instance, when passing [2,14] all points size\n1614 |               will be either 2 or 14, alternatively.\n1615 | \n1616 |               .. versionchanged:: 1.1.0\n1617 | \n1618 |         size : str, scalar or array-like, optional\n1619 |             Alias for s.\n1620 | \n1621 |             .. versionadded:: 1.5.0\n1622 | \n1623 |         c : str, int or array-like, optional\n1624 |             The color of each point. Possible values are:\n1625 | \n1626 |             - A single color string referred to by name, RGB or RGBA code,\n1627 |               for instance 'red' or '#a98d19'.\n1628 | \n1629 |             - A sequence of color strings referred to by name, RGB or RGBA\n1630 |               code, which will be used for each point's color recursively. For\n1631 |               instance ['green','yellow'] all points will be filled in green or\n1632 |               yellow, alternatively.\n1633 | \n1634 |             - A column name or position whose values will be used to color the\n1635 |               marker points according to a colormap.\n1636 |         color : str, int or array-like, optional\n1637 |             Alias for c.\n1638 | \n1639 |             .. versionadded:: 1.5.0\n1640 | \n1641 |         **kwargs\n1642 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1643 | \n1644 |         Returns\n1645 |         -------\n1646 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1647 | \n1648 |         See Also\n1649 |         --------\n1650 |         matplotlib.pyplot.scatter : Scatter plot using multiple input data\n1651 |             formats.\n1652 | \n1653 |         Examples\n1654 |         --------\n1655 |         Let's see how to draw a scatter plot using coordinates from the values\n1656 |         in a DataFrame's columns.\n1657 | \n1658 |         .. plot::\n1659 |             :context: close-figs\n1660 | \n1661 |             >>> df = pd.DataFrame([[5.1, 3.5, 0], [4.9, 3.0, 0], [7.0, 3.2, 1],\n1662 |             ...                    [6.4, 3.2, 1], [5.9, 3.0, 2]],\n1663 |             ...                   columns=['length', 'width', 'species'])\n1664 |             >>> ax1 = df.plot.scatter(x='length',\n1665 |             ...                       y='width',\n1666 |             ...                       c='DarkBlue')\n1667 | \n1668 |         And now with the color determined by a column as well.\n1669 | \n1670 |         .. plot::\n1671 |             :context: close-figs\n1672 | \n1673 |             >>> ax2 = df.plot.scatter(x='length',\n1674 |             ...                       y='width',\n1675 |             ...                       c='species',\n1676 |             ...                       colormap='viridis')\n1677 |         \"\"\"\n1678 |         size = kwargs.pop(\"size\", None)\n1679 |         if s is not None and size is not None:\n1680 |             raise TypeError(\"Specify exactly one of `s` and `size`\")\n1681 |         elif s is not None or size is not None:\n1682 |             kwargs[\"s\"] = s if s is not None else size\n1683 | \n1684 |         color = kwargs.pop(\"color\", None)\n1685 |         if c is not None and color is not None:\n1686 |             raise TypeError(\"Specify exactly one of `c` and `color`\")\n1687 |         elif c is not None or color is not None:\n1688 |             kwargs[\"c\"] = c if c is not None else color\n1689 | \n1690 |         return self(kind=\"scatter\", x=x, y=y, **kwargs)\n1691 | \n1692 |     def hexbin(self, x, y, C=None, reduce_C_function=None, gridsize=None, **kwargs):\n1693 |         \"\"\"\n1694 |         Generate a hexagonal binning plot.\n1695 | \n1696 |         Generate a hexagonal binning plot of `x` versus `y`. If `C` is `None`\n1697 |         (the default), this is a histogram of the number of occurrences\n1698 |         of the observations at ``(x[i], y[i])``.\n1699 | \n1700 |         If `C` is specified, specifies values at given coordinates\n1701 |         ``(x[i], y[i])``. These values are accumulated for each hexagonal\n1702 |         bin and then reduced according to `reduce_C_function`,\n1703 |         having as default the NumPy's mean function (:meth:`numpy.mean`).\n1704 |         (If `C` is specified, it must also be a 1-D sequence\n1705 |         of the same length as `x` and `y`, or a column label.)\n1706 | \n1707 |         Parameters\n1708 |         ----------\n1709 |         x : int or str\n1710 |             The column label or position for x points.\n1711 |         y : int or str\n1712 |             The column label or position for y points.\n1713 |         C : int or str, optional\n1714 |             The column label or position for the value of `(x, y)` point.\n1715 |         reduce_C_function : callable, default `np.mean`\n1716 |             Function of one argument that reduces all the values in a bin to\n1717 |             a single number (e.g. `np.mean`, `np.max`, `np.sum`, `np.std`).\n1718 |         gridsize : int or tuple of (int, int), default 100\n1719 |             The number of hexagons in the x-direction.\n1720 |             The corresponding number of hexagons in the y-direction is\n1721 |             chosen in a way that the hexagons are approximately regular.\n1722 |             Alternatively, gridsize can be a tuple with two elements\n1723 |             specifying the number of hexagons in the x-direction and the\n1724 |             y-direction.\n1725 |         **kwargs\n1726 |             Additional keyword arguments are documented in\n1727 |             :meth:`DataFrame.plot`.\n1728 | \n1729 |         Returns\n1730 |         -------\n1731 |         matplotlib.AxesSubplot\n1732 |             The matplotlib ``Axes`` on which the hexbin is plotted.\n1733 | \n1734 |         See Also\n1735 |         --------\n1736 |         DataFrame.plot : Make plots of a DataFrame.\n1737 |         matplotlib.pyplot.hexbin : Hexagonal binning plot using matplotlib,\n1738 |             the matplotlib function that is used under the hood.\n1739 | \n1740 |         Examples\n1741 |         --------\n1742 |         The following examples are generated with random data from\n1743 |         a normal distribution.\n1744 | \n1745 |         .. plot::\n1746 |             :context: close-figs\n1747 | \n1748 |             >>> n = 10000\n1749 |             >>> df = pd.DataFrame({'x': np.random.randn(n),\n1750 |             ...                    'y': np.random.randn(n)})\n1751 |             >>> ax = df.plot.hexbin(x='x', y='y', gridsize=20)\n1752 | \n1753 |         The next example uses `C` and `np.sum` as `reduce_C_function`.\n1754 |         Note that `'observations'` values ranges from 1 to 5 but the result\n1755 |         plot shows values up to more than 25. This is because of the\n1756 |         `reduce_C_function`.\n1757 | \n1758 |         .. plot::\n1759 |             :context: close-figs\n1760 | \n1761 |             >>> n = 500\n1762 |             >>> df = pd.DataFrame({\n1763 |             ...     'coord_x': np.random.uniform(-3, 3, size=n),\n1764 |             ...     'coord_y': np.random.uniform(30, 50, size=n),\n1765 |             ...     'observations': np.random.randint(1,5, size=n)\n1766 |             ...     })\n1767 |             >>> ax = df.plot.hexbin(x='coord_x',\n1768 |             ...                     y='coord_y',\n1769 |             ...                     C='observations',\n1770 |             ...                     reduce_C_function=np.sum,\n1771 |             ...                     gridsize=10,\n1772 |             ...                     cmap=\"viridis\")\n1773 |         \"\"\"\n1774 |         if reduce_C_function is not None:\n1775 |             kwargs[\"reduce_C_function\"] = reduce_C_function\n1776 |         if gridsize is not None:\n1777 |             kwargs[\"gridsize\"] = gridsize\n1778 | \n1779 |         return self(kind=\"hexbin\", x=x, y=y, C=C, **kwargs)\n```\n\n\n##Searching for entity `pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots`...\n### Search Result:\nFound function `pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots`.\nSource: Exact match found for entity name `pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots`.\n```\n372 | def _setup_subplots(self):\n373 |         if self.subplots:\n374 |             fig, axes = create_subplots(\n375 |                 naxes=self.nseries,\n376 |                 sharex=self.sharex,\n377 |                 sharey=self.sharey,\n378 |                 figsize=self.figsize,\n379 |                 ax=self.ax,\n380 |                 layout=self.layout,\n381 |                 layout_type=self._layout_type,\n382 |             )\n383 |         else:\n384 |             if self.ax is None:\n385 |                 fig = self.plt.figure(figsize=self.figsize)\n386 |                 axes = fig.add_subplot(111)\n387 |             else:\n388 |                 fig = self.ax.get_figure()\n389 |                 if self.figsize is not None:\n390 |                     fig.set_size_inches(self.figsize)\n391 |                 axes = self.ax\n392 | \n393 |         axes = flatten_axes(axes)\n394 | \n395 |         valid_log = {False, True, \"sym\", None}\n396 |         input_log = {self.logx, self.logy, self.loglog}\n397 |         if input_log - valid_log:\n398 |             invalid_log = next(iter(input_log - valid_log))\n399 |             raise ValueError(\n400 |                 f\"Boolean, None and 'sym' are valid options, '{invalid_log}' is given.\"\n401 |             )\n402 | \n403 |         if self.logx is True or self.loglog is True:\n404 |             [a.set_xscale(\"log\") for a in axes]\n405 |         elif self.logx == \"sym\" or self.loglog == \"sym\":\n406 |             [a.set_xscale(\"symlog\") for a in axes]\n407 | \n408 |         if self.logy is True or self.loglog is True:\n409 |             [a.set_yscale(\"log\") for a in axes]\n410 |         elif self.logy == \"sym\" or self.loglog == \"sym\":\n411 |             [a.set_yscale(\"symlog\") for a in axes]\n412 | \n413 |         self.fig = fig\n414 |         self.axes = axes\n```\n"}, {"content": "Based on the provided search results, the following files, classes, and functions are relevant for implementing the requested feature:\n\n```\npandas/plotting/_core.py\nclass: PlotAccessor\nfunction: __call__\n\npandas/plotting/_matplotlib/core.py\nfunction: MPLPlot._setup_subplots\n\npandas/plotting/_matplotlib/core.py\nfunction: MPLPlot._adorn_subplots\n\npandas/plotting/_matplotlib/tools.py\nfunction: create_subplots\n\npandas/plotting/_matplotlib/tools.py\nfunction: _get_layout\n```\n\n<finish></finish>", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 103985, "completion_tokens": 479}, "time": 57.087059020996094}]}}
{"instance_id": "scikit-learn__scikit-learn-16948", "found_files": [["sklearn/decomposition/_nmf.py"]], "found_modules": [["sklearn/decomposition/_nmf.py:NMF", "sklearn/decomposition/_nmf.py:_fit_multiplicative_update", "sklearn/decomposition/_nmf.py:_beta_divergence", "sklearn/decomposition/_nmf.py:_multiplicative_update_w", "sklearn/decomposition/_nmf.py:_multiplicative_update_h"]], "found_entities": [["sklearn/decomposition/_nmf.py:NMF.fit_transform", "sklearn/decomposition/_nmf.py:_fit_multiplicative_update", "sklearn/decomposition/_nmf.py:_beta_divergence", "sklearn/decomposition/_nmf.py:_multiplicative_update_w", "sklearn/decomposition/_nmf.py:_multiplicative_update_h"]], "raw_output_loc": ["Based on the contents of `_nmf.py`, we need to focus on the parts of the code that deal with the NMF solver, particularly the multiplicative update solver and the beta-divergence calculations. The feature request mentions an online implementation of NMF that should support any beta divergence, not just Kullback-Leibler. \n\nLet's identify specific functions and classes that are relevant for implementing this feature:\n\n1. **NMF Class**: The main class for Non-negative Matrix Factorization.\n2. **_fit_multiplicative_update Function**: Handles the multiplicative update solver.\n3. **_beta_divergence Function**: Computes the beta-divergence between X and the dot product WH.\n4. **_multiplicative_update_w Function**: Updates W in the multiplicative update solver.\n5. **_multiplicative_update_h Function**: Updates H in the multiplicative update solver.\n\nWe'll also need to look at how the solver and beta divergence are handled within the `fit_transform` method of the `NMF` class.\n\nLet's start by listing the locations for these entities.\n\n```\nsklearn/decomposition/_nmf.py\nclass: NMF\nfunction: fit_transform\n\nsklearn/decomposition/_nmf.py\nfunction: _fit_multiplicative_update\n\nsklearn/decomposition/_nmf.py\nfunction: _beta_divergence\n\nsklearn/decomposition/_nmf.py\nfunction: _multiplicative_update_w\n\nsklearn/decomposition/_nmf.py\nfunction: _multiplicative_update_h\n```"], "meta_data": {"repo": "scikit-learn/scikit-learn", "base_commit": "7d93ca87ea14ef8f16be43d75cff72d05f48f7ed", "problem_statement": "Online implementation of Non-negative Matrix Factorizarion (NMF)\n<!--\r\nIf your issue is a usage question, submit it here instead:\r\n- StackOverflow with the scikit-learn tag: https://stackoverflow.com/questions/tagged/scikit-learn\r\n- Mailing List: https://mail.python.org/mailman/listinfo/scikit-learn\r\nFor more information, see User Questions: http://scikit-learn.org/stable/support.html#user-questions\r\n-->\r\n\r\n<!-- Instructions For Filing a Bug: https://github.com/scikit-learn/scikit-learn/blob/master/CONTRIBUTING.md#filing-bugs -->\r\n\r\n#### Description\r\n<!-- Example: Joblib Error thrown when calling fit on LatentDirichletAllocation with evaluate_every > 0-->\r\n@GaelVaroquaux Maybe an online version of the NMF could be useful in big data settings.\r\n\r\n#### Steps/Code to Reproduce\r\n<!--\r\nExample:\r\n```python\r\nfrom sklearn.feature_extraction.text import CountVectorizer\r\nfrom sklearn.decomposition import LatentDirichletAllocation\r\n\r\ndocs = [\"Help I have a bug\" for i in range(1000)]\r\n\r\nvectorizer = CountVectorizer(input=docs, analyzer='word')\r\nlda_features = vectorizer.fit_transform(docs)\r\n\r\nlda_model = LatentDirichletAllocation(\r\n    n_topics=10,\r\n    learning_method='online',\r\n    evaluate_every=10,\r\n    n_jobs=4,\r\n)\r\nmodel = lda_model.fit(lda_features)\r\n```\r\nIf the code is too long, feel free to put it in a public gist and link\r\nit in the issue: https://gist.github.com\r\n-->\r\n\r\n#### Expected Results\r\n<!-- Example: No error is thrown. Please paste or describe the expected results.-->\r\n\r\n#### Actual Results\r\n<!-- Please paste or specifically describe the actual output or traceback. -->\r\nHere I show the results for an sparse matrix as input of size 1M x 2.8k\r\nThe factorization has `n_components = 10` and each point is an entire pass on the data.\r\nThe current online implementation only supports the kullback-leibler divergence, but in practice\r\ncan be generalized to any beta divergence.\r\n\r\n![batch_vs_online_nmf](https://user-images.githubusercontent.com/11759948/53494592-69748b00-3a9e-11e9-8cc8-ce53ce3fe7f2.png)\r\n\r\n#### Versions\r\n<!--\r\nPlease run the following snippet and paste the output below.\r\nFor scikit-learn >= 0.20:\r\nimport sklearn; sklearn.show_versions()\r\nFor scikit-learn < 0.20:\r\nimport platform; print(platform.platform())\r\nimport sys; print(\"Python\", sys.version)\r\nimport numpy; print(\"NumPy\", numpy.__version__)\r\nimport scipy; print(\"SciPy\", scipy.__version__)\r\nimport sklearn; print(\"Scikit-Learn\", sklearn.__version__)\r\n-->\r\n\r\n\r\n<!-- Thanks for contributing! -->\r\n\nDraft implementation of MiniBatchNMF\n<!--\r\nThanks for contributing a pull request! Please ensure you have taken a look at\r\nthe contribution guidelines: https://github.com/scikit-learn/scikit-learn/blob/master/CONTRIBUTING.md#pull-request-checklist\r\n-->\r\n\r\n#### Reference Issues/PRs\r\n<!--\r\nExample: Fixes #1234. See also #3456.\r\nPlease use keywords (e.g., Fixes) to create link to the issues or pull requests\r\nyou resolved, so that they will automatically be closed when your pull request\r\nis merged. See https://github.com/blog/1506-closing-issues-via-pull-requests\r\n-->\r\n\r\n\r\n#### What does this implement/fix? Explain your changes.\r\n\r\nImplementation of a mini-batch NMF with multiplicative updates.\r\n#13308 \r\n#### Any other comments?\r\n\r\n\r\n<!--\r\nPlease be aware that we are a loose team of volunteers so patience is\r\nnecessary; assistance handling other issues is very welcome. We value\r\nall user contributions, no matter how minor they are. If we are slow to\r\nreview, either the pull request needs some benchmarking, tinkering,\r\nconvincing, etc. or more likely the reviewers are simply busy. In either\r\ncase, we ask for your understanding during the review process.\r\nFor more information, see our FAQ on this topic:\r\nhttp://scikit-learn.org/dev/faq.html#why-is-my-pull-request-not-getting-any-attention.\r\n\r\nThanks for contributing!\r\n-->\r\n\n", "patch": "diff --git a/doc/computing/scaling_strategies.rst b/doc/computing/scaling_strategies.rst\nindex 5eee5728e4b9a..277d499f4cc13 100644\n--- a/doc/computing/scaling_strategies.rst\n+++ b/doc/computing/scaling_strategies.rst\n@@ -80,6 +80,7 @@ Here is a list of incremental estimators for different tasks:\n       + :class:`sklearn.decomposition.MiniBatchDictionaryLearning`\n       + :class:`sklearn.decomposition.IncrementalPCA`\n       + :class:`sklearn.decomposition.LatentDirichletAllocation`\n+      + :class:`sklearn.decomposition.MiniBatchNMF`\n   - Preprocessing\n       + :class:`sklearn.preprocessing.StandardScaler`\n       + :class:`sklearn.preprocessing.MinMaxScaler`\ndiff --git a/doc/modules/classes.rst b/doc/modules/classes.rst\nindex 9640f176925c5..a4217ad44cd76 100644\n--- a/doc/modules/classes.rst\n+++ b/doc/modules/classes.rst\n@@ -319,6 +319,7 @@ Samples generator\n    decomposition.MiniBatchDictionaryLearning\n    decomposition.MiniBatchSparsePCA\n    decomposition.NMF\n+   decomposition.MiniBatchNMF\n    decomposition.PCA\n    decomposition.SparsePCA\n    decomposition.SparseCoder\ndiff --git a/doc/modules/decomposition.rst b/doc/modules/decomposition.rst\nindex dd8fac301ceed..4f6a889473f13 100644\n--- a/doc/modules/decomposition.rst\n+++ b/doc/modules/decomposition.rst\n@@ -921,6 +921,29 @@ stored components::\n     * :ref:`sphx_glr_auto_examples_applications_plot_topics_extraction_with_nmf_lda.py`\n     * :ref:`sphx_glr_auto_examples_decomposition_plot_beta_divergence.py`\n \n+.. _MiniBatchNMF:\n+\n+Mini-batch Non Negative Matrix Factorization\n+--------------------------------------------\n+\n+:class:`MiniBatchNMF` [7]_ implements a faster, but less accurate version of the\n+non negative matrix factorization (i.e. :class:`~sklearn.decomposition.NMF`),\n+better suited for large datasets.\n+\n+By default, :class:`MiniBatchNMF` divides the data into mini-batches and\n+optimizes the NMF model in an online manner by cycling over the mini-batches\n+for the specified number of iterations. The ``batch_size`` parameter controls\n+the size of the batches.\n+\n+In order to speed up the mini-batch algorithm it is also possible to scale\n+past batches, giving them less importance than newer batches. This is done\n+introducing a so-called forgetting factor controlled by the ``forget_factor``\n+parameter.\n+\n+The estimator also implements ``partial_fit``, which updates ``H`` by iterating\n+only once over a mini-batch. This can be used for online learning when the data\n+is not readily available from the start, or when the data does not fit into memory.\n+\n .. topic:: References:\n \n     .. [1] `\"Learning the parts of objects by non-negative matrix factorization\"\n@@ -945,6 +968,9 @@ stored components::\n            the beta-divergence\" <1010.1763>`\n            C. Fevotte, J. Idier, 2011\n \n+    .. [7] :arxiv:`\"Online algorithms for nonnegative matrix factorization with the\n+       Itakura-Saito divergence\" <1106.4198>`\n+       A. Lefevre, F. Bach, C. Fevotte, 2011\n \n .. _LatentDirichletAllocation:\n \ndiff --git a/doc/whats_new/v1.1.rst b/doc/whats_new/v1.1.rst\nindex 3dc5799c228ad..0acd0612dd0c7 100644\n--- a/doc/whats_new/v1.1.rst\n+++ b/doc/whats_new/v1.1.rst\n@@ -288,6 +288,11 @@ Changelog\n :mod:`sklearn.decomposition`\n ............................\n \n+- |MajorFeature| Added a new estimator :class:`decomposition.MiniBatchNMF`. It is a\n+  faster but less accurate version of non-negative matrix factorization, better suited\n+  for large datasets. :pr:`16948` by :user:`Chiara Marmo <cmarmo>`,\n+  :user:`Patricio Cerda <pcerda>` and :user:`J\u00e9r\u00e9mie du Boisberranger <jeremiedbb>`. \n+\n - |Enhancement| :class:`decomposition.PCA` exposes a parameter `n_oversamples` to tune\n   :func:`sklearn.decomposition.randomized_svd` and\n   get accurate results when the number of features is large.\ndiff --git a/examples/applications/plot_topics_extraction_with_nmf_lda.py b/examples/applications/plot_topics_extraction_with_nmf_lda.py\nindex 48b69d710226b..38945241ab68b 100644\n--- a/examples/applications/plot_topics_extraction_with_nmf_lda.py\n+++ b/examples/applications/plot_topics_extraction_with_nmf_lda.py\n@@ -30,13 +30,15 @@\n import matplotlib.pyplot as plt\n \n from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\n-from sklearn.decomposition import NMF, LatentDirichletAllocation\n+from sklearn.decomposition import NMF, MiniBatchNMF, LatentDirichletAllocation\n from sklearn.datasets import fetch_20newsgroups\n \n n_samples = 2000\n n_features = 1000\n n_components = 10\n n_top_words = 20\n+batch_size = 128\n+init = \"nndsvda\"\n \n \n def plot_top_words(model, feature_names, n_top_words, title):\n@@ -101,7 +103,15 @@ def plot_top_words(model, feature_names, n_top_words, title):\n     \"n_samples=%d and n_features=%d...\" % (n_samples, n_features)\n )\n t0 = time()\n-nmf = NMF(n_components=n_components, random_state=1, alpha=0.1, l1_ratio=0.5).fit(tfidf)\n+nmf = NMF(\n+    n_components=n_components,\n+    random_state=1,\n+    init=init,\n+    beta_loss=\"frobenius\",\n+    alpha_W=0.00005,\n+    alpha_H=0.00005,\n+    l1_ratio=1,\n+).fit(tfidf)\n print(\"done in %0.3fs.\" % (time() - t0))\n \n \n@@ -121,10 +131,12 @@ def plot_top_words(model, feature_names, n_top_words, title):\n nmf = NMF(\n     n_components=n_components,\n     random_state=1,\n+    init=init,\n     beta_loss=\"kullback-leibler\",\n     solver=\"mu\",\n     max_iter=1000,\n-    alpha=0.1,\n+    alpha_W=0.00005,\n+    alpha_H=0.00005,\n     l1_ratio=0.5,\n ).fit(tfidf)\n print(\"done in %0.3fs.\" % (time() - t0))\n@@ -137,6 +149,63 @@ def plot_top_words(model, feature_names, n_top_words, title):\n     \"Topics in NMF model (generalized Kullback-Leibler divergence)\",\n )\n \n+# Fit the MiniBatchNMF model\n+print(\n+    \"\\n\" * 2,\n+    \"Fitting the MiniBatchNMF model (Frobenius norm) with tf-idf \"\n+    \"features, n_samples=%d and n_features=%d, batch_size=%d...\"\n+    % (n_samples, n_features, batch_size),\n+)\n+t0 = time()\n+mbnmf = MiniBatchNMF(\n+    n_components=n_components,\n+    random_state=1,\n+    batch_size=batch_size,\n+    init=init,\n+    beta_loss=\"frobenius\",\n+    alpha_W=0.00005,\n+    alpha_H=0.00005,\n+    l1_ratio=0.5,\n+).fit(tfidf)\n+print(\"done in %0.3fs.\" % (time() - t0))\n+\n+\n+tfidf_feature_names = tfidf_vectorizer.get_feature_names_out()\n+plot_top_words(\n+    mbnmf,\n+    tfidf_feature_names,\n+    n_top_words,\n+    \"Topics in MiniBatchNMF model (Frobenius norm)\",\n+)\n+\n+# Fit the MiniBatchNMF model\n+print(\n+    \"\\n\" * 2,\n+    \"Fitting the MiniBatchNMF model (generalized Kullback-Leibler \"\n+    \"divergence) with tf-idf features, n_samples=%d and n_features=%d, \"\n+    \"batch_size=%d...\" % (n_samples, n_features, batch_size),\n+)\n+t0 = time()\n+mbnmf = MiniBatchNMF(\n+    n_components=n_components,\n+    random_state=1,\n+    batch_size=batch_size,\n+    init=init,\n+    beta_loss=\"kullback-leibler\",\n+    alpha_W=0.00005,\n+    alpha_H=0.00005,\n+    l1_ratio=0.5,\n+).fit(tfidf)\n+print(\"done in %0.3fs.\" % (time() - t0))\n+\n+tfidf_feature_names = tfidf_vectorizer.get_feature_names_out()\n+plot_top_words(\n+    mbnmf,\n+    tfidf_feature_names,\n+    n_top_words,\n+    \"Topics in MiniBatchNMF model (generalized Kullback-Leibler divergence)\",\n+)\n+\n print(\n     \"\\n\" * 2,\n     \"Fitting LDA models with tf features, n_samples=%d and n_features=%d...\"\ndiff --git a/sklearn/decomposition/__init__.py b/sklearn/decomposition/__init__.py\nindex c280aeb2cf71d..c5f323d3c5d72 100644\n--- a/sklearn/decomposition/__init__.py\n+++ b/sklearn/decomposition/__init__.py\n@@ -5,7 +5,11 @@\n \"\"\"\n \n \n-from ._nmf import NMF, non_negative_factorization\n+from ._nmf import (\n+    NMF,\n+    MiniBatchNMF,\n+    non_negative_factorization,\n+)\n from ._pca import PCA\n from ._incremental_pca import IncrementalPCA\n from ._kernel_pca import KernelPCA\n@@ -31,6 +35,7 @@\n     \"IncrementalPCA\",\n     \"KernelPCA\",\n     \"MiniBatchDictionaryLearning\",\n+    \"MiniBatchNMF\",\n     \"MiniBatchSparsePCA\",\n     \"NMF\",\n     \"PCA\",\ndiff --git a/sklearn/decomposition/_nmf.py b/sklearn/decomposition/_nmf.py\nindex 443f9c4be1649..7623822ba5912 100644\n--- a/sklearn/decomposition/_nmf.py\n+++ b/sklearn/decomposition/_nmf.py\n@@ -10,14 +10,16 @@\n import numpy as np\n import scipy.sparse as sp\n import time\n+import itertools\n import warnings\n from math import sqrt\n+from scipy import linalg\n \n from ._cdnmf_fast import _update_cdnmf_fast\n from .._config import config_context\n from ..base import BaseEstimator, TransformerMixin, _ClassNamePrefixFeaturesOutMixin\n from ..exceptions import ConvergenceWarning\n-from ..utils import check_random_state, check_array\n+from ..utils import check_random_state, check_array, gen_batches\n from ..utils.extmath import randomized_svd, safe_sparse_dot, squared_norm\n from ..utils.validation import (\n     check_is_fitted,\n@@ -30,7 +32,7 @@\n def norm(x):\n     \"\"\"Dot product-based Euclidean norm implementation.\n \n-    See: http://fseoane.net/blog/2011/computing-the-vector-norm/\n+    See: http://fa.bianp.net/blog/2011/computing-the-vector-norm/\n \n     Parameters\n     ----------\n@@ -166,6 +168,7 @@ def _beta_divergence(X, W, H, beta, square_root=False):\n         res /= beta * (beta - 1)\n \n     if square_root:\n+        res = max(res, 0)  # avoid negative number due to rounding errors\n         return np.sqrt(2 * res)\n     else:\n         return res\n@@ -493,10 +496,10 @@ def _fit_coordinate_descent(\n \n     References\n     ----------\n-    Cichocki, Andrzej, and Phan, Anh-Huy. \"Fast local algorithms for\n-    large scale nonnegative matrix and tensor factorizations.\"\n-    IEICE transactions on fundamentals of electronics, communications and\n-    computer sciences 92.3: 708-721, 2009.\n+    .. [1] :doi:`\"Fast local algorithms for large scale nonnegative matrix and tensor\n+       factorizations\" <10.1587/transfun.E92.A.708>`\n+       Cichocki, Andrzej, and P. H. A. N. Anh-Huy. IEICE transactions on fundamentals\n+       of electronics, communications and computer sciences 92.3: 708-721, 2009.\n     \"\"\"\n     # so W and Ht are both in C order in memory\n     Ht = check_array(H.T, order=\"C\")\n@@ -637,11 +640,15 @@ def _multiplicative_update_w(\n     if gamma != 1:\n         delta_W **= gamma\n \n-    return delta_W, H_sum, HHt, XHt\n+    W *= delta_W\n \n+    return W, H_sum, HHt, XHt\n \n-def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n-    \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n+\n+def _multiplicative_update_h(\n+    X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma, A=None, B=None, rho=None\n+):\n+    \"\"\"update H in Multiplicative Update NMF.\"\"\"\n     if beta_loss == 2:\n         numerator = safe_sparse_dot(W.T, X)\n         denominator = np.linalg.multi_dot([W.T, W, H])\n@@ -712,14 +719,27 @@ def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n         denominator = denominator + l2_reg_H * H\n     denominator[denominator == 0] = EPSILON\n \n-    numerator /= denominator\n-    delta_H = numerator\n-\n-    # gamma is in ]0, 1]\n-    if gamma != 1:\n-        delta_H **= gamma\n+    if A is not None and B is not None:\n+        # Updates for the online nmf\n+        if gamma != 1:\n+            H **= 1 / gamma\n+        numerator *= H\n+        A *= rho\n+        B *= rho\n+        A += numerator\n+        B += denominator\n+        H = A / B\n+\n+        if gamma != 1:\n+            H **= gamma\n+    else:\n+        delta_H = numerator\n+        delta_H /= denominator\n+        if gamma != 1:\n+            delta_H **= gamma\n+        H *= delta_H\n \n-    return delta_H\n+    return H\n \n \n def _fit_multiplicative_update(\n@@ -800,6 +820,8 @@ def _fit_multiplicative_update(\n \n     References\n     ----------\n+    Lee, D. D., & Seung, H., S. (2001). Algorithms for Non-negative Matrix\n+    Factorization. Adv. Neural Inform. Process. Syst.. 13.\n     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n     factorization with the beta-divergence. Neural Computation, 23(9).\n     \"\"\"\n@@ -823,21 +845,35 @@ def _fit_multiplicative_update(\n     for n_iter in range(1, max_iter + 1):\n         # update W\n         # H_sum, HHt and XHt are saved and reused if not update_H\n-        delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n-            X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n+        W, H_sum, HHt, XHt = _multiplicative_update_w(\n+            X,\n+            W,\n+            H,\n+            beta_loss=beta_loss,\n+            l1_reg_W=l1_reg_W,\n+            l2_reg_W=l2_reg_W,\n+            gamma=gamma,\n+            H_sum=H_sum,\n+            HHt=HHt,\n+            XHt=XHt,\n+            update_H=update_H,\n         )\n-        W *= delta_W\n \n         # necessary for stability with beta_loss < 1\n         if beta_loss < 1:\n             W[W < np.finfo(np.float64).eps] = 0.0\n \n-        # update H\n+        # update H (only at fit or fit_transform)\n         if update_H:\n-            delta_H = _multiplicative_update_h(\n-                X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n+            H = _multiplicative_update_h(\n+                X,\n+                W,\n+                H,\n+                beta_loss=beta_loss,\n+                l1_reg_H=l1_reg_H,\n+                l2_reg_H=l2_reg_H,\n+                gamma=gamma,\n             )\n-            H *= delta_H\n \n             # These values will be recomputed since H changed\n             H_sum, HHt, XHt = None, None, None\n@@ -902,15 +938,16 @@ def non_negative_factorization(\n \n         .. math::\n \n-            0.5 * ||X - WH||_{loss}^2\n+            L(W, H) &= 0.5 * ||X - WH||_{loss}^2\n+\n+            &+ alpha\\\\_W * l1\\\\_ratio * n\\\\_features * ||vec(W)||_1\n \n-            + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n+            &+ alpha\\\\_H * l1\\\\_ratio * n\\\\_samples * ||vec(H)||_1\n \n-            + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n+            &+ 0.5 * alpha\\\\_W * (1 - l1\\\\_ratio) * n\\\\_features * ||W||_{Fro}^2\n \n-            + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n+            &+ 0.5 * alpha\\\\_H * (1 - l1\\\\_ratio) * n\\\\_samples * ||H||_{Fro}^2\n \n-            + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n \n     Where:\n \n@@ -1084,13 +1121,14 @@ def non_negative_factorization(\n \n     References\n     ----------\n-    Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n-    large scale nonnegative matrix and tensor factorizations.\"\n-    IEICE transactions on fundamentals of electronics, communications and\n-    computer sciences 92.3: 708-721, 2009.\n-\n-    Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n-    factorization with the beta-divergence. Neural Computation, 23(9).\n+    .. [1] :doi:`\"Fast local algorithms for large scale nonnegative matrix and tensor\n+       factorizations\" <10.1587/transfun.E92.A.708>`\n+       Cichocki, Andrzej, and P. H. A. N. Anh-Huy. IEICE transactions on fundamentals\n+       of electronics, communications and computer sciences 92.3: 708-721, 2009.\n+\n+    .. [2] :doi:`\"Algorithms for nonnegative matrix factorization with the\n+       beta-divergence\" <10.1162/NECO_a_00168>`\n+       Fevotte, C., & Idier, J. (2011). Neural Computation, 23(9).\n     \"\"\"\n     X = check_array(X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32])\n \n@@ -1120,23 +1158,23 @@ def non_negative_factorization(\n class NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n     \"\"\"Non-Negative Matrix Factorization (NMF).\n \n-    Find two non-negative matrices (W, H) whose product approximates the non-\n-    negative matrix X. This factorization can be used for example for\n-    dimensionality reduction, source separation or topic extraction.\n+    Find two non-negative matrices, i.e. matrices with all non-negative elements, (W, H)\n+    whose product approximates the non-negative matrix X. This factorization can be used\n+    for example for dimensionality reduction, source separation or topic extraction.\n \n     The objective function is:\n \n         .. math::\n \n-            0.5 * ||X - WH||_{loss}^2\n+            L(W, H) &= 0.5 * ||X - WH||_{loss}^2\n \n-            + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n+            &+ alpha\\\\_W * l1\\\\_ratio * n\\\\_features * ||vec(W)||_1\n \n-            + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n+            &+ alpha\\\\_H * l1\\\\_ratio * n\\\\_samples * ||vec(H)||_1\n \n-            + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n+            &+ 0.5 * alpha\\\\_W * (1 - l1\\\\_ratio) * n\\\\_features * ||W||_{Fro}^2\n \n-            + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n+            &+ 0.5 * alpha\\\\_H * (1 - l1\\\\_ratio) * n\\\\_samples * ||H||_{Fro}^2\n \n     Where:\n \n@@ -1325,13 +1363,14 @@ class NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n \n     References\n     ----------\n-    Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n-    large scale nonnegative matrix and tensor factorizations.\"\n-    IEICE transactions on fundamentals of electronics, communications and\n-    computer sciences 92.3: 708-721, 2009.\n+    .. [1] :doi:`\"Fast local algorithms for large scale nonnegative matrix and tensor\n+       factorizations\" <10.1587/transfun.E92.A.708>`\n+       Cichocki, Andrzej, and P. H. A. N. Anh-Huy. IEICE transactions on fundamentals\n+       of electronics, communications and computer sciences 92.3: 708-721, 2009.\n \n-    Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n-    factorization with the beta-divergence. Neural Computation, 23(9).\n+    .. [2] :doi:`\"Algorithms for nonnegative matrix factorization with the\n+       beta-divergence\" <10.1162/NECO_a_00168>`\n+       Fevotte, C., & Idier, J. (2011). Neural Computation, 23(9).\n \n     Examples\n     --------\n@@ -1632,7 +1671,7 @@ def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n                 random_state=self.random_state,\n             )\n         elif self.solver == \"mu\":\n-            W, H, n_iter = _fit_multiplicative_update(\n+            W, H, n_iter, *_ = _fit_multiplicative_update(\n                 X,\n                 W,\n                 H,\n@@ -1643,8 +1682,8 @@ def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n                 l1_reg_H,\n                 l2_reg_W,\n                 l2_reg_H,\n-                update_H=update_H,\n-                verbose=self.verbose,\n+                update_H,\n+                self.verbose,\n             )\n         else:\n             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n@@ -1729,3 +1768,628 @@ def inverse_transform(self, W):\n     def _n_features_out(self):\n         \"\"\"Number of transformed output features.\"\"\"\n         return self.components_.shape[0]\n+\n+\n+class MiniBatchNMF(NMF):\n+    \"\"\"Mini-Batch Non-Negative Matrix Factorization (NMF).\n+\n+    .. versionadded:: 1.1\n+\n+    Find two non-negative matrices, i.e. matrices with all non-negative elements,\n+    (`W`, `H`) whose product approximates the non-negative matrix `X`. This\n+    factorization can be used for example for dimensionality reduction, source\n+    separation or topic extraction.\n+\n+    The objective function is:\n+\n+        .. math::\n+\n+            L(W, H) &= 0.5 * ||X - WH||_{loss}^2\n+\n+            &+ alpha\\\\_W * l1\\\\_ratio * n\\\\_features * ||vec(W)||_1\n+\n+            &+ alpha\\\\_H * l1\\\\_ratio * n\\\\_samples * ||vec(H)||_1\n+\n+            &+ 0.5 * alpha\\\\_W * (1 - l1\\\\_ratio) * n\\\\_features * ||W||_{Fro}^2\n+\n+            &+ 0.5 * alpha\\\\_H * (1 - l1\\\\_ratio) * n\\\\_samples * ||H||_{Fro}^2\n+\n+    Where:\n+\n+    :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n+\n+    :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n+\n+    The generic norm :math:`||X - WH||_{loss}^2` may represent\n+    the Frobenius norm or another supported beta-divergence loss.\n+    The choice between options is controlled by the `beta_loss` parameter.\n+\n+    The objective function is minimized with an alternating minimization of `W`\n+    and `H`.\n+\n+    Note that the transformed data is named `W` and the components matrix is\n+    named `H`. In the NMF literature, the naming convention is usually the opposite\n+    since the data matrix `X` is transposed.\n+\n+    Read more in the :ref:`User Guide <MiniBatchNMF>`.\n+\n+    Parameters\n+    ----------\n+    n_components : int, default=None\n+        Number of components, if `n_components` is not set all features\n+        are kept.\n+\n+    init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n+        Method used to initialize the procedure.\n+        Valid options:\n+\n+        - `None`: 'nndsvda' if `n_components <= min(n_samples, n_features)`,\n+          otherwise random.\n+\n+        - `'random'`: non-negative random matrices, scaled with:\n+          `sqrt(X.mean() / n_components)`\n+\n+        - `'nndsvd'`: Nonnegative Double Singular Value Decomposition (NNDSVD)\n+          initialization (better for sparseness).\n+\n+        - `'nndsvda'`: NNDSVD with zeros filled with the average of X\n+          (better when sparsity is not desired).\n+\n+        - `'nndsvdar'` NNDSVD with zeros filled with small random values\n+          (generally faster, less accurate alternative to NNDSVDa\n+          for when sparsity is not desired).\n+\n+        - `'custom'`: use custom matrices `W` and `H`\n+\n+    batch_size : int, default=1024\n+        Number of samples in each mini-batch. Large batch sizes\n+        give better long-term convergence at the cost of a slower start.\n+\n+    beta_loss : float or {'frobenius', 'kullback-leibler', \\\n+            'itakura-saito'}, default='frobenius'\n+        Beta divergence to be minimized, measuring the distance between `X`\n+        and the dot product `WH`. Note that values different from 'frobenius'\n+        (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n+        fits. Note that for `beta_loss <= 0` (or 'itakura-saito'), the input\n+        matrix `X` cannot contain zeros.\n+\n+    tol : float, default=1e-4\n+        Control early stopping based on the norm of the differences in `H`\n+        between 2 steps. To disable early stopping based on changes in `H`, set\n+        `tol` to 0.0.\n+\n+    max_no_improvement : int, default=10\n+        Control early stopping based on the consecutive number of mini batches\n+        that does not yield an improvement on the smoothed cost function.\n+        To disable convergence detection based on cost function, set\n+        `max_no_improvement` to None.\n+\n+    max_iter : int, default=200\n+        Maximum number of iterations over the complete dataset before\n+        timing out.\n+\n+    alpha_W : float, default=0.0\n+        Constant that multiplies the regularization terms of `W`. Set it to zero\n+        (default) to have no regularization on `W`.\n+\n+    alpha_H : float or \"same\", default=\"same\"\n+        Constant that multiplies the regularization terms of `H`. Set it to zero to\n+        have no regularization on `H`. If \"same\" (default), it takes the same value as\n+        `alpha_W`.\n+\n+    l1_ratio : float, default=0.0\n+        The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n+        For l1_ratio = 0 the penalty is an elementwise L2 penalty\n+        (aka Frobenius Norm).\n+        For l1_ratio = 1 it is an elementwise L1 penalty.\n+        For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n+\n+    forget_factor : float, default=0.7\n+        Amount of rescaling of past information. Its value could be 1 with\n+        finite datasets. Choosing values < 1 is recommended with online\n+        learning as more recent batches will weight more than past batches.\n+\n+    fresh_restarts : bool, default=False\n+        Whether to completely solve for W at each step. Doing fresh restarts will likely\n+        lead to a better solution for a same number of iterations but it is much slower.\n+\n+    fresh_restarts_max_iter : int, default=30\n+        Maximum number of iterations when solving for W at each step. Only used when\n+        doing fresh restarts. These iterations may be stopped early based on a small\n+        change of W controlled by `tol`.\n+\n+    transform_max_iter : int, default=None\n+        Maximum number of iterations when solving for W at transform time.\n+        If None, it defaults to `max_iter`.\n+\n+    random_state : int, RandomState instance or None, default=None\n+        Used for initialisation (when ``init`` == 'nndsvdar' or\n+        'random'), and in Coordinate Descent. Pass an int for reproducible\n+        results across multiple function calls.\n+        See :term:`Glossary <random_state>`.\n+\n+    verbose : bool, default=False\n+        Whether to be verbose.\n+\n+    Attributes\n+    ----------\n+    components_ : ndarray of shape (n_components, n_features)\n+        Factorization matrix, sometimes called 'dictionary'.\n+\n+    n_components_ : int\n+        The number of components. It is same as the `n_components` parameter\n+        if it was given. Otherwise, it will be same as the number of\n+        features.\n+\n+    reconstruction_err_ : float\n+        Frobenius norm of the matrix difference, or beta-divergence, between\n+        the training data `X` and the reconstructed data `WH` from\n+        the fitted model.\n+\n+    n_iter_ : int\n+        Actual number of started iterations over the whole dataset.\n+\n+    n_steps_ : int\n+        Number of mini-batches processed.\n+\n+    n_features_in_ : int\n+        Number of features seen during :term:`fit`.\n+\n+    feature_names_in_ : ndarray of shape (`n_features_in_`,)\n+        Names of features seen during :term:`fit`. Defined only when `X`\n+        has feature names that are all strings.\n+\n+    See Also\n+    --------\n+    NMF : Non-negative matrix factorization.\n+    MiniBatchDictionaryLearning : Finds a dictionary that can best be used to represent\n+        data using a sparse code.\n+\n+    References\n+    ----------\n+    .. [1] :doi:`\"Fast local algorithms for large scale nonnegative matrix and tensor\n+       factorizations\" <10.1587/transfun.E92.A.708>`\n+       Cichocki, Andrzej, and P. H. A. N. Anh-Huy. IEICE transactions on fundamentals\n+       of electronics, communications and computer sciences 92.3: 708-721, 2009.\n+\n+    .. [2] :doi:`\"Algorithms for nonnegative matrix factorization with the\n+       beta-divergence\" <10.1162/NECO_a_00168>`\n+       Fevotte, C., & Idier, J. (2011). Neural Computation, 23(9).\n+\n+    .. [3] :doi:`\"Online algorithms for nonnegative matrix factorization with the\n+       Itakura-Saito divergence\" <10.1109/ASPAA.2011.6082314>`\n+       Lefevre, A., Bach, F., Fevotte, C. (2011). WASPA.\n+\n+    Examples\n+    --------\n+    >>> import numpy as np\n+    >>> X = np.array([[1, 1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n+    >>> from sklearn.decomposition import MiniBatchNMF\n+    >>> model = MiniBatchNMF(n_components=2, init='random', random_state=0)\n+    >>> W = model.fit_transform(X)\n+    >>> H = model.components_\n+    \"\"\"\n+\n+    def __init__(\n+        self,\n+        n_components=None,\n+        *,\n+        init=None,\n+        batch_size=1024,\n+        beta_loss=\"frobenius\",\n+        tol=1e-4,\n+        max_no_improvement=10,\n+        max_iter=200,\n+        alpha_W=0.0,\n+        alpha_H=\"same\",\n+        l1_ratio=0.0,\n+        forget_factor=0.7,\n+        fresh_restarts=False,\n+        fresh_restarts_max_iter=30,\n+        transform_max_iter=None,\n+        random_state=None,\n+        verbose=0,\n+    ):\n+\n+        super().__init__(\n+            n_components=n_components,\n+            init=init,\n+            solver=\"mu\",\n+            beta_loss=beta_loss,\n+            tol=tol,\n+            max_iter=max_iter,\n+            random_state=random_state,\n+            alpha_W=alpha_W,\n+            alpha_H=alpha_H,\n+            l1_ratio=l1_ratio,\n+            verbose=verbose,\n+        )\n+\n+        self.max_no_improvement = max_no_improvement\n+        self.batch_size = batch_size\n+        self.forget_factor = forget_factor\n+        self.fresh_restarts = fresh_restarts\n+        self.fresh_restarts_max_iter = fresh_restarts_max_iter\n+        self.transform_max_iter = transform_max_iter\n+\n+    def _check_params(self, X):\n+        super()._check_params(X)\n+\n+        # batch_size\n+        self._batch_size = self.batch_size\n+        if not isinstance(self._batch_size, numbers.Integral) or self._batch_size <= 0:\n+            raise ValueError(\n+                \"batch_size must be a positive integer, got \"\n+                f\"{self._batch_size!r} instead.\"\n+            )\n+        self._batch_size = min(self._batch_size, X.shape[0])\n+\n+        # forget_factor\n+        self._rho = self.forget_factor ** (self._batch_size / X.shape[0])\n+\n+        # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n+        if self._beta_loss < 1:\n+            self._gamma = 1.0 / (2.0 - self._beta_loss)\n+        elif self._beta_loss > 2:\n+            self._gamma = 1.0 / (self._beta_loss - 1.0)\n+        else:\n+            self._gamma = 1.0\n+\n+        # transform_max_iter\n+        self._transform_max_iter = (\n+            self.max_iter\n+            if self.transform_max_iter is None\n+            else self.transform_max_iter\n+        )\n+\n+        return self\n+\n+    def _solve_W(self, X, H, max_iter):\n+        \"\"\"Minimize the objective function w.r.t W.\n+\n+        Update W with H being fixed, until convergence. This is the heart\n+        of `transform` but it's also used during `fit` when doing fresh restarts.\n+        \"\"\"\n+        avg = np.sqrt(X.mean() / self._n_components)\n+        W = np.full((X.shape[0], self._n_components), avg, dtype=X.dtype)\n+        W_buffer = W.copy()\n+\n+        # Get scaled regularization terms. Done for each minibatch to take into account\n+        # variable sizes of minibatches.\n+        l1_reg_W, _, l2_reg_W, _ = self._scale_regularization(X)\n+\n+        for _ in range(max_iter):\n+            W, *_ = _multiplicative_update_w(\n+                X, W, H, self._beta_loss, l1_reg_W, l2_reg_W, self._gamma\n+            )\n+\n+            W_diff = linalg.norm(W - W_buffer) / linalg.norm(W)\n+            if self.tol > 0 and W_diff <= self.tol:\n+                break\n+\n+            W_buffer[:] = W\n+\n+        return W\n+\n+    def _minibatch_step(self, X, W, H, update_H):\n+        \"\"\"Perform the update of W and H for one minibatch.\"\"\"\n+        batch_size = X.shape[0]\n+\n+        # get scaled regularization terms. Done for each minibatch to take into account\n+        # variable sizes of minibatches.\n+        l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H = self._scale_regularization(X)\n+\n+        # update W\n+        if self.fresh_restarts or W is None:\n+            W = self._solve_W(X, H, self.fresh_restarts_max_iter)\n+        else:\n+            W, *_ = _multiplicative_update_w(\n+                X, W, H, self._beta_loss, l1_reg_W, l2_reg_W, self._gamma\n+            )\n+\n+        # necessary for stability with beta_loss < 1\n+        if self._beta_loss < 1:\n+            W[W < np.finfo(np.float64).eps] = 0.0\n+\n+        batch_cost = (\n+            _beta_divergence(X, W, H, self._beta_loss)\n+            + l1_reg_W * W.sum()\n+            + l1_reg_H * H.sum()\n+            + l2_reg_W * (W**2).sum()\n+            + l2_reg_H * (H**2).sum()\n+        ) / batch_size\n+\n+        # update H (only at fit or fit_transform)\n+        if update_H:\n+            H[:] = _multiplicative_update_h(\n+                X,\n+                W,\n+                H,\n+                beta_loss=self._beta_loss,\n+                l1_reg_H=l1_reg_H,\n+                l2_reg_H=l2_reg_H,\n+                gamma=self._gamma,\n+                A=self._components_numerator,\n+                B=self._components_denominator,\n+                rho=self._rho,\n+            )\n+\n+            # necessary for stability with beta_loss < 1\n+            if self._beta_loss <= 1:\n+                H[H < np.finfo(np.float64).eps] = 0.0\n+\n+        return batch_cost\n+\n+    def _minibatch_convergence(\n+        self, X, batch_cost, H, H_buffer, n_samples, step, n_steps\n+    ):\n+        \"\"\"Helper function to encapsulate the early stopping logic\"\"\"\n+        batch_size = X.shape[0]\n+\n+        # counts steps starting from 1 for user friendly verbose mode.\n+        step = step + 1\n+\n+        # Ignore first iteration because H is not updated yet.\n+        if step == 1:\n+            if self.verbose:\n+                print(f\"Minibatch step {step}/{n_steps}: mean batch cost: {batch_cost}\")\n+            return False\n+\n+        # Compute an Exponentially Weighted Average of the cost function to\n+        # monitor the convergence while discarding minibatch-local stochastic\n+        # variability: https://en.wikipedia.org/wiki/Moving_average\n+        if self._ewa_cost is None:\n+            self._ewa_cost = batch_cost\n+        else:\n+            alpha = batch_size / (n_samples + 1)\n+            alpha = min(alpha, 1)\n+            self._ewa_cost = self._ewa_cost * (1 - alpha) + batch_cost * alpha\n+\n+        # Log progress to be able to monitor convergence\n+        if self.verbose:\n+            print(\n+                f\"Minibatch step {step}/{n_steps}: mean batch cost: \"\n+                f\"{batch_cost}, ewa cost: {self._ewa_cost}\"\n+            )\n+\n+        # Early stopping based on change of H\n+        H_diff = linalg.norm(H - H_buffer) / linalg.norm(H)\n+        if self.tol > 0 and H_diff <= self.tol:\n+            if self.verbose:\n+                print(f\"Converged (small H change) at step {step}/{n_steps}\")\n+            return True\n+\n+        # Early stopping heuristic due to lack of improvement on smoothed\n+        # cost function\n+        if self._ewa_cost_min is None or self._ewa_cost < self._ewa_cost_min:\n+            self._no_improvement = 0\n+            self._ewa_cost_min = self._ewa_cost\n+        else:\n+            self._no_improvement += 1\n+\n+        if (\n+            self.max_no_improvement is not None\n+            and self._no_improvement >= self.max_no_improvement\n+        ):\n+            if self.verbose:\n+                print(\n+                    \"Converged (lack of improvement in objective function) \"\n+                    f\"at step {step}/{n_steps}\"\n+                )\n+            return True\n+\n+        return False\n+\n+    def fit_transform(self, X, y=None, W=None, H=None):\n+        \"\"\"Learn a NMF model for the data X and returns the transformed data.\n+\n+        This is more efficient than calling fit followed by transform.\n+\n+        Parameters\n+        ----------\n+        X : {array-like, sparse matrix} of shape (n_samples, n_features)\n+            Data matrix to be decomposed.\n+\n+        y : Ignored\n+            Not used, present here for API consistency by convention.\n+\n+        W : array-like of shape (n_samples, n_components), default=None\n+            If `init='custom'`, it is used as initial guess for the solution.\n+\n+        H : array-like of shape (n_components, n_features), default=None\n+            If `init='custom'`, it is used as initial guess for the solution.\n+\n+        Returns\n+        -------\n+        W : ndarray of shape (n_samples, n_components)\n+            Transformed data.\n+        \"\"\"\n+        X = self._validate_data(\n+            X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n+        )\n+\n+        with config_context(assume_finite=True):\n+            W, H, n_iter, n_steps = self._fit_transform(X, W=W, H=H)\n+\n+        self.reconstruction_err_ = _beta_divergence(\n+            X, W, H, self._beta_loss, square_root=True\n+        )\n+\n+        self.n_components_ = H.shape[0]\n+        self.components_ = H\n+        self.n_iter_ = n_iter\n+        self.n_steps_ = n_steps\n+\n+        return W\n+\n+    def _fit_transform(self, X, W=None, H=None, update_H=True):\n+        \"\"\"Learn a NMF model for the data X and returns the transformed data.\n+\n+        Parameters\n+        ----------\n+        X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n+            Data matrix to be decomposed.\n+\n+        W : array-like of shape (n_samples, n_components), default=None\n+            If init='custom', it is used as initial guess for the solution.\n+\n+        H : array-like of shape (n_components, n_features), default=None\n+            If init='custom', it is used as initial guess for the solution.\n+            If update_H=False, it is used as a constant, to solve for W only.\n+\n+        update_H : bool, default=True\n+            If True, both W and H will be estimated from initial guesses,\n+            this corresponds to a call to the `fit_transform` method.\n+            If False, only W will be estimated, this corresponds to a call\n+            to the `transform` method.\n+\n+        Returns\n+        -------\n+        W : ndarray of shape (n_samples, n_components)\n+            Transformed data.\n+\n+        H : ndarray of shape (n_components, n_features)\n+            Factorization matrix, sometimes called 'dictionary'.\n+\n+        n_iter : int\n+            Actual number of started iterations over the whole dataset.\n+\n+        n_steps : int\n+            Number of mini-batches processed.\n+        \"\"\"\n+        check_non_negative(X, \"NMF (input X)\")\n+        self._check_params(X)\n+\n+        if X.min() == 0 and self._beta_loss <= 0:\n+            raise ValueError(\n+                \"When beta_loss <= 0 and X contains zeros, \"\n+                \"the solver may diverge. Please add small values \"\n+                \"to X, or use a positive beta_loss.\"\n+            )\n+\n+        n_samples = X.shape[0]\n+\n+        # initialize or check W and H\n+        W, H = self._check_w_h(X, W, H, update_H)\n+        H_buffer = H.copy()\n+\n+        # Initialize auxiliary matrices\n+        self._components_numerator = H.copy()\n+        self._components_denominator = np.ones(H.shape, dtype=H.dtype)\n+\n+        # Attributes to monitor the convergence\n+        self._ewa_cost = None\n+        self._ewa_cost_min = None\n+        self._no_improvement = 0\n+\n+        batches = gen_batches(n_samples, self._batch_size)\n+        batches = itertools.cycle(batches)\n+        n_steps_per_iter = int(np.ceil(n_samples / self._batch_size))\n+        n_steps = self.max_iter * n_steps_per_iter\n+\n+        for i, batch in zip(range(n_steps), batches):\n+\n+            batch_cost = self._minibatch_step(X[batch], W[batch], H, update_H)\n+\n+            if update_H and self._minibatch_convergence(\n+                X[batch], batch_cost, H, H_buffer, n_samples, i, n_steps\n+            ):\n+                break\n+\n+            H_buffer[:] = H\n+\n+        if self.fresh_restarts:\n+            W = self._solve_W(X, H, self._transform_max_iter)\n+\n+        n_steps = i + 1\n+        n_iter = int(np.ceil(n_steps / n_steps_per_iter))\n+\n+        if n_iter == self.max_iter and self.tol > 0:\n+            warnings.warn(\n+                f\"Maximum number of iterations {self.max_iter} reached. \"\n+                \"Increase it to improve convergence.\",\n+                ConvergenceWarning,\n+            )\n+\n+        return W, H, n_iter, n_steps\n+\n+    def transform(self, X):\n+        \"\"\"Transform the data X according to the fitted MiniBatchNMF model.\n+\n+        Parameters\n+        ----------\n+        X : {array-like, sparse matrix} of shape (n_samples, n_features)\n+            Data matrix to be transformed by the model.\n+\n+        Returns\n+        -------\n+        W : ndarray of shape (n_samples, n_components)\n+            Transformed data.\n+        \"\"\"\n+        check_is_fitted(self)\n+        X = self._validate_data(\n+            X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n+        )\n+\n+        W = self._solve_W(X, self.components_, self._transform_max_iter)\n+\n+        return W\n+\n+    def partial_fit(self, X, y=None, W=None, H=None):\n+        \"\"\"Update the model using the data in `X` as a mini-batch.\n+\n+        This method is expected to be called several times consecutively\n+        on different chunks of a dataset so as to implement out-of-core\n+        or online learning.\n+\n+        This is especially useful when the whole dataset is too big to fit in\n+        memory at once (see :ref:`scaling_strategies`).\n+\n+        Parameters\n+        ----------\n+        X : {array-like, sparse matrix} of shape (n_samples, n_features)\n+            Data matrix to be decomposed.\n+\n+        y : Ignored\n+            Not used, present here for API consistency by convention.\n+\n+        W : array-like of shape (n_samples, n_components), default=None\n+            If `init='custom'`, it is used as initial guess for the solution.\n+            Only used for the first call to `partial_fit`.\n+\n+        H : array-like of shape (n_components, n_features), default=None\n+            If `init='custom'`, it is used as initial guess for the solution.\n+            Only used for the first call to `partial_fit`.\n+\n+        Returns\n+        -------\n+        self\n+            Returns the instance itself.\n+        \"\"\"\n+        has_components = hasattr(self, \"components_\")\n+\n+        X = self._validate_data(\n+            X,\n+            accept_sparse=(\"csr\", \"csc\"),\n+            dtype=[np.float64, np.float32],\n+            reset=not has_components,\n+        )\n+\n+        if not has_components:\n+            # This instance has not been fitted yet (fit or partial_fit)\n+            self._check_params(X)\n+            _, H = self._check_w_h(X, W=W, H=H, update_H=True)\n+\n+            self._components_numerator = H.copy()\n+            self._components_denominator = np.ones(H.shape, dtype=H.dtype)\n+            self.n_steps_ = 0\n+        else:\n+            H = self.components_\n+\n+        self._minibatch_step(X, None, H, update_H=True)\n+\n+        self.n_components_ = H.shape[0]\n+        self.components_ = H\n+        self.n_steps_ += 1\n+\n+        return self\ndiff --git a/sklearn/utils/estimator_checks.py b/sklearn/utils/estimator_checks.py\nindex 5e9601ae220a6..cc51507f90d49 100644\n--- a/sklearn/utils/estimator_checks.py\n+++ b/sklearn/utils/estimator_checks.py\n@@ -652,6 +652,9 @@ def _set_checking_parameters(estimator):\n         # NMF\n         if name == \"NMF\":\n             estimator.set_params(max_iter=500)\n+        # MiniBatchNMF\n+        if estimator.__class__.__name__ == \"MiniBatchNMF\":\n+            estimator.set_params(max_iter=20, fresh_restarts=True)\n         # MLP\n         if name in [\"MLPClassifier\", \"MLPRegressor\"]:\n             estimator.set_params(max_iter=100)\n"}, "usage": {"cost($)": "0", "prompt_tokens": 59256, "completion_tokens": 664}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'scikit-learn' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Online implementation of Non-negative Matrix Factorizarion (NMF)\n\n<!--\r\nIf your issue is a usage question, submit it here instead:\r\n- StackOverflow with the scikit-learn tag: https://stackoverflow.com/questions/tagged/scikit-learn\r\n- Mailing List: https://mail.python.org/mailman/listinfo/scikit-learn\r\nFor more information, see User Questions: http://scikit-learn.org/stable/support.html#user-questions\r\n-->\r\n\r\n<!-- Instructions For Filing a Bug: https://github.com/scikit-learn/scikit-learn/blob/master/CONTRIBUTING.md#filing-bugs -->\r\n\r\n#### Description\r\n<!-- Example: Joblib Error thrown when calling fit on LatentDirichletAllocation with evaluate_every > 0-->\r\n@GaelVaroquaux Maybe an online version of the NMF could be useful in big data settings.\r\n\r\n#### Steps/Code to Reproduce\r\n<!--\r\nExample:\r\n```python\r\nfrom sklearn.feature_extraction.text import CountVectorizer\r\nfrom sklearn.decomposition import LatentDirichletAllocation\r\n\r\ndocs = [\"Help I have a bug\" for i in range(1000)]\r\n\r\nvectorizer = CountVectorizer(input=docs, analyzer='word')\r\nlda_features = vectorizer.fit_transform(docs)\r\n\r\nlda_model = LatentDirichletAllocation(\r\n    n_topics=10,\r\n    learning_method='online',\r\n    evaluate_every=10,\r\n    n_jobs=4,\r\n)\r\nmodel = lda_model.fit(lda_features)\r\n```\r\nIf the code is too long, feel free to put it in a public gist and link\r\nit in the issue: https://gist.github.com\r\n-->\r\n\r\n#### Expected Results\r\n<!-- Example: No error is thrown. Please paste or describe the expected results.-->\r\n\r\n#### Actual Results\r\n<!-- Please paste or specifically describe the actual output or traceback. -->\r\nHere I show the results for an sparse matrix as input of size 1M x 2.8k\r\nThe factorization has `n_components = 10` and each point is an entire pass on the data.\r\nThe current online implementation only supports the kullback-leibler divergence, but in practice\r\ncan be generalized to any beta divergence.\r\n\r\n![batch_vs_online_nmf](https://user-images.githubusercontent.com/11759948/53494592-69748b00-3a9e-11e9-8cc8-ce53ce3fe7f2.png)\r\n\r\n#### Versions\r\n<!--\r\nPlease run the following snippet and paste the output below.\r\nFor scikit-learn >= 0.20:\r\nimport sklearn; sklearn.show_versions()\r\nFor scikit-learn < 0.20:\r\nimport platform; print(platform.platform())\r\nimport sys; print(\"Python\", sys.version)\r\nimport numpy; print(\"NumPy\", numpy.__version__)\r\nimport scipy; print(\"SciPy\", scipy.__version__)\r\nimport sklearn; print(\"Scikit-Learn\", sklearn.__version__)\r\n-->\r\n\r\n\r\n<!-- Thanks for contributing! -->\r\n\nDraft implementation of MiniBatchNMF\n<!--\r\nThanks for contributing a pull request! Please ensure you have taken a look at\r\nthe contribution guidelines: https://github.com/scikit-learn/scikit-learn/blob/master/CONTRIBUTING.md#pull-request-checklist\r\n-->\r\n\r\n#### Reference Issues/PRs\r\n<!--\r\nExample: Fixes #1234. See also #3456.\r\nPlease use keywords (e.g., Fixes) to create link to the issues or pull requests\r\nyou resolved, so that they will automatically be closed when your pull request\r\nis merged. See https://github.com/blog/1506-closing-issues-via-pull-requests\r\n-->\r\n\r\n\r\n#### What does this implement/fix? Explain your changes.\r\n\r\nImplementation of a mini-batch NMF with multiplicative updates.\r\n#13308 \r\n#### Any other comments?\r\n\r\n\r\n<!--\r\nPlease be aware that we are a loose team of volunteers so patience is\r\nnecessary; assistance handling other issues is very welcome. We value\r\nall user contributions, no matter how minor they are. If we are slow to\r\nreview, either the pull request needs some benchmarking, tinkering,\r\nconvincing, etc. or more likely the reviewers are simply busy. In either\r\ncase, we ask for your understanding during the review process.\r\nFor more information, see our FAQ on this topic:\r\nhttp://scikit-learn.org/dev/faq.html#why-is-my-pull-request-not-getting-any-attention.\r\n\r\nThanks for contributing!\r\n-->\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n"}, {"content": "To start, let's extract the key problem information and identify the modules in the 'scikit-learn' package mentioned in the issue.\n\nRequested feature description: Online implementation of Non-negative Matrix Factorization (NMF)\nBehavior without this feature: Current online implementation only supports the Kullback-Leibler divergence.\nExpected behavior with the feature: Generalized to any beta divergence.\nAdditional context: Mention of MiniBatchNMF with multiplicative updates.\n\nModules referenced:\n- Non-negative Matrix Factorization (NMF)\n- MiniBatchNMF\n\nNext, let's explore the repo structure to familiarize ourselves with where these modules might be located. Since NMF and MiniBatchNMF are algorithms, they are likely to be found in the `decomposition` module.\n\nLet's start with the decomposition module to find where the NMF and MiniBatchNMF are implemented.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/decomposition/__init__.py']</parameter>\n<parameter=direction>both</parameter>\n<parameter=traversal_depth>2</parameter>\n<parameter=entity_type_filter>['file', 'class']</parameter>\n<parameter=dependency_type_filter>['contains', 'imports']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\nsklearn/decomposition/__init__.py\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_nmf.py:NMF\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_pca.py:PCA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_incremental_pca.py:IncrementalPCA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_kernel_pca.py:KernelPCA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_sparse_pca.py:SparsePCA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_sparse_pca.py:MiniBatchSparsePCA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_truncated_svd.py:TruncatedSVD\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_fastica.py:FastICA\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_dict_learning.py:DictionaryLearning\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_dict_learning.py:MiniBatchDictionaryLearning\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_dict_learning.py:SparseCoder\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_factor_analysis.py:FactorAnalysis\n\u251c\u2500\u2500 imports \u2500\u2500 sklearn/decomposition/_lda.py:LatentDirichletAllocation\n\u251c\u2500\u2500 imports-by \u2500\u2500 asv_benchmarks/benchmarks/datasets.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 asv_benchmarks/benchmarks/decomposition.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 sklearn/manifold/_t_sne.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 sklearn/manifold/_isomap.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 sklearn/neighbors/_nca.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/ensemble/plot_random_forest_embedding.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/cluster/plot_kmeans_digits.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/compose/plot_digits_pipe.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/compose/plot_feature_union.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/compose/plot_column_transformer.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/compose/plot_compare_reduction.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/datasets/plot_iris_dataset.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/miscellaneous/plot_multilabel.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/miscellaneous/plot_pipeline_display.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/miscellaneous/plot_kernel_approximation.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/manifold/plot_mds.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/manifold/plot_lle_digits.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/applications/plot_face_recognition.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/applications/wikipedia_principal_eigenvector.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/applications/plot_digits_denoising.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/applications/plot_topics_extraction_with_nmf_lda.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/preprocessing/plot_scaling_importance.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/text/plot_document_clustering.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/model_selection/plot_grid_search_refit_callable.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_incremental_pca.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_kernel_pca.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_faces_decomposition.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_pca_vs_lda.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_image_denoising.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_pca_vs_fa_model_selection.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_pca_iris.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_ica_blind_source_separation.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_pca_3d.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_varimax_fa.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_sparse_coding.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/decomposition/plot_ica_vs_pca.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/cross_decomposition/plot_pcr_vs_pls.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/neighbors/plot_nca_dim_reduction.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 examples/neighbors/plot_digits_kde_sampling.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 benchmarks/bench_tsne_mnist.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 benchmarks/bench_plot_nmf.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 benchmarks/bench_plot_incremental_pca.py\n\u251c\u2500\u2500 imports-by \u2500\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_components.py\n\u2514\u2500\u2500 imports-by \u2500\u2500 benchmarks/bench_kernel_pca_solvers_time_vs_n_samples.py\n"}, {"content": "Based on the exploration of the `sklearn/decomposition/__init__.py` file, we have identified that the `NMF` and `MiniBatchNMF` classes are located in `sklearn/decomposition/_nmf.py`. Let's proceed to get the contents of this file to further analyze the feature.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/decomposition/_nmf.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `sklearn/decomposition/_nmf.py`...\n### Search Result:\nFound file `sklearn/decomposition/_nmf.py`.\nSource: Exact match found for entity name `sklearn/decomposition/_nmf.py`.\n```\n   1 | \"\"\" Non-negative matrix factorization.\n   2 | \"\"\"\n   3 | # Author: Vlad Niculae\n   4 | #         Lars Buitinck\n   5 | #         Mathieu Blondel <mathieu@mblondel.org>\n   6 | #         Tom Dupre la Tour\n   7 | # License: BSD 3 clause\n   8 | \n   9 | import numbers\n  10 | import numpy as np\n  11 | import scipy.sparse as sp\n  12 | import time\n  13 | import warnings\n  14 | from math import sqrt\n  15 | \n  16 | from ._cdnmf_fast import _update_cdnmf_fast\n  17 | from .._config import config_context\n  18 | from ..base import BaseEstimator, TransformerMixin, _ClassNamePrefixFeaturesOutMixin\n  19 | from ..exceptions import ConvergenceWarning\n  20 | from ..utils import check_random_state, check_array\n  21 | from ..utils.extmath import randomized_svd, safe_sparse_dot, squared_norm\n  22 | from ..utils.validation import (\n  23 |     check_is_fitted,\n  24 |     check_non_negative,\n  25 | )\n  26 | \n  27 | EPSILON = np.finfo(np.float32).eps\n  28 | \n  29 | \n  30 | def norm(x):\n  31 |     \"\"\"Dot product-based Euclidean norm implementation.\n  32 | \n  33 |     See: http://fseoane.net/blog/2011/computing-the-vector-norm/\n  34 | \n  35 |     Parameters\n  36 |     ----------\n  37 |     x : array-like\n  38 |         Vector for which to compute the norm.\n  39 |     \"\"\"\n  40 |     return sqrt(squared_norm(x))\n  41 | \n  42 | \n  43 | def trace_dot(X, Y):\n  44 |     \"\"\"Trace of np.dot(X, Y.T).\n  45 | \n  46 |     Parameters\n  47 |     ----------\n  48 |     X : array-like\n  49 |         First matrix.\n  50 |     Y : array-like\n  51 |         Second matrix.\n  52 |     \"\"\"\n  53 |     return np.dot(X.ravel(), Y.ravel())\n  54 | \n  55 | \n  56 | def _check_init(A, shape, whom):\n  57 |     A = check_array(A)\n  58 |     if np.shape(A) != shape:\n  59 |         raise ValueError(\n  60 |             \"Array with wrong shape passed to %s. Expected %s, but got %s \"\n  61 |             % (whom, shape, np.shape(A))\n  62 |         )\n  63 |     check_non_negative(A, whom)\n  64 |     if np.max(A) == 0:\n  65 |         raise ValueError(\"Array passed to %s is full of zeros.\" % whom)\n  66 | \n  67 | \n  68 | def _beta_divergence(X, W, H, beta, square_root=False):\n  69 |     \"\"\"Compute the beta-divergence of X and dot(W, H).\n  70 | \n  71 |     Parameters\n  72 |     ----------\n  73 |     X : float or array-like of shape (n_samples, n_features)\n  74 | \n  75 |     W : float or array-like of shape (n_samples, n_components)\n  76 | \n  77 |     H : float or array-like of shape (n_components, n_features)\n  78 | \n  79 |     beta : float or {'frobenius', 'kullback-leibler', 'itakura-saito'}\n  80 |         Parameter of the beta-divergence.\n  81 |         If beta == 2, this is half the Frobenius *squared* norm.\n  82 |         If beta == 1, this is the generalized Kullback-Leibler divergence.\n  83 |         If beta == 0, this is the Itakura-Saito divergence.\n  84 |         Else, this is the general beta-divergence.\n  85 | \n  86 |     square_root : bool, default=False\n  87 |         If True, return np.sqrt(2 * res)\n  88 |         For beta == 2, it corresponds to the Frobenius norm.\n  89 | \n  90 |     Returns\n  91 |     -------\n  92 |         res : float\n  93 |             Beta divergence of X and np.dot(X, H).\n  94 |     \"\"\"\n  95 |     beta = _beta_loss_to_float(beta)\n  96 | \n  97 |     # The method can be called with scalars\n  98 |     if not sp.issparse(X):\n  99 |         X = np.atleast_2d(X)\n 100 |     W = np.atleast_2d(W)\n 101 |     H = np.atleast_2d(H)\n 102 | \n 103 |     # Frobenius norm\n 104 |     if beta == 2:\n 105 |         # Avoid the creation of the dense np.dot(W, H) if X is sparse.\n 106 |         if sp.issparse(X):\n 107 |             norm_X = np.dot(X.data, X.data)\n 108 |             norm_WH = trace_dot(np.linalg.multi_dot([W.T, W, H]), H)\n 109 |             cross_prod = trace_dot((X * H.T), W)\n 110 |             res = (norm_X + norm_WH - 2.0 * cross_prod) / 2.0\n 111 |         else:\n 112 |             res = squared_norm(X - np.dot(W, H)) / 2.0\n 113 | \n 114 |         if square_root:\n 115 |             return np.sqrt(res * 2)\n 116 |         else:\n 117 |             return res\n 118 | \n 119 |     if sp.issparse(X):\n 120 |         # compute np.dot(W, H) only where X is nonzero\n 121 |         WH_data = _special_sparse_dot(W, H, X).data\n 122 |         X_data = X.data\n 123 |     else:\n 124 |         WH = np.dot(W, H)\n 125 |         WH_data = WH.ravel()\n 126 |         X_data = X.ravel()\n 127 | \n 128 |     # do not affect the zeros: here 0 ** (-1) = 0 and not infinity\n 129 |     indices = X_data > EPSILON\n 130 |     WH_data = WH_data[indices]\n 131 |     X_data = X_data[indices]\n 132 | \n 133 |     # used to avoid division by zero\n 134 |     WH_data[WH_data == 0] = EPSILON\n 135 | \n 136 |     # generalized Kullback-Leibler divergence\n 137 |     if beta == 1:\n 138 |         # fast and memory efficient computation of np.sum(np.dot(W, H))\n 139 |         sum_WH = np.dot(np.sum(W, axis=0), np.sum(H, axis=1))\n 140 |         # computes np.sum(X * log(X / WH)) only where X is nonzero\n 141 |         div = X_data / WH_data\n 142 |         res = np.dot(X_data, np.log(div))\n 143 |         # add full np.sum(np.dot(W, H)) - np.sum(X)\n 144 |         res += sum_WH - X_data.sum()\n 145 | \n 146 |     # Itakura-Saito divergence\n 147 |     elif beta == 0:\n 148 |         div = X_data / WH_data\n 149 |         res = np.sum(div) - np.product(X.shape) - np.sum(np.log(div))\n 150 | \n 151 |     # beta-divergence, beta not in (0, 1, 2)\n 152 |     else:\n 153 |         if sp.issparse(X):\n 154 |             # slow loop, but memory efficient computation of :\n 155 |             # np.sum(np.dot(W, H) ** beta)\n 156 |             sum_WH_beta = 0\n 157 |             for i in range(X.shape[1]):\n 158 |                 sum_WH_beta += np.sum(np.dot(W, H[:, i]) ** beta)\n 159 | \n 160 |         else:\n 161 |             sum_WH_beta = np.sum(WH**beta)\n 162 | \n 163 |         sum_X_WH = np.dot(X_data, WH_data ** (beta - 1))\n 164 |         res = (X_data**beta).sum() - beta * sum_X_WH\n 165 |         res += sum_WH_beta * (beta - 1)\n 166 |         res /= beta * (beta - 1)\n 167 | \n 168 |     if square_root:\n 169 |         return np.sqrt(2 * res)\n 170 |     else:\n 171 |         return res\n 172 | \n 173 | \n 174 | def _special_sparse_dot(W, H, X):\n 175 |     \"\"\"Computes np.dot(W, H), only where X is non zero.\"\"\"\n 176 |     if sp.issparse(X):\n 177 |         ii, jj = X.nonzero()\n 178 |         n_vals = ii.shape[0]\n 179 |         dot_vals = np.empty(n_vals)\n 180 |         n_components = W.shape[1]\n 181 | \n 182 |         batch_size = max(n_components, n_vals // n_components)\n 183 |         for start in range(0, n_vals, batch_size):\n 184 |             batch = slice(start, start + batch_size)\n 185 |             dot_vals[batch] = np.multiply(W[ii[batch], :], H.T[jj[batch], :]).sum(\n 186 |                 axis=1\n 187 |             )\n 188 | \n 189 |         WH = sp.coo_matrix((dot_vals, (ii, jj)), shape=X.shape)\n 190 |         return WH.tocsr()\n 191 |     else:\n 192 |         return np.dot(W, H)\n 193 | \n 194 | \n 195 | def _compute_regularization(alpha, alpha_W, alpha_H, l1_ratio, regularization):\n 196 |     \"\"\"Compute L1 and L2 regularization coefficients for W and H.\"\"\"\n 197 |     if alpha_W != 0 or alpha_H != \"same\":\n 198 |         # if alpha_W or alpha_H is not left to its default value we ignore alpha and\n 199 |         # regularization.\n 200 |         alpha_H = alpha_W if alpha_H == \"same\" else alpha_H\n 201 |         l1_reg_W = alpha_W * l1_ratio\n 202 |         l1_reg_H = alpha_H * l1_ratio\n 203 |         l2_reg_W = alpha_W * (1.0 - l1_ratio)\n 204 |         l2_reg_H = alpha_H * (1.0 - l1_ratio)\n 205 |     else:\n 206 |         # TODO remove in 1.2\n 207 |         l1_reg_W, l2_reg_W, l1_reg_H, l2_reg_H = 0.0, 0.0, 0.0, 0.0\n 208 |         if regularization in (\"both\", \"transformation\"):\n 209 |             l1_reg_W = alpha * l1_ratio\n 210 |             l2_reg_W = alpha * (1.0 - l1_ratio)\n 211 |         if regularization in (\"both\", \"components\"):\n 212 |             l1_reg_H = alpha * l1_ratio\n 213 |             l2_reg_H = alpha * (1.0 - l1_ratio)\n 214 | \n 215 |     return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n 216 | \n 217 | \n 218 | def _beta_loss_to_float(beta_loss):\n 219 |     \"\"\"Convert string beta_loss to float.\"\"\"\n 220 |     allowed_beta_loss = {\"frobenius\": 2, \"kullback-leibler\": 1, \"itakura-saito\": 0}\n 221 |     if isinstance(beta_loss, str) and beta_loss in allowed_beta_loss:\n 222 |         beta_loss = allowed_beta_loss[beta_loss]\n 223 | \n 224 |     if not isinstance(beta_loss, numbers.Number):\n 225 |         raise ValueError(\n 226 |             \"Invalid beta_loss parameter: got %r instead of one of %r, or a float.\"\n 227 |             % (beta_loss, allowed_beta_loss.keys())\n 228 |         )\n 229 |     return beta_loss\n 230 | \n 231 | \n 232 | def _initialize_nmf(X, n_components, init=None, eps=1e-6, random_state=None):\n 233 |     \"\"\"Algorithms for NMF initialization.\n 234 | \n 235 |     Computes an initial guess for the non-negative\n 236 |     rank k matrix approximation for X: X = WH.\n 237 | \n 238 |     Parameters\n 239 |     ----------\n 240 |     X : array-like of shape (n_samples, n_features)\n 241 |         The data matrix to be decomposed.\n 242 | \n 243 |     n_components : int\n 244 |         The number of components desired in the approximation.\n 245 | \n 246 |     init :  {'random', 'nndsvd', 'nndsvda', 'nndsvdar'}, default=None\n 247 |         Method used to initialize the procedure.\n 248 |         Valid options:\n 249 | \n 250 |         - None: 'nndsvda' if n_components <= min(n_samples, n_features),\n 251 |             otherwise 'random'.\n 252 | \n 253 |         - 'random': non-negative random matrices, scaled with:\n 254 |             sqrt(X.mean() / n_components)\n 255 | \n 256 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 257 |             initialization (better for sparseness)\n 258 | \n 259 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 260 |             (better when sparsity is not desired)\n 261 | \n 262 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 263 |             (generally faster, less accurate alternative to NNDSVDa\n 264 |             for when sparsity is not desired)\n 265 | \n 266 |         - 'custom': use custom matrices W and H\n 267 | \n 268 |         .. versionchanged:: 1.1\n 269 |             When `init=None` and n_components is less than n_samples and n_features\n 270 |             defaults to `nndsvda` instead of `nndsvd`.\n 271 | \n 272 |     eps : float, default=1e-6\n 273 |         Truncate all values less then this in output to zero.\n 274 | \n 275 |     random_state : int, RandomState instance or None, default=None\n 276 |         Used when ``init`` == 'nndsvdar' or 'random'. Pass an int for\n 277 |         reproducible results across multiple function calls.\n 278 |         See :term:`Glossary <random_state>`.\n 279 | \n 280 |     Returns\n 281 |     -------\n 282 |     W : array-like of shape (n_samples, n_components)\n 283 |         Initial guesses for solving X ~= WH.\n 284 | \n 285 |     H : array-like of shape (n_components, n_features)\n 286 |         Initial guesses for solving X ~= WH.\n 287 | \n 288 |     References\n 289 |     ----------\n 290 |     C. Boutsidis, E. Gallopoulos: SVD based initialization: A head start for\n 291 |     nonnegative matrix factorization - Pattern Recognition, 2008\n 292 |     http://tinyurl.com/nndsvd\n 293 |     \"\"\"\n 294 |     check_non_negative(X, \"NMF initialization\")\n 295 |     n_samples, n_features = X.shape\n 296 | \n 297 |     if (\n 298 |         init is not None\n 299 |         and init != \"random\"\n 300 |         and n_components > min(n_samples, n_features)\n 301 |     ):\n 302 |         raise ValueError(\n 303 |             \"init = '{}' can only be used when \"\n 304 |             \"n_components <= min(n_samples, n_features)\".format(init)\n 305 |         )\n 306 | \n 307 |     if init is None:\n 308 |         if n_components <= min(n_samples, n_features):\n 309 |             init = \"nndsvda\"\n 310 |         else:\n 311 |             init = \"random\"\n 312 | \n 313 |     # Random initialization\n 314 |     if init == \"random\":\n 315 |         avg = np.sqrt(X.mean() / n_components)\n 316 |         rng = check_random_state(random_state)\n 317 |         H = avg * rng.standard_normal(size=(n_components, n_features)).astype(\n 318 |             X.dtype, copy=False\n 319 |         )\n 320 |         W = avg * rng.standard_normal(size=(n_samples, n_components)).astype(\n 321 |             X.dtype, copy=False\n 322 |         )\n 323 |         np.abs(H, out=H)\n 324 |         np.abs(W, out=W)\n 325 |         return W, H\n 326 | \n 327 |     # NNDSVD initialization\n 328 |     U, S, V = randomized_svd(X, n_components, random_state=random_state)\n 329 |     W = np.zeros_like(U)\n 330 |     H = np.zeros_like(V)\n 331 | \n 332 |     # The leading singular triplet is non-negative\n 333 |     # so it can be used as is for initialization.\n 334 |     W[:, 0] = np.sqrt(S[0]) * np.abs(U[:, 0])\n 335 |     H[0, :] = np.sqrt(S[0]) * np.abs(V[0, :])\n 336 | \n 337 |     for j in range(1, n_components):\n 338 |         x, y = U[:, j], V[j, :]\n 339 | \n 340 |         # extract positive and negative parts of column vectors\n 341 |         x_p, y_p = np.maximum(x, 0), np.maximum(y, 0)\n 342 |         x_n, y_n = np.abs(np.minimum(x, 0)), np.abs(np.minimum(y, 0))\n 343 | \n 344 |         # and their norms\n 345 |         x_p_nrm, y_p_nrm = norm(x_p), norm(y_p)\n 346 |         x_n_nrm, y_n_nrm = norm(x_n), norm(y_n)\n 347 | \n 348 |         m_p, m_n = x_p_nrm * y_p_nrm, x_n_nrm * y_n_nrm\n 349 | \n 350 |         # choose update\n 351 |         if m_p > m_n:\n 352 |             u = x_p / x_p_nrm\n 353 |             v = y_p / y_p_nrm\n 354 |             sigma = m_p\n 355 |         else:\n 356 |             u = x_n / x_n_nrm\n 357 |             v = y_n / y_n_nrm\n 358 |             sigma = m_n\n 359 | \n 360 |         lbd = np.sqrt(S[j] * sigma)\n 361 |         W[:, j] = lbd * u\n 362 |         H[j, :] = lbd * v\n 363 | \n 364 |     W[W < eps] = 0\n 365 |     H[H < eps] = 0\n 366 | \n 367 |     if init == \"nndsvd\":\n 368 |         pass\n 369 |     elif init == \"nndsvda\":\n 370 |         avg = X.mean()\n 371 |         W[W == 0] = avg\n 372 |         H[H == 0] = avg\n 373 |     elif init == \"nndsvdar\":\n 374 |         rng = check_random_state(random_state)\n 375 |         avg = X.mean()\n 376 |         W[W == 0] = abs(avg * rng.standard_normal(size=len(W[W == 0])) / 100)\n 377 |         H[H == 0] = abs(avg * rng.standard_normal(size=len(H[H == 0])) / 100)\n 378 |     else:\n 379 |         raise ValueError(\n 380 |             \"Invalid init parameter: got %r instead of one of %r\"\n 381 |             % (init, (None, \"random\", \"nndsvd\", \"nndsvda\", \"nndsvdar\"))\n 382 |         )\n 383 | \n 384 |     return W, H\n 385 | \n 386 | \n 387 | def _update_coordinate_descent(X, W, Ht, l1_reg, l2_reg, shuffle, random_state):\n 388 |     \"\"\"Helper function for _fit_coordinate_descent.\n 389 | \n 390 |     Update W to minimize the objective function, iterating once over all\n 391 |     coordinates. By symmetry, to update H, one can call\n 392 |     _update_coordinate_descent(X.T, Ht, W, ...).\n 393 | \n 394 |     \"\"\"\n 395 |     n_components = Ht.shape[1]\n 396 | \n 397 |     HHt = np.dot(Ht.T, Ht)\n 398 |     XHt = safe_sparse_dot(X, Ht)\n 399 | \n 400 |     # L2 regularization corresponds to increase of the diagonal of HHt\n 401 |     if l2_reg != 0.0:\n 402 |         # adds l2_reg only on the diagonal\n 403 |         HHt.flat[:: n_components + 1] += l2_reg\n 404 |     # L1 regularization corresponds to decrease of each element of XHt\n 405 |     if l1_reg != 0.0:\n 406 |         XHt -= l1_reg\n 407 | \n 408 |     if shuffle:\n 409 |         permutation = random_state.permutation(n_components)\n 410 |     else:\n 411 |         permutation = np.arange(n_components)\n 412 |     # The following seems to be required on 64-bit Windows w/ Python 3.5.\n 413 |     permutation = np.asarray(permutation, dtype=np.intp)\n 414 |     return _update_cdnmf_fast(W, HHt, XHt, permutation)\n 415 | \n 416 | \n 417 | def _fit_coordinate_descent(\n 418 |     X,\n 419 |     W,\n 420 |     H,\n 421 |     tol=1e-4,\n 422 |     max_iter=200,\n 423 |     l1_reg_W=0,\n 424 |     l1_reg_H=0,\n 425 |     l2_reg_W=0,\n 426 |     l2_reg_H=0,\n 427 |     update_H=True,\n 428 |     verbose=0,\n 429 |     shuffle=False,\n 430 |     random_state=None,\n 431 | ):\n 432 |     \"\"\"Compute Non-negative Matrix Factorization (NMF) with Coordinate Descent\n 433 | \n 434 |     The objective function is minimized with an alternating minimization of W\n 435 |     and H. Each minimization is done with a cyclic (up to a permutation of the\n 436 |     features) Coordinate Descent.\n 437 | \n 438 |     Parameters\n 439 |     ----------\n 440 |     X : array-like of shape (n_samples, n_features)\n 441 |         Constant matrix.\n 442 | \n 443 |     W : array-like of shape (n_samples, n_components)\n 444 |         Initial guess for the solution.\n 445 | \n 446 |     H : array-like of shape (n_components, n_features)\n 447 |         Initial guess for the solution.\n 448 | \n 449 |     tol : float, default=1e-4\n 450 |         Tolerance of the stopping condition.\n 451 | \n 452 |     max_iter : int, default=200\n 453 |         Maximum number of iterations before timing out.\n 454 | \n 455 |     l1_reg_W : float, default=0.\n 456 |         L1 regularization parameter for W.\n 457 | \n 458 |     l1_reg_H : float, default=0.\n 459 |         L1 regularization parameter for H.\n 460 | \n 461 |     l2_reg_W : float, default=0.\n 462 |         L2 regularization parameter for W.\n 463 | \n 464 |     l2_reg_H : float, default=0.\n 465 |         L2 regularization parameter for H.\n 466 | \n 467 |     update_H : bool, default=True\n 468 |         Set to True, both W and H will be estimated from initial guesses.\n 469 |         Set to False, only W will be estimated.\n 470 | \n 471 |     verbose : int, default=0\n 472 |         The verbosity level.\n 473 | \n 474 |     shuffle : bool, default=False\n 475 |         If true, randomize the order of coordinates in the CD solver.\n 476 | \n 477 |     random_state : int, RandomState instance or None, default=None\n 478 |         Used to randomize the coordinates in the CD solver, when\n 479 |         ``shuffle`` is set to ``True``. Pass an int for reproducible\n 480 |         results across multiple function calls.\n 481 |         See :term:`Glossary <random_state>`.\n 482 | \n 483 |     Returns\n 484 |     -------\n 485 |     W : ndarray of shape (n_samples, n_components)\n 486 |         Solution to the non-negative least squares problem.\n 487 | \n 488 |     H : ndarray of shape (n_components, n_features)\n 489 |         Solution to the non-negative least squares problem.\n 490 | \n 491 |     n_iter : int\n 492 |         The number of iterations done by the algorithm.\n 493 | \n 494 |     References\n 495 |     ----------\n 496 |     Cichocki, Andrzej, and Phan, Anh-Huy. \"Fast local algorithms for\n 497 |     large scale nonnegative matrix and tensor factorizations.\"\n 498 |     IEICE transactions on fundamentals of electronics, communications and\n 499 |     computer sciences 92.3: 708-721, 2009.\n 500 |     \"\"\"\n 501 |     # so W and Ht are both in C order in memory\n 502 |     Ht = check_array(H.T, order=\"C\")\n 503 |     X = check_array(X, accept_sparse=\"csr\")\n 504 | \n 505 |     rng = check_random_state(random_state)\n 506 | \n 507 |     for n_iter in range(1, max_iter + 1):\n 508 |         violation = 0.0\n 509 | \n 510 |         # Update W\n 511 |         violation += _update_coordinate_descent(\n 512 |             X, W, Ht, l1_reg_W, l2_reg_W, shuffle, rng\n 513 |         )\n 514 |         # Update H\n 515 |         if update_H:\n 516 |             violation += _update_coordinate_descent(\n 517 |                 X.T, Ht, W, l1_reg_H, l2_reg_H, shuffle, rng\n 518 |             )\n 519 | \n 520 |         if n_iter == 1:\n 521 |             violation_init = violation\n 522 | \n 523 |         if violation_init == 0:\n 524 |             break\n 525 | \n 526 |         if verbose:\n 527 |             print(\"violation:\", violation / violation_init)\n 528 | \n 529 |         if violation / violation_init <= tol:\n 530 |             if verbose:\n 531 |                 print(\"Converged at iteration\", n_iter + 1)\n 532 |             break\n 533 | \n 534 |     return W, Ht.T, n_iter\n 535 | \n 536 | \n 537 | def _multiplicative_update_w(\n 538 |     X,\n 539 |     W,\n 540 |     H,\n 541 |     beta_loss,\n 542 |     l1_reg_W,\n 543 |     l2_reg_W,\n 544 |     gamma,\n 545 |     H_sum=None,\n 546 |     HHt=None,\n 547 |     XHt=None,\n 548 |     update_H=True,\n 549 | ):\n 550 |     \"\"\"Update W in Multiplicative Update NMF.\"\"\"\n 551 |     if beta_loss == 2:\n 552 |         # Numerator\n 553 |         if XHt is None:\n 554 |             XHt = safe_sparse_dot(X, H.T)\n 555 |         if update_H:\n 556 |             # avoid a copy of XHt, which will be re-computed (update_H=True)\n 557 |             numerator = XHt\n 558 |         else:\n 559 |             # preserve the XHt, which is not re-computed (update_H=False)\n 560 |             numerator = XHt.copy()\n 561 | \n 562 |         # Denominator\n 563 |         if HHt is None:\n 564 |             HHt = np.dot(H, H.T)\n 565 |         denominator = np.dot(W, HHt)\n 566 | \n 567 |     else:\n 568 |         # Numerator\n 569 |         # if X is sparse, compute WH only where X is non zero\n 570 |         WH_safe_X = _special_sparse_dot(W, H, X)\n 571 |         if sp.issparse(X):\n 572 |             WH_safe_X_data = WH_safe_X.data\n 573 |             X_data = X.data\n 574 |         else:\n 575 |             WH_safe_X_data = WH_safe_X\n 576 |             X_data = X\n 577 |             # copy used in the Denominator\n 578 |             WH = WH_safe_X.copy()\n 579 |             if beta_loss - 1.0 < 0:\n 580 |                 WH[WH == 0] = EPSILON\n 581 | \n 582 |         # to avoid taking a negative power of zero\n 583 |         if beta_loss - 2.0 < 0:\n 584 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n 585 | \n 586 |         if beta_loss == 1:\n 587 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n 588 |         elif beta_loss == 0:\n 589 |             # speeds up computation time\n 590 |             # refer to /numpy/numpy/issues/9363\n 591 |             WH_safe_X_data **= -1\n 592 |             WH_safe_X_data **= 2\n 593 |             # element-wise multiplication\n 594 |             WH_safe_X_data *= X_data\n 595 |         else:\n 596 |             WH_safe_X_data **= beta_loss - 2\n 597 |             # element-wise multiplication\n 598 |             WH_safe_X_data *= X_data\n 599 | \n 600 |         # here numerator = dot(X * (dot(W, H) ** (beta_loss - 2)), H.T)\n 601 |         numerator = safe_sparse_dot(WH_safe_X, H.T)\n 602 | \n 603 |         # Denominator\n 604 |         if beta_loss == 1:\n 605 |             if H_sum is None:\n 606 |                 H_sum = np.sum(H, axis=1)  # shape(n_components, )\n 607 |             denominator = H_sum[np.newaxis, :]\n 608 | \n 609 |         else:\n 610 |             # computation of WHHt = dot(dot(W, H) ** beta_loss - 1, H.T)\n 611 |             if sp.issparse(X):\n 612 |                 # memory efficient computation\n 613 |                 # (compute row by row, avoiding the dense matrix WH)\n 614 |                 WHHt = np.empty(W.shape)\n 615 |                 for i in range(X.shape[0]):\n 616 |                     WHi = np.dot(W[i, :], H)\n 617 |                     if beta_loss - 1 < 0:\n 618 |                         WHi[WHi == 0] = EPSILON\n 619 |                     WHi **= beta_loss - 1\n 620 |                     WHHt[i, :] = np.dot(WHi, H.T)\n 621 |             else:\n 622 |                 WH **= beta_loss - 1\n 623 |                 WHHt = np.dot(WH, H.T)\n 624 |             denominator = WHHt\n 625 | \n 626 |     # Add L1 and L2 regularization\n 627 |     if l1_reg_W > 0:\n 628 |         denominator += l1_reg_W\n 629 |     if l2_reg_W > 0:\n 630 |         denominator = denominator + l2_reg_W * W\n 631 |     denominator[denominator == 0] = EPSILON\n 632 | \n 633 |     numerator /= denominator\n 634 |     delta_W = numerator\n 635 | \n 636 |     # gamma is in ]0, 1]\n 637 |     if gamma != 1:\n 638 |         delta_W **= gamma\n 639 | \n 640 |     return delta_W, H_sum, HHt, XHt\n 641 | \n 642 | \n 643 | def _multiplicative_update_h(X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma):\n 644 |     \"\"\"Update H in Multiplicative Update NMF.\"\"\"\n 645 |     if beta_loss == 2:\n 646 |         numerator = safe_sparse_dot(W.T, X)\n 647 |         denominator = np.linalg.multi_dot([W.T, W, H])\n 648 | \n 649 |     else:\n 650 |         # Numerator\n 651 |         WH_safe_X = _special_sparse_dot(W, H, X)\n 652 |         if sp.issparse(X):\n 653 |             WH_safe_X_data = WH_safe_X.data\n 654 |             X_data = X.data\n 655 |         else:\n 656 |             WH_safe_X_data = WH_safe_X\n 657 |             X_data = X\n 658 |             # copy used in the Denominator\n 659 |             WH = WH_safe_X.copy()\n 660 |             if beta_loss - 1.0 < 0:\n 661 |                 WH[WH == 0] = EPSILON\n 662 | \n 663 |         # to avoid division by zero\n 664 |         if beta_loss - 2.0 < 0:\n 665 |             WH_safe_X_data[WH_safe_X_data == 0] = EPSILON\n 666 | \n 667 |         if beta_loss == 1:\n 668 |             np.divide(X_data, WH_safe_X_data, out=WH_safe_X_data)\n 669 |         elif beta_loss == 0:\n 670 |             # speeds up computation time\n 671 |             # refer to /numpy/numpy/issues/9363\n 672 |             WH_safe_X_data **= -1\n 673 |             WH_safe_X_data **= 2\n 674 |             # element-wise multiplication\n 675 |             WH_safe_X_data *= X_data\n 676 |         else:\n 677 |             WH_safe_X_data **= beta_loss - 2\n 678 |             # element-wise multiplication\n 679 |             WH_safe_X_data *= X_data\n 680 | \n 681 |         # here numerator = dot(W.T, (dot(W, H) ** (beta_loss - 2)) * X)\n 682 |         numerator = safe_sparse_dot(W.T, WH_safe_X)\n 683 | \n 684 |         # Denominator\n 685 |         if beta_loss == 1:\n 686 |             W_sum = np.sum(W, axis=0)  # shape(n_components, )\n 687 |             W_sum[W_sum == 0] = 1.0\n 688 |             denominator = W_sum[:, np.newaxis]\n 689 | \n 690 |         # beta_loss not in (1, 2)\n 691 |         else:\n 692 |             # computation of WtWH = dot(W.T, dot(W, H) ** beta_loss - 1)\n 693 |             if sp.issparse(X):\n 694 |                 # memory efficient computation\n 695 |                 # (compute column by column, avoiding the dense matrix WH)\n 696 |                 WtWH = np.empty(H.shape)\n 697 |                 for i in range(X.shape[1]):\n 698 |                     WHi = np.dot(W, H[:, i])\n 699 |                     if beta_loss - 1 < 0:\n 700 |                         WHi[WHi == 0] = EPSILON\n 701 |                     WHi **= beta_loss - 1\n 702 |                     WtWH[:, i] = np.dot(W.T, WHi)\n 703 |             else:\n 704 |                 WH **= beta_loss - 1\n 705 |                 WtWH = np.dot(W.T, WH)\n 706 |             denominator = WtWH\n 707 | \n 708 |     # Add L1 and L2 regularization\n 709 |     if l1_reg_H > 0:\n 710 |         denominator += l1_reg_H\n 711 |     if l2_reg_H > 0:\n 712 |         denominator = denominator + l2_reg_H * H\n 713 |     denominator[denominator == 0] = EPSILON\n 714 | \n 715 |     numerator /= denominator\n 716 |     delta_H = numerator\n 717 | \n 718 |     # gamma is in ]0, 1]\n 719 |     if gamma != 1:\n 720 |         delta_H **= gamma\n 721 | \n 722 |     return delta_H\n 723 | \n 724 | \n 725 | def _fit_multiplicative_update(\n 726 |     X,\n 727 |     W,\n 728 |     H,\n 729 |     beta_loss=\"frobenius\",\n 730 |     max_iter=200,\n 731 |     tol=1e-4,\n 732 |     l1_reg_W=0,\n 733 |     l1_reg_H=0,\n 734 |     l2_reg_W=0,\n 735 |     l2_reg_H=0,\n 736 |     update_H=True,\n 737 |     verbose=0,\n 738 | ):\n 739 |     \"\"\"Compute Non-negative Matrix Factorization with Multiplicative Update.\n 740 | \n 741 |     The objective function is _beta_divergence(X, WH) and is minimized with an\n 742 |     alternating minimization of W and H. Each minimization is done with a\n 743 |     Multiplicative Update.\n 744 | \n 745 |     Parameters\n 746 |     ----------\n 747 |     X : array-like of shape (n_samples, n_features)\n 748 |         Constant input matrix.\n 749 | \n 750 |     W : array-like of shape (n_samples, n_components)\n 751 |         Initial guess for the solution.\n 752 | \n 753 |     H : array-like of shape (n_components, n_features)\n 754 |         Initial guess for the solution.\n 755 | \n 756 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n 757 |             'itakura-saito'}, default='frobenius'\n 758 |         String must be in {'frobenius', 'kullback-leibler', 'itakura-saito'}.\n 759 |         Beta divergence to be minimized, measuring the distance between X\n 760 |         and the dot product WH. Note that values different from 'frobenius'\n 761 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n 762 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n 763 |         matrix X cannot contain zeros.\n 764 | \n 765 |     max_iter : int, default=200\n 766 |         Number of iterations.\n 767 | \n 768 |     tol : float, default=1e-4\n 769 |         Tolerance of the stopping condition.\n 770 | \n 771 |     l1_reg_W : float, default=0.\n 772 |         L1 regularization parameter for W.\n 773 | \n 774 |     l1_reg_H : float, default=0.\n 775 |         L1 regularization parameter for H.\n 776 | \n 777 |     l2_reg_W : float, default=0.\n 778 |         L2 regularization parameter for W.\n 779 | \n 780 |     l2_reg_H : float, default=0.\n 781 |         L2 regularization parameter for H.\n 782 | \n 783 |     update_H : bool, default=True\n 784 |         Set to True, both W and H will be estimated from initial guesses.\n 785 |         Set to False, only W will be estimated.\n 786 | \n 787 |     verbose : int, default=0\n 788 |         The verbosity level.\n 789 | \n 790 |     Returns\n 791 |     -------\n 792 |     W : ndarray of shape (n_samples, n_components)\n 793 |         Solution to the non-negative least squares problem.\n 794 | \n 795 |     H : ndarray of shape (n_components, n_features)\n 796 |         Solution to the non-negative least squares problem.\n 797 | \n 798 |     n_iter : int\n 799 |         The number of iterations done by the algorithm.\n 800 | \n 801 |     References\n 802 |     ----------\n 803 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n 804 |     factorization with the beta-divergence. Neural Computation, 23(9).\n 805 |     \"\"\"\n 806 |     start_time = time.time()\n 807 | \n 808 |     beta_loss = _beta_loss_to_float(beta_loss)\n 809 | \n 810 |     # gamma for Maximization-Minimization (MM) algorithm [Fevotte 2011]\n 811 |     if beta_loss < 1:\n 812 |         gamma = 1.0 / (2.0 - beta_loss)\n 813 |     elif beta_loss > 2:\n 814 |         gamma = 1.0 / (beta_loss - 1.0)\n 815 |     else:\n 816 |         gamma = 1.0\n 817 | \n 818 |     # used for the convergence criterion\n 819 |     error_at_init = _beta_divergence(X, W, H, beta_loss, square_root=True)\n 820 |     previous_error = error_at_init\n 821 | \n 822 |     H_sum, HHt, XHt = None, None, None\n 823 |     for n_iter in range(1, max_iter + 1):\n 824 |         # update W\n 825 |         # H_sum, HHt and XHt are saved and reused if not update_H\n 826 |         delta_W, H_sum, HHt, XHt = _multiplicative_update_w(\n 827 |             X, W, H, beta_loss, l1_reg_W, l2_reg_W, gamma, H_sum, HHt, XHt, update_H\n 828 |         )\n 829 |         W *= delta_W\n 830 | \n 831 |         # necessary for stability with beta_loss < 1\n 832 |         if beta_loss < 1:\n 833 |             W[W < np.finfo(np.float64).eps] = 0.0\n 834 | \n 835 |         # update H\n 836 |         if update_H:\n 837 |             delta_H = _multiplicative_update_h(\n 838 |                 X, W, H, beta_loss, l1_reg_H, l2_reg_H, gamma\n 839 |             )\n 840 |             H *= delta_H\n 841 | \n 842 |             # These values will be recomputed since H changed\n 843 |             H_sum, HHt, XHt = None, None, None\n 844 | \n 845 |             # necessary for stability with beta_loss < 1\n 846 |             if beta_loss <= 1:\n 847 |                 H[H < np.finfo(np.float64).eps] = 0.0\n 848 | \n 849 |         # test convergence criterion every 10 iterations\n 850 |         if tol > 0 and n_iter % 10 == 0:\n 851 |             error = _beta_divergence(X, W, H, beta_loss, square_root=True)\n 852 | \n 853 |             if verbose:\n 854 |                 iter_time = time.time()\n 855 |                 print(\n 856 |                     \"Epoch %02d reached after %.3f seconds, error: %f\"\n 857 |                     % (n_iter, iter_time - start_time, error)\n 858 |                 )\n 859 | \n 860 |             if (previous_error - error) / error_at_init < tol:\n 861 |                 break\n 862 |             previous_error = error\n 863 | \n 864 |     # do not print if we have already printed in the convergence test\n 865 |     if verbose and (tol == 0 or n_iter % 10 != 0):\n 866 |         end_time = time.time()\n 867 |         print(\n 868 |             \"Epoch %02d reached after %.3f seconds.\" % (n_iter, end_time - start_time)\n 869 |         )\n 870 | \n 871 |     return W, H, n_iter\n 872 | \n 873 | \n 874 | def non_negative_factorization(\n 875 |     X,\n 876 |     W=None,\n 877 |     H=None,\n 878 |     n_components=None,\n 879 |     *,\n 880 |     init=None,\n 881 |     update_H=True,\n 882 |     solver=\"cd\",\n 883 |     beta_loss=\"frobenius\",\n 884 |     tol=1e-4,\n 885 |     max_iter=200,\n 886 |     alpha=\"deprecated\",\n 887 |     alpha_W=0.0,\n 888 |     alpha_H=\"same\",\n 889 |     l1_ratio=0.0,\n 890 |     regularization=\"deprecated\",\n 891 |     random_state=None,\n 892 |     verbose=0,\n 893 |     shuffle=False,\n 894 | ):\n 895 |     \"\"\"Compute Non-negative Matrix Factorization (NMF).\n 896 | \n 897 |     Find two non-negative matrices (W, H) whose product approximates the non-\n 898 |     negative matrix X. This factorization can be used for example for\n 899 |     dimensionality reduction, source separation or topic extraction.\n 900 | \n 901 |     The objective function is:\n 902 | \n 903 |         .. math::\n 904 | \n 905 |             0.5 * ||X - WH||_{loss}^2\n 906 | \n 907 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n 908 | \n 909 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n 910 | \n 911 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n 912 | \n 913 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n 914 | \n 915 |     Where:\n 916 | \n 917 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n 918 | \n 919 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n 920 | \n 921 |     The generic norm :math:`||X - WH||_{loss}^2` may represent\n 922 |     the Frobenius norm or another supported beta-divergence loss.\n 923 |     The choice between options is controlled by the `beta_loss` parameter.\n 924 | \n 925 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n 926 |     `H` to keep their impact balanced with respect to one another and to the data fit\n 927 |     term as independent as possible of the size `n_samples` of the training set.\n 928 | \n 929 |     The objective function is minimized with an alternating minimization of W\n 930 |     and H. If H is given and update_H=False, it solves for W only.\n 931 | \n 932 |     Note that the transformed data is named W and the components matrix is named H. In\n 933 |     the NMF literature, the naming convention is usually the opposite since the data\n 934 |     matrix X is transposed.\n 935 | \n 936 |     Parameters\n 937 |     ----------\n 938 |     X : array-like of shape (n_samples, n_features)\n 939 |         Constant matrix.\n 940 | \n 941 |     W : array-like of shape (n_samples, n_components), default=None\n 942 |         If init='custom', it is used as initial guess for the solution.\n 943 | \n 944 |     H : array-like of shape (n_components, n_features), default=None\n 945 |         If init='custom', it is used as initial guess for the solution.\n 946 |         If update_H=False, it is used as a constant, to solve for W only.\n 947 | \n 948 |     n_components : int, default=None\n 949 |         Number of components, if n_components is not set all features\n 950 |         are kept.\n 951 | \n 952 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n 953 |         Method used to initialize the procedure.\n 954 | \n 955 |         Valid options:\n 956 | \n 957 |         - None: 'nndsvda' if n_components < n_features, otherwise 'random'.\n 958 | \n 959 |         - 'random': non-negative random matrices, scaled with:\n 960 |             sqrt(X.mean() / n_components)\n 961 | \n 962 |         - 'nndsvd': Nonnegative Double Singular Value Decomposition (NNDSVD)\n 963 |             initialization (better for sparseness)\n 964 | \n 965 |         - 'nndsvda': NNDSVD with zeros filled with the average of X\n 966 |             (better when sparsity is not desired)\n 967 | \n 968 |         - 'nndsvdar': NNDSVD with zeros filled with small random values\n 969 |             (generally faster, less accurate alternative to NNDSVDa\n 970 |             for when sparsity is not desired)\n 971 | \n 972 |         - 'custom': use custom matrices W and H if `update_H=True`. If\n 973 |           `update_H=False`, then only custom matrix H is used.\n 974 | \n 975 |         .. versionchanged:: 0.23\n 976 |             The default value of `init` changed from 'random' to None in 0.23.\n 977 | \n 978 |         .. versionchanged:: 1.1\n 979 |             When `init=None` and n_components is less than n_samples and n_features\n 980 |             defaults to `nndsvda` instead of `nndsvd`.\n 981 | \n 982 |     update_H : bool, default=True\n 983 |         Set to True, both W and H will be estimated from initial guesses.\n 984 |         Set to False, only W will be estimated.\n 985 | \n 986 |     solver : {'cd', 'mu'}, default='cd'\n 987 |         Numerical solver to use:\n 988 | \n 989 |         - 'cd' is a Coordinate Descent solver that uses Fast Hierarchical\n 990 |             Alternating Least Squares (Fast HALS).\n 991 | \n 992 |         - 'mu' is a Multiplicative Update solver.\n 993 | \n 994 |         .. versionadded:: 0.17\n 995 |            Coordinate Descent solver.\n 996 | \n 997 |         .. versionadded:: 0.19\n 998 |            Multiplicative Update solver.\n 999 | \n1000 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1001 |             'itakura-saito'}, default='frobenius'\n1002 |         Beta divergence to be minimized, measuring the distance between X\n1003 |         and the dot product WH. Note that values different from 'frobenius'\n1004 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1005 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1006 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1007 | \n1008 |         .. versionadded:: 0.19\n1009 | \n1010 |     tol : float, default=1e-4\n1011 |         Tolerance of the stopping condition.\n1012 | \n1013 |     max_iter : int, default=200\n1014 |         Maximum number of iterations before timing out.\n1015 | \n1016 |     alpha : float, default=0.0\n1017 |         Constant that multiplies the regularization terms. Set it to zero to have no\n1018 |         regularization. When using `alpha` instead of `alpha_W` and `alpha_H`, the\n1019 |         regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1020 |         factors for `W` (resp. `H`).\n1021 | \n1022 |         .. deprecated:: 1.0\n1023 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1024 |             Use `alpha_W` and `alpha_H` instead.\n1025 | \n1026 |     alpha_W : float, default=0.0\n1027 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1028 |         (default) to have no regularization on `W`.\n1029 | \n1030 |         .. versionadded:: 1.0\n1031 | \n1032 |     alpha_H : float or \"same\", default=\"same\"\n1033 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1034 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1035 |         `alpha_W`.\n1036 | \n1037 |         .. versionadded:: 1.0\n1038 | \n1039 |     l1_ratio : float, default=0.0\n1040 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1041 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1042 |         (aka Frobenius Norm).\n1043 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1044 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1045 | \n1046 |     regularization : {'both', 'components', 'transformation'}, default=None\n1047 |         Select whether the regularization affects the components (H), the\n1048 |         transformation (W), both or none of them.\n1049 | \n1050 |         .. deprecated:: 1.0\n1051 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1052 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1053 | \n1054 |     random_state : int, RandomState instance or None, default=None\n1055 |         Used for NMF initialisation (when ``init`` == 'nndsvdar' or\n1056 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1057 |         results across multiple function calls.\n1058 |         See :term:`Glossary <random_state>`.\n1059 | \n1060 |     verbose : int, default=0\n1061 |         The verbosity level.\n1062 | \n1063 |     shuffle : bool, default=False\n1064 |         If true, randomize the order of coordinates in the CD solver.\n1065 | \n1066 |     Returns\n1067 |     -------\n1068 |     W : ndarray of shape (n_samples, n_components)\n1069 |         Solution to the non-negative least squares problem.\n1070 | \n1071 |     H : ndarray of shape (n_components, n_features)\n1072 |         Solution to the non-negative least squares problem.\n1073 | \n1074 |     n_iter : int\n1075 |         Actual number of iterations.\n1076 | \n1077 |     Examples\n1078 |     --------\n1079 |     >>> import numpy as np\n1080 |     >>> X = np.array([[1,1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1081 |     >>> from sklearn.decomposition import non_negative_factorization\n1082 |     >>> W, H, n_iter = non_negative_factorization(X, n_components=2,\n1083 |     ... init='random', random_state=0)\n1084 | \n1085 |     References\n1086 |     ----------\n1087 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1088 |     large scale nonnegative matrix and tensor factorizations.\"\n1089 |     IEICE transactions on fundamentals of electronics, communications and\n1090 |     computer sciences 92.3: 708-721, 2009.\n1091 | \n1092 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1093 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1094 |     \"\"\"\n1095 |     X = check_array(X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32])\n1096 | \n1097 |     est = NMF(\n1098 |         n_components=n_components,\n1099 |         init=init,\n1100 |         solver=solver,\n1101 |         beta_loss=beta_loss,\n1102 |         tol=tol,\n1103 |         max_iter=max_iter,\n1104 |         random_state=random_state,\n1105 |         alpha=alpha,\n1106 |         alpha_W=alpha_W,\n1107 |         alpha_H=alpha_H,\n1108 |         l1_ratio=l1_ratio,\n1109 |         verbose=verbose,\n1110 |         shuffle=shuffle,\n1111 |         regularization=regularization,\n1112 |     )\n1113 | \n1114 |     with config_context(assume_finite=True):\n1115 |         W, H, n_iter = est._fit_transform(X, W=W, H=H, update_H=update_H)\n1116 | \n1117 |     return W, H, n_iter\n1118 | \n1119 | \n1120 | class NMF(_ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n1121 |     \"\"\"Non-Negative Matrix Factorization (NMF).\n1122 | \n1123 |     Find two non-negative matrices (W, H) whose product approximates the non-\n1124 |     negative matrix X. This factorization can be used for example for\n1125 |     dimensionality reduction, source separation or topic extraction.\n1126 | \n1127 |     The objective function is:\n1128 | \n1129 |         .. math::\n1130 | \n1131 |             0.5 * ||X - WH||_{loss}^2\n1132 | \n1133 |             + alpha\\\\_W * l1_{ratio} * n\\\\_features * ||vec(W)||_1\n1134 | \n1135 |             + alpha\\\\_H * l1_{ratio} * n\\\\_samples * ||vec(H)||_1\n1136 | \n1137 |             + 0.5 * alpha\\\\_W * (1 - l1_{ratio}) * n\\\\_features * ||W||_{Fro}^2\n1138 | \n1139 |             + 0.5 * alpha\\\\_H * (1 - l1_{ratio}) * n\\\\_samples * ||H||_{Fro}^2\n1140 | \n1141 |     Where:\n1142 | \n1143 |     :math:`||A||_{Fro}^2 = \\\\sum_{i,j} A_{ij}^2` (Frobenius norm)\n1144 | \n1145 |     :math:`||vec(A)||_1 = \\\\sum_{i,j} abs(A_{ij})` (Elementwise L1 norm)\n1146 | \n1147 |     The generic norm :math:`||X - WH||_{loss}` may represent\n1148 |     the Frobenius norm or another supported beta-divergence loss.\n1149 |     The choice between options is controlled by the `beta_loss` parameter.\n1150 | \n1151 |     The regularization terms are scaled by `n_features` for `W` and by `n_samples` for\n1152 |     `H` to keep their impact balanced with respect to one another and to the data fit\n1153 |     term as independent as possible of the size `n_samples` of the training set.\n1154 | \n1155 |     The objective function is minimized with an alternating minimization of W\n1156 |     and H.\n1157 | \n1158 |     Note that the transformed data is named W and the components matrix is named H. In\n1159 |     the NMF literature, the naming convention is usually the opposite since the data\n1160 |     matrix X is transposed.\n1161 | \n1162 |     Read more in the :ref:`User Guide <NMF>`.\n1163 | \n1164 |     Parameters\n1165 |     ----------\n1166 |     n_components : int, default=None\n1167 |         Number of components, if n_components is not set all features\n1168 |         are kept.\n1169 | \n1170 |     init : {'random', 'nndsvd', 'nndsvda', 'nndsvdar', 'custom'}, default=None\n1171 |         Method used to initialize the procedure.\n1172 |         Default: None.\n1173 |         Valid options:\n1174 | \n1175 |         - `None`: 'nndsvda' if n_components <= min(n_samples, n_features),\n1176 |           otherwise random.\n1177 | \n1178 |         - `'random'`: non-negative random matrices, scaled with:\n1179 |           sqrt(X.mean() / n_components)\n1180 | \n1181 |         - `'nndsvd'`: Nonnegative Double Singular Value Decomposition (NNDSVD)\n1182 |           initialization (better for sparseness)\n1183 | \n1184 |         - `'nndsvda'`: NNDSVD with zeros filled with the average of X\n1185 |           (better when sparsity is not desired)\n1186 | \n1187 |         - `'nndsvdar'` NNDSVD with zeros filled with small random values\n1188 |           (generally faster, less accurate alternative to NNDSVDa\n1189 |           for when sparsity is not desired)\n1190 | \n1191 |         - `'custom'`: use custom matrices W and H\n1192 | \n1193 |         .. versionchanged:: 1.1\n1194 |             When `init=None` and n_components is less than n_samples and n_features\n1195 |             defaults to `nndsvda` instead of `nndsvd`.\n1196 | \n1197 |     solver : {'cd', 'mu'}, default='cd'\n1198 |         Numerical solver to use:\n1199 |         'cd' is a Coordinate Descent solver.\n1200 |         'mu' is a Multiplicative Update solver.\n1201 | \n1202 |         .. versionadded:: 0.17\n1203 |            Coordinate Descent solver.\n1204 | \n1205 |         .. versionadded:: 0.19\n1206 |            Multiplicative Update solver.\n1207 | \n1208 |     beta_loss : float or {'frobenius', 'kullback-leibler', \\\n1209 |             'itakura-saito'}, default='frobenius'\n1210 |         Beta divergence to be minimized, measuring the distance between X\n1211 |         and the dot product WH. Note that values different from 'frobenius'\n1212 |         (or 2) and 'kullback-leibler' (or 1) lead to significantly slower\n1213 |         fits. Note that for beta_loss <= 0 (or 'itakura-saito'), the input\n1214 |         matrix X cannot contain zeros. Used only in 'mu' solver.\n1215 | \n1216 |         .. versionadded:: 0.19\n1217 | \n1218 |     tol : float, default=1e-4\n1219 |         Tolerance of the stopping condition.\n1220 | \n1221 |     max_iter : int, default=200\n1222 |         Maximum number of iterations before timing out.\n1223 | \n1224 |     random_state : int, RandomState instance or None, default=None\n1225 |         Used for initialisation (when ``init`` == 'nndsvdar' or\n1226 |         'random'), and in Coordinate Descent. Pass an int for reproducible\n1227 |         results across multiple function calls.\n1228 |         See :term:`Glossary <random_state>`.\n1229 | \n1230 |     alpha : float, default=0.0\n1231 |         Constant that multiplies the regularization terms. Set it to zero to\n1232 |         have no regularization. When using `alpha` instead of `alpha_W` and `alpha_H`,\n1233 |         the regularization terms are not scaled by the `n_features` (resp. `n_samples`)\n1234 |         factors for `W` (resp. `H`).\n1235 | \n1236 |         .. versionadded:: 0.17\n1237 |            *alpha* used in the Coordinate Descent solver.\n1238 | \n1239 |         .. deprecated:: 1.0\n1240 |             The `alpha` parameter is deprecated in 1.0 and will be removed in 1.2.\n1241 |             Use `alpha_W` and `alpha_H` instead.\n1242 | \n1243 |     alpha_W : float, default=0.0\n1244 |         Constant that multiplies the regularization terms of `W`. Set it to zero\n1245 |         (default) to have no regularization on `W`.\n1246 | \n1247 |         .. versionadded:: 1.0\n1248 | \n1249 |     alpha_H : float or \"same\", default=\"same\"\n1250 |         Constant that multiplies the regularization terms of `H`. Set it to zero to\n1251 |         have no regularization on `H`. If \"same\" (default), it takes the same value as\n1252 |         `alpha_W`.\n1253 | \n1254 |         .. versionadded:: 1.0\n1255 | \n1256 |     l1_ratio : float, default=0.0\n1257 |         The regularization mixing parameter, with 0 <= l1_ratio <= 1.\n1258 |         For l1_ratio = 0 the penalty is an elementwise L2 penalty\n1259 |         (aka Frobenius Norm).\n1260 |         For l1_ratio = 1 it is an elementwise L1 penalty.\n1261 |         For 0 < l1_ratio < 1, the penalty is a combination of L1 and L2.\n1262 | \n1263 |         .. versionadded:: 0.17\n1264 |            Regularization parameter *l1_ratio* used in the Coordinate Descent\n1265 |            solver.\n1266 | \n1267 |     verbose : int, default=0\n1268 |         Whether to be verbose.\n1269 | \n1270 |     shuffle : bool, default=False\n1271 |         If true, randomize the order of coordinates in the CD solver.\n1272 | \n1273 |         .. versionadded:: 0.17\n1274 |            *shuffle* parameter used in the Coordinate Descent solver.\n1275 | \n1276 |     regularization : {'both', 'components', 'transformation', None}, \\\n1277 |                      default='both'\n1278 |         Select whether the regularization affects the components (H), the\n1279 |         transformation (W), both or none of them.\n1280 | \n1281 |         .. versionadded:: 0.24\n1282 | \n1283 |         .. deprecated:: 1.0\n1284 |             The `regularization` parameter is deprecated in 1.0 and will be removed in\n1285 |             1.2. Use `alpha_W` and `alpha_H` instead.\n1286 | \n1287 |     Attributes\n1288 |     ----------\n1289 |     components_ : ndarray of shape (n_components, n_features)\n1290 |         Factorization matrix, sometimes called 'dictionary'.\n1291 | \n1292 |     n_components_ : int\n1293 |         The number of components. It is same as the `n_components` parameter\n1294 |         if it was given. Otherwise, it will be same as the number of\n1295 |         features.\n1296 | \n1297 |     reconstruction_err_ : float\n1298 |         Frobenius norm of the matrix difference, or beta-divergence, between\n1299 |         the training data ``X`` and the reconstructed data ``WH`` from\n1300 |         the fitted model.\n1301 | \n1302 |     n_iter_ : int\n1303 |         Actual number of iterations.\n1304 | \n1305 |     n_features_in_ : int\n1306 |         Number of features seen during :term:`fit`.\n1307 | \n1308 |         .. versionadded:: 0.24\n1309 | \n1310 |     feature_names_in_ : ndarray of shape (`n_features_in_`,)\n1311 |         Names of features seen during :term:`fit`. Defined only when `X`\n1312 |         has feature names that are all strings.\n1313 | \n1314 |         .. versionadded:: 1.0\n1315 | \n1316 |     See Also\n1317 |     --------\n1318 |     DictionaryLearning : Find a dictionary that sparsely encodes data.\n1319 |     MiniBatchSparsePCA : Mini-batch Sparse Principal Components Analysis.\n1320 |     PCA : Principal component analysis.\n1321 |     SparseCoder : Find a sparse representation of data from a fixed,\n1322 |         precomputed dictionary.\n1323 |     SparsePCA : Sparse Principal Components Analysis.\n1324 |     TruncatedSVD : Dimensionality reduction using truncated SVD.\n1325 | \n1326 |     References\n1327 |     ----------\n1328 |     Cichocki, Andrzej, and P. H. A. N. Anh-Huy. \"Fast local algorithms for\n1329 |     large scale nonnegative matrix and tensor factorizations.\"\n1330 |     IEICE transactions on fundamentals of electronics, communications and\n1331 |     computer sciences 92.3: 708-721, 2009.\n1332 | \n1333 |     Fevotte, C., & Idier, J. (2011). Algorithms for nonnegative matrix\n1334 |     factorization with the beta-divergence. Neural Computation, 23(9).\n1335 | \n1336 |     Examples\n1337 |     --------\n1338 |     >>> import numpy as np\n1339 |     >>> X = np.array([[1, 1], [2, 1], [3, 1.2], [4, 1], [5, 0.8], [6, 1]])\n1340 |     >>> from sklearn.decomposition import NMF\n1341 |     >>> model = NMF(n_components=2, init='random', random_state=0)\n1342 |     >>> W = model.fit_transform(X)\n1343 |     >>> H = model.components_\n1344 |     \"\"\"\n1345 | \n1346 |     def __init__(\n1347 |         self,\n1348 |         n_components=None,\n1349 |         *,\n1350 |         init=None,\n1351 |         solver=\"cd\",\n1352 |         beta_loss=\"frobenius\",\n1353 |         tol=1e-4,\n1354 |         max_iter=200,\n1355 |         random_state=None,\n1356 |         alpha=\"deprecated\",\n1357 |         alpha_W=0.0,\n1358 |         alpha_H=\"same\",\n1359 |         l1_ratio=0.0,\n1360 |         verbose=0,\n1361 |         shuffle=False,\n1362 |         regularization=\"deprecated\",\n1363 |     ):\n1364 |         self.n_components = n_components\n1365 |         self.init = init\n1366 |         self.solver = solver\n1367 |         self.beta_loss = beta_loss\n1368 |         self.tol = tol\n1369 |         self.max_iter = max_iter\n1370 |         self.random_state = random_state\n1371 |         self.alpha = alpha\n1372 |         self.alpha_W = alpha_W\n1373 |         self.alpha_H = alpha_H\n1374 |         self.l1_ratio = l1_ratio\n1375 |         self.verbose = verbose\n1376 |         self.shuffle = shuffle\n1377 |         self.regularization = regularization\n1378 | \n1379 |     def _more_tags(self):\n1380 |         return {\"requires_positive_X\": True}\n1381 | \n1382 |     def _check_params(self, X):\n1383 |         # n_components\n1384 |         self._n_components = self.n_components\n1385 |         if self._n_components is None:\n1386 |             self._n_components = X.shape[1]\n1387 |         if (\n1388 |             not isinstance(self._n_components, numbers.Integral)\n1389 |             or self._n_components <= 0\n1390 |         ):\n1391 |             raise ValueError(\n1392 |                 \"Number of components must be a positive integer; got \"\n1393 |                 f\"(n_components={self._n_components!r})\"\n1394 |             )\n1395 | \n1396 |         # max_iter\n1397 |         if not isinstance(self.max_iter, numbers.Integral) or self.max_iter < 0:\n1398 |             raise ValueError(\n1399 |                 \"Maximum number of iterations must be a positive \"\n1400 |                 f\"integer; got (max_iter={self.max_iter!r})\"\n1401 |             )\n1402 | \n1403 |         # tol\n1404 |         if not isinstance(self.tol, numbers.Number) or self.tol < 0:\n1405 |             raise ValueError(\n1406 |                 \"Tolerance for stopping criteria must be positive; got \"\n1407 |                 f\"(tol={self.tol!r})\"\n1408 |             )\n1409 | \n1410 |         # beta_loss\n1411 |         self._beta_loss = _beta_loss_to_float(self.beta_loss)\n1412 | \n1413 |         # solver\n1414 |         allowed_solver = (\"cd\", \"mu\")\n1415 |         if self.solver not in allowed_solver:\n1416 |             raise ValueError(\n1417 |                 f\"Invalid solver parameter: got {self.solver!r} instead of one of \"\n1418 |                 f\"{allowed_solver}\"\n1419 |             )\n1420 |         if self.solver != \"mu\" and self.beta_loss not in (2, \"frobenius\"):\n1421 |             # 'mu' is the only solver that handles other beta losses than 'frobenius'\n1422 |             raise ValueError(\n1423 |                 f\"Invalid beta_loss parameter: solver {self.solver!r} does not handle \"\n1424 |                 f\"beta_loss = {self.beta_loss!r}\"\n1425 |             )\n1426 |         if self.solver == \"mu\" and self.init == \"nndsvd\":\n1427 |             warnings.warn(\n1428 |                 \"The multiplicative update ('mu') solver cannot update \"\n1429 |                 \"zeros present in the initialization, and so leads to \"\n1430 |                 \"poorer results when used jointly with init='nndsvd'. \"\n1431 |                 \"You may try init='nndsvda' or init='nndsvdar' instead.\",\n1432 |                 UserWarning,\n1433 |             )\n1434 | \n1435 |         # alpha and regularization are deprecated in favor of alpha_W and alpha_H\n1436 |         # TODO clean up in 1.2\n1437 |         if self.alpha != \"deprecated\":\n1438 |             warnings.warn(\n1439 |                 \"`alpha` was deprecated in version 1.0 and will be removed \"\n1440 |                 \"in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1441 |                 FutureWarning,\n1442 |             )\n1443 |             alpha = self.alpha\n1444 |         else:\n1445 |             alpha = 0.0\n1446 | \n1447 |         if self.regularization != \"deprecated\":\n1448 |             warnings.warn(\n1449 |                 \"`regularization` was deprecated in version 1.0 and will be \"\n1450 |                 \"removed in 1.2. Use `alpha_W` and `alpha_H` instead\",\n1451 |                 FutureWarning,\n1452 |             )\n1453 |             allowed_regularization = (\"both\", \"components\", \"transformation\", None)\n1454 |             if self.regularization not in allowed_regularization:\n1455 |                 raise ValueError(\n1456 |                     f\"Invalid regularization parameter: got {self.regularization!r} \"\n1457 |                     f\"instead of one of {allowed_regularization}\"\n1458 |                 )\n1459 |             regularization = self.regularization\n1460 |         else:\n1461 |             regularization = \"both\"\n1462 | \n1463 |         (\n1464 |             self._l1_reg_W,\n1465 |             self._l1_reg_H,\n1466 |             self._l2_reg_W,\n1467 |             self._l2_reg_H,\n1468 |         ) = _compute_regularization(\n1469 |             alpha, self.alpha_W, self.alpha_H, self.l1_ratio, regularization\n1470 |         )\n1471 | \n1472 |         return self\n1473 | \n1474 |     def _check_w_h(self, X, W, H, update_H):\n1475 |         # check W and H, or initialize them\n1476 |         n_samples, n_features = X.shape\n1477 |         if self.init == \"custom\" and update_H:\n1478 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1479 |             _check_init(W, (n_samples, self._n_components), \"NMF (input W)\")\n1480 |             if H.dtype != X.dtype or W.dtype != X.dtype:\n1481 |                 raise TypeError(\n1482 |                     \"H and W should have the same dtype as X. Got \"\n1483 |                     \"H.dtype = {} and W.dtype = {}.\".format(H.dtype, W.dtype)\n1484 |                 )\n1485 |         elif not update_H:\n1486 |             _check_init(H, (self._n_components, n_features), \"NMF (input H)\")\n1487 |             if H.dtype != X.dtype:\n1488 |                 raise TypeError(\n1489 |                     \"H should have the same dtype as X. Got H.dtype = {}.\".format(\n1490 |                         H.dtype\n1491 |                     )\n1492 |                 )\n1493 |             # 'mu' solver should not be initialized by zeros\n1494 |             if self.solver == \"mu\":\n1495 |                 avg = np.sqrt(X.mean() / self._n_components)\n1496 |                 W = np.full((n_samples, self._n_components), avg, dtype=X.dtype)\n1497 |             else:\n1498 |                 W = np.zeros((n_samples, self._n_components), dtype=X.dtype)\n1499 |         else:\n1500 |             W, H = _initialize_nmf(\n1501 |                 X, self._n_components, init=self.init, random_state=self.random_state\n1502 |             )\n1503 |         return W, H\n1504 | \n1505 |     def _scale_regularization(self, X):\n1506 |         n_samples, n_features = X.shape\n1507 |         if self.alpha_W != 0 or self.alpha_H != \"same\":\n1508 |             # if alpha_W or alpha_H is not left to its default value we ignore alpha\n1509 |             # and regularization, and we scale the regularization terms.\n1510 |             l1_reg_W = n_features * self._l1_reg_W\n1511 |             l1_reg_H = n_samples * self._l1_reg_H\n1512 |             l2_reg_W = n_features * self._l2_reg_W\n1513 |             l2_reg_H = n_samples * self._l2_reg_H\n1514 |         else:\n1515 |             # Otherwise we keep the old behavior with no scaling\n1516 |             # TODO remove in 1.2\n1517 |             l1_reg_W = self._l1_reg_W\n1518 |             l1_reg_H = self._l1_reg_H\n1519 |             l2_reg_W = self._l2_reg_W\n1520 |             l2_reg_H = self._l2_reg_H\n1521 | \n1522 |         return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n1523 | \n1524 |     def fit_transform(self, X, y=None, W=None, H=None):\n1525 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1526 | \n1527 |         This is more efficient than calling fit followed by transform.\n1528 | \n1529 |         Parameters\n1530 |         ----------\n1531 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1532 |             Training vector, where `n_samples` is the number of samples\n1533 |             and `n_features` is the number of features.\n1534 | \n1535 |         y : Ignored\n1536 |             Not used, present for API consistency by convention.\n1537 | \n1538 |         W : array-like of shape (n_samples, n_components)\n1539 |             If init='custom', it is used as initial guess for the solution.\n1540 | \n1541 |         H : array-like of shape (n_components, n_features)\n1542 |             If init='custom', it is used as initial guess for the solution.\n1543 | \n1544 |         Returns\n1545 |         -------\n1546 |         W : ndarray of shape (n_samples, n_components)\n1547 |             Transformed data.\n1548 |         \"\"\"\n1549 |         X = self._validate_data(\n1550 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n1551 |         )\n1552 | \n1553 |         with config_context(assume_finite=True):\n1554 |             W, H, n_iter = self._fit_transform(X, W=W, H=H)\n1555 | \n1556 |         self.reconstruction_err_ = _beta_divergence(\n1557 |             X, W, H, self._beta_loss, square_root=True\n1558 |         )\n1559 | \n1560 |         self.n_components_ = H.shape[0]\n1561 |         self.components_ = H\n1562 |         self.n_iter_ = n_iter\n1563 | \n1564 |         return W\n1565 | \n1566 |     def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n1567 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1568 | \n1569 |         Parameters\n1570 |         ----------\n1571 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1572 |             Data matrix to be decomposed\n1573 | \n1574 |         y : Ignored\n1575 | \n1576 |         W : array-like of shape (n_samples, n_components)\n1577 |             If init='custom', it is used as initial guess for the solution.\n1578 | \n1579 |         H : array-like of shape (n_components, n_features)\n1580 |             If init='custom', it is used as initial guess for the solution.\n1581 |             If update_H=False, it is used as a constant, to solve for W only.\n1582 | \n1583 |         update_H : bool, default=True\n1584 |             If True, both W and H will be estimated from initial guesses,\n1585 |             this corresponds to a call to the 'fit_transform' method.\n1586 |             If False, only W will be estimated, this corresponds to a call\n1587 |             to the 'transform' method.\n1588 | \n1589 |         Returns\n1590 |         -------\n1591 |         W : ndarray of shape (n_samples, n_components)\n1592 |             Transformed data.\n1593 | \n1594 |         H : ndarray of shape (n_components, n_features)\n1595 |             Factorization matrix, sometimes called 'dictionary'.\n1596 | \n1597 |         n_iter_ : int\n1598 |             Actual number of iterations.\n1599 |         \"\"\"\n1600 |         check_non_negative(X, \"NMF (input X)\")\n1601 | \n1602 |         # check parameters\n1603 |         self._check_params(X)\n1604 | \n1605 |         if X.min() == 0 and self._beta_loss <= 0:\n1606 |             raise ValueError(\n1607 |                 \"When beta_loss <= 0 and X contains zeros, \"\n1608 |                 \"the solver may diverge. Please add small values \"\n1609 |                 \"to X, or use a positive beta_loss.\"\n1610 |             )\n1611 | \n1612 |         # initialize or check W and H\n1613 |         W, H = self._check_w_h(X, W, H, update_H)\n1614 | \n1615 |         # scale the regularization terms\n1616 |         l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H = self._scale_regularization(X)\n1617 | \n1618 |         if self.solver == \"cd\":\n1619 |             W, H, n_iter = _fit_coordinate_descent(\n1620 |                 X,\n1621 |                 W,\n1622 |                 H,\n1623 |                 self.tol,\n1624 |                 self.max_iter,\n1625 |                 l1_reg_W,\n1626 |                 l1_reg_H,\n1627 |                 l2_reg_W,\n1628 |                 l2_reg_H,\n1629 |                 update_H=update_H,\n1630 |                 verbose=self.verbose,\n1631 |                 shuffle=self.shuffle,\n1632 |                 random_state=self.random_state,\n1633 |             )\n1634 |         elif self.solver == \"mu\":\n1635 |             W, H, n_iter = _fit_multiplicative_update(\n1636 |                 X,\n1637 |                 W,\n1638 |                 H,\n1639 |                 self._beta_loss,\n1640 |                 self.max_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |         Returns\n1679 |         -------\n1680 |         self : object\n1681 |             Returns the instance itself.\n1682 |         \"\"\"\n1683 |         self.fit_transform(X, **params)\n1684 |         return self\n1685 | \n1686 |     def transform(self, X):\n1687 |         \"\"\"Transform the data X according to the fitted NMF model.\n1688 | \n1689 |         Parameters\n1690 |         ----------\n1691 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1692 |             Training vector, where `n_samples` is the number of samples\n1693 |             and `n_features` is the number of features.\n1694 | \n1695 |         Returns\n1696 |         -------\n1697 |         W : ndarray of shape (n_samples, n_components)\n1698 |             Transformed data.\n1699 |         \"\"\"\n1700 |         check_is_fitted(self)\n1701 |         X = self._validate_data(\n1702 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32], reset=False\n1703 |         )\n1704 | \n1705 |         with config_context(assume_finite=True):\n1706 |             W, *_ = self._fit_transform(X, H=self.components_, update_H=False)\n1707 | \n1708 |         return W\n1709 | \n1710 |     def inverse_transform(self, W):\n1711 |         \"\"\"Transform data back to its original space.\n1712 | \n1713 |         .. versionadded:: 0.18\n1714 | \n1715 |         Parameters\n1716 |         ----------\n1717 |         W : {ndarray, sparse matrix} of shape (n_samples, n_components)\n1718 |             Transformed data matrix.\n1719 | \n1720 |         Returns\n1721 |         -------\n1722 |         X : {ndarray, sparse matrix} of shape (n_samples, n_features)\n1723 |             Returns a data matrix of the original shape.\n1724 |         \"\"\"\n1725 |         check_is_fitted(self)\n1726 |         return np.dot(W, self.components_)\n1727 | \n1728 |     @property\n1729 |     def _n_features_out(self):\n1730 |         \"\"\"Number of transformed output features.\"\"\"\n1731 |         return self.components_.shape[0]\n1732 | \n```\n"}, {"content": "Based on the contents of `_nmf.py`, we need to focus on the parts of the code that deal with the NMF solver, particularly the multiplicative update solver and the beta-divergence calculations. The feature request mentions an online implementation of NMF that should support any beta divergence, not just Kullback-Leibler. \n\nLet's identify specific functions and classes that are relevant for implementing this feature:\n\n1. **NMF Class**: The main class for Non-negative Matrix Factorization.\n2. **_fit_multiplicative_update Function**: Handles the multiplicative update solver.\n3. **_beta_divergence Function**: Computes the beta-divergence between X and the dot product WH.\n4. **_multiplicative_update_w Function**: Updates W in the multiplicative update solver.\n5. **_multiplicative_update_h Function**: Updates H in the multiplicative update solver.\n\nWe'll also need to look at how the solver and beta divergence are handled within the `fit_transform` method of the `NMF` class.\n\nLet's start by listing the locations for these entities.\n\n```\nsklearn/decomposition/_nmf.py\nclass: NMF\nfunction: fit_transform\n\nsklearn/decomposition/_nmf.py\nfunction: _fit_multiplicative_update\n\nsklearn/decomposition/_nmf.py\nfunction: _beta_divergence\n\nsklearn/decomposition/_nmf.py\nfunction: _multiplicative_update_w\n\nsklearn/decomposition/_nmf.py\nfunction: _multiplicative_update_h\n```\n<finish></finish>", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "explore_tree_structure", "description": "\nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n", "parameters": {"type": "object", "properties": {"start_entities": {"description": "List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).", "type": "array", "items": {"type": "string"}}, "direction": {"description": "Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.", "type": "string", "enum": ["upstream", "downstream", "both"], "default": "downstream"}, "traversal_depth": {"description": "Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).", "type": "integer", "default": 2}, "entity_type_filter": {"description": "List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}, "dependency_type_filter": {"description": "List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.", "type": ["array", "null"], "items": {"type": "string"}, "default": null}}, "required": ["start_entities"]}}}], "usage": {"prompt_tokens": 59256, "completion_tokens": 664}, "time": 70.37393498420715}]}}
{"instance_id": "numpy__numpy-17394", "found_files": [["numpy/lib/stride_tricks.py", "numpy/core/numeric.py", "numpy/lib/function_base.py"]], "found_modules": [["numpy/lib/stride_tricks.py:as_strided", "numpy/core/numeric.py:roll", "numpy/core/numeric.py:rollaxis", "numpy/core/numeric.py:moveaxis"]], "found_entities": [["numpy/lib/stride_tricks.py:as_strided", "numpy/core/numeric.py:roll", "numpy/core/numeric.py:rollaxis", "numpy/core/numeric.py:moveaxis"]], "raw_output_loc": ["Based on the content of `numpy/core/numeric.py`, the `roll` function and related functions like `rollaxis` and `moveaxis` are in the same section dealing with array manipulation along axes. The `convolve` and `correlate` functions are also in this section, and they involve sliding operations over arrays, which makes this a suitable place for the `sliding_window` function.\n\nWe will also consider `numpy/lib/stride_tricks.py` since it contains the `as_strided` function, which is directly related to the low-level manipulation of strides required for the sliding window.\n\nAdditionally, `numpy/lib/function_base.py` contains several window-related functions, making it another logical place to add the `sliding_window` function.\n\nHere are the final locations for the `sliding_window` function:\n\n```\nnumpy/lib/stride_tricks.py\nfunction: as_strided\n\nnumpy/core/numeric.py\nfunction: roll\n\nnumpy/core/numeric.py\nfunction: rollaxis\n\nnumpy/core/numeric.py\nfunction: moveaxis\n\nnumpy/lib/function_base.py\n# No specific function found, but this file contains various window-related functions like kaiser, blackman, bartlett which can serve as good examples.\n```"], "meta_data": {"repo": "numpy/numpy", "base_commit": "43683b3256a86659f230dcadbcde1f8020398bfa", "problem_statement": "Suggestion: Sliding Window Function\nUsing `np.lib.stride_tricks.as_stride` one can very efficiently create a sliding window that segments an array as a preprocessing step for vectorized applications. For example a moving average of a window length `3`, stepsize `1`:\n\n```\na = numpy.arange(10)\na_strided = numpy.lib.stride_tricks.as_strided(\n    a, shape=(8, 3), strides=(8, 8)\n)\nprint numpy.mean(a_strided, axis=1)\n```\n\nThis is very performant but very hard to do, as the `shape` and `strides` parameters are very hard to understand.\n\nI suggest the implementation of a \"simple `sliding_window` function\" that does the job of figuring out those two parameters for you.\n\n[The implementation I have been using for years](https://gist.github.com/nils-werner/9d321441006b112a4b116a8387c2280c) allows the above to be replaced by\n\n```\na = numpy.arange(10)\na_strided = sliding_window(a, size=3, stepsize=1)\nprint numpy.mean(a_strided, axis=1)\n```\n\n@teoliphant [also has an implementation](https://gist.github.com/teoliphant/96eb779a16bd038e374f2703da62f06d) that would change the above to\n\n```\na = numpy.arange(10)\na_strided = array_for_sliding_window(a, 3)\nprint numpy.mean(a_strided, axis=1)\n```\n\nboth making it much more readable.\n\nSeeing it is a common usecase in vectorized computing I suggest we put a similar function into NumPy itself.\n\nRegarding to which implementation to follow, they are both assume different things but allow you to do the same thing eventually:\n\n`sliding_window`\n- slides over one axis only\n- allows setting windowsize and stepsize\n- returns array with dimension n+1\n- sliding over several axes requires two calls (which come for free as there is no memory reordered)\n- has a superfluous `copy` parameter that can be removed and replaced by appending `.copy()` after the call\n\n`array_for_sliding_window`\n- slides over all axes simultaneously, window lengths are given as `tuple` parameter\n- Assumes a stepsize one in all directions\n- returns array with dimension n*2\n- stepsize not equal to one requires slicing of output data (unsure if this implies copying data)\n- Disabling sliding over `axis[n]` requires you set argument `wshape[n] = 1` or `wshape[n] = a.shape[n]`\n\nThis means for flexible `stepsize` the following are equivalent (with some minor bug in `sliding_window` there):\n\n```\na = numpy.arange(10)\nprint sliding_window(a, size=3, stepsize=2)\n\na = numpy.arange(10)\nprint array_for_sliding_window(a, 3)[::2, :] # Stepsize 2 by dropping every 2nd row\n```\n\nfor sliding over one `axis` the following are equivalent (with some transposing and squeezing):\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(a, size=3, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (1, 3))\n```\n\nand for sliding over two `axis` the following are equivalent:\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(sliding_window(a, size=3, axis=0), size=2, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (3, 2))\n```\n\nThis issue is about sparking discussion about\n- Do we need such a function?\n- Which features are required?\n- Which interface should we persue?\n\nAfter discussion I am willing to draft up a pull request with an implementation we agreed on.\n\n", "patch": "diff --git a/doc/release/upcoming_changes/17394.new_function.rst b/doc/release/upcoming_changes/17394.new_function.rst\nnew file mode 100644\nindex 000000000000..50c9d1db310d\n--- /dev/null\n+++ b/doc/release/upcoming_changes/17394.new_function.rst\n@@ -0,0 +1,5 @@\n+``sliding_window_view`` provides a sliding window view for numpy arrays\n+-----------------------------------------------------------------------\n+`numpy.sliding_window_view` constructs views on numpy arrays that offer a\n+sliding or moving window access to the array. This allows for the simple\n+implementation of certain algorithms, such as running means.\ndiff --git a/doc/source/reference/routines.indexing.rst b/doc/source/reference/routines.indexing.rst\nindex aeec1a1bba55..a1c82c620340 100644\n--- a/doc/source/reference/routines.indexing.rst\n+++ b/doc/source/reference/routines.indexing.rst\n@@ -42,6 +42,7 @@ Indexing-like operations\n    diag\n    diagonal\n    select\n+   sliding_window_view\n    lib.stride_tricks.as_strided\n \n Inserting data into arrays\ndiff --git a/numpy/lib/stride_tricks.py b/numpy/lib/stride_tricks.py\nindex d8a8b325e3a4..a6c0da751abc 100644\n--- a/numpy/lib/stride_tricks.py\n+++ b/numpy/lib/stride_tricks.py\n@@ -6,9 +6,11 @@\n \n \"\"\"\n import numpy as np\n+from numpy.core.numeric import normalize_axis_tuple\n from numpy.core.overrides import array_function_dispatch, set_module\n \n-__all__ = ['broadcast_to', 'broadcast_arrays', 'broadcast_shapes']\n+__all__ = ['broadcast_to', 'broadcast_arrays', 'broadcast_shapes',\n+           'sliding_window_view']\n \n \n class DummyArray:\n@@ -67,6 +69,8 @@ def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n     --------\n     broadcast_to: broadcast an array to a given shape.\n     reshape : reshape an array.\n+    sliding_window_view: userfriendly and safe function for the creation of\n+        sliding window views.\n \n     Notes\n     -----\n@@ -111,6 +115,228 @@ def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n     return view\n \n \n+def _sliding_window_view_dispatcher(x, window_shape, axis=None, *,\n+                                    subok=None, writeable=None):\n+    return (x,)\n+\n+\n+@array_function_dispatch(_sliding_window_view_dispatcher, module='numpy')\n+def sliding_window_view(x, window_shape, axis=None, *,\n+                        subok=False, writeable=False):\n+    \"\"\"\n+    Create a sliding window view into the array with the given window shape.\n+\n+    Also known as rolling or moving window, the window slides across all\n+    dimensions of the array and extracts subsets of the array at all window\n+    positions.\n+    \n+    .. versionadded:: 1.20.0\n+\n+    Parameters\n+    ----------\n+    x : array_like\n+        Array to create the sliding window view from.\n+    window_shape : int or tuple of int\n+        Size of window over each axis that takes part in the sliding window.\n+        If `axis` is not present, must have same length as the number of input\n+        array dimensions. Single integers `i` are treated as if they were the\n+        tuple `(i,)`.\n+    axis : int or tuple of int, optional\n+        Axis or axes along which the sliding window is applied.\n+        By default, the sliding window is applied to all axes and\n+        `window_shape[i]` will refer to axis `i` of `x`.\n+        If `axis` is given as a `tuple of int`, `window_shape[i]` will refer to\n+        the axis `axis[i]` of `x`.\n+        Single integers `i` are treated as if they were the tuple `(i,)`.\n+    subok : bool, optional\n+        If True, sub-classes will be passed-through, otherwise the returned\n+        array will be forced to be a base-class array (default).\n+    writeable : bool, optional\n+        When true, allow writing to the returned view. The default is false,\n+        as this should be used with caution: the returned view contains the\n+        same memory location multiple times, so writing to one location will\n+        cause others to change.\n+\n+    Returns\n+    -------\n+    view : ndarray\n+        Sliding window view of the array. The sliding window dimensions are\n+        inserted at the end, and the original dimensions are trimmed as\n+        required by the size of the sliding window.\n+        That is, ``view.shape = x_shape_trimmed + window_shape``, where\n+        ``x_shape_trimmed`` is ``x.shape`` with every entry reduced by one less\n+        than the corresponding window size.\n+\n+    See Also\n+    --------\n+    lib.stride_tricks.as_strided: A lower-level and less safe routine for\n+        creating arbitrary views from custom shape and strides.\n+    broadcast_to: broadcast an array to a given shape.\n+\n+    Notes\n+    -----\n+    For many applications using a sliding window view can be convenient, but\n+    potentially very slow. Often specialized solutions exist, for example:\n+\n+    - `scipy.signal.fftconvolve`\n+\n+    - filtering functions in `scipy.ndimage`\n+\n+    - moving window functions provided by\n+      `bottleneck <https://github.com/pydata/bottleneck>`_.\n+\n+    As a rough estimate, a sliding window approach with an input size of `N`\n+    and a window size of `W` will scale as `O(N*W)` where frequently a special\n+    algorithm can achieve `O(N)`. That means that the sliding window variant\n+    for a window size of 100 can be a 100 times slower than a more specialized\n+    version.\n+\n+    Nevertheless, for small window sizes, when no custom algorithm exists, or\n+    as a prototyping and developing tool, this function can be a good solution.\n+\n+    Examples\n+    --------\n+    >>> x = np.arange(6)\n+    >>> x.shape\n+    (6,)\n+    >>> v = np.sliding_window_view(x, 3)\n+    >>> v.shape\n+    (4, 3)\n+    >>> v\n+    array([[0, 1, 2],\n+           [1, 2, 3],\n+           [2, 3, 4],\n+           [3, 4, 5]])\n+\n+    This also works in more dimensions, e.g.\n+\n+    >>> i, j = np.ogrid[:3, :4]\n+    >>> x = 10*i + j\n+    >>> x.shape\n+    (3, 4)\n+    >>> x\n+    array([[ 0,  1,  2,  3],\n+           [10, 11, 12, 13],\n+           [20, 21, 22, 23]])\n+    >>> shape = (2,2)\n+    >>> v = np.sliding_window_view(x, shape)\n+    >>> v.shape\n+    (2, 3, 2, 2)\n+    >>> v\n+    array([[[[ 0,  1],\n+             [10, 11]],\n+            [[ 1,  2],\n+             [11, 12]],\n+            [[ 2,  3],\n+             [12, 13]]],\n+           [[[10, 11],\n+             [20, 21]],\n+            [[11, 12],\n+             [21, 22]],\n+            [[12, 13],\n+             [22, 23]]]])\n+\n+    The axis can be specified explicitly:\n+\n+    >>> v = np.sliding_window_view(x, 3, 0)\n+    >>> v.shape\n+    (1, 4, 3)\n+    >>> v\n+    array([[[ 0, 10, 20],\n+            [ 1, 11, 21],\n+            [ 2, 12, 22],\n+            [ 3, 13, 23]]])\n+\n+    The same axis can be used several times. In that case, every use reduces\n+    the corresponding original dimension:\n+\n+    >>> v = np.sliding_window_view(x, (2, 3), (1, 1))\n+    >>> v.shape\n+    (3, 1, 2, 3)\n+    >>> v\n+    array([[[[ 0,  1,  2],\n+             [ 1,  2,  3]]],\n+           [[[10, 11, 12],\n+             [11, 12, 13]]],\n+           [[[20, 21, 22],\n+             [21, 22, 23]]]])\n+\n+    Combining with stepped slicing (`::step`), this can be used to take sliding\n+    views which skip elements:\n+\n+    >>> x = np.arange(7)\n+    >>> np.sliding_window_view(x, 5)[:, ::2]\n+    array([[0, 2, 4],\n+           [1, 3, 5],\n+           [2, 4, 6]])\n+\n+    or views which move by multiple elements\n+\n+    >>> x = np.arange(7)\n+    >>> np.sliding_window_view(x, 3)[::2, :]\n+    array([[0, 1, 2],\n+           [2, 3, 4],\n+           [4, 5, 6]])\n+\n+    A common application of `sliding_window_view` is the calculation of running\n+    statistics. The simplest example is the\n+    `moving average <https://en.wikipedia.org/wiki/Moving_average>`_:\n+\n+    >>> x = np.arange(6)\n+    >>> x.shape\n+    (6,)\n+    >>> v = np.sliding_window_view(x, 3)\n+    >>> v.shape\n+    (4, 3)\n+    >>> v\n+    array([[0, 1, 2],\n+           [1, 2, 3],\n+           [2, 3, 4],\n+           [3, 4, 5]])\n+    >>> moving_average = v.mean(axis=-1)\n+    >>> moving_average\n+    array([1., 2., 3., 4.])\n+\n+    Note that a sliding window approach is often **not** optimal (see Notes).\n+    \"\"\"\n+    window_shape = (tuple(window_shape)\n+                    if np.iterable(window_shape)\n+                    else (window_shape,))\n+    # first convert input to array, possibly keeping subclass\n+    x = np.array(x, copy=False, subok=subok)\n+\n+    window_shape_array = np.array(window_shape)\n+    if np.any(window_shape_array < 0):\n+        raise ValueError('`window_shape` cannot contain negative values')\n+\n+    if axis is None:\n+        axis = tuple(range(x.ndim))\n+        if len(window_shape) != len(axis):\n+            raise ValueError(f'Since axis is `None`, must provide '\n+                             f'window_shape for all dimensions of `x`; '\n+                             f'got {len(window_shape)} window_shape elements '\n+                             f'and `x.ndim` is {x.ndim}.')\n+    else:\n+        axis = normalize_axis_tuple(axis, x.ndim, allow_duplicate=True)\n+        if len(window_shape) != len(axis):\n+            raise ValueError(f'Must provide matching length window_shape and '\n+                             f'axis; got {len(window_shape)} window_shape '\n+                             f'elements and {len(axis)} axes elements.')\n+\n+    out_strides = x.strides + tuple(x.strides[ax] for ax in axis)\n+\n+    # note: same axis can be windowed repeatedly\n+    x_shape_trimmed = list(x.shape)\n+    for ax, dim in zip(axis, window_shape):\n+        if x_shape_trimmed[ax] < dim:\n+            raise ValueError(\n+                'window shape cannot be larger than input array shape')\n+        x_shape_trimmed[ax] -= dim - 1\n+    out_shape = tuple(x_shape_trimmed) + window_shape\n+    return as_strided(x, strides=out_strides, shape=out_shape,\n+                      subok=subok, writeable=writeable)\n+\n+\n def _broadcast_to(array, shape, subok, readonly):\n     shape = tuple(shape) if np.iterable(shape) else (shape,)\n     array = np.array(array, copy=False, subok=subok)\n"}, "usage": {"cost($)": "0", "prompt_tokens": 132677, "completion_tokens": 831}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nexplore_graph_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 1, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Args:\n    start_entities:\n    direction:\n    traversal_depth:\n    entity_type_filter:\n    dependency_type_filter:\n    Returns:\n\nexplore_tree_structure(start_entities: List[str], direction: str = 'downstream', traversal_depth: int = 2, entity_type_filter: Optional[List[str]] = None, dependency_type_filter: Optional[List[str]] = None):\n    Analyzes and displays the dependency structure around specified entities in a code graph.\n    This function searches and presents relationships and dependencies for the specified entities (such as classes, functions, files, or directories) in a code graph.\n    It explores how the input entities relate to others, using defined types of dependencies, including 'contains', 'imports', 'invokes' and 'inherits'.\n    The search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n    Example Usage:\n    1. Exploring Outward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_a.py:ClassA'],\n    direction='downstream',\n    traversal_depth=2,\n    entity_type_filter=['class', 'function'],\n    dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n    2. Exploring Inward Dependencies:\n    ```\n    get_local_structure(\n    start_entities=['src/module_b.py:FunctionY'],\n    direction='upstream',\n    traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n    Notes:\n    * Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n    * Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n    * Graph Context: The function operates on a pre-built code graph containing entities (e.g., files, classes and functions) and dependencies representing their interactions and relationships.\n    Parameters:\n    ----------\n    start_entities : list[str]\n    List of entities (e.g., class, function, file, or directory paths) to begin the search from.\n    - Entities representing classes or functions must be formatted as \"file_path:QualifiedName\"\n    (e.g., `interface/C.py:C.method_a.inner_func`).\n    - For files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n    direction : str, optional\n    Direction of traversal in the code graph; allowed options are:\n    - 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n    - 'downstream': Traversal to explore the effects or interactions of the specified entities on others\n    (how others depend on them).\n    - 'both': Traversal in both directions.\n    Default is 'downstream'.\n    traversal_depth : int, optional\n    Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).\n    Must be either `-1` or a non-negative integer (\u2265 0).\n    Default is 2.\n    entity_type_filter : list[str], optional\n    List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal.\n    If None, all entity types are included.\n    Default is None.\n    dependency_type_filter : list[str], optional\n    List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal.\n    If None, all dependency types are included.\n    Default is None.\n    Returns:\n    -------\n    result : object\n    An object representing the traversal results, which includes discovered entities and their dependencies.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Comprehensive Dependency Analysis: Prioritize analyzing the code dependencies of functions, methods, or classes mentioned in the problem description or those identified in relevant locations. Use `search_invoke_and_reference` as the primary tool to ensure all interactions within the codebase are captured.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: explore_tree_structure ----\nDescription: \nUnified repository exploring tool that traverses a pre-built code graph to retrieve dependency structure around specified entities.\nThe search can be controlled to traverse upstream (exploring dependencies that entities rely on) or downstream (exploring how entities impact others), with optional limits on traversal depth and filters for entity and dependency types.\n\nCode Graph Definition:\n* Entity Types: 'directory', 'file', 'class', 'function'.\n* Dependency Types: 'contains', 'imports', 'invokes', 'inherits'.\n* Hierarchy:\n    - Directories contain files and subdirectories.\n    - Files contain classes and functions.\n    - Classes contain inner classes and methods.\n    - Functions can contain inner functions.\n* Interactions:\n    - Files/classes/functions can import classes and functions.\n    - Classes can inherit from other classes.\n    - Classes and functions can invoke others (invocations in a class's `__init__` are attributed to the class).\nEntity ID:\n* Unique identifier including file path and module path.\n* Here's an example of an Entity ID: `\"interface/C.py:C.method_a.inner_func\"` identifies function `inner_func` within `method_a` of class `C` in `\"interface/C.py\"`.\n\nNotes:\n* Traversal Control: The `traversal_depth` parameter specifies how deep the function should explore the graph starting from the input entities.\n* Filtering: Use `entity_type_filter` and `dependency_type_filter` to narrow down the scope of the search, focusing on specific entity types and relationships.\n\n\nExample Usage:\n1. Exploring Outward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_a.py:ClassA'],\n        direction='downstream',\n        traversal_depth=2,\n        dependency_type_filter=['invokes', 'imports']\n    )\n    ```\n    This retrieves the dependencies of `ClassA` up to 2 levels deep, focusing only on classes and functions with 'invokes' and 'imports' relationships.\n\n2. Exploring Inward Dependencies:\n    ```\n    explore_tree_structure(\n        start_entities=['src/module_b.py:FunctionY'],\n        direction='upstream',\n        traversal_depth=-1\n    )\n    ```\n    This finds all entities that depend on `FunctionY` without restricting the traversal depth.\n3. Exploring Repository Structure:\n    ```\n    explore_tree_structure(\n      start_entities=['/'],\n      traversal_depth=2,\n      dependency_type_filter=['contains']\n    )\n    ```\n    This retrieves the tree repository structure from the root directory (/), traversing up to two levels deep and focusing only on 'contains' relationship.\n4. Generate Class Diagrams:\n    ```\n    explore_tree_structure(\n        start_entities=selected_entity_ids,\n        direction='both',\n        traverse_depth=-1,\n        dependency_type_filter=['inherits']\n    )\n    ```\n\nParameters:\n  (1) start_entities (array, required): List of entities (e.g., class, function, file, or directory paths) to begin the search from.\nEntities representing classes or functions must be formatted as \"file_path:QualifiedName\" (e.g., `interface/C.py:C.method_a.inner_func`).\nFor files or directories, provide only the file or directory path (e.g., `src/module_a.py` or `src/`).\n  (2) direction (string, optional): Direction of traversal in the code graph; allowed options are: `upstream`, `downstream`, `both`.\n- 'upstream': Traversal to explore dependencies that the specified entities rely on (how they depend on others).\n- 'downstream': Traversal to explore the effects or interactions of the specified entities on others (how others depend on them).\n- 'both': Traversal on both direction.\nAllowed values: [`upstream`, `downstream`, `both`]\n  (3) traversal_depth (integer, optional): Maximum depth of traversal. A value of -1 indicates unlimited depth (subject to a maximum limit).Must be either `-1` or a non-negative integer (\u2265 0).\n  (4) entity_type_filter (['array', 'null'], optional): List of entity types (e.g., 'class', 'function', 'file', 'directory') to include in the traversal. If None, all entity types are included.\n  (5) dependency_type_filter (['array', 'null'], optional): List of dependency types (e.g., 'contains', 'imports', 'invokes', 'inherits') to include in the traversal. If None, all dependency types are included.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'numpy' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n- Consider upstream and downstream dependencies that may affect or be affected by the issue.\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Suggestion: Sliding Window Function\n\nUsing `np.lib.stride_tricks.as_stride` one can very efficiently create a sliding window that segments an array as a preprocessing step for vectorized applications. For example a moving average of a window length `3`, stepsize `1`:\n\n```\na = numpy.arange(10)\na_strided = numpy.lib.stride_tricks.as_strided(\n    a, shape=(8, 3), strides=(8, 8)\n)\nprint numpy.mean(a_strided, axis=1)\n```\n\nThis is very performant but very hard to do, as the `shape` and `strides` parameters are very hard to understand.\n\nI suggest the implementation of a \"simple `sliding_window` function\" that does the job of figuring out those two parameters for you.\n\n[The implementation I have been using for years](https://gist.github.com/nils-werner/9d321441006b112a4b116a8387c2280c) allows the above to be replaced by\n\n```\na = numpy.arange(10)\na_strided = sliding_window(a, size=3, stepsize=1)\nprint numpy.mean(a_strided, axis=1)\n```\n\n@teoliphant [also has an implementation](https://gist.github.com/teoliphant/96eb779a16bd038e374f2703da62f06d) that would change the above to\n\n```\na = numpy.arange(10)\na_strided = array_for_sliding_window(a, 3)\nprint numpy.mean(a_strided, axis=1)\n```\n\nboth making it much more readable.\n\nSeeing it is a common usecase in vectorized computing I suggest we put a similar function into NumPy itself.\n\nRegarding to which implementation to follow, they are both assume different things but allow you to do the same thing eventually:\n\n`sliding_window`\n- slides over one axis only\n- allows setting windowsize and stepsize\n- returns array with dimension n+1\n- sliding over several axes requires two calls (which come for free as there is no memory reordered)\n- has a superfluous `copy` parameter that can be removed and replaced by appending `.copy()` after the call\n\n`array_for_sliding_window`\n- slides over all axes simultaneously, window lengths are given as `tuple` parameter\n- Assumes a stepsize one in all directions\n- returns array with dimension n*2\n- stepsize not equal to one requires slicing of output data (unsure if this implies copying data)\n- Disabling sliding over `axis[n]` requires you set argument `wshape[n] = 1` or `wshape[n] = a.shape[n]`\n\nThis means for flexible `stepsize` the following are equivalent (with some minor bug in `sliding_window` there):\n\n```\na = numpy.arange(10)\nprint sliding_window(a, size=3, stepsize=2)\n\na = numpy.arange(10)\nprint array_for_sliding_window(a, 3)[::2, :] # Stepsize 2 by dropping every 2nd row\n```\n\nfor sliding over one `axis` the following are equivalent (with some transposing and squeezing):\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(a, size=3, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (1, 3))\n```\n\nand for sliding over two `axis` the following are equivalent:\n\n```\na = numpy.arange(25).reshape(5, 5)\nprint sliding_window(sliding_window(a, size=3, axis=0), size=2, axis=1)\n\na = numpy.arange(25).reshape(5, 5)\nprint array_for_sliding_window(a, (3, 2))\n```\n\nThis issue is about sparking discussion about\n- Do we need such a function?\n- Which features are required?\n- Which interface should we persue?\n\nAfter discussion I am willing to draft up a pull request with an implementation we agreed on.\n--- END PROBLEM STATEMENT ---\n\nIMPORTANT: You should ONLY interact with the environment provided to you AND NEVER ASK FOR HUMAN HELP.\nDon't include any lambda functions!\nYou should NOT modify any files!\n"}, {"content": "To start, let's categorize and extract key information from the issue description:\n\n- **Requested feature description**: A simple `sliding_window` function to create a sliding window for vectorized applications, replacing complex `as_strided` usage.\n- **Behavior without this feature**: Using `np.lib.stride_tricks.as_strided` directly, which requires manual calculation of `shape` and `strides` parameters and is less intuitive.\n- **Expected behavior with the feature**: A straightforward function to specify window size and stepsize, simplifying the creation of sliding windows and improving readability.\n- **Additional context**: Two existing implementations (`sliding_window` by @nils-werner and `array_for_sliding_window` by @teoliphant) are discussed, highlighting differences in flexibility and usage patterns.\n\nFrom the additional context, the modules mentioned are `np.lib.stride_tricks`. Since we're looking for a new feature, it makes sense to explore the files related to this module to see where the new function could fit.\n\nLet's start by exploring the structure of the `numpy/lib/stride_tricks.py` file to familiarize ourselves with its contents and identify potential areas for adding the new `sliding_window` function.\n\n<function=get_entity_contents>\n<parameter=entity_names>['numpy/lib/stride_tricks.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `numpy/lib/stride_tricks.py`...\n### Search Result:\nFound file `numpy/lib/stride_tricks.py`.\nSource: Exact match found for entity name `numpy/lib/stride_tricks.py`.\n```\n  1 | \"\"\"\n  2 | Utilities that manipulate strides to achieve desirable effects.\n  3 | \n  4 | An explanation of strides can be found in the \"ndarray.rst\" file in the\n  5 | NumPy reference guide.\n  6 | \n  7 | \"\"\"\n  8 | import numpy as np\n  9 | from numpy.core.overrides import array_function_dispatch, set_module\n 10 | \n 11 | __all__ = ['broadcast_to', 'broadcast_arrays', 'broadcast_shapes']\n 12 | \n 13 | \n 14 | class DummyArray:\n 15 |     \"\"\"Dummy object that just exists to hang __array_interface__ dictionaries\n 16 |     and possibly keep alive a reference to a base array.\n 17 |     \"\"\"\n 18 | \n 19 |     def __init__(self, interface, base=None):\n 20 |         self.__array_interface__ = interface\n 21 |         self.base = base\n 22 | \n 23 | \n 24 | def _maybe_view_as_subclass(original_array, new_array):\n 25 |     if type(original_array) is not type(new_array):\n 26 |         # if input was an ndarray subclass and subclasses were OK,\n 27 |         # then view the result as that subclass.\n 28 |         new_array = new_array.view(type=type(original_array))\n 29 |         # Since we have done something akin to a view from original_array, we\n 30 |         # should let the subclass finalize (if it has it implemented, i.e., is\n 31 |         # not None).\n 32 |         if new_array.__array_finalize__:\n 33 |             new_array.__array_finalize__(original_array)\n 34 |     return new_array\n 35 | \n 36 | \n 37 | def as_strided(x, shape=None, strides=None, subok=False, writeable=True):\n 38 |     \"\"\"\n 39 |     Create a view into the array with the given shape and strides.\n 40 | \n 41 |     .. warning:: This function has to be used with extreme care, see notes.\n 42 | \n 43 |     Parameters\n 44 |     ----------\n 45 |     x : ndarray\n 46 |         Array to create a new.\n 47 |     shape : sequence of int, optional\n 48 |         The shape of the new array. Defaults to ``x.shape``.\n 49 |     strides : sequence of int, optional\n 50 |         The strides of the new array. Defaults to ``x.strides``.\n 51 |     subok : bool, optional\n 52 |         .. versionadded:: 1.10\n 53 | \n 54 |         If True, subclasses are preserved.\n 55 |     writeable : bool, optional\n 56 |         .. versionadded:: 1.12\n 57 | \n 58 |         If set to False, the returned array will always be readonly.\n 59 |         Otherwise it will be writable if the original array was. It\n 60 |         is advisable to set this to False if possible (see Notes).\n 61 | \n 62 |     Returns\n 63 |     -------\n 64 |     view : ndarray\n 65 | \n 66 |     See also\n 67 |     --------\n 68 |     broadcast_to: broadcast an array to a given shape.\n 69 |     reshape : reshape an array.\n 70 | \n 71 |     Notes\n 72 |     -----\n 73 |     ``as_strided`` creates a view into the array given the exact strides\n 74 |     and shape. This means it manipulates the internal data structure of\n 75 |     ndarray and, if done incorrectly, the array elements can point to\n 76 |     invalid memory and can corrupt results or crash your program.\n 77 |     It is advisable to always use the original ``x.strides`` when\n 78 |     calculating new strides to avoid reliance on a contiguous memory\n 79 |     layout.\n 80 | \n 81 |     Furthermore, arrays created with this function often contain self\n 82 |     overlapping memory, so that two elements are identical.\n 83 |     Vectorized write operations on such arrays will typically be\n 84 |     unpredictable. They may even give different results for small, large,\n 85 |     or transposed arrays.\n 86 |     Since writing to these arrays has to be tested and done with great\n 87 |     care, you may want to use ``writeable=False`` to avoid accidental write\n 88 |     operations.\n 89 | \n 90 |     For these reasons it is advisable to avoid ``as_strided`` when\n 91 |     possible.\n 92 |     \"\"\"\n 93 |     # first convert input to array, possibly keeping subclass\n 94 |     x = np.array(x, copy=False, subok=subok)\n 95 |     interface = dict(x.__array_interface__)\n 96 |     if shape is not None:\n 97 |         interface['shape'] = tuple(shape)\n 98 |     if strides is not None:\n 99 |         interface['strides'] = tuple(strides)\n100 | \n101 |     array = np.asarray(DummyArray(interface, base=x))\n102 |     # The route via `__interface__` does not preserve structured\n103 |     # dtypes. Since dtype should remain unchanged, we set it explicitly.\n104 |     array.dtype = x.dtype\n105 | \n106 |     view = _maybe_view_as_subclass(x, array)\n107 | \n108 |     if view.flags.writeable and not writeable:\n109 |         view.flags.writeable = False\n110 | \n111 |     return view\n112 | \n113 | \n114 | def _broadcast_to(array, shape, subok, readonly):\n115 |     shape = tuple(shape) if np.iterable(shape) else (shape,)\n116 |     array = np.array(array, copy=False, subok=subok)\n117 |     if not shape and array.shape:\n118 |         raise ValueError('cannot broadcast a non-scalar to a scalar array')\n119 |     if any(size < 0 for size in shape):\n120 |         raise ValueError('all elements of broadcast shape must be non-'\n121 |                          'negative')\n122 |     extras = []\n123 |     it = np.nditer(\n124 |         (array,), flags=['multi_index', 'refs_ok', 'zerosize_ok'] + extras,\n125 |         op_flags=['readonly'], itershape=shape, order='C')\n126 |     with it:\n127 |         # never really has writebackifcopy semantics\n128 |         broadcast = it.itviews[0]\n129 |     result = _maybe_view_as_subclass(array, broadcast)\n130 |     # In a future version this will go away\n131 |     if not readonly and array.flags._writeable_no_warn:\n132 |         result.flags.writeable = True\n133 |         result.flags._warn_on_write = True\n134 |     return result\n135 | \n136 | \n137 | def _broadcast_to_dispatcher(array, shape, subok=None):\n138 |     return (array,)\n139 | \n140 | \n141 | @array_function_dispatch(_broadcast_to_dispatcher, module='numpy')\n142 | def broadcast_to(array, shape, subok=False):\n143 |     \"\"\"Broadcast an array to a new shape.\n144 | \n145 |     Parameters\n146 |     ----------\n147 |     array : array_like\n148 |         The array to broadcast.\n149 |     shape : tuple\n150 |         The shape of the desired array.\n151 |     subok : bool, optional\n152 |         If True, then sub-classes will be passed-through, otherwise\n153 |         the returned array will be forced to be a base-class array (default).\n154 | \n155 |     Returns\n156 |     -------\n157 |     broadcast : array\n158 |         A readonly view on the original array with the given shape. It is\n159 |         typically not contiguous. Furthermore, more than one element of a\n160 |         broadcasted array may refer to a single memory location.\n161 | \n162 |     Raises\n163 |     ------\n164 |     ValueError\n165 |         If the array is not compatible with the new shape according to NumPy's\n166 |         broadcasting rules.\n167 | \n168 |     See Also\n169 |     --------\n170 |     broadcast\n171 |     broadcast_arrays\n172 |     broadcast_shapes\n173 | \n174 |     Notes\n175 |     -----\n176 |     .. versionadded:: 1.10.0\n177 | \n178 |     Examples\n179 |     --------\n180 |     >>> x = np.array([1, 2, 3])\n181 |     >>> np.broadcast_to(x, (3, 3))\n182 |     array([[1, 2, 3],\n183 |            [1, 2, 3],\n184 |            [1, 2, 3]])\n185 |     \"\"\"\n186 |     return _broadcast_to(array, shape, subok=subok, readonly=True)\n187 | \n188 | \n189 | def _broadcast_shape(*args):\n190 |     \"\"\"Returns the shape of the arrays that would result from broadcasting the\n191 |     supplied arrays against each other.\n192 |     \"\"\"\n193 |     # use the old-iterator because np.nditer does not handle size 0 arrays\n194 |     # consistently\n195 |     b = np.broadcast(*args[:32])\n196 |     # unfortunately, it cannot handle 32 or more arguments directly\n197 |     for pos in range(32, len(args), 31):\n198 |         # ironically, np.broadcast does not properly handle np.broadcast\n199 |         # objects (it treats them as scalars)\n200 |         # use broadcasting to avoid allocating the full array\n201 |         b = broadcast_to(0, b.shape)\n202 |         b = np.broadcast(b, *args[pos:(pos + 31)])\n203 |     return b.shape\n204 | \n205 | \n206 | @set_module('numpy')\n207 | def broadcast_shapes(*args):\n208 |     \"\"\"\n209 |     Broadcast the input shapes into a single shape.\n210 | \n211 |     :ref:`Learn more about broadcasting here <basics.broadcasting>`.\n212 | \n213 |     .. versionadded:: 1.20.0\n214 | \n215 |     Parameters\n216 |     ----------\n217 |     `*args` : tuples of ints, or ints\n218 |         The shapes to be broadcast against each other.\n219 | \n220 |     Returns\n221 |     -------\n222 |     tuple\n223 |         Broadcasted shape.\n224 | \n225 |     Raises\n226 |     ------\n227 |     ValueError\n228 |         If the shapes are not compatible and cannot be broadcast according\n229 |         to NumPy's broadcasting rules.\n230 | \n231 |     See Also\n232 |     --------\n233 |     broadcast\n234 |     broadcast_arrays\n235 |     broadcast_to\n236 | \n237 |     Examples\n238 |     --------\n239 |     >>> np.broadcast_shapes((1, 2), (3, 1), (3, 2))\n240 |     (3, 2)\n241 | \n242 |     >>> np.broadcast_shapes((6, 7), (5, 6, 1), (7,), (5, 1, 7))\n243 |     (5, 6, 7)\n244 |     \"\"\"\n245 |     arrays = [np.empty(x, dtype=[]) for x in args]\n246 |     return _broadcast_shape(*arrays)\n247 | \n248 | \n249 | def _broadcast_arrays_dispatcher(*args, subok=None):\n250 |     return args\n251 | \n252 | \n253 | @array_function_dispatch(_broadcast_arrays_dispatcher, module='numpy')\n254 | def broadcast_arrays(*args, subok=False):\n255 |     \"\"\"\n256 |     Broadcast any number of arrays against each other.\n257 | \n258 |     Parameters\n259 |     ----------\n260 |     `*args` : array_likes\n261 |         The arrays to broadcast.\n262 | \n263 |     subok : bool, optional\n264 |         If True, then sub-classes will be passed-through, otherwise\n265 |         the returned arrays will be forced to be a base-class array (default).\n266 | \n267 |     Returns\n268 |     -------\n269 |     broadcasted : list of arrays\n270 |         These arrays are views on the original arrays.  They are typically\n271 |         not contiguous.  Furthermore, more than one element of a\n272 |         broadcasted array may refer to a single memory location. If you need\n273 |         to write to the arrays, make copies first. While you can set the\n274 |         ``writable`` flag True, writing to a single output value may end up\n275 |         changing more than one location in the output array.\n276 | \n277 |         .. deprecated:: 1.17\n278 |             The output is currently marked so that if written to, a deprecation\n279 |             warning will be emitted. A future version will set the\n280 |             ``writable`` flag False so writing to it will raise an error.\n281 | \n282 |     See Also\n283 |     --------\n284 |     broadcast\n285 |     broadcast_to\n286 |     broadcast_shapes\n287 | \n288 |     Examples\n289 |     --------\n290 |     >>> x = np.array([[1,2,3]])\n291 |     >>> y = np.array([[4],[5]])\n292 |     >>> np.broadcast_arrays(x, y)\n293 |     [array([[1, 2, 3],\n294 |            [1, 2, 3]]), array([[4, 4, 4],\n295 |            [5, 5, 5]])]\n296 | \n297 |     Here is a useful idiom for getting contiguous copies instead of\n298 |     non-contiguous views.\n299 | \n300 |     >>> [np.array(a) for a in np.broadcast_arrays(x, y)]\n301 |     [array([[1, 2, 3],\n302 |            [1, 2, 3]]), array([[4, 4, 4],\n303 |            [5, 5, 5]])]\n304 | \n305 |     \"\"\"\n306 |     # nditer is not used here to avoid the limit of 32 arrays.\n307 |     # Otherwise, something like the following one-liner would suffice:\n308 |     # return np.nditer(args, flags=['multi_index', 'zerosize_ok'],\n309 |     #                  order='C').itviews\n310 | \n311 |     args = [np.array(_m, copy=False, subok=subok) for _m in args]\n312 | \n313 |     shape = _broadcast_shape(*args)\n314 | \n315 |     if all(array.shape == shape for array in args):\n316 |         # Common case where nothing needs to be broadcasted.\n317 |         return args\n318 | \n319 |     return [_broadcast_to(array, shape, subok=subok, readonly=False)\n320 |             for array in args]\n321 | \n```\n"}, {"content": "Based on the issue description and the content of `numpy/lib/stride_tricks.py`, the `sliding_window` function seems most relevant to be added near the existing `as_strided` function, given its purpose and functionality.\n\nNext, let's search for other places in the NumPy codebase where similar functionalities might be needed or where the feature could integrate well. We'll look for mentions of sliding window or similar concepts.\n\n<function=search_code_snippets>\n<parameter=search_terms>[\"sliding window\", \"rolling window\", \"window\", \"stride\"]</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nnumpy/core/setup_common.py:long_double_representation\nnumpy/core/setup_common.py:long_double_representation\nnumpy/polynomial/_polybase.py:ABCPolyBase.__repr__\nnumpy/polynomial/_polybase.py:ABCPolyBase.__init__\nnumpy/polynomial/_polybase.py:ABCPolyBase.fit\nnumpy/polynomial/_polybase.py:ABCPolyBase.convert\nnumpy/polynomial/_polybase.py:ABCPolyBase.identity\nnumpy/polynomial/_