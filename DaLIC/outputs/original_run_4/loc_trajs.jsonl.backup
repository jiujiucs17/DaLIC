ew()\n12819 |             0.0\n12820 | \n12821 |             With a DataFrame\n12822 | \n12823 |             >>> df = pd.DataFrame({'a': [1, 2, 3], 'b': [2, 3, 4], 'c': [1, 3, 5]},\n12824 |             ...                   index=['tiger', 'zebra', 'cow'])\n12825 |             >>> df\n12826 |                     a   b   c\n12827 |             tiger   1   2   1\n12828 |             zebra   2   3   3\n12829 |             cow     3   4   5\n12830 |             >>> df.skew()\n12831 |             a   0.0\n12832 |             b   0.0\n12833 |             c   0.0\n12834 |             dtype: float64\n12835 | \n12836 |             Using axis=1\n12837 | \n12838 |             >>> df.skew(axis=1)\n12839 |             tiger   1.732051\n12840 |             zebra  -1.732051\n12841 |             cow     0.000000\n12842 |             dtype: float64\n12843 | \n12844 |             In this case, `numeric_only` should be set to `True` to avoid\n12845 |             getting an error.\n12846 | \n12847 |             >>> df = pd.DataFrame({'a': [1, 2, 3], 'b': ['T', 'Z', 'X']},\n12848 |             ...                   index=['tiger', 'zebra', 'cow'])\n12849 |             >>> df.skew(numeric_only=True)\n12850 |             a   0.0\n12851 |             dtype: float64\"\"\"\n12852 |         kwargs = {\"min_count\": \"\"}\n12853 | \n12854 |     elif name == \"kurt\":\n12855 |         base_doc = _num_doc\n12856 |         desc = (\n12857 |             \"Return unbiased kurtosis over requested axis.\\n\\n\"\n12858 |             \"Kurtosis obtained using Fisher's definition of\\n\"\n12859 |             \"kurtosis (kurtosis of normal == 0.0). Normalized \"\n12860 |             \"by N-1.\"\n12861 |         )\n12862 |         see_also = \"\"\n12863 |         examples = \"\"\"\n12864 | \n12865 |             Examples\n12866 |             --------\n12867 |             >>> s = pd.Series([1, 2, 2, 3], index=['cat', 'dog', 'dog', 'mouse'])\n12868 |             >>> s\n12869 |             cat    1\n12870 |  