 of\n369 |         # each line\n370 |         for w in line.split()[1:]:\n371 |             read.pop(0)\n372 |             read.append(w)\n373 | \n374 |             # If the end of read is equal to the after_sequence, read contains\n375 |             # the long double\n376 |             if read[-8:] == _AFTER_SEQ:\n377 |                 saw = copy.copy(read)\n378 |                 # if the content was 12 bytes, we only have 32 - 8 - 12 = 12\n379 |                 # \"before\" bytes. In other words the first 4 \"before\" bytes went\n380 |                 # past the sliding window.\n381 |                 if read[:12] == _BEFORE_SEQ[4:]:\n382 |                     if read[12:-8] == _INTEL_EXTENDED_12B:\n383 |                         return 'INTEL_EXTENDED_12_BYTES_LE'\n384 |                     if read[12:-8] == _MOTOROLA_EXTENDED_12B:\n385 |                         return 'MOTOROLA_EXTENDED_12_BYTES_BE'\n386 |                 # if the content was 16 bytes, we are left with 32-8-16 = 16\n387 |                 # \"before\" bytes, so 8 went past the sliding window.\n388 |                 elif read[:8] == _BEFORE_SEQ[8:]:\n389 |                     if read[8:-8] == _INTEL_EXTENDED_16B:\n390 |                         return 'INTEL_EXTENDED_16_BYTES_LE'\n391 |                     elif read[8:-8] == _IEEE_QUAD_PREC_BE:\n392 |                         return 'IEEE_QUAD_BE'\n393 |                     elif read[8:-8] == _IEEE_QUAD_PREC_LE:\n394 |                         return 'IEEE_QUAD_LE'\n395 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_LE:\n396 |                         return 'IBM_DOUBLE_DOUBLE_LE'\n397 |                     elif read[8:-8] == _IBM_DOUBLE_DOUBLE_BE:\n398 |                         return 'IBM_DOUBLE_DOUBLE_BE'\n399 |                 # if the content was 8 bytes, left with 32-8-8 = 16 bytes\n400 |                 elif read[:16] == _BEFORE_SEQ:\n401 |                     if read[16:-8] == _IEEE_DOUBLE_LE:\n402 |                         return 'IEEE_DOUBLE_LE'\n403 |                     elif read[16:-8] == _IEEE_DOUBLE_BE:\n404 |                         return 'IEEE_DOUBLE_BE'\n405 | \n406 |     if saw is not None:\n407 |         raise ValueError(\"Unrecognized format (%s)\" % saw)\n408 |     else:\n409 |         # We never detected the after_sequence\n410 |         raise ValueError(\"Could not lock sequences (%s)\" % saw)\n```\n\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.__repr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n306 | def __repr__(self):\n307 |         coef = repr(self.coef)[6:-1]\n308 |         domain = repr(self.domain)[6:-1]\n309 |         window = repr(self.window)[6:-1]\n310 |         name = self.__class__.__name__\n311 |         return f\"{name}({coef}, domain={domain}, window={window})\"\n```\n\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.convert`.\nSource: Retrieved code content using keyword search (bm25).\n```\n732 | def convert(self, domain=None, kind=None, window=None):\n733 |         \"\"\"Convert series to a different kind and/or domain and/or window.\n734 | \n735 |         Parameters\n736 |         ----------\n737 |         domain : array_like, optional\n738 |             The domain of the converted series. If the value is None,\n739 |             the default domain of `kind` is used.\n740 |         kind : class, optional\n741 |             The polynomial series type class to which the current instance\n742 |             should be converted. If kind is None, then the class of the\n743 |             current instance is used.\n744 |         window : array_like, optional\n745 |             The window of the converted series. If the value is None,\n746 |             the default window of `kind` is used.\n747 | \n748 |         Returns\n749 |         -------\n750 |         new_series : series\n751 |             The returned class can be of different type than the current\n752 |             instance and/or have a different domain and/or different\n753 |             window.\n754 | \n755 |         Notes\n756 |         -----\n757 |         Conversion between domains and class types can result in\n758 |         numerically ill defined series.\n759 | \n760 |         Examples\n761 |         --------\n762 | \n763 |         \"\"\"\n764 |         if kind is None:\n765 |             kind = self.__class__\n766 |         if domain is None:\n767 |             domain = kind.domain\n768 |         if window is None:\n769 |             window = kind.window\n770 |         return self(kind.identity(domain, window=window))\n```\n\nFound function `numpy/polynomial/_polybase.py:ABCPolyBase.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n904 | def fit(cls, x, y, deg, domain=None, rcond=None, full=False, w=None,\n905 |         window=None):\n906 |         \"\"\"Least squares fit to data.\n907 | \n908 |         Return a series instance that is the least squares fit to the data\n909 |         `y` sampled at `x`. The domain of the returned instance can be\n910 |         specified and this will often result in a superior fit with less\n911 |         chance of ill conditioning.\n912 | \n913 |         Parameters\n914 |         ----------\n915 |         x : array_like, shape (M,)\n916 |             x-coordinates of the M sample points ``(x[i], y[i])``.\n917 |         y : array_like, shape (M,)\n918 |             y-coordinates of the M sample points ``(x[i], y[i])``.\n919 |         deg : int or 1-D array_like\n920 |             Degree(s) of the fitting polynomials. If `deg` is a single integer\n921 |             all terms up to and including the `deg`'th term are included in the\n922 |             fit. For NumPy versions >= 1.11.0 a list of integers specifying the\n923 |             degrees of the terms to include may be used instead.\n924 |         domain : {None, [beg, end], []}, optional\n925 |             Domain to use for the returned series. If ``None``,\n926 |             then a minimal domain