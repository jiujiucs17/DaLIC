ts)\n 254 |         Ground truth (correct) target values.\n 255 | \n 256 |     y_pred : array-like of shape (n_samples,) or (n_samples, n_outputs)\n 257 |         Estimated target values.\n 258 | \n 259 |     sample_weight : array-like of shape (n_samples,), default=None\n 260 |         Sample weights.\n 261 | \n 262 |     alpha : float, slope of the pinball loss, default=0.5,\n 263 |         This loss is equivalent to :ref:`mean_absolute_error` when `alpha=0.5`,\n 264 |         `alpha=0.95` is minimized by estimators of the 95th percentile.\n 265 | \n 266 |     multioutput : {'raw_values', 'uniform_average'}  or array-like of shape \\\n 267 |             (n_outputs,), default='uniform_average'\n 268 |         Defines aggregating of multiple output values.\n 269 |         Array-like value defines weights used to average errors.\n 270 | \n 271 |         'raw_values' :\n 272 |             Returns a full set of errors in case of multioutput input.\n 273 | \n 274 |         'uniform_average' :\n 275 |             Errors of all outputs are averaged with uniform weight.\n 276 | \n 277 |     Returns\n 278 |     -------\n 279 |     loss : float or ndarray of floats\n 280 |         If multioutput is 'raw_values', then mean absolute error is returned\n 281 |         for each output separately.\n 282 |         If multioutput is 'uniform_average' or an ndarray of weights, then the\n 283 |         weighted average of all output errors is returned.\n 284 | \n 285 |         The pinball loss output is a non-negative floating point. The best\n 286 |         value is 0.0.\n 287 | \n 288 |     Examples\n 289 |     --------\n 290 |     >>> from sklearn.metrics import mean_pinball_loss\n 291 |     >>> y_true = [1, 2, 3]\n 292 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.1)\n 293 |     np.float64(0.03...)\n 294 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.1)\n 295 |     np.float64(0.3...)\n 296 |     >>> mean_pinball_loss(y_true, [0, 2, 3], alpha=0.9)\n 297 |     np.float64(0.3...)\n 298 |     >>> mean_pinball_loss(y_true, [1, 2, 4], alpha=0.9)\n 299 |     np.float64(0.03...)\n 300 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.1)\n 301 |     np.float64(0.0)\n 302 |     >>> mean_pinball_loss(y_true, y_true, alpha=0.9)\n 303 |     np.float64(0.0)\n 304 |     \"\"\"\n 305 |     y_type, y_true, y_pred, multioutput = _check_reg_targets(\n 306 |         y_true, y_pred, multioutput\n 307 |     )\n 308 |     check_consistent_length(y_true, y_pred, sample_weight)\n 309 |     diff = y_true - y_pred\n 310 |     sign = (diff >= 0).astype(diff.dtype)\n 311 |     loss = alpha * sign * diff - (1 - alpha) * (1 - sign) * diff\n 312 |     output_errors = np.average(loss, weights=sample_weight, axis=0)\n 313 | \n 314 |     if isinstance(multioutput, str) and multioutput == \"raw_values\":\n 315 |         return output_errors\n 316 | \n 317 |     if isinstance(multioutput, str) and multioutput == \"uniform_average\":\n 318 |         # pass None as weights to np.average: uniform mean\n 319 |         multioutput = None\n 320 | \n 321 |     return np.average(output_errors, weights=multioutput)\n 322 | \n 323 | \n 324 | @validate_params(\n 325 |     {\n 326 |         \"y_true\": [\"array-like\"],\n 327 |         \"y_pred\": [\"array-like\"],\n 328 |         \"sample_weight\": [\"array-like\", None],\n 329 |         \"multioutput\": [StrOptions({\"raw_values\", \"uniform_average\"}), \"array-like\"],\n 330 |     },\n 331 |     prefer_skip_nested_validation=True,\n 332 | )\n 333 | def mean_absolute_percentage_error(\n 334 |     y_true, y_pred, *, sample_weight=None, multioutput=\"uniform_average\"\n 335 | ):\n 336 |     \"\"\"Mean absolute percentage error (MAPE) regression loss.\n 337 | \n 338 |     Note that we are not using the common \"percentage\" definition: the percentage\n 339 |     in the range [0, 100] is converted to a relative value in the range [0, 1]\n 340 |     by dividing by 100. Thus, an error of 200% corresponds to a relative error