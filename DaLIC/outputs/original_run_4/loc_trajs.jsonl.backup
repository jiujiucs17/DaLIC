class has its own standard deviation with QDA.\n 11 | \"\"\"\n 12 | print(__doc__)\n 13 | \n 14 | from scipy import linalg\n 15 | import numpy as np\n 16 | import matplotlib.pyplot as plt\n 17 | import matplotlib as mpl\n 18 | from matplotlib import colors\n 19 | \n 20 | from sklearn.discriminant_analysis import LinearDiscriminantAnalysis\n 21 | from sklearn.discriminant_analysis import QuadraticDiscriminantAnalysis\n 22 | \n 23 | # #############################################################################\n 24 | # Colormap\n 25 | cmap = colors.LinearSegmentedColormap(\n 26 |     'red_blue_classes',\n 27 |     {'red': [(0, 1, 1), (1, 0.7, 0.7)],\n 28 |      'green': [(0, 0.7, 0.7), (1, 0.7, 0.7)],\n 29 |      'blue': [(0, 0.7, 0.7), (1, 1, 1)]})\n 30 | plt.cm.register_cmap(cmap=cmap)\n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n50 | b2 = plt.scatter(X_test[:, 0], X_test[:, 1], c='blueviolet', s=s,\n51 |                  edgecolors='k')\n52 | c = plt.scatter(X_outliers[:, 0], X_outliers[:, 1], c='gold', s=s,\n53 |                 edgecolors='k')\n54 | plt.axis('tight')\n55 | plt.xlim((-5, 5))\n56 | plt.ylim((-5, 5))\n57 | plt.legend([a.collections[0], b1, b2, c],\n58 |            [\"learned frontier\", \"training observations\",\n59 |             \"new regular observations\", \"new abnormal observations\"],\n60 |            loc=\"upper left\",\n61 |            prop=matplotlib.font_manager.FontProperties(size=11))\n62 | plt.xlabel(\n63 |     \"error train: %d/200 ; errors novel regular: %d/40 ; \"\n64 |     \"errors novel abnormal: %d/40\"\n65 |     % (n_error_train, n_error_test, n_error_outliers))\n66 | plt.show()\n67 | \n```\n\nFound .\nSource: Retrieved code content using keyword search (bm25).\n```\n64 | roc_display = RocCurveDisplay(fpr=fpr, tpr=tpr).plot()\n65 | \n66 | # %%\n67 | # Create :class:`PrecisionRecallDisplay`\n68 | ##############################################################################\n69 | # Similarly, the precision recall curve can be plotted using `y_score` from\n70 | # the prevision sections.\n71 | from sklearn.metrics import precision_recall_curve\n72 | from sklearn.metrics import PrecisionRecallDisplay\n73 | \n74 | prec, recall, _ = precision_recall_curve(y_test, y_score,\n75 |                                          pos_label=clf.classes_[1])\n76 | pr_display = PrecisionRecallDisplay(precision=prec, recall=recall).plot()\n77 | \n78 | # %%\n79 | # Combining the display objects into a single plot\n80 | ##############################################################################\n81 | # The display objects store the computed values that were passed as arguments.\n82 | # This allows for the visualizations to be easliy combined using matplotlib's\n83 | # API. In the following example, we place the displays next to each other in a\n84 | # row.\n85 | \n86 | # sphinx_gallery_thumbnail_number = 4\n87 | import matplotlib.pyplot as plt\n88 | fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 8))\n89 | \n90 | roc_display.plot(ax=ax1)\n91 | pr_display.plot(ax=ax2)\n92 | plt.show()\n93 | \n```\n\nFound code snippet in file `examples/decomposition/plot_beta_divergence.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ==============================\n 3 | Beta-divergence loss functions\n 4 | ==============================\n 5 | \n 6 | A plot that compares the various Beta-divergence loss functions supported by\n 7 | the Multiplicative-Update ('mu') solver in :class:`~sklearn.decomposition.NMF`.\n 8 | \"\"\"\n 9 | import numpy as np\n10 | import matplotlib.pyplot as plt\n11 | from sklearn.decomposition._nmf import _beta_divergence\n12 | \n13 | print(__doc__)\n14 | \n15 | x = np.linspace(0.001, 4, 1000)\n16 | y = np.zeros(x.shape)\n17 | \n18 | colors = 'mbgyr'\n19 | for j, beta in enumerate((0., 0.5, 1., 1.5, 2.)):\n20 |     for i, xi in enumerate(x):\n21 |         y[i] = _beta_divergence(1, xi, 1, beta)\n22 |     name = \"beta = %1.1f\" % beta\n23 |     plt.plot(x, y, label=name, color=colors[j])\n24 | \n25 | plt.xlabel(\"x\")\n26 | plt.title(\"beta-divergence(1, x)\")\n27 | plt.legend(loc=0)\n28 | plt.axis([0, 4, 0, 3])\n29 | plt.show()\n30 | \n```\n\nFound code snippet in file `examples/mixture/plot_gmm_pdf.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =========================================\n 3 | Density Estimation for a Gaussian mixture\n 4 | =========================================\n 5 | \n 6 | Plot the density estimation of a mixture of two Gaussians. Data is\n 7 | generated from two Gaussians with different centers and covariance\n 8 | matrices.\n 9 | \"\"\"\n10 | \n11 | import numpy as np\n12 | import matplotlib.pyplot as plt\n13 | from matplotlib.colors import LogNorm\n14 | from sklearn import mixture\n15 | \n16 | n_samples = 300\n17 | \n18 | # generate random sample, two components\n19 | np.random.seed(0)\n20 | \n21 | # generate spherical data centered on (20, 20)\n22 | shifted_gaussian = np.random.randn(n_samples, 2) + np.array([20, 20])\n23 | \n24 | # generate zero centered stretched Gaussian data\n25 | C = np.array([[0., -0.7], [3.5, .7]])\n26 | stretched_gaussian = np.dot(np.random.randn(n_samples, 2), C)\n27 | \n28 | # concatenate the two datasets into the final training set\n29 | X_train = np.vstack([shifted_gaussian, stretched_gaussian])\n30 | \n31 | # fit a Gaussian Mixture Model with two components\n32 | clf = mixture.GaussianMixture(n_components=2, covariance_type='full')\n33 | clf.fit(X_train)\n34 | \n35 | # display predicted scores by the model as a contour plot\n36 | x = np.linspace(-20., 30.)\n37 | y = np.linspace(-20., 40.)\n38 | X, Y = np.meshgrid(x, y)\n39 | XX = np.array([X.ravel(), Y.ravel()]).T\n40 | Z = -clf.score_samples(XX)\n41 | Z = Z.reshape(X.shape)\n42 | \n43 | CS = plt.contour(X, Y, Z, norm=LogNorm(vmin=1.0, vmax=1000.0),\n44 |                  levels=np.logspace(0, 3, 10))\n45 | CB = plt.colorbar(CS, shrink=0.8, extend='both')\n46 | plt.scatter(X_train[:, 0], X_train[:, 1], .8)\n47 | \n48 | plt.title('Negative log-likelihood predicted by a GMM')\n49 | plt.axis('tight')\n50 | plt.show()\n51 | \n```\n\nFound file `examples/ensemble/plot_ensemble_oob.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/ensemble/plot_ensemble_oob.py` for the full content if needed.\n"}, {"content": "Based on the search results, the key modules for adding a calibration curve plotting function appear to be in the `sklearn/metrics/_plot/` directory, as this directory contains other plotting functions for metrics.\n\nWe will focus on the following files:\n- `sklearn/metrics/_plot/det_curve.py`\n- `sklearn/metrics/_plot/precision_recall_curve.py`\n- `sklearn/metrics/_plot/roc_curve.py`\n- `sklearn/metrics/_plot/confusion_matrix.py`\n- `sklearn/metrics/_plot/base.py` (likely to contain base classes for plotting)\n\nLet's examine the contents of `sklearn/metrics/_plot/base.py` to understand the structure and see if there is a good place to add the new function.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/metrics/_plot/base.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `sklearn/metrics/_plot/base.py`...\n### Search Result:\nFound file `sklearn/metrics/_plot/base.py`.\nSource: Exact match found for entity name `sklearn/metrics/_plot/base.py`.\n```\n  1 | import numpy as np\n  2 | \n  3 | from ...base import is_classifier\n  4 | \n  5 | \n  6 | def _check_classifier_response_method(estimator, response_method):\n  7 |     \"\"\"Return prediction method from the response_method\n  8 | \n  9 |     Parameters\n 10 |     ----------\n 11 |     estimator: object\n 12 |         Classifier to check\n 13 | \n 14 |     response_method: {'auto', 'predict_proba', 'decision_function'}\n 15 |         Specifies whether to use :term:`predict_proba` or\n 16 |         :term:`decision_function` as the target response. If set to 'auto',\n 17 |         :term:`predict_proba` is tried first and if it does not exist\n 18 |         :term:`decision_function` is tried next.\n 19 | \n 20 |     Returns\n 21 |     -------\n 22 |     prediction_method: callable\n 23 |         prediction method of estimator\n 24 |     \"\"\"\n 25 | \n 26 |     if response_method not in (\"predict_proba\", \"decision_function\", \"auto\"):\n 27 |         raise ValueError(\n 28 |             \"response_method must be 'predict_proba', 'decision_function' or 'auto'\"\n 29 |         )\n 30 | \n 31 |     error_msg = \"response method {} is not defined in {}\"\n 32 |     if response_method != \"auto\":\n 33 |         prediction_method = getattr(estimator, response_method, None)\n 34 |         if prediction_method is None:\n 35 |             raise ValueError(\n 36 |                 error_msg.format(response_method, estimator.__class__.__name__)\n 37 |             )\n 38 |     else:\n 39 |         predict_proba = getattr(estimator, \"predict_proba\", None)\n 40 |         decision_function = getattr(estimator, \"decision_function\", None)\n 41 |         prediction_method = predict_proba or decision_function\n 42 |         if prediction_method is None:\n 43 |             raise ValueError(\n 44 |                 error_msg.format(\n 45 |                     \"decision_function or predict_proba\", estimator.__class__.__name__\n 46 |                 )\n 47 |             )\n 48 | \n 49 |     return prediction_method\n 50 | \n 51 | \n 52 | def _get_response(X, estimator, response_method, pos_label=None):\n 53 |     \"\"\"Return response and positive label.\n 54 | \n 55 |     Parameters\n 56 |     ----------\n 57 |     X : {array-like, sparse matrix} of shape (n_samples, n_features)\n 58 |         Input values.\n 59 | \n 60 |     estimator : estimator instance\n 61 |         Fitted classifier or a fitted :class:`~sklearn.pipeline.Pipeline`\n 62 |         in which the last estimator is a classifier.\n 63 | \n 64 |     response_method: {'auto', 'predict_proba', 'decision_function'}\n 65 |         Specifies whether to use :term:`predict_proba` or\n 66 |         :term:`decision_function` as the target response. If set to 'auto',\n 67 |         :term:`predict_proba` is tried first and if it does not exist\n 68 |         :term:`decision_function` is tried next.\n 69 | \n 70 |     pos_label : str or int, default=None\n 71 |         The class considered as the positive class when computing\n 72 |         the metrics. By default, `estimators.classes_[1]` is\n 73 |         considered as the positive class.\n 74 | \n 75 |     Returns\n 76 |     -------\n 77 |     y_pred: ndarray of shape (n_samples,)\n 78 |         Target scores calculated from the provided response_method\n 79 |         and pos_label.\n 80 | \n 81 |     pos_label: str or int\n 82 |         The class considered as the positive class when computing\n 83 |         the metrics.\n 84 |     \"\"\"\n 85 |     classification_error = (\n 86 |         \"Expected 'estimator' to be a binary classifier, but got\"\n 87 |         f\" {estimator.__class__.__name__}\"\n 88 |     )\n 89 | \n 90 |     if not is_classifier(estimator):\n 91 |         raise ValueError(classification_error)\n 92 | \n 93 |     prediction_method = _check_classifier_response_method(estimator, response_method)\n 94 | \n 95 |     y_pred = prediction_method(X)\n 96 | \n 97 |     if pos_label is not None and pos_label not in estimator.classes_:\n 98 |         raise ValueError(\n 99 |             \"The class provided by 'pos_label' is unknown. Got \"\n100 |             f\"{pos_label} instead of one of {estimator.classes_}\"\n101 |         )\n102 | \n103 |     if y_pred.ndim != 1:  # `predict_proba`\n104 |         if y_pred.shape[1] != 2:\n105 |             raise ValueError(classification_error)\n106 |         if pos_label is None:\n107 |             pos_label = estimator.classes_[1]\n108 |             y_pred = y_pred[:, 1]\n109 |         else:\n110 |             class_idx = np.flatnonzero(estimator.classes_ == pos_label)\n111 |             y_pred = y_pred[:, class_idx]\n112 |     else:\n113 |         if pos_label is None:\n114 |             pos_label = estimator.classes_[1]\n115 |         elif pos_label == estimator.classes_[0]:\n116 |             y_pred *= -1\n117 | \n118 |     return y_pred, pos_label\n119 | \n```\n"}, {"content": "Given the contents of `sklearn/metrics/_plot/base.py`, it appears to be a utility file that provides common functionalities for plotting metrics. For our new calibration curve plotting function, it makes sense to create a new class or function in this directory or in a new file dedicated to calibration plots.\n\nHowever, since the calibration curve plotting function is quite specific, we might want to create a new file named `calibration_curve.py` under `sklearn/metrics/_plot/`. This file can import necessary components from `base.py` and other related modules.\n\nWe will now examine the other identified files to understand their structure and dependencies better.\n\n<function=explore_tree_structure>\n<parameter=start_entities>['sklearn/metrics/_plot/det_curve.py', 'sklearn/metrics/_plot/precision_recall_curve.py', 'sklearn/metrics/_plot/roc_curve.py', 'sklearn/metrics/_plot/confusion_matrix.py']</parameter>\n<parameter>direction>'upstream'</parameter>\n<parameter>traversal_depth>1</parameter>\n<parameter>entity_type_filter>['file', 'class', 'function']</parameter>\n<parameter>dependency_type_filter>['imports']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "explore_tree_structure", "content": "OBSERVATION:\nsklearn/metrics/_plot/det_curve.py\n\u251c\u2500\u2500 contains \u2500\u2500 sklearn/metrics/_plot/det_curve.py:DetCurveDisplay\n\u2502               \u251c\u2500\u2500 contains \u2500\u2500 sklearn/metr