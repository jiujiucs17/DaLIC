ic ties rather than get platform specific rank\n3757 |         # inversions in case of machine level differences.\n3758 |         a = estimator.predict_proba(X_test)[:, 1].round(decimals=10)\n3759 |         b = estimator.decision_function(X_test).round(decimals=10)\n3760 | \n3761 |         rank_proba, rank_score = rankdata(a), rankdata(b)\n3762 |         try:\n3763 |             assert_array_almost_equal(rank_proba, rank_score)\n3764 |         except AssertionError:\n3765 |             # Sometimes, the rounding applied on the probabilities will have\n3766 |             # ties that are not present in the scores because it is\n3767 |             # numerically more precise. In this case, we relax the test by\n3768 |             # grouping the decision function scores based on the probability\n3769 |             # rank and check that the score is monotonically increasing.\n3770 |             grouped_y_score = np.array(\n3771 |                 [b[rank_proba == group].mean() for group in np.unique(rank_proba)]\n3772 |             )\n3773 |             sorted_idx = np.argsort(grouped_y_score)\n3774 |             assert_array_equal(sorted_idx, np.arange(len(sorted_idx)))\n```\n\n\n\n##Searching for term \"docstring consistency\", \"assert_consistent_docs docstring consistency check_docstring_consistency\"...\n### Search Result:\nFound function `doc/api_reference.py:_get_submodule`.\nSource: Retrieved code content using keyword search (bm25).\n```\n21 | def _get_submodule(module_name, submodule_name):\n22 |     \"\"\"Get the submodule docstring and automatically add the hook.\n23 | \n24 |     `module_name` is e.g. `sklearn.feature_extraction`, and `submodule_name` is e.g.\n25 |     `image`, so we get the docstring and hook for `sklearn.feature_extraction.image`\n26 |     submodule. `module_name` is used to reset the current module because autosummary\n27 |     automatically changes the current module.\n28 |     \"\"\"\n29 |     lines = [\n30 |         f\".. automodule:: {module_name}.{submodule_name}\",\n31 |         f\".. currentmodule:: {module_name}\",\n32 |     ]\n33 |     return \"\\n\\n\".join(lines)\n```\n\nFound function `sklearn/feature_extraction/_hash.py:FeatureHasher.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n128 | def fit(self, X=None, y=None):\n129 |         \"\"\"Only validates estimator's parameters.\n130 | \n131 |         This method allows to: (i) validate the estimator's parameters and\n132 |         (ii) be consistent with the scikit-learn transformer API.\n133 | \n134 |         Parameters\n135 |         ----------\n136 |         X : Ignored\n137 |             Not used, present here for API consistency by convention.\n138 | \n139 |         y : Ignored\n140 |             Not used, present here for API consistency by convention.\n141 | \n142 |         Returns\n143 |         -------\n144 |         self : object\n145 |             FeatureHasher class instance.\n146 |         \"\"\"\n147 |         return self\n```\n\n\n\n##Searching for term \"check_docstring_consistency\"...\n### Search Result:\nFound code snippet in file `sklearn/cross_decomposition/_pls.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n   1 | \"\"\"\n   2 | The :mod:`sklearn.pls` module implements Partial Least Squares (PLS).\n   3 | \"\"\"\n   4 | \n   5 | # Authors: The scikit-learn developers\n   6 | # SPDX-License-Identifier: BSD-3-Clause\n   7 | \n   8 | import warnings\n   9 | from abc import ABCMeta, abstractmethod\n  10 | from numbers import Integral, Real\n  11 | \n  12 | import numpy as np\n  13 | from scipy.linalg import svd\n  14 | \n  15 | from ..base import (\n  16 |     BaseEstimator,\n  17 |     ClassNamePrefixFeaturesOutMixin,\n  18 |     MultiOutputMixin,\n  19 |     RegressorMixin,\n  20 |     TransformerMixin,\n  21 |     _fit_context,\n  22 | )\n  23 | from ..exceptions import ConvergenceWarning\n  24 | from ..utils import check_array, check_consistent_length\n  25 | from ..utils