     kind = order\n599 |         else:\n600 |             kind = method\n601 |         terp = interpolate.interp1d(\n602 |             x, y, kind=kind, fill_value=fill_value, bounds_error=bounds_error\n603 |         )\n604 |         new_y = terp(new_x)\n605 |     elif method == \"spline\":\n606 |         # GH #10633, #24014\n607 |         if isna(order) or (order <= 0):\n608 |             raise ValueError(\n609 |                 f\"order needs to be specified and greater than 0; got order: {order}\"\n610 |             )\n611 |         terp = interpolate.UnivariateSpline(x, y, k=order, **kwargs)\n612 |         new_y = terp(new_x)\n613 |     else:\n614 |         # GH 7295: need to be able to write for some reason\n615 |         # in some circumstances: check all three\n616 |         if not x.flags.writeable:\n617 |             x = x.copy()\n618 |         if not y.flags.writeable:\n619 |             y = y.copy()\n620 |         if not new_x.flags.writeable:\n621 |             new_x = new_x.copy()\n622 |         terp = alt_methods.get(method, None)\n623 |         if terp is None:\n624 |             raise ValueError(f\"Can not interpolate with method={method}.\")\n625 | \n626 |         # Make sure downcast is not in kwargs for alt methods\n627 |         kwargs.pop(\"downcast\", None)\n628 |         new_y = terp(x, y, new_x, **kwargs)\n629 |     return new_y\n```\n\nFound function `pandas/core/internals/managers.py:BaseBlockManager.interpolate`.\nFound function `pandas/core/arrays/numpy_.py:NumpyExtensionArray.interpolate`.\nFound function `pandas/core/arrays/masked.py:BaseMaskedArray.interpolate`.\nFound function `pandas/core/arrays/datetimelike.py:TimelikeOps.interpolate`.\nFound function `pandas/core/arrays/arrow/array.py:ArrowExtensionArray.interpolate`.\nSource: Match found for entity name `interpolate`.\nHint: Use more detailed query to get the full content of some if needed.\n"}, {"content": "```\npandas/core/frame.py\nfunction: DataFrame.interpolate\n\npandas/core/