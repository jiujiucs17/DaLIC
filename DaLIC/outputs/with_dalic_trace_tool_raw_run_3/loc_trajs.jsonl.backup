et_subplots\npandas/plotting/_matplotlib/core.py:MPLPlot._get_axes_layout\npandas/plotting/_matplotlib/core.py:MPLPlot._make_legend\npandas/plotting/_matplotlib/core.py:MPLPlot:3\npandas/plotting/_matplotlib/core.py:MPLPlot._kind\npandas/plotting/_matplotlib/core.py:MPLPlot.__init__\npandas/plotting/_matplotlib/core.py:MPLPlot\npandas/plotting/_matplotlib/core.py:MPLPlot._iter_data\npandas/plotting/_matplotlib/core.py:MPLPlot.nseries\n##Searching for term \"plot\"...\n### Search Result:\nFound function `pandas/util/_doctools.py:TablePlotter.plot`.\nSource: Match found for entity name `plot`.\n```\n 44 | def plot(self, left, right, labels=None, vertical: bool = True):\n 45 |         \"\"\"\n 46 |         Plot left / right DataFrames in specified layout.\n 47 | \n 48 |         Parameters\n 49 |         ----------\n 50 |         left : list of DataFrames before operation is applied\n 51 |         right : DataFrame of operation result\n 52 |         labels : list of str to be drawn as titles of left DataFrames\n 53 |         vertical : bool, default True\n 54 |             If True, use vertical layout. If False, use horizontal layout.\n 55 |         \"\"\"\n 56 |         import matplotlib.gridspec as gridspec\n 57 |         import matplotlib.pyplot as plt\n 58 | \n 59 |         if not isinstance(left, list):\n 60 |             left = [left]\n 61 |         left = [self._conv(df) for df in left]\n 62 |         right = self._conv(right)\n 63 | \n 64 |         hcells, vcells = self._get_cells(left, right, vertical)\n 65 | \n 66 |         if vertical:\n 67 |             figsize = self.cell_width * hcells, self.cell_height * vcells\n 68 |         else:\n 69 |             # include margin for titles\n 70 |             figsize = self.cell_width * hcells, self.cell_height * vcells\n 71 |         fig = plt.figure(figsize=figsize)\n 72 | \n 73 |         if vertical:\n 74 |             gs = gridspec.GridSpec(len(left), hcells)\n 75 |             # left\n 76 |             max_left_cols = max(self._shape(df)[1] for df in left)\n 77 |             max_left_rows = max(self._shape(df)[0] for df in left)\n 78 |             for i, (l, label) in enumerate(zip(left, labels)):\n 79 |                 ax = fig.add_subplot(gs[i, 0:max_left_cols])\n 80 |                 self._make_table(ax, l, title=label, height=1.0 / max_left_rows)\n 81 |             # right\n 82 |             ax = plt.subplot(gs[:, max_left_cols:])\n 83 |             self._make_table(ax, right, title=\"Result\", height=1.05 / vcells)\n 84 |             fig.subplots_adjust(top=0.9, bottom=0.05, left=0.05, right=0.95)\n 85 |         else:\n 86 |             max_rows = max(self._shape(df)[0] for df in left + [right])\n 87 |             height = 1.0 / np.max(max_rows)\n 88 |             gs = gridspec.GridSpec(1, hcells)\n 89 |             # left\n 90 |             i = 0\n 91 |             for df, label in zip(left, labels):\n 92 |                 sp = self._shape(df)\n 93 |                 ax = fig.add_subplot(gs[0, i : i + sp[1]])\n 94 |                 self._make_table(ax, df, title=label, height=height)\n 95 |                 i += sp[1]\n 96 |             # right\n 97 |             ax = plt.subplot(gs[0, i:])\n 98 |             self._make_table(ax, right, title=\"Result\", height=height)\n 99 |             fig.subplots_adjust(top=0.85, bottom=0.05, left=0.05, right=0.95)\n100 | \n101 |         return fig\n```\n\nFound function `pandas/plotting/_matplotlib/__init__.py:plot`.\nSource: Match found for entity name `plot`.\n```\n58 | def plot(data, kind, **kwargs):\n59 |     # Importing pyplot at the top of the file (before the converters are\n60 |     # registered) causes problems in matplotlib 2 (converters seem to not\n61 |     # work)\n62 |     import matplotlib.pyplot as plt\n63 | \n64 |     if kwargs.pop(\"reuse_plot\", False):\n65 |         ax = kwargs.get(\"ax\")\n66 |         if ax is None and len(plt.get_fignums()) > 0:\n67 |             with plt.rc_context():\n68 |                 ax = plt.gca()\n69 |             kwargs[\"ax\"] = getattr(ax, \"left_ax\", ax)\n70 |     plot_obj = PLOT_CLASSES[kind](data, **kwargs)\n71 |     plot_obj.generate()\n72 |     plot_obj.draw()\n73 |     return plot_obj.result\n```\n\n\n\n##Searching for term \"subplots\"...\n### Search Result:\nFound function `pandas/plotting/_matplotlib/tools.py:create_subplots`.\nSource: Retrieved entity using keyword search (bm25).\n```\n132 | def create_subplots(\n133 |     naxes: int,\n134 |     sharex: bool = False,\n135 |     sharey: bool = False,\n136 |     squeeze: bool = True,\n137 |     subplot_kw=None,\n138 |     ax=None,\n139 |     layout=None,\n140 |     layout_type: str = \"box\",\n141 |     **fig_kw,\n142 | ):\n143 |     \"\"\"\n144 |     Create a figure with a set of subplots already made.\n145 | \n146 |     This utility wrapper makes it convenient to create common layouts of\n147 |     subplots, including the enclosing figure object, in a single call.\n148 | \n149 |     Parameters\n150 |     ----------\n151 |     naxes : int\n152 |       Number of required axes. Exceeded axes are set invisible. Default is\n153 |       nrows * ncols.\n154 | \n155 |     sharex : bool\n156 |       If True, the X axis will be shared amongst all subplots.\n157 | \n158 |     sharey : bool\n159 |       If True, the Y axis will be shared amongst all subplots.\n160 | \n161 |     squeeze : bool\n162 | \n163 |       If True, extra dimensions are squeezed out from the returned axis object:\n164 |         - if only one subplot is constructed (nrows=ncols=1), the resulting\n165 |         single Axis object is returned as a scalar.\n166 |         - for Nx1 or 1xN subplots, the returned object is a 1-d numpy object\n167 |         array of Axis objects are returned as numpy 1-d arrays.\n168 |         - for NxM subplots with N>1 and M>1 are returned as a 2d array.\n169 | \n170 |       If False, no squeezing is done: the returned axis object is always\n171 |       a 2-d array containing Axis instances, even if it ends up being 1x1.\n172 | \n173 |     subplot_kw : dict\n174 |       Dict with keywords passed to the add_subplot() call used to create each\n175 |       subplots.\n176 | \n177 |     ax : Matplotlib axis object, optional\n178 | \n179 |     layout : tuple\n180 |       Number of rows and columns of the subplot grid.\n181 |       If not specified, calculated from naxes and layout_type\n182 | \n183 |     layout_type : {'box', 'horizontal', 'vertical'}, default 'box'\n184 |       Specify how to layout the subplot grid.\n185 | \n186 |     fig_kw : Other keyword arguments to be passed to the figure() call.\n187 |         Note that all keywords not recognized above will be\n188 |         automatically included here.\n189 | \n190 |     Returns\n191 |     -------\n192 |     fig, ax : tuple\n193 |       - fig is the Matplotlib Figure object\n194 |       - ax can be either a single axis object or an array of axis objects if\n195 |       more than one subplot was created.  The dimensions of the resulting array\n196 |       can be controlled with the squeeze keyword, see above.\n197 | \n198 |     Examples\n199 |     --------\n200 |     x = np.linspace(0, 2*np.pi, 400)\n201 |     y = np.sin(x**2)\n202 | \n203 |     # Just a figure and one subplot\n204 |     f, ax = plt.subplots()\n205 |     ax.plot(x, y)\n206 |     ax.set_title('Simple plot')\n207 | \n208 |     # Two subplots, unpack the output array immediately\n209 |     f, (ax1, ax2) = plt.subplots(1, 2, sharey=True)\n210 |     ax1.plot(x, y)\n211 |     ax1.set_title('Sharing Y axis')\n212 |     ax2.scatter(x, y)\n213 | \n214 |     # Four polar axes\n215 |     plt.subplots(2, 2, subplot_kw=dict(polar=True))\n216 |     \"\"\"\n217 |     import matplotlib.pyplot as plt\n218 | \n219 |     if subplot_kw is None:\n220 |         subplot_kw = {}\n221 | \n222 |     if ax is None:\n223 |         fig = plt.figure(**fig_kw)\n224 |     else:\n225 |         if is_list_like(ax):\n226 |             if squeeze:\n227 |                 ax = flatten_axes(ax)\n228 |             if layout is not None:\n229 |                 warnings.warn(\n230 |                     \"When passing multiple axes, layout keyword is ignored.\",\n231 |                     UserWarning,\n232 |                 )\n233 |             if sharex or sharey:\n234 |                 warnings.warn(\n235 |                     \"When passing multiple axes, sharex and sharey \"\n236 |                     \"are ignored. These settings must be specified when creating axes.\",\n237 |                     UserWarning,\n238 |                     stacklevel=find_stack_level(),\n239 |                 )\n240 |             if ax.size == naxes:\n241 |                 fig = ax.flat[0].get_figure()\n242 |                 return fig, ax\n243 |             else:\n244 |                 raise ValueError(\n245 |                     f\"The number of passed axes must be {naxes}, the \"\n246 |                     \"same as the output plot\"\n247 |                 )\n248 | \n249 |         fig = ax.get_figure()\n250 |         # if ax is passed and a number of subplots is 1, return ax as it is\n251 |         if naxes == 1:\n252 |             if squeeze:\n253 |                 return fig, ax\n254 |             else:\n255 |                 return fig, flatten_axes(ax)\n256 |         else:\n257 |             warnings.warn(\n258 |                 \"To output multiple subplots, the figure containing \"\n259 |                 \"the passed axes is being cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sharex:\n276 |         subplot_kw[\"sharex\"] = ax0\n277 |     if sharey:\n278 |         subplot_kw[\"sharey\"] = ax0\n279 |     axarr[0] = ax0\n280 | \n281 |     # Note off-by-one counting because add_subplot uses the MATLAB 1-based\n282 |     # convention.\n283 |     for i in range(1, nplots):\n284 |         kwds = subplot_kw.copy()\n285 |         # Set sharex and sharey to None for blank/dummy axes, these can\n286 |         # interfere with proper axis limits on the visible axes if\n287 |         # they share axes e.g. issue #7528\n288 |         if i >= naxes:\n289 |             kwds[\"sharex\"] = None\n290 |             kwds[\"sharey\"] = None\n291 |         ax = fig.add_subplot(nrows, ncols, i + 1, **kwds)\n292 |         axarr[i] = ax\n293 | \n294 |     if naxes != nplots:\n295 |         for ax in axarr[naxes:]:\n296 |             ax.set_visible(False)\n297 | \n298 |     handle_shared_axes(axarr, nplots, naxes, nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 |             axes = axarr.reshape(nrows, ncols).squeeze()\n308 |     else:\n309 |         # returned axis array will be always 2-d, even if nrows=ncols=1\n310 |         axes = axarr.reshape(nrows, ncols)\n311 | \n312 |     return fig, axes\n```\n\nFound function `pandas/plotting/_matplotlib/core.py:MPLPlot._setup_subplots`.\nSource: Retrieved entity using keyword search (bm25).\n```\n372 | def _setup_subplots(self):\n373 |         if self.subplots:\n374 |             fig, axes = create_subplots(\n375 |                 naxe