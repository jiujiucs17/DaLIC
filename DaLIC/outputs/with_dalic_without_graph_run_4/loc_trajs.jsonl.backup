 code content using keyword search (bm25).\n```\n650 | def _make_legend(self) -> None:\n651 |         ax, leg = self._get_ax_legend(self.axes[0])\n652 | \n653 |         handles = []\n654 |         labels = []\n655 |         title = \"\"\n656 | \n657 |         if not self.subplots:\n658 |             if leg is not None:\n659 |                 title = leg.get_title().get_text()\n660 |                 # Replace leg.LegendHandles because it misses marker info\n661 |                 handles = leg.legendHandles\n662 |                 labels = [x.get_text() for x in leg.get_texts()]\n663 | \n664 |             if self.legend:\n665 |                 if self.legend == \"reverse\":\n666 |                     handles += reversed(self.legend_handles)\n667 |                     labels += reversed(self.legend_labels)\n668 |                 else:\n669 |                     handles += self.legend_handles\n670 |                     labels += self.legend_labels\n671 | \n672 |                 if self.legend_title is not None:\n673 |                     title = self.legend_title\n674 | \n675 |             if len(handles) > 0:\n676 |                 ax.legend(handles, labels, loc=\"best\", title=title)\n677 | \n678 |         elif self.subplots and self.legend:\n679 |             for ax in self.axes:\n680 |                 if ax.get_visible():\n681 |                     ax.legend(loc=\"best\")\n```\n\nFound function `pandas/plotting/_matplotlib/core.py:MPLPlot._get_subplots`.\nSource: Retrieved code content using keyword search (bm25).\n```\n961 | def _get_subplots(self):\n962 |         from matplotlib.axes import Subplot\n963 | \n964 |         return [\n965 |             ax for ax in self.axes[0].get_figure().get_axes() if isinstance(ax, Subplot)\n966 |         ]\n```\n\nFound function `pandas/plotting/_matplotlib/core.py:MPLPlot._get_axes_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n968 | def _get_axes_layout(self) -> tuple[int, int]:\n969 |         axes =