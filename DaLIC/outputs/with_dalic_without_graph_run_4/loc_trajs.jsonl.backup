ndow_shape` is an integer then the shape will be (window_shape,)\n141 |         If `window_shape` is a tuple, its length must be equal to the number\n142 |         of input array dimensions. Each entry represents the size of the\n143 |         window along that dimension.\n144 |     axis : int or tuple of int, optional\n145 |         Axis or axes along which the sliding window is applied.\n146 |         Default is None which applies a sliding window along all axes.\n147 |     subok : bool, optional\n148 |         If True, then the newly created view will allow a subclass of the\n149 |         original array to pass through. Defaults to False.\n150 |     writeable : bool, optional\n151 |         Set the `writeable` flag of the returned array to `True` or `False`.\n152 |         If `subok` is True, then the `writeable` flag will be inherited\n153 |         from the original array. Defaults to `False`.\n154 | \n155 |     Returns\n156 |     -------\n157 |     view : ndarray\n158 |         Sliding window view of the array.\n159 | \n160 |     Examples\n161 |     --------\n162 |     >>> a = np.arange(9).reshape(3, 3)\n163 |     >>> np.lib.stride_tricks.sliding_window_view(a, (2, 2))\n164 |     array([[[[0, 1],\n165 |              [3, 4]],\n166 | \n167 |             [[1, 2],\n168 |              [4, 5]]],\n169 | \n170 | \n171 |            [[[3, 4],\n172 |              [6, 7]],\n173 | \n174 |             [[4, 5],\n175 |              [7, 8]]]])\n176 | \n177 |     >>> a = np.arange(4).reshape(2, 2)\n178 |     >>> np.lib.stride_tricks.sliding_window_view(a, 2)\n179 |     array([[[[0, 1],\n180 |              [2, 3]]]])\n181 | \n182 |     >>> a = np.arange(4).reshape(2, 2)\n183 |     >>> np.lib.stride_tricks.sliding_window_view(a, 2, axis=0)\n184 |     array([[[[0, 1],\n185 |              [2, 3]]]])\n186 | \n187 |     >>> a = np.arange(4).reshape(2, 2)\n188 |     >>> np.lib.stride_tricks.sliding_window_view(a, 2, axis=1)\n189 |     array([[[[0, 1]],\n190 | \n191 |             [[2, 3]]]])\n192 |     \"\"\"\n193 |     x = np.array(x, copy=False, subok=subok)\n194 | \n195 |     if axis is None:\n196 |         axis = tuple(range(x.ndim))\n197 |     else:\n198 |         if isinstance(axis, int):\n199 |             axis = (axis,)\n200 | \n201 |     if isinstance(window_shape, int):\n202 |         window_shape = (window_shape,)\n203 | \n204 |     if len(axis) != len(window_shape):\n205 |         raise ValueError(\"`axis` and `window_shape` must have the same number \"\n206 |                          \"of dimensions\")\n207 | \n208 |     if any(w <= 0 for w in window_shape):\n209 |         raise ValueError(\"`window_shape` must be strictly positive\")\n210 | \n211 |     if any(w > s for w, s in zip(window_shape, x.shape)):\n212 |         raise ValueError(\"`window_shape` is larger than input array along \"\n213 |                          \"dimension %d\" % (axis[window_shape.index(max(window_shape))],))\n214 | \n215 |     out_shape = tuple(s - w + 1 for s, w in zip(x.shape, window_shape))\n216 |     if any(o <= 0 for o in out_shape):\n217 |         raise ValueError(\"window shape is larger than input shape along axis %d\"\n218 |                          % (axis[out_shape.index(min(out_shape))],))\n219 | \n220 |     out_shape += tuple(window_shape)\n221 |     out_strides = x.strides + tuple(x.strides[ax] for ax in axis)\n222 | \n223 |     ret = as_strided(x, shape=out_shape, strides=out_strides, subok=subok)\n224 |     if not writeable:\n225 |         ret.flags.writeable = False\n226 |     return ret\n```\n\n\n\nAssistant```\nnumpy/lib/stride_tricks.py\nline: 123\nfunction: sliding_window_view\n\nnumpy/lib/stride_tricks.py\nline: 124\nfunction: sliding_window_view\n\nnumpy/lib/stride_tricks.py\nline: 131\nfunction: sliding_window_view\n\nnumpy/lib/stride_tricks.py\nline: 211\nfunction: sliding_window_view\n\nnumpy/lib/stride_tricks.py\nline: 220\nfunction: sliding_window_view\n\nnumpy/lib/stride_tricks.py\nline: 221\nfunction: sliding_window_view\n\n