bool, default: False\n3402 |             Whether to hide voxels with points outside the axes view limits.\n3403 | \n3404 |             .. versionadded:: 3.10\n3405 | \n3406 |         **kwargs\n3407 |             Additional keyword arguments to pass onto\n3408 |             `~mpl_toolkits.mplot3d.art3d.Poly3DCollection`.\n3409 | \n3410 |         Returns\n3411 |         -------\n3412 |         faces : dict\n3413 |             A dictionary indexed by coordinate, where ``faces[i, j, k]`` is a\n3414 |             `.Poly3DCollection` of the faces drawn for the voxel\n3415 |             ``filled[i, j, k]``. If no faces were drawn for a given voxel,\n3416 |             either because it was not asked to be drawn, or it is fully\n3417 |             occluded, then ``(i, j, k) not in faces``.\n3418 | \n3419 |         Examples\n3420 |         --------\n3421 |         .. plot:: gallery/mplot3d/voxels.py\n3422 |         .. plot:: gallery/mplot3d/voxels_rgb.py\n3423 |         .. plot:: gallery/mplot3d/voxels_torus.py\n3424 |         .. plot:: gallery/mplot3d/voxels_numpy_logo.py\n3425 |         \"\"\"\n3426 | \n3427 |         # work out which signature we should be using, and use it to parse\n3428 |         # the arguments. Name must be voxels for the correct error message\n3429 |         if len(args) >= 3:\n3430 |             # underscores indicate position only\n3431 |             def voxels(__x, __y, __z, filled, **kwargs):\n3432 |                 return (__x, __y, __z), filled, kwargs\n3433 |         else:\n3434 |             def voxels(filled, **kwargs):\n3435 |                 return None, filled, kwargs\n3436 | \n3437 |         xyz, filled, kwargs = voxels(*args, **kwargs)\n3438 | \n3439 |         # check dimensions\n3440 |         if filled.ndim != 3:\n3441 |             raise ValueError(\"Argument filled must be 3-dimensional\")\n3442 |         size = np.array(filled.shape, dtype=np.intp)\n3443 | \n3444 |         # check xyz coordinates, which are one larger than the filled shape\n3445 |         coord_shape = tuple(size + 1)\n3446 |         if xyz is None:\n3447 |             x, y, z = np.indices(coord_shape)\n3448 |         else:\n3449 |             x, y, z = (np.broadcast_to(c, coord_shape) for c in xyz)\n3450 | \n3451 |         def _broadcast_color_arg(color, name):\n3452 |             if np.ndim(color) in (0, 1):\n3453 |                 # single color, like \"red\" or [1, 0, 0]\n3454 |                 return np.broadcast_to(color, filled.shape + np.shape(color))\n3455 |             elif np.ndim(color) in (3, 4):\n3456 |                 # 3D array of strings, or 4D array with last axis rgb\n3457 |                 if np.shape(color)[:3] != filled.shape:\n3458 |                     raise ValueError(\n3459 |                         f\"When multidimensional, {name} must match the shape \"\n3460 |                         \"of filled\")\n3461 |                 return color\n3462 |             else:\n3463 |                 raise ValueError(f\"Invalid {name} argument\")\n3464 | \n3465 |         # broadcast and default on facecolors\n3466 |         if facecolors is None:\n3467 |             facecolors = self._get_patches_for_fill.get_next_color()\n3468 |         facecolors = _broadcast_color_arg(facecolors, 'facecolors')\n3469 | \n3470 |         # broadcast but no default on edgecolors\n3471 |         edgecolors = _broadcast_color_arg(edgecolors, 'edgecolors')\n3472 | \n3473 |         # scale to the full array, even if the data is only in the center\n3474 |         self.auto_scale_xyz(x, y, z)\n3475 | \n3476 |         # points lying on corners of a square\n3477 |         square = np.array([\n3478 |             [0, 0, 0],\n3479 |             [1, 0, 0],\n3480 |             [1, 1, 0],\n3481 |             [0, 1, 0],\n3482 |         ], dtype=np.intp)\n3483 | \n3484 |         voxel_faces = defaultdict(list)\n3485 | \n3486 |         def permutation_matrices(n):\n3487 |             \"\"\"Generate cyclic permutation matrices.\"\"\"\n3488 |        