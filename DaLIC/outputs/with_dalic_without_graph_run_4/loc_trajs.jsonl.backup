matplotlib/patches.py:ConnectionStyle.Bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3083 | class Bar(_Base):\n3084 |         \"\"\"\n3085 |         A line with *angle* between A and B with *armA* and *armB*. One of the\n3086 |         arms is extended so that they are connected in a right angle. The\n3087 |         length of *armA* is determined by (*armA* + *fraction* x AB distance).\n3088 |         Same for *armB*.\n3089 |         \"\"\"\n3090 | \n3091 |         def __init__(self, armA=0., armB=0., fraction=0.3, angle=None):\n3092 |             \"\"\"\n3093 |             Parameters\n3094 |             ----------\n3095 |             armA : float\n3096 |                 Minimum length of armA.\n3097 | \n3098 |             armB : float\n3099 |                 Minimum length of armB.\n3100 | \n3101 |             fraction : float\n3102 |                 A fraction of the distance between two points that will be\n3103 |                 added to armA and armB.\n3104 | \n3105 |             angle : float or None\n3106 |                 Angle of the connecting line (if None, parallel to A and B).\n3107 |             \"\"\"\n3108 |             self.armA = armA\n3109 |             self.armB = armB\n3110 |             self.fraction = fraction\n3111 |             self.angle = angle\n3112 | \n3113 |         def connect(self, posA, posB):\n3114 |             x1, y1 = posA\n3115 |             x20, y20 = x2, y2 = posB\n3116 | \n3117 |             theta1 = math.atan2(y2 - y1, x2 - x1)\n3118 |             dx, dy = x2 - x1, y2 - y1\n3119 |             dd = (dx * dx + dy * dy) ** .5\n3120 |             ddx, ddy = dx / dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\nFound file `galleries/plot_types/basic/bar.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/plot_types/basic/bar.py` for the full content if needed.\n\n\n\n##Searching for term \"bar()\"...\n### Search Result:\nFound function `lib/matplotlib/axes/_axes.py:Axes.bar`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2326 | def bar(self, x, height, width=0.8, bottom=None, *, align=\"center\",\n2327 |             **kwargs):\n2328 |         r\"\"\"\n2329 |         Make a bar plot.\n2330 | \n2331 |         The bars are positioned at *x* with the given *align*\\ment. Their\n2332 |         dimensions are given by *height* and *width*. The vertical baseline\n2333 |         is *bottom* (default 0).\n2334 | \n2335 |         Many parameters can take either a single value applying to all bars\n2336 |         or a sequence of values, one for each bar.\n2337 | \n2338 |         Parameters\n2339 |         ----------\n2340 |         x : float or array-like\n2341 |             The x coordinates of the bars. See also *align* for the\n2342 |             alignment of the bars to the coordinates.\n2343 | \n2344 |         height : float or array-like\n2345 |             The height(s) of the bars.\n2346 | \n2347 |             Note that if *bottom* has units (e.g. datetime), *height* should be in\n2348 |             units that are a difference from the value of *bottom* (e.g. timedelta).\n2349 | \n2350 |         width : float or array-like, default: 0.8\n2351 |             The width(s) of the bars.\n2352 | \n2353 |             Note that if *x* has units (e.g. datetime), then *width* should be in\n2354 |             units that are a difference (e.g. timedelta) around the *x* values.\n2355 | \n2356 |         bottom : float or array-like, default: 0\n2357 |             The y coordinate(s) of the bottom side(s) of the bars.\n2358 | \n2359 |             Note that if *bottom* has units, then the y-axis will get a Locator and\n2360 |             Formatter appropriate for the units (e.g. dates, or categorical).\n2361 | \n2362 |         align : {'center', 'edge'}, default: 'center'\n2363 |             Alignment of the bars to the *x* coordinates:\n2364 | \n2365 |             - 'center': Center the base on the *x* positions.\n2366 |             - 'edge': Align the left edges of the bars with the *x* positions.\n2367 | \n2368 |             To align the bars on the right edge pass a negative *width* and\n2369 |             ``align='edge'``.\n2370 | \n2371 |         Returns\n2372 |         -------\n2373 |         `.BarContainer`\n2374 |             Container with all the bars and optionally errorbars.\n2375 | \n2376 |         Other Parameters\n2377 |         ----------------\n2378 |         color : :mpltype:`color` or list of :mpltype:`color`, optional\n2379 |             The colors of the bar faces.\n2380 | \n2381 |         edgecolor : :mpltype:`color` or list of :mpltype:`color`, optional\n2382 |             The colors of the bar edges.\n2383 | \n2384 |         linewidth : float or array-like, optional\n2385 |             Width of the bar edge(s). If 0, don't draw edges.\n2386 | \n2387 |         tick_label : str or list of str, optional\n2388 |             The tick labels of the bars.\n2389 |             Default: None (Use default numeric labels.)\n2390 | \n2391 |         label : str or list of str, optional\n2392 |             A single label is attached to the resulting `.BarContainer` as a\n2393 |             label for the whole dataset.\n2394 |             If a list is provided, it must be the same length as *x* and\n2395 |             labels the individual bars. Repeated labels are not de-duplicated\n2396 |             and will cause repeated label entries, so this is best used when\n2397 |             bars also differ in style (e.g., by passing a list to *color*.)\n2398 | \n2399 |         xerr, yerr : float or array-like of shape(N,) or shape(2, N), optional\n2400 |             If not *None*, add horizontal / vertical errorbars to the bar tips.\n2401 |             The values are +/- sizes relative to the data:\n2402 | \n2403 |             - scalar: symmetric +/- values for all bars\n2404 |             - shape(N,): symmetric +/- values for each bar\n2405 |             - shape(2, N): Separate - and + values for each bar. First row\n2406 |               contains the lower errors, the second row contains the upper\n2407 |               errors.\n2408 |             - *None*: No errorbar. (Default)\n2409 | \n2410 |             See :doc:`/gallery/statistics/errorbar_features` for an example on\n2411 |             the usage of *xerr* and *yerr*.\n2412 | \n2413 |         ecolor : :mpltype:`color` or list of :mpltype:`color`, default: 'black'\n2414 |             The line color of the errorbars.\n2415 | \n2416 |         capsize : float, default: :rc:`errorbar.capsize`\n2417 |            The length of the error bar caps in points.\n2418 | \n2419 |         error_kw : dict, optional\n2420 |             Dictionary of keyword arguments to be passed to the\n2421 |             `~.Axes.errorbar` method. Values of *ecolor* or *capsize* defined\n2422 |             here take precedence over the independent keyword arguments.\n2423 | \n2424 |         log : bool, default: False\n2425 |             If *True*, set the y-axis to be log scale.\n2426 | \n2427 |         data : indexable object, optional\n2428 |             DATA_PARAMETER_PLACEHOLDER\n2429 | \n2430 |         **kwargs : `.Rectangle` properties\n2431 | \n2432 |         %(Rectangle:kwdoc)s\n2433 | \n2434 |         See Also\n2435 |         --------\n2436 |         barh : Plot a horizontal bar plot.\n2437 | \n2438 |         Notes\n2439 |         -----\n2440 |         Stacked bars can be achieved by passing individual *bottom* values per\n2441 |         bar. See :doc:`/gallery/lines_bars_and_markers/bar_stacked`.\n2442 |         \"\"\"\n2443 |         kwargs = cbook.normalize_kwargs(kwargs, mpatches.Patch)\n2444 |         color = kwargs.pop('color', None)\n2445 |         if color is None:\n2446 |             color = self._get_patches_for_fill.get_next_color()\n2447 |         edgecolor = kwargs.pop('edgecolor', None)\n2448 |         linewidth = kwargs.pop('linewidth', None)\n2449 |         hatch = kwargs.pop('hatch', None)\n2450 | \n2451 |         # Because xerr and yerr will be passed to errorbar, most dimension\n2452 |         # checking and processing will be left to the errorbar method.\n2453 |         xerr = kwargs.pop('xerr', None)\n2454 |         yerr = kwargs.pop('yerr', None)\n2455 |         error_kw = kwargs.pop('error_kw', None)\n2456 |         error_kw = {} if error_kw is None else error_kw.copy()\n2457 |         ezorder = error_kw.pop('zorder', None)\n2458 |         if ezorder is None:\n2459 |             ezorder = kwargs.get('zorder', None)\n2460 |             if ezorder is not None:\n2461 |                 # If using the bar zorder, increment slightly to make sure\n2462 |                 # errorbars are drawn on top of bars\n2463 |                 ezorder += 0.01\n2464 |         error_kw.setdefault('zorder', ezorder)\n2465 |         ecolor = kwargs.pop('ecolor', 'k')\n2466 |         capsize = kwargs.pop('capsize', mpl.rcParams[\"errorbar.capsize\"])\n2467 |         error_kw.setdefault('ecolor', ecolor)\n2468 |         error_kw.setdefault('capsize', capsize)\n2469 | \n2470 |         # The keyword argument *orientation* is used by barh() to defer all\n2471 |         # logic and drawing to bar(). It is considered internal and is\n2472 |         # intentionally not mentioned in the docstring.\n2473 |         orientation = kwargs.pop('orientation', 'vertical')\n2474 |         _api.check_in_list(['vertical', 'horizontal'], orientation=orientation)\n2475 |         log = kwargs.pop('log', False)\n2476 |         label = kwargs.pop('label', '')\n2477 |         tick_labels = kwargs.pop('tick_label', None)\n2478 | \n2479 |         y = bottom  # Matches barh call signature.\n2480 |         if orientation == 'vertical':\n2481 |             if y is None:\n2482 |                 y = 0\n2483 |         else:  # horizontal\n2484 |             if x is None:\n2485 |                 x = 0\n2486 | \n2487 |         if orientation == 'vertical':\n2488 |             # It is possible for y (bottom) to contain unit information.\n2489 |             # However, it is also possible for y=0 for the default and height\n2490 |             # to contain unit information.  This will prioritize the units of y.\n2491 |             self._process_unit_info(\n2492 |                 [(\"x\", x), (\"y\", y), (\"y\", height)], kwargs, convert=False)\n2493 |             if log:\n2494 |                 self.set_yscale('log', nonpositive='clip')\n2495 |         else:  # horizontal\n2496 |             # It is possible for x (left) to contain unit information.\n2497 |             # However, it is also possible for x=0 for the default and width\n2498 |             # to contain unit information.  This will prioritize the units of x.\n2499 |             self