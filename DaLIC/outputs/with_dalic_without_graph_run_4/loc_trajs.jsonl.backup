d into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n##Searching for entity `sklearn/metrics/_plot/base.py:_get_response`...\n### Search Result:\nFound function `sklearn/metrics/_plot/base.py:_get_response`.\nSource: Exact match found for entity name `sklearn/metrics/_plot/base.py:_get_response`.\n```\n 52 | def _get_response(X, estimator, response_method, pos_label=None):\n 53 |     \"\"\"Return response and positive label.\n 54 | \n 55 |     Parameters\n 56 |     ----------\n 57 |     X : {array-like, sparse matrix} of shape (n_samples, n_features)\n 58 |         Input values.\n 59 | \n 60 |     estimator : estimator instance\n 61 |         Fitted classifier or a fitted :class:`~sklearn.pipeline.Pipeline`\n 62 |         in which the last estimator is a classifier.\n 63 | \n 64 |     response_method: {'auto', 'predict_proba', 'decision_function'}\n 65 |         Specifies whether to use :term:`predict_proba` or\n 66 |         :term:`decision_function` as the target response. If set to 'auto',\n 67 |         :term:`predict_proba` is tried first and if it does not exist\n 68 |         :term:`decision_function` is tried next.\n 69 | \n 70 |     pos_label : str or int, default=None\n 71 |         The class considered as the positive class when computing\n 72 |         the metrics. By default, `estimators.classes_[1]` is\n 73 |         considered as the positive class.\n 74 | \n 75 |     Returns\n 76 |     -------\n 77 |     y_pred: ndarray of shape (n_samples,)\n 78 |         Target scores calculated from the provided response_method\n 79 |         and pos_label.\n 80 | \n 81 |     pos_label: str or int\n 82 |         The class considered as the positive class when computing\n 83 |         the metrics.\n 84 |     \"\"\"\n 85 |     classification_error = (\n 86 |         \"Expected 'estimator' to be a binary classifier, but got\"\n 87 |         f\" {estimator.__class__.__name__}\"\n 88 |     )\n 89 | \n 90 |     if not is_classifier(estimator):\n 91 |         raise ValueError(classification_error)\n 92 | \n 93 |     prediction_method = _check_classifier_response_method(estimator, response_method)\n 94 | \n 95 |     y_pred = prediction_method(X)\n 96 | \n 97 |     if pos_label is not None and pos_label not in estimator.classes_:\n 98 |         raise ValueError(\n 99 |             \"The class provided by 'pos_label' is unknown. Got \"\n100 |             f\"{pos_label} instead of one of {estimator.classes_}\"\n101 |         )\n102 | \n103 |     if y_pred.ndim != 1:  # `predict_proba`\n104 |         if y_pred.shape[1] != 2:\n105 |             raise ValueError(classification_error)\n106 |         if pos_label is None:\n107 |             pos_label = estimator.classes_[1]\n108 |             y_pred = y_pred[:, 1]\n109 |         else:\n110 |             class_idx = np.flatnonzero(estimator.classes_ == pos_label)\n111 |             y_pred = y_pred[:, class_idx]\n112 |     else:\n113 |         if pos_label is None:\n114 |             pos_label = estimator.classes_[1]\n115 |         elif pos_label == estimator.classes_[0]:\n116 |             y_pred *= -1\n117 | \n118 |     return y_pred, pos_label\n```\n"}, {"content": "<function=search_code_snippets>\n<parameter=search_terms>\n['plot_calibration_curve', 'CalibrationDisplay', 'calibration_curve', 'matplotlib']\n</parameter>\n<parameter=file_path_or_pattern>\nsklearn/calibration.py\n</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"plot_calibration_curve\"...\n### Search Result:\nFound file `examples/calibration/plot_calibration_curve.py`.\nSource: Match found for entity name `plot_calibration_curve`.\nJust show the structure of this file due to response length limitations:\n```\n\n\n# Create dataset of classification task with many redundant and few\n# informative features\nX, y = datasets.make_classification(n_samples=100000, n_features=20,\n                                    n_informative=2, n_redundant=10,\n                                    random_state=42)\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.99,\n                                                    random_state=42)\n\n\ndef plot_calibration_curve(est, name, fig_index):\n...\n\n```\nHint: Search `examples/calibration/plot_calibration_curve.py` to get the full content if needed.\n\nFound function `examples/calibration/plot_calibration_curve.py:plot_calibration_curve`.\nSource: Match found for entity name `plot_calibration_curve`.\n```\n 72 | def plot_calibration_curve(est, name, fig_index):\n 73 |     \"\"\"Plot calibration curve for est w/o and with calibration. \"\"\"\n 74 |     # Calibrated with isotonic calibration\n 75 |     isotonic = CalibratedClassifierCV(est, cv=2, method='isotonic')\n 76 | \n 77 |     # Calibrated with sigmoid calibration\n 78 |     sigmoid = CalibratedClassifierCV(est, cv=2, method='sigmoid')\n 79 | \n 80 |     # Logistic regression with no calibration as baseline\n 81 |     lr = LogisticRegression(C=1.)\n 82 | \n 83 |     fig = plt.figure(fig_index, figsize=(10, 10))\n 84 |     ax1 = plt.subplot2grid((3, 1), (0, 0), rowspan=2, fig=fig)\n 85 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\n\n\n##Searching for term \"CalibrationDisplay\"...\n### Search Result:\nFound function `sklearn/calibration.py:_sigmoid_calibration`.\nSource: Retrieved entity using keyword search (bm25).\n```\n722 | def _sigmoid_calibration(predictions, y, sample_weight=None):\n723 |     \"\"\"Probability Calibration with sigmoid method (Platt 2000)\n724 | \n725 |     Parameters\n726 |     ----------\n727 |     predictions : ndarray of shape (n_samples,)\n728 |         The decision function or predict proba for the samples.\n729 | \n730 |     y : ndarray of shape (n_samples,)\n731 |         The targets.\n732 | \n733 |     sample_weight : array-like of shape (n_samples,), default=None\n734 |         Sample weights. If None, then samples are equally weighted.\n735 | \n736 |     Returns\n737 |     -------\n738 |     a : float\n739 |         The slope.\n740 | \n741 |     b : float\n742 |         The intercept.\n743 | \n744 |     References\n745 |     ----------\n746 |     Platt, \"Probabilistic Outputs for Support Vector Machines\"\n747 |     \"\"\"\n748 |     predictions = column_or_1d(predictions)\n749 |     y = column_or_1d(y)\n750 | \n751 |     F = predictions  # F follows Platt's notations\n752 | \n753 |     # Bayesian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n```\n\nFound file `sklearn/calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/calibration.py` for the full content if needed.\n\n\n\n##Searching for term \"CalibrationDisplay\", \"CalibrationDisplay matplotlib\"...\n### Search Result:\nFound file `examples/calibration/plot_calibration.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `examples/calibration/plot_calibration.py` for the full content if needed.\n\n\n\n##Searching for term \"calibration_curve\"...\n### Search Result:\nFound function `sklearn/calibration.py:calibration_curve`.\nSource: Match found for entity name `calibration_curve`.\n```\n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n\n##Searching for term \"matplotlib\"...\n### Search Result:\nFound function `sklearn/utils/__init__.py:check_matplotlib_support`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1085 | def check_matplotlib_support(caller_name):\n1086 |     \"\"\"Raise ImportError with detailed error message if mpl is not installed.\n1087 | \n1088 |     Plot utilities like :func:`plot_partial_dependence` should lazily import\n1089 |     matplotlib and call this helper before any computation.\n1090 | \n1091 |     Parameters\n1092 |     ----------\n1093 |     caller_name : str\n1094 |         The name of the caller that requires matplotlib.\n1095 |     \"\"\"\n1096 |     try:\n1097 |         import matplotlib  # noqa\n1098 |     except ImportError as e:\n1099 |         raise ImportError(\n1100 |             \"{} requires matplotlib. You can install matplotlib with \"\n1101 |             \"`pip install matplotlib`\".format(caller_name)\n1102 |         ) from e\n```\n\nFound function `doc/conftest.py:skip_if_matplotlib_not_installed`.\nSource: Retrieved entit