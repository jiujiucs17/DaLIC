56 |     ----------\n1357 |     axis : int, iterable of int\n1358 |         The un-normalized index or indices of the axis.\n1359 |     ndim : int\n1360 |         The number of dimensions of the array that `axis` should be normalized\n1361 |         against.\n1362 |     argname : str, optional\n1363 |         A prefix to put before the error message, typically the name of the\n1364 |         argument.\n1365 |     allow_duplicate : bool, optional\n1366 |         If False, the default, disallow an axis from being specified twice.\n1367 | \n1368 |     Returns\n1369 |     -------\n1370 |     normalized_axes : tuple of int\n1371 |         The normalized axis index, such that `0 <= normalized_axis < ndim`\n1372 | \n1373 |     Raises\n1374 |     ------\n1375 |     AxisError\n1376 |         If any axis provided is out of range\n1377 |     ValueError\n1378 |         If an axis is repeated\n1379 | \n1380 |     See also\n1381 |     --------\n1382 |     normalize_axis_index : normalizing a single scalar axis\n1383 |     \"\"\"\n1384 |     # Optimization to speed-up the most common cases.\n1385 |     if type(axis) not in (tuple, list):\n1386 |         try:\n1387 |             axis = [operator.index(axis)]\n1388 |         except TypeError:\n1389 |             pass\n1390 |     # Going via an iterator directly is slower than via list comprehension.\n1391 |     axis = tuple([normalize_axis_index(ax, ndim, argname) for ax in axis])\n1392 |     if not allow_duplicate and len(set(axis)) != len(axis):\n1393 |         if argname:\n1394 |             raise ValueError('repeated axis in `{}` argument'.format(argname))\n1395 |         else:\n1396 |             raise ValueError('repeated axis')\n1397 |     return axis\n```\n\nFound function `numpy/core/numeric.py:_move_axis_to_0`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1477 | def _move_axis_to_0(a, axis):\n1478 |     return moveaxis(a, axis, 0)\n```\n\nFound function `numpy/ma/extras.py:apply_along_axis`.\nSource: Retrieved entity using keyword search (bm25).\n```\n372 | def apply_along_axis(func1d, axis, arr, *args, **kwargs):\n373 |     \"\"\"\n374 |     (This docstring should be overwritten)\n375 |     \"\"\"\n376 |     arr = array(arr, copy=False, subok=True)\n377 |     nd = arr.ndim\n378 |     axis = normalize_axis_index(axis, nd)\n379 |     ind = [0] * (nd - 1)\n380 |     i = np.zeros(nd, 'O')\n381 |     indlist = list(range(nd))\n382 |     indlist.remove(axis)\n383 |     i[axis] = slice(None, None)\n384 |     outshape = np.asarray(arr.shape).take(indlist)\n385 |     i.put(indlist, ind)\n386 |     res = func1d(arr[tuple(i.tolist())], *args, **kwargs)\n387 |     #  if res is a number, then we have a smaller output array\n388 |     asscalar = np.isscalar(res)\n389 |     if not asscalar:\n390 |         try:\n391 |             len(res)\n392 |         except TypeError:\n393 |             asscalar = True\n394 |     # Note: we shouldn't set the dtype of the output from the first result\n395 |     # so we force the type to object, and build a list of dtypes.  We'll\n396 |     # just take the largest, to avoid some downcasting\n397 |     dtypes = []\n398 |     if asscalar:\n399 |         dtypes.append(np.asarray(res).dtype)\n400 |         outarr = zeros(outshape, object)\n401 |         outarr[tuple(ind)] = res\n402 |         Ntot = np.product(outshape)\n403 |         k = 1\n404 |         while k < Ntot:\n405 |             # increment the index\n406 |             ind[-1] += 1\n407 |             n = -1\n408 |             while (ind[n] >= outshape[n]) and (n > (1 - nd)):\n409 |                 ind[n - 1] += 1\n410 |                 ind[n] = 0\n411 |                 n -= 1\n412 |             i.put(indlist, ind)\n413 |             res = func1d(arr[tuple(i.tolist())], *args, **kwargs)\n414 |             outarr[tuple(ind)] = res\n415 |             dtypes.append(asarray(res).dtype)\n416 |             k += 1\n417 |     else:\n418 |         res = array(res, copy=False, subok=True)\n419 |       