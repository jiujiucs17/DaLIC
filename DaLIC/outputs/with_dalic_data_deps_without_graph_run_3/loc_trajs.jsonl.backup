  -------\n 81 |     type_true : one of {'continuous', continuous-multioutput'}\n 82 |         The type of the true target data, as output by\n 83 |         'utils.multiclass.type_of_target'.\n 84 | \n 85 |     y_true : array-like of shape (n_samples, n_outputs)\n 86 |         Ground truth (correct) target values.\n 87 | \n 88 |     y_pred : array-like of shape (n_samples, n_outputs)\n 89 |         Estimated target values.\n 90 | \n 91 |     multioutput : array-like of shape (n_outputs) or string in ['raw_values',\n 92 |         uniform_average', 'variance_weighted'] or None\n 93 |         Custom output weights if ``multioutput`` is array-like or\n 94 |         just the corresponding argument if ``multioutput`` is a\n 95 |         correct keyword.\n 96 |     \"\"\"\n 97 |     xp, _ = get_namespace(y_true, y_pred, multioutput, xp=xp)\n 98 | \n 99 |     check_consistent_length(y_true, y_pred)\n100 |     y_true = check_array(y_true, ensure_2d=False, dtype=dtype)\n101 |     y_pred = check_array(y_pred, ensure_2d=False, dtype=dtype)\n102 | \n103 |     if y_true.ndim == 1:\n104 |         y_true = xp.reshape(y_true, (-1, 1))\n105 | \n106 |     if y_pred.ndim == 1:\n107 |         y_pred = xp.reshape(y_pred, (-1, 1))\n108 | \n109 |     if y_true.shape[1] != y_pred.shape[1]:\n110 |         raise ValueError(\n111 |             \"y_true and y_pred have different number of output ({0}!={1})\".format(\n112 |                 y_true.shape[1], y_pred.shape[1]\n113 |             )\n114 |         )\n115 | \n116 |     n_outputs = y_true.shape[1]\n117 |     allowed_multioutput_str = (\"raw_values\", \"uniform_average\", \"variance_weighted\")\n118 |     if isinstance(multioutput, str):\n119 |         if multioutput not in allowed_multioutput_str:\n120 |             raise ValueError(\n121 |                 \"Allowed 'multioutput' string values are {}. \"\n122 |                 \"You provided multioutput={!r}\".format(\n123 |                     allowed_multioutput_str, multioutput\n124 |                 )\n125 |             )\n126 |     elif multioutput is not None:\n127 |         multioutput = check_array(multioutput, ensure_2d=False)\n128 |         if n_outputs == 1:\n129 |             raise ValueError(\"Custom weights are useful only in multi-output cases.\")\n130 |         elif n_outputs != multioutput.shape[0]:\n131 |             raise ValueError(\n132 |                 \"There must be equally many custom weights \"\n133 |                 f\"({multioutput.shape[0]}) as outputs ({n_outputs}).\"\n134 |             )\n135 |     y_type = \"continuous\" if n_outputs == 1 else \"continuous-multioutput\"\n136 | \n137 |     return y_type, y_true, y_pred, multioutput\n```\n\n\n\n##Searching for term \"_find_matching_floating_dtype\"...\n### Search Result:\nFound function `sklearn/utils/_array_api.py:_find_matching_floating_dtype`.\nSource: Match found for entity name `_find_matching_floating_dtype`.\n```\n673 | def _find_matching_floating_dtype(*arrays, xp):\n674 |     \"\"\"Find a suitable floating point dtype when computing with arrays.\n675 | \n676 |     If any of the arrays are floating point, return the dtype with the highest\n677 |     precision by following official type promotion rules:\n678 | \n679 |     https://data-apis.org/array-api/latest/API_specification/type_promotion.html\n680 | \n681 |     If there are no floating point input arrays (all integral inputs for\n682 |     instance), return the default floating point dtype for the namespace.\n683 |     \"\"\"\n684 |     dtyped_arrays = [a for a in arrays if hasattr(a, \"dtype\")]\n685 |     floating_dtypes = [\n686 |         a.dtype for a in dtyped_arrays if xp.isdtype(a.dtype, \"real floating\")\n687 |     ]\n688 |     if floating_dtypes:\n689 |         # Return the floating dtype with the highest precision:\n690 |         return xp.result_type(*floating_dtypes)\n691 | \n692 |     # If none of the input arrays have a floating point dtype, they must be all\n693 |     # integer arrays or containers of Python scalars: return the default\n694 |     # floating point dtype for the namespace (implementation specific).\n695 |     return xp.asarray(0.0).dtype\n```\n"}, {"content": "Now let me check the validation module since it seems to be involved in the feature request:\n\n<function=search_code_snippets>\n<parameter=search_terms>['check_array']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"check_array\"...\n### Search Result:\nFound function `sklearn/utils/validation.py:check_array`.\nSource: Match found for entity name `check_array`.\n```\n 735 | def check_array(\n 736 |     array,\n 737 |     accept_sparse=False,\n 738 |     *,\n 739 |     accept_large_sparse=True,\n 740 |     dtype=\"numeric\",\n 741 |     order=None,\n 742 |     copy=False,\n 743 |     force_writeable=False,\n 744 |     force_all_finite=\"deprecated\",\n 745 |     ensure_all_finite=None,\n 746 |     ensure_non_negative=False,\n 747 |     ensure_2d=True,\n 748 |     allow_nd=False,\n 749 |     ensure_min_samples=1,\n 750 |     ensure_min_features=1,\n 751 |     estimator=None,\n 752 |     input_name=\"\",\n 753 | ):\n 754 |     \"\"\"Input validation on an array, list, sparse matrix or similar.\n 755 | \n 756 |     By default, the input is checked to be a non-empty 2D array containing\n 757 |     only finite values. If the dtype of the array is object, attempt\n 758 |     converting to float, raising on failure.\n 759 | \n 760 |     Parameters\n 761 |     ----------\n 762 |     array : object\n 763 |         Input object to check / convert.\n 764 | \n 765 |     accept_sparse : str, bool or list/tuple of str, default=False\n 766 |         String[s] representing allowed sparse matrix formats, such as 'csc',\n 767 |         'csr', etc. If the input is sparse but not in the allowed format,\n 768 |         it will be converted to the first listed format. True allows the input\n 769 |         to be any format. False means that a sparse matrix input will\n 770 |         raise an error.\n 771 | \n 772 |     accept_large_sparse : bool, default=True\n 773 |         If a CSR, CSC, COO or BSR sparse matrix is supplied and accepted by\n 774 |         accept_sparse, accept_large_sparse=False will cause it to be accepted\n 775 |         only if its indices are stored with a 32-bit dtype.\n 776 | \n 777 |         .. versionadded:: 0.20\n 778 | \n 779 |     dtype : 'numeric', type, list of type or None, default='numeric'\n 780 |         Data type of result. If None, the dtype of the input is preserved.\n 781 |         If \"numeric\", dtype is preserved unless array.dtype is object.\n 782 |         If dtype is a list of types, conversion on the first type is only\n 783 |         performed if the dtype of the input is not in the list.\n 784 | \n 785 |     order : {'F', 'C'} or None, default=None\n 786 |         Whether an array will be forced to be fortran or c-style.\n 787 |         When order is None (default), then if copy=False, nothing is ensured\n 788 |         about the memory layout of the output array; otherwise (copy=True)\n 789 |         the memory layout of the returned array is kept as close as possible\n 790 |         to the original array.\n 791 | \n 792 |     copy : bool, default=False\n 793 |         Whether a forced copy will be triggered. If copy=False, a copy might\n 794 |         be triggered by a conversion.\n 795 | \n 796 |     force_writeable : bool, default=False\n 797 |         Whether to force the output array to be writeable. If True, the returned array\n 798 |         is guaranteed to be writeable, which may require a copy. Otherwise the\n 799 |         writeability of the input array is preserved.\n 800 | \n 801 |         .. versionadded:: 1.6\n 802 | \n 803 |     force_all_finite : bool or 'allow-nan', default=True\n 804 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 805 |         possibilities are:\n 806 | \n 807 |         - True: Force all values of array to be finite.\n 808 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 809 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 810 |           cannot be infinite.\n 811 | \n 812 |         .. versionadded:: 0.20\n 813 |            ``force_all_finite`` accepts the string ``'allow-nan'``.\n 814 | \n 815 |         .. versionchanged:: 0.23\n 816 |            Accepts `pd.NA` and converts it into `np.nan`\n 817 | \n 818 |         .. deprecated:: 1.6\n 819 |            `force_all_finite` was renamed to `ensure_all_finite` and will be removed\n 820 |            in 1.8.\n 821 | \n 822 |     ensure_all_finite : bool or 'allow-nan', default=True\n 823 |         Whether to raise an error on np.inf, np.nan, pd.NA in array. The\n 824 |         possibilities are:\n 825 | \n 826 |         - True: Force all values of array to be finite.\n 827 |         - False: accepts np.inf, np.nan, pd.NA in array.\n 828 |         - 'allow-nan': accepts only np.nan and pd.NA values in array. Values\n 829 |           cannot be infinite.\n 830 | \n 831 |         .. versionadded:: 1.6\n 832 |            `force_all_finite` was renamed to `ensure_all_finite`.\n 833 | \n 834 |     ensure_non_negative : bool, default=False\n 835 |         Make sure the array has only non-negative values. If True, an array that\n 836 |         contains negative values will raise a ValueError.\n 837 | \n 838 |         .. versionadded:: 1.6\n 839 | \n 840 |     ensure_2d : bool, default=True\n 841 |         Whether to raise a value error if array is not 2D.\n 842 | \n 843 |     allow_nd : bool, default=False\n 844 |         Whether to allow array.ndim > 2.\n 845 | \n 846 |     ensure_min_samples : int, default=1\n 847 |         Make sure that the array has a minimum number of samples in its first\n 848 |         axis (rows for a 2D array). Setting to 0 disables this check.\n 849 | \n 850 |     ensure_min_features : int, default=1\n 851 |         Make sure that the 2D array has some minimum number of features\n 852 |         (columns). The default value of 1 rejects empty datasets.\n 853 |         This check is only enforced when the input data has effectively 2\n 854 |         dimensions or is originally 1D and ``ensure_2d`` is True. Setting to 0\n 855 |         disables this check.\n 856 | \n 857 |     estimator : str or estimator instance, default=None\n 858 |         If passed, include the name of the estimator in warning messages.\n 859 | \n 860 |     input_name : str, default=\"\"\n 861 |         The data name used to construct the error message. In particular\n 862 |         if `input_name` is \"X\" and the data has NaN values and\n 863 |         allow_nan is False, the error message will link to the imputer\n 864 |         documentation.\n 865 | \n 866 |         .. versionadded:: 1.1.0\n 867 | \n 868 |     Returns\n 869 |     -------\n 870 |     array_converted : object\n 871 |         The converted and validated array.\n 872 | \n 873 |     Examples\n 874 |     --------\n 875 |     >>> from sklearn.utils.validation import check_array\n 876 |     >>> X = [[1, 2, 3], [4, 5, 6]]\n 877 |     >>> X_checked = check_array(X)\n 878 |     >>> X_checked\n 879 |     array([[1, 2, 3], [4, 5, 6]])\n 880 |     \"\"\"\n 881 |     ensure_all_finite = _deprecate_force_all_finite(force_all_finite, ensure_all_finite)\n 882 | \n 883 |     if isinstance(array, np.matrix):\n 884 |         raise TypeError(\n 885 |             \"np.matrix is not supported. Please convert to a numpy array with \"\n 886 |             \"np.asarray. For more information see: \"\n 887 |             \"https://numpy.org/doc/stable/reference/generated/numpy.matrix.html\"\n 888 |         )\n 889 | \n 890 |     xp, is_array_api_compliant = get_namespace(array)\n 891 | \n 892 |     # store reference to original array to check if copy is needed when\n 893 |     # function returns\n 894 |     array_orig = array\n 895 | \n 896 |     # store whether originally we wanted numeric dtype\n 897 |     dtype_numeric = isinstance(dtype, str) and dtype == \"numeric\"\n 898 | \n 899 |     dtype_orig = getattr(array, \"dtype\", None)\n 900 |     if not is_array_api_compliant and not hasattr(dtype_orig, \"kind\"):\n 901 |         # not a data type (e.g. a column named dtype in a pandas DataFrame)\n 902 |         dtype_orig = None\n 903 | \n 904 |     # check if the object contains several dtypes (typically a pandas\n 905 |     # DataFrame), and store them. If not, store None.\n 906 |     dtypes_orig = None\n 907 |     pandas_requires_conversion = False\n 908 |     # track if we have a Series-like object to raise a better error message\n 909 |     type_if_series = None\n 910 |     if hasattr(array, \"dtypes\") and hasattr(array.dtypes, \"__array__\"):\n 911 |         # throw warning if columns are sparse. If all columns are sparse, then\n 912 |         # array.sparse exists and sparsity will be preserved (later).\n 913 |         with suppress(ImportError):\n 914 |             from pandas import SparseDtype\n 915 | \n 916 |             def is_sparse(dtype):\n 917 |                 return isinstance(dtype, SparseDtype)\n 918 | \n 919 |             if not hasattr(array, \"sparse\") and array.dtypes.apply(is_sparse).any():\n 920 |                 warnings.warn(\n 921 |                     \"pandas.DataFrame with sparse columns found.\"\n 922 |                     \"It will be converted to a dense numpy array.\"\n 923 |                 )\n 924 | \n 925 |         dtypes_orig = list(array.dtypes)\n 926 |         pandas_requires_conversion = any(\n 927 |             _pandas_dtype_needs_early_conversion(i) for i in dtypes_orig\n 928 |         )\n 929 |         if all(isinstance(dtype_iter, np.dtype) for dtype_iter in dtypes_orig):\n 930 |             dtype_orig = np.result_type(*dtypes_orig)\n 931 |         elif pandas_requires_conversion and any(d == object for d in dtypes_orig):\n 932 |             # Force object if any of the dtypes is an object\n 933 |             dtype_orig = object\n 934 | \n 935 |     elif (_is_extension_array_dtype(array) or hasattr(array, \"iloc\")) and hasattr(\n 936 |         array, \"dtype\"\n 937 |     ):\n 938 |         # array is a pandas series\n 939 |         type_if_series = type(array)\n 940 |         pandas_requires_conversion = _pandas_dtype_needs_early_conversion(array.dtype)\n 941 |         if isinstance(array.dtype, np.dtype):\n 942 |             dtype_orig = array.dtype\n 943 |         else:\n 944 |             # Set to None to let array.astype work out the best dtype\n 945 |             dtype_orig = None\n 946 | \n 947 |     if dtype_numeric:\n 948 |         if (\n 949 |             dtype_orig is not None\n 950 |             and hasattr(dtype_orig, \"kind\")\n 951 |             and dtype_orig.kind == \"O\"\n 952 |         ):\n 953 |             # if input is object, convert to float.\n 954 |             dtype = xp.float64\n 955 |         else:\n 956 |             dtype = None\n 957 | \n 958 |     if isinstance(dtype, (list, tuple)):\n 959 |         if dtype_orig is not None and dtype_orig in dtype:\n 960 |             # no dtype conversion required\n 961 |             dtype = None\n 962 |         else:\n 963 |             # dtype conversion required. Let's select the first element of the\n 964 |             # list of accepted types.\n 965 |             dtype = dtype[0]\n 966 | \n 967 |     if pandas_requires_conversion:\n 968 |         # pandas dataframe requires conversion earlier to handle extension dtypes with\n 969 |         # nans\n 970 |         # Use the original dtype for conversion if dtype is None\n 971 |         new_dtype = dtype_orig if dtype is None else dtype\n 972 |         array = array.astype(new_dtype)\n 973 |         # Since we converted here, we do not need to convert again later\n 974 |         dtype = None\n 975 | \n 976 |     if ensure_all_finite not in (True, Fa