082 |                         \"single sample) or a single column (i.e. single feature) \"\n1083 |                         \"instead.\"\n1084 |                     )\n1085 |                 else:\n1086 |                     msg = (\n1087 |                         f\"Expected 2D array, got 1D array instead:\\narray={array}.\\n\"\n1088 |                         \"Reshape your data either using array.reshape(-1, 1) if \"\n1089 |                         \"your data has a single feature or array.reshape(1, -1) \"\n1090 |                         \"if it contains a single sample.\"\n1091 |                     )\n1092 |                 raise ValueError(msg)\n1093 | \n1094 |         if dtype_numeric and hasattr(array.dtype, \"kind\") and array.dtype.kind in \"USV\":\n1095 |             raise ValueError(\n1096 |                 \"dtype='numeric' is not compatible with arrays of bytes/strings.\"\n1097 |                 \"Convert your data to numeric values explicitly instead.\"\n1098 |             )\n1099 |         if not allow_nd and array.ndim >= 3:\n1100 |             raise ValueError(\n1101 |                 \"Found array with dim %d. %s expected <= 2.\"\n1102 |                 % (array.ndim, estimator_name)\n1103 |             )\n1104 | \n1105 |         if ensure_all_finite:\n1106 |             _assert_all_finite(\n1107 |                 array,\n1108 |                 input_name=input_name,\n1109 |                 estimator_name=estimator_name,\n1110 |                 allow_nan=ensure_all_finite == \"allow-nan\",\n1111 |             )\n1112 | \n1113 |         if copy:\n1114 |             if _is_numpy_namespace(xp):\n1115 |                 # only make a copy if `array` and `array_orig` may share memory`\n1116 |                 if np.may_share_memory(array, array_orig):\n1117 |                     array = _asarray_with_order(\n1118 |                         array, dtype=dtype, order=order, copy=True, xp=xp\n1119 |                     )\n1120 |             else:\n1121 |     