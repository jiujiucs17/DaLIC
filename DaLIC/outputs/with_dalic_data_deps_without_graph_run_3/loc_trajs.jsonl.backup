   array,\n1015 |             accept_sparse=accept_sparse,\n1016 |             dtype=dtype,\n1017 |             copy=copy,\n1018 |             ensure_all_finite=ensure_all_finite,\n1019 |             accept_large_sparse=accept_large_sparse,\n1020 |             estimator_name=estimator_name,\n1021 |             input_name=input_name,\n1022 |         )\n1023 |         if ensure_2d and array.ndim < 2:\n1024 |             raise ValueError(\n1025 |                 f\"Expected 2D input, got input with shape {array.shape}.\\n\"\n1026 |                 \"Reshape your data either using array.reshape(-1, 1) if \"\n1027 |                 \"your data has a single feature or array.reshape(1, -1) \"\n1028 |                 \"if it contains a single sample.\"\n1029 |             )\n1030 |     else:\n1031 |         # If np.array(..) gives ComplexWarning, then we convert the warning\n1032 |         # to an error. This is needed because specifying a non complex\n1033 |         # dtype to the function converts complex to real dtype,\n1034 |         # thereby passing the test made in the lines following the scope\n1035 |         # of warnings context manager.\n1036 |         with warnings.catch_warnings():\n1037 |             try:\n1038 |                 warnings.simplefilter(\"error\", ComplexWarning)\n1039 |                 if dtype is not None and xp.isdtype(dtype, \"integral\"):\n1040 |                     # Conversion float -> int should not contain NaN or\n1041 |                     # inf (numpy#14412). We cannot use casting='safe' because\n1042 |                     # then conversion float -> int would be disallowed.\n1043 |                     array = _asarray_with_order(array, order=order, xp=xp)\n1044 |                     if xp.isdtype(array.dtype, (\"real floating\", \"complex floating\")):\n1045 |                         _assert_all_finite(\n1046 |                             array,\n1047 |                             allow_nan=False,\n1048 |                             ms