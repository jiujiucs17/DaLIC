])\n2566 |             or np.array_equal(classes, [1])\n2567 |         ):\n2568 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2569 |             raise ValueError(\n2570 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2571 |                 \"specified: either make y_true take value in {0, 1} or \"\n2572 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2573 |             )\n2574 |         pos_label = 1\n2575 | \n2576 |     return pos_label\n```\n\nFound function `sklearn/feature_extraction/text.py:_VectorizerMixin._check_stop_words_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n374 | def _check_stop_words_consistency(self, stop_words, preprocess, tokenize):\n375 |         \"\"\"Check if stop words are consistent\n376 | \n377 |         Returns\n378 |         -------\n379 |         is_consistent : True if stop words are consistent with the preprocessor\n380 |                         and tokenizer, False if they are not, None if the check\n381 |                         was previously performed, \"error\" if it could not be\n382 |                         performed (e.g. because of the use of a custom\n383 |                         preprocessor / tokenizer)\n384 |         \"\"\"\n385 |         if id(self.stop_words) == getattr(self, \"_stop_words_id\", None):\n386 |             # Stop words are were previously validated\n387 |             return None\n388 | \n389 |         # NB: stop_words is validated, unlike self.stop_words\n390 |         try:\n391 |             inconsistent = set()\n392 |             for w in stop_words or ():\n393 |                 tokens = list(tokenize(preprocess(w)))\n394 |                 for token in tokens:\n395 |                     if token not in stop_words:\n396 |                         inconsistent.add(token)\n397 |             self._stop_words_id = id(self.stop_words)\n398 | \n399 |             if inconsistent:\n400 |           