492 |                 )\n1493 |             # 'mu' solver should not be initialized by zeros\n1494 |             if self.solver == \"mu\":\n1495 |                 avg = np.sqrt(X.mean() / self._n_components)\n1496 |                 W = np.full((n_samples, self._n_components), avg, dtype=X.dtype)\n1497 |             else:\n1498 |                 W = np.zeros((n_samples, self._n_components), dtype=X.dtype)\n1499 |         else:\n1500 |             W, H = _initialize_nmf(\n1501 |                 X, self._n_components, init=self.init, random_state=self.random_state\n1502 |             )\n1503 |         return W, H\n1504 | \n1505 |     def _scale_regularization(self, X):\n1506 |         n_samples, n_features = X.shape\n1507 |         if self.alpha_W != 0 or self.alpha_H != \"same\":\n1508 |             # if alpha_W or alpha_H is not left to its default value we ignore alpha\n1509 |             # and regularization, and we scale the regularization terms.\n1510 |             l1_reg_W = n_features * self._l1_reg_W\n1511 |             l1_reg_H = n_samples * self._l1_reg_H\n1512 |             l2_reg_W = n_features * self._l2_reg_W\n1513 |             l2_reg_H = n_samples * self._l2_reg_H\n1514 |         else:\n1515 |             # Otherwise we keep the old behavior with no scaling\n1516 |             # TODO remove in 1.2\n1517 |             l1_reg_W = self._l1_reg_W\n1518 |             l1_reg_H = self._l1_reg_H\n1519 |             l2_reg_W = self._l2_reg_W\n1520 |             l2_reg_H = self._l2_reg_H\n1521 | \n1522 |         return l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H\n1523 | \n1524 |     def fit_transform(self, X, y=None, W=None, H=None):\n1525 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1526 | \n1527 |         This is more efficient than calling fit followed by transform.\n1528 | \n1529 |         Parameters\n1530 |         ----------\n1531 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1532 |             Training vector, where `n_samples` is the number of samples\n1533 |             and `n_features` is the number of features.\n1534 | \n1535 |         y : Ignored\n1536 |             Not used, present for API consistency by convention.\n1537 | \n1538 |         W : array-like of shape (n_samples, n_components)\n1539 |             If init='custom', it is used as initial guess for the solution.\n1540 | \n1541 |         H : array-like of shape (n_components, n_features)\n1542 |             If init='custom', it is used as initial guess for the solution.\n1543 | \n1544 |         Returns\n1545 |         -------\n1546 |         W : ndarray of shape (n_samples, n_components)\n1547 |             Transformed data.\n1548 |         \"\"\"\n1549 |         X = self._validate_data(\n1550 |             X, accept_sparse=(\"csr\", \"csc\"), dtype=[np.float64, np.float32]\n1551 |         )\n1552 | \n1553 |         with config_context(assume_finite=True):\n1554 |             W, H, n_iter = self._fit_transform(X, W=W, H=H)\n1555 | \n1556 |         self.reconstruction_err_ = _beta_divergence(\n1557 |             X, W, H, self._beta_loss, square_root=True\n1558 |         )\n1559 | \n1560 |         self.n_components_ = H.shape[0]\n1561 |         self.components_ = H\n1562 |         self.n_iter_ = n_iter\n1563 | \n1564 |         return W\n1565 | \n1566 |     def _fit_transform(self, X, y=None, W=None, H=None, update_H=True):\n1567 |         \"\"\"Learn a NMF model for the data X and returns the transformed data.\n1568 | \n1569 |         Parameters\n1570 |         ----------\n1571 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1572 |             Data matrix to be decomposed\n1573 | \n1574 |         y : Ignored\n1575 | \n1576 |         W : array-like of shape (n_samples, n_components)\n1577 |             If init='custom', it is used as initial guess for the solution.\n1578 | \n1579 |         H : array-like of shape (n_components, n_features)\n1580 |             If init='custom', it is used as initial guess for the solution.\n1581 |             If update_H=False, it is used as a constant, to solve for W only.\n1582 | \n1583 |         update_H : bool, default=True\n1584 |             If True, both W and H will be estimated from initial guesses,\n1585 |             this corresponds to a call to the 'fit_transform' method.\n1586 |             If False, only W will be estimated, this corresponds to a call\n1587 |             to the 'transform' method.\n1588 | \n1589 |         Returns\n1590 |         -------\n1591 |         W : ndarray of shape (n_samples, n_components)\n1592 |             Transformed data.\n1593 | \n1594 |         H : ndarray of shape (n_components, n_features)\n1595 |             Factorization matrix, sometimes called 'dictionary'.\n1596 | \n1597 |         n_iter_ : int\n1598 |             Actual number of iterations.\n1599 |         \"\"\"\n1600 |         check_non_negative(X, \"NMF (input X)\")\n1601 | \n1602 |         # check parameters\n1603 |         self._check_params(X)\n1604 | \n1605 |         if X.min() == 0 and self._beta_loss <= 0:\n1606 |             raise ValueError(\n1607 |                 \"When beta_loss <= 0 and X contains zeros, \"\n1608 |                 \"the solver may diverge. Please add small values \"\n1609 |                 \"to X, or use a positive beta_loss.\"\n1610 |             )\n1611 | \n1612 |         # initialize or check W and H\n1613 |         W, H = self._check_w_h(X, W, H, update_H)\n1614 | \n1615 |         # scale the regularization terms\n1616 |         l1_reg_W, l1_reg_H, l2_reg_W, l2_reg_H = self._scale_regularization(X)\n1617 | \n1618 |         if self.solver == \"cd\":\n1619 |             W, H, n_iter = _fit_coordinate_descent(\n1620 |                 X,\n1621 |                 W,\n1622 |                 H,\n1623 |                 self.tol,\n1624 |                 self.max_iter,\n1625 |                 l1_reg_W,\n1626 |                 l1_reg_H,\n1627 |                 l2_reg_W,\n1628 |                 l2_reg_H,\n1629 |                 update_H=update_H,\n1630 |                 verbose=self.verbose,\n1631 |                 shuffle=self.shuffle,\n1632 |                 random_state=self.random_state,\n1633 |             )\n1634 |         elif self.solver == \"mu\":\n1635 |             W, H, n_iter = _fit_multiplicative_update(\n1636 |                 X,\n1637 |                 W,\n1638 |                 H,\n1639 |                 self._beta_loss,\n1640 |                 self.max_iter,\n1641 |                 self.tol,\n1642 |                 l1_reg_W,\n1643 |                 l1_reg_H,\n1644 |                 l2_reg_W,\n1645 |                 l2_reg_H,\n1646 |                 update_H=update_H,\n1647 |                 verbose=self.verbose,\n1648 |             )\n1649 |         else:\n1650 |             raise ValueError(\"Invalid solver parameter '%s'.\" % self.solver)\n1651 | \n1652 |         if n_iter == self.max_iter and self.tol > 0:\n1653 |             warnings.warn(\n1654 |                 \"Maximum number of iterations %d reached. Increase \"\n1655 |                 \"it to improve convergence.\"\n1656 |                 % self.max_iter,\n1657 |                 ConvergenceWarning,\n1658 |             )\n1659 | \n1660 |         return W, H, n_iter\n1661 | \n1662 |     def fit(self, X, y=None, **params):\n1663 |         \"\"\"Learn a NMF model for the data X.\n1664 | \n1665 |         Parameters\n1666 |         ----------\n1667 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n1668 |             Training vector, where `n_samples` is the number of samples\n1669 |             and `n_features` is the number of features.\n1670 | \n1671 |         y : Ignored\n1672 |             Not used, present for API consistency by convention.\n1673 | \n1674 |         **params : kwargs\n1675 |             Parameters (keyword arguments) and values passed to\n1676 |             the fit_transform instance.\n1677 | \n1678 |     