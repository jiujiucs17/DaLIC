 \n3088 |         zsort : {'average', 'min', 'max'}, default: 'average'\n3089 |             The z-axis sorting scheme passed onto `~.art3d.Poly3DCollection`\n3090 | \n3091 |         shade : bool, default: True\n3092 |             When true, this shades the dark sides of the bars (relative\n3093 |             to the plot's source of light).\n3094 | \n3095 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3096 |             The lightsource to use when *shade* is True.\n3097 | \n3098 |         axlim_clip : bool, default: False\n3099 |             Whether to hide the bars with points outside the axes view limits.\n3100 | \n3101 |             .. versionadded:: 3.10\n3102 | \n3103 |         data : indexable object, optional\n3104 |             DATA_PARAMETER_PLACEHOLDER\n3105 | \n3106 |         **kwargs\n3107 |             Any additional keyword arguments are passed onto\n3108 |             `~.art3d.Poly3DCollection`.\n3109 | \n3110 |         Returns\n3111 |         -------\n3112 |         collection : `~.art3d.Poly3DCollection`\n3113 |             A collection of three-dimensional polygons representing the bars.\n3114 |         \"\"\"\n3115 | \n3116 |         had_data = self.has_data()\n3117 | \n3118 |         x, y, z, dx, dy, dz = np.broadcast_arrays(\n3119 |             np.atleast_1d(x), y, z, dx, dy, dz)\n3120 |         minx = np.min(x)\n3121 |         maxx = np.max(x + dx)\n3122 |         miny = np.min(y)\n3123 |         maxy = np.max(y + dy)\n3124 |         minz = np.min(z)\n3125 |         maxz = np.max(z + dz)\n3126 | \n3127 |         # shape (6, 4, 3)\n3128 |         # All faces are oriented facing outwards - when viewed from the\n3129 |         # outside, their vertices are in a counterclockwise ordering.\n3130 |         cuboid = np.array([\n3131 |             # -z\n3132 |             (\n3133 |                 (0, 0, 0),\n3134 |                 (0, 1, 0),\n3135 |                 (1, 1, 0),\n3136 |                 (1, 0, 0),\n3137 |             ),\n3138 |             # +z\n3139 |             (\n3140 |                 (0, 0, 1),\n3141 |                 (1, 0, 1),\n3142 |                 (1, 1, 1),\n3143 |                 (0, 1, 1),\n3144 |             ),\n3145 |             # -y\n3146 |             (\n3147 |                 (0, 0, 0),\n3148 |                 (1, 0, 0),\n3149 |                 (1, 0, 1),\n3150 |                 (0, 0, 1),\n3151 |             ),\n3152 |             # +y\n3153 |             (\n3154 |                 (0, 1, 0),\n3155 |                 (0, 1, 1),\n3156 |                 (1, 1, 1),\n3157 |                 (1, 1, 0),\n3158 |             ),\n3159 |             # -x\n3160 |             (\n3161 |                 (0, 0, 0),\n3162 |                 (0, 0, 1),\n3163 |                 (0, 1, 1),\n3164 |                 (0, 1, 0),\n3165 |             ),\n3166 |             # +x\n3167 |             (\n3168 |                 (1, 0, 0),\n3169 |                 (1, 1, 0),\n3170 |                 (1, 1, 1),\n3171 |                 (1, 0, 1),\n3172 |             ),\n3173 |         ])\n3174 | \n3175 |         # indexed by [bar, face, vertex, coord]\n3176 |         polys = np.empty(x.shape + cuboid.shape)\n3177 | \n3178 |         # handle each coordinate separately\n3179 |         for i, p, dp in [(0, x, dx), (1, y, dy), (2, z, dz)]:\n3180 |             p = p[..., np.newaxis, np.newaxis]\n3181 |             dp = dp[..., np.newaxis, np.newaxis]\n3182 |             polys[..., i] = p + dp * cuboid[..., i]\n3183 | \n3184 |         # collapse the first two axes\n3185 |         polys = polys.reshape((-1,) + polys.shape[2:])\n3186 | \n3187 |         facecolors = []\n3188 |         if color is None:\n3189 |             color = [self._get_patches_for_fill.get_next_color()]\n3190 | \n3191 |         color = list(mcolors.to_rgba_array(color))\n3192 | \n3193 |         if len(color) == len(x):\n3194 |             # bar colors specified, need to expand to number of faces\n3195 |             for c in color:\n3196 |                 facecolors.extend([c] * 6)\n3197 |         else:\n3198 |             # a single color specified, or face colors specified explicitly\n3199 |             facecolors = color\n3200 |             if len(facecolors) < len(x):\n3201 |                 facecolors *= (6 * len(x))\n3202 | \n3203 |         col = art3d.Poly3DCollection(polys,\n3204 |                                      zsort=zsort,\n3205 |                                      facecolors=facecolors,\n3206 |                                      shade=shade,\n3207 |                                      lightsource=lightsource,\n3208 |                                      axlim_clip=axlim_clip,\n3209 |                                      *args, **kwargs)\n3210 |         self.add_collection(col)\n3211 | \n3212 |         self.auto_scale_xyz((minx, maxx), (miny, maxy), (minz, maxz), had_data)\n3213 | \n3214 |         return col\n```\n\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2989 | def bar(self, left, height, zs=0, zdir='z', *args,\n2990 |             axlim_clip=False, **kwargs):\n2991 |         \"\"\"\n2992 |         Add 2D bar(s).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         left : 1D array-like\n2997 |             The x coordinates of the left sides of the bars.\n2998 |         height : 1D array-like\n2999 |             The height of the bars.\n3000 |         zs : float or 1D array-like, default: 0\n3001 |             Z coordinate of bars; if a single value is specified, it will be\n3002 |             used for all bars.\n3003 |         zdir : {'x', 'y', 'z'}, default: 'z'\n3004 |             When plotting 2D data, the direction to use as z ('x', 'y' or 'z').\n3005 |         axlim_clip : bool, default: False\n3006 |             Whether to hide bars with points outside the axes view limits.\n3007 | \n3008 |             .. versionadded:: 3.10\n3009 |         data : indexable object, optional\n3010 |             DATA_PARAMETER_PLACEHOLDER\n3011 |         **kwargs\n3012 |             Other keyword arguments are forwarded to\n3013 |             `matplotlib.axes.Axes.bar`.\n3014 | \n3015 |         Returns\n3016 |         -------\n3017 |         mpl_toolkits.mplot3d.art3d.Patch3DCollection\n3018 |         \"\"\"\n3019 |         had_data = self.has_data()\n3020 | \n3021 |         patches = super().bar(left, height, *args, **kwargs)\n3022 | \n3023 |         zs = np.broadcast_to(zs, len(left), subok=True)\n3024 | \n3025 |         verts = []\n3026 |         verts_zs = []\n3027 |         for p, z in zip(patches, zs):\n3028 |             vs = art3d._get_patch_verts(p)\n3029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |             # NOTE: Bugs could still occur if len(verts) > 0,\n3038 |             #       but the \"2nd dimension\" is empty.\n3039 |             xs, ys = zip(*verts)\n3040 |         else:\n3041 |             xs, ys = [], []\n3042 | \n3043 |         xs, ys, verts_zs = art3d.juggle_axes(xs, ys, verts_zs, zdir)\n3044 |         self.auto_scale_xyz(xs, ys, verts_zs, had_data)\n3045 | \n3046 |         return patches\n```\n\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be horizontal.\n65 | \n66 |     \"\"\"\n67 | \n68 |     def __init__(self, patches, errorbar=None, *, datavalues=None,\n69 |                  orientation=None, **kwargs):\n70 |         self.patches = patches\n71 |         self.errorbar = errorbar\n72 |         self.datavalues = datavalues\n73 |         self.orientation = orientation\n74 |         super().__init__(patches, **kwargs)\n```\n\n\n\n##Searching for term \"color\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/individual_colors_from_cmap.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | ===========================================\n 3 | Selecting individual colors from a colormap\n 4 | ===========================================\n 5 | \n 6 | Sometimes we want to use more colors or a different set of colors than the default color\n 7 | cycle provides. Selecting individual colors from one of the provided colormaps can be a\n 8 | convenient way to do this.\n 9 | \n10 | We can retrieve colors from any `.Colormap` by calling it with a float or a list of\n11 | floats in the range [0, 1]; e.g. ``cmap(0.5)`` will give the middle color. See also\n12 | `.Colormap.__call__`.\n13 | \n14 | Extracting colors from a continuous colormap\n15 | --------------------------------------------\n16 | \"\"\"\n17 | \n18 | import matplotlib.pyplot as plt\n19 | import numpy as np\n20 | \n21 | import matplotlib as mpl\n22 | \n23 | n_lines = 21\n24 | cmap = mpl.colormaps['plasma']\n25 | \n26 | # Take colors at regular intervals spanning the colormap.\n27 | colors = cmap(np.linspace(0, 1, n_lines))\n28 | \n29 | fig, ax = plt.subplots(layout='constrained')\n30 | \n31 | for i, color in enumerate(colors):\n32 |     ax.plot([0, i], color=color)\n33 | \n34 | plt.show()\n35 | \n36 | # %%\n37 | #\n38 | # Extracting colors from a discrete colormap\n39 | # ------------------------------------------\n40 | # The list of all colors in a `.ListedColormap` is available as the ``colors``\n41 | # attribute.\n42 | \n43 | colors = mpl.colormaps['Dark2'].colors\n44 | \n45 | fig, ax = plt.subplots(layout='constrained')\n46 | \n47 | for i, color in enumerate(colors):\n48 |     ax.plot([0, i], color=color)\n49 | \n50 | plt.show()\n51 | \n52 | # %%\n53 | # See Also\n54 | # --------\n55 | #\n56 | # For more details about manipulating colormaps, see :ref:`colormap-manipulation`.  To\n57 | # change the default color cycle, see :ref:`color_cycle`.\n58 | #\n59 | # .. admonition:: References\n60 | #\n61 | #    The use of the following functions, methods, classes and modules is shown\n62 | #    in this example:\n63 | #\n64 | #    - `matplotlib.colors.Colormap`\n65 | #    - `matplotlib.colors.Colormap.resampled`\n66 | #\n67 | # .. tags::\n68 | #\n69 | #    component: colormap\n70 | #    styling: color\n71 | #    plot-type: line\n72 | #    level: intermediate\n73 | \n```\n\nFound class `lib/matplotlib/colorizer.py:Colorizer`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Colorizer:\n    def __init__(self, cmap=None, norm=None):\n...\n    def _scale_norm(self, norm, vmin, vmax, A):\n...\n    @property\n    def norm(self):\n...\n    @norm.setter\n    def norm(self, norm):\n...\n    def to_rgba(self, x, alpha=None, bytes=False, norm=True):\n...\n    @staticmethod\n    def _pass_image_data(x, alp