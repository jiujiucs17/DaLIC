     for i in range(n_steps):\n2018 |                 # Sample a minibatch from the full dataset\n2019 |                 minibatch_indices = random_state.randint(0, n_samples, self._batch_size)\n2020 | \n2021 |                 # Perform the actual update step on the minibatch data\n2022 |                 batch_inertia = _mini_batch_step(\n2023 |                     X=X[minibatch_indices],\n2024 |                     x_squared_norms=x_squared_norms[minibatch_indices],\n2025 |                     sample_weight=sample_weight[minibatch_indices],\n2026 |                     centers=centers,\n2027 |                     centers_new=centers_new,\n2028 |                     weight_sums=self._counts,\n2029 |                     random_state=random_state,\n2030 |                     random_reassign=self._random_reassign(),\n2031 |                     reassignment_ratio=self.reassignment_ratio,\n2032 |                     verbose=self.verbose,\n2033 |                     n_threads=self._n_threads,\n2034 |                 )\n2035 | \n2036 |                 if self._tol > 0.0:\n2037 |                     centers_squared_diff = np.sum((centers_new - centers) ** 2)\n2038 |                 else:\n2039 |                     centers_squared_diff = 0\n2040 | \n2041 |                 centers, centers_new = centers_new, centers\n2042 | \n2043 |                 # Monitor convergence and do early stopping if necessary\n2044 |                 if self._mini_batch_convergence(\n2045 |                     i, n_steps, n_samples, centers_squared_diff, batch_inertia\n2046 |                 ):\n2047 |                     break\n2048 | \n2049 |         self.cluster_centers_ = centers\n2050 |         self._n_features_out = self.cluster_centers_.shape[0]\n2051 | \n2052 |         self.n_steps_ = i + 1\n2053 |         self.n_iter_ = int(np.ceil(((i + 1) * self._batch_size) / n_samples))\n2054 | \n2055 |         if self.compute_labels:\n2056 |             self.labels_, self.inertia_ = _labels_inertia_threadpool_limit(\n2057 |                 X,\n2058 |                 sample_weight,\n2059 |                 x_squared_norms,\n2060 |                 self.cluster_centers_,\n2061 |                 n_threads=self._n_threads,\n2062 |             )\n2063 |         else:\n2064 |             self.inertia_ = self._ewa_inertia * n_samples\n2065 | \n2066 |         return self\n```\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSRegression`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSRegression(_PLS):\n\n    # This implementation provides the same results that 3 PLS packages\n    # provided in the R language (R-project):\n    #     - \"mixOmics\" with function pls(X, Y, mode = \"regression\")\n    #     - \"plspm \" with function plsreg2(X, Y)\n    #     - \"pls\" with function oscorespls.fit(X, Y)\n\n    def __init__(\n        self, n_components=2, *, scale=True, max_iter=500, tol=1e-06, copy=True\n    ):\n...\n    def fit(self, X, Y):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSRegression` to get the full content if needed.\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSCanonical`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSCanonical(_PLS):\n\n    # This implementation provides the same results that the \"plspm\" package\n    # provided in the R language (R-project), using the function plsca(X, Y).\n    # Results are equal or collinear with the function\n    # ``pls(..., mode = \"canonical\")`` of the \"mixOmics\" package. The\n    # difference relies in the fact that mixOmics implementation does not\n    # exactly implement the Wold algorithm since it does not normalize\n    # y_weights to one.\n\n    def __init__(\n        self,\n        n_components=2,\n        *,\n        scale=True,\n        algorithm=\"nipals\",\n        max_i