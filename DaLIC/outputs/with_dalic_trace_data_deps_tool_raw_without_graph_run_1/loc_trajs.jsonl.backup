n153 |                     large problems.\n154 | \n155 |     tol : float, default=1e-6\n156 |         Tolerance for 'arpack' method.\n157 |         Not used if eigen_solver=='dense'.\n158 | \n159 |     max_iter : int, default=100\n160 |         Maximum number of iterations for 'arpack' method.\n161 |         Not used if eigen_solver=='dense'\n162 | \n163 |     random_state : int, RandomState instance, default=None\n164 |         Determines the random number generator when ``solver`` == 'arpack'.\n165 |         Pass an int for reproducible results across multiple function calls.\n166 |         See :term:`Glossary <random_state>`.\n167 |     \"\"\"\n168 |     if eigen_solver == \"auto\":\n169 |         if M.shape[0] > 200 and k + k_skip < 10:\n170 |             eigen_solver = \"arpack\"\n171 |         else:\n172 |             eigen_solver = \"dense\"\n173 | \n174 |     if eigen_solver == \"arpack\":\n175 |         v0 = _init_arpack_v0(M.shape[0], random_state)\n176 |         try:\n177 |             eigen_values, eigen_vectors = eigsh(\n178 |                 M, k + k_skip, sigma=0.0, tol=tol, maxiter=max_iter, v0=v0\n179 |             )\n180 |         except RuntimeError as e:\n181 |             raise ValueError(\n182 |                 \"Error in determining null-space with ARPACK. Error message: \"\n183 |                 \"'%s'. Note that eigen_solver='arpack' can fail when the \"\n184 |                 \"weight matrix is singular or otherwise ill-behaved. In that \"\n185 |                 \"case, eigen_solver='dense' is recommended. See online \"\n186 |                 \"documentation for more information.\" % e\n187 |             ) from e\n188 | \n189 |         return eigen_vectors[:, k_skip:], np.sum(eigen_values[k_skip:])\n190 |     elif eigen_solver == \"dense\":\n191 |         if hasattr(M, \"toarray\"):\n192 |             M = M.toarray()\n193 |         eigen_values, eigen_vectors = _eigh(\n194 |             M, subset_by_index=(k_skip, k + k_skip - 1), overwrit