d data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **kwargs,\n617 |     )\n```\n\nFound function `pandas/plotting/_core.py:PlotAccessor.line`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1034 | def line(self, x=None, y=None, **kwargs):\n1035 |         \"\"\"\n1036 |         Plot Series or DataFrame as lines.\n1037 | \n1038 |         This function is useful to plot lines using DataFrame's values\n1039 |         as coordinates.\n1040 |         \"\"\"\n1041 |         return self(kind=\"line\", x=x, y=y, **kwargs)\n```\n\nFound file `pandas/plotting/_core.py`.\nFound file `pandas/plotting/_misc.py`.\nFound file `asv_bench/benchmarks/plotting.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"plot subplots\"...\n### Search Result:\nFound function `pandas/plotting/_matplotlib/tools.py:create_subplots`.\nSource: Retrieved code content using keyword search (bm25).\n```\n132 | def create_subplots(\n133 |     naxes: int,\n134 |     sharex: bool = False,\n135 |     sharey: bool = False,\n136 |     squeeze: bool = True,\n137 |     subplot_kw=None,\n138 |     ax=None,\n139 |     layout=None,\n140 |     layout_type: str = \"box\",\n141 |     **fig_kw,\n142 | ):\n143 |     \"\"\"\n144 |     Create a figure with a set of subplots already made.\n145 | \n146 |     This utility wrapper makes it convenient to create common layouts of\n147 |     subplots, including the enclosing figure object, in a single call.\n148 | \n149 |     Parameters\n150 |     ----------\n151 |     naxes : int\n152 |       Number of required axes. Exceeded axes are set invisible. Default is\n153 |       nrows * ncols.\n154 | \n155 |     sharex : bool\n156 |       If True, the X axis will be shared amongst all subplots.\n157 | \n158 |     sharey : bool\n159 |       If True, the Y axis will be shared amongst all subplots.\n160 | \n161 |     squeeze : bool\n162 | \n163 |       If True, extra dimensions are squeezed out from the returned axis object:\n164 |         - if only one subplot is constructed (nrows=ncols=1), the resulting\n165 |         single Axis object is returned as a scalar.\n166 |         - for Nx1 or 1xN subplots, the returned object is a 1-d numpy object\n167 |         array of Axis objects are returned as numpy 1-d arrays.\n168 |         - for NxM subplots with N>1 and M>1 are returned as a 2d array.\n169 | \n170 |       If False, no squeezing is done: the returned axis object is always\n171 |       a 2-d array containing Axis instances, even if it ends up being 1x1.\n172 | \n173 |     subplot_kw : dict\n174 |       Dict with keywords passed to the add_subplot() call used to create each\n175 |       subplots.\n176 | \n177 |     ax : Matplotlib axis object, optional\n178 | \n179 |     layout : tuple\n180 |       Number of rows and columns of the subplot grid.\n181 |       If not specified, calculated from naxes and layout_type\n182 | \n183 |     layout_type : {'box', 'horizontal', 'vertical'}, default 'box'\n184 |       Specify how to layout the subplot grid.\n185 | \n186 |     fig_kw : Other keyword arguments to be passed to the figure() call.\n187 |         Note that all keywords not recognized above will be\n188 |         automatically included here.\n189 | \n190 |     Returns\n191 |     -------\n192 |     fig, ax : tuple\n193 |       - fig is the Matplotlib Figure object\n194 |       - ax can be either a single axis object or an array of axis objects if\n195 |       more than one subplot was created.  The dimensions of the resulting array\n196 |       can be controlled with the squeeze keyword, see above.\n197 | \n198 |     Examples\n199 |     --------\n200 |     x = np.linspace(0, 2*np.pi, 400)\n201 |     y = np.sin(x**2)\n202 | \n203 |     # Just a figure and one subplot\n204 |     f, ax = plt.subplots()\n205 |     ax.plot(x, y)\n206 |     ax.set_title('Simple plot')\n207 | \n208 |     # Two subplots, unpack the output array immediately\n209 |     f, (ax1, ax2) = plt.subplots(1, 2, sharey=True)\n210 |     ax1.plot(x, y)\n211 |     ax1.set_title('Sharing Y axis')\n212 |     ax2.scatter(x, y)\n213 | \n214 |     # Four polar axes\n215 |     plt.subplots(2, 2, subplot_kw=dict(polar=True))\n216 |     \"\"\"\n217 |     import matplotlib.pyplot as plt\n218 | \n219 |     if subplot_kw is None:\n220 |         subplot_kw = {}\n221 | \n222 |     if ax is None:\n223 |         fig = plt.figure(**fig_kw)\n224 |     else:\n225 |         if is_list_like(ax):\n226 |             if squeeze:\n227 |                 ax = flatten_axes(ax)\n228 |             if layout is not None:\n229 |                 warnings.warn(\n230 |                     \"When passing multiple axes, layout keyword is ignored.\",\n231 |                     UserWarning,\n232 |                 )\n233 |             if sharex or sharey:\n234 |                 warnings.warn(\n235 |                     \"When passing multiple axes, sharex and sharey \"\n236 |                     \"are ignored. These settings must be specified when creating axes.\",\n237 |                     UserWarning,\n238 |                     stacklevel=find_stack_level(),\n239 |                 )\n240 |             if ax.size == naxes:\n241 |                 fig = ax.flat[0].get_figure()\n242 |                 return fig, ax\n243 |             else:\n244 |                 raise ValueError(\n245 |                     f\"The number of passed axes must be {naxes}, the \"\n246 |                     \"same as the output plot\"\n247 |                 )\n248 | \n249 |         fig = ax.get_figure()\n250 |         # if ax is passed and a number of subplots is 1, return ax as it is\n251 |         if naxes == 1:\n252 |             if squeeze:\n253 |                 return fig, ax\n254 |             else:\n255 |                 return fig, flatten_axes(ax)\n256 |         else:\n257 |             warnings.warn(\n258 |                 \"To output multiple subplots, the figure containing \"\n259 |                 \"the passed axes is being cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sharex:\n276 |         subplot_kw[\"sharex\"] = ax0\n277 |     if sharey:\n278 |         subplot_kw[\"sharey\"] = ax0\n279 |     axarr[0] = ax0\n280 | \n281 |     # Note off-by-one counting because add_subplot uses the MATLAB 1-based\n282 |     # convention.\n283 |     for i in range(1, nplots):\n284 |         kwds = subplot_kw.copy()\n285 |         # Set sharex and sharey to None for blank/dummy axes, these can\n286 |         # interfere with proper axis limits on the visible axes if\n287 |         # they share axes e.g. issue #7528\n288 |         if i >= naxes:\n289 |             kwds[\"sharex\"] = None\n290 |             kwds[\"sharey\"] = None\n291 |         ax = fig.add_subplot(nrows, ncols, i + 1, **kwds)\n292 |         axarr[i] = ax\n293 | \n294 |     if naxes != nplots:\n295 |         for ax in axarr[naxes:]:\n296 |             ax.set_visible(False)\n297 | \n298 |     handle_shared_axes(axarr, nplots, naxes, nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 |             axes = axarr.reshape(nrows, ncols).squeeze()\n308 |     else:\n309 |         # returned axis array will be always 2-d, even if nrows=ncols=1\n310 |         axes = axarr.reshape(nrows, ncols)\n311 | \n312 |     return fig, axes\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |         return (1, nplots)\n112 |     elif layout_type == \"vertical\":\n113 |         return (nplots, 1)\n114 | \n115 |     layouts = {1: (1, 1), 2: (1, 2), 3: (2, 2), 4: (2, 2)}\n116 |     try:\n117 |         return layouts[nplots]\n118 |     except KeyError:\n119 |         k = 1\n120 |         while k**2 < nplots:\n121 |             k += 1\n122 | \n123 |         if (k - 1) * k >= nplots:\n124 |             return k, (k - 1)\n125 |         else:\n126 |             return k, k\n```\n\n\n\n##Searching for term \"DataFrame.plot plot subplots\"...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PlotAccessor(PandasObject):\n\n    _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n    _series_kinds = (\"pie\",)\n    _dataframe_kinds = (\"scatter\", \"hexbin\")\n    _kind_aliases = {\"density\": \"kde\"}\n    _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n\n    def __init__(self, data) -> None:\n...\n    @staticmethod\n    def _get_call_args(backend_name, data, args, kwargs):\n...\n    def __call__(self, *args, **kwargs):\n...\n    __call__.__doc__ = __doc__\n\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n\n        Examples\n        --------\n\n        .. plot::\n            :context: close-figs\n\n            >>> s = pd.Series([1, 3, 2])\n            >>> s.plot.line()\n            <AxesSubplot:ylabel='Density'>\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the populations for some animals\n            over the years.\n\n            >>> df = pd.DataFrame({\n            ...    'pig': [20, 18, 489, 675, 1776],\n            ...    'horse': [4, 25, 281, 600, 1900]\n            ...    }, index=[1990, 1997, 2003, 2009, 2014])\n            >>> lines = df.plot.line()\n\n        .. plot::\n           :context: close-figs\n\n           An example with subplots, so an array of axes is returned.\n\n           >>> axes = df.plot.line(subplots=True)\n           >>> type(axes)\n           <class 'numpy.ndarray'>\n\n        .. plot::\n           :context: close-figs\n\n           Let's repeat the same example, but specifying colors for\n           each column (in this case, for each animal).\n\n           >>> axes = df.plot.line(\n           ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n           ... )\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the relationship between both\n            populations.\n\n            >>> lines = df.plot.line(x='pig', y='horse')\n        \"\"\"\n    )\n    @Substitution(kind=\"line\")\n    @Appender(_bar_or_line_doc)\n    def line(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.barh : Horizontal bar plot.\n        DataFrame.plot : Make plots of a DataFrame.\n        matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n\n        Examples\n        --------\n        Basic plot.\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n            >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n\n        Plot a whole dataframe to a bar plot. Each column is assigned a\n        distinct color, and each row is nested in a group along the\n        horizontal axis.\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.bar(rot=0)\n\n        Plot stacked bar charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(stacked=True)\n\n        Instead of nesting, the figure can be split by column with\n        ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n        :class:`matplotlib.axes.Axes` are returned.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(rot=0, subplots=True)\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        If you don't like the default colours, you can specify how you'd\n        like each column to be colored.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(\n            ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n            ... )\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        Plot a single column.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(y='speed', rot=0)\n\n        Plot only selected categories for the DataFrame.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(x='lifespan', rot=0)\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def bar(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.bar: Vertical bar plot.\n        DataFrame.plot : Make plots of DataFrame using matplotlib.\n        matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n\n        Examples\n        --------\n        Basic example\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n            >>> ax = df.plot.barh(x='lab', y='val')\n\n        Plot a whole DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh()\n\n        Plot stacked barh charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(stacked=True)\n\n        We can specify colors for each column\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n\n        Plot a column of the DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh(y='speed')\n\n        Plot DataFrame versus the desired column\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh(x='lifespan')\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def barh(self, x=None, y=None, **kwargs):\n...\n    def box(self, by=None, **kwargs):\n...\n    def hist(self, by=None, bins=10, **kwargs):\n...\n    def kde(self, bw_method=None, ind=None, **kwargs):\n...\n    density = kde\n\n    def area(self, x=None, y=None, **kwargs):\n...\n    def pie(self, **kwargs):\n...\n    def scatter(self, x, y, s=None, c=None, **kwargs):\n...\n    def hexbin(self, x, y, C=None, reduce_C_function=None, gridsize=None, **kwargs):\n\n```\nHint: Search `pandas/plotting/_core.py:PlotAccessor` to get the full content if needed.\n"}, {"content": "Let me analyze the feature request and locate the relevant code areas:\n\n## Step 1: Categorizing and Extracting Key Information\n\nThe feature request is about enhancing the DataFrame.plot() method to allow grouping multiple columns on the same subplot. Key terms:\n- DataFrame.plot()\n- subplots parameter\n- visualization\n- grouping columns\n\nLet me explore the code structure to locate relevant files and classes.\n\n<function=get_entity_contents>\n<parameter=entity_names>['pandas/plotting/_core.py:PlotAccessor']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_entity_contents", "content": "OBSERVATION:\n##Searching for entity `pandas/plotting/_core.py:PlotAccessor`...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Exact match found for entity name `pandas/plotting/_core.py:PlotAccessor`.\n```\n 620 | class PlotAccessor(PandasObject):\n 621 |     \"\"\"\n 622 |     Make plots of Series or DataFrame.\n 623 | \n 624 |     Uses the backend specified by the\n 625 |     option ``plotting.backend``. By default, matplotlib is used.\n 626 | \n 627 |     Parameters\n 628 |     ----------\n 629 |     data : Series or DataFrame\n 630 |         The object for which the method is called.\n 631 |     x : label or position, default None\n 632 |         Only used if data is a DataFrame.\n 633 |     y : label, position or list of label, positions, default None\n 634 |         Allows plotting of one column versus another. Only used if data is a\n 635 |         DataFrame.\n 636 |     kind : str\n 637 |         The kind of plot to produce:\n 638 | \n 639 |         - 'line' : line plot (default)\n 640 |         - 'bar' : vertical bar plot\n 641 |         - 'barh' : horizontal bar plot\n 642 |         - 'hist' : histogram\n 643 |         - 'box' : boxplot\n 644 |         - 'kde' : Kernel Density Estimation plot\n 645 |         - 'density' : same as 'kde'\n 646 |         - 'area' : area plot\n 647 |         - 'pie' : pie plot\n 648 |         - 'scatter' : scatter plot (DataFrame only)\n 649 |         - 'hexbin' : hexbin plot (DataFrame only)\n 650 |     ax : matplotlib axes object, default None\n 651 |         An axes of the current figure.\n 652 |     subplots : bool, default False\n 653 |         Make separate subplots for each column.\n 654 |     sharex : bool, default True if ax is None else False\n 655 |         In case ``subplots=True``, share x axis and set some x axis labels\n 656 |         to invisible; defaults to True if ax is None otherwise False if\n 657 |         an ax is passed in; Be aware, that passing in both an ax and\n 658 |         ``sharex=True`` will alter all x axis labels for all axis in a figure.\n 659 |     sharey : bool, default False\n 660 |         In case ``subplots=True``, share y axis and set some y axis labels to invisible.\n 661 |     layout : tuple, optional\n 662 |         (rows, columns) for the layout of subplots.\n 663 |     figsize : a tuple (width, height) in inches\n 664 |         Size of a figure object.\n 665 |     use_index : bool, default True\n 666 |         Use index as ticks for x axis.\n 667 |     title : str or list\n 668 |         Title to use for the plot. If a string is passed, print the string\n 669 |         at the top of the figure. If a list is passed and `subplots` is\n 670 |         True, print each item in the list above the corresponding subplot.\n 671 |     grid : bool, default None (matlab style default)\n 672 |         Axis grid lines.\n 673 |     legend : bool or {'reverse'}\n 674 |         Place legend on axis subplots.\n 675 |     style : list or dict\n 676 |         The matplotlib line style per column.\n 677 |     logx : bool or 'sym', default False\n 678 |         Use log scaling or symlog scaling on x axis.\n 679 |         .. versionchanged:: 0.25.0\n 680 | \n 681 |     logy : bool or 'sym' default False\n 682 |         Use log scaling or symlog scaling on y axis.\n 683 |         .. versionchanged:: 0.25.0\n 684 | \n 685 |     loglog : bool or 'sym', default False\n 686 |         Use log scaling or symlog scaling on both x and y axes.\n 687 |         .. versionchanged:: 0.25.0\n 688 | \n 689 |     xticks : sequence\n 690 |         Values to use for the xticks.\n 691 |     yticks : sequence\n 692 |         Values to use for the yticks.\n 693 |     xlim : 2-tuple/list\n 694 |         Set the x limits of the current axes.\n 695 |     ylim : 2-tuple/list\n 696 |         Set the y limits of the current axes.\n 697 |     xlabel : label, optional\n 698 |         Name to use for the xlabel on x-axis. Default uses index name as xlabel, or the\n 699 |         x-column name for planar plots.\n 700 | \n 701 |         .. versionadded:: 1.1.0\n 702 | \n 703 |         .. versionchanged:: 1.2.0\n 704 | \n 705 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 706 | \n 707 |     ylabel : label, optional\n 708 |         Name to use for the ylabel on y-axis. Default will show no ylabel, or the\n 709 |         y-column name for planar plots.\n 710 | \n 711 |         .. versionadded:: 1.1.0\n 712 | \n 713 |         .. versionchanged:: 1.2.0\n 714 | \n 715 |            Now applicable to planar plots (`scatter`, `hexbin`).\n 716 | \n 717 |     rot : int, default None\n 718 |         Rotation for ticks (xticks for vertical, yticks for horizontal\n 719 |         plots).\n 720 |     fontsize : int, default None\n 721 |         Font size for xticks and yticks.\n 722 |     colormap : str or matplotlib colormap object, default None\n 723 |         Colormap to select colors from. If string, load colormap with that\n 724 |         name from matplotlib.\n 725 |     colorbar : bool, optional\n 726 |         If True, plot colorbar (only relevant for 'scatter' and 'hexbin'\n 727 |         plots).\n 728 |     position : float\n 729 |         Specify relative alignments for bar plot layout.\n 730 |         From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 731 |         (center).\n 732 |     table : bool, Series or DataFrame, default False\n 733 |         If True, draw a table using the data in the DataFrame and the data\n 734 |         will be transposed to meet matplotlib's default layout.\n 735 |         If a Series or DataFrame is passed, use passed data to draw a\n 736 |         table.\n 737 |     yerr : DataFrame, Series, array-like, dict and str\n 738 |         See :ref:`Plotting with Error Bars <visualization.errorbars>` for\n 739 |         detail.\n 740 |     xerr : DataFrame, Series, array-like, dict and str\n 741 |         Equivalent to yerr.\n 742 |     stacked : bool, default False in line and bar plots, and True in area plot\n 743 |         If True, create stacked plot.\n 744 |     sort_columns : bool, default False\n 745 |         Sort column names to determine plot ordering.\n 746 |     secondary_y : bool or sequence, default False\n 747 |         Whether to plot on the secondary y-axis if a list/tuple, which\n 748 |         columns to plot on secondary y-axis.\n 749 |     mark_right : bool, default True\n 750 |         When using a secondary_y axis, automatically mark the column\n 751 |         labels with \"(right)\" in the legend.\n 752 |     include_bool : bool, default is False\n 753 |         If True, boolean values can be plotted.\n 754 |     backend : str, default None\n 755 |         Backend to use instead of the backend specified in the option\n 756 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n 757 |         specify the ``plotting.backend`` for the whole session, set\n 758 |         ``pd.options.plotting.backend``.\n 759 | \n 760 |         .. versionadded:: 1.0.0\n 761 | \n 762 |     **kwargs\n 763 |         Options to pass to matplotlib plotting method.\n 764 | \n 765 |     Returns\n 766 |     -------\n 767 |     :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n 768 |         If the backend is not the default matplotlib one, the return value\n 769 |         will be the object returned by the backend.\n 770 | \n 771 |     Notes\n 772 |     -----\n 773 |     - See matplotlib documentation online for more on this subject\n 774 |     - If `kind` = 'bar' or 'barh', you can specify relative alignments\n 775 |       for bar plot layout by `position` keyword.\n 776 |       From 0 (left/bottom-end) to 1 (right/top-end). Default is 0.5\n 777 |       (center)\n 778 |     \"\"\"\n 779 | \n 780 |     _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n 781 |     _series_kinds = (\"pie\",)\n 782 |     _dataframe_kinds = (\"scatter\", \"hexbin\")\n 783 |     _kind_aliases = {\"density\": \"kde\"}\n 784 |     _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n 785 | \n 786 |     def __init__(self, data) -> None:\n 787 |         self._parent = data\n 788 | \n 789 |     @staticmethod\n 790 |     def _get_call_args(backend_name, data, args, kwargs):\n 791 |         \"\"\"\n 792 |         This function makes calls to this accessor `__call__` method compatible\n 793 |         with the previous `SeriesPlotMethods.__call__` and\n 794 |         `DataFramePlotMethods.__call__`. Those had slightly different\n 795 |         signatures, since `DataFramePlotMethods` accepted `x` and `y`\n 796 |         parameters.\n 797 |         \"\"\"\n 798 |         if isinstance(data, ABCSeries):\n 799 |             arg_def = [\n 800 |                 (\"kind\", \"line\"),\n 801 |                 (\"ax\", None),\n 802 |                 (\"figsize\", None),\n 803 |                 (\"use_index\", True),\n 804 |                 (\"title\", None),\n 805 |                 (\"grid\", None),\n 806 |                 (\"legend\", False),\n 807 |                 (\"style\", None),\n 808 |                 (\"logx\", False),\n 809 |                 (\"logy\", False),\n 810 |                 (\"loglog\", False),\n 811 |                 (\"xticks\", None),\n 812 |                 (\"yticks\", None),\n 813 |                 (\"xlim\", None),\n 814 |                 (\"ylim\", None),\n 815 |                 (\"rot\", None),\n 816 |                 (\"fontsize\", None),\n 817 |                 (\"colormap\", None),\n 818 |                 (\"table\", False),\n 819 |                 (\"yerr\", None),\n 820 |                 (\"xerr\", None),\n 821 |                 (\"label\", None),\n 822 |                 (\"secondary_y\", False),\n 823 |                 (\"xlabel\", None),\n 824 |                 (\"ylabel\", None),\n 825 |             ]\n 826 |         elif isinstance(data, ABCDataFrame):\n 827 |             arg_def = [\n 828 |                 (\"x\", None),\n 829 |                 (\"y\", None),\n 830 |                 (\"kind\", \"line\"),\n 831 |                 (\"ax\", None),\n 832 |                 (\"subplots\", False),\n 833 |                 (\"sharex\", None),\n 834 |                 (\"sharey\", False),\n 835 |                 (\"layout\", None),\n 836 |                 (\"figsize\", None),\n 837 |                 (\"use_index\", True),\n 838 |                 (\"title\", None),\n 839 |                 (\"grid\", None),\n 840 |                 (\"legend\", True),\n 841 |                 (\"style\", None),\n 842 |                 (\"logx\", False),\n 843 |                 (\"logy\", False),\n 844 |                 (\"loglog\", False),\n 845 |                 (\"xticks\", None),\n 846 |                 (\"yticks\", None),\n 847 |                 (\"xlim\", None),\n 848 |                 (\"ylim\", None),\n 849 |                 (\"rot\", None),\n 850 |                 (\"fontsize\", None),\n 851 |                 (\"colormap\", None),\n 852 |                 (\"table\", False),\n 853 |                 (\"yerr\", None),\n 854 |                 (\"xerr\", None),\n 855 |                 (\"secondary_y\", False),\n 856 |                 (\"sort_columns\", False),\n 857 |                 (\"xlabel\", None),\n 858 |                 (\"ylabel\", None),\n 859 |             ]\n 860 |         else:\n 861 |             raise TypeError(\n 862 |                 f\"Called plot accessor for type {type(data).__name__}, \"\n 863 |                 \"expected Series or DataFrame\"\n 864 |             )\n 865 | \n 866 |         if args and isinstance(data, ABCSeries):\n 867 |             positional_args = str(args)[1:-1]\n 868 |             keyword_args = \", \".join(\n 869 |                 [f\"{name}={repr(value)}\" for (name, _), value in zip(arg_def, args)]\n 870 |             )\n 871 |             msg = (\n 872 |                 \"`Series.plot()` should not be called with positional \"\n 873 |                 \"arguments, only keyword arguments. The order of \"\n 874 |                 \"positional arguments will change in the future. \"\n 875 |                 f\"Use `Series.plot({keyword_args})` instead of \"\n 876 |                 f\"`Series.plot({positional_args})`.\"\n 877 |             )\n 878 |             raise TypeError(msg)\n 879 | \n 880 |         pos_args = {name: value for (name, _), value in zip(arg_def, args)}\n 881 |         if backend_name == \"pandas.plotting._matplotlib\":\n 882 |             kwargs = dict(arg_def, **pos_args, **kwargs)\n 883 |         else:\n 884 |             kwargs = dict(pos_args, **kwargs)\n 885 | \n 886 |         x = kwargs.pop(\"x\", None)\n 887 |         y = kwargs.pop(\"y\", None)\n 888 |         kind = kwargs.pop(\"kind\", \"line\")\n 889 |         return x, y, kind, kwargs\n 890 | \n 891 |     def __call__(self, *args, **kwargs):\n 892 |         plot_backend = _get_plot_backend(kwargs.pop(\"backend\", None))\n 893 | \n 894 |         x, y, kind, kwargs = self._get_call_args(\n 895 |             plot_backend.__name__, self._parent, args, kwargs\n 896 |         )\n 897 | \n 898 |         kind = self._kind_aliases.get(kind, kind)\n 899 | \n 900 |         # when using another backend, get out of the way\n 901 |         if plot_backend.__name__ != \"pandas.plotting._matplotlib\":\n 902 |             return plot_backend.plot(self._parent, x=x, y=y, kind=kind, **kwargs)\n 903 | \n 904 |         if kind not in self._all_kinds:\n 905 |             raise ValueError(f\"{kind} is not a valid plot kind\")\n 906 | \n 907 |         # The original data structured can be transformed before passed to the\n 908 |         # backend. For example, for DataFrame is common to set the index as the\n 909 |         # `x` parameter, and return a Series with the parameter `y` as values.\n 910 |         data = self._parent.copy()\n 911 | \n 912 |         if isinstance(data, ABCSeries):\n 913 |             kwargs[\"reuse_plot\"] = True\n 914 | \n 915 |         if kind in self._dataframe_kinds:\n 916 |             if isinstance(data, ABCDataFrame):\n 917 |                 return plot_backend.plot(data, x=x, y=y, kind=kind, **kwargs)\n 918 |             else:\n 919 |                 raise ValueError(f\"plot kind {kind} can only be used for data frames\")\n 920 |         elif kind in self._series_kinds:\n 921 |             if isinstance(data, ABCDataFrame):\n 922 |                 if y is None and kwargs.get(\"subplots\") is False:\n 923 |                     raise ValueError(\n 924 |                         f\"{kind} requires either y column or 'subplots=True'\"\n 925 |                     )\n 926 |                 elif y is not None:\n 927 |                     if is_integer(y) and not data.columns.holds_integer():\n 928 |                         y = data.columns[y]\n 929 |                     # converted to series actually. copy to not modify\n 930 |                     data = data[y].copy()\n 931 |                     data.index.name = y\n 932 |         elif isinstance(data, ABCDataFrame):\n 933 |             data_cols = data.columns\n 934 |             if x is not None:\n 935 |                 if is_integer(x) and not data.columns.holds_integer():\n 936 |                     x = data_cols[x]\n 937 |                 elif not isinstance(data[x], ABCSeries):\n 938 |                     raise ValueError(\"x must be a label or position\")\n 939 |                 data = data.set_index(x)\n 940 |             if y is not None:\n 941 |                 # check if we have y as int or list of ints\n 942 |                 int_ylist = is_list_like(y) and all(is_integer(c) for c in y)\n 943 |                 int_y_arg = is_integer(y) or int_ylist\n 944 |                 if int_y_arg and not data.columns.holds_integer():\n 945 |                     y = data_cols[y]\n 946 | \n 947 |                 label_kw = kwargs[\"label\"] if \"label\" in kwargs else False\n 948 |                 for kw in [\"xerr\", \"yerr\"]:\n 949 |                     if kw in kwargs and (\n 950 |                         isinstance(kwargs[kw], str) or is_integer(kwargs[kw])\n 951 |                     ):\n 952 |                         try:\n 953 |                             kwargs[kw] = data[kwargs[kw]]\n 954 |                         except (IndexError, KeyError, TypeError):\n 955 |                             pass\n 956 | \n 957 |                 # don't overwrite\n 958 |                 data = data[y].copy()\n 959 | \n 960 |                 if isinstance(data, ABCSeries):\n 961 |                     label_name = label_kw or y\n 962 |                     data.name = label_name\n 963 |                 else:\n 964 |                     match = is_list_like(label_kw) and len(label_kw) == len(y)\n 965 |                     if label_kw and not match:\n 966 |                         raise ValueError(\n 967 |                             \"label should be list-like and same length as y\"\n 968 |                         )\n 969 |                     label_name = label_kw or data.columns\n 970 |                     data.columns = label_name\n 971 | \n 972 |         return plot_backend.plot(data, kind=kind, **kwargs)\n 973 | \n 974 |     __call__.__doc__ = __doc__\n 975 | \n 976 |     @Appender(\n 977 |         \"\"\"\n 978 |         See Also\n 979 |         --------\n 980 |         matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n 981 | \n 982 |         Examples\n 983 |         --------\n 984 | \n 985 |         .. plot::\n 986 |             :context: close-figs\n 987 | \n 988 |             >>> s = pd.Series([1, 3, 2])\n 989 |             >>> s.plot.line()\n 990 |             <AxesSubplot:ylabel='Density'>\n 991 | \n 992 |         .. plot::\n 993 |             :context: close-figs\n 994 | \n 995 |             The following example shows the populations for some animals\n 996 |             over the years.\n 997 | \n 998 |             >>> df = pd.DataFrame({\n 999 |             ...    'pig': [20, 18, 489, 675, 1776],\n1000 |             ...    'horse': [4, 25, 281, 600, 1900]\n1001 |             ...    }, index=[1990, 1997, 2003, 2009, 2014])\n1002 |             >>> lines = df.plot.line()\n1003 | \n1004 |         .. plot::\n1005 |            :context: close-figs\n1006 | \n1007 |            An example with subplots, so an array of axes is returned.\n1008 | \n1009 |            >>> axes = df.plot.line(subplots=True)\n1010 |            >>> type(axes)\n1011 |            <class 'numpy.ndarray'>\n1012 | \n1013 |         .. plot::\n1014 |            :context: close-figs\n1015 | \n1016 |            Let's repeat the same example, but specifying colors for\n1017 |            each column (in this case, for each animal).\n1018 | \n1019 |            >>> axes = df.plot.line(\n1020 |            ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n1021 |            ... )\n1022 | \n1023 |         .. plot::\n1024 |             :context: close-figs\n1025 | \n1026 |             The following example shows the relationship between both\n1027 |             populations.\n1028 | \n1029 |             >>> lines = df.plot.line(x='pig', y='horse')\n1030 |         \"\"\"\n1031 |     )\n1032 |     @Substitution(kind=\"line\")\n1033 |     @Appender(_bar_or_line_doc)\n1034 |     def line(self, x=None, y=None, **kwargs):\n1035 |         \"\"\"\n1036 |         Plot Series or DataFrame as lines.\n1037 | \n1038 |         This function is useful to plot lines using DataFrame's values\n1039 |         as coordinates.\n1040 |         \"\"\"\n1041 |         return self(kind=\"line\", x=x, y=y, **kwargs)\n1042 | \n1043 |     @Appender(\n1044 |         \"\"\"\n1045 |         See Also\n1046 |         --------\n1047 |         DataFrame.plot.barh : Horizontal bar plot.\n1048 |         DataFrame.plot : Make plots of a DataFrame.\n1049 |         matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n1050 | \n1051 |         Examples\n1052 |         --------\n1053 |         Basic plot.\n1054 | \n1055 |         .. plot::\n1056 |             :context: close-figs\n1057 | \n1058 |             >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n1059 |             >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n1060 | \n1061 |         Plot a whole dataframe to a bar plot. Each column is assigned a\n1062 |         distinct color, and each row is nested in a group along the\n1063 |         horizontal axis.\n1064 | \n1065 |         .. plot::\n1066 |             :context: close-figs\n1067 | \n1068 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1069 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1070 |             >>> index = ['snail', 'pig', 'elephant',\n1071 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1072 |             >>> df = pd.DataFrame({'speed': speed,\n1073 |             ...                    'lifespan': lifespan}, index=index)\n1074 |             >>> ax = df.plot.bar(rot=0)\n1075 | \n1076 |         Plot stacked bar charts for the DataFrame\n1077 | \n1078 |         .. plot::\n1079 |             :context: close-figs\n1080 | \n1081 |             >>> ax = df.plot.bar(stacked=True)\n1082 | \n1083 |         Instead of nesting, the figure can be split by column with\n1084 |         ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n1085 |         :class:`matplotlib.axes.Axes` are returned.\n1086 | \n1087 |         .. plot::\n1088 |             :context: close-figs\n1089 | \n1090 |             >>> axes = df.plot.bar(rot=0, subplots=True)\n1091 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1092 | \n1093 |         If you don't like the default colours, you can specify how you'd\n1094 |         like each column to be colored.\n1095 | \n1096 |         .. plot::\n1097 |             :context: close-figs\n1098 | \n1099 |             >>> axes = df.plot.bar(\n1100 |             ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n1101 |             ... )\n1102 |             >>> axes[1].legend(loc=2)  # doctest: +SKIP\n1103 | \n1104 |         Plot a single column.\n1105 | \n1106 |         .. plot::\n1107 |             :context: close-figs\n1108 | \n1109 |             >>> ax = df.plot.bar(y='speed', rot=0)\n1110 | \n1111 |         Plot only selected categories for the DataFrame.\n1112 | \n1113 |         .. plot::\n1114 |             :context: close-figs\n1115 | \n1116 |             >>> ax = df.plot.bar(x='lifespan', rot=0)\n1117 |     \"\"\"\n1118 |     )\n1119 |     @Substitution(kind=\"bar\")\n1120 |     @Appender(_bar_or_line_doc)\n1121 |     def bar(self, x=None, y=None, **kwargs):\n1122 |         \"\"\"\n1123 |         Vertical bar plot.\n1124 | \n1125 |         A bar plot is a plot that presents categorical data with\n1126 |         rectangular bars with lengths proportional to the values that they\n1127 |         represent. A bar plot shows comparisons among discrete categories. One\n1128 |         axis of the plot shows the specific categories being compared, and the\n1129 |         other axis represents a measured value.\n1130 |         \"\"\"\n1131 |         return self(kind=\"bar\", x=x, y=y, **kwargs)\n1132 | \n1133 |     @Appender(\n1134 |         \"\"\"\n1135 |         See Also\n1136 |         --------\n1137 |         DataFrame.plot.bar: Vertical bar plot.\n1138 |         DataFrame.plot : Make plots of DataFrame using matplotlib.\n1139 |         matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n1140 | \n1141 |         Examples\n1142 |         --------\n1143 |         Basic example\n1144 | \n1145 |         .. plot::\n1146 |             :context: close-figs\n1147 | \n1148 |             >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n1149 |             >>> ax = df.plot.barh(x='lab', y='val')\n1150 | \n1151 |         Plot a whole DataFrame to a horizontal bar plot\n1152 | \n1153 |         .. plot::\n1154 |             :context: close-figs\n1155 | \n1156 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1157 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1158 |             >>> index = ['snail', 'pig', 'elephant',\n1159 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1160 |             >>> df = pd.DataFrame({'speed': speed,\n1161 |             ...                    'lifespan': lifespan}, index=index)\n1162 |             >>> ax = df.plot.barh()\n1163 | \n1164 |         Plot stacked barh charts for the DataFrame\n1165 | \n1166 |         .. plot::\n1167 |             :context: close-figs\n1168 | \n1169 |             >>> ax = df.plot.barh(stacked=True)\n1170 | \n1171 |         We can specify colors for each column\n1172 | \n1173 |         .. plot::\n1174 |             :context: close-figs\n1175 | \n1176 |             >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n1177 | \n1178 |         Plot a column of the DataFrame to a horizontal bar plot\n1179 | \n1180 |         .. plot::\n1181 |             :context: close-figs\n1182 | \n1183 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1184 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1185 |             >>> index = ['snail', 'pig', 'elephant',\n1186 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1187 |             >>> df = pd.DataFrame({'speed': speed,\n1188 |             ...                    'lifespan': lifespan}, index=index)\n1189 |             >>> ax = df.plot.barh(y='speed')\n1190 | \n1191 |         Plot DataFrame versus the desired column\n1192 | \n1193 |         .. plot::\n1194 |             :context: close-figs\n1195 | \n1196 |             >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n1197 |             >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n1198 |             >>> index = ['snail', 'pig', 'elephant',\n1199 |             ...          'rabbit', 'giraffe', 'coyote', 'horse']\n1200 |             >>> df = pd.DataFrame({'speed': speed,\n1201 |             ...                    'lifespan': lifespan}, index=index)\n1202 |             >>> ax = df.plot.barh(x='lifespan')\n1203 |     \"\"\"\n1204 |     )\n1205 |     @Substitution(kind=\"bar\")\n1206 |     @Appender(_bar_or_line_doc)\n1207 |     def barh(self, x=None, y=None, **kwargs):\n1208 |         \"\"\"\n1209 |         Make a horizontal bar plot.\n1210 | \n1211 |         A horizontal bar plot is a plot that presents quantitative data with\n1212 |         rectangular bars with lengths proportional to the values that they\n1213 |         represent. A bar plot shows comparisons among discrete categories. One\n1214 |         axis of the plot shows the specific categories being compared, and the\n1215 |         other axis represents a measured value.\n1216 |         \"\"\"\n1217 |         return self(kind=\"barh\", x=x, y=y, **kwargs)\n1218 | \n1219 |     def box(self, by=None, **kwargs):\n1220 |         r\"\"\"\n1221 |         Make a box plot of the DataFrame columns.\n1222 | \n1223 |         A box plot is a method for graphically depicting groups of numerical\n1224 |         data through their quartiles.\n1225 |         The box extends from the Q1 to Q3 quartile values of the data,\n1226 |         with a line at the median (Q2). The whiskers extend from the edges\n1227 |         of box to show the range of the data. The position of the whiskers\n1228 |         is set by default to 1.5*IQR (IQR = Q3 - Q1) from the edges of the\n1229 |         box. Outlier points are those past the end of the whiskers.\n1230 | \n1231 |         For further details see Wikipedia's\n1232 |         entry for `boxplot <https://en.wikipedia.org/wiki/Box_plot>`__.\n1233 | \n1234 |         A consideration when using this chart is that the box and the whiskers\n1235 |         can overlap, which is very common when plotting small sets of data.\n1236 | \n1237 |         Parameters\n1238 |         ----------\n1239 |         by : str or sequence\n1240 |             Column in the DataFrame to group by.\n1241 | \n1242 |             .. versionchanged:: 1.4.0\n1243 | \n1244 |                Previously, `by` is silently ignore and makes no groupings\n1245 | \n1246 |         **kwargs\n1247 |             Additional keywords are documented in\n1248 |             :meth:`DataFrame.plot`.\n1249 | \n1250 |         Returns\n1251 |         -------\n1252 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1253 | \n1254 |         See Also\n1255 |         --------\n1256 |         DataFrame.boxplot: Another method to draw a box plot.\n1257 |         Series.plot.box: Draw a box plot from a Series object.\n1258 |         matplotlib.pyplot.boxplot: Draw a box plot in matplotlib.\n1259 | \n1260 |         Examples\n1261 |         --------\n1262 |         Draw a box plot from a DataFrame with four columns of randomly\n1263 |         generated data.\n1264 | \n1265 |         .. plot::\n1266 |             :context: close-figs\n1267 | \n1268 |             >>> data = np.random.randn(25, 4)\n1269 |             >>> df = pd.DataFrame(data, columns=list('ABCD'))\n1270 |             >>> ax = df.plot.box()\n1271 | \n1272 |         You can also generate groupings if you specify the `by` parameter (which\n1273 |         can take a column name, or a list or tuple of column names):\n1274 | \n1275 |         .. versionchanged:: 1.4.0\n1276 | \n1277 |         .. plot::\n1278 |             :context: close-figs\n1279 | \n1280 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1281 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1282 |             >>> ax = df.plot.box(column=\"age\", by=\"gender\", figsize=(10, 8))\n1283 |         \"\"\"\n1284 |         return self(kind=\"box\", by=by, **kwargs)\n1285 | \n1286 |     def hist(self, by=None, bins=10, **kwargs):\n1287 |         \"\"\"\n1288 |         Draw one histogram of the DataFrame's columns.\n1289 | \n1290 |         A histogram is a representation of the distribution of data.\n1291 |         This function groups the values of all given Series in the DataFrame\n1292 |         into bins and draws all bins in one :class:`matplotlib.axes.Axes`.\n1293 |         This is useful when the DataFrame's Series are in a similar scale.\n1294 | \n1295 |         Parameters\n1296 |         ----------\n1297 |         by : str or sequence, optional\n1298 |             Column in the DataFrame to group by.\n1299 | \n1300 |             .. versionchanged:: 1.4.0\n1301 | \n1302 |                Previously, `by` is silently ignore and makes no groupings\n1303 | \n1304 |         bins : int, default 10\n1305 |             Number of histogram bins to be used.\n1306 |         **kwargs\n1307 |             Additional keyword arguments are documented in\n1308 |             :meth:`DataFrame.plot`.\n1309 | \n1310 |         Returns\n1311 |         -------\n1312 |         class:`matplotlib.AxesSubplot`\n1313 |             Return a histogram plot.\n1314 | \n1315 |         See Also\n1316 |         --------\n1317 |         DataFrame.hist : Draw histograms per DataFrame's Series.\n1318 |         Series.hist : Draw a histogram with Series' data.\n1319 | \n1320 |         Examples\n1321 |         --------\n1322 |         When we roll a die 6000 times, we expect to get each value around 1000\n1323 |         times. But when we roll two dice and sum the result, the distribution\n1324 |         is going to be quite different. A histogram illustrates those\n1325 |         distributions.\n1326 | \n1327 |         .. plot::\n1328 |             :context: close-figs\n1329 | \n1330 |             >>> df = pd.DataFrame(\n1331 |             ...     np.random.randint(1, 7, 6000),\n1332 |             ...     columns = ['one'])\n1333 |             >>> df['two'] = df['one'] + np.random.randint(1, 7, 6000)\n1334 |             >>> ax = df.plot.hist(bins=12, alpha=0.5)\n1335 | \n1336 |         A grouped histogram can be generated by providing the parameter `by` (which\n1337 |         can be a column name, or a list of column names):\n1338 | \n1339 |         .. plot::\n1340 |             :context: close-figs\n1341 | \n1342 |             >>> age_list = [8, 10, 12, 14, 72, 74, 76, 78, 20, 25, 30, 35, 60, 85]\n1343 |             >>> df = pd.DataFrame({\"gender\": list(\"MMMMMMMMFFFFFF\"), \"age\": age_list})\n1344 |             >>> ax = df.plot.hist(column=[\"age\"], by=\"gender\", figsize=(10, 8))\n1345 |         \"\"\"\n1346 |         return self(kind=\"hist\", by=by, bins=bins, **kwargs)\n1347 | \n1348 |     def kde(self, bw_method=None, ind=None, **kwargs):\n1349 |         \"\"\"\n1350 |         Generate Kernel Density Estimate plot using Gaussian kernels.\n1351 | \n1352 |         In statistics, `kernel density estimation`_ (KDE) is a non-parametric\n1353 |         way to estimate the probability density function (PDF) of a random\n1354 |         variable. This function uses Gaussian kernels and includes automatic\n1355 |         bandwidth determination.\n1356 | \n1357 |         .. _kernel density estimation:\n1358 |             https://en.wikipedia.org/wiki/Kernel_density_estimation\n1359 | \n1360 |         Parameters\n1361 |         ----------\n1362 |         bw_method : str, scalar or callable, optional\n1363 |             The method used to calculate the estimator bandwidth. This can be\n1364 |             'scott', 'silverman', a scalar constant or a callable.\n1365 |             If None (default), 'scott' is used.\n1366 |             See :class:`scipy.stats.gaussian_kde` for more information.\n1367 |         ind : NumPy array or int, optional\n1368 |             Evaluation points for the estimated PDF. If None (default),\n1369 |             1000 equally spaced points are used. If `ind` is a NumPy array, the\n1370 |             KDE is evaluated at the points passed. If `ind` is an integer,\n1371 |             `ind` number of equally spaced points are used.\n1372 |         **kwargs\n1373 |             Additional keyword arguments are documented in\n1374 |             :meth:`DataFrame.plot`.\n1375 | \n1376 |         Returns\n1377 |         -------\n1378 |         matplotlib.axes.Axes or numpy.ndarray of them\n1379 | \n1380 |         See Also\n1381 |         --------\n1382 |         scipy.stats.gaussian_kde : Representation of a kernel-density\n1383 |             estimate using Gaussian kernels. This is the function used\n1384 |             internally to estimate the PDF.\n1385 | \n1386 |         Examples\n1387 |         --------\n1388 |         Given a Series of points randomly sampled from an unknown\n1389 |         distribution, estimate its PDF using KDE with automatic\n1390 |         bandwidth determination and plot the results, evaluating them at\n1391 |         1000 equally spaced points (default):\n1392 | \n1393 |         .. plot::\n1394 |             :context: close-figs\n1395 | \n1396 |             >>> s = pd.Series([1, 2, 2.5, 3, 3.5, 4, 5])\n1397 |             >>> ax = s.plot.kde()\n1398 | \n1399 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1400 |         lead to over-fitting, while using a large bandwidth value may result\n1401 |         in under-fitting:\n1402 | \n1403 |         .. plot::\n1404 |             :context: close-figs\n1405 | \n1406 |             >>> ax = s.plot.kde(bw_method=0.3)\n1407 | \n1408 |         .. plot::\n1409 |             :context: close-figs\n1410 | \n1411 |             >>> ax = s.plot.kde(bw_method=3)\n1412 | \n1413 |         Finally, the `ind` parameter determines the evaluation points for the\n1414 |         plot of the estimated PDF:\n1415 | \n1416 |         .. plot::\n1417 |             :context: close-figs\n1418 | \n1419 |             >>> ax = s.plot.kde(ind=[1, 2, 3, 4, 5])\n1420 | \n1421 |         For DataFrame, it works in the same way:\n1422 | \n1423 |         .. plot::\n1424 |             :context: close-figs\n1425 | \n1426 |             >>> df = pd.DataFrame({\n1427 |             ...     'x': [1, 2, 2.5, 3, 3.5, 4, 5],\n1428 |             ...     'y': [4, 4, 4.5, 5, 5.5, 6, 6],\n1429 |             ... })\n1430 |             >>> ax = df.plot.kde()\n1431 | \n1432 |         A scalar bandwidth can be specified. Using a small bandwidth value can\n1433 |         lead to over-fitting, while using a large bandwidth value may result\n1434 |         in under-fitting:\n1435 | \n1436 |         .. plot::\n1437 |             :context: close-figs\n1438 | \n1439 |             >>> ax = df.plot.kde(bw_method=0.3)\n1440 | \n1441 |         .. plot::\n1442 |             :context: close-figs\n1443 | \n1444 |             >>> ax = df.plot.kde(bw_method=3)\n1445 | \n1446 |         Finally, the `ind` parameter determines the evaluation points for the\n1447 |         plot of the estimated PDF:\n1448 | \n1449 |         .. plot::\n1450 |             :context: close-figs\n1451 | \n1452 |             >>> ax = df.plot.kde(ind=[1, 2, 3, 4, 5, 6])\n1453 |         \"\"\"\n1454 |         return self(kind=\"kde\", bw_method=bw_method, ind=ind, **kwargs)\n1455 | \n1456 |     density = kde\n1457 | \n1458 |     def area(self, x=None, y=None, **kwargs):\n1459 |         \"\"\"\n1460 |         Draw a stacked area plot.\n1461 | \n1462 |         An area plot displays quantitative data visually.\n1463 |         This function wraps the matplotlib area function.\n1464 | \n1465 |         Parameters\n1466 |         ----------\n1467 |         x : label or position, optional\n1468 |             Coordinates for the X axis. By default uses the index.\n1469 |         y : label or position, optional\n1470 |             Column to plot. By default uses all columns.\n1471 |         stacked : bool, default True\n1472 |             Area plots are stacked by default. Set to False to create a\n1473 |             unstacked plot.\n1474 |         **kwargs\n1475 |             Additional keyword arguments are documented in\n1476 |             :meth:`DataFrame.plot`.\n1477 | \n1478 |         Returns\n1479 |         -------\n1480 |         matplotlib.axes.Axes or numpy.ndarray\n1481 |             Area plot, or array of area plots if subplots is True.\n1482 | \n1483 |         See Also\n1484 |         --------\n1485 |         DataFrame.plot : Make plots of DataFrame using matplotlib / pylab.\n1486 | \n1487 |         Examples\n1488 |         --------\n1489 |         Draw an area plot based on basic business metrics:\n1490 | \n1491 |         .. plot::\n1492 |             :context: close-figs\n1493 | \n1494 |             >>> df = pd.DataFrame({\n1495 |             ...     'sales': [3, 2, 3, 9, 10, 6],\n1496 |             ...     'signups': [5, 5, 6, 12, 14, 13],\n1497 |             ...     'visits': [20, 42, 28, 62, 81, 50],\n1498 |             ... }, index=pd.date_range(start='2018/01/01', end='2018/07/01',\n1499 |             ...                        freq='M'))\n1500 |             >>> ax = df.plot.area()\n1501 | \n1502 |         Area plots are stacked by default. To produce an unstacked plot,\n1503 |         pass ``stacked=False``:\n1504 | \n1505 |         .. plot::\n1506 |             :context: close-figs\n1507 | \n1508 |             >>> ax = df.plot.area(stacked=False)\n1509 | \n1510 |         Draw an area plot for a single column:\n1511 | \n1512 |         .. plot::\n1513 |             :context: close-figs\n1514 | \n1515 |             >>> ax = df.plot.area(y='sales')\n1516 | \n1517 |         Draw with a different `x`:\n1518 | \n1519 |         .. plot::\n1520 |             :context: close-figs\n1521 | \n1522 |             >>> df = pd.DataFrame({\n1523 |             ...     'sales': [3, 2, 3],\n1524 |             ...     'visits': [20, 42, 28],\n1525 |             ...     'day': [1, 2, 3],\n1526 |             ... })\n1527 |             >>> ax = df.plot.area(x='day')\n1528 |         \"\"\"\n1529 |         return self(kind=\"area\", x=x, y=y, **kwargs)\n1530 | \n1531 |     def pie(self, **kwargs):\n1532 |         \"\"\"\n1533 |         Generate a pie plot.\n1534 | \n1535 |         A pie plot is a proportional representation of the numerical data in a\n1536 |         column. This function wraps :meth:`matplotlib.pyplot.pie` for the\n1537 |         specified column. If no column reference is passed and\n1538 |         ``subplots=True`` a pie plot is drawn for each numerical column\n1539 |         independently.\n1540 | \n1541 |         Parameters\n1542 |         ----------\n1543 |         y : int or label, optional\n1544 |             Label or position of the column to plot.\n1545 |             If not provided, ``subplots=True`` argument must be passed.\n1546 |         **kwargs\n1547 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1548 | \n1549 |         Returns\n1550 |         -------\n1551 |         matplotlib.axes.Axes or np.ndarray of them\n1552 |             A NumPy array is returned when `subplots` is True.\n1553 | \n1554 |         See Also\n1555 |         --------\n1556 |         Series.plot.pie : Generate a pie plot for a Series.\n1557 |         DataFrame.plot : Make plots of a DataFrame.\n1558 | \n1559 |         Examples\n1560 |         --------\n1561 |         In the example below we have a DataFrame with the information about\n1562 |         planet's mass and radius. We pass the 'mass' column to the\n1563 |         pie function to get a pie plot.\n1564 | \n1565 |         .. plot::\n1566 |             :context: close-figs\n1567 | \n1568 |             >>> df = pd.DataFrame({'mass': [0.330, 4.87 , 5.97],\n1569 |             ...                    'radius': [2439.7, 6051.8, 6378.1]},\n1570 |             ...                   index=['Mercury', 'Venus', 'Earth'])\n1571 |             >>> plot = df.plot.pie(y='mass', figsize=(5, 5))\n1572 | \n1573 |         .. plot::\n1574 |             :context: close-figs\n1575 | \n1576 |             >>> plot = df.plot.pie(subplots=True, figsize=(11, 6))\n1577 |         \"\"\"\n1578 |         if (\n1579 |             isinstance(self._parent, ABCDataFrame)\n1580 |             and kwargs.get(\"y\", None) is None\n1581 |             and not kwargs.get(\"subplots\", False)\n1582 |         ):\n1583 |             raise ValueError(\"pie requires either y column or 'subplots=True'\")\n1584 |         return self(kind=\"pie\", **kwargs)\n1585 | \n1586 |     def scatter(self, x, y, s=None, c=None, **kwargs):\n1587 |         \"\"\"\n1588 |         Create a scatter plot with varying marker point size and color.\n1589 | \n1590 |         The coordinates of each point are defined by two dataframe columns and\n1591 |         filled circles are used to represent each point. This kind of plot is\n1592 |         useful to see complex correlations between two variables. Points could\n1593 |         be for instance natural 2D coordinates like longitude and latitude in\n1594 |         a map or, in general, any pair of metrics that can be plotted against\n1595 |         each other.\n1596 | \n1597 |         Parameters\n1598 |         ----------\n1599 |         x : int or str\n1600 |             The column name or column position to be used as horizontal\n1601 |             coordinates for each point.\n1602 |         y : int or str\n1603 |             The column name or column position to be used as vertical\n1604 |             coordinates for each point.\n1605 |         s : str, scalar or array-like, optional\n1606 |             The size of each point. Possible values are:\n1607 | \n1608 |             - A string with the name of the column to be used for marker's size.\n1609 | \n1610 |             - A single scalar so all points have the same size.\n1611 | \n1612 |             - A sequence of scalars, which will be used for each point's size\n1613 |               recursively. For instance, when passing [2,14] all points size\n1614 |               will be either 2 or 14, alternatively.\n1615 | \n1616 |               .. versionchanged:: 1.1.0\n1617 | \n1618 |         size : str, scalar or array-like, optional\n1619 |             Alias for s.\n1620 | \n1621 |             .. versionadded:: 1.5.0\n1622 | \n1623 |         c : str, int or array-like, optional\n1624 |             The color of each point. Possible values are:\n1625 | \n1626 |             - A single color string referred to by name, RGB or RGBA code,\n1627 |               for instance 'red' or '#a98d19'.\n1628 | \n1629 |             - A sequence of color strings referred to by name, RGB or RGBA\n1630 |               code, which will be used for each point's color recursively. For\n1631 |               instance ['green','yellow'] all points will be filled in green or\n1632 |               yellow, alternatively.\n1633 | \n1634 |             - A column name or position whose values will be used to color the\n1635 |               marker points according to a colormap.\n1636 |         color : str, int or array-like, optional\n1637 |             Alias for c.\n1638 | \n1639 |             .. versionadded:: 1.5.0\n1640 | \n1641 |         **kwargs\n1642 |             Keyword arguments to pass on to :meth:`DataFrame.plot`.\n1643 | \n1644 |         Returns\n1645 |         -------\n1646 |         :class:`matplotlib.axes.Axes` or numpy.ndarray of them\n1647 | \n1648 |         See Also\n1649 |         --------\n1650 |         matplotlib.pyplot.scatter : Scatter plot using multiple input data\n1651 |             formats.\n1652 | \n1653 |         Examples\n1654 |         --------\n1655 |         Let's see how to draw a scatter plot using coordinates from the values\n1656 |         in a DataFrame's columns.\n1657 | \n1658 |         .. plot::\n1659 |             :context: close-figs\n1660 | \n1661 |             >>> df = pd.DataFrame([[5.1, 3.5, 0], [4.9, 3.0, 0], [7.0, 3.2, 1],\n1662 |             ...                    [6.4, 3.2, 1], [5.9, 3.0, 2]],\n1663 |             ...                   columns=['length', 'width', 'species'])\n1664 |             >>> ax1 = df.plot.scatter(x='length',\n1665 |             ...                       y='width',\n1666 |             ...                       c='DarkBlue')\n1667 | \n1668 |         And now with the color determined by a column as well.\n1669 | \n1670 |         .. plot::\n1671 |             :context: close-figs\n1672 | \n1673 |             >>> ax2 = df.plot.scatter(x='length',\n1674 |             ...                       y='width',\n1675 |             ...                       c='species',\n1676 |             ...                       colormap='viridis')\n1677 |         \"\"\"\n1678 |         size = kwargs.pop(\"size\", None)\n1679 |         if s is not None and size is not None:\n1680 |             raise TypeError(\"Specify exactly one of `s` and `size`\")\n1681 |         elif s is not None or size is not None:\n1682 |             kwargs[\"s\"] = s if s is not None else size\n1683 | \n1684 |         color = kwargs.pop(\"color\", None)\n1685 |         if c is not None and color is not None:\n1686 |             raise TypeError(\"Specify exactly one of `c` and `color`\")\n1687 |         elif c is not None or color is not None:\n1688 |             kwargs[\"c\"] = c if c is not None else color\n1689 | \n1690 |         return self(kind=\"scatter\", x=x, y=y, **kwargs)\n1691 | \n1692 |     def hexbin(self, x, y, C=None, reduce_C_function=None, gridsize=None, **kwargs):\n1693 |         \"\"\"\n1694 |         Generate a hexagonal binning plot.\n1695 | \n1696 |         Generate a hexagonal binning plot of `x` versus `y`. If `C` is `None`\n1697 |         (the default), this is a histogram of the number of occurrences\n1698 |         of the observations at ``(x[i], y[i])``.\n1699 | \n1700 |         If `C` is specified, specifies values at given coordinates\n1701 |         ``(x[i], y[i])``. These values are accumulated for each hexagonal\n1702 |         bin and then reduced according to `reduce_C_function`,\n1703 |         having as default the NumPy's mean function (:meth:`numpy.mean`).\n1704 |         (If `C` is specified, it must also be a 1-D sequence\n1705 |         of the same length as `x` and `y`, or a column label.)\n1706 | \n1707 |         Parameters\n1708 |         ----------\n1709 |         x : int or str\n1710 |             The column label or position for x points.\n1711 |         y : int or str\n1712 |             The column label or position for y points.\n1713 |         C : int or str, optional\n1714 |             The column label or position for the value of `(x, y)` point.\n1715 |         reduce_C_function : callable, default `np.mean`\n1716 |             Function of one argument that reduces all the values in a bin to\n1717 |             a single number (e.g. `np.mean`, `np.max`, `np.sum`, `np.std`).\n1718 |         gridsize : int or tuple of (int, int), default 100\n1719 |             The number of hexagons in the x-direction.\n1720 |             The corresponding number of hexagons in the y-direction is\n1721 |             chosen in a way that the hexagons are approximately regular.\n1722 |             Alternatively, gridsize can be a tuple with two elements\n1723 |             specifying the number of hexagons in the x-direction and the\n1724 |             y-direction.\n1725 |         **kwargs\n1726 |             Additional keyword arguments are documented in\n1727 |             :meth:`DataFrame.plot`.\n1728 | \n1729 |         Returns\n1730 |         -------\n1731 |         matplotlib.AxesSubplot\n1732 |             The matplotlib ``Axes`` on which the hexbin is plotted.\n1733 | \n1734 |         See Also\n1735 |         --------\n1736 |         DataFrame.plot : Make plots of a DataFrame.\n1737 |         matplotlib.pyplot.hexbin : Hexagonal binning plot using matplotlib,\n1738 |             the matplotlib function that is used under the hood.\n1739 | \n1740 |         Examples\n1741 |         --------\n1742 |         The following examples are generated with random data from\n1743 |         a normal distribution.\n1744 | \n1745 |         .. plot::\n1746 |             :context: close-figs\n1747 | \n1748 |             >>> n = 10000\n1749 |             >>> df = pd.DataFrame({'x': np.random.randn(n),\n1750 |             ...                    'y': np.random.randn(n)})\n1751 |             >>> ax = df.plot.hexbin(x='x', y='y', gridsize=20)\n1752 | \n1753 |         The next example uses `C` and `np.sum` as `reduce_C_function`.\n1754 |         Note that `'observations'` values ranges from 1 to 5 but the result\n1755 |         plot shows values up to more than 25. This is because of the\n1756 |         `reduce_C_function`.\n1757 | \n1758 |         .. plot::\n1759 |             :context: close-figs\n1760 | \n1761 |             >>> n = 500\n1762 |             >>> df = pd.DataFrame({\n1763 |             ...     'coord_x': np.random.uniform(-3, 3, size=n),\n1764 |             ...     'coord_y': np.random.uniform(30, 50, size=n),\n1765 |             ...     'observations': np.random.randint(1,5, size=n)\n1766 |             ...     })\n1767 |             >>> ax = df.plot.hexbin(x='coord_x',\n1768 |             ...                     y='coord_y',\n1769 |             ...                     C='observations',\n1770 |             ...                     reduce_C_function=np.sum,\n1771 |             ...                     gridsize=10,\n1772 |             ...                     cmap=\"viridis\")\n1773 |         \"\"\"\n1774 |         if reduce_C_function is not None:\n1775 |             kwargs[\"reduce_C_function\"] = reduce_C_function\n1776 |         if gridsize is not None:\n1777 |             kwargs[\"gridsize\"] = gridsize\n1778 | \n1779 |         return self(kind=\"hexbin\", x=x, y=y, C=C, **kwargs)\n```\n"}, {"content": "Let me analyze the feature request and locate the relevant code areas:\n\n## Step 1: Categorizing and Extracting Key Information\n\nThe feature request is about enhancing the DataFrame.plot() method to allow grouping multiple columns on the same subplot. Key Terms:\n- DataFrame.plot()\n- subplots parameter\n- visualization\n- grouping columns\n\nLet me explore the code structure to locate relevant files and 