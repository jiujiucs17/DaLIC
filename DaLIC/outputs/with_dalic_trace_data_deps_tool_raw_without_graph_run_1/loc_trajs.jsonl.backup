opy=False\n848 |             )\n849 |             X_new.append(X_step)\n850 | \n851 |             data_step = factor_nz * np.sin(j * log_step_nz)\n852 |             X_step = sp.csr_matrix(\n853 |                 (data_step, indices, indptr), shape=X.shape, dtype=X.dtype, copy=False\n854 |             )\n855 |             X_new.append(X_step)\n856 | \n857 |         return sp.hstack(X_new)\n```\n\nFound function `sklearn/random_projection.py:_sparse_random_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n202 | def _sparse_random_matrix(n_components, n_features, density=\"auto\", random_state=None):\n203 |     \"\"\"Generalized Achlioptas random sparse matrix for random projection.\n204 | \n205 |     Setting density to 1 / 3 will yield the original matrix by Dimitris\n206 |     Achlioptas while setting a lower value will yield the generalization\n207 |     by Ping Li et al.\n208 | \n209 |     If we note :math:`s = 1 / density`, the components of the random matrix are\n210 |     drawn from:\n211 | \n212 |       - -sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n213 |       -  0                              with probability 1 - 1 / s\n214 |       - +sqrt(s) / sqrt(n_components)   with probability 1 / 2s\n215 | \n216 |     Read more in the :ref:`User Guide <sparse_random_matrix>`.\n217 | \n218 |     Parameters\n219 |     ----------\n220 |     n_components : int,\n221 |         Dimensionality of the target projection space.\n222 | \n223 |     n_features : int,\n224 |         Dimensionality of the original source space.\n225 | \n226 |     density : float or 'auto', default='auto'\n227 |         Ratio of non-zero component in the random projection matrix in the\n228 |         range `(0, 1]`\n229 | \n230 |         If density = 'auto', the value is set to the minimum density\n231 |         as recommended by Ping Li et al.: 1 / sqrt(n_features).\n232 | \n233 |         Use density = 1 / 3.0 if you want to reproduce the results from\n234 |         Achlioptas, 2001.\n235 | \n236 |     random_state : int, RandomState instance or None, default=None\n237 |         Controls the pseudo random number generator used to generate the matrix\n238 |         at fit time.\n239 |         Pass an int for reproducible output across multiple function calls.\n240 |         See :term:`Glossary <random_state>`.\n241 | \n242 |     Returns\n243 |     -------\n244 |     components : {ndarray, sparse matrix} of shape (n_components, n_features)\n245 |         The generated Gaussian random matrix. Sparse matrix will be of CSR\n246 |         format.\n247 | \n248 |     See Also\n249 |     --------\n250 |     SparseRandomProjection\n251 | \n252 |     References\n253 |     ----------\n254 | \n255 |     .. [1] Ping Li, T. Hastie and K. W. Church, 2006,\n256 |            \"Very Sparse Random Projections\".\n257 |            https://web.stanford.edu/~hastie/Papers/Ping/KDD06_rp.pdf\n258 | \n259 |     .. [2] D. Achlioptas, 2001, \"Database-friendly random projections\",\n260 |            https://cgi.di.uoa.gr/~optas/papers/jl.pdf\n261 | \n262 |     \"\"\"\n263 |     _check_input_size(n_components, n_features)\n264 |     density = _check_density(density, n_features)\n265 |     rng = check_random_state(random_state)\n266 | \n267 |     if density == 1:\n268 |         # skip index generation if totally dense\n269 |         components = rng.binomial(1, 0.5, (n_components, n_features)) * 2 - 1\n270 |         return 1 / np.sqrt(n_components) * components\n271 | \n272 |     else:\n273 |         # Generate location of non zero elements\n274 |         indices = []\n275 |         offset = 0\n276 |         indptr = [offset]\n277 |         for _ in range(n_components):\n278 |             # find the indices of the non-zero components for row i\n279 |             n_nonzero_i = rng.binomial(n_features, density)\n280 |             indices_i = sample_without_replacement(\n281 |                 n_features, n_nonzero_i, random_state=rng\n282 |             )\n283 |             indices.append(indices_i)\n284 |             offset += n_nonzero_i\n285 |             indptr.append(offset)\n286 | \n287 |         indices = np.concatenate(indices)\n288 | \n289 |         # Among non zero components the probability of the sign is 50%/50%\n290 |         data = rng.binomial(1, 0.5, size=np.size(indices)) * 2 - 1\n291 | \n292 |         # build the CSR structure by concatenating the rows\n293 |         components = sp.csr_matrix(\n294 |             (data, indices, indptr), shape=(n_components, n_features)\n295 |         )\n296 | \n297 |         return np.sqrt(1 / density) / np.sqrt(n_components) * components\n```\n\nFound function `sklearn/preprocessing/_label.py:LabelBinarizer.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n271 | def fit(self, y):\n272 |         \"\"\"Fit label binarizer.\n273 | \n274 |         Parameters\n275 |         ----------\n276 |         y : ndarray of shape (n_samples,) or (n_samples, n_classes)\n277 |             Target values. The 2-d matrix should only contain 0 and 1,\n278 |             represents multilabel classification.\n279 | \n280 |         Returns\n281 |         -------\n282 |         self : object\n283 |             Returns the instance itself.\n284 |         \"\"\"\n285 | \n286 |         self._validate_params()\n287 | \n288 |         if self.neg_label >= self.pos_label:\n289 |             raise ValueError(\n290 |                 f\"neg_label={self.neg_label} must be strictly less than \"\n291 |                 f\"pos_label={self.pos_label}.\"\n292 |             )\n293 | \n294 |         if self.sparse_output and (self.pos_label == 0 or self.neg_label != 0):\n295 |             raise ValueError(\n296 |                 \"Sparse binarization is only supported with non \"\n297 |                 \"zero pos_label and zero neg_label, got \"\n298 |                 f\"pos_label={self.pos_label} and neg_label={self.neg_label}\"\n299 |             )\n300 | \n301 |         self.y_type_ = type_of_target(y, input_name=\"y\")\n302 | \n303 |         if \"multioutput\" in self.y_type_:\n304 |             raise ValueError(\n305 |                 \"Multioutput target data is not supported with label binarization\"\n306 |             )\n307 |         if _num_samples(y) == 0:\n308 |             raise ValueError(\"y has 0 samples: %r\" % y)\n309 | \n310 |         self.sparse_input_ = sp.issparse(y)\n311 |         self.classes_ = unique_labels(y)\n312 |         return self\n```\n\nFound function `sklearn/preprocessing/_label.py:MultiLabelBinarizer.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n764 | def fit(self, y):\n765 |         \"\"\"Fit the label sets binarizer, storing :term:`classes_`.\n766 | \n767 |         Parameters\n768 |         ----------\n769 |         y : iterable of iterables\n770 |             A set of labels (any orderable and hashable object) for each\n771 |             sample. If the `classes` parameter is set, `y` will not be\n772 |             iterated.\n773 | \n774 |         Returns\n775 |         -------\n776 |         self : object\n777 |             Fitted estimator.\n778 |         \"\"\"\n779 |         self._validate_params()\n780 |         self._cached_dict = None\n781 | \n782 |         if self.classes is None:\n783 |             classes = sorted(set(itertools.chain.from_iterable(y)))\n784 |         elif len(set(self.classes)) < len(self.classes):\n785 |             raise ValueError(\n786 |                 \"The classes argument contains duplicate \"\n787 |                 \"classes. Remove these duplicates before passing \"\n788 |                 \"them to MultiLabelBinarizer.\"\n789 |             )\n790 |         else:\n791 |             classes = self.classes\n792 |         dtype = int if all(isinstance(c, int) for c in classes) else object\n793 |         self.classes_ = np.empty(len(classes), dtype=dtype)\n794 |         self.classes_[:] = classes\n795 |         return self\n```\n\n\n\n##Searching for term \"spmatrix toarray sparse_output\"...\n### Search Result:\nFound function `sklearn/preprocessing/_label.py:label_binarize`.\nSource: Retrieved code content using keyword search (bm25).\n```\n434 | def label_binarize(y, *, classes, neg_label=0, pos_label=1, sparse_output=False):\n435 |     \"\"\"Binarize labels in a one-vs-all fashion.\n436 | \n437 |     Several regression and binary classification algorithms are\n438 |     available in scikit-learn. A simple way to extend these algorithms\n439 |     to the multi-class classification case is to use the so-called\n440 |     one-vs-all scheme.\n441 | \n442 |     This function makes it possible to compute this transformation for a\n443 |     fixed set of class labels known ahead of time.\n444 | \n445 |     Parameters\n446 |     ----------\n447 |     y : array-like\n448 |         Sequence of integer labels or multilabel data to encode.\n449 | \n450 |     classes : array-like of shape (n_classes,)\n451 |         Uniquely holds the label for each class.\n452 | \n453 |     neg_label : int, default=0\n454 |         Value with which negative labels must be encoded.\n455 | \n456 |     pos_label : int, default=1\n457 |         Value with which positive labels must be encoded.\n458 | \n459 |     sparse_output : bool, default=False,\n460 |         Set to true if output binary array is desired in CSR sparse format.\n461 | \n462 |     Returns\n463 |     -------\n464 |     Y : {ndarray, sparse matrix} of shape (n_samples, n_classes)\n465 |         Shape will be (n_samples, 1) for binary problems. Sparse matrix will\n466 |         be of CSR format.\n467 | \n468 |     See Also\n469 |     --------\n470 |     LabelBinarizer : Class used to wrap the functionality of label_binarize and\n471 |         allow for fitting to classes independently of the transform operation.\n472 | \n473 |     Examples\n474 |     --------\n475 |     >>> from sklearn.preprocessing import label_binarize\n476 |     >>> label_binarize([1, 6], classes=[1, 2, 4, 6])\n477 |     array([[1, 0, 0, 0],\n478 |            [0, 0, 0, 1]])\n479 | \n480 |     The class ordering is preserved:\n481 | \n482 |     >>> label_binarize([1, 6], classes=[1, 6, 4, 2])\n483 |     array([[1, 0, 0, 0],\n484 |            [0, 1, 0, 0]])\n485 | \n486 |     Binary targets transform to a column vector\n487 | \n488 |     >>> label_binarize(['yes', 'no', 'no', 'yes'], classes=['no', 'yes'])\n489 |     array([[1],\n490 |            [0],\n491 |            [0],\n492 |            [1]])\n493 |     \"\"\"\n494 |     if not isinstance(y, list):\n495 |         # XXX Workaround that will be removed when list of list format is\n496 |         # dropped\n497 |         y = check_array(\n498 |             y, input_name=\"y\", accept_sparse=\"csr\", ensure_2d=False, dtype=None\n499 |         )\n500 |     else:\n501 |         if _num_samples(y) == 0:\n502 |             raise ValueError(\"y has 0 samples: %r\" % y)\n503 |     if neg_label >= pos_label:\n504 |         raise ValueError(\n505 |             \"neg_label={0} must be strictly less than pos_label={1}.\".format(\n506 |                 neg_label, pos_label\n507 |             )\n508 |         )\n509 | \n510 |     if sparse_output and (pos_label == 0 or neg_label != 0):\n511 |         raise ValueError(\n512 |             \"Sparse binarization is only supported with non \"\n513 |             \"zero pos_label and zero neg_label, got \"\n514 |             \"pos_label={0} and neg_label={1}\"\n515 |             \"\".format(pos_label, neg_label)\n516 |         )\n517 | \n518 |     # To account for pos_label == 0 in the dense case\n519 |     pos_switch = pos_label == 0\n520 |     if pos_switch:\n521 |         pos_label = -neg_label\n522 | \n523 |     y_type = type_of_target(y)\n524 |     if \"multioutput\" in y_type:\n525 |         raise ValueError(\n526 |             \"Multioutput target data is not supported with label binarization\"\n527 |         )\n528 |     if y_type == \"unknown\":\n529 |         raise ValueError(\"The type of target data is not known\")\n530 | \n531 |     n_samples = y.shape[0] if sp.issparse(y) else len(y)\n532 |     n_classes = len(classes)\n533 |     classes = np.asarray(classes)\n534 | \n535 |     if y_type == \"binary\":\n536 |         if n_classes == 1:\n537 |             if sparse_output:\n538 |                 return sp.csr_matrix((n_samples, 1), dtype=int)\n539 |             else:\n540 |                 Y = np.zeros((len(y), 1), dtype=int)\n541 |                 Y += neg_label\n542 |                 return Y\n543 |         elif len(classes) >= 3:\n544 |             y_type = \"multiclass\"\n545 | \n546 |     sorted_class = np.sort(classes)\n547 |     if y_type == \"multilabel-indicator\":\n548 |         y_n_classes = y.shape[1] if hasattr(y, \"shape\") else len(y[0])\n549 |         if classes.size != y_n_classes:\n550 |             raise ValueError(\n551 |                 \"classes {0} mismatch with the labels {1} found in the data\".format(\n552 |                     classes, unique_labels(y)\n553 |                 )\n554 |             )\n555 | \n556 |     if y_type in (\"binary\", \"multiclass\"):\n557 |         y = column_or_1d(y)\n558 | \n559 |         # pick out the known labels from y\n560 |         y_in_classes = np.in1d(y, classes)\n561 |         y_seen = y[y_in_classes]\n562 |         indices = np.searchsorted(sorted_class, y_seen)\n563 |         indptr = np.hstack((0, np.cumsum(y_in_classes)))\n564 | \n565 |         data = np.empty_like(indices)\n566 |         data.fill(pos_label)\n567 |         Y = sp.csr_matrix((data, indices, indptr), shape=(n_samples, n_classes))\n568 |     elif y_type == \"multilabel-indicator\":\n569 |         Y = sp.csr_matrix(y)\n570 |         if pos_label != 1:\n571 |             data = np.empty_like(Y.data)\n572 |             data.fill(pos_label)\n573 |             Y.data = data\n574 |     else:\n575 |         raise ValueError(\n576 |             \"%s target data is not supported with label binarization\" % y_type\n577 |         )\n578 | \n579 |     if not sparse_output:\n580 |         Y = Y.toarray()\n581 |         Y = Y.astype(int, copy=False)\n582 | \n583 |         if neg_label != 0:\n584 |             Y[Y == 0] = neg_label\n585 | \n586 |         if pos_switch:\n587 |             Y[Y == pos_label] = 0\n588 |     else:\n589 |         Y.data = Y.data.astype(int, copy=False)\n590 | \n591 |     # preserve label ordering\n592 |     if np.any(classes != sorted_class):\n593 |         indices = np.searchsorted(sorted_class, classes)\n594 |         Y = Y[:, indices]\n595 | \n596 |     if y_type == \"binary\":\n597 |         if sparse_output:\n598 |             Y = Y.getcol(-1)\n599 |         else:\n600 |             Y = Y[:, -1].reshape((-1, 1))\n601 | \n602 |     return Y\n```\n\nFound function `sklearn/utils/_set_output.py:_wrap_method_output`.\nSource: Retrieved entity using keyword search (bm25).\n```\n135 | def _wrap_method_output(f, method):\n136 |     \"\"\"Wrapper used by `_SetOutputMixin` to automatically wrap methods.\"\"\"\n137 | \n138 |     @wraps(f)\n139 |     def wrapped(self, X, *args, **kwargs):\n140 |         data_to_wrap = f(self, X, *args, **kwargs)\n141 |         if isinstance(data_to_wrap, tuple):\n142 |             # only wrap the first output for cross decomposition\n143 |             return_tuple = (\n144 |                 _wrap_data_with_container(method, data_to_wrap[0], X, self),\n145 |                 *data_to_wrap[1:],\n146 |             )\n147 |             # Support for namedtuples `_make` is a documented API for namedtuples:\n148 |             # https://docs.python.org/3/library/collections.html#collections.somenamedtuple._make\n149 |             if hasattr(type(data_to_wrap), \"_make\"):\n150 |                 return type(data_to_wrap)._make(return_tuple)\n151 |             return return_tuple\n152 | \n153 |         return _wrap_data_with_container(method, data_to_wrap, X, self)\n154 | \n155 |     return wrapped\n```\n\nFound function `sklearn/utils/_se