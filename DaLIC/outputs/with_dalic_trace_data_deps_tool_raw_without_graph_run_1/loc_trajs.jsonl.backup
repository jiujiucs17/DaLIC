hunks of 10k for efficiency\n 681 |             data = self.asi8\n 682 |             length = len(self)\n 683 |             chunksize = _ITER_CHUNKSIZE\n 684 |             chunks = (length // chunksize) + 1\n 685 | \n 686 |             for i in range(chunks):\n 687 |                 start_i = i * chunksize\n 688 |                 end_i = min((i + 1) * chunksize, length)\n 689 |                 converted = ints_to_pydatetime(\n 690 |                     data[start_i:end_i],\n 691 |                     tz=self.tz,\n 692 |                     box=\"timestamp\",\n 693 |                     reso=self._creso,\n 694 |                 )\n 695 |                 yield from converted\n 696 | \n 697 |     def astype(self, dtype, copy: bool = True):\n 698 |         # We handle\n 699 |         #   --> datetime\n 700 |         #   --> period\n 701 |         # DatetimeLikeArrayMixin Super handles the rest.\n 702 |         dtype = pandas_dtype(dtype)\n 703 | \n 704 |         if dtype == self.dtype:\n 705 |             if copy:\n 706 |                 return self.copy()\n 707 |             return self\n 708 | \n 709 |         elif isinstance(dtype, ExtensionDtype):\n 710 |             if not isinstance(dtype, DatetimeTZDtype):\n 711 |                 # e.g. Sparse[datetime64[ns]]\n 712 |                 return super().astype(dtype, copy=copy)\n 713 |             elif self.tz is None:\n 714 |                 # pre-2.0 this did self.tz_localize(dtype.tz), which did not match\n 715 |                 #  the Series behavior which did\n 716 |                 #  values.tz_localize(\"UTC\").tz_convert(dtype.tz)\n 717 |                 raise TypeError(\n 718 |                     \"Cannot use .astype to convert from timezone-naive dtype to \"\n 719 |                     \"timezone-aware dtype. Use obj.tz_localize instead or \"\n 720 |                     \"series.dt.tz_localize instead\"\n 721 |                 )\n 722 |             else:\n 723 |                 # tzaware unit conversion e.g. datetime64[s, UTC]\n 724 |                 np_dtype = np.dtype(dtype.str)\n 725 |                 res_values = astype_overflowsafe(self._ndarray, np_dtype, copy=copy)\n 726 |                 return type(self)._simple_new(res_values, dtype=dtype, freq=self.freq)\n 727 | \n 728 |         elif (\n 729 |             self.tz is None\n 730 |             and lib.is_np_dtype(dtype, \"M\")\n 731 |             and not is_unitless(dtype)\n 732 |             and is_supported_dtype(dtype)\n 733 |         ):\n 734 |             # unit conversion e.g. datetime64[s]\n 735 |             res_values = astype_overflowsafe(self._ndarray, dtype, copy=True)\n 736 |             return type(self)._simple_new(res_values, dtype=res_values.dtype)\n 737 |             # TODO: preserve freq?\n 738 | \n 739 |         elif self.tz is not None and lib.is_np_dtype(dtype, \"M\"):\n 740 |             # pre-2.0 behavior for DTA/DTI was\n 741 |             #  values.tz_convert(\"UTC\").tz_localize(None), which did not match\n 742 |             #  the Series behavior\n 743 |             raise TypeError(\n 744 |                 \"Cannot use .astype to convert from timezone-aware dtype to \"\n 745 |                 \"timezone-naive dtype. Use obj.tz_localize(None) or \"\n 746 |                 \"obj.tz_convert('UTC').tz_localize(None) instead.\"\n 747 |             )\n 748 | \n 749 |         elif (\n 750 |             self.tz is None\n 751 |             and lib.is_np_dtype(dtype, \"M\")\n 752 |             and dtype != self.dtype\n 753 |             and is_unitless(dtype)\n 754 |         ):\n 755 |             raise TypeError(\n 756 |                 \"Casting to unit-less dtype 'datetime64' is not supported. \"\n 757 |                 \"Pass e.g. 'datetime64[ns]' instead.\"\n 758 |             )\n 759 | \n 760 |         elif isinstance(dtype, PeriodDtype):\n 761 |             return self.to_period(freq=dtype.freq)\n 762 |         return dtl.DatetimeLikeArrayMixin.astype(self, dtype, copy)\n 763 | \n 764 |     # -----------------------------------------------------------------\n 765 |     # Rendering Methods\n 766 | \n 767 |     def _format_native_types(\n 768 |         self, *, na_rep: str | float = \"NaT\", date_format=None, **kwargs\n 769 |     ) -> npt.NDArray[np.object_]:\n 770 |         if date_format is None and self._is_dates_only:\n 771 |             # Only dates and no timezone: provide a default format\n 772 |             date_format = \"%Y-%m-%d\"\n 773 | \n 774 |         return tslib.format_array_from_datetime(\n 775 |             self.asi8, tz=self.tz, format=date_format, na_rep=na_rep, reso=self._creso\n 776 |         )\n 777 | \n 778 |     # -----------------------------------------------------------------\n 779 |     # Comparison Methods\n 780 | \n 781 |     def _assert_tzawareness_compat(self, other) -> None:\n 782 |         # adapted from _Timestamp._assert_tzawareness_compat\n 783 |         other_tz = getattr(other, \"tzinfo\", None)\n 784 |         other_dtype = getattr(other, \"dtype\", None)\n 785 | \n 786 |         if isinstance(other_dtype, DatetimeTZDtype):\n 787 |             # Get tzinfo from Series dtype\n 788 |             other_tz = other.dtype.tz\n 789 |         if other is NaT:\n 790 |             # pd.NaT quacks both aware and naive\n 791 |             pass\n 792 |         elif self.tz is None:\n 793 |             if other_tz is not None:\n 794 |                 raise TypeError(\n 795 |                     \"Cannot compare tz-naive and tz-aware datetime-like objects.\"\n 796 |                 )\n 797 |         elif other_tz is None:\n 798 |             raise TypeError(\n 799 |                 \"Cannot compare tz-naive and tz-aware datetime-like objects\"\n 800 |             )\n 801 | \n 802 |     # -----------------------------------------------------------------\n 803 |     # Arithmetic Methods\n 804 | \n 805 |     def _add_offset(self, offset: BaseOffset) -> Self:\n 806 |         assert not isinstance(offset, Tick)\n 807 | \n 808 |         if self.tz is not None:\n 809 |             values = self.tz_localize(None)\n 810 |         else:\n 811 |             values = self\n 812 | \n 813 |         try:\n 814 |             res_values = offset._apply_array(values._ndarray)\n 815 |             if res_values.dtype.kind == \"i\":\n 816 |                 # error: Argument 1 to \"view\" of \"ndarray\" has incompatible type\n 817 |                 # \"dtype[datetime64] | DatetimeTZDtype\"; expected\n 818 |                 # \"dtype[Any] | type[Any] | _SupportsDType[dtype[Any]]\"\n 819 |                 res_values = res_values.view(values.dtype)  # type: ignore[arg-type]\n 820 |         except NotImplementedError:\n 821 |             if get_option(\"performance_warnings\"):\n 822 |                 warnings.warn(\n 823 |                     \"Non-vectorized DateOffset being applied to Series or \"\n 824 |                     \"DatetimeIndex.\",\n 825 |                     PerformanceWarning,\n 826 |                     stacklevel=find_stack_level(),\n 827 |                 )\n 828 |             res_values = self.astype(\"O\") + offset\n 829 |             result = type(self)._from_sequence(res_values, dtype=self.dtype)\n 830 | \n 831 |         else:\n 832 |             result = type(self)._simple_new(res_values, dtype=res_values.dtype)\n 833 |             if offset.normalize:\n 834 |                 result = result.normalize()\n 835 |                 result._freq = None\n 836 | \n 837 |             if self.tz is not None:\n 838 |                 result = result.tz_localize(self.tz)\n 839 | \n 840 |         return result\n 841 | \n 842 |     # -----------------------------------------------------------------\n 843 |     # Timezone Conversion and Localization Methods\n 844 | \n 845 |     def _local_timestamps(self) -> npt.NDArray[np.int64]:\n 846 |         \"\"\"\n 847 |         Convert to an i8 (unix-like nanosecond timestamp) representation\n 848 |         while keeping the local timezone and not using UTC.\n 849 |         This is used to calculate time-of-day information as if the timestamps\n 850 |         were timezone-naive.\n 851 |         \"\"\"\n 852 |         if self.tz is None or timezones.is_utc(self.tz):\n 853 |             # Avoid the copy that would be made in tzconversion\n 854 |             return self.asi8\n 855 |         return tz_convert_from_utc(self.asi8, self.tz, reso=self._creso)\n 856 | \n 857 |     def tz_convert(self, tz) -> Self:\n 858 |         \"\"\"\n 859 |         Convert tz-aware Datetime Array/Index from one time zone to another.\n 860 | \n 861 |         Parameters\n 862 |         ----------\n 863 |         tz : str, zoneinfo.ZoneInfo, pytz.timezone, dateutil.tz.tzfile, datetime.tzinfo or None\n 864 |             Time zone for time. Corresponding timestamps would be converted\n 865 |             to this time zone of the Datetime Array/Index. A `tz` of None will\n 866 |             convert to UTC and remove the timezone information.\n 867 | \n 868 |         Returns\n 869 |         -------\n 870 |         Array or Index\n 871 |             Datetme Array/Index with target `tz`.\n 872 | \n 873 |         Raises\n 874 |         ------\n 875 |         TypeError\n 876 |             If Datetime Array/Index is tz-naive.\n 877 | \n 878 |         See Also\n 879 |         --------\n 880 |         DatetimeIndex.tz : A timezone that has a variable offset from UTC.\n 881 |         DatetimeIndex.tz_localize : Localize tz-naive DatetimeIndex to a\n 882 |             given time zone, or remove timezone from a tz-aware DatetimeIndex.\n 883 | \n 884 |         Examples\n 885 |         --------\n 886 |         With the `tz` parameter, we can change the DatetimeIndex\n 887 |         to other time zones:\n 888 | \n 889 |         >>> dti = pd.date_range(\n 890 |         ...     start=\"2014-08-01 09:00\", freq=\"h\", periods=3, tz=\"Europe/Berlin\"\n 891 |         ... )\n 892 | \n 893 |         >>> dti\n 894 |         DatetimeIndex(['2014-08-01 09:00:00+02:00',\n 895 |                        '2014-08-01 10:00:00+02:00',\n 896 |                        '2014-08-01 11:00:00+02:00'],\n 897 |                       dtype='datetime64[ns, Europe/Berlin]', freq='h')\n 898 | \n 899 |         >>> dti.tz_convert(\"US/Central\")\n 900 |         DatetimeIndex(['2014-08-01 02:00:00-05:00',\n 901 |                        '2014-08-01 03:00:00-05:00',\n 902 |                        '2014-08-01 04:00:00-05:00'],\n 903 |                       dtype='datetime64[ns, US/Central]', freq='h')\n 904 | \n 905 |         With the ``tz=None``, we can remove the timezone (after converting\n 906 |         to UTC if necessary):\n 907 | \n 908 |         >>> dti = pd.date_range(\n 909 |         ...     start=\"2014-08-01 09:00\", freq=\"h\", periods=3, tz=\"Europe/Berlin\"\n 910 |         ... )\n 911 | \n 912 |         >>> dti\n 913 |         DatetimeIndex(['2014-08-01 09:00:00+02:00',\n 914 |                        '2014-08-01 10:00:00+02:00',\n 915 |                        '2014-08-01 11:00:00+02:00'],\n 916 |                         dtype='datetime64[ns, Europe/Berlin]', freq='h')\n 917 | \n 918 |         >>> dti.tz_convert(None)\n 919 |         DatetimeIndex(['2014-08-01 07:00:00',\n 920 |                        '2014-08-01 08:00:00',\n 921 |                        '2014-08-01 09:00:00'],\n 922 |                         dtype='datetime64[ns]', freq='h')\n 923 |         \"\"\"  # noqa: E501\n 924 |         tz = timezones.maybe_get_tz(tz)\n 925 | \n 926 |         if self.tz is None:\n 927 |             # tz naive, use tz_localize\n 928 |             raise TypeError(\n 929 |                 \"Cannot convert tz-naive timestamps, use tz_localize to localize\"\n 930 |             )\n 931 | \n 932 |         # No conversion since timestamps are all UTC to begin with\n 933 |         dtype = tz_to_dtype(tz, unit=self.unit)\n 934 |         return self._simple_new(self._ndarray, dtype=dtype, freq=self.freq)\n 935 | \n 936 |     @dtl.ravel_compat\n 937 |     def tz_localize(\n 938 |         self,\n 939 |         tz,\n 940 |         ambiguous: TimeAmbiguous = \"raise\",\n 941 |         nonexistent: TimeNonexistent = \"raise\",\n 942 |     ) -> Self:\n 943 |         \"\"\"\n 944 |         Localize tz-naive Datetime Array/Index to tz-aware Datetime Array/Index.\n 945 | \n 946 |         This method takes a time zone (tz) naive Datetime Array/Index object\n 947 |         and makes this time zone aware. It does not move the time to another\n 948 |         time zone.\n 949 | \n 950 |         This method can also be used to do the inverse -- to create a time\n 951 |         zone unaware object from an aware object. To that end, pass `tz=None`.\n 952 | \n 953 |         Parameters\n 954 |         ----------\n 955 |         tz : str, zoneinfo.ZoneInfo,, pytz.timezone, dateutil.tz.tzfile, datetime.tzinfo or None\n 956 |             Time zone to convert timestamps to. Passing ``None`` will\n 957 |             remove the time zone information preserving local time.\n 958 |         ambiguous : 'infer', 'NaT', bool array, default 'raise'\n 959 |             When clocks moved backward due to DST, ambiguous times may arise.\n 960 |             For example in Central European Time (UTC+01), when going from\n 961 |             03:00 DST to 02:00 non-DST, 02:30:00 local time occurs both at\n 962 |             00:30:00 UTC and at 01:30:00 UTC. In such a situation, the\n 963 |             `ambiguous` parameter dictates how ambiguous times should be\n 964 |             handled.\n 965 | \n 966 |             - 'infer' will attempt to infer fall dst-transition hours based on\n 967 |               order\n 968 |             - bool-ndarray where True signifies a DST time, False signifies a\n 969 |               non-DST time (note that this flag is only applicable for\n 970 |               ambiguous times)\n 971 |             - 'NaT' will return NaT where there are ambiguous times\n 972 |             - 'raise' will raise a ValueError if there are ambiguous\n 973 |               times.\n 974 | \n 975 |         nonexistent : 'shift_forward', 'shift_backward, 'NaT', timedelta, \\\n 976 | default 'raise'\n 977 |             A nonexistent time does not exist in a particular timezone\n 978 |             where clocks moved forward due to DST.\n 979 | \n 980 |             - 'shift_forward' will shift the nonexistent time forward to the\n 981 |               closest existing time\n 982 |             - 'shift_backward' will shift the nonexistent time backward to the\n 983 |               closest existing time\n 984 |             - 'NaT' will return NaT where there are nonexistent times\n 985 |             - timedelta objects will shift nonexistent times by the timedelta\n 986 |             - 'raise' will raise a ValueError if there are\n 987 |               nonexistent times.\n 988 | \n 989 |         Returns\n 990 |         -------\n 991 |         Same type as self\n 992 |             Array/Index converted to the specified time zone.\n 993 | \n 994 |         Raises\n 995 |         ------\n 996 |         TypeError\n 997 |             If the Datetime Array/Index is tz-aware and tz is not None.\n 998 | \n 999 |         See Also\n1000 |         --------\n1001 |         DatetimeIndex.tz_convert : Convert tz-aware DatetimeIndex from\n1002 |             one time zone to another.\n1003 | \n1004 |         Examples\n1005 |         --------\n1006 |         >>> tz_naive = pd.date_range('2018-03-01 09:00', periods=3)\n1007 |         >>> tz_naive\n1008 |         DatetimeIndex(['2018-03-01 09:00:00', '2018-03-02 09:00:00',\n1009 |                        '2018-03-03 09:00:00'],\n1010 |                       dtype='datetime64[ns]', freq='D')\n1011 | \n1012 |         Localize DatetimeIndex in US/Eastern time zone:\n1013 | \n1014 |         >>> tz_aware = tz_naive.tz_localize(tz='US/Eastern')\n1015 |         >>> tz_aware\n1016 |         DatetimeIndex(['2018-03-01 09:00:00-05:00',\n1017 |                        '2018-03-02 09:00:00-05:00',\n1018 |                        '2018-03-03 09:00:00-05:00'],\n1019 |                       dtype='datetime64[ns, US/Eastern]', freq=None)\n1020 | \n1021 |         With the ``tz=None``, we can remove the time zone information\n1022 |         while keeping the local time (not converted to UTC):\n1023 | \n1024 |         >>> tz_aware.tz_localize(None)\n1025 |         DatetimeIndex(['2018-03-01 09:00:00', '2018-03-02 09:00:00',\n1026 |                        '2018-03-03 09:00:00'],\n1027 |                       dtype='datetime64[ns]', freq=None)\n1028 | \n1029 |         Be careful with DST changes. When there is sequential data, pandas can\n1030 |         infer the DST time:\n1031 | \n1032 |         >>> s = pd.to_datetime(pd.Series(['2018-10-28 01:30:00',\n1033 |         ...                               '2018-10-28 02:00:00',\n1034 |         ...                               '2018-10-28 02:30:00',\n1035 |         ...                               '2018-10-28 02:00:00',\n1036 |         ...                               '2018-10-28 02:30:00',\n1037 |         ...                               '2018-10-28 03:00:00',\n1038 |         ...                               '2018-10-28 03:30:00']))\n1039 |         >>> s.dt.tz_localize('CET', ambiguous='infer')\n1040 |         0   2018-10-28 01:30:00+02:00\n1041 |         1   2018-10-28 02:00:00+02:00\n1042 |         2   2018-10-28 02:30:00+02:00\n1043 |         3   2018-10-28 02:00:00+01:00\n1044 |         4   2018-10-28 02:30:00+01:00\n1045 |         5   2018-10-28 03:00:00+01:00\n1046 |         6   2018-10-28 03:30:00+01:00\n1047 |         dtype: datetime64[s, CET]\n1048 | \n1049 |         In some cases, inferring the DST is impossible. In such cases, you can\n1050 |         pass an ndarray to the ambiguous parameter to set the DST explicitly\n1051 | \n1052 |         >>> s = pd.to_datetime(pd.Series(['2018-10-28 01:20:00',\n1053 |         ...                               '2018-10-28 02:36:00',\n1054 |         ...                               '2018-10-28 03:46:00']))\n1055 |         >>> s.dt.tz_localize('CET', ambiguous=np.array([True, True, False]))\n1056 |         0   2018-10-28 01:20:00+02:00\n1057 |         1   2018-10-28 02:36:00+02:00\n1058 |         2   2018-10-28 03:46:00+01:00\n1059 |         dtype: datetime64[s, CET]\n1060 | \n1061 |         If the DST transition causes nonexistent times, you can shift these\n1062 |         dates forward or backwards with a timedelta object or `'shift_forward'`\n1063 |         or `'shift_backwards'`.\n1064 | \n1065 |         >>> s = pd.to_datetime(pd.Series(['2015-03-29 02:30:00',\n1066 |         ...                               '2015-03-29 03:30:00'], dtype=\"M8[ns]\"))\n1067 |         >>> s.dt.tz_localize('Europe/Warsaw', nonexistent='shift_forward')\n1068 |         0   2015-03-29 03:00:00+02:00\n1069 |         1   2015-03-29 03:30:00+02:00\n1070 |         dtype: datetime64[ns, Europe/Warsaw]\n1071 | \n1072 |         >>> s.dt.tz_localize('Europe/Warsaw', nonexistent='shift_backward')\n1073 |         0   2015-03-29 01:59:59.999999999+01:00\n1074 |         1   2015-03-29 03:30:00+02:00\n1075 |         dtype: datetime64[ns, Europe/Warsaw]\n1076 | \n1077 |         >>> s.dt.tz_localize('Europe/Warsaw', nonexistent=pd.Timedelta('1h'))\n1078 |         0   2015-03-29 03:30:00+02:00\n1079 |         1   2015-03-29 03:30:00+02:00\n1080 |         dtype: datetime64[ns, Europe/Warsaw]\n1081 |         \"\"\"  # noqa: E501\n1082 |         nonexistent_options = (\"raise\", \"NaT\", \"shift_forward\", \"shift_backward\")\n1083 |         if nonexistent not in nonexistent_options and not isinstance(\n1084 |             nonexistent, timedelta\n1085 |         ):\n1086 |             raise ValueError(\n1087 |                 \"The nonexistent argument must be one of 'raise', \"\n1088 |                 \"'NaT', 'shift_forward', 'shift_backward' or \"\n1089 |                 \"a timedelta object\"\n1090 |             )\n1091 | \n1092 |         if self.tz is not None:\n1093 |             if tz is None:\n1094 |                 new_dates = tz_convert_from_utc(self.asi8, self.tz, reso=self._creso)\n1095 |             else:\n1096 |                 raise TypeError(\"Already tz-aware, use tz_convert to convert.\")\n1097 |         else:\n1098 |             tz = timezones.maybe_get_tz(tz)\n1099 |             # Convert to UTC\n1100 | \n1101 |             new_dates = tzconversion.tz_localize_to_utc(\n1102 |                 self.asi8,\n1103 |                 tz,\n1104 |                 ambiguous=ambiguous,\n1105 |                 nonexistent=nonexistent,\n1106 |                 creso=self._creso,\n1107 |             )\n1108 |         new_dates_dt64 = new_dates.view(f\"M8[{self.unit}]\")\n1109 |         dtype = tz_to_dtype(tz, unit=self.unit)\n1110 | \n1111 |         freq = None\n1112 |         if timezones.is_utc(tz) or (len(self) == 1 and not isna(new_dates_dt64[0])):\n1113 |             # we can preserve freq\n1114 |             # TODO: Also for fixed-offsets\n1115 |             freq = self.freq\n1116 |         elif tz is None and self.tz is None:\n1117 |             # no-op\n1118 |             freq = self.freq\n1119 |         return self._simple_new(new_dates_dt64, dtype=dtype, freq=freq)\n1120 | \n1121 |     # ----------------------------------------------------------------\n1122 |     # Conversion Methods - Vectorized analogues of Timestamp methods\n1123 | \n1124 |     def to_pydatetime(self) -> npt.NDArray[np.object_]:\n1125 |         \"\"\"\n1126 |         Return an ndarray of ``datetime.datetime`` objects.\n1127 | \n1128 |         Returns\n1129 |         -------\n1130 |         numpy.ndarray\n1131 |             An ndarray of ``datetime.datetime`` objects.\n1132 | \n1133 |         See Also\n1134 |         --------\n1135 |         DatetimeIndex.to_julian_date : Converts Datetime Array to float64 ndarray\n1136 |             of Julian Dates.\n1137 | \n1138 |         Examples\n1139 |         --------\n1140 |         >>> idx = pd.date_range(\"2018-02-27\", periods=3)\n1141 |         >>> idx.to_pydatetime()\n1142 |         array([datetime.datetime(2018, 2, 27, 0, 0),\n1143 |                datetime.datetime(2018, 2, 28, 0, 0),\n1144 |                datetime.datetime(2018, 3, 1, 0, 0)], dtype=object)\n1145 |         \"\"\"\n1146 |         return ints_to_pydatetime(self.asi8, tz=self.tz, reso=self._creso)\n1147 | \n1148 |     def normalize(self) -> Self:\n1149 |         \"\"\"\n1150 |         Convert times to midnight.\n1151 | \n1152 |         The time component of the date-time is converted to midnight i.e.\n1153 |         00:00:00. This is useful in cases, when the time does not matter.\n1154 |         Length is unaltered. The timezones are unaffected.\n1155 | \n1156 |         This method is available on Series with datetime values under\n1157 |         the ``.dt`` accessor, and directly on Datetime Array/Index.\n1158 | \n1159 |         Returns\n1160 |         -------\n1161 |         DatetimeArray, DatetimeIndex or Series\n1162 |             The same type as the original data. Series will have the same\n1163 |             name and index. DatetimeIndex will have the same name.\n1164 | \n1165 |         See Also\n1166 |         --------\n1167 |         floor : Floor the datetimes to the specified freq.\n1168 |         ceil : Ceil the datetimes to the specified freq.\n1169 |         round : Round the datetimes to the specified freq.\n1170 | \n1171 |         Examples\n1172 |         --------\n1173 |         >>> idx = pd.date_range(\n1174 |         ...     start=\"2014-08-01 10:00\", freq=\"h\", periods=3, tz=\"Asia/Calcutta\"\n1175 |         ... )\n1176 |         >>> idx\n1177 |         DatetimeIndex(['2014-08-01 10:00:00+05:30',\n1178 |                        '2014-08-01 11:00:00+05:30',\n1179 |                        '2014-08-01 12:00:00+05:30'],\n1180 |                         dtype='datetime64[ns, Asia/Calcutta]', freq='h')\n1181 |         >>> idx.normalize()\n1182 |         DatetimeIndex(['2014-08-01 00:00:00+05:30',\n1183 |                        '2014-08-01 00:00:00+05:30',\n1184 |                        '2014-08-01 00:00:00+05:30'],\n1185 |                        dtype='datetime64[ns, Asia/Calcutta]', freq=None)\n1186 |         \"\"\"\n1187 |         new_values = normalize_i8_timestamps(self.asi8, self.tz, reso=self._creso)\n1188 |         dt64_values = new_values.view(self._ndarray.dtype)\n1189 | \n1190 |         dta = type(self)._simple_new(dt64_values, dtype=dt64_values.dtype)\n1191 |         dta = dta._with_freq(\"infer\")\n1192 |         if self.tz is not None:\n1193 |             dta = dta.tz_localize(self.tz)\n1194 |         return dta\n1195 | \n1196 |     def to_period(self, freq=None) -> PeriodArray:\n1197 |         \"\"\"\n1198 |         Cast to PeriodArray/PeriodIndex at a particular frequency.\n1199 | \n1200 |         Converts DatetimeArray/Index to PeriodArray/PeriodIndex.\n1201 | \n1202 |         Parameters\n1203 |         ----------\n1204 |         freq : str or Period, optional\n1205 |             One of pandas' :ref:`period aliases <timeseries.period_aliases>`\n1206 |             or an Period object. Will be inferred by default.\n1207 | \n1208 |         Returns\n1209 |         -------\n1210 |         PeriodArray/PeriodIndex\n1211 |             Immutable ndarray holding ordinal values at a particular frequency.\n1212 | \n1213 |         Raises\n1214 |         ------\n1215 |         ValueError\n1216 |             When converting a DatetimeArray/Index with non-regular values,\n1217 |             so that a frequency cannot be inferred.\n1218 | \n1219 |         See Also\n1220 |         --------\n1221 |         PeriodIndex: Immutable ndarray holding ordinal values.\n1222 |         DatetimeIndex.to_pydatetime: Return DatetimeIndex as object.\n1223 | \n1224 |         Examples\n1225 |         --------\n1226 |         >>> df = pd.DataFrame(\n1227 |         ...     {\"y\": [1, 2, 3]},\n1228 |         ...     index=pd.to_datetime(\n1229 |         ...         [\n1230 |         ...             \"2000-03-31 00:00:00\",\n1231 |         ...             \"2000-05-31 00:00:00\",\n1232 |         ...             \"2000-08-31 00:00:00\",\n1233 |         ...         ]\n1234 |         ...     ),\n1235 |         ... )\n1236 |         >>> df.index.to_period(\"M\")\n1237 |         PeriodIndex(['2000-03', '2000-05', '2000-08'],\n1238 |                     dtype='period[M]')\n1239 | \n1240 |         Infer the daily frequency\n1241 | \n1242 |         >>> idx = pd.date_range(\"2017-01-01\", periods=2)\n1243 |         >>> idx.to_period()\n1244 |         PeriodIndex(['2017-01-01', '2017-01-02'],\n1245 |                     dtype='period[D]')\n1246 |         \"\"\"\n1247 |         from pandas.core.arrays import PeriodArray\n1248 | \n1249 |         if self.tz is not None:\n1250 |             warnings.warn(\n1251 |                 \"Converting to PeriodArray/Index representation \"\n1252 |                 \"will drop timezone information.\",\n1253 |                 UserWarning,\n1254 |                 stacklevel=find_stack_level(),\n1255 |             )\n1256 | \n1257 |         if freq is None:\n1258 |             freq = self.freqstr or self.inferred_freq\n1259 |             if isinstance(self.freq, BaseOffset) and hasattr(\n1260 |                 self.freq, \"_period_dtype_code\"\n1261 |             ):\n1262 |                 freq = PeriodDtype(self.freq)._freqstr\n1263 | \n1264 |             if freq is None:\n1265 |                 raise ValueError(\n1266 |                     \"You must pass a freq argument as current index has none.\"\n1267 |                 )\n1268 | \n1269 |             res = get_period_alias(freq)\n1270 | \n1271 |             #  https://github.com/pandas-dev/pandas/issues/33358\n1272 |             if res is None:\n1273 |                 res = freq\n1274 | \n1275 |             freq = res\n1276 |         return PeriodArray._from_datetime64(self._ndarray, freq, tz=self.tz)\n1277 | \n1278 |     # -----------------------------------------------------------------\n1279 |     # Properties - Vectorized Timestamp Properties/Methods\n1280 | \n1281 |     def month_name(self, locale=None) -> npt.NDArray[np.object_]:\n1282 |         \"\"\"\n1283 |         Return the month names with specified locale.\n1284 | \n1285 |         Parameters\n1286 |         ----------\n1287 |         locale : str, optional\n1288 |             Locale determining the language in which to return the month name.\n1289 |             Default is English locale (``'en_US.utf8'``). Use the command\n1290 |             ``locale -a`` on your terminal on Unix systems to find your locale\n1291 |             language code.\n1292 | \n1293 |         Returns\n1294 |         -------\n1295 |         Series or Index\n1296 |             Series or Index of month names.\n1297 | \n1298 |         See Also\n1299 |         --------\n1300 |         DatetimeIndex.day_name : Return the day names with specified locale.\n1301 | \n1302 |         Examples\n1303 |         --------\n1304 |         >>> s = pd.Series(pd.date_range(start=\"2018-01\", freq=\"ME\", periods=3))\n1305 |         >>> s\n1306 |         0   2018-01-31\n1307 |         1   2018-02-28\n1308 |         2   2018-03-31\n1309 |         dtype: datetime64[ns]\n1310 |         >>> s.dt.month_name()\n1311 |         0     January\n1312 |         1    February\n1313 |         2       March\n1314 |         dtype: object\n1315 | \n1316 |         >>> idx = pd.date_range(start=\"2018-01\", freq=\"ME\", periods=3)\n1317 |         >>> idx\n1318 |         DatetimeIndex(['2018-01-31', '2018-02-28', '2018-03-31'],\n1319 |                       dtype='datetime64[ns]', freq='ME')\n1320 |         >>> idx.month_name()\n1321 |         Index(['January', 'February', 'March'], dtype='object')\n1322 | \n1323 |         Using the ``locale`` parameter you can set a different locale language,\n1324 |         for example: ``idx.month_name(locale='pt_BR.utf8')`` will return month\n1325 |         names in Brazilian Portuguese language.\n1326 | \n1327 |         >>> idx = pd.date_range(start=\"2018-01\", freq=\"ME\", periods=3)\n1328 |         >>> idx\n1329 |         DatetimeIndex(['2018-01-31', '2018-02-28', '2018-03-31'],\n1330 |                       dtype='datetime64[ns]', freq='ME')\n1331 |         >>> idx.month_name(locale=\"pt_BR.utf8\")  # doctest: +SKIP\n1332 |         Index(['Janeiro', 'Fevereiro', 'Mar\u00e7o'], dtype='object')\n1333 |         \"\"\"\n1334 |         values = self._local_timestamps()\n1335 | \n1336 |         result = fields.get_date_name_field(\n1337 |             values, \"month_name\", locale=locale, reso=self._creso\n1338 |         )\n1339 |         result = self._maybe_mask_results(result, fill_value=None)\n1340 |         if using_string_dtype():\n1341 |             from pandas import (\n1342 |                 StringDtype,\n1343 |                 array as pd_array,\n1344 |             )\n1345 | \n1346 |             return pd_array(result, dtype=StringDtype(na_value=np.nan))  # type: ignore[return-value]\n1347 |         return result\n1348 | \n1349 |     def day_name(self, locale=None) -> npt.NDArray[np.object_]:\n1350 |         \"\"\"\n1351 |         Return the day names with specified locale.\n1352 | \n1353 |         Parameters\n1354 |         ----------\n1355 |         locale : str, optional\n1356 |             Locale determining the language in which to return the day name.\n1357 |             Default is English locale (``'en_US.utf8'``). Use the command\n1358 |             ``locale -a`` on your terminal on Unix systems to find your locale\n1359 |             language code.\n1360 | \n1361 |         Returns\n1362 |         -------\n1363 |         Series or Index\n1364 |             Series or Index of day names.\n1365 | \n1366 |         See Also\n1367 |         --------\n1368 |         DatetimeIndex.month_name : Return the month names with specified locale.\n1369 | \n1370 |         Examples\n1371 |         --------\n1372 |         >>> s = pd.Series(pd.date_range(start=\"2018-01-01\", freq=\"D\", periods=3))\n1373 |         >>> s\n1374 |         0   2018-01-01\n1375 |         1   2018-01-02\n1376 |         2   2018-01-03\n1377 |         dtype: datetime64[ns]\n1378 |         >>> s.dt.day_name()\n1379 |         0       Monday\n1380 |         1      Tuesday\n1381 |         2    Wednesday\n1382 |         dtype: object\n1383 | \n1384 |         >>> idx = pd.date_range(start=\"2018-01-01\", freq=\"D\", periods=3)\n1385 |         >>> idx\n1386 |         DatetimeIndex(['2018-01-01', '2018-01-02', '2018-01-03'],\n1387 |                       dtype='datetime64[ns]', freq='D')\n1388 |         >>> idx.day_name()\n1389 |         Index(['Monday', 'Tuesday', 'Wednesday'], dtype='object')\n1390 | \n1391 |         Using the ``locale`` parameter you can set a different locale language,\n1392 |         for example: ``idx.day_name(locale='pt_BR.utf8')`` will return day\n1393 |         names in Brazilian Portuguese language.\n1394 | \n1395 |         >>> idx = pd.date_range(start=\"2018-01-01\", freq=\"D\", periods=3)\n1396 |         >>> idx\n1397 |         DatetimeIndex(['2018-01-01', '2018-01-02', '2018-01-03'],\n1398 |                       dtype='datetime64[ns]', freq='D')\n1399 |         >>> idx.day_name(locale=\"pt_BR.utf8\")  # doctest: +SKIP\n1400 |         Index(['Segunda', 'Ter\u00e7a', 'Quarta'], dtype='object')\n1401 |         \"\"\"\n1402 |         values = self._local_timestamps()\n1403 | \n1404 |         result = fields.get_date_name_field(\n1405 |             values, \"day_name\", locale=locale, reso=self._creso\n1406 |         )\n1407 |         result = self._maybe_mask_results(result, fill_value=None)\n1408 |         if using_string_dtype():\n1409 |             # TODO: no tests that check for dtype of result as of 2024-08-15\n1410 |             from pandas import (\n1411 |                 StringDtype,\n1412 |                 array as pd_array,\n1413 |             )\n1414 | \n1415 |             return pd_array(result, dtype=StringDtype(na_value=np.nan))  # type: ignore[return-value]\n1416 |         return result\n1417 | \n1418 |     @property\n1419 |     def time(self) -> npt.NDArray[np.object_]:\n1420 |         \"\"\"\n1421 |         Returns numpy array of :class:`datetime.time` objects.\n1422 | \n1423 |         The time part of the Timestamps.\n1424 | \n1425 |         See Also\n1426 |         --------\n1427 |         DatetimeIndex.timetz : Returns numpy array of :class:`datetime.time`\n1428 |             objects with timezones. The time part of the Timestamps.\n1429 |         DatetimeIndex.date : Returns numpy array of python :class:`datetime.date`\n1430 |             objects. Namely, the date part of Timestamps without time and timezone\n1431 |             information.\n1432 | \n1433 |         Examples\n1434 |         --------\n1435 |         For Series:\n1436 | \n1437 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n1438 |         >>> s = pd.to_datetime(s)\n1439 |         >>> s\n1440 |         0   2020-01-01 10:00:00+00:00\n1441 |         1   2020-02-01 11:00:00+00:00\n1442 |         dtype: datetime64[s, UTC]\n1443 |         >>> s.dt.time\n1444 |         0    10:00:00\n1445 |         1    11:00:00\n1446 |         dtype: object\n1447 | \n1448 |         For DatetimeIndex:\n1449 | \n1450 |         >>> idx = pd.DatetimeIndex(\n1451 |         ...     [\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"]\n1452 |         ... )\n1453 |         >>> idx.time\n1454 |         array([datetime.time(10, 0), datetime.time(11, 0)], dtype=object)\n1455 |         \"\"\"\n1456 |         # If the Timestamps have a timezone that is not UTC,\n1457 |         # convert them into their i8 representation while\n1458 |         # keeping their timezone and not using UTC\n1459 |         timestamps = self._local_timestamps()\n1460 | \n1461 |         return ints_to_pydatetime(timestamps, box=\"time\", reso=self._creso)\n1462 | \n1463 |     @property\n1464 |     def timetz(self) -> npt.NDArray[np.object_]:\n1465 |         \"\"\"\n1466 |         Returns numpy array of :class:`datetime.time` objects with timezones.\n1467 | \n1468 |         The time part of the Timestamps.\n1469 | \n1470 |         See Also\n1471 |         --------\n1472 |         DatetimeIndex.time : Returns numpy array of :class:`datetime.time` objects.\n1473 |             The time part of the Timestamps.\n1474 |         DatetimeIndex.tz : Return the timezone.\n1475 | \n1476 |         Examples\n1477 |         --------\n1478 |         For Series:\n1479 | \n1480 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n1481 |         >>> s = pd.to_datetime(s)\n1482 |         >>> s\n1483 |         0   2020-01-01 10:00:00+00:00\n1484 |         1   2020-02-01 11:00:00+00:00\n1485 |         dtype: datetime64[s, UTC]\n1486 |         >>> s.dt.timetz\n1487 |         0    10:00:00+00:00\n1488 |         1    11:00:00+00:00\n1489 |         dtype: object\n1490 | \n1491 |         For DatetimeIndex:\n1492 | \n1493 |         >>> idx = pd.DatetimeIndex(\n1494 |         ...     [\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"]\n1495 |         ... )\n1496 |         >>> idx.timetz\n1497 |         array([datetime.time(10, 0, tzinfo=datetime.timezone.utc),\n1498 |         datetime.time(11, 0, tzinfo=datetime.timezone.utc)], dtype=object)\n1499 |         \"\"\"\n1500 |         return ints_to_pydatetime(self.asi8, self.tz, box=\"time\", reso=self._creso)\n1501 | \n1502 |     @property\n1503 |     def date(self) -> npt.NDArray[np.object_]:\n1504 |         \"\"\"\n1505 |         Returns numpy array of python :class:`datetime.date` objects.\n1506 | \n1507 |         Namely, the date part of Timestamps without time and\n1508 |         timezone information.\n1509 | \n1510 |         See Also\n1511 |         --------\n1512 |         DatetimeIndex.time : Returns numpy array of :class:`datetime.time` objects.\n1513 |             The time part of the Timestamps.\n1514 |         DatetimeIndex.year : The year of the datetime.\n1515 |         DatetimeIndex.month : The month as January=1, December=12.\n1516 |         DatetimeIndex.day : The day of the datetime.\n1517 | \n1518 |         Examples\n1519 |         --------\n1520 |         For Series:\n1521 | \n1522 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n1523 |         >>> s = pd.to_datetime(s)\n1524 |         >>> s\n1525 |         0   2020-01-01 10:00:00+00:00\n1526 |         1   2020-02-01 11:00:00+00:00\n1527 |         dtype: datetime64[s, UTC]\n1528 |         >>> s.dt.date\n1529 |         0    2020-01-01\n1530 |         1    2020-02-01\n1531 |         dtype: object\n1532 | \n1533 |         For DatetimeIndex:\n1534 | \n1535 |         >>> idx = pd.DatetimeIndex(\n1536 |         ...     [\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"]\n1537 |         ... )\n1538 |         >>> idx.date\n1539 |         array([datetime.date(2020, 1, 1), datetime.date(2020, 2, 1)], dtype=object)\n1540 |         \"\"\"\n1541 |         # If the Timestamps have a timezone that is not UTC,\n1542 |         # convert them into their i8 representation while\n1543 |         # keeping their timezone and not using UTC\n1544 |         timestamps = self._local_timestamps()\n1545 | \n1546 |         return ints_to_pydatetime(timestamps, box=\"date\", reso=self._creso)\n1547 | \n1548 |     def isocalendar(self) -> DataFrame:\n1549 |         \"\"\"\n1550 |         Calculate year, week, and day according to the ISO 8601 standard.\n1551 | \n1552 |         Returns\n1553 |         -------\n1554 |         DataFrame\n1555 |             With columns year, week and day.\n1556 | \n1557 |         See Also\n1558 |         --------\n1559 |         Timestamp.isocalendar : Function return a 3-tuple containing ISO year,\n1560 |             week number, and weekday for the given Timestamp object.\n1561 |         datetime.date.isocalendar : Return a named tuple object with\n1562 |             three components: year, week and weekday.\n1563 | \n1564 |         Examples\n1565 |         --------\n1566 |         >>> idx = pd.date_range(start=\"2019-12-29\", freq=\"D\", periods=4)\n1567 |         >>> idx.isocalendar()\n1568 |                     year  week  day\n1569 |         2019-12-29  2019    52    7\n1570 |         2019-12-30  2020     1    1\n1571 |         2019-12-31  2020     1    2\n1572 |         2020-01-01  2020     1    3\n1573 |         >>> idx.isocalendar().week\n1574 |         2019-12-29    52\n1575 |         2019-12-30     1\n1576 |         2019-12-31     1\n1577 |         2020-01-01     1\n1578 |         Freq: D, Name: week, dtype: UInt32\n1579 |         \"\"\"\n1580 |         from pandas import DataFrame\n1581 | \n1582 |         values = self._local_timestamps()\n1583 |         sarray = fields.build_isocalendar_sarray(values, reso=self._creso)\n1584 |         iso_calendar_df = DataFrame(\n1585 |             sarray, columns=[\"year\", \"week\", \"day\"], dtype=\"UInt32\"\n1586 |         )\n1587 |         if self._hasna:\n1588 |             iso_calendar_df.iloc[self._isnan] = None\n1589 |         return iso_calendar_df\n1590 | \n1591 |     year = _field_accessor(\n1592 |         \"year\",\n1593 |         \"Y\",\n1594 |         \"\"\"\n1595 |         The year of the datetime.\n1596 | \n1597 |         See Also\n1598 |         --------\n1599 |         DatetimeIndex.month: The month as January=1, December=12.\n1600 |         DatetimeIndex.day: The day of the datetime.\n1601 | \n1602 |         Examples\n1603 |         --------\n1604 |         >>> datetime_series = pd.Series(\n1605 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"YE\")\n1606 |         ... )\n1607 |         >>> datetime_series\n1608 |         0   2000-12-31\n1609 |         1   2001-12-31\n1610 |         2   2002-12-31\n1611 |         dtype: datetime64[ns]\n1612 |         >>> datetime_series.dt.year\n1613 |         0    2000\n1614 |         1    2001\n1615 |         2    2002\n1616 |         dtype: int32\n1617 |         \"\"\",\n1618 |     )\n1619 |     month = _field_accessor(\n1620 |         \"month\",\n1621 |         \"M\",\n1622 |         \"\"\"\n1623 |         The month as January=1, December=12.\n1624 | \n1625 |         See Also\n1626 |         --------\n1627 |         DatetimeIndex.year: The year of the datetime.\n1628 |         DatetimeIndex.day: The day of the datetime.\n1629 | \n1630 |         Examples\n1631 |         --------\n1632 |         >>> datetime_series = pd.Series(\n1633 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"ME\")\n1634 |         ... )\n1635 |         >>> datetime_series\n1636 |         0   2000-01-31\n1637 |         1   2000-02-29\n1638 |         2   2000-03-31\n1639 |         dtype: datetime64[ns]\n1640 |         >>> datetime_series.dt.month\n1641 |         0    1\n1642 |         1    2\n1643 |         2    3\n1644 |         dtype: int32\n1645 |         \"\"\",\n1646 |     )\n1647 |     day = _field_accessor(\n1648 |         \"day\",\n1649 |         \"D\",\n1650 |         \"\"\"\n1651 |         The day of the datetime.\n1652 | \n1653 |         See Also\n1654 |         --------\n1655 |         DatetimeIndex.year: The year of the datetime.\n1656 |         DatetimeIndex.month: The month as January=1, December=12.\n1657 |         DatetimeIndex.hour: The hours of the datetime.\n1658 | \n1659 |         Examples\n1660 |         --------\n1661 |         >>> datetime_series = pd.Series(\n1662 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"D\")\n1663 |         ... )\n1664 |         >>> datetime_series\n1665 |         0   2000-01-01\n1666 |         1   2000-01-02\n1667 |         2   2000-01-03\n1668 |         dtype: datetime64[ns]\n1669 |         >>> datetime_series.dt.day\n1670 |         0    1\n1671 |         1    2\n1672 |         2    3\n1673 |         dtype: int32\n1674 |         \"\"\",\n1675 |     )\n1676 |     hour = _field_accessor(\n1677 |         \"hour\",\n1678 |         \"h\",\n1679 |         \"\"\"\n1680 |         The hours of the datetime.\n1681 | \n1682 |         See Also\n1683 |         --------\n1684 |         DatetimeIndex.day: The day of the datetime.\n1685 |         DatetimeIndex.minute: The minutes of the datetime.\n1686 |         DatetimeIndex.second: The seconds of the datetime.\n1687 | \n1688 |         Examples\n1689 |         --------\n1690 |         >>> datetime_series = pd.Series(\n1691 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"h\")\n1692 |         ... )\n1693 |         >>> datetime_series\n1694 |         0   2000-01-01 00:00:00\n1695 |         1   2000-01-01 01:00:00\n1696 |         2   2000-01-01 02:00:00\n1697 |         dtype: datetime64[ns]\n1698 |         >>> datetime_series.dt.hour\n1699 |         0    0\n1700 |         1    1\n1701 |         2    2\n1702 |         dtype: int32\n1703 |         \"\"\",\n1704 |     )\n1705 |     minute = _field_accessor(\n1706 |         \"minute\",\n1707 |         \"m\",\n1708 |         \"\"\"\n1709 |         The minutes of the datetime.\n1710 | \n1711 |         See Also\n1712 |         --------\n1713 |         DatetimeIndex.hour: The hours of the datetime.\n1714 |         DatetimeIndex.second: The seconds of the datetime.\n1715 | \n1716 |         Examples\n1717 |         --------\n1718 |         >>> datetime_series = pd.Series(\n1719 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"min\")\n1720 |         ... )\n1721 |         >>> datetime_series\n1722 |         0   2000-01-01 00:00:00\n1723 |         1   2000-01-01 00:01:00\n1724 |         2   2000-01-01 00:02:00\n1725 |         dtype: datetime64[ns]\n1726 |         >>> datetime_series.dt.minute\n1727 |         0    0\n1728 |         1    1\n1729 |         2    2\n1730 |         dtype: int32\n1731 |         \"\"\",\n1732 |     )\n1733 |     second = _field_accessor(\n1734 |         \"second\",\n1735 |         \"s\",\n1736 |         \"\"\"\n1737 |         The seconds of the datetime.\n1738 | \n1739 |         See Also\n1740 |         --------\n1741 |         DatetimeIndex.minute: The minutes of the datetime.\n1742 |         DatetimeIndex.microsecond: The microseconds of the datetime.\n1743 |         DatetimeIndex.nanosecond: The nanoseconds of the datetime.\n1744 | \n1745 |         Examples\n1746 |         --------\n1747 |         >>> datetime_series = pd.Series(\n1748 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"s\")\n1749 |         ... )\n1750 |         >>> datetime_series\n1751 |         0   2000-01-01 00:00:00\n1752 |         1   2000-01-01 00:00:01\n1753 |         2   2000-01-01 00:00:02\n1754 |         dtype: datetime64[ns]\n1755 |         >>> datetime_series.dt.second\n1756 |         0    0\n1757 |         1    1\n1758 |         2    2\n1759 |         dtype: int32\n1760 |         \"\"\",\n1761 |     )\n1762 |     microsecond = _field_accessor(\n1763 |         \"microsecond\",\n1764 |         \"us\",\n1765 |         \"\"\"\n1766 |         The microseconds of the datetime.\n1767 | \n1768 |         See Also\n1769 |         --------\n1770 |         DatetimeIndex.second: The seconds of the datetime.\n1771 |         DatetimeIndex.nanosecond: The nanoseconds of the datetime.\n1772 | \n1773 |         Examples\n1774 |         --------\n1775 |         >>> datetime_series = pd.Series(\n1776 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"us\")\n1777 |         ... )\n1778 |         >>> datetime_series\n1779 |         0   2000-01-01 00:00:00.000000\n1780 |         1   2000-01-01 00:00:00.000001\n1781 |         2   2000-01-01 00:00:00.000002\n1782 |         dtype: datetime64[ns]\n1783 |         >>> datetime_series.dt.microsecond\n1784 |         0       0\n1785 |         1       1\n1786 |         2       2\n1787 |         dtype: int32\n1788 |         \"\"\",\n1789 |     )\n1790 |     nanosecond = _field_accessor(\n1791 |         \"nanosecond\",\n1792 |         \"ns\",\n1793 |         \"\"\"\n1794 |         The nanoseconds of the datetime.\n1795 | \n1796 |         See Also\n1797 |         --------\n1798 |         DatetimeIndex.second: The seconds of the datetime.\n1799 |         DatetimeIndex.microsecond: The microseconds of the datetime.\n1800 | \n1801 |         Examples\n1802 |         --------\n1803 |         >>> datetime_series = pd.Series(\n1804 |         ...     pd.date_range(\"2000-01-01\", periods=3, freq=\"ns\")\n1805 |         ... )\n1806 |         >>> datetime_series\n1807 |         0   2000-01-01 00:00:00.000000000\n1808 |         1   2000-01-01 00:00:00.000000001\n1809 |         2   2000-01-01 00:00:00.000000002\n1810 |         dtype: datetime64[ns]\n1811 |         >>> datetime_series.dt.nanosecond\n1812 |         0       0\n1813 |         1       1\n1814 |         2       2\n1815 |         dtype: int32\n1816 |         \"\"\",\n1817 |     )\n1818 |     _dayofweek_doc = \"\"\"\n1819 |     The day of the week with Monday=0, Sunday=6.\n1820 | \n1821 |     Return the day of the week. It is assumed the week starts on\n1822 |     Monday, which is denoted by 0 and ends on Sunday which is denoted\n1823 |     by 6. This method is available on both Series with datetime\n1824 |     values (using the `dt` accessor) or DatetimeIndex.\n1825 | \n1826 |     Returns\n1827 |     -------\n1828 |     Series or Index\n1829 |         Containing integers indicating the day number.\n1830 | \n1831 |     See Also\n1832 |     --------\n1833 |     Series.dt.dayofweek : Alias.\n1834 |     Series.dt.weekday : Alias.\n1835 |     Series.dt.day_name : Returns the name of the day of the week.\n1836 | \n1837 |     Examples\n1838 |     --------\n1839 |     >>> s = pd.date_range('2016-12-31', '2017-01-08', freq='D').to_series()\n1840 |     >>> s.dt.dayofweek\n1841 |     2016-12-31    5\n1842 |     2017-01-01    6\n1843 |     2017-01-02    0\n1844 |     2017-01-03    1\n1845 |     2017-01-04    2\n1846 |     2017-01-05    3\n1847 |     2017-01-06    4\n1848 |     2017-01-07    5\n1849 |     2017-01-08    6\n1850 |     Freq: D, dtype: int32\n1851 |     \"\"\"\n1852 |     day_of_week = _field_accessor(\"day_of_week\", \"dow\", _dayofweek_doc)\n1853 |     dayofweek = day_of_week\n1854 |     weekday = day_of_week\n1855 | \n1856 |     day_of_year = _field_accessor(\n1857 |         \"dayofyear\",\n1858 |         \"doy\",\n1859 |         \"\"\"\n1860 |         The ordinal day of the year.\n1861 | \n1862 |         See Also\n1863 |         --------\n1864 |         DatetimeIndex.dayofweek : The day of the week with Monday=0, Sunday=6.\n1865 |         DatetimeIndex.day : The day of the datetime.\n1866 | \n1867 |         Examples\n1868 |         --------\n1869 |         For Series:\n1870 | \n1871 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n1872 |         >>> s = pd.to_datetime(s)\n1873 |         >>> s\n1874 |         0   2020-01-01 10:00:00+00:00\n1875 |         1   2020-02-01 11:00:00+00:00\n1876 |         dtype: datetime64[s, UTC]\n1877 |         >>> s.dt.dayofyear\n1878 |         0    1\n1879 |         1   32\n1880 |         dtype: int32\n1881 | \n1882 |         For DatetimeIndex:\n1883 | \n1884 |         >>> idx = pd.DatetimeIndex([\"1/1/2020 10:00:00+00:00\",\n1885 |         ...                         \"2/1/2020 11:00:00+00:00\"])\n1886 |         >>> idx.dayofyear\n1887 |         Index([1, 32], dtype='int32')\n1888 |         \"\"\",\n1889 |     )\n1890 |     dayofyear = day_of_year\n1891 |     quarter = _field_accessor(\n1892 |         \"quarter\",\n1893 |         \"q\",\n1894 |         \"\"\"\n1895 |         The quarter of the date.\n1896 | \n1897 |         See Also\n1898 |         --------\n1899 |         DatetimeIndex.snap : Snap time stamps to nearest occurring frequency.\n1900 |         DatetimeIndex.time : Returns numpy array of datetime.time objects.\n1901 |             The time part of the Timestamps.\n1902 | \n1903 |         Examples\n1904 |         --------\n1905 |         For Series:\n1906 | \n1907 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"4/1/2020 11:00:00+00:00\"])\n1908 |         >>> s = pd.to_datetime(s)\n1909 |         >>> s\n1910 |         0   2020-01-01 10:00:00+00:00\n1911 |         1   2020-04-01 11:00:00+00:00\n1912 |         dtype: datetime64[s, UTC]\n1913 |         >>> s.dt.quarter\n1914 |         0    1\n1915 |         1    2\n1916 |         dtype: int32\n1917 | \n1918 |         For DatetimeIndex:\n1919 | \n1920 |         >>> idx = pd.DatetimeIndex([\"1/1/2020 10:00:00+00:00\",\n1921 |         ...                         \"2/1/2020 11:00:00+00:00\"])\n1922 |         >>> idx.quarter\n1923 |         Index([1, 1], dtype='int32')\n1924 |         \"\"\",\n1925 |     )\n1926 |     days_in_month = _field_accessor(\n1927 |         \"days_in_month\",\n1928 |         \"dim\",\n1929 |         \"\"\"\n1930 |         The number of days in the month.\n1931 | \n1932 |         See Also\n1933 |         --------\n1934 |         Series.dt.day : Return the day of the month.\n1935 |         Series.dt.is_month_end : Return a boolean indicating if the\n1936 |             date is the last day of the month.\n1937 |         Series.dt.is_month_start : Return a boolean indicating if the\n1938 |             date is the first day of the month.\n1939 |         Series.dt.month : Return the month as January=1 through December=12.\n1940 | \n1941 |         Examples\n1942 |         --------\n1943 |         >>> s = pd.Series([\"1/1/2020 10:00:00+00:00\", \"2/1/2020 11:00:00+00:00\"])\n1944 |         >>> s = pd.to_datetime(s)\n1945 |         >>> s\n1946 |         0   2020-01-01 10:00:00+00:00\n1947 |         1   2020-02-01 11:00:00+00:00\n1948 |         dtype: datetime64[s, UTC]\n1949 |         >>> s.dt.daysinmonth\n1950 |         0    31\n1951 |         1    29\n1952 |         dtype: int32\n1953 |         \"\"\",\n1954 |     )\n1955 |     daysinmonth = days_in_month\n1956 |     _is_month_doc = \"\"\"\n1957 |         Indicates whether the date is the {first_or_last} day of the month.\n1958 | \n1959 |         Returns\n1960 |         -------\n1961 |         Series or array\n1962 |             For Series, returns a Series with boolean values.\n1963 |             For DatetimeIndex, returns a boolean array.\n1964 | \n1965 |         See Also\n1966 |         --------\n1967 |         is_month_start : Return a boolean indicating whether the date\n1968 |             is the first day of the month.\n1969 |         is_month_end : Return a boolean indicating whether the date\n1970 |             is the last day of the month.\n1971 | \n1972 |         Examples\n1973 |         --------\n1974 |         This method is available on Series with datetime values under\n1975 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n1976 | \n1977 |         >>> s = pd.Series(pd.date_range(\"2018-02-27\", periods=3))\n1978 |         >>> s\n1979 |         0   2018-02-27\n1980 |         1   2018-02-28\n1981 |         2   2018-03-01\n1982 |         dtype: datetime64[ns]\n1983 |         >>> s.dt.is_month_start\n1984 |         0    False\n1985 |         1    False\n1986 |         2    True\n1987 |         dtype: bool\n1988 |         >>> s.dt.is_month_end\n1989 |         0    False\n1990 |         1    True\n1991 |         2    False\n1992 |         dtype: bool\n1993 | \n1994 |         >>> idx = pd.date_range(\"2018-02-27\", periods=3)\n1995 |         >>> idx.is_month_start\n1996 |         array([False, False, True])\n1997 |         >>> idx.is_month_end\n1998 |         array([False, True, False])\n1999 |     \"\"\"\n2000 |     is_month_start = _field_accessor(\n2001 |         \"is_month_start\", \"is_month_start\", _is_month_doc.format(first_or_last=\"first\")\n2002 |     )\n2003 | \n2004 |     is_month_end = _field_accessor(\n2005 |         \"is_month_end\", \"is_month_end\", _is_month_doc.format(first_or_last=\"last\")\n2006 |     )\n2007 | \n2008 |     is_quarter_start = _field_accessor(\n2009 |         \"is_quarter_start\",\n2010 |         \"is_quarter_start\",\n2011 |         \"\"\"\n2012 |         Indicator for whether the date is the first day of a quarter.\n2013 | \n2014 |         Returns\n2015 |         -------\n2016 |         is_quarter_start : Series or DatetimeIndex\n2017 |             The same type as the original data with boolean values. Series will\n2018 |             have the same name and index. DatetimeIndex will have the same\n2019 |             name.\n2020 | \n2021 |         See Also\n2022 |         --------\n2023 |         quarter : Return the quarter of the date.\n2024 |         is_quarter_end : Similar property for indicating the quarter end.\n2025 | \n2026 |         Examples\n2027 |         --------\n2028 |         This method is available on Series with datetime values under\n2029 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n2030 | \n2031 |         >>> df = pd.DataFrame({'dates': pd.date_range(\"2017-03-30\",\n2032 |         ...                   periods=4)})\n2033 |         >>> df.assign(quarter=df.dates.dt.quarter,\n2034 |         ...           is_quarter_start=df.dates.dt.is_quarter_start)\n2035 |                dates  quarter  is_quarter_start\n2036 |         0 2017-03-30        1             False\n2037 |         1 2017-03-31        1             False\n2038 |         2 2017-04-01        2              True\n2039 |         3 2017-04-02        2             False\n2040 | \n2041 |         >>> idx = pd.date_range('2017-03-30', periods=4)\n2042 |         >>> idx\n2043 |         DatetimeIndex(['2017-03-30', '2017-03-31', '2017-04-01', '2017-04-02'],\n2044 |                       dtype='datetime64[ns]', freq='D')\n2045 | \n2046 |         >>> idx.is_quarter_start\n2047 |         array([False, False,  True, False])\n2048 |         \"\"\",\n2049 |     )\n2050 |     is_quarter_end = _field_accessor(\n2051 |         \"is_quarter_end\",\n2052 |         \"is_quarter_end\",\n2053 |         \"\"\"\n2054 |         Indicator for whether the date is the last day of a quarter.\n2055 | \n2056 |         Returns\n2057 |         -------\n2058 |         is_quarter_end : Series or DatetimeIndex\n2059 |             The same type as the original data with boolean values. Series will\n2060 |             have the same name and index. DatetimeIndex will have the same\n2061 |             name.\n2062 | \n2063 |         See Also\n2064 |         --------\n2065 |         quarter : Return the quarter of the date.\n2066 |         is_quarter_start : Similar property indicating the quarter start.\n2067 | \n2068 |         Examples\n2069 |         --------\n2070 |         This method is available on Series with datetime values under\n2071 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n2072 | \n2073 |         >>> df = pd.DataFrame({'dates': pd.date_range(\"2017-03-30\",\n2074 |         ...                    periods=4)})\n2075 |         >>> df.assign(quarter=df.dates.dt.quarter,\n2076 |         ...           is_quarter_end=df.dates.dt.is_quarter_end)\n2077 |                dates  quarter    is_quarter_end\n2078 |         0 2017-03-30        1             False\n2079 |         1 2017-03-31        1              True\n2080 |         2 2017-04-01        2             False\n2081 |         3 2017-04-02        2             False\n2082 | \n2083 |         >>> idx = pd.date_range('2017-03-30', periods=4)\n2084 |         >>> idx\n2085 |         DatetimeIndex(['2017-03-30', '2017-03-31', '2017-04-01', '2017-04-02'],\n2086 |                       dtype='datetime64[ns]', freq='D')\n2087 | \n2088 |         >>> idx.is_quarter_end\n2089 |         array([False,  True, False, False])\n2090 |         \"\"\",\n2091 |     )\n2092 |     is_year_start = _field_accessor(\n2093 |         \"is_year_start\",\n2094 |         \"is_year_start\",\n2095 |         \"\"\"\n2096 |         Indicate whether the date is the first day of a year.\n2097 | \n2098 |         Returns\n2099 |         -------\n2100 |         Series or DatetimeIndex\n2101 |             The same type as the original data with boolean values. Series will\n2102 |             have the same name and index. DatetimeIndex will have the same\n2103 |             name.\n2104 | \n2105 |         See Also\n2106 |         --------\n2107 |         is_year_end : Similar property indicating the last day of the year.\n2108 | \n2109 |         Examples\n2110 |         --------\n2111 |         This method is available on Series with datetime values under\n2112 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n2113 | \n2114 |         >>> dates = pd.Series(pd.date_range(\"2017-12-30\", periods=3))\n2115 |         >>> dates\n2116 |         0   2017-12-30\n2117 |         1   2017-12-31\n2118 |         2   2018-01-01\n2119 |         dtype: datetime64[ns]\n2120 | \n2121 |         >>> dates.dt.is_year_start\n2122 |         0    False\n2123 |         1    False\n2124 |         2    True\n2125 |         dtype: bool\n2126 | \n2127 |         >>> idx = pd.date_range(\"2017-12-30\", periods=3)\n2128 |         >>> idx\n2129 |         DatetimeIndex(['2017-12-30', '2017-12-31', '2018-01-01'],\n2130 |                       dtype='datetime64[ns]', freq='D')\n2131 | \n2132 |         >>> idx.is_year_start\n2133 |         array([False, False,  True])\n2134 | \n2135 |         This method, when applied to Series with datetime values under\n2136 |         the ``.dt`` accessor, will lose information about Business offsets.\n2137 | \n2138 |         >>> dates = pd.Series(pd.date_range(\"2020-10-30\", periods=4, freq=\"BYS\"))\n2139 |         >>> dates\n2140 |         0   2021-01-01\n2141 |         1   2022-01-03\n2142 |         2   2023-01-02\n2143 |         3   2024-01-01\n2144 |         dtype: datetime64[ns]\n2145 | \n2146 |         >>> dates.dt.is_year_start\n2147 |         0    True\n2148 |         1    False\n2149 |         2    False\n2150 |         3    True\n2151 |         dtype: bool\n2152 | \n2153 |         >>> idx = pd.date_range(\"2020-10-30\", periods=4, freq=\"BYS\")\n2154 |         >>> idx\n2155 |         DatetimeIndex(['2021-01-01', '2022-01-03', '2023-01-02', '2024-01-01'],\n2156 |                       dtype='datetime64[ns]', freq='BYS-JAN')\n2157 | \n2158 |         >>> idx.is_year_start\n2159 |         array([ True,  True,  True,  True])\n2160 |         \"\"\",\n2161 |     )\n2162 |     is_year_end = _field_accessor(\n2163 |         \"is_year_end\",\n2164 |         \"is_year_end\",\n2165 |         \"\"\"\n2166 |         Indicate whether the date is the last day of the year.\n2167 | \n2168 |         Returns\n2169 |         -------\n2170 |         Series or DatetimeIndex\n2171 |             The same type as the original data with boolean values. Series will\n2172 |             have the same name and index. DatetimeIndex will have the same\n2173 |             name.\n2174 | \n2175 |         See Also\n2176 |         --------\n2177 |         is_year_start : Similar property indicating the start of the year.\n2178 | \n2179 |         Examples\n2180 |         --------\n2181 |         This method is available on Series with datetime values under\n2182 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n2183 | \n2184 |         >>> dates = pd.Series(pd.date_range(\"2017-12-30\", periods=3))\n2185 |         >>> dates\n2186 |         0   2017-12-30\n2187 |         1   2017-12-31\n2188 |         2   2018-01-01\n2189 |         dtype: datetime64[ns]\n2190 | \n2191 |         >>> dates.dt.is_year_end\n2192 |         0    False\n2193 |         1     True\n2194 |         2    False\n2195 |         dtype: bool\n2196 | \n2197 |         >>> idx = pd.date_range(\"2017-12-30\", periods=3)\n2198 |         >>> idx\n2199 |         DatetimeIndex(['2017-12-30', '2017-12-31', '2018-01-01'],\n2200 |                       dtype='datetime64[ns]', freq='D')\n2201 | \n2202 |         >>> idx.is_year_end\n2203 |         array([False,  True, False])\n2204 |         \"\"\",\n2205 |     )\n2206 |     is_leap_year = _field_accessor(\n2207 |         \"is_leap_year\",\n2208 |         \"is_leap_year\",\n2209 |         \"\"\"\n2210 |         Boolean indicator if the date belongs to a leap year.\n2211 | \n2212 |         A leap year is a year, which has 366 days (instead of 365) including\n2213 |         29th of February as an intercalary day.\n2214 |         Leap years are years which are multiples of four with the exception\n2215 |         of years divisible by 100 but not by 400.\n2216 | \n2217 |         Returns\n2218 |         -------\n2219 |         Series or ndarray\n2220 |              Booleans indicating if dates belong to a leap year.\n2221 | \n2222 |         See Also\n2223 |         --------\n2224 |         DatetimeIndex.is_year_end : Indicate whether the date is the\n2225 |             last day of the year.\n2226 |         DatetimeIndex.is_year_start : Indicate whether the date is the first\n2227 |             day of a year.\n2228 | \n2229 |         Examples\n2230 |         --------\n2231 |         This method is available on Series with datetime values under\n2232 |         the ``.dt`` accessor, and directly on DatetimeIndex.\n2233 | \n2234 |         >>> idx = pd.date_range(\"2012-01-01\", \"2015-01-01\", freq=\"YE\")\n2235 |         >>> idx\n2236 |         DatetimeIndex(['2012-12-31', '2013-12-31', '2014-12-31'],\n2237 |                       dtype='datetime64[ns]', freq='YE-DEC')\n2238 |         >>> idx.is_leap_year\n2239 |         array([ True, False, False])\n2240 | \n2241 |         >>> dates_series = pd.Series(idx)\n2242 |         >>> dates_series\n2243 |         0   2012-12-31\n2244 |         1   2013-12-31\n2245 |         2   2014-12-31\n2246 |         dtype: datetime64[ns]\n2247 |         >>> dates_series.dt.is_leap_year\n2248 |         0     True\n2249 |         1    False\n2250 |         2    False\n2251 |         dtype: bool\n2252 |         \"\"\",\n2253 |     )\n2254 | \n2255 |     def to_julian_date(self) -> npt.NDArray[np.float64]:\n2256 |         \"\"\"\n2257 |         Convert Datetime Array to float64 ndarray of Julian Dates.\n2258 |         0 Julian date is noon January 1, 4713 BC.\n2259 |         https://en.wikipedia.org/wiki/Julian_day\n2260 |         \"\"\"\n2261 | \n2262 |         # http://mysite.verizon.net/aesir_research/date/jdalg2.htm\n2263 |         year = np.asarray(self.year)\n2264 |         month = np.asarray(self.month)\n2265 |         day = np.asarray(self.day)\n2266 |         testarr = month < 3\n2267 |         year[testarr] -= 1\n2268 |         month[testarr] += 12\n2269 |         return (\n2270 |             day\n2271 |             + np.fix((153 * month - 457) / 5)\n2272 |             + 365 * year\n2273 |             + np.floor(year / 4)\n2274 |             - np.floor(year / 100)\n2275 |             + np.floor(year / 400)\n2276 |             + 1_721_118.5\n2277 |             + (\n2278 |                 self.hour\n2279 |                 + self.minute / 60\n2280 |                 + self.second / 3600\n2281 |                 + self.microsecond / 3600 / 10**6\n2282 |                 + self.nanosecond / 3600 / 10**9\n2283 |             )\n2284 |             / 24\n2285 |         )\n2286 | \n2287 |     # -----------------------------------------------------------------\n2288 |     # Reductions\n2289 | \n2290 |     def _reduce(\n2291 |         self, name: str, *, skipna: bool = True, keepdims: bool = False, **kwargs\n2292 |     ):\n2293 |         result = super()._reduce(name, skipna=skipna, keepdims=keepdims, **kwargs)\n2294 |         if keepdims and isinstance(result, np.ndarray):\n2295 |             if name == \"std\":\n2296 |                 from pandas.core.arrays import TimedeltaArray\n2297 | \n2298 |                 return TimedeltaArray._from_sequence(result)\n2299 |             else:\n2300 |                 return self._from_sequence(result, dtype=self.dtype)\n2301 |         return result\n2302 | \n2303 |     def std(\n2304 |         self,\n2305 |         axis=None,\n2306 |         dtype=None,\n2307 |         out=None,\n2308 |         ddof: int = 1,\n2309 |         keepdims: bool = False,\n2310 |         skipna: bool = True,\n2311 |     ) -> Timedelta:\n2312 |         \"\"\"\n2313 |         Return sample standard deviation over requested axis.\n2314 | \n2315 |         Normalized by `N-1` by default. This can be changed using ``ddof``.\n2316 | \n2317 |         Parameters\n2318 |         ----------\n2319 |         axis : int, optional\n2320 |             Axis for the function to be applied on. For :class:`pandas.Series`\n2321 |             this parameter is unused and defaults to ``None``.\n2322 |         dtype : dtype, optional, default None\n2323 |             Type to use in computing the standard deviation. For arrays of\n2324 |             integer type the default is float64, for arrays of float types\n2325 |             it is the same as the array type.\n2326 |         out : ndarray, optional, default None\n2327 |             Alternative output array in which to place the result. It must have\n2328 |             the same shape as the expected output but the type (of the\n2329 |             calculated values) will be cast if necessary.\n2330 |         ddof : int, default 1\n2331 |             Degrees of Freedom. The divisor used in calculations is `N - ddof`,\n2332 |             where `N` represents the number of elements.\n2333 |         keepdims : bool, optional\n2334 |             If this is set to True, the axes which are reduced are left in the\n2335 |             result as dimensions with size one. With this option, the result\n2336 |             will broadcast correctly against the input array. If the default\n2337 |             value is passed, then keepdims will not be passed through to the\n2338 |             std method of sub-classes of ndarray, however any non-default value\n2339 |             will be. If the sub-class method does not implement keepdims any\n2340 |             exceptions will be raised.\n2341 |         skipna : bool, default True\n2342 |             Exclude NA/null values. If an entire row/column is ``NA``, the result\n2343 |             will be ``NA``.\n2344 | \n2345 |         Returns\n2346 |         -------\n2347 |         Timedelta\n2348 |             Standard deviation over requested axis.\n2349 | \n2350 |         See Also\n2351 |         --------\n2352 |         numpy.ndarray.std : Returns the standard deviation of the array elements\n2353 |             along given axis.\n2354 |         Series.std : Return sample standard deviation over requested axis.\n2355 | \n2356 |         Examples\n2357 |         --------\n2358 |         For :class:`pandas.DatetimeIndex`:\n2359 | \n2360 |         >>> idx = pd.date_range(\"2001-01-01 00:00\", periods=3)\n2361 |         >>> idx\n2362 |         DatetimeIndex(['2001-01-01', '2001-01-02', '2001-01-03'],\n2363 |                       dtype='datetime64[ns]', freq='D')\n2364 |         >>> idx.std()\n2365 |         Timedelta('1 days 00:00:00')\n2366 |         \"\"\"\n2367 |         # Because std is translation-invariant, we can get self.std\n2368 |         #  by calculating (self - Timestamp(0)).std, and we can do it\n2369 |         #  without creating a copy by using a view on self._ndarray\n2370 |         from pandas.core.arrays import TimedeltaArray\n2371 | \n2372 |         # Find the td64 dtype with the same resolution as our dt64 dtype\n2373 |         dtype_str = self._ndarray.dtype.name.replace(\"datetime64\", \"timedelta64\")\n2374 |         dtype = np.dtype(dtype_str)\n2375 | \n2376 |         tda = TimedeltaArray._simple_new(self._ndarray.view(dtype), dtype=dtype)\n2377 | \n2378 |         return tda.std(axis=axis, out=out, ddof=ddof, keepdims=keepdims, skipna=skipna)\n```\n\n\n##Searching for entity `pandas/core/series.py:Series.round`...\n### Search Result:\nFound function `pandas/core/series.py:Series.round`.\nSource: Exact match found for entity name `pandas/core/series.py:Series.round`.\n```\n2463 | def round(self, decimals: int = 0, *args, **kwargs) -> Series:\n2464 |         \"\"\"\n2465 |  