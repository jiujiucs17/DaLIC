dtype=np.float64, copy=self.copy, ensure_2d=False\n1009 |         )\n1010 |         if Y.ndim == 1:\n1011 |             Y = Y.reshape(-1, 1)\n1012 | \n1013 |         # we'll compute the SVD of the cross-covariance matrix = X.T.dot(Y)\n1014 |         # This matrix rank is at most min(n_samples, n_features, n_targets) so\n1015 |         # n_components cannot be bigger than that.\n1016 |         n_components = self.n_components\n1017 |         rank_upper_bound = min(X.shape[0], X.shape[1], Y.shape[1])\n1018 |         if n_components > rank_upper_bound:\n1019 |             raise ValueError(\n1020 |                 f\"`n_components` upper bound is {rank_upper_bound}. \"\n1021 |                 f\"Got {n_components} instead. Reduce `n_components`.\"\n1022 |             )\n1023 | \n1024 |         X, Y, self._x_mean, self._y_mean, self._x_std, self._y_std = _center_scale_xy(\n1025 |             X, Y, self.scale\n1026 |         )\n1027 | \n1028 |         # Compute SVD of cross-covariance matrix\n1029 |         C = np.dot(X.T, Y)\n1030 |         U, s, Vt = svd(C, full_matrices=False)\n1031 |         U = U[:, :n_components]\n1032 |         Vt = Vt[:n_components]\n1033 |         U, Vt = svd_flip(U, Vt)\n1034 |         V = Vt.T\n1035 | \n1036 |         self.x_weights_ = U\n1037 |         self.y_weights_ = V\n1038 |         self._n_features_out = self.x_weights_.shape[1]\n1039 |         return self\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.transform`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1041 | def transform(self, X, Y=None):\n1042 |         \"\"\"\n1043 |         Apply the dimensionality reduction.\n1044 | \n1045 |         Parameters\n1046 |         ----------\n1047 |         X : array-like of shape (n_samples, n_features)\n1048 |             Samples to be transformed.\n1049 | \n1050 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets), \\\n1051 |                 default=None\n1052 |             Targets.\