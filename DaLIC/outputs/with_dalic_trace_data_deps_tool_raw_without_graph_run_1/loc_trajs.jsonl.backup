   'variance_weighted'] or None\n 69 |         None is accepted due to backward compatibility of r2_score().\n 70 | \n 71 |     dtype : str or list, default=\"numeric\"\n 72 |         the dtype argument passed to check_array.\n 73 | \n 74 |     xp : module, default=None\n 75 |         Precomputed array namespace module. When passed, typically from a caller\n 76 |         that has already performed inspection of its own inputs, skips array\n 77 |         namespace inspection.\n 78 | \n 79 |     Returns\n 80 |     -------\n 81 |     type_true : one of {'continuous', continuous-multioutput'}\n 82 |         The type of the true target data, as output by\n 83 |         'utils.multiclass.type_of_target'.\n 84 | \n 85 |     y_true : array-like of shape (n_samples, n_outputs)\n 86 |         Ground truth (correct) target values.\n 87 | \n 88 |     y_pred : array-like of shape (n_samples, n_outputs)\n 89 |         Estimated target values.\n 90 | \n 91 |     multioutput : array-like of shape (n_outputs) or string in ['raw_values',\n 92 |         uniform_average', 'variance_weighted'] or None\n 93 |         Custom output weights if ``multioutput`` is array-like or\n 94 |         just the corresponding argument if ``multioutput`` is a\n 95 |         correct keyword.\n 96 |     \"\"\"\n 97 |     xp, _ = get_namespace(y_true, y_pred, multioutput, xp=xp)\n 98 | \n 99 |     check_consistent_length(y_true, y_pred)\n100 |     y_true = check_array(y_true, ensure_2d=False, dtype=dtype)\n101 |     y_pred = check_array(y_pred, ensure_2d=False, dtype=dtype)\n102 | \n103 |     if y_true.ndim == 1:\n104 |         y_true = xp.reshape(y_true, (-1, 1))\n105 | \n106 |     if y_pred.ndim == 1:\n107 |         y_pred = xp.reshape(y_pred, (-1, 1))\n108 | \n109 |     if y_true.shape[1] != y_pred.shape[1]:\n110 |         raise ValueError(\n111 |             \"y_true and y_pred have different number of output ({0}!={1})\".format(\n112 |                 y_true.shape[1], y_pred.shape[1]\n113 |             )\n114 |         )\n115 | \n116 |     n_outputs = y_true.shape[1]\n117 |     allowed_multioutput_str = (\"raw_values\", \"uniform_average\", \"variance_weighted\")\n118 |     if isinstance(multioutput, str):\n119 |         if multioutput not in allowed_multioutput_str:\n120 |             raise ValueError(\n121 |                 \"Allowed 'multioutput' string values are {}. \"\n122 |                 \"You provided multioutput={!r}\".format(\n123 |                     allowed_multioutput_str, multioutput\n124 |                 )\n125 |             )\n126 |     elif multioutput is not None:\n127 |         multioutput = check_array(multioutput, ensure_2d=False)\n128 |         if n_outputs == 1:\n129 |             raise ValueError(\"Custom weights are useful only in multi-output cases.\")\n130 |         elif n_outputs != multioutput.shape[0]:\n131 |             raise ValueError(\n132 |                 \"There must be equally many custom weights \"\n133 |                 f\"({multioutput.shape[0]}) as outputs ({n_outputs}).\"\n134 |             )\n135 |     y_type = \"continuous\" if n_outputs == 1 else \"continuous-multioutput\"\n136 | \n137 |     return y_type, y_true, y_pred, multioutput\n```\n"}, {"content": "Let me search for the `_find_matching_floating_dtype` function since it's mentioned in the issue:\n\n<function=search_code_snippets>\n<parameter=search_terms>['_find_matching_floating_dtype']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"_find_matching_floating_dtype\"...\n### Search Result:\nFound function `sklearn/utils/_array_api.py:_find_matching_floating_dtype`.\nSource: Match found for entity name `_find_matching_floating_dtype`.\n```\n673 | def _find_matching_floating_dtype(*arrays, xp):\n674 |     \"\"\"Find a suitable floating point dtype when computing with arrays.\n675 | \n676 |     If any of the arrays are floating point, return the dtype with the highest\n677 |     precision by following official type promotion rules:\n678 | \n679 |     https://data-apis.org/array-api/latest/API_specification/type_promotion.html\n680 | \n681 |     If there are no floating point input arrays (all integral inputs for\n682 |     instance), return the default floating point dtype for the namespace.\n683 |     \"\"\"\n684 |     dtyped_arrays = [a for a in arrays if hasattr(a, \"dtype\")]\n685 |     floating_dtypes = [\n686 |         a.dtype for a in dtyped_arrays if xp.isdtype(a.dtype, \"real floating\")\n687 |     ]\n688 |     if floating_dtypes:\n689 |         # Return the floating dtype with the highest precision:\n690 |         return xp.result_type(*floating_dtypes)\n691 | \n692 |     # If none of the input arrays have a floating point dtype, they must be all\n693 |     # integer arrays or containers of Python scalars: return the default\n694 |     # floating point dtype for the namespace (implementation specific).\n695 |     return xp.asarray(0.0).dtype\n```\n"}, {"content": "Let me also check for the test file mentioned:\n\n<function=search_code_snippets>\n<parameter=search_terms>['test_regression.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\nNo results for test files: `test_regression.py`. Please do not search for any test files.\n"}, {"content": "Let me get more details about the data dependency relationships:\n\n<function=get_trace_data_dependencies>\n<parameter=symbol_contains>['_check_reg_targets', '_find_matching_floating_dtype']</parameter>\n<parameter=edge_type>data</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "get_trace_data_dependencies", "content": "OBSERVATION:\n{\n  \"instance_id\": \"scikit-learn__scikit-learn-30128\",\n  \"