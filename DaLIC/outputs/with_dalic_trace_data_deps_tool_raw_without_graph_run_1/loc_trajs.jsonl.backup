xamples/applications/plot_model_complexity_influence.py:benchmark_influence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n107 | def benchmark_influence(conf):\n108 |     \"\"\"\n109 |     Benchmark influence of `changing_param` on both MSE and latency.\n110 |     \"\"\"\n111 |     prediction_times = []\n112 |     prediction_powers = []\n113 |     complexities = []\n114 |     for param_value in conf[\"changing_param_values\"]:\n115 |         conf[\"tuned_params\"][conf[\"changing_param\"]] = param_value\n116 |         estimator = conf[\"estimator\"](**conf[\"tuned_params\"])\n117 | \n118 |         print(\"Benchmarking %s\" % estimator)\n119 |         estimator.fit(conf[\"data\"][\"X_train\"], conf[\"data\"][\"y_train\"])\n120 |         conf[\"postfit_hook\"](estimator)\n121 |         complexity = conf[\"complexity_computer\"](estimator)\n122 |         complexities.append(complexity)\n123 |         start_time = time.time()\n124 |         for _ in range(conf[\"n_samples\"]):\n125 |             y_pred = estimator.predict(conf[\"data\"][\"X_test\"])\n126 |         elapsed_time = (time.time() - start_time) / float(conf[\"n_samples\"])\n127 |         prediction_times.append(elapsed_time)\n128 |         pred_score = conf[\"prediction_performance_computer\"](\n129 |             conf[\"data\"][\"y_test\"], y_pred\n130 |         )\n131 |         prediction_powers.append(pred_score)\n132 |         print(\n133 |             \"Complexity: %d | %s: %.4f | Pred. Time: %fs\\n\"\n134 |             % (\n135 |                 complexity,\n136 |                 conf[\"prediction_performance_label\"],\n137 |                 pred_score,\n138 |                 elapsed_time,\n139 |             )\n140 |         )\n141 |     return prediction_powers, prediction_times, complexities\n```\n\nFound function `examples/applications/plot_model_complexity_influence.py:_count_nonzero_coefficients`.\nSource: Retrieved code content using keyword search (bm25).\n```\n159 | def _cou