alled ensure_wrapped_if_datetimelike because fastparquet\n 255 |         #  relied on it, as of 2.0 the caller is responsible for this.\n 256 |         if placement is None:\n 257 |             placement = self._mgr_locs\n 258 | \n 259 |         # We assume maybe_coerce_values has already been called\n 260 |         return type(self)(values, placement=placement, ndim=self.ndim, refs=refs)\n 261 | \n 262 |     @final\n 263 |     def __repr__(self) -> str:\n 264 |         # don't want to print out all of the items here\n 265 |         name = type(self).__name__\n 266 |         if self.ndim == 1:\n 267 |             result = f\"{name}: {len(self)} dtype: {self.dtype}\"\n 268 |         else:\n 269 |             shape = \" x \".join([str(s) for s in self.shape])\n 270 |             result = f\"{name}: {self.mgr_locs.indexer}, {shape}, dtype: {self.dtype}\"\n 271 | \n 272 |         return result\n 273 | \n 274 |     @final\n 275 |     def __len__(self) -> int:\n 276 |         return len(self.values)\n 277 | \n 278 |     @final\n 279 |     def slice_block_columns(self, slc: slice) -> Self:\n 280 |         \"\"\"\n 281 |         Perform __getitem__-like, return result as block.\n 282 |         \"\"\"\n 283 |         new_mgr_locs = self._mgr_locs[slc]\n 284 | \n 285 |         new_values = self._slice(slc)\n 286 |         refs = self.refs\n 287 |         return type(self)(new_values, new_mgr_locs, self.ndim, refs=refs)\n 288 | \n 289 |     @final\n 290 |     def take_block_columns(self, indices: npt.NDArray[np.intp]) -> Self:\n 291 |         \"\"\"\n 292 |         Perform __getitem__-like, return result as block.\n 293 | \n 294 |         Only supports slices that preserve dimensionality.\n 295 |         \"\"\"\n 296 |         # Note: only called from is from internals.concat, and we can verify\n 297 |         #  that never happens with 1-column blocks, i.e. never for ExtensionBlock.\n 298 | \n 299 |         new_mgr_locs = self._mgr_locs[indices]\n 300 | \n 301 |         new_values = self._slice(indices)\n 302 |         return type(self)(new_values, new_mgr_locs, self.ndim, refs=None)\n 303 | \n 304 |     @final\n 305 |     def getitem_block_columns(\n 306 |         self, slicer: slice, new_mgr_locs: BlockPlacement, ref_inplace_op: bool = False\n 307 |     ) -> Self:\n 308 |         \"\"\"\n 309 |         Perform __getitem__-like, return result as block.\n 310 | \n 311 |         Only supports slices that preserve dimensionality.\n 312 |         \"\"\"\n 313 |         new_values = self._slice(slicer)\n 314 |         refs = self.refs if not ref_inplace_op or self.refs.has_reference() else None\n 315 |         return type(self)(new_values, new_mgr_locs, self.ndim, refs=refs)\n 316 | \n 317 |     @final\n 318 |     def _can_hold_element(self, element: Any) -> bool:\n 319 |         \"\"\"require the same dtype as ourselves\"\"\"\n 320 |         element = extract_array(element, extract_numpy=True)\n 321 |         return can_hold_element(self.values, element)\n 322 | \n 323 |     @final\n 324 |     def should_store(self, value: ArrayLike) -> bool:\n 325 |         \"\"\"\n 326 |         Should we set self.values[indexer] = value inplace or do we need to cast?\n 327 | \n 328 |         Parameters\n 329 |         ----------\n 330 |         value : np.ndarray or ExtensionArray\n 331 | \n 332 |         Returns\n 333 |         -------\n 334 |         bool\n 335 |         \"\"\"\n 336 |         return value.dtype == self.dtype\n 337 | \n 338 |     # ---------------------------------------------------------------------\n 339 |     # Apply/Reduce and Helpers\n 340 | \n 341 |     @final\n 342 |     def apply(self, func, **kwargs) -> list[Block]:\n 343 |         \"\"\"\n 344 |         apply the function to my values; return a block if we are not\n 345 |         one\n 346 |         \"\"\"\n 347 |         result = func(self.values, **kwargs)\n 348 | \n 349 |         result = maybe_coerce_values(result)\n 350 |         return self._split_op_result(result)\n 351 | \n 352 |     @final\n 353 |     def reduce(self, func) -> list[Block]:\n 354 |         # We will apply the function and reshape the result into a single-row\n 355 |         #  Block with the same mgr_locs; squeezing will be done at a higher level\n 356 |         assert self.ndim == 2\n 357 | \n 358 |         result = func(self.values)\n 359 | \n 360 |         if self.values.ndim == 1:\n 361 |             res_values = result\n 362 |         else:\n 363 |             res_values = result.reshape(-1, 1)\n 364 | \n 365 |         nb = self.make_block(res_values)\n 366 |         return [nb]\n 367 | \n 368 |     @final\n 369 |     def _split_op_result(self, result: ArrayLike) -> list[Block]:\n 370 |         # See also: split_and_operate\n 371 |         if result.ndim > 1 and isinstance(result.dtype, ExtensionDtype):\n 372 |             # TODO(EA2D): unnecessary with 2D EAs\n 373 |             # if we get a 2D ExtensionArray, we need to split it into 1D pieces\n 374 |             nbs = []\n 375 |             for i, loc in enumerate(self._mgr_locs):\n 376 |                 if not is_1d_only_ea_dtype(result.dtype):\n 377 |                     vals = result[i : i + 1]\n 378 |                 else:\n 379 |                     vals = result[i]\n 380 | \n 381 |                 bp = BlockPlacement(loc)\n 382 |                 block = self.make_block(values=vals, placement=bp)\n 383 |                 nbs.append(block)\n 384 |             return nbs\n 385 | \n 386 |         nb = self.make_block(result)\n 387 | \n 388 |         return [nb]\n 389 | \n 390 |     @final\n 391 |     def _split(self) -> Generator[Block]:\n 392 |         \"\"\"\n 393 |         Split a block into a list of single-column blocks.\n 394 |         \"\"\"\n 395 |         assert self.ndim == 2\n 396 | \n 397 |         for i, ref_loc in enumerate(self._mgr_locs):\n 398 |             vals = self.values[slice(i, i + 1)]\n 399 | \n 400 |             bp = BlockPlacement(ref_loc)\n 401 |             nb = type(self)(vals, placement=bp, ndim=2, refs=self.refs)\n 402 |             yield nb\n 403 | \n 404 |     @final\n 405 |     def split_and_operate(self, func, *args, **kwargs) -> list[Block]:\n 406 |         \"\"\"\n 407 |         Split the block and apply func column-by-column.\n 408 | \n 409 |         Parameters\n 410 |         ----------\n 411 |         func : Block method\n 412 |         *args\n 413 |         **kwargs\n 414 | \n 415 |         Returns\n 416 |         -------\n 417 |         List[Block]\n 418 |         \"\"\"\n 419 |         assert self.ndim == 2 and self.shape[0] != 1\n 420 | \n 421 |         res_blocks = []\n 422 |         for nb in self._split():\n 423 |             rbs = func(nb, *args, **kwargs)\n 424 |             res_blocks.extend(rbs)\n 425 |         return res_blocks\n 426 | \n 427 |     # ---------------------------------------------------------------------\n 428 |     # Up/Down-casting\n 429 | \n 430 |     @final\n 431 |     def coerce_to_target_dtype(self, other, raise_on_upcast: bool) -> Block:\n 432 |         \"\"\"\n 433 |         coerce the current block to a dtype compat for other\n 434 |         we will return a block, possibly object, and not raise\n 435 | \n 436 |         we can also safely try to coerce to the same dtype\n 437 |         and will receive the same block\n 438 |         \"\"\"\n 439 |         new_dtype = find_result_type(self.values.dtype, other)\n 440 |         if new_dtype == self.dtype:\n 441 |             # GH#52927 avoid RecursionError\n 442 |             raise AssertionError(\n 443 |                 \"Something has gone wrong, please report a bug at \"\n 444 |                 \"https://github.com/pandas-dev/pandas/issues\"\n 445 |             )\n 446 | \n 447 |         # In a future version of pandas, the default will be that\n 448 |         # setting `nan` into an integer series won't raise.\n 449 |         if (\n 450 |             is_scalar(other)\n 451 |             and is_integer_dtype(self.values.dtype)\n 452 |             and isna(other)\n 453 |             and other is not NaT\n 454 |             and not (\n 455 |                 isinstance(other, (np.datetime64, np.timedelta64)) and np.isnat(other)\n 456 |             )\n 457 |         ):\n 458 |             raise_on_upcast = False\n 459 |         elif (\n 460 |             isinstance(other, np.ndarray)\n 461 |             and other.ndim == 1\n 462 |             and is_integer_dtype(self.values.dtype)\n 463 |             and is_float_dtype(other.dtype)\n 464 |             and lib.has_only_ints_or_nan(other)\n 465 |         ):\n 466 |             raise_on_upcast = False\n 467 | \n 468 |         if raise_on_upcast:\n 469 |             raise TypeError(f\"Invalid value '{other}' for dtype '{self.values.dtype}'\")\n 470 |         if self.values.dtype == new_dtype:\n 471 |             raise AssertionError(\n 472 |                 f\"Did not expect new dtype {new_dtype} to equal self.dtype \"\n 473 |                 f\"{self.values.dtype}. Please report a bug at \"\n 474 |                 \"https://github.com/pandas-dev/pandas/issues.\"\n 475 |             )\n 476 |         try:\n 477 |             return self.astype(new_dtype)\n 478 |         except OutOfBoundsDatetime as err:\n 479 |             # e.g. GH#56419 if self.dtype is a low-resolution dt64 and we try to\n 480 |             #  upcast to a higher-resolution dt64, we may have entries that are\n 481 |             #  out of bounds for the higher resolution.\n 482 |             #  Re-raise with a more informative message.\n 483 |             raise OutOfBoundsDatetime(\n 484 |                 f\"Incompatible (high-resolution) value for dtype='{self.dtype}'. \"\n 485 |                 \"Explicitly cast before operating.\"\n 486 |             ) from err\n 487 | \n 488 |     @final\n 489 |     def convert(self) -> list[Block]:\n 490 |         \"\"\"\n 491 |         Attempt to coerce any object types to better types. Return a copy\n 492 |         of the block (if copy = True).\n 493 |         \"\"\"\n 494 |         if not self.is_object:\n 495 |             return [self.copy(deep=False)]\n 496 | \n 497 |         if self.ndim != 1 and self.shape[0] != 1:\n 498 |             blocks = self.split_and_operate(Block.convert)\n 499 |             if all(blk.dtype.kind == \"O\" for blk in blocks):\n 500 |                 # Avoid fragmenting the block if convert is a no-op\n 501 |                 return [self.copy(deep=False)]\n 502 |             return blocks\n 503 | \n 504 |         values = self.values\n 505 |         if values.ndim == 2:\n 506 |             # the check above ensures we only get here with values.shape[0] == 1,\n 507 |             # avoid doing .ravel as that might make a copy\n 508 |             values = values[0]\n 509 | \n 510 |         res_values = lib.maybe_convert_objects(\n 511 |             values,  # type: ignore[arg-type]\n 512 |             convert_non_numeric=True,\n 513 |         )\n 514 |         refs = None\n 515 |         if (\n 516 |             res_values is values\n 517 |             or isinstance(res_values, NumpyExtensionArray)\n 518 |             and res_values._ndarray is values\n 519 |         ):\n 520 |             refs = self.refs\n 521 | \n 522 |         res_values = ensure_block_shape(res_values, self.ndim)\n 523 |         res_values = maybe_coerce_values(res_values)\n 524 |         return [self.make_block(res_values, refs=refs)]\n 525 | \n 526 |     def convert_dtypes(\n 527 |         self,\n 528 |         infer_objects: bool = True,\n 529 |         convert_string: bool = True,\n 530 |         convert_integer: bool = True,\n 531 |         convert_boolean: bool = True,\n 532 |         convert_floating: bool = True,\n 533 |         dtype_backend: DtypeBackend = \"numpy_nullable\",\n 534 |     ) -> list[Block]:\n 535 |         if infer_objects and self.is_object:\n 536 |             blks = self.convert()\n 537 |         else:\n 538 |             blks = [self]\n 539 | \n 540 |         if not any(\n 541 |             [convert_floating, convert_integer, convert_boolean, convert_string]\n 542 |         ):\n 543 |             return [b.copy(deep=False) for b in blks]\n 544 | \n 545 |         rbs = []\n 546 |         for blk in blks:\n 547 |             # Determine dtype column by column\n 548 |             sub_blks = (\n 549 |                 [blk] if blk.ndim == 1 or self.shape[0] == 1 else list(blk._split())\n 550 |             )\n 551 |             dtypes = [\n 552 |                 convert_dtypes(\n 553 |                     b.values,\n 554 |                     convert_string,\n 555 |                     convert_integer,\n 556 |                     convert_boolean,\n 557 |                     convert_floating,\n 558 |                     infer_objects,\n 559 |                     dtype_backend,\n 560 |                 )\n 561 |                 for b in sub_blks\n 562 |             ]\n 563 |             if all(dtype == self.dtype for dtype in dtypes):\n 564 |                 # Avoid block splitting if no dtype changes\n 565 |                 rbs.append(blk.copy(deep=False))\n 566 |                 continue\n 567 | \n 568 |             for dtype, b in zip(dtypes, sub_blks):\n 569 |                 rbs.append(b.astype(dtype=dtype, squeeze=b.ndim != 1))\n 570 |         return rbs\n 571 | \n 572 |     # ---------------------------------------------------------------------\n 573 |     # Array-Like Methods\n 574 | \n 575 |     @final\n 576 |     @cache_readonly\n 577 |     def dtype(self) -> DtypeObj:\n 578 |         return self.values.dtype\n 579 | \n 580 |     @final\n 581 |     def astype(\n 582 |         self,\n 583 |         dtype: DtypeObj,\n 584 |         errors: IgnoreRaise = \"raise\",\n 585 |         squeeze: bool = False,\n 586 |     ) -> Block:\n 587 |         \"\"\"\n 588 |         Coerce to the new dtype.\n 589 | \n 590 |         Parameters\n 591 |         ----------\n 592 |         dtype : np.dtype or ExtensionDtype\n 593 |         errors : str, {'raise', 'ignore'}, default 'raise'\n 594 |             - ``raise`` : allow exceptions to be raised\n 595 |             - ``ignore`` : suppress exceptions. On error return original object\n 596 |         squeeze : bool, default False\n 597 |             squeeze values to ndim=1 if only one column is given\n 598 | \n 599 |         Returns\n 600 |         -------\n 601 |         Block\n 602 |         \"\"\"\n 603 |         values = self.values\n 604 |         if squeeze and values.ndim == 2 and is_1d_only_ea_dtype(dtype):\n 605 |             if values.shape[0] != 1:\n 606 |                 raise ValueError(\"Can not squeeze with more than one column.\")\n 607 |             values = values[0, :]  # type: ignore[call-overload]\n 608 | \n 609 |         new_values = astype_array_safe(values, dtype, errors=errors)\n 610 | \n 611 |         new_values = maybe_coerce_values(new_values)\n 612 | \n 613 |         refs = None\n 614 |         if astype_is_view(values.dtype, new_values.dtype):\n 615 |             refs = self.refs\n 616 | \n 617 |         newb = self.make_block(new_values, refs=refs)\n 618 |         if newb.shape != self.shape:\n 619 |             raise TypeError(\n 620 |                 f\"cannot set astype for dtype \"\n 621 |                 f\"({self.dtype.name} [{self.shape}]) to different shape \"\n 622 |                 f\"({newb.dtype.name} [{newb.shape}])\"\n 623 |             )\n 624 |         return newb\n 625 | \n 626 |     @final\n 627 |     def get_values_for_csv(\n 628 |         self, *, float_format, date_format, decimal, na_rep: str = \"nan\", quoting=None\n 629 |     ) -> Block:\n 630 |         \"\"\"convert to our native types format\"\"\"\n 631 |         result = get_values_for_csv(\n 632 |             self.values,\n 633 |             na_rep=na_rep,\n 634 |             quoting=quoting,\n 635 |             float_format=float_format,\n 636 |             date_format=date_format,\n 637 |             decimal=decimal,\n 638 |         )\n 639 |         return self.make_block(result)\n 640 | \n 641 |     @final\n 642 |     def copy(self, deep: bool = True) -> Self:\n 643 |         \"\"\"copy constructor\"\"\"\n 644 |         values = self.values\n 645 |         refs: BlockValuesRefs | None\n 646 |         if deep:\n 647 |             values = values.copy()\n 648 |             refs = None\n 649 |         else:\n 650 |             refs = self.refs\n 651 |         return type(self)(values, placement=self._mgr_locs, ndim=self.ndim, refs=refs)\n 652 | \n 653 |     # ---------------------------------------------------------------------\n 654 |     # Copy-on-Write Helpers\n 655 | \n 656 |     def _maybe_copy(self, inplace: bool) -> Self:\n 657 |         if inplace:\n 658 |             deep = self.refs.has_reference()\n 659 |             return self.copy(deep=deep)\n 660 |         return self.copy()\n 661 | \n 662 |     @final\n 663 |     def _get_refs_and_copy(self, inplace: bool):\n 664 |         refs = None\n 665 |         copy = not inplace\n 666 |         if inplace:\n 667 |             if self.refs.has_reference():\n 668 |                 copy = True\n 669 |             else:\n 670 |                 refs = self.refs\n 671 |         return copy, refs\n 672 | \n 673 |     # ---------------------------------------------------------------------\n 674 |     # Replace\n 675 | \n 676 |     @final\n 677 |     def replace(\n 678 |         self,\n 679 |         to_replace,\n 680 |         value,\n 681 |         inplace: bool = False,\n 682 |         # mask may be pre-computed if we're called from replace_list\n 683 |         mask: npt.NDArray[np.bool_] | None = None,\n 684 |     ) -> list[Block]:\n 685 |         \"\"\"\n 686 |         replace the to_replace value with value, possible to create new\n 687 |         blocks here this is just a call to putmask.\n 688 |         \"\"\"\n 689 | \n 690 |         # Note: the checks we do in NDFrame.replace ensure we never get\n 691 |         #  here with listlike to_replace or value, as those cases\n 692 |         #  go through replace_list\n 693 |         values = self.values\n 694 | \n 695 |         if not self._can_hold_element(to_replace):\n 696 |             # We cannot hold `to_replace`, so we know immediately that\n 697 |             #  replacing it is a no-op.\n 698 |             # Note: If to_replace were a list, NDFrame.replace would call\n 699 |             #  replace_list instead of replace.\n 700 |             return [self.copy(deep=False)]\n 701 | \n 702 |         if mask is None:\n 703 |             mask = missing.mask_missing(values, to_replace)\n 704 |         if not mask.any():\n 705 |             # Note: we get here with test_replace_extension_other incorrectly\n 706 |             #  bc _can_hold_element is incorrect.\n 707 |             return [self.copy(deep=False)]\n 708 | \n 709 |         elif self._can_hold_element(value):\n 710 |             # TODO(CoW): Maybe split here as well into columns where mask has True\n 711 |             # and rest?\n 712 |             blk = self._maybe_copy(inplace)\n 713 |             putmask_inplace(blk.values, mask, value)\n 714 |             return [blk]\n 715 | \n 716 |         elif self.ndim == 1 or self.shape[0] == 1:\n 717 |             if value is None or value is NA:\n 718 |                 blk = self.astype(np.dtype(object))\n 719 |             else:\n 720 |                 blk = self.coerce_to_target_dtype(value, raise_on_upcast=False)\n 721 |             return blk.replace(\n 722 |                 to_replace=to_replace,\n 723 |                 value=value,\n 724 |                 inplace=True,\n 725 |                 mask=mask,\n 726 |             )\n 727 | \n 728 |         else:\n 729 |             # split so that we only upcast where necessary\n 730 |             blocks = []\n 731 |             for i, nb in enumerate(self._split()):\n 732 |                 blocks.extend(\n 733 |                     type(self).replace(\n 734 |                         nb,\n 735 |                         to_replace=to_replace,\n 736 |                         value=value,\n 737 |                         inplace=True,\n 738 |                         mask=mask[i : i + 1],\n 739 |                     )\n 740 |                 )\n 741 |             return blocks\n 742 | \n 743 |     @final\n 744 |     def _replace_regex(\n 745 |         self,\n 746 |         to_replace,\n 747 |         value,\n 748 |         inplace: bool = False,\n 749 |         mask=None,\n 750 |     ) -> list[Block]:\n 751 |         \"\"\"\n 752 |         Replace elements by the given value.\n 753 | \n 754 |         Parameters\n 755 |         ----------\n 756 |         to_replace : object or pattern\n 757 |             Scalar to replace or regular expression to match.\n 758 |         value : object\n 759 |             Replacement object.\n 760 |         inplace : bool, default False\n 761 |             Perform inplace modification.\n 762 |         mask : array-like of bool, optional\n 763 |             True indicate corresponding element is ignored.\n 764 | \n 765 |         Returns\n 766 |         -------\n 767 |         List[Block]\n 768 |         \"\"\"\n 769 |         if not self._can_hold_element(to_replace):\n 770 |             # i.e. only if self.is_object is True, but could in principle include a\n 771 |             #  String ExtensionBlock\n 772 |             return [self.copy(deep=False)]\n 773 | \n 774 |         rx = re.compile(to_replace)\n 775 | \n 776 |         block = self._maybe_copy(inplace)\n 777 | \n 778 |         replace_regex(block.values, rx, value, mask)\n 779 |         return [block]\n 780 | \n 781 |     @final\n 782 |     def replace_list(\n 783 |         self,\n 784 |         src_list: Iterable[Any],\n 785 |         dest_list: Sequence[Any],\n 786 |         inplace: bool = False,\n 787 |         regex: bool = False,\n 788 |     ) -> list[Block]:\n 789 |         \"\"\"\n 790 |         See BlockManager.replace_list docstring.\n 791 |         \"\"\"\n 792 |         values = self.values\n 793 | \n 794 |         # Exclude anything that we know we won't contain\n 795 |         pairs = [\n 796 |             (x, y) for x, y in zip(src_list, dest_list) if self._can_hold_element(x)\n 797 |         ]\n 798 |         if not len(pairs):\n 799 |             return [self.copy(deep=False)]\n 800 | \n 801 |         src_len = len(pairs) - 1\n 802 | \n 803 |         if is_string_dtype(values.dtype):\n 804 |             # Calculate the mask once, prior to the call of comp\n 805 |             # in order to avoid repeating the same computations\n 806 |             na_mask = ~isna(values)\n 807 |             masks: Iterable[npt.NDArray[np.bool_]] = (\n 808 |                 extract_bool_array(\n 809 |                     cast(\n 810 |                         ArrayLike,\n 811 |                         compare_or_regex_search(\n 812 |                             values, s[0], regex=regex, mask=na_mask\n 813 |                         ),\n 814 |                     )\n 815 |                 )\n 816 |                 for s in pairs\n 817 |             )\n 818 |         else:\n 819 |             # GH#38086 faster if we know we dont need to check for regex\n 820 |             masks = (missing.mask_missing(values, s[0]) for s in pairs)\n 821 |         # Materialize if inplace = True, since the masks can change\n 822 |         # as we replace\n 823 |         if inplace:\n 824 |             masks = list(masks)\n 825 | \n 826 |         # Don't set up refs here, otherwise we will think that we have\n 827 |         # references when we check again later\n 828 |         rb = [self]\n 829 | \n 830 |         for i, ((src, dest), mask) in enumerate(zip(pairs, masks)):\n 831 |             new_rb: list[Block] = []\n 832 | \n 833 |             # GH-39338: _replace_coerce can split a block into\n 834 |             # single-column blocks, so track the index so we know\n 835 |             # where to index into the mask\n 836 |             for blk_num, blk in enumerate(rb):\n 837 |                 if len(rb) == 1:\n 838 |                     m = mask\n 839 |                 else:\n 840 |                     mib = mask\n 841 |                     assert not isinstance(mib, bool)\n 842 |                     m = mib[blk_num : blk_num + 1]\n 843 | \n 844 |                 # error: Argument \"mask\" to \"_replace_coerce\" of \"Block\" has\n 845 |                 # incompatible type \"Union[ExtensionArray, ndarray[Any, Any], bool]\";\n 846 |                 # expected \"ndarray[Any, dtype[bool_]]\"\n 847 |                 result = blk._replace_coerce(\n 848 |                     to_replace=src,\n 849 |                     value=dest,\n 850 |                     mask=m,\n 851 |                     inplace=inplace,\n 852 |                     regex=regex,\n 853 |                 )\n 854 | \n 855 |                 if i != src_len:\n 856 |                     # This is ugly, but we have to get rid of intermediate refs\n 857 |                     # that did not go out of scope yet, otherwise we will trigger\n 858 |                     # many unnecessary copies\n 859 |                     for b in result:\n 860 |                         ref = weakref.ref(b)\n 861 |                         b.refs.referenced_blocks.pop(\n 862 |                             b.refs.referenced_blocks.index(ref)\n 863 |                         )\n 864 |                 new_rb.extend(result)\n 865 |             rb = new_rb\n 866 |         return rb\n 867 | \n 868 |     @final\n 869 |     def _replace_coerce(\n 870 |         self,\n 871 |         to_replace,\n 872 |         value,\n 873 |         mask: npt.NDArray[np.bool_],\n 874 |         inplace: bool = True,\n 875 |         regex: bool = False,\n 876 |     ) -> list[Block]:\n 877 |         \"\"\"\n 878 |         Replace value corresponding to the given boolean array with another\n 879 |         value.\n 880 | \n 881 |         Parameters\n 882 |         ----------\n 883 |         to_replace : object or pattern\n 884 |             Scalar to replace or regular expression to match.\n 885 |         value : object\n 886 |             Replacement object.\n 887 |         mask : np.ndarray[bool]\n 888 |             True indicate corresponding element is ignored.\n 889 |         inplace : bool, default True\n 890 |             Perform inplace modification.\n 891 |         regex : bool, default False\n 892 |             If true, perform regular expression substitution.\n 893 | \n 894 |         Returns\n 895 |         -------\n 896 |         List[Block]\n 897 |         \"\"\"\n 898 |         if should_use_regex(regex, to_replace):\n 899 |             return self._replace_regex(\n 900 |                 to_replace,\n 901 |                 value,\n 902 |                 inplace=inplace,\n 903 |                 mask=mask,\n 904 |             )\n 905 |         else:\n 906 |             if value is None:\n 907 |                 # gh-45601, gh-45836, gh-46634\n 908 |                 if mask.any():\n 909 |                     has_ref = self.refs.has_reference()\n 910 |                     nb = self.astype(np.dtype(object))\n 911 |                     if not inplace:\n 912 |                         nb = nb.copy()\n 913 |                     elif inplace and has_ref and nb.refs.has_reference():\n 914 |                         # no copy in astype and we had refs before\n 915 |                         nb = nb.copy()\n 916 |                     putmask_inplace(nb.values, mask, value)\n 917 |                     return [nb]\n 918 |                 return [self.copy(deep=False)]\n 919 |             return self.replace(\n 920 |                 to_replace=to_replace,\n 921 |                 value=value,\n 922 |                 inplace=inplace,\n 923 |                 mask=mask,\n 924 |             )\n 925 | \n 926 |     # ---------------------------------------------------------------------\n 927 |     # 2D Methods - Shared by NumpyBlock and NDArrayBackedExtensionBlock\n 928 |     #  but not ExtensionBlock\n 929 | \n 930 |     def _maybe_squeeze_arg(self, arg: np.ndarray) -> np.ndarray:\n 931 |         \"\"\"\n 932 |         For compatibility with 1D-only ExtensionArrays.\n 933 |         \"\"\"\n 934 |         return arg\n 935 | \n 936 |     def _unwrap_setitem_indexer(self, indexer):\n 937 |         \"\"\"\n 938 |         For compatibility with 1D-only ExtensionArrays.\n 939 |         \"\"\"\n 940 |         return indexer\n 941 | \n 942 |     # NB: this cannot be made cache_readonly because in mgr.set_values we pin\n 943 |     #  new .values that can have different shape GH#42631\n 944 |     @property\n 945 |     def shape(self) -> Shape:\n 946 |         return self.values.shape\n 947 | \n 948 |     def iget(self, i: int | tuple[int, int] | tuple[slice, int]) -> np.ndarray:\n 949 |         # In the case where we have a tuple[slice, int], the slice will always\n 950 |         #  be slice(None)\n 951 |         # Note: only reached with self.ndim == 2\n 952 |         # Invalid index type \"Union[int, Tuple[int, int], Tuple[slice, int]]\"\n 953 |         # for \"Union[ndarray[Any, Any], ExtensionArray]\"; expected type\n 954 |         # \"Union[int, integer[Any]]\"\n 955 |         return self.values[i]  # type: ignore[index]\n 956 | \n 957 |     def _slice(\n 958 |         self, slicer: slice | npt.NDArray[np.bool_] | npt.NDArray[np.intp]\n 959 |     ) -> ArrayLike:\n 960 |         \"\"\"return a slice of my values\"\"\"\n 961 | \n 962 |         return self.values[slicer]\n 963 | \n 964 |     def set_inplace(self, locs, values: ArrayLike, copy: bool = False) -> None:\n 965 |         \"\"\"\n 966 |         Modify block values in-place with new item value.\n 967 | \n 968 |         If copy=True, first copy the underlying values in place before modifying\n 969 |         (for Copy-on-Write).\n 970 | \n 971 |         Notes\n 972 |         -----\n 973 |         `set_inplace` never creates a new array or new Block, whereas `setitem`\n 974 |         _may_ create a new array and always creates a new Block.\n 975 | \n 976 |         Caller is responsible for checking values.dtype == self.dtype.\n 977 |         \"\"\"\n 978 |         if copy:\n 979 |             self.values = self.values.copy()\n 980 |         self.values[locs] = values\n 981 | \n 982 |     @final\n 983 |     def take_nd(\n 984 |         self,\n 985 |         indexer: npt.NDArray[np.intp],\n 986 |         axis: AxisInt,\n 987 |         new_mgr_locs: BlockPlacement | None = None,\n 988 |         fill_value=lib.no_default,\n 989 |     ) -> Block:\n 990 |         \"\"\"\n 991 |         Take values according to indexer and return them as a block.\n 992 |         \"\"\"\n 993 |         values = self.values\n 994 | \n 995 |         if fill_value is lib.no_default:\n 996 |             fill_value = self.fill_value\n 997 |             allow_fill = False\n 998 |         else:\n 999 |             allow_fill = True\n1000 | \n1001 |         # Note: algos.take_nd has upcast logic similar to coerce_to_target_dtype\n1002 |         new_values = algos.take_nd(\n1003 |             values, indexer, axis=axis, allow_fill=allow_fill, fill_value=fill_value\n1004 |         )\n1005 | \n1006 |         # Called from three places in managers, all of which satisfy\n1007 |         #  these assertions\n1008 |         if isinstance(self, ExtensionBlock):\n1009 |             # NB: in this case, the 'axis' kwarg will be ignored in the\n1010 |             #  algos.take_nd call above.\n1011 |             assert not (self.ndim == 1 and new_mgr_locs is None)\n1012 |         assert not (axis == 0 and new_mgr_locs is None)\n1013 | \n1014 |         if new_mgr_locs is None:\n1015 |             new_mgr_locs = self._mgr_locs\n1016 | \n1017 |         if new_values.dtype != self.dtype:\n1018 |             return self.make_block(new_values, new_mgr_locs)\n1019 |         else:\n1020 |             return self.make_block_same_class(new_values, new_mgr_locs)\n1021 | \n1022 |     def _unstack(\n1023 |         self,\n1024 |         unstacker,\n1025 |         fill_value,\n1026 |         new_placement: npt.NDArray[np.intp],\n1027 |         needs_masking: npt.NDArray[np.bool_],\n1028 |     ):\n1029 |         \"\"\"\n1030 |         Return a list of unstacked blocks of self\n1031 | \n1032 |         Parameters\n1033 |         ----------\n1034 |         unstacker : reshape._Unstacker\n1035 |         fill_value : int\n1036 |             Only used in ExtensionBlock._unstack\n1037 |         new_placement : np.ndarray[np.intp]\n1038 |         allow_fill : bool\n1039 |         needs_masking : np.ndarray[bool]\n1040 | \n1041 |         Returns\n1042 |         -------\n1043 |         blocks : list of Block\n1044 |             New blocks of unstacked values.\n1045 |         mask : array-like of bool\n1046 |             The mask of columns of `blocks` we should keep.\n1047 |         \"\"\"\n1048 |         new_values, mask = unstacker.get_new_values(\n1049 |             self.values.T, fill_value=fill_value\n1050 |         )\n1051 | \n1052 |         mask = mask.any(0)\n1053 |         # TODO: in all tests we have mask.all(); can we rely on that?\n1054 | \n1055 |         # Note: these next two lines ensure that\n1056 |         #  mask.sum() == sum(len(nb.mgr_locs) for nb in blocks)\n1057 |         #  which the calling function needs in order to pass verify_integrity=False\n1058 |         #  to the BlockManager constructor\n1059 |         new_values = new_values.T[mask]\n1060 |         new_placement = new_placement[mask]\n1061 | \n1062 |         bp = BlockPlacement(new_placement)\n1063 |         blocks = [new_block_2d(new_values, placement=bp)]\n1064 |         return blocks, mask\n1065 | \n1066 |     # ---------------------------------------------------------------------\n1067 | \n1068 |     def setitem(self, indexer, value) -> Block:\n1069 |         \"\"\"\n1070 |         Attempt self.values[indexer] = value, possibly creating a new array.\n1071 | \n1072 |         Parameters\n1073 |         ----------\n1074 |         indexer : tuple, list-like, array-like, slice, int\n1075 |             The subset of self.values to set\n1076 |         value : object\n1077 |             The value being set\n1078 | \n1079 |         Returns\n1080 |         -------\n1081 |         Block\n1082 | \n1083 |         Notes\n1084 |         -----\n1085 |         `indexer` is a direct slice/positional indexer. `value` must\n1086 |         be a compatible shape.\n1087 |         \"\"\"\n1088 | \n1089 |         value = self._standardize_fill_value(value)\n1090 | \n1091 |         values = cast(np.ndarray, self.values)\n1092 |         if self.ndim == 2:\n1093 |             values = values.T\n1094 | \n1095 |         # length checking\n1096 |         check_setitem_lengths(indexer, value, values)\n1097 | \n1098 |         if self.dtype != _dtype_obj:\n1099 |             # GH48933: extract_array would convert a pd.Series value to np.ndarray\n1100 |             value = extract_array(value, extract_numpy=True)\n1101 |         try:\n1102 |             casted = np_can_hold_element(values.dtype, value)\n1103 |         except LossySetitemError:\n1104 |             # current dtype cannot store value, coerce to common dtype\n1105 |             nb = self.coerce_to_target_dtype(value, raise_on_upcast=True)\n1106 |             return nb.setitem(indexer, value)\n1107 |         else:\n1108 |             if self.dtype == _dtype_obj:\n1109 |                 # TODO: avoid having to construct values[indexer]\n1110 |                 vi = values[indexer]\n1111 |                 if lib.is_list_like(vi):\n1112 |                     # checking lib.is_scalar here fails on\n1113 |                     #  test_iloc_setitem_custom_object\n1114 |                     casted = setitem_datetimelike_compat(values, len(vi), casted)\n1115 | \n1116 |             self = self._maybe_copy(inplace=True)\n1117 |             values = cast(np.ndarray, self.values.T)\n1118 |             if isinstance(casted, np.ndarray) and casted.ndim == 1 and len(casted) == 1:\n1119 |                 # NumPy 1.25 deprecation: https://github.com/numpy/numpy/pull/10615\n1120 |                 casted = casted[0, ...]\n1121 |             try:\n1122 |                 values[indexer] = casted\n1123 |             except (TypeError, ValueError) as err:\n1124 |                 if is_list_like(casted):\n1125 |                     raise ValueError(\n1126 |                         \"setting an array element with a sequence.\"\n1127 |                     ) from err\n1128 |                 raise\n1129 |         return self\n1130 | \n1131 |     def putmask(self, mask, new) -> list[Block]:\n1132 |         \"\"\"\n1133 |         putmask the data to the block; it is possible that we may create a\n1134 |         new dtype of block\n1135 | \n1136 |         Return the resulting block(s).\n1137 | \n1138 |         Parameters\n1139 |         ----------\n1140 |         mask : np.ndarray[bool], SparseArray[bool], or BooleanArray\n1141 |         new : a ndarray/object\n1142 | \n1143 |         Returns\n1144 |         -------\n1145 |         List[Block]\n1146 |         \"\"\"\n1147 |         orig_mask = mask\n1148 |         values = cast(np.ndarray, self.values)\n1149 |         mask, noop = validate_putmask(values.T, mask)\n1150 |         assert not isinstance(new, (ABCIndex, ABCSeries, ABCDataFrame))\n1151 | \n1152 |         if new is lib.no_default:\n1153 |             new = self.fill_value\n1154 | \n1155 |         new = self._standardize_fill_value(new)\n1156 |         new = extract_array(new, extract_numpy=True)\n1157 | \n1158 |         if noop:\n1159 |             return [self.copy(deep=False)]\n1160 | \n1161 |         try:\n1162 |             casted = np_can_hold_element(values.dtype, new)\n1163 | \n1164 |             self = self._maybe_copy(inplace=True)\n1165 |             values = cast(np.ndarray, self.values)\n1166 | \n1167 |             putmask_without_repeat(values.T, mask, casted)\n1168 |             return [self]\n1169 |         except LossySetitemError:\n1170 |             if self.ndim == 1 or self.shape[0] == 1:\n1171 |                 # no need to split columns\n1172 | \n1173 |                 if not is_list_like(new):\n1174 |                     # using just new[indexer] can't save us the need to cast\n1175 |                     return self.coerce_to_target_dtype(\n1176 |                         new, raise_on_upcast=True\n1177 |                     ).putmask(mask, new)\n1178 |                 else:\n1179 |                     indexer = mask.nonzero()[0]\n1180 |                     nb = self.setitem(indexer, new[indexer])\n1181 |                     return [nb]\n1182 | \n1183 |             else:\n1184 |                 is_array = isinstance(new, np.ndarray)\n1185 | \n1186 |                 res_blocks = []\n1187 |                 for i, nb in enumerate(self._split()):\n1188 |                     n = new\n1189 |                     if is_array:\n1190 |                         # we have a different value per-column\n1191 |                         n = new[:, i : i + 1]\n1192 | \n1193 |                     submask = orig_mask[:, i : i + 1]\n1194 |                     rbs = nb.putmask(submask, n)\n1195 |                     res_blocks.extend(rbs)\n1196 |                 return res_blocks\n1197 | \n1198 |     def where(self, other, cond) -> list[Block]:\n1199 |         \"\"\"\n1200 |         evaluate the block; return result block(s) from the result\n1201 | \n1202 |         Parameters\n1203 |         ----------\n1204 |         other : a ndarray/object\n1205 |         cond : np.ndarray[bool], SparseArray[bool], or BooleanArray\n1206 | \n1207 |         Returns\n1208 |         -------\n1209 |         List[Block]\n1210 |         \"\"\"\n1211 |         assert cond.ndim == self.ndim\n1212 |         assert not isinstance(other, (ABCIndex, ABCSeries, ABCDataFrame))\n1213 | \n1214 |         transpose = self.ndim == 2\n1215 | \n1216 |         cond = extract_bool_array(cond)\n1217 | \n1218 |         # EABlocks override where\n1219 |         values = cast(np.ndarray, self.values)\n1220 |         orig_other = other\n1221 |         if transpose:\n1222 |             values = values.T\n1223 | \n1224 |         icond, noop = validate_putmask(values, ~cond)\n1225 |         if noop:\n1226 |             return [self.copy(deep=False)]\n1227 | \n1228 |         if other is lib.no_default:\n1229 |             other = self.fill_value\n1230 | \n1231 |         other = self._standardize_fill_value(other)\n1232 | \n1233 |         try:\n1234 |             # try/except here is equivalent to a self._can_hold_element check,\n1235 |             #  but this gets us back 'casted' which we will reuse below;\n1236 |             #  without using 'casted', expressions.where may do unwanted upcasts.\n1237 |             casted = np_can_hold_element(values.dtype, other)\n1238 |         except (ValueError, TypeError, LossySetitemError):\n1239 |             # we cannot coerce, return a compat dtype\n1240 | \n1241 |             if self.ndim == 1 or self.shape[0] == 1:\n1242 |                 # no need to split columns\n1243 | \n1244 |                 block = self.coerce_to_target_dtype(other, raise_on_upcast=False)\n1245 |                 return block.where(orig_other, cond)\n1246 | \n1247 |             else:\n1248 |                 is_array = isinstance(other, (np.ndarray, ExtensionArray))\n1249 | \n1250 |                 res_blocks = []\n1251 |                 for i, nb in enumerate(self._split()):\n1252 |                     oth = other\n1253 |                     if is_array:\n1254 |                         # we have a different value per-column\n1255 |                         oth = other[:, i : i + 1]\n1256 | \n1257 |                     submask = cond[:, i : i + 1]\n1258 |                     rbs = nb.where(oth, submask)\n1259 |                     res_blocks.extend(rbs)\n1260 |                 return res_blocks\n1261 | \n1262 |         else:\n1263 |             other = casted\n1264 |             alt = setitem_datetimelike_compat(values, icond.sum(), other)\n1265 |             if alt is not other:\n1266 |                 if is_list_like(other) and len(other) < len(values):\n1267 |                     # call np.where with other to get the appropriate ValueError\n1268 |                     np.where(~icond, values, other)\n1269 |                     raise NotImplementedError(\n1270 |                         \"This should not be reached; call to np.where above is \"\n1271 |                         \"expected to raise ValueError. Please report a bug at \"\n1272 |                         \"github.com/pandas-dev/pandas\"\n1273 |                     )\n1274 |                 result = values.copy()\n1275 |                 np.putmask(result, icond, alt)\n1276 |             else:\n1277 |                 # By the time we get here, we should have all Series/Index\n1278 |                 #  args extracted to ndarray\n1279 |                 if (\n1280 |                     is_list_like(other)\n1281 |                     and not isinstance(other, np.ndarray)\n1282 |                     and len(other) == self.shape[-1]\n1283 |                 ):\n1284 |                     # If we don't do this broadcasting here, then expressions.where\n1285 |                     #  will broadcast a 1D other to be row-like instead of\n1286 |                     #  column-like.\n1287 |                     other = np.array(other).reshape(values.shape)\n1288 |                     # If lengths don't match (or len(other)==1), we will raise\n1289 |                     #  inside expressions.where, see test_series_where\n1290 | \n1291 |                 # Note: expressions.where may upcast.\n1292 |                 result = expressions.where(~icond, values, other)\n1293 |                 # The np_can_hold_element check _should_ ensure that we always\n1294 |                 #  have result.dtype == self.dtype here.\n1295 | \n1296 |         if transpose:\n1297 |             result = result.T\n1298 | \n1299 |         return [self.make_block(result)]\n1300 | \n1301 |     def fillna(\n1302 |         self,\n1303 |         value,\n1304 |         limit: int | None = None,\n1305 |         inplace: bool = False,\n1306 |     ) -> list[Block]:\n1307 |         \"\"\"\n1308 |         fillna on the block with the value. If we fail, then convert to\n1309 |         block to hold objects instead and try again\n1310 |         \"\"\"\n1311 |         # Caller is responsible for validating limit; if int it is strictly positive\n1312 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n1313 | \n1314 |         if not self._can_hold_na:\n1315 |             # can short-circuit the isna call\n1316 |             noop = True\n1317 |         else:\n1318 |             mask = isna(self.values)\n1319 |             mask, noop = validate_putmask(self.values, mask)\n1320 | \n1321 |         if noop:\n1322 |             # we can't process the value, but nothing to do\n1323 |             return [self.copy(deep=False)]\n1324 | \n1325 |         if limit is not None:\n1326 |             mask[mask.cumsum(self.ndim - 1) > limit] = False\n1327 | \n1328 |         if inplace:\n1329 |             nbs = self.putmask(mask.T, value)\n1330 |         else:\n1331 |             nbs = self.where(value, ~mask.T)\n1332 |         return extend_blocks(nbs)\n1333 | \n1334 |     def pad_or_backfill(\n1335 |         self,\n1336 |         *,\n1337 |         method: FillnaOptions,\n1338 |         inplace: bool = False,\n1339 |         limit: int | None = None,\n1340 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n1341 |     ) -> list[Block]:\n1342 |         if not self._can_hold_na:\n1343 |             # If there are no NAs, then interpolate is a no-op\n1344 |             return [self.copy(deep=False)]\n1345 | \n1346 |         copy, refs = self._get_refs_and_copy(inplace)\n1347 | \n1348 |         # Dispatch to the NumpyExtensionArray method.\n1349 |         # We know self.array_values is a NumpyExtensionArray bc EABlock overrides\n1350 |         vals = cast(NumpyExtensionArray, self.array_values)\n1351 |         new_values = vals.T._pad_or_backfill(\n1352 |             method=method,\n1353 |             limit=limit,\n1354 |             limit_area=limit_area,\n1355 |             copy=copy,\n1356 |         ).T\n1357 | \n1358 |         data = extract_array(new_values, extract_numpy=True)\n1359 |         return [self.make_block_same_class(data, refs=refs)]\n1360 | \n1361 |     @final\n1362 |     def interpolate(\n1363 |         self,\n1364 |         *,\n1365 |         method: InterpolateOptions,\n1366 |         index: Index,\n1367 |         inplace: bool = False,\n1368 |         limit: int | None = None,\n1369 |         limit_direction: Literal[\"forward\", \"backward\", \"both\"] = \"forward\",\n1370 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n1371 |         **kwargs,\n1372 |     ) -> list[Block]:\n1373 |         inplace = validate_bool_kwarg(inplace, \"inplace\")\n1374 |         # error: Non-overlapping equality check [...]\n1375 |         if method == \"asfreq\":  # type: ignore[comparison-overlap]\n1376 |             # clean_fill_method used to allow this\n1377 |             missing.clean_fill_method(method)\n1378 | \n1379 |         if not self._can_hold_na:\n1380 |             # If there are no NAs, then interpolate is a no-op\n1381 |             return [self.copy(deep=False)]\n1382 | \n1383 |         if self.dtype == _dtype_obj:\n1384 |             # GH#53631\n1385 |             name = {1: \"Series\", 2: \"DataFrame\"}[self.ndim]\n1386 |             raise TypeError(f\"{name} cannot interpolate with object dtype.\")\n1387 | \n1388 |         copy, refs = self._get_refs_and_copy(inplace)\n1389 | \n1390 |         # Dispatch to the EA method.\n1391 |         new_values = self.array_values.interpolate(\n1392 |             method=method,\n1393 |             axis=self.ndim - 1,\n1394 |             index=index,\n1395 |             limit=limit,\n1396 |             limit_direction=limit_direction,\n1397 |             limit_area=limit_area,\n1398 |             copy=copy,\n1399 |             **kwargs,\n1400 |         )\n1401 |         data = extract_array(new_values, extract_numpy=True)\n1402 |         return [self.make_block_same_class(data, refs=refs)]\n1403 | \n1404 |     @final\n1405 |     def diff(self, n: int) -> list[Block]:\n1406 |         \"\"\"return block for the diff of the values\"\"\"\n1407 |         # only reached with ndim == 2\n1408 |         # TODO(EA2D): transpose will be unnecessary with 2D EAs\n1409 |         new_values = algos.diff(self.values.T, n, axis=0).T\n1410 |         return [self.make_block(values=new_values)]\n1411 | \n1412 |     def shift(self, periods: int, fill_value: Any = None) -> list[Block]:\n1413 |         \"\"\"shift the block by periods, possibly upcast\"\"\"\n1414 |         # convert integer to float if necessary. need to do a lot more than\n1415 |         # that, handle boolean etc also\n1416 |         axis = self.ndim - 1\n1417 | \n1418 |         # Note: periods is never 0 here, as that is handled at the top of\n1419 |         #  NDFrame.shift.  If that ever changes, we can do a check for periods=0\n1420 |         #  and possibly avoid coercing.\n1421 | \n1422 |         if not lib.is_scalar(fill_value) and self.dtype != _dtype_obj:\n1423 |             # with object dtype there is nothing to promote, and the user can\n1424 |             #  pass pretty much any weird fill_value they like\n1425 |             # see test_shift_object_non_scalar_fill\n1426 |             raise ValueError(\"fill_value must be a scalar\")\n1427 | \n1428 |         fill_value = self._standardize_fill_value(fill_value)\n1429 | \n1430 |         try:\n1431 |             # error: Argument 1 to \"np_can_hold_element\" has incompatible type\n1432 |             # \"Union[dtype[Any], ExtensionDtype]\"; expected \"dtype[Any]\"\n1433 |             casted = np_can_hold_element(\n1434 |                 self.dtype,  # type