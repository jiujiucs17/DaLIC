array of shape (n_samples,)\n2541 |         The target vector.\n2542 | \n2543 |     Returns\n2544 |     -------\n2545 |     pos_label : int, float, bool or str\n2546 |         If `pos_label` can be inferred, it will be returned.\n2547 | \n2548 |     Raises\n2549 |     ------\n2550 |     ValueError\n2551 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2552 |         it will raise a `ValueError`.\n2553 |     \"\"\"\n2554 |     # ensure binary classification if pos_label is not specified\n2555 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2556 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2557 |     # when elements in the two arrays are not comparable.\n2558 |     if pos_label is None:\n2559 |         # Compute classes only if pos_label is not specified:\n2560 |         classes = np.unique(y_true)\n2561 |         if classes.dtype.kind in \"OUS\" or not (\n2562 |             np.array_equal(classes, [0, 1])\n2563 |             or np.array_equal(classes, [-1, 1])\n2564 |             or np.array_equal(classes, [0])\n2565 |             or np.array_equal(classes, [-1])\n2566 |             or np.array_equal(classes, [1])\n2567 |         ):\n2568 |             classes_repr = \", \".join([repr(c) for c in classes.tolist()])\n2569 |             raise ValueError(\n2570 |                 f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2571 |                 \"specified: either make y_true take value in {0, 1} or \"\n2572 |                 \"{-1, 1} or pass pos_label explicitly.\"\n2573 |             )\n2574 |         pos_label = 1\n2575 | \n2576 |     return pos_label\n```\n\nFound function `sklearn/feature_extraction/text.py:_VectorizerMixin._check_stop_words_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n374 | def _check_stop_words_consistency(self, stop_words, preprocess, tokenize):\n375 |         \"\"\"Check if stop words are consistent\n376 | \n377 |         Returns\n378 |         -------\n379 |         is_consistent : True if stop words are consistent with the preprocessor\n380 |                         and tokenizer, False if they are not, None if the check\n381 |                         was previously performed, \"error\" if it could not be\n382 |                         performed (e.g. because of the use of a custom\n383 |                         preprocessor / tokenizer)\n384 |         \"\"\"\n385 |         if id(self.stop_words) == getattr(self, \"_stop_words_id\", None):\n386 |             # Stop words are were previously validated\n387 |             return None\n388 | \n389 |         # NB: stop_words is validated, unlike self.stop_words\n390 |         try:\n391 |             inconsistent = set()\n392 |             for w in stop_words or ():\n393 |                 tokens = list(tokenize(preprocess(w)))\n394 |                 for token in tokens:\n395 |                     if token not in stop_words:\n396 |                         inconsistent.add(token)\n397 |             self._stop_words_id = id(self.stop_words)\n398 | \n399 |             if inconsistent:\n400 |                 warnings.warn(\n401 |                     \"Your stop_words may be inconsistent with \"\n402 |                     \"your preprocessing. Tokenizing the stop \"\n403 |                     \"words generated tokens %r not in \"\n404 |                     \"stop_words.\" % sorted(inconsistent)\n405 |                 )\n406 |             return not inconsistent\n407 |         except Exception:\n408 |             # Failed to check stop words consistency (e.g. because a custom\n409 |             # preprocessor or tokenizer was used)\n410 |             self._stop_words_id = id(self.stop_words)\n411 |             return \"error\"\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_pipeline_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1858 | def check_pipeline_consistency(name, estimator_orig):\n1859 |