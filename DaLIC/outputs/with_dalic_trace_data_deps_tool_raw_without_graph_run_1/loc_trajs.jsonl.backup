ert an object of type {type(data)} to a datetimelike index\"\n652 |             )\n653 | \n654 |         orig = data if isinstance(data.dtype, CategoricalDtype) else None\n655 |         if orig is not None:\n656 |             data = data._constructor(\n657 |                 orig.array,\n658 |                 name=orig.name,\n659 |                 copy=False,\n660 |                 dtype=orig._values.categories.dtype,\n661 |                 index=orig.index,\n662 |             )\n663 | \n664 |         if isinstance(data.dtype, ArrowDtype) and data.dtype.kind in \"Mm\":\n665 |             return ArrowTemporalProperties(data, orig)\n666 |         if lib.is_np_dtype(data.dtype, \"M\"):\n667 |             return DatetimeProperties(data, orig)\n668 |         elif isinstance(data.dtype, DatetimeTZDtype):\n669 |             return DatetimeProperties(data, orig)\n670 |         elif lib.is_np_dtype(data.dtype, \"m\"):\n671 |             return TimedeltaProperties(data, orig)\n672 |         elif isinstance(data.dtype, PeriodDtype):\n673 |             return PeriodProperties(data, orig)\n674 | \n675 |         raise AttributeError(\"Can only use .dt accessor with datetimelike values\")\n```\n\nFound function `pandas/core/series.py:Series.to_period`.\nSource: Retrieved code content using keyword search (bm25).\n```\n5719 | def to_period(\n5720 |         self,\n5721 |         freq: str | None = None,\n5722 |         copy: bool | lib.NoDefault = lib.no_default,\n5723 |     ) -> Series:\n5724 |         \"\"\"\n5725 |         Convert Series from DatetimeIndex to PeriodIndex.\n5726 | \n5727 |         Parameters\n5728 |         ----------\n5729 |         freq : str, default None\n5730 |             Frequency associated with the PeriodIndex.\n5731 |         copy : bool, default False\n5732 |             Whether or not to return a copy.\n5733 | \n5734 |             .. note::\n5735 |                 The `copy` keyword will change behavior in pandas 3.0.\n5736 |                 `Copy-on-Write\n5737 |                 <https://pandas.pydata.org/docs/dev/user_guide/copy_on_write.html>`__\n5738 |                 will be enabled by default, which means that all methods with a\n5739 |                 `copy` keyword will use a lazy copy mechanism to defer the copy and\n5740 |                 ignore the `copy` keyword. The `copy` keyword will be removed in a\n5741 |                 future version of pandas.\n5742 | \n5743 |                 You can already get the future behavior and improvements through\n5744 |                 enabling copy on write ``pd.options.mode.copy_on_write = True``\n5745 | \n5746 |             .. deprecated:: 3.0.0\n5747 | \n5748 |         Returns\n5749 |         -------\n5750 |         Series\n5751 |             Series with index converted to PeriodIndex.\n5752 | \n5753 |         See Also\n5754 |         --------\n5755 |         DataFrame.to_period: Equivalent method for DataFrame.\n5756 |         Series.dt.to_period: Convert DateTime column values.\n5757 | \n5758 |         Examples\n5759 |         --------\n5760 |         >>> idx = pd.DatetimeIndex([\"2023\", \"2024\", \"2025\"])\n5761 |         >>> s = pd.Series([1, 2, 3], index=idx)\n5762 |         >>> s = s.to_period()\n5763 |         >>> s\n5764 |         2023    1\n5765 |         2024    2\n5766 |         2025    3\n5767 |         Freq: Y-DEC, dtype: int64\n5768 | \n5769 |         Viewing the index\n5770 | \n5771 |         >>> s.index\n5772 |         PeriodIndex(['2023', '2024', '2025'], dtype='period[Y-DEC]')\n5773 |         \"\"\"\n5774 |         self._check_copy_deprecation(copy)\n5775 |         if not isinstance(self.index, DatetimeIndex):\n5776 |             raise TypeError(f\"unsupported Type {type(self.index).__name__}\")\n5777 | \n5778 |         new_obj = self.copy(deep=False)\n5779 |         new_index = self.index.to_period(freq=freq)\n5780 |         setattr(new_obj, \"index\", new_index)\n5781 |         return new_obj\n```\n\n\n\n##Searching for term \"dt.accessor\".