()\n124 |         for _ in range(conf[\"n_samples\"]):\n125 |             y_pred = estimator.predict(conf[\"data\"][\"X_test\"])\n126 |         elapsed_time = (time.time() - start_time) / float(conf[\"n_samples\"])\n127 |         prediction_times.append(elapsed_time)\n128 |         pred_score = conf[\"prediction_performance_computer\"](\n129 |             conf[\"data\"][\"y_test\"], y_pred\n130 |         )\n131 |         prediction_powers.append(pred_score)\n132 |         print(\n133 |             \"Complexity: %d | %s: %.4f | Pred. Time: %fs\\n\"\n134 |             % (\n135 |                 complexity,\n136 |                 conf[\"prediction_performance_label\"],\n137 |                 pred_score,\n138 |                 elapsed_time,\n139 |             )\n140 |         )\n141 |     return prediction_powers, prediction_times, complexities\n```\n\nFound function `examples/applications/plot_model_complexity_influence.py:_count_nonzero_coefficients`.\nSource: Retrieved code content using keyword search (bm25).\n```\n159 | def _count_nonzero_coefficients(estimator):\n160 |     a = estimator.coef_.toarray()\n161 |     return np.count_nonzero(a)\n```\n\nFound file `sklearn/neural_network/_rbm.py`.\nFound file `sklearn/neural_network/_base.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"astype\"...\n### Search Result:\nFound function `sklearn/utils/_array_api.py:_NumPyAPIWrapper.astype`.\nSource: Match found for entity name `astype`.\n```\n243 | def astype(self, x, dtype, *, copy=True, casting=\"unsafe\"):\n244 |         # astype is not defined in the top level NumPy namespace\n245 |         return x.astype(dtype, copy=copy, casting=casting)\n```\n\n\n\n##Searching for term \"sparse toarray\"...\n### Search Result:\nFound function `sklearn/feature_selection/_univariate_selection.py:chi2`.\nSource: Retrieved code content using keyword search (bm25).\n```\n182 | def chi2(X, y):\n183 |     \"\"\"Compute chi-squared stats between each non-negative feature and class.\n184 | \n185 |     This score can be used to select the `n_features` features with the\n186 |     highest values for the test chi-squared statistic from X, which must\n187 |     contain only **non-negative features** such as booleans or frequencies\n188 |     (e.g., term counts in document classification), relative to the classes.\n189 | \n190 |     Recall that the chi-square test measures dependence between stochastic\n191 |     variables, so using this function \"weeds out\" the features that are the\n192 |     most likely to be independent of class and therefore irrelevant for\n193 |     classification.\n194 | \n195 |     Read more in the :ref:`User Guide <univariate_feature_selection>`.\n196 | \n197 |     Parameters\n198 |     ----------\n199 |     X : {array-like, sparse matrix} of shape (n_samples, n_features)\n200 |         Sample vectors.\n201 | \n202 |     y : array-like of shape (n_samples,)\n203 |         Target vector (class labels).\n204 | \n205 |     Returns\n206 |     -------\n207 |     chi2 : ndarray of shape (n_features,)\n208 |         Chi2 statistics for each feature.\n209 | \n210 |     p_values : ndarray of shape (n_features,)\n211 |         P-values for each feature.\n212 | \n213 |     See Also\n214 |     --------\n215 |     f_classif : ANOVA F-value between label/feature for classification tasks.\n216 |     f_regression : F-value between label/feature for regression tasks.\n217 | \n218 |     Notes\n219 |     -----\n220 |     Complexity of this algorithm is O(n_classes * n_features).\n221 |     \"\"\"\n222 | \n223 |     # XXX: we might want to do some of the following in logspace instead for\n224 |     # numerical stability.\n225 |     # Converting X to float allows getting better performance for the\n226 |     # safe_sparse_dot call made below.\n227 |     X = check_array(X, accept_sparse=\"csr\", dtype=(np.float64, np.float32))\n228 |     if np.any((X.data if issparse(X) else X) < 0):\n229 |         raise ValueError(\"Input X must be non-negative.\")\n230 | \n231 |     # Use a sparse representation for Y by default to reduce memory usage when\n232 |     # y has many unique classes.\n233 |     Y = LabelBinarizer(sparse_output=True).fit_transform(y)\n234 |     if Y.shape[1] == 1:\n235 |         Y = Y.toarray()\n236 |         Y = np.append(1 - Y, Y, axis=1)\n237 | \n238 |     observed = safe_sparse_dot(Y.T, X)  # n_classes * n_features\n239 | \n240 |     if issparse(observed):\n241 |         # convert back to a dense array before calling _chisquare\n242 |         # XXX: could _chisquare be reimplement to accept sparse matrices for\n243 |         # cases where both n_classes and n_features are large (and X is\n244 |         # sparse)?\n245 |         observed = observed.toarray()\n246 | \n247 |     feature_count = X.sum(axis=0).reshape(1, -1)\n248 |     class_prob = Y.mean(axis=0).reshape(1, -1)\n249 |     expected = np.dot(class_prob.T, feature_count)\n250 | \n251 |     return _chisquare(observed, expected)\n```\n\nFound function `sklearn/utils/extmath.py:density`.\nSource: Retrieved code content using keyword search (bm25).\n```\n125 | def density(w, **kwargs):\n126 |     \"\"\"Compute density of a sparse vector.\n127 | \n128 |     Parameters\n129 |     ----------\n130 |     w : array-like\n131 |         The sparse vector.\n132 |     **kwargs : keyword arguments\n133 |         Ignored.\n134 | \n135 |         .. deprecated:: 1.2\n136 |             ``**kwargs`` were deprecated in version 1.2 and will be removed in\n137 |             1.4.\n138 | \n139 |     Returns\n140 |     -------\n141 |     float\n142 |         The density of w, between 0 and 1.\n143 |     \"\"\"\n144 |     if kwargs:\n145 |         warnings.warn(\n146 |             (\n147 |                 \"Additional keyword arguments are deprecated in version 1.2 and will be\"\n148 |                 \" removed in version 1.4.\"\n149 |             ),\n150 |             FutureWarning,\n151 |         )\n152 | \n153 |     if hasattr(w, \"toarray\"):\n154 |         d = float(w.nnz) / (w.shape[0] * w.shape[1])\n155 |     else:\n156 |         d = 0 if w is None else float((w != 0).sum()) / w.size\n157 |     return d\n```\n\nFound function `sklearn/metrics/cluster/_supervised.py:contingency_matrix`.\nSource: Retrieved code content using keyword search (bm25).\n```\n104 | def contingency_matrix(\n105 |     labels_true, labels_pred, *, eps=None, sparse=False, dtype=np.int64\n106 | ):\n107 |     \"\"\"Build a contingency matrix describing the relationship between labels.\n108 | \n109 |     Parameters\n110 |     ----------\n111 |     labels_true : array-like of shape (n_samples,)\n112 |         Ground truth class labels to be used as a reference.\n113 | \n114 |     labels_pred : array-like of shape (n_samples,)\n115 |         Cluster labels to evaluate.\n116 | \n117 |     eps : float, default=None\n118 |         If a float, that value is added to all values in the contingency\n119 |         matrix. This helps to stop NaN propagation.\n120 |         If ``None``, nothing is adjusted.\n121 | \n122 |     sparse : bool, default=False\n123 |         If `True`, return a sparse CSR continency matrix. If `eps` is not\n124 |         `None` and `sparse` is `True` will raise ValueError.\n125 | \n126 |         .. versionadded:: 0.18\n127 | \n128 |     dtype : numeric type, default=np.int64\n129 |         Output dtype. Ignored if `eps` is not `None`.\n130 | \n131 |         .. versionadded:: 0.24\n132 | \n133 |     Returns\n134 |     -------\n135 |     contingency : {array-like, sparse}, shape=[n_classes_true, n_classes_pred]\n136 |         Matrix :math:`C` such that :math:`C_{i, j}` is the number of samples in\n137 |         true class :math:`i` and in predicted class :math:`j`. If\n138 |         ``eps is None``, the dtype of this array will be integer unless set\n139 |         otherwise with the ``dtype`` argument. If ``eps`` is given, the dtype\n140 |         will be float.\n141 |         Will be a ``sklearn.sparse.csr_matrix`` if ``sparse=True``.\n142 |     \"\"\"\n143 | \n144 |     if eps is not None and sparse:\n145 |         raise ValueError(\"Cannot set 'eps' when sparse=True\")\n146 | \n147 |     classes, class_idx = np.unique(labels_true, return_inverse=True)\n148 |     clusters, cluster_idx = np.unique(labels_pred, return_inverse=True)\n149 |     n_classes = classes.shape[0]\n150 |     n_clusters = clusters.shape[0]\n151 |     # Using coo_matrix to accelerate simple histogram calculation,\n152 |     # i.e. bins are consecutive integers\n153 |     # Currently, coo_matrix is faster than histogram2d for simple cases\n154 |     contingency = sp.coo_matrix(\n155 |         (np.ones(class_idx.shape[0]), (class_idx, cluster_idx)),\n156 |         shape=(n_classes, n_clusters),\n157 |         dtype=dtype,\n158 |     )\n159 |     if sparse:\n160 |         contingency = contingency.tocsr()\n161 |         contingency.sum_duplicates()\n162 |     else:\n163 |         contingency = contingency.toarray()\n164 |         if eps is not None:\n165 |             # don't use += as contingency is integer\n166 |             contingency = contingency + eps\n167 |     return contingency\n```\n\nFound function `sklearn/utils/__init__.py:safe_mask`.\nSource: Retrieved code content using keyword search (bm25).\n```\n117 | def safe_mask(X, mask):\n118 |     \"\"\"Return a mask which is safe to use on X.\n119 | \n120 |     Parameters\n121 |     ----------\n122 |     X : {array-like, sparse matrix}\n123 |         Data on which to apply mask.\n124 | \n125 |     mask : ndarray\n126 |         Mask to be used on X.\n127 | \n128 |     Returns\n129 |     -------\n130 |     mask : ndarray\n131 |         Array that is safe to use on X.\n132 |     \"\"\"\n133 |     mask = np.asarray(mask)\n134 |     if np.issubdtype(mask.dtype, np.signedinteger):\n135 |         return mask\n136 | \n137 |     if hasattr(X, \"toarray\"):\n138 |