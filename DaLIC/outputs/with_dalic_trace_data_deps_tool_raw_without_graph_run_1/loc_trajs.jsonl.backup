avior.\n1482 |         (Note: Series.round would raise)\n1483 | \n1484 |         Parameters\n1485 |         ----------\n1486 |         decimals: int,\n1487 |             Number of decimal places to round to.\n1488 |             Caller is responsible for validating this\n1489 |         \"\"\"\n1490 |         if not self.is_numeric or self.is_bool:\n1491 |             return self.copy(deep=False)\n1492 |         # TODO: round only defined on BaseMaskedArray\n1493 |         # Series also does this, so would need to fix both places\n1494 |         # error: Item \"ExtensionArray\" of \"Union[ndarray[Any, Any], ExtensionArray]\"\n1495 |         # has no attribute \"round\"\n1496 |         values = self.values.round(decimals)  # type: ignore[union-attr]\n1497 | \n1498 |         refs = None\n1499 |         if values is self.values:\n1500 |             refs = self.refs\n1501 | \n1502 |         return self.make_block_same_class(values, refs=refs)\n1503 | \n1504 |     # ---------------------------------------------------------------------\n1505 |     # Abstract Methods Overridden By EABackedBlock and NumpyBlock\n1506 | \n1507 |     def delete(self, loc) -> list[Block]:\n1508 |         \"\"\"Deletes the locs from the block.\n1509 | \n1510 |         We split the block to avoid copying the underlying data. We create new\n1511 |         blocks for every connected segment of the initial block that is not deleted.\n1512 |         The new blocks point to the initial array.\n1513 |         \"\"\"\n1514 |         if not is_list_like(loc):\n1515 |             loc = [loc]\n1516 | \n1517 |         if self.ndim == 1:\n1518 |             values = cast(np.ndarray, self.values)\n1519 |             values = np.delete(values, loc)\n1520 |             mgr_locs = self._mgr_locs.delete(loc)\n1521 |             return [type(self)(values, placement=mgr_locs, ndim=self.ndim)]\n1522 | \n1523 |         if np.max(loc) >= self.values.shape[0]:\n1524 |             raise IndexError\n1525 | \n1526 |         # Add one out-of-bounds indexer as maximum to collect\n1527 |         # all columns after our last indexer if any\n1528 |         loc = np.concatenate([loc, [self.values.shape[0]]])\n1529 |         mgr_locs_arr = self._mgr_locs.as_array\n1530 |         new_blocks: list[Block] = []\n1531 | \n1532 |         previous_loc = -1\n1533 |         # TODO(CoW): This is tricky, if parent block goes out of scope\n1534 |         # all split blocks are referencing each other even though they\n1535 |         # don't share data\n1536 |         refs = self.refs if self.refs.has_reference() else None\n1537 |         for idx in loc:\n1538 |             if idx == previous_loc + 1:\n1539 |                 # There is no column between current and last idx\n1540 |                 pass\n1541 |             else:\n1542 |                 # No overload variant of \"__getitem__\" of \"ExtensionArray\" matches\n1543 |                 # argument type \"Tuple[slice, slice]\"\n1544 |                 values = self.values[previous_loc + 1 : idx, :]  # type: ignore[call-overload]\n1545 |                 locs = mgr_locs_arr[previous_loc + 1 : idx]\n1546 |                 nb = type(self)(\n1547 |                     values, placement=BlockPlacement(locs), ndim=self.ndim, refs=refs\n1548 |                 )\n1549 |                 new_blocks.append(nb)\n1550 | \n1551 |             previous_loc = idx\n1552 | \n1553 |         return new_blocks\n1554 | \n1555 |     @property\n1556 |     def is_view(self) -> bool:\n1557 |         \"\"\"return a boolean if I am possibly a view\"\"\"\n1558 |         raise AbstractMethodError(self)\n1559 | \n1560 |     @property\n1561 |     def array_values(self) -> ExtensionArray:\n1562 |         \"\"\"\n1563 |         The array that Series.array returns. Always an ExtensionArray.\n1564 |         \"\"\"\n1565 |         raise AbstractMethodError(self)\n1566 | \n1567 |     def get_values(self, dtype: DtypeObj | None = None) -> np.ndarray:\n1568 |         \"\"\"\n1569 |         return an internal format, currently just the ndarray\n1570 |         this is often overridden to handle to_dense like operations\n1571 |         \"\"\"\n1572 |         raise AbstractMethodError(self)\n1573 | \n1574 | \n1575 | class EABackedBlock(Block):\n1576 |     \"\"\"\n1577 |     Mixin for Block subclasses backed by ExtensionArray.\n1578 |     \"\"\"\n1579 | \n1580 |     values: ExtensionArray\n1581 | \n1582 |     @final\n1583 |     def shift(self, periods: int, fill_value: Any = None) -> list[Block]:\n1584 |         \"\"\"\n1585 |         Shift the block by `periods`.\n1586 | \n1587 |         Dispatches to underlying ExtensionArray and re-boxes in an\n1588 |         ExtensionBlock.\n1589 |         \"\"\"\n1590 |         # Transpose since EA.shift is always along axis=0, while we want to shift\n1591 |         #  along rows.\n1592 |         new_values = self.values.T.shift(periods=periods, fill_value=fill_value).T\n1593 |         return [self.make_block_same_class(new_values)]\n1594 | \n1595 |     @final\n1596 |     def setitem(self, indexer, value):\n1597 |         \"\"\"\n1598 |         Attempt self.values[indexer] = value, possibly creating a new array.\n1599 | \n1600 |         This differs from Block.setitem by not allowing setitem to change\n1601 |         the dtype of the Block.\n1602 | \n1603 |         Parameters\n1604 |         ----------\n1605 |         indexer : tuple, list-like, array-like, slice, int\n1606 |             The subset of self.values to set\n1607 |         value : object\n1608 |             The value being set\n1609 | \n1610 |         Returns\n1611 |         -------\n1612 |         Block\n1613 | \n1614 |         Notes\n1615 |         -----\n1616 |         `indexer` is a direct slice/positional indexer. `value` must\n1617 |         be a compatible shape.\n1618 |         \"\"\"\n1619 |         orig_indexer = indexer\n1620 |         orig_value = value\n1621 | \n1622 |         indexer = self._unwrap_setitem_indexer(indexer)\n1623 |         value = self._maybe_squeeze_arg(value)\n1624 | \n1625 |         values = self.values\n1626 |         if values.ndim == 2:\n1627 |             # TODO(GH#45419): string[pyarrow] tests break if we transpose\n1628 |             #  unconditionally\n1629 |             values = values.T\n1630 |         check_setitem_lengths(indexer, value, values)\n1631 | \n1632 |         try:\n1633 |             values[indexer] = value\n1634 |         except (ValueError, TypeError):\n1635 |             if isinstance(self.dtype, IntervalDtype):\n1636 |                 # see TestSetitemFloatIntervalWithIntIntervalValues\n1637 |                 nb = self.coerce_to_target_dtype(orig_value, raise_on_upcast=True)\n1638 |                 return nb.setitem(orig_indexer, orig_value)\n1639 | \n1640 |             elif isinstance(self, NDArrayBackedExtensionBlock):\n1641 |                 nb = self.coerce_to_target_dtype(orig_value, raise_on_upcast=True)\n1642 |                 return nb.setitem(orig_indexer, orig_value)\n1643 | \n1644 |             else:\n1645 |                 raise\n1646 | \n1647 |         else:\n1648 |             return self\n1649 | \n1650 |     @final\n1651 |     def where(self, other, cond) -> list[Block]:\n1652 |         arr = self.values.T\n1653 | \n1654 |         cond = extract_bool_array(cond)\n1655 | \n1656 |         orig_other = other\n1657 |         orig_cond = cond\n1658 |         other = self._maybe_squeeze_arg(other)\n1659 |         cond = self._maybe_squeeze_arg(cond)\n1660 | \n1661 |         if other is lib.no_default:\n1662 |             other = self.fill_value\n1663 | \n1664 |         icond, noop = validate_putmask(arr, ~cond)\n1665 |         if noop:\n1666 |             # GH#44181, GH#45135\n1667 |             # Avoid a) raising for Interval/PeriodDtype and b) unnecessary object upcast\n1668 |             return [self.copy(deep=False)]\n1669 | \n1670 |         try:\n1671 |             res_values = arr._where(cond, other).T\n1672 |         except (ValueError, TypeError):\n1673 |             if self.ndim == 1 or self.shape[0] == 1:\n1674 |                 if isinstance(self.dtype, IntervalDtype):\n1675 |                     # TestSetitemFloatIntervalWithIntIntervalValues\n1676 |                     blk = self.coerce_to_target_dtype(orig_other, raise_on_upcast=False)\n1677 |                     return blk.where(orig_other, orig_cond)\n1678 | \n1679 |                 elif isinstance(self, NDArrayBackedExtensionBlock):\n1680 |                     # NB: not (yet) the same as\n1681 |                     #  isinstance(values, NDArrayBackedExtensionArray)\n1682 |                     blk = self.coerce_to_target_dtype(orig_other, raise_on_upcast=False)\n1683 |                     return blk.where(orig_other, orig_cond)\n1684 | \n1685 |                 else:\n1686 |                     raise\n1687 | \n1688 |             else:\n1689 |                 # Same pattern we use in Block.putmask\n1690 |                 is_array = isinstance(orig_other, (np.ndarray, ExtensionArray))\n1691 | \n1692 |                 res_blocks = []\n1693 |                 for i, nb in enumerate(self._split()):\n1694 |                     n = orig_other\n1695 |                     if is_array:\n1696 |                         # we have a different value per-column\n1697 |                         n = orig_other[:, i : i + 1]\n1698 | \n1699 |                     submask = orig_cond[:, i : i + 1]\n1700 |                     rbs = nb.where(n, submask)\n1701 |                     res_blocks.extend(rbs)\n1702 |                 return res_blocks\n1703 | \n1704 |         nb = self.make_block_same_class(res_values)\n1705 |         return [nb]\n1706 | \n1707 |     @final\n1708 |     def putmask(self, mask, new) -> list[Block]:\n1709 |         \"\"\"\n1710 |         See Block.putmask.__doc__\n1711 |         \"\"\"\n1712 |         mask = extract_bool_array(mask)\n1713 |         if new is lib.no_default:\n1714 |             new = self.fill_value\n1715 | \n1716 |         orig_new = new\n1717 |         orig_mask = mask\n1718 |         new = self._maybe_squeeze_arg(new)\n1719 |         mask = self._maybe_squeeze_arg(mask)\n1720 | \n1721 |         if not mask.any():\n1722 |             return [self.copy(deep=False)]\n1723 | \n1724 |         self = self._maybe_copy(inplace=True)\n1725 |         values = self.values\n1726 |         if values.ndim == 2:\n1727 |             values = values.T\n1728 | \n1729 |         try:\n1730 |             # Caller is responsible for ensuring matching lengths\n1731 |             values._putmask(mask, new)\n1732 |         except (TypeError, ValueError):\n1733 |             if self.ndim == 1 or self.shape[0] == 1:\n1734 |                 if isinstance(self.dtype, IntervalDtype):\n1735 |                     # Discussion about what we want to support in the general\n1736 |                     #  case GH#39584\n1737 |                     blk = self.coerce_to_target_dtype(orig_new, raise_on_upcast=True)\n1738 |                     return blk.putmask(orig_mask, orig_new)\n1739 | \n1740 |                 elif isinstance(self, NDArrayBackedExtensionBlock):\n1741 |                     # NB: not (yet) the same as\n1742 |                     #  isinstance(values, NDArrayBackedExtensionArray)\n1743 |                     blk = self.coerce_to_target_dtype(orig_new, raise_on_upcast=True)\n1744 |                     return blk.putmask(orig_mask, orig_new)\n1745 | \n1746 |                 else:\n1747 |                     raise\n1748 | \n1749 |             else:\n1750 |                 # Same pattern we use in Block.putmask\n1751 |                 is_array = isinstance(orig_new, (np.ndarray, ExtensionArray))\n1752 | \n1753 |                 res_blocks = []\n1754 |                 for i, nb in enumerate(self._split()):\n1755 |                     n = orig_new\n1756 |                     if is_array:\n1757 |                         # we have a different value per-column\n1758 |                         n = orig_new[:, i : i + 1]\n1759 | \n1760 |                     submask = orig_mask[:, i : i + 1]\n1761 |                     rbs = nb.putmask(submask, n)\n1762 |                     res_blocks.extend(rbs)\n1763 |                 return res_blocks\n1764 | \n1765 |         return [self]\n1766 | \n1767 |     @final\n1768 |     def delete(self, loc) -> list[Block]:\n1769 |         # This will be unnecessary if/when __array_function__ is implemented\n1770 |         if self.ndim == 1:\n1771 |             values = self.values.delete(loc)\n1772 |             mgr_locs = self._mgr_locs.delete(loc)\n1773 |             return [type(self)(values, placement=mgr_locs, ndim=self.ndim)]\n1774 |         elif self.values.ndim == 1:\n1775 |             # We get here through to_stata\n1776 |             return []\n1777 |         return super().delete(loc)\n1778 | \n1779 |     @final\n1780 |     @cache_readonly\n1781 |     def array_values(self) -> ExtensionArray:\n1782 |         return self.values\n1783 | \n1784 |     @final\n1785 |     def get_values(self, dtype: DtypeObj | None = None) -> np.ndarray:\n1786 |         \"\"\"\n1787 |         return object dtype as boxed values, such as Timestamps/Timedelta\n1788 |         \"\"\"\n1789 |         values: ArrayLike = self.values\n1790 |         if dtype == _dtype_obj:\n1791 |             values = values.astype(object)\n1792 |         # TODO(EA2D): reshape not needed with 2D EAs\n1793 |         return np.asarray(values).reshape(self.shape)\n1794 | \n1795 |     @final\n1796 |     def pad_or_backfill(\n1797 |         self,\n1798 |         *,\n1799 |         method: FillnaOptions,\n1800 |         inplace: bool = False,\n1801 |         limit: int | None = None,\n1802 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n1803 |     ) -> list[Block]:\n1804 |         values = self.values\n1805 | \n1806 |         kwargs: dict[str, Any] = {\"method\": method, \"limit\": limit}\n1807 |         if \"limit_area\" in inspect.signature(values._pad_or_backfill).parameters:\n1808 |             kwargs[\"limit_area\"] = limit_area\n1809 |         elif limit_area is not None:\n1810 |             raise NotImplementedError(\n1811 |                 f\"{type(values).__name__} does not implement limit_area \"\n1812 |                 \"(added in pandas 2.2). 3rd-party ExtensionArray authors \"\n1813 |                 \"need to add this argument to _pad_or_backfill.\"\n1814 |             )\n1815 | \n1816 |         if values.ndim == 2:\n1817 |             # NDArrayBackedExtensionArray.fillna assumes axis=0\n1818 |             new_values = values.T._pad_or_backfill(**kwargs).T\n1819 |         else:\n1820 |             new_values = values._pad_or_backfill(**kwargs)\n1821 |         return [self.make_block_same_class(new_values)]\n1822 | \n1823 | \n1824 | class ExtensionBlock(EABackedBlock):\n1825 |     \"\"\"\n1826 |     Block for holding extension types.\n1827 | \n1828 |     Notes\n1829 |     -----\n1830 |     This holds all 3rd-party extension array types. It's also the immediate\n1831 |     parent class for our internal extension types' blocks.\n1832 | \n1833 |     ExtensionArrays are limited to 1-D.\n1834 |     \"\"\"\n1835 | \n1836 |     values: ExtensionArray\n1837 | \n1838 |     def fillna(\n1839 |         self,\n1840 |         value,\n1841 |         limit: int | None = None,\n1842 |         inplace: bool = False,\n1843 |     ) -> list[Block]:\n1844 |         if isinstance(self.dtype, IntervalDtype):\n1845 |             # Block.fillna handles coercion (test_fillna_interval)\n1846 |             if limit is not None:\n1847 |                 raise ValueError(\"limit must be None\")\n1848 |             return super().fillna(\n1849 |                 value=value,\n1850 |                 limit=limit,\n1851 |                 inplace=inplace,\n1852 |             )\n1853 |         if self._can_hold_na and not self.values._hasna:\n1854 |             refs = self.refs\n1855 |             new_values = self.values\n1856 |         else:\n1857 |             copy, refs = self._get_refs_and_copy(inplace)\n1858 | \n1859 |             try:\n1860 |                 new_values = self.values.fillna(value=value, limit=limit, copy=copy)\n1861 |             except TypeError:\n1862 |                 # 3rd party EA that has not implemented copy keyword yet\n1863 |                 refs = None\n1864 |                 new_values = self.values.fillna(value=value, limit=limit)\n1865 |                 # issue the warning *after* retrying, in case the TypeError\n1866 |                 #  was caused by an invalid fill_value\n1867 |                 warnings.warn(\n1868 |                     # GH#53278\n1869 |                     \"ExtensionArray.fillna added a 'copy' keyword in pandas \"\n1870 |                     \"2.1.0. In a future version, ExtensionArray subclasses will \"\n1871 |                     \"need to implement this keyword or an exception will be \"\n1872 |                     \"raised. In the interim, the keyword is ignored by \"\n1873 |                     f\"{type(self.values).__name__}.\",\n1874 |                     DeprecationWarning,\n1875 |                     stacklevel=find_stack_level(),\n1876 |                 )\n1877 | \n1878 |         return [self.make_block_same_class(new_values, refs=refs)]\n1879 | \n1880 |     @cache_readonly\n1881 |     def shape(self) -> Shape:\n1882 |         # TODO(EA2D): override unnecessary with 2D EAs\n1883 |         if self.ndim == 1:\n1884 |             return (len(self.values),)\n1885 |         return len(self._mgr_locs), len(self.values)\n1886 | \n1887 |     def iget(self, i: int | tuple[int, int] | tuple[slice, int]):\n1888 |         # In the case where we have a tuple[slice, int], the slice will always\n1889 |         #  be slice(None)\n1890 |         # We _could_ make the annotation more specific, but mypy would\n1891 |         #  complain about override mismatch:\n1892 |         #  Literal[0] | tuple[Literal[0], int] | tuple[slice, int]\n1893 | \n1894 |         # Note: only reached with self.ndim == 2\n1895 | \n1896 |         if isinstance(i, tuple):\n1897 |             # TODO(EA2D): unnecessary with 2D EAs\n1898 |             col, loc = i\n1899 |             if not com.is_null_slice(col) and col != 0:\n1900 |                 raise IndexError(f\"{self} only contains one item\")\n1901 |             if isinstance(col, slice):\n1902 |                 # the is_null_slice check above assures that col is slice(None)\n1903 |                 #  so what we want is a view on all our columns and row loc\n1904 |                 if loc < 0:\n1905 |                     loc += len(self.values)\n1906 |                 # Note: loc:loc+1 vs [[loc]] makes a difference when called\n1907 |                 #  from fast_xs because we want to get a view back.\n1908 |                 return self.values[loc : loc + 1]\n1909 |             return self.values[loc]\n1910 |         else:\n1911 |             if i != 0:\n1912 |                 raise IndexError(f\"{self} only contains one item\")\n1913 |             return self.values\n1914 | \n1915 |     def set_inplace(self, locs, values: ArrayLike, copy: bool = False) -> None:\n1916 |         # When an ndarray, we should have locs.tolist() == [0]\n1917 |         # When a BlockPlacement we should have list(locs) == [0]\n1918 |         if copy:\n1919 |             self.values = self.values.copy()\n1920 |         self.values[:] = values\n1921 | \n1922 |     def _maybe_squeeze_arg(self, arg):\n1923 |         \"\"\"\n1924 |         If necessary, squeeze a (N, 1) ndarray to (N,)\n1925 |         \"\"\"\n1926 |         # e.g. if we are passed a 2D mask for putmask\n1927 |         if (\n1928 |             isinstance(arg, (np.ndarray, ExtensionArray))\n1929 |             and arg.ndim == self.values.ndim + 1\n1930 |         ):\n1931 |             # TODO(EA2D): unnecessary with 2D EAs\n1932 |             assert arg.shape[1] == 1\n1933 |             # error: No overload variant of \"__getitem__\" of \"ExtensionArray\"\n1934 |             # matches argument type \"Tuple[slice, int]\"\n1935 |             arg = arg[:, 0]  # type: ignore[call-overload]\n1936 |         elif isinstance(arg, ABCDataFrame):\n1937 |             # 2022-01-06 only reached for setitem\n1938 |             # TODO: should we avoid getting here with DataFrame?\n1939 |             assert arg.shape[1] == 1\n1940 |             arg = arg._ixs(0, axis=1)._values\n1941 | \n1942 |         return arg\n1943 | \n1944 |     def _unwrap_setitem_indexer(self, indexer):\n1945 |         \"\"\"\n1946 |         Adapt a 2D-indexer to our 1D values.\n1947 | \n1948 |         This is intended for 'setitem', not 'iget' or '_slice'.\n1949 |         \"\"\"\n1950 |         # TODO: ATM this doesn't work for iget/_slice, can we change that?\n1951 | \n1952 |         if isinstance(indexer, tuple) and len(indexer) == 2:\n1953 |             # TODO(EA2D): not needed with 2D EAs\n1954 |             #  Should never have length > 2.  Caller is responsible for checking.\n1955 |             #  Length 1 is reached vis setitem_single_block and setitem_single_column\n1956 |             #  each of which pass indexer=(pi,)\n1957 |             if all(isinstance(x, np.ndarray) and x.ndim == 2 for x in indexer):\n1958 |                 # GH#44703 went through indexing.maybe_convert_ix\n1959 |                 first, second = indexer\n1960 |                 if not (\n1961 |                     second.size == 1 and (second == 0).all() and first.shape[1] == 1\n1962 |                 ):\n1963 |                     raise NotImplementedError(\n1964 |                         \"This should not be reached. Please report a bug at \"\n1965 |                         \"github.com/pandas-dev/pandas/\"\n1966 |                     )\n1967 |                 indexer = first[:, 0]\n1968 | \n1969 |             elif lib.is_integer(indexer[1]) and indexer[1] == 0:\n1970 |                 # reached via setitem_single_block passing the whole indexer\n1971 |                 indexer = indexer[0]\n1972 | \n1973 |             elif com.is_null_slice(indexer[1]):\n1974 |                 indexer = indexer[0]\n1975 | \n1976 |             elif is_list_like(indexer[1]) and indexer[1][0] == 0:\n1977 |                 indexer = indexer[0]\n1978 | \n1979 |             else:\n1980 |                 raise NotImplementedError(\n1981 |                     \"This should not be reached. Please report a bug at \"\n1982 |                     \"github.com/pandas-dev/pandas/\"\n1983 |                 )\n1984 |         return indexer\n1985 | \n1986 |     @property\n1987 |     def is_view(self) -> bool:\n1988 |         \"\"\"Extension arrays are never treated as views.\"\"\"\n1989 |         return False\n1990 | \n1991 |     # error: Cannot override writeable attribute with read-only property\n1992 |     @cache_readonly\n1993 |     def is_numeric(self) -> bool:  # type: ignore[override]\n1994 |         return self.values.dtype._is_numeric\n1995 | \n1996 |     def _slice(\n1997 |         self, slicer: slice | npt.NDArray[np.bool_] | npt.NDArray[np.intp]\n1998 |     ) -> ExtensionArray:\n1999 |         \"\"\"\n2000 |         Return a slice of my values.\n2001 | \n2002 |         Parameters\n2003 |         ----------\n2004 |         slicer : slice, ndarray[int], or ndarray[bool]\n2005 |             Valid (non-reducing) indexer for self.values.\n2006 | \n2007 |         Returns\n2008 |         -------\n2009 |         ExtensionArray\n2010 |         \"\"\"\n2011 |         # Notes: ndarray[bool] is only reachable when via get_rows_with_mask, which\n2012 |         #  is only for Series, i.e. self.ndim == 1.\n2013 | \n2014 |         # return same dims as we currently have\n2015 |         if self.ndim == 2:\n2016 |             # reached via getitem_block via _slice_take_blocks_ax0\n2017 |             # TODO(EA2D): won't be necessary with 2D EAs\n2018 | \n2019 |             if not isinstance(slicer, slice):\n2020 |                 raise AssertionError(\n2021 |                     \"inval