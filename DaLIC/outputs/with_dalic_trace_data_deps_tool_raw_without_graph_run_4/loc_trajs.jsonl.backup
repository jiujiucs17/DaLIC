d doc-strings.\n 92 |         accessors : list of str\n 93 |             List of accessors to add.\n 94 |         typ : {'property', 'method'}\n 95 |         overwrite : bool, default False\n 96 |             Overwrite the method/property in the target class if it exists.\n 97 |         accessor_mapping: Callable, default lambda x: x\n 98 |             Callable to map the delegate's function to the cls' function.\n 99 |         raise_on_missing: bool, default True\n100 |             Raise if an accessor does not exist on delegate.\n101 |             False skips the missing accessor.\n102 |         \"\"\"\n103 | \n104 |         def _create_delegator_property(name: str):\n105 |             def _getter(self):\n106 |                 return self._delegate_property_get(name)\n107 | \n108 |             def _setter(self, new_values):\n109 |                 return self._delegate_property_set(name, new_values)\n110 | \n111 |             _getter.__name__ = name\n112 |             _setter.__name__ = name\n113 | \n114 |             return property(\n115 |                 fget=_getter,\n116 |                 fset=_setter,\n117 |                 doc=getattr(delegate, accessor_mapping(name)).__doc__,\n118 |             )\n119 | \n120 |         def _create_delegator_method(name: str):\n121 |             method = getattr(delegate, accessor_mapping(name))\n122 | \n123 |             @functools.wraps(method)\n124 |             def f(self, *args, **kwargs):\n125 |                 return self._delegate_method(name, *args, **kwargs)\n126 | \n127 |             return f\n128 | \n129 |         for name in accessors:\n130 |             if (\n131 |                 not raise_on_missing\n132 |                 and getattr(delegate, accessor_mapping(name), None) is None\n133 |             ):\n134 |                 continue\n135 | \n136 |             if typ == \"property\":\n137 |                 f = _create_delegator_property(name)\n138 |             else:\n139 |                 f = _create_delegat