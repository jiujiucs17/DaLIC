ication, we fix `pos_label=1` if the labels are in the set\n2187 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2188 |     `pos_label` parameters.\n2189 | \n2190 |     Parameters\n2191 |     ----------\n2192 |     pos_label : int, float, bool, str or None\n2193 |         The positive label.\n2194 |     y_true : ndarray of shape (n_samples,)\n2195 |         The target vector.\n2196 | \n2197 |     Returns\n2198 |     -------\n2199 |     pos_label : int, float, bool or str\n2200 |         If `pos_label` can be inferred, it will be returned.\n2201 | \n2202 |     Raises\n2203 |     ------\n2204 |     ValueError\n2205 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2206 |         it will raise a `ValueError`.\n2207 |     \"\"\"\n2208 |     # ensure binary classification if pos_label is not specified\n2209 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2210 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2211 |     # when elements in the two arrays are not comparable.\n2212 |     classes = np.unique(y_true)\n2213 |     if pos_label is None and (\n2214 |         classes.dtype.kind in \"OUS\"\n2215 |         or not (\n2216 |             np.array_equal(classes, [0, 1])\n2217 |             or np.array_equal(classes, [-1, 1])\n2218 |             or np.array_equal(classes, [0])\n2219 |             or np.array_equal(classes, [-1])\n2220 |             or np.array_equal(classes, [1])\n2221 |         )\n2222 |     ):\n2223 |         classes_repr = \", \".join(repr(c) for c in classes)\n2224 |         raise ValueError(\n2225 |             f\"y_true takes value in {{{classes_repr}}} and pos_label is not \"\n2226 |             \"specified: either make y_true take value in {0, 1} or \"\n2227 |             \"{-1, 1} or pass pos_label explicitly.\"\n2228 |         )\n2229 |     elif pos_label is None:\n2230 |         pos_label = 1\n2231 | \n2232 |     return pos_label\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSSVD.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 985 | def fit(self, X, Y):\n 986 |         \"\"\"Fit model to data.\n 987 | \n 988 |         Parameters\n 989 |         ----------\n 990 |         X : array-like of shape (n_samples, n_features)\n 991 |             Training samples.\n 992 | \n 993 |         Y : array-like of shape (n_samples,) or (n_samples, n_targets)\n 994 |             Targets.\n 995 | \n 996 |         Returns\n 997 |         -------\n 998 |         self : object\n 999 |             Fitted estimator.\n1000 |         \"\"\"\n1001 |         self._validate_params()\n1002 | \n1003 |         check_consistent_length(X, Y)\n1004 |         X = self._validate_data(\n1005 |             X, dtype=np.float64, copy=self.copy, ensure_min_samples=2\n1006 |         )\n1007 |         Y = check_array(\n1008 |             Y, input_name=\"Y\", dtype=np.float64, copy=self.copy, ensure_2d=False\n1009 |         )\n1010 |         if Y.ndim == 1:\n1011 |             Y = Y.reshape(-1, 1)\n1012 | \n1013 |         # we'll compute the SVD of the cross-covariance matrix = X.T.dot(Y)\n1014 |         # This matrix rank is at most min(n_samples, n_features, n_targets) so\n1015 |         # n_components cannot be bigger than that.\n1016 |         n_components = self.n_components\n1017 |         rank_upper_bound = min(X.shape[0], X.shape[1], Y.shape[1])\n1018 |         if n_components > rank_upper_bound:\n1019 |             raise ValueError(\n1020 |                 f\"`n_components` upper bound is {rank_upper_bound}. \"\n1021 |                 f\"Got {n_components} instead. Reduce `n_components`.\"\n1022 |             )\n1023 | \n1024 |         X, Y, self._x_mean, self._y_mean, self._x_std, self._y_std = _center_scale_xy(\n1025 |             X, Y, self.scale\n1026 |         )\n1027 | \n1028 |         # Compute SVD of cross-covariance matrix\n1029 |         C = np.dot(X.T, Y)\n1030 |         U, s, Vt = svd(C, full_