ze` to ensure you have a\n852 |         Series.\n853 | \n854 |         Parameters\n855 |         ----------\n856 |         axis : {0 or 'index', 1 or 'columns', None}, default None\n857 |             A specific axis to squeeze. By default, all length-1 axes are\n858 |             squeezed. For `Series` this parameter is unused and defaults to `None`.\n859 | \n860 |         Returns\n861 |         -------\n862 |         DataFrame, Series, or scalar\n863 |             The projection after squeezing `axis` or all the axes.\n864 | \n865 |         See Also\n866 |         --------\n867 |         Series.iloc : Integer-location based indexing for selecting scalars.\n868 |         DataFrame.iloc : Integer-location based indexing for selecting Series.\n869 |         Series.to_frame : Inverse of DataFrame.squeeze for a\n870 |             single-column DataFrame.\n871 | \n872 |         Examples\n873 |         --------\n874 |         >>> primes = pd.Series([2, 3, 5, 7])\n875 | \n876 |         Slicing might produce a Series with a single value:\n877 | \n878 |         >>> even_primes = primes[primes % 2 == 0]\n879 |         >>> even_primes\n880 |         0    2\n881 |         dtype: int64\n882 | \n883 |         >>> even_primes.squeeze()\n884 |         2\n885 | \n886 |         Squeezing objects with more than one value in every axis does nothing:\n887 | \n888 |         >>> odd_primes = primes[primes % 2 == 1]\n889 |         >>> odd_primes\n890 |         1    3\n891 |         2    5\n892 |         3    7\n893 |         dtype: int64\n894 | \n895 |         >>> odd_primes.squeeze()\n896 |         1    3\n897 |         2    5\n898 |         3    7\n899 |         dtype: int64\n900 | \n901 |         Squeezing is even more effective when used with DataFrames.\n902 | \n903 |         >>> df = pd.DataFrame([[1, 2], [3, 4]], columns=[\"a\", \"b\"])\n904 |         >>> df\n905 |            a  b\n906 |         0  1  2\n907 |         1  3  4\n908 | \n909 |         Slicing a single column will produce a DataFrame with the columns\n910 |         having only one value:\n911 | \n912 |         >>> df_a = df[[\"a\"]]\n913 |         >>> df_a\n914 |            a\n915 |         0  1\n916 |         1  3\n917 | \n918 |         So the columns can be squeezed down, resulting in a Series:\n919 | \n920 |         >>> df_a.squeeze(\"columns\")\n921 |         0    1\n922 |         1    3\n923 |         Name: a, dtype: int64\n924 | \n925 |         Slicing a single row from a single column will produce a single\n926 |         scalar DataFrame:\n927 | \n928 |         >>> df_0a = df.loc[df.index < 1, [\"a\"]]\n929 |         >>> df_0a\n930 |            a\n931 |         0  1\n932 | \n933 |         Squeezing the rows produces a single scalar Series:\n934 | \n935 |         >>> df_0a.squeeze(\"rows\")\n936 |         a    1\n937 |         Name: 0, dtype: int64\n938 | \n939 |         Squeezing all axes will project directly into a scalar:\n940 | \n941 |         >>> df_0a.squeeze()\n942 |         1\n943 |         \"\"\"\n944 |         axes = range(self._AXIS_LEN) if axis is None else (self._get_axis_number(axis),)\n945 |         result = self.iloc[\n946 |             tuple(\n947 |                 0 if i in axes and len(a) == 1 else slice(None)\n948 |                 for i, a in enumerate(self.axes)\n949 |             )\n950 |         ]\n951 |         if isinstance(result, NDFrame):\n952 |             result = result.__finalize__(self, method=\"squeeze\")\n953 |         return result\n```\n"}, {"content": "Step 3: Let me analyze the feature:\n\n- The `squeeze` method is part of the `NDFrame` class in `pandas/core/generic.py`\n- Current signature: `def squeeze(self, axis: Axis | None = None)`\n- Docstring describes:\n  * Parameters: `axis` can be 0/index, 1/columns, or None\n  * Returns: DataFrame, Series, or scalar depending on input shape\n- Method implementation shows it handles different axis types and reduces dimensions\n- Method is commonly used for data reduction in visualization and analysis\n\nStep 4: Let me locate areas for the feature implementation:\n\n<function=search_code_snippets>\n<parameter=search_terms>['Axis', 'Self']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\npandas/io/stata.py:StataReader._read_new_header\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_partial_key_null_slice\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_all_null_slices\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_all_bool_indexers\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_partial_key_list\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_xs_level_0\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_partial_key_bool_indexer\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_all_scalars\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_multiindex\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_xs_level_1\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_partial_key_slice\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_all_lists\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_slice_plus_null_slice\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_xs_full_key\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_partial_key_scalar\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_all_slices\nasv_bench/benchmarks/indexing.py:MultiIndexing.time_loc_null_slice_plus_slice\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_boolean_rows_boolean\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_at_setitem\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_boolean_rows_object\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_boolean_rows\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_at\nasv_bench/benchmarks/indexing.py:DataFrameStringIndexing.time_getitem_scalar