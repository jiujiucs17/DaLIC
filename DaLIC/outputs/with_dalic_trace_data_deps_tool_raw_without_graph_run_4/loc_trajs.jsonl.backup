ch\":\n2595 |             # GH#57063\n2596 |             warnings.warn(\n2597 |                 \"'epoch' date format is deprecated and will be removed in a future \"\n2598 |                 \"version, please use 'iso' date format instead.\",\n2599 |                 FutureWarning,\n2600 |                 stacklevel=find_stack_level(),\n2601 |             )\n2602 | \n2603 |         config.is_nonnegative_int(indent)\n2604 |         indent = indent or 0\n2605 | \n2606 |         return json.to_json(\n2607 |             path_or_buf=path_or_buf,\n2608 |             obj=self,\n2609 |             orient=orient,\n2610 |             date_format=date_format,\n2611 |             double_precision=double_precision,\n2612 |             force_ascii=force_ascii,\n2613 |             date_unit=date_unit,\n2614 |             default_handler=default_handler,\n2615 |             lines=lines,\n2616 |             compression=compression,\n2617 |             index=index,\n2618 |             indent=indent,\n2619 |             storage_options=storage_options,\n2620 |             mode=mode,\n2621 |         )\n```\n\nFound class `asv_bench/benchmarks/join_merge.py:Concat`.\nSource: Retrieved entity using keyword search (bm25).\n```\n23 | class Concat:\n24 |     params = [0, 1]\n25 |     param_names = [\"axis\"]\n26 | \n27 |     def setup(self, axis):\n28 |         N = 1000\n29 |         s = Series(N, index=Index([f\"i-{i}\" for i in range(N)], dtype=object))\n30 |         self.series = [s[i:-i] for i in range(1, 10)] * 50\n31 |         self.small_frames = [DataFrame(np.random.randn(5, 4))] * 1000\n32 |         df = DataFrame(\n33 |             {\"A\": range(N)}, index=date_range(\"20130101\", periods=N, freq=\"s\")\n34 |         )\n35 |         self.empty_left = [DataFrame(), df]\n36 |         self.empty_right = [df, DataFrame()]\n37 |         self.mixed_ndims = [df, df.head(N // 2)]\n38 | \n39 |     def time_concat_series(self, axis):\n40 |         concat(self.series, axis=axis, sort=False)\n4