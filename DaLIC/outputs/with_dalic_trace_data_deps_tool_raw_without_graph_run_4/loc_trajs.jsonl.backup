2262 |     assert adjusted_rand_score(pred, y) > 0.4\n2263 |     if _safe_tags(clusterer, key=\"non_deterministic\"):\n2264 |         return\n2265 |     set_random_state(clusterer)\n2266 |     with warnings.catch_warnings(record=True):\n2267 |         pred2 = clusterer.fit_predict(X)\n2268 |     assert_array_equal(pred, pred2)\n2269 | \n2270 |     # fit_predict(X) and labels_ should be of type int\n2271 |     assert pred.dtype in [np.dtype(\"int32\"), np.dtype(\"int64\")]\n2272 |     assert pred2.dtype in [np.dtype(\"int32\"), np.dtype(\"int64\")]\n2273 | \n2274 |     # Add noise to X to test the possible values of the labels\n2275 |     labels = clusterer.fit_predict(X_noise)\n2276 | \n2277 |     # There should be at least one sample in every cluster. Equivalently\n2278 |     # labels_ should contain all the consecutive values between its\n2279 |     # min and its max.\n2280 |     labels_sorted = np.unique(labels)\n2281 |     assert_array_equal(\n2282 |         labels_sorted, np.arange(labels_sorted[0], labels_sorted[-1] + 1)\n2283 |     )\n2284 | \n2285 |     # Labels are expected to start at 0 (no noise) or -1 (if noise)\n2286 |     assert labels_sorted[0] in [0, -1]\n2287 |     # Labels should be less than n_clusters - 1\n2288 |     if hasattr(clusterer, \"n_clusters\"):\n2289 |         n_clusters = getattr(clusterer, \"n_clusters\")\n2290 |         assert n_clusters - 1 >= labels_sorted[-1]\n```\n\nFound function `sklearn/utils/estimator_checks.py:check_classifiers_multilabel_representation_invariance`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2630 | def check_classifiers_multilabel_representation_invariance(name, classifier_orig):\n2631 |     X, y = make_multilabel_classification(\n2632 |         n_samples=100,\n2633 |         n_features=2,\n2634 |         n_classes=5,\n2635 |         n_labels=3,\n2636 |         length=50,\n2637 |         allow_unlabeled=True,\n2638 |         random_state=0,\n2639 |     )\n2640 |     X = scale(X)\n264