      color : sequence of colors, optional\n3067 |             The color of the bars can be specified globally or\n3068 |             individually. This parameter can be:\n3069 | \n3070 |             - A single color, to color all bars the same color.\n3071 |             - An array of colors of length N bars, to color each bar\n3072 |               independently.\n3073 |             - An array of colors of length 6, to color the faces of the\n3074 |               bars similarly.\n3075 |             - An array of colors of length 6 * N bars, to color each face\n3076 |               independently.\n3077 | \n3078 |             When coloring the faces of the boxes specifically, this is\n3079 |             the order of the coloring:\n3080 | \n3081 |             1. -Z (bottom of box)\n3082 |             2. +Z (top of box)\n3083 |             3. -Y\n3084 |             4. +Y\n3085 |             5. -X\n3086 |             6. +X\n3087 | \n3088 |         zsort : {'average', 'min', 'max'}, default: 'average'\n3089 |             The z-axis sorting scheme passed onto `~.art3d.Poly3DCollection`\n3090 | \n3091 |         shade : bool, default: True\n3092 |             When true, this shades the dark sides of the bars (relative\n3093 |             to the plot's source of light).\n3094 | \n3095 |         lightsource : `~matplotlib.colors.LightSource`, optional\n3096 |             The lightsource to use when *shade* is True.\n3097 | \n3098 |         axlim_clip : bool, default: False\n3099 |             Whether to hide the bars with points outside the axes view limits.\n3100 | \n3101 |             .. versionadded:: 3.10\n3102 | \n3103 |         data : indexable object, optional\n3104 |             DATA_PARAMETER_PLACEHOLDER\n3105 | \n3106 |         **kwargs\n3107 |             Any additional keyword arguments are passed onto\n3108 |             `~.art3d.Poly3DCollection`.\n3109 | \n3110 |         Returns\n3111 |         -------\n3112 |         collection : `~.art3d.Poly3DCollection`\n3113 |             A collection of three-dimensional polygons representing the bars.\n3114 |         \"\"\"\n3115 | \n3116 |         had_data = self.has_data()\n3117 | \n3118 |         x, y, z, dx, dy, dz = np.broadcast_arrays(\n3119 |             np.atleast_1d(x), y, z, dx, dy, dz)\n3120 |         minx = np.min(x)\n3121 |         maxx = np.max(x + dx)\n3122 |         miny = np.min(y)\n3123 |         maxy = np.max(y + dy)\n3124 |         minz = np.min(z)\n3125 |         maxz = np.max(z + dz)\n3126 | \n3127 |         # shape (6, 4, 3)\n3128 |         # All faces are oriented facing outwards - when viewed from the\n3129 |         # outside, their vertices are in a counterclockwise ordering.\n3130 |         cuboid = np.array([\n3131 |             # -z\n3132 |             (\n3133 |                 (0, 0, 0),\n3134 |                 (0, 1, 0),\n3135 |                 (1, 1, 0),\n3136 |                 (1, 0, 0),\n3137 |             ),\n3138 |             # +z\n3139 |             (\n3140 |                 (0, 0, 1),\n3141 |                 (1, 0, 1),\n3142 |                 (1, 1, 1),\n3143 |                 (0, 1, 1),\n3144 |             ),\n3145 |             # -y\n3146 |             (\n3147 |                 (0, 0, 0),\n3148 |                 (1, 0, 0),\n3149 |                 (1, 0, 1),\n3150 |                 (0, 0, 1),\n3151 |             ),\n3152 |             # +y\n3153 |             (\n3154 |                 (0, 1, 0),\n3155 |                 (0, 1, 1),\n3156 |                 (1, 1, 1),\n3157 |                 (1, 1, 0),\n3158 |             ),\n3159 |             # -x\n3160 |             (\n3161 |                 (0, 0, 0),\n3162 |                 (0, 0, 1),\n3163 |                 (0, 1, 1),\n3164 |                 (0, 1, 0),\n3165 |             ),\n3166 |             # +x\n3167 |             (\n3168 |                 (1, 0, 0),\n3169 |                 (1, 1, 0),\n3170 |                 (1, 1, 1),\n3171 |                 (1, 0, 1),\n3172 |             ),\n3173 |         ])\n3174 | \n3175 |         # indexed by [bar, face, vertex, coord]\n3176 |         polys = np.empty(x.shape + cuboid.shape)\n3177 | \n3178 |         # handle each coordinate separately\n3179 |         for i, p, dp in [(0, x, dx), (1, y, dy), (2, z, dz)]:\n3180 |             p = p[..., np.newaxis, np.newaxis]\n3181 |             dp = dp[..., np.newaxis, np.newaxis]\n3182 |             polys[..., i] = p + dp * cuboid[..., i]\n3183 | \n3184 |         # collapse the first two axes\n3185 |         polys = polys.reshape((-1,) + polys.shape[2:])\n3186 | \n3187 |         facecolors = []\n3188 |         if color is None:\n3189 |             color = [self._get_patches_for_fill.get_next_color()]\n3190 | \n3191 |         color = list(mcolors.to_rgba_array(color))\n3192 | \n3193 |         if len(color) == len(x):\n3194 |             # bar colors specified, need to expand to number of faces\n3195 |             for c in color:\n3196 |                 facecolors.extend([c] * 6)\n3197 |         else:\n3198 |             # a single color specified, or face colors specified explicitly\n3199 |             facecolors = color\n3200 |             if len(facecolors) < len(x):\n3201 |                 facecolors *= (6 * len(x))\n3202 | \n3203 |         col = art3d.Poly3DCollection(polys,\n3204 |                                      zsort=zsort,\n3205 |                                      facecolors=facecolors,\n3206 |                                      shade=shade,\n3207 |                                      lightsource=lightsource,\n3208 |                                      axlim_clip=axlim_clip,\n3209 |                                      *args, **kwargs)\n3210 |         self.add_collection(col)\n3211 | \n3212 |         self.auto_scale_xyz((minx, maxx), (miny, maxy), (minz, maxz), had_data)\n3213 | \n3214 |         return col\n```\n\nFound function `lib/mpl_toolkits/mplot3d/axes3d.py:Axes3D.bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2989 | def bar(self, left, height, zs=0, zdir='z', *args,\n2990 |             axlim_clip=False, **kwargs):\n2991 |         \"\"\"\n2992 |         Add 2D bar(s).\n2993 | \n2994 |         Parameters\n2995 |         ----------\n2996 |         left : 1D array-like\n2997 |             The x coordinates of the left sides of the bars.\n2998 |         height : 1D array-like\n2999 |             The height of the bars.\n3000 |         zs : float or 1D array-like, default: 0\n3001 |             Z coordinate of bars; if a single value is specified, it will be\n3002 |             used for all bars.\n3003 |         zdir : {'x', 'y', 'z'}, default: 'z'\n3004 |             When plotting 2D data, the direction to use as z ('x', 'y' or 'z').\n3005 |         axlim_clip : bool, default: False\n3006 |             Whether to hide bars with points outside the axes view limits.\n3007 | \n3008 |             .. versionadded:: 3.10\n3009 |         data : indexable object, optional\n3010 |             DATA_PARAMETER_PLACEHOLDER\n3011 |         **kwargs\n3012 |             Other keyword arguments are forwarded to\n3013 |             `matplotlib.axes.Axes.bar`.\n3014 | \n3015 |         Returns\n3016 |         -------\n3017 |         mpl_toolkits.mplot3d.art3d.Patch3DCollection\n3018 |         \"\"\"\n3019 |         had_data = self.has_data()\n3020 | \n3021 |         patches = super().bar(left, height, *args, **kwargs)\n3022 | \n3023 |         zs = np.broadcast_to(zs, len(left), subok=True)\n3024 | \n3025 |         verts = []\n3026 |         verts_zs = []\n3027 |         for p, z in zip(patches, zs):\n3028 |             vs = art3d._get_patch_verts(p)\n3029 |             verts += vs.tolist()\n3030 |             verts_zs += [z] * len(vs)\n3031 |             art3d.patch_2d_to_3d(p, z, zdir, axlim_clip)\n3032 |             if 'alpha' in kwargs:\n3033 |                 p.set_alpha(kwargs['alpha'])\n3034 | \n3035 |         if len(verts) > 0:\n3036 |             # the following has to be skipped if verts is empty\n3037 |