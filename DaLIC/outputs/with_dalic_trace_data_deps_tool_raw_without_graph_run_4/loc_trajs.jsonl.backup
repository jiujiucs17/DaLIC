3 |         # Only convert X to a numpy array if there is no cheaper, heuristic\n354 |         # option.\n355 |         X = np.asarray(X)\n356 | \n357 |     if hasattr(X, \"shape\"):\n358 |         if not hasattr(X.shape, \"__len__\") or len(X.shape) <= 1:\n359 |             message += f\" with shape {X.shape}\"\n360 |             raise TypeError(message)\n361 |         return X.shape[1]\n362 | \n363 |     first_sample = X[0]\n364 | \n365 |     # Do not consider an array-like of strings or dicts to be a 2D array\n366 |     if isinstance(first_sample, (str, bytes, dict)):\n367 |         message += f\" where the samples are of type {type(first_sample).__qualname__}\"\n368 |         raise TypeError(message)\n369 | \n370 |     try:\n371 |         # If X is a list of lists, for instance, we assume that all nested\n372 |         # lists have the same length without checking or converting to\n373 |         # a numpy array to keep this function call as cheap as possible.\n374 |         return len(first_sample)\n375 |     except Exception as err:\n376 |         raise TypeError(message) from err\n```\n\nFound function `sklearn/utils/validation.py:indexable`.\nSource: Retrieved entity using keyword search (bm25).\n```\n498 | def indexable(*iterables):\n499 |     \"\"\"Make arrays indexable for cross-validation.\n500 | \n501 |     Checks consistent length, passes through None, and ensures that everything\n502 |     can be indexed by converting sparse matrices to csr and converting\n503 |     non-iterable objects to arrays.\n504 | \n505 |     Parameters\n506 |     ----------\n507 |     *iterables : {lists, dataframes, ndarrays, sparse matrices}\n508 |         List of objects to ensure sliceability.\n509 | \n510 |     Returns\n511 |     -------\n512 |     result : list of {ndarray, sparse matrix, dataframe} or None\n513 |         Returns a list containing indexable arrays (i.e. NumPy array,\n514 |         sparse matrix, or dataframe) or `None`.\n515 | \n516 |     Examples\n517 |     --------\n518 |     >>> from sklearn.utils import indexable\n519 |     >>> from scipy.sparse import csr_matrix\n520 |     >>> import numpy as np\n521 |     >>> iterables = [\n522 |     ...     [1, 2, 3], np.array([2, 3, 4]), None, csr_matrix([[5], [6], [7]])\n523 |     ... ]\n524 |     >>> indexable(*iterables)\n525 |     [[1, 2, 3], array([2, 3, 4]), None, <...Sparse...dtype 'int64'...shape (3, 1)>]\n526 |     \"\"\"\n527 | \n528 |     result = [_make_indexable(X) for X in iterables]\n529 |     check_consistent_length(*result)\n530 |     return result\n```\n\nFound file `sklearn/utils/validation.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/utils/validation.py` for the full content if needed.\n\n\n\n##Searching for term \"validate\"...\n### Search Result:\nFound function `sklearn/utils/validation.py:check_scalar`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1758 | def check_scalar(\n1759 |     x,\n1760 |     name,\n1761 |     target_type,\n1762 |     *,\n1763 |     min_val=None,\n1764 |     max_val=None,\n1765 |     include_boundaries=\"both\",\n1766 | ):\n1767 |     \"\"\"Validate scalar parameters type and value.\n1768 | \n1769 |     Parameters\n1770 |     ----------\n1771 |     x : object\n1772 |         The scalar parameter to validate.\n1773 | \n1774 |     name : str\n1775 |         The name of the parameter to be printed in error messages.\n1776 | \n1777 |     target_type : type or tuple\n1778 |         Acceptable data types for the parameter.\n1779 | \n1780 |     min_val : float or int, default=None\n1781 |         The minimum valid value the parameter can take. If None (default) it\n1782 |         is implied that the parameter does not have a lower bound.\n1783 | \n1784 |     max_val : float or int, default=None\n1785 |         The maximum valid value the parameter can take. If None (default) it\n1786 |         is implied that the parameter does not have an upper bound.\n1787 | \n1788 |     include_boundaries : {\"left\", \"right\", \"both\", \"neither\"}, default=\"both\"\n1789 |         Whether the interval defined by `min_val` and `max_val` should include\n1790 |         the boundaries. Possible choices are:\n1791 | \n1792 |         - `\"left\"`: only `min_val` is included in the valid interval.\n1793 |           It is equivalent to the interval `[ min_val, max_val )`.\n1794 |         - `\"right\"`: only `max_val` is included in the valid interval.\n1795 |           It is equivalent to the interval `( min_val, max_val ]`.\n1796 |         - `\"both\"`: `min_val` and `max_val` are included in the valid interval.\n1797 |           It is equivalent to the interval `[ min_val, max_val ]`.\n1798 |         - `\"neither\"`: neither `min_val` nor `max_val` are included in the\n1799 |           valid interval. It is equivalent to the interval `( min_val, max_val )`.\n1800 | \n1801 |     Returns\n1802 |     -------\n1803 |     x : numbers.Number\n1804 |         The validated number.\n1805 | \n1806 |     Raises\n1807 |     ------\n1808 |     TypeError\n1809 |         If the parameter's type does not match the desired type.\n1810 | \n1811 |     ValueError\n1812 |         If the parameter's value violates the given bounds.\n1813 |         If `min_val`, `max_val` and `include_boundaries` are inconsistent.\n1814 | \n1815 |     Examples\n1816 |     --------\n1817 |     >>> from sklearn.utils.validation import check_scalar\n1818 |     >>> check_scalar(10, \"x\", int, min_val=1, max_val=20)\n1819 |     10\n1820 |     \"\"\"\n1821 | \n1822 |     def type_name(t):\n1823 |         \"\"\"Convert type into humman readable string.\"\"\"\n1824 |         module = t.__module__\n1825 |         qualname = t.__qualname__\n1826 |         if module == \"builtins\":\n1827 |             return qualname\n1828 |         elif t == numbers.Real:\n1829 |             return \"float\"\n1830 |         elif t == numbers.Integral:\n1831 |             return \"int\"\n1832 |         return f\"{module}.{qualname}\"\n1833 | \n1834 |     if not isinstance(x, target_type):\n1835 |         if isinstance(target_type, tuple):\n1836 |             types_str = \", \".join(type_name(t) for t in target_type)\n1837 |             target_type_str = f\"{{{types_str}}}\"\n1838 |         else:\n1839 |             target_type_str = type_name(target_type)\n1840 | \n1841 |         raise TypeError(\n1842 |             f\"{name} must be an instance of {target_type_str}, not\"\n1843 |             f\" {type(x).__qualname__}.\"\n1844 |         )\n1845 | \n1846 |     expected_include_boundaries = (\"left\", \"right\", \"both\", \"neither\")\n1847 |     if include_boundaries not in expected_include_boundaries:\n1848 |         raise ValueError(\n1849 |             f\"Unknown value for `include_boundaries`: {repr(include_boundaries)}. \"\n1850 |             f\"Possible values are: {expected_include_boundaries}.\"\n1851 |         )\n1852 | \n1853 |     if max_val is None and include_boundaries == \"right\":\n1854 |         raise ValueError(\n1855 |             \"`include_boundaries`='right' without specifying explicitly `max_val` \"\n1856 |             \"is inconsistent.\"\n1857 |         )\n1858 | \n1859 |     if min_val is None and include_boundaries == \"left\":\n1860 |         raise ValueError(\n1861 |             \"`include_boundaries`='left' without specifying explicitly `min_val` \"\n1862 |             \"is inconsistent.\"\n1863 |         )\n1864 | \n1865 |     comparison_operator = (\n1866 |         operator.lt if include_boundaries in (\"left\", \"both\") else operator.le\n1867 |     )\n1868 |     if min_val is not None and comparison_operator(x, min_val):\n1869 |         raise ValueError(\n1870 |             f\"{name} == {x}, must be\"\n1871 |             f\" {'>=' if include_boundaries in ('left', 'both') else '>'} {min_val}.\"\n1872 |         )\n1873 | \n1874 |     comparison_operator = (\n1875 |         operator.gt if include_boundaries in (\"right\", \"both\") else operator.g