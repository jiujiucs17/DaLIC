out='constrained')\n46 | \n47 | for i, color in enumerate(colors):\n48 |     ax.plot([0, i], color=color)\n49 | \n50 | plt.show()\n51 | \n52 | # %%\n53 | # See Also\n54 | # --------\n55 | #\n56 | # For more details about manipulating colormaps, see :ref:`colormap-manipulation`.  To\n57 | # change the default color cycle, see :ref:`color_cycle`.\n58 | #\n59 | # .. admonition:: References\n60 | #\n61 | #    The use of the following functions, methods, classes and modules is shown\n62 | #    in this example:\n63 | #\n64 | #    - `matplotlib.colors.Colormap`\n65 | #    - `matplotlib.colors.Colormap.resampled`\n66 | #\n67 | # .. tags::\n68 | #\n69 | #    component: colormap\n70 | #    styling: color\n71 | #    plot-type: line\n72 | #    level: intermediate\n73 | \n```\n\nFound class `lib/matplotlib/colorizer.py:Colorizer`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass Colorizer:\n    def __init__(self, cmap=None, norm=None):\n...\n    def _scale_norm(self, norm, vmin, vmax, A):\n...\n    @property\n    def norm(self):\n...\n    @norm.setter\n    def norm(self, norm):\n...\n    def to_rgba(self, x, alpha=None, bytes=False, norm=True):\n...\n    @staticmethod\n    def _pass_image_data(x, alpha=None, bytes=False, norm=True):\n...\n    def autoscale(self, A):\n...\n    def autoscale_None(self, A):\n...\n    def _set_cmap(self, cmap):\n...\n    @property\n    def cmap(self):\n...\n    @cmap.setter\n    def cmap(self, cmap):\n...\n    def set_clim(self, vmin=None, vmax=None):\n...\n    def get_clim(self):\n...\n    def changed(self):\n...\n    @property\n    def vmin(self):\n...\n    @vmin.setter\n    def vmin(self, vmin):\n...\n    @property\n    def vmax(self):\n...\n    @vmax.setter\n    def vmax(self, vmax):\n...\n    @property\n    def clip(self):\n...\n    @clip.setter\n    def clip(self, clip):\n\n```\nHint: Search `lib/matplotlib/colorizer.py:Colorizer` to get the full content if needed.\n\nFound function `lib/matplotlib/colorizer.py:Colorizer.autoscale_None`.\nSource: Retrieved entity using keyword search (bm25).\n```\n215 | def autoscale_None(self, A):\n216 |         \"\"\"\n217 |         Autoscale the scalar limits on the norm instance using the\n218 |         current array, changing only limits that are None\n219 |         \"\"\"\n220 |         if A is None:\n221 |             raise TypeError('You must first set_array for mappable')\n222 |         # If the norm's limits are updated self.changed() will be called\n223 |         # through the callbacks attached to the norm\n224 |         self.norm.autoscale_None(A)\n```\n\nFound class `lib/matplotlib/colorizer.py:ColorizingArtist`.\nSource: Retrieved code content using keyword search (bm25).\n```\n631 | class ColorizingArtist(_ScalarMappable, artist.Artist):\n632 |     \"\"\"\n633 |     Base class for artists that make map data to color using a `.colorizer.Colorizer`.\n634 | \n635 |     The `.colorizer.Colorizer` applies data normalization before\n636 |     returning RGBA colors from a `~matplotlib.colors.Colormap`.\n637 | \n638 |     \"\"\"\n639 |     def __init__(self, colorizer, **kwargs):\n640 |         \"\"\"\n641 |         Parameters\n642 |         ----------\n643 |         colorizer : `.colorizer.Colorizer`\n644 |         \"\"\"\n645 |         _api.check_isinstance(Colorizer, colorizer=colorizer)\n646 |         super().__init__(colorizer=colorizer, **kwargs)\n647 | \n648 |     @property\n649 |     def colorizer(self):\n650 |         return self._colorizer\n651 | \n652 |     @colorizer.setter\n653 |     def colorizer(self, cl):\n654 |         _api.check_isinstance(Colorizer, colorizer=cl)\n655 |         self._colorizer.callbacks.disconnect(self._id_colorizer)\n656 |         self._colorizer = cl\n657 |         self._id_colorizer = cl.callbacks.connect('changed', self.changed)\n658 | \n659 |     def _set_colorizer_check_keywords(self, colorizer, **kwargs):\n660 |         \"\"\"\n661 |         Raises a ValueError if any kwarg is not None while colorizer is not None.\n662 |         \"\"\"\n663 |         self._check_exclusionary_keywords(colorizer, **kwargs)\n664 |         self.colorizer = colorizer\n```\n\nFound function `galleries/users_explain/colors/colors.py:demo`.\nSource: Retrieved entity using keyword search (bm25).\n```\n155 | def demo(sty):\n156 |     mpl.style.use(sty)\n157 |     fig, ax = plt.subplots(figsize=(3, 3))\n158 | \n159 |     ax.set_title(f'style: {sty!r}', color='C0')\n160 | \n161 |     ax.plot(th, np.cos(th), 'C1', label='C1')\n162 |     ax.plot(th, np.sin(th), 'C2', label='C2')\n163 |     ax.legend()\n```\n\nFound function `lib/matplotlib/colors.py:LinearSegmentedColormap.from_list`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1081 | def from_list(name, colors, N=256, gamma=1.0):\n1082 |         \"\"\"\n1083 |         Create a `LinearSegmentedColormap` from a list of colors.\n1084 | \n1085 |         Parameters\n1086 |         ----------\n1087 |         name : str\n1088 |             The name of the colormap.\n1089 |         colors : list of :mpltype:`color` or list of (value, color)\n1090 |             If only colors are given, they are equidistantly mapped from the\n1091 |             range :math:`[0, 1]`; i.e. 0 maps to ``colors[0]`` and 1 maps to\n1092 |             ``colors[-1]``.\n1093 |             If (value, color) pairs are given, the mapping is from *value*\n1094 |             to *color*. This can be used to divide the range unevenly.\n1095 |         N : int\n1096 |             The number of RGB quantization levels.\n1097 |         gamma : float\n1098 |         \"\"\"\n1099 |         if not np.iterable(colors):\n1100 |             raise ValueError('colors must be iterable')\n1101 | \n1102 |         if (isinstance(colors[0], Sized) and len(colors[0]) == 2\n1103 |                 and not isinstance(colors[0], str)):\n1104 |             # List of value, color pairs\n1105 |             vals, colors = zip(*colors)\n1106 |         else:\n1107 |             vals = np.linspace(0, 1, len(colors))\n1108 | \n1109 |         r, g, b, a = to_rgba_array(colors).T\n1110 |         cdict = {\n1111 |             \"red\": np.column_stack([vals, r, r]),\n1112 |             \"green\": np.column_stack([vals, g, g]),\n1113 |             \"blue\": np.column_stack([vals, b, b]),\n1114 |             \"alpha\": np.column_stack([vals, a, a]),\n1115 |         }\n1116 | \n1117 |         return LinearSegmentedColormap(name, cdict, N, gamma)\n```\n\nFound file `galleries/users_explain/colors/colors.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `galleries/users_explain/colors/colors.py` for the full content if needed.\n\n\n\n##Searching for term \"bar() facecolor edgecolor color\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/set_alpha.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =================================\n 3 | Ways to set a color's alpha value\n 4 | =================================\n 5 | \n 6 | Compare setting alpha by the *alpha* keyword argument and by one of the Matplotlib color\n 7 | formats. Often, the *alpha* keyword is the only tool needed to add transparency to a\n 8 | color. In some cases, the *(matplotlib_color, alpha)* color format provides an easy way\n 9 | to fine-tune the appearance of a Figure.\n10 | \n11 | \"\"\"\n12 | \n13 | import matplotlib.pyplot as plt\n14 | import numpy as np\n15 | \n16 | # Fixing random state for reproducibility.\n17 | np.random.seed(19680801)\n18 | \n19 | fig, (ax1, ax2) = plt.subplots(ncols=2, figsize=(8, 4))\n20 | \n21 | x_values = [n for n in range(20)]\n22 | y_values = np.random.randn(20)\n23 | \n24 | facecolors = ['green' if y > 0 else 'red' for y in y_values]\n25 | edgecolors = facecolors\n26 | \n27 | ax1.bar(x_values, y_values, color=facecolors, edgecolor=edgecolors, alpha=0.5)\n28 | ax1.set_title(\"Explicit 'alpha' keyword value\\nshared by all bars and edges\")\n29 | \n30 | \n31 | # Normalize y values to get distinct face alpha values.\n32 | abs_y = [abs(y) for y in y_values]\n33 | face_alphas = [n / max(abs_y) for n in abs_y]\n34 | edge_alphas = [1 - alpha for alpha in face_alphas]\n35 | \n36 | colors_with_alphas = list(zip(facecolors, face_alphas))\n37 | edgecolors_with_alphas = list(zip(edgecolors, edge_alphas))\n38 | \n39 | ax2.bar(x_values, y_values, color=colors_with_alphas,\n40 |         edgecolor=edgecolors_with_alphas)\n41 | ax2.set_title('Normalized alphas for\\neach bar and each edge')\n42 | \n43 | plt.show()\n44 | \n45 | # %%\n46 | #\n47 | # .. admonition:: References\n48 | #\n49 | #    The use of the following functions, methods, classes and modules is shown\n50 | #    in this example:\n51 | #\n52 | #    - `matplotlib.axes.Axes.bar`\n53 | #    - `matplotlib.pyplot.subplots`\n54 | #\n55 | # .. tags::\n56 | #\n57 | #    styling: color\n58 | #    plot-type: bar\n59 | #    level: beginner\n60 | \n```\n\nFound code snippet in file `galleries/examples/statistics/histogram_multihist.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =====================================================\n  3 | The histogram (hist) function with multiple data sets\n  4 | =====================================================\n  5 | \n  6 | Plot histogram with multiple sample sets and demonstrate:\n  7 | \n  8 | * Use of legend with multiple sample sets\n  9 | * Stacked bars\n 10 | * Step curve with no fill\n 11 | * Data sets of different sample sizes\n 12 | \n 13 | Selecting different bin counts and sizes can significantly affect the\n 14 | shape of a histogram. The Astropy docs have a great section on how to\n 15 | select these parameters:\n 16 | http://docs.astropy.org/en/stable/visualization/histogram.html\n 17 | \n 18 | .. redirect-from:: /gallery/lines_bars_and_markers/filled_step\n 19 | \n 20 | \"\"\"\n 21 | # %%\n 22 | import matplotlib.pyplot as plt\n 23 | import numpy as np\n 24 | \n 25 | np.random.seed(19680801)\n 26 | \n 27 | n_bins = 10\n 28 | x = np.random.randn(1000, 3)\n 29 | \n 30 | fig, ((ax0, ax1), (ax2, ax3)) = plt.subplots(nrows=2, ncols=2)\n 31 | \n 32 | colors = ['red', 'tan', 'lime']\n 33 | ax0.hist(x, n_bins, density=True, histtype='bar', color=colors, label=colors)\n 34 | ax0.legend(prop={'size': 10})\n 35 | ax0.set_title('bars with legend')\n 36 | \n 37 | ax1.hist(x, n_bins, density=True, histtype='bar', stacked=True)\n 38 | ax1.set_title('stacked bar')\n 39 | \n 40 | ax2.hist(x, n_bins, histtype='step', stacked=True, fill=False)\n 41 | ax2.set_title('stack step (unfilled)')\n 42 | \n 43 | # Make a multiple-histogram of data-sets with different length.\n 44 | x_multi = [np.random.randn(n) for n in [10000, 5000, 2000]]\n 45 | ax3.hist(x_multi, n_bins, histtype='bar')\n 46 | ax3.set_title('different sample sizes')\n 47 | \n 48 | fig.tight_layout()\n 49 | plt.show()\n 50 | \n 51 | # %%\n 52 | # -----------------------------------\n 53 | # Setting properties for each dataset\n 54 | # -----------------------------------\n 55 | #\n 56 | # You can style the histograms individually by passing a list of values to the\n 57 | # following parameters:\n 58 | #\n 59 | # * edgecolor\n 60 | # * facecolor\n 61 | # * hatch\n 62 | # * linewidth\n 63 | # * linestyle\n 64 | #\n 65 | #\n 66 | # edgecolor\n 67 | # .........\n 68 | \n 69 | fig, ax = plt.subplots()\n 70 | \n 71 | edgecolors = ['green', 'red', 'blue']\n 72 | \n 73 | ax.hist(x, n_bins, fill=False, histtype=\"step\", stacked=True,\n 74 |         edgecolor=edgecolors, label=edgecolors)\n 75 | ax.legend()\n 76 | ax.set_title('Stacked Steps with Edgecolors')\n 77 | \n 78 | plt.show()\n 79 | \n 80 | # %%\n 81 | # facecolor\n 82 | # .........\n```\n\nFound function `lib/matplotlib/axes/_axes.py:Axes.hist`.\nSource: Retrieved code content using keyword search (bm25).\n```\n6728 | def hist(self, x, bins=None, range=None, density=False, weights=None,\n6729 |              cumulative=False, bottom=None, histtype='bar', align='mid',\n6730 |              orientation='vertical', rwidth=None, log=False,\n6731 |              color=None, label=None, stacked=False, **kwargs):\n6732 |         \"\"\"\n6733 |         Compute and plot a histogram.\n6734 | \n6735 |         This method uses `numpy.histogram` to bin the data in *x* and count the\n6736 |         number of values in each bin, then draws the distribution either as a\n6737 |         `.BarContainer` or `.Polygon`. The *bins*, *range*, *density*, and\n6738 |         *weights* parameters are forwarded to `numpy.histogram`.\n6739 | \n6740 |         If the data has already been binned and counted, use `~.bar` or\n6741 |         `~.stairs` to plot the distribution::\n6742 | \n6743 |             counts, bins = np.histogram(x)\n6744 |             plt.stairs(counts, bins)\n6745 | \n6746 |         Alternatively, plot pre-computed bins and counts using ``hist()`` by\n6747 |         treating each bin as a single point with a weight equal to its count::\n6748 | \n6749 |             plt.hist(bins[:-1], bins, weights=counts)\n6750 | \n6751 |         The data input *x* can be a singular array, a list of datasets of\n6752 |         potentially different lengths ([*x0*, *x1*, ...]), or a 2D ndarray in\n6753 |         which each column is a dataset. Note that the ndarray form is\n6754 |         transposed relative to the list form. If the input is an array, then\n6755 |         the return value is a tuple (*n*, *bins*, *patches*); if the input is a\n6756 |         sequence of arrays, then the return value is a tuple\n6757 |         ([*n0*, *n1*, ...], *bins*, [*patches0*, *patches1*, ...]).\n6758 | \n6759 |         Masked arrays are not supported.\n6760 | \n6761 |         Parameters\n6762 |         ----------\n6763 |         x : (n,) array or sequence of (n,) arrays\n6764 |             Input values, this takes either a single array or a sequence of\n6765 |             arrays which are not required to be of the same length.\n6766 | \n6767 |         bins : int or sequence or str, default: :rc:`hist.bins`\n6768 |             If *bins* is an integer, it defines the number of equal-width bins\n6769 |             in the range.\n6770 | \n6771 |             If *bins* is a sequence, it defines the bin edges, including the\n6772 |             left edge of the first bin and the right edge of the last bin;\n6773 |             in this case, bins may be unequally spaced.  All but the last\n6774 |             (righthand-most) bin is half-open.  In other words, if *bins* is::\n6775 | \n6776 |                 [1, 2, 3, 4]\n6777 | \n6778 |             then the first bin is ``[1, 2)`` (including 1, but excluding 2) and\n6779 |             the second ``[2, 3)``.  The last bin, however, is ``[3, 4]``, which\n6780 |             *includes* 4.\n6781 | \n6782 |             If *bins* is a string, it is one of the binning strategies\n6783 |             supported by `numpy.histogram_bin_edges`: 'auto', 'fd', 'doane',\n6784 |             'scott', 'stone', 'rice', 'sturges', or 'sqrt'.\n6785 | \n6786 |         range : tuple or None, default: None\n6787 |             The lower and upper range of the bins. Lower and upper outliers\n6788 |             are ignored. If not provided, *range* is ``(x.min(), x.max())``.\n6789 |             Range has no effect if *bins* is a sequence.\n6790 | \n6791 |             If *bins* is a sequence or *range* is specified, autoscaling\n6792 |             is based on the specified bin range instead of the\n6793 |             range of x.\n6794 | \n6795 |         density : bool, default: False\n6796 |             If ``True``, draw and return a probability density: each bin\n6797 |             will display the bin's raw count divided by the total number of\n6798 |             counts *and the bin width*\n6799 |             (``density = counts / (sum(counts) * np.diff(bins))``),\n6800 |             so that the area under the histogram integrates to 1\n6801 |             (``np.sum(density * np.diff(bins)) == 1``).\n6802 | \n6803 |             If *stacked* is also ``True``, the sum of the histograms is\n6804 |             normalized to 1.\n6805 | \n6806 |         weights : (n,) array-like or None, default: None\n6807 |             An array of weights, of the same shape as *x*.  Each value in\n6808 |             *x* only contributes its associated weight towards the bin count\n6809 |             (instead of 1).  If *density* is ``True``, the weights are\n6810 |             normalized, so that the integral of the density over the range\n6811 |             remains 1.\n6812 | \n6813 |         cumulative : bool or -1, default: False\n6814 |             If ``True``, then a histogram is computed where each bin gives the\n6815 |             counts in that bin plus all bins for smaller values. The last bin\n6816 |             gives the total number of datapoints.\n6817 | \n6818 |             If *density* is also ``True`` then the histogram is normalized such\n6819 |             that the last bin equals 1.\n6820 | \n6821 |             If *cumulative* is a number less than 0 (e.g., -1), the direction\n6822 |             of accumulation is reversed.  In this case, if *density* is also\n6823 |             ``True``, then the histogram is normalized such that the first bin\n6824 |             equals 1.\n6825 | \n6826 |         bottom : array-like, scalar, or None, default: None\n6827 |             Location of the bottom of each bin, i.e. bins are drawn from\n6828 |             ``bottom`` to ``bottom + hist(x, bins)`` If a scalar, the bottom\n6829 |             of each bin is shifted by the same amount. If an array, each bin\n6830 |             is shifted independently and the length of bottom must match the\n6831 |             number of bins. If None, defaults to 0.\n6832 | \n6833 |         histtype : {'bar', 'barstacked', 'step', 'stepfilled'}, default: 'bar'\n6834 |             The type of histogram to draw.\n6835 | \n6836 |             - 'bar' is a traditional bar-type histogram.  If multiple data\n6837 |               are given the bars are arranged side by side.\n6838 |             - 'barstacked' is a bar-type histogram where multiple\n6839 |               data are stacked on top of each other.\n6840 |             - 'step' generates a lineplot that is by default unfilled.\n6841 |             - 'stepfilled' generates a lineplot that is by default filled.\n6842 | \n6843 |         align : {'left', 'mid', 'right'}, default: 'mid'\n6844 |             The horizontal alignment of the histogram bars.\n6845 | \n6846 |             - 'left': bars are centered on the left bin edges.\n6847 |             - 'mid': bars are centered between the bin edges.\n6848 |             - 'right': bars are centered on the right bin edges.\n6849 | \n6850 |         orientation : {'vertical', 'horizontal'}, default: 'vertical'\n6851 |             If 'horizontal', `~.Axes.barh` will be used for bar-type histograms\n6852 |             and the *bottom* kwarg will be the left edges.\n6853 | \n6854 |         rwidth : float or None, default: None\n6855 |             The relative width of the bars as a fraction of the bin width.  If\n6856 |             ``None``, automatically compute the width.\n6857 | \n6858 |             Ignored if *histtype* is 'step' or 'stepfilled'.\n6859 | \n6860 |         log : bool, default: False\n6861 |             If ``True``, the histogram axis will be set to a log scale.\n6862 | \n6863 |         color : :mpltype:`color` or list of :mpltype:`color` or None, default: None\n6864 |             Color or sequence of colors, one per dataset.  Default (``None``)\n6865 |             uses the standard line color sequence.\n6866 | \n6867 |         label : str or list of str, optional\n6868 |             String, or sequence of strings to match multiple datasets.  Bar\n6869 |             charts yield multiple patches per dataset, but only the first gets\n6870 |             the label, so that `~.Axes.legend` will work as expected.\n6871 | \n6872 |         stacked : bool, default: False\n6873 |             If ``True``, multiple data are stacked on top of each other If\n6874 |             ``False`` multiple data are arranged side by side if histtype is\n6875 |             'bar' or on top of each other if histtype is 'step'\n6876 | \n6877 |         Returns\n6878 |         -------\n6879 |         n : array or list of arrays\n6880 |             The values of the histogram bins. See *density* and *weights* for a\n6881 |             description of the possible semantics.  If input *x* is an array,\n6882 |             then this is an array of length *nbins*. If input is a sequence of\n6883 |             arrays ``[data1, data2, ...]``, then this is a list of arrays with\n6884 |             the values of the histograms for each of the arrays in the same\n6885 |             order.  The dtype of the array *n* (or of its element arrays) will\n6886 |             always be float even if no weighting or normalization is used.\n6887 | \n6888 |         bins : array\n6889 |             The edges of the bins. Length nbins + 1 (nbins left edges and right\n6890 |             edge of last bin).  Always a single array even when multiple data\n6891 |             sets are passed in.\n6892 | \n6893 |         patches : `.BarContainer` or list of a single `.Polygon` or list of \\\n6894 | such objects\n6895 |             Container of individual artists used to create the histogram\n6896 |             or list of such containers if there are multiple input datasets.\n6897 | \n6898 |         Other Parameters\n6899 |         ----------------\n6900 |         data : indexable object, optional\n6901 |             DATA_PARAMETER_PLACEHOLDER\n6902 | \n6903 |         **kwargs\n6904 |             `~matplotlib.patches.Patch` properties. The following properties\n6905 |             additionally accept a sequence of values corresponding to the\n6906 |             datasets in *x*:\n6907 |             *edgecolor*, *facecolor*, *linewidth*, *linestyle*, *hatch*.\n6908 | \n6909 |             .. versionadded:: 3.10\n6910 |                Allowing sequences of values in above listed Patch properties.\n6911 | \n6912 |         See Also\n6913 |         --------\n6914 |         hist2d : 2D histogram with rectangular bins\n6915 |         hexbin : 2D histogram with hexagonal bins\n6916 |         stairs : Plot a pre-computed histogram\n6917 |         bar : Plot a pre-computed histogram\n6918 | \n6919 |         Notes\n6920 |         -----\n6921 |         For large numbers of bins (>1000), plotting can be significantly\n6922 |         accelerated by using `~.Axes.stairs` to plot a pre-computed histogram\n6923 |         (``plt.stairs(*np.histogram(data))``), or by setting *histtype* to\n6924 |         'step' or 'stepfilled' rather than 'bar' or 'barstacked'.\n6925 |         \"\"\"\n6926 |         # Avoid shadowing the builtin.\n6927 |         bin_range = range\n6928 |         from builtins import range\n6929 | \n6930 |         if np.isscalar(x):\n6931 |             x = [x]\n6932 | \n6933 |         if bins is None:\n6934 |             bins = mpl.rcParams['hist.bins']\n6935 | \n6936 |         # Validate string inputs here to avoid cluttering subsequent code.\n6937 |         _api.check_in_list(['bar', 'barstacked', 'step', 'stepfilled'],\n6938 |                            histtype=histtype)\n6939 |         _api.check_in_list(['left', 'mid', 'right'], align=align)\n6940 |         _api.check_in_list(['horizontal', 'vertical'], orientation=orientation)\n6941 | \n6942 |         if histtype == 'barstacked' and not stacked:\n6943 |             stacked = True\n6944 | \n6945 |         # Massage 'x' for processing.\n6946 |         x = cbook._reshape_2D(x, 'x')\n6947 |         nx = len(x)  # number of datasets\n6948 | \n6949 |         # Process unit information.  _process_unit_info sets the unit and\n6950 |         # converts the first dataset; then we convert each following dataset\n6951 |         # one at