_ = np.c_[np.asarray(y), np.asarray(y)]\n4229 |         y_[::2, 1] *= 2\n4230 | \n4231 |     X_transform = transformer.fit_transform(X, y=y_)\n4232 |     input_features = [f\"feature{i}\" for i in range(n_features)]\n4233 | \n4234 |     # input_features names is not the same length as n_features_in_\n4235 |     with raises(ValueError, match=\"input_features should have length equal\"):\n4236 |         transformer.get_feature_names_out(input_features[::2])\n4237 | \n4238 |     feature_names_out = transformer.get_feature_names_out(input_features)\n4239 |     assert feature_names_out is not None\n4240 |     assert isinstance(feature_names_out, np.ndarray)\n4241 |     assert feature_names_out.dtype == object\n4242 |     assert all(isinstance(name, str) for name in feature_names_out)\n4243 | \n4244 |     if isinstance(X_transform, tuple):\n4245 |         n_features_out = X_transform[0].shape[1]\n4246 |     else:\n4247 |         n_features_out = X_transform.shape[1]\n4248 | \n4249 |     assert (\n4250 |         len(feature_names_out) == n_features_out\n4251 |     ), f\"Expected {n_features_out} feature names, got {len(feature_names_out)}\"\n```\n\n\n\n##Searching for term \"assert\", \"validate consistency assert\"...\n### Search Result:\nFound function `sklearn/utils/estimator_checks.py:check_array_api_input`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 875 | def check_array_api_input(\n 876 |     name,\n 877 |     estimator_orig,\n 878 |     array_namespace,\n 879 |     device=None,\n 880 |     dtype_name=\"float64\",\n 881 |     check_values=False,\n 882 | ):\n 883 |     \"\"\"Check that the estimator can work consistently with the Array API\n 884 | \n 885 |     By default, this just checks that the types and shapes of the arrays are\n 886 |     consistent with calling the same estimator with numpy arrays.\n 887 | \n 888 |     When check_values is True, it also checks that calling the estimator on the\n 889 |     array_api Array gives the same results as ndarrays.\n 890 |     \"\"\"\n 891 |     xp = _array_api_for_tests(array_namespace, device)\n 892 | \n 893 |     X, y = make_classification(random_state=42)\n 894 |     X = X.astype(dtype_name, copy=False)\n 895 | \n 896 |     X = _enforce_estimator_tags_X(estimator_orig, X)\n 897 |     y = _enforce_estimator_tags_y(estimator_orig, y)\n 898 | \n 899 |     est = clone(estimator_orig)\n 900 | \n 901 |     X_xp = xp.asarray(X, device=device)\n 902 |     y_xp = xp.asarray(y, device=device)\n 903 | \n 904 |     est.fit(X, y)\n 905 | \n 906 |     array_attributes = {\n 907 |         key: value for key, value in vars(est).items() if isinstance(value, np.ndarray)\n 908 |     }\n 909 | \n 910 |     est_xp = clone(est)\n 911 |     with config_context(array_api_dispatch=True):\n 912 |         est_xp.fit(X_xp, y_xp)\n 913 |         input_ns = get_namespace(X_xp)[0].__name__\n 914 | \n 915 |     # Fitted attributes which are arrays must have the same\n 916 |     # namespace as the one of the training data.\n 917 |     for key, attribute in array_attributes.items():\n 918 |         est_xp_param = getattr(est_xp, key)\n 919 |         with config_context(array_api_dispatch=True):\n 920 |             attribute_ns = get_namespace(est_xp_param)[0].__name__\n 921 |         assert attribute_ns == input_ns, (\n 922 |             f\"'{key}' attribute is in wrong namespace, expected {input_ns} \"\n 923 |             f\"got {attribute_ns}\"\n 924 |         )\n 925 | \n 926 |         assert array_device(est_xp_param) == array_device(X_xp)\n 927 | \n 928 |         est_xp_param_np = _convert_to_numpy(est_xp_param, xp=xp)\n 929 |         if check_values:\n 930 |             assert_allclose(\n 931 |                 attribute,\n 932 |                 est_xp_param_np,\n 933 |                 err_msg=f\"{key} not the same\",\n 934 |                 atol=_atol_for_type(X.dtype),\n 935 |             )\n 936 |         else:\n 937 |             assert attribute.shape == est_xp_param_np.shape\