d avoid a copy\n2048 |         (if the input is already a numpy array or a scipy.sparse CSR / CSC\n2049 |         matrix and if axis is 1).\n2050 | \n2051 |     Returns\n2052 |     -------\n2053 |     X_tr : {ndarray, sparse matrix} of shape (n_samples, n_features)\n2054 |         The transformed data.\n2055 | \n2056 |     See Also\n2057 |     --------\n2058 |     Binarizer : Performs binarization using the Transformer API\n2059 |         (e.g. as part of a preprocessing :class:`~sklearn.pipeline.Pipeline`).\n2060 |     \"\"\"\n2061 |     X = check_array(X, accept_sparse=[\"csr\", \"csc\"], copy=copy)\n2062 |     if sparse.issparse(X):\n2063 |         if threshold < 0:\n2064 |             raise ValueError(\"Cannot binarize a sparse matrix with threshold < 0\")\n2065 |         cond = X.data > threshold\n2066 |         not_cond = np.logical_not(cond)\n2067 |         X.data[cond] = 1\n2068 |         X.data[not_cond] = 0\n2069 |         X.eliminate_zeros()\n2070 |     else:\n2071 |         cond = X > threshold\n2072 |         not_cond = np.logical_not(cond)\n2073 |         X[cond] = 1\n2074 |         X[not_cond] = 0\n2075 |     return X\n```\n\n\n\n##Searching for term \"design_matrix\"...\n### Search Result:\nFound class `sklearn/cross_decomposition/_pls.py:PLSSVD`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSSVD(ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator):\n\n    _parameter_constraints: dict = {\n        \"n_components\": [Interval(Integral, 1, None, closed=\"left\")],\n        \"scale\": [\"boolean\"],\n        \"copy\": [\"boolean\"],\n    }\n\n    def __init__(self, n_components=2, *, scale=True, copy=True):\n...\n    def fit(self, X, Y):\n...\n    def transform(self, X, Y=None):\n...\n    def fit_transform(self, X, y=None):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSSVD` to get the full content if needed.\n\nFound function `sklearn/linear_model/_ridge.py:_RidgeGCV._svd_decompose_design_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1913 | def _svd_decompose_design_matrix(self, X, y, sqrt_sw):\n1914 |         # X already centered\n1915 |         X_mean = np.zeros(X.shape[1], dtype=X.dtype)\n1916 |         if self.fit_intercept:\n1917 |             # to emulate fit_intercept=True situation, add a column\n1918 |             # containing the square roots of the sample weights\n1919 |             # by centering, the other columns are orthogonal to that one\n1920 |             intercept_column = sqrt_sw[:, None]\n1921 |             X = np.hstack((X, intercept_column))\n1922 |         U, singvals, _ = linalg.svd(X, full_matrices=0)\n1923 |         singvals_sq = singvals**2\n1924 |         UT_y = np.dot(U.T, y)\n1925 |         return X_mean, singvals_sq, U, UT_y\n```\n\nFound function `sklearn/linear_model/_ridge.py:_RidgeGCV._solve_svd_design_matrix`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1927 | def _solve_svd_design_matrix(self, alpha, y, sqrt_sw, X_mean, singvals_sq, U, UT_y):\n1928 |         \"\"\"Compute dual coefficients and diagonal of G^-1.\n1929 | \n1930 |         Used when we have an SVD decomposition of X\n1931 |         (n_samples > n_features and X is dense).\n1932 |         \"\"\"\n1933 |         w = ((singvals_sq + alpha) ** -1) - (alpha**-1)\n1934 |         if self.fit_intercept:\n1935 |             # detect intercept column\n1936 |             normalized_sw = sqrt_sw / np.linalg.norm(sqrt_sw)\n1937 |             intercept_dim = _find_smallest_angle(normalized_sw, U)\n1938 |             # cancel the regularization for the intercept\n1939 |             w[intercept_dim] = -(alpha**-1)\n1940 |         c = np.dot(U, self._diag_dot(w, UT_y)) + (alpha**-1) * y\n1941 |         G_inverse_diag = self._decomp_diag(w, U) + (alpha**-1)\n1942 |         if len(y.shape) != 1:\n1943 |             # handle case where y is 2-d\n1944 |           