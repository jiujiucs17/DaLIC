x_weights\n110 | \n111 |     n_iter = i + 1\n112 |     if n_iter == max_iter:\n113 |         warnings.warn(\"Maximum number of iterations reached\", ConvergenceWarning)\n114 | \n115 |     return x_weights, y_weights, n_iter\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_center_scale_xy`.\nSource: Retrieved code content using keyword search (bm25).\n```\n128 | def _center_scale_xy(X, Y, scale=True):\n129 |     \"\"\"Center X, Y and scale if the scale parameter==True\n130 | \n131 |     Returns\n132 |     -------\n133 |         X, Y, x_mean, y_mean, x_std, y_std\n134 |     \"\"\"\n135 |     # center\n136 |     x_mean = X.mean(axis=0)\n137 |     X -= x_mean\n138 |     y_mean = Y.mean(axis=0)\n139 |     Y -= y_mean\n140 |     # scale\n141 |     if scale:\n142 |         x_std = X.std(axis=0, ddof=1)\n143 |         x_std[x_std == 0.0] = 1.0\n144 |         X /= x_std\n145 |         y_std = Y.std(axis=0, ddof=1)\n146 |         y_std[y_std == 0.0] = 1.0\n147 |         Y /= y_std\n148 |     else:\n149 |         x_std = np.ones(X.shape[1])\n150 |         y_std = np.ones(Y.shape[1])\n151 |     return X, Y, x_mean, y_mean, x_std, y_std\n```\n\n\n\n##Searching for term \"docstring\"...\n### Search Result:\nFound `sklearn/utils/deprecation.py:deprecated`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | import functools\n  5 | import warnings\n  6 | \n  7 | __all__ = [\"deprecated\"]\n  8 | \n  9 | \n 10 | class deprecated:\n 11 |     \"\"\"Decorator to mark a function or class as deprecated.\n 12 | \n 13 |     Issue a warning when the function is called/the class is instantiated and\n 14 |     adds a warning to the docstring.\n 15 | \n 16 |     The optional extra argument will be appended to the deprecation message\n 17 |     and the docstring. Note: to use this with the default value for extra, put\n 18 |     in an empty of parentheses:\n 19 | \n 20 |     Examples\n 21 |     --------\n 22 |     >>> from sklearn.utils import deprecated\n 23 | 