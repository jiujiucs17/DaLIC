c_only:\n874 |         return np.nan\n875 | \n876 |     if isinstance(constraint, MissingValues) and not constraint.numeric_only:\n877 |         return \"missing\"\n878 | \n879 |     if isinstance(constraint, HasMethods):\n880 |         return type(\n881 |             \"ValidHasMethods\", (), {m: lambda self: None for m in constraint.methods}\n882 |         )()\n883 | \n884 |     if isinstance(constraint, _IterablesNotString):\n885 |         return [1, 2, 3]\n886 | \n887 |     if isinstance(constraint, _CVObjects):\n888 |         return 5\n889 | \n890 |     if isinstance(constraint, Options):  # includes StrOptions\n891 |         for option in constraint.options:\n892 |             return option\n893 | \n894 |     if isinstance(constraint, Interval):\n895 |         interval = constraint\n896 |         if interval.left is None and interval.right is None:\n897 |             return 0\n898 |         elif interval.left is None:\n899 |             return interval.right - 1\n900 |         elif interval.right is None:\n901 |             return interval.left + 1\n902 |         else:\n903 |             if interval.type is Real:\n904 |                 return (interval.left + interval.right) / 2\n905 |             else:\n906 |                 return interval.left + 1\n907 | \n908 |     raise ValueError(f\"Unknown constraint type: {constraint}\")\n```\n\nFound function `sklearn/utils/validation.py:_is_pandas_df_or_series`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2262 | def _is_pandas_df_or_series(X):\n2263 |     \"\"\"Return True if the X is a pandas dataframe or series.\"\"\"\n2264 |     try:\n2265 |         pd = sys.modules[\"pandas\"]\n2266 |     except KeyError:\n2267 |         return False\n2268 |     return isinstance(X, (pd.DataFrame, pd.Series))\n```\n\nFound function `sklearn/utils/validation.py:_is_pandas_df`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2271 | def _is_pandas_df(X):\n2272 |     \"\"\"Return True if the X