\n277 |         if self.contamination != \"auto\":\n278 |             if not (0.0 < self.contamination <= 0.5):\n279 |                 raise ValueError(\n280 |                     \"contamination must be in (0, 0.5], got: %f\" % self.contamination\n281 |                 )\n282 | \n283 |         n_samples = self.n_samples_fit_\n284 |         if self.n_neighbors > n_samples:\n285 |             warnings.warn(\n286 |                 \"n_neighbors (%s) is greater than the \"\n287 |                 \"total number of samples (%s). n_neighbors \"\n288 |                 \"will be set to (n_samples - 1) for estimation.\"\n289 |                 % (self.n_neighbors, n_samples)\n290 |             )\n291 |         self.n_neighbors_ = max(1, min(self.n_neighbors, n_samples - 1))\n292 | \n293 |         self._distances_fit_X_, _neighbors_indices_fit_X_ = self.kneighbors(\n294 |             n_neighbors=self.n_neighbors_\n295 |         )\n296 | \n297 |         self._lrd = self._local_reachability_density(\n298 |             self._distances_fit_X_, _neighbors_indices_fit_X_\n299 |         )\n300 | \n301 |         # Compute lof score over training samples to define offset_:\n302 |         lrd_ratios_array = (\n303 |             self._lrd[_neighbors_indices_fit_X_] / self._lrd[:, np.newaxis]\n304 |         )\n305 | \n306 |         self.negative_outlier_factor_ = -np.mean(lrd_ratios_array, axis=1)\n307 | \n308 |         if self.contamination == \"auto\":\n309 |             # inliers score around -1 (the higher, the less abnormal).\n310 |             self.offset_ = -1.5\n311 |         else:\n312 |             self.offset_ = np.percentile(\n313 |                 self.negative_outlier_factor_, 100.0 * self.contamination\n314 |             )\n315 | \n316 |         return self\n```\n\nFound file `sklearn/utils/validation.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `sklearn/utils/validation.py` for the full content if needed.\n\n\n\n##Searching for term \"MiniBatch