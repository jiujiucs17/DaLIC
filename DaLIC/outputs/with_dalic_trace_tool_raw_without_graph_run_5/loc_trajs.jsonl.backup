pace `np.isinf/isnan` or custom\n111 |     # Cython implementation to prevent false positives and provide a detailed\n112 |     # error message.\n113 |     with np.errstate(over=\"ignore\"):\n114 |         first_pass_isfinite = xp.isfinite(xp.sum(X))\n115 |     if first_pass_isfinite:\n116 |         return\n117 | \n118 |     _assert_all_finite_element_wise(\n119 |         X,\n120 |         xp=xp,\n121 |         allow_nan=allow_nan,\n122 |         msg_dtype=msg_dtype,\n123 |         estimator_name=estimator_name,\n124 |         input_name=input_name,\n125 |     )\n```\n\nFound function `sklearn/utils/validation.py:check_consistent_length`.\nSource: Retrieved entity using keyword search (bm25).\n```\n451 | def check_consistent_length(*arrays):\n452 |     \"\"\"Check that all arrays have consistent first dimensions.\n453 | \n454 |     Checks whether all objects in arrays have the same shape or length.\n455 | \n456 |     Parameters\n457 |     ----------\n458 |     *arrays : list or tuple of input objects.\n459 |         Objects that will be checked for consistent length.\n460 | \n461 |     Examples\n462 |     --------\n463 |     >>> from sklearn.utils.validation import check_consistent_length\n464 |     >>> a = [1, 2, 3]\n465 |     >>> b = [2, 3, 4]\n466 |     >>> check_consistent_length(a, b)\n467 |     \"\"\"\n468 | \n469 |     lengths = [_num_samples(X) for X in arrays if X is not None]\n470 |     uniques = np.unique(lengths)\n471 |     if len(uniques) > 1:\n472 |         raise ValueError(\n473 |             \"Found input variables with inconsistent numbers of samples: %r\"\n474 |             % [int(l) for l in lengths]\n475 |         )\n```\n\nFound function `sklearn/base.py:clone`.\nSource: Retrieved entity using keyword search (bm25).\n```\n40 | def clone(estimator, *, safe=True):\n41 |     \"\"\"Construct a new unfitted estimator with the same parameters.\n42 | \n43 |     Clone does a deep copy of the model in an estimator\n44 |     without actually copying attached data. It returns a new estimator\n45 |     with the same parameters that has not been fitted on any data.\n46 | \n47 |     .. versionchanged:: 1.3\n48 |         Delegates to `estimator.__sklearn_clone__` if the method exists.\n49 | \n50 |     Parameters\n51 |     ----------\n52 |     estimator : {list, tuple, set} of estimator instance or a single \\\n53 |             estimator instance\n54 |         The estimator or group of estimators to be cloned.\n55 |     safe : bool, default=True\n56 |         If safe is False, clone will fall back to a deep copy on objects\n57 |         that are not estimators. Ignored if `estimator.__sklearn_clone__`\n58 |         exists.\n59 | \n60 |     Returns\n61 |     -------\n62 |     estimator : object\n63 |         The deep copy of the input, an estimator if input is an estimator.\n64 | \n65 |     Notes\n66 |     -----\n67 |     If the estimator's `random_state` parameter is an integer (or if the\n68 |     estimator doesn't have a `random_state` parameter), an *exact clone* is\n69 |     returned: the clone and the original estimator will give the exact same\n70 |     results. Otherwise, *statistical clone* is returned: the clone might\n71 |     return different results from the original estimator. More details can be\n72 |     found in :ref:`randomness`.\n73 | \n74 |     Examples\n75 |     --------\n76 |     >>> from sklearn.base import clone\n77 |     >>> from sklearn.linear_model import LogisticRegression\n78 |     >>> X = [[-1, 0], [0, 1], [0, -1], [1, 0]]\n79 |     >>> y = [0, 0, 1, 1]\n80 |     >>> classifier = LogisticRegression().fit(X, y)\n81 |     >>> cloned_classifier = clone(classifier)\n82 |     >>> hasattr(classifier, \"classes_\")\n83 |     True\n84 |     >>> hasattr(cloned_classifier, \"classes_\")\n85 |     False\n86 |     >>> classifier is cloned_classifier\n87 |     False\n88 |     \"\"\"\n89 |     if hasattr(estimator, \"__sklearn_clone__\") and not inspect.isclass(estimator):\n90 |         return estimator.__sklearn_clone__()\n91 |     return _clone_parametrized(estimator, safe=safe)\n```\n\n\n\n##Searching for term \"check_consistency assert_consistent\"...\n### Search Result:\nFound code snippet in file `sklearn/cross_decomposition/_pls.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n   1 | \"\"\"\n   2 | The :mod:`sklearn.pls` module implements Partial Least Squares (PLS).\n   3 | \"\"\"\n   4 | \n   5 | # Authors: The scikit-learn developers\n   6 | # SPDX-License-Identifier: BSD-3-Clause\n   7 | \n   8 | import warnings\n   9 | from abc import ABCMeta, abstractmethod\n  10 | from numbers import Integral, Real\n  11 | \n  12 | import numpy as np\n  13 | from scipy.linalg import svd\n  14 | \n  15 | from ..base import (\n  16 |     BaseEstimator,\n  17 |     ClassNamePrefixFeaturesOutMixin,\n  18 |     MultiOutputMixin,\n  19 |     RegressorMixin,\n  20 |     TransformerMixin,\n  21 |     _fit_context,\n  22 | )\n  23 | from ..exceptions import ConvergenceWarning\n  24 | from ..utils import check_array, check_consistent_length\n  25 | from ..utils._param_validation import Interval, StrOptions\n  26 | from ..utils.extmath import svd_flip\n  27 | from ..utils.fixes import parse_version, sp_version\n  28 | from ..utils.validation import FLOAT_DTYPES, check_is_fitted\n  29 | \n  30 | __all__ = [\"PLSCanonical\", \"PLSRegression\", \"PLSSVD\"]\n  31 | \n  32 | \n  33 | if sp_version >= parse_version(\"1.7\"):\n  34 |     # Starting in scipy 1.7 pinv2 was deprecated in favor of pinv.\n  35 |     # pinv now uses the svd to compute the pseudo-inverse.\n  36 |     from scipy.linalg import pinv as pinv2\n  37 | else:\n  38 |     from scipy.linalg import pinv2\n```\n"}, {"content": "Let me get the content of the validation module to better understand the implementation details.\n\n<function=get_entity_contents>\n<parameter=entity_names>['sklearn/utils/validation.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role":