ype(index.dtype):\n 324 |             # We keep behavior consistent with prior versions of pandas for\n 325 |             # non-numeric, non-datetime indexes\n 326 |             index = Index(range(len(index)))\n 327 |     else:\n 328 |         methods = {\"index\", \"values\", \"nearest\", \"time\"}\n 329 |         is_numeric_or_datetime = (\n 330 |             is_numeric_dtype(index.dtype)\n 331 |             or isinstance(index.dtype, DatetimeTZDtype)\n 332 |             or lib.is_np_dtype(index.dtype, \"mM\")\n 333 |         )\n 334 |         valid = NP_METHODS + SP_METHODS\n 335 |         if method in valid:\n 336 |             if method not in methods and not is_numeric_or_datetime:\n 337 |                 raise ValueError(\n 338 |                     \"Index column must be numeric or datetime type when \"\n 339 |                     f\"using {method} method other than linear. \"\n 340 |                     \"Try setting a numeric or datetime index column before \"\n 341 |                     \"interpolating.\"\n 342 |                 )\n 343 |         else:\n 344 |             raise ValueError(f\"Can not interpolate with method={method}.\")\n 345 | \n 346 |     if isna(index).any():\n 347 |         raise NotImplementedError(\n 348 |             \"Interpolation with NaNs in the index \"\n 349 |             \"has not been implemented. Try filling \"\n 350 |             \"those NaNs before interpolating.\"\n 351 |         )\n 352 |     return index\n 353 | \n 354 | \n 355 | def interpolate_2d_inplace(\n 356 |     data: np.ndarray,  # floating dtype\n 357 |     index: Index,\n 358 |     axis: AxisInt,\n 359 |     method: str = \"linear\",\n 360 |     limit: int | None = None,\n 361 |     limit_direction: str = \"forward\",\n 362 |     limit_area: str | None = None,\n 363 |     fill_value: Any | None = None,\n 364 |     mask=None,\n 365 |     **kwargs,\n 366 | ) -> None:\n 367 |     \"\"\"\n 368 |     Column-wise application of _interpolate_1d.\n 369 | \n 370 |   