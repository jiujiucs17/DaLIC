ype: ignore[call-overload]\n 420 | \n 421 | \n 422 | def _index_to_interp_indices(index: Index, method: str) -> np.ndarray:\n 423 |     \"\"\"\n 424 |     Convert Index to ndarray of indices to pass to NumPy/SciPy.\n 425 |     \"\"\"\n 426 |     xarr = index._values\n 427 |     if needs_i8_conversion(xarr.dtype):\n 428 |         # GH#1646 for dt64tz\n 429 |         xarr = xarr.view(\"i8\")\n 430 | \n 431 |     if method == \"linear\":\n 432 |         inds = xarr\n 433 |         inds = cast(np.ndarray, inds)\n 434 |     else:\n 435 |         inds = np.asarray(xarr)\n 436 | \n 437 |         if method in (\"values\", \"index\"):\n 438 |             if inds.dtype == np.object_:\n 439 |                 inds = lib.maybe_convert_objects(inds)\n 440 | \n 441 |     return inds\n 442 | \n 443 | \n 444 | def _interpolate_1d(\n 445 |     indices: np.ndarray,\n 446 |     yvalues: np.ndarray,\n 447 |     method: str = \"linear\",\n 448 |     limit: int | None = None,\n 449 |     limit_direction: str = \"forward\",\n 450 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 451 |     fill_value: Any | None = None,\n 452 |     bounds_error: bool = False,\n 453 |     order: int | None = None,\n 454 |     mask=None,\n 455 |     **kwargs,\n 456 | ) -> None:\n 457 |     \"\"\"\n 458 |     Logic for the 1-d interpolation.  The input\n 459 |     indices and yvalues will each be 1-d arrays of the same length.\n 460 | \n 461 |     Bounds_error is currently hardcoded to False since non-scipy ones don't\n 462 |     take it as an argument.\n 463 | \n 464 |     Notes\n 465 |     -----\n 466 |     Fills 'yvalues' in-place.\n 467 |     \"\"\"\n 468 |     if mask is not None:\n 469 |         invalid = mask\n 470 |     else:\n 471 |         invalid = isna(yvalues)\n 472 |     valid = ~invalid\n 473 | \n 474 |     if not valid.any():\n 475 |         return\n 476 | \n 477 |     if valid.all():\n 478 |         return\n 479 | \n 480 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n 481 |     all_nans = np.flatnonzero(invalid)\n 482 | \n 483 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n 484 |     if first_valid_index is None:  # no nan found in start\n 485 |         first_valid_index = 0\n 486 |     start_nans = np.arange(first_valid_index)\n 487 | \n 488 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n 489 |     if last_valid_index is None:  # no nan found in end\n 490 |         last_valid_index = len(yvalues)\n 491 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n 492 | \n 493 |     # preserve_nans contains indices of invalid values,\n 494 |     # but in this case, it is the final set of indices that need to be\n 495 |     # preserved as NaN after the interpolation.\n 496 | \n 497 |     # For example if limit_direction='forward' then preserve_nans will\n 498 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n 499 |     # are more than 'limit' away from the prior non-NaN.\n 500 | \n 501 |     # set preserve_nans based on direction using _interp_limit\n 502 |     if limit_direction == \"forward\":\n 503 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n 504 |     elif limit_direction == \"backward\":\n 505 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n 506 |     else:\n 507 |         # both directions... just use _interp_limit\n 508 |         preserve_nans = np.unique(_interp_limit(invalid, limit, limit))\n 509 | \n 510 |     # if limit_area is set, add either mid or outside indices\n 511 |     # to preserve_nans GH #16284\n 512 |     if limit_area == \"inside\":\n 513 |         # preserve NaNs on the outside\n 514 |         preserve_nans = np.union1d(preserve_nans, start_nans)\n 515 |         preserve_nans = np.union1d(preserve_nans, end_nans)\n 516 |     elif limit_area == \"outside\":\n 517 |         # preserve NaNs on the inside\n 518 |         mid_nans = np.setdiff1d(all_nans, start_nans, assume_unique=True)\n 519 |         mid_nans = np.setdiff1d(mid_nans, end_nans, assume_unique=True)\n 520 |         preserve_nans = np.union1d(preserve_nans, mid_nans)\n 521 | \n 522 |     is_datetimelike = yvalues.dtype.kind in \"mM\"\n 523 | \n 524 |     if is_datetimelike:\n 525 |         yvalues = yvalues.view(\"i8\")\n 526 | \n 527 |     if method in NP_METHODS:\n 528 |         # np.interp requires sorted X values, #21037\n 529 | \n 530 |         indexer = np.argsort(indices[valid])\n 531 |         yvalues[invalid] = np.interp(\n 532 |             indices[invalid], indices[valid][indexer], yvalues[valid][indexer]\n 533 |         )\n 534 |     else:\n 535 |         yvalues[invalid] = _interpolate_scipy_wrapper(\n 536 |             indices[valid],\n 537 |             yvalues[valid],\n 538 |             indices[invalid],\n 539 |             method=method,\n 540 |             fill_value=fill_value,\n 541 |             bounds_error=bounds_error,\n 542 |             order=order,\n 543 |             **kwargs,\n 544 |         )\n 545 | \n 546 |     if mask is not None:\n 547 |         mask[:] = False\n 548 |         mask[preserve_nans] = True\n 549 |     elif is_datetimelike:\n 550 |         yvalues[preserve_nans] = NaT.value\n 551 |     else:\n 552 |         yvalues[preserve_nans] = np.nan\n 553 |     return\n 554 | \n 555 | \n 556 | def _interpolate_scipy_wrapper(\n 557 |     x: np.ndarray,\n 558 |     y: np.ndarray,\n 559 |     new_x: np.ndarray,\n 560 |     method: str,\n 561 |     fill_value=None,\n 562 |     bounds_error: bool = False,\n 563 |     order=None,\n 564 |     **kwargs,\n 565 | ):\n 566 |     \"\"\"\n 567 |     Passed off to scipy.interpolate.interp1d. method is scipy's kind.\n 568 |     Returns an array interpolated at new_x.  Add any new methods to\n 569 |     the list in _clean_interp_method.\n 570 |     \"\"\"\n 571 |     extra = f\"{method} interpolation requires SciPy.\"\n 572 |     import_optional_dependency(\"scipy\", extra=extra)\n 573 |     from scipy import interpolate\n 574 | \n 575 |     new_x = np.asarray(new_x)\n 576 | \n 577 |     # ignores some kwargs that could be passed along.\n 578 |     alt_methods = {\n 579 |         \"barycentric\": interpolate.barycentric_interpolate,\n 580 |         \"krogh\": interpolate.krogh_interpolate,\n 581 |         \"from_derivatives\": _from_derivatives,\n 582 |         \"piecewise_polynomial\": _from_derivatives,\n 583 |         \"cubicspline\": _cubicspline_interpolate,\n 584 |         \"akima\": _akima_interpolate,\n 585 |         \"pchip\": interpolate.pchip_interpolate,\n 586 |     }\n 587 | \n 588 |     interp1d_methods = [\n 589 |         \"nearest\",\n 590 |         \"zero\",\n 591 |         \"slinear\",\n 592 |         \"quadratic\",\n 593 |         \"cubic\",\n 594 |         \"polynomial\",\n 595 |     ]\n 596 |     if method in interp1d_methods:\n 597 |         if method == \"polynomial\":\n 598 |             kind = order\n 599 |         else:\n 600 |             kind = method\n 601 |         terp = interpolate.interp1d(\n 602 |             x, y, kind=kind, fill_value=fill_value, bounds_error=bounds_error\n 603 |         )\n 604 |         new_y = terp(new_x)\n 605 |     elif method == \"spline\":\n 606 |         # GH #10633, #24014\n 607 |         if isna(order) or (order <= 0):\n 608 |             raise ValueError(\n 609 |                 f\"order needs to be specified and greater than 0; got order: {order}\"\n 610 |             )\n 611 |         terp = interpolate.UnivariateSpline(x, y, k=order, **kwargs)\n 612 |         new_y = terp(new_x)\n 613 |     else:\n 614 |         # GH 7295: need to be able to write for some reason\n 615 |         # in some circumstances: check all three\n 616 |         if not x.flags.writeable:\n 617 |             x = x.copy()\n 618 |         if not y.flags.writeable:\n 619 |             y = y.copy()\n 620 |         if not new_x.flags.writeable:\n 621 |             new_x = new_x.copy()\n 622 |         terp = alt_methods.get(method, None)\n 623 |         if terp is None:\n 624 |             raise ValueError(f\"Can not interpolate with method={method}.\")\n 625 | \n 626 |         # Make sure downcast is not in kwargs for alt methods\n 627 |         kwargs.pop(\"downcast\", None)\n 628 |         new_y = terp(x, y, new_x, **kwargs)\n 629 |     return new_y\n 630 | \n 631 | \n 632 | def _from_derivatives(\n 633 |     xi: np.ndarray,\n 634 |     yi: np.ndarray,\n 635 |     x: np.ndarray,\n 636 |     order=None,\n 637 |     der: int | list[int] | None = 0,\n 638 |     extrapolate: bool = False,\n 639 | ):\n 640 |     \"\"\"\n 641 |     Convenience function for interpolate.BPoly.from_derivatives.\n 642 | \n 643 |     Construct a piecewise polynomial in the Bernstein basis, compatible\n 644 |     with the specified values and derivatives at breakpoints.\n 645 | \n 646 |     Parameters\n 647 |     ----------\n 648 |     xi : array-like\n 649 |         sorted 1D array of x-coordinates\n 650 |     yi : array-like or list of array-likes\n 651 |         yi[i][j] is the j-th derivative known at xi[i]\n 652 |     order: None or int or array-like of ints. Default: None.\n 653 |         Specifies the degree of local polynomials. If not None, some\n 654 |         derivatives are ignored.\n 655 |     der : int or list\n 656 |         How many derivatives to extract; None for all potentially nonzero\n 657 |         derivatives (that is a number equal to the number of points), or a\n 658 |         list of derivatives to extract. This number includes the function\n 659 |         value as 0th derivative.\n 660 |      extrapolate : bool, optional\n 661 |         Whether to extrapolate to ouf-of-bounds points based on first and last\n 662 |         intervals, or to return NaNs. Default: True.\n 663 | \n 664 |     See Also\n 665 |     --------\n 666 |     scipy.interpolate.BPoly.from_derivatives\n 667 | \n 668 |     Returns\n 669 |     -------\n 670 |     y : scalar or array-like\n 671 |         The result, of length R or length M or M by R.\n 672 |     \"\"\"\n 673 |     from scipy import interpolate\n 674 | \n 675 |     # return the method for compat with scipy version & backwards compat\n 676 |     method = interpolate.BPoly.from_derivatives\n 677 |     m = method(xi, yi.reshape(-1, 1), orders=order, extrapolate=extrapolate)\n 678 | \n 679 |     return m(x)\n 680 | \n 681 | \n 682 | def _akima_interpolate(\n 683 |     xi: np.ndarray,\n 684 |     yi: np.ndarray,\n 685 |     x: np.ndarray,\n 686 |     der: int | list[int] | None = 0,\n 687 |     axis: AxisInt = 0,\n 688 | ):\n 689 |     \"\"\"\n 690 |     Convenience function for akima interpolation.\n 691 |     xi and yi are arrays of values used to approximate some function f,\n 692 |     with ``yi = f(xi)``.\n 693 | \n 694 |     See `Akima1DInterpolator` for details.\n 695 | \n 696 |     Parameters\n 697 |     ----------\n 698 |     xi : np.ndarray\n 699 |         A sorted list of x-coordinates, of length N.\n 700 |     yi : np.ndarray\n 701 |         A 1-D array of real values.  `yi`'s length along the interpolation\n 702 |         axis must be equal to the length of `xi`. If N-D array, use axis\n 703 |         parameter to select correct axis.\n 704 |     x : np.ndarray\n 705 |         Of length M.\n 706 |     der : int, optional\n 707 |         How many derivatives to extract; None for all potentially\n 708 |         nonzero derivatives (that is a number equal to the number\n 709 |         of points), or a list of derivatives to extract. This number\n 710 |         includes the function value as 0th derivative.\n 711 |     axis : int, optional\n 712 |         Axis in the yi array corresponding to the x-coordinate values.\n 713 | \n 714 |     See Also\n 715 |     --------\n 716 |     scipy.interpolate.Akima1DInterpolator\n 717 | \n 718 |     Returns\n 719 |     -------\n 720 |     y : scalar or array-like\n 721 |         The result, of length R or length M or M by R,\n 722 | \n 723 |     \"\"\"\n 724 |     from scipy import interpolate\n 725 | \n 726 |     P = interpolate.Akima1DInterpolator(xi, yi, axis=axis)\n 727 | \n 728 |     return P(x, nu=der)\n 729 | \n 730 | \n 731 | def _cubicspline_interpolate(\n 732 |     xi: np.ndarray,\n 733 |     yi: np.ndarray,\n 734 |     x: np.ndarray,\n 735 |     axis: AxisInt = 0,\n 736 |     bc_type: str | tuple[Any, Any] = \"not-a-knot\",\n 737 |     extrapolate=None,\n 738 | ):\n 739 |     \"\"\"\n 740 |     Convenience function for cubic spline data interpolator.\n 741 | \n 742 |     See `scipy.interpolate.CubicSpline` for details.\n 743 | \n 744 |     Parameters\n 745 |     ----------\n 746 |     xi : np.ndarray, shape (n,)\n 747 |         1-d array containing values of the independent variable.\n 748 |         Values must be real, finite and in strictly increasing order.\n 749 |     yi : np.ndarray\n 750 |         Array containing values of the dependent variable. It can have\n 751 |         arbitrary number of dimensions, but the length along ``axis``\n 752 |         (see below) must match the length of ``x``. Values must be finite.\n 753 |     x : np.ndarray, shape (m,)\n 754 |     axis : int, optional\n 755 |         Axis along which `y` is assumed to be varying. Meaning that for\n 756 |         ``x[i]`` the corresponding values are ``np.take(y, i, axis=axis)``.\n 757 |         Default is 0.\n 758 |     bc_type : string or 2-tuple, optional\n 759 |         Boundary condition type. Two additional equations, given by the\n 760 |         boundary conditions, are required to determine all coefficients of\n 761 |         polynomials on each segment [2]_.\n 762 |         If `bc_type` is a string, then the specified condition will be applied\n 763 |         at both ends of a spline. Available conditions are:\n 764 |         * 'not-a-knot' (default): The first and second segment at a curve end\n 765 |           are the same polynomial. It is a good default when there is no\n 766 |           information on boundary conditions.\n 767 |         * 'periodic': The interpolated functions is assumed to be periodic\n 768 |           of period ``x[-1] - x[0]``. The first and last value of `y` must be\n 769 |           identical: ``y[0] == y[-1]``. This boundary condition will result in\n 770 |           ``y'[0] == y'[-1]`` and ``y''[0] == y''[-1]``.\n 771 |         * 'clamped': The first derivative at curves ends are zero. Assuming\n 772 |           a 1D `y`, ``bc_type=((1, 0.0), (1, 0.0))`` is the same condition.\n 773 |         * 'natural': The second derivative at curve ends are zero. Assuming\n 774 |           a 1D `y`, ``bc_type=((2, 0.0), (2, 0.0))`` is the same condition.\n 775 |         If `bc_type` is a 2-tuple, the first and the second value will be\n 776 |         applied at the curve start and end respectively. The tuple values can\n 777 |         be one of the previously mentioned strings (except 'periodic') or a\n 778 |         tuple `(order, deriv_values)` allowing to specify arbitrary\n 779 |         derivatives at curve ends:\n 780 |         * `order`: the derivative order, 1 or 2.\n 781 |         * `deriv_value`: array-like containing derivative values, shape must\n 782 |           be the same as `y`, excluding ``axis`` dimension. For example, if\n 783 |           `y` is 1D, then `deriv_value` must be a scalar. If `y` is 3D with\n 784 |           the shape (n0, n1, n2) and axis=2, then `deriv_value` must be 2D\n 785 |           and have the shape (n0, n1).\n 786 |     extrapolate : {bool, 'periodic', None}, optional\n 787 |         If bool, determines whether to extrapolate to out-of-bounds points\n 788 |         based on first and last intervals, or to return NaNs. If 'periodic',\n 789 |         periodic extrapolation is used. If None (default), ``extrapolate`` is\n 790 |         set to 'periodic' for ``bc_type='periodic'`` and to True otherwise.\n 791 | \n 792 |     See Also\n 793 |     --------\n 794 |     scipy.interpolate.CubicHermiteSpline\n 795 | \n 796 |     Returns\n 797 |     -------\n 798 |     y : scalar or array-like\n 799 |         The result, of shape (m,)\n 800 | \n 801 |     References\n 802 |     ----------\n 803 |     .. [1] `Cubic Spline Interpolation\n 804 |             <https://en.wikiversity.org/wiki/Cubic_Spline_Interpolation>`_\n 805 |             on Wikiversity.\n 806 |     .. [2] Carl de Boor, \"A Practical Guide to Splines\", Springer-Verlag, 1978.\n 807 |     \"\"\"\n 808 |     from scipy import interpolate\n 809 | \n 810 |     P = interpolate.CubicSpline(\n 811 |         xi, yi, axis=axis, bc_type=bc_type, extrapolate=extrapolate\n 812 |     )\n 813 | \n 814 |     return P(x)\n 815 | \n 816 | \n 817 | def pad_or_backfill_inplace(\n 818 |     values: np.ndarray,\n 819 |     method: Literal[\"pad\", \"backfill\"] = \"pad\",\n 820 |     axis: AxisInt = 0,\n 821 |     limit: int | None = None,\n 822 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 823 | ) -> None:\n 824 |     \"\"\"\n 825 |     Perform an actual interpolation of values, values will be make 2-d if\n 826 |     needed fills inplace, returns the result.\n 827 | \n 828 |     Parameters\n 829 |     ----------\n 830 |     values: np.ndarray\n 831 |         Input array.\n 832 |     method: str, default \"pad\"\n 833 |         Interpolation method. Could be \"bfill\" or \"pad\"\n 834 |     axis: 0 or 1\n 835 |         Interpolation axis\n 836 |     limit: int, optional\n 837 |         Index limit on interpolation.\n 838 |     limit_area: str, optional\n 839 |         Limit area for interpolation. Can be \"inside\" or \"outside\"\n 840 | \n 841 |     Notes\n 842 |     -----\n 843 |     Modifies values in-place.\n 844 |     \"\"\"\n 845 |     transf = (lambda x: x) if axis == 0 else (lambda x: x.T)\n 846 | \n 847 |     # reshape a 1 dim if needed\n 848 |     if values.ndim == 1:\n 849 |         if axis != 0:  # pragma: no cover\n 850 |             raise AssertionError(\"cannot interpolate on a ndim == 1 with axis != 0\")\n 851 |         values = values.reshape(tuple((1,) + values.shape))\n 852 | \n 853 |     method = clean_fill_method(method)\n 854 |     tvalues = transf(values)\n 855 | \n 856 |     func = get_fill_func(method, ndim=2)\n 857 |     # _pad_2d and _backfill_2d both modify tvalues inplace\n 858 |     func(tvalues, limit=limit, limit_area=limit_area)\n 859 | \n 860 | \n 861 | def _fillna_prep(\n 862 |     values, mask: npt.NDArray[np.bool_] | None = None\n 863 | ) -> npt.NDArray[np.bool_]:\n 864 |     # boilerplate for _pad_1d, _backfill_1d, _pad_2d, _backfill_2d\n 865 | \n 866 |     if mask is None:\n 867 |         mask = isna(values)\n 868 | \n 869 |     return mask\n 870 | \n 871 | \n 872 | def _datetimelike_compat(func: F) -> F:\n 873 |     \"\"\"\n 874 |     Wrapper to handle datetime64 and timedelta64 dtypes.\n 875 |     \"\"\"\n 876 | \n 877 |     @wraps(func)\n 878 |     def new_func(\n 879 |         values,\n 880 |         limit: int | None = None,\n 881 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 882 |         mask=None,\n 883 |     ):\n 884 |         if needs_i8_conversion(values.dtype):\n 885 |             if mask is None:\n 886 |                 # This needs to occur before casting to int64\n 887 |                 mask = isna(values)\n 888 | \n 889 |             result, mask = func(\n 890 |                 values.view(\"i8\"), limit=limit, limit_area=limit_area, mask=mask\n 891 |             )\n 892 |             return result.view(values.dtype), mask\n 893 | \n 894 |         return func(values, limit=limit, limit_area=limit_area, mask=mask)\n 895 | \n 896 |     return cast(F, new_func)\n 897 | \n 898 | \n 899 | @_datetimelike_compat\n 900 | def _pad_1d(\n 901 |     values: np.ndarray,\n 902 |     limit: int | None = None,\n 903 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 904 |     mask: npt.NDArray[np.bool_] | None = None,\n 905 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 906 |     mask = _fillna_prep(values, mask)\n 907 |     if limit_area is not None and not mask.all():\n 908 |         _fill_limit_area_1d(mask, limit_area)\n 909 |     algos.pad_inplace(values, mask, limit=limit)\n 910 |     return values, mask\n 911 | \n 912 | \n 913 | @_datetimelike_compat\n 914 | def _backfill_1d(\n 915 |     values: np.ndarray,\n 916 |     limit: int | None = None,\n 917 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 918 |     mask: npt.NDArray[np.bool_] | None = None,\n 919 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 920 |     mask = _fillna_prep(values, mask)\n 921 |     if limit_area is not None and not mask.all():\n 922 |         _fill_limit_area_1d(mask, limit_area)\n 923 |     algos.backfill_inplace(values, mask, limit=limit)\n 924 |     return values, mask\n 925 | \n 926 | \n 927 | @_datetimelike_compat\n 928 | def _pad_2d(\n 929 |     values: np.ndarray,\n 930 |     limit: int | None = None,\n 931 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 932 |     mask: npt.NDArray[np.bool_] | None = None,\n 933 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 934 |     mask = _fillna_prep(values, mask)\n 935 |     if limit_area is not None:\n 936 |         _fill_limit_area_2d(mask, limit_area)\n 937 | \n 938 |     if values.size:\n 939 |         algos.pad_2d_inplace(values, mask, limit=limit)\n 940 |     return values, mask\n 941 | \n 942 | \n 943 | @_datetimelike_compat\n 944 | def _backfill_2d(\n 945 |     values,\n 946 |     limit: int | None = None,\n 947 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 948 |     mask: npt.NDArray[np.bool_] | None = None,\n 949 | ):\n 950 |     mask = _fillna_prep(values, mask)\n 951 |     if limit_area is not None:\n 952 |         _fill_limit_area_2d(mask, limit_area)\n 953 | \n 954 |     if values.size:\n 955 |         algos.backfill_2d_inplace(values, mask, limit=limit)\n 956 |     else:\n 957 |         # for test coverage\n 958 |         pass\n 959 |     return values, mask\n 960 | \n 961 | \n 962 | def _fill_limit_area_1d(\n 963 |     mask: npt.NDArray[np.bool_], limit_area: Literal[\"outside\", \"inside\"]\n 964 | ) -> None:\n 965 |     \"\"\"Prepare 1d mask for ffill/bfill with limit_area.\n 966 | \n 967 |     Caller is responsible for checking at least one value of mask is False.\n 968 |     When called, mask will no longer faithfully represent when\n 969 |     the corresponding are NA or not.\n 970 | \n 971 |     Parameters\n 972 |     ----------\n 973 |     mask : np.ndarray[bool, ndim=1]\n 974 |         Mask representing NA values when filling.\n 975 |     limit_area : { \"outside\", \"inside\" }\n 976 |         Whether to limit filling to outside or inside the outer most non-NA value.\n 977 |     \"\"\"\n 978 |     neg_mask = ~mask\n 979 |     first = neg_mask.argmax()\n 980 |     last = len(neg_mask) - neg_mask[::-1].argmax() - 1\n 981 |     if limit_area == \"inside\":\n 982 |         mask[:first] = False\n 983 |         mask[last + 1 :] = False\n 984 |     elif limit_area == \"outside\":\n 985 |         mask[first + 1 : last] = False\n 986 | \n 987 | \n 988 | def _fill_limit_area_2d(\n 989 |     mask: npt.NDArray[np.bool_], limit_area: Literal[\"outside\", \"inside\"]\n 990 | ) -> None:\n 991 |     \"\"\"Prepare 2d mask for ffill/bfill with limit_area.\n 992 | \n 993 |     When called, mask will no longer faithfully represent when\n 994 |     the corresponding are NA or not.\n 995 | \n 996 |     Parameters\n 997 |     ----------\n 998 |     mask : np.ndarray[bool, ndim=1]\n 999 |         Mask representing NA values when filling.\n1000 |     limit_area : { \"outside\", \"inside\" }\n1001 |         Whether to limit filling to outside or inside the outer most non-NA value.\n1002 |     \"\"\"\n1003 |     neg_mask = ~mask.T\n1004 |     if limit_area == \"outside\":\n1005 |         # Identify inside\n1006 |         la_mask = (\n1007 |             np.maximum.accumulate(neg_mask, axis=0)\n1008 |             & np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1009 |         )\n1010 |     else:\n1011 |         # Identify outside\n1012 |         la_mask = (\n1013 |             ~np.maximum.accumulate(neg_mask, axis=0)\n1014 |             | ~np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1015 |         )\n1016 |     mask[la_mask.T] = False\n1017 | \n1018 | \n1019 | _fill_methods = {\"pad\": _pad_1d, \"backfill\": _backfill_1d}\n1020 | \n1021 | \n1022 | def get_fill_func(method, ndim: int = 1):\n1023 |     method = clean_fill_method(method)\n1024 |     if ndim == 1:\n1025 |         return _fill_methods[method]\n1026 |     return {\"pad\": _pad_2d, \"backfill\": _backfill_2d}[method]\n1027 | \n1028 | \n1029 | def clean_reindex_fill_method(method) -> ReindexMethod | None:\n1030 |     if method is None:\n1031 |         return None\n1032 |     return clean_fill_method(method, allow_nearest=True)\n1033 | \n1034 | \n1035 | def _interp_limit(\n1036 |     invalid: npt.NDArray[np.bool_], fw_limit: int | None, bw_limit: int | None\n1037 | ) -> np.ndarray:\n1038 |     \"\"\"\n1039 |     Get indexers of values that won't be filled\n1040 |     because they exceed the limits.\n1041 | \n1042 |     Parameters\n1043 |     ----------\n1044 |     invalid : np.ndarray[bool]\n1045 |     fw_limit : int or None\n1046 |         forward limit to index\n1047 |     bw_limit : int or None\n1048 |         backward limit to index\n1049 | \n1050 |     Returns\n1051 |     -------\n1052 |     set of indexers\n1053 | \n1054 |     Notes\n1055 |     -----\n1056 |     This is equivalent to the more readable, but slower\n1057 | \n1058 |     .. code-block:: python\n1059 | \n1060 |         def _interp_limit(invalid, fw_limit, bw_limit):\n1061 |             for x in np.where(invalid)[0]:\n1062 |                 if invalid[max(0, x - fw_limit) : x + bw_limit + 1].all():\n1063 |                     yield x\n1064 |     \"\"\"\n1065 |     # handle forward first; the backward direction is the same except\n1066 |     # 1. operate on the reversed array\n1067 |     # 2. subtract the returned indices from N - 1\n1068 |     N = len(invalid)\n1069 |     f_idx = np.array([], dtype=np.int64)\n1070 |     b_idx = np.array([], dtype=np.int64)\n1071 |     assume_unique = True\n1072 | \n1073 |     def inner(invalid, limit: int):\n1074 |         limit = min(limit, N)\n1075 |         windowed = np.lib.stride_tricks.sliding_window_view(invalid, limit + 1).all(1)\n1076 |         idx = np.union1d(\n1077 |             np.where(windowed)[0] + limit,\n1078 |             np.where((~invalid[: limit + 1]).cumsum() == 0)[0],\n1079 |         )\n1080 |         return idx\n1081 | \n1082 |     if fw_limit is not None:\n1083 |         if fw_limit == 0:\n1084 |             f_idx = np.where(invalid)[0]\n1085 |             assume_unique = False\n1086 |         else:\n1087 |             f_idx = inner(invalid, fw_limit)\n1088 | \n1089 |     if bw_limit is not None:\n1090 |         if bw_limit == 0:\n1091 |             # then we don't even need to care about backwards\n1092 |             # just use forwards\n1093 |             return f_idx\n1094 |         else:\n1095 |             b_idx = N - 1 - inner(invalid[::-1], bw_limit)\n1096 |             if fw_limit == 0:\n1097 |                 return b_idx\n1098 | \n1099 |     return np.intersect1d(f_idx, b_idx, assume_unique=assume_unique)\n1100 | \n```\n"}, {"content": "Based on the analysis of the code and the issue description, here are the key locations that need documentation improvement:\n\n```\npandas/core/frame.py\nline: 1005-1010\nclass: None\nfunction: DataFrame.interpolate\n\npandas/core/missing.py\nline: 181-183\nfunction: NP_METHODS\n\npandas/core/missing.py\nline: 204-219\nfunction: clean_interp_method\n\npandas/core/missing.py\nline: 311-344\nfunction: get_interp_index\n\npandas/core/missing.py\nline: 444-552\nfunction: _interpolate_1d\n```\n\nThese locations are crucial because:\n\n1. `pandas/core/frame.py`: Contains the main DataFrame.interpolate implementation that needs enhanced documentation. The docstring in this file is where the primary focus should be.\n\n2. `pandas/core/missing.py`: Contains important constants and validation logic:\n   - NP_METHODS defines the special interpolation methods ('time', 'index', 'values') that have specific implementations\n   - clean_interp_method validates the interpolation method selection\n   - get_interp_index handles how different methods process the index values\n   - _interpolate_1d implements the core interpolation logic for these special methods\n\n3. The documentation needs to clarify:\n   - The relationship between 'time', 'index', and 'values' interpolation methods\n   - Special requirements for 'time' method (need DatetimeIndex)\n   - Implementation details for each method type\n   - How these methods work differently from others in the interpolation system\n\n4. The current documentation in the code shows that these special methods are somewhat ad hoc implementations that don't fully align with the general interpolation framework. The enhancement would involve making this clearer in the docstrings.\n\n5. The implementation shows that the 'time' method is a special case that only works with DatetimeIndex, while 'index' and 'values' are more generic implementations that fall back to 'values' method when not applicable.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}, {"type": "function", "function": {"name": "get_trace_artifacts", "description": "\nRead a compact raw slice of DaLIC execution-trace artifacts for the current instance.\nThis tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\nIt does not rank or recommend results. It only applies exact filters and pagination.\n\nNote:\n'<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n- executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n- tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n- then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n\nArgs:\n- `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`. \n    If not specified, it defaults to `all` and does not filter by artifact type.\n- `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`. \n    If not specified, it defaults to `None` and does not filter by file path.\n- `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`. \n    If not specified, it defaults to `None` and does not filter by qualified name.\n- `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n- `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n\nReturns:\nA JSON string encoding an object with the following top-level fields:\n- `instance_id`: The current DaLIC instance id.\n- `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n- `applied_filters`: The effective filter and pagination values used for this call.\n- `artifacts`: A JSON array of matched artifacts.\n- `has_more`: Whether more matched artifacts are available after this slice.\n- `next_start`: The pagination offset to use for the next slice.\n\nEach artifact in `artifacts` is a JSON object with the following fields:\n- `qualified_name`: The qualified name of the artifact.\n- `path`: The compact file path where the artifact is defined.\n- `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n- `defined_line`: The line number where the artifact is defined.\n- `end_line`: The ending line number of the artifact, if available.\n- `event_count`: The number of matching execution events in trace A.\n- `call_count`: The number of calls observed in trace A.\n- `max_call_depth`: The maximum observed call depth for this artifact.\n\nUsage suggestions:\n- Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n- Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n", "parameters": {"type": "object", "properties": {"artifact_type": {"type": "string", "enum": ["all", "function", "method", "class"], "default": "all", "description": "Optional exact filter for artifact definition type."}, "path_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the compact file path.", "default": null}, "name_contains": {"type": ["string", "null"], "description": "Optional case-insensitive substring filter applied to the qualified name.", "default": null}, "start": {"type": "integer", "default": 0, "description": "Zero-based pagination offset."}, "limit": {"type": "integer", "default": 8, "description": "Maximum number of artifacts to return in this slice."}}, "required": []}}}], "usage": {"prompt_tokens": 83177, "completion_tokens": 630}, "time": 110.16015887260437}]}}
{"instance_id": "matplotlib__matplotlib-29265", "found_files": [["lib/matplotlib/collections.py", "lib/matplotlib/lines.py", "lib/matplotlib/__init__.py"]], "found_modules": [["lib/matplotlib/collections.py:LineCollection", "lib/matplotlib/transforms.py:Transform", "lib/matplotlib/widgets.py:RadioButtons", "lib/matplotlib/backends/backend_pdf.py:PdfFile", "lib/matplotlib/cbook.py:index_of", "lib/matplotlib/lines.py:VertexSelector", "lib/matplotlib/axes/_base.py:_AxesBase"]], "found_entities": [["lib/matplotlib/collections.py:LineCollection.set_alpha", "lib/matplotlib/transforms.py:Transform.transform_path_non_affine", "lib/matplotlib/widgets.py:RadioButtons._clear", "lib/matplotlib/backends/backend_pdf.py:PdfFile.imageObject", "lib/matplotlib/cbook.py:index_of", "lib/matplotlib/transforms.py:Transform.inverted", "lib/matplotlib/lines.py:VertexSelector.process_selected", "lib/matplotlib/collections.py:LineCollection.get_segments", "lib/matplotlib/axes/_base.py:_AxesBase.lines"]], "raw_output_loc": ["Based on my analysis, I can identify the key locations that need to be modified to implement the requested feature improvement. Here's the localization result:\n\n```\nlib/matplotlib/collections.py\nline: 1615-1622\nclass: LineCollection\nfunction: __init__\n\nlib/matplotlib/collections.py\nline: 1664-1686\nclass: LineCollection\nfunction: get_segments\n\nlib/matplotlib/collections.py\nline: 1700-1705\nclass: LineCollection\nfunction: set_alpha\n\nlib/matplotlib/lines.py\nline: 1513-1514\nclass: Line2D\nfunction: _AxesBase.lines\n\nlib/matplotlib/__init__.py\nline: N/A\n```\n\nThese locations are ordered by importance for implementing the requested changes to the LineCollection docstring. The main changes would focus on the `LineCollection.__init__` method's docstring, which currently describes the parameters in detail but doesn't match the requested format exactly."], "meta_data": {"repo": "matplotlib/matplotlib", "base_commit": "0406a56b051a371ccf81d2946126580651a645f2", "problem_statement": "Improve LineCollection docstring further\n              (M, 2)\r\n\r\nI would perhaps completely drop the \"list of points\" and just write\r\n```\r\nA sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\r\narray-like of points::\r\n\r\n    line0 = [(x0, y0), (x1, y1), ...]\r\n\r\nEach line can...\r\n```\r\n\r\n_Originally posted by @anntzer in https://github.com/matplotlib/matplotlib/pull/26676#discussion_r1313026557_\r\n\r\n\r\n            \n", "patch": "diff --git a/lib/matplotlib/collections.py b/lib/matplotlib/collections.py\nindex a78f1838357e..f18d5a4c3a8c 100644\n--- a/lib/matplotlib/collections.py\n+++ b/lib/matplotlib/collections.py\n@@ -1612,14 +1612,13 @@ def __init__(self, segments,  # Can be None.\n         \"\"\"\n         Parameters\n         ----------\n-        segments : list of array-like\n-            A sequence (*line0*, *line1*, *line2*) of lines, where each line is a list\n-            of points::\n+        segments : list of (N, 2) array-like\n+            A sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\n+            array-like containing points::\n \n-                lineN = [(x0, y0), (x1, y1), ... (xm, ym)]\n+                line0 = [(x0, y0), (x1, y1), ...]\n \n-            or the equivalent Mx2 numpy array with two columns. Each line\n-            can have a different number of segments.\n+            Each line can contain a different number of points.\n         linewidths : float or list of float, default: :rc:`lines.linewidth`\n             The width of each line in points.\n         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n"}, "usage": {"cost($)": "0", "prompt_tokens": 71823, "completion_tokens": 453}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\nget_trace_artifacts(artifact_type: str = 'all', path_contains: str | None = None, name_contains: str | None = None, start: int = 0, limit: int = 8):\n    Read a compact raw slice of DaLIC execution-trace artifacts for the current instance.\n    This tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\n    It does not rank or recommend results. It only applies filters and pagination.\n    Note:\n    '<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n    - executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n    - tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n    - then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n    Args:\n    - `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`.\n    If not specified, it defaults to `all` and does not filter by artifact type.\n    - `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`.\n    If not specified, it defaults to `None` and does not filter by file path.\n    - `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`.\n    If not specified, it defaults to `None` and does not filter by qualified name.\n    - `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n    - `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n    Returns:\n    A JSON string encoding an object with the following top-level fields:\n    - `instance_id`: The current DaLIC instance id.\n    - `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n    - `applied_filters`: The effective filter and pagination values used for this call.\n    - `artifacts`: A JSON array of matched artifacts.\n    - `has_more`: Whether more matched artifacts are available after this slice.\n    - `next_start`: The pagination offset to use for the next slice.\n    Each artifact in `artifacts` is a JSON object with the following fields:\n    - `qualified_name`: The qualified name of the artifact.\n    - `path`: The compact file path where the artifact is defined.\n    - `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n    - `defined_line`: The line number where the artifact is defined.\n    - `end_line`: The ending line number of the artifact, if available.\n    - `event_count`: The number of matching execution events in trace A.\n    - `call_count`: The number of calls observed in trace A.\n    - `max_call_depth`: The maximum observed call depth for this artifact.\n    Usage suggestions:\n    - Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n    - Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n\nget_trace_data_dependencies(symbol_contains: str | None = None, scope_contains: str | None = None, path_contains: str | None = None, edge_type: str | None = None, start: int = 0, limit: int = 12, path_limit: int = 4):\n    Read a compact raw slice of DaLIC data-dependency evidence for the current instance.\n    This tool reads '<instance_id>/unique_dep_tree.json' and returns a short JSON summary.\n    It does not rank or recommend results. It only applies filters and pagination.\n    Note:\n    - '<instance_id>/unique_dep_tree.json' is generated by analyzing the data dependencies of the unique artifacts in '<instance_id>/unique_artifacts.json'.\n    - It contains the dataflows associated with the unique artifacts, which can help you understand how the unique artifacts are related to each other and how they are related to other parts of the codebase.\n    Args:\n    - `symbol_contains`: Optional case-insensitive substring filter applied to symbol names.\n    For example, if you are interested in dependencies related to symbols with `DataLoader` in their names, you can set `symbol_contains` to `DataLoader`.\n    Together with `scope_contains` and `path_contains`, this first selects a set of matching symbols; an edge is retained when either endpoint belongs to that set.\n    If not specified, it defaults to `None`\n    - `scope_contains`: Optional case-insensitive substring filter applied to symbol scopes.\n    The scope is represented as a dot-separated string of nested scopes, such as `src.utils.data_loader.DataLoader.__init__`.\n    You can set `scope_contains` to a substring of the scope to filter dependencies related to that scope.\n    For example, setting it to `DataLoader` would match the above scope and include its dependencies.\n    Together with `symbol_contains` and `path_contains`, this contributes to the symbol-matching step described above.\n    If not specified, it defaults to `None`\n    - `path_contains`: Optional case-insensitive substring filter applied to compact file paths.\n    For example, if you are interested in dependencies related to files under `src/utils`, you can set `path_contains` to `src/utils`.\n    Together with `symbol_contains` and `scope_contains`, this contributes to the symbol-matching step described above.\n    If not specified, it defaults to `None`\n    - `edge_type`: Optional exact filter for dependency edge type such as `data` or `ret`. If not specified, it defaults to `None` and does not filter by edge type.\n    - `start`: Zero-based pagination offset for matched edges. It defaults to 0, meaning that the first page starts from the first matched edge.\n    - `limit`: Maximum number of matched edges to return in this slice. It defaults to 12, which is a reasonable number for you to inspect at a time.\n    You can adjust it based on your preference and the typical number of matched edges.\n    - `path_limit`: Maximum number of compact dependency paths to include. A dependency path is a sequence of dependency edges connecting two symbols.\n    If there are more matched paths than this limit, only the first few unique compressed paths are returned.\n    Important behavior:\n    - If at least one symbol matches the combined `symbol_contains` / `scope_contains` / `path_contains` filters, only edges whose source or destination is in that matched symbol set are retained.\n    - If no symbol matches those filters, edge filtering falls back to `edge_type` plus pagination only; it does not return an empty edge list.\n    Returns:\n    A JSON string encoding an object with the following top-level fields:\n    - `instance_id`: The current DaLIC instance id.\n    - `dep_summary`: Summary counts, including retained file / symbol / edge counts and the returned / filtered edge counts.\n    - `applied_filters`: The effective filter and pagination values used for this call.\n    - `matched_symbols`: A compact JSON array of symbols related to the current page of results.\n    - `edges`: A JSON array of matched dependency edges.\n    - `paths`: A JSON array of compressed dependency-path strings related to the current page.\n    - `has_more`: Whether more matched edges are available after this slice.\n    - `next_start`: The pagination offset to use for the next slice.\n    Each symbol in `matched_symbols` has these fields:\n    - `kind`: The raw symbol kind from DaLIC, such as `func`, `class`, or similar labels.\n    - `symbol`: The symbol name.\n    - `scope`: The raw scope string associated with the symbol.\n    - `path`: The compact file path where the symbol is defined.\n    - `line`: The line number where the symbol is defined.\n    Each edge in `edges` is a JSON object with the following fields:\n    - `src`: A compact source-symbol object with fields `kind`, `symbol`, `scope`, `path`, and `line`.\n    - `dst`: A compact target-symbol object with fields `kind`, `symbol`, `scope`, `path`, and `line`.\n    - `edge_type`: The raw dependency edge type, such as `arg`, `data`, or `ret`.\n    Usage suggestions:\n    - Use it whenever you need a focused dependency slice around a traced symbol, scope, or file path.\n    - During analysis, you may call it again with narrower `symbol_contains`, `scope_contains`, `path_contains`, or `edge_type` filters.\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n---- BEGIN FUNCTION #4: get_trace_artifacts ----\nDescription: \nRead a compact raw slice of DaLIC execution-trace artifacts for the current instance.\nThis tool reads '<instance_id>/unique_artifacts.json' and returns a short JSON summary.\nIt does not rank or recommend results. It only applies exact filters and pagination.\n\nNote:\n'<instance_id>/unique_artifacts.json' is generated through a Software Reconnaissance-style analysis, which involves:\n- executing two Python scripts describing the same process with (A.py) and without (B.py) the feature enabled.\n- tracing their execution, obtain trace A and trace B as the execution traces of A.py and B.py, respectively.\n- then subtracting the overlapping parts from trace A and save the rest in '<instance_id>/unique_artifacts.json'. Therefore it contains the non-overlapping artifacts that only appear in A.py, which are likely to be related to the feature and thus to the issue.\n\nArgs:\n- `artifact_type`: Optional exact filter for artifact definition type. It can be `function`, `method`, or `class`. \n    If not specified, it defaults to `all` and does not filter by artifact type.\n- `path_contains`: Optional case-insensitive substring filter applied to the compact file path. For example, if you are interested in artifacts defined in files under `src/utils`, you can set `path_contains` to `src/utils`. \n    If not specified, it defaults to `None` and does not filter by file path.\n- `name_contains`: Optional case-insensitive substring filter applied to the qualified name. For example, if you are interested in artifacts with `DataLoader` in their qualified names, you can set `name_contains` to `DataLoader`. \n    If not specified, it defaults to `None` and does not filter by qualified name.\n- `start`: Zero-based pagination offset. It defaults to 0, meaning that the first page starts from the first matched artifact.\n- `limit`: Maximum number of artifacts to return in this slice. It defaults to 8, which is a reasonable number for you to inspect at a time. You can adjust it based on your preference and the typical number of matched artifacts.\n\nReturns:\nA JSON string encoding an object with the following top-level fields:\n- `instance_id`: The current DaLIC instance id.\n- `trace_summary`: Summary counts, including `unique_function_count`, `returned_count`, and `filtered_count`.\n- `applied_filters`: The effective filter and pagination values used for this call.\n- `artifacts`: A JSON array of matched artifacts.\n- `has_more`: Whether more matched artifacts are available after this slice.\n- `next_start`: The pagination offset to use for the next slice.\n\nEach artifact in `artifacts` is a JSON object with the following fields:\n- `qualified_name`: The qualified name of the artifact.\n- `path`: The compact file path where the artifact is defined.\n- `definition_type`: The raw definition type from DaLIC, such as `function` or `class`.\n- `defined_line`: The line number where the artifact is defined.\n- `end_line`: The ending line number of the artifact, if available.\n- `event_count`: The number of matching execution events in trace A.\n- `call_count`: The number of calls observed in trace A.\n- `max_call_depth`: The maximum observed call depth for this artifact.\n\nUsage suggestions:\n- Call this once near the start of analyzing a new data point to inspect execution-trace evidence.\n- Call it again later with narrower `path_contains` or `name_contains` filters whenever you need a more precise slice.\n\nParameters:\n  (1) artifact_type (string, optional): Optional exact filter for artifact definition type.\nAllowed values: [`all`, `function`, `method`, `class`]\n  (2) path_contains (['string', 'null'], optional): Optional case-insensitive substring filter applied to the compact file path.\n  (3) name_contains (['string', 'null'], optional): Optional case-insensitive substring filter applied to the qualified name.\n  (4) start (integer, optional): Zero-based pagination offset.\n  (5) limit (integer, optional): Maximum number of artifacts to return in this slice.\n---- END FUNCTION #4 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'matplotlib' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should include the file path, class name (if applicable), function name, or line numbers, ordered by importance.\nYour answer would better include about 5 files.\n\nIMPORTANT FORMAT RULES:\n- Output ONLY the location block, followed by `<finish></finish>`.\n- Do NOT include explanations, bullets, headings, numbering, summaries, or notes before or after the location block.\n- Each file path MUST appear on its own line and end with `.py`.\n- Do NOT write `file.py:QualifiedName` on a single line in the final answer.\n- After a file path line, use separate `line:`, `class:`, and `function:` lines as needed.\n\n### Examples:\n```\nfull_path1/file1.py\nline: 10\nclass: MyClass1\nfunction: my_function1\n\nfull_path2/file2.py\nline: 76\nfunction: MyClass2.my_function2\n\nfull_path3/file3.py\nline: 24\nline: 156\nfunction: my_function3\n```\n\nReturn just the location(s)\n\nNote: Your thinking should be thorough and so it's fine if it's very long.\n\n--- BEGIN PROBLEM STATEMENT ---\nTitle: Improve LineCollection docstring further\n\n(M, 2)\r\n\r\nI would perhaps completely drop the \"list of points\" and just write\r\n```\r\nA sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\r\narray-like of points::\r\n\r\n    line0 = [(x0, y0), (x1, y1), ...]\r\n\r\nEach line can...\r\n```\r\n\r\n_Originally posted by @anntzer in https://github.com/matplotlib/matplotlib/pull/26676#discussion_r1313026557