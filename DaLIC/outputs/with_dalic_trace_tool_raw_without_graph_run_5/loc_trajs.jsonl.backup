ibutes via xxx.attribute = \"something\" after a\n142 |     call to `self.__freeze()`. Mainly used to prevent the user from using\n143 |     wrong attributes on an accessor (`Series.cat/.str/.dt`).\n144 | \n145 |     If you really want to add a new attribute at a later time, you need to use\n146 |     `object.__setattr__(self, key, value)`.\n147 |     \"\"\"\n148 | \n149 |     def _freeze(self) -> None:\n150 |         \"\"\"\n151 |         Prevents setting additional attributes.\n152 |         \"\"\"\n153 |         object.__setattr__(self, \"__frozen\", True)\n154 | \n155 |     # prevent adding any attribute via s.xxx.new_attribute = ...\n156 |     def __setattr__(self, key: str, value) -> None:\n157 |         # _cache is used by a decorator\n158 |         # We need to check both 1.) cls.__dict__ and 2.) getattr(self, key)\n159 |         # because\n160 |         # 1.) getattr is false for attributes that raise errors\n161 |         # 2.) cls.__dict__ doesn't traverse into base classes\n162 |         if getattr(self, \"__frozen\", False) and not (\n163 |             key == \"_cache\"\n164 |             or key in type(self).__dict__\n165 |             or getattr(self, key, None) is not None\n166 |         ):\n167 |             raise AttributeError(f\"You cannot add any new attribute '{key}'\")\n168 |         object.__setattr__(self, key, value)\n```\n\nFound class `asv_bench/benchmarks/groupby.py:DateAttributes`.\nSource: Retrieved entity using keyword search (bm25).\n```\n241 | class DateAttributes:\n242 |     def setup(self):\n243 |         rng = date_range(\"1/1/2000\", \"12/31/2005\", freq=\"h\")\n244 |         self.year, self.month, self.day = rng.year, rng.month, rng.day\n245 |         self.ts = Series(np.random.randn(len(rng)), index=rng)\n246 | \n247 |     def time_len_groupby_object(self):\n248 |         len(self.ts.groupby([self.year, self.month, self.day]))\n```\n\nFound class `pandas/core/arrays/arrow/accessors.py:ArrowAccessor`.\nSource: Retrieved code co