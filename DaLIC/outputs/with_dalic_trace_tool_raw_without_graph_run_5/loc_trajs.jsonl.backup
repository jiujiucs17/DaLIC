ormats the date axis (x-axis).\n295 | \n296 |     Major and minor ticks are automatically set for the frequency of the\n297 |     current underlying series.  As the dynamic mode is activated by\n298 |     default, changing the limits of the x axis will intelligently change\n299 |     the positions of the ticks.\n300 |     \"\"\"\n301 |     from matplotlib import pylab\n302 | \n303 |     # handle index specific formatting\n304 |     # Note: DatetimeIndex does not use this\n305 |     # interface. DatetimeIndex uses matplotlib.date directly\n306 |     if isinstance(index, ABCPeriodIndex):\n307 | \n308 |         majlocator = TimeSeries_DateLocator(\n309 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n310 |         )\n311 |         minlocator = TimeSeries_DateLocator(\n312 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n313 |         )\n314 |         subplot.xaxis.set_major_locator(majlocator)\n315 |         subplot.xaxis.set_minor_locator(minlocator)\n316 | \n317 |         majformatter = TimeSeries_DateFormatter(\n318 |             freq, dynamic_mode=True, minor_locator=False, plot_obj=subplot\n319 |         )\n320 |         minformatter = TimeSeries_DateFormatter(\n321 |             freq, dynamic_mode=True, minor_locator=True, plot_obj=subplot\n322 |         )\n323 |         subplot.xaxis.set_major_formatter(majformatter)\n324 |         subplot.xaxis.set_minor_formatter(minformatter)\n325 | \n326 |         # x and y coord info\n327 |         subplot.format_coord = functools.partial(_format_coord, freq)\n328 | \n329 |     elif isinstance(index, ABCTimedeltaIndex):\n330 |         subplot.xaxis.set_major_formatter(TimeSeries_TimedeltaFormatter())\n331 |     else:\n332 |         raise TypeError(\"index type not supported\")\n333 | \n334 |     pylab.draw_if_interactive()\n```\n\nFound function `pandas/plotting/_matplotlib/tools.py:_get_layout`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 86 | def _get_layout(nplots: int, layout=None, layout_type: str = \"box\") -> tuple[int, int]:\n 87 |     if layout is not None:\n 88 |         if not isinstance(layout, (tuple, list)) or len(layout) != 2:\n 89 |             raise ValueError(\"Layout must be a tuple of (rows, columns)\")\n 90 | \n 91 |         nrows, ncols = layout\n 92 | \n 93 |         if nrows == -1 and ncols > 0:\n 94 |             layout = nrows, ncols = (ceil(nplots / ncols), ncols)\n 95 |         elif ncols == -1 and nrows > 0:\n 96 |             layout = nrows, ncols = (nrows, ceil(nplots / nrows))\n 97 |         elif ncols <= 0 and nrows <= 0:\n 98 |             msg = \"At least one dimension of layout must be positive\"\n 99 |             raise ValueError(msg)\n100 | \n101 |         if nrows * ncols < nplots:\n102 |             raise ValueError(\n103 |                 f\"Layout of {nrows}x{ncols} must be larger than required size {nplots}\"\n104 |             )\n105 | \n106 |         return layout\n107 | \n108 |     if layout_type == \"single\":\n109 |         return (1, 1)\n110 |     elif layout_type == \"horizontal\":\n111 |         return (1, nplots)\n112 |     elif layout_type == \"vertical\":\n113 |         return (nplots, 1)\n114 | \n115 |     layouts = {1: (1, 1), 2: (1, 2), 3: (2, 2), 4: (2, 2)}\n116 |     try:\n117 |         return layouts[nplots]\n118 |     except KeyError:\n119 |         k = 1\n120 |         while k**2 < nplots:\n121 |             k += 1\n122 | \n123 |         if (k - 1) * k >= nplots:\n124 |             return k, (k - 1)\n125 |         else:\n126 |             return k, k\n```\n\n\n\n##Searching for term \"subplots\", \"DataFrame.plot subplots\"...\n### Search Result:\nFound function `pandas/plotting/_core.py:boxplot_frame_groupby`.\nSource: Retrieved code content using keyword search (bm25).\n```\n526 | def boxplot_frame_groupby(\n527 |     grouped,\n528 |     subplots=True,\n529 |     column=None,\n530 |     fontsize=None,\n531 |     rot=0,\n532 |     grid=True,\n533 |     ax=None,\n534 |     figsize=None,\n535 |     layout=None,\n536 |     sharex=False,\n537 |     sharey=True,\n538 |     backend=None,\n539 |     **kwargs,\n540 | ):\n541 |     \"\"\"\n542 |     Make box plots from DataFrameGroupBy data.\n543 | \n544 |     Parameters\n545 |     ----------\n546 |     grouped : Grouped DataFrame\n547 |     subplots : bool\n548 |         * ``False`` - no subplots will be used\n549 |         * ``True`` - create a subplot for each group.\n550 | \n551 |     column : column name or list of names, or vector\n552 |         Can be any valid input to groupby.\n553 |     fontsize : int or str\n554 |     rot : label rotation angle\n555 |     grid : Setting this to True will show the grid\n556 |     ax : Matplotlib axis object, default None\n557 |     figsize : A tuple (width, height) in inches\n558 |     layout : tuple (optional)\n559 |         The layout of the plot: (rows, columns).\n560 |     sharex : bool, default False\n561 |         Whether x-axes will be shared among subplots.\n562 |     sharey : bool, default True\n563 |         Whether y-axes will be shared among subplots.\n564 |     backend : str, default None\n565 |         Backend to use instead of the backend specified in the option\n566 |         ``plotting.backend``. For instance, 'matplotlib'. Alternatively, to\n567 |         specify the ``plotting.backend`` for the whole session, set\n568 |         ``pd.options.plotting.backend``.\n569 | \n570 |         .. versionadded:: 1.0.0\n571 | \n572 |     **kwargs\n573 |         All other plotting keyword arguments to be passed to\n574 |         matplotlib's boxplot function.\n575 | \n576 |     Returns\n577 |     -------\n578 |     dict of key/value = group key/DataFrame.boxplot return value\n579 |     or DataFrame.boxplot return value in case subplots=figures=False\n580 | \n581 |     Examples\n582 |     --------\n583 |     You can create boxplots for grouped data and show them as separate subplots:\n584 | \n585 |     .. plot::\n586 |         :context: close-figs\n587 | \n588 |         >>> import itertools\n589 |         >>> tuples = [t for t in itertools.product(range(1000), range(4))]\n590 |         >>> index = pd.MultiIndex.from_tuples(tuples, names=['lvl0', 'lvl1'])\n591 |         >>> data = np.random.randn(len(index),4)\n592 |         >>> df = pd.DataFrame(data, columns=list('ABCD'), index=index)\n593 |         >>> grouped = df.groupby(level='lvl1')\n594 |         >>> grouped.boxplot(rot=45, fontsize=12, figsize=(8,10))  # doctest: +SKIP\n595 | \n596 |     The ``subplots=False`` option shows the boxplots in a single figure.\n597 | \n598 |     .. plot::\n599 |         :context: close-figs\n600 | \n601 |         >>> grouped.boxplot(subplots=False, rot=45, fontsize=12)  # doctest: +SKIP\n602 |     \"\"\"\n603 |     plot_backend = _get_plot_backend(backend)\n604 |     return plot_backend.boxplot_frame_groupby(\n605 |         grouped,\n606 |         subplots=subplots,\n607 |         column=column,\n608 |         fontsize=fontsize,\n609 |         rot=rot,\n610 |         grid=grid,\n611 |         ax=ax,\n612 |         figsize=figsize,\n613 |         layout=layout,\n614 |         sharex=sharex,\n615 |         sharey=sharey,\n616 |         **kwargs,\n617 |     )\n```\n\n\n\n##Searching for term \"DataFrame.plot subplots\"...\n### Search Result:\nFound class `pandas/plotting/_core.py:PlotAccessor`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PlotAccessor(PandasObject):\n\n    _common_kinds = (\"line\", \"bar\", \"barh\", \"kde\", \"density\", \"area\", \"hist\", \"box\")\n    _series_kinds = (\"pie\",)\n    _dataframe_kinds = (\"scatter\", \"hexbin\")\n    _kind_aliases = {\"density\": \"kde\"}\n    _all_kinds = _common_kinds + _series_kinds + _dataframe_kinds\n\n    def __init__(self, data) -> None:\n...\n    @staticmethod\n    def _get_call_args(backend_name, data, args, kwargs):\n...\n    def __call__(self, *args, **kwargs):\n...\n    __call__.__doc__ = __doc__\n\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        matplotlib.pyplot.plot : Plot y versus x as lines and/or markers.\n\n        Examples\n        --------\n\n        .. plot::\n            :context: close-figs\n\n            >>> s = pd.Series([1, 3, 2])\n            >>> s.plot.line()\n            <AxesSubplot:ylabel='Density'>\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the populations for some animals\n            over the years.\n\n            >>> df = pd.DataFrame({\n            ...    'pig': [20, 18, 489, 675, 1776],\n            ...    'horse': [4, 25, 281, 600, 1900]\n            ...    }, index=[1990, 1997, 2003, 2009, 2014])\n            >>> lines = df.plot.line()\n\n        .. plot::\n           :context: close-figs\n\n           An example with subplots, so an array of axes is returned.\n\n           >>> axes = df.plot.line(subplots=True)\n           >>> type(axes)\n           <class 'numpy.ndarray'>\n\n        .. plot::\n           :context: close-figs\n\n           Let's repeat the same example, but specifying colors for\n           each column (in this case, for each animal).\n\n           >>> axes = df.plot.line(\n           ...     subplots=True, color={\"pig\": \"pink\", \"horse\": \"#742802\"}\n           ... )\n\n        .. plot::\n            :context: close-figs\n\n            The following example shows the relationship between both\n            populations.\n\n            >>> lines = df.plot.line(x='pig', y='horse')\n        \"\"\"\n    )\n    @Substitution(kind=\"line\")\n    @Appender(_bar_or_line_doc)\n    def line(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.barh : Horizontal bar plot.\n        DataFrame.plot : Make plots of a DataFrame.\n        matplotlib.pyplot.bar : Make a bar plot with matplotlib.\n\n        Examples\n        --------\n        Basic plot.\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab':['A', 'B', 'C'], 'val':[10, 30, 20]})\n            >>> ax = df.plot.bar(x='lab', y='val', rot=0)\n\n        Plot a whole dataframe to a bar plot. Each column is assigned a\n        distinct color, and each row is nested in a group along the\n        horizontal axis.\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.bar(rot=0)\n\n        Plot stacked bar charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(stacked=True)\n\n        Instead of nesting, the figure can be split by column with\n        ``subplots=True``. In this case, a :class:`numpy.ndarray` of\n        :class:`matplotlib.axes.Axes` are returned.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(rot=0, subplots=True)\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        If you don't like the default colours, you can specify how you'd\n        like each column to be colored.\n\n        .. plot::\n            :context: close-figs\n\n            >>> axes = df.plot.bar(\n            ...     rot=0, subplots=True, color={\"speed\": \"red\", \"lifespan\": \"green\"}\n            ... )\n            >>> axes[1].legend(loc=2)  # doctest: +SKIP\n\n        Plot a single column.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(y='speed', rot=0)\n\n        Plot only selected categories for the DataFrame.\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.bar(x='lifespan', rot=0)\n    \"\"\"\n    )\n    @Substitution(kind=\"bar\")\n    @Appender(_bar_or_line_doc)\n    def bar(self, x=None, y=None, **kwargs):\n...\n    @Appender(\n        \"\"\"\n        See Also\n        --------\n        DataFrame.plot.bar: Vertical bar plot.\n        DataFrame.plot : Make plots of DataFrame using matplotlib.\n        matplotlib.axes.Axes.bar : Plot a vertical bar plot using matplotlib.\n\n        Examples\n        --------\n        Basic example\n\n        .. plot::\n            :context: close-figs\n\n            >>> df = pd.DataFrame({'lab': ['A', 'B', 'C'], 'val': [10, 30, 20]})\n            >>> ax = df.plot.barh(x='lab', y='val')\n\n        Plot a whole DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFrame({'speed': speed,\n            ...                    'lifespan': lifespan}, index=index)\n            >>> ax = df.plot.barh()\n\n        Plot stacked barh charts for the DataFrame\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(stacked=True)\n\n        We can specify colors for each column\n\n        .. plot::\n            :context: close-figs\n\n            >>> ax = df.plot.barh(color={\"speed\": \"red\", \"lifespan\": \"green\"})\n\n        Plot a column of the DataFrame to a horizontal bar plot\n\n        .. plot::\n            :context: close-figs\n\n            >>> speed = [0.1, 17.5, 40, 48, 52, 69, 88]\n            >>> lifespan = [2, 8, 70, 1.5, 25, 12, 28]\n            >>> index = ['snail', 'pig', 'elephant',\n            ...          'rabbit', 'giraffe', 'coyote', 'horse']\n            >>> df = pd.DataFr