(estimator) if v.endswith(\"_\") and not v.startswith(\"__\")\n1649 |     ]\n1650 |     return len(fitted_attrs) > 0\n```\n\n\n\n##Searching for term \"Returns\"...\n### Search Result:\nFound class `sklearn/feature_selection/_rfe.py:RFE`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass RFE(SelectorMixin, MetaEstimatorMixin, BaseEstimator):\n\n    _parameter_constraints: dict = {\n        \"estimator\": [HasMethods([\"fit\"])],\n        \"n_features_to_select\": [\n            None,\n            Interval(RealNotInt, 0, 1, closed=\"right\"),\n            Interval(Integral, 0, None, closed=\"neither\"),\n        ],\n        \"step\": [\n            Interval(Integral, 0, None, closed=\"neither\"),\n            Interval(RealNotInt, 0, 1, closed=\"neither\"),\n        ],\n        \"verbose\": [\"verbose\"],\n        \"importance_getter\": [str, callable],\n    }\n\n    def __init__(\n        self,\n        estimator,\n        *,\n        n_features_to_select=None,\n        step=1,\n        verbose=0,\n        importance_getter=\"auto\",\n    ):\n...\n    @property\n    def _estimator_type(self):\n...\n    @property\n    def classes_(self):\n...\n    @_fit_context(\n        # RFE.estimator is not validated yet\n        prefer_skip_nested_validation=False\n    )\n    def fit(self, X, y, **fit_params):\n...\n    def _fit(self, X, y, step_score=None, **fit_params):\n...\n    @available_if(_estimator_has(\"predict\"))\n    def predict(self, X, **predict_params):\n...\n    @available_if(_estimator_has(\"score\"))\n    def score(self, X, y, **score_params):\n...\n    def _get_support_mask(self):\n...\n    @available_if(_estimator_has(\"decision_function\"))\n    def decision_function(self, X):\n...\n    @available_if(_estimator_has(\"predict_proba\"))\n    def predict_proba(self, X):\n...\n    @available_if(_estimator_has(\"predict_log_proba\"))\n    def predict_log_proba(self, X):\n...