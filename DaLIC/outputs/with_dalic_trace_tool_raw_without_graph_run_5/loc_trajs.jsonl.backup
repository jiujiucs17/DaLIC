|     Returns\n 76 |     -------\n 77 |     bool\n 78 |         True if the comparison fails, False otherwise\n 79 |     \"\"\"\n 80 |     with conda_path.open() as file:\n 81 |         deps = yaml.safe_load(file)[\"dependencies\"]\n 82 | \n 83 |     pip_deps = []\n 84 |     for dep in deps:\n 85 |         if isinstance(dep, str):\n 86 |             conda_dep = conda_package_to_pip(dep)\n 87 |             if conda_dep:\n 88 |                 pip_deps.append(conda_dep)\n 89 |         elif isinstance(dep, dict) and len(dep) == 1 and \"pip\" in dep:\n 90 |             pip_deps.extend(dep[\"pip\"])\n 91 |         else:\n 92 |             raise ValueError(f\"Unexpected dependency {dep}\")\n 93 | \n 94 |     header = (\n 95 |         f\"# This file is auto-generated from {conda_path.name}, do not modify.\\n\"\n 96 |         \"# See that file for comments about the need/usage of each dependency.\\n\\n\"\n 97 |     )\n 98 |     pip_content = header + \"\\n\".join(pip_deps) + \"\\n\"\n 99 | \n100 |     # add setuptools to requirements-dev.txt\n101 |     meta = toml.load(pathlib.Path(conda_path.parent, \"pyproject.toml\"))\n102 |     for requirement in meta[\"build-system\"][\"requires\"]:\n103 |         if \"setuptools\" in requirement:\n104 |             pip_content += requirement\n105 |             pip_content += \"\\n\"\n106 | \n107 |     if compare:\n108 |         with pip_path.open() as file:\n109 |             return pip_content != file.read()\n110 | \n111 |     with pip_path.open(\"w\") as file:\n112 |         file.write(pip_content)\n113 |     return False\n```\n\n\n\n##Searching for term \"requires\"...\n### Search Result:\nFound code snippet in file `scripts/generate_pip_deps_from_conda.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | #!/usr/bin/env python3\n  2 | \"\"\"\n  3 | Convert the conda environment.yml to the pip requirements-dev.txt,\n  4 | or check that they have the same packages (for the CI)\n  5 | \n  6 | Usage:\n  7 | \n 