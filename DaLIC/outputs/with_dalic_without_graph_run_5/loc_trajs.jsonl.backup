ions\n380 |         if self.op in [\"==\", \"!=\"]:\n381 |             # too many values to create the expression?\n382 |             if len(values) <= self._max_selectors:\n383 |                 vs = [self.generate(v) for v in values]\n384 |                 self.condition = f\"({' | '.join(vs)})\"\n385 | \n386 |             # use a filter after reading\n387 |             else:\n388 |                 return None\n389 |         else:\n390 |             self.condition = self.generate(values[0])\n391 | \n392 |         return self\n393 | \n394 | \n395 | class JointConditionBinOp(ConditionBinOp):\n396 |     # error: Signature of \"evaluate\" incompatible with supertype \"BinOp\"\n397 |     def evaluate(self) -> Self:  # type: ignore[override]\n398 |         self.condition = f\"({self.lhs.condition} {self.op} {self.rhs.condition})\"\n399 |         return self\n400 | \n401 | \n402 | class UnaryOp(ops.UnaryOp):\n403 |     def prune(self, klass):\n404 |         if self.op != \"~\":\n405 |             raise NotImplementedError(\"UnaryOp only support invert type ops\")\n406 | \n407 |         operand = self.operand\n408 |         operand = operand.prune(klass)\n409 | \n410 |         if operand is not None and (\n411 |             (issubclass(klass, ConditionBinOp) and operand.condition is not None)\n412 |             or (\n413 |                 not issubclass(klass, ConditionBinOp)\n414 |                 and issubclass(klass, FilterBinOp)\n415 |                 and operand.filter is not None\n416 |             )\n417 |         ):\n418 |             return operand.invert()\n419 |         return None\n420 | \n421 | \n422 | class PyTablesExprVisitor(BaseExprVisitor):\n423 |     const_type: ClassVar[type[ops.Term]] = Constant\n424 |     term_type: ClassVar[type[Term]] = Term\n425 | \n426 |     def __init__(self, env, engine, parser, **kwargs) -> None:\n427 |         super().__init__(env, engine, parser)\n428 |         for bin_op in self.binary_ops:\n429 |             bin_node = sel