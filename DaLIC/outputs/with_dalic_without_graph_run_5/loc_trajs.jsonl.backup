1, 0],\n3482 |         ], dtype=np.intp)\n3483 | \n3484 |         voxel_faces = defaultdict(list)\n3485 | \n3486 |         def permutation_matrices(n):\n3487 |             \"\"\"Generate cyclic permutation matrices.\"\"\"\n3488 |             mat = np.eye(n, dtype=np.intp)\n3489 |             for i in range(n):\n3490 |                 yield mat\n3491 |                 mat = np.roll(mat, 1, axis=0)\n3492 | \n3493 |         # iterate over each of the YZ, ZX, and XY orientations, finding faces\n3494 |         # to render\n3495 |         for permute in permutation_matrices(3):\n3496 |             # find the set of ranges to iterate over\n3497 |             pc, qc, rc = permute.T.dot(size)\n3498 |             pinds = np.arange(pc)\n3499 |             qinds = np.arange(qc)\n3500 |             rinds = np.arange(rc)\n3501 | \n3502 |             square_rot_pos = square.dot(permute.T)\n3503 |             square_rot_neg = square_rot_pos[::-1]\n3504 | \n3505 |             # iterate within the current plane\n3506 |             for p in pinds:\n3507 |                 for q in qinds:\n3508 |                     # iterate perpendicularly to the current plane, handling\n3509 |                     # boundaries. We only draw faces between a voxel and an\n3510 |                     # empty space, to avoid drawing internal faces.\n3511 | \n3512 |                     # draw lower faces\n3513 |                     p0 = permute.dot([p, q, 0])\n3514 |                     i0 = tuple(p0)\n3515 |                     if filled[i0]:\n3516 |                         voxel_faces[i0].append(p0 + square_rot_neg)\n3517 | \n3518 |                     # draw middle faces\n3519 |                     for r1, r2 in itertools.pairwise(rinds):\n3520 |                         p1 = permute.dot([p, q, r1])\n3521 |                         p2 = permute.dot([p, q, r2])\n3522 | \n3523 |                         i1 = tuple(p1)\n3524 |                         i2 = tuple(p2)\n3525 | \n3526 |                         if f