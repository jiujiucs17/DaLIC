ys.path.insert(0, args.python_path)\n374 |     globals()[\"pandas\"] = importlib.import_module(\"pandas\")\n375 | \n376 |     # Set the matplotlib backend to the non-interactive Agg backend for all\n377 |     # child processes.\n378 |     os.environ[\"MPLBACKEND\"] = \"module://matplotlib.backends.backend_agg\"\n379 | \n380 |     builder = DocBuilder(\n381 |         args.num_jobs,\n382 |         not args.no_api,\n383 |         args.whatsnew,\n384 |         args.single,\n385 |         args.verbosity,\n386 |         args.warnings_are_errors,\n387 |         args.no_browser,\n388 |     )\n389 |     return getattr(builder, args.command)()\n```\n\nFound function `pandas/util/version/__init__.py:_cmpkey`.\nSource: Retrieved entity using keyword search (bm25).\n```\n394 | def _cmpkey(\n395 |     epoch: int,\n396 |     release: tuple[int, ...],\n397 |     pre: tuple[str, int] | None,\n398 |     post: tuple[str, int] | None,\n399 |     dev: tuple[str, int] | None,\n400 |     local: LocalType | None,\n401 | ) -> CmpKey:\n402 |     # When we compare a release version, we want to compare it with all of the\n403 |     # trailing zeros removed. So we'll use a reverse the list, drop all the now\n404 |     # leading zeros until we come to something non zero, then take the rest\n405 |     # re-reverse it back into the correct order and make it a tuple and use\n406 |     # that for our sorting key.\n407 |     _release = tuple(\n408 |         reversed(list(itertools.dropwhile(lambda x: x == 0, reversed(release))))\n409 |     )\n410 | \n411 |     # We need to \"trick\" the sorting algorithm to put 1.0.dev0 before 1.0a0.\n412 |     # We'll do this by abusing the pre segment, but we _only_ want to do this\n413 |     # if there is not a pre or a post segment. If we have one of those then\n414 |     # the normal sorting rules will handle this case correctly.\n415 |     if pre is None and post is None and dev is not None:\n416 |         _pre: CmpPrePostDevType = NegativeInfinity\n417 |     # Versions without a pre-release (except as noted above) should sort after\n418 |     # those with one.\n419 |     elif pre is None:\n420 |         _pre = Infinity\n421 |     else:\n422 |         _pre = pre\n423 | \n424 |     # Versions without a post segment should sort before those with one.\n425 |     if post is None:\n426 |         _post: CmpPrePostDevType = NegativeInfinity\n427 | \n428 |     else:\n429 |         _post = post\n430 | \n431 |     # Versions without a development segment should sort after those with one.\n432 |     if dev is None:\n433 |         _dev: CmpPrePostDevType = Infinity\n434 | \n435 |     else:\n436 |         _dev = dev\n437 | \n438 |     if local is None:\n439 |         # Versions without a local segment should sort before those with one.\n440 |         _local: CmpLocalType = NegativeInfinity\n441 |     else:\n442 |         # Versions with a local segment need that segment parsed to implement\n443 |         # the sorting rules in PEP440.\n444 |         # - Alpha numeric segments sort before numeric segments\n445 |         # - Alpha numeric segments sort lexicographically\n446 |         # - Numeric segments sort numerically\n447 |         # - Shorter versions sort before longer versions when the prefixes\n448 |         #   match exactly\n449 |         _local = tuple(\n450 |             (i, \"\") if isinstance(i, int) else (NegativeInfinity, i) for i in local\n451 |         )\n452 | \n453 |     return epoch, _release, _pre, _post, _dev, _local\n```\n\nFound file `generate_version.py`.\nSource: Retrieved entity using keyword search (bm25).\nHint: Search `generate_version.py` for the full content if needed.\n"}, {"content": "```\npandas/docs/source/generated/pandas.DataFrame.to_csv.rst\n\npandas/core/generic.py\nline: 3727\nline: 3733\nfunction: NDFrame.to_csv\n\npandas/io/formats/csvs.py\nline: 106\nline: 107\nfunction: CSVFormatter.float_format\n\npandas/io/formats/format.py\nline: 1163\nline: 1165\nfunction: _GenericArrayFormatter.__init_