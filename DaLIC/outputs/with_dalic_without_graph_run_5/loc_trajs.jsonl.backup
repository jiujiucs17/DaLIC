n49 |             if (assume and not ask(assume.xreplace(match), assumptions)):\n50 |                 continue\n51 |             expr2 = subs(match)(target)\n52 |             if isinstance(expr2, Expr):\n53 |                 expr2 = rebuild(expr2)\n54 |             yield expr2\n55 |     return rewrite_rl\n56 | \n```\n\nFound function `sympy/core/expr.py:Expr._eval_adjoint`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1039 | def _eval_adjoint(self):\n1040 |         from sympy.functions.elementary.complexes import conjugate, transpose\n1041 |         if self.is_hermitian:\n1042 |             return self\n1043 |         elif self.is_antihermitian:\n1044 |             return -self\n1045 |         obj = self._eval_conjugate()\n1046 |         if obj is not None:\n1047 |             return transpose(obj)\n1048 |         obj = self._eval_transpose()\n1049 |         if obj is not None:\n1050 |             return conjugate(obj)\n```\n\nFound function `sympy/series/gruntz.py:SubsSet.copy`.\nSource: Retrieved code content using keyword search (bm25).\n```\n239 | def copy(self):\n240 |         \"\"\"Create a shallow copy of SubsSet\"\"\"\n241 |         r = SubsSet()\n242 |         r.rewrites = self.rewrites.copy()\n243 |         for expr, var in self.items():\n244 |             r[expr] = var\n245 |         return r\n```\n\nFound function `sympy/series/gruntz.py:rewrite`.\nFound function `sympy/combinatorics/fp_groups.py:rewrite`.\nFound function `sympy/functions/elementary/piecewise.py:Piecewise._eval_rewrite_as_KroneckerDelta.rewrite`.\nSource: Match found for entity name `rewrite`.\nHint: Use more detailed query to get the full content of some if needed.\n\n\n\n##Searching for term \"sympy/core/expr.py:Expr.rewrite\", \"sympy/core/expr.py:Expr.rewrite sympy/core/expr.py:Expr._eval_rewrite_as\"...\n### Search Result:\nFound function `sympy/core/basic.py:Basic.rewrite`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1996 | def rewrite(self, *args, deep=True, **hints):\n1997 |         \"\"\"\n1998 |         Rewrite *self* using a defined rule.\n1999 | \n2000 |         Rewriting transforms an expression to another, which is mathematically\n2001 |         equivalent but structurally different. For example you can rewrite\n2002 |         trigonometric functions as complex exponentials or combinatorial\n2003 |         functions as gamma function.\n2004 | \n2005 |         This method takes a *pattern* and a *rule* as positional arguments.\n2006 |         *pattern* is optional parameter which defines the types of expressions\n2007 |         that will be transformed. If it is not passed, all possible expressions\n2008 |         will be rewritten. *rule* defines how the expression will be rewritten.\n2009 | \n2010 |         Parameters\n2011 |         ==========\n2012 | \n2013 |         args : Expr\n2014 |             A *rule*, or *pattern* and *rule*.\n2015 |             - *pattern* is a type or an iterable of types.\n2016 |             - *rule* can be any object.\n2017 | \n2018 |         deep : bool, optional\n2019 |             If ``True``, subexpressions are recursively transformed. Default is\n2020 |             ``True``.\n2021 | \n2022 |         Examples\n2023 |         ========\n2024 | \n2025 |         If *pattern* is unspecified, all possible expressions are transformed.\n2026 | \n2027 |         >>> from sympy import cos, sin, exp, I\n2028 |         >>> from sympy.abc import x\n2029 |         >>> expr = cos(x) + I*sin(x)\n2030 |         >>> expr.rewrite(exp)\n2031 |         exp(I*x)\n2032 | \n2033 |         Pattern can be a type or an iterable of types.\n2034 | \n2035 |         >>> expr.rewrite(sin, exp)\n2036 |         exp(I*x)/2 + cos(x) - exp(-I*x)/2\n2037 |         >>> expr.rewrite([cos,], exp)\n2038 |         exp(I*x)/2 + I*sin(x) + exp(-I*x)/2\n2039 |         >>> expr.rewrite([cos, sin], exp)\n2040 |         exp(I*x)\n2041 | \n2042 |         Rewriting behavior can be implemented by defining ``_eval_rewrite()``\n2043 |         method.\n2044 | \n2045 |         >>> from sympy import Expr, sqrt, pi\n2046 |         >>> class MySin(Expr):\n2047 |         ...     def _eval_rewrite(self, rule, args, **hints):\n2048 |         ...         x, = args\n2049 |         ...         if rule == cos:\n2050 |         ...             return cos(pi/2 - x, evaluate=False)\n2051 |         ...         if rule == sqrt:\n2052 |         ...             return sqrt(1 - cos(x)**2)\n2053 |         >>> MySin(MySin(x)).rewrite(cos)\n2054 |         cos(-cos(-x + pi/2) + pi/2)\n2055 |         >>> MySin(x).rewrite(sqrt)\n2056 |         sqrt(1 - cos(x)**2)\n2057 | \n2058 |         Defining ``_eval_rewrite_as_[...]()`` method is supported for backwards\n2059 |         compatibility reason. This may be removed in the future and using it is\n2060 |         discouraged.\n2061 | \n2062 |         >>> class MySin(Expr):\n2063 |         ...     def _eval_rewrite_as_cos(self, *args, **hints):\n2064 |         ...         x, = args\n2065 |         ...         return cos(pi/2 - x, evaluate=False)\n2066 |         >>> MySin(x).rewrite(cos)\n2067 |         cos(-x + pi/2)\n2068 | \n2069 |         \"\"\"\n2070 |         if not args:\n2071 |             return self\n2072 | \n2073 |         hints.update(deep=deep)\n2074 | \n2075 |         pattern = args[:-1]\n2076 |         rule = args[-1]\n2077 | \n2078 |         # support old design by _eval_rewrite_as_[...] method\n2079 |         if isinstance(rule, str):\n2080 |             method = \"_eval_rewrite_as_%s\" % rule\n2081 |         elif hasattr(rule, \"__name__\"):\n2082 |             # rule is class or function\n2083 |             clsname = rule.__name__\n2084 |             method = \"_eval_rewrite_as_%s\" % clsname\n2085 |         else:\n2086 |             # rule is instance\n2087 |             clsname = rule.__class__.__name__\n2088 |             method = \"_eval_rewrite_as_%s\" % clsname\n2089 | \n2090 |         if pattern:\n2091 |             if iterable(patt