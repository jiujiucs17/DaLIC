536 |     \"\"\"\n537 |     ws = \"\"\n538 |     # original, if small, if large\n539 |     conversion_data: tuple[\n540 |         tuple[type, type, type],\n541 |         tuple[type, type, type],\n542 |         tuple[type, type, type],\n543 |         tuple[type, type, type],\n544 |         tuple[type, type, type],\n545 |     ] = (\n546 |         (np.bool_, np.int8, np.int8),\n547 |         (np.uint8, np.int8, np.int16),\n548 |         (np.uint16, np.int16, np.int32),\n549 |         (np.uint32, np.int32, np.int64),\n550 |         (np.uint64, np.int64, np.float64),\n551 |     )\n552 | \n553 |     float32_max = struct.unpack(\"<f\", b\"\\xff\\xff\\xff\\x7e\")[0]\n554 |     float64_max = struct.unpack(\"<d\", b\"\\xff\\xff\\xff\\xff\\xff\\xff\\xdf\\x7f\")[0]\n555 | \n556 |     for col in data:\n557 |         # Cast from unsupported types to supported types\n558 |         is_nullable_int = (\n559 |             isinstance(data[col].dtype, ExtensionDtype)\n560 |             and data[col].dtype.kind in \"iub\"\n561 |         )\n562 |         # We need to find orig_missing before altering data below\n563 |         orig_missing = data[col].isna()\n564 |         if is_nullable_int:\n565 |             fv = 0 if data[col].dtype.kind in \"iu\" else False\n566 |             # Replace with NumPy-compatible column\n567 |             data[col] = data[col].fillna(fv).astype(data[col].dtype.numpy_dtype)\n568 |         elif isinstance(data[col].dtype, ExtensionDtype):\n569 |             if getattr(data[col].dtype, \"numpy_dtype\", None) is not None:\n570 |                 data[col] = data[col].astype(data[col].dtype.numpy_dtype)\n571 |             elif is_string_dtype(data[col].dtype):\n572 |                 # TODO could avoid converting string dtype to object here,\n573 |                 # but handle string dtype in _encode_strings\n574 |                 data[col] = data[col].astype(\"object\")\n575 |                 # generate_table checks for None values\n576 |                 data.loc[data[col].isna(), col] = None\n577 | \n578 |         dtype = data[col].dtype\n579 |         empty_df = data.shape[0] == 0\n580 |         for c_data in conversion_data:\n581 |             if dtype == c_data[0]:\n582 |                 if empty_df or data[col].max() <= np.iinfo(c_data[1]).max:\n583 |                     dtype = c_data[1]\n584 |                 else:\n585 |                     dtype = c_data[2]\n586 |                 if c_data[2] == np.int64:  # Warn if necessary\n587 |                     if data[col].max() >= 2**53:\n588 |                         ws = precision_loss_doc.format(\"uint64\", \"float64\")\n589 | \n590 |                 data[col] = data[col].astype(dtype)\n591 | \n592 |         # Check values and upcast if necessary\n593 | \n594 |         if dtype == np.int8 and not empty_df:\n595 |             if data[col].max() > 100 or data[col].min() < -127:\n596 |                 data[col] = data[col].astype(np.int16)\n597 |         elif dtype == np.int16 and not empty_df:\n598 |             if data[col].max() > 32740 or data[col].min() < -32767:\n599 |                 data[col] = data[col].astype(np.int32)\n600 |         elif dtype == np.int64:\n601 |             if empty_df or (\n602 |                 data[col].max() <= 2147483620 and data[col].min() >= -2147483647\n603 |             ):\n604 |                 data[col] = data[col].astype(np.int32)\n605 |             else:\n606 |                 data[col] = data[col].astype(np.float64)\n607 |                 if data[col].max() >= 2**53 or data[col].min() <= -(2**53):\n608 |                     ws = precision_loss_doc.format(\"int64\", \"float64\")\n609 |         elif dtype in (np.float32, np.float64):\n610 |             if np.isinf(data[col]).any():\n611 |                 raise ValueError(\n612 |                     f\"Column {col} contains infinity or -infinity\"\n613 |                     \"which is outside the range supported by Stata.\"\n614 |                 )\n615 |             value = data[c