5 |     ax2 = plt.subplot2grid((3, 1), (2, 0), fig=fig)\n 86 | \n 87 |     ax1.plot([0, 1], [0, 1], \"k:\", label=\"Perfectly calibrated\")\n 88 |     for clf, name in [(lr, 'Logistic'),\n 89 |                       (est, name),\n 90 |                       (isotonic, name + ' + Isotonic'),\n 91 |                       (sigmoid, name + ' + Sigmoid')]:\n 92 |         clf.fit(X_train, y_train)\n 93 |         y_pred = clf.predict(X_test)\n 94 |         if hasattr(clf, \"predict_proba\"):\n 95 |             prob_pos = clf.predict_proba(X_test)[:, 1]\n 96 |         else:  # use decision function\n 97 |             prob_pos = clf.decision_function(X_test)\n 98 |             prob_pos = \\\n 99 |                 (prob_pos - prob_pos.min()) / (prob_pos.max() - prob_pos.min())\n100 | \n101 |         clf_score = brier_score_loss(y_test, prob_pos, pos_label=y.max())\n102 |         print(\"%s:\" % name)\n103 |         print(\"\\tBrier: %1.3f\" % (clf_score))\n104 |         print(\"\\tPrecision: %1.3f\" % precision_score(y_test, y_pred))\n105 |         print(\"\\tRecall: %1.3f\" % recall_score(y_test, y_pred))\n106 |         print(\"\\tF1: %1.3f\\n\" % f1_score(y_test, y_pred))\n107 | \n108 |         fraction_of_positives, mean_predicted_value = \\\n109 |             calibration_curve(y_test, prob_pos, n_bins=10)\n110 | \n111 |         ax1.plot(mean_predicted_value, fraction_of_positives, \"s-\",\n112 |                  label=\"%s (%1.3f)\" % (name, clf_score))\n113 | \n114 |         ax2.hist(prob_pos, range=(0, 1), bins=10, label=name,\n115 |                  histtype=\"step\", lw=2)\n116 | \n117 |     ax1.set_ylabel(\"Fraction of positives\")\n118 |     ax1.set_ylim([-0.05, 1.05])\n119 |     ax1.legend(loc=\"lower right\")\n120 |     ax1.set_title('Calibration plots  (reliability curve)')\n121 | \n122 |     ax2.set_xlabel(\"Mean predicted value\")\n123 |     ax2.set_ylabel(\"Count\")\n124 |     ax2.legend(loc=\"upper center\", ncol=2)\n125 | \n126 |     plt.tight_layout()\n```\n\n\n\n##Searching for term \"calibration_curve\"...\n### Search Result:\nFound function `sklearn/calibration.py:calibration_curve`.\nSource: Match found for entity name `calibration_curve`.\n```\n840 | def calibration_curve(y_true, y_prob, *, normalize=False, n_bins=5, strategy=\"uniform\"):\n841 |     \"\"\"Compute true and predicted probabilities for a calibration curve.\n842 | \n843 |     The method assumes the inputs come from a binary classifier, and\n844 |     discretize the [0, 1] interval into bins.\n845 | \n846 |     Calibration curves may also be referred to as reliability diagrams.\n847 | \n848 |     Read more in the :ref:`User Guide <calibration>`.\n849 | \n850 |     Parameters\n851 |     ----------\n852 |     y_true : array-like of shape (n_samples,)\n853 |         True targets.\n854 | \n855 |     y_prob : array-like of shape (n_samples,)\n856 |         Probabilities of the positive class.\n857 | \n858 |     normalize : bool, default=False\n859 |         Whether y_prob needs to be normalized into the [0, 1] interval, i.e.\n860 |         is not a proper probability. If True, the smallest value in y_prob\n861 |         is linearly mapped onto 0 and the largest one onto 1.\n862 | \n863 |     n_bins : int, default=5\n864 |         Number of bins to discretize the [0, 1] interval. A bigger number\n865 |         requires more data. Bins with no samples (i.e. without\n866 |         corresponding values in `y_prob`) will not be returned, thus the\n867 |         returned arrays may have less than `n_bins` values.\n868 | \n869 |     strategy : {'uniform', 'quantile'}, default='uniform'\n870 |         Strategy used to define the widths of the bins.\n871 | \n872 |         uniform\n873 |             The bins have identical widths.\n874 |         quantile\n875 |             The bins have the same number of samples and depend on `y_prob`.\n876 | \n877 |     Returns\n878 |     -------\n879 |     prob_true : ndarray of shape (n_bins,) or smaller\n880 |         The proportion of samples whose class is the positive class, in each\n881 |         bin (fraction of positives).\n882 | \n883 |     prob_pred : ndarray of shape (n_bins,) or smaller\n884 |         The mean predicted probability in each bin.\n885 | \n886 |     References\n887 |     ----------\n888 |     Alexandru Niculescu-Mizil and Rich Caruana (2005) Predicting Good\n889 |     Probabilities With Supervised Learning, in Proceedings of the 22nd\n890 |     International Conference on Machine Learning (ICML).\n891 |     See section 4 (Qualitative Analysis of Predictions).\n892 | \n893 |     Examples\n894 |     --------\n895 |     >>> import numpy as np\n896 |     >>> from sklearn.calibration import calibration_curve\n897 |     >>> y_true = np.array([0, 0, 0, 0, 1, 1, 1, 1, 1])\n898 |     >>> y_pred = np.array([0.1, 0.2, 0.3, 0.4, 0.65, 0.7, 0.8, 0.9,  1.])\n899 |     >>> prob_true, prob_pred = calibration_curve(y_true, y_pred, n_bins=3)\n900 |     >>> prob_true\n901 |     array([0. , 0.5, 1. ])\n902 |     >>> prob_pred\n903 |     array([0.2  , 0.525, 0.85 ])\n904 |     \"\"\"\n905 |     y_true = column_or_1d(y_true)\n906 |     y_prob = column_or_1d(y_prob)\n907 |     check_consistent_length(y_true, y_prob)\n908 | \n909 |     if normalize:  # Normalize predicted values into interval [0, 1]\n910 |         y_prob = (y_prob - y_prob.min()) / (y_prob.max() - y_prob.min())\n911 |     elif y_prob.min() < 0 or y_prob.max() > 1:\n912 |         raise ValueError(\n913 |             \"y_prob has values outside [0, 1] and normalize is set to False.\"\n914 |         )\n915 | \n916 |     labels = np.unique(y_true)\n917 |     if len(labels) > 2:\n918 |         raise ValueError(\n919 |             \"Only binary classification is supported. Provided labels %s.\" % labels\n920 |         )\n921 |     y_true = label_binarize(y_true, classes=labels)[:, 0]\n922 | \n923 |     if strategy == \"quantile\":  # Determine bin edges by distribution of data\n924 |         quantiles = np.linspace(0, 1, n_bins + 1)\n925 |         bins = np.percentile(y_prob, quantiles * 100)\n926 |         bins[-1] = bins[-1] + 1e-8\n927 |     elif strategy == \"uniform\":\n928 |         bins = np.linspace(0.0, 1.0 + 1e-8, n_bins + 1)\n929 |     else:\n930 |         raise ValueError(\n931 |             \"Invalid entry to 'strategy' input. Strategy \"\n932 |             \"must be either 'quantile' or 'uniform'.\"\n933 |         )\n934 | \n935 |     binids = np.digitize(y_prob, bins) - 1\n936 | \n937 |     bin_sums = np.bincount(binids, weights=y_prob, minlength=len(bins))\n938 |     bin_true = np.bincount(binids, weights=y_true, minlength=len(bins))\n939 |     bin_total = np.bincount(binids, minlength=len(bins))\n940 | \n941 |     nonzero = bin_total != 0\n942 |     prob_true = bin_true[nonzero] / bin_total[nonzero]\n943 |     prob_pred = bin_sums[nonzero] / bin_total[nonzero]\n944 | \n945 |     return prob_true, prob_pred\n```\n\n\n\n##Searching for term \"CalibrationDisplay\"...\n### Search Result:\nFound function `sklearn/datasets/_base.py:load_digits`.\nSource: Retrieved code content using keyword search (bm25).\n```\n783 | def load_digits(*, n_class=10, return_X_y=False, as_frame=False):\n784 |     \"\"\"Load and return the digits dataset (classification).\n785 | \n786 |     Each datapoint is a 8x8 image of a digit.\n787 | \n788 |     =================   ==============\n789 |     Classes                         10\n790 |     Samples per class             ~180\n791 |     Samples total                 1797\n792 |     Dimensionality                  64\n793 |     Features             integers 0-16\n794 |     =================   ==============\n795 | \n796 |     Read more in the :ref:`User Guide <digits_dataset>`.\n797 | \n798 |     Parameters\n799 |     ----------\n800 |     n_class : int, default=10\n801 |         The number of classes to return. Between 0 and 10.\n802 | \n803 |     return_X_y : bool, default=False\n804 |         If True, returns ``(data, target)`` instead of a Bunch object.\n805 |         See below for more information about the `data` and `target` object.\n806 | \n807 |         .. versionadded:: 0.18\n808 | \n809 |     as_frame : bool, default=False\n810 |         If True, the data is a pandas DataFrame including columns with\n811 |         appropriate dtypes (numeric). The target is\n812 |         a pandas DataFrame or Series depending on the number of target columns.\n813 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n814 |         DataFrames or Series as described below.\n815 | \n816 |         .. versionadded:: 0.23\n817 | \n818 |     Returns\n819 |     -------\n820 |     data : :class:`~sklearn.utils.Bunch`\n821 |         Dictionary-like object, with the following attributes.\n822 | \n823 |         data : {ndarray, dataframe} of shape (1797, 64)\n824 |             The flattened data matrix. If `as_frame=True`, `data` will be\n825 |             a pandas DataFrame.\n826 |         target: {ndarray, Series} of shape (1797,)\n827 |             The classification target. If `as_frame=True`, `target` will be\n828 |             a pandas Series.\n829 |         feature_names: list\n830 |             The names of the dataset columns.\n831 |         target_names: list\n832 |             The names of target classes.\n833 | \n834 |             .. versionadded:: 0.20\n835 | \n836 |         frame: DataFrame of shape (1797, 65)\n837 |             Only present when `as_frame=True`. DataFrame with `data` and\n838 |             `target`.\n839 | \n840 |             .. versionadded:: 0.23\n841 |         images: {ndarray} of shape (1797, 8, 8)\n842 |             The raw image data.\n843 |         DESCR: str\n844 |             The full description of the dataset.\n845 | \n846 |     (data, target) : tuple if ``return_X_y`` is True\n847 | \n848 |         .. versionadded:: 0.18\n849 | \n850 |     This is a copy of the test set of the UCI ML hand-written digits datasets\n851 |     https://archive.ics.uci.edu/ml/datasets/Optical+Recognition+of+Handwritten+Digits\n852 | \n853 |     Examples\n854 |     --------\n855 |     To load the data and visualize the images::\n856 | \n857 |         >>> from sklearn.datasets import load_digits\n858 |         >>> digits = load_digits()\n859 |         >>> print(digits.data.shape)\n860 |         (1797, 64)\n861 |         >>> import matplotlib.pyplot as plt\n862 |         >>> plt.gray()\n863 |         >>> plt.matshow(digits.images[0])\n864 |         <...>\n865 |         >>> plt.show()\n866 |     \"\"\"\n867 | \n868 |     data, fdescr = load_gzip_compressed_csv_data(\n869 |         data_file_name=\"digits.csv.gz\", descr_file_name=\"digits.rst\", delimiter=\",\"\n870 |     )\n871 | \n872 |     target = data[:, -1].astype(int, copy=False)\n873 |     flat_data = data[:, :-1]\n874 |     images = flat_data.view()\n875 |     images.shape = (-1, 8, 8)\n876 | \n877 |     if n_class < 10:\n878 |         idx = target < n_class\n879 |         flat_data, target = flat_data[idx], target[idx]\n880 |         images = images[idx]\n881 | \n882 |     feature_names = [\n883 |         \"pixel_{}_{}\".format(row_idx, col_idx)\n884 |         for row_idx in range(8)\n885 |         for col_idx in range(8)\n886 |     ]\n887 | \n888 |     frame = None\n889 |     target_columns = [\n890 |         \"target\",\n891 |     ]\n892 |     if as_frame:\n893 |         frame, flat_data, target = _convert_data_dataframe(\n894 |             \"load_digits\", flat_data, target, feature_names, target_columns\n895 |         )\n896 | \n897 |     if return_X_y:\n898 |         return flat_data, target\n899 | \n900 |     return Bunch(\n901 |         data=flat_data,\n902 |         target=target,\n903 |         frame=frame,\n904 |         feature_names=feature_names,\n905 |         target_names=np.arange(10),\n906 |         images=images,\n907 |         DESCR=fdescr,\n908 |     )\n```\n\nFound function `sklearn/datasets/_base.py:load_linnerud`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1008 | def load_linnerud(*, return_X_y=False, as_frame=False):\n1009 |     \"\"\"Load and return the physical excercise linnerud dataset.\n1010 | \n1011 |     This dataset is suitable for multi-ouput regression tasks.\n1012 | \n1013 |     ==============   ============================\n1014 |     Samples total    20\n1015 |     Dimensionality   3 (for both data and target)\n1016 |     Features         integer\n1017 |     Targets          integer\n1018 |     ==============   ============================\n1019 | \n1020 |     Read more in the :ref:`User Guide <linnerrud_dataset>`.\n1021 | \n1022 |     Parameters\n1023 |     ----------\n1024 |     return_X_y : bool, default=False\n1025 |         If True, returns ``(data, target)`` instead of a Bunch object.\n1026 |         See below for more information about the `data` and `target` object.\n1027 | \n1028 |         .. versionadded:: 0.18\n1029 | \n1030 |     as_frame : bool, default=False\n1031 |         If True, the data is a pandas DataFrame including columns with\n1032 |         appropriate dtypes (numeric, string or categorical). The target is\n1033 |         a pandas DataFrame or Series depending on the number of target columns.\n1034 |         If `return_X_y` is True, then (`data`, `target`) will be pandas\n1035 |         DataFrames or Series as described below.\n1036 | \n1037 |         .. versionadded:: 0.23\n1038 | \n1039 |     Returns\n1040 |     -------\n1041 |     data : :class:`~sklearn.utils.Bunch`\n1042 |         Dictionary-like object, with the following attributes.\n1043 | \n1044 |         data : {ndarray, dataframe} of shape (20, 3)\n1045 |             The data matrix. If `as_frame=True`, `data` will be a pandas\n1046 |             DataFrame.\n1047 |         target: {ndarray, dataframe} of shape (20, 3)\n1048 |             The regression targets. If `as_frame=True`, `target` will be\n1049 |             a pandas DataFrame.\n1050 |         feature_names: list\n1051 |             The names of the