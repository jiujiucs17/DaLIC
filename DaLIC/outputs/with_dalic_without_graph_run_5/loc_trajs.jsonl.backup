ian priors (see Platt end of section 2.2)\n754 |     prior0 = float(np.sum(y <= 0))\n755 |     prior1 = y.shape[0] - prior0\n756 |     T = np.zeros(y.shape)\n757 |     T[y > 0] = (prior1 + 1.0) / (prior1 + 2.0)\n758 |     T[y <= 0] = 1.0 / (prior0 + 2.0)\n759 |     T1 = 1.0 - T\n760 | \n761 |     def objective(AB):\n762 |         # From Platt (beginning of Section 2.2)\n763 |         P = expit(-(AB[0] * F + AB[1]))\n764 |         loss = -(xlogy(T, P) + xlogy(T1, 1.0 - P))\n765 |         if sample_weight is not None:\n766 |             return (sample_weight * loss).sum()\n767 |         else:\n768 |             return loss.sum()\n769 | \n770 |     def grad(AB):\n771 |         # gradient of the objective function\n772 |         P = expit(-(AB[0] * F + AB[1]))\n773 |         TEP_minus_T1P = T - P\n774 |         if sample_weight is not None:\n775 |             TEP_minus_T1P *= sample_weight\n776 |         dA = np.dot(TEP_minus_T1P, F)\n777 |         dB = np.sum(TEP_minus_T1P)\n778 |         return np.array([dA, dB])\n779 | \n780 |     AB0 = np.array([0.0, log((prior0 + 1.0) / (prior1 + 1.0))])\n781 |     AB_ = fmin_bfgs(objective, AB0, fprime=grad, disp=False)\n782 |     return AB_[0], AB_[1]\n```\n\n\n\n##Searching for term \"matplotlib\"...\n### Search Result:\nFound code snippet in file `examples/applications/svm_gui.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | ==========\n  3 | Libsvm GUI\n  4 | ==========\n  5 | \n  6 | A simple graphical frontend for Libsvm mainly intended for didactic\n  7 | purposes. You can create data points by point and click and visualize\n  8 | the decision region induced by different kernels and parameter settings.\n  9 | \n 10 | To create positive examples click the left mouse button; to create\n 11 | negative examples click the right button.\n 12 | \n 13 | If all examples are from the same class, it uses a one-class SVM.\n 14 | \n 15 | \"\"\"\n 16 | \n 17 | print(__doc__)\n 18 | \n 19 | # Author: Peter Prettenhoer <peter.prettenhofer@gmail.com>\n 20 | #\n 21 | # License: BSD 3 clause\n 22 | \n 23 | import matplotlib\n 24 | matplotlib.use('TkAgg')\n 25 | from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\n 26 | try:\n 27 |     from matplotlib.backends.backend_tkagg import NavigationToolbar2Tk\n 28 | except ImportError:\n 29 |     # NavigationToolbar2TkAgg was deprecated in matplotlib 2.2\n 30 |     from matplotlib.backends.backend_tkagg import (\n 31 |         NavigationToolbar2TkAgg as NavigationToolbar2Tk\n 32 |     )\n 33 | from matplotlib.figure import Figure\n 34 | from matplotlib.contour import ContourSet\n 35 | \n 36 | import sys\n 37 | import numpy as np\n 38 | import tkinter as Tk\n 39 | \n 40 | from sklearn import svm\n 41 | from sklearn.datasets import dump_svmlight_file\n 42 | \n 43 | y_min, y_max = -50, 50\n 44 | x_min, x_max = -50, 50\n```\n\nFound function `sklearn/utils/__init__.py:check_matplotlib_support`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1085 | def check_matplotlib_support(caller_name):\n1086 |     \"\"\"Raise ImportError with detailed error message if mpl is not installed.\n1087 | \n1088 |     Plot utilities like :func:`plot_partial_dependence` should lazily import\n1089 |     matplotlib and call this helper before any computation.\n1090 | \n1091 |     Parameters\n1092 |     ----------\n1093 |     caller_name : str\n1094 |         The name of the caller that requires matplotlib.\n1095 |     \"\"\"\n1096 |     try:\n1097 |         import matplotlib  # noqa\n1098 |     except ImportError as e:\n1099 |         raise ImportError(\n1100 |             \"{} requires matplotlib. You can install matplotlib with \"\n1101 |             \"`pip install matplotlib`\".format(caller_name)\n1102 |         ) from e\n```\n\nFound function `doc/conftest.py:skip_if_matplotlib_not_installed`.\nSource: Retrieved entity using keyword search (bm25).\n```\n102 | def skip_if_matplotlib_not_installed(fname):\n103 |     tr