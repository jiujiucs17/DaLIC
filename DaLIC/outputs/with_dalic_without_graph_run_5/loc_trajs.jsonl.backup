upby,\n  65 | )\n  66 | from pandas.core.groupby.grouper import Grouper\n  67 | from pandas.core.groupby.ops import BinGrouper\n  68 | from pandas.core.indexes.api import MultiIndex\n  69 | from pandas.core.indexes.base import Index\n  70 | from pandas.core.indexes.datetimes import (\n  71 |     DatetimeIndex,\n  72 |     date_range,\n  73 | )\n  74 | from pandas.core.indexes.period import (\n  75 |     PeriodIndex,\n  76 |     period_range,\n  77 | )\n  78 | from pandas.core.indexes.timedeltas import (\n  79 |     TimedeltaIndex,\n  80 |     timedelta_range,\n  81 | )\n  82 | from pandas.core.reshape.concat import concat\n  83 | \n  84 | from pandas.tseries.frequencies import (\n  85 |     is_subperiod,\n  86 |     is_superperiod,\n  87 | )\n  88 | from pandas.tseries.offsets import (\n  89 |     Day,\n  90 |     Tick,\n  91 | )\n  92 | \n  93 | if TYPE_CHECKING:\n  94 |     from collections.abc import (\n  95 |         Callable,\n  96 |         Hashable,\n  97 |     )\n  98 | \n  99 |     from pandas._typing import (\n 100 |         Any,\n 101 |         AnyArrayLike,\n 102 |         Axis,\n 103 |         Concatenate,\n 104 |         FreqIndexT,\n 105 |         Frequency,\n 106 |         IndexLabel,\n 107 |         InterpolateOptions,\n 108 |         P,\n 109 |         Self,\n 110 |         T,\n 111 |         TimedeltaConvertibleTypes,\n 112 |         TimeGrouperOrigin,\n 113 |         TimestampConvertibleTypes,\n 114 |         npt,\n 115 |     )\n 116 | \n 117 |     from pandas import (\n 118 |         DataFrame,\n 119 |         Series,\n 120 |     )\n 121 | \n 122 | _shared_docs_kwargs: dict[str, str] = {}\n 123 | \n 124 | \n 125 | class Resampler(BaseGroupBy, PandasObject):\n 126 |     \"\"\"\n 127 |     Class for resampling datetimelike data, a groupby-like operation.\n 128 |     See aggregate, transform, and apply functions on this object.\n 129 | \n 130 |     It's easiest to use obj.resample(...) to use Resampler.\n 131 | \n 132 |     Parameters\n 133 |     ----------\n 134 |     obj : Series or DataFrame\n 135 |     groupby : TimeGrouper\n 136 | \n 137 |     Returns\n 138 |     -------\n 139 |     a Resampler of the appropriate type\n 140 | \n 141 |     Notes\n 142 |     -----\n 143 |     After resampling, see aggregate, apply, and transform functions.\n 144 |     \"\"\"\n 145 | \n 146 |     _grouper: BinGrouper\n 147 |     _timegrouper: TimeGrouper\n 148 |     binner: DatetimeIndex | TimedeltaIndex | PeriodIndex  # depends on subclass\n 149 |     exclusions: frozenset[Hashable] = frozenset()  # for SelectionMixin compat\n 150 |     _internal_names_set = set({\"obj\", \"ax\", \"_indexer\"})\n 151 | \n 152 |     # to the groupby descriptor\n 153 |     _attributes = [\n 154 |         \"freq\",\n 155 |         \"closed\",\n 156 |         \"label\",\n 157 |         \"convention\",\n 158 |         \"origin\",\n 159 |         \"offset\",\n 160 |     ]\n 161 | \n 162 |     def __init__(\n 163 |         self,\n 164 |         obj: NDFrame,\n 165 |         timegrouper: TimeGrouper,\n 166 |         *,\n 167 |         gpr_index: Index,\n 168 |         group_keys: bool = False,\n 169 |         selection=None,\n 170 |         include_groups: bool = True,\n 171 |     ) -> None:\n 172 |         self._timegrouper = timegrouper\n 173 |         self.keys = None\n 174 |         self.sort = True\n 175 |         self.group_keys = group_keys\n 176 |         self.as_index = True\n 177 |         self.include_groups = include_groups\n 178 | \n 179 |         self.obj, self.ax, self._indexer = self._timegrouper._set_grouper(\n 180 |             self._convert_obj(obj), sort=True, gpr_index=gpr_index\n 181 |         )\n 182 |         self.binner, self._grouper = self._get_binner()\n 183 |         self._selection = selection\n 184 |         if self._timegrouper.key is not None:\n 185 |             self.exclusions = frozenset([self._timegrouper.key])\n 186 |         else:\n 187 |             self.exclusions = frozenset()\n 188 | \n 189 |     @final\n 190 |     def __str__(self) -> str:\n 191 |         \"\"\"\n 192 |         Provide a nice str repr of our rolling object.\n 193 |         \"\"\"\n 194 |         attrs = (\n 195 |             f\"{k}={getattr(self._timegrouper, k)}\"\n 196 |             for k in self._attributes\n 197 |             if getattr(self._timegrouper, k, None) is not None\n 198 |         )\n 199 |         return f\"{type(self).__name__} [{', '.join(attrs)}]\"\n 200 | \n 201 |     @final\n 202 |     def __getattr__(self, attr: str):\n 203 |         if attr in self._internal_names_set:\n 204 |             return object.__getattribute__(self, attr)\n 205 |         if attr in self._attributes:\n 206 |             return getattr(self._timegrouper, attr)\n 207 |         if attr in self.obj:\n 208 |             return self[attr]\n 209 | \n 210 |         return object.__getattribute__(self, attr)\n 211 | \n 212 |     @final\n 213 |     @property\n 214 |     def _from_selection(self) -> bool:\n 215 |         \"\"\"\n 216 |         Is the resampling from a DataFrame column or MultiIndex level.\n 217 |         \"\"\"\n 218 |         # upsampling and PeriodIndex resampling do not work\n 219 |         # with selection, this state used to catch and raise an error\n 220 |         return self._timegrouper is not None and (\n 221 |             self._timegrouper.key is not None or self._timegrouper.level is not None\n 222 |         )\n 223 | \n 224 |     def _convert_obj(self, obj: NDFrameT) -> NDFrameT:\n 225 |         \"\"\"\n 226 |         Provide any conversions for the object in order to correctly handle.\n 227 | \n 228 |         Parameters\n 229 |         ----------\n 230 |         obj : Series or DataFrame\n 231 | \n 232 |         Returns\n 233 |         -------\n 234 |         Series or DataFrame\n 235 |         \"\"\"\n 236 |         return obj._consolidate()\n 237 | \n 238 |     def _get_binner_for_time(self):\n 239 |         raise AbstractMethodError(self)\n 240 | \n 241 |     @final\n 242 |     def _get_binner(self):\n 243 |         \"\"\"\n 244 |         Create the BinGrouper, assume that self.set_grouper(obj)\n 245 |         has already been called.\n 246 |         \"\"\"\n 247 |         binner, bins, binlabels = self._get_binner_for_time()\n 248 |         assert len(bins) == len(binlabels)\n 249 |         bin_grouper = BinGrouper(bins, binlabels, indexer=self._indexer)\n 250 |         return binner, bin_grouper\n 251 | \n 252 |     @overload\n 253 |     def pipe(\n 254 |         self,\n 255 |         func: Callable[Concatenate[Self, P], T],\n 256 |         *args: P.args,\n 257 |         **kwargs: P.kwargs,\n 258 |     ) -> T: ...\n 259 | \n 260 |     @overload\n 261 |     def pipe(\n 262 |         self,\n 263 |         func: tuple[Callable[..., T], str],\n 264 |         *args: Any,\n 265 |         **kwargs: Any,\n 266 |     ) -> T: ...\n 267 | \n 268 |     @final\n 269 |     @Substitution(\n 270 |         klass=\"Resampler\",\n 271 |         examples=\"\"\"\n 272 |     >>> df = pd.DataFrame({'A': [1, 2, 3, 4]},\n 273 |     ...                   index=pd.date_range('2012-08-02', periods=4))\n 274 |     >>> df\n 275 |                 A\n 276 |     2012-08-02  1\n 277 |     2012-08-03  2\n 278 |     2012-08-04  3\n 279 |     2012-08-05  4\n 280 | \n 281 |     To get the difference between each 2-day period's maximum and minimum\n 282 |     value in one pass, you can do\n 283 | \n 284 |     >>> df.resample('2D').pipe(lambda x: x.max() - x.min())\n 285 |                 A\n 286 |     2012-08-02  1\n 287 |     2012-08-04  1\"\"\",\n 288 |     )\n 289 |     @Appender(_pipe_template)\n 290 |     def pipe(\n 291 |         self,\n 292 |         func: Callable[Concatenate[Self, P], T] | tuple[Callable[..., T], str],\n 293 |         *args: Any,\n 294 |         **kwargs: Any,\n 295 |     ) -> T:\n 296 |         return super().pipe(func, *args, **kwargs)\n 297 | \n 298 |     _agg_see_also_doc = dedent(\n 299 |         \"\"\"\n 300 |     See Also\n 301 |     --------\n 302 |     DataFrame.groupby.aggregate : Aggregate using callable, string, dict,\n 303 |         or list of string/callables.\n 304 |     DataFrame.resample.transform : Transforms the Series on each group\n 305 |         based on the given function.\n 306 |     DataFrame.aggregate: Aggregate using one or more\n 307 |         operations over the specified axis.\n 308 |     \"\"\"\n 309 |     )\n 310 | \n 311 |     _agg_examples_doc = dedent(\n 312 |         \"\"\"\n 313 |     Examples\n 314 |     --------\n 315 |     >>> s = pd.Series([1, 2, 3, 4, 5],\n 316 |     ...               index=pd.date_range('20130101', periods=5, freq='s'))\n 317 |     >>> s\n 318 |     2013-01-01 00:00:00    1\n 319 |     2013-01-01 00:00:01    2\n 320 |     2013-01-01 00:00:02    3\n 321 |     2013-01-01 00:00:03    4\n 322 |     2013-01-01 00:00:04    5\n 323 |     Freq: s, dtype: int64\n 324 | \n 325 |     >>> r = s.resample('2s')\n 326 | \n 327 |     >>> r.agg(\"sum\")\n 328 |     2013-01-01 00:00:00    3\n 329 |     2013-01-01 00:00:02    7\n 330 |     2013-01-01 00:00:04    5\n 331 |     Freq: 2s, dtype: int64\n 332 | \n 333 |     >>> r.agg(['sum', 'mean', 'max'])\n 334 |                          sum  mean  max\n 335 |     2013-01-01 00:00:00    3   1.5    2\n 336 |     2013-01-01 00:00:02    7   3.5    4\n 337 |     2013-01-01 00:00:04    5   5.0    5\n 338 | \n 339 |     >>> r.agg({'result': lambda x: x.mean() / x.std(),\n 340 |     ...        'total': \"sum\"})\n 341 |                            result  total\n 342 |     2013-01-01 00:00:00  2.121320      3\n 343 |     2013-01-01 00:00:02  4.949747      7\n 344 |     2013-01-01 00:00:04       NaN      5\n 345 | \n 346 |     >>> r.agg(average=\"mean\", total=\"sum\")\n 347 |                              average  total\n 348 |     2013-01-01 00:00:00      1.5      3\n 349 |     2013-01-01 00:00:02      3.5      7\n 350 |     2013-01-01 00:00:04      5.0      5\n 351 |     \"\"\"\n 352 |     )\n 353 | \n 354 |     @final\n 355 |     @doc(\n 356 |         _shared_docs[\"aggregate\"],\n 357 |         see_also=_agg_see_also_doc,\n 358 |         examples=_agg_examples_doc,\n 359 |         klass=\"DataFrame\",\n 360 |         axis=\"\",\n 361 |     )\n 362 |     def aggregate(self, func=None, *args, **kwargs):\n 363 |         result = ResamplerWindowApply(self, func, args=args, kwargs=kwargs).agg()\n 364 |         if result is None:\n 365 |             how = func\n 366 |             result = self._groupby_and_aggregate(how, *args, **kwargs)\n 367 | \n 368 |         return result\n 369 | \n 370 |     agg = aggregate\n 371 |     apply = aggregate\n 372 | \n 373 |     @final\n 374 |     def transform(self, arg, *args, **kwargs):\n 375 |         \"\"\"\n 376 |         Call function producing a like-indexed Series on each group.\n 377 | \n 378 |         Return a Series with the transformed values.\n 379 | \n 380 |         Parameters\n 381 |         ----------\n 382 |         arg : function\n 383 |             To apply to each group. Should return a Series with the same index.\n 384 | \n 385 |         Returns\n 386 |         -------\n 387 |         Series\n 388 | \n 389 |         Examples\n 390 |         --------\n 391 |         >>> s = pd.Series([1, 2], index=pd.date_range(\"20180101\", periods=2, freq=\"1h\"))\n 392 |         >>> s\n 393 |         2018-01-01 00:00:00    1\n 394 |         2018-01-01 01:00:00    2\n 395 |         Freq: h, dtype: int64\n 396 | \n 397 |         >>> resampled = s.resample(\"15min\")\n 398 |         >>> resampled.transform(lambda x: (x - x.mean()) / x.std())\n 399 |         2018-01-01 00:00:00   NaN\n 400 |         2018-01-01 01:00:00   NaN\n 401 |         Freq: h, dtype: float64\n 402 |         \"\"\"\n 403 |         return self._selected_obj.groupby(self._timegrouper).transform(\n 404 |             arg, *args, **kwargs\n 405 |         )\n 406 | \n 407 |     def _downsample(self, how, **kwargs):\n 408 |         raise AbstractMethodError(self)\n 409 | \n 410 |     def _upsample(self, f, limit: int | None = None, fill_value=None):\n 411 |         raise AbstractMethodError(self)\n 412 | \n 413 |     def _gotitem(self, key, ndim: int, subset=None):\n 414 |         \"\"\"\n 415 |         Sub-classes to define. Return a sliced object.\n 416 | \n 417 |         Parameters\n 418 |         ----------\n 419 |         key : string / list of selections\n 420 |         ndim : {1, 2}\n 421 |             requested ndim of result\n 422 |         subset : object, default None\n 423 |             subset to act on\n 424 |         \"\"\"\n 425 |         grouper = self._grouper\n 426 |         if subset is None:\n 427 |             subset = self.obj\n 428 |             if key is not None:\n 429 |                 subset = subset[key]\n 430 |             else:\n 431 |                 # reached via Apply.agg_dict_like with selection=None and ndim=1\n 432 |                 assert subset.ndim == 1\n 433 |         if ndim == 1:\n 434 |             assert subset.ndim == 1\n 435 | \n 436 |         grouped = get_groupby(\n 437 |             subset, by=None, grouper=grouper, group_keys=self.group_keys\n 438 |         )\n 439 |         return grouped\n 440 | \n 441 |     def _groupby_and_aggregate(self, how, *args, **kwargs):\n 442 |         \"\"\"\n 443 |         Re-evaluate the obj with a groupby aggregation.\n 444 |         \"\"\"\n 445 |         grouper = self._grouper\n 446 | \n 447 |         # Excludes `on` column when provided\n 448 |         obj = self._obj_with_exclusions\n 449 | \n 450 |         grouped = get_groupby(obj, by=None, grouper=grouper, group_keys=self.group_keys)\n 451 | \n 452 |         try:\n 453 |             if callable(how):\n 454 |                 # TODO: test_resample_apply_with_additional_args fails if we go\n 455 |                 #  through the non-lambda path, not clear that it should.\n 456 |                 func = lambda x: how(x, *args, **kwargs)\n 457 |                 result = grouped.aggregate(func)\n 458 |             else:\n 459 |                 result = grouped.aggregate(how, *args, **kwargs)\n 460 |         except (AttributeError, KeyError):\n 461 |             # we have a non-reducing function; try to evaluate\n 462 |             # alternatively we want to evaluate only a column of the input\n 463 | \n 464 |             # test_apply_to_one_column_of_df the function being applied references\n 465 |             #  a DataFrame column, but aggregate_item_by_item operates column-wise\n 466 |             #  on Series, raising AttributeError or KeyError\n 467 |             #  (depending on whether the column lookup uses getattr/__getitem__)\n 468 |             result = _apply(\n 469 |                 grouped, how, *args, include_groups=self.include_groups, **kwargs\n 470 |             )\n 471 | \n 472 |         except ValueError as err:\n 473 |             if \"Must produce aggregated value\" in str(err):\n 474 |                 # raised in _aggregate_named\n 475 |                 # see test_apply_without_aggregation, test_apply_with_mutated_index\n 476 |                 pass\n 477 |             else:\n 478 |                 raise\n 479 | \n 480 |             # we have a non-reducing function\n 481 |             # try to evaluate\n 482 |             result = _apply(\n 483 |                 grouped, how, *args, include_groups=self.include_groups, **kwargs\n 484 |             )\n 485 | \n 486 |         return self._wrap_result(result)\n 487 | \n 488 |     @final\n 489 |     def _get_resampler_for_grouping(\n 490 |         self, groupby: GroupBy, key, include_groups: bool = True\n 491 |     ):\n 492 |         \"\"\"\n 493 |         Return the correct class for resampling with groupby.\n 494 |         \"\"\"\n 495 |         return self._resampler_for_grouping(\n 496 |             groupby=groupby, key=key, parent=self, include_groups=include_groups\n 497 |         )\n 498 | \n 499 |     def _wrap_result(self, result):\n 500 |         \"\"\"\n 501 |         Potentially wrap any results.\n 502 |         \"\"\"\n 503 |         # GH 47705\n 504 |         obj = self.obj\n 505 |         if (\n 506 |             isinstance(result, ABCDataFrame)\n 507 |             and len(result) == 0\n 508 |             and not isinstance(result.index, PeriodIndex)\n 509 |         ):\n 510 |             result = result.set_index(\n 511 |                 _asfreq_compat(obj.index[:0], freq=self.freq), append=True\n 512 |             )\n 513 | \n 514 |         if isinstance(result, ABCSeries) and self._selection is not None:\n 515 |             result.name = self._selection\n 516 | \n 517 |         if isinstance(result, ABCSeries) and result.empty:\n 518 |             # When index is all NaT, result is empty but index is not\n 519 |             result.index = _asfreq_compat(obj.index[:0], freq=self.freq)\n 520 |             result.name = getattr(obj, \"name\", None)\n 521 | \n 522 |         if self._timegrouper._arrow_dtype is not None:\n 523 |             result.index = result.index.astype(self._timegrouper._arrow_dtype)\n 524 | \n 525 |         return result\n 526 | \n 527 |     @final\n 528 |     def ffill(self, limit: int | None = None):\n 529 |         \"\"\"\n 530 |         Forward fill the values.\n 531 | \n 532 |         This method fills missing values by propagating the last valid\n 533 |         observation forward, up to the next valid observation. It is commonly\n 534 |         used in time series analysis when resampling data to a higher frequency\n 535 |         (upsampling) and filling gaps in the resampled output.\n 536 | \n 537 |         Parameters\n 538 |         ----------\n 539 |         limit : int, optional\n 540 |             Limit of how many values to fill.\n 541 | \n 542 |         Returns\n 543 |         -------\n 544 |         Series\n 545 |             The resampled data with missing values filled forward.\n 546 | \n 547 |         See Also\n 548 |         --------\n 549 |         Series.fillna: Fill NA/NaN values using the specified method.\n 550 |         DataFrame.fillna: Fill NA/NaN values using the specified method.\n 551 | \n 552 |         Examples\n 553 |         --------\n 554 |         Here we only create a ``Series``.\n 555 | \n 556 |         >>> ser = pd.Series(\n 557 |         ...     [1, 2, 3, 4],\n 558 |         ...     index=pd.DatetimeIndex(\n 559 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n 560 |         ...     ),\n 561 |         ... )\n 562 |         >>> ser\n 563 |         2023-01-01    1\n 564 |         2023-01-15    2\n 565 |         2023-02-01    3\n 566 |         2023-02-15    4\n 567 |         dtype: int64\n 568 | \n 569 |         Example for ``ffill`` with downsampling (we have fewer dates after resampling):\n 570 | \n 571 |         >>> ser.resample(\"MS\").ffill()\n 572 |         2023-01-01    1\n 573 |         2023-02-01    3\n 574 |         Freq: MS, dtype: int64\n 575 | \n 576 |         Example for ``ffill`` with upsampling (fill the new dates with\n 577 |         the previous value):\n 578 | \n 579 |         >>> ser.resample(\"W\").ffill()\n 580 |         2023-01-01    1\n 581 |         2023-01-08    1\n 582 |         2023-01-15    2\n 583 |         2023-01-22    2\n 584 |         2023-01-29    2\n 585 |         2023-02-05    3\n 586 |         2023-02-12    3\n 587 |         2023-02-19    4\n 588 |         Freq: W-SUN, dtype: int64\n 589 | \n 590 |         With upsampling and limiting (only fill the first new date with the\n 591 |         previous value):\n 592 | \n 593 |         >>> ser.resample(\"W\").ffill(limit=1)\n 594 |         2023-01-01    1.0\n 595 |         2023-01-08    1.0\n 596 |         2023-01-15    2.0\n 597 |         2023-01-22    2.0\n 598 |         2023-01-29    NaN\n 599 |         2023-02-05    3.0\n 600 |         2023-02-12    NaN\n 601 |         2023-02-19    4.0\n 602 |         Freq: W-SUN, dtype: float64\n 603 |         \"\"\"\n 604 |         return self._upsample(\"ffill\", limit=limit)\n 605 | \n 606 |     @final\n 607 |     def nearest(self, limit: int | None = None):\n 608 |         \"\"\"\n 609 |         Resample by using the nearest value.\n 610 | \n 611 |         When resampling data, missing values may appear (e.g., when the\n 612 |         resampling frequency is higher than the original frequency).\n 613 |         The `nearest` method will replace ``NaN`` values that appeared in\n 614 |         the resampled data with the value from the nearest member of the\n 615 |         sequence, based on the index value.\n 616 |         Missing values that existed in the original data will not be modified.\n 617 |         If `limit` is given, fill only this many values in each direction for\n 618 |         each of the original values.\n 619 | \n 620 |         Parameters\n 621 |         ----------\n 622 |         limit : int, optional\n 623 |             Limit of how many values to fill.\n 624 | \n 625 |         Returns\n 626 |         -------\n 627 |         Series or DataFrame\n 628 |             An upsampled Series or DataFrame with ``NaN`` values filled with\n 629 |             their nearest value.\n 630 | \n 631 |         See Also\n 632 |         --------\n 633 |         bfill : Backward fill the new missing values in the resampled data.\n 634 |         ffill : Forward fill ``NaN`` values.\n 635 | \n 636 |         Examples\n 637 |         --------\n 638 |         >>> s = pd.Series([1, 2], index=pd.date_range(\"20180101\", periods=2, freq=\"1h\"))\n 639 |         >>> s\n 640 |         2018-01-01 00:00:00    1\n 641 |         2018-01-01 01:00:00    2\n 642 |         Freq: h, dtype: int64\n 643 | \n 644 |         >>> s.resample(\"15min\").nearest()\n 645 |         2018-01-01 00:00:00    1\n 646 |         2018-01-01 00:15:00    1\n 647 |         2018-01-01 00:30:00    2\n 648 |         2018-01-01 00:45:00    2\n 649 |         2018-01-01 01:00:00    2\n 650 |         Freq: 15min, dtype: int64\n 651 | \n 652 |         Limit the number of upsampled values imputed by the nearest:\n 653 | \n 654 |         >>> s.resample(\"15min\").nearest(limit=1)\n 655 |         2018-01-01 00:00:00    1.0\n 656 |         2018-01-01 00:15:00    1.0\n 657 |         2018-01-01 00:30:00    NaN\n 658 |         2018-01-01 00:45:00    2.0\n 659 |         2018-01-01 01:00:00    2.0\n 660 |         Freq: 15min, dtype: float64\n 661 |         \"\"\"\n 662 |         return self._upsample(\"nearest\", limit=limit)\n 663 | \n 664 |     @final\n 665 |     def bfill(self, limit: int | None = None):\n 666 |         \"\"\"\n 667 |         Backward fill the new missing values in the resampled data.\n 668 | \n 669 |         In statistics, imputation is the process of replacing missing data with\n 670 |         substituted values [1]_. When resampling data, missing values may\n 671 |         appear (e.g., when the resampling frequency is higher than the original\n 672 |         frequency). The backward fill will replace NaN values that appeared in\n 673 |         the resampled data with the next value in the original sequence.\n 674 |         Missing values that existed in the original data will not be modified.\n 675 | \n 676 |         Parameters\n 677 |         ----------\n 678 |         limit : int, optional\n 679 |             Limit of how many values to fill.\n 680 | \n 681 |         Returns\n 682 |         -------\n 683 |         Series, DataFrame\n 684 |             An upsampled Series or DataFrame with backward filled NaN values.\n 685 | \n 686 |         See Also\n 687 |         --------\n 688 |         nearest : Fill NaN values with nearest neighbor starting from center.\n 689 |         ffill : Forward fill NaN values.\n 690 |         Series.fillna : Fill NaN values in the Series using the\n 691 |             specified method, which can be 'backfill'.\n 692 |         DataFrame.fillna : Fill NaN values in the DataFrame using the\n 693 |             specified method, which can be 'backfill'.\n 694 | \n 695 |         References\n 696 |         ----------\n 697 |         .. [1] https://en.wikipedia.org/wiki/Imputation_(statistics)\n 698 | \n 699 |         Examples\n 700 |         --------\n 701 |         Resampling a Series:\n 702 | \n 703 |         >>> s = pd.Series(\n 704 |         ...     [1, 2, 3], index=pd.date_range(\"20180101\", periods=3, freq=\"h\")\n 705 |         ... )\n 706 |         >>> s\n 707 |         2018-01-01 00:00:00    1\n 708 |         2018-01-01 01:00:00    2\n 709 |         2018-01-01 02:00:00    3\n 710 |         Freq: h, dtype: int64\n 711 | \n 712 |         >>> s.resample(\"30min\").bfill()\n 713 |         2018-01-01 00:00:00    1\n 714 |         2018-01-01 00:30:00    2\n 715 |         2018-01-01 01:00:00    2\n 716 |         2018-01-01 01:30:00    3\n 717 |         2018-01-01 02:00:00    3\n 718 |         Freq: 30min, dtype: int64\n 719 | \n 720 |         >>> s.resample(\"15min\").bfill(limit=2)\n 721 |         2018-01-01 00:00:00    1.0\n 722 |         2018-01-01 00:15:00    NaN\n 723 |         2018-01-01 00:30:00    2.0\n 724 |         2018-01-01 00:45:00    2.0\n 725 |         2018-01-01 01:00:00    2.0\n 726 |         2018-01-01 01:15:00    NaN\n 727 |         2018-01-01 01:30:00    3.0\n 728 |         2018-01-01 01:45:00    3.0\n 729 |         2018-01-01 02:00:00    3.0\n 730 |         Freq: 15min, dtype: float64\n 731 | \n 732 |         Resampling a DataFrame that has missing values:\n 733 | \n 734 |         >>> df = pd.DataFrame(\n 735 |         ...     {\"a\": [2, np.nan, 6], \"b\": [1, 3, 5]},\n 736 |         ...     index=pd.date_range(\"20180101\", periods=3, freq=\"h\"),\n 737 |         ... )\n 738 |         >>> df\n 739 |                                a  b\n 740 |         2018-01-01 00:00:00  2.0  1\n 741 |         2018-01-01 01:00:00  NaN  3\n 742 |         2018-01-01 02:00:00  6.0  5\n 743 | \n 744 |         >>> df.resample(\"30min\").bfill()\n 745 |                                a  b\n 746 |         2018-01-01 00:00:00  2.0  1\n 747 |         2018-01-01 00:30:00  NaN  3\n 748 |         2018-01-01 01:00:00  NaN  3\n 749 |         2018-01-01 01:30:00  6.0  5\n 750 |         2018-01-01 02:00:00  6.0  5\n 751 | \n 752 |         >>> df.resample(\"15min\").bfill(limit=2)\n 753 |                                a    b\n 754 |         2018-01-01 00:00:00  2.0  1.0\n 755 |         2018-01-01 00:15:00  NaN  NaN\n 756 |         2018-01-01 00:30:00  NaN  3.0\n 757 |         2018-01-01 00:45:00  NaN  3.0\n 758 |         2018-01-01 01:00:00  NaN  3.0\n 759 |         2018-01-01 01:15:00  NaN  NaN\n 760 |         2018-01-01 01:30:00  6.0  5.0\n 761 |         2018-01-01 01:45:00  6.0  5.0\n 762 |         2018-01-01 02:00:00  6.0  5.0\n 763 |         \"\"\"\n 764 |         return self._upsample(\"bfill\", limit=limit)\n 765 | \n 766 |     @final\n 767 |     def interpolate(\n 768 |         self,\n 769 |         method: InterpolateOptions = \"linear\",\n 770 |         *,\n 771 |         axis: Axis = 0,\n 772 |         limit: int | None = None,\n 773 |         inplace: bool = False,\n 774 |         limit_direction: Literal[\"forward\", \"backward\", \"both\"] = \"forward\",\n 775 |         limit_area=None,\n 776 |         downcast=lib.no_default,\n 777 |         **kwargs,\n 778 |     ):\n 779 |         \"\"\"\n 780 |         Interpolate values between target timestamps according to different methods.\n 781 | \n 782 |         The original index is first reindexed to target timestamps\n 783 |         (see :meth:`core.resample.Resampler.asfreq`),\n 784 |         then the interpolation of ``NaN`` values via :meth:`DataFrame.interpolate`\n 785 |         happens.\n 786 | \n 787 |         Parameters\n 788 |         ----------\n 789 |         method : str, default 'linear'\n 790 |             Interpolation technique to use. One of:\n 791 | \n 792 |             * 'linear': Ignore the index and treat the values as equally\n 793 |               spaced. This is the only method supported on MultiIndexes.\n 794 |             * 'time': Works on daily and higher resolution data to interpolate\n 795 |               given length of interval.\n 796 |             * 'index', 'values': use the actual numerical values of the index.\n 797 |             * 'pad': Fill in NaNs using existing values.\n 798 |             * 'nearest', 'zero', 'slinear', 'quadratic', 'cubic',\n 799 |               'barycentric', 'polynomial': Passed to\n 800 |               `scipy.interpolate.interp1d`, whereas 'spline' is passed to\n 801 |               `scipy.interpolate.UnivariateSpline`. These methods use the numerical\n 802 |               values of the index.  Both 'polynomial' and 'spline' require that\n 803 |               you also specify an `order` (int), e.g.\n 804 |               ``df.interpolate(method='polynomial', order=5)``. Note that,\n 805 |               `slinear` method in Pandas refers to the Scipy first order `spline`\n 806 |               instead of Pandas first order `spline`.\n 807 |             * 'krogh', 'piecewise_polynomial', 'spline', 'pchip', 'akima',\n 808 |               'cubicspline': Wrappers around the SciPy interpolation methods of\n 809 |               similar names. See `Notes`.\n 810 |             * 'from_derivatives': Refers to\n 811 |               `scipy.interpolate.BPoly.from_derivatives`.\n 812 | \n 813 |         axis : {{0 or 'index', 1 or 'columns', None}}, default None\n 814 |             Axis to interpolate along. For `Series` this parameter is unused\n 815 |             and defaults to 0.\n 816 |         limit : int, optional\n 817 |             Maximum number of consecutive NaNs to fill. Must be greater than\n 818 |             0.\n 819 |         inplace : bool, default False\n 820 |             Update the data in place if possible.\n 821 |         limit_direction : {{'forward', 'backward', 'both'}}, Optional\n 822 |             Consecutive NaNs will be filled in this direction.\n 823 | \n 824 |         limit_area : {{`None`, 'inside', 'outside'}}, default None\n 825 |             If limit is specified, consecutive NaNs will be filled with this\n 826 |             restriction.\n 827 | \n 828 |             * ``None``: No fill restriction.\n 829 |             * 'inside': Only fill NaNs surrounded by valid values\n 830 |               (interpolate).\n 831 |             * 'outside': Only fill NaNs outside valid values (extrapolate).\n 832 | \n 833 |         downcast : optional, 'infer' or None, defaults to None\n 834 |             Downcast dtypes if possible.\n 835 | \n 836 |             .. deprecated:: 2.1.0\n 837 | \n 838 |         **kwargs : optional\n 839 |             Keyword arguments to pass on to the interpolating function.\n 840 | \n 841 |         Returns\n 842 |         -------\n 843 |         DataFrame or Series\n 844 |             Interpolated values at the specified freq.\n 845 | \n 846 |         See Also\n 847 |         --------\n 848 |         core.resample.Resampler.asfreq: Return the values at the new freq,\n 849 |             essentially a reindex.\n 850 |         DataFrame.interpolate: Fill NaN values using an interpolation method.\n 851 |         DataFrame.bfill : Backward fill NaN values in the resampled data.\n 852 |         DataFrame.ffill : Forward fill NaN values.\n 853 | \n 854 |         Notes\n 855 |         -----\n 856 |         For high-frequent or non-equidistant time-series with timestamps\n 857 |         the reindexing followed by interpolation may lead to information loss\n 858 |         as shown in the last example.\n 859 | \n 860 |         Examples\n 861 |         --------\n 862 | \n 863 |         >>> start = \"2023-03-01T07:00:00\"\n 864 |         >>> timesteps = pd.date_range(start, periods=5, freq=\"s\")\n 865 |         >>> series = pd.Series(data=[1, -1, 2, 1, 3], index=timesteps)\n 866 |         >>> series\n 867 |         2023-03-01 07:00:00    1\n 868 |         2023-03-01 07:00:01   -1\n 869 |         2023-03-01 07:00:02    2\n 870 |         2023-03-01 07:00:03    1\n 871 |         2023-03-01 07:00:04    3\n 872 |         Freq: s, dtype: int64\n 873 | \n 874 |         Downsample the dataframe to 0.5Hz by providing the period time of 2s.\n 875 | \n 876 |         >>> series.resample(\"2s\").interpolate(\"linear\")\n 877 |         2023-03-01 07:00:00    1\n 878 |         2023-03-01 07:00:02    2\n 879 |         2023-03-01 07:00:04    3\n 880 |         Freq: 2s, dtype: int64\n 881 | \n 882 |         Upsample the dataframe to 2Hz by providing the period time of 500ms.\n 883 | \n 884 |         >>> series.resample(\"500ms\").interpolate(\"linear\")\n 885 |         2023-03-01 07:00:00.000    1.0\n 886 |         2023-03-01 07:00:00.500    0.0\n 887 |         2023-03-01 07:00:01.000   -1.0\n 888 |         2023-03-01 07:00:01.500    0.5\n 889 |         2023-03-01 07:00:02.000    2.0\n 890 |         2023-03-01 07:00:02.500    1.5\n 891 |         2023-03-01 07:00:03.000    1.0\n 892 |         2023-03-01 07:00:03.500    2.0\n 893 |         2023-03-01 07:00:04.000    3.0\n 894 |         Freq: 500ms, dtype: float64\n 895 | \n 896 |         Internal reindexing with ``asfreq()`` prior to interpolation leads to\n 897 |         an interpolated timeseries on the basis of the reindexed timestamps\n 898 |         (anchors). It is assured that all available datapoints from original\n 899 |         series become anchors, so it also works for resampling-cases that lead\n 900 |         to non-aligned timestamps, as in the following example:\n 901 | \n 902 |         >>> series.resample(\"400ms\").interpolate(\"linear\")\n 903 |         2023-03-01 07:00:00.000    1.0\n 904 |         2023-03-01 07:00:00.400    0.2\n 905 |         2023-03-01 07:00:00.800   -0.6\n 906 |         2023-03-01 07:00:01.200   -0.4\n 907 |         2023-03-01 07:00:01.600    0.8\n 908 |         2023-03-01 07:00:02.000    2.0\n 909 |         2023-03-01 07:00:02.400    1.6\n 910 |         2023-03-01 07:00:02.800    1.2\n 911 |         2023-03-01 07:00:03.200    1.4\n 912 |         2023-03-01 07:00:03.600    2.2\n 913 |         2023-03-01 07:00:04.000    3.0\n 914 |         Freq: 400ms, dtype: float64\n 915 | \n 916 |         Note that the series correctly decreases between two anchors\n 917 |         ``07:00:00`` and ``07:00:02``.\n 918 |         \"\"\"\n 919 |         assert downcast is lib.no_default  # just checking coverage\n 920 |         result = self._upsample(\"asfreq\")\n 921 | \n 922 |         # If the original data has timestamps which are not aligned with the\n 923 |         # target timestamps, we need to add those points back to the data frame\n 924 |         # that is supposed to be interpolated. This does not work with\n 925 |         # PeriodIndex, so we skip this case. GH#21351\n 926 |         obj = self._selected_obj\n 927 |         is_period_index = isinstance(obj.index, PeriodIndex)\n 928 | \n 929 |         # Skip this step for PeriodIndex\n 930 |         if not is_period_index:\n 931 |             final_index = result.index\n 932 |             if isinstance(final_index, MultiIndex):\n 933 |                 raise NotImplementedError(\n 934 |                     \"Direct interpolation of MultiIndex data frames is not \"\n 935 |                     \"supported. If you tried to resample and interpolate on a \"\n 936 |                     \"grouped data frame, please use:\\n\"\n 937 |                     \"`df.groupby(...).apply(lambda x: x.resample(...).\"\n 938 |                     \"interpolate(...), include_groups=False)`\"\n 939 |                     \"\\ninstead, as resampling and interpolation has to be \"\n 940 |                     \"performed for each group independently.\"\n 941 |                 )\n 942 | \n 943 |             missing_data_points_index = obj.index.difference(final_index)\n 944 |             if len(missing_data_points_index) > 0:\n 945 |                 result = concat(\n 946 |                     [result, obj.loc[missing_data_points_index]]\n 947 |                 ).sort_index()\n 948 | \n 949 |         result_interpolated = result.interpolate(\n 950 |             method=method,\n 951 |             axis=axis,\n 952 |             limit=limit,\n 953 |             inplace=inplace,\n 954 |             limit_direction=limit_direction,\n 955 |             limit_area=limit_area,\n 956 |             downcast=downcast,\n 957 |             **kwargs,\n 958 |         )\n 959 | \n 960 |         # No further steps if the original data has a PeriodIndex\n 961 |         if is_period_index:\n 962 |             return result_interpolated\n 963 | \n 964 |         # Make sure that original data points which do not align with the\n 965 |         # resampled index are removed\n 966 |         result_interpolated = result_interpolated.loc[final_index]\n 967 | \n 968 |         # Make sure frequency indexes are preserved\n 969 |         result_interpolated.index = final_index\n 970 |         return result_interpolated\n 971 | \n 972 |     @final\n 973 |     def asfreq(self, fill_value=None):\n 974 |         \"\"\"\n 975 |         Return the values at the new freq, essentially a reindex.\n 976 | \n 977 |         Parameters\n 978 |         ----------\n 979 |         fill_value : scalar, optional\n 980 |             Value to use for missing values, applied during upsampling (note\n 981 |             this does not fill NaNs that already were present).\n 982 | \n 983 |         Returns\n 984 |         -------\n 985 |         DataFrame or Series\n 986 |             Values at the specified freq.\n 987 | \n 988 |         See Also\n 989 |         --------\n 990 |         Series.asfreq: Convert TimeSeries to specified frequency.\n 991 |         DataFrame.asfreq: Convert TimeSeries to specified frequency.\n 992 | \n 993 |         Examples\n 994 |         --------\n 995 | \n 996 |         >>> ser = pd.Series(\n 997 |         ...     [1, 2, 3, 4],\n 998 |         ...     index=pd.DatetimeIndex(\n 999 |         ...         [\"2023-01-01\", \"2023-01-31\", \"2023-02-01\", \"2023-02-28\"]\n1000 |         ...     ),\n1001 |         ... )\n1002 |         >>> ser\n1003 |         2023-01-01    1\n1004 |         2023-01-31    2\n1005 |         2023-02-01    3\n1006 |         2023-02-28    4\n1007 |         dtype: int64\n1008 |         >>> ser.resample(\"MS\").asfreq()\n1009 |         2023-01-01    1\n1010 |         2023-02-01    3\n1011 |         Freq: MS, dtype: int64\n1012 |         \"\"\"\n1013 |         return self._upsample(\"asfreq\", fill_value=fill_value)\n1014 | \n1015 |     @final\n1016 |     def sum(\n1017 |         self,\n1018 |         numeric_only: bool = False,\n1019 |         min_count: int = 0,\n1020 |     ):\n1021 |         \"\"\"\n1022 |         Compute sum of group values.\n1023 | \n1024 |         This method provides a simple way to compute the sum of values within each\n1025 |         resampled group, particularly useful for aggregating time-based data into\n1026 |         daily, monthly, or yearly sums.\n1027 | \n1028 |         Parameters\n1029 |         ----------\n1030 |         numeric_only : bool, default False\n1031 |             Include only float, int, boolean columns.\n1032 | \n1033 |             .. versionchanged:: 2.0.0\n1034 | \n1035 |                 numeric_only no longer accepts ``None``.\n1036 | \n1037 |         min_count : int, default 0\n1038 |             The required number of valid values to perform the operation. If fewer\n1039 |             than ``min_count`` non-NA values are present the result will be NA.\n1040 | \n1041 |         Returns\n1042 |         -------\n1043 |         Series or DataFrame\n1044 |             Computed sum of values within each group.\n1045 | \n1046 |         See Also\n1047 |         --------\n1048 |         core.resample.Resampler.mean : Compute mean of groups, excluding missing values.\n1049 |         core.resample.Resampler.count : Compute count of group, excluding missing\n1050 |             values.\n1051 |         DataFrame.resample : Resample time-series data.\n1052 |         Series.sum : Return the sum of the values over the requested axis.\n1053 | \n1054 |         Examples\n1055 |         --------\n1056 |         >>> ser = pd.Series(\n1057 |         ...     [1, 2, 3, 4],\n1058 |         ...     index=pd.DatetimeIndex(\n1059 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1060 |         ...     ),\n1061 |         ... )\n1062 |         >>> ser\n1063 |         2023-01-01    1\n1064 |         2023-01-15    2\n1065 |         2023-02-01    3\n1066 |         2023-02-15    4\n1067 |         dtype: int64\n1068 |         >>> ser.resample(\"MS\").sum()\n1069 |         2023-01-01    3\n1070 |         2023-02-01    7\n1071 |         Freq: MS, dtype: int64\n1072 |         \"\"\"\n1073 |         return self._downsample(\"sum\", numeric_only=numeric_only, min_count=min_count)\n1074 | \n1075 |     @final\n1076 |     def prod(\n1077 |         self,\n1078 |         numeric_only: bool = False,\n1079 |         min_count: int = 0,\n1080 |     ):\n1081 |         \"\"\"\n1082 |         Compute prod of group values.\n1083 | \n1084 |         Parameters\n1085 |         ----------\n1086 |         numeric_only : bool, default False\n1087 |             Include only float, int, boolean columns.\n1088 | \n1089 |             .. versionchanged:: 2.0.0\n1090 | \n1091 |                 numeric_only no longer accepts ``None``.\n1092 | \n1093 |         min_count : int, default 0\n1094 |             The required number of valid values to perform the operation. If fewer\n1095 |             than ``min_count`` non-NA values are present the result will be NA.\n1096 | \n1097 |         Returns\n1098 |         -------\n1099 |         Series or DataFrame\n1100 |             Computed prod of values within each group.\n1101 | \n1102 |         Examples\n1103 |         --------\n1104 |         >>> ser = pd.Series(\n1105 |         ...     [1, 2, 3, 4],\n1106 |         ...     index=pd.DatetimeIndex(\n1107 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1108 |         ...     ),\n1109 |         ... )\n1110 |         >>> ser\n1111 |         2023-01-01    1\n1112 |         2023-01-15    2\n1113 |         2023-02-01    3\n1114 |         2023-02-15    4\n1115 |         dtype: int64\n1116 |         >>> ser.resample(\"MS\").prod()\n1117 |         2023-01-01    2\n1118 |         2023-02-01   12\n1119 |         Freq: MS, dtype: int64\n1120 |         \"\"\"\n1121 |         return self._downsample(\"prod\", numeric_only=numeric_only, min_count=min_count)\n1122 | \n1123 |     @final\n1124 |     def min(\n1125 |         self,\n1126 |         numeric_only: bool = False,\n1127 |         min_count: int = 0,\n1128 |     ):\n1129 |         \"\"\"\n1130 |         Compute min value of group.\n1131 | \n1132 |         Returns\n1133 |         -------\n1134 |         Series or DataFrame\n1135 | \n1136 |         Examples\n1137 |         --------\n1138 |         >>> ser = pd.Series(\n1139 |         ...     [1, 2, 3, 4],\n1140 |         ...     index=pd.DatetimeIndex(\n1141 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1142 |         ...     ),\n1143 |         ... )\n1144 |         >>> ser\n1145 |         2023-01-01    1\n1146 |         2023-01-15    2\n1147 |         2023-02-01    3\n1148 |         2023-02-15    4\n1149 |         dtype: int64\n1150 |         >>> ser.resample(\"MS\").min()\n1151 |         2023-01-01    1\n1152 |         2023-02-01    3\n1153 |         Freq: MS, dtype: int64\n1154 |         \"\"\"\n1155 |         return self._downsample(\"min\", numeric_only=numeric_only, min_count=min_count)\n1156 | \n1157 |     @final\n1158 |     def max(\n1159 |         self,\n1160 |         numeric_only: bool = False,\n1161 |         min_count: int = 0,\n1162 |     ):\n1163 |         \"\"\"\n1164 |         Compute max value of group.\n1165 | \n1166 |         Returns\n1167 |         -------\n1168 |         Series or DataFrame\n1169 | \n1170 |         Examples\n1171 |         --------\n1172 |         >>> ser = pd.Series(\n1173 |         ...     [1, 2, 3, 4],\n1174 |         ...     index=pd.DatetimeIndex(\n1175 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1176 |         ...     ),\n1177 |         ... )\n1178 |         >>> ser\n1179 |         2023-01-01    1\n1180 |         2023-01-15    2\n1181 |         2023-02-01    3\n1182 |         2023-02-15    4\n1183 |         dtype: int64\n1184 |         >>> ser.resample(\"MS\").max()\n1185 |         2023-01-01    2\n1186 |         2023-02-01    4\n1187 |         Freq: MS, dtype: int64\n1188 |         \"\"\"\n1189 |         return self._downsample(\"max\", numeric_only=numeric_only, min_count=min_count)\n1190 | \n1191 |     @final\n1192 |     @doc(GroupBy.first)\n1193 |     def first(\n1194 |         self,\n1195 |         numeric_only: bool = False,\n1196 |         min_count: int = 0,\n1197 |         skipna: bool = True,\n1198 |     ):\n1199 |         return self._downsample(\n1200 |             \"first\", numeric_only=numeric_only, min_count=min_count, skipna=skipna\n1201 |         )\n1202 | \n1203 |     @final\n1204 |     @doc(GroupBy.last)\n1205 |     def last(\n1206 |         self,\n1207 |         numeric_only: bool = False,\n1208 |         min_count: int = 0,\n1209 |         skipna: bool = True,\n1210 |     ):\n1211 |         return self._downsample(\n1212 |             \"last\", numeric_only=numeric_only, min_count=min_count, skipna=skipna\n1213 |         )\n1214 | \n1215 |     @final\n1216 |     @doc(GroupBy.median)\n1217 |     def median(self, numeric_only: bool = False):\n1218 |         return self._downsample(\"median\", numeric_only=numeric_only)\n1219 | \n1220 |     @final\n1221 |     def mean(\n1222 |         self,\n1223 |         numeric_only: bool = False,\n1224 |     ):\n1225 |         \"\"\"\n1226 |         Compute mean of groups, excluding missing values.\n1227 | \n1228 |         Parameters\n1229 |         ----------\n1230 |         numeric_only : bool, default False\n1231 |             Include only `float`, `int` or `boolean` data.\n1232 | \n1233 |             .. versionchanged:: 2.0.0\n1234 | \n1235 |                 numeric_only now defaults to ``False``.\n1236 | \n1237 |         Returns\n1238 |         -------\n1239 |         DataFrame or Series\n1240 |             Mean of values within each group.\n1241 | \n1242 |         Examples\n1243 |         --------\n1244 | \n1245 |         >>> ser = pd.Series(\n1246 |         ...     [1, 2, 3, 4],\n1247 |         ...     index=pd.DatetimeIndex(\n1248 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1249 |         ...     ),\n1250 |         ... )\n1251 |         >>> ser\n1252 |         2023-01-01    1\n1253 |         2023-01-15    2\n1254 |         2023-02-01    3\n1255 |         2023-02-15    4\n1256 |         dtype: int64\n1257 |         >>> ser.resample(\"MS\").mean()\n1258 |         2023-01-01    1.5\n1259 |         2023-02-01    3.5\n1260 |         Freq: MS, dtype: float64\n1261 |         \"\"\"\n1262 |         return self._downsample(\"mean\", numeric_only=numeric_only)\n1263 | \n1264 |     @final\n1265 |     def std(\n1266 |         self,\n1267 |         ddof: int = 1,\n1268 |         numeric_only: bool = False,\n1269 |     ):\n1270 |         \"\"\"\n1271 |         Compute standard deviation of groups, excluding missing values.\n1272 | \n1273 |         Parameters\n1274 |         ----------\n1275 |         ddof : int, default 1\n1276 |             Degrees of freedom.\n1277 |         numeric_only : bool, default False\n1278 |             Include only `float`, `int` or `boolean` data.\n1279 | \n1280 |             .. versionadded:: 1.5.0\n1281 | \n1282 |             .. versionchanged:: 2.0.0\n1283 | \n1284 |                 numeric_only now defaults to ``False``.\n1285 | \n1286 |         Returns\n1287 |         -------\n1288 |         DataFrame or Series\n1289 |             Standard deviation of values within each group.\n1290 | \n1291 |         Examples\n1292 |         --------\n1293 | \n1294 |         >>> ser = pd.Series(\n1295 |         ...     [1, 3, 2, 4, 3, 8],\n1296 |         ...     index=pd.DatetimeIndex(\n1297 |         ...         [\n1298 |         ...             \"2023-01-01\",\n1299 |         ...             \"2023-01-10\",\n1300 |         ...             \"2023-01-15\",\n1301 |         ...             \"2023-02-01\",\n1302 |         ...             \"2023-02-10\",\n1303 |         ...             \"2023-02-15\",\n1304 |         ...         ]\n1305 |         ...     ),\n1306 |         ... )\n1307 |         >>> ser.resample(\"MS\").std()\n1308 |         2023-01-01    1.000000\n1309 |         2023-02-01    2.645751\n1310 |         Freq: MS, dtype: float64\n1311 |         \"\"\"\n1312 |         return self._downsample(\"std\", ddof=ddof, numeric_only=numeric_only)\n1313 | \n1314 |     @final\n1315 |     def var(\n1316 |         self,\n1317 |         ddof: int = 1,\n1318 |         numeric_only: bool = False,\n1319 |     ):\n1320 |         \"\"\"\n1321 |         Compute variance of groups, excluding missing values.\n1322 | \n1323 |         Parameters\n1324 |         ----------\n1325 |         ddof : int, default 1\n1326 |             Degrees of freedom.\n1327 | \n1328 |         numeric_only : bool, default False\n1329 |             Include only `float`, `int` or `boolean` data.\n1330 | \n1331 |             .. versionadded:: 1.5.0\n1332 | \n1333 |             .. versionchanged:: 2.0.0\n1334 | \n1335 |                 numeric_only now defaults to ``False``.\n1336 | \n1337 |         Returns\n1338 |         -------\n1339 |         DataFrame or Series\n1340 |             Variance of values within each group.\n1341 | \n1342 |         Examples\n1343 |         --------\n1344 | \n1345 |         >>> ser = pd.Series(\n1346 |         ...     [1, 3, 2, 4, 3, 8],\n1347 |         ...     index=pd.DatetimeIndex(\n1348 |         ...         [\n1349 |         ...             \"2023-01-01\",\n1350 |         ...             \"2023-01-10\",\n1351 |         ...             \"2023-01-15\",\n1352 |         ...             \"2023-02-01\",\n1353 |         ...             \"2023-02-10\",\n1354 |         ...             \"2023-02-15\",\n1355 |         ...         ]\n1356 |         ...     ),\n1357 |         ... )\n1358 |         >>> ser.resample(\"MS\").var()\n1359 |         2023-01-01    1.0\n1360 |         2023-02-01    7.0\n1361 |         Freq: MS, dtype: float64\n1362 | \n1363 |         >>> ser.resample(\"MS\").var(ddof=0)\n1364 |         2023-01-01    0.666667\n1365 |         2023-02-01    4.666667\n1366 |         Freq: MS, dtype: float64\n1367 |         \"\"\"\n1368 |         return self._downsample(\"var\", ddof=ddof, numeric_only=numeric_only)\n1369 | \n1370 |     @final\n1371 |     @doc(GroupBy.sem)\n1372 |     def sem(\n1373 |         self,\n1374 |         ddof: int = 1,\n1375 |         numeric_only: bool = False,\n1376 |     ):\n1377 |         return self._downsample(\"sem\", ddof=ddof, numeric_only=numeric_only)\n1378 | \n1379 |     @final\n1380 |     @doc(GroupBy.ohlc)\n1381 |     def ohlc(self):\n1382 |         ax = self.ax\n1383 |         obj = self._obj_with_exclusions\n1384 |         if len(ax) == 0:\n1385 |             # GH#42902\n1386 |             obj = obj.copy()\n1387 |             obj.index = _asfreq_compat(obj.index, self.freq)\n1388 |             if obj.ndim == 1:\n1389 |                 obj = obj.to_frame()\n1390 |                 obj = obj.reindex([\"open\", \"high\", \"low\", \"close\"], axis=1)\n1391 |             else:\n1392 |                 mi = MultiIndex.from_product(\n1393 |                     [obj.columns, [\"open\", \"high\", \"low\", \"close\"]]\n1394 |                 )\n1395 |                 obj = obj.reindex(mi, axis=1)\n1396 |             return obj\n1397 | \n1398 |         return self._downsample(\"ohlc\")\n1399 | \n1400 |     @final\n1401 |     def nunique(self):\n1402 |         \"\"\"\n1403 |         Return number of unique elements in the group.\n1404 | \n1405 |         Returns\n1406 |         -------\n1407 |         Series\n1408 |             Number of unique values within each group.\n1409 | \n1410 |         See Also\n1411 |         --------\n1412 |         core.groupby.SeriesGroupBy.nunique : Method nunique for SeriesGroupBy.\n1413 | \n1414 |         Examples\n1415 |         --------\n1416 |         >>> ser = pd.Series(\n1417 |         ...     [1, 2, 3, 3],\n1418 |         ...     index=pd.DatetimeIndex(\n1419 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1420 |         ...     ),\n1421 |         ... )\n1422 |         >>> ser\n1423 |         2023-01-01    1\n1424 |         2023-01-15    2\n1425 |         2023-02-01    3\n1426 |         2023-02-15    3\n1427 |         dtype: int64\n1428 |         >>> ser.resample(\"MS\").nunique()\n1429 |         2023-01-01    2\n1430 |         2023-02-01    1\n1431 |         Freq: MS, dtype: int64\n1432 |         \"\"\"\n1433 |         return self._downsample(\"nunique\")\n1434 | \n1435 |     @final\n1436 |     @doc(GroupBy.size)\n1437 |     def size(self):\n1438 |         result = self._downsample(\"size\")\n1439 | \n1440 |         # If the result is a non-empty DataFrame we stack to get a Series\n1441 |         # GH 46826\n1442 |         if isinstance(result, ABCDataFrame) and not result.empty:\n1443 |             result = result.stack()\n1444 | \n1445 |         if not len(self.ax):\n1446 |             from pandas import Series\n1447 | \n1448 |             if self._selected_obj.ndim == 1:\n1449 |                 name = self._selected_obj.name\n1450 |             else:\n1451 |                 name = None\n1452 |             result = Series([], index=result.index, dtype=\"int64\", name=name)\n1453 |         return result\n1454 | \n1455 |     @final\n1456 |     @doc(GroupBy.count)\n1457 |     def count(self):\n1458 |         result = self._downsample(\"count\")\n1459 |         if not len(self.ax):\n1460 |             if self._selected_obj.ndim == 1:\n1461 |                 result = type(self._selected_obj)(\n1462 |                     [], index=result.index, dtype=\"int64\", name=self._selected_obj.name\n1463 |                 )\n1464 |             else:\n1465 |                 from pandas import DataFrame\n1466 | \n1467 |                 result = DataFrame(\n1468 |                     [], index=result.index, columns=result.columns, dtype=\"int64\"\n1469 |                 )\n1470 | \n1471 |         return result\n1472 | \n1473 |     @final\n1474 |     def quantile(self, q: float | list[float] | AnyArrayLike = 0.5, **kwargs):\n1475 |         \"\"\"\n1476 |         Return value at the given quantile.\n1477 | \n1478 |         Parameters\n1479 |         ----------\n1480 |         q : float or array-like, default 0.5 (50% quantile)\n1481 | \n1482 |         Returns\n1483 |         -------\n1484 |         DataFrame or Series\n1485 |             Quantile of values within each group.\n1486 | \n1487 |         See Also\n1488 |         --------\n1489 |         Series.quantile\n1490 |             Return a series, where the index is q and the values are the quantiles.\n1491 |         DataFrame.quantile\n1492 |             Return a DataFrame, where the columns are the columns of self,\n1493 |             and the values are the quantiles.\n1494 |         DataFrameGroupBy.quantile\n1495 |             Return a DataFrame, where the columns are groupby columns,\n1496 |             and the values are its quantiles.\n1497 | \n1498 |         Examples\n1499 |         --------\n1500 | \n1501 |         >>> ser = pd.Series(\n1502 |         ...     [1, 3, 2, 4, 3, 8],\n1503 |         ...     index=pd.DatetimeIndex(\n1504 |         ...         [\n1505 |         ...             \"2023-01-01\",\n1506 |         ...             \"2023-01-10\",\n1507 |         ...             \"2023-01-15\",\n1508 |         ...             \"2023-02-01\",\n1509 |         ...             \"2023-02-10\",\n1510 |         ...             \"2023-02-15\",\n1511 |         ...         ]\n1512 |         ...     ),\n1513 |         ... )\n1514 |         >>> ser.resample(\"MS\").quantile()\n1515 |         2023-01-01    2.0\n1516 |         2023-02-01    4.0\n1517 |         Freq: MS, dtype: float64\n1518 | \n1519 |         >>> ser.resample(\"MS\").quantile(0.25)\n1520 |         2023-01-01    1.5\n1521 |         2023-02-01    3.5\n1522 |         Freq: MS, dtype: float64\n1523 |         \"\"\"\n1524 |         return self._downsample(\"quantile\", q=q, **kwargs)\n1525 | \n1526 | \n1527 | class _GroupByMixin(PandasObject, SelectionMixin):\n1528 |     \"\"\"\n1529 |     Provide the groupby facilities.\n1530 |     \"\"\"\n1531 | \n1532 |     _attributes: list[str]  # in practice the same as Resampler._attributes\n1533 |     _selection: IndexLabel | None = None\n1534 |     _groupby: GroupBy\n1535 |     _timegrouper: TimeGrouper\n1536 | \n1537 |     def __init__(\n1538 |         self,\n1539 |         *,\n1540 |         parent: Resampler,\n1541 |         groupby: GroupBy,\n1542 |         key=None,\n1543 |         selection: IndexLabel | None = None,\n1544 |         include_groups: bool = False,\n1545 |     ) -> None:\n1546 |         # reached via ._gotitem and _get_resampler_for_grouping\n1547 | \n1548 |         assert isinstance(groupby, GroupBy), type(groupby)\n1549 | \n1550 |         # parent is always a Resampler, sometimes a _GroupByMixin\n1551 |         assert isinstance(parent, Resampler), type(parent)\n1552 | \n1553 |         # initialize our GroupByMixin object with\n1554 |         # the resampler attributes\n1555 |         for attr in self._attributes:\n1556 |             setattr(self, attr, getattr(parent, attr))\n1557 |         self._selection = selection\n1558 | \n1559 |         self.binner = parent.binner\n1560 |         self.key = key\n1561 | \n1562 |         self._groupby = groupby\n1563 |         self._timegrouper = copy.copy(parent._timegrouper)\n1564 | \n1565 |         self.ax = parent.ax\n1566 |         self.obj = parent.obj\n1567 |         self.include_groups = include_groups\n1568 | \n1569 |     @no_type_check\n1570 |     def _apply(self, f, *args, **kwargs):\n1571 |         \"\"\"\n1572 |         Dispatch to _upsample; we are stripping all of the _upsample kwargs and\n1573 |         performing the original function call on the grouped object.\n1574 |         \"\"\"\n1575 | \n1576 |         def func(x):\n1577 |             x = self._resampler_cls(x, timegrouper=self._timegrouper, gpr_index=self.ax)\n1578 | \n1579 |             if isinstance(f, str):\n1580 |                 return getattr(x, f)(**kwargs)\n1581 | \n1582 |             return x.apply(f, *args, **kwargs)\n1583 | \n1584 |         result = _apply(self._groupby, func, include_groups=self.include_groups)\n1585 |         return self._wrap_result(result)\n1586 | \n1587 |     _upsample = _apply\n1588 |     _downsample = _apply\n1589 |     _groupby_and_aggregate = _apply\n1590 | \n1591 |     @final\n1592 |     def _gotitem(self, key, ndim, subset=None):\n1593 |         \"\"\"\n1594 |         Sub-classes to define. Return a sliced object.\n1595 | \n1596 |         Parameters\n1597 |         ----------\n1598 |         key : string / list of selections\n1599 |         ndim : {1, 2}\n1600 |             requested ndim of result\n1601 |         subset : object, default None\n1602 |             subset to act on\n1603 |         \"\"\"\n1604 |         # create a new object to prevent aliasing\n1605 |         if subset is None:\n1606 |             subset = self.obj\n1607 |             if key is not None:\n1608 |                 subset = subset[key]\n1609 |             else:\n1610 |                 # reached via Apply.agg_dict_like with selection=None, ndim=1\n1611 |                 assert subset.ndim == 1\n1612 | \n1613 |         # Try to select from a DataFrame, falling back to a Series\n1614 |         try:\n1615 |             if isinstance(key, list) and self.key not in key and self.key is not None:\n1616 |                 key.append(self.key)\n1617 |             groupby = self._groupby[key]\n1618 |         except IndexError:\n1619 |             groupby = self._groupby\n1620 | \n1621 |         selection = self._infer_selection(key, subset)\n1622 | \n1623 |         new_rs = type(self)(\n1624 |             groupby=groupby,\n1625 |             parent=cast(Resampler, self),\n1626 |             selection=selection,\n1627 |         )\n1628 |         return new_rs\n1629 | \n1630 | \n1631 | class DatetimeIndexResampler(Resampler):\n1632 |     ax: DatetimeIndex\n1633 | \n1634 |     @property\n1635 |     def _resampler_for_grouping(self) -> type[DatetimeIndexResamplerGroupby]:\n1636 |         return DatetimeIndexResamplerGroupby\n1637 | \n1638 |     def _get_binner_for_time(self):\n1639 |         # this is how we are actually creating the bins\n1640 |         if isinstance(self.ax, PeriodIndex):\n1641 |             return self._timegrouper._get_time_period_bins(self.ax)\n1642 |         return self._timegrouper._get_time_bins(self.ax)\n1643 | \n1644 |     def _downsample(self, how, **kwargs):\n1645 |         \"\"\"\n1646 |         Downsample the cython defined function.\n1647 | \n1648 |         Parameters\n1649 |         ----------\n1650 |         how : string / cython mapped function\n1651 |         **kwargs : kw args passed to how function\n1652 |         \"\"\"\n1653 |         ax = self.ax\n1654 | \n1655 |         # Excludes `on` column when provided\n1656 |         obj = self._obj_with_exclusions\n1657 | \n1658 |         if not len(ax):\n1659 |             # reset to the new freq\n1660 |             obj = obj.copy()\n1661 |             obj.index = obj.index._with_freq(self.freq)\n1662 |             assert obj.index.freq == self.freq, (obj.index.freq, self.freq)\n1663 |             return obj\n1664 | \n1665 |         # do we have a regular frequency\n1666 | \n1667 |         # error: Item \"None\" of \"Optional[Any]\" has no attribute \"binlabels\"\n1668 |         if (\n1669 |             (ax.freq is not None or ax.inferred_freq is not None)\n1670 |             and len(self._grouper.binlabels) > len(ax)\n1671 |             and how is None\n1672 |         ):\n1673 |             # let's do an asfreq\n1674 |             return self.asfreq()\n1675 | \n1676 |         # we are downsampling\n1677 |         # we want to call the actual grouper method here\n1678 |         result = obj.groupby(self._grouper).aggregate(how, **kwargs)\n1679 |         return self._wrap_result(result)\n1680 | \n1681 |     def _adjust_binner_for_upsample(self, binner):\n1682 |         \"\"\"\n1683 |         Adjust our binner when upsampling.\n1684 | \n1685 |         The range of a new index should not be outside specified range\n1686 |         \"\"\"\n1687 |         if self.closed == \"right\":\n1688 |             binner = binner[1:]\n1689 |         else:\n1690 |             binner = binner[:-1]\n1691 |         return binner\n1692 | \n1693 |     def _upsample(self, method, limit: int | None = None, fill_value=None):\n1694 |         \"\"\"\n1695 |         Parameters\n1696 |         ----------\n1697 |         method : string {'backfill', 'bfill', 'pad',\n1698 |             'ffill', 'asfreq'} method for upsampling\n1699 |         limit : int, default None\n1700 |             Maximum size gap to fill when reindexing\n1701 |         fill_value : scalar, default None\n1702 |             Value to use for missing values\n1703 |         \"\"\"\n1704 |         if self._from_selection:\n1705 |             raise ValueError(\n1706 |                 \"Upsampling from level= or on= selection \"\n1707 |                 \"is not supported, use .set_index(...) \"\n1708 |                 \"to explicitly set index to datetime-like\"\n1709 |             )\n1710 | \n1711 |         ax = self.ax\n1712 |         obj = self._selected_obj\n1713 |         binner = self.binner\n1714 |         res_index = self._adjust_binner_for_upsample(binner)\n1715 | \n1716 |         # if we have the same frequency as our axis, then we are equal sampling\n1717 |         if (\n1718 |             limit is None\n1719 |             and to_offset(ax.inferred_freq) == self.freq\n1720 |             and len(obj) == len(res_index)\n1721 |         ):\n1722 |             result = obj.copy()\n1723 |             result.index = res_index\n1724 |         else:\n1725 |             if method == \"asfreq\":\n1726 |                 method = None\n1727 |             result = obj.reindex(\n1728 |                 res_index, method=method, limit=limit, fill_value=fill_value\n1729 |             )\n1730 | \n1731 |         return self._wrap_result(result)\n1732 | \n1733 |     def _wrap_result(self, result):\n1734 |         result = super()._wrap_result(result)\n1735 | \n1736 |         # we may have a different kind that we were asked originally\n1737 |         # convert if needed\n1738 |         if isinstance(self.ax, PeriodIndex) and not isinstance(\n1739 |             result.index, PeriodIndex\n1740 |         ):\n1741 |             if isinstance(result.index, MultiIndex):\n1742 |                 # GH 24103 - e.g. groupby resample\n1743 |                 if not isinstance(result.index.levels[-1], PeriodIndex):\n1744 |                     new_level = result.index.levels[-1].to_period(self.freq)\n1745 |                     result.index = result.index.set_levels(new_level, level=-1)\n1746 |             else:\n1747 |                 result.index = result.index.to_period(self.freq)\n1748 |         return result\n1749 | \n1750 | \n1751 | # error: Definition of \"ax\" in base class \"_GroupByMixin\" is incompatible\n1752 | # with definition in base class \"DatetimeIndexResampler\"\n1753 | class DatetimeIndexResamplerGroupby(  # type: ignore[misc]\n1754 |     _GroupByMixin, DatetimeIndexResampler\n1755 | ):\n1756 |     \"\"\"\n1757 |     Provides a resample of a groupby implementation\n1758 |     \"\"\"\n1759 | \n1760 |     @property\n1761 |     def _resampler_cls(self):\n1762 |         return DatetimeIndexResampler\n1763 | \n1764 | \n1765 | class PeriodIndexResampler(DatetimeIndexResampler):\n1766 |     # error: Incompatible types in assignment (expression has type \"PeriodIndex\", base\n1767 |     # class \"DatetimeIndexResampler\" defined the type as \"DatetimeIndex\")\n1768 |     ax: PeriodIndex  # type: ignore[assignment]\n1769 | \n1770 |     @property\n1771 |     def _resampler_for_grouping(self):\n1772 |         warnings.warn(\n1773 |             \"Resampling a groupby with a PeriodIndex is deprecated. \"\n1774 |             \"Cast to DatetimeIndex before resampling instead.\",\n1775 |             FutureWarning,\n1776 |             stacklevel=find_stack_level(),\n1777 |         )\n1778 |         return PeriodIndexResamplerGroupby\n1779 | \n1780 |     def _get_binner_for_time(self):\n1781 |         if isinstance(self.ax, DatetimeIndex):\n1782 |             return super()._get_binner_for_time()\n1783 |         return self._timegrouper._get_period_bins(self.ax)\n1784 | \n1785 |     def _convert_obj(self, obj: NDFrameT) -> NDFrameT:\n1786 |         obj = super()._convert_obj(obj)\n1787 | \n1788 |         if self._from_selection:\n1789 |             # see GH 14008, GH 12871\n1790 |             msg = (\n1791 |                 \"Resampling from level= or on= selection \"\n1792 |                 \"with a PeriodIndex is not currently supported, \"\n1793 |                 \"use .set_index(...) to explicitly set index\"\n1794 |             )\n1795 |             raise NotImplementedError(msg)\n1796 | \n1797 |         # convert to timestamp\n1798 |         if isinstance(obj, DatetimeIndex):\n1799 |             obj = obj.to_timestamp(how=self.convention)\n1800 | \n1801 |         return obj\n1802 | \n1803 |     def _downsample(self, how, **kwargs):\n1804 |         \"\"\"\n1805 |         Downsample the cython defined function.\n1806 | \n1807 |         Parameters\n1808 |         ----------\n1809 |         how : string / cython mapped function\n1810 |         **kwargs : kw args passed to how function\n1811 |         \"\"\"\n1812 |         # we may need to actually resample as if we are timestamps\n1813 |         if isinstance(self.ax, DatetimeIndex):\n1814 |             return super()._downsample(how, **kwargs)\n1815 | \n1816 |         ax = self.ax\n1817 | \n1818 |         if is_subperiod(ax.freq, self.freq):\n1819 |             # Downsampling\n1820 |             return self._groupby_and_aggregate(how, **kwargs)\n1821 |         elif is_superperiod(ax.freq, self.freq):\n1822 |             if how == \"ohlc\":\n1823 |                 # GH #13083\n1824 |                 # upsampling to subperiods is handled as an asfreq, which works\n1825 |                 # for pure aggregating/reducing methods\n1826 |                 # OHLC reduces along the time dimension, but creates multiple\n1827 |                 # values for each period -> handle by _groupby_and_aggregate()\n1828 |                 return self._groupby_and_aggregate(how)\n1829 |             return self.asfreq()\n1830 |         elif ax.freq == self.freq:\n1831 |             return self.asfreq()\n1832 | \n1833 |         raise IncompatibleFrequency(\n1834 |             f\"Frequency {ax.freq} cannot be resampled to {self.freq}, \"\n1835 |             \"as they are not sub or super periods\"\n1836 |         )\n1837 | \n1838 |     def _upsample(self, method, limit: int | None = None, fill_value=None):\n1839 |         \"\"\"\n1840 |         Parameters\n1841 |         ----------\n1842 |         method : {'backfill', 'bfill', 'pad', 'ffill'}\n1843 |             Method for upsampling.\n1844 |         limit : int, default None\n1845 |             Maximum size gap to fill when reindexing.\n1846 |         fill_value : scalar, default None\n1847 |             Value to use for missing values.\n1848 |         \"\"\"\n1849 |         # we may need to actually resample as if we are timestamps\n1850 |         if isinstance(self.ax, DatetimeIndex):\n1851 |             return super()._upsample(method, limit=limit, fill_value=fill_value)\n1852 | \n1853 |         ax = self.ax\n1854 |         obj = self.obj\n1855 |         new_index = self.binner\n1856 | \n1857 |         # Start vs. end of period\n1858 |         memb = ax.asfreq(self.freq, how=self.convention)\n1859 | \n1860 |         # Get the fill indexer\n1861 |         if method == \"asfreq\":\n1862 |             method = None\n1863 |         indexer = memb.get_indexer(new_index, method=method, limit=limit)\n1864 |         new_obj = _take_new_index(\n1865 |             obj,\n1866 |             indexer,\n1867 |             new_index,\n1868 |         )\n1869 |         return self._wrap_result(new_obj)\n1870 | \n1871 | \n1872 | # error: Definition of \"ax\" in base class \"_GroupByMixin\" is incompatible with\n1873 | # definition in base class \"PeriodIndexResampler\"\n1874 | class PeriodIndexResamplerGroupby(  # type: ignore[misc]\n1875 |     _GroupByMixin, PeriodIndexResampler\n1876 | ):\n1877 |     \"\"\"\n1878 |     Provides a resample of a groupby implementation.\n1879 |     \"\"\"\n1880 | \n1881 |     @property\n1882 |     def _resampler_cls(self):\n1883 |         return PeriodIndexResampler\n1884 | \n1885 | \n1886 | class TimedeltaIndexResampler(DatetimeIndexResampler):\n1887 |     # error: Incompatible types in assignment (expression has type \"TimedeltaIndex\",\n1888 |     # base class \"DatetimeIndexResampler\" defined the type as \"DatetimeIndex\")\n1889 |     ax: TimedeltaIndex  # type: ignore[assignment]\n1890 | \n1891 |     @property\n1892 |     def _resampler_for_grouping(self):\n1893 |         return TimedeltaIndexResamplerGroupby\n1894 | \n1895 |     def _get_binner_for_time(self):\n1896 |         return self._timegrouper._get_time_delta_bins(self.ax)\n1897 | \n1898 |     def _adjust_binner_for_upsample(self, binner):\n1899 |         \"\"\"\n1900 |         Adjust our binner when upsampling.\n1901 | \n1902 |         The range of a new index is allowed to be greater than original range\n1903 |         so we don't need to change the length of a binner, GH 13022\n1904 |         \"\"\"\n1905 |         return binner\n1906 | \n1907 | \n1908 | # error: Definition of \"ax\" in base class \"_GroupByMixin\" is incompatible with\n1909 | # definition in base class \"DatetimeIndexResampler\"\n1910 | class TimedeltaIndexResamplerGroupby(  # type: ignore[misc]\n1911 |     _GroupByMixin, TimedeltaIndexResampler\n1912 | ):\n1913 |     \"\"\"\n1914 |     Provides a resample of a groupby implementation.\n1915 |     \"\"\"\n1916 | \n1917 |     @property\n1918 |     def _resampler_cls(self):\n1919 |         return TimedeltaIndexResampler\n1920 | \n1921 | \n1922 | def get_resampler(obj: Series | DataFrame, **kwds) -> Resampler:\n1923 |     \"\"\"\n1924 |     Create a TimeGrouper and return our resampler.\n1925 |     \"\"\"\n1926 |     tg = TimeGrouper(obj, **kwds)  # type: ignore[arg-type]\n1927 |     return tg._get_resampler(obj)\n1928 | \n1929 | \n1930 | get_resampler.__doc__ = Resampler.__doc__\n1931 | \n1932 | \n1933 | def get_resampler_for_grouping(\n1934 |     groupby: GroupBy,\n1935 |     rule,\n1936 |     how=None,\n1937 |     fill_method=None,\n1938 |     limit: int | None = None,\n1939 |     on=None,\n1940 |     include_groups: bool = True,\n1941 |     **kwargs,\n1942 | ) -> Resampler:\n1943 |     \"\"\"\n1944 |     Return our appropriate resampler when grouping as well.\n1945 |     \"\"\"\n1946 |     # .resample uses 'on' similar to how .groupby uses 'key'\n1947 |     tg = TimeGrouper(freq=rule, key=on, **kwargs)\n1948 |     resampler = tg._get_resampler(groupby.obj)\n1949 |     return resampler._get_resampler_for_grouping(\n1950 |         groupby=groupby, include_groups=include_groups, key=tg.key\n1951 |     )\n1952 | \n1953 | \n1954 | class TimeGrouper(Grouper):\n1955 |     \"\"\"\n1956 |     Custom groupby class for time-interval grouping.\n1957 | \n1958 |     Parameters\n1959 |     ----------\n1960 |     freq : pandas date offset or offset alias for identifying bin edges\n1961 |     closed : closed end of interval; 'left' or 'right'\n1962 |     label : interval boundary to use for labeling; 'left' or 'right'\n1963 |     convention : {'start', 'end', 'e', 's'}\n1964 |         If axis is PeriodIndex\n1965 |     \"\"\"\n1966 | \n1967 |     _attributes = Grouper._attributes + (\n1968 |         \"closed\",\n1969 |         \"label\",\n1970 |         \"how\",\n1971 |         \"convention\",\n1972 |         \"origin\",\n1973 |         \"offset\",\n1974 |     )\n1975 | \n1976 |     origin: TimeGrouperOrigin\n1977 | \n1978 |     def __init__(\n1979 |         self,\n1980 |         obj: Grouper | None = None,\n1981 |         freq: Frequency = \"Min\",\n1982 |         key: str | None = None,\n1983 |         closed: Literal[\"left\", \"right\"] | None = None,\n1984 |         label: Literal[\"left\", \"right\"] | None = None,\n1985 |         how: str = \"mean\",\n1986 |         fill_method=None,\n1987 |         limit: int | None = None,\n1988 |         convention: Literal[\"start\", \"end\", \"e\", \"s\"] | None = None,\n1989 |         origin: Literal[\"epoch\", \"start\", \"start_day\", \"end\", \"end_day\"]\n1990 |         | TimestampConvertibleTypes = \"start_day\",\n1991 |         offset: TimedeltaConvertibleTypes | None = None,\n1992 |         group_keys: bool = False,\n1993 |         **kwargs,\n1994 |     ) -> None:\n1995 |         # Check for correctness of the keyword arguments which would\n1996 |         # otherwise silently use the default if misspelled\n1997 |         if label not in {None, \"left\", \"right\"}:\n1998 |             raise ValueError(f\"Unsupported value {label} for `label`\")\n1999 |         if closed not in {None, \"left\", \"right\"}:\n2000 |             raise ValueError(f\"Unsupported value {closed} for `closed`\")\n2001 |         if convention not in {None, \"start\", \"end\", \"e\", \"s\"}:\n2002 |             raise ValueError(f\"Unsupported value {convention} for `convention`\")\n2003 | \n2004 |         if (\n2005 |             key is None\n2006 |             and obj is not None\n2007 |             and isinstance(obj.index, PeriodIndex)  # type: ignore[attr-defined]\n2008 |             or (\n2009 |                 key is not None\n2010 |                 and obj is not None\n2011 |                 and getattr(obj[key], \"dtype\", None) == \"period\"  # type: ignore[index]\n2012 |             )\n2013 |         ):\n2014 |             freq = to_offset(freq, is_period=True)\n2015 |         else:\n2016 |             freq = to_offset(freq)\n2017 | \n2018 |         end_types = {\"ME\", \"YE\", \"QE\", \"BME\", \"BYE\", \"BQE\", \"W\"}\n2019 |         rule = freq.rule_code\n2020 |         if rule in end_types or (\"-\" in rule and rule[: rule.find(\"-\")] in end_types):\n2021 |             if closed is None:\n2022 |                 closed = \"right\"\n2023 |             if label is None:\n2024 |                 label = \"right\"\n2025 |         else:\n2026 |             # The backward resample sets ``closed`` to ``'right'`` by default\n2027 |             # since the last value should be considered as the edge point for\n2028 |             # the last bin. When origin in \"end\" or \"end_day\", the value for a\n2029 |             # specific ``Timestamp`` index stands for the resample result from\n2030 |             # the current ``Timestamp`` minus ``freq`` to the current\n2031 |             # ``Timestamp`` with a right close.\n2032 |             if origin in [\"end\", \"end_day\"]:\n2033 |                 if closed is None:\n2034 |                     closed = \"right\"\n2035 |                 if label is None:\n2036 |                     label = \"right\"\n2037 |             else:\n2038 |                 if closed is None:\n2039 |                     closed = \"left\"\n2040 |                 if label is None:\n2041 |                     label = \"left\"\n2042 | \n2043 |         self.closed = closed\n2044 |         self.label = label\n2045 |         self.convention = convention if convention is not None else \"e\"\n2046 |         self.how = how\n2047 |         self.fill_method = fill_method\n2048 |         self.limit = limit\n2049 |         self.group_keys = group_keys\n2050 |         self._arrow_dtype: ArrowDtype | None = None\n2051 | \n2052 |         if origin in (\"epoch\", \"start\", \"start_day\", \"end\", \"end_day\"):\n2053 |             # error: Incompatible types in assignment (expression has type \"Union[Union[\n2054 |             # Timestamp, datetime, datetime64, signedinteger[_64Bit], float, str],\n2055 |             # Literal['epoch', 'start', 'start_day', 'end', 'end_day']]\", variable has\n2056 |             # type \"Union[Timestamp, Literal['epoch', 'start', 'start_day', 'end',\n2057 |             # 'end_day']]\")\n2058 |             self.origin = origin  # type: ignore[assignment]\n2059 |         else:\n2060 |             try:\n2061 |                 self.origin = Timestamp(origin)\n2062 |             except (ValueError, TypeError) as err:\n2063 |                 raise ValueError(\n2064 |                     \"'origin' should be equal to 'epoch', 'start', 'start_day', \"\n2065 |                     \"'end', 'end_day' or \"\n2066 |                     f\"should be a Timestamp convertible type. Got '{origin}' instead.\"\n2067 |                 ) from err\n2068 | \n2069 |         try:\n2070 |             self.offset = Timedelta(offset) if offset is not None else None\n2071 |         except (ValueError, TypeError) as err:\n2072 |             raise ValueError(\n2073 |                 \"'offset' should be a Timedelta convertible type. \"\n2074 |                 f\"Got '{offset}' instead.\"\n2075 |             ) from err\n2076 | \n2077 |         # always sort time groupers\n2078 |         kwargs[\"sort\"] = True\n2079 | \n2080 |         super().__init__(freq=freq, key=key, **kwargs)\n2081 | \n2082 |     def _get_resampler(self, obj: NDFrame) -> Resampler:\n2083 |         \"\"\"\n2084 |         Return my resampler or raise if we have an invalid axis.\n2085 | \n2086 |         Parameters\n2087 |         ----------\n2088 |         obj : Series or DataFrame\n2089 | \n2090 |         Returns\n2091 |         -------\n2092 |         Resampler\n2093 | \n2094 |         Raises\n2095 |         ------\n2096 |         TypeError if incompatible axis\n2097 | \n2098 |         \"\"\"\n2099 |         _, ax, _ = self._set_grouper(obj, gpr_index=None)\n2100 |         if isinstance(ax, DatetimeIndex):\n2101 |             return DatetimeIndexResampler(\n2102 |                 obj,\n2103 |                 timegrouper=self,\n2104 |                 group_keys=self.group_keys,\n2105 |                 gpr_index=ax,\n2106 |             )\n2107 |         elif isinstance(ax, PeriodIndex):\n2108 |             if isinstance(ax, PeriodIndex):\n2109 |                 # GH#53481\n2110 |                 warnings.warn(\n2111 |                     \"Resampling with a PeriodIndex is deprecated. \"\n2112 |                     \"Cast index to DatetimeIndex before resampling instead.\",\n2113 |                     FutureWarning,\n2114 |                     stacklevel=find_stack_level(),\n2115 |                 )\n2116 |             return PeriodIndexResampler(\n2117 |                 obj,\n2118 |                 timegrouper=self,\n2119 |                 group_keys=self.group_keys,\n2120 |                 gpr_index=ax,\n2121 |             )\n2122 |         elif isinstance(ax, TimedeltaIndex):\n2123 |             return TimedeltaIndexResampler(\n2124 |                 obj,\n2125 |                 timegrouper=self,\n2126 |                 group_keys=self.group_keys,\n2127 |                 gpr_index=ax,\n2128 |             )\n2129 | \n2130 |         raise TypeError(\n2131 |             \"Only valid with DatetimeIndex, \"\n2132 |             \"TimedeltaIndex or PeriodIndex, \"\n2133 |             f\"but got an instance of '{type(ax).__name__}'\"\n2134 |         )\n2135 | \n2136 |     def _get_grouper(\n2137 |         self, obj: NDFrameT, validate: bool = True\n2138 |     ) -> tuple[BinGrouper, NDFrameT]:\n2139 |         # create the resampler and return our binner\n2140 |         r = self._get_resampler(obj)\n2141 |         return r._grouper, cast(NDFrameT, r.obj)\n2142 | \n2143 |     def _get_time_bins(self, ax: DatetimeIndex):\n2144 |         if not isinstance(ax, DatetimeIndex):\n2145 |             raise TypeError(\n2146 |                 \"axis must be a DatetimeIndex, but got \"\n2147 |                 f\"an instance of {type(ax).__name__}\"\n2148 |             )\n2149 | \n2150 |         if len(ax) == 0:\n2151 |             binner = labels = DatetimeIndex(\n2152 |                 data=[], freq=self.freq, name=ax.name, dtype=ax.dtype\n2153 |             )\n2154 |             return binner, [], labels\n2155 | \n2156 |         first, last = _get_timestamp_range_edges(\n2157 |             ax.min(),\n2158 |             ax.max(),\n2159 |             self.freq,\n2160 |             unit=ax.unit,\n2161 |             closed=self.closed,\n2162 |             origin=self.origin,\n2163 |             offset=self.offset,\n2164 |         )\n2165 |         # GH #12037\n2166 |         # use first/last directly instead of call replace() on them\n2167 |         # because replace() will swallow the nanosecond part\n2168 |         # thus last bin maybe slightly before the end if the end contains\n2169 |         # nanosecond part and lead to `Values falls after last bin` error\n2170 |         # GH 25758: If DST lands at midnight (e.g. 'America/Havana'), user feedback\n2171 |         # has noted that ambiguous=True provides the most sensible result\n2172 |         binner = labels = date_range(\n2173 |             freq=self.freq,\n2174 |             start=first,\n2175 |             end=last,\n2176 |             tz=ax.tz,\n2177 |             name=ax.name,\n2178 |             ambiguous=True,\n2179 |             nonexistent=\"shift_forward\",\n2180 |             unit=ax.unit,\n2181 |         )\n2182 | \n2183 |         ax_values = ax.asi8\n2184 |         binner, bin_edges = self._adjust_bin_edges(binner, ax_values)\n2185 | \n2186 |         # general version, knowing nothing about relative frequencies\n2187 |         bins = lib.generate_bins_dt64(\n2188 |             ax_values, bin_edges, self.closed, hasnans=ax.hasnans\n2189 |         )\n2190 | \n2191 |         if self.closed == \"right\":\n2192 |             labels = binner\n2193 |             if self.label == \"right\":\n2194 |                 labels = labels[1:]\n2195 |         elif self.label == \"right\":\n2196 |             labels = labels[1:]\n2197 | \n2198 |         if ax.hasnans:\n2199 |             binner = binner.insert(0, NaT)\n2200 |             labels = labels.insert(0, NaT)\n2201 | \n2202 |         # if we end up with more labels than bins\n2203 |         # adjust the labels\n2204 |         # GH4076\n2205 |         if len(bins) < len(labels):\n2206 |             labels = labels[: len(bins)]\n2207 | \n2208 |         return binner, bins, labels\n2209 | \n2210 |     def _adjust_bin_edges(\n2211 |         self, binner: DatetimeIndex, ax_values: npt.NDArray[np.int64]\n2212 |     ) -> tuple[DatetimeIndex, npt.NDArray[np.int64]]:\n2213 |         # Some hacks for > daily data, see #1471, #1458, #1483\n2214 | \n2215 |         if self.freq.name in (\"BME\", \"ME\", \"W\") or self.freq.name.split(\"-\")[0] in (\n2216 |             \"BQE\",\n2217 |             \"BYE\",\n2218 |             \"QE\",\n2219 |             \"YE\",\n2220 |             \"W\",\n2221 |         ):\n2222 |             # If the right end-point is on the last day of the month, roll forwards\n2223 |             # until the last moment of that day. Note that we only do this for offsets\n2224 |             # which correspond to the end of a super-daily period - \"month start\", for\n2225 |             # example, is excluded.\n2226 |             if self.closed == \"right\":\n2227 |                 # GH 21459, GH 9119: Adjust the bins relative to the wall time\n2228 |                 edges_dti = binner.tz_localize(None)\n2229 |                 edges_dti = (\n2230 |                     edges_dti\n2231 |                     + Timedelta(days=1, unit=edges_dti.unit).as_unit(edges_dti.unit)\n2232 |                     - Timedelta(1, unit=edges_dti.unit).as_unit(edges_dti.unit)\n2233 |                 )\n2234 |                 bin_edges = edges_dti.tz_localize(binner.tz).asi8\n2235 |             else:\n2236 |                 bin_edges = binner.asi8\n2237 | \n2238 |             # intraday values on last day\n2239 |             if bin_edges[-2] > ax_values.max():\n2240 |                 bin_edges = bin_edges[:-1]\n2241 |                 binner = binner[:-1]\n2242 |         else:\n2243 |             bin_edges = binner.asi8\n2244 |         return binner, bin_edges\n2245 | \n2246 |     def _get_time_delta_bins(self, ax: TimedeltaIndex):\n2247 |         if not isinstance(ax, TimedeltaIndex):\n2248 |             raise TypeError(\n2249 |                 \"axis must be a TimedeltaIndex, but got \"\n2250 |                 f\"an instance of {type(ax).__name__}\"\n2251 |             )\n2252 | \n2253 |         if not isinstance(self.freq, Tick):\n2254 |             # GH#51896\n2255 |             raise ValueError(\n2256 |                 \"Resampling on a TimedeltaIndex requires fixed-duration `freq`, \"\n2257 |                 f\"e.g. '24h' or '3D', not {self.freq}\"\n2258 |             )\n2259 | \n2260 |         if not len(ax):\n2261 |             binner = labels = TimedeltaIndex(data=[], freq=self.freq, name=ax.name)\n2262 |             return binner, [], labels\n2263 | \n2264 |         start, end = ax.min(), ax.max()\n2265 | \n2266 |         if self.closed == \"right\":\n2267 |             end += self.freq\n2268 | \n2269 |         labels = binner = timedelta_range(\n2270 |             start=start, end=end, freq=self.freq, name=ax.name\n2271 |         )\n2272 | \n2273 |         end_stamps = labels\n2274 |         if self.closed == \"left\":\n2275 |             end_stamps += self.freq\n2276 | \n2277 |         bins = ax.searchsorted(end_stamps, side=self.closed)\n2278 | \n2279 |         if self.offset:\n2280 |             # GH 10530 & 31809\n2281 |             labels += self.offset\n2282 | \n2283 |         return binner, bins, labels\n2284 | \n2285 |     def _get_time_period_bins(self, ax: DatetimeIndex):\n2286 |         if not isinstance(ax, DatetimeIndex):\n2287 |             raise TypeError(\n2288 |                 \"axis must be a DatetimeIndex, but got \"\n2289 |                 f\"an instance of {type(ax).__name__}\"\n2290 |             )\n2291 | \n2292 |         freq = self.freq\n2293 | \n2294 |         if len(ax) == 0:\n2295 |             binner = labels = PeriodIndex(\n2296 |                 data=[], freq=freq, name=ax.name, dtype=ax.dtype\n2297 |             )\n2298 |             return binner, [], labels\n2299 | \n2300 |         labels = binner = period_range(start=ax[0], end=ax[-1], freq=freq, name=ax.name)\n2301 | \n2302 |         end_stamps = (labels + freq).asfreq(freq, \"s\").to_timestamp()\n2303 |         if ax.tz:\n2304 |             end_stamps = end_stamps.tz_localize(ax.tz)\n2305 |         bins = ax.searchsorted(end_stamps, side=\"left\")\n2306 | \n2307 |         return binner, bins, labels\n2308 | \n2309 |     def _get_period_bins(self, ax: PeriodIndex):\n2310 |         if not isinstance(ax, PeriodIndex):\n2311 |             raise TypeError(\n2312 |                 \"axis must be a PeriodIndex, but got \"\n2313 |                 f\"an instance of {type(ax).__name__}\"\n2314 |             )\n2315 | \n2316 |         memb = ax.asfreq(self.freq, how=self.convention)\n2317 | \n2318 |         # NaT handling as in pandas._lib.lib.generate_bins_dt64()\n2319 |         nat_count = 0\n2320 |         if memb.hasnans:\n2321 |             # error: Incompatible types in assignment (expression has type\n2322 |             # \"bool_\", variable has type \"int\")  [assignment]\n2323 |             nat_count = np.sum(memb._isnan)  # type: ignore[assignment]\n2324 |             memb = memb[~memb._isnan]\n2325 | \n2326 |         if not len(memb):\n2327 |             # index contains no valid (non-NaT) values\n2328 |             bins = np.array([], dtype=np.int64)\n2329 |             binner = labels = PeriodIndex(data=[], freq=self.freq, name=ax.name)\n2330 |             if len(ax) > 0:\n2331 |                 # index is all NaT\n2332 |                 binner, bins, labels = _insert_nat_bin(binner, bins, labels, len(ax))\n2333 |             return binner, bins, labels\n2334 | \n2335 |         freq_mult = self.freq.n\n2336 | \n2337 |         start = ax.min().asfreq(self.freq, how=self.convention)\n2338 |         end = ax.max().asfreq(self.freq, how=\"end\")\n2339 |         bin_shift = 0\n2340 | \n2341 |         if isinstance(self.freq, Tick):\n2342 |             # GH 23882 & 31809: get adjusted bin edge labels with 'origin'\n2343 |             # and 'origin' support. This call only makes sense if the freq is a\n2344 |             # Tick since offset and origin are only used in those cases.\n2345 |             # Not doing this check could create an extra empty bin.\n2346 |             p_start, end = _get_period_range_edges(\n2347 |                 start,\n2348 |                 end,\n2349 |                 self.freq,\n2350 |                 closed=self.closed,\n2351 |                 origin=self.origin,\n2352 |                 offset=self.offset,\n2353 |             )\n2354 | \n2355 |             # Get offset for bin edge (not label edge) adjustment\n2356 |             start_offset = Period(start, self.freq) - Period(p_start, self.freq)\n2357 |             # error: Item \"Period\" of \"Union[Period, Any]\" has no attribute \"n\"\n2358 |             bin_shift = start_offset.n % freq_mult  # type: ignore[union-attr]\n2359 |             start = p_start\n2360 | \n2361 |         labels = binner = period_range(\n2362 |             start=start, end=end, freq=self.freq, name=ax.name\n2363 |         )\n2364 | \n2365 |         i8 = memb.asi8\n2366 | \n2367 |         # when upsampling to subperiods, we need to generate enough bins\n2368 |         expected_bins_count = len(binner) * freq_mult\n2369 |         i8_extend = expected_bins_count - (i8[-1] - i8[0])\n2370 |         rng = np.arange(i8[0], i8[-1] + i8_extend, freq_mult)\n2371 |         rng += freq_mult\n2372 |         # adjust bin edge indexes to account for base\n2373 |         rng -= bin_shift\n2374 | \n2375 |         # Wrap in PeriodArray for PeriodArray.searchsorted\n2376 |         prng = type(memb._data)(rng, dtype=memb.dtype)\n2377 |         bins = memb.searchsorted(prng, side=\"left\")\n2378 | \n2379 |         if nat_count > 0:\n2380 |             binner, bins, labels = _insert_nat_bin(binner, bins, labels, nat_count)\n2381 | \n2382 |         return binner, bins, labels\n2383 | \n2384 |     def _set_grouper(\n2385 |         self, obj: NDFrameT, sort: bool = False, *, gpr_index: Index | None = None\n2386 |     ) -> tuple[NDFrameT, Index, npt.NDArray[np.intp] | None]:\n2387 |         obj, ax, indexer = super()._set_grouper(obj, sort, gpr_index=gpr_index)\n2388 |         if isinstance(ax.dtype, ArrowDtype) and ax.dtype.kind in \"Mm\":\n2389 |             self._arrow_dtype = ax.dtype\n2390 |             ax = Index(\n2391 |                 cast(ArrowExtensionArray, ax.array)._maybe_convert_datelike_array()\n2392 |             )\n2393 |         return obj, ax, indexer\n2394 | \n2395 | \n2396 | @overload\n2397 | def _take_new_index(\n2398 |     obj: DataFrame, indexer: npt.NDArray[np.intp], new_index: Index\n2399 | ) -> DataFrame: ...\n2400 | \n2401 | \n2402 | @overload\n2403 | def _take_new_index(\n2404 |     obj: Series, indexer: npt.NDArray[np.intp], new_index: Index\n2405 | ) -> Series: ...\n2406 | \n2407 | \n2408 | def _take_new_index(\n2409 |     obj: DataFrame | Series,\n2410 |     indexer: npt.NDArray[np.intp],\n2411 |     new_index: Index,\n2412 | ) -> DataFrame | Series:\n2413 |     if isinstance(obj, ABCSeries):\n2414 |         new_values = algos.take_nd(obj._values, indexer)\n2415 |         return obj._constructor(new_values, index=new_index, name=obj.name)\n2416 |     elif isinstance(obj, ABCDataFrame):\n2417 |         new_mgr = obj._mgr.reindex_indexer(new_axis=new_index, indexer=indexer, axis=1)\n2418 |         return obj._constructor_from_mgr(new_mgr, axes=new_mgr.axes)\n2419 |     else:\n2420 |         raise ValueError(\"'obj' should be either a Series or a DataFrame\")\n2421 | \n2422 | \n2423 | def _get_timestamp_range_edges(\n2424 |     first: Timestamp,\n2425 |     last: Timestamp,\n2426 |     freq: BaseOffset,\n2427 |     unit: str,\n2428 |     closed: Literal[\"right\", \"left\"] = \"left\",\n2429 |     origin: TimeGrouperOrigin = \"start_day\",\n2430 |     offset: Timedelta | None = None,\n2431 | ) -> tuple[Timestamp, Timestamp]:\n2432 |     \"\"\"\n2433 |     Adjust the `first` Timestamp to the preceding Timestamp that resides on\n2434 |     the provided offset. Adjust the `last` Timestamp to the following\n2435 |     Timestamp that resides on the provided offset. Input Timestamps that\n2436 |     already reside on the offset will be adjusted depending on the type of\n2437 |     offset and the `closed` parameter.\n2438 | \n2439 |     Parameters\n2440 |     ----------\n2441 |     first : pd.Timestamp\n2442 |         The beginning Timestamp of the range to be adjusted.\n2443 |     last : pd.Timestamp\n2444 |         The ending Timestamp of the range to be adjusted.\n2445 |     freq : pd.DateOffset\n2446 |         The dateoffset to which the Timestamps will be adjusted.\n2447 |     closed : {'right', 'left'}, default \"left\"\n2448 |         Which side of bin interval is closed.\n2449 |     origin : {'epoch', 'start', 'start_day'} or Timestamp, default 'start_day'\n2450 |         The timestamp on which to adjust the grouping. The timezone of origin must\n2451 |         match the timezone of the index.\n2452 |         If a timestamp is not used, these values are also supported:\n2453 | \n2454 |         - 'epoch': `origin` is 1970-01-01\n2455 |         - 'start': `origin` is the first value of the timeseries\n2456 |         - 'start_day': `origin` is the first day at midnight of the timeseries\n2457 |     offset : pd.Timedelta, default is None\n2458 |         An offset timedelta added to the origin.\n2459 | \n2460 |     Returns\n2461 |     -------\n2462 |     A tuple of length 2, containing the adjusted pd.Timestamp objects.\n2463 |     \"\"\"\n2464 |     if isinstance(freq, Tick):\n2465 |         index_tz = first.tz\n2466 |         if isinstance(origin, Timestamp) and (origin.tz is None) != (index_tz is None):\n2467 |             raise ValueError(\"The origin must have the same timezone as the index.\")\n2468 |         if origin == \"epoch\":\n2469 |             # set the epoch based on the timezone to have similar bins results when\n2470 |             # resampling on the same kind of indexes on different timezones\n2471 |             origin = Timestamp(\"1970-01-01\", tz=index_tz)\n2472 | \n2473 |         if isinstance(freq, Day):\n2474 |             # _adjust_dates_anchored assumes 'D' means 24h, but first/last\n2475 |             # might contain a DST transition (23h, 24h, or 25h).\n2476 |             # So \"pretend\" the dates are naive when adjusting the endpoints\n2477 |             first = first.tz_localize(None)\n2478 |             last = last.tz_localize(None)\n2479 |             if isinstance(origin, Timestamp):\n2480 |                 origin = origin.tz_localize(None)\n2481 | \n2482 |         first, last = _adjust_dates_anchored(\n2483 |             first, last, freq, closed=closed, origin=origin, offset=offset, unit=unit\n2484 |         )\n2485 |         if isinstance(freq, Day):\n2486 |             first = first.tz_localize(index_tz)\n2487 |             last = last.tz_localize(index_tz, nonexistent=\"shift_forward\")\n2488 |     else:\n2489 |         first = first.normalize()\n2490 |         last = last.normalize()\n2491 | \n2492 |         if closed == \"left\":\n2493 |             first = Timestamp(freq.rollback(first))\n2494 |         else:\n2495 |             first = Timestamp(first - freq)\n2496 | \n2497 |         last = Timestamp(last + freq)\n2498 | \n2499 |     return first, last\n2500 | \n2501 | \n2502 | def _get_period_range_edges(\n2503 |     first: Period,\n2504 |     last: Period,\n2505 |     freq: BaseOffset,\n2506 |     closed: Literal[\"right\", \"left\"] = \"left\",\n2507 |     origin: TimeGrouperOrigin = \"start_day\",\n2508 |     offset: Timedelta | None = None,\n2509 | ) -> tuple[Period, Period]:\n2510 |     \"\"\"\n2511 |     Adjust the provided `first` and `last` Periods to the respective Period of\n2512 |     the given offset that encompasses them.\n2513 | \n2514 |     Parameters\n2515 |     ----------\n2516 |     first : pd.Period\n2517 |         The beginning Period of the range to be adjusted.\n2518 |     last : pd.Period\n2519 |         The ending Period of the range to be adjusted.\n2520 |     freq : pd.DateOffset\n2521 |         The freq to which the Periods will be adjusted.\n2522 |     closed : {'right', 'left'}, default \"left\"\n2523 |         Which side of bin interval is closed.\n2524 |     origin : {'epoch', 'start', 'start_day'}, Timestamp, default 'start_day'\n2525 |         The timestamp on which to adjust the grouping. The timezone of origin must\n2526 |         match the timezone of the index.\n2527 | \n2528 |         If a timestamp is not used, these values are also supported:\n2529 | \n2530 |         - 'epoch': `origin` is 1970-01-01\n2531 |         - 'start': `origin` is the first value of the timeseries\n2532 |         - 'start_day': `origin` is the first day at midnight of the timeseries\n2533 |     offset : pd.Timedelta, default is None\n2534 |         An offset timedelta added to the origin.\n2535 | \n2536 |     Returns\n2537 |     -------\n2538 |     A tuple of length 2, containing the adjusted pd.Period objects.\n2539 |     \"\"\"\n2540 |     if not all(isinstance(obj, Period) for obj in [first, last]):\n2541 |         raise TypeError(\"'first' and 'last' must be instances of type Period\")\n2542 | \n2543 |     # GH 23882\n2544 |     first_ts = first.to_timestamp()\n2545 |     last_ts = last.to_timestamp()\n2546 |     adjust_first = not freq.is_on_offset(first_ts)\n2547 |     adjust_last = freq.is_on_offset(last_ts)\n2548 | \n2549 |     first_ts, last_ts = _get_timestamp_range_edges(\n2550 |         first_ts, last_ts, freq, unit=\"ns\", closed=closed, origin=origin, offset=offset\n2551 |     )\n2552 | \n2553 |     first = (first_ts + int(adjust_first) * freq).to_period(freq)\n2554 |     last = (last_ts - int(adjust_last) * freq).to_period(freq)\n2555 |     return first, last\n2556 | \n2557 | \n2558 | def _insert_nat_bin(\n2559 |     binner: PeriodIndex, bins: np.ndarray, labels: PeriodIndex, nat_count: int\n2560 | ) -> tuple[PeriodIndex, np.ndarray, PeriodIndex]:\n2561 |     # NaT handling as in pandas._lib.lib.generate_bins_dt64()\n2562 |     # shift bins by the number of NaT\n2563 |     assert nat_count > 0\n2564 |     bins += nat_count\n2565 |     bins = np.insert(bins, 0, nat_count)\n2566 | \n2567 |     # Incompatible types in assignment (expression has type \"Index\", variable\n2568 |     # has type \"PeriodIndex\")\n2569 |     binner = binner.insert(0, NaT)  # type: ignore[assignment]\n2570 |     # Incompatible types in assignment (expression has type \"Index\", variable\n2571 |     # has type \"PeriodIndex\")\n2572 |     labels = labels.insert(0, NaT)  # type: ignore[assignment]\n2573 |     return binner, bins, labels\n2574 | \n2575 | \n2576 | def _adjust_dates_anchored(\n2577 |     first: Timestamp,\n2578 |     last: Timestamp,\n2579 |     freq: Tick,\n2580 |     closed: Literal[\"right\", \"left\"] = \"right\",\n2581 |     origin: TimeGrouperOrigin = \"start_day\",\n2582 |     offset: Timedelta | None = None,\n2583 |     unit: str = \"ns\",\n2584 | ) -> tuple[Timestamp, Timestamp]:\n2585 |     # First and last offsets should be calculated from the start day to fix an\n2586 |     # error cause by resampling across multiple days when a one day period is\n2587 |     # not a multiple of the frequency. See GH 8683\n2588 |     # To handle frequencies that are not multiple or divisible by a day we let\n2589 |     # the possibility to define a fixed origin timestamp. See GH 31809\n2590 |     first = first.as_unit(unit)\n2591 |     last = last.as_unit(unit)\n2592 |     if offset is not None:\n2593 |         offset = offset.as_unit(unit)\n2594 | \n2595 |     freq_value = Timedelta(freq).as_unit(unit)._value\n2596 | \n2597 |     origin_timestamp = 0  # origin == \"epoch\"\n2598 |     if origin == \"start_day\":\n2599 |         origin_timestamp = first.normalize()._value\n2600 |     elif origin == \"start\":\n2601 |         origin_timestamp = first._value\n2602 |     elif isinstance(origin, Timestamp):\n2603 |         origin_timestamp = origin.as_unit(unit)._value\n2604 |     elif origin in [\"end\", \"end_day\"]:\n2605 |         origin_last = last if origin == \"end\" else last.ceil(\"D\")\n2606 |         sub_freq_times = (origin_last._value - first._value) // freq_value\n2607 |         if closed == \"left\":\n2608 |             sub_freq_times += 1\n2609 |         first = origin_last - sub_freq_times * freq\n2610 |         origin_timestamp = first._value\n2611 |     origin_timestamp += offset._value if offset else 0\n2612 | \n2613 |     # GH 10117 & GH 19375. If first and last contain timezone information,\n2614 |     # Perform the calculation in UTC in order to avoid localizing on an\n2615 |     # Ambiguous or Nonexistent time.\n2616 |     first_tzinfo = first.tzinfo\n2617 |     last_tzinfo = last.tzinfo\n2618 |     if first_tzinfo is not None:\n2619 |         first = first.tz_convert(\"UTC\")\n2620 |     if last_tzinfo is not None:\n2621 |         last = last.tz_convert(\"UTC\")\n2622 | \n2623 |     foffset = (first._value - origin_timestamp) % freq_value\n2624 |     loffset = (last._value - origin_timestamp) % freq_value\n2625 | \n2626 |     if closed == \"right\":\n2627 |         if foffset > 0:\n2628 |             # roll back\n2629 |             fresult_int = first._value - foffset\n2630 |         else:\n2631 |             fresult_int = first._value - freq_value\n2632 | \n2633 |         if loffset > 0:\n2634 |             # roll forward\n2635 |             lresult_int = last._value + (freq_value - loffset)\n2636 |         else:\n2637 |             # already the end of the road\n2638 |             lresult_int = last._value\n2639 |     else:  # closed == 'left'\n2640 |         if foffset > 0:\n2641 |             fresult_int = first._value - foffset\n2642 |         else:\n2643 |             # start of the road\n2644 |             fresult_int = first._value\n2645 | \n2646 |         if loffset > 0:\n2647 |             # roll forward\n2648 |             lresult_int = last._value + (freq_value - loffset)\n2649 |         else:\n2650 |             lresult_int = last._value + freq_value\n2651 |     fresult = Timestamp(fresult_int, unit=unit)\n2652 |     lresult = Timestamp(lresult_int, unit=unit)\n2653 |     if first_tzinfo is not None:\n2654 |         fresult = fresult.tz_localize(\"UTC\").tz_convert(first_tzinfo)\n2655 |     if last_tzinfo is not None:\n2656 |         lresult = lresult.tz_localize(\"UTC\").tz_convert(last_tzinfo)\n2657 |     return fresult, lresult\n2658 | \n2659 | \n2660 | def asfreq(\n2661 |     obj: NDFrameT,\n2662 |     freq,\n2663 |     method=None,\n2664 |     how=None,\n2665 |     normalize: bool = False,\n2666 |     fill_value=None,\n2667 | ) -> NDFrameT:\n2668 |     \"\"\"\n2669 |     Utility frequency conversion method for Series/DataFrame.\n2670 | \n2671 |     See :meth:`pandas.NDFrame.asfreq` for full documentation.\n2672 |     \"\"\"\n2673 |     if isinstance(obj.index, PeriodIndex):\n2674 |         if method is not None:\n2675 |             raise NotImplementedError(\"'method' argument is not supported\")\n2676 | \n2677 |         if how is None:\n2678 |             how = \"E\"\n2679 | \n2680 |         if isinstance(freq, BaseOffset):\n2681 |             if hasattr(freq, \"_period_dtype_code\"):\n2682 |                 freq = PeriodDtype(freq)._freqstr\n2683 | \n2684 |         new_obj = obj.copy()\n2685 |         new_obj.index = obj.index.asfreq(freq, how=how)\n2686 | \n2687 |     elif len(obj.index) == 0:\n2688 |         new_obj = obj.copy()\n2689 | \n2690 |         new_obj.index = _asfreq_compat(obj.index, freq)\n2691 |     else:\n2692 |         unit = None\n2693 |         if isinstance(obj.index, DatetimeIndex):\n2694 |             # TODO: should we disallow non-DatetimeIndex?\n2695 |             unit = obj.index.unit\n2696 |         dti = date_range(obj.index.min(), obj.index.max(), freq=freq, unit=unit)\n2697 |         dti.name = obj.index.name\n2698 |         new_obj = obj.reindex(dti, method=method, fill_value=fill_value)\n2699 |         if normalize:\n2700 |             new_obj.index = new_obj.index.normalize()\n2701 | \n2702 |     return new_obj\n2703 | \n2704 | \n2705 | def _asfreq_compat(index: FreqIndexT, freq) -> FreqIndexT:\n2706 |     \"\"\"\n2707 |     Helper to mimic asfreq on (empty) DatetimeIndex and TimedeltaIndex.\n2708 | \n2709 |     Parameters\n2710 |     ----------\n2711 |     index : PeriodIndex, DatetimeIndex, or TimedeltaIndex\n2712 |     freq : DateOffset\n2713 | \n2714 |     Returns\n2715 |     -------\n2716 |     same type as index\n2717 |     \"\"\"\n2718 |     if len(index) != 0:\n2719 |         # This should never be reached, always checked by the caller\n2720 |         raise ValueError(\n2721 |             \"Can only set arbitrary freq for empty DatetimeIndex or TimedeltaIndex\"\n2722 |         )\n2723 |     if isinstance(index, PeriodIndex):\n2724 |         new_index = index.asfreq(freq=freq)\n2725 |     elif isinstance(index, DatetimeIndex):\n2726 |         new_index = DatetimeIndex([], dtype=index.dtype, freq=freq, name=index.name)\n2727 |     elif isinstance(index, TimedeltaIndex):\n2728 |         new_index = TimedeltaIndex([], dtype=index.dtype, freq=freq, name=index.name)\n2729 |     else:  # pragma: no cover\n2730 |         raise TypeError(type(index))\n2731 |     return new_index\n2732 | \n2733 | \n2734 | def _apply(\n2735 |     grouped: GroupBy, how: Callable, *args, include_groups: bool, **kwargs\n2736 | ) -> DataFrame:\n2737 |     # GH#7155 - rewrite warning to appear as if it came from `.resample`\n2738 |     target_message = \"DataFrameGroupBy.apply operated on the grouping columns\"\n2739 |     new_message = _apply_groupings_depr.format(\"DataFrameGroupBy\", \"resample\")\n2740 |     with rewrite_warning(\n2741 |         target_message=target_message,\n2742 |         target_category=DeprecationWarning,\n2743 |         new_message=new_message,\n2744 |     ):\n2745 |         result = grouped.apply(how, *args, include_groups=include_groups, **kwargs)\n2746 |     return result\n2747 | \n```\n"}, {"content": "Based on my analysis of the code and the issue description, I can now provide the locations that need to be updated for improving the DataFrame.interpolate() documentation. Here are the key areas:\n\n```\npandas/core/generic.py\nline: 7646-7861\nfunction: NDFrame.interpolate\n\npandas/core/missing.py\nline: 182-185\nvariable: NP_METHODS\nline: 186-201\nvariable: SP_METHODS\n\npandas/core/missing.py\nline: 311-352\nfunction: get_interp_index\n\npandas/core/missing.py\nline: 444-553\nfunction: _interpolate_1d\n\npandas/core/missing.py\nline: 556-629  \nfunction: _interpolate_scipy_wrapper\n```\n\nThese locations are ordered by importance for addressing the documentation improvement request. The main documentation for DataFrame.interpolate() is in the NDFrame.interpolate() function in generic.py. The other files contain the core implementation details that affect how the interpolation methods work, particularly:\n\n1. NP_METHODS and SP_METHODS define the distinct interpolation families\n2. get_interp_index handles the special cases for different interpolation methods\n3. _interpolate_1d implements the actual interpolation logic\n4. _interpolate_scipy_wrapper handles the integration with scipy's interpolation methods\n\nThe issue specifically mentions that the documentation needs improvement, particularly around:\n\n1. The 'time' method's behavior for daily and higher resolution data\n2. The 'index' and 'values' methods' differences\n3. The relationship between these methods and their mathematical implementations\n\nThese files together form the complete picture of how pandas' interpolation methods work internally and where the documentation should be improved to clarify these aspects.\n\n<function=finish>\n", "role": "assistant", "tool_calls": null, "function_call": null}], "tools": [{"type": "function", "function": {"name": "finish", "description": "Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task."}}, {"type": "function", "function": {"name": "search_code_snippets", "description": "Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n", "parameters": {"type": "object", "properties": {"search_terms": {"type": "array", "items": {"type": "string"}, "description": "A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search."}, "line_nums": {"type": "array", "items": {"type": "integer"}, "description": "Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search."}, "file_path_or_pattern": {"type": "string", "description": "A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.", "default": "**/*.py"}}, "required": []}}}, {"type": "function", "function": {"name": "get_entity_contents", "description": "\nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n", "parameters": {"type": "object", "properties": {"entity_names": {"type": "array", "items": {"type": "string"}, "description": "A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py')."}}, "required": ["entity_names"]}}}], "usage": {"prompt_tokens": 135840, "completion_tokens": 587}, "time": 128.93561697006226}]}}
{"instance_id": "matplotlib__matplotlib-29265", "found_files": [["lib/matplotlib/collections.py"]], "found_modules": [["lib/matplotlib/widgets.py:RadioButtons", "lib/matplotlib/collections.py:LineCollection", "lib/matplotlib/patches.py:Ellipse", "lib/matplotlib/ticker.py:PercentFormatter", "lib/matplotlib/animation.py:FuncAnimation"]], "found_entities": [["lib/matplotlib/widgets.py:RadioButtons._clear", "lib/matplotlib/collections.py:LineCollection.set_segments", "lib/matplotlib/patches.py:Ellipse.get_path", "lib/matplotlib/collections.py:LineCollection.get_color", "lib/matplotlib/ticker.py:PercentFormatter.convert_to_pct", "lib/matplotlib/collections.py:LineCollection.get_segments", "lib/matplotlib/animation.py:FuncAnimation.new_frame_seq"]], "raw_output_loc": ["After analyzing the issue and the code, I can now provide the locations that need to be modified to implement the requested documentation improvement for LineCollection's docstring. Here's the result:\n\n```\nlib/matplotlib/collections.py\nline: 1614\nline: 1619\nline: 1622\nline: 1623\nclass: LineCollection\nfunction: __init__\n\nlib/matplotlib/collections.py\nline: 1656\nline: 1657\nline: 1658\nline: 1659\nclass: LineCollection\nfunction: set_segments\n\nlib/matplotlib/collections.py\nline: 1664\nline: 1665\nline: 1666\nline: 1667\nline: 1668\nclass: LineCollection\nfunction: get_segments\n\nlib/matplotlib/collections.py\nline: 1721\nline: 1722\nclass: LineCollection\nfunction: get_color\n```\n\nThese locations are selected because:\n1. The main docstring for LineCollection is located in the `__init__` method (lines 1614-1623), where the current documentation about segments format needs to be updated.\n\n2. The `set_segments` method (lines 1656-1659) is crucial as it handles the conversion of input segments into Path objects, which is directly related to the requested docstring changes.\n\n3. The `get_segments` method (lines 1664-1668) confirms the current implementation approach of storing segments as a list of paths.\n\n4. The `get_color` method (lines 1721-1722) shows the pattern for consistent documentation throughout the class.\n\nThe primary focus should be on the docstring in the `__init__` method, but the other locations are included as they provide important context about how the segments are handled and stored internally, which helps ensure consistency in the documentation throughout the class."], "meta_data": {"repo": "matplotlib/matplotlib", "base_commit": "0406a56b051a371ccf81d2946126580651a645f2", "problem_statement": "Improve LineCollection docstring further\n              (M, 2)\r\n\r\nI would perhaps completely drop the \"list of points\" and just write\r\n```\r\nA sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\r\narray-like of points::\r\n\r\n    line0 = [(x0, y0), (x1, y1), ...]\r\n\r\nEach line can...\r\n```\r\n\r\n_Originally posted by @anntzer in https://github.com/matplotlib/matplotlib/pull/26676#discussion_r1313026557_\r\n\r\n\r\n            \n", "patch": "diff --git a/lib/matplotlib/collections.py b/lib/matplotlib/collections.py\nindex a78f1838357e..f18d5a4c3a8c 100644\n--- a/lib/matplotlib/collections.py\n+++ b/lib/matplotlib/collections.py\n@@ -1612,14 +1612,13 @@ def __init__(self, segments,  # Can be None.\n         \"\"\"\n         Parameters\n         ----------\n-        segments : list of array-like\n-            A sequence (*line0*, *line1*, *line2*) of lines, where each line is a list\n-            of points::\n+        segments : list of (N, 2) array-like\n+            A sequence ``[line0, line1, ...]`` where each line is a (N, 2)-shape\n+            array-like containing points::\n \n-                lineN = [(x0, y0), (x1, y1), ... (xm, ym)]\n+                line0 = [(x0, y0), (x1, y1), ...]\n \n-            or the equivalent Mx2 numpy array with two columns. Each line\n-            can have a different number of segments.\n+            Each line can contain a different number of points.\n         linewidths : float or list of float, default: :rc:`lines.linewidth`\n             The width of each line in points.\n         colors : :mpltype:`color` or list of color, default: :rc:`lines.color`\n"}, "usage": {"cost($)": "0", "prompt_tokens": 37573, "completion_tokens": 546}, "loc_trajs": {"trajs": [{"messages": [{"role": "system", "content": "A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed answers to the user's questions.\nThe assistant can use a Python environment with <execute_ipython>, e.g.:\n<execute_ipython>\nprint(\"Hello World!\")\n</execute_ipython>\n\nApart from the standard Python library, the assistant can also use the following functions (already imported) in <execute_ipython> environment:\nsearch_code_snippets(search_terms: Optional[List[str]] = None, line_nums: Optional[List] = None, file_path_or_pattern: Optional[str] = '**/*.py') -> str:\n    Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n    This function supports retrieving the complete content of a code entity,\n    searching for code entities such as classes or functions by keywords, or locating specific lines within a file.\n    It also supports filtering searches based on a file path or file pattern.\n    Note:\n    1. If `search_terms` are provided, it searches for code snippets based on each term:\n    - If a term is formatted as 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') ,\n    or just 'file_path', the corresponding complete code is retrieved or file content is retrieved.\n    - If a term matches a file, class, or function name, matched entities are retrieved.\n    - If there is no match with any module name, it attempts to find code snippets that likely contain the term.\n    2. If `line_nums` is provided, it searches for code snippets at the specified lines within the file defined by\n    `file_path_or_pattern`.\n    Args:\n    search_terms (Optional[List[str]]): A list of names, keywords, or code snippets to search for within the codebase.\n    Terms can be formatted as 'file_path:QualifiedName' to search for a specific module or entity within a file\n    (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum') or as 'file_path' to retrieve the complete content\n    of a file. This can also include potential function names, class names, or general code fragments.\n    line_nums (Optional[List[int]]): Specific line numbers to locate code snippets within a specified file.\n    When provided, `file_path_or_pattern` must specify a valid file path.\n    file_path_or_pattern (Optional[str]): A glob pattern or specific file path used to filter search results\n    to particular files or directories. Defaults to '**/*.py', meaning all Python files are searched by default.\n    If `line_nums` are provided, this must specify a specific file path.\n    Returns:\n    str: The search results, which may include code snippets, matching entities, or complete file content.\n    Example Usage:\n    # Search for the full content of a specific file\n    result = search_code_snippets(search_terms=['src/my_file.py'])\n    # Search for a specific function\n    result = search_code_snippets(search_terms=['src/my_file.py:MyClass.func_name'])\n    # Search for specific lines (10 and 15) within a file\n    result = search_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n    # Combined search for a module name and within a specific file pattern\n    result = search_code_snippets(search_terms=[\"MyClass\"], file_path_or_pattern=\"src/**/*.py\")\n\n\nFunction Usage Guidelines:\n- Issue Analysis and Retrieval: Begin by analyzing the issue and extracting relevant information for retrieval. Use the functions `search_in_repo` to gather more insights about the issue.\n- Accessing Files and Code: Use `get_file_structures` or `search_class_structures` to gain an overview of the files or classes; Call `get_file_content` to access the content of specific file relevant to the issue, and employ `search_class` or `search_method` to retrieve specific modules when you know the specific names of these modules.\n\n- Repository Overview: Use `get_repo_structure` to gain an overview of the repository. This aids in independently searching for related files or analyzing results from previous steps. However, this tool is relatively expensive, use other tools to search files, classes or methods if you know their potential names.\n- File Limitations: You may search as many files as necessary, but make sure not include noise.\n- Exclusions: Do not include any existing test case files in your findings.\n- Evaluate and prioritize findings from different search methods, reranking the answer when you give final output.\nIMPORTANT:\n- Parameter Accuracy: Ensure that the parameters used for each tool call are accurate, avoiding assumptions.\n\nResponses should be concise.\nThe assistant should attempt fewer things at a time instead of putting too many commands OR too much code in one \"execute\" block.\nInclude ONLY ONE <execute_ipython> per response, unless the assistant is finished with the task or needs more input or action from the user in order to proceed.\nIf the assistant is finished with the task you MUST include <finish></finish> in your response.\nIMPORTANT: Execute code using <execute_ipython> whenever possible.\nThe assistant should utilize full file paths to prevent path-related errors.\nThe assistant must avoid apologies and thanks in its responses.\nYou have access to the following functions:\n\n---- BEGIN FUNCTION #1: finish ----\nDescription: Finish the interaction when the task is complete OR if the assistant cannot proceed further with the task.\nNo parameters are required for this function.\n---- END FUNCTION #1 ----\n\n---- BEGIN FUNCTION #2: search_code_snippets ----\nDescription: Searches the codebase to retrieve relevant code snippets based on given queries(terms or line numbers).\n** Note:\n- Either `search_terms` or `line_nums` must be provided to perform a search.\n- If `search_terms` are provided, it searches for code snippets based on each term:\n- If `line_nums` is provided, it searches for code snippets around the specified lines within the file defined by `file_path_or_pattern`.\n\n** Example Usage:\n# Search for code content contain keyword `order`, `bill`\nsearch_code_snippets(search_terms=[\"order\", \"bill\"])\n\n# Search for a class\nsearch_code_snippets(search_terms=[\"MyClass\"])\n\n# Search for context around specific lines (10 and 15) within a file\nsearch_code_snippets(line_nums=[10, 15], file_path_or_pattern='src/example.py')\n\nParameters:\n  (1) search_terms (array, optional): A list of names, keywords, or code snippets to search for within the codebase. This can include potential function names, class names, or general code fragments. Either `search_terms` or `line_nums` must be provided to perform a search.\n  (2) line_nums (array, optional): Specific line numbers to locate code snippets within a specified file. Must be used alongside a valid `file_path_or_pattern`. Either `line_nums` or `search_terms` must be provided to perform a search.\n  (3) file_path_or_pattern (string, optional): A glob pattern or specific file path used to filter search results to particular files or directories. Defaults to \"**/*.py\", meaning all Python files are searched by default. If `line_nums` are provided, this must specify a specific file path.\n---- END FUNCTION #2 ----\n\n---- BEGIN FUNCTION #3: get_entity_contents ----\nDescription: \nSearches the codebase to retrieve the complete implementations of specified entities based on the provided entity names. \nThe tool can handle specific entity queries such as function names, class names, or file paths.\n\n**Usage Example:**\n# Search for a specific function implementation\nget_entity_contents(['src/my_file.py:MyClass.func_name'])\n\n# Search for a file's complete content\nget_entity_contents(['src/my_file.py'])\n\n**Entity Name Format:**\n- To specify a function or class, use the format: `file_path:QualifiedName`\n  (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum').\n- To search for a file's content, use only the file path (e.g., 'src/my_file.py').\n\nParameters:\n  (1) entity_names (array, required): A list of entity names to query. Each entity name can represent a function, class, or file. For functions or classes, the format should be 'file_path:QualifiedName' (e.g., 'src/helpers/math_helpers.py:MathUtils.calculate_sum'). For files, use just the file path (e.g., 'src/my_file.py').\n---- END FUNCTION #3 ----\n\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<function=example_function_name>\n<parameter=example_parameter_1>value_1</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format, start with <function= and end with </function>\n- Required parameters MUST be specified\n- Only call one function at a time\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after.\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"}, {"role": "user", "content": "\nGiven the following GitHub issue description, your objective is to localize the specific files, classes or functions, and lines of code that are relevant to the solution for the issue. More specifically, these issues are all \"feature request\" issues, which means that you need to find the locations the feature described in the issue.\n\nFollow these steps to localize the issue:\n## Step 1: Categorize and Extract Key Problem Information\n - Classify the issue description into the following categories:\n    Requested feature description, behavior with out this feature, expected behavior with the feature, and additional context.\n - Identify modules in the 'matplotlib' package mentioned in each category.\n - Use extracted keywords and line numbers to search for relevant code references for additional context.\n\n## Step 2: Locate Referenced Modules\n- Accurately determine specific modules\n    - Explore the repo to familiarize yourself with its structure.\n    - Analyze the described workflow to identify specific modules or components being referenced.\n- Pay special attention to distinguishing between modules with similar names using context and described workflow.\n- Output Format for collected relevant modules:\n    - Use the format: 'file_path:QualifiedName'\n    - E.g., for a function `calculate_sum` in the `MathUtils` class located in `src/helpers/math_helpers.py`, represent it as: 'src/helpers/math_helpers.py:MathUtils.calculate_sum'.\n\n## Step 3: Analyze the feature\n- Understand the Purpose of the Feature in the Context of the Codebase\n    - Understand what the feature is supposed to do.\n    - Understand why it is needed.\n    - Understand how it fits into the overall functionality of the codebase.\n- Analyze the Feature's Relationship with the Codebase\n    - Identify the key affected components of the feature.\n    - Understand how these components interact with each other and with existing code.\n    - Consider the inputs, outputs, and side effects of the feature.\n\n## Step 4: Locate Areas for Feature Implementation\n- Locate specific files, functions, or lines of code implementing the key part of the requested feature or containing critical information for resolving the issue.\n\n- Think Thoroughly: List multiple potential solutions and consider edge cases that could impact the resolution.\n\n## Output Format for Final Results:\nYour final output should list the locations requiring modification, wrapped with triple backticks ```\nEach location should