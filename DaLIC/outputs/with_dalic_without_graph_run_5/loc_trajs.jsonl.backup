       f\" expected {length}\"\n  61 |             )\n  62 |         value = value[mask]\n  63 | \n  64 |     return value\n  65 | \n  66 | \n  67 | def mask_missing(arr: ArrayLike, values_to_mask) -> npt.NDArray[np.bool_]:\n  68 |     \"\"\"\n  69 |     Return a masking array of same size/shape as arr\n  70 |     with entries equaling any member of values_to_mask set to True\n  71 | \n  72 |     Parameters\n  73 |     ----------\n  74 |     arr : ArrayLike\n  75 |     values_to_mask: list, tuple, or scalar\n  76 | \n  77 |     Returns\n  78 |     -------\n  79 |     np.ndarray[bool]\n  80 |     \"\"\"\n  81 |     # When called from Block.replace/replace_list, values_to_mask is a scalar\n  82 |     #  known to be holdable by arr.\n  83 |     # When called from Series._single_replace, values_to_mask is tuple or list\n  84 |     dtype, values_to_mask = infer_dtype_from(values_to_mask)\n  85 | \n  86 |     if isinstance(dtype, np.dtype):\n  87 |         values_to_mask = np.array(values_to_mask, dtype=dtype)\n  88 |     else:\n  89 |         cls = dtype.construct_array_type()\n  90 |         if not lib.is_list_like(values_to_mask):\n  91 |             values_to_mask = [values_to_mask]\n  92 |         values_to_mask = cls._from_sequence(values_to_mask, dtype=dtype, copy=False)\n  93 | \n  94 |     potential_na = False\n  95 |     if is_object_dtype(arr.dtype):\n  96 |         # pre-compute mask to avoid comparison to NA\n  97 |         potential_na = True\n  98 |         arr_mask = ~isna(arr)\n  99 | \n 100 |     na_mask = isna(values_to_mask)\n 101 |     nonna = values_to_mask[~na_mask]\n 102 | \n 103 |     # GH 21977\n 104 |     mask = np.zeros(arr.shape, dtype=bool)\n 105 |     if (\n 106 |         is_numeric_dtype(arr.dtype)\n 107 |         and not is_bool_dtype(arr.dtype)\n 108 |         and is_bool_dtype(nonna.dtype)\n 109 |     ):\n 110 |         pass\n 111 |     elif (\n 112 |         is_bool_dtype(arr.dtype)\n 113 |         and is_numeric_dtype(nonna.dtype)\n 114 |         and not is_bool_dtype(nonna.dtype)\n 115 |     ):\n 116 |         pass\n 117 |     else:\n 118 |         for x in nonna:\n 119 |             if is_numeric_v_string_like(arr, x):\n 120 |                 # GH#29553 prevent numpy deprecation warnings\n 121 |                 pass\n 122 |             else:\n 123 |                 if potential_na:\n 124 |                     new_mask = np.zeros(arr.shape, dtype=np.bool_)\n 125 |                     new_mask[arr_mask] = arr[arr_mask] == x\n 126 |                 else:\n 127 |                     new_mask = arr == x\n 128 | \n 129 |                     if not isinstance(new_mask, np.ndarray):\n 130 |                         # usually BooleanArray\n 131 |                         new_mask = new_mask.to_numpy(dtype=bool, na_value=False)\n 132 |                 mask |= new_mask\n 133 | \n 134 |     if na_mask.any():\n 135 |         mask |= isna(arr)\n 136 | \n 137 |     return mask\n 138 | \n 139 | \n 140 | @overload\n 141 | def clean_fill_method(\n 142 |     method: Literal[\"ffill\", \"pad\", \"bfill\", \"backfill\"],\n 143 |     *,\n 144 |     allow_nearest: Literal[False] = ...,\n 145 | ) -> Literal[\"pad\", \"backfill\"]: ...\n 146 | \n 147 | \n 148 | @overload\n 149 | def clean_fill_method(\n 150 |     method: Literal[\"ffill\", \"pad\", \"bfill\", \"backfill\", \"nearest\"],\n 151 |     *,\n 152 |     allow_nearest: Literal[True],\n 153 | ) -> Literal[\"pad\", \"backfill\", \"nearest\"]: ...\n 154 | \n 155 | \n 156 | def clean_fill_method(\n 157 |     method: Literal[\"ffill\", \"pad\", \"bfill\", \"backfill\", \"nearest\"],\n 158 |     *,\n 159 |     allow_nearest: bool = False,\n 160 | ) -> Literal[\"pad\", \"backfill\", \"nearest\"]:\n 161 |     if isinstance(method, str):\n 162 |         # error: Incompatible types in assignment (expression has type \"str\", variable\n 163 |         # has type \"Literal['ffill', 'pad', 'bfill', 'backfill', 'nearest']\")\n 164 |         method = method.lower()  # type: ignore[assignment]\n 165 |         if method == \"ffill\":\n 166 |             method = \"pad\"\n 167 |         elif method == \"bfill\":\n 168 |             method = \"backfill\"\n 169 | \n 170 |     valid_methods = [\"pad\", \"backfill\"]\n 171 |     expecting = \"pad (ffill) or backfill (bfill)\"\n 172 |     if allow_nearest:\n 173 |         valid_methods.append(\"nearest\")\n 174 |         expecting = \"pad (ffill), backfill (bfill) or nearest\"\n 175 |     if method not in valid_methods:\n 176 |         raise ValueError(f\"Invalid fill method. Expecting {expecting}. Got {method}\")\n 177 |     return method\n 178 | \n 179 | \n 180 | # interpolation methods that dispatch to np.interp\n 181 | \n 182 | NP_METHODS = [\"linear\", \"time\", \"index\", \"values\"]\n 183 | \n 184 | # interpolation methods that dispatch to _interpolate_scipy_wrapper\n 185 | \n 186 | SP_METHODS = [\n 187 |     \"nearest\",\n 188 |     \"zero\",\n 189 |     \"slinear\",\n 190 |     \"quadratic\",\n 191 |     \"cubic\",\n 192 |     \"barycentric\",\n 193 |     \"krogh\",\n 194 |     \"spline\",\n 195 |     \"polynomial\",\n 196 |     \"from_derivatives\",\n 197 |     \"piecewise_polynomial\",\n 198 |     \"pchip\",\n 199 |     \"akima\",\n 200 |     \"cubicspline\",\n 201 | ]\n 202 | \n 203 | \n 204 | def clean_interp_method(method: str, index: Index, **kwargs) -> str:\n 205 |     order = kwargs.get(\"order\")\n 206 | \n 207 |     if method in (\"spline\", \"polynomial\") and order is None:\n 208 |         raise ValueError(\"You must specify the order of the spline or polynomial.\")\n 209 | \n 210 |     valid = NP_METHODS + SP_METHODS\n 211 |     if method not in valid:\n 212 |         raise ValueError(f\"method must be one of {valid}. Got '{method}' instead.\")\n 213 | \n 214 |     if method in (\"krogh\", \"piecewise_polynomial\", \"pchip\"):\n 215 |         if not index.is_monotonic_increasing:\n 216 |             raise ValueError(\n 217 |                 f\"{method} interpolation requires that the index be monotonic.\"\n 218 |             )\n 219 | \n 220 |     return method\n 221 | \n 222 | \n 223 | def find_valid_index(how: str, is_valid: npt.NDArray[np.bool_]) -> int | None:\n 224 |     \"\"\"\n 225 |     Retrieves the positional index of the first valid value.\n 226 | \n 227 |     Parameters\n 228 |     ----------\n 229 |     how : {'first', 'last'}\n 230 |         Use this parameter to change between the first or last valid index.\n 231 |     is_valid: np.ndarray\n 232 |         Mask to find na_values.\n 233 | \n 234 |     Returns\n 235 |     -------\n 236 |     int or None\n 237 |     \"\"\"\n 238 |     assert how in [\"first\", \"last\"]\n 239 | \n 240 |     if len(is_valid) == 0:  # early stop\n 241 |         return None\n 242 | \n 243 |     if is_valid.ndim == 2:\n 244 |         is_valid = is_valid.any(axis=1)  # reduce axis 1\n 245 | \n 246 |     if how == \"first\":\n 247 |         idxpos = is_valid[::].argmax()\n 248 | \n 249 |     elif how == \"last\":\n 250 |         idxpos = len(is_valid) - 1 - is_valid[::-1].argmax()\n 251 | \n 252 |     chk_notna = is_valid[idxpos]\n 253 | \n 254 |     if not chk_notna:\n 255 |         return None\n 256 |     # Incompatible return value type (got \"signedinteger[Any]\",\n 257 |     # expected \"Optional[int]\")\n 258 |     return idxpos  # type: ignore[return-value]\n 259 | \n 260 | \n 261 | def validate_limit_direction(\n 262 |     limit_direction: str,\n 263 | ) -> Literal[\"forward\", \"backward\", \"both\"]:\n 264 |     valid_limit_directions = [\"forward\", \"backward\", \"both\"]\n 265 |     limit_direction = limit_direction.lower()\n 266 |     if limit_direction not in valid_limit_directions:\n 267 |         raise ValueError(\n 268 |             \"Invalid limit_direction: expecting one of \"\n 269 |             f\"{valid_limit_directions}, got '{limit_direction}'.\"\n 270 |         )\n 271 |     # error: Incompatible return value type (got \"str\", expected\n 272 |     # \"Literal['forward', 'backward', 'both']\")\n 273 |     return limit_direction  # type: ignore[return-value]\n 274 | \n 275 | \n 276 | def validate_limit_area(limit_area: str | None) -> Literal[\"inside\", \"outside\"] | None:\n 277 |     if limit_area is not None:\n 278 |         valid_limit_areas = [\"inside\", \"outside\"]\n 279 |         limit_area = limit_area.lower()\n 280 |         if limit_area not in valid_limit_areas:\n 281 |             raise ValueError(\n 282 |                 f\"Invalid limit_area: expecting one of {valid_limit_areas}, got \"\n 283 |                 f\"{limit_area}.\"\n 284 |             )\n 285 |     # error: Incompatible return value type (got \"Optional[str]\", expected\n 286 |     # \"Optional[Literal['inside', 'outside']]\")\n 287 |     return limit_area  # type: ignore[return-value]\n 288 | \n 289 | \n 290 | def infer_limit_direction(\n 291 |     limit_direction: Literal[\"backward\", \"forward\", \"both\"] | None, method: str\n 292 | ) -> Literal[\"backward\", \"forward\", \"both\"]:\n 293 |     # Set `limit_direction` depending on `method`\n 294 |     if limit_direction is None:\n 295 |         if method in (\"backfill\", \"bfill\"):\n 296 |             limit_direction = \"backward\"\n 297 |         else:\n 298 |             limit_direction = \"forward\"\n 299 |     else:\n 300 |         if method in (\"pad\", \"ffill\") and limit_direction != \"forward\":\n 301 |             raise ValueError(\n 302 |                 f\"`limit_direction` must be 'forward' for method `{method}`\"\n 303 |             )\n 304 |         if method in (\"backfill\", \"bfill\") and limit_direction != \"backward\":\n 305 |             raise ValueError(\n 306 |                 f\"`limit_direction` must be 'backward' for method `{method}`\"\n 307 |             )\n 308 |     return limit_direction\n 309 | \n 310 | \n 311 | def get_interp_index(method, index: Index) -> Index:\n 312 |     # create/use the index\n 313 |     if method == \"linear\":\n 314 |         # prior default\n 315 |         from pandas import Index\n 316 | \n 317 |         if isinstance(index.dtype, DatetimeTZDtype) or lib.is_np_dtype(\n 318 |             index.dtype, \"mM\"\n 319 |         ):\n 320 |             # Convert datetime-like indexes to int64\n 321 |             index = Index(index.view(\"i8\"))\n 322 | \n 323 |         elif not is_numeric_dtype(index.dtype):\n 324 |             # We keep behavior consistent with prior versions of pandas for\n 325 |             # non-numeric, non-datetime indexes\n 326 |             index = Index(range(len(index)))\n 327 |     else:\n 328 |         methods = {\"index\", \"values\", \"nearest\", \"time\"}\n 329 |         is_numeric_or_datetime = (\n 330 |             is_numeric_dtype(index.dtype)\n 331 |             or isinstance(index.dtype, DatetimeTZDtype)\n 332 |             or lib.is_np_dtype(index.dtype, \"mM\")\n 333 |         )\n 334 |         valid = NP_METHODS + SP_METHODS\n 335 |         if method in valid:\n 336 |             if method not in methods and not is_numeric_or_datetime:\n 337 |                 raise ValueError(\n 338 |                     \"Index column must be numeric or datetime type when \"\n 339 |                     f\"using {method} method other than linear. \"\n 340 |                     \"Try setting a numeric or datetime index column before \"\n 341 |                     \"interpolating.\"\n 342 |                 )\n 343 |         else:\n 344 |             raise ValueError(f\"Can not interpolate with method={method}.\")\n 345 | \n 346 |     if isna(index).any():\n 347 |         raise NotImplementedError(\n 348 |             \"Interpolation with NaNs in the index \"\n 349 |             \"has not been implemented. Try filling \"\n 350 |             \"those NaNs before interpolating.\"\n 351 |         )\n 352 |     return index\n 353 | \n 354 | \n 355 | def interpolate_2d_inplace(\n 356 |     data: np.ndarray,  # floating dtype\n 357 |     index: Index,\n 358 |     axis: AxisInt,\n 359 |     method: str = \"linear\",\n 360 |     limit: int | None = None,\n 361 |     limit_direction: str = \"forward\",\n 362 |     limit_area: str | None = None,\n 363 |     fill_value: Any | None = None,\n 364 |     mask=None,\n 365 |     **kwargs,\n 366 | ) -> None:\n 367 |     \"\"\"\n 368 |     Column-wise application of _interpolate_1d.\n 369 | \n 370 |     Notes\n 371 |     -----\n 372 |     Alters 'data' in-place.\n 373 | \n 374 |     The signature does differ from _interpolate_1d because it only\n 375 |     includes what is needed for Block.interpolate.\n 376 |     \"\"\"\n 377 |     # validate the interp method\n 378 |     clean_interp_method(method, index, **kwargs)\n 379 | \n 380 |     if is_valid_na_for_dtype(fill_value, data.dtype):\n 381 |         fill_value = na_value_for_dtype(data.dtype, compat=False)\n 382 | \n 383 |     if method == \"time\":\n 384 |         if not needs_i8_conversion(index.dtype):\n 385 |             raise ValueError(\n 386 |                 \"time-weighted interpolation only works \"\n 387 |                 \"on Series or DataFrames with a \"\n 388 |                 \"DatetimeIndex\"\n 389 |             )\n 390 |         method = \"values\"\n 391 | \n 392 |     limit_direction = validate_limit_direction(limit_direction)\n 393 |     limit_area_validated = validate_limit_area(limit_area)\n 394 | \n 395 |     # default limit is unlimited GH #16282\n 396 |     limit = algos.validate_limit(nobs=None, limit=limit)\n 397 | \n 398 |     indices = _index_to_interp_indices(index, method)\n 399 | \n 400 |     def func(yvalues: np.ndarray) -> None:\n 401 |         # process 1-d slices in the axis direction\n 402 | \n 403 |         _interpolate_1d(\n 404 |             indices=indices,\n 405 |             yvalues=yvalues,\n 406 |             method=method,\n 407 |             limit=limit,\n 408 |             limit_direction=limit_direction,\n 409 |             limit_area=limit_area_validated,\n 410 |             fill_value=fill_value,\n 411 |             bounds_error=False,\n 412 |             mask=mask,\n 413 |             **kwargs,\n 414 |         )\n 415 | \n 416 |     # error: No overload variant of \"apply_along_axis\" matches\n 417 |     # argument types \"Callable[[ndarray[Any, Any]], None]\",\n 418 |     # \"int\", \"ndarray[Any, Any]\"\n 419 |     np.apply_along_axis(func, axis, data)  # type: ignore[call-overload]\n 420 | \n 421 | \n 422 | def _index_to_interp_indices(index: Index, method: str) -> np.ndarray:\n 423 |     \"\"\"\n 424 |     Convert Index to ndarray of indices to pass to NumPy/SciPy.\n 425 |     \"\"\"\n 426 |     xarr = index._values\n 427 |     if needs_i8_conversion(xarr.dtype):\n 428 |         # GH#1646 for dt64tz\n 429 |         xarr = xarr.view(\"i8\")\n 430 | \n 431 |     if method == \"linear\":\n 432 |         inds = xarr\n 433 |         inds = cast(np.ndarray, inds)\n 434 |     else:\n 435 |         inds = np.asarray(xarr)\n 436 | \n 437 |         if method in (\"values\", \"index\"):\n 438 |             if inds.dtype == np.object_:\n 439 |                 inds = lib.maybe_convert_objects(inds)\n 440 | \n 441 |     return inds\n 442 | \n 443 | \n 444 | def _interpolate_1d(\n 445 |     indices: np.ndarray,\n 446 |     yvalues: np.ndarray,\n 447 |     method: str = \"linear\",\n 448 |     limit: int | None = None,\n 449 |     limit_direction: str = \"forward\",\n 450 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 451 |     fill_value: Any | None = None,\n 452 |     bounds_error: bool = False,\n 453 |     order: int | None = None,\n 454 |     mask=None,\n 455 |     **kwargs,\n 456 | ) -> None:\n 457 |     \"\"\"\n 458 |     Logic for the 1-d interpolation.  The input\n 459 |     indices and yvalues will each be 1-d arrays of the same length.\n 460 | \n 461 |     Bounds_error is currently hardcoded to False since non-scipy ones don't\n 462 |     take it as an argument.\n 463 | \n 464 |     Notes\n 465 |     -----\n 466 |     Fills 'yvalues' in-place.\n 467 |     \"\"\"\n 468 |     if mask is not None:\n 469 |         invalid = mask\n 470 |     else:\n 471 |         invalid = isna(yvalues)\n 472 |     valid = ~invalid\n 473 | \n 474 |     if not valid.any():\n 475 |         return\n 476 | \n 477 |     if valid.all():\n 478 |         return\n 479 | \n 480 |     # These index pointers to invalid values... i.e. {0, 1, etc...\n 481 |     all_nans = np.flatnonzero(invalid)\n 482 | \n 483 |     first_valid_index = find_valid_index(how=\"first\", is_valid=valid)\n 484 |     if first_valid_index is None:  # no nan found in start\n 485 |         first_valid_index = 0\n 486 |     start_nans = np.arange(first_valid_index)\n 487 | \n 488 |     last_valid_index = find_valid_index(how=\"last\", is_valid=valid)\n 489 |     if last_valid_index is None:  # no nan found in end\n 490 |         last_valid_index = len(yvalues)\n 491 |     end_nans = np.arange(1 + last_valid_index, len(valid))\n 492 | \n 493 |     # preserve_nans contains indices of invalid values,\n 494 |     # but in this case, it is the final set of indices that need to be\n 495 |     # preserved as NaN after the interpolation.\n 496 | \n 497 |     # For example if limit_direction='forward' then preserve_nans will\n 498 |     # contain indices of NaNs at the beginning of the series, and NaNs that\n 499 |     # are more than 'limit' away from the prior non-NaN.\n 500 | \n 501 |     # set preserve_nans based on direction using _interp_limit\n 502 |     if limit_direction == \"forward\":\n 503 |         preserve_nans = np.union1d(start_nans, _interp_limit(invalid, limit, 0))\n 504 |     elif limit_direction == \"backward\":\n 505 |         preserve_nans = np.union1d(end_nans, _interp_limit(invalid, 0, limit))\n 506 |     else:\n 507 |         # both directions... just use _interp_limit\n 508 |         preserve_nans = np.unique(_interp_limit(invalid, limit, limit))\n 509 | \n 510 |     # if limit_area is set, add either mid or outside indices\n 511 |     # to preserve_nans GH #16284\n 512 |     if limit_area == \"inside\":\n 513 |         # preserve NaNs on the outside\n 514 |         preserve_nans = np.union1d(preserve_nans, start_nans)\n 515 |         preserve_nans = np.union1d(preserve_nans, end_nans)\n 516 |     elif limit_area == \"outside\":\n 517 |         # preserve NaNs on the inside\n 518 |         mid_nans = np.setdiff1d(all_nans, start_nans, assume_unique=True)\n 519 |         mid_nans = np.setdiff1d(mid_nans, end_nans, assume_unique=True)\n 520 |         preserve_nans = np.union1d(preserve_nans, mid_nans)\n 521 | \n 522 |     is_datetimelike = yvalues.dtype.kind in \"mM\"\n 523 | \n 524 |     if is_datetimelike:\n 525 |         yvalues = yvalues.view(\"i8\")\n 526 | \n 527 |     if method in NP_METHODS:\n 528 |         # np.interp requires sorted X values, #21037\n 529 | \n 530 |         indexer = np.argsort(indices[valid])\n 531 |         yvalues[invalid] = np.interp(\n 532 |             indices[invalid], indices[valid][indexer], yvalues[valid][indexer]\n 533 |         )\n 534 |     else:\n 535 |         yvalues[invalid] = _interpolate_scipy_wrapper(\n 536 |             indices[valid],\n 537 |             yvalues[valid],\n 538 |             indices[invalid],\n 539 |             method=method,\n 540 |             fill_value=fill_value,\n 541 |             bounds_error=bounds_error,\n 542 |             order=order,\n 543 |             **kwargs,\n 544 |         )\n 545 | \n 546 |     if mask is not None:\n 547 |         mask[:] = False\n 548 |         mask[preserve_nans] = True\n 549 |     elif is_datetimelike:\n 550 |         yvalues[preserve_nans] = NaT.value\n 551 |     else:\n 552 |         yvalues[preserve_nans] = np.nan\n 553 |     return\n 554 | \n 555 | \n 556 | def _interpolate_scipy_wrapper(\n 557 |     x: np.ndarray,\n 558 |     y: np.ndarray,\n 559 |     new_x: np.ndarray,\n 560 |     method: str,\n 561 |     fill_value=None,\n 562 |     bounds_error: bool = False,\n 563 |     order=None,\n 564 |     **kwargs,\n 565 | ):\n 566 |     \"\"\"\n 567 |     Passed off to scipy.interpolate.interp1d. method is scipy's kind.\n 568 |     Returns an array interpolated at new_x.  Add any new methods to\n 569 |     the list in _clean_interp_method.\n 570 |     \"\"\"\n 571 |     extra = f\"{method} interpolation requires SciPy.\"\n 572 |     import_optional_dependency(\"scipy\", extra=extra)\n 573 |     from scipy import interpolate\n 574 | \n 575 |     new_x = np.asarray(new_x)\n 576 | \n 577 |     # ignores some kwargs that could be passed along.\n 578 |     alt_methods = {\n 579 |         \"barycentric\": interpolate.barycentric_interpolate,\n 580 |         \"krogh\": interpolate.krogh_interpolate,\n 581 |         \"from_derivatives\": _from_derivatives,\n 582 |         \"piecewise_polynomial\": _from_derivatives,\n 583 |         \"cubicspline\": _cubicspline_interpolate,\n 584 |         \"akima\": _akima_interpolate,\n 585 |         \"pchip\": interpolate.pchip_interpolate,\n 586 |     }\n 587 | \n 588 |     interp1d_methods = [\n 589 |         \"nearest\",\n 590 |         \"zero\",\n 591 |         \"slinear\",\n 592 |         \"quadratic\",\n 593 |         \"cubic\",\n 594 |         \"polynomial\",\n 595 |     ]\n 596 |     if method in interp1d_methods:\n 597 |         if method == \"polynomial\":\n 598 |             kind = order\n 599 |         else:\n 600 |             kind = method\n 601 |         terp = interpolate.interp1d(\n 602 |             x, y, kind=kind, fill_value=fill_value, bounds_error=bounds_error\n 603 |         )\n 604 |         new_y = terp(new_x)\n 605 |     elif method == \"spline\":\n 606 |         # GH #10633, #24014\n 607 |         if isna(order) or (order <= 0):\n 608 |             raise ValueError(\n 609 |                 f\"order needs to be specified and greater than 0; got order: {order}\"\n 610 |             )\n 611 |         terp = interpolate.UnivariateSpline(x, y, k=order, **kwargs)\n 612 |         new_y = terp(new_x)\n 613 |     else:\n 614 |         # GH 7295: need to be able to write for some reason\n 615 |         # in some circumstances: check all three\n 616 |         if not x.flags.writeable:\n 617 |             x = x.copy()\n 618 |         if not y.flags.writeable:\n 619 |             y = y.copy()\n 620 |         if not new_x.flags.writeable:\n 621 |             new_x = new_x.copy()\n 622 |         terp = alt_methods.get(method, None)\n 623 |         if terp is None:\n 624 |             raise ValueError(f\"Can not interpolate with method={method}.\")\n 625 | \n 626 |         # Make sure downcast is not in kwargs for alt methods\n 627 |         kwargs.pop(\"downcast\", None)\n 628 |         new_y = terp(x, y, new_x, **kwargs)\n 629 |     return new_y\n 630 | \n 631 | \n 632 | def _from_derivatives(\n 633 |     xi: np.ndarray,\n 634 |     yi: np.ndarray,\n 635 |     x: np.ndarray,\n 636 |     order=None,\n 637 |     der: int | list[int] | None = 0,\n 638 |     extrapolate: bool = False,\n 639 | ):\n 640 |     \"\"\"\n 641 |     Convenience function for interpolate.BPoly.from_derivatives.\n 642 | \n 643 |     Construct a piecewise polynomial in the Bernstein basis, compatible\n 644 |     with the specified values and derivatives at breakpoints.\n 645 | \n 646 |     Parameters\n 647 |     ----------\n 648 |     xi : array-like\n 649 |         sorted 1D array of x-coordinates\n 650 |     yi : array-like or list of array-likes\n 651 |         yi[i][j] is the j-th derivative known at xi[i]\n 652 |     order: None or int or array-like of ints. Default: None.\n 653 |         Specifies the degree of local polynomials. If not None, some\n 654 |         derivatives are ignored.\n 655 |     der : int or list\n 656 |         How many derivatives to extract; None for all potentially nonzero\n 657 |         derivatives (that is a number equal to the number of points), or a\n 658 |         list of derivatives to extract. This number includes the function\n 659 |         value as 0th derivative.\n 660 |      extrapolate : bool, optional\n 661 |         Whether to extrapolate to ouf-of-bounds points based on first and last\n 662 |         intervals, or to return NaNs. Default: True.\n 663 | \n 664 |     See Also\n 665 |     --------\n 666 |     scipy.interpolate.BPoly.from_derivatives\n 667 | \n 668 |     Returns\n 669 |     -------\n 670 |     y : scalar or array-like\n 671 |         The result, of length R or length M or M by R.\n 672 |     \"\"\"\n 673 |     from scipy import interpolate\n 674 | \n 675 |     # return the method for compat with scipy version & backwards compat\n 676 |     method = interpolate.BPoly.from_derivatives\n 677 |     m = method(xi, yi.reshape(-1, 1), orders=order, extrapolate=extrapolate)\n 678 | \n 679 |     return m(x)\n 680 | \n 681 | \n 682 | def _akima_interpolate(\n 683 |     xi: np.ndarray,\n 684 |     yi: np.ndarray,\n 685 |     x: np.ndarray,\n 686 |     der: int | list[int] | None = 0,\n 687 |     axis: AxisInt = 0,\n 688 | ):\n 689 |     \"\"\"\n 690 |     Convenience function for akima interpolation.\n 691 |     xi and yi are arrays of values used to approximate some function f,\n 692 |     with ``yi = f(xi)``.\n 693 | \n 694 |     See `Akima1DInterpolator` for details.\n 695 | \n 696 |     Parameters\n 697 |     ----------\n 698 |     xi : np.ndarray\n 699 |         A sorted list of x-coordinates, of length N.\n 700 |     yi : np.ndarray\n 701 |         A 1-D array of real values.  `yi`'s length along the interpolation\n 702 |         axis must be equal to the length of `xi`. If N-D array, use axis\n 703 |         parameter to select correct axis.\n 704 |     x : np.ndarray\n 705 |         Of length M.\n 706 |     der : int, optional\n 707 |         How many derivatives to extract; None for all potentially\n 708 |         nonzero derivatives (that is a number equal to the number\n 709 |         of points), or a list of derivatives to extract. This number\n 710 |         includes the function value as 0th derivative.\n 711 |     axis : int, optional\n 712 |         Axis in the yi array corresponding to the x-coordinate values.\n 713 | \n 714 |     See Also\n 715 |     --------\n 716 |     scipy.interpolate.Akima1DInterpolator\n 717 | \n 718 |     Returns\n 719 |     -------\n 720 |     y : scalar or array-like\n 721 |         The result, of length R or length M or M by R,\n 722 | \n 723 |     \"\"\"\n 724 |     from scipy import interpolate\n 725 | \n 726 |     P = interpolate.Akima1DInterpolator(xi, yi, axis=axis)\n 727 | \n 728 |     return P(x, nu=der)\n 729 | \n 730 | \n 731 | def _cubicspline_interpolate(\n 732 |     xi: np.ndarray,\n 733 |     yi: np.ndarray,\n 734 |     x: np.ndarray,\n 735 |     axis: AxisInt = 0,\n 736 |     bc_type: str | tuple[Any, Any] = \"not-a-knot\",\n 737 |     extrapolate=None,\n 738 | ):\n 739 |     \"\"\"\n 740 |     Convenience function for cubic spline data interpolator.\n 741 | \n 742 |     See `scipy.interpolate.CubicSpline` for details.\n 743 | \n 744 |     Parameters\n 745 |     ----------\n 746 |     xi : np.ndarray, shape (n,)\n 747 |         1-d array containing values of the independent variable.\n 748 |         Values must be real, finite and in strictly increasing order.\n 749 |     yi : np.ndarray\n 750 |         Array containing values of the dependent variable. It can have\n 751 |         arbitrary number of dimensions, but the length along ``axis``\n 752 |         (see below) must match the length of ``x``. Values must be finite.\n 753 |     x : np.ndarray, shape (m,)\n 754 |     axis : int, optional\n 755 |         Axis along which `y` is assumed to be varying. Meaning that for\n 756 |         ``x[i]`` the corresponding values are ``np.take(y, i, axis=axis)``.\n 757 |         Default is 0.\n 758 |     bc_type : string or 2-tuple, optional\n 759 |         Boundary condition type. Two additional equations, given by the\n 760 |         boundary conditions, are required to determine all coefficients of\n 761 |         polynomials on each segment [2]_.\n 762 |         If `bc_type` is a string, then the specified condition will be applied\n 763 |         at both ends of a spline. Available conditions are:\n 764 |         * 'not-a-knot' (default): The first and second segment at a curve end\n 765 |           are the same polynomial. It is a good default when there is no\n 766 |           information on boundary conditions.\n 767 |         * 'periodic': The interpolated functions is assumed to be periodic\n 768 |           of period ``x[-1] - x[0]``. The first and last value of `y` must be\n 769 |           identical: ``y[0] == y[-1]``. This boundary condition will result in\n 770 |           ``y'[0] == y'[-1]`` and ``y''[0] == y''[-1]``.\n 771 |         * 'clamped': The first derivative at curves ends are zero. Assuming\n 772 |           a 1D `y`, ``bc_type=((1, 0.0), (1, 0.0))`` is the same condition.\n 773 |         * 'natural': The second derivative at curve ends are zero. Assuming\n 774 |           a 1D `y`, ``bc_type=((2, 0.0), (2, 0.0))`` is the same condition.\n 775 |         If `bc_type` is a 2-tuple, the first and the second value will be\n 776 |         applied at the curve start and end respectively. The tuple values can\n 777 |         be one of the previously mentioned strings (except 'periodic') or a\n 778 |         tuple `(order, deriv_values)` allowing to specify arbitrary\n 779 |         derivatives at curve ends:\n 780 |         * `order`: the derivative order, 1 or 2.\n 781 |         * `deriv_value`: array-like containing derivative values, shape must\n 782 |           be the same as `y`, excluding ``axis`` dimension. For example, if\n 783 |           `y` is 1D, then `deriv_value` must be a scalar. If `y` is 3D with\n 784 |           the shape (n0, n1, n2) and axis=2, then `deriv_value` must be 2D\n 785 |           and have the shape (n0, n1).\n 786 |     extrapolate : {bool, 'periodic', None}, optional\n 787 |         If bool, determines whether to extrapolate to out-of-bounds points\n 788 |         based on first and last intervals, or to return NaNs. If 'periodic',\n 789 |         periodic extrapolation is used. If None (default), ``extrapolate`` is\n 790 |         set to 'periodic' for ``bc_type='periodic'`` and to True otherwise.\n 791 | \n 792 |     See Also\n 793 |     --------\n 794 |     scipy.interpolate.CubicHermiteSpline\n 795 | \n 796 |     Returns\n 797 |     -------\n 798 |     y : scalar or array-like\n 799 |         The result, of shape (m,)\n 800 | \n 801 |     References\n 802 |     ----------\n 803 |     .. [1] `Cubic Spline Interpolation\n 804 |             <https://en.wikiversity.org/wiki/Cubic_Spline_Interpolation>`_\n 805 |             on Wikiversity.\n 806 |     .. [2] Carl de Boor, \"A Practical Guide to Splines\", Springer-Verlag, 1978.\n 807 |     \"\"\"\n 808 |     from scipy import interpolate\n 809 | \n 810 |     P = interpolate.CubicSpline(\n 811 |         xi, yi, axis=axis, bc_type=bc_type, extrapolate=extrapolate\n 812 |     )\n 813 | \n 814 |     return P(x)\n 815 | \n 816 | \n 817 | def pad_or_backfill_inplace(\n 818 |     values: np.ndarray,\n 819 |     method: Literal[\"pad\", \"backfill\"] = \"pad\",\n 820 |     axis: AxisInt = 0,\n 821 |     limit: int | None = None,\n 822 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 823 | ) -> None:\n 824 |     \"\"\"\n 825 |     Perform an actual interpolation of values, values will be make 2-d if\n 826 |     needed fills inplace, returns the result.\n 827 | \n 828 |     Parameters\n 829 |     ----------\n 830 |     values: np.ndarray\n 831 |         Input array.\n 832 |     method: str, default \"pad\"\n 833 |         Interpolation method. Could be \"bfill\" or \"pad\"\n 834 |     axis: 0 or 1\n 835 |         Interpolation axis\n 836 |     limit: int, optional\n 837 |         Index limit on interpolation.\n 838 |     limit_area: str, optional\n 839 |         Limit area for interpolation. Can be \"inside\" or \"outside\"\n 840 | \n 841 |     Notes\n 842 |     -----\n 843 |     Modifies values in-place.\n 844 |     \"\"\"\n 845 |     transf = (lambda x: x) if axis == 0 else (lambda x: x.T)\n 846 | \n 847 |     # reshape a 1 dim if needed\n 848 |     if values.ndim == 1:\n 849 |         if axis != 0:  # pragma: no cover\n 850 |             raise AssertionError(\"cannot interpolate on a ndim == 1 with axis != 0\")\n 851 |         values = values.reshape(tuple((1,) + values.shape))\n 852 | \n 853 |     method = clean_fill_method(method)\n 854 |     tvalues = transf(values)\n 855 | \n 856 |     func = get_fill_func(method, ndim=2)\n 857 |     # _pad_2d and _backfill_2d both modify tvalues inplace\n 858 |     func(tvalues, limit=limit, limit_area=limit_area)\n 859 | \n 860 | \n 861 | def _fillna_prep(\n 862 |     values, mask: npt.NDArray[np.bool_] | None = None\n 863 | ) -> npt.NDArray[np.bool_]:\n 864 |     # boilerplate for _pad_1d, _backfill_1d, _pad_2d, _backfill_2d\n 865 | \n 866 |     if mask is None:\n 867 |         mask = isna(values)\n 868 | \n 869 |     return mask\n 870 | \n 871 | \n 872 | def _datetimelike_compat(func: F) -> F:\n 873 |     \"\"\"\n 874 |     Wrapper to handle datetime64 and timedelta64 dtypes.\n 875 |     \"\"\"\n 876 | \n 877 |     @wraps(func)\n 878 |     def new_func(\n 879 |         values,\n 880 |         limit: int | None = None,\n 881 |         limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 882 |         mask=None,\n 883 |     ):\n 884 |         if needs_i8_conversion(values.dtype):\n 885 |             if mask is None:\n 886 |                 # This needs to occur before casting to int64\n 887 |                 mask = isna(values)\n 888 | \n 889 |             result, mask = func(\n 890 |                 values.view(\"i8\"), limit=limit, limit_area=limit_area, mask=mask\n 891 |             )\n 892 |             return result.view(values.dtype), mask\n 893 | \n 894 |         return func(values, limit=limit, limit_area=limit_area, mask=mask)\n 895 | \n 896 |     return cast(F, new_func)\n 897 | \n 898 | \n 899 | @_datetimelike_compat\n 900 | def _pad_1d(\n 901 |     values: np.ndarray,\n 902 |     limit: int | None = None,\n 903 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 904 |     mask: npt.NDArray[np.bool_] | None = None,\n 905 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 906 |     mask = _fillna_prep(values, mask)\n 907 |     if limit_area is not None and not mask.all():\n 908 |         _fill_limit_area_1d(mask, limit_area)\n 909 |     algos.pad_inplace(values, mask, limit=limit)\n 910 |     return values, mask\n 911 | \n 912 | \n 913 | @_datetimelike_compat\n 914 | def _backfill_1d(\n 915 |     values: np.ndarray,\n 916 |     limit: int | None = None,\n 917 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 918 |     mask: npt.NDArray[np.bool_] | None = None,\n 919 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 920 |     mask = _fillna_prep(values, mask)\n 921 |     if limit_area is not None and not mask.all():\n 922 |         _fill_limit_area_1d(mask, limit_area)\n 923 |     algos.backfill_inplace(values, mask, limit=limit)\n 924 |     return values, mask\n 925 | \n 926 | \n 927 | @_datetimelike_compat\n 928 | def _pad_2d(\n 929 |     values: np.ndarray,\n 930 |     limit: int | None = None,\n 931 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 932 |     mask: npt.NDArray[np.bool_] | None = None,\n 933 | ) -> tuple[np.ndarray, npt.NDArray[np.bool_]]:\n 934 |     mask = _fillna_prep(values, mask)\n 935 |     if limit_area is not None:\n 936 |         _fill_limit_area_2d(mask, limit_area)\n 937 | \n 938 |     if values.size:\n 939 |         algos.pad_2d_inplace(values, mask, limit=limit)\n 940 |     return values, mask\n 941 | \n 942 | \n 943 | @_datetimelike_compat\n 944 | def _backfill_2d(\n 945 |     values,\n 946 |     limit: int | None = None,\n 947 |     limit_area: Literal[\"inside\", \"outside\"] | None = None,\n 948 |     mask: npt.NDArray[np.bool_] | None = None,\n 949 | ):\n 950 |     mask = _fillna_prep(values, mask)\n 951 |     if limit_area is not None:\n 952 |         _fill_limit_area_2d(mask, limit_area)\n 953 | \n 954 |     if values.size:\n 955 |         algos.backfill_2d_inplace(values, mask, limit=limit)\n 956 |     else:\n 957 |         # for test coverage\n 958 |         pass\n 959 |     return values, mask\n 960 | \n 961 | \n 962 | def _fill_limit_area_1d(\n 963 |     mask: npt.NDArray[np.bool_], limit_area: Literal[\"outside\", \"inside\"]\n 964 | ) -> None:\n 965 |     \"\"\"Prepare 1d mask for ffill/bfill with limit_area.\n 966 | \n 967 |     Caller is responsible for checking at least one value of mask is False.\n 968 |     When called, mask will no longer faithfully represent when\n 969 |     the corresponding are NA or not.\n 970 | \n 971 |     Parameters\n 972 |     ----------\n 973 |     mask : np.ndarray[bool, ndim=1]\n 974 |         Mask representing NA values when filling.\n 975 |     limit_area : { \"outside\", \"inside\" }\n 976 |         Whether to limit filling to outside or inside the outer most non-NA value.\n 977 |     \"\"\"\n 978 |     neg_mask = ~mask\n 979 |     first = neg_mask.argmax()\n 980 |     last = len(neg_mask) - neg_mask[::-1].argmax() - 1\n 981 |     if limit_area == \"inside\":\n 982 |         mask[:first] = False\n 983 |         mask[last + 1 :] = False\n 984 |     elif limit_area == \"outside\":\n 985 |         mask[first + 1 : last] = False\n 986 | \n 987 | \n 988 | def _fill_limit_area_2d(\n 989 |     mask: npt.NDArray[np.bool_], limit_area: Literal[\"outside\", \"inside\"]\n 990 | ) -> None:\n 991 |     \"\"\"Prepare 2d mask for ffill/bfill with limit_area.\n 992 | \n 993 |     When called, mask will no longer faithfully represent when\n 994 |     the corresponding are NA or not.\n 995 | \n 996 |     Parameters\n 997 |     ----------\n 998 |     mask : np.ndarray[bool, ndim=1]\n 999 |         Mask representing NA values when filling.\n1000 |     limit_area : { \"outside\", \"inside\" }\n1001 |         Whether to limit filling to outside or inside the outer most non-NA value.\n1002 |     \"\"\"\n1003 |     neg_mask = ~mask.T\n1004 |     if limit_area == \"outside\":\n1005 |         # Identify inside\n1006 |         la_mask = (\n1007 |             np.maximum.accumulate(neg_mask, axis=0)\n1008 |             & np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1009 |         )\n1010 |     else:\n1011 |         # Identify outside\n1012 |         la_mask = (\n1013 |             ~np.maximum.accumulate(neg_mask, axis=0)\n1014 |             | ~np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1015 |         )\n1016 |     mask[la_mask.T] = False\n1017 | \n1018 | \n1019 | _fill_methods = {\"pad\": _pad_1d, \"backfill\": _backfill_1d}\n1020 | \n1021 | \n1022 | def get_fill_func(method, ndim: int = 1):\n1023 |     method = clean_fill_method(method)\n1024 |     if ndim == 1:\n1025 |         return _fill_methods[method]\n1026 |     return {\"pad\": _pad_2d, \"backfill\": _backfill_2d}[method]\n1027 | \n1028 | \n1029 | def clean_reindex_fill_method(method) -> ReindexMethod | None:\n1030 |     if method is None:\n1031 |         return None\n1032 |     return clean_fill_method(method, allow_nearest=True)\n1033 | \n1034 | \n1035 | def _interp_limit(\n1036 |     invalid: npt.NDArray[np.bool_], fw_limit: int | None, bw_limit: int | None\n1037 | ) -> np.ndarray:\n1038 |     \"\"\"\n1039 |     Get indexers of values that won't be filled\n1040 |     because they exceed the limits.\n1041 | \n1042 |     Parameters\n1043 |     ----------\n1044 |     invalid : np.ndarray[bool]\n1045 |     fw_limit : int or None\n1046 |         forward limit to index\n1047 |     bw_limit : int or None\n1048 |         backward limit to index\n1049 | \n1050 |     Returns\n1051 |     -------\n1052 |     set of indexers\n1053 | \n1054 |     Notes\n1055 |     -----\n1056 |     This is equivalent to the more readable, but slower\n1057 | \n1058 |     .. code-block:: python\n1059 | \n1060 |         def _interp_limit(invalid, fw_limit, bw_limit):\n1061 |             for x in np.where(invalid)[0]:\n1062 |                 if invalid[max(0, x - fw_limit) : x + bw_limit + 1].all():\n1063 |                     yield x\n1064 |     \"\"\"\n1065 |     # handle forward first; the backward direction is the same except\n1066 |     # 1. operate on the reversed array\n1067 |     # 2. subtract the returned indices from N - 1\n1068 |     N = len(invalid)\n1069 |     f_idx = np.array([], dtype=np.int64)\n1070 |     b_idx = np.array([], dtype=np.int64)\n1071 |     assume_unique = True\n1072 | \n1073 |     def inner(invalid, limit: int):\n1074 |         limit = min(limit, N)\n1075 |         windowed = np.lib.stride_tricks.sliding_window_view(invalid, limit + 1).all(1)\n1076 |         idx = np.union1d(\n1077 |             np.where(windowed)[0] + limit,\n1078 |             np.where((~invalid[: limit + 1]).cumsum() == 0)[0],\n1079 |         )\n1080 |         return idx\n1081 | \n1082 |     if fw_limit is not None:\n1083 |         if fw_limit == 0:\n1084 |             f_idx = np.where(invalid)[0]\n1085 |             assume_unique = False\n1086 |         else:\n1087 |             f_idx = inner(invalid, fw_limit)\n1088 | \n1089 |     if bw_limit is not None:\n1090 |         if bw_limit == 0:\n1091 |             # then we don't even need to care about backwards\n1092 |             # just use forwards\n1093 |             return f_idx\n1094 |         else:\n1095 |             b_idx = N - 1 - inner(invalid[::-1], bw_limit)\n1096 |             if fw_limit == 0:\n1097 |                 return b_idx\n1098 | \n1099 |     return np.intersect1d(f_idx, b_idx, assume_unique=assume_unique)\n1100 | \n```\n"}, {"content": "Let me also check the resample.py file since it contains resampling-related interpolation:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/core/resample.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"rol