           # object)\n577 |             nominal_attributes = {k: v for k, v in arff['attributes']\n578 |                                   if isinstance(v, list) and\n579 |                                   k in data_columns + target_columns}\n580 |             return X, y, nominal_attributes\n581 | \n582 |         def postprocess(X, y, nominal_attributes):\n583 |             is_classification = {col_name in nominal_attributes\n584 |                                  for col_name in target_columns}\n585 |             if not is_classification:\n586 |                 # No target\n587 |                 pass\n588 |             elif all(is_classification):\n589 |                 y = np.hstack([\n590 |                     np.take(\n591 |                         np.asarray(nominal_attributes.pop(col_name),\n592 |                                    dtype='O'),\n593 |                         y[:, i:i + 1].astype(int, copy=False))\n594 |                     for i, col_name in enumerate(target_columns)\n595 |                 ])\n596 |             elif any(is_classification):\n597 |                 raise ValueError('Mix of nominal and non-nominal targets is '\n598 |                                  'not currently supported')\n599 | \n600 |             # reshape y back to 1-D array, if there is only 1 target column;\n601 |             # back to None if there are not target columns\n602 |             if y.shape[1] == 1:\n603 |                 y = y.reshape((-1,))\n604 |             elif y.shape[1] == 0:\n605 |                 y = None\n606 |             return X, y, frame, nominal_attributes\n607 | \n608 |     out = _retry_with_clean_cache(url, data_home)(\n609 |         _load_arff_response)(url, data_home,\n610 |                              return_type=return_type,\n611 |                              encode_nominal=not as_frame,\n612 |                              parse_arff=parse_arff)\n613 |     X, y, frame, nominal_attributes = postprocess(*out)\n614 | \n615 |     return Bunc