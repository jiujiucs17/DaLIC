 str or int\n 82 |         The class considered as the positive class when computing\n 83 |         the metrics.\n 84 |     \"\"\"\n 85 |     classification_error = (\n 86 |         \"Expected 'estimator' to be a binary classifier, but got\"\n 87 |         f\" {estimator.__class__.__name__}\"\n 88 |     )\n 89 | \n 90 |     if not is_classifier(estimator):\n 91 |         raise ValueError(classification_error)\n 92 | \n 93 |     prediction_method = _check_classifier_response_method(estimator, response_method)\n 94 | \n 95 |     y_pred = prediction_method(X)\n 96 | \n 97 |     if pos_label is not None and pos_label not in estimator.classes_:\n 98 |         raise ValueError(\n 99 |             \"The class provided by 'pos_label' is unknown. Got \"\n100 |             f\"{pos_label} instead of one of {estimator.classes_}\"\n101 |         )\n102 | \n103 |     if y_pred.ndim != 1:  # `predict_proba`\n104 |         if y_pred.shape[1] != 2:\n105 |             raise ValueError(classification_error)\n106 |         if pos_label is None:\n107 |             pos_label = estimator.classes_[1]\n108 |             y_pred = y_pred[:, 1]\n109 |         else:\n110 |             class_idx = np.flatnonzero(estimator.classes_ == pos_label)\n111 |             y_pred = y_pred[:, class_idx]\n112 |     else:\n113 |         if pos_label is None:\n114 |             pos_label = estimator.classes_[1]\n115 |         elif pos_label == estimator.classes_[0]:\n116 |             y_pred *= -1\n117 | \n118 |     return y_pred, pos_label\n```\n\nFound function `sklearn/datasets/_openml.py:_load_arff_response`.\nSource: Retrieved entity using keyword search (bm25).\n```\n499 | def _load_arff_response(\n500 |     url: str,\n501 |     data_home: Optional[str],\n502 |     return_type,\n503 |     encode_nominal: bool,\n504 |     parse_arff: Callable[[ArffContainerType], Tuple],\n505 |     md5_checksum: str,\n506 | ) -> Tuple:\n507 |     \"\"\"Load arff data with url and parses arff response with parse_arff\"\"\"\n508 |     response = _open_openml_url(url, data_home)\n509 | \n510 |     with closing(response):\n511 |         # Note that if the data is dense, no reading is done until the data\n512 |         # generator is iterated.\n513 |         actual_md5_checksum = hashlib.md5()\n514 | \n515 |         def _stream_checksum_generator(response):\n516 |             for line in response:\n517 |                 actual_md5_checksum.update(line)\n518 |                 yield line.decode(\"utf-8\")\n519 | \n520 |         stream = _stream_checksum_generator(response)\n521 | \n522 |         arff = _arff.load(\n523 |             stream, return_type=return_type, encode_nominal=encode_nominal\n524 |         )\n525 | \n526 |         parsed_arff = parse_arff(arff)\n527 | \n528 |         # consume remaining stream, if early exited\n529 |         for _ in stream:\n530 |             pass\n531 | \n532 |         if actual_md5_checksum.hexdigest() != md5_checksum:\n533 |             raise ValueError(\n534 |                 \"md5 checksum of local file for \"\n535 |                 + url\n536 |                 + \" does not match description. \"\n537 |                 \"Downloaded file could have been modified / \"\n538 |                 \"corrupted, clean cache and retry...\"\n539 |             )\n540 | \n541 |         return parsed_arff\n```\n\nFound function `sklearn/inspection/_partial_dependence.py:_partial_dependence_brute`.\nSource: Retrieved code content using keyword search (bm25).\n```\n120 | def _partial_dependence_brute(est, grid, features, X, response_method):\n121 | \n122 |     predictions = []\n123 |     averaged_predictions = []\n124 | \n125 |     # define the prediction_method (predict, predict_proba, decision_function).\n126 |     if is_regressor(est):\n127 |         prediction_method = est.predict\n128 |     else:\n129 |         predict_proba = getattr(est, \"predict_proba\", None)\n130 |         decision_function = getattr(est, \"decision_function\", None)\n131 |         if response_method == \"auto\":\n132 |             # try predict_proba, then decision_function if it doesn't exist\n133 |             prediction_method = predict_proba or decision_function\n134 |         else:\n135 |             prediction_method = (\n136 |                 predict_proba\n137 |                 if response_method == \"predict_proba\"\n138 |                 else decision_function\n139 |             )\n140 |         if prediction_method is None:\n141 |             if response_method == \"auto\":\n142 |                 raise ValueError(\n143 |                     \"The estimator has no predict_proba and no \"\n144 |                     \"decision_function method.\"\n145 |                 )\n146 |             elif response_method == \"predict_proba\":\n147 |                 raise ValueError(\"The estimator has no predict_proba method.\")\n148 |             else:\n149 |                 raise ValueError(\"The estimator has no decision_function method.\")\n150 | \n151 |     for new_values in grid:\n152 |         X_eval = X.copy()\n153 |         for i, variable in enumerate(features):\n154 |             if hasattr(X_eval, \"iloc\"):\n155 |                 X_eval.iloc[:, variable] = new_values[i]\n156 |             else:\n157 |                 X_eval[:, variable] = new_values[i]\n158 | \n159 |         try:\n160 |             # Note: predictions is of shape\n161 |             # (n_points,) for non-multioutput regressors\n162 |             # (n_points, n_tasks) for multioutput regressors\n163 |             # (n_points, 1) for the regressors in cross_decomposition (I think)\n164 |             # (n_points, 2) for binary classification\n165 |             # (n_points, n_classes) for multiclass classification\n166 |             pred = prediction_method(X_eval)\n167 | \n168 |             predictions.append(pred)\n169 |             # average over samples\n170 |             averaged_predictions.append(np.mean(pred, axis=0))\n171 |         except NotFittedError as e:\n172 |             raise ValueError(\"'estimator' parameter must be a fitted estimator\") from e\n173 | \n174 |     n_samples = X.shape[0]\n175 | \n176 |     # reshape to (n_targets, n_instances, n_points) where n_targets is:\n177 |     # - 1 for non-multioutput regression and binary classification (shape is\n178 |     #   already correct in those cases)\n179 |     # - n_tasks for multi-output regression\n180 |     # - n_classes for multiclass classification.\n181 |     predictions = np.array(predictions).T\n182 |     if is_regressor(est) and predictions.ndim == 2:\n183 |         # non-multioutput regression, shape is (n_instances, n_points,)\n184 |         predictions = predictions.reshape(n_samples, -1)\n185 |     elif is_classifier(est) and predictions.shape[0] == 2:\n186 |         # Binary classification, shape is (2, n_instances, n_points).\n187 |         # we output the effect of **positive** class\n188 |         predictions = predictions[1]\n189 |         predictions = predictions.reshape(n_samples, -1)\n190 | \n191 |     # reshape averaged_predictions to (n_targets, n_points) where n_targets is:\n192 |     # - 1 for non-multioutput regression and binary classification (shape is\n193 |     #   already correct in those cases)\n194 |     # - n_tasks for multi-output regression\n195 |     # - n_classes for multiclass classification.\n196 |     averaged_predictions = np.array(averaged_predictions).T\n197 |     if is_regressor(est) and averaged_predictions.ndim == 1:\n198 |         # non-multioutput regression, shape is (n_points,)\n199 |         averaged_predictions = averaged_predictions.reshape(1, -1)\n200 |     elif is_classifier(est) and averaged_predictions.shape[0] == 2:\n201 |         # Binary classification, shape is (2, n_points).\n202 |         # we output the effect of **positive** class\n203 |         averaged_predictions = averaged_predictions[1]\n204 |         averaged_predictions = averaged_predictions.reshape(1, -1)\n205 | \n206 |     return averaged_predictions, predictions\n```\n\n\n\n##Searching for term \"response_method\", \"CalibrationDisplay matplotlib response_method\"...\n### Search Result:\nFound function `sklearn/inspection/_partial_dependence.py:partial_dependence`.\nSource: Retrieved code content using keyword search (bm25).\n```\n209 | def partial_dependence(\n210 |     estimator,\n211 |     X,\n212 |     features,\n213 |     *,\n214 |     response_method=\"auto\",\n215 |     percentiles=(0.05, 0.95),\n216 |     grid_resolution=100,\n217 |     method=\"auto\",\n218 |     kind=\"legacy\",\n219 | ):\n220 |     \"\"\"Partial dependence of ``features``.\n221 | \n222 |     Partial dependence of a feature (or a set of features) corresponds to\n223 |     the average response of an estimator for each possible value of the\n224 |     feature.\n225 | \n226 |     Read more in the :ref:`User Guide <partial_dependence>`.\n227 | \n228 |     .. warning::\n229 | \n230 |         For :class:`~sklearn.ensemble.GradientBoostingClassifier` and\n231 |         :class:`~sklearn.ensemble.GradientBoostingRegressor`, the\n232 |         `'recursion'` method (used by default) will not account for the `init`\n233 |         predictor of the boosting process. In practice, this will produce\n234 |         the same values as `'brute'` up to a constant offset in the target\n235 |         response, provided that `init` is a constant estimator (which is the\n236 |         default). However, if `init` is not a constant estimator, the\n237 |         partial dependence values are incorrect for `'recursion'` because the\n238 |         offset will be sample-dependent. It is preferable to use the `'brute'`\n239 |         method. Note that this only applies to\n240 |         :class:`~sklearn.ensemble.GradientBoostingClassifier` and\n241 |         :class:`~sklearn.ensemble.GradientBoostingRegressor`, not to\n242 |         :class:`~sklearn.ensemble.HistGradientBoostingClassifier` and\n243 |         :class:`~sklearn.ensemble.HistGradientBoostingRegressor`.\n244 | \n245 |     Parameters\n246 |     ----------\n247 |     estimator : BaseEstimator\n248 |         A fitted estimator object implementing :term:`predict`,\n249 |         :term:`predict_proba`, or :term:`decision_function`.\n250 |         Multioutput-multiclass classifiers are not supported.\n251 | \n252 |     X : {array-like or dataframe} of shape (n_samples, n_features)\n253 |         ``X`` is used to generate a grid of values for the target\n254 |         ``features`` (where the partial dependence will be evaluated), and\n255 |         also to generate values for the complement features when the\n256 |         `method` is 'brute'.\n257 | \n258 |     features : array-like of {int, str}\n259 |         The feature (e.g. `[0]`) or pair of interacting features\n260 |         (e.g. `[(0, 1)]`) for which the partial dependency should be computed.\n261 | \n262 |     response_method : {'auto', 'predict_proba', 'decision_function'}, \\\n263 |             default='auto'\n264 |         Specifies whether to use :term:`predict_proba` or\n265 |         :term:`decision_function` as the target response. For regressors\n266 |         this parameter is ignored and the response is always the output of\n267 |         :term:`predict`. By default, :term:`predict_proba` is tried first\n268 |         and we revert to :term:`decision_function` if it doesn't exist. If\n269 |         ``method`` is 'recursion', the response is always the output of\n270 |         :term:`decision_function`.\n271 | \n272 |     percentiles : tuple of float, default=(0.05, 0.95)\n273 |         The lower and upper percentile used to create the extreme values\n274 |         for the grid. Must be in [0, 1].\n275 | \n276 |     grid_resolution : int, default=100\n277 |         The number of equally spaced points on the grid, for each target\n278 |         feature.\n279 | \n280 |     method : {'auto', 'recursion', 'brute'}, default='auto'\n281 |         The method used to calculate the averaged predictions:\n282 | \n283 |         - `'recursion'` is only supported for some tree-based estimators\n284 |           (namely\n285 |           :class:`~sklearn.ensemble.GradientBoostingClassifier`,\n286 |           :class:`~sklearn.ensemble.GradientBoostingRegressor`,\n287 |           :class:`~sklearn.ensemble.HistGradientBoostingClassifier`,\n288 |           :class:`~sklearn.ensemble.HistGradientBoostingRegressor`,\n289 |           :class:`~sklearn.tree.DecisionTreeRegressor`,\n290 |           :class:`~sklearn.ensemble.RandomForestRegressor`,\n291 |           ) when `kind='average'`.\n292 |           This is more efficient in terms of speed.\n293 |           With this method, the target response of a\n294 |           classifier is always the decision function, not the predicted\n295 |           probabilities. Since the `'recursion'` method implicitely computes\n296 |           the average of the Individual Conditional Expectation (ICE) by\n297 |           design, it is not compatible with ICE and thus `kind` must be\n298 |           `'average'`.\n299 | \n300 |         - `'brute'` is supported for any estimator, but is more\n301 |           computationally intensive.\n302 | \n303 |         - `'auto'`: the `'recursion'` is used for estimators that support it,\n304 |           and `'brute'` is used otherwise.\n305 | \n306 |         Please see :ref:`this note <pdp_method_differences>` for\n307 |         differences between the `'brute'` and `'recursion'` method.\n308 | \n309 |     kind : {'legacy', 'average', 'individual', 'both'}, default='legacy'\n310 |         Whether to return the partial dependence averaged across all the\n311 |         samples in the dataset or one line per sample or both.\n312 |         See Returns below.\n313 | \n314 |         Note that the fast `method='recursion'` option is only available for\n315 |         `kind='average'`. Plotting individual dependencies requires using the\n316 |         slower `method='brute'` option.\n317 | \n318 |         .. versionadded:: 0.24\n319 |         .. deprecated:: 0.24\n320 |             `kind='legacy'` is deprecated and will be removed in version 1.1.\n321 |             `kind='average'` will be the new default. It is intended to migrate\n322 |             from the ndarray output to :class:`~sklearn.utils.Bunch` output.\n323 | \n324 | \n325 |     Returns\n326 |     -------\n327 |     predictions : ndarray or :class:`~sklearn.utils.Bunch`\n328 | \n329 |         - if `kind='legacy'`, return value is ndarray of shape (n_outputs, \\\n330 |                 len(values[0]), len(values[1]), ...)\n331 |             The predictions for all the points in the grid, averaged\n332 |             over all samples in X (or over the training data if ``method``\n333 |             is 'recursion').\n334 | \n335 |         - if `kind='individual'`, `'average'` or `'both'`, return value is \\\n336 |                 :class:`~sklearn.utils.Bunch`\n337 |             Dictionary-like object, with the following attributes.\n338 | \n339 |             individual : ndarray of shape (n_outputs, n_instances, \\\n340 |                     len(values[0]), len(values[1]), ...)\n341 |                 The predictions for all the points in the grid for all\n342 |                 samples in X. This is also known as Individual\n343 |                 Conditional Expectation (ICE)\n344 | \n345 |             average : ndarray of shape (n_outputs, len(values[0]), \\\n346 |                     len(values[1]), ...)\n347 |                 The predictions for all the points in the grid, averaged\n348 |                 over all samples in X (or over the training data if\n349 |                 ``method`` is 'recursion').\n350 |                 Only available when kind='both'.\n351 | \n352 |             values : seq of 1d ndarrays\n353 |                 The values with which the grid has been created. The generated\n354 |                 grid is a cartesian product of the arrays in ``values``.\n355 |                 ``len(values) == len(features)``. The size of each array\n356 |                 ``values[j]`` is either ``grid_resolution``, or the number of\n357 |                 unique values in ``X[:, j]``, whichever is smaller.\n358 | \n359 |         ``n_outputs`` corresponds to the number of classes in a multi-class\n360 |         setting, or to the number of tasks for multi-output regression.\n361 |         For classical regression and binary classification ``n_outputs==1``.\n362 |         ``n_values_feature_j`` corresponds to the size ``values[j]``.\n363 | \n364 |     values : seq of 1d ndarrays\n365 |         The values with which the grid has been created. The generated grid\n366 |         is a cartesian product of the arrays in ``values``. ``len(values) ==\n367 |         len(features)``. The size of each array ``values[j]`` is either\n368 |         ``grid_resolution``, or the number of unique values in ``X[:, j]``,\n369 |         whichever is smaller. Only available when `kind=\"legacy\"`.\n370 | \n371 |     See Also\n372 |     --------\n373 |     plot_partial_dependence : Plot Partial Dependence.\n374 |     PartialDependenceDisplay : Partial Dependence visualization.\n375 | \n376 |     Examples\n377 |     --------\n378 |     >>> X = [[0, 0, 2], [1, 0, 0]]\n379 |     >>> y = [0, 1]\n380 |     >>> from sklearn.ensemble import GradientBoostingClassifier\n381 |     >>> gb = GradientBoostingClassifier(random_state=0).fit(X, y)\n382 |     >>> partial_dependence(gb, features=[0], X=X, percentiles=(0, 1),\n383 |     ...                    grid_resolution=2) # doctest: +SKIP\n384 |     (array([[-4.52...,  4.52...]]), [array([ 0.,  1.])])\n385 |     \"\"\"\n386 |     if not (is_classifier(estimator) or is_regressor(estimator)):\n387 |         raise ValueError(\"'estimator' must be a fitted regressor or classifier.\")\n388 | \n389 |     if isinstance(estimator, Pipeline):\n390 |         # TODO: to be removed if/when pipeline get a `steps_` attributes\n391 |         # assuming Pipeline is the only estimator that does not store a new\n392 |         # attribute\n393 |         for est in estimator:\n394 |             # FIXME: remove the None option when it will be deprecated\n395 |             if est not in (None, \"drop\"):\n396 |                 check_is_fitted(est)\n397 |     else:\n398 |         check_is_fitted(estimator)\n399 | \n400 |     if is_classifier(estimator) and isinstance(estimator.classes_[0], np.ndarray):\n401 |         raise ValueError(\"Multiclass-multioutput estimators are not supported\")\n402 | \n403 |     # Use check_array only on lists and other non-array-likes / sparse. Do not\n404 |     # convert DataFrame into a NumPy array.\n405 |     if not (hasattr(X, \"__array__\") or sparse.issparse(X)):\n406 |         X = check_array(X, force_all_finite=\"allow-nan\", dtype=object)\n407 | \n408 |     accepted_responses = (\"auto\", \"predict_proba\", \"decision_function\")\n409 |     if response_method not in accepted_responses:\n410 |         raise ValueError(\n411 |             \"response_method {} is invalid. Accepted response_method names \"\n412 |             \"are {}.\".format(response_method, \", \".join(accepted_responses))\n413 |         )\n414 | \n415 |     if is_regressor(estimator) and response_method != \"auto\":\n416 |         raise ValueError(\n417 |             \"The response_method parameter is ignored for regressors and \"\n418 |             \"must be 'auto'.\"\n419 |         )\n420 | \n421 |     accepted_methods = (\"brute\", \"recursion\", \"auto\")\n422 |     if method not in accepted_methods:\n423 |         raise ValueError(\n424 |             \"method {} is invalid. Accepted method names are {}.\".format(\n425 |                 method, \", \".join(accepted_methods)\n426 |             )\n427 |         )\n428 | \n429 |     if kind != \"average\" and kind != \"legacy\":\n430 |         if method == \"recursion\":\n431 |             raise ValueError(\n432 |                 \"The 'recursion' method only applies when 'kind' is set to 'average'\"\n433 |             )\n434 |         method = \"brute\"\n435 | \n436 |     if method == \"auto\":\n437 |         if isinstance(estimator, BaseGradientBoosting) and estimator.init is None:\n438 |             method = \"recursion\"\n439 |         elif isinstance(\n440 |             estimator,\n441 |             (BaseHistGradientBoosting, DecisionTreeRegressor, RandomForestRegressor),\n442 |         ):\n443 |             method = \"recursion\"\n444 |         else:\n445 |             method = \"brute\"\n446 | \n447 |     if method == \"recursion\":\n448 |         if not isinstance(\n449 |             estimator,\n450 |             (\n451 |                 BaseGradientBoosting,\n452 |                 BaseHistGradientBoosting,\n453 |                 DecisionTreeRegressor,\n454 |                 RandomForestRegressor,\n455 |             ),\n456 |         ):\n457 |             supported_classes_recursion = (\n458 |                 \"GradientBoostingClassifier\",\n459 |                 \"GradientBoostingRegressor\",\n460 |                 \"HistGradientBoostingClassifier\",\n461 |                 \"HistGradientBoostingRegressor\",\n462 |                 \"HistGradientBoostingRegressor\",\n463 |                 \"DecisionTreeRegressor\",\n464 |                 \"RandomForestRegressor\",\n465 |             )\n466 |             raise ValueError(\n467 |                 \"Only the following estimators support the 'recursion' \"\n468 |                 \"method: {}. Try using method='brute'.\".format(\n469 |                     \", \".join(supported_classes_recursion)\n470 |                 )\n471 |             )\n472 |         if response_method == \"auto\":\n473 |             response_method = \"decision_function\"\n474 | \n475 |         if response_method != \"decision_function\":\n476 |             raise ValueError(\n477 |                 \"With the 'recursion' method, the response_method must be \"\n478 |                 \"'decision_function'. Got {}.\".format(response_method)\n479 |             )\n480 | \n481 |     if _determine_key_type(features, accept_slice=False) == \"int\":\n482 |         # _get_column_indices() supports negative indexing. Here, we limit\n483 |         # the indexing to be positive. The upper bound will be checked\n484 |         # by _get_column_indices()\n485 |         if np.any(np.less(features, 0)):\n486 |             raise ValueError(\"all features must be in [0, {}]\".format(X.shape[1] - 1))\n487 | \n488 |     features_indices = np.asarray(\n489 |         _get_column_indices(X, features), dtype=np.int32, order=\"C\"\n490 |     ).ravel()\n491 | \n492 |     grid, values = _grid_from_X(\n493 |         _safe_indexing(X, features_indices, axis=1), percentiles, grid_resolution\n494 |     )\n495 | \n496 |     if method == \"brute\":\n497 |         averaged_predictions, predictions = _partial_dependence_brute(\n498 |             estimator, grid, features_indices, X, response_method\n499 |         )\n500 | \n501 |         # reshape predictions to\n502 |         # (n_outputs, n_instances, n_values_feature_0, n_values_feature_1, ...)\n503 |         predictions = predictions.reshape(\n504 |             -1, X.shape[0], *[val.shape[0] for val in values]\n505 |         )\n506 |     else:\n507 |         averaged_predictions = _partial_dependence_recursion(\n508 |             estimator, grid, features_indices\n509 |         )\n510 | \n511 |     # reshape averaged_predictions to\n512 |     # (n_outputs, n_values_feature_0, n_values_feature_1, ...)\n513 |     averaged_predictions = averaged_predictions.reshape(\n514 |         -1, *[val.shape[0] for val in values]\n515 |     )\n516 | \n517 |     if kind == \"legacy\":\n518 |         warnings.warn(\n519 |             \"A Bunch will be returned in place of 'predictions' from version\"\n520 |             \" 1.1 (renaming of 0.26) with partial dependence results \"\n521 |             \"accessible via the 'average' key. In the meantime, pass \"\n522 |             \"kind='average' to get the future behaviour.\",\n523 |             FutureWarning,\n524 |         )\n525 |         # TODO 1.1: Remove kind == 'legacy' section\n526 |         return averaged_predictions, values\n527 |     elif kind == \"average\":\n528 |         return Bunch(average=averaged_predictions, values=values)\n529 |     elif kind == \"individual\":\n530 |         return Bunch(individual=predictions, values=values)\n531 |     else:  # kind='both'\n532 |         return Bunch(\n533 |             average=averaged_predictions,\n534 |             individual=predictions,\n535 |             values=values,\n536 |         )\n```\n\nFound function `sklearn/metrics/_plot/det_curve.py:DetCurveDisplay.from_estimator`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 84 | def from_estimator(\n 85 |         cls,\n 86 |         estimator,\n 87 |         X,\n 88 |         y,\n 89 |         *,\n 90 |         sample_weight=None,\n 91 |         response_method=\"auto\",\n 92 |         pos_label=None,\n 93 |         name=None,\n 94 |         ax=None,\n 95 |         **kwargs,\n 96 |     ):\n 97 |         \"\"\"Plot DET curve given an estimator and data.\n 98 | \n 99 |         Read more in the :ref:`User Guide <visualizations>`.\n100 | \n101 |         .. versionadded:: 1.0\n102 | \n103 |         Parameters\n104 |         ----------\n105 |         estimator : estimator instance\n106 |             Fitted classifier or a fitted :class:`~sklearn.pipeline.Pipeline`\n107 |             in which the last estimator is a classifier.\n108 | \n109 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n110 |             Input values.\n111 | \n112 |         y : array-like of shape (n_samples,)\n113 |             Target values.\n114 | \n115 |         sample_weight : array-like of shape (n_samples,), default=None\n116 |             Sample weights.\n117 | \n118 |         response_method : {'predict_proba', 'decision_function', 'auto'} \\\n119 |                 default='auto'\n120 |             Specifies whether to use :term:`predict_proba` or\n121 |             :term:`decision_function` as the predicted target response. If set\n122 |             to 'auto', :term:`predict_proba` is tried first and if it does not\n123 |             exist :term:`decision_function` is tried next.\n124 | \n125 |         pos_label : str or int, default=None\n126 |             The label of the positive class. When `pos_label=None`, if `y_true`\n127 |             is in {-1, 1} or {0, 1}, `pos_label` is set to 1, otherwise an\n128 |             error will be raised.\n129 | \n130 |         name : str, default=None\n131 |             Name of DET curve for labeling. If `None`, use the name of the\n132 |             estimator.\n133 | \n134 |         ax : matplotlib axes, default=None\n135 |             Axes object to plot on. If `None`, a new figure and axes is\n136 |             created.\n137 | \n138 |         **kwargs : dict\n139 |             Additional keywords arguments passed to matplotlib `plot` function.\n140 | \n141 |         Returns\n142 |         -------\n143 |         display : :class:`~sklearn.metrics.DetCurveDisplay`\n144 |             Object that stores computed values.\n145 | \n146 |         See Also\n147 |         --------\n148 |         det_curve : Compute error rates for different probability thresholds.\n149 |         DetCurveDisplay.from_predictions : Plot DET curve given the true and\n150 |             predicted labels.\n151 |         plot_roc_curve : Plot Receiver operating characteristic (ROC) curve.\n152 | \n153 |         Examples\n154 |         --------\n155 |         >>> import matplotlib.pyplot as plt\n156 |         >>> from sklearn.datasets import make_classification\n157 |         >>> from sklearn.metrics import DetCurveDisplay\n158 |         >>> from sklearn.model_selection import train_test_split\n159 |         >>> from sklearn.svm import SVC\n160 |         >>> X, y = make_classification(n_samples=1000, random_state=0)\n161 |         >>> X_train, X_test, y_train, y_test = train_test_split(\n162 |         ...     X, y, test_size=0.4, random_state=0)\n163 |         >>> clf = SVC(random_state=0).fit(X_train, y_train)\n164 |         >>> DetCurveDisplay.from_estimator(\n165 |         ...    clf, X_test, y_test)\n166 |         <...>\n167 |         >>> plt.show()\n168 |         \"\"\"\n169 |         check_matplotlib_support(f\"{cls.__name__}.from_estimator\")\n170 | \n171 |         name = estimator.__class__.__name__ if name is None else name\n172 | \n173 |         y_pred, pos_label = _get_response(\n174 |             X,\n175 |             estimator,\n176 |             response_method,\n177 |             pos_label=pos_label,\n178 |         )\n179 | \n180 |         return cls.from_predictions(\n181 |             y_true=y,\n182 |             y_pred=y_pred,\n183 |             sample_weight=sample_weight,\n184 |             name=name,\n185 |             ax=ax,\n186 |             pos_label=pos_label,\n187 |             **kwargs,\n188 |         )\n```\n\nFound function `sklearn/metrics/_plot/base.py:_check_classifier_response_method`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 6 | def _check_classifier_response_method(estimator, response_method):\n 7 |     \"\"\"Return prediction method from the response_method\n 8 | \n 9 |     Parameters\n10 |     ----------\n11 |     estimator: object\n12 |         Classifier to check\n13 | \n14 |     response_method: {'auto', 'predict_proba', 'decision_function'}\n15 |         Specifies whether to use :term:`predict_proba` or\n16 |         :term:`decision_function` as the target response. If set to 'auto',\n17 |         :term:`predict_proba` is tried first and if it does not exist\n18 |         :term:`decision_function` is tried next.\n19 | \n20 |     Returns\n21 |     -------\n22 |     prediction_method: callable\n23 |         prediction method of estimator\n24 |     \"\"\"\n25 | \n26 |     if response_method not in (\"predict_proba\", \"de