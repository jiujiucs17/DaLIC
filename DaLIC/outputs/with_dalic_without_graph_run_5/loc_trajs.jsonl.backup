(after making a copy\n810 |             # when `copy=True`).\n811 |             # recompute Gram\n812 |             precompute = \"auto\"\n813 |             Xy = None\n814 |         elif check_input:\n815 |             # If we're going to use the user's precomputed gram matrix, we\n816 |             # do a quick check to make sure its not totally bogus.\n817 |             _check_precomputed_gram_matrix(X, precompute, X_offset, X_scale)\n818 | \n819 |     # precompute if n_samples > n_features\n820 |     if isinstance(precompute, str) and precompute == \"auto\":\n821 |         precompute = n_samples > n_features\n822 | \n823 |     if precompute is True:\n824 |         # make sure that the 'precompute' array is contiguous.\n825 |         precompute = np.empty(shape=(n_features, n_features), dtype=X.dtype, order=\"C\")\n826 |         np.dot(X.T, X, out=precompute)\n827 | \n828 |     if not hasattr(precompute, \"__array__\"):\n829 |         Xy = None  # cannot use Xy if precompute is not Gram\n830 | \n831 |     if hasattr(precompute, \"__array__\") and Xy is None:\n832 |         common_dtype = np.result_type(X.dtype, y.dtype)\n833 |         if y.ndim == 1:\n834 |             # Xy is 1d, make sure it is contiguous.\n835 |             Xy = np.empty(shape=n_features, dtype=common_dtype, order=\"C\")\n836 |             np.dot(X.T, y, out=Xy)\n837 |         else:\n838 |             # Make sure that Xy is always F contiguous even if X or y are not\n839 |             # contiguous: the goal is to make it fast to extract the data for a\n840 |             # specific target.\n841 |             n_targets = y.shape[1]\n842 |             Xy = np.empty(shape=(n_features, n_targets), dtype=common_dtype, order=\"F\")\n843 |             np.dot(y.T, X, out=Xy.T)\n844 | \n845 |     return X, y, X_offset, y_offset, X_scale, precompute, Xy\n```\n\nFound function `sklearn/utils/extmath.py:cartesian`.\nSource: Retrieved code content using keyword search (bm25).\n```\n793 | def cartesian(arrays