alues on the\n6318 |             passed MultiIndex level.\n6319 |         fill_value : None or float value, default None (NaN)\n6320 |             Fill existing missing (NaN) values, and any new element needed for\n6321 |             successful Series alignment, with this value before computation.\n6322 |             If data in both corresponding Series locations is missing\n6323 |             the result of filling (at that location) will be missing.\n6324 |         axis : {0 or 'index'}\n6325 |             Unused. Parameter needed for compatibility with DataFrame.\n6326 | \n6327 |         Returns\n6328 |         -------\n6329 |         Series\n6330 |             The result of the operation.\n6331 | \n6332 |         See Also\n6333 |         --------\n6334 |         Series.rmul : Reverse of the Multiplication operator, see\n6335 |             `Python documentation\n6336 |             <https://docs.python.org/3/reference/datamodel.html#emulating-numeric-types>`_\n6337 |             for more details.\n6338 | \n6339 |         Examples\n6340 |         --------\n6341 |         >>> a = pd.Series([1, 1, 1, np.nan], index=[\"a\", \"b\", \"c\", \"d\"])\n6342 |         >>> a\n6343 |         a    1.0\n6344 |         b    1.0\n6345 |         c    1.0\n6346 |         d    NaN\n6347 |         dtype: float64\n6348 |         >>> b = pd.Series([1, np.nan, 1, np.nan], index=[\"a\", \"b\", \"d\", \"e\"])\n6349 |         >>> b\n6350 |         a    1.0\n6351 |         b    NaN\n6352 |         d    1.0\n6353 |         e    NaN\n6354 |         dtype: float64\n6355 |         >>> a.multiply(b, fill_value=0)\n6356 |         a    1.0\n6357 |         b    0.0\n6358 |         c    0.0\n6359 |         d    0.0\n6360 |         e    NaN\n6361 |         dtype: float64\n6362 |         >>> a.mul(5, fill_value=0)\n6363 |         a    5.0\n6364 |         b    5.0\n6365 |         c    5.0\n6366 |         d    0.0\n6367 |         dtype: float64\n6368 |         \"\"\"\n6369 |         return self._flex_method(\n6370 |             other, operator.mul, level=level, fill_value=fill_value, axis=axis\n6371 |         )\n6372 | \n6373 |     multiply = mul\n6374 | \n6375 |     @Appender(ops.make_flex_doc(\"rmul\", \"series\"))\n6376 |     def rmul(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6377 |         return self._flex_method(\n6378 |             other, roperator.rmul, level=level, fill_value=fill_value, axis=axis\n6379 |         )\n6380 | \n6381 |     def truediv(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6382 |         \"\"\"\n6383 |         Return Floating division of series and other, \\\n6384 |         element-wise (binary operator `truediv`).\n6385 | \n6386 |         Equivalent to ``series / other``, but with support to substitute a\n6387 |         fill_value for missing data in either one of the inputs.\n6388 | \n6389 |         Parameters\n6390 |         ----------\n6391 |         other : Series or scalar value\n6392 |             Series with which to compute division.\n6393 |         level : int or name\n6394 |             Broadcast across a level, matching Index values on the\n6395 |             passed MultiIndex level.\n6396 |         fill_value : None or float value, default None (NaN)\n6397 |             Fill existing missing (NaN) values, and any new element needed for\n6398 |             successful Series alignment, with this value before computation.\n6399 |             If data in both corresponding Series locations is missing\n6400 |             the result of filling (at that location) will be missing.\n6401 |         axis : {0 or 'index'}\n6402 |             Unused. Parameter needed for compatibility with DataFrame.\n6403 | \n6404 |         Returns\n6405 |         -------\n6406 |         Series\n6407 |             The result of the operation.\n6408 | \n6409 |         See Also\n6410 |         --------\n6411 |         Series.rtruediv : Reverse of the Floating division operator, see\n6412 |             `Python documentation\n6413 |             <https://docs.python.org/3/reference/datamodel.html#emulating-numeric-types>`_\n6414 |             for more details.\n6415 | \n6416 |         Examples\n6417 |         --------\n6418 |         >>> a = pd.Series([1, 1, 1, np.nan], index=[\"a\", \"b\", \"c\", \"d\"])\n6419 |         >>> a\n6420 |         a    1.0\n6421 |         b    1.0\n6422 |         c    1.0\n6423 |         d    NaN\n6424 |         dtype: float64\n6425 |         >>> b = pd.Series([1, np.nan, 1, np.nan], index=[\"a\", \"b\", \"d\", \"e\"])\n6426 |         >>> b\n6427 |         a    1.0\n6428 |         b    NaN\n6429 |         d    1.0\n6430 |         e    NaN\n6431 |         dtype: float64\n6432 |         >>> a.divide(b, fill_value=0)\n6433 |         a    1.0\n6434 |         b    inf\n6435 |         c    inf\n6436 |         d    0.0\n6437 |         e    NaN\n6438 |         dtype: float64\n6439 |         \"\"\"\n6440 |         return self._flex_method(\n6441 |             other, operator.truediv, level=level, fill_value=fill_value, axis=axis\n6442 |         )\n6443 | \n6444 |     div = truediv\n6445 |     divide = truediv\n6446 | \n6447 |     @Appender(ops.make_flex_doc(\"rtruediv\", \"series\"))\n6448 |     def rtruediv(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6449 |         return self._flex_method(\n6450 |             other, roperator.rtruediv, level=level, fill_value=fill_value, axis=axis\n6451 |         )\n6452 | \n6453 |     rdiv = rtruediv\n6454 | \n6455 |     @Appender(ops.make_flex_doc(\"floordiv\", \"series\"))\n6456 |     def floordiv(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6457 |         return self._flex_method(\n6458 |             other, operator.floordiv, level=level, fill_value=fill_value, axis=axis\n6459 |         )\n6460 | \n6461 |     @Appender(ops.make_flex_doc(\"rfloordiv\", \"series\"))\n6462 |     def rfloordiv(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6463 |         return self._flex_method(\n6464 |             other, roperator.rfloordiv, level=level, fill_value=fill_value, axis=axis\n6465 |         )\n6466 | \n6467 |     def mod(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6468 |         \"\"\"\n6469 |         Return Modulo of series and other, element-wise (binary operator `mod`).\n6470 | \n6471 |         Equivalent to ``series % other``, but with support to substitute a\n6472 |         fill_value for missing data in either one of the inputs.\n6473 | \n6474 |         Parameters\n6475 |         ----------\n6476 |         other : Series or scalar value\n6477 |             Series with which to compute modulo.\n6478 |         level : int or name\n6479 |             Broadcast across a level, matching Index values on the\n6480 |             passed MultiIndex level.\n6481 |         fill_value : None or float value, default None (NaN)\n6482 |             Fill existing missing (NaN) values, and any new element needed for\n6483 |             successful Series alignment, with this value before computation.\n6484 |             If data in both corresponding Series locations is missing\n6485 |             the result of filling (at that location) will be missing.\n6486 |         axis : {0 or 'index'}\n6487 |             Unused. Parameter needed for compatibility with DataFrame.\n6488 | \n6489 |         Returns\n6490 |         -------\n6491 |         Series\n6492 |             The result of the operation.\n6493 | \n6494 |         See Also\n6495 |         --------\n6496 |         Series.rmod : Reverse of the Modulo operator, see\n6497 |             `Python documentation\n6498 |             <https://docs.python.org/3/reference/datamodel.html#emulating-numeric-types>`_\n6499 |             for more details.\n6500 | \n6501 |         Examples\n6502 |         --------\n6503 |         >>> a = pd.Series([1, 1, 1, np.nan], index=[\"a\", \"b\", \"c\", \"d\"])\n6504 |         >>> a\n6505 |         a    1.0\n6506 |         b    1.0\n6507 |         c    1.0\n6508 |         d    NaN\n6509 |         dtype: float64\n6510 |         >>> b = pd.Series([1, np.nan, 1, np.nan], index=[\"a\", \"b\", \"d\", \"e\"])\n6511 |         >>> b\n6512 |         a    1.0\n6513 |         b    NaN\n6514 |         d    1.0\n6515 |         e    NaN\n6516 |         dtype: float64\n6517 |         >>> a.mod(b, fill_value=0)\n6518 |         a    0.0\n6519 |         b    NaN\n6520 |         c    NaN\n6521 |         d    0.0\n6522 |         e    NaN\n6523 |         dtype: float64\n6524 |         \"\"\"\n6525 |         return self._flex_method(\n6526 |             other, operator.mod, level=level, fill_value=fill_value, axis=axis\n6527 |         )\n6528 | \n6529 |     @Appender(ops.make_flex_doc(\"rmod\", \"series\"))\n6530 |     def rmod(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6531 |         return self._flex_method(\n6532 |             other, roperator.rmod, level=level, fill_value=fill_value, axis=axis\n6533 |         )\n6534 | \n6535 |     @Appender(ops.make_flex_doc(\"pow\", \"series\"))\n6536 |     def pow(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6537 |         return self._flex_method(\n6538 |             other, operator.pow, level=level, fill_value=fill_value, axis=axis\n6539 |         )\n6540 | \n6541 |     @Appender(ops.make_flex_doc(\"rpow\", \"series\"))\n6542 |     def rpow(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6543 |         return self._flex_method(\n6544 |             other, roperator.rpow, level=level, fill_value=fill_value, axis=axis\n6545 |         )\n6546 | \n6547 |     @Appender(ops.make_flex_doc(\"divmod\", \"series\"))\n6548 |     def divmod(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6549 |         return self._flex_method(\n6550 |             other, divmod, level=level, fill_value=fill_value, axis=axis\n6551 |         )\n6552 | \n6553 |     @Appender(ops.make_flex_doc(\"rdivmod\", \"series\"))\n6554 |     def rdivmod(self, other, level=None, fill_value=None, axis: Axis = 0) -> Series:\n6555 |         return self._flex_method(\n6556 |             other, roperator.rdivmod, level=level, fill_value=fill_value, axis=axis\n6557 |         )\n6558 | \n6559 |     # ----------------------------------------------------------------------\n6560 |     # Reductions\n6561 | \n6562 |     def _reduce(\n6563 |         self,\n6564 |         op,\n6565 |         # error: Variable \"pandas.core.series.Series.str\" is not valid as a type\n6566 |         name: str,  # type: ignore[valid-type]\n6567 |         *,\n6568 |         axis: Axis = 0,\n6569 |         skipna: bool = True,\n6570 |         numeric_only: bool = False,\n6571 |         filter_type=None,\n6572 |         **kwds,\n6573 |     ):\n6574 |         \"\"\"\n6575 |         Perform a reduction operation.\n6576 | \n6577 |         If we have an ndarray as a value, then simply perform the operation,\n6578 |         otherwise delegate to the object.\n6579 |         \"\"\"\n6580 |         delegate = self._values\n6581 | \n6582 |         if axis is not None:\n6583 |             self._get_axis_number(axis)\n6584 | \n6585 |         if isinstance(delegate, ExtensionArray):\n6586 |             # dispatch to ExtensionArray interface\n6587 |             return delegate._reduce(name, skipna=skipna, **kwds)\n6588 | \n6589 |         else:\n6590 |             # dispatch to numpy arrays\n6591 |             if numeric_only and self.dtype.kind not in \"iufcb\":\n6592 |                 # i.e. not is_numeric_dtype(self.dtype)\n6593 |                 kwd_name = \"numeric_only\"\n6594 |                 if name in [\"any\", \"all\"]:\n6595 |                     kwd_name = \"bool_only\"\n6596 |                 # GH#47500 - change to TypeError to match other methods\n6597 |                 raise TypeError(\n6598 |                     f\"Series.{name} does not allow {kwd_name}={numeric_only} \"\n6599 |                     \"with non-numeric dtypes.\"\n6600 |                 )\n6601 |             return op(delegate, skipna=skipna, **kwds)\n6602 | \n6603 |     @Appender(make_doc(\"any\", ndim=1))\n6604 |     # error: Signature of \"any\" incompatible with supertype \"NDFrame\"\n6605 |     def any(  # type: ignore[override]\n6606 |         self,\n6607 |         *,\n6608 |         axis: Axis = 0,\n6609 |         bool_only: bool = False,\n6610 |         skipna: bool = True,\n6611 |         **kwargs,\n6612 |     ) -> bool:\n6613 |         nv.validate_logical_func((), kwargs, fname=\"any\")\n6614 |         validate_bool_kwarg(skipna, \"skipna\", none_allowed=False)\n6615 |         return self._reduce(\n6616 |             nanops.nanany,\n6617 |             name=\"any\",\n6618 |             axis=axis,\n6619 |             numeric_only=bool_only,\n6620 |             skipna=skipna,\n6621 |             filter_type=\"bool\",\n6622 |         )\n6623 | \n6624 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"all\")\n6625 |     @Appender(make_doc(\"all\", ndim=1))\n6626 |     def all(\n6627 |         self,\n6628 |         axis: Axis = 0,\n6629 |         bool_only: bool = False,\n6630 |         skipna: bool = True,\n6631 |         **kwargs,\n6632 |     ) -> bool:\n6633 |         nv.validate_logical_func((), kwargs, fname=\"all\")\n6634 |         validate_bool_kwarg(skipna, \"skipna\", none_allowed=False)\n6635 |         return self._reduce(\n6636 |             nanops.nanall,\n6637 |             name=\"all\",\n6638 |             axis=axis,\n6639 |             numeric_only=bool_only,\n6640 |             skipna=skipna,\n6641 |             filter_type=\"bool\",\n6642 |         )\n6643 | \n6644 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"min\")\n6645 |     def min(\n6646 |         self,\n6647 |         axis: Axis | None = 0,\n6648 |         skipna: bool = True,\n6649 |         numeric_only: bool = False,\n6650 |         **kwargs,\n6651 |     ):\n6652 |         \"\"\"\n6653 |         Return the minimum of the values over the requested axis.\n6654 | \n6655 |         If you want the *index* of the minimum, use ``idxmin``.\n6656 |         This is the equivalent of the ``numpy.ndarray`` method ``argmin``.\n6657 | \n6658 |         Parameters\n6659 |         ----------\n6660 |         axis : {index (0)}\n6661 |             Axis for the function to be applied on.\n6662 |             For `Series` this parameter is unused and defaults to 0.\n6663 | \n6664 |             For DataFrames, specifying ``axis=None`` will apply the aggregation\n6665 |             across both axes.\n6666 | \n6667 |             .. versionadded:: 2.0.0\n6668 | \n6669 |         skipna : bool, default True\n6670 |             Exclude NA/null values when computing the result.\n6671 |         numeric_only : bool, default False\n6672 |             Include only float, int, boolean columns.\n6673 |         **kwargs\n6674 |             Additional keyword arguments to be passed to the function.\n6675 | \n6676 |         Returns\n6677 |         -------\n6678 |         scalar or Series (if level specified)\n6679 |             The minimum of the values in the Series.\n6680 | \n6681 |         See Also\n6682 |         --------\n6683 |         numpy.min : Equivalent numpy function for arrays.\n6684 |         Series.min : Return the minimum.\n6685 |         Series.max : Return the maximum.\n6686 |         Series.idxmin : Return the index of the minimum.\n6687 |         Series.idxmax : Return the index of the maximum.\n6688 |         DataFrame.min : Return the minimum over the requested axis.\n6689 |         DataFrame.max : Return the maximum over the requested axis.\n6690 |         DataFrame.idxmin : Return the index of the minimum over the requested axis.\n6691 |         DataFrame.idxmax : Return the index of the maximum over the requested axis.\n6692 | \n6693 |         Examples\n6694 |         --------\n6695 |         >>> idx = pd.MultiIndex.from_arrays(\n6696 |         ...     [[\"warm\", \"warm\", \"cold\", \"cold\"], [\"dog\", \"falcon\", \"fish\", \"spider\"]],\n6697 |         ...     names=[\"blooded\", \"animal\"],\n6698 |         ... )\n6699 |         >>> s = pd.Series([4, 2, 0, 8], name=\"legs\", index=idx)\n6700 |         >>> s\n6701 |         blooded  animal\n6702 |         warm     dog       4\n6703 |                  falcon    2\n6704 |         cold     fish      0\n6705 |                  spider    8\n6706 |         Name: legs, dtype: int64\n6707 | \n6708 |         >>> s.min()\n6709 |         0\n6710 |         \"\"\"\n6711 |         return NDFrame.min(\n6712 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n6713 |         )\n6714 | \n6715 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"max\")\n6716 |     def max(\n6717 |         self,\n6718 |         axis: Axis | None = 0,\n6719 |         skipna: bool = True,\n6720 |         numeric_only: bool = False,\n6721 |         **kwargs,\n6722 |     ):\n6723 |         \"\"\"\n6724 |         Return the maximum of the values over the requested axis.\n6725 | \n6726 |         If you want the *index* of the maximum, use ``idxmax``.\n6727 |         This is the equivalent of the ``numpy.ndarray`` method ``argmax``.\n6728 | \n6729 |         Parameters\n6730 |         ----------\n6731 |         axis : {index (0)}\n6732 |             Axis for the function to be applied on.\n6733 |             For `Series` this parameter is unused and defaults to 0.\n6734 | \n6735 |             For DataFrames, specifying ``axis=None`` will apply the aggregation\n6736 |             across both axes.\n6737 | \n6738 |             .. versionadded:: 2.0.0\n6739 | \n6740 |         skipna : bool, default True\n6741 |             Exclude NA/null values when computing the result.\n6742 |         numeric_only : bool, default False\n6743 |             Include only float, int, boolean columns.\n6744 |         **kwargs\n6745 |             Additional keyword arguments to be passed to the function.\n6746 | \n6747 |         Returns\n6748 |         -------\n6749 |         scalar or Series (if level specified)\n6750 |             The maximum of the values in the Series.\n6751 | \n6752 |         See Also\n6753 |         --------\n6754 |         numpy.max : Equivalent numpy function for arrays.\n6755 |         Series.min : Return the minimum.\n6756 |         Series.max : Return the maximum.\n6757 |         Series.idxmin : Return the index of the minimum.\n6758 |         Series.idxmax : Return the index of the maximum.\n6759 |         DataFrame.min : Return the minimum over the requested axis.\n6760 |         DataFrame.max : Return the maximum over the requested axis.\n6761 |         DataFrame.idxmin : Return the index of the minimum over the requested axis.\n6762 |         DataFrame.idxmax : Return the index of the maximum over the requested axis.\n6763 | \n6764 |         Examples\n6765 |         --------\n6766 |         >>> idx = pd.MultiIndex.from_arrays(\n6767 |         ...     [[\"warm\", \"warm\", \"cold\", \"cold\"], [\"dog\", \"falcon\", \"fish\", \"spider\"]],\n6768 |         ...     names=[\"blooded\", \"animal\"],\n6769 |         ... )\n6770 |         >>> s = pd.Series([4, 2, 0, 8], name=\"legs\", index=idx)\n6771 |         >>> s\n6772 |         blooded  animal\n6773 |         warm     dog       4\n6774 |                  falcon    2\n6775 |         cold     fish      0\n6776 |                  spider    8\n6777 |         Name: legs, dtype: int64\n6778 | \n6779 |         >>> s.max()\n6780 |         8\n6781 |         \"\"\"\n6782 |         return NDFrame.max(\n6783 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n6784 |         )\n6785 | \n6786 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"sum\")\n6787 |     def sum(\n6788 |         self,\n6789 |         axis: Axis | None = None,\n6790 |         skipna: bool = True,\n6791 |         numeric_only: bool = False,\n6792 |         min_count: int = 0,\n6793 |         **kwargs,\n6794 |     ):\n6795 |         \"\"\"\n6796 |         Return the sum of the values over the requested axis.\n6797 | \n6798 |         This is equivalent to the method ``numpy.sum``.\n6799 | \n6800 |         Parameters\n6801 |         ----------\n6802 |         axis : {index (0)}\n6803 |             Axis for the function to be applied on.\n6804 |             For `Series` this parameter is unused and defaults to 0.\n6805 | \n6806 |             .. warning::\n6807 | \n6808 |                 The behavior of DataFrame.sum with ``axis=None`` is deprecated,\n6809 |                 in a future version this will reduce over both axes and return a scalar\n6810 |                 To retain the old behavior, pass axis=0 (or do not pass axis).\n6811 | \n6812 |             .. versionadded:: 2.0.0\n6813 | \n6814 |         skipna : bool, default True\n6815 |             Exclude NA/null values when computing the result.\n6816 |         numeric_only : bool, default False\n6817 |             Include only float, int, boolean columns. Not implemented for Series.\n6818 | \n6819 |         min_count : int, default 0\n6820 |             The required number of valid values to perform the operation. If fewer than\n6821 |             ``min_count`` non-NA values are present the result will be NA.\n6822 |         **kwargs\n6823 |             Additional keyword arguments to be passed to the function.\n6824 | \n6825 |         Returns\n6826 |         -------\n6827 |         scalar or Series (if level specified)\n6828 |             Sum of the values for the requested axis.\n6829 | \n6830 |         See Also\n6831 |         --------\n6832 |         numpy.sum : Equivalent numpy function for computing sum.\n6833 |         Series.mean : Mean of the values.\n6834 |         Series.median : Median of the values.\n6835 |         Series.std : Standard deviation of the values.\n6836 |         Series.var : Variance of the values.\n6837 |         Series.min : Minimum value.\n6838 |         Series.max : Maximum value.\n6839 | \n6840 |         Examples\n6841 |         --------\n6842 |         >>> idx = pd.MultiIndex.from_arrays(\n6843 |         ...     [[\"warm\", \"warm\", \"cold\", \"cold\"], [\"dog\", \"falcon\", \"fish\", \"spider\"]],\n6844 |         ...     names=[\"blooded\", \"animal\"],\n6845 |         ... )\n6846 |         >>> s = pd.Series([4, 2, 0, 8], name=\"legs\", index=idx)\n6847 |         >>> s\n6848 |         blooded  animal\n6849 |         warm     dog       4\n6850 |                  falcon    2\n6851 |         cold     fish      0\n6852 |                  spider    8\n6853 |         Name: legs, dtype: int64\n6854 | \n6855 |         >>> s.sum()\n6856 |         14\n6857 | \n6858 |         By default, the sum of an empty or all-NA Series is ``0``.\n6859 | \n6860 |         >>> pd.Series([], dtype=\"float64\").sum()  # min_count=0 is the default\n6861 |         0.0\n6862 | \n6863 |         This can be controlled with the ``min_count`` parameter. For example, if\n6864 |         you'd like the sum of an empty series to be NaN, pass ``min_count=1``.\n6865 | \n6866 |         >>> pd.Series([], dtype=\"float64\").sum(min_count=1)\n6867 |         nan\n6868 | \n6869 |         Thanks to the ``skipna`` parameter, ``min_count`` handles all-NA and\n6870 |         empty series identically.\n6871 | \n6872 |         >>> pd.Series([np.nan]).sum()\n6873 |         0.0\n6874 | \n6875 |         >>> pd.Series([np.nan]).sum(min_count=1)\n6876 |         nan\n6877 |         \"\"\"\n6878 |         return NDFrame.sum(\n6879 |             self,\n6880 |             axis=axis,\n6881 |             skipna=skipna,\n6882 |             numeric_only=numeric_only,\n6883 |             min_count=min_count,\n6884 |             **kwargs,\n6885 |         )\n6886 | \n6887 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"prod\")\n6888 |     @doc(make_doc(\"prod\", ndim=1))\n6889 |     def prod(\n6890 |         self,\n6891 |         axis: Axis | None = None,\n6892 |         skipna: bool = True,\n6893 |         numeric_only: bool = False,\n6894 |         min_count: int = 0,\n6895 |         **kwargs,\n6896 |     ):\n6897 |         return NDFrame.prod(\n6898 |             self,\n6899 |             axis=axis,\n6900 |             skipna=skipna,\n6901 |             numeric_only=numeric_only,\n6902 |             min_count=min_count,\n6903 |             **kwargs,\n6904 |         )\n6905 | \n6906 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"mean\")\n6907 |     def mean(\n6908 |         self,\n6909 |         axis: Axis | None = 0,\n6910 |         skipna: bool = True,\n6911 |         numeric_only: bool = False,\n6912 |         **kwargs,\n6913 |     ) -> Any:\n6914 |         \"\"\"\n6915 |         Return the mean of the values over the requested axis.\n6916 | \n6917 |         Parameters\n6918 |         ----------\n6919 |         axis : {index (0)}\n6920 |             Axis for the function to be applied on.\n6921 |             For `Series` this parameter is unused and defaults to 0.\n6922 | \n6923 |             For DataFrames, specifying ``axis=None`` will apply the aggregation\n6924 |             across both axes.\n6925 | \n6926 |             .. versionadded:: 2.0.0\n6927 | \n6928 |         skipna : bool, default True\n6929 |             Exclude NA/null values when computing the result.\n6930 |         numeric_only : bool, default False\n6931 |             Include only float, int, boolean columns.\n6932 |         **kwargs\n6933 |             Additional keyword arguments to be passed to the function.\n6934 | \n6935 |         Returns\n6936 |         -------\n6937 |         scalar or Series (if level specified)\n6938 |             Mean of the values for the requested axis.\n6939 | \n6940 |         See Also\n6941 |         --------\n6942 |         numpy.median : Equivalent numpy function for computing median.\n6943 |         Series.sum : Sum of the values.\n6944 |         Series.median : Median of the values.\n6945 |         Series.std : Standard deviation of the values.\n6946 |         Series.var : Variance of the values.\n6947 |         Series.min : Minimum value.\n6948 |         Series.max : Maximum value.\n6949 | \n6950 |         Examples\n6951 |         --------\n6952 |         >>> s = pd.Series([1, 2, 3])\n6953 |         >>> s.mean()\n6954 |         2.0\n6955 |         \"\"\"\n6956 |         return NDFrame.mean(\n6957 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n6958 |         )\n6959 | \n6960 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"median\")\n6961 |     def median(\n6962 |         self,\n6963 |         axis: Axis | None = 0,\n6964 |         skipna: bool = True,\n6965 |         numeric_only: bool = False,\n6966 |         **kwargs,\n6967 |     ) -> Any:\n6968 |         \"\"\"\n6969 |         Return the median of the values over the requested axis.\n6970 | \n6971 |         Parameters\n6972 |         ----------\n6973 |         axis : {index (0)}\n6974 |             Axis for the function to be applied on.\n6975 |             For `Series` this parameter is unused and defaults to 0.\n6976 | \n6977 |             For DataFrames, specifying ``axis=None`` will apply the aggregation\n6978 |             across both axes.\n6979 | \n6980 |             .. versionadded:: 2.0.0\n6981 | \n6982 |         skipna : bool, default True\n6983 |             Exclude NA/null values when computing the result.\n6984 |         numeric_only : bool, default False\n6985 |             Include only float, int, boolean columns.\n6986 |         **kwargs\n6987 |             Additional keyword arguments to be passed to the function.\n6988 | \n6989 |         Returns\n6990 |         -------\n6991 |         scalar or Series (if level specified)\n6992 |             Median of the values for the requested axis.\n6993 | \n6994 |         See Also\n6995 |         --------\n6996 |         numpy.median : Equivalent numpy function for computing median.\n6997 |         Series.sum : Sum of the values.\n6998 |         Series.median : Median of the values.\n6999 |         Series.std : Standard deviation of the values.\n7000 |         Series.var : Variance of the values.\n7001 |         Series.min : Minimum value.\n7002 |         Series.max : Maximum value.\n7003 | \n7004 |         Examples\n7005 |         --------\n7006 |         >>> s = pd.Series([1, 2, 3])\n7007 |         >>> s.median()\n7008 |         2.0\n7009 | \n7010 |         With a DataFrame\n7011 | \n7012 |         >>> df = pd.DataFrame({\"a\": [1, 2], \"b\": [2, 3]}, index=[\"tiger\", \"zebra\"])\n7013 |         >>> df\n7014 |                a   b\n7015 |         tiger  1   2\n7016 |         zebra  2   3\n7017 |         >>> df.median()\n7018 |         a   1.5\n7019 |         b   2.5\n7020 |         dtype: float64\n7021 | \n7022 |         Using axis=1\n7023 | \n7024 |         >>> df.median(axis=1)\n7025 |         tiger   1.5\n7026 |         zebra   2.5\n7027 |         dtype: float64\n7028 | \n7029 |         In this case, `numeric_only` should be set to `True`\n7030 |         to avoid getting an error.\n7031 | \n7032 |         >>> df = pd.DataFrame({\"a\": [1, 2], \"b\": [\"T\", \"Z\"]}, index=[\"tiger\", \"zebra\"])\n7033 |         >>> df.median(numeric_only=True)\n7034 |         a   1.5\n7035 |         dtype: float64\n7036 |         \"\"\"\n7037 |         return NDFrame.median(\n7038 |             self, axis=axis, skipna=skipna, numeric_only=numeric_only, **kwargs\n7039 |         )\n7040 | \n7041 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"sem\")\n7042 |     @doc(make_doc(\"sem\", ndim=1))\n7043 |     def sem(\n7044 |         self,\n7045 |         axis: Axis | None = None,\n7046 |         skipna: bool = True,\n7047 |         ddof: int = 1,\n7048 |         numeric_only: bool = False,\n7049 |         **kwargs,\n7050 |     ):\n7051 |         return NDFrame.sem(\n7052 |             self,\n7053 |             axis=axis,\n7054 |             skipna=skipna,\n7055 |             ddof=ddof,\n7056 |             numeric_only=numeric_only,\n7057 |             **kwargs,\n7058 |         )\n7059 | \n7060 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"var\")\n7061 |     def var(\n7062 |         self,\n7063 |         axis: Axis | None = None,\n7064 |         skipna: bool = True,\n7065 |         ddof: int = 1,\n7066 |         numeric_only: bool = False,\n7067 |         **kwargs,\n7068 |     ):\n7069 |         \"\"\"\n7070 |         Return unbiased variance over requested axis.\n7071 | \n7072 |         Normalized by N-1 by default. This can be changed using the ddof argument.\n7073 | \n7074 |         Parameters\n7075 |         ----------\n7076 |         axis : {index (0)}\n7077 |             For `Series` this parameter is unused and defaults to 0.\n7078 | \n7079 |             .. warning::\n7080 | \n7081 |                 The behavior of DataFrame.var with ``axis=None`` is deprecated,\n7082 |                 in a future version this will reduce over both axes and return a scalar\n7083 |                 To retain the old behavior, pass axis=0 (or do not pass axis).\n7084 | \n7085 |         skipna : bool, default True\n7086 |             Exclude NA/null values. If an entire row/column is NA, the result\n7087 |             will be NA.\n7088 |         ddof : int, default 1\n7089 |             Delta Degrees of Freedom. The divisor used in calculations is N - ddof,\n7090 |             where N represents the number of elements.\n7091 |         numeric_only : bool, default False\n7092 |             Include only float, int, boolean columns. Not implemented for Series.\n7093 |         **kwargs :\n7094 |             Additional keywords passed.\n7095 | \n7096 |         Returns\n7097 |         -------\n7098 |         scalar or Series (if level specified)\n7099 |             Unbiased variance over requested axis.\n7100 | \n7101 |         See Also\n7102 |         --------\n7103 |         numpy.var : Equivalent function in NumPy.\n7104 |         Series.std : Returns the standard deviation of the Series.\n7105 |         DataFrame.var : Returns the variance of the DataFrame.\n7106 |         DataFrame.std : Return standard deviation of the values over\n7107 |             the requested axis.\n7108 | \n7109 |         Examples\n7110 |         --------\n7111 |         >>> df = pd.DataFrame(\n7112 |         ...     {\n7113 |         ...         \"person_id\": [0, 1, 2, 3],\n7114 |         ...         \"age\": [21, 25, 62, 43],\n7115 |         ...         \"height\": [1.61, 1.87, 1.49, 2.01],\n7116 |         ...     }\n7117 |         ... ).set_index(\"person_id\")\n7118 |         >>> df\n7119 |                    age  height\n7120 |         person_id\n7121 |         0           21    1.61\n7122 |         1           25    1.87\n7123 |         2           62    1.49\n7124 |         3           43    2.01\n7125 | \n7126 |         >>> df.var()\n7127 |         age       352.916667\n7128 |         height      0.056367\n7129 |         dtype: float64\n7130 | \n7131 |         Alternatively, ``ddof=0`` can be set to normalize by N instead of N-1:\n7132 | \n7133 |         >>> df.var(ddof=0)\n7134 |         age       264.687500\n7135 |         height      0.042275\n7136 |         dtype: float64\n7137 |         \"\"\"\n7138 |         return NDFrame.var(\n7139 |             self,\n7140 |             axis=axis,\n7141 |             skipna=skipna,\n7142 |             ddof=ddof,\n7143 |             numeric_only=numeric_only,\n7144 |             **kwargs,\n7145 |         )\n7146 | \n7147 |     @deprecate_nonkeyword_arguments(version=\"4.0\", allowed_args=[\"self\"], name=\"std\")\n7148 |     @doc(make_doc(\"std\", ndim=1))\n7149 |     def std(\n7150 |         self,\n7151 |         axis: Axis | None = None,\n7152 |    