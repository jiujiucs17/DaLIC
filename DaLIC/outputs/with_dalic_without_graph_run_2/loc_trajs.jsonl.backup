lf):\n 91 |         \"\"\"Specify kind str. Must be overridden in child class\"\"\"\n 92 |         raise NotImplementedError\n 93 | \n 94 |     _layout_type = \"vertical\"\n 95 |     _default_rot = 0\n 96 |     orientation: str | None = None\n 97 | \n 98 |     axes: np.ndarray  # of Axes objects\n 99 | \n100 |     def __init__(\n101 |         self,\n102 |         data,\n103 |         kind=None,\n104 |         by: IndexLabel | None = None,\n105 |         subplots=False,\n106 |         sharex=None,\n107 |         sharey=False,\n108 |         use_index=True,\n109 |         figsize=None,\n110 |         grid=None,\n111 |         legend=True,\n112 |         rot=None,\n113 |         ax=None,\n114 |         fig=None,\n115 |         title=None,\n116 |         xlim=None,\n117 |         ylim=None,\n118 |         xticks=None,\n119 |         yticks=None,\n120 |         xlabel: Hashable | None = None,\n121 |         ylabel: Hashable | None = None,\n122 |         sort_columns=False,\n123 |         fontsize=None,\n124 |         secondary_y=False,\n125 |         colormap=None,\n126 |         table=False,\n127 |         layout=None,\n128 |         include_bool=False,\n129 |         column: IndexLabel | None = None,\n130 |         **kwds,\n131 |     ) -> None:\n132 | \n133 |         import matplotlib.pyplot as plt\n134 | \n135 |         self.data = data\n136 | \n137 |         # if users assign an empty list or tuple, raise `ValueError`\n138 |         # similar to current `df.box` and `df.hist` APIs.\n139 |         if by in ([], ()):\n140 |             raise ValueError(\"No group keys passed!\")\n141 |         self.by = com.maybe_make_list(by)\n142 | \n143 |         # Assign the rest of columns into self.columns if by is explicitly defined\n144 |         # while column is not, only need `columns` in hist/box plot when it's DF\n145 |         # TODO: Might deprecate `column` argument in future PR (#28373)\n146 |         if isinstance(data, DataFrame):\n147 |             if column:\n148 |                 self.columns = com.maybe_make_list(column)\n149 |             else:\n150 |                 if self.by is None:\n151 |                     self.columns = [\n152 |                         col for col in data.columns if is_numeric_dtype(data[col])\n153 |                     ]\n154 |                 else:\n155 |                     self.columns = [\n156 |                         col\n157 |                         for col in data.columns\n158 |                         if col not in self.by and is_numeric_dtype(data[col])\n159 |                     ]\n160 | \n161 |         # For `hist` plot, need to get grouped original data before `self.data` is\n162 |         # updated later\n163 |         if self.by is not None and self._kind == \"hist\":\n164 |             self._grouped = data.groupby(self.by)\n165 | \n166 |         self.kind = kind\n167 | \n168 |         self.sort_columns = sort_columns\n169 | \n170 |         self.subplots = subplots\n171 | \n172 |         if sharex is None:\n173 | \n174 |             # if by is defined, subplots are used and sharex should be False\n175 |             if ax is None and by is None:\n176 |                 self.sharex = True\n177 |             else:\n178 |                 # if we get an axis, the users should do the visibility\n179 |                 # setting...\n180 |                 self.sharex = False\n181 |         else:\n182 |             self.sharex = sharex\n183 | \n184 |         self.sharey = sharey\n185 |         self.figsize = figsize\n186 |         self.layout = layout\n187 | \n188 |         self.xticks = xticks\n189 |         self.yticks = yticks\n190 |         self.xlim = xlim\n191 |         self.ylim = ylim\n192 |         self.title = title\n193 |         self.use_index = use_index\n194 |         self.xlabel = xlabel\n195 |         self.ylabel = ylabel\n196 | \n197 |         self.fontsize = fontsize\n198 | \n199 |         if rot is not None:\n200 |             self.rot = rot\n201 |             # need to kno