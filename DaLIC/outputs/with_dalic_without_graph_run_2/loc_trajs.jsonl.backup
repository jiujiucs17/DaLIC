 |         Whether to limit filling to outside or inside the outer most non-NA value.\n 977 |     \"\"\"\n 978 |     neg_mask = ~mask\n 979 |     first = neg_mask.argmax()\n 980 |     last = len(neg_mask) - neg_mask[::-1].argmax() - 1\n 981 |     if limit_area == \"inside\":\n 982 |         mask[:first] = False\n 983 |         mask[last + 1 :] = False\n 984 |     elif limit_area == \"outside\":\n 985 |         mask[first + 1 : last] = False\n 986 | \n 987 | \n 988 | def _fill_limit_area_2d(\n 989 |     mask: npt.NDArray[np.bool_], limit_area: Literal[\"outside\", \"inside\"]\n 990 | ) -> None:\n 991 |     \"\"\"Prepare 2d mask for ffill/bfill with limit_area.\n 992 | \n 993 |     When called, mask will no longer faithfully represent when\n 994 |     the corresponding are NA or not.\n 995 | \n 996 |     Parameters\n 997 |     ----------\n 998 |     mask : np.ndarray[bool, ndim=1]\n 999 |         Mask representing NA values when filling.\n1000 |     limit_area : { \"outside\", \"inside\" }\n1001 |         Whether to limit filling to outside or inside the outer most non-NA value.\n1002 |     \"\"\"\n1003 |     neg_mask = ~mask.T\n1004 |     if limit_area == \"outside\":\n1005 |         # Identify inside\n1006 |         la_mask = (\n1007 |             np.maximum.accumulate(neg_mask, axis=0)\n1008 |             & np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1009 |         )\n1010 |     else:\n1011 |         # Identify outside\n1012 |         la_mask = (\n1013 |             ~np.maximum.accumulate(neg_mask, axis=0)\n1014 |             | ~np.maximum.accumulate(neg_mask[::-1], axis=0)[::-1]\n1015 |         )\n1016 |     mask[la_mask.T] = False\n1017 | \n1018 | \n1019 | _fill_methods = {\"pad\": _pad_1d, \"backfill\": _backfill_1d}\n1020 | \n1021 | \n1022 | def get_fill_func(method, ndim: int = 1):\n1023 |     method = clean_fill_method(method)\n1024 |     if ndim == 1:\n1025 |         return _fill_methods[method]\n1026 |     return {\"pad\": _pad_2d, \"backfill\": _backfill_2d}[method]\n1027 | \n1028 | \n1029 | def clean_reindex_fill_method(method) -> ReindexMethod | None:\n1030 |     if method is None:\n1031 |         return None\n1032 |     return clean_fill_method(method, allow_nearest=True)\n1033 | \n1034 | \n1035 | def _interp_limit(\n1036 |     invalid: npt.NDArray[np.bool_], fw_limit: int | None, bw_limit: int | None\n1037 | ) -> np.ndarray:\n1038 |     \"\"\"\n1039 |     Get indexers of values that won't be filled\n1040 |     because they exceed the limits.\n1041 | \n1042 |     Parameters\n1043 |     ----------\n1044 |     invalid : np.ndarray[bool]\n1045 |     fw_limit : int or None\n1046 |         forward limit to index\n1047 |     bw_limit : int or None\n1048 |         backward limit to index\n1049 | \n1050 |     Returns\n1051 |     -------\n1052 |     set of indexers\n1053 | \n1054 |     Notes\n1055 |     -----\n1056 |     This is equivalent to the more readable, but slower\n1057 | \n1058 |     .. code-block:: python\n1059 | \n1060 |         def _interp_limit(invalid, fw_limit, bw_limit):\n1061 |             for x in np.where(invalid)[0]:\n1062 |                 if invalid[max(0, x - fw_limit) : x + bw_limit + 1].all():\n1063 |                     yield x\n1064 |     \"\"\"\n1065 |     # handle forward first; the backward direction is the same except\n1066 |     # 1. operate on the reversed array\n1067 |     # 2. subtract the returned indices from N - 1\n1068 |     N = len(invalid)\n1069 |     f_idx = np.array([], dtype=np.int64)\n1070 |     b_idx = np.array([], dtype=np.int64)\n1071 |     assume_unique = True\n1072 | \n1073 |     def inner(invalid, limit: int):\n1074 |         limit = min(limit, N)\n1075 |         windowed = np.lib.stride_tricks.sliding_window_view(invalid, limit + 1).all(1)\n1076 |         idx = np.union1d(\n1077 |             np.where(windowed)[0] + limit,\n1078 |             np.where((~invalid[: limit + 1]).cumsum() == 0)[0],\n1079 |         )\n1080 |         return idx\n1081 | \n1082 |     if fw_limit is not None:\n1083 |         if fw_limit == 0:\n1084 |             f_idx = np.where(invalid)[0]\n1085 |             assume_unique = False\n1086 |         else:\n1087 |             f_idx = inner(invalid, fw_limit)\n1088 | \n1089 |     if bw_limit is not None:\n1090 |         if bw_limit == 0:\n1091 |             # then we don't even need to care about backwards\n1092 |             # just use forwards\n1093 |             return f_idx\n1094 |         else:\n1095 |             b_idx = N - 1 - inner(invalid[::-1], bw_limit)\n1096 |             if fw_limit == 0:\n1097 |                 return b_idx\n1098 | \n1099 |     return np.intersect1d(f_idx, b_idx, assume_unique=assume_unique)\n1100 | \n```\n"}, {"content": "Let me also check the implementation in blocks.py since it contains core interpolation logic:\n\n<function=search_code_snippets>\n<parameter=search_terms>['pandas/core/internals/blocks.py']</parameter>\n", "role": "assistant", "tool_calls": null, "function_call": null}, {"role": "tool", "tool_call_id": "toolu_01", "name": "search_code_snippets", "content": "OBSERVATION:\n##Searching for term \"pandas/core/internals/blocks.py\"...\n### Search Result:\nFound file `pandas/core/internals/blocks.py`.\nSource: Exact match found for entity name `pandas/core/internals/blocks.py`.\n```\n   1 | from __future__ import annotations\n   2 | \n   3 | import inspect\n   4 | import re\n   5 | from typing import (\n   6 |     TYPE_CHECKING,\n   7 |     Any,\n   8 |     Literal,\n   9 |     cast,\n  10 |     final,\n  11 | )\n  12 | import warnings\n  13 | import weakref\n  14 | \n  15 | import numpy as np\n  16 | \n  17 | from pandas._libs import (\n  18 |     NaT,\n  19 |     internals as libinternals,\n  20 |     lib,\n  21 | )\n  22 | from pandas._libs.internals import (\n  23 |     BlockPlacement,\n  24 |     BlockValuesRefs,\n  25 | )\n  26 | from pandas._libs.missing import NA\n  27 | from pandas._typing import (\n  28 |     ArrayLike,\n  29 |     AxisInt,\n  30 |  