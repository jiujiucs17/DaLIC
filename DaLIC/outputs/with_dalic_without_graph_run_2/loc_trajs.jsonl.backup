rget vector.\n 32 | \n 33 |     epsilon : float\n 34 |         Robustness of the Huber estimator.\n 35 | \n 36 |     alpha : float\n 37 |         Regularization parameter.\n 38 | \n 39 |     sample_weight : ndarray of shape (n_samples,), default=None\n 40 |         Weight assigned to each sample.\n 41 | \n 42 |     Returns\n 43 |     -------\n 44 |     loss : float\n 45 |         Huber loss.\n 46 | \n 47 |     gradient : ndarray, shape (len(w))\n 48 |         Returns the derivative of the Huber loss with respect to each\n 49 |         coefficient, intercept and the scale as a vector.\n 50 |     \"\"\"\n 51 |     _, n_features = X.shape\n 52 |     fit_intercept = n_features + 2 == w.shape[0]\n 53 |     if fit_intercept:\n 54 |         intercept = w[-2]\n 55 |     sigma = w[-1]\n 56 |     w = w[:n_features]\n 57 |     n_samples = np.sum(sample_weight)\n 58 | \n 59 |     # Calculate the values where |y - X'w -c / sigma| > epsilon\n 60 |     # The values above this threshold are outliers.\n 61 |     linear_loss = y - safe_sparse_dot(X, w)\n 62 |     if fit_intercept:\n 63 |         linear_loss -= intercept\n 64 |     abs_linear_loss = np.abs(linear_loss)\n 65 |     outliers_mask = abs_linear_loss > epsilon * sigma\n 66 | \n 67 |     # Calculate the linear loss due to the outliers.\n 68 |     # This is equal to (2 * M * |y - X'w -c / sigma| - M**2) * sigma\n 69 |     outliers = abs_linear_loss[outliers_mask]\n 70 |     num_outliers = np.count_nonzero(outliers_mask)\n 71 |     n_non_outliers = X.shape[0] - num_outliers\n 72 | \n 73 |     # n_sq_outliers includes the weight give to the outliers while\n 74 |     # num_outliers is just the number of outliers.\n 75 |     outliers_sw = sample_weight[outliers_mask]\n 76 |     n_sw_outliers = np.sum(outliers_sw)\n 77 |     outlier_loss = (\n 78 |         2.0 * epsilon * np.sum(outliers_sw * outliers)\n 79 |         - sigma * n_sw_outliers * epsilon**2\n 80 |     )\n 81 | \n 82 |     # Calculate the quadratic loss due to the non-outliers.-\n 83 |     # This is equal to |(y - X'w - c)**2 / sigma**2| * sigma\n 84 |     non_outliers = linear_loss[~outliers_mask]\n 85 |     weighted_non_outliers = sample_weight[~outliers_mask] * non_outliers\n 86 |     weighted_loss = np.dot(weighted_non_outliers.T, non_outliers)\n 87 |     squared_loss = weighted_loss / sigma\n 88 | \n 89 |     if fit_intercept:\n 90 |         grad = np.zeros(n_features + 2)\n 91 |     else:\n 92 |         grad = np.zeros(n_features + 1)\n 93 | \n 94 |     # Gradient due to the squared loss.\n 95 |     X_non_outliers = -axis0_safe_slice(X, ~outliers_mask, n_non_outliers)\n 96 |     grad[:n_features] = (\n 97 |         2.0 / sigma * safe_sparse_dot(weighted_non_outliers, X_non_outliers)\n 98 |     )\n 99 | \n100 |     # Gradient due to the linear loss.\n101 |     signed_outliers = np.ones_like(outliers)\n102 |     signed_outliers_mask = linear_loss[outliers_mask] < 0\n103 |     signed_outliers[signed_outliers_mask] = -1.0\n104 |     X_outliers = axis0_safe_slice(X, outliers_mask, num_outliers)\n105 |     sw_outliers = sample_weight[outliers_mask] * signed_outliers\n106 |     grad[:n_features] -= 2.0 * epsilon * (safe_sparse_dot(sw_outliers, X_outliers))\n107 | \n108 |     # Gradient due to the penalty.\n109 |     grad[:n_features] += alpha * 2.0 * w\n110 | \n111 |     # Gradient due to sigma.\n112 |     grad[-1] = n_samples\n113 |     grad[-1] -= n_sw_outliers * epsilon**2\n114 |     grad[-1] -= squared_loss / sigma\n115 | \n116 |     # Gradient due to the intercept.\n117 |     if fit_intercept:\n118 |         grad[-2] = -2.0 * np.sum(weighted_non_outliers) / sigma\n119 |         grad[-2] -= 2.0 * epsilon * np.sum(sw_outliers)\n120 | \n121 |     loss = n_samples * sigma + squared_loss + outlier_loss\n122 |     loss += alpha * np.dot(w, w)\n123 |     return loss, grad\n```\n\nFound class `sklearn/svm/_classes.py:SVR`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass SVR(RegressorMixin, BaseLibSVM):\n\n    _impl = \"epsilon_svr\"\n\n    def __init__(\n        self,\n        *,\n        kernel=\"rbf\",\n        degree=3,\n        gamma=\"scale\",\n        coef0=0.0,\n        tol=1e-3,\n        C=1.0,\n        epsilon=0.1,\n        shrinking=True,\n        cache_size=200,\n        verbose=False,\n        max_iter=-1,\n    ):\n...\n    def _more_tags(self):\n\n```\nHint: Search `sklearn/svm/_classes.py:SVR` to get the full content if needed.\n\nFound class `sklearn/_loss/loss.py:PinballLoss`.\nSource: Retrieved entity using keyword search (bm25).\n```\n580 | class PinballLoss(BaseLoss):\n581 |     \"\"\"Quantile loss aka pinball loss, for regression.\n582 | \n583 |     Domain:\n584 |     y_true and y_pred all real numbers\n585 |     quantile in (0, 1)\n586 | \n587 |     Link:\n588 |     y_pred = raw_prediction\n589 | \n590 |     For a given sample x_i, the pinball loss is defined as::\n591 | \n592 |         loss(x_i) = rho_{quantile}(y_true_i - raw_prediction_i)\n593 | \n594 |         rho_{quantile}(u) = u * (quantile - 1_{u<0})\n595 |                           = -u *(1 - quantile)  if u < 0\n596 |                              u * quantile       if u >= 0\n597 | \n598 |     Note: 2 * PinballLoss(quantile=0.5) equals AbsoluteError().\n599 | \n600 |     Additional Attributes\n601 |     ---------------------\n602 |     quantile : float\n603 |         The quantile to be estimated. Must be in range (0, 1).\n604 |     \"\"\"\n605 | \n606 |     differentiable = False\n607 |     need_update_leaves_values = True\n608 | \n609 |     def __init__(self, sample_weight=None, quantile=0.5):\n610 |         check_scalar(\n611 |             quantile,\n612 |             \"quantile\",\n613 |             target_type=numbers.Real,\n614 |             min_val=0,\n615 |             max_val=1,\n616 |             include_boundaries=\"neither\",\n617 |         )\n618 |         super().__init__(\n619 |             closs=CyPinballLoss(quantile=float(quantile)),\n620 |             link=IdentityLink(),\n621 |         )\n622 |         self.approx_hessian = True\n623 |         self.constant_hessian = sample_weight is None\n624 | \n625 |     def fit_intercept_only(self, y_true, sample_weight=None):\n626 |         \"\"\"Compute raw_prediction of an intercept-only model.\n627 | \n628 |         This is the weighted median of the target, i.e. over the samples\n629 |         axis=0.\n630 |         \"\"\"\n631 |         if sample_weight is None:\n632 |             return np.percentile(y_true, 100 * self.closs.quantile, axis=0)\n633 |         else:\n634 |             return _weighted_percentile(\n635 |                 y_true, sample_weight, 100 * self.closs.quantile\n636 |             )\n```\n\nFound class `sklearn/_loss/loss.py:HalfPoissonLoss`.\nSource: Retrieved entity using keyword search (bm25).\n```\n639 | class HalfPoissonLoss(BaseLoss):\n640 |     \"\"\"Half Poisson deviance loss with log-link, for regression.\n641 | \n642 |     Domain:\n643 |     y_true in non-negative real numbers\n644 |     y_pred in positive real numbers\n645 | \n646 |     Link:\n647 |     y_pred = exp(raw_prediction)\n648 | \n649 |     For a given sample x_i, half the Poisson deviance is defined as::\n650 | \n651 |         loss(x_i) = y_true_i * log(y_true_i/exp(raw_prediction_i))\n652 |                     - y_true_i + exp(raw_prediction_i)\n653 | \n654 |     Half the Poisson deviance is actually the negative log-likelihood up to\n655 |     constant terms (not involving raw_prediction) and simplifies the\n656 |     computation of the gradients.\n657 |     We also skip the constant term `y_true_i * log(y_true_i) - y_true_i`.\n658 |     \"\"\"\n659 | \n660 |     def __init__(self, sample_weight=None):\n661 |         super().__init__(closs=CyHalfPoissonLoss(), link=LogLink())\n662 |         self.interval_y_true = Interval(0, np.inf, True, False)\n663 | \n664 |     def constant_to_optimal_zero(self, y_true, sample_weight=None):\n665 |         term = xlogy(y_true, y_true) - y_true\n666 |         if sample_weight is not None:\n667 |             term *= sample_weight\n668 |         return term\n```\n\nFound function `sklearn/linear_model/_huber.py:HuberRegressor.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n262 | def fit(self, X, y, sample_weight=None):\n263 |         \"\"\"Fit the model according to the given training data.\n264 | \n265 |         Parameters\n266 |         ----------\n267 |         X : array-like, shape (n_samples, n_features)\n268 |             Training vector, where `n_samples` is the number of samples and\n269 |             `n_features` is the number of features.\n270 | \n271 |         y : array-like, shape (n_samples,)\n272 |             Target vector relative to X.\n273 | \n274 |         sample_weight : array-like, shape (n_samples,)\n275 |             Weight given to each sample.\n276 | \n277 |         Returns\n278 |         -------\n279 |         self : object\n280 |             Fitted `HuberRegressor` estimator.\n281 |         \"\"\"\n282 |         X, y = self._validate_data(\n283 |             X,\n284 |             y,\n285 |             copy=False,\n286 |             accept_sparse=[\"csr\"],\n287 |             y_numeric=True,\n288 |             dtype=[np.float64, np.float32],\n289 |         )\n290 | \n291 |         sample_weight = _check_sample_weight(sample_weight, X)\n292 | \n293 |         if self.epsilon < 1.0:\n294 |             raise ValueError(\n295 |                 \"epsilon should be greater than or equal to 1.0, got %f\" % self.epsilon\n296 |             )\n297 | \n298 |         if self.warm_start and hasattr(self, \"coef_\"):\n299 |             parameters = np.concatenate((self.coef_, [self.intercept_, self.scale_]))\n300 |         else:\n301 |             if self.fit_intercept:\n302 |                 parameters = np.zeros(X.shape[1] + 2)\n303 |             else:\n304 |                 parameters = np.zeros(X.shape[1] + 1)\n305 |             # Make sure to initialize the scale parameter to a strictly\n306 |             # positive value:\n307 |             parameters[-1] = 1\n308 | \n309 |         # Sigma or the scale factor should be non-negative.\n310 |         # Setting it to be zero might cause undefined bounds hence we set it\n311 |         # to a value close to zero.\n312 |         bounds = np.tile([-np.inf, np.inf], (parameters.shape[0], 1))\n313 |         bounds[-1][0] = np.finfo(np.float64).eps * 10\n314 | \n315 |         opt_res = optimize.minimize(\n316 |             _huber_loss_and_gradient,\n317 |             parameters,\n318 |             method=\"L-BFGS-B\",\n319 |             jac=True,\n320 |             args=(X, y, self.epsilon, self.alpha, sample_weight),\n321 |             options={\"maxiter\": self.max_iter, \"gtol\": self.tol, \"iprint\": -1},\n322 |             bounds=bounds,\n323 |         )\n324 | \n325 |         parameters = opt_res.x\n326 | \n327 |         if opt_res.status == 2:\n328 |             raise ValueError(\n329 |                 \"HuberRegressor convergence failed: l-BFGS-b solver terminated with %s\"\n330 |                 % opt_res.message\n331 |             )\n332 |         self.n_iter_ = _check_optimize_result(\"lbfgs\", opt_res, self.max_iter)\n333 |         self.scale_ = parameters[-1]\n334 |         if self.fit_intercept:\n335 |             self.intercept_ = parameters[-2]\n336 |         else:\n337 |             self.intercept_ = 0.0\n338 |         self.coef_ = parameters[: X.shape[1]]\n339 | \n340 |         residual = np.abs(y - safe_sparse_dot(X, self.coef_) - self.intercept_)\n341 |         self.outliers_ = residual > self.scale_ * self.epsilon\n342 |         return self\n```\n\nFound function `sklearn/svm/_classes.py:SVR._more_tags`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1251 | def _more_tags(self):\n1252 |         return {\n1253 |             \"_xfail_checks\": {\n1254 |                 \"check_sample_weights_