n1967 | \n1968 |         # perform several inits with random subsets\n1969 |         best_inertia = None\n1970 |         for init_idx in range(self._n_init):\n1971 |             if self.verbose:\n1972 |                 print(f\"Init {init_idx + 1}/{self._n_init} with method {init}\")\n1973 | \n1974 |             # Initialize the centers using only a fraction of the data as we\n1975 |             # expect n_samples to be very large when using MiniBatchKMeans.\n1976 |             cluster_centers = self._init_centroids(\n1977 |                 X,\n1978 |                 x_squared_norms=x_squared_norms,\n1979 |                 init=init,\n1980 |                 random_state=random_state,\n1981 |                 init_size=self._init_size,\n1982 |             )\n1983 | \n1984 |             # Compute inertia on a validation set.\n1985 |             _, inertia = _labels_inertia_threadpool_limit(\n1986 |                 X_valid,\n1987 |                 sample_weight_valid,\n1988 |                 x_squared_norms_valid,\n1989 |                 cluster_centers,\n1990 |                 n_threads=self._n_threads,\n1991 |             )\n1992 | \n1993 |             if self.verbose:\n1994 |                 print(f\"Inertia for init {init_idx + 1}/{self._n_init}: {inertia}\")\n1995 |             if best_inertia is None or inertia < best_inertia:\n1996 |                 init_centers = cluster_centers\n1997 |                 best_inertia = inertia\n1998 | \n1999 |         centers = init_centers\n2000 |         centers_new = np.empty_like(centers)\n2001 | \n2002 |         # Initialize counts\n2003 |         self._counts = np.zeros(self.n_clusters, dtype=X.dtype)\n2004 | \n2005 |         # Attributes to monitor the convergence\n2006 |         self._ewa_inertia = None\n2007 |         self._ewa_inertia_min = None\n2008 |         self._no_improvement = 0\n2009 | \n2010 |         # Initialize number of samples seen since last reassignment\n2011 |         self._n_since_last_reassign = 0\n2012 | \n2013 |         n_steps = (self.max_iter * n_samples) // self._batch_size\n2014 | \n2015 |         with threadpool_limits(limits=1, user_api=\"blas\"):\n2016 |             # Perform the iterative optimization until convergence\n2017 |             for i in range(n_steps):\n2018 |                 # Sample a minibatch from the full dataset\n2019 |                 minibatch_indices = random_state.randint(0, n_samples, self._batch_size)\n2020 | \n2021 |                 # Perform the actual update step on the minibatch data\n2022 |                 batch_inertia = _mini_batch_step(\n2023 |                     X=X[minibatch_indices],\n2024 |                     x_squared_norms=x_squared_norms[minibatch_indices],\n2025 |                     sample_weight=sample_weight[minibatch_indices],\n2026 |                     centers=centers,\n2027 |                     centers_new=centers_new,\n2028 |                     weight_sums=self._counts,\n2029 |                     random_state=random_state,\n2030 |                     random_reassign=self._random_reassign(),\n2031 |                     reassignment_ratio=self.reassignment_ratio,\n2032 |                     verbose=self.verbose,\n2033 |                     n_threads=self._n_threads,\n2034 |                 )\n2035 | \n2036 |                 if self._tol > 0.0:\n2037 |                     centers_squared_diff = np.sum((centers_new - centers) ** 2)\n2038 |                 else:\n2039 |                     centers_squared_diff = 0\n2040 | \n2041 |                 centers, centers_new = centers_new, centers\n2042 | \n2043 |                 # Monitor convergence and do early stopping if necessary\n2044 |                 if self._mini_batch_convergence(\n2045 |                     i, n_steps, n_samples, centers_squared_diff, batch_inertia\n2046 |                 ):\n2047 |                     break\n2048 | \n2049 |         self.cluster_centers_ = centers\n2050 |         self._n_features_out = self.cluster_centers_.shape[0]\n2051 | \n2052 |         self.n_steps_ = i + 1\n2053 |         self.n_iter_ = int(np.ceil(((i + 1) * self._batch_size) / n_samples))\n2054 | \n2055 |         if self.compute_labels:\n2056 |             self.labels_, self.inertia_ = _labels_inertia_threadpool_limit(\n2057 |                 X,\n2058 |                 sample_weight,\n2059 |                 x_squared_norms,\n2060 |                 self.cluster_centers_,\n2061 |                 n_threads=self._n_threads,\n2062 |             )\n2063 |         else:\n2064 |             self.inertia_ = self._ewa_inertia * n_samples\n2065 | \n2066 |         return self\n```\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSRegression`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSRegression(_PLS):\n\n    # This implementation provides the same results that 3 PLS packages\n    # provided in the R language (R-project):\n    #     - \"mixOmics\" with function pls(X, Y, mode = \"regression\")\n    #     - \"plspm \" with function plsreg2(X, Y)\n    #     - \"pls\" with function oscorespls.fit(X, Y)\n\n    def __init__(\n        self, n_components=2, *, scale=True, max_iter=500, tol=1e-06, copy=True\n    ):\n...\n    def fit(self, X, Y):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSRegression` to get the full content if needed.\n\nFound class `sklearn/cross_decomposition/_pls.py:PLSCanonical`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass PLSCanonical(_PLS):\n\n    # This implementation provides the same results that the \"plspm\" package\n    # provided in the R language (R-project), using the function plsca(X, Y).\n    # Results are equal or collinear with the function\n    # ``pls(..., mode = \"canonical\")`` of the \"mixOmics\" package. The\n    # difference relies in the fact that mixOmics implementation does not\n    # exactly implement the Wold algorithm since it does not normalize\n    # y_weights to one.\n\n    def __init__(\n        self,\n        n_components=2,\n        *,\n        scale=True,\n        algorithm=\"nipals\",\n        max_iter=500,\n        tol=1e-06,\n        copy=True,\n    ):\n\n```\nHint: Search `sklearn/cross_decomposition/_pls.py:PLSCanonical` to get the full content if needed.\n\nFound class `asv_benchmarks/benchmarks/cluster.py:MiniBatchKMeansBenchmark`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 57 | class MiniBatchKMeansBenchmark(Predictor, Transformer, Estimator, Benchmark):\n 58 |     \"\"\"\n 59 |     Benchmarks for MiniBatchKMeans.\n 60 |     \"\"\"\n 61 | \n 62 |     param_names = [\"representation\", \"init\"]\n 63 |     params = ([\"dense\", \"sparse\"], [\"random\", \"k-means++\"])\n 64 | \n 65 |     def setup_cache(self):\n 66 |         super().setup_cache()\n 67 | \n 68 |     def make_data(self, params):\n 69 |         representation, init = params\n 70 | \n 71 |         if representation == \"sparse\":\n 72 |             data = _20newsgroups_highdim_dataset()\n 73 |         else:\n 74 |             data = _blobs_dataset(n_clusters=20)\n 75 | \n 76 |         return data\n 77 | \n 78 |     def make_estimator(self, params):\n 79 |         representation, init = params\n 80 | \n 81 |         max_iter = 5 if representation == \"sparse\" else 2\n 82 | \n 83 |         estimator = MiniBatchKMeans(\n 84 |             n_clusters=20,\n 85 |             init=init,\n 86 |             n_init=1,\n 87 |             max_iter=max_iter,\n 88 |             batch_size=1000,\n 89 |             max_no_improvement=None,\n 90 |             compute_labels=False,\n 91 |             random_state=0,\n 92 |         )\n 93 | \n 94 |         return estimator\n 95 | \n 96 |     def make_scorers(self):\n 97 |         self.train_scorer = lambda _, __: neg_mean_inertia(\n 98 |             self.X, self.estimator.predict(self.X), self.estimator.cluster_centers_\n 99 |         )\n100 |         self.test_scorer = lambda _, __: neg_mean_inertia(\n101 |             self.X_val,\n102 |             self.estimator.predict(self.X_val),\n103 |             self.estimator.cluster_centers_,\n104 |         )\n```\n\nFound function `sklearn/utils/validation.py:_generate_get_feature_names_out`.\nSource: Retrieved code content using keyword search (bm25).\n```\n1918 | def _generate_get_feature_names_out(estimator, n_features_out, input_features=None):\n1919 |     \"\"\"Generate feature names out for estimator using the estimator name as the prefix.\n1920 | \n1921 |     The input_feature names are validated but not used. This function is useful\n1922 |     for estimators that generate their own names based on `n_features_out`, i.e. PCA.\n1923 | \n1924 |     Parameters\n1925 |     ----------\n1926 |     estimator : estimator instance\n1927 |         Estimator producing output feature names.\n1928 | \n1929 |     n_feature_out : int\n1930 |         Number of feature names out.\n1931 | \n1932 |     input_features : array-like of str or None, default=None\n1933 |         Only used to validate feature names with `estimator.feature_names_in_`.\n1934 | \n1935 |     Returns\n1936 |     -------\n1937 |     feature_names_in : ndarray of str or `None`\n1938 |         Feature names in.\n1939 |     \"\"\"\n1940 |     _check_feature_names_in(estimator, input_features, generate_names=False)\n1941 |     estimator_name = estimator.__class__.__name__.lower()\n1942 |     return np.asarray(\n1943 |         [f\"{estimator_name}{i}\" for i in range(n_features_out)], dtype=object\n1944 |     )\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:PLSRegression.fit`.\nSource: Retrieved code content using keyword search (bm25).\n```\n634 | def fit(self, X, Y):\n635 |         \"\"\"Fit model to data.\n636 | \n637 |         Parameters\n638 |         ----------\n639 |         X : array-like of shape (n_samples, n_features)\n640 |            