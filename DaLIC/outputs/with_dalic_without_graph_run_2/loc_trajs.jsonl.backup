e and True, respectively, but\n2377 |     in this function they refer to solutions of an expression. So 0 and 1\n2378 |     return the domain and EmptySet, respectively, while True and False\n2379 |     return the opposite (as they are assumed to be solutions of relational\n2380 |     expressions).\n2381 | \n2382 | \n2383 |     See Also\n2384 |     ========\n2385 | \n2386 |     solveset_real: solver for real domain\n2387 |     solveset_complex: solver for complex domain\n2388 | \n2389 |     Examples\n2390 |     ========\n2391 | \n2392 |     >>> from sympy import exp, sin, Symbol, pprint, S, Eq\n2393 |     >>> from sympy.solvers.solveset import solveset, solveset_real\n2394 | \n2395 |     * The default domain is complex. Not specifying a domain will lead\n2396 |       to the solving of the equation in the complex domain (and this\n2397 |       is not affected by the assumptions on the symbol):\n2398 | \n2399 |     >>> x = Symbol('x')\n2400 |     >>> pprint(solveset(exp(x) - 1, x), use_unicode=False)\n2401 |     {2*n*I*pi | n in Integers}\n2402 | \n2403 |     >>> x = Symbol('x', real=True)\n2404 |     >>> pprint(solveset(exp(x) - 1, x), use_unicode=False)\n2405 |     {2*n*I*pi | n in Integers}\n2406 | \n2407 |     * If you want to use ``solveset`` to solve the equation in the\n2408 |       real domain, provide a real domain. (Using ``solveset_real``\n2409 |       does this automatically.)\n2410 | \n2411 |     >>> R = S.Reals\n2412 |     >>> x = Symbol('x')\n2413 |     >>> solveset(exp(x) - 1, x, R)\n2414 |     {0}\n2415 |     >>> solveset_real(exp(x) - 1, x)\n2416 |     {0}\n2417 | \n2418 |     The solution is unaffected by assumptions on the symbol:\n2419 | \n2420 |     >>> p = Symbol('p', positive=True)\n2421 |     >>> pprint(solveset(p**2 - 4))\n2422 |     {-2, 2}\n2423 | \n2424 |     When a :class:`~.ConditionSet` is returned, symbols with assumptions that\n2425 |     would alter the set are replaced with more generic symbols:\n2426 | \n2427 |     >>> i = Symbol('i', imaginary=True)\n2428 |     >>> solveset(Eq(i**2 + i*sin(i), 1), i, domain=S.Reals)\n2429 |     ConditionSet(_R, Eq(_R**2 + _R*sin(_R) - 1, 0), Reals)\n2430 | \n2431 |     * Inequalities can be solved over the real domain only. Use of a complex\n2432 |       domain leads to a NotImplementedError.\n2433 | \n2434 |     >>> solveset(exp(x) > 1, x, R)\n2435 |     Interval.open(0, oo)\n2436 | \n2437 |     \"\"\"\n2438 |     f = sympify(f)\n2439 |     symbol = sympify(symbol)\n2440 | \n2441 |     if f is S.true:\n2442 |         return domain\n2443 | \n2444 |     if f is S.false:\n2445 |         return S.EmptySet\n2446 | \n2447 |     if not isinstance(f, (Expr, Relational, Number)):\n2448 |         raise ValueError(\"%s is not a valid SymPy expression\" % f)\n2449 | \n2450 |     if not isinstance(symbol, (Expr, Relational)) and  symbol is not None:\n2451 |         raise ValueError(\"%s is not a valid SymPy symbol\" % (symbol,))\n2452 | \n2453 |     if not isinstance(domain, Set):\n2454 |         raise ValueError(\"%s is not a valid domain\" %(domain))\n2455 | \n2456 |     free_symbols = f.free_symbols\n2457 | \n2458 |     if f.has(Piecewise):\n2459 |         f = piecewise_fold(f)\n2460 | \n2461 |     if symbol is None and not free_symbols:\n2462 |         b = Eq(f, 0)\n2463 |         if b is S.true:\n2464 |             return domain\n2465 |         elif b is S.false:\n2466 |             return S.EmptySet\n2467 |         else:\n2468 |             raise NotImplementedError(filldedent('''\n2469 |                 relationship between value and 0 is unknown: %s''' % b))\n2470 | \n2471 |     if symbol is None:\n2472 |         if len(free_symbols) == 1:\n2473 |             symbol = free_symbols.pop()\n2474 |         elif free_symbols:\n2475 |             raise ValueError(filldedent('''\n2476 |                 The independent variable must be specified for a\n2477 |                 multivariate equation.'''))\n2478 |     elif not isinstance(symbol, Symbol):\n2479 |         f, s, swap = recast_to_symbols([f], [symbol])\n2480 |         # the xreplace will be needed if a ConditionSet is returned\n2481 |         return solveset(f[0], s[0], domain).xreplace(swap)\n2482 | \n2483 |     # solveset should ignore assumptions on symbols\n2484 |     newsym = None\n2485 |     if domain.is_subset(S.Reals):\n2486 |         if symbol._assumptions_orig != {'real': True}:\n2487 |             newsym = Dummy('R', real=True)\n2488 |     elif domain.is_subset(S.Complexes):\n2489 |         if symbol._assumptions_orig != {'complex': True}:\n2490 |             newsym = Dummy('C', complex=True)\n2491 | \n2492 |     if newsym is not None:\n2493 |         rv = solveset(f.xreplace({symbol: newsym}), newsym, domain)\n2494 |         # try to use the original symbol if possible\n2495 |         try:\n2496 |             _rv = rv.xreplace({newsym: symbol})\n2497 |         except TypeError:\n2498 |             _rv = rv\n2499 |         if rv.dummy_eq(_rv):\n2500 |             rv = _rv\n2501 |         return rv\n2502 | \n2503 |     # Abs has its own handling method which avoids the\n2504 |     # rewriting property that the first piece of abs(x)\n2505 |     # is for x >= 0 and the 2nd piece for x < 0 -- solutions\n2506 |     # can look better if the 2nd condition is x <= 0. Since\n2507 |     # the solution is a set, duplication of results is not\n2508 |     # an issue, e.g. {y, -y} when y is 0 will be {0}\n2509 |     f, mask = _masked(f, Abs)\n2510 |     f = f.rewrite(Piecewise) # everything that's not an Abs\n2511 |     for d, e in mask:\n2512 |         # everything *in* an Abs\n2513 |         e = e.func(e.args[0].rewrite(Piecewise))\n2514 |         f = f.xreplace({d: e})\n2515 |     f = piecewise_fold(f)\n2516 | \n2517 |     return _solveset(f, symbol, domain, _check=True)\n```\n\nFound function `sympy/integrals/heurisch.py:heurisch`.\nSource: Retrieved code content using keyword search (bm25).\n```\n296 | def heurisch(f, x, rewrite=False, hints=None, mappings=None, retries=3,\n297 |              degree_offset=0, unnecessary_permutations=None,\n298 |              _try_heurisch=None):\n299 |     \"\"\"\n300 |     Compute indefinite integral using heuristic Risch algorithm.\n301 | \n302 |     Explanation\n303 |     ===========\n304 | \n305 |     This is a heuristic approach to indefinite integration in finite\n306 |     terms using the extended heuristic (parallel) Risch algorithm, based\n307 |     on Manuel Bronstein's \"Poor Man's Integrator\".\n308 | \n309 |     The algorithm supports various classes of functions including\n310 |     transcendental elementary or special functions like Airy,\n311 |     Bessel, Whittaker and Lambert.\n312 | \n313 |     Note that this algorithm is not a decision procedure. If it isn't\n314 |     able to compute the antiderivative for a given function, then this is\n315 |     not a proof that such a functions does not exist.  One should use\n316 |     recursive Risch algorithm in such case.  It's an open question if\n317 |     this algorithm can be made a full decision procedure.\n318 | \n319 |     This is an internal integrator procedure. You should use top level\n320 |     'integrate' function in most cases, as this procedure needs some\n321 |     preprocessing steps and otherwise may fail.\n322 | \n323 |     Specification\n324 |     =============\n325 | \n326 |      heurisch(f, x, rewrite=False, hints=None)\n327 | \n328 |        where\n329 |          f : expression\n330 |          x : symbol\n331 | \n332 |          rewrite -> force rewrite 'f' in terms of 'tan' and 'tanh'\n333 |          hints   -> a list of functions that may appear in anti-derivate\n334 | \n335 |           - hints = None          --> no suggestions at all\n336 |           - hints = [ ]           --> try to figure out\n337 |           - hints = [f1, ..., fn] --> we know better\n338 | \n339 |     Examples\n340 |     ========\n341 | \n342 |     >>> from sympy import tan\n343 |     >>> from sympy.integrals.heurisch import heurisch\n344 |     >>> from sympy.abc import x, y\n345 | \n346 |     >>> heurisch(y*tan(x), x)\n347 |     y*log(tan(x)**2 + 1)/2\n348 | \n349 |     See Manuel Bronstein's \"Poor Man's Integrator\":\n350 | \n351 |     References\n352 |     ==========\n353 | \n354 |     .. [1] https://www-sop.inria.fr/cafe/Manuel.Bronstein/pmint/index.html\n355 | \n356 |     For more information on the implemented algorithm refer to:\n357 | \n358 |     .. [2] K. Geddes, L. Stefanus, On the Risch-Norman Integration\n359 |        Method and its Implementation in Maple, Proceedings of\n360 |        ISSAC'89, ACM Press, 212-217.\n361 | \n362 |     .. [3] J. H. Davenport, On the Parallel Risch Algorithm (I),\n363 |        Proceedings of EUROCAM'82, LNCS 144, Springer, 144-157.\n364 | \n365 |     .. [4] J. H. Davenport, On the Parallel Risch Algorithm (III):\n366 |        Use of Tangents, SIGSAM Bulletin 16 (1982), 3-6.\n367 | \n368 |     .. [5] J. H. Davenport, B. M. Trager, On the Parallel Risch\n369 |        Algorithm (II), ACM Transactions on Mathematical\n370 |        Software 11 (1985), 356-362.\n371 | \n372 |     See Also\n373 |     ========\n374 | \n375 |     sympy.integrals.integrals.Integral.doit\n376 |     sympy.integrals.integrals.Integral\n377 |     sympy.integrals.heurisch.components\n378 |     \"\"\"\n379 |     f = sympify(f)\n380 | \n381 |     # There are some functions that Heurisch cannot currently handle,\n382 |     # so do not even try.\n383 |     # Set _try_heurisch=True to skip this check\n384 |     if _try_heurisch is not True:\n385 |         if f.has(Abs, re, im, sign, Heaviside, DiracDelta, floor, ceiling, arg):\n386 |             return\n387 | \n388 |     if not f.has_free(x):\n389 |         return f*x\n390 | \n391 |     if not f.is_Add:\n392 |         indep, f = f.as_independent(x)\n393 |     else:\n394 |         indep = S.One\n395 | \n396 |     rewritables = {\n397 |         (sin, cos, cot): tan,\n398 |         (sinh, cosh, coth): tanh,\n399 |     }\n400 | \n401 |     if rewrite:\n402 |         for candidates, rule in rewritables.items():\n403 |             f = f.rewrite(candidates, rule)\n404 |     else:\n405 |         for candidates in rewritables.keys():\n406 |             if f.has(*candidates):\n407 |                 break\n408 |         else:\n409 |             rewrite = True\n410 | \n411 |     terms = components(f, x)\n412 |     dcache = DiffCache(x)\n413 | \n414 |     if hints is not None:\n415 |         if not hints:\n416 |             a = Wild('a', exclude=[x])\n417 |             b = Wild('b', exclude=[x])\n418 |             c = Wild('c', exclude=[x])\n419 | \n420 |             for g in set(terms):  # using copy of terms\n421 |                 if g.is_Function:\n422 |                     if isinstance(g, li):\n423 |                         M = g.args[0].match(a*x**b)\n424 | \n425 |                         if M is not None:\n426 |                             terms.add( x*(li(M[a]*x**M[b]) - (M[a]*x**M[b])**(-1/M[b])*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n427 |                             #terms.add( x*(li(M[a]*x**M[b]) - (x**M[b])**(-1/M[b])*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n428 |                             #terms.add( x*(li(M[a]*x**M[b]) - x*Ei((M[b]+1)*log(M[a]*x**M[b])/M[b])) )\n429 |                             #terms.add( li(M[a]*x**M[b]) - Ei((M[b]+1)*log(M[a]*x**M[b])/M[b]) )\n430 | \n431 |                     elif isinstance(g, exp):\n432 |                         M = g.args[0].match(a*x**2)\n433 | \n434 |                         if M is not None:\n435 |                             if M[a].is_positive:\n436 |                                 terms.add(erfi(sqrt(M[a])*x))\n437 |                             else: # M[a].is_negative or unknown\n438 |                                 terms.add(erf(sqrt(-M[a])*x))\n439 | \n440 |                         M = g.args[0].match(a*x**2 + b*x + c)\n441 | \n442 |                         if M is not None:\n443 |                             if M[a].is_positive:\n444 |             