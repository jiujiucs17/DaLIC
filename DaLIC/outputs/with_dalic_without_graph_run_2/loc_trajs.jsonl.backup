ult True\n171 |         Raise if an accessor does not exist on delegate.\n172 |         False skips the missing accessor.\n173 | \n174 |     Returns\n175 |     -------\n176 |     callable\n177 |         A class decorator.\n178 | \n179 |     Examples\n180 |     --------\n181 |     @delegate_names(Categorical, [\"categories\", \"ordered\"], \"property\")\n182 |     class CategoricalAccessor(PandasDelegate):\n183 |         [...]\n184 |     \"\"\"\n185 | \n186 |     def add_delegate_accessors(cls):\n187 |         cls._add_delegate_accessors(\n188 |             delegate,\n189 |             accessors,\n190 |             typ,\n191 |             overwrite=overwrite,\n192 |             accessor_mapping=accessor_mapping,\n193 |             raise_on_missing=raise_on_missing,\n194 |         )\n195 |         return cls\n196 | \n197 |     return add_delegate_accessors\n```\n\nFound function `pandas/core/accessor.py:_register_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n237 | def _register_accessor(\n238 |     name: str, cls: type[NDFrame | Index]\n239 | ) -> Callable[[TypeT], TypeT]:\n240 |     \"\"\"\n241 |     Register a custom accessor on {klass} objects.\n242 | \n243 |     Parameters\n244 |     ----------\n245 |     name : str\n246 |         Name under which the accessor should be registered. A warning is issued\n247 |         if this name conflicts with a preexisting attribute.\n248 | \n249 |     Returns\n250 |     -------\n251 |     callable\n252 |         A class decorator.\n253 | \n254 |     See Also\n255 |     --------\n256 |     register_dataframe_accessor : Register a custom accessor on DataFrame objects.\n257 |     register_series_accessor : Register a custom accessor on Series objects.\n258 |     register_index_accessor : Register a custom accessor on Index objects.\n259 | \n260 |     Notes\n261 |     -----\n262 |     This function allows you to register a custom-defined accessor class for {klass}.\n263 |     The requirements for the accessor class are as follows:\n264 | \n265 |     * Must contain an init method that:\n266 | \n267 |       * accepts a single {klass} object\n268 | \n269 |       * raises an AttributeError if the {klass} object does not have correctly\n270 |         matching inputs for the accessor\n271 | \n272 |     * Must contain a method for each access pattern.\n273 | \n274 |       * The methods should be able to take any argument signature.\n275 | \n276 |       * Accessible using the @property decorator if no additional arguments are\n277 |         needed.\n278 | \n279 |     Examples\n280 |     --------\n281 |     {examples}\n282 |     \"\"\"\n283 | \n284 |     def decorator(accessor: TypeT) -> TypeT:\n285 |         if hasattr(cls, name):\n286 |             warnings.warn(\n287 |                 f\"registration of accessor {accessor!r} under name \"\n288 |                 f\"{name!r} for type {cls!r} is overriding a preexisting \"\n289 |                 f\"attribute with the same name.\",\n290 |                 UserWarning,\n291 |                 stacklevel=find_stack_level(),\n292 |             )\n293 |         setattr(cls, name, Accessor(name, accessor))\n294 |         cls._accessors.add(name)\n295 |         return accessor\n296 | \n297 |     return decorator\n```\n\n\n\n##Searching for term \"AttributeError .str accessor\"...\n### Search Result:\nFound function `pandas/core/accessor.py:register_dataframe_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n327 | def register_dataframe_accessor(name: str) -> Callable[[TypeT], TypeT]:\n328 |     from pandas import DataFrame\n329 | \n330 |     return _register_accessor(name, DataFrame)\n```\n\nFound function `pandas/core/accessor.py:register_series_accessor`.\nSource: Retrieved code content using keyword search (bm25).\n```\n358 | def register_series_accessor(name: str) -> Callable[[TypeT], TypeT]:\n359 |     from pandas import Series\n360 | \n361 |     return _register_accessor(name, Series)\n```\n\nFound function `pandas/core/strings/accessor.py:StringMethods._validate`.\nSource: Retrieved code content using keyword search (bm25).\n```\n221 | def _validate(data):\n222 |         \"\"\"\n223 |         Auxiliary function for StringMethods, infers and checks dtype of data.\n224 | \n225 |         This is a \"first line of defence\" at the creation of the StringMethods-\n226 |         object, and just checks that the dtype is in the\n227 |         *union* of the allowed types over all string methods below; this\n228 |         restriction is then refined on a per-method basis using the decorator\n229 |         @forbid_nonstring_types (more info in the corresponding docstring).\n230 | \n231 |         This really should exclude all series/index with any non-string values,\n232 |         but that isn't practical for performance reasons until we have a str\n233 |         dtype (GH 9343 / 13877)\n234 | \n235 |         Parameters\n236 |         ----------\n237 |         data : The content of the Series\n238 | \n239 |         Returns\n240 |         -------\n241 |         dtype : inferred dtype of data\n242 |         \"\"\"\n243 |         if isinstance(data, ABCMultiIndex):\n244 |             raise AttributeError(\n245 |                 \"Can only use .str accessor with Index, not MultiIndex\"\n246 |             )\n247 | \n248 |         # see _libs/lib.pyx for list of inferred types\n249 |         allowed_types = [\"string\", \"empty\", \"bytes\", \"mixed\", \"mixed-integer\"]\n250 | \n251 |         data = extract_array(data)\n252 | \n253 |         values = getattr(data, \"categories\", data)  # categorical / normal\n254 | \n255 |         inferred_dtype = lib.infer_dtype(values, skipna=True)\n256 | \n257 |         if inferred_dtype not in allowed_types:\n258 |             raise AttributeError(\"Can only use .str accessor with string values!\")\n259 |         return inferred_dtype\n```\n"}, {"content": "Let me analyze the dependency tree to understand the relationships between c