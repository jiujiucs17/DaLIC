|         CompressionOptions,\n  96 |         FilePath,\n  97 |         FloatFormatType,\n  98 |         FormattersType,\n  99 |         IndexLabel,\n 100 |         SequenceNotStr,\n 101 |         StorageOptions,\n 102 |         WriteBuffer,\n 103 |     )\n 104 | \n 105 |     from pandas import (\n 106 |         DataFrame,\n 107 |         Series,\n 108 |     )\n 109 | \n 110 | \n 111 | common_docstring: Final = \"\"\"\n 112 |         Parameters\n 113 |         ----------\n 114 |         buf : str, Path or StringIO-like, optional, default None\n 115 |             Buffer to write to. If None, the output is returned as a string.\n 116 |         columns : array-like, optional, default None\n 117 |             The subset of columns to write. Writes all columns by default.\n 118 |         col_space : %(col_space_type)s, optional\n 119 |             %(col_space)s.\n 120 |         header : %(header_type)s, optional\n 121 |             %(header)s.\n 122 |         index : bool, optional, default True\n 123 |             Whether to print index (row) labels.\n 124 |         na_rep : str, optional, default 'NaN'\n 125 |             String representation of ``NaN`` to use.\n 126 |         formatters : list, tuple or dict of one-param. functions, optional\n 127 |             Formatter functions to apply to columns' elements by position or\n 128 |             name.\n 129 |             The result of each function must be a unicode string.\n 130 |             List/tuple must be of length equal to the number of columns.\n 131 |         float_format : one-parameter function, optional, default None\n 132 |             Formatter function to apply to columns' elements if they are\n 133 |             floats. This function must return a unicode string and will be\n 134 |             applied only to the non-``NaN`` elements, with ``NaN`` being\n 135 |             handled by ``na_rep``.\n 136 |         sparsify : bool, optional, default True\n 137 |             Set to False for a DataFrame with a hierarchical index to print\n 138 |             every multiindex key at each row.\n 139 |         index_names : bool, optional, default True\n 140 |             Prints the names of the indexes.\n 141 |         justify : str, default None\n 142 |             How to justify the column labels. If None uses the option from\n 143 |             the print configuration (controlled by set_option), 'right' out\n 144 |             of the box. Valid values are\n 145 | \n 146 |             * left\n 147 |             * right\n 148 |             * center\n 149 |             * justify\n 150 |             * justify-all\n 151 |             * start\n 152 |             * end\n 153 |             * inherit\n 154 |             * match-parent\n 155 |             * initial\n 156 |             * unset.\n 157 |         max_rows : int, optional\n 158 |             Maximum number of rows to display in the console.\n 159 |         max_cols : int, optional\n 160 |             Maximum number of columns to display in the console.\n 161 |         show_dimensions : bool, default False\n 162 |             Display DataFrame dimensions (number of rows by number of columns).\n 163 |         decimal : str, default '.'\n 164 |             Character recognized as decimal separator, e.g. ',' in Europe.\n 165 |     \"\"\"\n 166 | \n 167 | VALID_JUSTIFY_PARAMETERS = (\n 168 |     \"left\",\n 169 |     \"right\",\n 170 |     \"center\",\n 171 |     \"justify\",\n 172 |     \"justify-all\",\n 173 |     \"start\",\n 174 |     \"end\",\n 175 |     \"inherit\",\n 176 |     \"match-parent\",\n 177 |     \"initial\",\n 178 |     \"unset\",\n 179 | )\n 180 | \n 181 | return_docstring: Final = \"\"\"\n 182 |         Returns\n 183 |         -------\n 184 |         str or None\n 185 |             If buf is None, returns the result as a string. Otherwise returns\n 186 |             None.\n 187 |     \"\"\"\n 188 | \n 189 | \n 190 | class SeriesFormatter:\n 191 |     \"\"\"\n 192 |     Implement the main logic of Series.to_string, which underlies\n 193 |     Series.__repr__.\n 194 |     \"\"\"\n 195 | \n 196 |     def __init__(\n 197 |         self,\n 198 |         series: Series,\n 199 |         *,\n 200 |         length: bool | str = True,\n 201 |         header: bool = True,\n 202 |         index: bool = True,\n 203 |         na_rep: str = \"NaN\",\n 204 |         name: bool = False,\n 205 |         float_format: str | None = None,\n 206 |         dtype: bool = True,\n 207 |         max_rows: int | None = None,\n 208 |         min_rows: int | None = None,\n 209 |     ) -> None:\n 210 |         self.series = series\n 211 |         self.buf = StringIO()\n 212 |         self.name = name\n 213 |         self.na_rep = na_rep\n 214 |         self.header = header\n 215 |         self.length = length\n 216 |         self.index = index\n 217 |         self.max_rows = max_rows\n 218 |         self.min_rows = min_rows\n 219 | \n 220 |         if float_format is None:\n 221 |             float_format = get_option(\"display.float_format\")\n 222 |         self.float_format = float_format\n 223 |         self.dtype = dtype\n 224 |         self.adj = printing.get_adjustment()\n 225 | \n 226 |         self._chk_truncate()\n 227 | \n 228 |     def _chk_truncate(self) -> None:\n 229 |         self.tr_row_num: int | None\n 230 | \n 231 |         min_rows = self.min_rows\n 232 |         max_rows = self.max_rows\n 233 |         # truncation determined by max_rows, actual truncated number of rows\n 234 |         # used below by min_rows\n 235 |         is_truncated_vertically = max_rows and (len(self.series) > max_rows)\n 236 |         series = self.series\n 237 |         if is_truncated_vertically:\n 238 |             max_rows = cast(int, max_rows)\n 239 |             if min_rows:\n 240 |                 # if min_rows is set (not None or 0), set max_rows to minimum\n 241 |                 # of both\n 242 |                 max_rows = min(min_rows, max_rows)\n 243 |             if max_rows == 1:\n 244 |                 row_num = max_rows\n 245 |                 series = series.iloc[:max_rows]\n 246 |             else:\n 247 |                 row_num = max_rows // 2\n 248 |                 series = concat((series.iloc[:row_num], series.iloc[-row_num:]))\n 249 |             self.tr_row_num = row_num\n 250 |         else:\n 251 |             self.tr_row_num = None\n 252 |         self.tr_series = series\n 253 |         self.is_truncated_vertically = is_truncated_vertically\n 254 | \n 255 |     def _get_footer(self) -> str:\n 256 |         name = self.series.name\n 257 |         footer = \"\"\n 258 | \n 259 |         index = self.series.index\n 260 |         if (\n 261 |             isinstance(index, (DatetimeIndex, PeriodIndex, TimedeltaIndex))\n 262 |             and index.freq is not None\n 263 |         ):\n 264 |             footer += f\"Freq: {index.freqstr}\"\n 265 | \n 266 |         if self.name is not False and name is not None:\n 267 |             if footer:\n 268 |                 footer += \", \"\n 269 | \n 270 |             series_name = printing.pprint_thing(name, escape_chars=(\"\\t\", \"\\r\", \"\\n\"))\n 271 |             footer += f\"Name: {series_name}\"\n 272 | \n 273 |         if self.length is True or (\n 274 |             self.length == \"truncate\" and self.is_truncated_vertically\n 275 |         ):\n 276 |             if footer:\n 277 |                 footer += \", \"\n 278 |             footer += f\"Length: {len(self.series)}\"\n 279 | \n 280 |         if self.dtype is not False and self.dtype is not None:\n 281 |             dtype_name = getattr(self.tr_series.dtype, \"name\", None)\n 282 |             if dtype_name:\n 283 |                 if footer:\n 284 |                     footer += \", \"\n 285 |                 footer += f\"dtype: {printing.pprint_thing(dtype_name)}\"\n 286 | \n 287 |         # level infos are added to the end and in a new line, like it is done\n 288 |         # for Categoricals\n 289 |         if isinstance(self.tr_series.dtype, CategoricalDtype):\n 290 |             level_info = self.tr_series._values._get_repr_footer()\n 291 |             if footer:\n 292 |                 footer += \"\\n\"\n 293 |             footer += level_info\n 294 | \n 295 |         return str(footer)\n 296 | \n 297 |     def _get_formatted_values(self) -> list[str]:\n 298 |         return format_array(\n 299 |             self.tr_series._values,\n 300 |             None,\n 301 |             float_format=self.float_format,\n 302 |             na_rep=self.na_rep,\n 303 |             leading_space=self.index,\n 304 |         )\n 305 | \n 306 |     def to_string(self) -> str:\n 307 |         series = self.tr_series\n 308 |         footer = self._get_footer()\n 309 | \n 310 |         if len(series) == 0:\n 311 |             return f\"{type(self.series).__name__}([], {footer})\"\n 312 | \n 313 |         index = series.index\n 314 |         have_header = _has_names(index)\n 315 |         if isinstance(index, MultiIndex):\n 316 |             fmt_index = index._format_multi(include_names=True, sparsify=None)\n 317 |             adj = printing.get_adjustment()\n 318 |             fmt_index = adj.adjoin(2, *fmt_index).split(\"\\n\")\n 319 |         else:\n 320 |             fmt_index = index._format_flat(include_name=True)\n 321 |         fmt_values = self._get_formatted_values()\n 322 | \n 323 |         if self.is_truncated_vertically:\n 324 |             n_header_rows = 0\n 325 |             row_num = self.tr_row_num\n 326 |             row_num = cast(int, row_num)\n 327 |             width = self.adj.len(fmt_values[row_num - 1])\n 328 |             if width > 3:\n 329 |                 dot_str = \"...\"\n 330 |             else:\n 331 |                 dot_str = \"..\"\n 332 |             # Series uses mode=center because it has single value columns\n 333 |             # DataFrame uses mode=left\n 334 |             dot_str = self.adj.justify([dot_str], width, mode=\"center\")[0]\n 335 |             fmt_values.insert(row_num + n_header_rows, dot_str)\n 336 |             fmt_index.insert(row_num + 1, \"\")\n 337 | \n 338 |         if self.index:\n 339 |             result = self.adj.adjoin(3, *[fmt_index[1:], fmt_values])\n 340 |         else:\n 341 |             result = self.adj.adjoin(3, fmt_values)\n 342 | \n 343 |         if self.header and have_header:\n 344 |             result = fmt_index[0] + \"\\n\" + result\n 345 | \n 346 |         if footer:\n 347 |             result += \"\\n\" + footer\n 348 | \n 349 |         return str(\"\".join(result))\n 350 | \n 351 | \n 352 | def get_dataframe_repr_params() -> dict[str, Any]:\n 353 |     \"\"\"Get the parameters used to repr(dataFrame) calls using DataFrame.to_string.\n 354 | \n 355 |     Supplying these parameters to DataFrame.to_string is equivalent to calling\n 356 |     ``repr(DataFrame)``. This is useful if you want to adjust the repr output.\n 357 | \n 358 |     .. versionadded:: 1.4.0\n 359 | \n 360 |     Example\n 361 |     -------\n 362 |     >>> import pandas as pd\n 363 |     >>>\n 364 |     >>> df = pd.DataFrame([[1, 2], [3, 4]])\n 365 |     >>> repr_params = pd.io.formats.format.get_dataframe_repr_params()\n 366 |     >>> repr(df) == df.to_string(**repr_params)\n 367 |     True\n 368 |     \"\"\"\n 369 |     from pandas.io.formats import console\n 370 | \n 371 |     if get_option(\"display.expand_frame_repr\"):\n 372 |         line_width, _ = console.get_console_size()\n 373 |     else:\n 374 |         line_width = None\n 375 |     return {\n 376 |         \"max_rows\": get_option(\"display.max_rows\"),\n 377 |         \"min_rows\": get_option(\"display.min_rows\"),\n 378 |         \"max_cols\": get_option(\"display.max_columns\"),\n 379 |         \"max_colwidth\": get_option(\"display.max_colwidth\"),\n 380 |         \"show_dimensions\": get_option(\"display.show_dimensions\"),\n 381 |         \"line_width\": line_width,\n 382 |     }\n 383 | \n 384 | \n 385 | def get_series_repr_params() -> dict[str, Any]:\n 386 |     \"\"\"Get the parameters used to repr(Series) calls using Series.to_string.\n 387 | \n 388 |     Supplying these parameters to Series.to_string is equivalent to calling\n 389 |     ``repr(series)``. This is useful if you want to adjust the series repr output.\n 390 | \n 391 |     .. versionadded:: 1.4.0\n 392 | \n 393 |     Example\n 394 |     -------\n 395 |     >>> import pandas as pd\n 396 |     >>>\n 397 |     >>> ser = pd.Series([1, 2, 3, 4])\n 398 |     >>> repr_params = pd.io.formats.format.get_series_repr_params()\n 399 |     >>> repr(ser) == ser.to_string(**repr_params)\n 400 |     True\n 401 |     \"\"\"\n 402 |     width, height = get_terminal_size()\n 403 |     max_rows_opt = get_option(\"display.max_rows\")\n 404 |     max_rows = height if max_rows_opt == 0 else max_rows_opt\n 405 |     min_rows = height if max_rows_opt == 0 else get_option(\"display.min_rows\")\n 406 | \n 407 |     return {\n 408 |         \"name\": True,\n 409 |         \"dtype\": True,\n 410 |         \"min_rows\": min_rows,\n 411 |         \"max_rows\": max_rows,\n 412 |         \"length\": get_option(\"display.show_dimensions\"),\n 413 |     }\n 414 | \n 415 | \n 416 | class DataFrameFormatter:\n 417 |     \"\"\"\n 418 |     Class for processing dataframe formatting options and data.\n 419 | \n 420 |     Used by DataFrame.to_string, which backs DataFrame.__repr__.\n 421 |     \"\"\"\n 422 | \n 423 |     __doc__ = __doc__ if __doc__ else \"\"\n 424 |     __doc__ += common_docstring + return_docstring\n 425 | \n 426 |     def __init__(\n 427 |         self,\n 428 |         frame: DataFrame,\n 429 |         columns: Axes | None = None,\n 430 |         col_space: ColspaceArgType | None = None,\n 431 |         header: bool | SequenceNotStr[str] = True,\n 432 |         index: bool = True,\n 433 |         na_rep: str = \"NaN\",\n 434 |         formatters: FormattersType | None = None,\n 435 |         justify: str | None = None,\n 436 |         float_format: FloatFormatType | None = None,\n 437 |         sparsify: bool | None = None,\n 438 |         index_names: bool = True,\n 439 |         max_rows: int | None = None,\n 440 |         min_rows: int | None = None,\n 441 |         max_cols: int | None = None,\n 442 |         show_dimensions: bool | str = False,\n 443 |         decimal: str = \".\",\n 444 |         bold_rows: bool = False,\n 445 |         escape: bool = True,\n 446 |     ) -> None:\n 447 |         self.frame = frame\n 448 |         self.columns = self._initialize_columns(columns)\n 449 |         self.col_space = self._initialize_colspace(col_space)\n 450 |         self.header = header\n 451 |         self.index = index\n 452 |         self.na_rep = na_rep\n 453 |         self.formatters = self._initialize_formatters(formatters)\n 454 |         self.justify = self._initialize_justify(justify)\n 455 |         self.float_format = float_format\n 456 |         self.sparsify = self._initialize_sparsify(sparsify)\n 457 |         self.show_index_names = index_names\n 458 |         self.decimal = decimal\n 459 |         self.bold_rows = bold_rows\n 460 |         self.escape = escape\n 461 |         self.max_rows = max_rows\n 462 |         self.min_rows = min_rows\n 463 |         self.max_cols = max_cols\n 464 |         self.show_dimensions = show_dimensions\n 465 | \n 466 |         self.max_cols_fitted = self._calc_max_cols_fitted()\n 467 |         self.max_rows_fitted = self._calc_max_rows_fitted()\n 468 | \n 469 |         self.tr_frame = self.frame\n 470 |         self.truncate()\n 471 |         self.adj = printing.get_adjustment()\n 472 | \n 473 |     def get_strcols(self) -> list[list[str]]:\n 474 |         \"\"\"\n 475 |         Render a DataFrame to a list of columns (as lists of strings).\n 476 |         \"\"\"\n 477 |         strcols = self._get_strcols_without_index()\n 478 | \n 479 |         if self.index:\n 480 |             str_index = self._get_formatted_index(self.tr_frame)\n 481 |             strcols.insert(0, str_index)\n 482 | \n 483 |         return strcols\n 484 | \n 485 |     @property\n 486 |     def should_show_dimensions(self) -> bool:\n 487 |         return self.show_dimensions is True or (\n 488 |             self.show_dimensions == \"truncate\" and self.is_truncated\n 489 |         )\n 490 | \n 491 |     @property\n 492 |     def is_truncated(self) -> bool:\n 493 |         return bool(self.is_truncated_horizontally or self.is_truncated_vertically)\n 494 | \n 495 |     @property\n 496 |     def is_truncated_horizontally(self) -> bool:\n 497 |         return bool(self.max_cols_fitted and (len(self.columns) > self.max_cols_fitted))\n 498 | \n 499 |     @property\n 500 |     def is_truncated_vertically(self) -> bool:\n 501 |         return bool(self.max_rows_fitted and (len(self.frame) > self.max_rows_fitted))\n 502 | \n 503 |     @property\n 504 |     def dimensions_info(self) -> str:\n 505 |         return f\"\\n\\n[{len(self.frame)} rows x {len(self.frame.columns)} columns]\"\n 506 | \n 507 |     @property\n 508 |     def has_index_names(self) -> bool:\n 509 |         return _has_names(self.frame.index)\n 510 | \n 511 |     @property\n 512 |     def has_column_names(self) -> bool:\n 513 |         return _has_names(self.frame.columns)\n 514 | \n 515 |     @property\n 516 |     def show_row_idx_names(self) -> bool:\n 517 |         return all((self.has_index_names, self.index, self.show_index_names))\n 518 | \n 519 |     @property\n 520 |     def show_col_idx_names(self) -> bool:\n 521 |         return all((self.has_column_names, self.show_index_names, self.header))\n 522 | \n 523 |     @property\n 524 |     def max_rows_displayed(self) -> int:\n 525 |         return min(self.max_rows or len(self.frame), len(self.frame))\n 526 | \n 527 |     def _initialize_sparsify(self, sparsify: bool | None) -> bool:\n 528 |         if sparsify is None:\n 529 |             return get_option(\"display.multi_sparse\")\n 530 |         return sparsify\n 531 | \n 532 |     def _initialize_formatters(\n 533 |         self, formatters: FormattersType | None\n 534 |     ) -> FormattersType:\n 535 |         if formatters is None:\n 536 |             return {}\n 537 |         elif len(self.frame.columns) == len(formatters) or isinstance(formatters, dict):\n 538 |             return formatters\n 539 |         else:\n 540 |             raise ValueError(\n 541 |                 f\"Formatters length({len(formatters)}) should match \"\n 542 |                 f\"DataFrame number of columns({len(self.frame.columns)})\"\n 543 |             )\n 544 | \n 545 |     def _initialize_justify(self, justify: str | None) -> str:\n 546 |         if justify is None:\n 547 |             return get_option(\"display.colheader_justify\")\n 548 |         else:\n 549 |             return justify\n 550 | \n 551 |     def _initialize_columns(self, columns: Axes | None) -> Index:\n 552 |         if columns is not None:\n 553 |             cols = ensure_index(columns)\n 554 |             self.frame = self.frame[cols]\n 555 |             return cols\n 556 |         else:\n 557 |             return self.frame.columns\n 558 | \n 559 |     def _initialize_colspace(self, col_space: ColspaceArgType | None) -> ColspaceType:\n 560 |         result: ColspaceType\n 561 | \n 562 |         if col_space is None:\n 563 |             result = {}\n 564 |         elif isinstance(col_space, (int, str)):\n 565 |             result = {\"\": col_space}\n 566 |             result.update({column: col_space for column in self.frame.columns})\n 567 |         elif isinstance(col_space, Mapping):\n 568 |             for column in col_space.keys():\n 569 |                 if column not in self.frame.columns and column != \"\":\n 570 |                     raise ValueError(\n 571 |                         f\"Col_space is defined for an unknown column: {column}\"\n 572 |                     )\n 573 |             result = col_space\n 574 |         else:\n 575 |             if len(self.frame.columns) != len(col_space):\n 576 |                 raise ValueError(\n 577 |                     f\"Col_space length({len(col_space)}) should match \"\n 578 |                     f\"DataFrame number of columns({len(self.frame.columns)})\"\n 579 |                 )\n 580 |             result = dict(zip(self.frame.columns, col_space))\n 581 |         return result\n 582 | \n 583 |     def _calc_max_cols_fitted(self) -> int | None:\n 584 |         \"\"\"Number of columns fitting the screen.\"\"\"\n 585 |         if not self._is_in_terminal():\n 586 |             return self.max_cols\n 587 | \n 588 |         width, _ = get_terminal_size()\n 589 |         if self._is_screen_narrow(width):\n 590 |             return width\n 591 |         else:\n 592 |             return self.max_cols\n 593 | \n 594 |     def _calc_max_rows_fitted(self) -> int | None:\n 595 |         \"\"\"Number of rows with data fitting the screen.\"\"\"\n 596 |         max_rows: int | None\n 597 | \n 598 |         if self._is_in_terminal():\n 599 |             _, height = get_terminal_size()\n 600 |             if self.max_rows == 0:\n 601 |                 # rows available to fill with actual data\n 602 |                 return height - self._get_number_of_auxiliary_rows()\n 603 | \n 604 |             if self._is_screen_short(height):\n 605 |                 max_rows = height\n 606 |             else:\n 607 |                 max_rows = self.max_rows\n 608 |         else:\n 609 |             max_rows = self.max_rows\n 610 | \n 611 |         return self._adjust_max_rows(max_rows)\n 612 | \n 613 |     def _adjust_max_rows(self, max_rows: int | None) -> int | None:\n 614 |         \"\"\"Adjust max_rows using display logic.\n 615 | \n 616 |         See description here:\n 617 |         https://pandas.pydata.org/docs/dev/user_guide/options.html#frequently-used-options\n 618 | \n 619 |         GH #37359\n 620 |         \"\"\"\n 621 |         if max_rows:\n 622 |             if (len(self.frame) > max_rows) and self.min_rows:\n 623 |                 # if truncated, set max_rows showed to min_rows\n 624 |                 max_rows = min(self.min_rows, max_rows)\n 625 |         return max_rows\n 626 | \n 627 |     def _is_in_terminal(self) -> bool:\n 628 |         \"\"\"Check if the output is to be shown in terminal.\"\"\"\n 629 |         return bool(self.max_cols == 0 or self.max_rows == 0)\n 630 | \n 631 |     def _is_screen_narrow(self, max_width) -> bool:\n 632 |         return bool(self.max_cols == 0 and len(self.frame.columns) > max_width)\n 633 | \n 634 |     def _is_screen_short(self, max_height) -> bool:\n 635 |         return bool(self.max_rows == 0 and len(self.frame) > max_height)\n 636 | \n 637 |     def _get_number_of_auxiliary_rows(self) -> int:\n 638 |         \"\"\"Get number of rows occupied by prompt, dots and dimension info.\"\"\"\n 639 |         dot_row = 1\n 640 |         prompt_row = 1\n 641 |         num_rows = dot_row + prompt_row\n 642 | \n 643 |         if self.show_dimensions:\n 644 |             num_rows += len(self.dimensions_info.splitlines())\n 645 | \n 646 |         if self.header:\n 647 |             num_rows += 1\n 648 | \n 649 |         return num_rows\n 650 | \n 651 |     def truncate(self) -> None:\n 652 |         \"\"\"\n 653 |         Check whether the frame should be truncated. If so, slice the frame up.\n 654 |         \"\"\"\n 655 |         if self.is_truncated_horizontally:\n 656 |             self._truncate_horizontally()\n 657 | \n 658 |         if self.is_truncated_vertically:\n 659 |             self._truncate_vertically()\n 660 | \n 661 |     def _truncate_horizontally(self) -> None:\n 662 |         \"\"\"Remove columns, which are not to be displayed and adjust formatters.\n 663 | \n 664 |         Attributes affected:\n 665 |             - tr_frame\n 666 |             - formatters\n 667 |             - tr_col_num\n 668 |         \"\"\"\n 669 |         assert self.max_cols_fitted is not None\n 670 |         col_num = self.max_cols_fitted // 2\n 671 |         if col_num >= 1:\n 672 |             left = self.tr_frame.iloc[:, :col_num]\n 673 |             right = self.tr_frame.iloc[:, -col_num:]\n 674 |             self.tr_frame = concat((left, right), axis=1)\n 675 | \n 676 |             # truncate formatter\n 677 |             if isinstance(self.formatters, (list, tuple)):\n 678 |                 self.formatters = [\n 679 |                     *self.formatters[:col_num],\n 680 |                     *self.formatters[-col_num:],\n 681 |                 ]\n 682 |         else:\n 683 |             col_num = cast(int, self.max_cols)\n 684 |             self.tr_frame = self.tr_frame.iloc[:, :col_num]\n 685 |         self.tr_col_num = col_num\n 686 | \n 687 |     def _truncate_vertically(self) -> None:\n 688 |         \"\"\"Remove rows, which are not to be displayed.\n 689 | \n 690 |         Attributes affected:\n 691 |             - tr_frame\n 692 |             - tr_row_num\n 693 |         \"\"\"\n 694 |         assert self.max_rows_fitted is not None\n 695 |         row_num = self.max_rows_fitted // 2\n 696 |         if row_num >= 1:\n 697 |             _len = len(self.tr_frame)\n 698 |             _slice = np.hstack([np.arange(row_num), np.arange(_len - row_num, _len)])\n 699 |             self.tr_frame = self.tr_frame.iloc[_slice]\n 700 |         else:\n 701 |             row_num = cast(int, self.max_rows)\n 702 |             self.tr_frame = self.tr_frame.iloc[:row_num, :]\n 703 |         self.tr_row_num = row_num\n 704 | \n 705 |     def _get_strcols_without_index(self) -> list[list[str]]:\n 706 |         strcols: list[list[str]] = []\n 707 | \n 708 |         if not is_list_like(self.header) and not self.header:\n 709 |             for i, c in enumerate(self.tr_frame):\n 710 |                 fmt_values = self.format_col(i)\n 711 |                 fmt_values = _make_fixed_width(\n 712 |                     strings=fmt_values,\n 713 |                     justify=self.justify,\n 714 |                     minimum=int(self.col_space.get(c, 0)),\n 715 |                     adj=self.adj,\n 716 |                 )\n 717 |                 strcols.append(fmt_values)\n 718 |             return strcols\n 719 | \n 720 |         if is_list_like(self.header):\n 721 |             # cast here since can't be bool if is_list_like\n 722 |             self.header = cast(list[str], self.header)\n 723 |             if len(self.header) != len(self.columns):\n 724 |                 raise ValueError(\n 725 |                     f\"Writing {len(self.columns)} cols \"\n 726 |                     f\"but got {len(self.header)} aliases\"\n 727 |                 )\n 728 |             str_columns = [[label] for label in self.header]\n 729 |         else:\n 730 |             str_columns = self._get_formatted_column_labels(self.tr_frame)\n 731 | \n 732 |         if self.show_row_idx_names:\n 733 |             for x in str_columns:\n 734 |                 x.append(\"\")\n 735 | \n 736 |         for i, c in enumerate(self.tr_frame):\n 737 |             cheader = str_columns[i]\n 738 |             header_colwidth = max(\n 739 |                 int(self.col_space.get(c, 0)), *(self.adj.len(x) for x in cheader)\n 740 |             )\n 741 |             fmt_values = self.format_col(i)\n 742 |             fmt_values = _make_fixed_width(\n 743 |                 fmt_values, self.justify, minimum=header_colwidth, adj=self.adj\n 744 |             )\n 745 | \n 746 |             max_len = max(*(self.adj.len(x) for x in fmt_values), header_colwidth)\n 747 |             cheader = self.adj.justify(cheader, max_len, mode=self.justify)\n 748 |             strcols.append(cheader + fmt_values)\n 749 | \n 750 |         return strcols\n 751 | \n 752 |     def format_col(self, i: int) -> list[str]:\n 753 |         frame = self.tr_frame\n 754 |         formatter = self._get_formatter(i)\n 755 |         return format_array(\n 756 |             frame.iloc[:, i]._values,\n 757 |             formatter,\n 758 |             float_format=self.float_format,\n 759 |             na_rep=self.na_rep,\n 760 |             space=self.col_space.get(frame.columns[i]),\n 761 |             decimal=self.decimal,\n 762 |             leading_space=self.index,\n 763 |         )\n 764 | \n 765 |     def _get_formatter(self, i: str | int) -> Callable | None:\n 766 |         if isinstance(self.formatters, (list, tuple)):\n 767 |             if is_integer(i):\n 768 |                 i = cast(int, i)\n 769 |                 return self.formatters[i]\n 770 |             else:\n 771 |                 return None\n 772 |         else:\n 773 |             if is_integer(i) and i not in self.columns:\n 774 |                 i = self.columns[i]\n 775 |             return self.formatters.get(i, None)\n 776 | \n 777 |     def _get_formatted_column_labels(self, frame: DataFrame) -> list[list[str]]:\n 778 |         from pandas.core.indexes.multi import sparsify_labels\n 779 | \n 780 |         columns = frame.columns\n 781 | \n 782 |         if isinstance(columns, MultiIndex):\n 783 |             fmt_columns = columns._format_multi(sparsify=False, include_names=False)\n 784 |             if self.sparsify and len(fmt_columns):\n 785 |                 fmt_columns = sparsify_labels(fmt_columns)\n 786 | \n 787 |             str_columns = [list(x) for x in zip(*fmt_columns)]\n 788 |         else:\n 789 |             fmt_columns = columns._format_flat(include_name=False)\n 790 |             str_columns = [\n 791 |                 [\n 792 |                     \" \" + x\n 793 |                     if not self._get_formatter(i) and is_numeric_dtype(dtype)\n 794 |                     else x\n 795 |                 ]\n 796 |                 for i, (x, dtype) in enumerate(zip(fmt_columns, self.frame.dtypes))\n 797 |             ]\n 798 |         return str_columns\n 799 | \n 800 |     def _get_formatted_index(self, frame: DataFrame) -> list[str]:\n 801 |         # Note: this is only used by to_string() and to_latex(), not by\n 802 |         # to_html(). so safe to cast col_space here.\n 803 |         col_space = {k: cast(int, v) for k, v in self.col_space.items()}\n 804 |         index = frame.index\n 805 |         columns = frame.columns\n 806 |         fmt = self._get_formatter(\"__index__\")\n 807 | \n 808 |         if isinstance(index, MultiIndex):\n 809 |             fmt_index = index._format_multi(\n 810 |                 sparsify=self.sparsify,\n 811 |                 include_names=self.show_row_idx_names,\n 812 |                 formatter=fmt,\n 813 |             )\n 814 |         else:\n 815 |             fmt_index = [\n 816 |                 index._format_flat(include_name=self.show_row_idx_names, formatter=fmt)\n 817 |             ]\n 818 | \n 819 |         fmt_index = [\n 820 |             tuple(\n 821 |                 _make_fixed_width(\n 822 |                     list(x), justify=\"left\", minimum=col_space.get(\"\", 0), adj=self.adj\n 823 |                 )\n 824 |             )\n 825 |             for x in fmt_index\n 826 |         ]\n 827 | \n 828 |         adjoined = self.adj.adjoin(1, *fmt_index).split(\"\\n\")\n 829 | \n 830 |         # empty space for columns\n 831 |         if self.show_col_idx_names:\n 832 |             col_header = [str(x) for x in self._get_column_name_list()]\n 833 |         else:\n 834 |             col_header = [\"\"] * columns.nlevels\n 835 | \n 836 |         if self.header:\n 837 |             return col_header + adjoined\n 838 |         else:\n 839 |             return adjoined\n 840 | \n 841 |     def _get_column_name_list(self) -> list[Hashable]:\n 842 |         names: list[Hashable] = []\n 843 |         columns = self.frame.columns\n 844 |         if isinstance(columns, MultiIndex):\n 845 |             names.extend(\"\" if name is None else name for name in columns.names)\n 846 |         else:\n 847 |             names.append(\"\" if columns.name is None else columns.name)\n 848 |         return names\n 849 | \n 850 | \n 851 | class DataFrameRenderer:\n 852 |     \"\"\"Class for creating dataframe output in multiple formats.\n 853 | \n 854 |     Called in pandas.core.generic.NDFrame:\n 855 |         - to_csv\n 856 |         - to_latex\n 857 | \n 858 |     Called in pandas.DataFrame:\n 859 |         - to_html\n 860 |         - to_string\n 861 | \n 862 |     Parameters\n 863 |     ----------\n 864 |     fmt : DataFrameFormatter\n 865 |         Formatter with the formatting options.\n 866 |     \"\"\"\n 867 | \n 868 |     def __init__(self, fmt: DataFrameFormatter) -> None:\n 869 |         self.fmt = fmt\n 870 | \n 871 |     def to_html(\n 872 |         self,\n 873 |         buf: FilePath | WriteBuffer[str] | None = None,\n 874 |         encoding: str | None = None,\n 875 |         classes: str | list | tuple | None = None,\n 876 |         notebook: bool = False,\n 877 |         border: int | bool | None = None,\n 878 |         table_id: str | None = None,\n 879 |         render_links: bool = False,\n 880 |     ) -> str | None:\n 881 |         \"\"\"\n 882 |         Render a DataFrame to a html table.\n 883 | \n 884 |         Parameters\n 885 |         ----------\n 886 |         buf : str, path object, file-like object, or None, default None\n 887 |             String, path object (implementing ``os.PathLike[str]``), or file-like\n 888 |             object implementing a string ``write()`` function. If None, the result is\n 889 |             returned as a string.\n 890 |         encoding : str, default \u201cutf-8\u201d\n 891 |             Set character encoding.\n 892 |         classes : str or list-like\n 893 |             classes to include in the `class` attribute of the opening\n 894 |             ``<table>`` tag, in addition to the default \"dataframe\".\n 895 |         notebook : {True, False}, optional, default False\n 896 |             Whether the generated HTML is for IPython Notebook.\n 897 |         border : int\n 898 |             A ``border=border`` attribute is included in the opening\n 899 |             ``<table>`` tag. Default ``pd.options.display.html.border``.\n 900 |         table_id : str, optional\n 901 |             A css id is included in the opening `<table>` tag if specified.\n 902 |         render_links : bool, default False\n 903 |             Convert URLs to HTML links.\n 904 |         \"\"\"\n 905 |         from pandas.io.formats.html import (\n 906 |             HTMLFormatter,\n 907 |             NotebookFormatter,\n 908 |         )\n 909 | \n 910 |         Klass = NotebookFormatter if notebook else HTMLFormatter\n 911 | \n 912 |         html_formatter = Klass(\n 913 |             self.fmt,\n 914 |             classes=classes,\n 915 |             border=border,\n 916 |             table_id=table_id,\n 917 |             render_links=render_links,\n 918 |         )\n 919 |         string = html_formatter.to_string()\n 920 |         return save_to_buffer(string, buf=buf, encoding=encoding)\n 921 | \n 922 |     def to_string(\n 923 |         self,\n 924 |         buf: FilePath | WriteBuffer[str] | None = None,\n 925 |         encoding: str | None = None,\n 926 |         line_width: int | None = None,\n 927 |     ) -> str | None:\n 928 |         \"\"\"\n 929 |         Render a DataFrame to a console-friendly tabular output.\n 930 | \n 931 |         Parameters\n 932 |         ----------\n 933 |         buf : str, path object, file-like object, or None, default None\n 934 |             String, path object (implementing ``os.PathLike[str]``), or file-like\n 935 |             object implementing a string ``write()`` function. If None, the result is\n 936 |             returned as a string.\n 937 |         encoding: str, default \u201cutf-8\u201d\n 938 |             Set character encoding.\n 939 |         line_width : int, optional\n 940 |             Width to wrap a line in characters.\n 941 |         \"\"\"\n 942 |         from pandas.io.formats.string import StringFormatter\n 943 | \n 944 |         string_formatter = StringFormatter(self.fmt, line_width=line_width)\n 945 |         string = string_formatter.to_string()\n 946 |         return save_to_buffer(string, buf=buf, encoding=encoding)\n 947 | \n 948 |     def to_csv(\n 949 |         self,\n 950 |         path_or_buf: FilePath | WriteBuffer[bytes] | WriteBuffer[str] | None = None,\n 951 |         encoding: str | None = None,\n 952 |         sep: str = \",\",\n 953 |         columns: Sequence[Hashable] | None = None,\n 954 |         index_label: IndexLabel | None = None,\n 955 |         mode: str = \"w\",\n 956 |         compression: CompressionOptions = \"infer\",\n 957 |         quoting: int | None = None,\n 958 |         quotechar: str = '\"',\n 959 |         lineterminator: str | None = None,\n 960 |         chunksize: int | None = None,\n 961 |         date_format: str | None = None,\n 962 |         doublequote: bool = True,\n 963 |         escapechar: str | None = None,\n 964 |         errors: str = \"strict\",\n 965 |         storage_options: StorageOptions | None = None,\n 966 |     ) -> str | None:\n 967 |         \"\"\"\n 968 |         Render dataframe as comma-separated file.\n 969 |         \"\"\"\n 970 |         from pandas.io.formats.csvs import CSVFormatter\n 971 | \n 972 |         if path_or_buf is None:\n 973 |             created_buffer = True\n 974 |             path_or_buf = StringIO()\n 975 |         else:\n 976 |             created_buffer = False\n 977 | \n 978 |         csv_formatter = CSVFormatter(\n 979 |             path_or_buf=path_or_buf,\n 980 |             lineterminator=lineterminator,\n 981 |             sep=sep,\n 982 |             encoding=encoding,\n 983 |             errors=errors,\n 984 |             compression=compression,\n 985 |             quoting=quoting,\n 986 |             cols=columns,\n 987 |             index_label=index_label,\n 988 |             mode=mode,\n 989 |             chunksize=chunksize,\n 990 |             quotechar=quotechar,\n 991 |             date_format=date_format,\n 992 |             doublequote=doublequote,\n 993 |             escapechar=escapechar,\n 994 |             storage_options=storage_options,\n 995 |             formatter=self.fmt,\n 996 |         )\n 997 |         csv_formatter.save()\n 998 | \n 999 |         if created_buffer:\n1000 |             assert isinstance(path_or_buf, StringIO)\n1001 |             content = path_or_buf.getvalue()\n1002 |             path_or_buf.close()\n1003 |             return content\n1004 | \n1005 |         return None\n1006 | \n1007 | \n1008 | def save_to_buffer(\n1009 |     string: str,\n1010 |     buf: FilePath | WriteBuffer[str] | None = None,\n1011 |     encoding: str | None = None,\n1012 | ) -> str | None:\n1013 |     \"\"\"\n1014 |     Perform serialization. Write to buf or return as string if buf is None.\n1015 |     \"\"\"\n1016 |     with _get_buffer(buf, encoding=encoding) as fd:\n1017 |         fd.write(string)\n1018 |         if buf is None:\n1019 |             # error: \"WriteBuffer[str]\" has no attribute \"getvalue\"\n1020 |             return fd.getvalue()  # type: ignore[attr-defined]\n1021 |         return None\n1022 | \n1023 | \n1024 | @contextmanager\n1025 | def _get_buffer(\n1026 |     buf: FilePath | WriteBuffer[str] | None, encoding: str | None = None\n1027 | ) -> Generator[WriteBuffer[str]] | Generator[StringIO]:\n1028 |     \"\"\"\n1029 |     Context manager to open, yield and close buffer for filenames or Path-like\n1030 |     objects, otherwise yield buf unchanged.\n1031 |     \"\"\"\n1032 |     if buf is not None:\n1033 |         buf = stringify_path(buf)\n1034 |     else:\n1035 |         buf = StringIO()\n1036 | \n1037 |     if encoding is None:\n1038 |         encoding = \"utf-8\"\n1039 |     elif not isinstance(buf, str):\n1040 |         raise ValueError(\"buf is not a file name and encoding is specified.\")\n1041 | \n1042 |     if hasattr(buf, \"write\"):\n1043 |         # Incompatible types in \"yield\" (actual type \"Union[str, WriteBuffer[str],\n1044 |         # StringIO]\", expected type \"Union[WriteBuffer[str], StringIO]\")\n1045 |         yield buf  # type: ignore[misc]\n1046 |     elif isinstance(buf, str):\n1047 |         check_parent_directory(str(buf))\n1048 |         with open(buf, \"w\", encoding=encoding, newline=\"\") as f:\n1049 |             # GH#30034 open instead of codecs.open prevents a file leak\n1050 |             #  if we have an invalid encoding argument.\n1051 |             # newline=\"\" is needed to roundtrip correctly on\n1052 |             #  windows test_to_latex_filename\n1053 |             yield f\n1054 |     else:\n1055 |         raise TypeError(\"buf is not a file name and it has no write method\")\n1056 | \n1057 | \n1058 | # ----------------------------------------------------------------------\n1059 | # Array formatters\n1060 | \n1061 | \n1062 | def format_array(\n1063 |     values: ArrayLike,\n1064 |     formatter: Callable | None,\n1065 |     float_format: FloatFormatType | None = None,\n1066 |     na_rep: str = \"NaN\",\n1067 |     digits: int | None = None,\n1068 |     space: str | int | None = None,\n1069 |     justify: str = \"right\",\n1070 |     decimal: str = \".\",\n1071 |     leading_space: bool | None = True,\n1072 |     quoting: int | None = None,\n1073 |     fallback_formatter: Callable | None = None,\n1074 | ) -> list[str]:\n1075 |     \"\"\"\n1076 |     Format an array for printing.\n1077 | \n1078 |     Parameters\n1079 |     ----------\n1080 |     values : np.ndarray or ExtensionArray\n1081 |     formatter\n1082 |     float_format\n1083 |     na_rep\n1084 |     digits\n1085 |     space\n1086 |     justify\n1087 |     decimal\n1088 |     leading_space : bool, optional, default True\n1089 |         Whether the array should be formatted with a leading space.\n1090 |         When an array as a column of a Series or DataFrame, we do want\n1091 |         the leading space to pad between columns.\n1092 | \n1093 |         When formatting an Index subclass\n1094 |         (e.g. IntervalIndex._get_values_for_csv), we don't want the\n1095 |         leading space since it should be left-aligned.\n1096 |     fallback_formatter\n1097 | \n1098 |     Returns\n1099 |     -------\n1100 |     List[str]\n1101 |     \"\"\"\n1102 |     fmt_klass: type[_GenericArrayFormatter]\n1103 |     if lib.is_np_dtype(values.dtype, \"M\"):\n1104 |         fmt_klass = _Datetime64Formatter\n1105 |         values = cast(DatetimeArray, values)\n1106 |     elif isinstance(values.dtype, DatetimeTZDtype):\n1107 |         fmt_klass = _Datetime64TZFormatter\n1108 |         values = cast(DatetimeArray, values)\n1109 |     elif lib.is_np_dtype(values.dtype, \"m\"):\n1110 |         fmt_klass = _Timedelta64Formatter\n1111 |         values = cast(TimedeltaArray, values)\n1112 |     elif isinstance(values.dtype, ExtensionDtype):\n1113 |         fmt_klass = _ExtensionArrayFormatter\n1114 |     elif lib.is_np_dtype(values.dtype, \"fc\"):\n1115 |         fmt_klass = FloatArrayFormatter\n1116 |     elif lib.is_np_dtype(values.dtype, \"iu\"):\n1117 |         fmt_klass = _IntArrayFormatter\n1118 |     else:\n1119 |         fmt_klass = _GenericArrayFormatter\n1120 | \n1121 |     if space is None:\n1122 |         space = 12\n1123 | \n1124 |     if float_format is None:\n1125 |         float_format = get_option(\"display.float_format\")\n1126 | \n1127 |     if digits is None:\n1128 |         digits = get_option(\"display.precision\")\n1129 | \n1130 |     fmt_obj = fmt_klass(\n1131 |         values,\n1132 |         digits=digits,\n1133 |         na_rep=na_rep,\n1134 |         float_format=float_format,\n1135 |         formatter=formatter,\n1136 |         space=space,\n1137 |         justify=justify,\n1138 |         decimal=decimal,\n1139 |         leading_space=leading_space,\n1140 |         quoting=quoting,\n1141 |         fallback_formatter=fallback_formatter,\n1142 |     )\n1143 | \n1144 |     return fmt_obj.get_result()\n1145 | \n1146 | \n1147 | class _GenericArrayFormatter:\n1148 |     def __init__(\n1149 |         self,\n1150 |         values: ArrayLike,\n1151 |         digits: int = 7,\n1152 |         formatter: Callable | None = None,\n1153 |         na_rep: str = \"NaN\",\n1154 |         space: str | int = 12,\n1155 |         float_format: FloatFormatType | None = None,\n1156 |         justify: str = \"right\",\n1157 |         decimal: str = \".\",\n1158 |         quoting: int | None = None,\n1159 |         fixed_width: bool = True,\n1160 |         leading_space: bool | None = True,\n1161 |         fallback_formatter: Callable | None = None,\n1162 |     ) -> None:\n1163 |         self.values = values\n1164 |         self.digits = digits\n1165 |         self.na_rep = na_rep\n1166 |         self.space = space\n1167 |         self.formatter = formatter\n1168 |         self.float_format = float_format\n1169 |         self.justify = justify\n1170 |         self.decimal = decimal\n1171 |         self.quoting = quoting\n1172 |         self.fixed_width = fixed_width\n1173 |         self.leading_space = leading_space\n1174 |         self.fallback_formatter = fallback_formatter\n1175 | \n1176 |     def get_result(self) -> list[str]:\n1177 |         fmt_values = self._format_strings()\n1178 |         return _make_fixed_width(fmt_values, self.justify)\n1179 | \n1180 |     def _format_strings(self) -> list[str]:\n1181 |         if self.float_format is None:\n1182 |             float_format = get_option(\"display.float_format\")\n1183 |             if float_format is None:\n1184 |                 precision = get_option(\"display.precision\")\n1185 |                 float_format = lambda x: _trim_zeros_single_float(\n1186 |                     f\"{x: .{precision:d}f}\"\n1187 |                 )\n1188 |         else:\n1189 |             float_format = self.float_format\n1190 | \n1191 |         if self.formatter is not None:\n1192 |             formatter = self.formatter\n1193 |         elif self.fallback_formatter is not None:\n1194 |             formatter = self.fallback_formatter\n1195 |         else:\n1196 |             quote_strings = self.quoting is not None and self.quoting != QUOTE_NONE\n1197 |             formatter = partial(\n1198 |                 printing.pprint_thing,\n1199 |                 escape_chars=(\"\\t\", \"\\r\", \"\\n\"),\n1200 |                 quote_strings=quote_strings,\n1201 |             )\n1202 | \n1203 |         def _format(x):\n1204 |             if self.na_rep is not None and is_scalar(x) and isna(x):\n1205 |                 if x is None:\n1206 |                     return \"None\"\n1207 |                 elif x is NA:\n1208 |                     return str(NA)\n1209 |                 elif x is NaT or isinstance(x, (np.datetime64, np.timedelta64)):\n1210 |                     return \"NaT\"\n1211 |                 return self.na_rep\n1212 |             elif isinstance(x, PandasObject):\n1213 |                 return str(x)\n1214 |             elif isinstance(x, StringDtype):\n1215 |                 return repr(x)\n1216 |             else:\n1217 |                 # object dtype\n1218 |                 return str(formatter(x))\n1219 | \n1220 |         vals = self.values\n1221 |         if not isinstance(vals, np.ndarray):\n1222 |             raise TypeError(\n1223 |                 \"ExtensionArray formatting should use _ExtensionArrayFormatter\"\n1224 |             )\n1225 |         inferred = lib.map_infer(vals, is_float)\n1226 |         is_float_type = (\n1227 |             inferred\n1228 |             # vals may have 2 or more dimensions\n1229 |             & np.all(notna(vals), axis=tuple(range(1, len(vals.shape))))\n1230 |         )\n1231 |         leading_space = self.leading_space\n1232 |         if leading_space is None:\n1233 |             leading_space = is_float_type.any()\n1234 | \n1235 |         fmt_values = []\n1236 |         for i, v in enumerate(vals):\n1237 |             if (not is_float_type[i] or self.formatter is not None) and leading_space:\n1238 |                 fmt_values.append(f\" {_format(v)}\")\n1239 |             elif is_float_type[i]:\n1240 |                 fmt_values.append(float_format(v))\n1241 |             else:\n1242 |                 if leading_space is False:\n1243 |                     # False specifically, so that the default is\n1244 |                     # to include a space if we get here.\n1245 |                     tpl = \"{v}\"\n1246 |                 else:\n1247 |                     tpl = \" {v}\"\n1248 |                 fmt_values.append(tpl.format(v=_format(v)))\n1249 | \n1250 |         return fmt_values\n1251 | \n1252 | \n1253 | class FloatArrayFormatter(_GenericArrayFormatter):\n1254 |     def __init__(self, *args, **kwargs) -> None:\n1255 |         super().__init__(*args, **kwargs)\n1256 | \n1257 |         # float_format is expected to be a string\n1258 |         # formatter should be used to pass a function\n1259 |         if self.float_format is not None and self.formatter is None:\n1260 |             # GH21625, GH22270\n1261 |             self.fixed_width = False\n1262 |             if callable(self.float_format):\n1263 |                 self.formatter = self.float_format\n1264 |                 self.float_format = None\n1265 | \n1266 |     def _value_formatter(\n1267 |         self,\n1268 |         float_format: FloatFormatType | None = None,\n1269 |         threshold: float | None = None,\n1270 |     ) -> Callable:\n1271 |         \"\"\"Returns a function to be applied on each value to format it\"\"\"\n1272 |         # the float_format parameter supersedes self.float_format\n1273 |         if float_format is None:\n1274 |             float_format = self.float_format\n1275 | \n1276 |         # we are going to compose different functions, to first convert to\n1277 |         # a string, then replace the decimal symbol, and finally chop according\n1278 |         # to the threshold\n1279 | \n1280 |         # when there is no float_format, we use str instead of '%g'\n1281 |         # because str(0.0) = '0.0' while '%g' % 0.0 = '0'\n1282 |         if float_format:\n1283 | \n1284 |             def base_formatter(v):\n1285 |                 assert float_format is not None  # for mypy\n1286 |                 # error: \"str\" not callable\n1287 |                 # error: Unexpected keyword argument \"value\" for \"__call__\" of\n1288 |                 # \"EngFormatter\"\n1289 |                 return (\n1290 |                     float_format(value=v)  # type: ignore[operator,call-arg]\n1291 |                     if notna(v)\n1292 |                     else self.na_rep\n1293 |                 )\n1294 | \n1295 |         else:\n1296 | \n1297 |             def base_formatter(v):\n1298 |                 return str(v) if notna(v) else self.na_rep\n1299 | \n1300 |         if self.decimal != \".\":\n1301 | \n1302 |             def decimal_formatter(v):\n1303 |                 return base_formatter(v).replace(\".\", self.decimal, 1)\n1304 | \n1305 |         else:\n1306 |             decimal_formatter = base_formatter\n1307 | \n1308 |         if threshold is None:\n1309 |             return decimal_formatter\n1310 | \n1311 |         def formatter(value):\n1312 |             if notna(value):\n1313 |                 if abs(value) > threshold:\n1314 |                     return decimal_formatter(value)\n1315 |                 else:\n1316 |                     return decimal_formatter(0.0)\n1317 |             else:\n1318 |                 return self.na_rep\n1319 | \n1320 |         return formatter\n1321 | \n1322 |     def get_result_as_array(self) -> np.ndarray:\n1323 |         \"\"\"\n1324 |         Returns the float values converted into strings using\n1325 |         the parameters given at initialisation, as a numpy array\n1326 |         \"\"\"\n1327 | \n1328 |         def format_with_na_rep(\n1329 |             values: ArrayLike, formatter: Callable, na_rep: str\n1330 |         ) -> np.ndarray:\n1331 |             mask = isna(values)\n1332 |             formatted = np.array(\n1333 |                 [\n1334 |                     formatter(val) if not m else na_rep\n1335 |                     for val, m in zip(values.ravel(), mask.ravel())\n1336 |                 ]\n1337 |             ).reshape(values.shape)\n1338 |             return formatted\n1339 | \n1340 |         def format_complex_with_na_rep(\n1341 |             values: ArrayLike, formatter: Callable, na_rep: str\n1342 |         ) -> np.ndarray:\n1343 |             real_values = np.real(values).ravel()  # type: ignore[arg-type]\n1344 |             imag_values = np.imag(values).ravel()  # type: ignore[arg-type]\n1345 |             real_mask, imag_mask = isna(real_values), isna(imag_values)\n1346 |             formatted_lst = []\n1347 |             for val, real_val, imag_val, re_isna, im_isna in zip(\n1348 |                 values.ravel(),\n1349 |                 real_values,\n1350 |                 imag_values,\n1351 |                 real_mask,\n1352 |                 imag_mask,\n1353 |             ):\n1354 |                 if not re_isna and not im_isna:\n1355 |                     formatted_lst.append(formatter(val))\n1356 |                 elif not re_isna:  # xxx+nanj\n1357 |                     formatted_lst.append(f\"{formatter(real_val)}+{na_rep}j\")\n1358 |                 elif not im_isna:  # nan[+/-]xxxj\n1359 |                     # The imaginary part may either start with a \"-\" or a space\n1360 |                     imag_formatted = formatter(imag_val).strip()\n1361 |                     if imag_formatted.startswith(\"-\"):\n1362 |                         formatted_lst.append(f\"{na_rep}{imag_formatted}j\")\n1363 |                     else:\n1364 |                         formatted_lst.append(f\"{na_rep}+{imag_formatted}j\")\n1365 |                 else:  # nan+nanj\n1366 |                     formatted_lst.append(f\"{na_rep}+{na_rep}j\")\n1367 |             return np.array(formatted_lst).reshape(values.shape)\n1368 | \n1369 |         if self.formatter is not None:\n1370 |             return format_with_na_rep(self.values, self.formatter, self.na_rep)\n1371 | \n1372 |         if self.fixed_width:\n1373 |             threshold = get_option(\"display.chop_threshold\")\n1374 |         else:\n1375 |             threshold = None\n1376 | \n1377 |         # if we have a fixed_width, we'll need to try different float_format\n1378 |         def format_values_with(float_format):\n1379 |             formatter = self._value_formatter(float_format, threshold)\n1380 | \n1381 |             # default formatter leaves a space to the left when formatting\n1382 |             # floats, must be consistent for left-justifying NaNs (GH #25061)\n1383 |             na_rep = \" \" + self.na_rep if self.justify == \"left\" else self.na_rep\n1384 | \n1385 |             # different formatting strategies for complex and non-complex data\n1386 |             # need to distinguish complex and float NaNs (GH #53762)\n1387 |             values = self.values\n1388 |             is_complex = is_complex_dtype(values)\n1389 | \n1390 |             # separate the wheat from the chaff\n1391 |             if is_complex:\n1392 |                 values = format_complex_with_na_rep(values, formatter, na_rep)\n1393 |             else:\n1394 |                 values = format_with_na_rep(values, formatter, na_rep)\n1395 | \n1396 |             if self.fixed_width:\n1397 |                 if is_complex:\n1398 |                     result = _trim_zeros_complex(values, self.decimal)\n1399 |                 else:\n1400 |                     result = _trim_zeros_float(values, self.decimal)\n1401 |                 return np.asarray(result, dtype=\"object\")\n1402 | \n1403 |             return values\n1404 | \n1405 |         # There is a special default string when we are fixed-width\n1406 |         # The default is otherwise to use str instead of a formatting string\n1407 |         float_format: FloatFormatType | None\n1408 |         if self.float_format is None:\n1409 |             if self.fixed_width:\n1410 |                 if self.leading_space is True:\n1411 |                     fmt_str = \"{value: .{digits:d}f}\"\n1412 |                 else:\n1413 |                     fmt_str = \"{value:.{digits:d}f}\"\n1414 |                 float_format = partial(fmt_str.format, digits=self.digits)\n1415 |             else:\n1416 |                 float_format = self.float_format\n1417 |         else:\n1418 |             float_format = lambda value: self.float_format % value\n1419 | \n1420 |         formatted_values = format_values_with(float_format)\n1421 | \n1422 |         if not self.fixed_width:\n1423 |             return formatted_values\n1424 | \n1425 |         # we need do convert to engineering format if some values are too small\n1426 |         # and would appear as 0, or if some values are too big and take too\n1427 |         # much space\n1428 | \n1429 |         if len(formatted_values) > 0:\n1430 |             maxlen = max(len(x) for x in formatted_values)\n1431 |             too_long = maxlen > self.digits + 6\n1432 |         else:\n1433 |             too_long = False\n1434 | \n1435 |         abs_vals = np.abs(self.values)\n1436 |         # this is pretty arbitrary for now\n1437 |         # large values: more that 8 characters including decimal symbol\n1438 |         # and first digit, hence > 1e6\n1439 |         has_large_values = (abs_vals > 1e6).any()\n1440 |         has_small_values = ((abs_vals < 10 ** (-self.digits)) & (abs_vals > 0)).any()\n1441 | \n1442 |         if has_small_values or (too_long and has_large_values):\n1443 |             if self.leading_space is True:\n1444 |                 fmt_str = \"{value: .{digits:d}e}\"\n1445 |             else:\n1446 |                 fmt_str = \"{value:.{digits:d}e}\"\n1447 |             float_format = partial(fmt_str.format, digits=self.digits)\n1448 |             formatted_values = format_values_with(float_format)\n1449 | \n1450 |         return formatted_values\n1451 | \n1452 |     def _format_strings(self) -> list[str]:\n1453 |         return list(self.get_result_as_array())\n1454 | \n1455 | \n1456 | class _IntArrayFormatter(_GenericArrayFormatter):\n1457 |     def _format_strings(self) -> list[str]:\n1458 |         if self.leading_space is False:\n1459 |             formatter_str = lambda x: f\"{x:d}\".format(x=x)\n1460 |         else:\n1461 |             formatter_str = lambda x: f\"{x: d}\".format(x=x)\n1462 |         formatter = self.formatter or formatter_str\n1463 |         fmt_values = [formatter(x) for x in self.values]\n1464 |         return fmt_values\n1465 | \n1466 | \n1467 | class _Datetime64Formatter(_GenericArrayFormatter):\n1468 |     values: DatetimeArray\n1469 | \n1470 |     def __init__(\n1471 |         self,\n1472 |         values: DatetimeArray,\n1473 |         nat_rep: str = \"NaT\",\n1474 |         date_format: None = None,\n1475 |         **kwargs,\n1476 |     ) -> None:\n1477 |         super().__init__(values, **kwargs)\n1478 |         self.nat_rep = nat_rep\n1479 |         self.date_format = date_format\n1480 | \n1481 |     def _format_strings(self) -> list[str]:\n1482 |         \"\"\"we by definition have DO NOT have a TZ\"\"\"\n1483 |         values = self.values\n1484 | \n1485 |         if self.formatter is not None:\n1486 |             return [self.formatter(x) for x in values]\n1487 | \n1488 |         fmt_values = values._format_native_types(\n1489 |             na_rep=self.nat_rep, date_format=self.date_format\n1490 |         )\n1491 |         return fmt_values.tolist()\n1492 | \n1493 | \n1494 | class _ExtensionArrayFormatter(_GenericArrayFormatter):\n1495 |     values: ExtensionArray\n1496 | \n1497 |     def _format_strings(self) -> list[str]:\n1498 |         values = self.values\n1499 | \n1500 |         formatter = self.formatter\n1501 |         fallback_formatter = None\n1502 |         if formatter is None:\n1503 |             fallback_formatter = values._formatter(boxed=True)\n1504 | \n1505 |         if isinstance(values, Categorical):\n1506 |             # Categorical is special for now, so that we can preserve tzinfo\n1507 |             array = values._internal_get_values()\n1508 |         else:\n1509 |             array = np.asarray(values, dtype=object)\n1510 | \n1511 |         fmt_values = format_array(\n1512 |             array,\n1513 |             formatter,\n1514 |             float_format=self.float_format,\n1515 |             na_rep=self.na_rep,\n1516 |             digits=self.digits,\n1517 |             space=self.space,\n1518 |             justify=self.justify,\n1519 |             decimal=self.decimal,\n1520 |             leading_space=self.leading_space,\n1521 |             quoting=self.quoting,\n1522 |             fallback_formatter=fallback_formatter,\n1523 |         )\n1524 |         return fmt_values\n1525 | \n1526 | \n1527 | def format_percentiles(\n1528 |     percentiles: np.ndarray | Sequence[float],\n1529 | ) -> list[str]:\n1530 |     \"\"\"\n1531 |     Outputs rounded and formatted percentiles.\n1532 | \n1533 |     Parameters\n1534 |     ----------\n1535 |     percentiles : list-like, containing floats from interval [0,1]\n1536 | \n1537 |     Returns\n1538 |     -------\n1539 |     formatted : list of strings\n1540 | \n1541 |     Notes\n1542 |     -----\n1543 |     Rounding precision is chosen so that: (1) if any two elements of\n1544 |     ``percentiles`` differ, they remain different after rounding\n1545 |     (2) no entry is *rounded* to 0% or 100%.\n1546 |     Any non-integer is always rounded to at least 1 decimal place.\n1547 | \n1548 |     Examples\n1549 |     --------\n1550 |     Keeps all entries different after rounding:\n1551 | \n1552 |     >>> format_percentiles([0.01999, 0.02001, 0.5, 0.666666, 0.9999])\n1553 |     ['1.999%', '2.001%', '50%', '66.667%', '99.99%']\n1554 | \n1555 |     No element is rounded to 0% or 100% (unless already equal to it).\n1556 |     Duplicates are allowed:\n1557 | \n1558 |     >>> format_percentiles([0, 0.5, 0.02001, 0.5, 0.666666, 0.9999])\n1559 |     ['0%', '50%', '2.0%', '50%', '66.67%', '99.99%']\n1560 |     \"\"\"\n1561 |     percentiles = np.asarray(percentiles)\n1562 | \n1563 |     # It checks for np.nan as well\n1564 |     if (\n1565 |         not is_numeric_dtype(percentiles)\n1566 |         or not np.all(percentiles >= 0)\n1567 |         or not np.all(percentiles <= 1)\n1568 |     ):\n1569 |         raise ValueError(\"percentiles should all be in the interval [0,1]\")\n1570 | \n1571 |     percentiles = 100 * percentiles\n1572 |     prec = get_precision(percentiles)\n1573 |     percentiles_round_type = percentiles.round(prec).astype(int)\n1574 | \n1575 |     int_idx = np.isclose(percentiles_round_type, percentiles)\n1576 | \n1577 |     if np.all(int_idx):\n1578 |         out = percentiles_round_type.astype(str)\n1579 |         return [i + \"%\" for i in out]\n1580 | \n1581 |     unique_pcts = np.unique(percentiles)\n1582 |     prec = get_precision(unique_pcts)\n1583 |     out = np.empty_like(percentiles, dtype=object)\n1584 |     out[int_idx] = percentiles[int_idx].round().astype(int).astype(str)\n1585 | \n1586 |     out[~int_idx] = percentiles[~int_idx].round(prec).astype(str)\n1587 |     return [i + \"%\" for i in out]\n1588 | \n1589 | \n1590 | def get_precision(array: np.ndarray | Sequence[float]) -> int:\n1591 |     to_begin = array[0] if array[0] > 0 else None\n1592 |     to_end = 100 - array[-1] if array[-1] < 100 else None\n1593 |     diff = np.ediff1d(array, to_begin=to_begin, to_end=to_end)\n1594 |     diff = abs(diff)\n1595 |     prec = -np.floor(np.log10(np.min(diff))).astype(int)\n1596 |     prec = max(1, prec)\n1597 |     return prec\n1598 | \n1599 | \n1600 | def _format_datetime64(x: NaTType | Timestamp, nat_rep: str = \"NaT\") -> str:\n1601 |     if x is NaT:\n1602 |         return nat_rep\n1603 | \n1604 |     # Timestamp.__str__ falls back to datetime.datetime.__str__ = isoformat(sep=' ')\n1605 |     # so it already uses string formatting rather