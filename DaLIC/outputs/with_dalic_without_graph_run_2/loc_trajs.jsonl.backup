ridge.\n13 | \n14 | \"\"\"\n15 | \n16 | # Authors: Manoj Kumar mks542@nyu.edu\n17 | # License: BSD 3 clause\n18 | \n19 | import numpy as np\n20 | import matplotlib.pyplot as plt\n21 | \n22 | from sklearn.datasets import make_regression\n23 | from sklearn.linear_model import HuberRegressor, Ridge\n24 | \n25 | # Generate toy data.\n26 | rng = np.random.RandomState(0)\n27 | X, y = make_regression(\n28 |     n_samples=20, n_features=1, random_state=0, noise=4.0, bias=100.0\n29 | )\n30 | \n31 | # Add four strong outliers to the dataset.\n32 | X_outliers = rng.normal(0, 0.5, size=(4, 1))\n33 | y_outliers = rng.normal(0, 2.0, size=4)\n34 | X_outliers[:2, :] += X.max() + X.mean() / 4.0\n35 | X_outliers[2:, :] += X.min() - X.mean() / 4.0\n36 | y_outliers[:2] += y.min() - y.mean() / 4.0\n37 | y_outliers[2:] += y.max() + y.mean() / 4.0\n38 | X = np.vstack((X, X_outliers))\n39 | y = np.concatenate((y, y_outliers))\n40 | plt.plot(X, y, \"b.\")\n41 | \n42 | # Fit the huber regressor over a series of epsilon values.\n43 | colors = [\"r-\", \"b-\", \"y-\", \"m-\"]\n44 | \n45 | x = np.linspace(X.min(), X.max(), 7)\n46 | epsilon_values = [1, 1.5, 1.75, 1.9]\n47 | for k, epsilon in enumerate(epsilon_values):\n48 |     huber = HuberRegressor(alpha=0.0, epsilon=epsilon)\n49 |     huber.fit(X, y)\n50 |     coef_ = huber.coef_ * x + huber.intercept_\n51 |     plt.plot(x, coef_, colors[k], label=\"huber loss, %s\" % epsilon)\n52 | \n53 | # Fit a ridge regressor to compare it to huber regressor.\n54 | ridge = Ridge(alpha=0.0, random_state=0)\n55 | ridge.fit(X, y)\n56 | coef_ridge = ridge.coef_\n57 | coef_ = ridge.coef_ * x + ridge.intercept_\n58 | plt.plot(x, coef_, \"g-\", label=\"ridge regression\")\n59 | \n60 | plt.title(\"Comparison of HuberRegressor vs Ridge\")\n61 | plt.xlabel(\"X\")\n62 | plt.ylabel(\"y\")\n63 | plt.legend(loc=0)\n64 | plt.show()\n65 | \n```\n\nFound class `sklearn/manifold/_t_sne.py:TSNE`.\nSource: Retrieved entity using keyword search (bm25).\nJust show the structu