f some dtype\n2157 |     # X_transformed should be from the same dtype.\n2158 |     transformer = clone(transformer_orig)\n2159 |     if hasattr(transformer, \"set_output\"):\n2160 |         transformer.set_output(transform=\"default\")\n2161 |     X, y = make_blobs(\n2162 |         n_samples=30,\n2163 |         centers=[[0, 0, 0], [1, 1, 1]],\n2164 |         random_state=0,\n2165 |         cluster_std=0.1,\n2166 |     )\n2167 |     X = StandardScaler().fit_transform(X)\n2168 |     X = _enforce_estimator_tags_X(transformer_orig, X)\n2169 | \n2170 |     for dtype in get_tags(transformer_orig).transformer_tags.preserves_dtype:\n2171 |         X_cast = X.astype(dtype)\n2172 |         set_random_state(transformer)\n2173 |         X_trans1 = transformer.fit_transform(X_cast, y)\n2174 |         X_trans2 = transformer.fit(X_cast, y).transform(X_cast)\n2175 | \n2176 |         for Xt, method in zip([X_trans1, X_trans2], [\"fit_transform\", \"transform\"]):\n2177 |             if isinstance(Xt, tuple):\n2178 |                 # cross-decompostion returns a tuple of (x_scores, y_scores)\n2179 |                 # when given y with fit_transform; only check the first element\n2180 |                 Xt = Xt[0]\n2181 | \n2182 |             # check that the output dtype is preserved\n2183 |             assert Xt.dtype == dtype, (\n2184 |                 f\"{name} (method={method}) does not preserve dtype. \"\n2185 |                 f\"Original/Expected dtype={dtype}, got dtype={Xt.dtype}.\"\n2186 |             )\n```\n\nFound function `sklearn/utils/validation.py:_check_sample_weight`.\nSource: Retrieved code content using keyword search (bm25).\n```\n2120 | def _check_sample_weight(\n2121 |     sample_weight, X, dtype=None, copy=False, ensure_non_negative=False\n2122 | ):\n2123 |     \"\"\"Validate sample weights.\n2124 | \n2125 |     Note that passing sample_weight=None will output an array of ones.\n2126 |     Therefore, in some cases, you may want to protect the call with:\n2127 |     if sample_weight is not None:\n2128 |         sample_weight = _check_sample_weight(...)\n2129 | \n2130 |     Parameters\n2131 |     ----------\n2132 |     sample_weight : {ndarray, Number or None}, shape (n_samples,)\n2133 |         Input sample weights.\n2134 | \n2135 |     X : {ndarray, list, sparse matrix}\n2136 |         Input data.\n2137 | \n2138 |     ensure_non_negative : bool, default=False,\n2139 |         Whether or not the weights are expected to be non-negative.\n2140 | \n2141 |         .. versionadded:: 1.0\n2142 | \n2143 |     dtype : dtype, default=None\n2144 |         dtype of the validated `sample_weight`.\n2145 |         If None, and the input `sample_weight` is an array, the dtype of the\n2146 |         input is preserved; otherwise an array with the default numpy dtype\n2147 |         is be allocated.  If `dtype` is not one of `float32`, `float64`,\n2148 |         `None`, the output will be of dtype `float64`.\n2149 | \n2150 |     copy : bool, default=False\n2151 |         If True, a copy of sample_weight will be created.\n2152 | \n2153 |     Returns\n2154 |     -------\n2155 |     sample_weight : ndarray of shape (n_samples,)\n2156 |         Validated sample weight. It is guaranteed to be \"C\" contiguous.\n2157 |     \"\"\"\n2158 |     n_samples = _num_samples(X)\n2159 | \n2160 |     if dtype is not None and dtype not in [np.float32, np.float64]:\n2161 |         dtype = np.float64\n2162 | \n2163 |     if sample_weight is None:\n2164 |         sample_weight = np.ones(n_samples, dtype=dtype)\n2165 |     elif isinstance(sample_weight, numbers.Number):\n2166 |         sample_weight = np.full(n_samples, sample_weight, dtype=dtype)\n2167 |     else:\n2168 |         if dtype is None:\n2169 |             dtype = [np.float64, np.float32]\n2170 |         sample_weight = check_array(\n2171 |             sample_weight,\n2172 |             accept_sparse=False,\n2173 |             ensure_2d=False,\n2174 |             dtype=dtype,\n2175 |             