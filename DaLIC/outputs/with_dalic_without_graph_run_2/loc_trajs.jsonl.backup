\n1043 |                     array = _asarray_with_order(array, order=order, xp=xp)\n1044 |                     if xp.isdtype(array.dtype, (\"real floating\", \"complex floating\")):\n1045 |                         _assert_all_finite(\n1046 |                             array,\n1047 |                             allow_nan=False,\n1048 |                             msg_dtype=dtype,\n1049 |                             estimator_name=estimator_name,\n1050 |                             input_name=input_name,\n1051 |                         )\n1052 |                     array = xp.astype(array, dtype, copy=False)\n1053 |                 else:\n1054 |                     array = _asarray_with_order(array, order=order, dtype=dtype, xp=xp)\n1055 |             except ComplexWarning as complex_warning:\n1056 |                 raise ValueError(\n1057 |                     \"Complex data not supported\\n{}\\n\".format(array)\n1058 |                 ) from complex_warning\n1059 | \n1060 |         # It is possible that the np.array(..) gave no warning. This happens\n1061 |         # when no dtype conversion happened, for example dtype = None. The\n1062 |         # result is that np.array(..) produces an array of complex dtype\n1063 |         # and we need to catch and raise exception for such cases.\n1064 |         _ensure_no_complex_data(array)\n1065 | \n1066 |         if ensure_2d:\n1067 |             # If input is scalar raise error\n1068 |             if array.ndim == 0:\n1069 |                 raise ValueError(\n1070 |                     \"Expected 2D array, got scalar array instead:\\narray={}.\\n\"\n1071 |                     \"Reshape your data either using array.reshape(-1, 1) if \"\n1072 |                     \"your data has a single feature or array.reshape(1, -1) \"\n1073 |                     \"if it contains a single sample.\".format(array)\n1074 |                 )\n1075 |             # If input is 1D raise error\n1076 |             if array.ndim == 1:\n1077 |    