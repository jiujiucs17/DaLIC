    ax.plot(\n285 |                 times,\n286 |                 scores,\n287 |                 label=solver,\n288 |                 color=colors[solver],\n289 |                 linestyle=linestyles[dtype],\n290 |                 marker=\".\",\n291 |                 alpha=alpha[dtype],\n292 |             )\n293 |             ax.axvline(\n294 |                 times[-1],\n295 |                 color=colors[solver],\n296 |                 alpha=alpha[dtype],\n297 |                 linestyle=linestyles[dtype],\n298 |             )\n299 | \n300 |         ax.set_xlabel(\"Time (s)\")\n301 |         ax.set_ylabel(\"Test objective (relative to min)\")\n302 |         ax.set_yscale(\"log\")\n303 | \n304 |         ax = axes[2]\n305 |         for accuracy, times, solver, dtype in zip(\n306 |             group[\"accuracies\"], group[\"times\"], group[\"solver\"], group[\"dtype\"]\n307 |         ):\n308 |             ax.plot(\n309 |                 times,\n310 |                 accuracy,\n311 |                 label=\"%s - %s\" % (solver, dtype),\n312 |                 alpha=alpha[dtype],\n313 |                 marker=\".\",\n314 |                 color=colors[solver],\n315 |                 linestyle=linestyles[dtype],\n316 |             )\n317 |             ax.axvline(\n318 |                 times[-1],\n319 |                 color=colors[solver],\n320 |                 alpha=alpha[dtype],\n321 |                 linestyle=linestyles[dtype],\n322 |             )\n323 | \n324 |         ax.set_xlabel(\"Time (s)\")\n325 |         ax.set_ylabel(\"Test accuracy\")\n326 |         ax.legend()\n327 |         name = \"single_target\" if single_target else \"multi_target\"\n328 |         name += \"_%s\" % penalty\n329 |         plt.suptitle(name)\n330 |         if outname is None:\n331 |             outname = name + \".png\"\n332 |         fig.tight_layout()\n333 |         fig.subplots_adjust(top=0.9)\n334 | \n335 |         ax = axes[3]\n336 |         for scores, times, solver, dtype in z