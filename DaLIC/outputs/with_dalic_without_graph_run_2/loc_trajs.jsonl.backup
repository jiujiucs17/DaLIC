dex=idx)\n461 |             return [others[x] for x in others]\n462 |         elif is_list_like(others, allow_sets=False):\n463 |             try:\n464 |                 others = list(others)  # ensure iterators do not get read twice etc\n465 |             except TypeError:\n466 |                 # e.g. ser.str, raise below\n467 |                 pass\n468 |             else:\n469 |                 # in case of list-like `others`, all elements must be\n470 |                 # either Series/Index/np.ndarray (1-dim)...\n471 |                 if all(\n472 |                     isinstance(x, (ABCSeries, ABCIndex, ExtensionArray))\n473 |                     or (isinstance(x, np.ndarray) and x.ndim == 1)\n474 |                     for x in others\n475 |                 ):\n476 |                     los: list[Series] = []\n477 |                     while others:  # iterate through list and append each element\n478 |                         los = los + self._get_series_list(others.pop(0))\n479 |                     return los\n480 |                 # ... or just strings\n481 |                 elif all(not is_list_like(x) for x in others):\n482 |                     return [Series(others, index=idx)]\n483 |         raise TypeError(\n484 |             \"others must be Series, Index, DataFrame, np.ndarray \"\n485 |             \"or list-like (either containing only strings or \"\n486 |             \"containing only objects of type Series/Index/\"\n487 |             \"np.ndarray[1-dim])\"\n488 |         )\n```\n\nFound function `web/pandas_web.py:main`.\nSource: Retrieved code content using keyword search (bm25).\n```\n434 | def main(\n435 |     source_path: str,\n436 |     target_path: str,\n437 | ) -> int:\n438 |     \"\"\"\n439 |     Copy every file in the source directory to the target directory.\n440 | \n441 |     For ``.md`` and ``.html`` files, render them with the context\n442 |     before copying them. ``.md`` files are transformed to HTML.\n443 |     \"\"\"\n444 |     config_fname = os.path.join(source_path, \"config.yml\")\n445 | \n446 |     shutil.rmtree(target_path, ignore_errors=True)\n447 |     os.makedirs(target_path, exist_ok=True)\n448 | \n449 |     sys.stderr.write(\"Generating context...\\n\")\n450 |     context = get_context(config_fname, target_path=target_path)\n451 |     sys.stderr.write(\"Context generated\\n\")\n452 | \n453 |     templates_path = os.path.join(source_path, context[\"main\"][\"templates_path\"])\n454 |     jinja_env = jinja2.Environment(loader=jinja2.FileSystemLoader(templates_path))\n455 | \n456 |     for fname in get_source_files(source_path):\n457 |         if os.path.normpath(fname) in context[\"main\"][\"ignore\"]:\n458 |             continue\n459 | \n460 |         sys.stderr.write(f\"Processing {fname}\\n\")\n461 |         dirname = os.path.dirname(fname)\n462 |         os.makedirs(os.path.join(target_path, dirname), exist_ok=True)\n463 | \n464 |         extension = os.path.splitext(fname)[-1]\n465 |         if extension in (\".html\", \".md\"):\n466 |             with open(os.path.join(source_path, fname), encoding=\"utf-8\") as f:\n467 |                 content = f.read()\n468 |             if extension == \".md\":\n469 |                 body = markdown.markdown(\n470 |                     content, extensions=context[\"main\"][\"markdown_extensions\"]\n471 |                 )\n472 |                 # Apply Bootstrap's table formatting manually\n473 |                 # Python-Markdown doesn't let us config table attributes by hand\n474 |                 body = body.replace(\"<table>\", '<table class=\"table table-bordered\">')\n475 |                 content = extend_base_template(body, context[\"main\"][\"base_template\"])\n476 |             context[\"base_url\"] = \"\".join([\"../\"] * os.path.normpath(fname).count(\"/\"))\n477 |             content = jinja_env.from_string(content).render(**context)\n478 |             fname_html = os.path.splitext(fname)[0] + \".html\"\n479 |             with open(\n480 |                 os.path.join(target_path, fname_html), \"w\", encoding=\"utf-8\"\n481 |             ) as f:\n482 |                 f.write(content)\n483 |         else:\n484 |             shutil.copy(\n485 |                 os.path.join(source_path, fname), os.path.join(target_path, dirname)\n486 |             )\n```\n\nFound function `pandas/core/computation/pytables.py:PyTablesExpr.__repr__`.\nSource: Retrieved code content using keyword search (bm25).\n```\n611 | def __repr__(self) -> str:\n612 |         if self.terms is not None:\n613 |             return pprint_thing(self.terms)\n614 |         return pprint_thing(self.expr)\n```\n\nFound function `pandas/core/computation/pytables.py:PyTablesExpr.evaluate`.\nSource: Retrieved code content using keyword search (bm25).\n```\n616 | def evaluate(self):\n617 |         \"\"\"create and return the numexpr condition and filter\"\"\"\n618 |         try:\n619 |             self.condition = self.terms.prune(ConditionBinOp)\n620 |         except AttributeError as err:\n621 |             raise ValueError(\n622 |                 f\"cannot process expression [{self.expr}], [{self}] \"\n623 |                 \"is not a valid condition\"\n624 |             ) from err\n625 |         try:\n626 |             self.filter = self.terms.prune(FilterBinOp)\n627 |         except AttributeError as err:\n628 |             raise ValueError(\n629 |                 f\"cannot process expression [{self.expr}], [{self}] \"\n630 |                 \"is not a valid filter\"\n631 |             ) from err\n632 | \n633 |         return self.condition, self.filter\n```\n\nFound function `pandas/core/computation/pytables.py:TermValue.tostring`.\nSource: Retrieved code content using keyword search (bm25).\n```\n645 | def tostring(self, encoding) -> str:\n646 |         \"\"\"quote the string if not encoded else encode and return\"\"\"\n647 |         if self.kind == \"string\":\n648 |             if encoding is not None:\n649 |             