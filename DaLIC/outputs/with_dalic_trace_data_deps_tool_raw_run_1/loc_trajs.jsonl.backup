 "OBSERVATION:\n{\n  \"instance_id\": \"scikit-learn__scikit-learn-16948\",\n  \"trace_summary\": {\n    \"unique_function_count\": 110,\n    \"returned_count\": 8,\n    \"filtered_count\": 18\n  },\n  \"applied_filters\": {\n    \"artifact_type\": \"all\",\n    \"path_contains\": \"sklearn/decomposition/_nmf.py\",\n    \"name_contains\": null,\n    \"start\": 0,\n    \"limit\": 8\n  },\n  \"artifacts\": [\n    {\n      \"qualified_name\": \"norm\",\n      \"path\": \"sklearn/decomposition/_nmf.py\",\n      \"definition_type\": \"function\",\n      \"defined_line\": 32,\n      \"end_line\": 42,\n      \"event_count\": 12,\n      \"call_count\": 4,\n      \"max_call_depth\": 6\n    },\n    {\n      \"qualified_name\": \"_beta_divergence\",\n      \"path\": \"sklearn/decomposition/_nmf.py\",\n      \"definition_type\": \"function\",\n      \"defined_line\": 70,\n      \"end_line\": 174,\n      \"event_count\": 24012,\n      \"call_count\": 2001,\n      \"max_call_depth\": 5\n    },\n    {\n      \"qualified_name\": \"_compute_regularization\",\n      \"path\": \"sklearn/decomposition/_nmf.py\",\n      \"definition_type\": \"function\",\n      \"defined_line\": 198,\n      \"end_line\": 218,\n      \"event_count\": 11,\n      \"call_count\": 1,\n      \"max_call_depth\": 6\n    },\n    {\n      \"qualified_name\": \"_beta_loss_to_float\",\n      \"path\": \"sklearn/decomposition/_nmf.py\",\n      \"definition_type\": \"function\",\n      \"defined_line\": 221,\n      \"end_line\": 232,\n      \"event_count\": 12013,\n      \"call_count\": 2002,\n      \"max_call_depth\": 6\n    },\n    {\n      \"qualified_name\": \"_initialize_nmf\",\n      \"path\": \"sklearn/decomposition/_nmf.py\",\n      \"definition_type\": \"function\",\n      \"defined_line\": 235,\n      \"end_line\": 387,\n      \"event_count\": 38,\n      \"call_count\": 1,\n      \"max_call_depth\": 5\n    },\n    {\n      \"qualified_name\": \"_multiplicative_update_w\",\n      \"path\": \"sklearn/decompos