umPy array of objects for any input.\n2588 | \n2589 |     Parameters\n2590 |     ----------\n2591 |     sequence : array-like of shape (n_elements,)\n2592 |         The sequence to be converted.\n2593 | \n2594 |     Returns\n2595 |     -------\n2596 |     out : ndarray of shape (n_elements,), dtype=object\n2597 |         The converted sequence into a 1-D NumPy array of object dtype.\n2598 | \n2599 |     Examples\n2600 |     --------\n2601 |     >>> import numpy as np\n2602 |     >>> from sklearn.utils.validation import _to_object_array\n2603 |     >>> _to_object_array([np.array([0]), np.array([1])])\n2604 |     array([array([0]), array([1])], dtype=object)\n2605 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2606 |     array([array([0]), array([1, 2])], dtype=object)\n2607 |     >>> _to_object_array([np.array([0]), np.array([1, 2])])\n2608 |     array([array([0]), array([1, 2])], dtype=object)\n2609 |     \"\"\"\n2610 |     out = np.empty(len(sequence), dtype=object)\n2611 |     out[:] = sequence\n2612 |     return out\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_pinv2_old`.\nSource: Retrieved code content using keyword search (bm25).\n```\n41 | def _pinv2_old(a):\n42 |     # Used previous scipy pinv2 that was updated in:\n43 |     # https://github.com/scipy/scipy/pull/10067\n44 |     # We can not set `cond` or `rcond` for pinv2 in scipy >= 1.3 to keep the\n45 |     # same behavior of pinv2 for scipy < 1.3, because the condition used to\n46 |     # determine the rank is dependent on the output of svd.\n47 |     u, s, vh = svd(a, full_matrices=False, check_finite=False)\n48 | \n49 |     t = u.dtype.char.lower()\n50 |     factor = {\"f\": 1e3, \"d\": 1e6}\n51 |     cond = np.max(s) * factor[t] * np.finfo(t).eps\n52 |     rank = np.sum(s > cond)\n53 | \n54 |     u = u[:, :rank]\n55 |     u /= s[:rank]\n56 |     return np.transpose(np.conjugate(np.dot(u, vh[:rank])))\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_get_first_singular_vectors_power_method`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 59 | def _get_first_singular_vectors_power_method(\n 60 |     X, Y, mode=\"A\", max_iter=500, tol=1e-06, norm_y_weights=False\n 61 | ):\n 62 |     \"\"\"Return the first left and right singular vectors of X'Y.\n 63 | \n 64 |     Provides an alternative to the svd(X'Y) and uses the power method instead.\n 65 |     With norm_y_weights to True and in mode A, this corresponds to the\n 66 |     algorithm section 11.3 of the Wegelin's review, except this starts at the\n 67 |     \"update saliences\" part.\n 68 |     \"\"\"\n 69 | \n 70 |     eps = np.finfo(X.dtype).eps\n 71 |     try:\n 72 |         y_score = next(col for col in Y.T if np.any(np.abs(col) > eps))\n 73 |     except StopIteration as e:\n 74 |         raise StopIteration(\"y residual is constant\") from e\n 75 | \n 76 |     x_weights_old = 100  # init to big value for first convergence check\n 77 | \n 78 |     if mode == \"B\":\n 79 |         # Precompute pseudo inverse matrices\n 80 |         # Basically: X_pinv = (X.T X)^-1 X.T\n 81 |         # Which requires inverting a (n_features, n_features) matrix.\n 82 |         # As a result, and as detailed in the Wegelin's review, CCA (i.e. mode\n 83 |         # B) will be unstable if n_features > n_samples or n_targets >\n 84 |         # n_samples\n 85 |         X_pinv, Y_pinv = _pinv2_old(X), _pinv2_old(Y)\n 86 | \n 87 |     for i in range(max_iter):\n 88 |         if mode == \"B\":\n 89 |             x_weights = np.dot(X_pinv, y_score)\n 90 |         else:\n 91 |             x_weights = np.dot(X.T, y_score) / np.dot(y_score, y_score)\n 92 | \n 93 |         x_weights /= np.sqrt(np.dot(x_weights, x_weights)) + eps\n 94 |         x_score = np.dot(X, x_weights)\n 95 | \n 96 |         if mode == \"B\":\n 97 |             y_weights = np.dot(Y_pinv, x_score)\n 98 |         else:\n 99 |             y_weights = np.dot(Y.T, x_score) / np.dot(x_score.T, x_score)\n100 | \n101 |         if norm_y_weights:\n102 |             y_weights /= np.sqrt(np.dot(y_weights, y_weights)) + eps\n103 | \n104 |         y_score = np.dot(Y, y_weights) / (np.dot(y_weights, y_weights) + eps)\n105 | \n106 |         x_weights_diff = x_weights - x_weights_old\n107 |         if np.dot(x_weights_diff, x_weights_diff) < tol or Y.shape[1] == 1:\n108 |             break\n109 |         x_weights_old = x_weights\n110 | \n111 |     n_iter = i + 1\n112 |     if n_iter == max_iter:\n113 |         warnings.warn(\"Maximum number of iterations reached\", ConvergenceWarning)\n114 | \n115 |     return x_weights, y_weights, n_iter\n```\n\nFound function `sklearn/cross_decomposition/_pls.py:_center_scale_xy`.\nSource: Retrieved code content using keyword search (bm25).\n```\n128 | def _center_scale_xy(X, Y, scale=True):\n129 |     \"\"\"Center X, Y and scale if the scale parameter==True\n130 | \n131 |     Returns\n132 |     -------\n133 |         X, Y, x_mean, y_mean, x_std, y_std\n134 |     \"\"\"\n135 |     # center\n136 |     x_mean = X.mean(axis=0)\n137 |     X -= x_mean\n138 |     y_mean = Y.mean(axis=0)\n139 |     Y -= y_mean\n140 |     # scale\n141 |     if scale:\n142 |         x_std = X.std(axis=0, ddof=1)\n143 |         x_std[x_std == 0.0] = 1.0\n144 |         X /= x_std\n145 |         y_std = Y.std(axis=0, ddof=1)\n146 |         y_std[y_std == 0.0] = 1.0\n147 |         Y /= y_std\n148 |     else:\n149 |         x_std = np.ones(X.shape[1])\n150 |         y_std = np.ones(Y.shape[1])\n151 |     return X, Y, x_mean, y_mean, x_std, y_std\n```\n\n\n\n##Searching for term \"_assert\", \"docstring _assert\"...\n### Search Result:\nFound function `sklearn/utils/validation.py:_assert_all_finite`.\nSource: Retrieved entity using keyword search (bm25).\n```\n 88 | def _assert_all_finite(\n 89 |     X, allow_nan=False, msg_dtype=None, estimator_name=None, input_name=\"\"\n 90 | ):\n 91 |     \"\"\"Like assert_all_finite, but only for ndarray.\"\"\"\n 92 | \n 93 |     xp, is_array_api = get_namespace(X)\n 94 | \n 95 |     if _get_config()[\"assume_finite\"]:\n 96 |         return\n 97 | \n 98 |     X = xp.asarray(X)\n 99 | \n100 |     # for object dtype data, we only check for NaNs (GH-13254)\n101 |     if not is_array_api and X.dtype == np.dtype(\"object\") and not allow_nan:\n102 |         if _object_dtype_isnan(X).any():\n103 |             raise ValueError(\"Input contains NaN\")\n104 | \n105 |     # We need only consider float arrays, hence can early return for all else.\n106 |     if not xp.isdtype(X.dtype, (\"real floating\", \"complex floating\")):\n107 |         return\n108 | \n109 |     # First try an O(n) time, O(1) space solution for the common case that\n110 |     # everything is finite; fall back to O(n) space `np.isinf/isnan` or custom\n111 |     # Cython implementation to prevent false positives and provide a detailed\n112 |     # error message.\n113 |     with np.errstate(over=\"ignore\"):\n114 |         first_pass_isfinite = xp.isfinite(xp.sum(X))\n115 |     if first_pass_isfinite:\n116 |         return\n117 | \n118 |     _assert_all_finite_element_wise(\n119 |         X,\n120 |         xp=xp,\n121 |         allow_nan=allow_nan,\n122 |         msg_dtype=msg_dtype,\n123 |         estimator_name=estimator_name,\n124 |         input_name=input_name,\n125 |     )\n```\n\nFound function `sklearn/utils/validation.py:_assert_all_finite_element_wise`.\nSource: Retrieved entity using keyword search (bm25).\n```\n128 | def _assert_all_finite_element_wise(\n129 |     X, *, xp, allow_nan, msg_dtype=None, estimator_name=None, input_name=\"\"\n130 | ):\n131 |     # Cython implementation doesn't support FP16 or complex numbers\n132 |     use_cython = (\n133 |         xp is np and X.data.contiguous and X.dtype.type in {np.float32, np.float64}\n134 |     )\n135 |     if use_cython:\n136 |         out = cy_isfinite(X.reshape(-1), allow_nan=allow_nan)\n137 |         has_nan_error = False if allow_nan else out == FiniteStatus.has_nan\n138 |         has_inf = out == FiniteStatus.has_infinite\n139 |     else:\n140 |         has_inf = xp.any(xp.isinf(X))\n141 |         has_nan_error = False if allow_nan else xp.any(xp.isnan(X))\n142 |     if has_inf or has_nan_error:\n143 |         if has_nan_error:\n144 |             type_err = \"NaN\"\n145 |         else:\n146 |             msg_dtype = msg_dtype if msg_dtype is not None else X.dtype\n147 |             type_err = f\"infinity or a value too large for {msg_dtype!r}\"\n148 |         padded_input_name = input_name + \" \" if input_name else \"\"\n149 |         msg_err = f\"Input {padded_input_name}contains {type_err}.\"\n150 |         if estimator_name and input_name == \"X\" and has_nan_error:\n151 |             # Improve the error message on how to handle missing values in\n152 |             # scikit-learn.\n153 |             msg_err += (\n154 |                 f\"\\n{estimator_name} does not accept missing values\"\n155 |                 \" encoded as NaN natively. For supervised learning, you might want\"\n156 |                 \" to consider sklearn.ensemble.HistGradientBoostingClassifier and\"\n157 |                 \" Regressor which accept missing values encoded as NaNs natively.\"\n158 |                 \" Alternatively, it is possible to preprocess the data, for\"\n159 |                 \" instance by using an imputer transformer in a pipeline or drop\"\n160 |                 \" samples with missing values. See\"\n161 |                 \" https://scikit-learn.org/stable/modules/impute.html\"\n162 |                 \" You can find a list of all estimators that handle NaN values\"\n163 |                 \" at the following page:\"\n164 |                 \" https://scikit-learn.org/stable/modules/impute.html\"\n165 |                 \"#estimators-that-handle-nan-values\"\n166 |             )\n167 |         raise ValueError(msg_err)\n```\n\nFound function `sklearn/utils/validation.py:assert_all_finite`.\nSource: Retrieved entity using keyword search (bm25).\n```\n170 | def assert_all_finite(\n171 |     X,\n172 |     *,\n173 |     allow_nan=False,\n174 |     estimator_name=None,\n175 |     input_name=\"\",\n176 | ):\n177 |     \"\"\"Throw a ValueError if X contains NaN or infinity.\n178 | \n179 |     Parameters\n180 |     ----------\n181 |     X : {ndarray, sparse matrix}\n182 |         The input data.\n183 | \n184 |     allow_nan : bool, default=False\n185 |         If True, do not throw error when `X` contains NaN.\n186 | \n187 |     estimator_name : str, default=None\n188 |         The estimator name, used to construct the error message.\n189 | \n190 |     input_name : str, default=\"\"\n191 |         The data name used to construct the error message. In particular\n192 |         if `input_name` is \"X\" and the data has NaN values and\n193 |         allow_nan is False, the error message will link to the imputer\n194 |         documentation.\n195 | \n196 |     Examples\n197 |     --------\n198 |     >>> from sklearn.utils import assert_all_finite\n199 |     >>> import numpy as np\n200 |     >>> array = np.array([1, np.inf, np.nan, 4])\n201 |     >>> try:\n202 |     ...     assert_all_finite(array)\n203 |     ...     print(\"Test passed: Array contains only finite values.\")\n204 |     ... except ValueError:\n205 |     ...     print(\"Test failed: Array contains non-finite values.\")\n206 |     Test failed: Array contains non-finite values.\n207 |     \"\"\"\n208 |     _assert_all_finite(\n209 |         X.data if sp.issparse(X) else X,\n210 |         allow_nan=allow_nan,\n211 |         estimator_name=estimator_name,\n212 |         input_name=input_name,\n213 |     )\n```\n\n\n\n##Searching for term \"docstring _assert\"...\n### Search Result:\nFound `sklearn/utils/deprecation.py:deprecated`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  4 | import functools\n  5 | import warnings\n  6 | \n  7 | __all__ = [\"deprecated\"]\n  8 | \n  9 | \n 10 | class deprecated:\n 11 |     \"\"\"Decorator to ma