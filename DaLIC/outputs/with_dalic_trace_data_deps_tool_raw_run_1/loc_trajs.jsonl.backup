) -> None:\n...\n    def _save(self) -> None:\n...\n    def __init__(\n        self,\n        path: FilePath | WriteExcelBuffer | ExcelWriter,\n        engine: str | None = None,\n        date_format: str | None = None,\n        datetime_format: str | None = None,\n        mode: str = \"w\",\n        storage_options: StorageOptions | None = None,\n        if_sheet_exists: ExcelWriterIfSheetExists | None = None,\n        engine_kwargs: dict[str, Any] | None = None,\n    ) -> None:\n...\n    @property\n    def date_format(self) -> str:\n...\n    @property\n    def datetime_format(self) -> str:\n...\n    @property\n    def if_sheet_exists(self) -> str:\n...\n    def __fspath__(self) -> str:\n...\n    def _get_sheet_name(self, sheet_name: str | None) -> str:\n...\n    def _value_with_fmt(\n        self, val\n    ) -> tuple[\n        int | float | bool | str | datetime.datetime | datetime.date, str | None\n    ]:\n...\n    @classmethod\n    def check_extension(cls, ext: str) -> Literal[True]:\n...\n    # Allow use as a contextmanager\n    def __enter__(self) -> Self:\n...\n    def __exit__(\n        self,\n        exc_type: type[BaseException] | None,\n        exc_value: BaseException | None,\n        traceback: TracebackType | None,\n    ) -> None:\n...\n    def close(self) -> None:\n\n```\nHint: Search `pandas/io/excel/_base.py:ExcelWriter` to get the full content if needed.\n\nFound function `pandas/io/excel/_base.py:ExcelWriter.engine`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1193 | def engine(self) -> str:\n1194 |         \"\"\"Name of engine.\"\"\"\n1195 |         return self._engine\n```\n\nFound function `pandas/io/excel/_base.py:ExcelWriter.__enter__`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1389 | def __enter__(self) -> Self:\n1390 |         return self\n```\n\nFound function `pandas/io/formats/style.py:Styler.to_excel`.\nSource: Retrieved code content using keyword search (bm25).\n```\n571 | def to_excel(\n572 |       