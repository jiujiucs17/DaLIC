243 |         Parameters\n 244 |         ----------\n 245 |         value : str\n 246 | \n 247 |         Returns\n 248 |         -------\n 249 |         Period, Timestamp, or Timedelta, or NaT\n 250 |             Whatever the type of ``self._scalar_type`` is.\n 251 | \n 252 |         Notes\n 253 |         -----\n 254 |         This should call ``self._check_compatible_with`` before\n 255 |         unboxing the result.\n 256 |         \"\"\"\n 257 |         raise AbstractMethodError(self)\n 258 | \n 259 |     def _unbox_scalar(\n 260 |         self, value: DTScalarOrNaT\n 261 |     ) -> np.int64 | np.datetime64 | np.timedelta64:\n 262 |         \"\"\"\n 263 |         Unbox the integer value of a scalar `value`.\n 264 | \n 265 |         Parameters\n 266 |         ----------\n 267 |         value : Period, Timestamp, Timedelta, or NaT\n 268 |             Depending on subclass.\n 269 | \n 270 |         Returns\n 271 |         -------\n 272 |         int\n 273 | \n 274 |         Examples\n 275 |         --------\n 276 |         >>> arr = pd.array(np.array([\"1970-01-01\"], \"datetime64[ns]\"))\n 277 |         >>> arr._unbox_scalar(arr[0])\n 278 |         numpy.datetime64('1970-01-01T00:00:00.000000000')\n 279 |         \"\"\"\n 280 |         raise AbstractMethodError(self)\n 281 | \n 282 |     def _check_compatible_with(self, other: DTScalarOrNaT) -> None:\n 283 |         \"\"\"\n 284 |         Verify that `self` and `other` are compatible.\n 285 | \n 286 |         * DatetimeArray verifies that the timezones (if any) match\n 287 |         * PeriodArray verifies that the freq matches\n 288 |         * Timedelta has no verification\n 289 | \n 290 |         In each case, NaT is considered compatible.\n 291 | \n 292 |         Parameters\n 293 |         ----------\n 294 |         other\n 295 | \n 296 |         Raises\n 297 |         ------\n 298 |         Exception\n 299 |         \"\"\"\n 300 |         raise AbstractMethodError(self)\n 301 | \n 302 |     # ------------------------------------------------------------------\n 303 | \n 304 |     def _box_func(self, x):\n 305 |         \"\"\"\n 306 |         box function to get object from internal representation\n 307 |         \"\"\"\n 308 |         raise AbstractMethodError(self)\n 309 | \n 310 |     def _box_values(self, values) -> np.ndarray:\n 311 |         \"\"\"\n 312 |         apply box func to passed values\n 313 |         \"\"\"\n 314 |         return lib.map_infer(values, self._box_func, convert=False)\n 315 | \n 316 |     def __iter__(self) -> Iterator:\n 317 |         if self.ndim > 1:\n 318 |             return (self[n] for n in range(len(self)))\n 319 |         else:\n 320 |             return (self._box_func(v) for v in self.asi8)\n 321 | \n 322 |     @property\n 323 |     def asi8(self) -> npt.NDArray[np.int64]:\n 324 |         \"\"\"\n 325 |         Integer representation of the values.\n 326 | \n 327 |         Returns\n 328 |         -------\n 329 |         ndarray\n 330 |             An ndarray with int64 dtype.\n 331 |         \"\"\"\n 332 |         # do not cache or you'll create a memory leak\n 333 |         return self._ndarray.view(\"i8\")\n 334 | \n 335 |     # ----------------------------------------------------------------\n 336 |     # Rendering Methods\n 337 | \n 338 |     def _format_native_types(\n 339 |         self, *, na_rep: str | float = \"NaT\", date_format=None\n 340 |     ) -> npt.NDArray[np.object_]:\n 341 |         \"\"\"\n 342 |         Helper method for astype when converting to strings.\n 343 | \n 344 |         Returns\n 345 |         -------\n 346 |         ndarray[str]\n 347 |         \"\"\"\n 348 |         raise AbstractMethodError(self)\n 349 | \n 350 |     def _formatter(self, boxed: bool = False) -> Callable[[object], str]:\n 351 |         # TODO: Remove Datetime & DatetimeTZ formatters.\n 352 |         return \"'{}'\".format\n 353 | \n 354 |     # ----------------------------------------------------------------\n 355 |     # Array-Like / EA-Interface Methods\n 356 | \n 357 |     def __array__(\n 358 |         self, dtype: NpDtype | None = None, copy: bool | None = None\n 359 |     ) -> np.ndarray:\n 360 |         # used for Timedelta/DatetimeArray, overwritten by PeriodArray\n 361 |         if is_object_dtype(dtype):\n 362 |             return np.array(list(self), dtype=object)\n 363 |         return self._ndarray\n 364 | \n 365 |     @overload\n 366 |     def __getitem__(self, key: ScalarIndexer) -> DTScalarOrNaT: ...\n 367 | \n 368 |     @overload\n 369 |     def __getitem__(\n 370 |         self,\n 371 |         key: SequenceIndexer | PositionalIndexerTuple,\n 372 |     ) -> Self: ...\n 373 | \n 374 |     def __getitem__(self, key: PositionalIndexer2D) -> Self | DTScalarOrNaT:\n 375 |         \"\"\"\n 376 |         This getitem defers to the underlying array, which by-definition can\n 377 |         only handle list-likes, slices, and integer scalars\n 378 |         \"\"\"\n 379 |         # Use cast as we know we will get back a DatetimeLikeArray or DTScalar,\n 380 |         # but skip evaluating the Union at runtime for performance\n 381 |         # (see https://github.com/pandas-dev/pandas/pull/44624)\n 382 |         result = cast(\"Union[Self, DTScalarOrNaT]\", super().__getitem__(key))\n 383 |         if lib.is_scalar(result):\n 384 |             return result\n 385 |         else:\n 386 |             # At this point we know the result is an array.\n 387 |             result = cast(Self, result)\n 388 |         result._freq = self._get_getitem_freq(key)\n 389 |         return result\n 390 | \n 391 |     def _get_getitem_freq(self, key) -> BaseOffset | None:\n 392 |         \"\"\"\n 393 |         Find the `freq` attribute to assign to the result of a __getitem__ lookup.\n 394 |         \"\"\"\n 395 |         is_period = isinstance(self.dtype, PeriodDtype)\n 396 |         if is_period:\n 397 |             freq = self.freq\n 398 |         elif self.ndim != 1:\n 399 |             freq = None\n 400 |         else:\n 401 |             key = check_array_indexer(self, key)  # maybe ndarray[bool] -> slice\n 402 |             freq = None\n 403 |             if isinstance(key, slice):\n 404 |                 if self.freq is not None and key.step is not None:\n 405 |                     freq = key.step * self.freq\n 406 |                 else:\n 407 |                     freq = self.freq\n 408 |             elif key is Ellipsis:\n 409 |                 # GH#21282 indexing with Ellipsis is similar to a full slice,\n 410 |                 #  should preserve `freq` attribute\n 411 |                 freq = self.freq\n 412 |             elif com.is_bool_indexer(key):\n 413 |                 new_key = lib.maybe_booleans_to_slice(key.view(np.uint8))\n 414 |                 if isinstance(new_key, slice):\n 415 |                     return self._get_getitem_freq(new_key)\n 416 |         return freq\n 417 | \n 418 |     # error: Argument 1 of \"__setitem__\" is incompatible with supertype\n 419 |     # \"ExtensionArray\"; supertype defines the argument type as \"Union[int,\n 420 |     # ndarray]\"\n 421 |     def __setitem__(\n 422 |         self,\n 423 |         key: int | Sequence[int] | Sequence[bool] | slice,\n 424 |         value: NaTType | Any | Sequence[Any],\n 425 |     ) -> None:\n 426 |         # I'm fudging the types a bit here. \"Any\" above really depends\n 427 |         # on type(self). For PeriodArray, it's Period (or stuff coercible\n 428 |         # to a period in from_sequence). For DatetimeArray, it's Timestamp...\n 429 |         # I don't know if mypy can do that, possibly with Generics.\n 430 |         # https://mypy.readthedocs.io/en/latest/generics.html\n 431 | \n 432 |         no_op = check_setitem_lengths(key, value, self)\n 433 | \n 434 |         # Calling super() before the no_op short-circuit means that we raise\n 435 |         #  on invalid 'value' even if this is a no-op, e.g. wrong-dtype empty array.\n 436 |         super().__setitem__(key, value)\n 437 | \n 438 |         if no_op:\n 439 |             return\n 440 | \n 441 |         self._maybe_clear_freq()\n 442 | \n 443 |     def _maybe_clear_freq(self) -> None:\n 444 |         # inplace operations like __setitem__ may invalidate the freq of\n 445 |         # DatetimeArray and TimedeltaArray\n 446 |         pass\n 447 | \n 448 |     def astype(self, dtype, copy: bool = True):\n 449 |         # Some notes on cases we don't have to handle here in the base class:\n 450 |         #   1. PeriodArray.astype handles period -> period\n 451 |         #   2. DatetimeArray.astype handles conversion between tz.\n 452 |         #   3. DatetimeArray.astype handles datetime -> period\n 453 |         dtype = pandas_dtype(dtype)\n 454 | \n 455 |         if dtype == object:\n 456 |             if self.dtype.kind == \"M\":\n 457 |                 self = cast(\"DatetimeArray\", self)\n 458 |                 # *much* faster than self._box_values\n 459 |                 #  for e.g. test_get_loc_tuple_monotonic_above_size_cutoff\n 460 |                 i8data = self.asi8\n 461 |                 converted = ints_to_pydatetime(\n 462 |                     i8data,\n 463 |                     tz=self.tz,\n 464 |                     box=\"timestamp\",\n 465 |                     reso=self._creso,\n 466 |                 )\n 467 |                 return converted\n 468 | \n 469 |             elif self.dtype.kind == \"m\":\n 470 |                 return ints_to_pytimedelta(self._ndarray, box=True)\n 471 | \n 472 |             return self._box_values(self.asi8.ravel()).reshape(self.shape)\n 473 | \n 474 |         elif is_string_dtype(dtype):\n 475 |             if isinstance(dtype, ExtensionDtype):\n 476 |                 arr_object = self._format_native_types(na_rep=dtype.na_value)  # type: ignore[arg-type]\n 477 |                 cls = dtype.construct_array_type()\n 478 |                 return cls._from_sequence(arr_object, dtype=dtype, copy=False)\n 479 |             else:\n 480 |                 return self._format_native_types()\n 481 | \n 482 |         elif isinstance(dtype, ExtensionDtype):\n 483 |             return super().astype(dtype, copy=copy)\n 484 |         elif dtype.kind in \"iu\":\n 485 |             # we deliberately ignore int32 vs. int64 here.\n 486 |             # See https://github.com/pandas-dev/pandas/issues/24381 for more.\n 487 |             values = self.asi8\n 488 |             if dtype != np.int64:\n 489 |                 raise TypeError(\n 490 |                     f\"Converting from {self.dtype} to {dtype} is not supported. \"\n 491 |                     \"Do obj.astype('int64').astype(dtype) instead\"\n 492 |                 )\n 493 | \n 494 |             if copy:\n 495 |                 values = values.copy()\n 496 |             return values\n 497 |         elif (dtype.kind in \"mM\" and self.dtype != dtype) or dtype.kind == \"f\":\n 498 |             # disallow conversion between datetime/timedelta,\n 499 |             # and conversions for any datetimelike to float\n 500 |             msg = f\"Cannot cast {type(self).__name__} to dtype {dtype}\"\n 501 |             raise TypeError(msg)\n 502 |         else:\n 503 |             return np.asarray(self, dtype=dtype)\n 504 | \n 505 |     @overload\n 506 |     def view(self) -> Self: ...\n 507 | \n 508 |     @overload\n 509 |     def view(self, dtype: Literal[\"M8[ns]\"]) -> DatetimeArray: ...\n 510 | \n 511 |     @overload\n 512 |     def view(self, dtype: Literal[\"m8[ns]\"]) -> TimedeltaArray: ...\n 513 | \n 514 |     @overload\n 515 |     def view(self, dtype: Dtype | None = ...) -> ArrayLike: ...\n 516 | \n 517 |     def view(self, dtype: Dtype | None = None) -> ArrayLike:\n 518 |         # we need to explicitly call super() method as long as the `@overload`s\n 519 |         #  are present in this file.\n 520 |         return super().view(dtype)\n 521 | \n 522 |     # ------------------------------------------------------------------\n 523 |     # Validation Methods\n 524 |     # TODO: try to de-duplicate these, ensure identical behavior\n 525 | \n 526 |     def _validate_comparison_value(self, other):\n 527 |         if isinstance(other, str):\n 528 |             try:\n 529 |                 # GH#18435 strings get a pass from tzawareness compat\n 530 |                 other = self._scalar_from_string(other)\n 531 |             except (ValueError, IncompatibleFrequency) as err:\n 532 |                 # failed to parse as Timestamp/Timedelta/Period\n 533 |                 raise InvalidComparison(other) from err\n 534 | \n 535 |         if isinstance(other, self._recognized_scalars) or other is NaT:\n 536 |             other = self._scalar_type(other)\n 537 |             try:\n 538 |                 self._check_compatible_with(other)\n 539 |             except (TypeError, IncompatibleFrequency) as err:\n 540 |                 # e.g. tzawareness mismatch\n 541 |                 raise InvalidComparison(other) from err\n 542 | \n 543 |         elif not is_list_like(other):\n 544 |             raise InvalidComparison(other)\n 545 | \n 546 |         elif len(other) != len(self):\n 547 |             raise ValueError(\"Lengths must match\")\n 548 | \n 549 |         else:\n 550 |             try:\n 551 |                 other = self._validate_listlike(other, allow_object=True)\n 552 |                 self._check_compatible_with(other)\n 553 |             except (TypeError, IncompatibleFrequency) as err:\n 554 |                 if is_object_dtype(getattr(other, \"dtype\", None)):\n 555 |                     # We will have to operate element-wise\n 556 |                     pass\n 557 |                 else:\n 558 |                     raise InvalidComparison(other) from err\n 559 | \n 560 |         return other\n 561 | \n 562 |     def _validate_scalar(\n 563 |         self,\n 564 |         value,\n 565 |         *,\n 566 |         allow_listlike: bool = False,\n 567 |         unbox: bool = True,\n 568 |     ):\n 569 |         \"\"\"\n 570 |         Validate that the input value can be cast to our scalar_type.\n 571 | \n 572 |         Parameters\n 573 |         ----------\n 574 |         value : object\n 575 |         allow_listlike: bool, default False\n 576 |             When raising an exception, whether the message should say\n 577 |             listlike inputs are allowed.\n 578 |         unbox : bool, default True\n 579 |             Whether to unbox the result before returning.  Note: unbox=False\n 580 |             skips the setitem compatibility check.\n 581 | \n 582 |         Returns\n 583 |         -------\n 584 |         self._scalar_type or NaT\n 585 |         \"\"\"\n 586 |         if isinstance(value, self._scalar_type):\n 587 |             pass\n 588 | \n 589 |         elif isinstance(value, str):\n 590 |             # NB: Careful about tzawareness\n 591 |             try:\n 592 |                 value = self._scalar_from_string(value)\n 593 |             except ValueError as err:\n 594 |                 msg = self._validation_error_message(value, allow_listlike)\n 595 |                 raise TypeError(msg) from err\n 596 | \n 597 |         elif is_valid_na_for_dtype(value, self.dtype):\n 598 |             # GH#18295\n 599 |             value = NaT\n 600 | \n 601 |         elif isna(value):\n 602 |             # if we are dt64tz and value is dt64(\"NaT\"), dont cast to NaT,\n 603 |             #  or else we'll fail to raise in _unbox_scalar\n 604 |             msg = self._validation_error_message(value, allow_listlike)\n 605 |             raise TypeError(msg)\n 606 | \n 607 |         elif isinstance(value, self._recognized_scalars):\n 608 |             # error: Argument 1 to \"Timestamp\" has incompatible type \"object\"; expected\n 609 |             # \"integer[Any] | float | str | date | datetime | datetime64\"\n 610 |             value = self._scalar_type(value)  # type: ignore[arg-type]\n 611 | \n 612 |         else:\n 613 |             msg = self._validation_error_message(value, allow_listlike)\n 614 |             raise TypeError(msg)\n 615 | \n 616 |         if not unbox:\n 617 |             # NB: In general NDArrayBackedExtensionArray will unbox here;\n 618 |             #  this option exists to prevent a performance hit in\n 619 |             #  TimedeltaIndex.get_loc\n 620 |             return value\n 621 |         return self._unbox_scalar(value)\n 622 | \n 623 |     def _validation_error_message(self, value, allow_listlike: bool = False) -> str:\n 624 |         \"\"\"\n 625 |         Construct an exception message on validation error.\n 626 | \n 627 |         Some methods allow only scalar inputs, while others allow either scalar\n 628 |         or listlike.\n 629 | \n 630 |         Parameters\n 631 |         ----------\n 632 |         allow_listlike: bool, default False\n 633 | \n 634 |         Returns\n 635 |         -------\n 636 |         str\n 637 |         \"\"\"\n 638 |         if hasattr(value, \"dtype\") and getattr(value, \"ndim\", 0) > 0:\n 639 |             msg_got = f\"{value.dtype} array\"\n 640 |         else:\n 641 |             msg_got = f\"'{type(value).__name__}'\"\n 642 |         if allow_listlike:\n 643 |             msg = (\n 644 |                 f\"value should be a '{self._scalar_type.__name__}', 'NaT', \"\n 645 |                 f\"or array of those. Got {msg_got} instead.\"\n 646 |             )\n 647 |         else:\n 648 |             msg = (\n 649 |                 f\"value should be a '{self._scalar_type.__name__}' or 'NaT'. \"\n 650 |                 f\"Got {msg_got} instead.\"\n 651 |             )\n 652 |         return msg\n 653 | \n 654 |     def _validate_listlike(self, value, allow_object: bool = False):\n 655 |         if isinstance(value, type(self)):\n 656 |             if self.dtype.kind in \"mM\" and not allow_object and self.unit != value.unit:  # type: ignore[attr-defined]\n 657 |                 # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 658 |                 value = value.as_unit(self.unit, round_ok=False)  # type: ignore[attr-defined]\n 659 |             return value\n 660 | \n 661 |         if isinstance(value, list) and len(value) == 0:\n 662 |             # We treat empty list as our own dtype.\n 663 |             return type(self)._from_sequence([], dtype=self.dtype)\n 664 | \n 665 |         if hasattr(value, \"dtype\") and value.dtype == object:\n 666 |             # `array` below won't do inference if value is an Index or Series.\n 667 |             #  so do so here.  in the Index case, inferred_type may be cached.\n 668 |             if lib.infer_dtype(value) in self._infer_matches:\n 669 |                 try:\n 670 |                     value = type(self)._from_sequence(value)\n 671 |                 except (ValueError, TypeError) as err:\n 672 |                     if allow_object:\n 673 |                         return value\n 674 |                     msg = self._validation_error_message(value, True)\n 675 |                     raise TypeError(msg) from err\n 676 | \n 677 |         # Do type inference if necessary up front (after unpacking\n 678 |         # NumpyExtensionArray)\n 679 |         # e.g. we passed PeriodIndex.values and got an ndarray of Periods\n 680 |         value = extract_array(value, extract_numpy=True)\n 681 |         value = pd_array(value)\n 682 |         value = extract_array(value, extract_numpy=True)\n 683 | \n 684 |         if is_all_strings(value):\n 685 |             # We got a StringArray\n 686 |             try:\n 687 |                 # TODO: Could use from_sequence_of_strings if implemented\n 688 |                 # Note: passing dtype is necessary for PeriodArray tests\n 689 |                 value = type(self)._from_sequence(value, dtype=self.dtype)\n 690 |             except ValueError:\n 691 |                 pass\n 692 | \n 693 |         if isinstance(value.dtype, CategoricalDtype):\n 694 |             # e.g. we have a Categorical holding self.dtype\n 695 |             if value.categories.dtype == self.dtype:\n 696 |                 # TODO: do we need equal dtype or just comparable?\n 697 |                 value = value._internal_get_values()\n 698 |                 value = extract_array(value, extract_numpy=True)\n 699 | \n 700 |         if allow_object and is_object_dtype(value.dtype):\n 701 |             pass\n 702 | \n 703 |         elif not type(self)._is_recognized_dtype(value.dtype):\n 704 |             msg = self._validation_error_message(value, True)\n 705 |             raise TypeError(msg)\n 706 | \n 707 |         if self.dtype.kind in \"mM\" and not allow_object:\n 708 |             # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 709 |             value = value.as_unit(self.unit, round_ok=False)  # type: ignore[attr-defined]\n 710 |         return value\n 711 | \n 712 |     def _validate_setitem_value(self, value):\n 713 |         if is_list_like(value):\n 714 |             value = self._validate_listlike(value)\n 715 |         else:\n 716 |             return self._validate_scalar(value, allow_listlike=True)\n 717 | \n 718 |         return self._unbox(value)\n 719 | \n 720 |     @final\n 721 |     def _unbox(self, other) -> np.int64 | np.datetime64 | np.timedelta64 | np.ndarray:\n 722 |         \"\"\"\n 723 |         Unbox either a scalar with _unbox_scalar or an instance of our own type.\n 724 |         \"\"\"\n 725 |         if lib.is_scalar(other):\n 726 |             other = self._unbox_scalar(other)\n 727 |         else:\n 728 |             # same type as self\n 729 |             self._check_compatible_with(other)\n 730 |             other = other._ndarray\n 731 |         return other\n 732 | \n 733 |     # ------------------------------------------------------------------\n 734 |     # Additional array methods\n 735 |     #  These are not part of the EA API, but we implement them because\n 736 |     #  pandas assumes they're there.\n 737 | \n 738 |     @ravel_compat\n 739 |     def map(self, mapper, na_action: Literal[\"ignore\"] | None = None):\n 740 |         from pandas import Index\n 741 | \n 742 |         result = map_array(self, mapper, na_action=na_action)\n 743 |         result = Index(result)\n 744 | \n 745 |         if isinstance(result, ABCMultiIndex):\n 746 |             return result.to_numpy()\n 747 |         else:\n 748 |             return result.array\n 749 | \n 750 |     def isin(self, values: ArrayLike) -> npt.NDArray[np.bool_]:\n 751 |         \"\"\"\n 752 |         Compute boolean array of whether each value is found in the\n 753 |         passed set of values.\n 754 | \n 755 |         Parameters\n 756 |         ----------\n 757 |         values : np.ndarray or ExtensionArray\n 758 | \n 759 |         Returns\n 760 |         -------\n 761 |         ndarray[bool]\n 762 |         \"\"\"\n 763 |         if values.dtype.kind in \"fiuc\":\n 764 |             # TODO: de-duplicate with equals, validate_comparison_value\n 765 |             return np.zeros(self.shape, dtype=bool)\n 766 | \n 767 |         values = ensure_wrapped_if_datetimelike(values)\n 768 | \n 769 |         if not isinstance(values, type(self)):\n 770 |             if values.dtype == object:\n 771 |                 values = lib.maybe_convert_objects(\n 772 |                     values,  # type: ignore[arg-type]\n 773 |                     convert_non_numeric=True,\n 774 |                     dtype_if_all_nat=self.dtype,\n 775 |                 )\n 776 |                 if values.dtype != object:\n 777 |                     return self.isin(values)\n 778 |                 else:\n 779 |                     # TODO: Deprecate this case\n 780 |                     # https://github.com/pandas-dev/pandas/pull/58645/files#r1604055791\n 781 |                     return isin(self.astype(object), values)\n 782 |             return np.zeros(self.shape, dtype=bool)\n 783 | \n 784 |         if self.dtype.kind in \"mM\":\n 785 |             self = cast(\"DatetimeArray | TimedeltaArray\", self)\n 786 |             # error: \"DatetimeLikeArrayMixin\" has no attribute \"as_unit\"\n 787 |             values = values.as_unit(self.unit)  # type: ignore[attr-defined]\n 788 | \n 789 |         try:\n 790 |             # error: Argument 1 to \"_check_compatible_with\" of \"DatetimeLikeArrayMixin\"\n 791 |             # has incompatible type \"ExtensionArray | ndarray[Any, Any]\"; expected\n 792 |             # \"Period | Timestamp | Timedelta | NaTType\"\n 793 |             self._check_compatible_with(values)  # type: ignore[arg-type]\n 794 |         except (TypeError, ValueError):\n 795 |             # Includes tzawareness mismatch and IncompatibleFrequencyError\n 796 |             return np.zeros(self.shape, dtype=bool)\n 797 | \n 798 |         # error: Item \"ExtensionArray\" of \"ExtensionArray | ndarray[Any, Any]\"\n 799 |         # has no attribute \"asi8\"\n 800 |         return isin(self.asi8, values.asi8)  # type: ignore[union-attr]\n 801 | \n 802 |     # ------------------------------------------------------------------\n 803 |     # Null Handling\n 804 | \n 805 |     def isna(self) -> npt.NDArray[np.bool_]:\n 806 |         return self._isnan\n 807 | \n 808 |     @property  # NB: override with cache_readonly in immutable subclasses\n 809 |     def _isnan(self) -> npt.NDArray[np.bool_]:\n 810 |         \"\"\"\n 811 |         return if each value is nan\n 812 |         \"\"\"\n 813 |         return self.asi8 == iNaT\n 814 | \n 815 |     @property  # NB: override with cache_readonly in immutable subclasses\n 816 |     def _hasna(self) -> bool:\n 817 |         \"\"\"\n 818 |         return if I have any nans; enables various perf speedups\n 819 |         \"\"\"\n 820 |         return bool(self._isnan.any())\n 821 | \n 822 |     def _maybe_mask_results(\n 823 |         self, result: np.ndarray, fill_value=iNaT, convert=None\n 824 |     ) -> np.ndarray:\n 825 |         \"\"\"\n 826 |         Parameters\n 827 |         ----------\n 828 |         result : np.ndarray\n 829 |         fill_value : object, default iNaT\n 830 |         convert : str, dtype or None\n 831 | \n 832 |         Returns\n 833 |         -------\n 834 |         result : ndarray with values replace by the fill_value\n 835 | \n 836 |         mask the result if needed, convert to the provided dtype if its not\n 837 |         None\n 838 | \n 839 |         This is an internal routine.\n 840 |         \"\"\"\n 841 |         if self._hasna:\n 842 |             if convert:\n 843 |                 result = result.astype(convert)\n 844 |             if fill_value is None:\n 845 |                 fill_value = np.nan\n 846 |             np.putmask(result, self._isnan, fill_value)\n 847 |         return result\n 848 | \n 849 |     # ------------------------------------------------------------------\n 850 |     # Frequency Properties/Methods\n 851 | \n 852 |     @property\n 853 |     def freqstr(self) -> str | None:\n 854 |         \"\"\"\n 855 |         Return the frequency object as a string if it's set, otherwise None.\n 856 | \n 857 |         See Also\n 858 |         --------\n 859 |         DatetimeIndex.inferred_freq : Returns a string representing a frequency\n 860 |             generated by infer_freq.\n 861 | \n 862 |         Examples\n 863 |         --------\n 864 |         For DatetimeIndex:\n 865 | \n 866 |         >>> idx = pd.DatetimeIndex([\"1/1/2020 10:00:00+00:00\"], freq=\"D\")\n 867 |         >>> idx.freqstr\n 868 |         'D'\n 869 | \n 870 |         The frequency can be inferred if there are more than 2 points:\n 871 | \n 872 |         >>> idx = pd.DatetimeIndex(\n 873 |         ...     [\"2018-01-01\", \"2018-01-03\", \"2018-01-05\"], freq=\"infer\"\n 874 |         ... )\n 875 |         >>> idx.freqstr\n 876 |         '2D'\n 877 | \n 878 |         For PeriodIndex:\n 879 | \n 880 |         >>> idx = pd.PeriodIndex([\"2023-1\", \"2023-2\", \"2023-3\"], freq=\"M\")\n 881 |         >>> idx.freqstr\n 882 |         'M'\n 883 |         \"\"\"\n 884 |         if self.freq is None:\n 885 |             return None\n 886 |         return self.freq.freqstr\n 887 | \n 888 |     @property  # NB: override with cache_readonly in immutable subclasses\n 889 |     def inferred_freq(self) -> str | None:\n 890 |         \"\"\"\n 891 |         Tries to return a string representing a frequency generated by infer_freq.\n 892 | \n 893 |         Returns None if it can't autodetect the frequency.\n 894 | \n 895 |         See Also\n 896 |         --------\n 897 |         DatetimeIndex.freqstr : Return the frequency object as a string if it's set,\n 898 |             otherwise None.\n 899 | \n 900 |         Examples\n 901 |         --------\n 902 |         For DatetimeIndex:\n 903 | \n 904 |         >>> idx = pd.DatetimeIndex([\"2018-01-01\", \"2018-01-03\", \"2018-01-05\"])\n 905 |         >>> idx.inferred_freq\n 906 |         '2D'\n 907 | \n 908 |         For TimedeltaIndex:\n 909 | \n 910 |         >>> tdelta_idx = pd.to_timedelta([\"0 days\", \"10 days\", \"20 days\"])\n 911 |         >>> tdelta_idx\n 912 |         TimedeltaIndex(['0 days', '10 days', '20 days'],\n 913 |                        dtype='timedelta64[ns]', freq=None)\n 914 |         >>> tdelta_idx.inferred_freq\n 915 |         '10D'\n 916 |         \"\"\"\n 917 |         if self.ndim != 1:\n 918 |             return None\n 919 |         try:\n 920 |             return frequencies.infer_freq(self)\n 921 |         except ValueError:\n 922 |             return None\n 923 | \n 924 |     @property  # NB: override with cache_readonly in immutable subclasses\n 925 |     def _resolution_obj(self) -> Resolution | None:\n 926 |         freqstr = self.freqstr\n 927 |         if freqstr is None:\n 928 |             return None\n 929 |         try:\n 930 |             return Resolution.get_reso_from_freqstr(freqstr)\n 931 |         except KeyError:\n 932 |             return None\n 933 | \n 934 |     @property  # NB: override with cache_readonly in immutable subclasses\n 935 |     def resolution(self) -> str:\n 936 |         \"\"\"\n 937 |         Returns day, hour, minute, second, millisecond or microsecond\n 938 |         \"\"\"\n 939 |         # error: Item \"None\" of \"Optional[Any]\" has no attribute \"attrname\"\n 940 |         return self._resolution_obj.attrname  # type: ignore[union-attr]\n 941 | \n 942 |     # monotonicity/uniqueness properties are called via frequencies.infer_freq,\n 943 |     #  see GH#23789\n 944 | \n 945 |     @property\n 946 |     def _is_monotonic_increasing(self) -> bool:\n 947 |         return algos.is_monotonic(self.asi8, timelike=True)[0]\n 948 | \n 949 |     @property\n 950 |     def _is_monotonic_decreasing(self) -> bool:\n 951 |         return algos.is_monotonic(self.asi8, timelike=True)[1]\n 952 | \n 953 |     @property\n 954 |     def _is_unique(self) -> bool:\n 955 |         return len(unique1d(self.asi8.ravel(\"K\"))) == self.size\n 956 | \n 957 |     # ------------------------------------------------------------------\n 958 |     # Arithmetic Methods\n 959 | \n 960 |     def _cmp_method(self, other, op):\n 961 |         if self.ndim > 1 and getattr(other, \"shape\", None) == self.shape:\n 962 |             # TODO: handle 2D-like listlikes\n 963 |             return op(self.ravel(), other.ravel()).reshape(self.shape)\n 964 | \n 965 |         try:\n 966 |             other = self._validate_comparison_value(other)\n 967 |         except InvalidComparison:\n 968 |             return invalid_comparison(self, other, op)\n 969 | \n 970 |         dtype = getattr(other, \"dtype\", None)\n 971 |         if is_object_dtype(dtype):\n 972 |             # We have to use comp_method_OBJECT_ARRAY instead of numpy\n 973 |             #  comparison otherwise it would raise when comparing to None\n 974 |             result = ops.comp_method_OBJECT_ARRAY(\n 975 |                 op, np.asarray(self.astype(object)), other\n 976 |             )\n 977 |             return result\n 978 |         if other is NaT:\n 979 |             if op is operator.ne:\n 980 |                 result = np.ones(self.shape, dtype=bool)\n 981 |             else:\n 982 |                 result = np.zeros(self.shape, dtype=bool)\n 983 |             return result\n 984 | \n 985 |         if not isinstance(self.dtype, PeriodDtype):\n 986 |             self = cast(TimelikeOps, self)\n 987 |             if self._creso != other._creso:\n 988 |                 if not isinstance(other, type(self)):\n 989 |                     # i.e. Timedelta/Timestamp, cast to ndarray and let\n 990 |                     #  compare_mismatched_resolutions handle broadcasting\n 991 |                     try:\n 992 |                         # GH#52080 see if we can losslessly cast to shared unit\n 993 |                         other = other.as_unit(self.unit, round_ok=False)\n 994 |                     except ValueError:\n 995 |                         other_arr = np.array(other.asm8)\n 996 |                         return compare_mismatched_resolutions(\n 997 |                             self._ndarray, other_arr, op\n 998 |                         )\n 999 |                 else:\n1000 |                     other_arr = other._ndarray\n1001 |                     return compare_mismatched_resolutions(self._ndarray, other_arr, op)\n1002 | \n1003 |         other_vals = self._unbox(other)\n1004 |         # GH#37462 comparison on i8 values is almost 2x faster than M8/m8\n1005 |         result = op(self._ndarray.view(\"i8\"), other_vals.view(\"i8\"))\n1006 | \n1007 |         o_mask = isna(other)\n1008 |         mask = self._isnan | o_mask\n1009 |         if mask.any():\n1010 |             nat_result = op is operator.ne\n1011 |             np.putmask(result, mask, nat_result)\n1012 | \n1013 |         return result\n1014 | \n1015 |     # pow is invalid for all three subclasses; TimedeltaArray will override\n1016 |     #  the multiplication and division ops\n1017 |     __pow__ = _make_unpacked_invalid_op(\"__pow__\")\n1018 |     __rpow__ = _make_unpacked_invalid_op(\"__rpow__\")\n1019 |     __mul__ = _make_unpacked_invalid_op(\"__mul__\")\n1020 |     __rmul__ = _make_unpacked_invalid_op(\"__rmul__\")\n1021 |     __truediv__ = _make_unpacked_invalid_op(\"__truediv__\")\n1022 |     __rtruediv__ = _make_unpacked_invalid_op(\"__rtruediv__\")\n1023 |     __floordiv__ = _make_unpacked_invalid_op(\"__floordiv__\")\n1024 |     __rfloordiv__ = _make_unpacked_invalid_op(\"__rfloordiv__\")\n1025 |     __mod__ = _make_unpacked_invalid_op(\"__mod__\")\n1026 |     __rmod__ = _make_unpacked_invalid_op(\"__rmod__\")\n1027 |     __divmod__ = _make_unpacked_invalid_op(\"__divmod__\")\n1028 |     __rdivmod__ = _make_unpacked_invalid_op(\"__rdivmod__\")\n1029 | \n1030 |     @final\n1031 |     def _get_i8_values_and_mask(\n1032 |         self, other\n1033 |     ) -> tuple[int | npt.NDArray[np.int64], None | npt.NDArray[np.bool_]]:\n1034 |         \"\"\"\n1035 |         Get the int64 values and b_mask to pass to add_overflowsafe.\n1036 |         \"\"\"\n1037 |         if isinstance(other, Period):\n1038 |             i8values = other.ordinal\n1039 |             mask = None\n1040 |         elif isinstance(other, (Timestamp, Timedelta)):\n1041 |             i8values = other._value\n1042 |             mask = None\n1043 |         else:\n1044 |             # PeriodArray, DatetimeArray, TimedeltaArray\n1045 |             mask = other._isnan\n1046 |             i8values = other.asi8\n1047 |         return i8values, mask\n1048 | \n1049 |     @final\n1050 |     def _get_arithmetic_result_freq(self, other) -> BaseOffset | None:\n1051 |         \"\"\"\n1052 |         Check if we can preserve self.freq in addition or subtraction.\n1053 |         \"\"\"\n1054 |         # Adding or subtracting a Timedelta/Timestamp scalar is freq-preserving\n1055 |         #  whenever self.freq is a Tick\n1056 |         if isinstance(self.dtype, PeriodDtype):\n1057 |             return self.freq\n1058 |         elif not lib.is_scalar(other):\n1059 |             return None\n1060 |         elif isinstance(self.freq, Tick):\n1061 |             # In these cases\n1062 |             return self.freq\n1063 |         return None\n1064 | \n1065 |     @final\n1066 |     def _add_datetimelike_scalar(self, other) -> DatetimeArray:\n1067 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1068 |             raise TypeError(\n1069 |                 f\"cannot add {type(self).__name__} and {type(other).__name__}\"\n1070 |             )\n1071 | \n1072 |         self = cast(\"TimedeltaArray\", self)\n1073 | \n1074 |         from pandas.core.arrays import DatetimeArray\n1075 |         from pandas.core.arrays.datetimes import tz_to_dtype\n1076 | \n1077 |         assert other is not NaT\n1078 |         if isna(other):\n1079 |             # i.e. np.datetime64(\"NaT\")\n1080 |             # In this case we specifically interpret NaT as a datetime, not\n1081 |             # the timedelta interpretation we would get by returning self + NaT\n1082 |             result = self._ndarray + NaT.to_datetime64().astype(f\"M8[{self.unit}]\")\n1083 |             # Preserve our resolution\n1084 |             return DatetimeArray._simple_new(result, dtype=result.dtype)\n1085 | \n1086 |         other = Timestamp(other)\n1087 |         self, other = self._ensure_matching_resos(other)\n1088 |         self = cast(\"TimedeltaArray\", self)\n1089 | \n1090 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1091 |         result = add_overflowsafe(self.asi8, np.asarray(other_i8, dtype=\"i8\"))\n1092 |         res_values = result.view(f\"M8[{self.unit}]\")\n1093 | \n1094 |         dtype = tz_to_dtype(tz=other.tz, unit=self.unit)\n1095 |         res_values = result.view(f\"M8[{self.unit}]\")\n1096 |         new_freq = self._get_arithmetic_result_freq(other)\n1097 |         return DatetimeArray._simple_new(res_values, dtype=dtype, freq=new_freq)\n1098 | \n1099 |     @final\n1100 |     def _add_datetime_arraylike(self, other: DatetimeArray) -> DatetimeArray:\n1101 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1102 |             raise TypeError(\n1103 |                 f\"cannot add {type(self).__name__} and {type(other).__name__}\"\n1104 |             )\n1105 | \n1106 |         # defer to DatetimeArray.__add__\n1107 |         return other + self\n1108 | \n1109 |     @final\n1110 |     def _sub_datetimelike_scalar(\n1111 |         self, other: datetime | np.datetime64\n1112 |     ) -> TimedeltaArray:\n1113 |         if self.dtype.kind != \"M\":\n1114 |             raise TypeError(f\"cannot subtract a datelike from a {type(self).__name__}\")\n1115 | \n1116 |         self = cast(\"DatetimeArray\", self)\n1117 |         # subtract a datetime from myself, yielding a ndarray[timedelta64[ns]]\n1118 | \n1119 |         if isna(other):\n1120 |             # i.e. np.datetime64(\"NaT\")\n1121 |             return self - NaT\n1122 | \n1123 |         ts = Timestamp(other)\n1124 | \n1125 |         self, ts = self._ensure_matching_resos(ts)\n1126 |         return self._sub_datetimelike(ts)\n1127 | \n1128 |     @final\n1129 |     def _sub_datetime_arraylike(self, other: DatetimeArray) -> TimedeltaArray:\n1130 |         if self.dtype.kind != \"M\":\n1131 |             raise TypeError(f\"cannot subtract a datelike from a {type(self).__name__}\")\n1132 | \n1133 |         if len(self) != len(other):\n1134 |             raise ValueError(\"cannot add indices of unequal length\")\n1135 | \n1136 |         self = cast(\"DatetimeArray\", self)\n1137 | \n1138 |         self, other = self._ensure_matching_resos(other)\n1139 |         return self._sub_datetimelike(other)\n1140 | \n1141 |     @final\n1142 |     def _sub_datetimelike(self, other: Timestamp | DatetimeArray) -> TimedeltaArray:\n1143 |         self = cast(\"DatetimeArray\", self)\n1144 | \n1145 |         from pandas.core.arrays import TimedeltaArray\n1146 | \n1147 |         try:\n1148 |             self._assert_tzawareness_compat(other)\n1149 |         except TypeError as err:\n1150 |             new_message = str(err).replace(\"compare\", \"subtract\")\n1151 |             raise type(err)(new_message) from err\n1152 | \n1153 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1154 |         res_values = add_overflowsafe(self.asi8, np.asarray(-other_i8, dtype=\"i8\"))\n1155 |         res_m8 = res_values.view(f\"timedelta64[{self.unit}]\")\n1156 | \n1157 |         new_freq = self._get_arithmetic_result_freq(other)\n1158 |         new_freq = cast(\"Tick | None\", new_freq)\n1159 |         return TimedeltaArray._simple_new(res_m8, dtype=res_m8.dtype, freq=new_freq)\n1160 | \n1161 |     @final\n1162 |     def _add_period(self, other: Period) -> PeriodArray:\n1163 |         if not lib.is_np_dtype(self.dtype, \"m\"):\n1164 |             raise TypeError(f\"cannot add Period to a {type(self).__name__}\")\n1165 | \n1166 |         # We will wrap in a PeriodArray and defer to the reversed operation\n1167 |         from pandas.core.arrays.period import PeriodArray\n1168 | \n1169 |         i8vals = np.broadcast_to(other.ordinal, self.shape)\n1170 |         dtype = PeriodDtype(other.freq)\n1171 |         parr = PeriodArray(i8vals, dtype=dtype)\n1172 |         return parr + self\n1173 | \n1174 |     def _add_offset(self, offset):\n1175 |         raise AbstractMethodError(self)\n1176 | \n1177 |     def _add_timedeltalike_scalar(self, other):\n1178 |         \"\"\"\n1179 |         Add a delta of a timedeltalike\n1180 | \n1181 |         Returns\n1182 |         -------\n1183 |         Same type as self\n1184 |         \"\"\"\n1185 |         if isna(other):\n1186 |             # i.e np.timedelta64(\"NaT\")\n1187 |             new_values = np.empty(self.shape, dtype=\"i8\").view(self._ndarray.dtype)\n1188 |             new_values.fill(iNaT)\n1189 |             return type(self)._simple_new(new_values, dtype=self.dtype)\n1190 | \n1191 |         # PeriodArray overrides, so we only get here with DTA/TDA\n1192 |         self = cast(\"DatetimeArray | TimedeltaArray\", self)\n1193 |         other = Timedelta(other)\n1194 |         self, other = self._ensure_matching_resos(other)\n1195 |         return self._add_timedeltalike(other)\n1196 | \n1197 |     def _add_timedelta_arraylike(self, other: TimedeltaArray) -> Self:\n1198 |         \"\"\"\n1199 |         Add a delta of a TimedeltaIndex\n1200 | \n1201 |         Returns\n1202 |         -------\n1203 |         Same type as self\n1204 |         \"\"\"\n1205 |         # overridden by PeriodArray\n1206 | \n1207 |         if len(self) != len(other):\n1208 |             raise ValueError(\"cannot add indices of unequal length\")\n1209 | \n1210 |         self, other = cast(\n1211 |             \"DatetimeArray | TimedeltaArray\", self\n1212 |         )._ensure_matching_resos(other)\n1213 |         return self._add_timedeltalike(other)\n1214 | \n1215 |     @final\n1216 |     def _add_timedeltalike(self, other: Timedelta | TimedeltaArray) -> Self:\n1217 |         other_i8, o_mask = self._get_i8_values_and_mask(other)\n1218 |         new_values = add_overflowsafe(self.asi8, np.asarray(other_i8, dtype=\"i8\"))\n1219 |         res_values = new_values.view(self._ndarray.dtype)\n1220 | \n1221 |         new_freq = self._get_arithmetic_result_freq(other)\n1222 | \n1223 |         # error: Unexpected keyword argument \"freq\" for \"_simple_new\" of \"NDArrayBacked\"\n1224 |         return type(self)._simple_new(\n1225 |             res_values,\n1226 |             dtype=self.dtype,\n1227 |             freq=new_freq,  # type: ignore[call-arg]\n1228 |         )\n1229 | \n1230 |     @final\n1231 |     def _add_nat(self) -> Self:\n1232 |         \"\"\"\n1233 |         Add pd.NaT to self\n1234 |         \"\"\"\n1235 |         if isinstance(self.dtype, PeriodDtype):\n1236 |             raise TypeError(\n1237 |                 f\"Cannot add {type(self).__name__} and {type(NaT).__name__}\"\n1238 |             )\n1239 | \n1240 |         # GH#19124 pd.NaT is treated like