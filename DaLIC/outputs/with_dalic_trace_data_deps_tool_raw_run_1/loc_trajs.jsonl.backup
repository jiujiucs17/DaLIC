f n_components is None:\n1001 |         n_components = X.shape[1]\n1002 | \n1003 |     if method not in (\"lars\", \"cd\"):\n1004 |         raise ValueError(\"Coding method not supported as a fit algorithm.\")\n1005 | \n1006 |     _check_positive_coding(method, positive_code)\n1007 | \n1008 |     method = \"lasso_\" + method\n1009 | \n1010 |     t0 = time.time()\n1011 |     n_samples, n_features = X.shape\n1012 |     # Avoid integer division problems\n1013 |     alpha = float(alpha)\n1014 |     random_state = check_random_state(random_state)\n1015 | \n1016 |     # Init V with SVD of X\n1017 |     if dict_init is not None:\n1018 |         dictionary = dict_init\n1019 |     else:\n1020 |         _, S, dictionary = randomized_svd(X, n_components, random_state=random_state)\n1021 |         dictionary = S[:, np.newaxis] * dictionary\n1022 |     r = len(dictionary)\n1023 |     if n_components <= r:\n1024 |         dictionary = dictionary[:n_components, :]\n1025 |     else:\n1026 |         dictionary = np.r_[\n1027 |             dictionary,\n1028 |             np.zeros((n_components - r, dictionary.shape[1]), dtype=dictionary.dtype),\n1029 |         ]\n1030 | \n1031 |     if verbose == 1:\n1032 |         print(\"[dict_learning]\", end=\" \")\n1033 | \n1034 |     if shuffle:\n1035 |         X_train = X.copy()\n1036 |         random_state.shuffle(X_train)\n1037 |     else:\n1038 |         X_train = X\n1039 | \n1040 |     X_train = check_array(\n1041 |         X_train, order=\"C\", dtype=[np.float64, np.float32], copy=False\n1042 |     )\n1043 | \n1044 |     # Fortran-order dict better suited for the sparse coding which is the\n1045 |     # bottleneck of this algorithm.\n1046 |     dictionary = check_array(dictionary, order=\"F\", dtype=X_train.dtype, copy=False)\n1047 |     dictionary = np.require(dictionary, requirements=\"W\")\n1048 | \n1049 |     batches = gen_batches(n_samples, batch_size)\n1050 |     batches = itertools.cycle(batches)\n1051 | \n1052 |     # The covariance of the dictionary\n1053 |     if inner_stats is None:\n1054 |         A = np.zeros((n_components, n_components), dtype=X_train.dtype)\n1055 |         # The data approximation\n1056 |         B = np.zeros((n_features, n_components), dtype=X_train.dtype)\n1057 |     else:\n1058 |         A = inner_stats[0].copy()\n1059 |         B = inner_stats[1].copy()\n1060 | \n1061 |     # If n_iter is zero, we need to return zero.\n1062 |     ii = iter_offset - 1\n1063 | \n1064 |     for ii, batch in zip(range(iter_offset, iter_offset + n_iter), batches):\n1065 |         this_X = X_train[batch]\n1066 |         dt = time.time() - t0\n1067 |         if verbose == 1:\n1068 |             sys.stdout.write(\".\")\n1069 |             sys.stdout.flush()\n1070 |         elif verbose:\n1071 |             if verbose > 10 or ii % ceil(100.0 / verbose) == 0:\n1072 |                 print(\n1073 |                     \"Iteration % 3i (elapsed time: % 3is, % 4.1fmn)\" % (ii, dt, dt / 60)\n1074 |                 )\n1075 | \n1076 |         this_code = sparse_encode(\n1077 |             this_X,\n1078 |             dictionary,\n1079 |             algorithm=method,\n1080 |             alpha=alpha,\n1081 |             n_jobs=n_jobs,\n1082 |             check_input=False,\n1083 |             positive=positive_code,\n1084 |             max_iter=method_max_iter,\n1085 |             verbose=verbose,\n1086 |         )\n1087 | \n1088 |         # Update the auxiliary variables\n1089 |         if ii < batch_size - 1:\n1090 |             theta = float((ii + 1) * batch_size)\n1091 |         else:\n1092 |             theta = float(batch_size**2 + ii + 1 - batch_size)\n1093 |         beta = (theta + 1 - batch_size) / (theta + 1)\n1094 | \n1095 |         A *= beta\n1096 |         A += np.dot(this_code.T, this_code)\n1097 |         B *= beta\n1098 |         B += np.dot(this_X.T, this_code)\n1099 | \n1100 |         # Update dictionary in place\n1101 |         _update_dict(\n1102 |             dictionary,\n1103 |             this_X,\n1104 |             this_code,\n1105 |             A,\n1106 |             B,\n1107 |             verbose=verbose,\n1108 |             random_state=random_state,\n1109 |             positive=positive_dict,\n1110 |         )\n1111 | \n1112 |         # Maybe we need a stopping criteria based on the amount of\n1113 |         # modification in the dictionary\n1114 |         if callback is not None:\n1115 |             callback(locals())\n1116 | \n1117 |     if return_inner_stats:\n1118 |         if return_n_iter:\n1119 |             return dictionary, (A, B), ii - iter_offset + 1\n1120 |         else:\n1121 |             return dictionary, (A, B)\n1122 |     if return_code:\n1123 |         if verbose > 1:\n1124 |             print(\"Learning code...\", end=\" \")\n1125 |         elif verbose == 1:\n1126 |             print(\"|\", end=\" \")\n1127 |         code = sparse_encode(\n1128 |             X,\n1129 |             dictionary,\n1130 |             algorithm=method,\n1131 |             alpha=alpha,\n1132 |             n_jobs=n_jobs,\n1133 |             check_input=False,\n1134 |             positive=positive_code,\n1135 |             max_iter=method_max_iter,\n1136 |             verbose=verbose,\n1137 |         )\n1138 |         if verbose > 1:\n1139 |             dt = time.time() - t0\n1140 |             print(\"done (total time: % 3is, % 4.1fmn)\" % (dt, dt / 60))\n1141 |         if return_n_iter:\n1142 |             return code, dictionary, ii - iter_offset + 1\n1143 |         else:\n1144 |             return code, dictionary\n1145 | \n1146 |     if return_n_iter:\n1147 |         return dictionary, ii - iter_offset + 1\n1148 |     else:\n1149 |         return dictionary\n```\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation._em_step`.\nSource: Retrieved code content using keyword search (bm25).\n```\n475 | def _em_step(self, X, total_samples, batch_update, parallel=None):\n476 |         \"\"\"EM update for 1 iteration.\n477 | \n478 |         update `_component` by batch VB or online VB.\n479 | \n480 |         Parameters\n481 |         ----------\n482 |         X : {array-like, sparse matrix} of shape (n_samples, n_features)\n483 |             Document word matrix.\n484 | \n485 |         total_samples : int\n486 |             Total number of documents. It is only used when\n487 |             batch_update is `False`.\n488 | \n489 |         batch_update : bool\n490 |             Parameter that controls updating method.\n491 |             `True` for batch learning, `False` for online learning.\n492 | \n493 |         parallel : joblib.Parallel, default=None\n494 |             Pre-initialized instance of joblib.Parallel\n495 | \n496 |         Returns\n497 |         -------\n498 |         doc_topic_distr : ndarray of shape (n_samples, n_components)\n499 |             Unnormalized document topic distribution.\n500 |         \"\"\"\n501 | \n502 |         # E-step\n503 |         _, suff_stats = self._e_step(\n504 |             X, cal_sstats=True, random_init=True, parallel=parallel\n505 |         )\n506 | \n507 |         # M-step\n508 |         if batch_update:\n509 |             self.components_ = self.topic_word_prior_ + suff_stats\n510 |         else:\n511 |             # online update\n512 |             # In the literature, the weight is `rho`\n513 |             weight = np.power(\n514 |                 self.learning_offset + self.n_batch_iter_, -self.learning_decay\n515 |             )\n516 |             doc_ratio = float(total_samples) / X.shape[0]\n517 |             self.components_ *= 1 - weight\n518 |             self.components_ += weight * (\n519 |                 self.topic_word_prior_ + doc_ratio * suff_stats\n520 |             )\n521 | \n522 |         # update `component_` related variables\n523 |         self.exp_dirichlet_component_ = np.exp(\n524 |             _dirichlet_expectation_2d(self.components_)\n525 |         )\n526 |         self.n_batch_iter_ += 1\n527 |         return\n```\n\n\n\n##Searching for term \"online\", \"learning_method\", \"MiniBatchNMF online learning_method\"...\n### Search Result:\nFound class `sklearn/decomposition/_lda.py:LatentDirichletAllocation`.\nSource: Retrieved code content using keyword search (bm25).\nJust show the structure of this class due to response length limitations:\n```\nclass LatentDirichletAllocation(\n    _ClassNamePrefixFeaturesOutMixin, TransformerMixin, BaseEstimator\n):\n\n    def __init__(\n        self,\n        n_components=10,\n        *,\n        doc_topic_prior=None,\n        topic_word_prior=None,\n        learning_method=\"batch\",\n        learning_decay=0.7,\n        learning_offset=10.0,\n        max_iter=10,\n        batch_size=128,\n        evaluate_every=-1,\n        total_samples=1e6,\n        perp_tol=1e-1,\n        mean_change_tol=1e-3,\n        max_doc_update_iter=100,\n        n_jobs=None,\n        verbose=0,\n        random_state=None,\n    ):\n...\n    def _check_params(self):\n...\n    def _init_latent_vars(self, n_features):\n...\n    def _e_step(self, X, cal_sstats, random_init, parallel=None):\n...\n    def _em_step(self, X, total_samples, batch_update, parallel=None):\n...\n    def _more_tags(self):\n...\n    def _check_non_neg_array(self, X, reset_n_features, whom):\n...\n    def partial_fit(self, X, y=None):\n...\n    def fit(self, X, y=None):\n...\n    def _unnormalized_transform(self, X):\n...\n    def transform(self, X):\n...\n    def _approx_bound(self, X, doc_topic_distr, sub_sampling):\n...\n    def score(self, X, y=None):\n...\n    def _perplexity_precomp_distr(self, X, doc_topic_distr=None, sub_sampling=False):\n...\n    def perplexity(self, X, sub_sampling=False):\n...\n    @property\n    def _n_features_out(self):\n\n```\nHint: Search `sklearn/decomposition/_lda.py:LatentDirichletAllocation` to get the full content if needed.\n\nFound function `sklearn/decomposition/_lda.py:LatentDirichletAllocation._check_params`.\nSource: Retrieved code content using keyword search (bm25).\n```\n360 | def _check_params(self):\n361 |         \"\"\"Check model parameters.\"\"\"\n362 |         if self.n_components <= 0:\n363 |             raise ValueError(\"Invalid 'n_components' parameter: %r\" % self.n_components)\n364 | \n365 |         if self.total_samples <= 0:\n366 |             raise ValueError(\n367 |                 \"Invalid 'total_samples' parameter: %r\" % self.total_samples\n368 |             )\n369 | \n370 |         if self.learning_offset < 0:\n371 |             raise ValueError(\n372 |                 \"Invalid 'learning_offset' parameter: %r\" % self.learning_offset\n373 |             )\n374 | \n375 |         if self.learning_method not in (\"batch\", \"online\"):\n376 |             raise ValueError(\n377 |                 \"Invalid 'learning_method' parameter: %r\" % self.learning_method\n378 |             )\n```\n\n\n\n##Searching for term \"learning_method\"...\n### Search Result:\nFound function `sklearn/model_selection/_validation.py:learning_curve`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1351 | def learning_curve(\n1352 |     estimator,\n1353 |     X,\n1354 |     y,\n1355 |     *,\n1356 |     groups=None,\n1357 |     train_sizes=np.linspace(0.1, 1.0, 5),\n1358 |     cv=None,\n1359 |     scoring=None,\n1360 |     exploit_incremental_learning=False,\n1361 |     n_jobs=None,\n1362 |     pre_dispatch=\"all\",\n1363 |     verbose=0,\n1364 |     shuffle=False,\n1365 |     random_state=None,\n1366 |     error_score=np.nan,\n1367 |     return_times=False,\n1368 |     fit_params=None,\n1369 | ):\n1370 |     \"\"\"Learning curve.\n1371 | \n1372 |     Determines cross-validated training and test scores for different training\n1373 |     set sizes.\n1374 | \n1375 |     A cross-validation generator splits the whole dataset k times in training\n1376 |     and test data. Subsets of the training set with varying sizes will be used\n1377 |     to train the estimator and a score for each training subset size and the\n1378 |     test set will be computed. Afterwards, the scores will be averaged over\n1379 |     all k runs for each training subset size.\n1380 | \n1381 |     Read more in the :ref:`User Guide <learning_curve>`.\n1382 | \n1383 |     Parameters\n1384 |     ----------\n1385 |     estimator : object type that implements the \"fit\" and \"predict\" methods\n1386 |         An object of that type which is cloned for each validation.\n1387 | \n1388 |     X : array-like of shape (n_samples, n_features)\n1389 |         Training vector, where `n_samples` is the number of samples and\n1390 |         `n_features` is the number of features.\n1391 | \n1392 |     y : array-like of shape (n_samples,) or (n_samples, n_outputs)\n1393 |         Target relative to X for classification or regression;\n1394 |         None for unsupervised learning.\n1395 | \n1396 |     groups : array-like of  shape (n_samples,), default=None\n1397 |         Group labels for the samples used while splitting the dataset into\n1398 |         train/test set. Only used in conjunction with a \"Group\" :term:`cv`\n1399 |         instance (e.g., :class:`GroupKFold`).\n1400 | \n1401 |     train_sizes : array-like of shape (n_ticks,), \\\n1402 |             default=np.linspace(0.1, 1.0, 5)\n1403 |         Relative or absolute numbers of training examples that will be used to\n1404 |         generate the learning curve. If the dtype is float, it is regarded as a\n1405 |         fraction of the maximum size of the training set (that is determined\n1406 |         by the selected validation method), i.e. it has to be within (0, 1].\n1407 |         Otherwise it is interpreted as absolute sizes of the training sets.\n1408 |         Note that for classification the number of samples usually have to\n1409 |         be big enough to contain at least one sample from each class.\n1410 | \n1411 |     cv : int, cross-validation generator or an iterable, default=None\n1412 |         Determines the cross-validation splitting strategy.\n1413 |         Possible inputs for cv are:\n1414 | \n1415 |         - None, to use the default 5-fold cross validation,\n1416 |         - int, to specify the number of folds in a `(Stratified)KFold`,\n1417 |         - :term:`CV splitter`,\n1418 |         - An iterable yielding (train, test) splits as arrays of indices.\n1419 | \n1420 |         For int/None inputs, if the estimator is a classifier and ``y`` is\n1421 |         either binary or multiclass, :class:`StratifiedKFold` is used. In all\n1422 |         other cases, :class:`KFold` is used. These splitters are instantiated\n1423 |         with `shuffle=False` so the splits will be the same across calls.\n1424 | \n1425 |         Refer :ref:`User Guide <cross_validation>` for the various\n1426 |         cross-validation strategies that can be used here.\n1427 | \n1428 |         .. versionchanged:: 0.22\n1429 |             ``cv`` default value if None changed from 3-fold to 5-fold.\n1430 | \n1431 |     scoring : str or callable, default=None\n1432 |         A str (see model evaluation documentation) or\n1433 |         a scorer callable object / function with signature\n1434 |         ``scorer(estimator, X, y)``.\n1435 | \n1436 |     exploit_incremental_learning : bool, default=False\n1437 |         If the estimator supports incremental learning, this will be\n1438 |         used to speed up fitting for different training set sizes.\n1439 | \n1440 |     n_jobs : int, default=None\n1441 |         Number of jobs to run in parallel. Training the estimator and computing\n1442 |         the score are parallelized over the different training and test sets.\n1443 |         ``None`` means 1 unless in a :obj:`joblib.parallel_backend` context.\n1444 |         ``-1`` means using all processors. See :term:`Glossary <n_jobs>`\n1445 |         for more details.\n1446 | \n1447 |     pre_dispatch : int or str, default='all'\n1448 |         Number of predispatched jobs for parallel execution (default is\n