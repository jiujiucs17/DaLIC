ss for resampling datetimelike data, a groupby-like operation.\n 128 |     See aggregate, transform, and apply functions on this object.\n 129 | \n 130 |     It's easiest to use obj.resample(...) to use Resampler.\n 131 | \n 132 |     Parameters\n 133 |     ----------\n 134 |     obj : Series or DataFrame\n 135 |     groupby : TimeGrouper\n 136 | \n 137 |     Returns\n 138 |     -------\n 139 |     a Resampler of the appropriate type\n 140 | \n 141 |     Notes\n 142 |     -----\n 143 |     After resampling, see aggregate, apply, and transform functions.\n 144 |     \"\"\"\n 145 | \n 146 |     _grouper: BinGrouper\n 147 |     _timegrouper: TimeGrouper\n 148 |     binner: DatetimeIndex | TimedeltaIndex | PeriodIndex  # depends on subclass\n 149 |     exclusions: frozenset[Hashable] = frozenset()  # for SelectionMixin compat\n 150 |     _internal_names_set = set({\"obj\", \"ax\", \"_indexer\"})\n 151 | \n 152 |     # to the groupby descriptor\n 153 |     _attributes = [\n 154 |         \"freq\",\n 155 |         \"closed\",\n 156 |         \"label\",\n 157 |         \"convention\",\n 158 |         \"origin\",\n 159 |         \"offset\",\n 160 |     ]\n 161 | \n 162 |     def __init__(\n 163 |         self,\n 164 |         obj: NDFrame,\n 165 |         timegrouper: TimeGrouper,\n 166 |         *,\n 167 |         gpr_index: Index,\n 168 |         group_keys: bool = False,\n 169 |         selection=None,\n 170 |         include_groups: bool = True,\n 171 |     ) -> None:\n 172 |         self._timegrouper = timegrouper\n 173 |         self.keys = None\n 174 |         self.sort = True\n 175 |         self.group_keys = group_keys\n 176 |         self.as_index = True\n 177 |         self.include_groups = include_groups\n 178 | \n 179 |         self.obj, self.ax, self._indexer = self._timegrouper._set_grouper(\n 180 |             self._convert_obj(obj), sort=True, gpr_index=gpr_index\n 181 |         )\n 182 |         self.binner, self._grouper = self._get_binner()\n 183 |         self._selection = selection\n 184 |         if self._timegrouper.key is not None:\n 185 |             self.exclusions = frozenset([self._timegrouper.key])\n 186 |         else:\n 187 |             self.exclusions = frozenset()\n 188 | \n 189 |     @final\n 190 |     def __str__(self) -> str:\n 191 |         \"\"\"\n 192 |         Provide a nice str repr of our rolling object.\n 193 |         \"\"\"\n 194 |         attrs = (\n 195 |             f\"{k}={getattr(self._timegrouper, k)}\"\n 196 |             for k in self._attributes\n 197 |             if getattr(self._timegrouper, k, None) is not None\n 198 |         )\n 199 |         return f\"{type(self).__name__} [{', '.join(attrs)}]\"\n 200 | \n 201 |     @final\n 202 |     def __getattr__(self, attr: str):\n 203 |         if attr in self._internal_names_set:\n 204 |             return object.__getattribute__(self, attr)\n 205 |         if attr in self._attributes:\n 206 |             return getattr(self._timegrouper, attr)\n 207 |         if attr in self.obj:\n 208 |             return self[attr]\n 209 | \n 210 |         return object.__getattribute__(self, attr)\n 211 | \n 212 |     @final\n 213 |     @property\n 214 |     def _from_selection(self) -> bool:\n 215 |         \"\"\"\n 216 |         Is the resampling from a DataFrame column or MultiIndex level.\n 217 |         \"\"\"\n 218 |         # upsampling and PeriodIndex resampling do not work\n 219 |         # with selection, this state used to catch and raise an error\n 220 |         return self._timegrouper is not None and (\n 221 |             self._timegrouper.key is not None or self._timegrouper.level is not None\n 222 |         )\n 223 | \n 224 |     def _convert_obj(self, obj: NDFrameT) -> NDFrameT:\n 225 |         \"\"\"\n 226 |         Provide any conversions for the object in order to correctly handle.\n 227 | \n 228 |         Parameters\n 229 |         ----------\n 230 |         obj : Series or DataFrame\n 231 | \n 232 |         Returns\n 233 |         -------\n 234 |         Series or DataFrame\n 235 |         \"\"\"\n 236 |         return obj._consolidate()\n 237 | \n 238 |     def _get_binner_for_time(self):\n 239 |         raise AbstractMethodError(self)\n 240 | \n 241 |     @final\n 242 |     def _get_binner(self):\n 243 |         \"\"\"\n 244 |         Create the BinGrouper, assume that self.set_grouper(obj)\n 245 |         has already been called.\n 246 |         \"\"\"\n 247 |         binner, bins, binlabels = self._get_binner_for_time()\n 248 |         assert len(bins) == len(binlabels)\n 249 |         bin_grouper = BinGrouper(bins, binlabels, indexer=self._indexer)\n 250 |         return binner, bin_grouper\n 251 | \n 252 |     @overload\n 253 |     def pipe(\n 254 |         self,\n 255 |         func: Callable[Concatenate[Self, P], T],\n 256 |         *args: P.args,\n 257 |         **kwargs: P.kwargs,\n 258 |     ) -> T: ...\n 259 | \n 260 |     @overload\n 261 |     def pipe(\n 262 |         self,\n 263 |         func: tuple[Callable[..., T], str],\n 264 |         *args: Any,\n 265 |         **kwargs: Any,\n 266 |     ) -> T: ...\n 267 | \n 268 |     @final\n 269 |     @Substitution(\n 270 |         klass=\"Resampler\",\n 271 |         examples=\"\"\"\n 272 |     >>> df = pd.DataFrame({'A': [1, 2, 3, 4]},\n 273 |     ...                   index=pd.date_range('2012-08-02', periods=4))\n 274 |     >>> df\n 275 |                 A\n 276 |     2012-08-02  1\n 277 |     2012-08-03  2\n 278 |     2012-08-04  3\n 279 |     2012-08-05  4\n 280 | \n 281 |     To get the difference between each 2-day period's maximum and minimum\n 282 |     value in one pass, you can do\n 283 | \n 284 |     >>> df.resample('2D').pipe(lambda x: x.max() - x.min())\n 285 |                 A\n 286 |     2012-08-02  1\n 287 |     2012-08-04  1\"\"\",\n 288 |     )\n 289 |     @Appender(_pipe_template)\n 290 |     def pipe(\n 291 |         self,\n 292 |         func: Callable[Concatenate[Self, P], T] | tuple[Callable[..., T], str],\n 293 |         *args: Any,\n 294 |         **kwargs: Any,\n 295 |     ) -> T:\n 296 |         return super().pipe(func, *args, **kwargs)\n 297 | \n 298 |     _agg_see_also_doc = dedent(\n 299 |         \"\"\"\n 300 |     See Also\n 301 |     --------\n 302 |     DataFrame.groupby.aggregate : Aggregate using callable, string, dict,\n 303 |         or list of string/callables.\n 304 |     DataFrame.resample.transform : Transforms the Series on each group\n 305 |         based on the given function.\n 306 |     DataFrame.aggregate: Aggregate using one or more\n 307 |         operations over the specified axis.\n 308 |     \"\"\"\n 309 |     )\n 310 | \n 311 |     _agg_examples_doc = dedent(\n 312 |         \"\"\"\n 313 |     Examples\n 314 |     --------\n 315 |     >>> s = pd.Series([1, 2, 3, 4, 5],\n 316 |     ...               index=pd.date_range('20130101', periods=5, freq='s'))\n 317 |     >>> s\n 318 |     2013-01-01 00:00:00    1\n 319 |     2013-01-01 00:00:01    2\n 320 |     2013-01-01 00:00:02    3\n 321 |     2013-01-01 00:00:03    4\n 322 |     2013-01-01 00:00:04    5\n 323 |     Freq: s, dtype: int64\n 324 | \n 325 |     >>> r = s.resample('2s')\n 326 | \n 327 |     >>> r.agg(\"sum\")\n 328 |     2013-01-01 00:00:00    3\n 329 |     2013-01-01 00:00:02    7\n 330 |     2013-01-01 00:00:04    5\n 331 |     Freq: 2s, dtype: int64\n 332 | \n 333 |     >>> r.agg(['sum', 'mean', 'max'])\n 334 |                          sum  mean  max\n 335 |     2013-01-01 00:00:00    3   1.5    2\n 336 |     2013-01-01 00:00:02    7   3.5    4\n 337 |     2013-01-01 00:00:04    5   5.0    5\n 338 | \n 339 |     >>> r.agg({'result': lambda x: x.mean() / x.std(),\n 340 |     ...        'total': \"sum\"})\n 341 |                            result  total\n 342 |     2013-01-01 00:00:00  2.121320      3\n 343 |     2013-01-01 00:00:02  4.949747      7\n 344 |     2013-01-01 00:00:04       NaN      5\n 345 | \n 346 |     >>> r.agg(average=\"mean\", total=\"sum\")\n 347 |                              average  total\n 348 |     2013-01-01 00:00:00      1.5      3\n 349 |     2013-01-01 00:00:02      3.5      7\n 350 |     2013-01-01 00:00:04      5.0      5\n 351 |     \"\"\"\n 352 |     )\n 353 | \n 354 |     @final\n 355 |     @doc(\n 356 |         _shared_docs[\"aggregate\"],\n 357 |         see_also=_agg_see_also_doc,\n 358 |         examples=_agg_examples_doc,\n 359 |         klass=\"DataFrame\",\n 360 |         axis=\"\",\n 361 |     )\n 362 |     def aggregate(self, func=None, *args, **kwargs):\n 363 |         result = ResamplerWindowApply(self, func, args=args, kwargs=kwargs).agg()\n 364 |         if result is None:\n 365 |             how = func\n 366 |             result = self._groupby_and_aggregate(how, *args, **kwargs)\n 367 | \n 368 |         return result\n 369 | \n 370 |     agg = aggregate\n 371 |     apply = aggregate\n 372 | \n 373 |     @final\n 374 |     def transform(self, arg, *args, **kwargs):\n 375 |         \"\"\"\n 376 |         Call function producing a like-indexed Series on each group.\n 377 | \n 378 |         Return a Series with the transformed values.\n 379 | \n 380 |         Parameters\n 381 |         ----------\n 382 |         arg : function\n 383 |             To apply to each group. Should return a Series with the same index.\n 384 | \n 385 |         Returns\n 386 |         -------\n 387 |         Series\n 388 | \n 389 |         Examples\n 390 |         --------\n 391 |         >>> s = pd.Series([1, 2], index=pd.date_range(\"20180101\", periods=2, freq=\"1h\"))\n 392 |         >>> s\n 393 |         2018-01-01 00:00:00    1\n 394 |         2018-01-01 01:00:00    2\n 395 |         Freq: h, dtype: int64\n 396 | \n 397 |         >>> resampled = s.resample(\"15min\")\n 398 |         >>> resampled.transform(lambda x: (x - x.mean()) / x.std())\n 399 |         2018-01-01 00:00:00   NaN\n 400 |         2018-01-01 01:00:00   NaN\n 401 |         Freq: h, dtype: float64\n 402 |         \"\"\"\n 403 |         return self._selected_obj.groupby(self._timegrouper).transform(\n 404 |             arg, *args, **kwargs\n 405 |         )\n 406 | \n 407 |     def _downsample(self, how, **kwargs):\n 408 |         raise AbstractMethodError(self)\n 409 | \n 410 |     def _upsample(self, f, limit: int | None = None, fill_value=None):\n 411 |         raise AbstractMethodError(self)\n 412 | \n 413 |     def _gotitem(self, key, ndim: int, subset=None):\n 414 |         \"\"\"\n 415 |         Sub-classes to define. Return a sliced object.\n 416 | \n 417 |         Parameters\n 418 |         ----------\n 419 |         key : string / list of selections\n 420 |         ndim : {1, 2}\n 421 |             requested ndim of result\n 422 |         subset : object, default None\n 423 |             subset to act on\n 424 |         \"\"\"\n 425 |         grouper = self._grouper\n 426 |         if subset is None:\n 427 |             subset = self.obj\n 428 |             if key is not None:\n 429 |                 subset = subset[key]\n 430 |             else:\n 431 |                 # reached via Apply.agg_dict_like with selection=None and ndim=1\n 432 |                 assert subset.ndim == 1\n 433 |         if ndim == 1:\n 434 |             assert subset.ndim == 1\n 435 | \n 436 |         grouped = get_groupby(\n 437 |             subset, by=None, grouper=grouper, group_keys=self.group_keys\n 438 |         )\n 439 |         return grouped\n 440 | \n 441 |     def _groupby_and_aggregate(self, how, *args, **kwargs):\n 442 |         \"\"\"\n 443 |         Re-evaluate the obj with a groupby aggregation.\n 444 |         \"\"\"\n 445 |         grouper = self._grouper\n 446 | \n 447 |         # Excludes `on` column when provided\n 448 |         obj = self._obj_with_exclusions\n 449 | \n 450 |         grouped = get_groupby(obj, by=None, grouper=grouper, group_keys=self.group_keys)\n 451 | \n 452 |         try:\n 453 |             if callable(how):\n 454 |                 # TODO: test_resample_apply_with_additional_args fails if we go\n 455 |                 #  through the non-lambda path, not clear that it should.\n 456 |                 func = lambda x: how(x, *args, **kwargs)\n 457 |                 result = grouped.aggregate(func)\n 458 |             else:\n 459 |                 result = grouped.aggregate(how, *args, **kwargs)\n 460 |         except (AttributeError, KeyError):\n 461 |             # we have a non-reducing function; try to evaluate\n 462 |             # alternatively we want to evaluate only a column of the input\n 463 | \n 464 |             # test_apply_to_one_column_of_df the function being applied references\n 465 |             #  a DataFrame column, but aggregate_item_by_item operates column-wise\n 466 |             #  on Series, raising AttributeError or KeyError\n 467 |             #  (depending on whether the column lookup uses getattr/__getitem__)\n 468 |             result = _apply(\n 469 |                 grouped, how, *args, include_groups=self.include_groups, **kwargs\n 470 |             )\n 471 | \n 472 |         except ValueError as err:\n 473 |             if \"Must produce aggregated value\" in str(err):\n 474 |                 # raised in _aggregate_named\n 475 |                 # see test_apply_without_aggregation, test_apply_with_mutated_index\n 476 |                 pass\n 477 |             else:\n 478 |                 raise\n 479 | \n 480 |             # we have a non-reducing function\n 481 |             # try to evaluate\n 482 |             result = _apply(\n 483 |                 grouped, how, *args, include_groups=self.include_groups, **kwargs\n 484 |             )\n 485 | \n 486 |         return self._wrap_result(result)\n 487 | \n 488 |     @final\n 489 |     def _get_resampler_for_grouping(\n 490 |         self, groupby: GroupBy, key, include_groups: bool = True\n 491 |     ):\n 492 |         \"\"\"\n 493 |         Return the correct class for resampling with groupby.\n 494 |         \"\"\"\n 495 |         return self._resampler_for_grouping(\n 496 |             groupby=groupby, key=key, parent=self, include_groups=include_groups\n 497 |         )\n 498 | \n 499 |     def _wrap_result(self, result):\n 500 |         \"\"\"\n 501 |         Potentially wrap any results.\n 502 |         \"\"\"\n 503 |         # GH 47705\n 504 |         obj = self.obj\n 505 |         if (\n 506 |             isinstance(result, ABCDataFrame)\n 507 |             and len(result) == 0\n 508 |             and not isinstance(result.index, PeriodIndex)\n 509 |         ):\n 510 |             result = result.set_index(\n 511 |                 _asfreq_compat(obj.index[:0], freq=self.freq), append=True\n 512 |             )\n 513 | \n 514 |         if isinstance(result, ABCSeries) and self._selection is not None:\n 515 |             result.name = self._selection\n 516 | \n 517 |         if isinstance(result, ABCSeries) and result.empty:\n 518 |             # When index is all NaT, result is empty but index is not\n 519 |             result.index = _asfreq_compat(obj.index[:0], freq=self.freq)\n 520 |             result.name = getattr(obj, \"name\", None)\n 521 | \n 522 |         if self._timegrouper._arrow_dtype is not None:\n 523 |             result.index = result.index.astype(self._timegrouper._arrow_dtype)\n 524 | \n 525 |         return result\n 526 | \n 527 |     @final\n 528 |     def ffill(self, limit: int | None = None):\n 529 |         \"\"\"\n 530 |         Forward fill the values.\n 531 | \n 532 |         This method fills missing values by propagating the last valid\n 533 |         observation forward, up to the next valid observation. It is commonly\n 534 |         used in time series analysis when resampling data to a higher frequency\n 535 |         (upsampling) and filling gaps in the resampled output.\n 536 | \n 537 |         Parameters\n 538 |         ----------\n 539 |         limit : int, optional\n 540 |             Limit of how many values to fill.\n 541 | \n 542 |         Returns\n 543 |         -------\n 544 |         Series\n 545 |             The resampled data with missing values filled forward.\n 546 | \n 547 |         See Also\n 548 |         --------\n 549 |         Series.fillna: Fill NA/NaN values using the specified method.\n 550 |         DataFrame.fillna: Fill NA/NaN values using the specified method.\n 551 | \n 552 |         Examples\n 553 |         --------\n 554 |         Here we only create a ``Series``.\n 555 | \n 556 |         >>> ser = pd.Series(\n 557 |         ...     [1, 2, 3, 4],\n 558 |         ...     index=pd.DatetimeIndex(\n 559 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n 560 |         ...     ),\n 561 |         ... )\n 562 |         >>> ser\n 563 |         2023-01-01    1\n 564 |         2023-01-15    2\n 565 |         2023-02-01    3\n 566 |         2023-02-15    4\n 567 |         dtype: int64\n 568 | \n 569 |         Example for ``ffill`` with downsampling (we have fewer dates after resampling):\n 570 | \n 571 |         >>> ser.resample(\"MS\").ffill()\n 572 |         2023-01-01    1\n 573 |         2023-02-01    3\n 574 |         Freq: MS, dtype: int64\n 575 | \n 576 |         Example for ``ffill`` with upsampling (fill the new dates with\n 577 |         the previous value):\n 578 | \n 579 |         >>> ser.resample(\"W\").ffill()\n 580 |         2023-01-01    1\n 581 |         2023-01-08    1\n 582 |         2023-01-15    2\n 583 |         2023-01-22    2\n 584 |         2023-01-29    2\n 585 |         2023-02-05    3\n 586 |         2023-02-12    3\n 587 |         2023-02-19    4\n 588 |         Freq: W-SUN, dtype: int64\n 589 | \n 590 |         With upsampling and limiting (only fill the first new date with the\n 591 |         previous value):\n 592 | \n 593 |         >>> ser.resample(\"W\").ffill(limit=1)\n 594 |         2023-01-01    1.0\n 595 |         2023-01-08    1.0\n 596 |         2023-01-15    2.0\n 597 |         2023-01-22    2.0\n 598 |         2023-01-29    NaN\n 599 |         2023-02-05    3.0\n 600 |         2023-02-12    NaN\n 601 |         2023-02-19    4.0\n 602 |         Freq: W-SUN, dtype: float64\n 603 |         \"\"\"\n 604 |         return self._upsample(\"ffill\", limit=limit)\n 605 | \n 606 |     @final\n 607 |     def nearest(self, limit: int | None = None):\n 608 |         \"\"\"\n 609 |         Resample by using the nearest value.\n 610 | \n 611 |         When resampling data, missing values may appear (e.g., when the\n 612 |         resampling frequency is higher than the original frequency).\n 613 |         The `nearest` method will replace ``NaN`` values that appeared in\n 614 |         the resampled data with the value from the nearest member of the\n 615 |         sequence, based on the index value.\n 616 |         Missing values that existed in the original data will not be modified.\n 617 |         If `limit` is given, fill only this many values in each direction for\n 618 |         each of the original values.\n 619 | \n 620 |         Parameters\n 621 |         ----------\n 622 |         limit : int, optional\n 623 |             Limit of how many values to fill.\n 624 | \n 625 |         Returns\n 626 |         -------\n 627 |         Series or DataFrame\n 628 |             An upsampled Series or DataFrame with ``NaN`` values filled with\n 629 |             their nearest value.\n 630 | \n 631 |         See Also\n 632 |         --------\n 633 |         bfill : Backward fill the new missing values in the resampled data.\n 634 |         ffill : Forward fill ``NaN`` values.\n 635 | \n 636 |         Examples\n 637 |         --------\n 638 |         >>> s = pd.Series([1, 2], index=pd.date_range(\"20180101\", periods=2, freq=\"1h\"))\n 639 |         >>> s\n 640 |         2018-01-01 00:00:00    1\n 641 |         2018-01-01 01:00:00    2\n 642 |         Freq: h, dtype: int64\n 643 | \n 644 |         >>> s.resample(\"15min\").nearest()\n 645 |         2018-01-01 00:00:00    1\n 646 |         2018-01-01 00:15:00    1\n 647 |         2018-01-01 00:30:00    2\n 648 |         2018-01-01 00:45:00    2\n 649 |         2018-01-01 01:00:00    2\n 650 |         Freq: 15min, dtype: int64\n 651 | \n 652 |         Limit the number of upsampled values imputed by the nearest:\n 653 | \n 654 |         >>> s.resample(\"15min\").nearest(limit=1)\n 655 |         2018-01-01 00:00:00    1.0\n 656 |         2018-01-01 00:15:00    1.0\n 657 |         2018-01-01 00:30:00    NaN\n 658 |         2018-01-01 00:45:00    2.0\n 659 |         2018-01-01 01:00:00    2.0\n 660 |         Freq: 15min, dtype: float64\n 661 |         \"\"\"\n 662 |         return self._upsample(\"nearest\", limit=limit)\n 663 | \n 664 |     @final\n 665 |     def bfill(self, limit: int | None = None):\n 666 |         \"\"\"\n 667 |         Backward fill the new missing values in the resampled data.\n 668 | \n 669 |         In statistics, imputation is the process of replacing missing data with\n 670 |         substituted values [1]_. When resampling data, missing values may\n 671 |         appear (e.g., when the resampling frequency is higher than the original\n 672 |         frequency). The backward fill will replace NaN values that appeared in\n 673 |         the resampled data with the next value in the original sequence.\n 674 |         Missing values that existed in the original data will not be modified.\n 675 | \n 676 |         Parameters\n 677 |         ----------\n 678 |         limit : int, optional\n 679 |             Limit of how many values to fill.\n 680 | \n 681 |         Returns\n 682 |         -------\n 683 |         Series, DataFrame\n 684 |             An upsampled Series or DataFrame with backward filled NaN values.\n 685 | \n 686 |         See Also\n 687 |         --------\n 688 |         nearest : Fill NaN values with nearest neighbor starting from center.\n 689 |         ffill : Forward fill NaN values.\n 690 |         Series.fillna : Fill NaN values in the Series using the\n 691 |             specified method, which can be 'backfill'.\n 692 |         DataFrame.fillna : Fill NaN values in the DataFrame using the\n 693 |             specified method, which can be 'backfill'.\n 694 | \n 695 |         References\n 696 |         ----------\n 697 |         .. [1] https://en.wikipedia.org/wiki/Imputation_(statistics)\n 698 | \n 699 |         Examples\n 700 |         --------\n 701 |         Resampling a Series:\n 702 | \n 703 |         >>> s = pd.Series(\n 704 |         ...     [1, 2, 3], index=pd.date_range(\"20180101\", periods=3, freq=\"h\")\n 705 |         ... )\n 706 |         >>> s\n 707 |         2018-01-01 00:00:00    1\n 708 |         2018-01-01 01:00:00    2\n 709 |         2018-01-01 02:00:00    3\n 710 |         Freq: h, dtype: int64\n 711 | \n 712 |         >>> s.resample(\"30min\").bfill()\n 713 |         2018-01-01 00:00:00    1\n 714 |         2018-01-01 00:30:00    2\n 715 |         2018-01-01 01:00:00    2\n 716 |         2018-01-01 01:30:00    3\n 717 |         2018-01-01 02:00:00    3\n 718 |         Freq: 30min, dtype: int64\n 719 | \n 720 |         >>> s.resample(\"15min\").bfill(limit=2)\n 721 |         2018-01-01 00:00:00    1.0\n 722 |         2018-01-01 00:15:00    NaN\n 723 |         2018-01-01 00:30:00    2.0\n 724 |         2018-01-01 00:45:00    2.0\n 725 |         2018-01-01 01:00:00    2.0\n 726 |         2018-01-01 01:15:00    NaN\n 727 |         2018-01-01 01:30:00    3.0\n 728 |         2018-01-01 01:45:00    3.0\n 729 |         2018-01-01 02:00:00    3.0\n 730 |         Freq: 15min, dtype: float64\n 731 | \n 732 |         Resampling a DataFrame that has missing values:\n 733 | \n 734 |         >>> df = pd.DataFrame(\n 735 |         ...     {\"a\": [2, np.nan, 6], \"b\": [1, 3, 5]},\n 736 |         ...     index=pd.date_range(\"20180101\", periods=3, freq=\"h\"),\n 737 |         ... )\n 738 |         >>> df\n 739 |                                a  b\n 740 |         2018-01-01 00:00:00  2.0  1\n 741 |         2018-01-01 01:00:00  NaN  3\n 742 |         2018-01-01 02:00:00  6.0  5\n 743 | \n 744 |         >>> df.resample(\"30min\").bfill()\n 745 |                                a  b\n 746 |         2018-01-01 00:00:00  2.0  1\n 747 |         2018-01-01 00:30:00  NaN  3\n 748 |         2018-01-01 01:00:00  NaN  3\n 749 |         2018-01-01 01:30:00  6.0  5\n 750 |         2018-01-01 02:00:00  6.0  5\n 751 | \n 752 |         >>> df.resample(\"15min\").bfill(limit=2)\n 753 |                                a    b\n 754 |         2018-01-01 00:00:00  2.0  1.0\n 755 |         2018-01-01 00:15:00  NaN  NaN\n 756 |         2018-01-01 00:30:00  NaN  3.0\n 757 |         2018-01-01 00:45:00  NaN  3.0\n 758 |         2018-01-01 01:00:00  NaN  3.0\n 759 |         2018-01-01 01:15:00  NaN  NaN\n 760 |         2018-01-01 01:30:00  6.0  5.0\n 761 |         2018-01-01 01:45:00  6.0  5.0\n 762 |         2018-01-01 02:00:00  6.0  5.0\n 763 |         \"\"\"\n 764 |         return self._upsample(\"bfill\", limit=limit)\n 765 | \n 766 |     @final\n 767 |     def interpolate(\n 768 |         self,\n 769 |         method: InterpolateOptions = \"linear\",\n 770 |         *,\n 771 |         axis: Axis = 0,\n 772 |         limit: int | None = None,\n 773 |         inplace: bool = False,\n 774 |         limit_direction: Literal[\"forward\", \"backward\", \"both\"] = \"forward\",\n 775 |         limit_area=None,\n 776 |         downcast=lib.no_default,\n 777 |         **kwargs,\n 778 |     ):\n 779 |         \"\"\"\n 780 |         Interpolate values between target timestamps according to different methods.\n 781 | \n 782 |         The original index is first reindexed to target timestamps\n 783 |         (see :meth:`core.resample.Resampler.asfreq`),\n 784 |         then the interpolation of ``NaN`` values via :meth:`DataFrame.interpolate`\n 785 |         happens.\n 786 | \n 787 |         Parameters\n 788 |         ----------\n 789 |         method : str, default 'linear'\n 790 |             Interpolation technique to use. One of:\n 791 | \n 792 |             * 'linear': Ignore the index and treat the values as equally\n 793 |               spaced. This is the only method supported on MultiIndexes.\n 794 |             * 'time': Works on daily and higher resolution data to interpolate\n 795 |               given length of interval.\n 796 |             * 'index', 'values': use the actual numerical values of the index.\n 797 |             * 'pad': Fill in NaNs using existing values.\n 798 |             * 'nearest', 'zero', 'slinear', 'quadratic', 'cubic',\n 799 |               'barycentric', 'polynomial': Passed to\n 800 |               `scipy.interpolate.interp1d`, whereas 'spline' is passed to\n 801 |               `scipy.interpolate.UnivariateSpline`. These methods use the numerical\n 802 |               values of the index.  Both 'polynomial' and 'spline' require that\n 803 |               you also specify an `order` (int), e.g.\n 804 |               ``df.interpolate(method='polynomial', order=5)``. Note that,\n 805 |               `slinear` method in Pandas refers to the Scipy first order `spline`\n 806 |               instead of Pandas first order `spline`.\n 807 |             * 'krogh', 'piecewise_polynomial', 'spline', 'pchip', 'akima',\n 808 |               'cubicspline': Wrappers around the SciPy interpolation methods of\n 809 |               similar names. See `Notes`.\n 810 |             * 'from_derivatives': Refers to\n 811 |               `scipy.interpolate.BPoly.from_derivatives`.\n 812 | \n 813 |         axis : {{0 or 'index', 1 or 'columns', None}}, default None\n 814 |             Axis to interpolate along. For `Series` this parameter is unused\n 815 |             and defaults to 0.\n 816 |         limit : int, optional\n 817 |             Maximum number of consecutive NaNs to fill. Must be greater than\n 818 |             0.\n 819 |         inplace : bool, default False\n 820 |             Update the data in place if possible.\n 821 |         limit_direction : {{'forward', 'backward', 'both'}}, Optional\n 822 |             Consecutive NaNs will be filled in this direction.\n 823 | \n 824 |         limit_area : {{`None`, 'inside', 'outside'}}, default None\n 825 |             If limit is specified, consecutive NaNs will be filled with this\n 826 |             restriction.\n 827 | \n 828 |             * ``None``: No fill restriction.\n 829 |             * 'inside': Only fill NaNs surrounded by valid values\n 830 |               (interpolate).\n 831 |             * 'outside': Only fill NaNs outside valid values (extrapolate).\n 832 | \n 833 |         downcast : optional, 'infer' or None, defaults to None\n 834 |             Downcast dtypes if possible.\n 835 | \n 836 |             .. deprecated:: 2.1.0\n 837 | \n 838 |         **kwargs : optional\n 839 |             Keyword arguments to pass on to the interpolating function.\n 840 | \n 841 |         Returns\n 842 |         -------\n 843 |         DataFrame or Series\n 844 |             Interpolated values at the specified freq.\n 845 | \n 846 |         See Also\n 847 |         --------\n 848 |         core.resample.Resampler.asfreq: Return the values at the new freq,\n 849 |             essentially a reindex.\n 850 |         DataFrame.interpolate: Fill NaN values using an interpolation method.\n 851 |         DataFrame.bfill : Backward fill NaN values in the resampled data.\n 852 |         DataFrame.ffill : Forward fill NaN values.\n 853 | \n 854 |         Notes\n 855 |         -----\n 856 |         For high-frequent or non-equidistant time-series with timestamps\n 857 |         the reindexing followed by interpolation may lead to information loss\n 858 |         as shown in the last example.\n 859 | \n 860 |         Examples\n 861 |         --------\n 862 | \n 863 |         >>> start = \"2023-03-01T07:00:00\"\n 864 |         >>> timesteps = pd.date_range(start, periods=5, freq=\"s\")\n 865 |         >>> series = pd.Series(data=[1, -1, 2, 1, 3], index=timesteps)\n 866 |         >>> series\n 867 |         2023-03-01 07:00:00    1\n 868 |         2023-03-01 07:00:01   -1\n 869 |         2023-03-01 07:00:02    2\n 870 |         2023-03-01 07:00:03    1\n 871 |         2023-03-01 07:00:04    3\n 872 |         Freq: s, dtype: int64\n 873 | \n 874 |         Downsample the dataframe to 0.5Hz by providing the period time of 2s.\n 875 | \n 876 |         >>> series.resample(\"2s\").interpolate(\"linear\")\n 877 |         2023-03-01 07:00:00    1\n 878 |         2023-03-01 07:00:02    2\n 879 |         2023-03-01 07:00:04    3\n 880 |         Freq: 2s, dtype: int64\n 881 | \n 882 |         Upsample the dataframe to 2Hz by providing the period time of 500ms.\n 883 | \n 884 |         >>> series.resample(\"500ms\").interpolate(\"linear\")\n 885 |         2023-03-01 07:00:00.000    1.0\n 886 |         2023-03-01 07:00:00.500    0.0\n 887 |         2023-03-01 07:00:01.000   -1.0\n 888 |         2023-03-01 07:00:01.500    0.5\n 889 |         2023-03-01 07:00:02.000    2.0\n 890 |         2023-03-01 07:00:02.500    1.5\n 891 |         2023-03-01 07:00:03.000    1.0\n 892 |         2023-03-01 07:00:03.500    2.0\n 893 |         2023-03-01 07:00:04.000    3.0\n 894 |         Freq: 500ms, dtype: float64\n 895 | \n 896 |         Internal reindexing with ``asfreq()`` prior to interpolation leads to\n 897 |         an interpolated timeseries on the basis of the reindexed timestamps\n 898 |         (anchors). It is assured that all available datapoints from original\n 899 |         series become anchors, so it also works for resampling-cases that lead\n 900 |         to non-aligned timestamps, as in the following example:\n 901 | \n 902 |         >>> series.resample(\"400ms\").interpolate(\"linear\")\n 903 |         2023-03-01 07:00:00.000    1.0\n 904 |         2023-03-01 07:00:00.400    0.2\n 905 |         2023-03-01 07:00:00.800   -0.6\n 906 |         2023-03-01 07:00:01.200   -0.4\n 907 |         2023-03-01 07:00:01.600    0.8\n 908 |         2023-03-01 07:00:02.000    2.0\n 909 |         2023-03-01 07:00:02.400    1.6\n 910 |         2023-03-01 07:00:02.800    1.2\n 911 |         2023-03-01 07:00:03.200    1.4\n 912 |         2023-03-01 07:00:03.600    2.2\n 913 |         2023-03-01 07:00:04.000    3.0\n 914 |         Freq: 400ms, dtype: float64\n 915 | \n 916 |         Note that the series correctly decreases between two anchors\n 917 |         ``07:00:00`` and ``07:00:02``.\n 918 |         \"\"\"\n 919 |         assert downcast is lib.no_default  # just checking coverage\n 920 |         result = self._upsample(\"asfreq\")\n 921 | \n 922 |         # If the original data has timestamps which are not aligned with the\n 923 |         # target timestamps, we need to add those points back to the data frame\n 924 |         # that is supposed to be interpolated. This does not work with\n 925 |         # PeriodIndex, so we skip this case. GH#21351\n 926 |         obj = self._selected_obj\n 927 |         is_period_index = isinstance(obj.index, PeriodIndex)\n 928 | \n 929 |         # Skip this step for PeriodIndex\n 930 |         if not is_period_index:\n 931 |             final_index = result.index\n 932 |             if isinstance(final_index, MultiIndex):\n 933 |                 raise NotImplementedError(\n 934 |                     \"Direct interpolation of MultiIndex data frames is not \"\n 935 |                     \"supported. If you tried to resample and interpolate on a \"\n 936 |                     \"grouped data frame, please use:\\n\"\n 937 |                     \"`df.groupby(...).apply(lambda x: x.resample(...).\"\n 938 |                     \"interpolate(...), include_groups=False)`\"\n 939 |                     \"\\ninstead, as resampling and interpolation has to be \"\n 940 |                     \"performed for each group independently.\"\n 941 |                 )\n 942 | \n 943 |             missing_data_points_index = obj.index.difference(final_index)\n 944 |             if len(missing_data_points_index) > 0:\n 945 |                 result = concat(\n 946 |                     [result, obj.loc[missing_data_points_index]]\n 947 |                 ).sort_index()\n 948 | \n 949 |         result_interpolated = result.interpolate(\n 950 |             method=method,\n 951 |             axis=axis,\n 952 |             limit=limit,\n 953 |             inplace=inplace,\n 954 |             limit_direction=limit_direction,\n 955 |             limit_area=limit_area,\n 956 |             downcast=downcast,\n 957 |             **kwargs,\n 958 |         )\n 959 | \n 960 |         # No further steps if the original data has a PeriodIndex\n 961 |         if is_period_index:\n 962 |             return result_interpolated\n 963 | \n 964 |         # Make sure that original data points which do not align with the\n 965 |         # resampled index are removed\n 966 |         result_interpolated = result_interpolated.loc[final_index]\n 967 | \n 968 |         # Make sure frequency indexes are preserved\n 969 |         result_interpolated.index = final_index\n 970 |         return result_interpolated\n 971 | \n 972 |     @final\n 973 |     def asfreq(self, fill_value=None):\n 974 |         \"\"\"\n 975 |         Return the values at the new freq, essentially a reindex.\n 976 | \n 977 |         Parameters\n 978 |         ----------\n 979 |         fill_value : scalar, optional\n 980 |             Value to use for missing values, applied during upsampling (note\n 981 |             this does not fill NaNs that already were present).\n 982 | \n 983 |         Returns\n 984 |         -------\n 985 |         DataFrame or Series\n 986 |             Values at the specified freq.\n 987 | \n 988 |         See Also\n 989 |         --------\n 990 |         Series.asfreq: Convert TimeSeries to specified frequency.\n 991 |         DataFrame.asfreq: Convert TimeSeries to specified frequency.\n 992 | \n 993 |         Examples\n 994 |         --------\n 995 | \n 996 |         >>> ser = pd.Series(\n 997 |         ...     [1, 2, 3, 4],\n 998 |         ...     index=pd.DatetimeIndex(\n 999 |         ...         [\"2023-01-01\", \"2023-01-31\", \"2023-02-01\", \"2023-02-28\"]\n1000 |         ...     ),\n1001 |         ... )\n1002 |         >>> ser\n1003 |         2023-01-01    1\n1004 |         2023-01-31    2\n1005 |         2023-02-01    3\n1006 |         2023-02-28    4\n1007 |         dtype: int64\n1008 |         >>> ser.resample(\"MS\").asfreq()\n1009 |         2023-01-01    1\n1010 |         2023-02-01    3\n1011 |         Freq: MS, dtype: int64\n1012 |         \"\"\"\n1013 |         return self._upsample(\"asfreq\", fill_value=fill_value)\n1014 | \n1015 |     @final\n1016 |     def sum(\n1017 |         self,\n1018 |         numeric_only: bool = False,\n1019 |         min_count: int = 0,\n1020 |     ):\n1021 |         \"\"\"\n1022 |         Compute sum of group values.\n1023 | \n1024 |         This method provides a simple way to compute the sum of values within each\n1025 |         resampled group, particularly useful for aggregating time-based data into\n1026 |         daily, monthly, or yearly sums.\n1027 | \n1028 |         Parameters\n1029 |         ----------\n1030 |         numeric_only : bool, default False\n1031 |             Include only float, int, boolean columns.\n1032 | \n1033 |             .. versionchanged:: 2.0.0\n1034 | \n1035 |                 numeric_only no longer accepts ``None``.\n1036 | \n1037 |         min_count : int, default 0\n1038 |             The required number of valid values to perform the operation. If fewer\n1039 |             than ``min_count`` non-NA values are present the result will be NA.\n1040 | \n1041 |         Returns\n1042 |         -------\n1043 |         Series or DataFrame\n1044 |             Computed sum of values within each group.\n1045 | \n1046 |         See Also\n1047 |         --------\n1048 |         core.resample.Resampler.mean : Compute mean of groups, excluding missing values.\n1049 |         core.resample.Resampler.count : Compute count of group, excluding missing\n1050 |             values.\n1051 |         DataFrame.resample : Resample time-series data.\n1052 |         Series.sum : Return the sum of the values over the requested axis.\n1053 | \n1054 |         Examples\n1055 |         --------\n1056 |         >>> ser = pd.Series(\n1057 |         ...     [1, 2, 3, 4],\n1058 |         ...     index=pd.DatetimeIndex(\n1059 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1060 |         ...     ),\n1061 |         ... )\n1062 |         >>> ser\n1063 |         2023-01-01    1\n1064 |         2023-01-15    2\n1065 |         2023-02-01    3\n1066 |         2023-02-15    4\n1067 |         dtype: int64\n1068 |         >>> ser.resample(\"MS\").sum()\n1069 |         2023-01-01    3\n1070 |         2023-02-01    7\n1071 |         Freq: MS, dtype: int64\n1072 |         \"\"\"\n1073 |         return self._downsample(\"sum\", numeric_only=numeric_only, min_count=min_count)\n1074 | \n1075 |     @final\n1076 |     def prod(\n1077 |         self,\n1078 |         numeric_only: bool = False,\n1079 |         min_count: int = 0,\n1080 |     ):\n1081 |         \"\"\"\n1082 |         Compute prod of group values.\n1083 | \n1084 |         Parameters\n1085 |         ----------\n1086 |         numeric_only : bool, default False\n1087 |             Include only float, int, boolean columns.\n1088 | \n1089 |             .. versionchanged:: 2.0.0\n1090 | \n1091 |                 numeric_only no longer accepts ``None``.\n1092 | \n1093 |         min_count : int, default 0\n1094 |             The required number of valid values to perform the operation. If fewer\n1095 |             than ``min_count`` non-NA values are present the result will be NA.\n1096 | \n1097 |         Returns\n1098 |         -------\n1099 |         Series or DataFrame\n1100 |             Computed prod of values within each group.\n1101 | \n1102 |         Examples\n1103 |         --------\n1104 |         >>> ser = pd.Series(\n1105 |         ...     [1, 2, 3, 4],\n1106 |         ...     index=pd.DatetimeIndex(\n1107 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1108 |         ...     ),\n1109 |         ... )\n1110 |         >>> ser\n1111 |         2023-01-01    1\n1112 |         2023-01-15    2\n1113 |         2023-02-01    3\n1114 |         2023-02-15    4\n1115 |         dtype: int64\n1116 |         >>> ser.resample(\"MS\").prod()\n1117 |         2023-01-01    2\n1118 |         2023-02-01   12\n1119 |         Freq: MS, dtype: int64\n1120 |         \"\"\"\n1121 |         return self._downsample(\"prod\", numeric_only=numeric_only, min_count=min_count)\n1122 | \n1123 |     @final\n1124 |     def min(\n1125 |         self,\n1126 |         numeric_only: bool = False,\n1127 |         min_count: int = 0,\n1128 |     ):\n1129 |         \"\"\"\n1130 |         Compute min value of group.\n1131 | \n1132 |         Returns\n1133 |         -------\n1134 |         Series or DataFrame\n1135 | \n1136 |         Examples\n1137 |         --------\n1138 |         >>> ser = pd.Series(\n1139 |         ...     [1, 2, 3, 4],\n1140 |         ...     index=pd.DatetimeIndex(\n1141 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1142 |         ...     ),\n1143 |         ... )\n1144 |         >>> ser\n1145 |         2023-01-01    1\n1146 |         2023-01-15    2\n1147 |         2023-02-01    3\n1148 |         2023-02-15    4\n1149 |         dtype: int64\n1150 |         >>> ser.resample(\"MS\").min()\n1151 |         2023-01-01    1\n1152 |         2023-02-01    3\n1153 |         Freq: MS, dtype: int64\n1154 |         \"\"\"\n1155 |         return self._downsample(\"min\", numeric_only=numeric_only, min_count=min_count)\n1156 | \n1157 |     @final\n1158 |     def max(\n1159 |         self,\n1160 |         numeric_only: bool = False,\n1161 |         min_count: int = 0,\n1162 |     ):\n1163 |         \"\"\"\n1164 |         Compute max value of group.\n1165 | \n1166 |         Returns\n1167 |         -------\n1168 |         Series or DataFrame\n1169 | \n1170 |         Examples\n1171 |         --------\n1172 |         >>> ser = pd.Series(\n1173 |         ...     [1, 2, 3, 4],\n1174 |         ...     index=pd.DatetimeIndex(\n1175 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1176 |         ...     ),\n1177 |         ... )\n1178 |         >>> ser\n1179 |         2023-01-01    1\n1180 |         2023-01-15    2\n1181 |         2023-02-01    3\n1182 |         2023-02-15    4\n1183 |         dtype: int64\n1184 |         >>> ser.resample(\"MS\").max()\n1185 |         2023-01-01    2\n1186 |         2023-02-01    4\n1187 |         Freq: MS, dtype: int64\n1188 |         \"\"\"\n1189 |         return self._downsample(\"max\", numeric_only=numeric_only, min_count=min_count)\n1190 | \n1191 |     @final\n1192 |     @doc(GroupBy.first)\n1193 |     def first(\n1194 |         self,\n1195 |         numeric_only: bool = False,\n1196 |         min_count: int = 0,\n1197 |         skipna: bool = True,\n1198 |     ):\n1199 |         return self._downsample(\n1200 |             \"first\", numeric_only=numeric_only, min_count=min_count, skipna=skipna\n1201 |         )\n1202 | \n1203 |     @final\n1204 |     @doc(GroupBy.last)\n1205 |     def last(\n1206 |         self,\n1207 |         numeric_only: bool = False,\n1208 |         min_count: int = 0,\n1209 |         skipna: bool = True,\n1210 |     ):\n1211 |         return self._downsample(\n1212 |             \"last\", numeric_only=numeric_only, min_count=min_count, skipna=skipna\n1213 |         )\n1214 | \n1215 |     @final\n1216 |     @doc(GroupBy.median)\n1217 |     def median(self, numeric_only: bool = False):\n1218 |         return self._downsample(\"median\", numeric_only=numeric_only)\n1219 | \n1220 |     @final\n1221 |     def mean(\n1222 |         self,\n1223 |         numeric_only: bool = False,\n1224 |     ):\n1225 |         \"\"\"\n1226 |         Compute mean of groups, excluding missing values.\n1227 | \n1228 |         Parameters\n1229 |         ----------\n1230 |         numeric_only : bool, default False\n1231 |             Include only `float`, `int` or `boolean` data.\n1232 | \n1233 |             .. versionchanged:: 2.0.0\n1234 | \n1235 |                 numeric_only now defaults to ``False``.\n1236 | \n1237 |         Returns\n1238 |         -------\n1239 |         DataFrame or Series\n1240 |             Mean of values within each group.\n1241 | \n1242 |         Examples\n1243 |         --------\n1244 | \n1245 |         >>> ser = pd.Series(\n1246 |         ...     [1, 2, 3, 4],\n1247 |         ...     index=pd.DatetimeIndex(\n1248 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1249 |         ...     ),\n1250 |         ... )\n1251 |         >>> ser\n1252 |         2023-01-01    1\n1253 |         2023-01-15    2\n1254 |         2023-02-01    3\n1255 |         2023-02-15    4\n1256 |         dtype: int64\n1257 |         >>> ser.resample(\"MS\").mean()\n1258 |         2023-01-01    1.5\n1259 |         2023-02-01    3.5\n1260 |         Freq: MS, dtype: float64\n1261 |         \"\"\"\n1262 |         return self._downsample(\"mean\", numeric_only=numeric_only)\n1263 | \n1264 |     @final\n1265 |     def std(\n1266 |         self,\n1267 |         ddof: int = 1,\n1268 |         numeric_only: bool = False,\n1269 |     ):\n1270 |         \"\"\"\n1271 |         Compute standard deviation of groups, excluding missing values.\n1272 | \n1273 |         Parameters\n1274 |         ----------\n1275 |         ddof : int, default 1\n1276 |             Degrees of freedom.\n1277 |         numeric_only : bool, default False\n1278 |             Include only `float`, `int` or `boolean` data.\n1279 | \n1280 |             .. versionadded:: 1.5.0\n1281 | \n1282 |             .. versionchanged:: 2.0.0\n1283 | \n1284 |                 numeric_only now defaults to ``False``.\n1285 | \n1286 |         Returns\n1287 |         -------\n1288 |         DataFrame or Series\n1289 |             Standard deviation of values within each group.\n1290 | \n1291 |         Examples\n1292 |         --------\n1293 | \n1294 |         >>> ser = pd.Series(\n1295 |         ...     [1, 3, 2, 4, 3, 8],\n1296 |         ...     index=pd.DatetimeIndex(\n1297 |         ...         [\n1298 |         ...             \"2023-01-01\",\n1299 |         ...             \"2023-01-10\",\n1300 |         ...             \"2023-01-15\",\n1301 |         ...             \"2023-02-01\",\n1302 |         ...             \"2023-02-10\",\n1303 |         ...             \"2023-02-15\",\n1304 |         ...         ]\n1305 |         ...     ),\n1306 |         ... )\n1307 |         >>> ser.resample(\"MS\").std()\n1308 |         2023-01-01    1.000000\n1309 |         2023-02-01    2.645751\n1310 |         Freq: MS, dtype: float64\n1311 |         \"\"\"\n1312 |         return self._downsample(\"std\", ddof=ddof, numeric_only=numeric_only)\n1313 | \n1314 |     @final\n1315 |     def var(\n1316 |         self,\n1317 |         ddof: int = 1,\n1318 |         numeric_only: bool = False,\n1319 |     ):\n1320 |         \"\"\"\n1321 |         Compute variance of groups, excluding missing values.\n1322 | \n1323 |         Parameters\n1324 |         ----------\n1325 |         ddof : int, default 1\n1326 |             Degrees of freedom.\n1327 | \n1328 |         numeric_only : bool, default False\n1329 |             Include only `float`, `int` or `boolean` data.\n1330 | \n1331 |             .. versionadded:: 1.5.0\n1332 | \n1333 |             .. versionchanged:: 2.0.0\n1334 | \n1335 |                 numeric_only now defaults to ``False``.\n1336 | \n1337 |         Returns\n1338 |         -------\n1339 |         DataFrame or Series\n1340 |             Variance of values within each group.\n1341 | \n1342 |         Examples\n1343 |         --------\n1344 | \n1345 |         >>> ser = pd.Series(\n1346 |         ...     [1, 3, 2, 4, 3, 8],\n1347 |         ...     index=pd.DatetimeIndex(\n1348 |         ...         [\n1349 |         ...             \"2023-01-01\",\n1350 |         ...             \"2023-01-10\",\n1351 |         ...             \"2023-01-15\",\n1352 |         ...             \"2023-02-01\",\n1353 |         ...             \"2023-02-10\",\n1354 |         ...             \"2023-02-15\",\n1355 |         ...         ]\n1356 |         ...     ),\n1357 |         ... )\n1358 |         >>> ser.resample(\"MS\").var()\n1359 |         2023-01-01    1.0\n1360 |         2023-02-01    7.0\n1361 |         Freq: MS, dtype: float64\n1362 | \n1363 |         >>> ser.resample(\"MS\").var(ddof=0)\n1364 |         2023-01-01    0.666667\n1365 |         2023-02-01    4.666667\n1366 |         Freq: MS, dtype: float64\n1367 |         \"\"\"\n1368 |         return self._downsample(\"var\", ddof=ddof, numeric_only=numeric_only)\n1369 | \n1370 |     @final\n1371 |     @doc(GroupBy.sem)\n1372 |     def sem(\n1373 |         self,\n1374 |         ddof: int = 1,\n1375 |         numeric_only: bool = False,\n1376 |     ):\n1377 |         return self._downsample(\"sem\", ddof=ddof, numeric_only=numeric_only)\n1378 | \n1379 |     @final\n1380 |     @doc(GroupBy.ohlc)\n1381 |     def ohlc(self):\n1382 |         ax = self.ax\n1383 |         obj = self._obj_with_exclusions\n1384 |         if len(ax) == 0:\n1385 |             # GH#42902\n1386 |             obj = obj.copy()\n1387 |             obj.index = _asfreq_compat(obj.index, self.freq)\n1388 |             if obj.ndim == 1:\n1389 |                 obj = obj.to_frame()\n1390 |                 obj = obj.reindex([\"open\", \"high\", \"low\", \"close\"], axis=1)\n1391 |             else:\n1392 |                 mi = MultiIndex.from_product(\n1393 |                     [obj.columns, [\"open\", \"high\", \"low\", \"close\"]]\n1394 |                 )\n1395 |                 obj = obj.reindex(mi, axis=1)\n1396 |             return obj\n1397 | \n1398 |         return self._downsample(\"ohlc\")\n1399 | \n1400 |     @final\n1401 |     def nunique(self):\n1402 |         \"\"\"\n1403 |         Return number of unique elements in the group.\n1404 | \n1405 |         Returns\n1406 |         -------\n1407 |         Series\n1408 |             Number of unique values within each group.\n1409 | \n1410 |         See Also\n1411 |         --------\n1412 |         core.groupby.SeriesGroupBy.nunique : Method nunique for SeriesGroupBy.\n1413 | \n1414 |         Examples\n1415 |         --------\n1416 |         >>> ser = pd.Series(\n1417 |         ...     [1, 2, 3, 3],\n1418 |         ...     index=pd.DatetimeIndex(\n1419 |         ...         [\"2023-01-01\", \"2023-01-15\", \"2023-02-01\", \"2023-02-15\"]\n1420 |         ...     ),\n1421 |         ... )\n1422 |         >>> ser\n1423 |         2023-01-01    1\n1424 |         2023-01-15    2\n1425 |         2023-02-01    3\n1426 |         2023-02-15    3\n1427 |         dtype: int64\n1428 |         >>> ser.resample(\"MS\").nunique()\n1429 |         2023-01-01    2\n1430 |         2023-02-01    1\n1431 |         Freq: MS, dtype: int64\n1432 |         \"\"\"\n1433 |         return self._downsample(\"nunique\")\n1434 | \n1435 |     @final\n1436 |     @doc(GroupBy.size)\n1437 |     def size(self):\n1438 |         result = self._downsample(\"size\")\n1439 | \n1440 |         # If the result is a non-empty DataFrame we stack to get a Series\n1441 |         # GH 46826\n1442 |         if isinstance(result, ABCDataFrame) and not result.empty:\n1443 |             result = result.stack()\n1444 | \n1445 |         if not len(self.ax):\n1446 |             from pandas import Series\n1447 | \n1448 |             if self._selected_obj.ndim == 1:\n1449 |                 name = self._selected_obj.name\n1450 |             else:\n1451 |                 name = None\n1452 |             result = Series([], index=result.index, dtype=\"int64\", name=name)\n1453 |         return result\n1454 | \n1455 |     @final\n1456 |     @doc(GroupBy.count)\n1457 |     def count(self):\n1458 |         result = self._downsample(\"count\")\n1459 |         if not len(self.ax):\n1460 |             if self._selected_obj.ndim == 1:\n1461 |                 result = type(self._selected_obj)(\n1462 |                     [], index=result.index, dtype=\"int64\", name=self._selected_obj.name\n1463 |                 )\n1464 |             else:\n1465 |                 from pandas import DataFrame\n1466 | \n1467 |                 result = DataFrame(\n1468 |                     [], index=result.index, columns=result.columns, dtype=\"int64\"\n1469 |                 )\n1470 | \n1471 |         return result\n1472 | \n1473 |     @final\n1474 |     def quantile(self, q: float | list[float] | AnyArrayLike = 0.5, **kwargs):\n1475 |         \"\"\"\n1476 |         Return value at the given quantile.\n1477 | \n1478 |         Parameters\n1479 |         ----------\n1480 |         q : float or array-like, default 0.5 (50% quantile)\n1481 | \n1482 |         Returns\n1483 |         -------\n1484 |         DataFrame or Series\n1485 |             Quantile of values within each group.\n1486 | \n1487 |         See Also\n1488 |         --------\n1489 |         Series.quantile\n1490 |             Return a series, where the index is q and the values are the quantiles.\n1491 |         DataFrame.quantile\n1492 |             Return a DataFrame, where the columns are the columns of self,\n1493 |             and the values are the quantiles.\n1494 |         DataFrameGroupBy.quantile\n1495 |             Return a DataFrame, where the columns are groupby columns,\n1496 |             and the values are its quantiles.\n1497 | \n1498 |         Examples\n1499 |         --------\n1500 | \n1501 |         >>> ser = pd.Series(\n1502 |         ...     [1, 3, 2, 4, 3, 8],\n1503 |         ...     index=pd.DatetimeIndex(\n1504 |         ...         [\n1505 |         ...             \"2023-01-01\",\n1506 |         .