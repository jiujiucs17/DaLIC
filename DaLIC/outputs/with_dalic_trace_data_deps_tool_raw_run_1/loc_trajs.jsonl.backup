118 |             y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = bottom\n7119 |             y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7120 | \n7121 |             if log:\n7122 |                 if orientation == 'horizontal':\n7123 |                     self.set_xscale('log', nonpositive='clip')\n7124 |                 else:  # orientation == 'vertical'\n7125 |                     self.set_yscale('log', nonpositive='clip')\n7126 | \n7127 |             if align == 'left':\n7128 |                 x -= 0.5*(bins[1]-bins[0])\n7129 |             elif align == 'right':\n7130 |                 x += 0.5*(bins[1]-bins[0])\n7131 | \n7132 |             # If fill kwarg is set, it will be passed to the patch collection,\n7133 |             # overriding this\n7134 |             fill = (histtype == 'stepfilled')\n7135 | \n7136 |             xvals, yvals = [], []\n7137 |             for top in tops:\n7138 |                 if stacked:\n7139 |                     # top of the previous polygon becomes the bottom\n7140 |                     y[2*len(bins)-1:] = y[1:2*len(bins)-1][::-1]\n7141 |                 # set the top of this polygon\n7142 |                 y[1:2*len(bins)-1:2] = y[2:2*len(bins):2] = top + bottom\n7143 | \n7144 |                 # The starting point of the polygon has not yet been\n7145 |                 # updated. So far only the endpoint was adjusted. This\n7146 |                 # assignment closes the polygon. The redundant endpoint is\n7147 |                 # later discarded (for step and stepfilled).\n7148 |                 y[0] = y[-1]\n7149 | \n7150 |                 if orientation == 'horizontal':\n7151 |                     xvals.append(y.copy())\n7152 |                     yvals.append(x.copy())\n7153 |                 else:\n7154 |                     xvals.append(x.copy())\n7155 |                     yvals.append(y.copy())\n7156 | \n7157 |             # stepfill is closed, step is not\n7158 |             split = -1 if fill else 2 * len(bins)\n7159 |             # add patches in reverse order so that when stacking,\n7160 |             # items lower in the stack are plotted on top of\n7161 |             # items higher in the stack\n7162 |             for x, y, color in reversed(list(zip(xvals, yvals, colors))):\n7163 |                 patches.append(self.fill(\n7164 |                     x[:split], y[:split],\n7165 |                     closed=True if fill else None,\n7166 |                     facecolor=color,\n7167 |                     edgecolor=None if fill else color,\n7168 |                     fill=fill if fill else None,\n7169 |                     zorder=None if fill else mlines.Line2D.zorder))\n7170 |             for patch_list in patches:\n7171 |                 for patch in patch_list:\n7172 |                     if orientation == 'vertical':\n7173 |                         patch.sticky_edges.y.append(0)\n7174 |                     elif orientation == 'horizontal':\n7175 |                         patch.sticky_edges.x.append(0)\n7176 | \n7177 |             # we return patches, so put it back in the expected order\n7178 |             patches.reverse()\n7179 | \n7180 |         # If None, make all labels None (via zip_longest below); otherwise,\n7181 |         # cast each element to str, but keep a single str as it.\n7182 |         labels = [] if label is None else np.atleast_1d(np.asarray(label, str))\n7183 | \n7184 |         if histtype == \"step\":\n7185 |             edgecolors = itertools.cycle(np.atleast_1d(kwargs.get('edgecolor',\n7186 |                                                                   colors)))\n7187 |         else:\n7188 |             edgecolors = itertools.cycle(np.atleast_1d(kwargs.get(\"edgecolor\", None)))\n7189 | \n7190 |         facecolors = itertools.cycle(np.atleast_1d(kwargs.get('facecolor', colors)))\n7191 |         hatches = itertools.cycle(np.atleast_1d(kwargs.get('hatch', None)))\n7192 |         linewidths = itertools.cycle(np.atleast_1d(kwargs.get('linewidth', None