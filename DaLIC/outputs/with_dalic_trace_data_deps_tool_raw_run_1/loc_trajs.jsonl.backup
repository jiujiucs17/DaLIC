                  voxel_faces[i0].append(p0 + square_rot_neg)\n3517 | \n3518 |                     # draw middle faces\n3519 |                     for r1, r2 in itertools.pairwise(rinds):\n3520 |                         p1 = permute.dot([p, q, r1])\n3521 |                         p2 = permute.dot([p, q, r2])\n3522 | \n3523 |                         i1 = tuple(p1)\n3524 |                         i2 = tuple(p2)\n3525 | \n3526 |                         if filled[i1] and not filled[i2]:\n3527 |                             voxel_faces[i1].append(p2 + square_rot_pos)\n3528 |                         elif not filled[i1] and filled[i2]:\n3529 |                             voxel_faces[i2].append(p2 + square_rot_neg)\n3530 | \n3531 |                     # draw upper faces\n3532 |                     pk = permute.dot([p, q, rc-1])\n3533 |                     pk2 = permute.dot([p, q, rc])\n3534 |                     ik = tuple(pk)\n3535 |                     if filled[ik]:\n3536 |                         voxel_faces[ik].append(pk2 + square_rot_pos)\n3537 | \n3538 |         # iterate over the faces, and generate a Poly3DCollection for each\n3539 |         # voxel\n3540 |         polygons = {}\n3541 |         for coord, faces_inds in voxel_faces.items():\n3542 |             # convert indices into 3D positions\n3543 |             if xyz is None:\n3544 |                 faces = faces_inds\n3545 |             else:\n3546 |                 faces = []\n3547 |                 for face_inds in faces_inds:\n3548 |                     ind = face_inds[:, 0], face_inds[:, 1], face_inds[:, 2]\n3549 |                     face = np.empty(face_inds.shape)\n3550 |                     face[:, 0] = x[ind]\n3551 |                     face[:, 1] = y[ind]\n3552 |                     face[:, 2] = z[ind]\n3553 |                     faces.append(face)\n3554 | \n3555 |             # shade the faces\n3556 |             facecolor = facecolors[coord]\n3557 |             edgecolor = edgecolors[coord]\n3558 | \n3559 |             poly = art3d.Poly3DCollection(\n3560 |                 faces, facecolors=facecolor, edgecolors=edgecolor,\n3561 |                 shade=shade, lightsource=lightsource, axlim_clip=axlim_clip,\n3562 |                 **kwargs)\n3563 |             self.add_collection3d(poly)\n3564 |             polygons[coord] = poly\n3565 | \n3566 |         return polygons\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Patch3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n728 | def get_facecolor(self):\n729 |         return self._maybe_depth_shade_and_sort_colors(super().get_facecolor())\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Path3DCollection.get_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n914 | def get_facecolor(self):\n915 |         return self._maybe_depth_shade_and_sort_colors(super().get_facecolor())\n```\n\nFound function `lib/mpl_toolkits/mplot3d/art3d.py:Poly3DCollection.set_facecolor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n1197 | def set_facecolor(self, colors):\n1198 |         # docstring inherited\n1199 |         super().set_facecolor(colors)\n1200 |         self._facecolor3d = PolyCollection.get_facecolor(self)\n```\n\nFound function `galleries/examples/mplot3d/intersecting_planes.py:plot_quadrants`.\nSource: Retrieved code content using keyword search (bm25).\n```\n26 | def plot_quadrants(ax, array, fixed_coord, cmap):\n27 |     \"\"\"For a given 3d *array* plot a plane with *fixed_coord*, using four quadrants.\"\"\"\n28 |     nx, ny, nz = array.shape\n29 |     index = {\n30 |         'x': (nx // 2, slice(None), slice(None)),\n31 |         'y': (slice(None), ny // 2, slice(None)),\n32 |         'z': (slice(None), slice(None), nz // 2),\n33 |     }[fixed_coord]\n34 |     plane_data = array[index]\n35 | \n36 |     n0, n1 = plane_data.shape\n37 |     quadrants = [\n38 |         plane_data[:n0 // 2, :n1 // 2],\n39 |         plane_data[:n0 // 2, n1 // 2:],\n40 |         plane_data[n0 // 2:, :n1 // 2],\n41 |         plane_data[n0 // 2:, n1 // 2:]\n42 |     ]\n43 | \n44 |     min_val = array.min()\n45 |     max_val = array.max()\n46 | \n47 |     cmap = plt.get_cmap(cmap)\n48 | \n49 |     for i, quadrant in enumerate(quadrants):\n50 |         facecolors = cmap((quadrant - min_val) / (max_val - min_val))\n51 |         if fixed_coord == 'x':\n52 |             Y, Z = np.mgrid[0:ny // 2, 0:nz // 2]\n53 |             X = nx // 2 * np.ones_like(Y)\n54 |             Y_offset = (i // 2) * ny // 2\n55 |             Z_offset = (i % 2) * nz // 2\n56 |             ax.plot_surface(X, Y + Y_offset, Z + Z_offset, rstride=1, cstride=1,\n57 |                             facecolors=facecolors, shade=False)\n58 |         elif fixed_coord == 'y':\n59 |             X, Z = np.mgrid[0:nx // 2, 0:nz // 2]\n60 |             Y = ny // 2 * np.ones_like(X)\n61 |             X_offset = (i // 2) * nx // 2\n62 |             Z_offset = (i % 2) * nz // 2\n63 |             ax.plot_surface(X + X_offset, Y, Z + Z_offset, rstride=1, cstride=1,\n64 |                             facecolors=facecolors, shade=False)\n65 |         elif fixed_coord == 'z':\n66 |             X, Y = np.mgrid[0:nx // 2, 0:ny // 2]\n67 |             Z = nz // 2 * np.ones_like(X)\n68 |             X_offset = (i // 2) * nx // 2\n69 |             Y_offset = (i % 2) * ny // 2\n70 |             ax.plot_surface(X + X_offset, Y + Y_offset, Z, rstride=1, cstride=1,\n71 |                             facecolors=facecolors, shade=False)\n```\n\nFound class `lib/mpl_toolkits/axisartist/axisline_style.py:AxislineStyle.FilledArrow`.\nSource: Retrieved code content using keyword search (bm25).\n```\n161 | class FilledArrow(SimpleArrow):\n162 |         \"\"\"\n163 |         An arrow with a filled head.\n164 |         \"\"\"\n165 | \n166 |         ArrowAxisClass = _FancyAxislineStyle.FilledArrow\n167 | \n168 |         def __init__(self, size=1, facecolor=None):\n169 |             \"\"\"\n170 |             Parameters\n171 |             ----------\n172 |             size : float\n173 |                 Size of the arrow as a fraction of the ticklabel size.\n174 |             facecolor : :mpltype:`color`, default: :rc:`axes.edgecolor`\n175 |                 Fill color.\n176 | \n177 |                 .. versionadded:: 3.7\n178 |             \"\"\"\n179 | \n180 |             if facecolor is None:\n181 |                 facecolor = mpl.rcParams['axes.edgecolor']\n182 |             self.size = size\n183 |             self._facecolor = facecolor\n184 |             super().__init__(size=size)\n185 | \n186 |         def new_line(self, axis_artist, transform):\n187 |             linepath = Path([(0, 0), (0, 1)])\n188 |             axisline = self.ArrowAxisClass(axis_artist, linepath, transform,\n189 |                                            line_mutation_scale=self.size,\n190 |                                            facecolor=self._facecolor)\n191 |             return axisline\n```\n\n\n\n##Searching for term \"bar() color edgecolor facecolor\"...\n### Search Result:\nFound code snippet in file `galleries/examples/color/set_alpha.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n 1 | \"\"\"\n 2 | =================================\n 3 | Ways to set a color's alpha value\n 4 | =================================\n 5 | \n 6 | Compare setting alpha by the *alpha* keyword argument and by one of the Matplotlib color\n 7 | formats. Often, the *alpha* keyword is the only tool needed to add transparency to a\n 8 | color. In some cases, the *(matplotlib_color, alpha)* color format provides an easy way\n 9 | to fine-tune the appearance of a Figure.\n10 | \n11 | \"\"\"\n12 | \n13 | import matplotlib.pyplot as plt\n14 | import numpy as np\n15 | \n16 | # Fixing random state for reproducibility.\n17 | np.random.seed(19680801)\n18 | \n19 | fig, (ax1, ax2) = plt.subplots(ncols=2, figsize=(8, 4))\n20 | \n21 | x_values = [n for n in range(20)]\n22 | y_values = np.random.randn(20)\n23 | \n24 | facecolors = ['green' if y > 0 else 'red' for y in y_values]\n25 | edgecolors = facecolors\n26 | \n27 | ax1.bar(x_values, y_values, color=facecolors, edgecolor=edgecolors, alpha=0.5)\n28 | ax1.set_title(\"Explicit 'alpha' keyword value\\nshared by all bars and edges\")\n29 | \n30 | \n31 | # Normalize y values to get distinct face alpha values.\n32 | abs_y = [abs(y) for y in y_values]\n33 | face_alphas = [n / max(abs_y) for n in abs_y]\n34 | edge_alphas = [1 - alpha for alpha in face_alphas]\n35 | \n36 | colors_with_alphas = list(zip(facecolors, face_alphas))\n37 | edgecolors_with_alphas = list(zip(edgecolors, edge_alphas))\n38 | \n39 | ax2.bar(x_values, y_values, color=colors_with_alphas,\n40 |         edgecolor=edgecolors_with_alphas)\n41 | ax2.set_title('Normalized alphas for\\neach bar and each edge')\n42 | \n43 | plt.show()\n44 | \n45 | # %%\n46 | #\n47 | # .. admonition:: References\n48 | #\n49 | #    The use of the following functions, methods, classes and modules is shown\n50 | #    in this example:\n51 | #\n52 | #    - `matplotlib.axes.Axes.bar`\n53 | #    - `matplotlib.pyplot.subplots`\n54 | #\n55 | # .. tags::\n56 | #\n57 | #    styling: color\n58 | #    plot-type: bar\n59 | #    level: beginner\n60 | \n```\n\nFound code snippet in file `galleries/examples/statistics/histogram_multihist.py`.\nSource: Retrieved code content using keyword search (bm25).\n```\n  1 | \"\"\"\n  2 | =====================================================\n  3 | The histogram (hist) function with multiple data sets\n  4 | =====================================================\n  5 | \n  6 | Plot histogram with multiple sample sets and demonstrate:\n  7 | \n  8 | * Use of legend with multiple sample sets\n  9 | * Stacked bars\n 10 | * Step curve with no fill\n 11 | * Data sets of different sample sizes\n 12 | \n 13 | Selecting different bin counts and sizes can significantly affect the\n 14 | shape of a histogram. The Astropy docs have a great section on how to\n 15 | select these parameters:\n 16 | http://docs.astropy.org/en/stable/visualization/histogram.html\n 17 | \n 18 | .. redirect-from:: /gallery/lines_bars_and_markers/filled_step\n 19 | \n 20 | \"\"\"\n 21 | # %%\n 22 | import matplotlib.pyplot as plt\n 23 | import numpy as np\n 24 | \n 25 | np.random.seed(19680801)\n 26 | \n 27 | n_bins = 10\n 28 | x = np.random.randn(1000, 3)\n 29 | \n 30 | fig, ((ax0, ax1), (ax2, ax3)) = plt.subplots(nrows=2, ncols=2)\n 31 | \n 32 | colors = ['red', 'tan', 'lime']\n 33 | ax0.hist(x, n_bins, density=True, histtype='bar', color=colors, label=colors)\n 34 | ax0.legend(prop={'size': 10})\n 35 | ax0.set_title('bars with legend')\n 36 | \n 37 | ax1.hist(x, n_bins, density=True, histtype='bar', stacked=True)\n 38 | ax1.set_title('stacked bar')\n 39 | \n 40 | ax2.hist(x, n_bins, histtype='step', stacked=True, fill=False)\n 41 | ax2.set_title('stack step (unfilled)')\n 42 | \n 43 | # Make a multiple-histogram of data-sets with different length.\n 44 | x_multi = [np.random.randn(n) for n in [10000, 5000, 2000]]\n 45 | ax3.hist(x_multi, n_bins, histtype='bar')\n 46 | ax3.set_title('different sample sizes')\n 47 | \n 48 | fig.tight_layout()\n 49 | plt.show()\n 50 | \n 51 | # %%\n 52 | # -----------------------------------\n 53 | # Setting properties for each dataset\n 54 | # -----------------------------------\n 55 | #\n 56 | # You can style the histograms individually by passing a list of values to the\n 57 | # following parameters:\n 58 | #\n 59 | # * edgecolor\n 60 | # * facecolor\n 61 | # * hatch\n 62 | # * linewidth\n 63 | # * linestyle\n 64 | #\n 65 | #\n 66 | # edgecolor\n 67 | # .........\n 68 | \n 69 | fig, ax = plt.subplots()\n 70 | \n 71 | edgecolors = ['green', 'red', 'blue']\n 72 | \n 73 | ax.hist(x, n_bins, fill=False, histtype=\"step\", stacked=True,\n 74 |         edgecolor=edgecolors, label=edgecolors)\n 75 | ax.legend()\n 76 | ax.set_title('Stacked Steps with Edgecolors')\n 77 | \n 78 | plt.show()\n 79 | \n 80 | # %%\n 81 | # facecolor\n 82 | # .........\n```\n\nFound function `lib/matplotlib/axes/_axes.py:Axes.hist`.\nSource: Retrieved code content using keyword search (bm25).\n```\n6728 | def hist(self, x, bins=None, range=None, density=False, weights=None,\n6729 |              cumulative=False, bottom=None, histtype='bar', align='mid',\n6730 |              orientation='vertical', rwidth=None, log=False,\n6731 |              color=None, label=None, stacked=False, **kwargs):\n6732 |         \"\"\"\n6733 |         Compute and plot a histogram.\n6734 | \n6735 |         This method uses `numpy.histogram` to bin the data in *x* and count the\n6736 |         number of values in each bin, then draws the distribution either as a\n6737 |         `.BarContainer` or `.Polygon`. The *bins*, *range*, *density*, and\n6738 |         *weights* parameters are forwarded to `numpy.histogram`.\n6739 | \n6740 |         If the data has already been binned and counted, use `~.bar` or\n6741 |         `~.stairs` to plot the distribution::\n6742 | \n6743 |             counts, bins = np.histogram(x)\n6744 |             plt.stairs(counts, bins)\n6745 | \n6746 |         Alternatively, plot pre-computed bins and counts using ``hist()`` by\n6747 |         treating each bin as a single point with a weight equal to its count::\n6748 | \n6749 |             plt.hist(bins[:-1], bins, weights=counts)\n6750 | \n6751 |         The data input *x* can be a singular array, a list of datasets of\n6752 |         potentially different lengths ([*x0*, *x1*, ...]), or a 2D ndarray in\n6753 |         which each column is a dataset. Note that the ndarray form is\n6754 |         transposed relative to the list form. If the input is an array, then\n6755 |         the return value is a tuple (*n*, *bins*, *patches*); if the input is a\n6756 |         sequence of arrays, then the return value is a tuple\n6757 |         ([*n0*, *n1*, ...], *bins*, [*patches0*, *patches1*, ...]).\n6758 | \n6759 |         Masked arrays are not supported.\n6760 | \n6761 |         Parameters\n6762 |         ----------\n6763 |         x : (n,) array or sequence of (n,) arrays\n6764 |             Input values, this takes either a single array or a sequence of\n6765 |             arrays which are not required to be of the same length.\n6766 | \n6767 |         bins : int or sequence or str, default: :rc:`hist.bins`\n6768 |             If *bins* is an integer, it defines the number of equal-width bins\n6769 |             in the range.\n6770 | \n6771 |             If *bins* is a sequence, it defines the bin edges, including the\n6772 |             left edge of the first bin and the right edge of the last bin;\n6773 |             in this case, bins may be unequally spaced.  All but the last\n6774 |             (righthand-most) bin is half-open.  In other words, if *bins* is::\n6775 | \n6776 |                 [1, 2, 3, 4]\n6777 | \n6778 |             then the first bin is ``[1, 2)`` (including 1, but excluding 2) and\n6779 |             the second ``[2, 3)``.  The last bin, however, is ``[3, 4]``, which\n6780 |             *includes* 4.\n6781 | \n6782 |             If *bins* is a string, it is one of the binning strategies\n6783 |             supported by `numpy.histogram_bin_edges`: 'auto', 'fd', 'doane',\n6784 |             'scott', 'stone', 'rice', 'sturges', or 'sqrt'.\n6785 | \n6786 |         range : tuple or None, default: None\n6787 |             The lower and upper range of the bins. Lower and upper outliers\n6788 |             are ignored. If not provided, *range* is ``(x.min(), x.max())``.\n6789 |             Range has no effect if *bins* is a sequence.\n6790 | \n6791 |             If *bins* is a sequence or *range* is specified, autoscaling\n6792 |             is based on the specified bin range instead of the\n6793 |             range of x.\n6794 | \n6795 |         density : bool, default: False\n6796 |             If ``True``, draw and return a probability density: each bin\n6797 |             will display the bin's raw count divided by the total number of\n6798 |             counts *and the bin width*\n6799 |             (``density = counts / (sum(counts) * np.diff(bins))``),\n6800 |             so that the area under the histogram integrates to 1\n6801 |             (``np.sum(density * np.diff(bins)) == 1``).\n6802 | \n6803 |             If *stacked* is also ``True``, the sum of the histograms is\n6804 |             normalized to 1.\n6805 | \n6806 |         weights : (n,) array-like or None, default: None\n6807 |             An array of weights, of the same shape as *x*.  Each value in\n6808 |             *x* only contributes its associated weight towards the bin count\n6809 |             (instead of 1).  If *density* is ``True``, the weights are\n6810 |             normalized, so that the integral of the density over the range\n6811 |             remains 1.\n6812 | \n6813 |         cumulative : bool or -1, default: False\n6814 |             If ``True``, then a histogram is computed where each bin gives the\n6815 |             counts in that bin plus all bins for smaller values. The last bin\n6816 |             gives the total number of datapoints.\n6817 | \n6818 |             If *density* is also ``True`` then the histogram is normalized such\n6819 |             that the last bin equals 1.\n6820 | \n6821 |             If *cumulative* is a number less than 0 (e.g., -1), the direction\n6822 |             of accumulation is reversed.  In this case, if *density* is also\n6823 |             ``True``, then the histogram is normalized such that the first bin\n6824 |             equals 1.\n6825 | \n6826 |         bottom : array-like, scalar, or None, default: None\n6827 |             Location of the bottom of each bin, i.e. bins are drawn from\n6828 |             ``bottom`` to ``bottom + hist(x, bins)`` If a scalar, the bottom\n6829 |             of each bin is shifted by the same amount. If an array, each bin\n6830 |             is shifted independently and the length of bottom must match the\n6831 |             number of bins. If None, defaults to 0.\n6832 | \n6833 |         histtype : {'bar', 'barstacked', 'step', 'stepfilled'}, default: 'bar'\n6834 |             The type of histogram to draw.\n6835 | \n6836 |             - 'bar' is a traditional bar-type histogram.  If multiple data\n6837 |               are given the bars are arranged side by side.\n6838 |             - 'barstacked' is a bar-type histogram where multiple\n6839 |               data are stacked on top of each other.\n6840 |             - 'step' generates a lineplot that is by default unfilled.\n6841 |             - 'stepfilled' generates a lineplot that is by default filled.\n6842 | \n6843 |         align : {'left', 'mid', 'right'}, default: 'mid'\n6844 |             The horizontal alignment of the histogram bars.\n6845 | \n6846 |             - 'left': bars are centered on the left bin edges.\n6847 |             - 'mid': bars are centered between the bin edges.\n6848 |             - 'right': bars are centered on the right bin edges.\n6849 | \n6850 |         orientation : {'vertical', 'horizontal'}, default: 'vertical'\n6851 |             If 'horizontal', `~.Axes.barh` will be used for bar-type histograms\n6852 |             and the *bottom* kwarg will be the left edges.\n6853 | \n6854 |         rwidth : float or None, default: None\n6855 |             The relative width of the bars as a fraction of the bin width.  If\n6856 |             ``None``, automatically compute the width.\n6857 | \n6858 |             Ignored if *histtype* is 'step' or 'stepfilled'.\n6859 | \n6860 |         log : bool, default: False\n6861 |             If ``True``, the histogram axis will be set to a log scale.\n6862 | \n6863 |         color : :mpltype:`color` or list of :mpltype:`color` or None, default: None\n6864 |             Color or sequence of colors, one per dataset.  Default (``None``)\n6865 |             uses the standard line color sequence.\n6866 | \n6867 |         label : str or list of str, optional\n6868 |             String, or sequence of strings to match multiple datasets.  Bar\n6869 |             charts yield multiple patches per dataset, but only the first gets\n6870 |             the label, so that `~.Axes.legend` will work as expected.\n6871 | \n6872 |         stacked : bool, default: False\n6873 |             If ``True``, multiple data are stacked on top of each other If\n6874 |             ``False`` multiple data are arranged side by side if histtype is\n6875 |             'bar' or on top of each other if histtype is 'step'\n6876 | \n6877 |         Returns\n6878 |         -------\n6879 |         n : array or list of arrays\n6880 |             The values of the histogram bins. See *density* and *weights* for a\n6881 |             description of the possible semantics.  If input *x* is an array,\n6882 |             then this is an array of length *nbins*. If input is a sequence of\n6883 |             arrays ``[data1, data2, ...]``, then this is a list of arrays with\n6884 |             the values of the histograms for each of the arrays in the same\n6885 |             order.  The dtype of the array *n* (or of its element arrays) will\n6886 |             always be float even if no weighting or normalization is used.\n6887 | \n6888 |         bins : array\n6889 |             The edges of the bins. Length nbins + 1 (nbins left edges and right\n6890 |             edge of last bin).  Always a single array even when multiple data\n6891 |             sets are passed in.\n6892 | \n6893 |         patches : `.BarContainer` or list of a single `.Polygon` or list of \\\n6894 | such objects\n6895 |             Container of individual artists used to create the histogram\n6896 |             or list of such containers if there are multiple input datasets.\n6897 | \n6898 |         Other Parameters\n6899 |         ----------------\n6900 |         data : indexable object, optional\n6901 |             DATA_PARAMETER_PLACEHOL