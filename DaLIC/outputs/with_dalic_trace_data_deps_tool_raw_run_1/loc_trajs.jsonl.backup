(bm25).\n```\n2763 | def bar_label(self, container, labels=None, *, fmt=\"%g\", label_type=\"edge\",\n2764 |                   padding=0, **kwargs):\n2765 |         \"\"\"\n2766 |         Label a bar plot.\n2767 | \n2768 |         Adds labels to bars in the given `.BarContainer`.\n2769 |         You may need to adjust the axis limits to fit the labels.\n2770 | \n2771 |         Parameters\n2772 |         ----------\n2773 |         container : `.BarContainer`\n2774 |             Container with all the bars and optionally errorbars, likely\n2775 |             returned from `.bar` or `.barh`.\n2776 | \n2777 |         labels : array-like, optional\n2778 |             A list of label texts, that should be displayed. If not given, the\n2779 |             label texts will be the data values formatted with *fmt*.\n2780 | \n2781 |         fmt : str or callable, default: '%g'\n2782 |             An unnamed %-style or {}-style format string for the label or a\n2783 |             function to call with the value as the first argument.\n2784 |             When *fmt* is a string and can be interpreted in both formats,\n2785 |             %-style takes precedence over {}-style.\n2786 | \n2787 |             .. versionadded:: 3.7\n2788 |                Support for {}-style format string and callables.\n2789 | \n2790 |         label_type : {'edge', 'center'}, default: 'edge'\n2791 |             The label type. Possible values:\n2792 | \n2793 |             - 'edge': label placed at the end-point of the bar segment, and the\n2794 |               value displayed will be the position of that end-point.\n2795 |             - 'center': label placed in the center of the bar segment, and the\n2796 |               value displayed will be the length of that segment.\n2797 |               (useful for stacked bars, i.e.,\n2798 |               :doc:`/gallery/lines_bars_and_markers/bar_label_demo`)\n2799 | \n2800 |         padding : float, default: 0\n2801 |             Distance of label from the end of the bar, in points.\n2802 | \n2803 |         **kwargs\n2804 |             Any remaining keyword arguments are passed through to\n2805 |             `.Axes.annotate`. The alignment parameters (\n2806 |             *horizontalalignment* / *ha*, *verticalalignment* / *va*) are\n2807 |             not supported because the labels are automatically aligned to\n2808 |             the bars.\n2809 | \n2810 |         Returns\n2811 |         -------\n2812 |         list of `.Annotation`\n2813 |             A list of `.Annotation` instances for the labels.\n2814 |         \"\"\"\n2815 |         for key in ['horizontalalignment', 'ha', 'verticalalignment', 'va']:\n2816 |             if key in kwargs:\n2817 |                 raise ValueError(\n2818 |                     f\"Passing {key!r} to bar_label() is not supported.\")\n2819 | \n2820 |         a, b = self.yaxis.get_view_interval()\n2821 |         y_inverted = a > b\n2822 |         c, d = self.xaxis.get_view_interval()\n2823 |         x_inverted = c > d\n2824 | \n2825 |         # want to know whether to put label on positive or negative direction\n2826 |         # cannot use np.sign here because it will return 0 if x == 0\n2827 |         def sign(x):\n2828 |             return 1 if x >= 0 else -1\n2829 | \n2830 |         _api.check_in_list(['edge', 'center'], label_type=label_type)\n2831 | \n2832 |         bars = container.patches\n2833 |         errorbar = container.errorbar\n2834 |         datavalues = container.datavalues\n2835 |         orientation = container.orientation\n2836 | \n2837 |         if errorbar:\n2838 |             # check \"ErrorbarContainer\" for the definition of these elements\n2839 |             lines = errorbar.lines  # attribute of \"ErrorbarContainer\" (tuple)\n2840 |             barlinecols = lines[2]  # 0: data_line, 1: caplines, 2: barlinecols\n2841 |             barlinecol = barlinecols[0]  # the \"LineCollection\" of error bars\n2842 |             errs = barlinecol.get_segments()\n2843 |         else:\n2844 |             errs = []\n2845 | \n2846 |         if labels is None:\n2847 |             labels = []\n2848 | \n2849 |         annotations = []\n2850 | \n2851 |         for bar, err, dat, lbl in itertools.zip_longest(\n2852 |                 bars, errs, datavalues, labels\n2853 |         ):\n2854 |             (x0, y0), (x1, y1) = bar.get_bbox().get_points()\n2855 |             xc, yc = (x0 + x1) / 2, (y0 + y1) / 2\n2856 | \n2857 |             if orientation == \"vertical\":\n2858 |                 extrema = max(y0, y1) if dat >= 0 else min(y0, y1)\n2859 |                 length = abs(y0 - y1)\n2860 |             else:  # horizontal\n2861 |                 extrema = max(x0, x1) if dat >= 0 else min(x0, x1)\n2862 |                 length = abs(x0 - x1)\n2863 | \n2864 |             if err is None or np.size(err) == 0:\n2865 |                 endpt = extrema\n2866 |             elif orientation == \"vertical\":\n2867 |                 endpt = err[:, 1].max() if dat >= 0 else err[:, 1].min()\n2868 |             else:  # horizontal\n2869 |                 endpt = err[:, 0].max() if dat >= 0 else err[:, 0].min()\n2870 | \n2871 |             if label_type == \"center\":\n2872 |                 value = sign(dat) * length\n2873 |             else:  # edge\n2874 |                 value = extrema\n2875 | \n2876 |             if label_type == \"center\":\n2877 |                 xy = (0.5, 0.5)\n2878 |                 kwargs[\"xycoords\"] = (\n2879 |                     lambda r, b=bar:\n2880 |                         mtransforms.Bbox.intersection(\n2881 |                             b.get_window_extent(r), b.get_clip_box()\n2882 |                         ) or mtransforms.Bbox.null()\n2883 |                 )\n2884 |             else:  # edge\n2885 |                 if orientation == \"vertical\":\n2886 |                     xy = xc, endpt\n2887 |                 else:  # horizontal\n2888 |                     xy = endpt, yc\n2889 | \n2890 |             if orientation == \"vertical\":\n2891 |                 y_direction = -1 if y_inverted else 1\n2892 |                 xytext = 0, y_direction * sign(dat) * padding\n2893 |             else:  # horizontal\n2894 |                 x_direction = -1 if x_inverted else 1\n2895 |                 xytext = x_direction * sign(dat) * padding, 0\n2896 | \n2897 |             if label_type == \"center\":\n2898 |                 ha, va = \"center\", \"center\"\n2899 |             else:  # edge\n2900 |                 if orientation == \"vertical\":\n2901 |                     ha = 'center'\n2902 |                     if y_inverted:\n2903 |                         va = 'top' if dat > 0 else 'bottom'  # also handles NaN\n2904 |                     else:\n2905 |                         va = 'top' if dat < 0 else 'bottom'  # also handles NaN\n2906 |                 else:  # horizontal\n2907 |                     if x_inverted:\n2908 |                         ha = 'right' if dat > 0 else 'left'  # also handles NaN\n2909 |                     else:\n2910 |                         ha = 'right' if dat < 0 else 'left'  # also handles NaN\n2911 |                     va = 'center'\n2912 | \n2913 |             if np.isnan(dat):\n2914 |                 lbl = ''\n2915 | \n2916 |             if lbl is None:\n2917 |                 if isinstance(fmt, str):\n2918 |                     lbl = cbook._auto_format_str(fmt, value)\n2919 |                 elif callable(fmt):\n2920 |                     lbl = fmt(value)\n2921 |                 else:\n2922 |                     raise TypeError(\"fmt must be a str or callable\")\n2923 |             annotation = self.annotate(lbl,\n2924 |                                        xy, xytext, textcoords=\"offset points\",\n2925 |                                        ha=ha, va=va, **kwargs)\n2926 |             annotations.append(annotation)\n2927 | \n2928 |         return annotations\n```\n\nFound class `lib/matplotlib/patches.py:ConnectionStyle.Bar`.\nSource: Retrieved entity using keyword search (bm25).\n```\n3083 | class Bar(_Base):\n3084 |         \"\"\"\n3085 |         A line with *angle* between A and B with *armA* and *armB*. One of the\n3086 |         arms is extended so that they are connected in a right angle. The\n3087 |         length of *armA* is determined by (*armA* + *fraction* x AB distance).\n3088 |         Same for *armB*.\n3089 |         \"\"\"\n3090 | \n3091 |         def __init__(self, armA=0., armB=0., fraction=0.3, angle=None):\n3092 |             \"\"\"\n3093 |             Parameters\n3094 |             ----------\n3095 |             armA : float\n3096 |                 Minimum length of armA.\n3097 | \n3098 |             armB : float\n3099 |                 Minimum length of armB.\n3100 | \n3101 |             fraction : float\n3102 |                 A fraction of the distance between two points that will be\n3103 |                 added to armA and armB.\n3104 | \n3105 |             angle : float or None\n3106 |                 Angle of the connecting line (if None, parallel to A and B).\n3107 |             \"\"\"\n3108 |             self.armA = armA\n3109 |             self.armB = armB\n3110 |             self.fraction = fraction\n3111 |             self.angle = angle\n3112 | \n3113 |         def connect(self, posA, posB):\n3114 |             x1, y1 = posA\n3115 |             x20, y20 = x2, y2 = posB\n3116 | \n3117 |             theta1 = math.atan2(y2 - y1, x2 - x1)\n3118 |             dx, dy = x2 - x1, y2 - y1\n3119 |             dd = (dx * dx + dy * dy) ** .5\n3120 |             ddx, ddy = dx / dd, dy / dd\n3121 | \n3122 |             armA, armB = self.armA, self.armB\n3123 | \n3124 |             if self.angle is not None:\n3125 |                 theta0 = np.deg2rad(self.angle)\n3126 |                 dtheta = theta1 - theta0\n3127 |                 dl = dd * math.sin(dtheta)\n3128 |                 dL = dd * math.cos(dtheta)\n3129 |                 x2, y2 = x1 + dL * math.cos(theta0), y1 + dL * math.sin(theta0)\n3130 |                 armB = armB - dl\n3131 | \n3132 |                 # update\n3133 |                 dx, dy = x2 - x1, y2 - y1\n3134 |                 dd2 = (dx * dx + dy * dy) ** .5\n3135 |                 ddx, ddy = dx / dd2, dy / dd2\n3136 | \n3137 |             arm = max(armA, armB)\n3138 |             f = self.fraction * dd + arm\n3139 | \n3140 |             cx1, cy1 = x1 + f * ddy, y1 - f * ddx\n3141 |             cx2, cy2 = x2 + f * ddy, y2 - f * ddx\n3142 | \n3143 |             vertices = [(x1, y1),\n3144 |                         (cx1, cy1),\n3145 |                         (cx2, cy2),\n3146 |                         (x20, y20)]\n3147 |             codes = [Path.MOVETO,\n3148 |                      Path.LINETO,\n3149 |                      Path.LINETO,\n3150 |                      Path.LINETO]\n3151 | \n3152 |             return Path(vertices, codes)\n```\n\nFound class `lib/matplotlib/container.py:BarContainer`.\nSource: Retrieved code content using keyword search (bm25).\n```\n42 | class BarContainer(Container):\n43 |     \"\"\"\n44 |     Container for the artists of bar plots (e.g. created by `.Axes.bar`).\n45 | \n46 |     The container can be treated as a tuple of the *patches* themselves.\n47 |     Additionally, you can access these and further parameters by the\n48 |     attributes.\n49 | \n50 |     Attributes\n51 |     ----------\n52 |     patches : list of :class:`~matplotlib.patches.Rectangle`\n53 |         The artists of the bars.\n54 | \n55 |     errorbar : None or :class:`~matplotlib.container.ErrorbarContainer`\n56 |         A container for the error bar artists if error bars are present.\n57 |         *None* otherwise.\n58 | \n59 |     datavalues : None or array-like\n60 |         The underlying data values corresponding to the bars.\n61 | \n62 |     orientation : {'vertical', 'horizontal'}, default: None\n63 |         If 'vertical', the bars are assumed to be vertical.\n64 |         If 'horizontal', the bars are assumed to be