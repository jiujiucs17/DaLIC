eing cleared.\",\n260 |                 UserWarning,\n261 |                 stacklevel=find_stack_level(),\n262 |             )\n263 |             fig.clear()\n264 | \n265 |     nrows, ncols = _get_layout(naxes, layout=layout, layout_type=layout_type)\n266 |     nplots = nrows * ncols\n267 | \n268 |     # Create empty object array to hold all axes.  It's easiest to make it 1-d\n269 |     # so we can just append subplots upon creation, and then\n270 |     axarr = np.empty(nplots, dtype=object)\n271 | \n272 |     # Create first subplot separately, so we can share it if requested\n273 |     ax0 = fig.add_subplot(nrows, ncols, 1, **subplot_kw)\n274 | \n275 |     if sharex:\n276 |         subplot_kw[\"sharex\"] = ax0\n277 |     if sharey:\n278 |         subplot_kw[\"sharey\"] = ax0\n279 |     axarr[0] = ax0\n280 | \n281 |     # Note off-by-one counting because add_subplot uses the MATLAB 1-based\n282 |     # convention.\n283 |     for i in range(1, nplots):\n284 |         kwds = subplot_kw.copy()\n285 |         # Set sharex and sharey to None for blank/dummy axes, these can\n286 |         # interfere with proper axis limits on the visible axes if\n287 |         # they share axes e.g. issue #7528\n288 |         if i >= naxes:\n289 |             kwds[\"sharex\"] = None\n290 |             kwds[\"sharey\"] = None\n291 |         ax = fig.add_subplot(nrows, ncols, i + 1, **kwds)\n292 |         axarr[i] = ax\n293 | \n294 |     if naxes != nplots:\n295 |         for ax in axarr[naxes:]:\n296 |             ax.set_visible(False)\n297 | \n298 |     handle_shared_axes(axarr, nplots, naxes, nrows, ncols, sharex, sharey)\n299 | \n300 |     if squeeze:\n301 |         # Reshape the array to have the final desired dimension (nrow,ncol),\n302 |         # though discarding unneeded dimensions that equal 1.  If we only have\n303 |         # one subplot, just return it instead of a 1-element array.\n304 |         if nplots == 1:\n305 |             axes = axarr[0]\n306 |         else:\n307 | 