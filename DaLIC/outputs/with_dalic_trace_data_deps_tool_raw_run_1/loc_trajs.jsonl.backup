     )\n2519 | \n2520 |         monotonic_cst = np.asarray(monotonic_cst, dtype=np.int8)\n2521 |         if monotonic_cst.shape[0] != estimator.n_features_in_:\n2522 |             raise ValueError(\n2523 |                 f\"monotonic_cst has shape {monotonic_cst.shape} but the input data \"\n2524 |                 f\"X has {estimator.n_features_in_} features.\"\n2525 |             )\n2526 |     return monotonic_cst\n```\n\nFound function `sklearn/utils/validation.py:_check_pos_label_consistency`.\nSource: Retrieved entity using keyword search (bm25).\n```\n2529 | def _check_pos_label_consistency(pos_label, y_true):\n2530 |     \"\"\"Check if `pos_label` need to be specified or not.\n2531 | \n2532 |     In binary classification, we fix `pos_label=1` if the labels are in the set\n2533 |     {-1, 1} or {0, 1}. Otherwise, we raise an error asking to specify the\n2534 |     `pos_label` parameters.\n2535 | \n2536 |     Parameters\n2537 |     ----------\n2538 |     pos_label : int, float, bool, str or None\n2539 |         The positive label.\n2540 |     y_true : ndarray of shape (n_samples,)\n2541 |         The target vector.\n2542 | \n2543 |     Returns\n2544 |     -------\n2545 |     pos_label : int, float, bool or str\n2546 |         If `pos_label` can be inferred, it will be returned.\n2547 | \n2548 |     Raises\n2549 |     ------\n2550 |     ValueError\n2551 |         In the case that `y_true` does not have label in {-1, 1} or {0, 1},\n2552 |         it will raise a `ValueError`.\n2553 |     \"\"\"\n2554 |     # ensure binary classification if pos_label is not specified\n2555 |     # classes.dtype.kind in ('O', 'U', 'S') is required to avoid\n2556 |     # triggering a FutureWarning by calling np.array_equal(a, b)\n2557 |     # when elements in the two arrays are not comparable.\n2558 |     if pos_label is None:\n2559 |         # Compute classes only if pos_label is not specified:\n2560 |         classes = np.unique(y_true)\n2561 |         if classes.dtype.kind in \"O