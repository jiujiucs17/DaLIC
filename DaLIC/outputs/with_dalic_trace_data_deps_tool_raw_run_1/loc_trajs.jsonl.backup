x = cbook._reshape_2D(x, 'x')\n6947 |         nx = len(x)  # number of datasets\n6948 | \n6949 |         # Process unit information.  _process_unit_info sets the unit and\n6950 |         # converts the first dataset; then we convert each following dataset\n6951 |         # one at a time.\n6952 |         if orientation == \"vertical\":\n6953 |             convert_units = self.convert_xunits\n6954 |             x = [*self._process_unit_info([(\"x\", x[0])], kwargs),\n6955 |                  *map(convert_units, x[1:])]\n6956 |         else:  # horizontal\n6957 |             convert_units = self.convert_yunits\n6958 |             x = [*self._process_unit_info([(\"y\", x[0])], kwargs),\n6959 |                  *map(convert_units, x[1:])]\n6960 | \n6961 |         if bin_range is not None:\n6962 |             bin_range = convert_units(bin_range)\n6963 | \n6964 |         if not cbook.is_scalar_or_string(bins):\n6965 |             bins = convert_units(bins)\n6966 | \n6967 |         # We need to do to 'weights' what was done to 'x'\n6968 |         if weights is not None:\n6969 |             w = cbook._reshape_2D(weights, 'weights')\n6970 |         else:\n6971 |             w = [None] * nx\n6972 | \n6973 |         if len(w) != nx:\n6974 |             raise ValueError('weights should have the same shape as x')\n6975 | \n6976 |         input_empty = True\n6977 |         for xi, wi in zip(x, w):\n6978 |             len_xi = len(xi)\n6979 |             if wi is not None and len(wi) != len_xi:\n6980 |                 raise ValueError('weights should have the same shape as x')\n6981 |             if len_xi:\n6982 |                 input_empty = False\n6983 | \n6984 |         if color is None:\n6985 |             colors = [self._get_lines.get_next_color() for i in range(nx)]\n6986 |         else:\n6987 |             colors = mcolors.to_rgba_array(color)\n6988 |             if len(colors) != nx:\n6989 |                 raise ValueError(f\"The 'color' keyword argument must have one \"\n6990 |                                  f\"color per dataset, but {nx} datasets and \"\n6991 |                                  f\"{len(colors)} colors were provided\")\n6992 | \n6993 |         hist_kwargs = dict()\n6994 | \n6995 |         # if the bin_range is not given, compute without nan numpy\n6996 |         # does not do this for us when guessing the range (but will\n6997 |         # happily ignore nans when computing the histogram).\n6998 |         if bin_range is None:\n6999 |             xmin = np.inf\n7000 |             xmax = -np.inf\n7001 |             for xi in x:\n7002 |                 if len(xi):\n7003 |                     # python's min/max ignore nan,\n7004 |                     # np.minnan returns nan for all nan input\n7005 |                     xmin = min(xmin, np.nanmin(xi))\n7006 |                     xmax = max(xmax, np.nanmax(xi))\n7007 |             if xmin <= xmax:  # Only happens if we have seen a finite value.\n7008 |                 bin_range = (xmin, xmax)\n7009 | \n7010 |         # If bins are not specified either explicitly or via range,\n7011 |         # we need to figure out the range required for all datasets,\n7012 |         # and supply that to np.histogram.\n7013 |         if not input_empty and len(x) > 1:\n7014 |             if weights is not None:\n7015 |                 _w = np.concatenate(w)\n7016 |             else:\n7017 |                 _w = None\n7018 |             bins = np.histogram_bin_edges(\n7019 |                 np.concatenate(x), bins, bin_range, _w)\n7020 |         else:\n7021 |             hist_kwargs['range'] = bin_range\n7022 | \n7023 |         density = bool(density)\n7024 |         if density and not stacked:\n7025 |             hist_kwargs['density'] = density\n7026 | \n7027 |         # List to store all the top coordinates of the histograms\n7028 |         tops = []  # Will have shape (n_datasets, n_bins).\n7029 |         # Loop through datasets\n7030 |         for i in range(nx):\n7031 |            