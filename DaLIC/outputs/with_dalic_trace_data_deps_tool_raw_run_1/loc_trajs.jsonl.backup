     if copy:\n189 |             values = values.copy()\n190 |     elif isinstance(values, np.ndarray) and values.dtype.kind in \"iufcb\":\n191 |         mask_values = isna(values)\n192 | \n193 |         values_bool = np.zeros(len(values), dtype=bool)\n194 |         values_bool[~mask_values] = values[~mask_values].astype(bool)\n195 | \n196 |         if not np.all(\n197 |             values_bool[~mask_values].astype(values.dtype) == values[~mask_values]\n198 |         ):\n199 |             raise TypeError(\"Need to pass bool-like values\")\n200 | \n201 |         values = values_bool\n202 |     else:\n203 |         values_object = np.asarray(values, dtype=object)\n204 | \n205 |         inferred_dtype = lib.infer_dtype(values_object, skipna=True)\n206 |         integer_like = (\"floating\", \"integer\", \"mixed-integer-float\")\n207 |         if inferred_dtype not in (\"boolean\", \"empty\") + integer_like:\n208 |             raise TypeError(\"Need to pass bool-like values\")\n209 | \n210 |         # mypy does not narrow the type of mask_values to npt.NDArray[np.bool_]\n211 |         # within this branch, it assumes it can also be None\n212 |         mask_values = cast(\"npt.NDArray[np.bool_]\", isna(values_object))\n213 |         values = np.zeros(len(values), dtype=bool)\n214 |         values[~mask_values] = values_object[~mask_values].astype(bool)\n215 | \n216 |         # if the values were integer-like, validate it were actually 0/1's\n217 |         if (inferred_dtype in integer_like) and not (\n218 |             np.all(\n219 |                 values[~mask_values].astype(float)\n220 |                 == values_object[~mask_values].astype(float)\n221 |             )\n222 |         ):\n223 |             raise TypeError(\"Need to pass bool-like values\")\n224 | \n225 |     if mask is None and mask_values is None:\n226 |         mask = np.zeros(values.shape, dtype=bool)\n227 |     elif mask is None:\n228 |         mask = mask_values\n229 |     else:\n230 |         if isinstance(mask, np.ndarray) and mask.dtype == np.bool_:\n231 |             if mask_values is not None:\n232 |                 mask = mask | mask_values\n233 |             else:\n234 |                 if copy:\n235 |                     mask = mask.copy()\n236 |         else:\n237 |             mask = np.array(mask, dtype=bool)\n238 |             if mask_values is not None:\n239 |                 mask = mask | mask_values\n240 | \n241 |     if values.shape != mask.shape:\n242 |         raise ValueError(\"values.shape and mask.shape must match\")\n243 | \n244 |     return values, mask\n```\n\n\n\n##Searching for term \"str accessor\", \"inferred_dtype str accessor\"...\n### Search Result:\nFound function `pandas/core/dtypes/dtypes.py:DatetimeTZDtype.str`.\nSource: Retrieved entity using keyword search (bm25).\n```\n771 | def str(self) -> str:  # type: ignore[override]\n772 |         return f\"|M8[{self.unit}]\"\n```\n\nFound class `pandas/core/accessor.py:Accessor`.\nSource: Retrieved entity using keyword search (bm25).\n```\n200 | class Accessor:\n201 |     \"\"\"\n202 |     Custom property-like object.\n203 | \n204 |     A descriptor for accessors.\n205 | \n206 |     Parameters\n207 |     ----------\n208 |     name : str\n209 |         Namespace that will be accessed under, e.g. ``df.foo``.\n210 |     accessor : cls\n211 |         Class with the extension methods.\n212 | \n213 |     Notes\n214 |     -----\n215 |     For accessor, The class's __init__ method assumes that one of\n216 |     ``Series``, ``DataFrame`` or ``Index`` as the\n217 |     single argument ``data``.\n218 |     \"\"\"\n219 | \n220 |     def __init__(self, name: str, accessor) -> None:\n221 |         self._name = name\n222 |         self._accessor = accessor\n223 | \n224 |     def __get__(self, obj, cls):\n225 |         if obj is None:\n226 |             # we're accessing the attribute of the class, i.e., Dataset.geo\n227 |             return self._accessor\n228 |         return self._accessor(obj)