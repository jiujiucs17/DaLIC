nner\n1560 |         self.key = key\n1561 | \n1562 |         self._groupby = groupby\n1563 |         self._timegrouper = copy.copy(parent._timegrouper)\n1564 | \n1565 |         self.ax = parent.ax\n1566 |         self.obj = parent.obj\n1567 |         self.include_groups = include_groups\n1568 | \n1569 |     @no_type_check\n1570 |     def _apply(self, f, *args, **kwargs):\n1571 |         \"\"\"\n1572 |         Dispatch to _upsample; we are stripping all of the _upsample kwargs and\n1573 |         performing the original function call on the grouped object.\n1574 |         \"\"\"\n1575 | \n1576 |         def func(x):\n1577 |             x = self._resampler_cls(x, timegrouper=self._timegrouper, gpr_index=self.ax)\n1578 | \n1579 |             if isinstance(f, str):\n1580 |                 return getattr(x, f)(**kwargs)\n1581 | \n1582 |             return x.apply(f, *args, **kwargs)\n1583 | \n1584 |         result = _apply(self._groupby, func, include_groups=self.include_groups)\n1585 |         return self._wrap_result(result)\n1586 | \n1587 |     _upsample = _apply\n1588 |     _downsample = _apply\n1589 |     _groupby_and_aggregate = _apply\n1590 | \n1591 |     @final\n1592 |     def _gotitem(self, key, ndim, subset=None):\n1593 |         \"\"\"\n1594 |         Sub-classes to define. Return a sliced object.\n1595 | \n1596 |         Parameters\n1597 |         ----------\n1598 |         key : string / list of selections\n1599 |         ndim : {1, 2}\n1600 |             requested ndim of result\n1601 |         subset : object, default None\n1602 |             subset to act on\n1603 |         \"\"\"\n1604 |         # create a new object to prevent aliasing\n1605 |         if subset is None:\n1606 |             subset = self.obj\n1607 |             if key is not None:\n1608 |                 subset = subset[key]\n1609 |             else:\n1610 |                 # reached via Apply.agg_dict_like with selection=None, ndim=1\n1611 |                 assert subset.ndim == 1\n1612 | \n1613 |         # Try to select from a DataFrame, falling back to a Series\n1614 |         try:\n1615 |             if isinstance(key, list) and self.key not in key and self.key is not None:\n1616 |                 key.append(self.key)\n1617 |             groupby = self._groupby[key]\n1618 |         except IndexError:\n1619 |             groupby = self._groupby\n1620 | \n1621 |         selection = self._infer_selection(key, subset)\n1622 | \n1623 |         new_rs = type(self)(\n1624 |             groupby=groupby,\n1625 |             parent=cast(Resampler, self),\n1626 |             selection=selection,\n1627 |         )\n1628 |         return new_rs\n1629 | \n1630 | \n1631 | class DatetimeIndexResampler(Resampler):\n1632 |     ax: DatetimeIndex\n1633 | \n1634 |     @property\n1635 |     def _resampler_for_grouping(self) -> type[DatetimeIndexResamplerGroupby]:\n1636 |         return DatetimeIndexResamplerGroupby\n1637 | \n1638 |     def _get_binner_for_time(self):\n1639 |         # this is how we are actually creating the bins\n1640 |         if isinstance(self.ax, PeriodIndex):\n1641 |             return self._timegrouper._get_time_period_bins(self.ax)\n1642 |         return self._timegrouper._get_time_bins(self.ax)\n1643 | \n1644 |     def _downsample(self, how, **kwargs):\n1645 |         \"\"\"\n1646 |         Downsample the cython defined function.\n1647 | \n1648 |         Parameters\n1649 |         ----------\n1650 |         how : string / cython mapped function\n1651 |         **kwargs : kw args passed to how function\n1652 |         \"\"\"\n1653 |         ax = self.ax\n1654 | \n1655 |         # Excludes `on` column when provided\n1656 |         obj = self._obj_with_exclusions\n1657 | \n1658 |         if not len(ax):\n1659 |             # reset to the new freq\n1660 |             obj = obj.copy()\n1661 |             obj.index = obj.index._with_freq(self.freq)\n1662 |             assert obj.index.freq == self.freq, (obj.index.freq, self.freq)\n1663 |        